"Data":"assets/陆英 4-20240826101522-8wewjpq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826102653-2hr4ikk","Type":"NodeParagraph","Properties":{"id":"20240826102653-2hr4ikk","updated":"20240826102653"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 728px;","style":"width: 718px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英 8-20240826102416-y7iro1l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 486px;","style":"width: 476px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英 9-20240826102601-2v6teun.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 476px;\" parent-style=\"width: 486px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826101739-eovekk5","Type":"NodeParagraph","Properties":{"id":"20240826101739-eovekk5","updated":"20240826101752"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 531px;","style":"width: 521px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英 5-20240826101738-vhullrp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 521px;\" parent-style=\"width: 531px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 667px;","style":"width: 657px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英3-20240702094406-i0c6z75.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 657px;\" parent-style=\"width: 667px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704144502-j5slxfr","Type":"NodeParagraph","Properties":{"id":"20240704144502-j5slxfr","updated":"20240704144707"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点击跳转→"},{"Type":"NodeTextMark","TextMarkType":"block-ref strong","TextMarkBlockRefID":"20240205153625-2kinrry","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"369补12蒴（蒴、蒴藋、蒴翟）"}]},{"ID":"20240704142837-a551i6h","Type":"NodeParagraph","Properties":{"id":"20240704142837-a551i6h","updated":"20240704143139"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：陆英也称为蒴藋，更多详情可在蒴藋下查看；"}]},{"ID":"20240704142934-4bs73w8","Type":"NodeParagraph","Properties":{"id":"20240704142934-4bs73w8","updated":"20240826113531"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：由于中草药图鉴是根据倪师的神农本草经排序，制造过程中倪师在神农本草经后369条补了一项本草‘蒴’，较多说法蒴就是陆英。这里不作删除合并（如有错误烦请指正），读者可在两篇中翻阅阅读。"}]},{"ID":"20240613113823-mo2kp1x","Type":"NodeThematicBreak","Properties":{"id":"20240613113823-mo2kp1x"}},{"ID":"20240613113847-tbhraiz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113847-tbhraiz","updated":"20240613113853"},"Children":[{"Type":"NodeText","Data":"陆英《神农本草经》"}]},{"ID":"20240613113847-8v1fx7y","Type":"NodeParagraph","Properties":{"id":"20240613113847-8v1fx7y","updated":"20240613113847"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613113847-nml8v7v","Type":"NodeParagraph","Properties":{"id":"20240613113847-nml8v7v","updated":"20240613113847"},"Children":[{"Type":"NodeText","Data":"主骨间诸痹，四肢拘挛，疼酸，膝寒痛，阴痿，短气，不足，脚肿。生川谷。"}]},{"ID":"20240613113847-tyvnner","Type":"NodeParagraph","Properties":{"id":"20240613113847-tyvnner","updated":"20240613113847"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生熊耳及冤句，立秋采，又曰蒴藋，味酸温有毒，一名荲（今本误作堇），一名芨，生四野，春夏采叶，秋冬采茎根。"}]},{"ID":"20240613113847-394e4ug","Type":"NodeParagraph","Properties":{"id":"20240613113847-394e4ug","updated":"20240613113847"},"Children":[{"Type":"NodeText","Data":"案《说文》云：堇草也，读若厘，芨荲草也，读若急，藋厘草也。《广雅》云：盆，陆英苺也。《尔雅》云：芨荲草。《唐本》注陆英云：此物蒴藋是也，后人不识，浪出蒴藋条。今注云：陆英，味苦寒无毒，蒴藋"}]},{"ID":"20240613113847-3d9znty","Type":"NodeParagraph","Properties":{"id":"20240613113847-3d9znty","updated":"20240613113847"},"Children":[{"Type":"NodeText","Data":"味酸温有毒，既此不同，难谓一种，盖其类尔。"}]},{"ID":"20240613113951-zvx4ug3","Type":"NodeThematicBreak","Properties":{"id":"20240613113951-zvx4ug3"}},{"ID":"20240613113952-3puevdw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113952-3puevdw","updated":"20240613113956"},"Children":[{"Type":"NodeText","Data":"陆英《医学入门》"}]},{"ID":"20240613113952-lslk2rc","Type":"NodeParagraph","Properties":{"id":"20240613113952-lslk2rc","updated":"20240613113952"},"Children":[{"Type":"NodeText","Data":"味苦寒。无毒，叶似芹，故芹名水英，此名陆英。立秋采花，所在有之。主风痹痛挛，皮肤瘙痒，风脚水肿，阴痿。"}]},{"ID":"20240613114042-iaw5us5","Type":"NodeThematicBreak","Properties":{"id":"20240613114042-iaw5us5"}},{"ID":"20240613114043-8s7w2dy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114043-8s7w2dy","updated":"20240613114047"},"Children":[{"Type":"NodeText","Data":"陆英《名医别录》"}]},{"ID":"20240613114043-gd07t8o","Type":"NodeParagraph","Properties":{"id":"20240613114043-gd07t8o","updated":"20240613114043"},"Children":[{"Type":"NodeText","Data":"无毒．生熊耳及宛朐．立秋采．"}]},{"ID":"20240613114043-e5hsjzx","Type":"NodeParagraph","Properties":{"id":"20240613114043-e5hsjzx","updated":"20240613114043"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶陆英，味苦，寒．主骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿．生川谷．"}]},{"ID":"20240613114118-71tf4qt","Type":"NodeThematicBreak","Properties":{"id":"20240613114118-71tf4qt"}},{"ID":"20240613114119-cf0a1sl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114119-cf0a1sl","updated":"20240613114131"},"Children":[{"Type":"NodeText","Data":"陆英《本草图经》"}]},{"ID":"20240613114119-7aqyh4b","Type":"NodeParagraph","Properties":{"id":"20240613114119-7aqyh4b","updated":"20240613114126"},"Children":[{"Type":"NodeText","Data":"陆英，生熊耳川谷及冤句。蒴 不载所出州土，但云生田野，今所在有之。春抽苗，茎有节，节间生枝；叶大似水芹及接骨，春夏采叶，秋冬采根茎。或云即陆英也。《本经》别立一条。陶隐居亦以为一物。苏恭云∶《药对》及古方无蒴 ，惟言陆英，明非别物。今注以性味不同，疑非一种，谓其类耳，然亦不能细别，再详陆英条，不言所用。蒴 条云用叶、根、茎，盖一物而所用别，故性味不同，何以明之？苏恭云此叶似芹及接骨花，亦一类，故芹名水英，此名陆英，接骨名木英，此三英花、叶并相似。又按《尔雅》云∶华 （音敷）也，华荣也。木谓之华，草谓之荣，不荣而实者为之秀，荣而不实者谓之英。然则此物既有英名，当是其花耳。故《本经》云∶陆英立秋采。立秋正是其花时也。又葛氏方有用蒴 者，有用蒴 根者，有用叶者，三用各别，正与经载三时所采者相会，谓陆英为花无疑也。"}]},{"ID":"20240613114136-tcxw2z2","Type":"NodeThematicBreak","Properties":{"id":"20240613114136-tcxw2z2"}},{"ID":"20240613114138-p9zohcv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114138-p9zohcv","updated":"20240613114142"},"Children":[{"Type":"NodeText","Data":"陆英《新修本草》"}]},{"ID":"20240613114138-ttbrohs","Type":"NodeParagraph","Properties":{"id":"20240613114138-ttbrohs","updated":"20240613114138"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿。生熊耳川谷及冤句，立秋采。"}]},{"ID":"20240613114138-2wutijw","Type":"NodeParagraph","Properties":{"id":"20240613114138-2wutijw","updated":"20240613114138"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此即蒴 是也。后人不识，浪出蒴 条。此叶似芹及接骨花，亦一类，故芹名水英，此名陆英，接骨树名木英，此三英也。花叶并相似。"}]},{"ID":"20240613114107-059co25","Type":"NodeThematicBreak","Properties":{"id":"20240613114107-059co25"}},{"ID":"20240613114108-qg7bh9l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114108-qg7bh9l","updated":"20240613114113"},"Children":[{"Type":"NodeText","Data":"陆英《本草经集注》"}]},{"ID":"20240613114108-ku65kuf","Type":"NodeParagraph","Properties":{"id":"20240613114108-ku65kuf","updated":"20240613114108"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿。生熊耳川谷及冤句，立秋采。"}]},{"ID":"20240613114052-boiksg3","Type":"NodeThematicBreak","Properties":{"id":"20240613114052-boiksg3"}},{"ID":"20240613114055-x3qjmkk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114055-x3qjmkk","updated":"20240613114102"},"Children":[{"Type":"NodeText","Data":"陆英《本经逢原》"}]},{"ID":"20240613114055-hlj2bgv","Type":"NodeParagraph","Properties":{"id":"20240613114055-hlj2bgv","updated":"20240613114055"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名蒴 ，又名接骨草"}]},{"ID":"20240613114055-1hp1o6g","Type":"NodeParagraph","Properties":{"id":"20240613114055-1hp1o6g","updated":"20240613114055"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。"}]},{"ID":"20240613114055-sd1pamd","Type":"NodeParagraph","Properties":{"id":"20240613114055-sd1pamd","updated":"20240613114055"},"Children":[{"Type":"NodeText","Data":"《本经》主骨间诸痹，四肢拘挛，疼酸膝寒痛，阴痿短气不足，脚肿。"}]},{"ID":"20240613114055-kwx76pg","Type":"NodeParagraph","Properties":{"id":"20240613114055-kwx76pg","updated":"20240613114055"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"陶苏《本草》，甄权《药性》皆言陆英即蒴 ，田野村墟甚多。人家所植高硕色赤者是陆英，田野所出不红，叶上有粉者是蒴 ，二味所主大率相类，《外台》、《千金方》多用之，世以其贱而全置不讲也。"}]},{"ID":"20240613114030-2tqkyp7","Type":"NodeThematicBreak","Properties":{"id":"20240613114030-2tqkyp7"}},{"ID":"20240613114031-mdvtx7l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114031-mdvtx7l","updated":"20240613114036"},"Children":[{"Type":"NodeText","Data":"陆英《千金翼方》"}]},{"ID":"20240613114031-qbss4up","Type":"NodeParagraph","Properties":{"id":"20240613114031-qbss4up","updated":"20240613114031"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿。生熊耳川谷及冤句，立秋采。"}]},{"ID":"20240613114019-vz35ngm","Type":"NodeThematicBreak","Properties":{"id":"20240613114019-vz35ngm"}},{"ID":"20240613114021-f3tyfim","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114021-f3tyfim","updated":"20240613114025"},"Children":[{"Type":"NodeText","Data":"陆英《神农本草经赞》"}]},{"ID":"20240613114021-oipdsia","Type":"NodeParagraph","Properties":{"id":"20240613114021-oipdsia","updated":"20240613114021"},"Children":[{"Type":"NodeText","Data":"味苦寒。主骨间诸痹。四肢拘挛。疼酸。膝寒痛。阴痿。短气不足。脚肿。生川谷。"}]},{"ID":"20240613114021-xmk0gfg","Type":"NodeParagraph","Properties":{"id":"20240613114021-xmk0gfg","updated":"20240613114021"},"Children":[{"Type":"NodeText","Data":"蒴敷华。萧秋启候。五叶缠枝。百枚贮豆。水节清肥。木心虚秀。粲兮三英。骨风效奏。"}]},{"ID":"20240613114021-j0bw4eo","Type":"NodeParagraph","Properties":{"id":"20240613114021-j0bw4eo","updated":"20240613114021"},"Children":[{"Type":"NodeText","Data":"苏恭曰。此即蒴也。古方惟言。陆英后人不识耳。苏颂曰。尔雅荣而不实。谓之英。"}]},{"ID":"20240613114021-1fppk95","Type":"NodeParagraph","Properties":{"id":"20240613114021-1fppk95","updated":"20240613114021"},"Children":[{"Type":"NodeText","Data":"此物英名。当是其花。名医云。宜秋采。正是其花时也。李时珍曰。每枝有五叶。寇宗曰。子初青。如绿豆颗。每朵如盏而大。生一二百子。苏恭曰。此叶似芹。及接骨花三物。亦同类芹。名水英。接骨名木英树。此三英也。水英根叶肥大。主治骨风。木英体轻虚无心。续筋骨。除风痹。诗。三英粲兮。"}]},{"ID":"20240613114006-xb4ne0n","Type":"NodeThematicBreak","Properties":{"id":"20240613114006-xb4ne0n"}},{"ID":"20240613114007-ww4elu2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114007-ww4elu2","updated":"20240613114013"},"Children":[{"Type":"NodeText","Data":"陆英《证类本草》"}]},{"ID":"20240613114007-1r6dpqb","Type":"NodeParagraph","Properties":{"id":"20240613114007-1r6dpqb","updated":"20240613114007"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿。生熊耳川谷及冤句。立秋采。"}]},{"ID":"20240613114007-bg0pt68","Type":"NodeParagraph","Properties":{"id":"20240613114007-bg0pt68","updated":"20240613114007"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此即蒴 是也，后人不识，浪出蒴 条。此叶似芹及接骨花，亦一类，故芹名水英，此名陆英，接骨树名木英，此三英也，花、叶并相似。臣禹锡等谨按药性论云∶陆英，一名蒴 。味苦、辛，有小毒。能捋风毒，香港脚上冲，心烦闷绝，主水气虚肿。风瘙皮肌恶痒，煎取汤入少酒，可俗之，妙。"}]},{"ID":"20240613114007-ghxao00","Type":"NodeParagraph","Properties":{"id":"20240613114007-ghxao00","updated":"20240613114007"},"Children":[{"Type":"NodeText","Data":"图经曰∶陆英，生熊耳川谷及冤句，蒴 不载所出州土，但云生田野，今所在有之。春抽苗，茎有节，节间生枝，叶大似水芹及接骨。春夏采叶，秋冬采根、茎。或云即陆英也。"}]},{"ID":"20240613114007-b2yfrn7","Type":"NodeParagraph","Properties":{"id":"20240613114007-b2yfrn7","updated":"20240613114007"},"Children":[{"Type":"NodeText","Data":"《本经》别立一条，陶隐居亦以为一物。苏恭云∶《药对》及古方无蒴 ，唯言陆英，明非别物。今注以性味不同，疑非一种，谓其类耳，然亦不能细别。再详陆英条，不言所用。蒴条云用叶、根、茎，盖一物而所用别，故性味不同，何以明之。苏恭云∶此叶似芹及接骨花，亦一类，故芹名水英，此名陆英，接骨名木英，此三英，花、叶并相似。又按《尔雅》云∶华， （音敷）也。华、 ，荣也。木谓之华，草谓之荣，不荣而实者为之秀，荣而不实者谓之英。然则此物既有英名，当是其花耳。故《本经》云∶陆英立秋采。立秋正是其花时也。"}]},{"ID":"20240613114007-xb1pwxx","Type":"NodeParagraph","Properties":{"id":"20240613114007-xb1pwxx","updated":"20240613114007"},"Children":[{"Type":"NodeText","Data":"又葛氏方，有用蒴 者；有用蒴 根者；有用叶者。三用各别，正与《经》载三时所采者相会，谓陆英为花无疑也。"}]},{"ID":"20240613113823-qjcuah5","Type":"NodeThematicBreak","Properties":{"id":"20240613113823-qjcuah5"}},{"ID":"20240613113824-krm6x7h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113824-krm6x7h","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：陆英"}]},{"ID":"20240613113824-nsgpcr1","Type":"NodeParagraph","Properties":{"id":"20240613113824-nsgpcr1","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613113824-t92v0ry","Type":"NodeParagraph","Properties":{"id":"20240613113824-t92v0ry","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" Lù Yīnɡ"}]},{"ID":"20240613113824-2v2si0n","Type":"NodeParagraph","Properties":{"id":"20240613113824-2v2si0n","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613113824-yh5cojc","Type":"NodeParagraph","Properties":{"id":"20240613113824-yh5cojc","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 蒴藋、走马前、走马风、八棱麻、八里麻、臭草、苛草、七叶金"}]},{"ID":"20240613113824-nepj3w9","Type":"NodeParagraph","Properties":{"id":"20240613113824-nepj3w9","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613113824-dp7r1ae","Type":"NodeParagraph","Properties":{"id":"20240613113824-dp7r1ae","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 为忍冬科接骨木属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"陆英"},{"Type":"NodeText","Data":"Sambucus chinensis Lindl.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根、茎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"入药。全年可采，洗净切碎，晒干或鲜用。"}]},{"ID":"20240613113824-b9gnwnd","Type":"NodeParagraph","Properties":{"id":"20240613113824-b9gnwnd","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613113824-hdivrjs","Type":"NodeParagraph","Properties":{"id":"20240613113824-hdivrjs","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 甘淡、微苦，平。"}]},{"ID":"20240613113824-0d8rdu0","Type":"NodeParagraph","Properties":{"id":"20240613113824-0d8rdu0","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613113824-4amw69v","Type":"NodeParagraph","Properties":{"id":"20240613113824-4amw69v","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 根：散瘀消肿，祛风活络。用于跌打损伤，扭伤肿痛，骨折疼痛，风湿关节痛。"}]},{"ID":"20240613113824-8g4xujw","Type":"NodeParagraph","Properties":{"id":"20240613113824-8g4xujw","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"茎、叶：利尿消肿，活血止痛。用于肾炎水肿，腰膝酸痛；外用治跌打肿痛。"}]},{"ID":"20240613113824-yo4w5rp","Type":"NodeParagraph","Properties":{"id":"20240613113824-yo4w5rp","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613113824-g0u2cw0","Type":"NodeParagraph","Properties":{"id":"20240613113824-g0u2cw0","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 均为1～2两，外用适量，捣烂敷患处。"}]},{"ID":"20240613113824-kpwwc8t","Type":"NodeParagraph","Properties":{"id":"20240613113824-kpwwc8t","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613113824-tqx01n0","Type":"NodeParagraph","Properties":{"id":"20240613113824-tqx01n0","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613113824-6h99ec2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113824-6h99ec2","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：陆英"}]},{"ID":"20240613113824-fzil654","Type":"NodeParagraph","Properties":{"id":"20240613113824-fzil654","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613113824-l3i3gme","Type":"NodeParagraph","Properties":{"id":"20240613113824-l3i3gme","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" Lù Yīnɡ"}]},{"ID":"20240613113824-8zpgkn3","Type":"NodeParagraph","Properties":{"id":"20240613113824-8zpgkn3","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613113824-635xkbh","Type":"NodeParagraph","Properties":{"id":"20240613113824-635xkbh","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613113824-xslxscv","Type":"NodeParagraph","Properties":{"id":"20240613113824-xslxscv","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613113824-kfosgb6","Type":"NodeParagraph","Properties":{"id":"20240613113824-kfosgb6","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 为忍冬科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒴藋"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613113824-7wdyw0c","Type":"NodeParagraph","Properties":{"id":"20240613113824-7wdyw0c","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613113824-xxjeb4i","Type":"NodeParagraph","Properties":{"id":"20240613113824-xxjeb4i","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240613113824-zo65s45","Type":"NodeParagraph","Properties":{"id":"20240613113824-zo65s45","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613113824-czhsihc","Type":"NodeParagraph","Properties":{"id":"20240613113824-czhsihc","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 含氯原酸、α-香树脂素棕榈酸酯（α-amyin palmitate）、熊果酸、β-谷甾醇、豆甾醇、油菜甾醇、硝酸钾、黄酮、鞣质等。"}]},{"ID":"20240613113824-6nhy92f","Type":"NodeParagraph","Properties":{"id":"20240613113824-6nhy92f","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613113824-la3sl4h","Type":"NodeParagraph","Properties":{"id":"20240613113824-la3sl4h","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 肝经。"}]},{"ID":"20240613113824-cfvzf1o","Type":"NodeParagraph","Properties":{"id":"20240613113824-cfvzf1o","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613113824-uxu1ht3","Type":"NodeParagraph","Properties":{"id":"20240613113824-uxu1ht3","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒。"}]},{"ID":"20240613113824-4023hid","Type":"NodeParagraph","Properties":{"id":"20240613113824-4023hid","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240613113824-5rbkvk8","Type":"NodeParagraph","Properties":{"id":"20240613113824-5rbkvk8","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613113824-laxgz4f","Type":"NodeParagraph","Properties":{"id":"20240613113824-laxgz4f","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"⑧《药性论》：\"苦辛，有小毒。\""}]},{"ID":"20240613113824-ae7iuac","Type":"NodeParagraph","Properties":{"id":"20240613113824-ae7iuac","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613113824-0acxg7j","Type":"NodeParagraph","Properties":{"id":"20240613113824-0acxg7j","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 孕妇禁服。"}]},{"ID":"20240613113824-97kn82z","Type":"NodeParagraph","Properties":{"id":"20240613113824-97kn82z","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613113824-yjmtbe1","Type":"NodeParagraph","Properties":{"id":"20240613113824-yjmtbe1","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 疏肝健脾，活血化瘀，利尿消肿。用于急性病毒性肝炎，肾炎水肿、风湿痛、脱臼、肾炎水肿、脚气水肿、荨麻疹，跌扑损伤，骨折。"}]},{"ID":"20240613113824-vtlvvpd","Type":"NodeParagraph","Properties":{"id":"20240613113824-vtlvvpd","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主骨间诸痹，四肢拘挛疼酸，膝寒痛，阴痿，短气不足，脚肿。\""}]},{"ID":"20240613113824-2d66exw","Type":"NodeParagraph","Properties":{"id":"20240613113824-2d66exw","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"能捋风毒，脚气上冲，心烦闷绝。主水气虚肿，风瘙皮肌恶痒，煎取汤入少洒可浴之妙。\""}]},{"ID":"20240613113824-2ysoh68","Type":"NodeParagraph","Properties":{"id":"20240613113824-2ysoh68","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613113824-3n6vl8l","Type":"NodeParagraph","Properties":{"id":"20240613113824-3n6vl8l","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱。外用：煎水洗浴。"}]},{"ID":"20240613113824-ry6dzkn","Type":"NodeParagraph","Properties":{"id":"20240613113824-ry6dzkn","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613113824-1wd0g79","Type":"NodeParagraph","Properties":{"id":"20240613113824-1wd0g79","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613113824-xvlipwr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113824-xvlipwr","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"《中华本草》：陆英"}]},{"ID":"20240613113824-lj0bqp3","Type":"NodeParagraph","Properties":{"id":"20240613113824-lj0bqp3","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613113824-n7kpgud","Type":"NodeParagraph","Properties":{"id":"20240613113824-n7kpgud","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" Lù Yīnɡ"}]},{"ID":"20240613113824-eay7f6r","Type":"NodeParagraph","Properties":{"id":"20240613113824-eay7f6r","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613113824-shshmxq","Type":"NodeParagraph","Properties":{"id":"20240613113824-shshmxq","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 蒴藋、接骨草、排风藤、铁篱笆、臭草、苛草、英雄草、走马箭、排风草、八棱麻、大臭草、七叶麻、马鞭三七、落得打、珍珠连、秧心草、乌鸡腿、小接骨丹、水马桑、七叶根、水椿皮、七爪阳姜、屎缸杖、掌落根、散血椒、梭草、七叶莲、七叶黄香"}]},{"ID":"20240613113824-86e3zvd","Type":"NodeParagraph","Properties":{"id":"20240613113824-86e3zvd","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613113824-btui12f","Type":"NodeParagraph","Properties":{"id":"20240613113824-btui12f","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" Chinese Elder Herb"}]},{"ID":"20240613113824-2mlk7gg","Type":"NodeParagraph","Properties":{"id":"20240613113824-2mlk7gg","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613113824-5l6a2c9","Type":"NodeParagraph","Properties":{"id":"20240613113824-5l6a2c9","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613113824-ltcf2es","Type":"NodeParagraph","Properties":{"id":"20240613113824-ltcf2es","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613113824-3l4n8dj","Type":"NodeParagraph","Properties":{"id":"20240613113824-3l4n8dj","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 药材基源：为忍冬科植物陆英的茎叶。"}]},{"ID":"20240613113824-exi1c8p","Type":"NodeParagraph","Properties":{"id":"20240613113824-exi1c8p","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dambucus chinensis Lindl. [S.jauanica auct. Non Reinw .ex Bl.]"}]},{"ID":"20240613113824-n5lbpb2","Type":"NodeParagraph","Properties":{"id":"20240613113824-n5lbpb2","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季采收，切段，鲜用或晒干。"}]},{"ID":"20240613113824-g48g3mn","Type":"NodeParagraph","Properties":{"id":"20240613113824-g48g3mn","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613113824-29w0n7u","Type":"NodeParagraph","Properties":{"id":"20240613113824-29w0n7u","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于林下、沟边或山坡草丛，也有栽种。"}]},{"ID":"20240613113824-zfbrmrb","Type":"NodeParagraph","Properties":{"id":"20240613113824-zfbrmrb","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于河北、陕西、甘肃、青海、江苏、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240613113824-s146e88","Type":"NodeParagraph","Properties":{"id":"20240613113824-s146e88","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613113824-uze8ymn","Type":"NodeParagraph","Properties":{"id":"20240613113824-uze8ymn","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 陆英 高大草本或半灌木，高达2m。茎有棱条，髓部白色。奇数羽状状得叶对生；托叶小、线形或呈腺状突起；小叶5-9，最上1对小叶片基部相互全生，有时还和顶生小叶相连，小叶片披针形，长5-15cm，宽2-4cm，先端长而渐尖，基部钝圆，两侧常不对称，边缘具细锯齿，近基部或中部以下边缘常有1或数枚遥齿；小叶柄短。大型复伞房花序顶生；各级总梗和花梗无毛至多少有毛，具由不孕花变成的黄色杯状腺体；苞片和小苞片线形至线状披针形，长4-5mm；花小、萼筒杯状，长约1.5mm，萼齿三角形，长约0.5mm；花冠辐状，冠筒长约1mm，花冠裂片卵形，长约2mm，反曲；花药黄色或紫色；子房3室，花柱极短，柱头3裂。浆果红果，近球形，直径3-4mm；核2-3粒，卵形，长约2.5mm，表面小疣状突起。花期4-5月，果期8-9月。"}]},{"ID":"20240613113824-50njf34","Type":"NodeParagraph","Properties":{"id":"20240613113824-50njf34","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613113824-d78wfu6","Type":"NodeParagraph","Properties":{"id":"20240613113824-d78wfu6","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜阴湿环境，对土壤要求不严，房前、屋后、边地、山坡等处均可栽种。"}]},{"ID":"20240613113824-43km8bq","Type":"NodeParagraph","Properties":{"id":"20240613113824-43km8bq","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"栽培技术 繁殖方法：主要用分根繁殖。2月中旬将地下根茎挖起，选粗壮（径约5cm）带芽者，煎成10-20cm长根段备用。按沟距24-33cm，沟深10cm，开成横沟，然后将根段横向按在沟内，上盖垃圾泥和焦泥灰，再覆土压实。"}]},{"ID":"20240613113824-2bsmj0s","Type":"NodeParagraph","Properties":{"id":"20240613113824-2bsmj0s","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"田间管理 苗出后追施猪粪或人粪肥1次，要适当除草和松土。"}]},{"ID":"20240613113824-r0ppf8j","Type":"NodeParagraph","Properties":{"id":"20240613113824-r0ppf8j","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613113824-7mlm663","Type":"NodeParagraph","Properties":{"id":"20240613113824-7mlm663","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎具细纵棱，呈类圆柱形而粗壮，多分枝，直径约1cm。表面灰色至灰黑色。幼枝复叶，小叶2-3对，互生或对生；小叶往纸质，易破碎，多皱缩，展平后呈狭卵形至卵状披针形，先端长渐尖，基部钝圆，两侧不等，边缘有细锯齿。鲜叶片揉之有臭气。气微，味微苦。"}]},{"ID":"20240613113824-gi41mco","Type":"NodeParagraph","Properties":{"id":"20240613113824-gi41mco","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"以茎质嫩、叶多、色绿者为佳。"}]},{"ID":"20240613113824-1nz6tdu","Type":"NodeParagraph","Properties":{"id":"20240613113824-1nz6tdu","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613113824-f6teira","Type":"NodeParagraph","Properties":{"id":"20240613113824-f6teira","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 煎剂灌胃，对小鼠的LD50为820g/kg，腹腔注射为119g/kg。毒性成分体内半衰期为6.9h。"}]},{"ID":"20240613113824-ceid7lx","Type":"NodeParagraph","Properties":{"id":"20240613113824-ceid7lx","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613113824-5jh09bx","Type":"NodeParagraph","Properties":{"id":"20240613113824-5jh09bx","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 陆英全草含黄酮类、酚性成分、鞣质、糖类、绿原酸（chlorogenic acid），种子含氰甙类[1]。"}]},{"ID":"20240613113824-c1vs7dj","Type":"NodeParagraph","Properties":{"id":"20240613113824-c1vs7dj","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613113824-tv3tlrl","Type":"NodeParagraph","Properties":{"id":"20240613113824-tv3tlrl","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 1.镇痛：陆英煎剂70、120、140g/kg灌服，对小鼠热板法试验表明有镇痛作用，其镇痛成分体内半衰期为3.9h。"}]},{"ID":"20240613113824-x6pdvh1","Type":"NodeParagraph","Properties":{"id":"20240613113824-x6pdvh1","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"2.抗肝损伤：陆英成分熊果酸100mg/kg皮下注射，对大鼠实验性肝损伤有保护作用，使肝中甘油三酯含量减少，并减轻肝细胞变性及坏死。"}]},{"ID":"20240613113824-vtdtpvi","Type":"NodeParagraph","Properties":{"id":"20240613113824-vtdtpvi","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"3.其他作用：煎剂5g/kg灌胃，并加酒调外敷，对实验性骨折兔，有活血散瘀、增加磷的吸收、促进骨痂骨化的作用。"}]},{"ID":"20240613113824-nvvjkp8","Type":"NodeParagraph","Properties":{"id":"20240613113824-nvvjkp8","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613113824-ech6ql2","Type":"NodeParagraph","Properties":{"id":"20240613113824-ech6ql2","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 味甘；微苦；性平"}]},{"ID":"20240613113824-vympcgi","Type":"NodeParagraph","Properties":{"id":"20240613113824-vympcgi","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613113824-0nkwqg4","Type":"NodeParagraph","Properties":{"id":"20240613113824-0nkwqg4","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 孕妇禁服。"}]},{"ID":"20240613113824-2ilny2o","Type":"NodeParagraph","Properties":{"id":"20240613113824-2ilny2o","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613113824-xb9vjug","Type":"NodeParagraph","Properties":{"id":"20240613113824-xb9vjug","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 祛风；利湿；舒筋；活血。主风温痹痛；腰腿痛；水肿；黄疸；跌打扣损伤；产后恶露不行；风疹瘙痒；丹毒；疮肿"}]},{"ID":"20240613113824-k0s4o2m","Type":"NodeParagraph","Properties":{"id":"20240613113824-k0s4o2m","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613113824-zci0nrq","Type":"NodeParagraph","Properties":{"id":"20240613113824-zci0nrq","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g，鲜品60-120g。外用：适量，捣敷；或煎水洗；或研末调敷。"}]},{"ID":"20240613113824-1ae0kdv","Type":"NodeParagraph","Properties":{"id":"20240613113824-1ae0kdv","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613113824-yf13tgo","Type":"NodeParagraph","Properties":{"id":"20240613113824-yf13tgo","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主骨间诸痹，四肢拘孪疼酸，膝寒痛，阴痿，短气不足，脚肿。"}]},{"ID":"20240613113824-5dgfubp","Type":"NodeParagraph","Properties":{"id":"20240613113824-5dgfubp","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：能捋风毒，脚气上冲，心烦闷绝。主水气虚肿，风瘙皮肌恶痒，煎取汤入少酒可浴之妙。"}]},{"ID":"20240613113824-umw16fs","Type":"NodeParagraph","Properties":{"id":"20240613113824-umw16fs","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613113824-3f1f6bh","Type":"NodeParagraph","Properties":{"id":"20240613113824-3f1f6bh","updated":"20240613113824"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613113825-01saqhh","Type":"NodeThematicBreak","Properties":{"id":"20240613113825-01saqhh"}},{"ID":"20240613113826-ww65slp","Type":"NodeParagraph","Properties":{"id":"20240613113826-ww65slp"}}]}