,"style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"重楼 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/重楼 9-20240826100702-8uma6tg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 650px;","style":"width: 640px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"重楼 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/重楼 10-20240826100728-txp23c0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 640px;\" parent-style=\"width: 650px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826100336-z4c2rf5","Type":"NodeParagraph","Properties":{"id":"20240826100336-z4c2rf5","updated":"20240826100344"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 426px;","style":"width: 416px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"重楼 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/重楼 3-20240826100111-zjsooq0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 416px;\" parent-style=\"width: 426px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 322px;","style":"width: 312px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶一枝花2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶一枝花2-20240701174423-1plg8ho.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 312px;\" parent-style=\"width: 322px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶一枝花8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶一枝花8-20240701175944-j6bp5nf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625095714-u2mmbcx","Type":"NodeParagraph","Properties":{"id":"20240625095714-u2mmbcx","updated":"20240826100213"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 562px;","style":"width: 552px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶一枝花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶一枝花-20240625095713-la1m0rz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 552px;\" parent-style=\"width: 562px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 602px;","style":"width: 592px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶一枝花6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶一枝花6-20240701175815-vzojc76.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240826100316-mw7gqcx","Type":"NodeParagraph","Properties":{"id":"20240826100316-mw7gqcx","updated":"20240826100620"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 307px;","style":"width: 297px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"重楼 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/重楼 6-20240826100458-dyryqfu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 297px;\" parent-style=\"width: 307px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"重楼 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/重楼 8-20240826100613-9v8xa7o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826100623-tssiu38","Type":"NodeParagraph","Properties":{"id":"20240826100623-tssiu38","updated":"20240826100631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上图片未按品种分类；"}]},{"ID":"20240613112943-rbf2uzs","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-rbf2uzs"}},{"ID":"20240613113216-pf1nlqa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113216-pf1nlqa","updated":"20240613113220"},"Children":[{"Type":"NodeText","Data":"蚤休《神农本草经》"}]},{"ID":"20240613113216-so4j17y","Type":"NodeParagraph","Properties":{"id":"20240613113216-so4j17y","updated":"20240613113216"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240613113216-dgwzo5p","Type":"NodeParagraph","Properties":{"id":"20240613113216-dgwzo5p","updated":"20240613113216"},"Children":[{"Type":"NodeText","Data":"主惊痫，摇头弄舌，热气在腹中，瘨疾，痈创，阴蚀，下三虫，去蛇毒。一名蚩休。生川谷。"}]},{"ID":"20240613113216-daxpp3g","Type":"NodeParagraph","Properties":{"id":"20240613113216-daxpp3g","updated":"20240613113216"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生山阳及冤句。"}]},{"ID":"20240613113216-1oldzrr","Type":"NodeParagraph","Properties":{"id":"20240613113216-1oldzrr","updated":"20240613113216"},"Children":[{"Type":"NodeText","Data":"案郑樵云：蚤休，日螫休，曰重楼金绵，曰重台，曰草，甘遂，今人谓之紫河车，服食家所用，而茎叶亦可爱，多植庭院间。"}]},{"ID":"20240613113252-u7o4nid","Type":"NodeThematicBreak","Properties":{"id":"20240613113252-u7o4nid"}},{"ID":"20240613113253-ku0daqm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113253-ku0daqm","updated":"20240613113300"},"Children":[{"Type":"NodeText","Data":"蚤休《神农本草经赞》"}]},{"ID":"20240613113253-cz17v29","Type":"NodeParagraph","Properties":{"id":"20240613113253-cz17v29","updated":"20240613113253"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主惊痫。摇头弄舌。热气在腹中。疾痈创。阴蚀。下三虫。去蛇毒。一名蚩休。生川谷。"}]},{"ID":"20240613113253-ix7vgux","Type":"NodeParagraph","Properties":{"id":"20240613113253-ix7vgux","updated":"20240613113253"},"Children":[{"Type":"NodeText","Data":"如转河车。休哉蚤捷。七叶一枝。重台三叠。掌运趺承。头昂舌贴。气朗天清。长生陈牒。"}]},{"ID":"20240613113253-3hc69se","Type":"NodeParagraph","Properties":{"id":"20240613113253-3hc69se","updated":"20240613113253"},"Children":[{"Type":"NodeText","Data":"苏颂曰。一名紫河车。李时珍曰。虫蛇之毒治之。即休。故有此名。陈嘉谟曰。一名七叶一枝花。苏恭曰。一名重台。叶有二三层者。日华子曰。治胎风。手足搐掣。服食经。紫河车。根切块。水煮。风干。每服三丸。五更初。面东致祝。连进三服。即能休粮。祝辞曰。天朗气清金鸡鸣。吾今服药欲长生。"}]},{"ID":"20240613113306-wtemzf5","Type":"NodeThematicBreak","Properties":{"id":"20240613113306-wtemzf5"}},{"ID":"20240613113307-99pwxbv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113307-99pwxbv","updated":"20240613113311"},"Children":[{"Type":"NodeText","Data":"蚤休《本草衍义》"}]},{"ID":"20240613113307-nl8kms2","Type":"NodeParagraph","Properties":{"id":"20240613113307-nl8kms2","updated":"20240613113307"},"Children":[{"Type":"NodeText","Data":"蚤休无旁枝，只一茎，挺生，高尺余，颠有四五叶，叶有歧，似虎杖。中心又起茎，亦如是生叶，惟根入药用。"}]},{"ID":"20240613113327-o8iyxkr","Type":"NodeThematicBreak","Properties":{"id":"20240613113327-o8iyxkr"}},{"ID":"20240613113328-wqs6883","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113328-wqs6883","updated":"20240613113333"},"Children":[{"Type":"NodeText","Data":"蚤休《得配本草》"}]},{"ID":"20240613113328-vmtwcwh","Type":"NodeParagraph","Properties":{"id":"20240613113328-vmtwcwh","updated":"20240613113328"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名紫河车，一名草甘遂，一名白甘遂"}]},{"ID":"20240613113328-pvdmuzl","Type":"NodeParagraph","Properties":{"id":"20240613113328-pvdmuzl","updated":"20240613113328"},"Children":[{"Type":"NodeText","Data":"伏雄黄、丹砂、硼砂及盐。"}]},{"ID":"20240613113328-s5fqorl","Type":"NodeParagraph","Properties":{"id":"20240613113328-s5fqorl","updated":"20240613113328"},"Children":[{"Type":"NodeText","Data":"苦，寒，有毒。入足厥阴经。治惊痫癫疾，疟疾寒热，及阴蚀痈肿，瘰 蛇毒。研末冷水服五分，治小儿胎风，手足搐搦。"}]},{"ID":"20240613113328-l8pt04v","Type":"NodeParagraph","Properties":{"id":"20240613113328-l8pt04v","updated":"20240613113328"},"Children":[{"Type":"NodeText","Data":"洗净焙用。醋磨，敷痈肿蛇毒甚效。此系毒草，不可轻服。"}]},{"ID":"20240613113316-9t89fwr","Type":"NodeThematicBreak","Properties":{"id":"20240613113316-9t89fwr"}},{"ID":"20240613113318-8aq1zoq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113318-8aq1zoq","updated":"20240613113323"},"Children":[{"Type":"NodeText","Data":"蚤休《本经逢原》"}]},{"ID":"20240613113318-w8jkhqs","Type":"NodeParagraph","Properties":{"id":"20240613113318-w8jkhqs","updated":"20240613113318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即草紫河车，金线重楼，俗名七叶一枝花"}]},{"ID":"20240613113318-zthqr2q","Type":"NodeParagraph","Properties":{"id":"20240613113318-zthqr2q","updated":"20240613113318"},"Children":[{"Type":"NodeText","Data":"苦微寒，有毒。"}]},{"ID":"20240613113318-s36611r","Type":"NodeParagraph","Properties":{"id":"20240613113318-s36611r","updated":"20240613113318"},"Children":[{"Type":"NodeText","Data":"《本经》主惊痫摇头弄舌，热气在腹中。"}]},{"ID":"20240613113318-egqxsqe","Type":"NodeParagraph","Properties":{"id":"20240613113318-egqxsqe","updated":"20240613113318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"蚤休，足厥阴经药，能治惊痫疟疾，瘰 痈肿，详《本经》主治，总取开结导热，而惊痫摇头弄舌之热邪自除。阳气虚者禁用，醋磨敷痈肿蛇毒有效。"}]},{"ID":"20240613113239-pbnl9jb","Type":"NodeThematicBreak","Properties":{"id":"20240613113239-pbnl9jb"}},{"ID":"20240613113240-usgkd9v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113240-usgkd9v","updated":"20240613113245"},"Children":[{"Type":"NodeText","Data":"蚤休《药性切用》"}]},{"ID":"20240613113240-sv4hc47","Type":"NodeParagraph","Properties":{"id":"20240613113240-sv4hc47","updated":"20240613113240"},"Children":[{"Type":"NodeText","Data":"一名重楼金线。味苦微寒，专治痈疽、蛇毒，为外科专药。"}]},{"ID":"20240613113228-37b5voi","Type":"NodeThematicBreak","Properties":{"id":"20240613113228-37b5voi"}},{"ID":"20240613113229-ufcfnyx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113229-ufcfnyx","updated":"20240613113234"},"Children":[{"Type":"NodeText","Data":"蚤休《本草便读》"}]},{"ID":"20240613113229-cxsnafn","Type":"NodeParagraph","Properties":{"id":"20240613113229-cxsnafn","updated":"20240613113229"},"Children":[{"Type":"NodeText","Data":"痈毒能消．味苦寒而散结．热瘀可化．杀虫积以通肝．（蚤休苦寒有毒．其苗一茎直上．每层七叶．至顶而花．根如菖蒲之根．入肝经．凉血散瘀．故能消痈杀虫毒．至其能治惊痰等证．大抵亦因郁热而然耳．）"}]},{"ID":"20240613112943-x4tk2j1","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-x4tk2j1"}},{"ID":"20240613113206-j2f9ljj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113206-j2f9ljj","updated":"20240613113210"},"Children":[{"Type":"NodeText","Data":"蚤休《本草从新》"}]},{"ID":"20240613113206-sacagtg","Type":"NodeParagraph","Properties":{"id":"20240613113206-sacagtg","updated":"20240613113206"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名重楼金线．"}]},{"ID":"20240613113206-6ps1om8","Type":"NodeParagraph","Properties":{"id":"20240613113206-6ps1om8","updated":"20240613113206"},"Children":[{"Type":"NodeText","Data":"味苦微寒．专理痈疽．除虫蛇毒．（谚云∶七叶一枝花、深山是我家、痈疽如遇者、一似手拈拿、苏恭曰∶磨醋、敷痈肿蛇毒、甚有效、时珍曰∶虫蛇之毒、得此治之即休、故有蚤休、螫休诸名．）兼疗惊痫．苦寒之品．中病即止．不宜多用．"}]},{"ID":"20240613112943-ps5oif0","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-ps5oif0"}},{"ID":"20240613113154-d10oktw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113154-d10oktw","updated":"20240613113200"},"Children":[{"Type":"NodeText","Data":"蚤休《本草图经》"}]},{"ID":"20240613113154-f8bo7j5","Type":"NodeParagraph","Properties":{"id":"20240613113154-f8bo7j5","updated":"20240613113157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蚤休"},{"Type":"NodeText","Data":"，即紫河车也，俗呼重楼金线。生山阳川谷及冤句，今河中、河阳、华、凤、文州及江淮间亦有之。苗叶似王孙、鬼臼等，作二、三层；六月开黄紫花，蕊赤黄色，上有金丝垂下；秋结红子；根似肥姜，皮赤肉白。四月、五月采根。日干用。"}]},{"ID":"20240613112943-21kzkin","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-21kzkin"}},{"ID":"20240613113144-7a6wpt2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113144-7a6wpt2","updated":"20240613113148"},"Children":[{"Type":"NodeText","Data":"蚤休《冯氏锦囊秘录》"}]},{"ID":"20240613113144-wtng4o4","Type":"NodeParagraph","Properties":{"id":"20240613113144-wtng4o4","updated":"20240613113144"},"Children":[{"Type":"NodeText","Data":"味苦寒，入肝经。"}]},{"ID":"20240613113144-uygeo86","Type":"NodeParagraph","Properties":{"id":"20240613113144-uygeo86","updated":"20240613113144"},"Children":[{"Type":"NodeText","Data":"蚤休，一名金钱重楼，一名紫河车草。其根似肥姜，治惊痫，摇头弄舌，湿热发肿作疮，下三虫解百毒。或摩酒饮，或摩醋敷，古人歌云∶“七叶一枝花，深山是我家，痈疽如遇此，一似手拈拿。”观此，则善治痈毒之功可知矣。"}]},{"ID":"20240613112943-hebsnjz","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-hebsnjz"}},{"ID":"20240613113136-iqj5fnt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113136-iqj5fnt","updated":"20240613113139"},"Children":[{"Type":"NodeText","Data":"蚤休《千金翼方》"}]},{"ID":"20240613113136-ju6a7w2","Type":"NodeParagraph","Properties":{"id":"20240613113136-ju6a7w2","updated":"20240613113136"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主惊痫，摇头弄舌，热气在腹中，癫疾痈疮，阴蚀，下三虫，去蛇毒。一名蚩休。生山阳川谷及冤句。"}]},{"ID":"20240613112943-u7ivap6","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-u7ivap6"}},{"ID":"20240613113126-p1jy4sb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113126-p1jy4sb","updated":"20240613113131"},"Children":[{"Type":"NodeText","Data":"蚤休《新修本草》"}]},{"ID":"20240613113126-5kedntf","Type":"NodeParagraph","Properties":{"id":"20240613113126-5kedntf","updated":"20240613113126"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主惊痫，摇头弄舌，热气在腹中，癫疾，痈疮阴蚀，下三虫，去蛇毒。一名蚩休。生山阳川谷及宛朐。"}]},{"ID":"20240613113126-m5v57d4","Type":"NodeParagraph","Properties":{"id":"20240613113126-m5v57d4","updated":"20240613113126"},"Children":[{"Type":"NodeText","Data":"〔谨案〕今谓重楼者是也。一名重台，南人名草甘遂，苗似王孙、鬼臼等，有二、三层。根如肥大菖蒲，细肌脆白，醋摩疗痈肿，敷蛇毒，有效。"}]},{"ID":"20240613112943-3l4rfap","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-3l4rfap"}},{"ID":"20240613113113-3l3yr4c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113113-3l3yr4c","updated":"20240613113120"},"Children":[{"Type":"NodeText","Data":"蚤休《本草纲目》"}]},{"ID":"20240613113113-zfwabbv","Type":"NodeParagraph","Properties":{"id":"20240613113113-zfwabbv","updated":"20240613113113"},"Children":[{"Type":"NodeText","Data":"「释名」蚩休、螫休、紫河车、重台、重楼金线、三层草、七叶一枝花、草甘遂、白甘遂。"}]},{"ID":"20240613113113-gci4lvd","Type":"NodeParagraph","Properties":{"id":"20240613113113-gci4lvd","updated":"20240613113113"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、微寒、有毒。"}]},{"ID":"20240613113113-g6iqpnm","Type":"NodeParagraph","Properties":{"id":"20240613113113-g6iqpnm","updated":"20240613113113"},"Children":[{"Type":"NodeText","Data":"「主治」惊阐、瘰疬、痈肿。磨醋敷痈肿蛇毒，甚有效。"}]},{"ID":"20240613112943-kv4hca7","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-kv4hca7"}},{"ID":"20240613113104-1u36guv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113104-1u36guv","updated":"20240613113108"},"Children":[{"Type":"NodeText","Data":"蚤休《本草崇原》"}]},{"ID":"20240613113104-24ej8rr","Type":"NodeParagraph","Properties":{"id":"20240613113104-24ej8rr","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，有毒。主治惊痫，摇头弄舌，热气在腹中。"}]},{"ID":"20240613113104-rowygy5","Type":"NodeParagraph","Properties":{"id":"20240613113104-rowygy5","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"（蚤休《图经》名紫河车，《唐本草》名重楼、金线，后人名三层草，又名七叶一枝花。"}]},{"ID":"20240613113104-fhh8ixs","Type":"NodeParagraph","Properties":{"id":"20240613113104-fhh8ixs","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"处处有之，多生深山阴湿之地。一茎独上，高尺余，茎当叶心，叶绿色似芍药，凡二三层，每一层七叶，茎头于夏月开花，一花七瓣，花黄紫色，蕊赤黄色，长三四寸，上有金线垂下，秋结红子，根似肥姜，皮赤肉白。谚云∶七叶一枝花，深山是我家，痈疽如迂者，一似手拈拿。又，道家有服食紫河车根法云∶可以休粮。）"}]},{"ID":"20240613113104-glci47s","Type":"NodeParagraph","Properties":{"id":"20240613113104-glci47s","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"一者水之生数也，七者火之成数也，三者一奇二偶，合而为三也。蚤休三层，一层七叶，一七瓣，禀先天水火之精，故主治惊痫，摇头弄舌。惊痫而摇头弄舌，乃小儿胎惊胎痫也。胎惊胎痫，乃热毒之气得于母腹之中，故曰∶热气在腹中。"}]},{"ID":"20240613113104-v1pp4pf","Type":"NodeParagraph","Properties":{"id":"20240613113104-v1pp4pf","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"愚按∶蚤休一名河车，服食此草，又能辟谷，为修炼元真，胎息长生之药，故主治小儿先天受热之病，学人得此义而推展之，则大人小儿后天之病，亦可治也。"}]},{"ID":"20240613113104-32hk04n","Type":"NodeParagraph","Properties":{"id":"20240613113104-32hk04n","updated":"20240613113104"},"Children":[{"Type":"NodeText","Data":"（按《日华本草》言∶紫河车治胎风手足搐，故隐庵解∶热气在腹中，谓热毒之气得于母腹弄舌，由小儿内热所致，不必作深一层解亦可。苏恭曰∶醋磨傅痈肿蛇毒甚效。）"}]},{"ID":"20240613112943-a8wn2r2","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-a8wn2r2"}},{"ID":"20240613113049-m5fx2rb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113049-m5fx2rb","updated":"20240613113059"},"Children":[{"Type":"NodeText","Data":"蚤休《医学入门》"}]},{"ID":"20240613113049-crsal6t","Type":"NodeParagraph","Properties":{"id":"20240613113049-crsal6t","updated":"20240613113049"},"Children":[{"Type":"NodeText","Data":"蚤休味苦气微寒，惊搐癫痫弄舌端，疮痈瘰 皆堪用，杀虫解毒不等闲。"}]},{"ID":"20240613113049-qw9hpj6","Type":"NodeParagraph","Properties":{"id":"20240613113049-qw9hpj6","updated":"20240613113049"},"Children":[{"Type":"NodeText","Data":"即紫河车，又名重楼金线。初夏早采根，日干为美。有毒。主惊痫、摇头弄舌、胎风手足抽搐，热气在腹，癫疾。杀三虫，解百毒，能吐泻人堕胎。古方治痈毒蛇毒，醋磨外敷，酒磨内服。"}]},{"ID":"20240613112943-5emr40g","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-5emr40g"}},{"ID":"20240613113039-meyt7t9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613113039-meyt7t9","updated":"20240613113044"},"Children":[{"Type":"NodeText","Data":"蚤休《本草乘雅半偈》"}]},{"ID":"20240613113039-4aqle5i","Type":"NodeParagraph","Properties":{"id":"20240613113039-4aqle5i","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613113039-swmly7n","Type":"NodeParagraph","Properties":{"id":"20240613113039-swmly7n","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"【气味】苦微寒，有毒。"}]},{"ID":"20240613113039-fh8gqde","Type":"NodeParagraph","Properties":{"id":"20240613113039-fh8gqde","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"【主治】主惊痫，摇头弄舌，热气在腹中。"}]},{"ID":"20240613113039-zvbml78","Type":"NodeParagraph","Properties":{"id":"20240613113039-zvbml78","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出山阳川谷，及冤句。今河中、河阳、华、凤、文州，及江淮间亦有之。生深山阴湿地，即紫河车、重楼金线、七叶一枝花也。一茎独上，茎当叶心。似王孙、鬼臼、芍药、蓖麻辈叶。凡一茎三层，独王屋山产者，至五七层，每层七叶，叶色碧绿。夏月茎头作花，一花七瓣，上有金丝下垂，蕊长三四寸，秋结红子，根如鬼臼，及紫参、苍术、菖蒲等状，外紫中白，理细质脆，有粳糯两种。修治，洗切焙用。丹家采制三黄、砂、汞。"}]},{"ID":"20240613113039-rz2xroy","Type":"NodeParagraph","Properties":{"id":"20240613113039-rz2xroy","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"【 】曰∶蚤休，阳草也。以生成功用诠名。礼记云∶发扬蹈厉之已蚤，使之休止休息尔。一茎独上，茎当叶心，叶必七，花瓣亦七，重台或一或三，或五或七，正阳数之生，火数之成也。味苦气寒，生深山阴湿处，是阳以阴为用矣。对待阴以阳用，致热在中，若风自火出，而弄舌摇头，及阳蹈阴中而痫，阴越阳中而惊，此皆阴阳舛错，越动静之尝故尔。所谓发扬蹈厉之已蚤，使之休止休息也。"}]},{"ID":"20240613113039-oo37om5","Type":"NodeParagraph","Properties":{"id":"20240613113039-oo37om5","updated":"20240613113039"},"Children":[{"Type":"NodeText","Data":"（头为诸阳之首，舌乃心火之苗，盖动摇名风，若风之自火出也。）"}]},{"ID":"20240613112943-r925bfq","Type":"NodeThematicBreak","Properties":{"id":"20240613112943-r925bfq"}},{"ID":"20240613112944-jrhtfcd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112944-jrhtfcd","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蚤休"}]},{"ID":"20240613112944-z54qy6s","Type":"NodeParagraph","Properties":{"id":"20240613112944-z54qy6s","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613112944-1vcqi3p","Type":"NodeParagraph","Properties":{"id":"20240613112944-1vcqi3p","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" Zǎo Xiū"}]},{"ID":"20240613112944-5chkb2d","Type":"NodeParagraph","Properties":{"id":"20240613112944-5chkb2d","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613112944-hs0pu82","Type":"NodeParagraph","Properties":{"id":"20240613112944-hs0pu82","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 蚩休（《别录》），重楼、重台、草甘遂（《唐本草》），螫休（《日华子本草》），紫河车、重楼金线（《本草图经》），白甘遂（《小儿药证直诀》），重台草（《圣惠方》），独脚莲（《滇南本草》），三层草（《纲目》），草河车（《植物名实图考》），九道箍、铁灯盏、七叶一盏灯、鸳鸯虫（《分类草药性》），双层楼（《福建民间草药》），多叶重楼、七子莲、铁灯台、枝花头（《广西中兽医药植》），九层楼（《广西药植图志》），螺丝七、海螺七、灯台七（《陕西中药志》），七层塔、八角盘、孩儿掏伞（《闽东本草》），金盘托荔枝、金盘托"}]},{"ID":"20240613112944-afpli2o","Type":"NodeParagraph","Properties":{"id":"20240613112944-afpli2o","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613112944-l2jgtl3","Type":"NodeParagraph","Properties":{"id":"20240613112944-l2jgtl3","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613112944-tj9ru6a","Type":"NodeParagraph","Properties":{"id":"20240613112944-tj9ru6a","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613112944-3w6hc33","Type":"NodeParagraph","Properties":{"id":"20240613112944-3w6hc33","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"七叶一枝花、金线重楼"},{"Type":"NodeText","Data":"及其数种同属植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。全年可采。挖取根茎，洗净，削去须根，晒干或烘干。"}]},{"ID":"20240613112944-z9bw3ce","Type":"NodeParagraph","Properties":{"id":"20240613112944-z9bw3ce","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613112944-3rps5as","Type":"NodeParagraph","Properties":{"id":"20240613112944-3rps5as","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 产广西、四川、云南、陕西等地。"}]},{"ID":"20240613112944-qrkce2o","Type":"NodeParagraph","Properties":{"id":"20240613112944-qrkce2o","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613112944-cpr7fn6","Type":"NodeParagraph","Properties":{"id":"20240613112944-cpr7fn6","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①七叶一枝花（《本草蒙筌》）"}]},{"ID":"20240613112944-4tqw3od","Type":"NodeParagraph","Properties":{"id":"20240613112944-4tqw3od","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"多年生直立草本，全体光滑无毛，高30～100厘米。根茎肥厚，黄褐色，结节明显，具鳞片状叶及众多须根。茎单一，青紫色或紫红色，直径约1厘米，基部有膜质叶鞘包茎。叶轮生茎顶，4～9片，通常为7片，长椭圆形或椭圆状披针形，长9～23厘米，宽2.5～7厘米，先端渐尖或短尖，全缘，基部楔形，膜质或薄纸质，绿色，有时下面带紫色；主脉3条基出。花单生顶端，花梗青紫色或紫红色；外列被片绿色，叶状，4～7片，长卵形至卵状披针形，长3～5厘米，宽1～1.5厘米，先端渐尖；内列被片与外列同数，黄色或黄绿色，线形，宽约1毫米，一般短于外列被片：雄蕊数与花被片同，花丝扁平，长3～5毫米，花药线形，金黄色，纵裂，长于花丝2～3倍，药隔在药上略延长、或无；子房上位，具4～6棱，花柱短，先端4～7裂，向外反卷；胚珠每室多数。蒴果球形，熟时黄褐色，3～6瓣裂，直径2～2.4厘米，内含多数鲜红色卵形种子。花期4～7月。果期8～11月。"}]},{"ID":"20240613112944-xia9cr9","Type":"NodeParagraph","Properties":{"id":"20240613112944-xia9cr9","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"生长于山区山坡、林下或溪边湿地。分布江苏、浙江、福建、江西、安徽、湖北、四川，贵州、云南、广东、广西等地。"}]},{"ID":"20240613112944-q86bptl","Type":"NodeParagraph","Properties":{"id":"20240613112944-q86bptl","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②金钱重楼（《本草蒙筌》）"}]},{"ID":"20240613112944-qznh57x","Type":"NodeParagraph","Properties":{"id":"20240613112944-qznh57x","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"多年生草本，高约60厘米。根茎横生，肥大，表面粗糙，节明显，每节上有纤维状须根，断面粉质。茎由根茎顶端生出，单一，圆柱形，基部带紫色。叶5～11片，一般为7片，轮生于茎顶，叶片长圆形或倒披针形，长7～15厘米，宽3～5厘米，叶柄常带红色。夏季茎顶抽出花梗，顶生花一朵；外轮花被片4～6片，卵状披针形，内轮花被片线形，与外轮花被片同数，长于外轮花被片；雄蕊亦与花被片同数，淡黄色；花柱4～5，子房8～10室。浆果状蒴果近球形，有角棱，成熟时带紫色。花期6～7月。果期8～10月。"}]},{"ID":"20240613112944-p757aol","Type":"NodeParagraph","Properties":{"id":"20240613112944-p757aol","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"生于山区林下或山谷、溪涧边阴湿处。分布云南、广东、湖北、四川、陕西、安徽、江苏等地。"}]},{"ID":"20240613112944-nu5gpgo","Type":"NodeParagraph","Properties":{"id":"20240613112944-nu5gpgo","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"此外，尚有下列几种同属植物，亦同等入药："}]},{"ID":"20240613112944-ed9vmai","Type":"NodeParagraph","Properties":{"id":"20240613112944-ed9vmai","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"①阔瓣蚤休"}]},{"ID":"20240613112944-xuzrm44","Type":"NodeParagraph","Properties":{"id":"20240613112944-xuzrm44","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"叶6～8片，倒卵形或倒卵状披针形。花的外列被片绿色，4～5瓣，内列被片黄色，4～5瓣，线形而略呈披针状，中上部宽2～3毫米；花柱4～5短裂。分布四川、云南。"}]},{"ID":"20240613112944-dhe5g92","Type":"NodeParagraph","Properties":{"id":"20240613112944-dhe5g92","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②毛脉蚤休"}]},{"ID":"20240613112944-mu5oxm4","Type":"NodeParagraph","Properties":{"id":"20240613112944-mu5oxm4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"全株被白色糠粕状的细小短毛，有时近于光滑无毛。叶10～12片，线形至披针形，长7.5～14厘米，宽0.9～3厘米。花的外裂被片4～6瓣，内列被片黄色，4～6瓣，线形或丝状；花药线形，药隔显著超出药室。分布四川、云南。"}]},{"ID":"20240613112944-n78mxv5","Type":"NodeParagraph","Properties":{"id":"20240613112944-n78mxv5","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③狭叶蚤休"}]},{"ID":"20240613112944-gkuta6x","Type":"NodeParagraph","Properties":{"id":"20240613112944-gkuta6x","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"叶11～15片，线形至线状披针形，通常略弯曲呈镐刀状，长9.5～19厘米，宽5～9毫米。花的外列被片5～7瓣，线形或线状披针形，长3～8厘米，内列被片5～7瓣，线形，超出外列被片，有时或倍之；花药药隔延伸极短或无。分布四川、云南。"}]},{"ID":"20240613112944-nfh64vo","Type":"NodeParagraph","Properties":{"id":"20240613112944-nfh64vo","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"④云南重楼"}]},{"ID":"20240613112944-vgwlwyn","Type":"NodeParagraph","Properties":{"id":"20240613112944-vgwlwyn","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"叶几为革质，6～9片，椭圆形或倒卵形，长5～9厘米，宽2～5厘米。花的外列被片6～9瓣，内列被片线形，前端略宽大，长4～6厘米，宽1～2毫米；药隔延长。分布云南。"}]},{"ID":"20240613112944-3cbqpej","Type":"NodeParagraph","Properties":{"id":"20240613112944-3cbqpej","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑤滇王孙，又名：金沙重楼"}]},{"ID":"20240613112944-uk7ot9d","Type":"NodeParagraph","Properties":{"id":"20240613112944-uk7ot9d","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～50厘米。叶6～9片，长椭圆形至椭圆状披针形，长6～10厘米，宽1.5～2.5厘米。花柄短于叶片，长2～7厘米；外列被片4～5瓣，披针形，长2～3厘米，宽约5毫米，内列被片4～5瓣，狭线形，长约1厘米，暗紫色；雄蕊6～10，赤紫色，花药线形，药隔暗褐色，于花药顶端延伸约3毫米；子房有时具翼，花柱4或5枚。花期5～6月。分布云南、四川。"}]},{"ID":"20240613112944-no7990y","Type":"NodeParagraph","Properties":{"id":"20240613112944-no7990y","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑥轮叶王孙"}]},{"ID":"20240613112944-z9a2msz","Type":"NodeParagraph","Properties":{"id":"20240613112944-z9a2msz","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30余厘米。叶通常8片，轮生茎顶，披针形。花淡黄色，外列被片4瓣，叶状，内列被片4，丝状。"}]},{"ID":"20240613112944-hvgxati","Type":"NodeParagraph","Properties":{"id":"20240613112944-hvgxati","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"分布山西等地。"}]},{"ID":"20240613112944-l49ud2e","Type":"NodeParagraph","Properties":{"id":"20240613112944-l49ud2e","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613112944-f4lzwpb","Type":"NodeParagraph","Properties":{"id":"20240613112944-f4lzwpb","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 干燥根茎呈灰黄至灰褐色，圆柱形，略扁压，长4.5～8.5厘米，径2.5～3.5厘米，节结密生，呈盘状隆起，棕色鳞叶多已脱落，残留须根及其痕迹。茎基处下陷，时有灰白的残茎，周围密被棕色菲薄鳞叶。质坚实，不易折断。断面平坦，粉质，黄白色至浅灰黄色。气微，略有辣味。以粗壮、干燥者为佳。"}]},{"ID":"20240613112944-06zlzxq","Type":"NodeParagraph","Properties":{"id":"20240613112944-06zlzxq","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"蚤休商品，除云南、广西外，大部分地区习用蓼科蓼属拳参组多种植物的根茎-拳参。参见\"拳参\"条。"}]},{"ID":"20240613112944-spgb28c","Type":"NodeParagraph","Properties":{"id":"20240613112944-spgb28c","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613112944-skaizn0","Type":"NodeParagraph","Properties":{"id":"20240613112944-skaizn0","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 小鼠灌服煎剂30～60克/公斤，3天内未见死亡。小鼠每日灌服0.4克，每天3次，连续3天；或静脉注射0.2％0.4毫升/只，均无死亡。故毒性很低。"}]},{"ID":"20240613112944-whak64d","Type":"NodeParagraph","Properties":{"id":"20240613112944-whak64d","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"《南方主要有毒植物》：\"七叶一枝花有毒部位，地下茎，皮部含毒较多。中毒症状：恶心、呕吐、头痛，严重者引起痉挛。解救方法：㈠洗胃，导泻，内服稀醋酸，如痉挛则用解痉剂等，对症治疗；㈡广州草药医师介绍：用甘草五钱先煎水，后与白米醋、生姜汁各二两混和，一半含漱，一半内服。\""}]},{"ID":"20240613112944-j5vvqvb","Type":"NodeParagraph","Properties":{"id":"20240613112944-j5vvqvb","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613112944-f8k1h7c","Type":"NodeParagraph","Properties":{"id":"20240613112944-f8k1h7c","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 七叶一枝花根含蚤休甙、薯蓣皂甙，薯蓣皂甙元的3-葡萄糖甙、3-鼠李糖葡萄糖甙、3-鼠李糖阿拉伯糖葡萄糖甙和3-四糖甙，娠二烯醇酮-3-查考茄三糖甙等多种皂甙。"}]},{"ID":"20240613112944-yjpnuj5","Type":"NodeParagraph","Properties":{"id":"20240613112944-yjpnuj5","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613112944-1ogos1z","Type":"NodeParagraph","Properties":{"id":"20240613112944-1ogos1z","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①平喘、止咳作用"}]},{"ID":"20240613112944-8ceks3v","Type":"NodeParagraph","Properties":{"id":"20240613112944-8ceks3v","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"豚鼠口服七叶一枝花煎剂有明显平喘作用（组胺喷雾法）。提取物（共五种）在1/2～1/5半数致死量时即有明显平喘作用，效果与1/2半数致死量的氨茶碱相似。提取物之一为皂甙，另三种Liebermsnn反应阳性。小鼠灌服煎剂有明显止咳作用（二氧化硫引咳法），但无祛痰作用（酚红法）。"}]},{"ID":"20240613112944-4tckva9","Type":"NodeParagraph","Properties":{"id":"20240613112944-4tckva9","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240613112944-vxdef7q","Type":"NodeParagraph","Properties":{"id":"20240613112944-vxdef7q","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"蚤休（未注明品种）100％制剂在试管内对肠道杆菌和化脓性球菌等多种致病菌皆有抗菌作用，近来用煎剂未能证明其有抑菌作用。醇提取物7.8毫克/毫升在体外有杀灭钩端螺旋体作用，同浓度水煎剂则无此作用。用鸡胚接种法证明水或醇提取物对甲型及亚洲甲型流感病毒都有抑制作用，稀释至1：1万至1：10万仍有效，小鼠用蚤休药液滴鼻，5小时后接种病毒，其死亡率比对照组略低。蚤休中含取质，其抗病毒作用与之有重要关系。"}]},{"ID":"20240613112944-0gay2cr","Type":"NodeParagraph","Properties":{"id":"20240613112944-0gay2cr","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613112944-qlkfrcu","Type":"NodeParagraph","Properties":{"id":"20240613112944-qlkfrcu","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 入心、肝经。"}]},{"ID":"20240613112944-zmngshi","Type":"NodeParagraph","Properties":{"id":"20240613112944-zmngshi","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"足厥阴经。\""}]},{"ID":"20240613112944-pi89exp","Type":"NodeParagraph","Properties":{"id":"20240613112944-pi89exp","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心经。\""}]},{"ID":"20240613112944-ocx4rch","Type":"NodeParagraph","Properties":{"id":"20240613112944-ocx4rch","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肺经。\""}]},{"ID":"20240613112944-ok86r0m","Type":"NodeParagraph","Properties":{"id":"20240613112944-ok86r0m","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613112944-8v1m0ng","Type":"NodeParagraph","Properties":{"id":"20240613112944-8v1m0ng","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒，有毒。"}]},{"ID":"20240613112944-ypj04ex","Type":"NodeParagraph","Properties":{"id":"20240613112944-ypj04ex","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，微寒。\""}]},{"ID":"20240613112944-1bsbtkl","Type":"NodeParagraph","Properties":{"id":"20240613112944-1bsbtkl","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有毒。\""}]},{"ID":"20240613112944-bvathhy","Type":"NodeParagraph","Properties":{"id":"20240613112944-bvathhy","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"冷，无毒。\""}]},{"ID":"20240613112944-5sdl9yr","Type":"NodeParagraph","Properties":{"id":"20240613112944-5sdl9yr","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"性微寒，味辛苦。\""}]},{"ID":"20240613112944-8kz54lt","Type":"NodeParagraph","Properties":{"id":"20240613112944-8kz54lt","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613112944-fuvcx75","Type":"NodeParagraph","Properties":{"id":"20240613112944-fuvcx75","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 体虚，无实火热毒，阴证外疡及孕妇均忌服。"}]},{"ID":"20240613112944-uipvn6g","Type":"NodeParagraph","Properties":{"id":"20240613112944-uipvn6g","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"热伤营阴吐衄血证忌用之。\""}]},{"ID":"20240613112944-su2xe8m","Type":"NodeParagraph","Properties":{"id":"20240613112944-su2xe8m","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"元气虚者禁用。\""}]},{"ID":"20240613112944-gv2iu6w","Type":"NodeParagraph","Properties":{"id":"20240613112944-gv2iu6w","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613112944-9cmmjyq","Type":"NodeParagraph","Properties":{"id":"20240613112944-9cmmjyq","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 清热解毒，平喘止咳，熄风定惊。治痈肿，疔疮，瘰疬，喉痹，慢性气管炎，小儿惊风抽搐，蛇虫咬伤。"}]},{"ID":"20240613112944-cac5a7z","Type":"NodeParagraph","Properties":{"id":"20240613112944-cac5a7z","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主惊痫，摇头弄舌，热气在腹中，癫疾，痈疮，阴蚀，下三虫，去蛇毒。\""}]},{"ID":"20240613112944-k8aiykd","Type":"NodeParagraph","Properties":{"id":"20240613112944-k8aiykd","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"醋摩疗痈肿，敷蛇毒。\""}]},{"ID":"20240613112944-ffk3yll","Type":"NodeParagraph","Properties":{"id":"20240613112944-ffk3yll","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治胎风搐手足，能吐泻瘰疬。\""}]},{"ID":"20240613112944-njxsnjr","Type":"NodeParagraph","Properties":{"id":"20240613112944-njxsnjr","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"消诸疮，无名肿毒，利小便。\""}]},{"ID":"20240613112944-ebcgx1n","Type":"NodeParagraph","Properties":{"id":"20240613112944-ebcgx1n","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"去疟疾寒热。\""}]},{"ID":"20240613112944-cxy6v99","Type":"NodeParagraph","Properties":{"id":"20240613112944-cxy6v99","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑥《生草药性备要》：\"补血行气，壮精益肾，能消百毒。\""}]},{"ID":"20240613112944-a42m281","Type":"NodeParagraph","Properties":{"id":"20240613112944-a42m281","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"益脾汁，升胃之清气，上行于肺，以益血行气壮精益肾，已痨嗽内伤。活血，止血，消肿，解毒。\""}]},{"ID":"20240613112944-s9u3z6p","Type":"NodeParagraph","Properties":{"id":"20240613112944-s9u3z6p","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑧《分类草药性》：\"治痔、疔疮。\""}]},{"ID":"20240613112944-p1475j7","Type":"NodeParagraph","Properties":{"id":"20240613112944-p1475j7","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑨《现代实用中药》：\"治扁桃体炎。\""}]},{"ID":"20240613112944-6c10rmv","Type":"NodeParagraph","Properties":{"id":"20240613112944-6c10rmv","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613112944-xxitx1t","Type":"NodeParagraph","Properties":{"id":"20240613112944-xxitx1t","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；磨汁、捣汁或入散剂。外用：捣敷或研末调涂。"}]},{"ID":"20240613112944-lw5luxp","Type":"NodeParagraph","Properties":{"id":"20240613112944-lw5luxp","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613112944-jrc5yil","Type":"NodeParagraph","Properties":{"id":"20240613112944-jrc5yil","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①治风毒暴肿：重台草、木鳖子（去壳）、半夏各一两。上药捣细罗为散，以酽醋调涂之；凡是热肿，熁之。（《圣惠方》重台草散）"}]},{"ID":"20240613112944-6nagh50","Type":"NodeParagraph","Properties":{"id":"20240613112944-6nagh50","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②治妇人奶结，乳汁不通，或小儿吹乳：重楼三钱。水煎，点水酒服。（《滇南本草》）"}]},{"ID":"20240613112944-a2ammvo","Type":"NodeParagraph","Properties":{"id":"20240613112944-a2ammvo","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③治耳内生疮热痛：蚤休适量。醋磨涂患处。（《广西民间常用草药》）"}]},{"ID":"20240613112944-ql54t5j","Type":"NodeParagraph","Properties":{"id":"20240613112944-ql54t5j","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"④治喉痹：七叶一枝花根茎二分。研粉吞服。（《浙江民间草药》）"}]},{"ID":"20240613112944-0s7rr97","Type":"NodeParagraph","Properties":{"id":"20240613112944-0s7rr97","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑤治小儿胎风，手足搐搦：蚤休为末。每服半钱，冷水下。（《卫生易简方》）"}]},{"ID":"20240613112944-4o1z1n4","Type":"NodeParagraph","Properties":{"id":"20240613112944-4o1z1n4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑥治慢惊：栝蒌根二钱，白甘遂一钱。上用慢火炒焦黄色，研匀。每服一字，煎麝香，薄荷汤调下，无时。（《小儿药证直诀》栝蒌汤）"}]},{"ID":"20240613112944-lgmly2t","Type":"NodeParagraph","Properties":{"id":"20240613112944-lgmly2t","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑦治肺痨久咳及哮喘：蚤休五钱。加水适量，同鸡肉或猪肺煲服。（《广西民间常用草药》）"}]},{"ID":"20240613112944-dmz2y18","Type":"NodeParagraph","Properties":{"id":"20240613112944-dmz2y18","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑧治新旧跌打内伤，止痛散瘀：七叶一枝花，童便浸四、五十天，洗净晒干研末。每服三分，酒或开水送下。（《广西药植图志》）"}]},{"ID":"20240613112944-9qa39n7","Type":"NodeParagraph","Properties":{"id":"20240613112944-9qa39n7","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑨治脱肛：蚤休，用醋磨汁。外涂患部后，用纱布压送复位，每日可涂二至三次。（《广西民间常用草药》）"}]},{"ID":"20240613112944-80vr0hm","Type":"NodeParagraph","Properties":{"id":"20240613112944-80vr0hm","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑩治蛇咬伤：七叶一枝花根二钱，研末开水送服，每日二至三次；另以七叶一枝花鲜根捣烂，或加甜酒酿捣烂敷患处。（《浙江民间常用草药》）"}]},{"ID":"20240613112944-9h12rw9","Type":"NodeParagraph","Properties":{"id":"20240613112944-9h12rw9","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"⑾治中鼠莽毒.金线重楼根。磨水服。（《濒湖集简方》）"}]},{"ID":"20240613112944-wo49xec","Type":"NodeParagraph","Properties":{"id":"20240613112944-wo49xec","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613112944-oewuzqz","Type":"NodeParagraph","Properties":{"id":"20240613112944-oewuzqz","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性气管炎"}]},{"ID":"20240613112944-x2ushm1","Type":"NodeParagraph","Properties":{"id":"20240613112944-x2ushm1","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"将重楼根茎去皮，捣碎、磨粉压片。每次3克，每日2次，饭后服。10天为一疗程，共服三个疗程，每疗程间停药3天。共治疗250余例。第一疗程治疗174例，有效率78％；第二疗程治疗122例，有效率96.7％；全程治疗92例，有效率为97.3％。"}]},{"ID":"20240613112944-y9mgpji","Type":"NodeParagraph","Properties":{"id":"20240613112944-y9mgpji","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②治疗神经性皮炎"}]},{"ID":"20240613112944-61xzmc4","Type":"NodeParagraph","Properties":{"id":"20240613112944-61xzmc4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"将蚤休根茎研成细粉，以香油或热菜油调敷。糜烂湿润病变可以粉剂直接撒布。一般治疗2～8天即可止痒，皮损逐渐消退。"}]},{"ID":"20240613112944-g6ju3af","Type":"NodeParagraph","Properties":{"id":"20240613112944-g6ju3af","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"③治疗外科炎症"}]},{"ID":"20240613112944-55kydfj","Type":"NodeParagraph","Properties":{"id":"20240613112944-55kydfj","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"用蚤休块根制成每毫升含生药2克的注射液，肌肉注射，每次2～4毫升，每日2～3次。治疗过敏性皮炎、痈疖、蜂窝织炎、急性淋巴结炎共37例，痊愈27例，好转6例，无效4例。"}]},{"ID":"20240613112944-xn0jowd","Type":"NodeParagraph","Properties":{"id":"20240613112944-xn0jowd","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613112944-01u4r1o","Type":"NodeParagraph","Properties":{"id":"20240613112944-01u4r1o","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①《本草汇言》：\"蚤休，凉血去风，解痈毒之药也。但气味苦寒，虽云凉血，不过为痈疽疮疡血热致疾者宜用，中病即止。又不可多服久服。\""}]},{"ID":"20240613112944-lpehasu","Type":"NodeParagraph","Properties":{"id":"20240613112944-lpehasu","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"②《本草正义》：\"蚤休，乃苦泄解毒之品，濒湖谓足厥阴经之药，盖清解肝胆之郁热，熄风降气，亦能退肿消痰，利水去湿。《本经》治惊痫，摇头弄舌，皆肝阳肆虐、木火生风之症。又谓之癫疾者，癫即巅顶之巅，字亦作颠，谓是肝风上凌，直上顶巅之病。蚤休能治此症，正以苦寒泄降，能熄风阳而清气火，则气血不冲，脑经不扰，而癫疾惊痫，摇头弄舌诸病可已。若其专治痈肿，则苦寒清热，亦能解毒。治阴蚀，下三虫，亦苦寒胜湿，自能杀虫，其用浅显易知，不烦多赘。濒湖引谚语有’…痈疽如遇着，一似手拈拿’。知此草专治痈疡，古今无不推重。然此类寒凉诸品，惟阳发红肿大痛名为宜。而坚块顽木之阴症大忌，非谓凡是外科，无不统治也。\""}]},{"ID":"20240613112944-lr1yxrs","Type":"NodeParagraph","Properties":{"id":"20240613112944-lr1yxrs","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613112944-whpf202","Type":"NodeParagraph","Properties":{"id":"20240613112944-whpf202","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613112944-qg0v6me","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112944-qg0v6me","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蚤休"}]},{"ID":"20240613112944-2xn6ta2","Type":"NodeParagraph","Properties":{"id":"20240613112944-2xn6ta2","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613112944-d97wqhv","Type":"NodeParagraph","Properties":{"id":"20240613112944-d97wqhv","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" Zǎo Xiū"}]},{"ID":"20240613112944-6yfh2my","Type":"NodeParagraph","Properties":{"id":"20240613112944-6yfh2my","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613112944-dafnpny","Type":"NodeParagraph","Properties":{"id":"20240613112944-dafnpny","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 蚩休、重台根、螫休、紫河车、重台草、白甘遂、金钱重楼、草河车、虫蒌、九道箍、鸳鸯虫、枝花头、双层楼、螺丝七、海螺七、灯台七、白河车、螺陀三七、土三七"}]},{"ID":"20240613112944-hp5ha12","Type":"NodeParagraph","Properties":{"id":"20240613112944-hp5ha12","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613112944-s2vg2hz","Type":"NodeParagraph","Properties":{"id":"20240613112944-s2vg2hz","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" rhizome of Manyleaf Paris"}]},{"ID":"20240613112944-ixymyxr","Type":"NodeParagraph","Properties":{"id":"20240613112944-ixymyxr","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613112944-qyrnbmr","Type":"NodeParagraph","Properties":{"id":"20240613112944-qyrnbmr","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613112944-cyankxu","Type":"NodeParagraph","Properties":{"id":"20240613112944-cyankxu","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：蚤休，苗叶似王孙、鬼臼等，作二、三层。六月开黄紫花，蕊赤黄色，上有金丝垂下，秋结红子。根似肥美，皮赤肉白。四月五月采根，日干用。"}]},{"ID":"20240613112944-zlehwbo","Type":"NodeParagraph","Properties":{"id":"20240613112944-zlehwbo","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》： 蚤休，无旁枝，止一茎挺生，高尺余。颠有四、五叶，叶有歧，似虎杖。中心又起茎，亦如是生叶。惟根入药用。"}]},{"ID":"20240613112944-xl0iry9","Type":"NodeParagraph","Properties":{"id":"20240613112944-xl0iry9","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"3.《纲目》： 蛇虫之毒，得此治之即休，故有蚤休、螫休诸名。重台、三层，因其叶状也。金线重"}]},{"ID":"20240613112944-0w7zfwk","Type":"NodeParagraph","Properties":{"id":"20240613112944-0w7zfwk","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613112944-k4pm2t5","Type":"NodeParagraph","Properties":{"id":"20240613112944-k4pm2t5","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物化重楼、云南重楼或七叶一枝花的根茎。"}]},{"ID":"20240613112944-yxi61ee","Type":"NodeParagraph","Properties":{"id":"20240613112944-yxi61ee","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Paris polyphylla Smith var.chinensis （Franch.）Hara [P.chinensisFranch.] 2.Paris polyphylla Smith var.yunnanensis（Franch.）Hand.-Mazz.[P.yunnanensis Franch.；P.polyphylla Smith var.platypetala Franch.]"}]},{"ID":"20240613112944-9t0npjb","Type":"NodeParagraph","Properties":{"id":"20240613112944-9t0npjb","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"采收和储藏：移栽3-5年后，在9-10月倒苗时，挖起根茎，晒或炕干后，撞去粗皮、须根。"}]},{"ID":"20240613112944-62yurro","Type":"NodeParagraph","Properties":{"id":"20240613112944-62yurro","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613112944-836076q","Type":"NodeParagraph","Properties":{"id":"20240613112944-836076q","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.华重楼生于山坡林下荫处或沟谷边的草地阴湿处。 2.云南重楼生于海拔200m左右的高山山沟林下，或阳坡杂木林下。 3.七叶一枝花生于海拔1800-3200m的林下。"}]},{"ID":"20240613112944-nwa1q83","Type":"NodeParagraph","Properties":{"id":"20240613112944-nwa1q83","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"资源分布：1.华重楼分布于陕西、江苏、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西、四川、贵州、云南。 2.云南重楼分布于福建、湖北、湖南、广西、四川、贵州、云南。 3.七叶一枝花分布于四川、贵州、云南、西藏东南部。"}]},{"ID":"20240613112944-41laibz","Type":"NodeParagraph","Properties":{"id":"20240613112944-41laibz","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613112944-gl0axx8","Type":"NodeParagraph","Properties":{"id":"20240613112944-gl0axx8","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 1.华重楼 多年生草本，高30-100cm。根茎肥厚，直径1-3cm，黄褐色，结节明显。茎直立，圆柱形，常带紫红色或青紫色，基部有1-3片膜质叶鞘包茎。叶轮生茎顶，通常7片；叶柄长5-18mm；叶片长圆状披针形、倒卵状披针形或倒披针形，长8-27cm宽2.2-10cm，先端急尖或渐尖，基部楔形，全缘，膜质或薄纸质。花柄出自轮生叶中央，通常比叶长，顶生一花； 花两性外轮花被片4-6，叶状，绿色，长卵形至卵状披针形，长3-7cm，内轮花被片细线形，与外轮花被片同数，黄色或黄绿色，宽1-1.5mm，长为外轮花被片的1/3左右或近等长；雄蕊8-10，排成2轮，花药长1.2-2cm，花丝很短，长仅为花药的1/3-1/4，药隔在花药上方突出0.5-2mm；子房近球形，具棱，花柱短，具4-5向外反卷的分枝。蒴果球形，成熟时瓣裂；种子多数，具鲜红色多浆汁的外种皮。花期5-7月，果期8-10月。2.云南重楼 与华重楼不同点在于：根茎肥厚，直径2-3.5cm，结节明显。叶6-10片轮生；叶柄长5-20mm；叶片披针形、卵状长圆形至倒卵形，长5-11cm，宽2-4.5cm。外轮花被片绿色，披针形或长卵形；内轮花被片黄色，线形而略呈披针状，中部以上宽2-6mm，长为外轮的1/2至近等长；雄蕊8-10，排列成2-3轮，花药长1-1.5cm花丝比花药短，药隔突出部分长1-2mm。花期6-7月，果期9-10月。 3.七叶一枝花 与华重楼十分相似，其共别在于：外轮花被片4-6狭卵状披针形，长4.5-7cm；内轮花被片狭条形，长超过外轮或近等长；雄蕊8-12，花药短，长5-8mm，与花丝近等长或稍长，药隔突出部分长0.5-1mm；花柱粗短，具4-5分枝。蒴果紫色，直径1.5-2.5cm，3-6瓣开裂。种子多数，具鲜红色多浆汁的外种皮。花期4-7月，果期8-11月。"}]},{"ID":"20240613112944-ar1yazy","Type":"NodeParagraph","Properties":{"id":"20240613112944-ar1yazy","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613112944-1gpdjno","Type":"NodeParagraph","Properties":{"id":"20240613112944-1gpdjno","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜冷凉阴湿环境，以土层深厚、疏松肥沃、富含腐殖质或砂质壤土栽培为宜。 栽培技术 用种子和根茎繁殖。种子繁殖：采用育苗移栽法，在9-10月，当种皮变红时采种。采后立即播种，作1.3m宽的高畦，按沟心距20-25cm，开横沟，深3-5cm，播幅10cm，每行播种子100粒左右，盖细土厚约3cm，次年早春出苗，当年只抽一片叶，培育2-3年即可移栽。苗期注意除草和适当施肥。移栽在冬季倒苗时进行，行株距200cm×12cm，深10-12cm，每穴栽1株，栽后施人畜粪水，并盖火灰，最后覆土。根茎繁殖：可在收获时进行，在老株从茎尖倒数3-5节处切下，作为种根。"}]},{"ID":"20240613112944-obmyg8l","Type":"NodeParagraph","Properties":{"id":"20240613112944-obmyg8l","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613112944-y1g6553","Type":"NodeParagraph","Properties":{"id":"20240613112944-y1g6553","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）华重楼 根茎类圆锥形，常弯曲，直径1.3-3cm，长3.7-10cm，顶端及中部较膨大，末端渐细。表面淡黄棕色或黄棕色，具斜向环节，节间长1.5-5mm；上侧有半圆形或椭圆形凹陷的茎痕，直径0.5-1.1cm，略交错排列；下侧有稀疏的须根及少数残留的须根；膨大顶端具凹陷的茎残基，有的环节可见鳞叶。质坚实，易折断，断面平坦，粉质，少数部分角质，粉质者粉白色，角质者淡黄棕色，可见草酸钙针晶束亮点。气微，味苦。 （2）云南重楼 根茎类圆形，多平直，直径1.2-6cm，长4.5-12cm。表面黄棕色，少数灰褐色，环节较稀疏；茎痕半圆形或扁圆形，不规则排列。质坚硬，不易折断，断面粉性。 （3）七叶一枝花 根茎类圆柱形，多平直，直径1-2.5cm 显微鉴别 根茎横切面（1）华重楼 表皮细胞类方形，淡黄棕色，壁微木栓化，外壁增厚；近茎痕处最外为多列后生皮层；后生皮层细胞形状不规则；较粗根茎表皮常破碎或脱落。皮层散有叶迹维管束和根迹维管束；粘液细胞众多，针晶长56-306μm，宽31-94μm。中柱内维管束25-30个，周木型，外侧排列较密，向内渐少。中柱亦有较多粘液细胞分布。本品薄壁细胞含淀粉粒。 （2）云南重楼 皮层和中柱的粘液细胞少数，针晶长94-201μm，宽40-142μm。中柱内维管束20-35个。 （3）七叶一枝花 皮层较宽，粘液细胞较少，针晶束长达85-133μm，宽38-77μm。中柱内维管束25-40个，粘液细胞罕见。 粉末特征：（1）华重楼 类白色。①淀粉粒单粒圆形、长圆形、菱形、茧形或不规则形，边缘常有类圆形突起或尖突，直径5-16μm，脐点少数可见，裂缝状、点状或三叉状；复粒较少，2-3分粒组成。②粘液细胞较多，直径54-140μm，长106-369μm，内含草酸钙针晶束；针晶束长86-333μm，针晶直径2-5μm。③薄壁细胞壁具细小纹孔，有的壁呈连珠状增厚。此外，有黄棕色或亮黄色表皮细胞，螺纹及网纹导管。 （2）云南重楼 类白色。①淀粉粒单粒长圆形、类三角形、类圆形、卵圆形、肾形或不规则形，少数边缘有突起，直径3-15μm；复粒较多，2-4分粒组成。②粘液细胞直径99-130μm；长153-403μm；针晶束长135-190μm，针晶直径约至6μm。③薄壁细胞壁具细小圆纹孔及孔沟，或呈连珠状增厚。此外，可见黄棕色表皮细胞，网纹、梯纹、螺纹导管，鳞叶表皮细胞。 （3）七叶一枝花 灰白色。①淀粉粒单粒长圆形、类圆形、圆三角形或肾形，少数边缘凹凸，直径3-11μm；复粒较多，2-3分粒组成。②粘液细胞直径79-126μm，长85-324μm；针晶束长81-144μm，针晶直径2-4μm。此外尚有黄棕色或亮黄色表皮细胞，网纹、梯纹、螺纹或环纹导管，鳞叶表皮细胞。"}]},{"ID":"20240613112944-uinp20x","Type":"NodeParagraph","Properties":{"id":"20240613112944-uinp20x","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613112944-q6qfiyg","Type":"NodeParagraph","Properties":{"id":"20240613112944-q6qfiyg","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 小鼠灌服煎剂30-60g/kg，3天内未见死亡。小鼠每日灌服0.4g，每天3次，连续3天；或静脉注射0.2%0.4ml/只，均无死亡。故毒性很低。"}]},{"ID":"20240613112944-cyhjg37","Type":"NodeParagraph","Properties":{"id":"20240613112944-cyhjg37","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613112944-qftghcd","Type":"NodeParagraph","Properties":{"id":"20240613112944-qftghcd","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 1.华重楼 根茎含薯蓣皂甙元-3-O-α-L-呋喃阿拉伯糖基（1→4）-[α-L-吡喃鼠李糖基（1→2）]-β-D-吡喃葡萄糖甙"}]},{"ID":"20240613112944-7926kba","Type":"NodeParagraph","Properties":{"id":"20240613112944-7926kba","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613112944-dnm5kad","Type":"NodeParagraph","Properties":{"id":"20240613112944-dnm5kad","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 1.平喘、止咳作用：豚鼠口服七叶一枝花煎剂有明显平喘作用 (组胺喷雾法)。提取物(共五种)在1/2-l/5半数致死量时即有明显平喘作用，效果与 l/2半数致死量的氨茶碱相似。提取物之一为皂甙，另三种 Liebermann反应阳性。小鼠灌服煎剂有明显止咳作用(二氧化硫引咳法)，但无祛痰作用(酚红法)。"}]},{"ID":"20240613112944-dwgqba7","Type":"NodeParagraph","Properties":{"id":"20240613112944-dwgqba7","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用：蚤休(未注明品种)100%制剂在试管内对肠道杆菌和化脓性球菌等多种致病菌皆有抗菌作用，近来用煎剂未能证明其有抑菌作用。醇提取物7.8mg/ml在体外有杀灭钧端螺旋体作用，同浓度水煎剂则无此作用。用鸡胚接种法证明水或醒提取物对甲型及亚洲甲型流感病毒都有抑制作用，稀释至1：1万至1：10万仍有效，小鼠用蚤休药液滴鼻，5小时后接种病毒，其死亡率比对照组略低。蚤休中含鞣质，其抗病毒作用与之有重要关系。"}]},{"ID":"20240613112944-0x1o55y","Type":"NodeParagraph","Properties":{"id":"20240613112944-0x1o55y","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613112944-8f6fth7","Type":"NodeParagraph","Properties":{"id":"20240613112944-8f6fth7","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粗粉的水浸液，分别加入带塞2支试管中，1管加5%氢氧化钠溶液，1管加5%盐酸溶液，密塞，振摇1min，产生大量蜂窝泡沫，加碱管比加酸管的泡沫高2倍以上。（检查甾体皂甙） （2）取本品乙醚提取液2份，挥干，1份加醋酐1ml溶解，加硫酸2滴，显黄色，后变红色、紫色、青色、污绿色；另一份加冰醋酸1ml溶解，加乙酰氯5滴与氧化锌少量，稍加热，显淡红色或紫红色。 （3）薄层色谱 取本品乙醇提取液，蒸干，加2mol/L盐酸回流2h，再用石油醚萃取，蒸干，加氯仿溶解作供试液，另以薯蓣皂甙元作对照品，分别点于同一硅胶G薄板上，以氯仿-甲醇（95：5）展开，用5%磷钼酸乙醇液喷雾，110度烤5min，供试液色谱在与对照品色谱相应位置上，显相同的蓝色斑点。"}]},{"ID":"20240613112944-176h520","Type":"NodeParagraph","Properties":{"id":"20240613112944-176h520","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613112944-1q378ig","Type":"NodeParagraph","Properties":{"id":"20240613112944-1q378ig","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240613112944-bbc0ai6","Type":"NodeParagraph","Properties":{"id":"20240613112944-bbc0ai6","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613112944-ye05mm1","Type":"NodeParagraph","Properties":{"id":"20240613112944-ye05mm1","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 苦；寒；小毒"}]},{"ID":"20240613112944-bwt2xv4","Type":"NodeParagraph","Properties":{"id":"20240613112944-bwt2xv4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613112944-eqxxthp","Type":"NodeParagraph","Properties":{"id":"20240613112944-eqxxthp","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 虚寒证，阴证外疡及孕妇禁服"}]},{"ID":"20240613112944-h9kwmp4","Type":"NodeParagraph","Properties":{"id":"20240613112944-h9kwmp4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613112944-5mdqxmb","Type":"NodeParagraph","Properties":{"id":"20240613112944-5mdqxmb","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 清热解毒；消肿止痛；凉肝定惊。主痈肿疮毒；咽肿喉痹；乳痈；蛇虫咬伤；跌打伤痛；肝热抽搐"}]},{"ID":"20240613112944-w4qm6ug","Type":"NodeParagraph","Properties":{"id":"20240613112944-w4qm6ug","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613112944-vbfd05j","Type":"NodeParagraph","Properties":{"id":"20240613112944-vbfd05j","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤， 3-10g；研末，每次1-3g。外用：适量，磨汗涂布、研末调敷或鲜品捣敷。"}]},{"ID":"20240613112944-x9tpew1","Type":"NodeParagraph","Properties":{"id":"20240613112944-x9tpew1","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613112944-cdv5jf9","Type":"NodeParagraph","Properties":{"id":"20240613112944-cdv5jf9","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" ①治风毒暴肿：重台草、木鳖子(去壳)、半夏各一两。上药捣细罗为散，以酽醋调徐之；凡是热肿，熁之。(《圣惠方》重台草散)②治妇人奶结，乳汁不通，或小儿吹乳：重楼三钱。水煎，点水酒服。(《滇南本草》)③治耳内生疮热痛：蚤休适量。醋磨涂患处。(《广西民间常用草药》)④治喉痹：七叶一枝花根茎二分。研粉吞服。(《浙江民间草药》)⑤治小儿胎风，手足搐溺: 蚤休为末。每服半钱，冷水下。(《卫生易简方》)⑥治慢惊：栝萎根二钱，白甘遂一钱。上用慢火炒焦黄色，研匀。每服一字，煎麝香、薄荷汤调下，无时。(《小儿药证直诀》栝萎汤)⑦治肺痨久咳及哮喘： 蚤休五钱。加水适量，同鸡肉或猪肺煲服。(《广西民间常用草药》)⑧治新旧跌打内伤，止痛散瘀：七叶一枝花，童便浸四、五十天，洗净晒干研末。每服三分，酒或开水送下。(《广西药植图志》)⑨治脱肛：蚤休，用醋磨汁。外涂患部后，用纱布压送复位，每日可涂二至三次。(《广西民间常用草药》)⑩治蛇咬伤:七叶一枝花根二钱，研末开水送服，每日二至三次；另以七叶一枝花鲜根捣烂，或加甜酒酿捣烂敷患处。 (《浙江民间常用草药》)⑩治中鼠莽毒．金线重楼根。磨水服。 (《濒湖集简方》)"}]},{"ID":"20240613112944-nsseiic","Type":"NodeParagraph","Properties":{"id":"20240613112944-nsseiic","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613112944-b0fkmnf","Type":"NodeParagraph","Properties":{"id":"20240613112944-b0fkmnf","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 1.治疗慢性气管炎：将重楼根茎去皮、捣碎、磨粉压片。每次3g，每日2次，饭后服。10天为一疗程，共服三个疗程，每疗程间停药3天。共治疗250余例。第一疗程治疗174例，有效率78%；第二疗程治疗122例，有效率96.7%；全程治疗92例，有效率为97.3%。"}]},{"ID":"20240613112944-7j4kqfv","Type":"NodeParagraph","Properties":{"id":"20240613112944-7j4kqfv","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"2.治疗神经性皮炎：将蚤休根茎研成细粉，以香油或熟菜油调敷。糜烂湿润病变可以粉剂直接撒布。一般治疗2-3天即可止痒，皮损逐渐消退。"}]},{"ID":"20240613112944-8pzwpxq","Type":"NodeParagraph","Properties":{"id":"20240613112944-8pzwpxq","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"3.治疗外科炎症：用蚤休块根制成每毫升含生药2g的注射液，肌肉注射，每次2-4ml，每日2-3次。治疗过敏性皮炎、痈疖、蜂窝织炎、急性淋巴结炎共37例，痊愈27例，好转6例，无效4例。"}]},{"ID":"20240613112944-5u1fter","Type":"NodeParagraph","Properties":{"id":"20240613112944-5u1fter","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613112944-s9gowfl","Type":"NodeParagraph","Properties":{"id":"20240613112944-s9gowfl","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 1.《本草汇言》：蚤休，凉血去风，解痈毒之药也。但气味苦寒，虽云凉血，不过为痈疽疮疡血热致疾者宜用，中病即止。又不可多服久服。"}]},{"ID":"20240613112944-n05jrj4","Type":"NodeParagraph","Properties":{"id":"20240613112944-n05jrj4","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"2.《本草正义》：蚤休，乃苦泄解毒之品，濒湖谓足厥阴经之药，盖清解肝胆之郁热，熄风降气，亦能退肿消痰，利水去湿。《本经》治惊癎，摇头弄舌，皆肝阳肆虐、木火生风之症。又谓之癫疾者，癫即巅顶之巅，字亦作颠，谓是肝风上凌，直上顶巅之病。蚤休能治此症，正以苦寒泄降，能熄风阳而清气火，则气血不冲，脑经不扰，而癫疾惊癎，摇头弄舌诸病可已。若其专治痈肿，则苦寒清热，亦能解毒。治阴蚀，下三虫，亦苦寒胜湿，自能杀虫，其用浅显易知，不烦多赘。濒湖引谚语有'痈疽如遇着，一似手拈拿。知此草专治痈疡，古今无不推重。然此类寒凉诸品，惟阳发红肿大痛者为宜，而坚块顽木之阴症大忌，非谓凡是外科，无不统治也。"}]},{"ID":"20240613112944-y5mg4jk","Type":"NodeParagraph","Properties":{"id":"20240613112944-y5mg4jk","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"3.《本经》：主惊癎，摇头弄舌，热气在腹中，癫疾，痈疮，阴蚀，下三虫，去蛇毒。"}]},{"ID":"20240613112944-jnpf1w1","Type":"NodeParagraph","Properties":{"id":"20240613112944-jnpf1w1","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"4.《唐本草》醋摩疗痈肿，敷蛇毒。"}]},{"ID":"20240613112944-a1s49w6","Type":"NodeParagraph","Properties":{"id":"20240613112944-a1s49w6","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：治胎风搐手足，能吐泻瘰疬。"}]},{"ID":"20240613112944-q9t8kot","Type":"NodeParagraph","Properties":{"id":"20240613112944-q9t8kot","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"6.《滇南本草》：消诸疮，无名肿毒，利小便。"}]},{"ID":"20240613112944-cswg68x","Type":"NodeParagraph","Properties":{"id":"20240613112944-cswg68x","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：去疟疾寒热。"}]},{"ID":"20240613112944-cdt8a9f","Type":"NodeParagraph","Properties":{"id":"20240613112944-cdt8a9f","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"8.《生草药性备要》：补血行气，壮精益肾，能消百毒。"}]},{"ID":"20240613112944-0epmtcz","Type":"NodeParagraph","Properties":{"id":"20240613112944-0epmtcz","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"9.《本草求原》：益脾汁，升胃之清气，上行于肺，以益血行气。壮精益肾，巳痨嗽内伤。活血，止血，消肿，解毒。"}]},{"ID":"20240613112944-5od7nb0","Type":"NodeParagraph","Properties":{"id":"20240613112944-5od7nb0","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"10.《分类草药性》：治痔、疗疮。"}]},{"ID":"20240613112944-s7nq4bs","Type":"NodeParagraph","Properties":{"id":"20240613112944-s7nq4bs","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"11.《现代实用中药》：治扁桃体炎。"}]},{"ID":"20240613112944-cbqpfz7","Type":"NodeParagraph","Properties":{"id":"20240613112944-cbqpfz7","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613112944-uthukvk","Type":"NodeParagraph","Properties":{"id":"20240613112944-uthukvk","updated":"20240613112944"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613112946-haucyqf","Type":"NodeThematicBreak","Properties":{"id":"20240613112946-haucyqf"}},{"ID":"20240613112947-t2wibqd","Type":"NodeParagraph","Properties":{"id":"20240613112947-t2wibqd"}}]}