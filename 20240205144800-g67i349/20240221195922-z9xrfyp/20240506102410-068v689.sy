Type":"NodeParagraph","Properties":{"id":"20240823161811-s0ksu0f","updated":"20240823162319"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"羊蹄 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/羊蹄 10-20240823161811-57mpwdn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 699px;","style":"width: 689px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"羊蹄 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/羊蹄 11-20240823161912-kbmvtta.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 689px;\" parent-style=\"width: 699px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823160313-u5cjocl","Type":"NodeParagraph","Properties":{"id":"20240823160313-u5cjocl","updated":"20240823160313"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 807px;","style":"width: 797px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"羊蹄 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/羊蹄 5-20240823160313-1bbhurd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 797px;\" parent-style=\"width: 807px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613102924-t3vs3cg","Type":"NodeThematicBreak","Properties":{"id":"20240613102924-t3vs3cg"}},{"ID":"20240613103253-g0widoy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103253-g0widoy","updated":"20240613103301"},"Children":[{"Type":"NodeText","Data":"羊蹄《神农本草经》"}]},{"ID":"20240613103253-egsdga7","Type":"NodeParagraph","Properties":{"id":"20240613103253-egsdga7","updated":"20240613103253"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613103253-36w48bb","Type":"NodeParagraph","Properties":{"id":"20240613103253-36w48bb","updated":"20240613103253"},"Children":[{"Type":"NodeText","Data":"主头秃疥搔，除热，女子阴蚀（《御览》此四字作无字）。一名东方宿，一名连虫陆，一名鬼目。生川泽。"}]},{"ID":"20240613103253-a2ka0k7","Type":"NodeParagraph","Properties":{"id":"20240613103253-a2ka0k7","updated":"20240613103253"},"Children":[{"Type":"NodeText","Data":"《名医》曰：名蓄，生陈留。"}]},{"ID":"20240613103253-arbqedn","Type":"NodeParagraph","Properties":{"id":"20240613103253-arbqedn","updated":"20240613103253"},"Children":[{"Type":"NodeText","Data":"案《说文》云：董草也，读若厘，藋，厘草也，芨堇草也。《广雅》云：荲，羊蹄也。《毛诗》云：言采其蓫。《笺》云：蓫，牛蘈也。陆德明云：本又作蓄。陆玑云：今人谓之羊蹄。陶宏景云：今人呼秃菜，即是蓄音之。诗云：言，采其蓄，案陆英，疑即此草之花，此草一名连虫陆，又陆英，即蒴藋，一名荲也，亦苦寒。"}]},{"ID":"20240613103504-3s50f2s","Type":"NodeThematicBreak","Properties":{"id":"20240613103504-3s50f2s"}},{"ID":"20240613103505-4t7pe9x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103505-4t7pe9x","updated":"20240613103510"},"Children":[{"Type":"NodeText","Data":"羊蹄《本草乘雅半偈》"}]},{"ID":"20240613103505-g6j3awa","Type":"NodeParagraph","Properties":{"id":"20240613103505-g6j3awa","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613103505-70q6fbu","Type":"NodeParagraph","Properties":{"id":"20240613103505-70q6fbu","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"单属上焦，亦是一法。"}]},{"ID":"20240613103505-hbesadd","Type":"NodeParagraph","Properties":{"id":"20240613103505-hbesadd","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，无毒。"}]},{"ID":"20240613103505-u10qrgj","Type":"NodeParagraph","Properties":{"id":"20240613103505-u10qrgj","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"【主治】主秃疮疥瘙。除热。女子阴蚀。"}]},{"ID":"20240613103505-57pffoo","Type":"NodeParagraph","Properties":{"id":"20240613103505-57pffoo","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出陈留川泽，所在亦有。秋深始生，凌冬不死。春生苗，高三四尺。茎节紫赤，叶长尺许，状如牛舌，及莴苣叶而青碧。入夏起台，花青白，成穗结实，有三棱，夏至而"}]},{"ID":"20240613103505-x457b9b","Type":"NodeParagraph","Properties":{"id":"20240613103505-x457b9b","updated":"20240613103505"},"Children":[{"Type":"NodeText","Data":"【 】曰∶秋分始生，夏至乃枯，以降入为升出，升出为降入者也。具充金丽泽之用，故名羊，即以形似表功力也。广八卦云∶ 为羊，为毁折，为附决，所谓商兑未宁，介疾有喜者也。味苦气寒，故主火热刑金，为疥瘙秃疮，女子阴蚀。经云∶痛痒疮疡，皆属心火，浸淫肺金形脏故尔。"}]},{"ID":"20240613103514-pfzqi47","Type":"NodeThematicBreak","Properties":{"id":"20240613103514-pfzqi47"}},{"ID":"20240613103516-pioa4od","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103516-pioa4od","updated":"20240613103520"},"Children":[{"Type":"NodeText","Data":"羊蹄《神农本草经赞》"}]},{"ID":"20240613103516-mxi9k95","Type":"NodeParagraph","Properties":{"id":"20240613103516-mxi9k95","updated":"20240613103516"},"Children":[{"Type":"NodeText","Data":"味苦寒。主头秃疥搔除热女子阴蚀。一名东方宿。一名连虫陆。一名鬼目。生川泽。"}]},{"ID":"20240613103516-wk478w0","Type":"NodeParagraph","Properties":{"id":"20240613103516-wk478w0","updated":"20240613103516"},"Children":[{"Type":"NodeText","Data":"野行采。黄赤盈蹊。秋冬心茂。花叶颜齐。牛舒长舌。羊奋歧蹄。洁制。炼士能稽。"}]},{"ID":"20240613103516-b7jpdwh","Type":"NodeParagraph","Properties":{"id":"20240613103516-b7jpdwh","updated":"20240613103516"},"Children":[{"Type":"NodeText","Data":"诗。我行其野。言采其。诗疏。牛。今之羊蹄也。李时珍曰。根长近尺。赤黄色。"}]},{"ID":"20240613103516-bc7vyk0","Type":"NodeParagraph","Properties":{"id":"20240613103516-bc7vyk0","updated":"20240613103516"},"Children":[{"Type":"NodeText","Data":"入夏起苔花。叶一色。夏至即枯。秋深即生。凌冬不死。叶长尺余。似牛舌之形。寇宗曰。"}]},{"ID":"20240613103516-dhsqebn","Type":"NodeParagraph","Properties":{"id":"20240613103516-dhsqebn","updated":"20240613103516"},"Children":[{"Type":"NodeText","Data":"叶可洁治。石子名金荞麦。烧炼家用以制。"}]},{"ID":"20240613103542-upsroto","Type":"NodeThematicBreak","Properties":{"id":"20240613103542-upsroto"}},{"ID":"20240613103543-237ctkb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103543-237ctkb","updated":"20240613103547"},"Children":[{"Type":"NodeText","Data":"羊蹄《医学入门》"}]},{"ID":"20240613103543-k9r5mpv","Type":"NodeParagraph","Properties":{"id":"20240613103543-k9r5mpv","updated":"20240613103543"},"Children":[{"Type":"NodeText","Data":"羊蹄根苦寒无毒，阴蚀侵淫头上秃，癣疮肿毒醋摩敷，止血杀虫功最速。"}]},{"ID":"20240613103543-kna81le","Type":"NodeParagraph","Properties":{"id":"20240613103543-kna81le","updated":"20240613103543"},"Children":[{"Type":"NodeText","Data":"叶似羊蹄，高三四尺，茎节间开紫赤花，子名金荞麦，根似牛蒡而坚实，夏中即枯，亦可作菜食。丹溪云∶属水，走血分。似苦 ，甘而不苦。多食滑大肠，生痒。主头秃，疥癣，肿毒， 疡疽痔，女子阴蚀侵淫，喉痹不语，并取根，醋摩敷之。除热，杀虫及小儿疳虫，解诸鱼毒、蛊毒，赤白痢，大便不通，肠风下血，并水煮汁服之。又生捣汁服，治产后风秘。"}]},{"ID":"20240613103526-t2urktq","Type":"NodeThematicBreak","Properties":{"id":"20240613103526-t2urktq"}},{"ID":"20240613103528-0amy5qm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103528-0amy5qm","updated":"20240613103532"},"Children":[{"Type":"NodeText","Data":"羊蹄《本草衍义》"}]},{"ID":"20240613103528-fmmvxcw","Type":"NodeParagraph","Properties":{"id":"20240613103528-fmmvxcw","updated":"20240613103528"},"Children":[{"Type":"NodeText","Data":"经不言根，《图经》加根字。处处有。叶如菜中菠 ，但无歧，而色差青白。叶浓，花与子亦相似。叶可洁擦 浦器，根取汁涂疥癣。子谓之金乔麦，烧炼家用以制铅汞。又锉根，研，绞汁，取三二匙，水半盏，煎一二沸，温温空肚服。治产后风秘，殊验。"}]},{"ID":"20240613103448-fu4cwbo","Type":"NodeThematicBreak","Properties":{"id":"20240613103448-fu4cwbo"}},{"ID":"20240613103450-it81mf5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103450-it81mf5","updated":"20240613103459"},"Children":[{"Type":"NodeText","Data":"羊蹄《本草从新》"}]},{"ID":"20240613103450-xf1sgfp","Type":"NodeParagraph","Properties":{"id":"20240613103450-xf1sgfp","updated":"20240613103450"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即秃菜．通、祛风．"}]},{"ID":"20240613103450-tnuxfgw","Type":"NodeParagraph","Properties":{"id":"20240613103450-tnuxfgw","updated":"20240613103450"},"Children":[{"Type":"NodeText","Data":"苦寒．治产后风秘．（捣汁二三匙、入水半盏煎之、空腹温服．）头风白屑．（宋太宗圣惠方、羊蹄草根杵、同羊胆汁涂之、永除．）喉痹不语．（羊蹄独根者、勿见风日及妇人、以三年醋、研如泥、生布拭喉外令赤、涂之．）头上白秃．（方同上．丹溪曰∶羊蹄根属水、是血分药．）能制三黄、砒石、丹砂、水银．"}]},{"ID":"20240613103612-tu51zlf","Type":"NodeThematicBreak","Properties":{"id":"20240613103612-tu51zlf"}},{"ID":"20240613103614-hicak89","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103614-hicak89","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"羊蹄"}]},{"ID":"20240613103614-n9mk2t6","Type":"NodeParagraph","Properties":{"id":"20240613103614-n9mk2t6","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主头秃疥瘙，除热，女子阴蚀，浸淫疽痔，杀虫。一名东方宿，一名连虫陆，一名鬼目，一名蓄。生陈留川泽。"}]},{"ID":"20240613103614-c69mpmb","Type":"NodeParagraph","Properties":{"id":"20240613103614-c69mpmb","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今人呼名秃菜，即是蓄音之讹。《诗》云言采其蓄。又一种极相似而味酸。"}]},{"ID":"20240613103614-pxch43k","Type":"NodeParagraph","Properties":{"id":"20240613103614-pxch43k","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"呼为酸摸根，亦疗疥也。唐本注云∶实味苦、涩，平，无毒。主赤白杂痢。根味辛、苦，有小毒。《万毕方》云∶疗虫毒。今山野平泽，处处有之。臣禹锡等谨按蜀本图经云∶生下湿地，高者三、四尺。叶狭长，茎节间紫赤。花青白色，子三棱，夏中即枯。又有一种，茎、叶俱细，节间生子若茺蔚子，疗痢乃佳。今所在有之。日华子云∶羊蹄根，治癣，杀一切虫，肿毒，醋摩贴。叶治小儿疳虫，杀胡夷鱼、 鱼、檀胡鱼毒，亦可作菜食。陈藏器云∶酸摸，叶酸美。小儿折食其英。根主暴热，腹胀。生捣绞汁服，当下痢，杀皮肤小虫。叶似羊蹄，是山大黄。一名当药。《尔雅》云∶须， 芜。注云∶似羊蹄而细，味酸可食。日华子云∶酸摸，味酸，凉，无毒。治小儿壮热。生山岗。状似羊蹄，叶而小黄。"}]},{"ID":"20240613103614-5g4u9jb","Type":"NodeParagraph","Properties":{"id":"20240613103614-5g4u9jb","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"图经曰∶羊蹄，秃菜也。生陈留川泽，今所在有之。生下湿地。春生苗，高三、四尺。"}]},{"ID":"20240613103614-zye9zi2","Type":"NodeParagraph","Properties":{"id":"20240613103614-zye9zi2","updated":"20240613103614"},"Children":[{"Type":"NodeText","Data":"叶狭长，颇似莴苣而色深。茎节间紫赤。花青白成穗，子三棱，有若茺蔚，夏中即枯。根似牛蒡而坚实。今人生采根，醋摩涂癣速效。亦煎作丸服之。其方以新采羊蹄根，不限多少，捣研绞取汁一大升，白蜜半斤，同熬如稠饧煎，更用防风末六两，搜和令可丸，大如梧子。用栝蒌甘草酒下三、二十丸，日二、三次，佳。谨按《诗·小雅》∶言蒙其蘧。陆机云∶蘧，今谓之羊蹄，似芦菔而茎赤，可 为茹，滑而美也。多啖令人下气。幽州人谓之蘧，字或作蓄（并耻六切）。又有一种极相类，而叶黄味酢，名酸摸。《尔雅》所谓须， （音孙）芜。郭璞食疗主痒。不宜多食。圣惠方∶治 疡风。用羊蹄菜根，于生铁上，以好醋磨，旋旋刮取，于患上，未瘥，更入硫黄少许，同磨涂之。又方∶治大便卒涩结不通。用羊蹄根一两锉，水一大盏，煎取六分去滓，温温顿服。外台秘要∶治疥方∶捣羊蹄根和猪脂涂上，或着盐少许，佳。千金方∶喉痹卒不语。羊蹄独根者，勿见风日及妇人、鸡、犬，以三年醋研和如泥，生布拭喉，令赤敷之。千金翼治漏瘤疮，湿癣痒。浸淫日广，痒不可忍，搔之黄水出，瘥。后复发。取羊蹄，净去土，细切捣，以大酢和，净洗敷上，一时间以冷水洗之，日一敷，瘥。若为末敷之，妙。斗门方治肠风痔泻血。羊蹄根、叶烂蒸一碗来，食之立瘥。简要济众治癣疮久不瘥。羊蹄根捣绞取汁，用调腻粉少许如膏，涂敷癣上，三、五遍即瘥。如干，即猪脂调和敷之。"}]},{"ID":"20240613103614-kuqaaz0","Type":"NodeParagraph","Properties":{"id":"20240613103614-kuqaaz0","updated":"20240613103621"},"Children":[{"Type":"NodeText","Data":"衍义曰∶羊蹄，《经》不言根，《图经》加根字。处处有。叶如菜中菠 ，但无歧，而色差青以制铅汞。又锉根，研，绞汁取三、二匙，水半盏，煎一、二沸，温温空肚服。治产后风秘，殊验。"}]},{"ID":"20240613103353-tx7weya","Type":"NodeThematicBreak","Properties":{"id":"20240613103353-tx7weya"}},{"ID":"20240613103355-t565fzi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103355-t565fzi","updated":"20240613103404"},"Children":[{"Type":"NodeText","Data":"羊蹄《本草图经》"}]},{"ID":"20240613103355-vs9ttqo","Type":"NodeParagraph","Properties":{"id":"20240613103355-vs9ttqo","updated":"20240613103400"},"Children":[{"Type":"NodeText","Data":"羊蹄，秃菜也。生陈留川泽，今所在有之。生下湿地。春生苗，高三、四尺；叶狭长，颇似莴苣而色深；茎节间紫赤；花青白成穗，子三棱，有若茺蔚，夏中即枯；根似牛蒡而坚实。"}]},{"ID":"20240613103355-3yrbw25","Type":"NodeParagraph","Properties":{"id":"20240613103355-3yrbw25","updated":"20240613103355"},"Children":[{"Type":"NodeText","Data":"今人生采根，醋摩涂癣速效。亦煎作丸服之。其方以新采羊蹄根，不限多少，捣研绞取汁一大升，白蜜半斤，同熬如稠饧煎，更用防风末六两，搜和，令可丸大如梧子。用栝楼、甘草酒下三、二十丸，日二、三次，佳，谨按《诗·小雅》∶言采其 。陆机云∶ ，今人谓之羊蹄，似芦菔而茎赤，可 为茹，滑而美也，多啖令人下气。幽州人谓之 。字或作蓄（并耻六切）。又有一种极相类，而叶黄味酢，名酸模。《尔雅》所谓须， （音孙）芜。郭璞云∶芜似羊蹄，叶细味酢，可食，一名 （音修）是也。"}]},{"ID":"20240613103309-8ldnoh6","Type":"NodeThematicBreak","Properties":{"id":"20240613103309-8ldnoh6"}},{"ID":"20240613103310-1owtvpy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103310-1owtvpy","updated":"20240613103320"},"Children":[{"Type":"NodeText","Data":"羊蹄《新修本草》"}]},{"ID":"20240613103310-b6nog73","Type":"NodeParagraph","Properties":{"id":"20240613103310-b6nog73","updated":"20240613103310"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主头秃疥瘙，除热，女子阴蚀。浸淫，疽痔，杀虫。一名东方宿，一名蓄。生陈留川泽。"}]},{"ID":"20240613103310-z0pzx5a","Type":"NodeParagraph","Properties":{"id":"20240613103310-z0pzx5a","updated":"20240613103310"},"Children":[{"Type":"NodeText","Data":"今人呼名秃菜，即是蓄音之讹。《诗》云言采其蓄。又一种极相似而味酸，呼为酸模，根亦疗疥也。"}]},{"ID":"20240613103310-kk4dilq","Type":"NodeParagraph","Properties":{"id":"20240613103310-kk4dilq","updated":"20240613103310"},"Children":[{"Type":"NodeText","Data":"〔谨案〕实，味苦、涩，平，无毒。主赤白杂痢。根，味辛、苦，有小毒。万华方云∶疗虫毒，今山野平泽处处有之。"}]},{"ID":"20240613103330-5hqx6qj","Type":"NodeThematicBreak","Properties":{"id":"20240613103330-5hqx6qj"}},{"ID":"20240613103331-mxwzgsj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103331-mxwzgsj","updated":"20240613103337"},"Children":[{"Type":"NodeText","Data":"羊蹄《名医别录》"}]},{"ID":"20240613103331-k48v99u","Type":"NodeParagraph","Properties":{"id":"20240613103331-k48v99u","updated":"20240613103331"},"Children":[{"Type":"NodeText","Data":"无毒．主治浸淫疽痔，杀虫．一名蓄．生陈留．"}]},{"ID":"20240613103331-c8bp65p","Type":"NodeParagraph","Properties":{"id":"20240613103331-c8bp65p","updated":"20240613103331"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶羊蹄，味苦，寒．主头秃疥瘙，除热，女子阴蚀．一名东方宿，一名连虫陆，一名鬼目．生川泽．"}]},{"ID":"20240613102924-2vc3svi","Type":"NodeThematicBreak","Properties":{"id":"20240613102924-2vc3svi"}},{"ID":"20240613103239-czpjaj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103239-czpjaj5","updated":"20240613103249"},"Children":[{"Type":"NodeText","Data":"羊蹄《千金翼方》"}]},{"ID":"20240613103239-9b9lnwc","Type":"NodeParagraph","Properties":{"id":"20240613103239-9b9lnwc","updated":"20240613103239"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主头秃疥瘙，除热，女子阴蚀浸淫，疽痔，杀虫。一名东方宿，一名连虫陆，一名鬼目，一名蓄。生陈留川泽。"}]},{"ID":"20240613102925-4mn21ov","Type":"NodeThematicBreak","Properties":{"id":"20240613102925-4mn21ov"}},{"ID":"20240613103055-dtditwh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103055-dtditwh","updated":"20240613103102"},"Children":[{"Type":"NodeText","Data":"羊蹄《本草纲目》"}]},{"ID":"20240613103055-b5bqgxe","Type":"NodeParagraph","Properties":{"id":"20240613103055-b5bqgxe","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"「释名」蓄、秃菜、败毒菜、牛舌菜、羊蹄大黄、鬼目、东方宿、连虫陆、水黄芹，子名金荞麦。"}]},{"ID":"20240613103055-hewg1fn","Type":"NodeParagraph","Properties":{"id":"20240613103055-hewg1fn","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240613103055-xtr3rk0","Type":"NodeParagraph","Properties":{"id":"20240613103055-xtr3rk0","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613103055-mu47zbr","Type":"NodeParagraph","Properties":{"id":"20240613103055-mu47zbr","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"1、结肠（便闭）。用羊蹄根一两，加水一大碗，煎至六成，温服。"}]},{"ID":"20240613103055-jevudc5","Type":"NodeParagraph","Properties":{"id":"20240613103055-jevudc5","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"2、肠风下血。用羊蹄根洗净，切细，加连皮老姜各半碗，是炒赤，以酒淬过，去渣，适量饮服。"}]},{"ID":"20240613103055-8dwvd22","Type":"NodeParagraph","Properties":{"id":"20240613103055-8dwvd22","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"3、喉痹。用羊蹄根，在陈醋中研成泥。先以布把喉外擦红，再把药涂上。"}]},{"ID":"20240613103055-d3zc0m8","Type":"NodeParagraph","Properties":{"id":"20240613103055-d3zc0m8","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"4、顽癣。用羊蹄根绞出汁，加轻粉少许，调成膏涂癣上，三、五次即愈。又方：用羊蹄根五升，在桑柴火上煮开四、五次，取汁洗癣，同时以羊蹄汁和矾末涂搽。"}]},{"ID":"20240613103055-1tqmdle","Type":"NodeParagraph","Properties":{"id":"20240613103055-1tqmdle","updated":"20240613103055"},"Children":[{"Type":"NodeText","Data":"5、湿癣（痒不可忍，出黄水，愈后易复发）。用羊蹄根捣烂，和醋调匀涂搽。过一阵，用冷水洗去。一天治一次。采得的羊蹄磨醋涂癣，有奇效。"}]},{"ID":"20240613102925-f4yrmea","Type":"NodeThematicBreak","Properties":{"id":"20240613102925-f4yrmea"}},{"ID":"20240613102927-zmgk1d9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613102927-zmgk1d9","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：羊蹄"}]},{"ID":"20240613102927-sftklxo","Type":"NodeParagraph","Properties":{"id":"20240613102927-sftklxo","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613102927-vj1lxvo","Type":"NodeParagraph","Properties":{"id":"20240613102927-vj1lxvo","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" Yánɡ Tí"}]},{"ID":"20240613102927-ruhtppm","Type":"NodeParagraph","Properties":{"id":"20240613102927-ruhtppm","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613102927-cwpsco3","Type":"NodeParagraph","Properties":{"id":"20240613102927-cwpsco3","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 土大黄、牛舌头、羊舌头、野菠菜、羊蹄叶"}]},{"ID":"20240613102927-pmd8qqx","Type":"NodeParagraph","Properties":{"id":"20240613102927-pmd8qqx","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613102927-gdpd8z8","Type":"NodeParagraph","Properties":{"id":"20240613102927-gdpd8z8","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 为蓼科酸模属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"皱叶酸模"},{"Type":"NodeText","Data":"Rumex crispus L 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"羊蹄"},{"Type":"NodeText","Data":"R. japonicus Houtt.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。春、秋挖根，洗净，切片，晒干。全草全年可采，或秋季采割，晒干。"}]},{"ID":"20240613102927-vw6bikq","Type":"NodeParagraph","Properties":{"id":"20240613102927-vw6bikq","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613102927-pe2lhmz","Type":"NodeParagraph","Properties":{"id":"20240613102927-pe2lhmz","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 苦、酸，寒。有小毒。"}]},{"ID":"20240613102927-ii8adcp","Type":"NodeParagraph","Properties":{"id":"20240613102927-ii8adcp","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613102927-t1ukv6o","Type":"NodeParagraph","Properties":{"id":"20240613102927-t1ukv6o","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 清热解毒，止血，通便，杀虫。用于鼻出血，功能性子宫出血，血小板减少性紫癜，慢性肝炎，肛门周围炎，大便秘结；外用治外痔，急性乳腺炎，黄水疮，疖肿，皮癣。"}]},{"ID":"20240613102927-7sbbtrs","Type":"NodeParagraph","Properties":{"id":"20240613102927-7sbbtrs","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613102927-agtqh90","Type":"NodeParagraph","Properties":{"id":"20240613102927-agtqh90","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 3～5钱，鲜品1～2两；外用适量，煎水洗或捣烂敷患处。"}]},{"ID":"20240613102927-20zhf1a","Type":"NodeParagraph","Properties":{"id":"20240613102927-20zhf1a","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613102927-4euewrk","Type":"NodeParagraph","Properties":{"id":"20240613102927-4euewrk","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613102927-ywkvmjx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613102927-ywkvmjx","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：羊蹄"}]},{"ID":"20240613102927-8ci263i","Type":"NodeParagraph","Properties":{"id":"20240613102927-8ci263i","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613102927-ez81dl8","Type":"NodeParagraph","Properties":{"id":"20240613102927-ez81dl8","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" Yánɡ Tí"}]},{"ID":"20240613102927-pezuk40","Type":"NodeParagraph","Properties":{"id":"20240613102927-pezuk40","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613102927-96pbpke","Type":"NodeParagraph","Properties":{"id":"20240613102927-96pbpke","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 东方宿、连虫陆、鬼目（《本经》），败毒菜根（《永类钤方》），羊蹄大黄（《庚辛玉册》），土大黄（《滇南本草》），牛舌根（《镇江府志》），牛舌大黄（《植物名实图考》），鸡脚大黄（《中医药实验研究》）。"}]},{"ID":"20240613102927-s5bh421","Type":"NodeParagraph","Properties":{"id":"20240613102927-s5bh421","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613102927-z09rffi","Type":"NodeParagraph","Properties":{"id":"20240613102927-z09rffi","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613102927-nl90g6d","Type":"NodeParagraph","Properties":{"id":"20240613102927-nl90g6d","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613102927-u3n90d8","Type":"NodeParagraph","Properties":{"id":"20240613102927-u3n90d8","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"羊蹄"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"尼泊尔羊蹄"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。8～9月采取。"}]},{"ID":"20240613102927-uxprqru","Type":"NodeParagraph","Properties":{"id":"20240613102927-uxprqru","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613102927-xqpjjti","Type":"NodeParagraph","Properties":{"id":"20240613102927-xqpjjti","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" ①羊蹄，又名：蘧（《诗经》），恶菜（《毛诗传，），荲（《广雅》），牛颓（陆玑《诗疏》），蓄（《别录》），秃菜（陶弘景），猪耳朵（《救荒本草》），秃叶、天王叶（《滇南本草图说》），败毒菜、牛舌菜、水黄芹（《纲目》），牛舌片、野萝卜、野莙荙、大头黄、羊耳朵、癣草。"}]},{"ID":"20240613102927-lukgr60","Type":"NodeParagraph","Properties":{"id":"20240613102927-lukgr60","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"多年生草本，根粗大黄色。茎直立，高1米许。根生叶丛生，有长柄，叶片长椭圆形，长10～25厘米，宽4～10厘米，先端钝，基部圆或带楔形，边缘呈波状；茎生叶较小，有短柄。总状花序顶生，每节花簇略下垂；花被6，淡绿色，外轮3片展开，内轮3片成果被；果被广卵形，有明显的网纹，背面各具一卵形疣状突起，其表有细网纹，边缘具不整齐的微齿；雄蕊6，成3对；子房具棱，1室，1胚珠，花柱3，柱头细裂。瘦果三角形，先端尖，角棱锐利，长约2毫米，褐色，光亮。有3片增大的果被包覆。花期4月。果熟期5月。"}]},{"ID":"20240613102927-cacyvjg","Type":"NodeParagraph","Properties":{"id":"20240613102927-cacyvjg","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"生于山野、略旁或湿地。分布我国东北、华北、华东、华中、华南各地。"}]},{"ID":"20240613102927-6ljs6gz","Type":"NodeParagraph","Properties":{"id":"20240613102927-6ljs6gz","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"②尼泊尔羊蹄，又名：牛儿黄草、尼泊尔酸模、牛儿大黄。"}]},{"ID":"20240613102927-o1o7edz","Type":"NodeParagraph","Properties":{"id":"20240613102927-o1o7edz","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"多年生草本，根粗大。茎圆形，有浅棱，高0.7～1.5米，直立。单叶五生，叶柄细；茎生叶长椭圆形、卵状长椭圆形至三角状卵形，长20～40厘米，宽3～5厘米，或更大，先端短尖，基部心脏形或圆形，边缘具不整齐之波状起伏，上部偶有杂于花序中的少数叶。总状花序，花簇之间有距离，花梗中部有明显的关节；花被6，内轮3枚扩大为果被，卵圆形，网脉突出而明显，中央有长椭圆形的疣状突起，边缘有针状齿，每侧约10枚，齿端成钩状；雄蕊6；子房三棱形，花柱3，柱头流苏状。瘦果三角形，有光泽。花期5月。"}]},{"ID":"20240613102927-n3uqxt5","Type":"NodeParagraph","Properties":{"id":"20240613102927-n3uqxt5","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"喜生于低山温暖地区的路旁及沟边。分布我国中部及西南部。"}]},{"ID":"20240613102927-p8nqeq1","Type":"NodeParagraph","Properties":{"id":"20240613102927-p8nqeq1","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"以上两种植物的叶（羊蹄叶）、果实（羊蹄实）亦供药用，各详专条。"}]},{"ID":"20240613102927-ydnkcl1","Type":"NodeParagraph","Properties":{"id":"20240613102927-ydnkcl1","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613102927-q53y8ky","Type":"NodeParagraph","Properties":{"id":"20240613102927-q53y8ky","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 羊蹄根含大黄根酸、大黄素、呢坡定基-3-甲基萘）。"}]},{"ID":"20240613102927-g7oobdp","Type":"NodeParagraph","Properties":{"id":"20240613102927-g7oobdp","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"本植物还含一种降血糖成分（熔点103～104℃）。"}]},{"ID":"20240613102927-263at1i","Type":"NodeParagraph","Properties":{"id":"20240613102927-263at1i","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613102927-59zo3ro","Type":"NodeParagraph","Properties":{"id":"20240613102927-59zo3ro","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 羊蹄根酊剂在试管内对多种致病真菌有一定的抑制作用。将根（品种未鉴定）煎剂与亚洲甲型流感病毒在试管内直接接触后注入鸡胚，有预防感染的作用，尿囊液蛋白质可大大降低这一作用。羊蹄根（品种未鉴定）煎剂浓缩后酒精提取物对急性淋巴细胞型白血病、急性单核细胞型白血病相急性粒细胞型白血病患者血细胞脱氢酶都有抑制作用（试管中美蓝脱色法），对前两者白细胞的呼吸有一定的抑制作用（瓦氏呼吸器测定法）。羊蹄含草酸，大剂量应用时有毒。大黄隶的药理作用参见\"大黄\"条。"}]},{"ID":"20240613102927-262p3rl","Type":"NodeParagraph","Properties":{"id":"20240613102927-262p3rl","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"同属植物团酸模的醇提水溶液对动物有持久的、中枢性的降低血压的作用。与大黄相似，小剂量有收敛，大量有轻泻作用.并能反射性的利胆，亦有某些止血作用。"}]},{"ID":"20240613102927-cxtbt5d","Type":"NodeParagraph","Properties":{"id":"20240613102927-cxtbt5d","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613102927-ggckn5s","Type":"NodeParagraph","Properties":{"id":"20240613102927-ggckn5s","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《本草撮要》：\"入手少阴经。\""}]},{"ID":"20240613102927-e27bocv","Type":"NodeParagraph","Properties":{"id":"20240613102927-e27bocv","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613102927-ll8w7y7","Type":"NodeParagraph","Properties":{"id":"20240613102927-ll8w7y7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 苦，寒，有小毒。"}]},{"ID":"20240613102927-j1kof5i","Type":"NodeParagraph","Properties":{"id":"20240613102927-j1kof5i","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240613102927-wir4y2o","Type":"NodeParagraph","Properties":{"id":"20240613102927-wir4y2o","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613102927-qk7hv77","Type":"NodeParagraph","Properties":{"id":"20240613102927-qk7hv77","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"味辛苦，有小毒。\""}]},{"ID":"20240613102927-6measpp","Type":"NodeParagraph","Properties":{"id":"20240613102927-6measpp","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"④《本草衍义补遗》：\"甘。\""}]},{"ID":"20240613102927-301okaq","Type":"NodeParagraph","Properties":{"id":"20240613102927-301okaq","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613102927-ozhtqti","Type":"NodeParagraph","Properties":{"id":"20240613102927-ozhtqti","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：\"脾胃虚寒，泄泻不食者切勿入口。\""}]},{"ID":"20240613102927-iefu33l","Type":"NodeParagraph","Properties":{"id":"20240613102927-iefu33l","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613102927-7vxy07a","Type":"NodeParagraph","Properties":{"id":"20240613102927-7vxy07a","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 清热，通便，利水，止血，杀虫。治大便燥结，淋浊，黄疸，吐血，肠风，功能性子宫出血，秃疮，疥癣，痈肿，跌打损伤。"}]},{"ID":"20240613102927-ostkclg","Type":"NodeParagraph","Properties":{"id":"20240613102927-ostkclg","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"清热解毒，杀虫止痒，通便。用于皮肤病、疥癣、各种出血、肝炎及各种炎症。"}]},{"ID":"20240613102927-qlypyi0","Type":"NodeParagraph","Properties":{"id":"20240613102927-qlypyi0","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主头秃疥瘙，除热，女子阴蚀。\""}]},{"ID":"20240613102927-8nyij4c","Type":"NodeParagraph","Properties":{"id":"20240613102927-8nyij4c","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主浸淫疽痔，杀虫。\""}]},{"ID":"20240613102927-hbfrzh1","Type":"NodeParagraph","Properties":{"id":"20240613102927-hbfrzh1","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治癣，杀一切虫肿毒，醋摩贴。\""}]},{"ID":"20240613102927-nn20171","Type":"NodeParagraph","Properties":{"id":"20240613102927-nn20171","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"④《滇南本草图说》：\"晒干为末，敷马刀，石痈，疔毒，癣疮，疥癞，痈疽，瘘疬等症，用醋为使，破烂用油调搽。\""}]},{"ID":"20240613102927-apopnol","Type":"NodeParagraph","Properties":{"id":"20240613102927-apopnol","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》整理本：\"治诸热毒，泻六腑实火，泻六经客热，退虚痨发烧，利小便，治热淋。杀虫，搽癣疮、癞疮。\""}]},{"ID":"20240613102927-xlmmisx","Type":"NodeParagraph","Properties":{"id":"20240613102927-xlmmisx","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613102927-rumc0i7","Type":"NodeParagraph","Properties":{"id":"20240613102927-rumc0i7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；捣汁或熬膏。外用：捣敷，磨汁涂或煎水洗。"}]},{"ID":"20240613102927-sx6cjv0","Type":"NodeParagraph","Properties":{"id":"20240613102927-sx6cjv0","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613102927-9iu7wdz","Type":"NodeParagraph","Properties":{"id":"20240613102927-9iu7wdz","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" ①治大便卒涩结不通：羊蹄根一两（锉）。以水一大盏，煎取六分，去滓，温温顿服之。（《圣惠方》）"}]},{"ID":"20240613102927-gz77zkx","Type":"NodeParagraph","Properties":{"id":"20240613102927-gz77zkx","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"②治产后风秘：羊蹄根锉研，绞取汁三、二匙，水半盏，煎一、二沸，温温空肚服。（《本草衍义》）"}]},{"ID":"20240613102927-6qsynzo","Type":"NodeParagraph","Properties":{"id":"20240613102927-6qsynzo","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"③治赤白浊：羊蹄根每用三钱至五钱。水煎服。（《中医药实验研究》）"}]},{"ID":"20240613102927-xmhbq29","Type":"NodeParagraph","Properties":{"id":"20240613102927-xmhbq29","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"④治湿热黄疸：羊蹄根五钱，五加皮五钱。水煎服。（《江西民间草药》）"}]},{"ID":"20240613102927-4tddq4h","Type":"NodeParagraph","Properties":{"id":"20240613102927-4tddq4h","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑤治热郁吐血：羊蹄草根和麦门冬煎汤饮，或熬膏，炼蜜收，白汤调服数匙。（《本草汇言》）"}]},{"ID":"20240613102927-fc84obq","Type":"NodeParagraph","Properties":{"id":"20240613102927-fc84obq","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑥治肠风下血：败毒菜根（洗切）、连皮老姜各半盏。同炒赤，以无灰酒淬之，碗盖少倾，去滓，任意饮。（《永类钤方》）"}]},{"ID":"20240613102927-qja9o11","Type":"NodeParagraph","Properties":{"id":"20240613102927-qja9o11","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑦治内痔便血：羊蹄根八钱至一两，较肥的猪肉四两。放瓦罐内，加入清水，煮至肉极烂时，去药饮汤。（《江西民间草药》）"}]},{"ID":"20240613102927-zeqjfsv","Type":"NodeParagraph","Properties":{"id":"20240613102927-zeqjfsv","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑧治肛门周围炎症：羊蹄根（鲜品）一两到一两半。水煎冲冰糖，早晚空腹服。（福建《中草药新医疗法资料选编》）"}]},{"ID":"20240613102927-44tx3rf","Type":"NodeParagraph","Properties":{"id":"20240613102927-44tx3rf","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑨治女人阴蚀疼痛：羊蹄煎汤揉洗。（《本草汇言》）"}]},{"ID":"20240613102927-j77ksfb","Type":"NodeParagraph","Properties":{"id":"20240613102927-j77ksfb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑩治喉痹卒不语：羊蹄独根者，勿见风日，以三年醋研和如泥，生布拭喉令亦，敷之。（《千金方》）"}]},{"ID":"20240613102927-xww4q6n","Type":"NodeParagraph","Properties":{"id":"20240613102927-xww4q6n","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑾治疬疡风：羊蹄草根，于生铁上酽醋磨，旋旋刮取，涂于患上；未瘥，更入硫黄少许，同磨涂之。（《圣惠方》）"}]},{"ID":"20240613102927-njz7tgp","Type":"NodeParagraph","Properties":{"id":"20240613102927-njz7tgp","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⑿治白秃：羊蹄草根（独根者，勿见风日），以三年醋研和如泥，生布拭疮令去，以敷之。（《补缺肘后方》）"}]},{"ID":"20240613102927-8g5m9kd","Type":"NodeParagraph","Properties":{"id":"20240613102927-8g5m9kd","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒀治疥：羊蹄根（捣），和猪脂涂上，或着少盐佳。（《姚僧坦集验方》）"}]},{"ID":"20240613102927-jyx7982","Type":"NodeParagraph","Properties":{"id":"20240613102927-jyx7982","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒁治细癣：羊蹄根于磨石上以苦酒磨之，以敷疮上；当先刮疮，以火炙干后敷四、五过。（《千金方》）"}]},{"ID":"20240613102927-nv49k7u","Type":"NodeParagraph","Properties":{"id":"20240613102927-nv49k7u","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒂治癣疮久不瘥：羊蹄根捣绞取汁，用调腻粉少许如膏，涂敷癣上，三、五遍；如干，即猪脂调和敷之。（《简要济众方》）"}]},{"ID":"20240613102927-nqi47kr","Type":"NodeParagraph","Properties":{"id":"20240613102927-nqi47kr","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒃治瘙窟温癣痒，浸淫日广，痒不可忍，搔之黄水出，瘥后复发：取羊蹄根去土，细切捣碎敷上一时间，以冷水洗，日一敷，若为末敷之亦得。（《履幢岩本草》）"}]},{"ID":"20240613102927-xhn6t31","Type":"NodeParagraph","Properties":{"id":"20240613102927-xhn6t31","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒄治头风白屑：羊蹄草根曝干，捣罗为末，以羊胆汁调，揩涂头上。（《圣惠方》）"}]},{"ID":"20240613102927-pfek29o","Type":"NodeParagraph","Properties":{"id":"20240613102927-pfek29o","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒅治汗斑初起：硼砂研末，用鲜羊蹄根蘸擦之；或单用鲜羊蹄根擦患处。初起者有效。（《中医药实验研究》）"}]},{"ID":"20240613102927-2ay16c7","Type":"NodeParagraph","Properties":{"id":"20240613102927-2ay16c7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒆治跌打损伤：鲜羊蹄根适量，捣烂，用酒炒热，敷患处。（《福建中草药》）"}]},{"ID":"20240613102927-hzizufx","Type":"NodeParagraph","Properties":{"id":"20240613102927-hzizufx","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"⒇结肠（便闭）。用羊蹄根一两，加水一大碗，煎至六成，温服。"}]},{"ID":"20240613102927-ujs1lnd","Type":"NodeParagraph","Properties":{"id":"20240613102927-ujs1lnd","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"（21）肠风下血。用羊蹄根洗净，切细，加连皮老姜各半碗，是炒赤，以酒淬过，去渣，适量饮服。"}]},{"ID":"20240613102927-191gn4x","Type":"NodeParagraph","Properties":{"id":"20240613102927-191gn4x","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"（22）喉痹。用羊蹄根，在陈醋中研成泥。先以布把喉外擦红，再把药涂上。"}]},{"ID":"20240613102927-h3ysqnq","Type":"NodeParagraph","Properties":{"id":"20240613102927-h3ysqnq","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"（23）顽癣。用羊蹄根绞出汁，加轻粉少许，调成膏涂癣上，三、五次即愈。又方：用羊蹄根五升，在桑柴火上煮开四、五次，取汁洗癣，同时以羊蹄汁和矾末涂搽。"}]},{"ID":"20240613102927-hwxhh5y","Type":"NodeParagraph","Properties":{"id":"20240613102927-hwxhh5y","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"（24）湿癣（痒不可忍，出黄水，愈后易复发）。用羊蹄根捣烂，和醋调匀涂搽。过一阵，用冷水洗去。一天治一次。析采得的羊蹄磨醋涂癣，有奇效。"}]},{"ID":"20240613102927-yu6u9xs","Type":"NodeParagraph","Properties":{"id":"20240613102927-yu6u9xs","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613102927-b9wli09","Type":"NodeParagraph","Properties":{"id":"20240613102927-b9wli09","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 治疗功能性子宫出血：取尼泊尔羊蹄干品30克，煎分3次服；或用尼泊尔羊蹄粉3克，开水冲服，每日3～4次。治疗42例，平均4天止血。重症33例，显效13例，有效17例，无效3例；轻症9例，显效4例，有效4例，无效1例。"}]},{"ID":"20240613102927-eqyks9b","Type":"NodeParagraph","Properties":{"id":"20240613102927-eqyks9b","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613102927-q01oija","Type":"NodeParagraph","Properties":{"id":"20240613102927-q01oija","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613102927-oo6e2m7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613102927-oo6e2m7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"《中华本草》：羊蹄"}]},{"ID":"20240613102927-7mp1u90","Type":"NodeParagraph","Properties":{"id":"20240613102927-7mp1u90","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613102927-gjw5620","Type":"NodeParagraph","Properties":{"id":"20240613102927-gjw5620","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" Yánɡ Tí"}]},{"ID":"20240613102927-dld4r0n","Type":"NodeParagraph","Properties":{"id":"20240613102927-dld4r0n","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613102927-o60xszo","Type":"NodeParagraph","Properties":{"id":"20240613102927-o60xszo","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 东方宿、连虫陆、鬼目、败毒菜根、羊蹄大黄、土大黄、牛舌根、牛蹄、牛舌大黄、野萝卜、野菠菱、癣药、山萝卜、牛舌头、牛大黄"}]},{"ID":"20240613102927-19bnnn5","Type":"NodeParagraph","Properties":{"id":"20240613102927-19bnnn5","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613102927-2q05fs3","Type":"NodeParagraph","Properties":{"id":"20240613102927-2q05fs3","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.陶弘景：羊蹄今人呼名秃菜，即是蓄音之讹。《诗》云，言采其蓄。又一种极相似而味酸，呼为酸模，根亦疗疥也。"}]},{"ID":"20240613102927-mqczj45","Type":"NodeParagraph","Properties":{"id":"20240613102927-mqczj45","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《图经》云，羊蹄生下湿地。高者三、四尺，叶狭长，茎节间紫赤，花青白色，子三棱，夏中即枯。又有一种茎叶俱细，节间生子若茺蔚子，疗痢乃佳，今所在有之。"}]},{"ID":"20240613102927-6duyog5","Type":"NodeParagraph","Properties":{"id":"20240613102927-6duyog5","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613102927-paqvg2z","Type":"NodeParagraph","Properties":{"id":"20240613102927-paqvg2z","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蓼科植物羊蹄或尼泊尔羊蹄的根。"}]},{"ID":"20240613102927-cos8yty","Type":"NodeParagraph","Properties":{"id":"20240613102927-cos8yty","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Rumex japonicus Houtt.2．Rumex nepalensis Spreng."}]},{"ID":"20240613102927-rkuovt6","Type":"NodeParagraph","Properties":{"id":"20240613102927-rkuovt6","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种2年后，秋季当地上叶变黄时，挖出根部，洗净鲜用或切片晒干。"}]},{"ID":"20240613102927-ffunpc4","Type":"NodeParagraph","Properties":{"id":"20240613102927-ffunpc4","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613102927-wed6n9t","Type":"NodeParagraph","Properties":{"id":"20240613102927-wed6n9t","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山野、路旁、湿地。"}]},{"ID":"20240613102927-x7ksg6b","Type":"NodeParagraph","Properties":{"id":"20240613102927-x7ksg6b","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.生于沟谷、河岸及湿地。"}]},{"ID":"20240613102927-ee63uj0","Type":"NodeParagraph","Properties":{"id":"20240613102927-ee63uj0","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布我国东北、华北、华东、中南各地。"}]},{"ID":"20240613102927-444yxgf","Type":"NodeParagraph","Properties":{"id":"20240613102927-444yxgf","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.分布于西南及陕西、甘肃、青海、江苏、江西、湖北、湖南、西藏等地。"}]},{"ID":"20240613102927-prd1mg5","Type":"NodeParagraph","Properties":{"id":"20240613102927-prd1mg5","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613102927-5ehums8","Type":"NodeParagraph","Properties":{"id":"20240613102927-5ehums8","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 1.多年生草本，高60-100cm。根粗大，断面黄色。茎直立，通常不分枝。单叶互生，具柄；叶片长圆形至长圆状披针形，基生叶较大，长16-22cm，宽4-9cm，先端急尖，基部圆形至微心形，边缘微状波皱褶。总状花序顶生，每节花簇略下垂；花两性，花被片6，淡绿色，外轮3片展开，内轮3片成果被；果被广卵形，有明显的网纹，背面各具一卵形疣状突起，其表面有细网纹，边缘具不整齐的微齿；雄蕊6，成3对；子房具棱，1室，1胚珠，花柱3，柱头细裂。瘦果宽卵形，有3棱，先端尖，角棱锐利，长约2mm，黑褐色，光亮。花期4月，果期5月。"}]},{"ID":"20240613102927-jm8789b","Type":"NodeParagraph","Properties":{"id":"20240613102927-jm8789b","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.本品与羊蹄的区别在于：叶片卵状长圆形，下部较宽，先端急尖或钝尖，基部心形或近圆形，两面的叶脉及叶缘均被白色短毛；结果时增大的内花被边缘具7-10对针刺，针刺先瑞呈钩状弯曲。花期5-6月，果期6-7月。"}]},{"ID":"20240613102927-luid04i","Type":"NodeParagraph","Properties":{"id":"20240613102927-luid04i","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613102927-xehayke","Type":"NodeParagraph","Properties":{"id":"20240613102927-xehayke","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽、湿润的环境，能耐严寒，干旱及高温、高湿条件生长不良，产量低。土壤要求上层深厚、肥沃、疏松，地下水位砂质壤上及腐殖质壤上为最好。坚硬的粘土及阴湿、低洼积水地区均不宜栽培。"}]},{"ID":"20240613102927-39mkd1z","Type":"NodeParagraph","Properties":{"id":"20240613102927-39mkd1z","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子及分根繁殖。种子繁殖：在春、夏、秋三季均可播种。由于羊蹄是一种深根性的植物，为了提高根的产量，整地时必须深翻上地，耕深不少30cm，并施足基肥。耕翻后打碎土块，耙平作成宽60cm、高25cm的高垅，条播或穴播。"}]},{"ID":"20240613102927-1gvpo5g","Type":"NodeParagraph","Properties":{"id":"20240613102927-1gvpo5g","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"为便于苗期管理，以条播为好。如果采用新收的种子，不须任何处理，如果播种前用温水（20℃以下）浸泡1d，可提前出苗。北方5月播种，播种后10～15d出苗。每1hm2播种量约10．5kg,覆土3cm，播后要及时浇水，并保持土壤潮湿。出苗后，结合松土、除草间苗1～2次。分根繁殖：将母株根头分成数块，每块至少有芽l-2个，然后按60cmx45cm行株距穴栽，每1hm2约需种块2250kg。"}]},{"ID":"20240613102927-ewuotvy","Type":"NodeParagraph","Properties":{"id":"20240613102927-ewuotvy","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"田间管理 出苗后要及时中耕除草、追肥、浇水，特别是天气干旱更要及时浇水。除作种用植株外，及早摘去花茎，可提高根的产量。种植期间要进行1～2次田间培土工作，以促进根的生长。"}]},{"ID":"20240613102927-i4es8je","Type":"NodeParagraph","Properties":{"id":"20240613102927-i4es8je","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613102927-xdz0d2s","Type":"NodeParagraph","Properties":{"id":"20240613102927-xdz0d2s","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）羊蹄 根类圆锥形，长6－18cm，直径0．8-1．8cm。根头部有残留茎基及支根痕。根表面棕灰色，具纵皱纹及横向突起的皮孔祥疤痕。质硬易折断，断面灰黄色颗粒状。气特殊，味微苦涩。"}]},{"ID":"20240613102927-glofgzt","Type":"NodeParagraph","Properties":{"id":"20240613102927-glofgzt","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"（ 2）尼泊尔酸模 根类圆锥形，下部有分枝，长约13cm，直径达2.5cm。根头部具残留茎基及支根痕，周围具少量干枯的棕色叶基纤维，其下有密集横纹。根表面黄灰色，多纵沟及横长皮孔样疤痕。质硬易折断，折断面淡棕色。气微，味苦涩。"}]},{"ID":"20240613102927-zebqsog","Type":"NodeParagraph","Properties":{"id":"20240613102927-zebqsog","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：（1）羊蹄 木栓层稍厚。皮层无机械组织。韧皮部细胞压缩。形成层呈环状。木质部导管单个散在或数个成群，少数伴有纤维束，呈径向排列，较稀疏。薄壁细胞含众多淀粉粒及草酸钙簇晶。淀粉粒长圆形或类球形，长3-27μm，簇晶直径 38-115μm。此外，尚含黄棕色物。根头部中心有髓。（2）尼泊尔酸模 木栓层薄。木质部导管无纤维束伴随。薄壁细胞含淀粉粒，类梭形或类球形，长5-46μm。本品薄壁细胞不含草酸钙簇晶。"}]},{"ID":"20240613102927-xn2lb5g","Type":"NodeParagraph","Properties":{"id":"20240613102927-xn2lb5g","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"理化鉴别 （1）取本品粉末．1g，加稀硫酸5ml，煮沸2min，趁热滤过，滤液放冷，加乙醚5ml，振摇，乙醚液即染成黄色。分取乙醚液，加氨试液2ml，振摇，氨液层即成红色，醚层仍显黄色。（检查蒽醌衍生物）（2）薄层色谱 取本品粉末0.2g,用甲醇浸浸泡5-6h，上清液作供试液；另取大黄素、大黄素甲醚、大黄酚作对照品。分别点样于同一硅胶G薄层板上，以苯-甲酸乙酯-甲酚-甲醇（3：1：1．05：2）展开，置紫外光灯（365nm）下检视，供试液色谱在与对照品色谱的相应位置上，显相同的橙红色荧光。"}]},{"ID":"20240613102927-1w5z5vw","Type":"NodeParagraph","Properties":{"id":"20240613102927-1w5z5vw","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613102927-7fdxdcw","Type":"NodeParagraph","Properties":{"id":"20240613102927-7fdxdcw","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 羊蹄报及根茎含有结合及游离的大黄素（emodin），大黄素甲醚（physcion），大黄酚（chrysophanol），总量l．73％，其中结合型0．27％，游离型l．46%[1]。还含有酸模素（musizin）即是尼泊尔羊蹄素[1]。"}]},{"ID":"20240613102927-ezk8f0s","Type":"NodeParagraph","Properties":{"id":"20240613102927-ezk8f0s","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"尼泊尔酸模根及根茎含结合和游离的大黄素、大黄素甲醚、大黄酚，总量l．42%，其中结合型0．51％，游离型0．91％，还含有酸模素和鞣质[1]。"}]},{"ID":"20240613102927-b7x3ua3","Type":"NodeParagraph","Properties":{"id":"20240613102927-b7x3ua3","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613102927-wbekdxa","Type":"NodeParagraph","Properties":{"id":"20240613102927-wbekdxa","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 1.抑菌作用 羊蹄根酊剂在试管内对多种致病真菌有一定的抑制作用。"}]},{"ID":"20240613102927-7v6mht8","Type":"NodeParagraph","Properties":{"id":"20240613102927-7v6mht8","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.预防感染作用 将根(品种未鉴定)煎剂与亚洲甲型流感病毒在试管内直接接触后注入鸡胚，有预防感染的作用，尿囊液蛋白质可大大降低这一作用。"}]},{"ID":"20240613102927-hn5jdsm","Type":"NodeParagraph","Properties":{"id":"20240613102927-hn5jdsm","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"3.对血液系统的作用 羊蹄根(品种未鉴定)煎剂浓缩后酒精提取物对急性淋巴细胞型白血病、急性单核细胞型白血病和急性粒细胞型白血病患者血细胞脱氢酶都有抑制作用(试管中美蓝脱色法)，对前两者白细胞的呼吸有一定的抑制作用(瓦氏呼吸器测定法)。"}]},{"ID":"20240613102927-m58h3rz","Type":"NodeParagraph","Properties":{"id":"20240613102927-m58h3rz","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"4.副作用：羊蹄含草酸，大剂量应用时有毒。大黄素的药理作用参见大黄条。"}]},{"ID":"20240613102927-p21kl6h","Type":"NodeParagraph","Properties":{"id":"20240613102927-p21kl6h","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"5.降压作用：同属植物团酸模RumexconfertusWilld.的醇提水溶液对动物有持久的、中枢性的降低血压的作用。"}]},{"ID":"20240613102927-6f0q070","Type":"NodeParagraph","Properties":{"id":"20240613102927-6f0q070","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"6.对消化系作用：与大黄相似，小剂量有收敛，大量有轻泻作用。并能反射性的利胆，亦有某些止血作用。"}]},{"ID":"20240613102927-kn34vkb","Type":"NodeParagraph","Properties":{"id":"20240613102927-kn34vkb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613102927-u6aa3s7","Type":"NodeParagraph","Properties":{"id":"20240613102927-u6aa3s7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 心；肝；大肠经"}]},{"ID":"20240613102927-ozzgzmb","Type":"NodeParagraph","Properties":{"id":"20240613102927-ozzgzmb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613102927-lgp56ge","Type":"NodeParagraph","Properties":{"id":"20240613102927-lgp56ge","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 苦；性寒"}]},{"ID":"20240613102927-fxx10ky","Type":"NodeParagraph","Properties":{"id":"20240613102927-fxx10ky","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613102927-m7z1u2t","Type":"NodeParagraph","Properties":{"id":"20240613102927-m7z1u2t","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：脾胃虚寒，泄泻不食者切勿入口。"}]},{"ID":"20240613102927-e4ngzyb","Type":"NodeParagraph","Properties":{"id":"20240613102927-e4ngzyb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613102927-dcqywoa","Type":"NodeParagraph","Properties":{"id":"20240613102927-dcqywoa","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 清热通便；凉血止血；杀虫止痒。主大便秘结；吐血衄血；肠风便血；痔血；崩漏；疥癣；白秃；痈疮肿毒；跌打损伤"}]},{"ID":"20240613102927-ubjp8z0","Type":"NodeParagraph","Properties":{"id":"20240613102927-ubjp8z0","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613102927-gsimfoh","Type":"NodeParagraph","Properties":{"id":"20240613102927-gsimfoh","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 内服；煎汤，9-15；捣汁；或熬膏。外用：适量，捣敷；磨汁涂；或煎水洗。"}]},{"ID":"20240613102927-auwz1ay","Type":"NodeParagraph","Properties":{"id":"20240613102927-auwz1ay","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613102927-3ujbwbi","Type":"NodeParagraph","Properties":{"id":"20240613102927-3ujbwbi","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 1.羊蹄根散(《医宗金鉴》)，主治癣。2.验方(《圣惠方》)：羊蹄根，以水一大盏，煎取六分，去滓，温温顿服之，主治便秘。"}]},{"ID":"20240613102927-0nm1qxb","Type":"NodeParagraph","Properties":{"id":"20240613102927-0nm1qxb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613102927-25pz8jo","Type":"NodeParagraph","Properties":{"id":"20240613102927-25pz8jo","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主头秃疥瘙，除热，女子阴蚀。"}]},{"ID":"20240613102927-mlx01zf","Type":"NodeParagraph","Properties":{"id":"20240613102927-mlx01zf","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主浸淫疽痔，杀虫。"}]},{"ID":"20240613102927-ykxcojr","Type":"NodeParagraph","Properties":{"id":"20240613102927-ykxcojr","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：治癣，杀一切虫肿毒，醋摩贴。"}]},{"ID":"20240613102927-13m0pd5","Type":"NodeParagraph","Properties":{"id":"20240613102927-13m0pd5","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"4.《滇南本草图说》：晒干为末，敷马刀，石痈，疔毒，癣疮，疥癞，痈疽，瘘疬等症，用醋为使，破烂用油调搽。"}]},{"ID":"20240613102927-hg72jqb","Type":"NodeParagraph","Properties":{"id":"20240613102927-hg72jqb","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》整理本：治诸热毒，泻六腑实火，泻六经客热，退虚痨发烧，利小便，治热淋。杀虫，搽癣疮、癞疮。"}]},{"ID":"20240613102927-gphtepk","Type":"NodeParagraph","Properties":{"id":"20240613102927-gphtepk","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613102927-ls5wqq7","Type":"NodeParagraph","Properties":{"id":"20240613102927-ls5wqq7","updated":"20240613102927"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613102928-58y9udk","Type":"NodeThematicBreak","Properties":{"id":"20240613102928-58y9udk"}},{"ID":"20240613102929-fj7umfs","Type":"NodeParagraph","Properties":{"id":"20240613102929-fj7umfs"}}]}