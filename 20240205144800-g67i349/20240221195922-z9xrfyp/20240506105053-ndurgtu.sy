{"ID":"20240506105053-ndurgtu","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506105053-ndurgtu","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506105053-ndurgtu\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240702135238-pt780p2\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613134736-gbteau9\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240702144114-6uf7t4m\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"321桐叶","type":"doc","updated":"20240827102226"},"Children":[{"ID":"20240702135238-pt780p2","Type":"NodeParagraph","Properties":{"id":"20240702135238-pt780p2","updated":"20240702135238"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 309px;","style":"width: 299px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桐叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桐叶-20240702135238-puqfn12.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 299px;\" parent-style=\"width: 309px;\"}"}]},{"ID":"20240702142205-2ztv9ot","Type":"NodeParagraph","Properties":{"id":"20240702142205-2ztv9ot","updated":"20240702142205"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 447px;","style":"width: 437px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泡桐4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泡桐4-20240702142205-qkcoxaj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 437px;\" parent-style=\"width: 447px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827092830-hs0wntn","Type":"NodeParagraph","Properties":{"id":"20240827092830-h