}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 407px;\" parent-style=\"width: 417px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827092433-9vfkjcn","Type":"NodeParagraph","Properties":{"id":"20240827092433-9vfkjcn","updated":"20240827101840"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：取图为泡桐树；"}]},{"ID":"20240613140115-4etjxi5","Type":"NodeThematicBreak","Properties":{"id":"20240613140115-4etjxi5"}},{"ID":"20240613140125-bkl6z65","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613140125-bkl6z65","updated":"20240613140133"},"Children":[{"Type":"NodeText","Data":"桐叶《神农本草经》"}]},{"ID":"20240613140125-z2q5d1s","Type":"NodeParagraph","Properties":{"id":"20240613140125-z2q5d1s","updated":"20240613140125"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613140125-6b8w70i","Type":"NodeParagraph","Properties":{"id":"20240613140125-6b8w70i","updated":"20240613140125"},"Children":[{"Type":"NodeText","Data":"主恶蚀，创着阴皮，主五痔，杀三虫。华主传猪创，饲猪，肥大三倍。生山谷。"}]},{"ID":"20240613140125-vbqet2g","Type":"NodeParagraph","Properties":{"id":"20240613140125-vbqet2g","updated":"20240613140125"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生桐柏山。"}]},{"ID":"20240613140125-y59q18y","Type":"NodeParagraph","Properties":{"id":"20240613140125-y59q18y","updated":"20240613140125"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桐，荣也，梧，梧桐木，一名榇。《尔雅》云：榇梧。郭璞云：今梧桐，又荣桐木。郭璞云：即梧桐。《毛诗》云：梧桐生矣。《传》云：梧桐柔木也。"}]},{"ID":"20240613140138-av78pk7","Type":"NodeThematicBreak","Properties":{"id":"20240613140138-av78pk7"}},{"ID":"20240613140139-mcj0pqj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613140139-mcj0pqj","updated":"20240613140144"},"Children":[{"Type":"NodeText","Data":"桐叶《神农本草经赞》"}]},{"ID":"20240613140139-1iokj1f","Type":"NodeParagraph","Properties":{"id":"20240613140139-1iokj1f","updated":"20240613140139"},"Children":[{"Type":"NodeText","Data":"味苦寒。主恶蚀创着阴皮。主五痔。杀三虫。华。主敷猪创。饲猪肥大三倍。生山谷。"}]},{"ID":"20240613140139-0iijuqa","Type":"NodeParagraph","Properties":{"id":"20240613140139-0iijuqa","updated":"20240613140139"},"Children":[{"Type":"NodeText","Data":"土宜五沃。拱把嘉桐。朝阳合抱。参极空中。凉琼夏荫。濡毳冬融。令仪君子。瑞应厢东。"}]},{"ID":"20240613140139-mn45dka","Type":"NodeParagraph","Properties":{"id":"20240613140139-mn45dka","updated":"20240613140139"},"Children":[{"Type":"NodeText","Data":"管子。五沃之土。其木宜桐。孟子。拱把之桐梓。夏侯湛赋。植嘉桐乎庭前。诗。于彼朝阳。陈翥诗。合抱由滋此。嵇康赋。参辰极而高骧。易纬。桐枝空中。高启诗。凉琼夏叶舒。"}]},{"ID":"20240613140139-ndf29s6","Type":"NodeParagraph","Properties":{"id":"20240613140139-ndf29s6","updated":"20240613140139"},"Children":[{"Type":"NodeText","Data":"徐茂诗。濡毳桐枝别作葩。广州志。白桐华有白毳。淹渍缉织为布。诗。其桐其椅。其实离离。岂弟君子。莫不令仪。瑞应图。王者任用贤良。梧桐生于东厢。"}]},{"ID":"20240613140154-h2anaas","Type":"NodeThematicBreak","Properties":{"id":"20240613140154-h2anaas"}},{"ID":"20240613140155-zwycwmz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613140155-zwycwmz","updated":"20240613140159"},"Children":[{"Type":"NodeText","Data":"桐叶《新修本草》"}]},{"ID":"20240613140155-bug5vb1","Type":"NodeParagraph","Properties":{"id":"20240613140155-bug5vb1","updated":"20240613140155"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主恶蚀疮着阴。皮主五痔，杀三虫。疗奔豚气病。华，敷猪疮，饲猪肥大三倍。生桐柏山谷。"}]},{"ID":"20240613140155-tpuusti","Type":"NodeParagraph","Properties":{"id":"20240613140155-tpuusti","updated":"20240613140155"},"Children":[{"Type":"NodeText","Data":"桐树有四种∶青桐，茎皮青，叶似梧桐而无子。梧桐，色白，叶似青桐有子，子肥亦可食。白桐与岗桐无异，惟有花子耳，花三月舒，黄紫色，《礼》云桐始花者也。岗桐无子，是作琴瑟者。今此云花，便应是白桐，白桐亦堪作琴瑟，一名椅桐，人家多植之。"}]},{"ID":"20240613140155-73g8v0r","Type":"NodeParagraph","Properties":{"id":"20240613140155-73g8v0r","updated":"20240613140155"},"Children":[{"Type":"NodeText","Data":"〔谨案〕古本草∶桐花饲猪，肥大三倍。今云敷疮，恐误矣，岂有故破伤猪，敷桐花者。"}]},{"ID":"20240613140115-044j0j2","Type":"NodeThematicBreak","Properties":{"id":"20240613140115-044j0j2"}},{"ID":"20240613140116-a80lxlv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613140116-a80lxlv","updated":"20240613140120"},"Children":[{"Type":"NodeText","Data":"桐叶《千金翼方》"}]},{"ID":"20240613140116-htx3au0","Type":"NodeParagraph","Properties":{"id":"20240613140116-htx3au0","updated":"20240613140116"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主恶蚀疮着阴。皮∶主五痔，杀三虫。疗贲豚气病。花∶主敷猪疮，饲猪肥大三倍。生桐柏山谷。"}]},{"ID":"20240613134732-6vlrqt8","Type":"NodeThematicBreak","Properties":{"id":"20240613134732-6vlrqt8"}},{"ID":"20240613140106-ovyfovl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613140106-ovyfovl","updated":"20240613140110"},"Children":[{"Type":"NodeText","Data":"桐叶《本草衍义》"}]},{"ID":"20240613140106-qo35p45","Type":"NodeParagraph","Properties":{"id":"20240613140106-qo35p45","updated":"20240613140106"},"Children":[{"Type":"NodeText","Data":"经注不指定是何桐，致难执用。今具四种桐，各有治疗，条其状列于后∶一种白桐，可斫琴者，叶三杈，开白花，亦不结子。《药性论》云∶“皮能治五淋，沐发，去头风，生发。”一种荏桐，早春先开淡红花，状如豉子花，成筒子，子或作桐油。《日华子》云∶“桐油冷，微毒。”一种梧桐，四月开淡黄小花，一如枣花。枝头出丝，堕地成油，沾渍衣履。五六月结桐子，今人收炒作果，动风气。此是《月令》清明之日桐始华者。一种岗桐。无花，不中作琴，体重。"}]},{"ID":"20240613134732-4nxym3c","Type":"NodeThematicBreak","Properties":{"id":"20240613134732-4nxym3c"}},{"ID":"20240613135001-d778zfx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613135001-d778zfx","updated":"20240613135016"},"Children":[{"Type":"NodeText","Data":"桐叶《证类本草》"}]},{"ID":"20240613135001-sfzd232","Type":"NodeParagraph","Properties":{"id":"20240613135001-sfzd232","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主恶蚀疮着阴。皮，主五痔，杀三虫，疗贲豚气病。"}]},{"ID":"20240613135001-rtilpvd","Type":"NodeParagraph","Properties":{"id":"20240613135001-rtilpvd","updated":"20240613135001"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"，主敷猪疮。饲猪，肥大三倍。生桐柏山谷。"}]},{"ID":"20240613135001-3a1wzwb","Type":"NodeParagraph","Properties":{"id":"20240613135001-3a1wzwb","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶桐树有四种，青桐，叶、皮青，似梧而无子。梧桐，色白，叶似青桐而有子，子桐无异，唯有花、子尔，花二月舒，黄紫色，《礼》云∶桐，始华者瑟者。今此云花，便应是白桐，白桐堪作琴瑟，一名椅桐，人家多植疮。恐误矣。岂有故破伤猪敷桐花者。臣禹锡等谨按尔雅疏云∶榇，一名梧。郭云∶今梧桐。《诗·大雅》云∶梧桐生矣，于彼朝阳是也。又曰∶桐木，一名荣。郭云∶即梧桐与榇梧一也。药性论云∶白桐皮，能治五淋。沐发去头风，生发滋润。"}]},{"ID":"20240613135001-20ivwb9","Type":"NodeParagraph","Properties":{"id":"20240613135001-20ivwb9","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"日华子云∶桐油，冷，微毒。敷恶疮疥及宣水肿，涂鼠咬处，能辟鼠。"}]},{"ID":"20240613135001-emii9qz","Type":"NodeParagraph","Properties":{"id":"20240613135001-emii9qz","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"图经曰∶桐，生桐柏山谷，今处处有之。其类有四种。旧注云∶青桐，枝、叶俱青而无子；梧桐，皮白，叶青而有子，子肥美可食；白桐，有华与子，其华二月舒，黄紫色，一名椅桐，又名黄桐，则药中所用华、叶者是也；岗桐，似白桐，唯无子，即是作琴瑟者。陆机《草水疏》云∶白桐宜为琴瑟。云南 人，绩以为布，似毛布。是作琴瑟宜岗桐、白桐二种也。"}]},{"ID":"20240613135001-iwcy4mq","Type":"NodeParagraph","Properties":{"id":"20240613135001-iwcy4mq","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"梧桐二种，俱有椅名也。或曰∶梧桐以知日月正闰。生十二叶，一边有六叶，从下数一叶为一月，至上十二叶。有闰十三叶，小余者。视之，则知闰何月也。故曰梧桐不生则九州异，或云今南人作油者，乃岗桐也，此桐亦有子，颇大于梧子耳。"}]},{"ID":"20240613135001-mldsn5k","Type":"NodeParagraph","Properties":{"id":"20240613135001-mldsn5k","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"江南有 桐，秋开红花，无实。有紫桐，花如百合，实堪糖煮以啖。岭南有刺桐，叶如梧桐，花侧敷如掌，枝干有刺，花色深红。主金殊效。又梧桐白皮，亦主痔。《删繁方》疗肠中生痔，肛门边有核者，猪悬蹄青用之，其膏敷疮，并酒服之。"}]},{"ID":"20240613135001-pxpi7go","Type":"NodeParagraph","Properties":{"id":"20240613135001-pxpi7go","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"子母秘录∶治痈疮疽痔 恶疮，小儿丹。用皮，水煎，敷。"}]},{"ID":"20240613135001-3aeb4mb","Type":"NodeParagraph","Properties":{"id":"20240613135001-3aeb4mb","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"衍义曰∶桐叶，《经》注不指定是何桐，致难执用。今具四种桐，各有治疗条，其状列于后∶一种白桐，可斫琴者，叶三杈，开白花，亦不结子。《药性论》云∶皮能治五淋，沐发，去头风，生发。一种荏桐，早春先开淡红花，状如鼓子花成筒子，子或作桐油。日华子云∶桐油，冷，微毒。一种梧桐，四月开淡黄小花，一如枣花。枝头出丝，堕地成油，沾渍衣履。"}]},{"ID":"20240613135001-yl180gs","Type":"NodeParagraph","Properties":{"id":"20240613135001-yl180gs","updated":"20240613135001"},"Children":[{"Type":"NodeText","Data":"一种岗桐，无花，不中作琴，体重。"}]},{"ID":"20240613134733-t5szkly","Type":"NodeThematicBreak","Properties":{"id":"20240613134733-t5szkly"}},{"ID":"20240613134923-wkdwjnu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134923-wkdwjnu","updated":"20240613134927"},"Children":[{"Type":"NodeText","Data":"桐叶《本草经集注》"}]},{"ID":"20240613134923-c6rye9d","Type":"NodeParagraph","Properties":{"id":"20240613134923-c6rye9d","updated":"20240613134923"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治恶蚀疮着阴。皮∶主五痔，杀三虫。治奔豚气病。花∶敷猪疮，饲猪肥大三倍，生桐柏山谷。"}]},{"ID":"20240613134923-x5icwxe","Type":"NodeParagraph","Properties":{"id":"20240613134923-x5icwxe","updated":"20240613134923"},"Children":[{"Type":"NodeText","Data":"桐树有四种∶青桐，茎皮青，叶似梧桐而无子。梧桐，色白，叶似青桐有子，子肥亦可食。白桐与岗桐无异，惟有花子尔。花三月舒，黄紫色，《礼》云桐始花者也。岗桐无子，是作琴瑟者。今此云花，便应是白桐，白桐亦堪作琴瑟，一名椅桐，人家多植之。"}]},{"ID":"20240613134733-k82w9pv","Type":"NodeThematicBreak","Properties":{"id":"20240613134733-k82w9pv"}},{"ID":"20240613134841-vgicbux","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134841-vgicbux","updated":"20240613134849"},"Children":[{"Type":"NodeText","Data":"桐叶《医学入门》"}]},{"ID":"20240613134841-wo6qtyq","Type":"NodeParagraph","Properties":{"id":"20240613134841-wo6qtyq","updated":"20240613134841"},"Children":[{"Type":"NodeText","Data":"处处有之，用白桐二月开淡红花，结子可作油者。叶，味苦，寒。无毒。主恶蚀疮着阴皮，主五痔，杀三虫，疗贲豚气病。皮，主五淋，浴发去头风，生发滋润，及痈疮疽痔 恶疮小儿丹，煎膏敷之。其花饲猪，肥大三倍。油，冷微毒。主消水肿，敷恶疮疥及鼠咬。一种梧桐，四月开淡黄小花如枣花，五六月结子，此即月令桐始花者，其子多食之动风气。白皮，主肠中生痔，肛门边有核者，又可敷疮，并酒服之。"}]},{"ID":"20240613134733-xb9ede5","Type":"NodeThematicBreak","Properties":{"id":"20240613134733-xb9ede5"}},{"ID":"20240613134734-oz9ero6","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240613134734-oz9ero6","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"桐叶"}]},{"ID":"20240613134734-pmfzxc2","Type":"NodeParagraph","Properties":{"id":"20240613134734-pmfzxc2","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613134734-ohmsrm6","Type":"NodeParagraph","Properties":{"id":"20240613134734-ohmsrm6","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" Tónɡ Yè"}]},{"ID":"20240613134734-jlhqdri","Type":"NodeParagraph","Properties":{"id":"20240613134734-jlhqdri","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613134734-sc9w6zu","Type":"NodeParagraph","Properties":{"id":"20240613134734-sc9w6zu","updated":"20240702135142"},"Children":[{"Type":"NodeText","Data":" 白桐叶（《本草经集注》）。"}]},{"ID":"20240613134734-5bqfd39","Type":"NodeParagraph","Properties":{"id":"20240613134734-5bqfd39","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613134734-5zavjqc","Type":"NodeParagraph","Properties":{"id":"20240613134734-5zavjqc","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613134734-5369sau","Type":"NodeParagraph","Properties":{"id":"20240613134734-5369sau","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613134734-40b7ttc","Type":"NodeParagraph","Properties":{"id":"20240613134734-40b7ttc","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 为玄参科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泡桐"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"毛泡桐"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613134734-qsff2m8","Type":"NodeParagraph","Properties":{"id":"20240613134734-qsff2m8","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613134734-mpt6ymk","Type":"NodeParagraph","Properties":{"id":"20240613134734-mpt6ymk","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 毛泡桐叶含熊果酸，并含糖甙及多酚类。"}]},{"ID":"20240613134734-xn2l1mr","Type":"NodeParagraph","Properties":{"id":"20240613134734-xn2l1mr","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613134734-xdweif9","Type":"NodeParagraph","Properties":{"id":"20240613134734-xdweif9","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 熊果酸不仅在化学上与齐墩果酸相近，作用也相近，为皂甙元，可作乳化剂用于制药或食品工业，对人或动物并无毒性。对水、盐代谢无明显作用。曾有人报告，与山楂酸之合剂能扩张冠状血管，可治疗冠脉循环及心功能不足，但也有人认为对冠状血管并无特异作用，而是由于其不溶于水，因而静脉注射后在体内形成小颗粒，伤害了肺脏，引起机体的各种反应。"}]},{"ID":"20240613134734-gax2em5","Type":"NodeParagraph","Properties":{"id":"20240613134734-gax2em5","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613134734-ans338e","Type":"NodeParagraph","Properties":{"id":"20240613134734-ans338e","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味苦，寒。\""}]},{"ID":"20240613134734-igzooje","Type":"NodeParagraph","Properties":{"id":"20240613134734-igzooje","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613134734-x1suwz7","Type":"NodeParagraph","Properties":{"id":"20240613134734-x1suwz7","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613134734-vdzd471","Type":"NodeParagraph","Properties":{"id":"20240613134734-vdzd471","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 治痈疽，疔疮，创伤出血。"}]},{"ID":"20240613134734-4zjb4uv","Type":"NodeParagraph","Properties":{"id":"20240613134734-4zjb4uv","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主恶蚀疮着阴。\""}]},{"ID":"20240613134734-rwsyh0f","Type":"NodeParagraph","Properties":{"id":"20240613134734-rwsyh0f","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"消肿毒，生发。\""}]},{"ID":"20240613134734-2nye4s0","Type":"NodeParagraph","Properties":{"id":"20240613134734-2nye4s0","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613134734-rgqepk9","Type":"NodeParagraph","Properties":{"id":"20240613134734-rgqepk9","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 外用：以醋蒸贴、捣敷或捣汁涂。内服：煎汤，0.5～1两。"}]},{"ID":"20240613134734-r4jfwve","Type":"NodeParagraph","Properties":{"id":"20240613134734-r4jfwve","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613134734-hwluqdp","Type":"NodeParagraph","Properties":{"id":"20240613134734-hwluqdp","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" ①治痈疽发背大如盘，臭腐不可近：桐叶醋蒸贴上，退热止痛，渐渐生肉收口。（《医林正宗》）"}]},{"ID":"20240613134734-t7ha5x8","Type":"NodeParagraph","Properties":{"id":"20240613134734-t7ha5x8","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"②治无名肿毒：泡桐花或叶、醉鱼草各五钱。捣敷。（江西《草药手册》）"}]},{"ID":"20240613134734-ojqu45o","Type":"NodeParagraph","Properties":{"id":"20240613134734-ojqu45o","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"③治白喉：霜打泡桐叶一两。水煎，红糖一两冲服。（《河南中草药手册》）"}]},{"ID":"20240613134734-k3e22ln","Type":"NodeParagraph","Properties":{"id":"20240613134734-k3e22ln","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"④抬人须鬓秃落不生长：麻子仁三升，白桐叶一把。米泔煮五、六沸，去滓，洗之。（《补缺肘后方》）"}]},{"ID":"20240613134734-sq54wao","Type":"NodeParagraph","Properties":{"id":"20240613134734-sq54wao","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613134734-lcwiuju","Type":"NodeParagraph","Properties":{"id":"20240613134734-lcwiuju","updated":"20240613134734"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613134735-063ylrp","Type":"NodeThematicBreak","Properties":{"id":"20240613134735-063ylrp"}},{"ID":"20240613134736-gbteau9","Type":"NodeParagraph","Properties":{"id":"20240613134736-gbteau9"}}]}