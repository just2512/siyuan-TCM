{"ID":"20240506105056-b47vzec","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240506105056-b47vzec","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506105056-b47vzec\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240703083110-3uem66b\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613151033-xp46vly\u0026quot;,\u0026quot;scrollTop\u0026quot;:2900,\u0026quot;focusId\u0026quot;:\u0026quot;20240703083821-yeo6znb\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"330豚卵（猪睾丸）","type":"doc","updated":"20240827173100"},"Children":[{"ID":"20240703083110-3uem66b","Type":"NodeParagraph","Properties":{"id":"20240703083110-3uem66b","updated":"20240703083110"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 433px;","style":"width: 423px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"豚卵"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/豚卵-20240703083110-0bi69g6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 423px;\" parent-style=\"width: 433px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703083235-e3s256v","Type":"NodeParagraph","Properties":{"id":"20240703083235-e3s256v","updated":"20240703083235"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪-20240703083235-1cqkaas.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪4-20240703083744-smeob73.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703083821-yeo6znb","Type":"NodeParagraph","Properties":{"id":"20240703083821-yeo6znb","updated":"20240703083825"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪5-20240703083821-jcs47mh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪3-20240703083629-w7cqxy6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703083556-octsw2m","Type":"NodeParagraph","Properties":{"id":"20240703083556-octsw2m","updated":"20240827173100"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 632px;","style":"width: 622px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪2-20240703083556-qp612ky.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 622px;\" parent-style=\"width: 632px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 705px;","style":"width: 695px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"公野猪 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/公野猪 1-20240827173100-x8t3utv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 695px;\" parent-style=\"width: 705px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613151030-5u5uf1b","Type":"NodeThematicBreak","Properties":{"id":"20240613151030-5u5uf1b"}},{"ID":"20240613151244-09l49ce","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151244-09l49ce","updated":"20240613151256"},"Children":[{"Type":"NodeText","Data":"豚卵《神农本草经》"}]},{"ID":"20240613151244-69o40hl","Type":"NodeParagraph","Properties":{"id":"20240613151244-69o40hl","updated":"20240613151244"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240613151244-hnxdlgr","Type":"NodeParagraph","Properties":{"id":"20240613151244-hnxdlgr","updated":"20240613151244"},"Children":[{"Type":"NodeText","Data":"主惊痫，瘨疾，鬼注，蛊毒，除寒热，贲豚，五癃，邪气，挛缩。一名豚颠，悬蹄，主五痔，伏热，在肠，肠痈，内蚀。"}]},{"ID":"20240613151244-5h1m9m9","Type":"NodeParagraph","Properties":{"id":"20240613151244-5h1m9m9","updated":"20240613151244"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上歹歹歹下巾），小豕也，从豸省，象形，从又，持肉以给祭祀，篆文作豚。方言云：猪，其子或谓之豚，或谓之豯.吴扬之间，谓之猪子。"}]},{"ID":"20240613151030-r2ljaih","Type":"NodeThematicBreak","Properties":{"id":"20240613151030-r2ljaih"}},{"ID":"20240613151128-aik96dx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151128-aik96dx","updated":"20240613151133"},"Children":[{"Type":"NodeText","Data":"豚卵《名医别录》"}]},{"ID":"20240613151128-grobyr0","Type":"NodeParagraph","Properties":{"id":"20240613151128-grobyr0","updated":"20240613151128"},"Children":[{"Type":"NodeText","Data":"无毒．阴干藏之，勿令败．猪四足，小寒，治伤挞，诸败疮，下乳汁．心，主惊邪忧肾，冷利，理肾气，通膀胱．胆，治伤寒热渴．肚，补中益气，止渴利．齿，治小儿惊五月五日取． 膏，主生发．肪膏，主煎诸膏药，解斑蝥、芫青毒． 猪肉，味酸，冷狂病．凡猪肉，味苦，主闭血脉，弱筋骨，虚人肌，不可久食，病患金创者尤甚．猪屎寒热，黄胆，湿痹．又，猪耳中垢，主蛇伤．猪脑，主风眩，脑鸣及冻疮．"}]},{"ID":"20240613151128-va3vpva","Type":"NodeParagraph","Properties":{"id":"20240613151128-va3vpva","updated":"20240613151308"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶豚卵，味甘，温．主惊痫癫疾，鬼注蛊毒，除寒热，贲豚，五癃，邪气挛缩．一名豚颠，悬蹄，主五痔，伏热，在肠，肠痈，内蚀。"}]},{"ID":"20240613151214-utxat6v","Type":"NodeThematicBreak","Properties":{"id":"20240613151214-utxat6v"}},{"ID":"20240613151219-885e3ca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151219-885e3ca","updated":"20240613151226"},"Children":[{"Type":"NodeText","Data":"豚卵《新修本草》"}]},{"ID":"20240613151219-dpkz2c5","Type":"NodeParagraph","Properties":{"id":"20240613151219-dpkz2c5","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主惊痫，癫疾，鬼疰，蛊毒，除寒热，贲豚，五癃，邪气挛缩。一名豚颠。阴干藏之，勿令败。"}]},{"ID":"20240613151219-m2xop51","Type":"NodeParagraph","Properties":{"id":"20240613151219-m2xop51","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"猪悬蹄。主五痔，伏热在肠，肠痈内蚀。猪四足，小寒。疗伤挞，诸惊邪，忧恚。肾，冷利，理肾气，通膀胱。胆，疗伤寒热渴。肚，补中益气，止渴利。齿，主小儿惊痫，五月五日取。"}]},{"ID":"20240613151219-7l7bts5","Type":"NodeParagraph","Properties":{"id":"20240613151219-7l7bts5","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"膏，主生发。肪膏，主煎诸膏药，解斑蝥、芫青毒。 猪肉，味酸，冷，疗狂病。凡猪肉，味苦，主闭血脉，弱筋骨，虚人肌，不可久食，病患金创者尤甚。猪屎，主寒热，黄胆，湿痹。"}]},{"ID":"20240613151219-une45sd","Type":"NodeParagraph","Properties":{"id":"20240613151219-une45sd","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"猪为用最多，惟肉不宜人，人有多食，皆能暴肥，此盖虚肌故也。其脂能悦泽皮肤，作手膏不皲裂，肪膏煎药，无不用之。勿令中水，腊月者历年不坏，颈下，膏谓之负革脂，入道家用。其屎汁，极疗温毒。"}]},{"ID":"20240613151219-hjnj631","Type":"NodeParagraph","Properties":{"id":"20240613151219-hjnj631","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"食其肉饮酒，不可卧秋稻穣中。又白猪蹄白杂青者不可食，食猪膏，又忌乌梅也。"}]},{"ID":"20240613151219-63186zu","Type":"NodeParagraph","Properties":{"id":"20240613151219-63186zu","updated":"20240613151219"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶猪耳中垢，疗蛇伤。猪脑，主风眩，脑鸣及冻疮。血，痫，及鬼毒去来，寒热五癃，五脏，主小儿惊痫汗发。十二月上亥日取肪，内新瓦器中，埋亥地百日，主方家用之。又云一升脂，着鸡子白十四枚，更良。"}]},{"ID":"20240613151204-qjjnehd","Type":"NodeThematicBreak","Properties":{"id":"20240613151204-qjjnehd"}},{"ID":"20240613151205-1weofew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151205-1weofew","updated":"20240613151209"},"Children":[{"Type":"NodeText","Data":"豚卵《神农本草经赞》"}]},{"ID":"20240613151205-mtcoomt","Type":"NodeParagraph","Properties":{"id":"20240613151205-mtcoomt","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"味苦温。主惊痫癫疾。鬼注蛊毒。除寒热。贲豚。五癃。邪气挛缩。一名豚颠。悬蹄。主五痔。伏热在肠。肠痈内蚀。"}]},{"ID":"20240613151205-9aujc8v","Type":"NodeParagraph","Properties":{"id":"20240613151205-9aujc8v","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"豢息么。采收下体。祭设冬先。纳从咸比。操酒穣穣。涉波弥弥。琢分施。百骸湔洗。"}]},{"ID":"20240613151205-vv9bvld","Type":"NodeParagraph","Properties":{"id":"20240613151205-vv9bvld","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"说文。豕息也。豢以谷。尔雅注。最后生者。呼为么豚。李时珍曰。牡猪小者。多去卵。"}]},{"ID":"20240613151205-olf9nxe","Type":"NodeParagraph","Properties":{"id":"20240613151205-olf9nxe","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"易释文。豕去势。曰。诗。无以下体。礼。孟冬之月。祭先肾。保生要录。咸纳肾。"}]},{"ID":"20240613151205-jgups17","Type":"NodeParagraph","Properties":{"id":"20240613151205-jgups17","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"千金方。除阴茎中痛。史记传。淳于见禳田者。操一豚蹄。酒一盂。祝曰。穣穣满家。诗。"}]},{"ID":"20240613151205-1l7x3zk","Type":"NodeParagraph","Properties":{"id":"20240613151205-1l7x3zk","updated":"20240613151205"},"Children":[{"Type":"NodeText","Data":"涉波矣。又。河水弥弥。宋濂序。雕肝琢肾。周邦彦赋。或蹄而折。徐积诗。五脏孰云可湔洗。百骸终恐生虫窠。"}]},{"ID":"20240613151138-y56id82","Type":"NodeThematicBreak","Properties":{"id":"20240613151138-y56id82"}},{"ID":"20240613151139-wqy2gc2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151139-wqy2gc2","updated":"20240613151144"},"Children":[{"Type":"NodeText","Data":"豚卵《增广和剂局方药性总论》"}]},{"ID":"20240613151139-9rv7p1s","Type":"NodeParagraph","Properties":{"id":"20240613151139-9rv7p1s","updated":"20240613151139"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主惊痫癫疾，鬼疰蛊毒，除寒热，奔豚五癃，邪气挛缩。悬蹄∶主五痔，伏热在肠，肠痈内蚀。猪四足∶主伤挞诸败疮，下乳汁。心∶主惊邪忧恚。肾∶和理肾气，通利膀胱。胆∶主伤寒热渴。肚∶补中益气，止渴利。齿∶主小儿惊痫。肪膏∶主煎膏药，解斑蝥、芫青毒。凡猪肉∶主闭血脉，弱筋骨，虚人肌，不可久食，病患金疮者尤甚。"}]},{"ID":"20240613151139-z61qlyu","Type":"NodeParagraph","Properties":{"id":"20240613151139-z61qlyu","updated":"20240613151139"},"Children":[{"Type":"NodeText","Data":"猪屎∶主寒热，黄胆，湿痹。日华子云∶猪，凉，微毒。肉疗水银风。久食令人虚肥，动风气。不可同牛肉煮食，令人生寸白虫。脂∶治皮肤风，杀虫，敷恶疮。肠∶止小便，补下焦。"}]},{"ID":"20240613151139-04pkxsh","Type":"NodeParagraph","Properties":{"id":"20240613151139-04pkxsh","updated":"20240613151139"},"Children":[{"Type":"NodeText","Data":"生血∶疗奔豚气及海外瘴气。又乳∶治小儿惊痫天吊，大人猪鸡痫病。孟诜云∶大猪头主补虚乏气力，去惊痫，五痔，下丹石。"}]},{"ID":"20240613151150-rgzohep","Type":"NodeThematicBreak","Properties":{"id":"20240613151150-rgzohep"}},{"ID":"20240613151151-2ihinr9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151151-2ihinr9","updated":"20240613151157"},"Children":[{"Type":"NodeText","Data":"豚卵《千金翼方》"}]},{"ID":"20240613151151-z0kmd2u","Type":"NodeParagraph","Properties":{"id":"20240613151151-z0kmd2u","updated":"20240613151151"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主惊痫癞疾，鬼疰蛊毒，除寒热贲豚，五癃邪气挛缩。一名豚颠。阴干藏之，勿令败。"}]},{"ID":"20240613151151-qhpqtuz","Type":"NodeParagraph","Properties":{"id":"20240613151151-qhpqtuz","updated":"20240613151151"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"悬蹄"}]},{"ID":"20240613151151-5h6de4p","Type":"NodeParagraph","Properties":{"id":"20240613151151-5h6de4p","updated":"20240613151151"},"Children":[{"Type":"NodeText","Data":"主五痔，伏热在肠，肠痈内蚀。"}]},{"ID":"20240613151030-gpspfjo","Type":"NodeThematicBreak","Properties":{"id":"20240613151030-gpspfjo"}},{"ID":"20240613151109-8157guf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151109-8157guf","updated":"20240613151122"},"Children":[{"Type":"NodeText","Data":"豚卵《本草图经》"}]},{"ID":"20240613151109-oxqmkzx","Type":"NodeParagraph","Properties":{"id":"20240613151109-oxqmkzx","updated":"20240613151113"},"Children":[{"Type":"NodeText","Data":"《本经》不著所出州土，云一名豚颠，阴干藏之，勿令败，谨按杨雄《方言》云：猪，燕、朝鲜之间谓之豭，关东西谓之彘，或谓之豕，南楚谓之狶（音喜）。其子谓之豯（音奚），吴扬之间谓之猪子，其实一种也。今云豚卵，当是猪子也。猪之属，为用最多。惟肉不宜食，食之多暴肥，盖风虚所致也。心，热，主血不足，补虚劣，不可多食，能耗心气。又不与吴茱萸合食。肺，微寒，能补肺，得大麻仁良。不与白花菜合食，令人气滞，发霍乱。肝，温，主冷泄，久滑赤白，乳妇赤白下方用子肝一叶，薄批之，揾著煨熟诃子末中，微火炙，又揾炙，尽半两末止，空腹细嚼，陈米饮送下，亦主冷劳腹脏虚者。脾，主脾胃虚热，以陈橘皮红、生姜、人参、葱白，切，拍之，合陈米水煮如羹，去橘皮，空腹食之。肾，补虚，壮气，消积滞。冬月不可食，损人真气，兼发虚壅。肚，主骨蒸热劳，血脉不行，补羸助气，四季宜食。张仲景有猪肚黄连丸是也。骨髓，寒，主补损恶疮。悬蹄，主痔、肠痈、内蚀。四蹄，主行妇人乳脉，滑肌肤，去寒热。《广济方》载其法云：妇人乳无汁者，以猪蹄四枚，治如食法，以水二斗，煮取一斗，去蹄，入土瓜根、通草、漏芦各三两，以汁煮取六升，去滓，内葱白、豉如常，著少米煮作稀葱豉粥食之。食了，或身体微微热，有少汗出佳；乳未下，更三、两剂，大验。肪膏，主诸恶疮，利血脉，解风热，润肺。入膏药，宜腊月亥日取之。肠脏，主大小肠风热宜食之。胰，寒，主肺气干胀喘急，润五脏，去皴疱。并肪膏，并杀斑猫、地胆、亭长等毒。然男子多食之损阳。崔元亮《海上方》著猪胰酒，疗冷痢久不瘥方。云此是脾气不足，暴冷入脾，舌上生疮，饮食无味，纵吃，食下还吐，小腹雷鸣，时时心闷，干皮细起，膝胫酸疼，两耳绝声，四肢沉重，日渐瘦劣，重成鬼气，及妇人血气不通，逆饭忧烦，行常无力，四肢不举，丈夫痃癖，两肋虚胀，变为水气，服之皆效验，此法出于传尸方。取猪胰一具，细切，与青蒿叶相和，以无灰酒一大升，微火温之，乘热内猪胰中，和蒿叶相共暖，使消尽，又取桂心一小两，别捣为末，内酒中，每日平旦空腹，取一小盏服之，午时夜间各再一服，甚验。忌热面油腻等食。胆，大寒，主骨热劳极，伤寒及渴疾，小儿五疳，杀虫。齿，主小儿惊痫，烧灰服之。屎，主寒热，黄疸，湿痹，今人取端午日南行猪零，合太一丹是也。燖猪汤，解诸毒虫魇。凡猪骨细，少筋多膏，大者有重百余斤，食物至寡，故人畜养之甚易生息。《尔雅》曰：彘，五尺为KT。郭璞注云：尸子曰：大豕为KT，今渔阳呼猪大者为KT是也。又下野猪黄条，主金疮。又云大寒，有毒，一名豪猪，鬃，间有毫如箭，能射人，陕、洛、江东诸山中并有之。肉亦甘美，多膏，皆不可多食，发风气，利大肠，令人虚羸。"}]},{"ID":"20240613151354-3cmsouy","Type":"NodeThematicBreak","Properties":{"id":"20240613151354-3cmsouy"}},{"ID":"20240613151356-togf5xb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151356-togf5xb","updated":"20240613151401"},"Children":[{"Type":"NodeText","Data":"豚卵《本草经集注》"}]},{"ID":"20240613151356-pqf3znv","Type":"NodeParagraph","Properties":{"id":"20240613151356-pqf3znv","updated":"20240613151356"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主治惊痫，癫疾，鬼疰，蛊毒，除寒热，贲豚，五癃，邪气挛缩，一名豚癫。阴干藏之，勿令败。猪悬蹄∶主治五痔，伏热在肠，肠痈内蚀。猪四足∶小寒。治伤挞，诸败疮，下乳汁。心∶主惊邪，忧恚。肾∶冷，和理肾气，通利膀胱。胆∶治伤寒热渴。肚∶补中益气，止渴利。齿∶主小儿惊痫，五月五日取。 膏∶主生发。肪膏∶主煎诸膏药，解斑蝥、芫青毒。 猪肉∶味酸，冷，治狂病。凡猪肉∶味苦，主闭血脉，弱筋骨，虚人肌，不可久食，病患金创者尤甚。猪屎∶主寒热，黄胆，湿痹。"}]},{"ID":"20240613151356-76xwqlr","Type":"NodeParagraph","Properties":{"id":"20240613151356-76xwqlr","updated":"20240613151356"},"Children":[{"Type":"NodeText","Data":"猪为用最多，惟肉不宜人，人有多食，皆能暴肥，此盖虚肌故也。其脂能悦泽皮肤，作手膏不皲裂，肪膏煎药，无不用之。勿令中水，腊月者历年不坏，颈上膏谓之负革脂，入道家用。其屎汁，极治温毒。食其肉饮酒，不可卧秫稻穣中。又白猪蹄白杂青者不可食，食猪膏，又忌乌梅也。"}]},{"ID":"20240613151030-x8jf6nx","Type":"NodeThematicBreak","Properties":{"id":"20240613151030-x8jf6nx"}},{"ID":"20240613151050-wd78igv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151050-wd78igv","updated":"20240613151101"},"Children":[{"Type":"NodeText","Data":"豚卵《证类本草》"}]},{"ID":"20240613151050-xtnmlse","Type":"NodeParagraph","Properties":{"id":"20240613151050-xtnmlse","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"味甘、温，无毒。主惊痫癫疾，鬼疰蛊毒，除寒热，贲豚五癃，邪气挛缩。一名豚颠。"}]},{"ID":"20240613151050-rj6dev2","Type":"NodeParagraph","Properties":{"id":"20240613151050-rj6dev2","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"阴干藏之，勿令败。"}]},{"ID":"20240613151050-zgilmpb","Type":"NodeParagraph","Properties":{"id":"20240613151050-zgilmpb","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"悬蹄"},{"Type":"NodeText","Data":"主五痔，伏热在肠，肠痈内蚀。"}]},{"ID":"20240613151050-3u32ube","Type":"NodeParagraph","Properties":{"id":"20240613151050-3u32ube","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按五痔通用药云∶猪悬蹄，平。药对云∶微寒。"}]},{"ID":"20240613151050-dkzhc4k","Type":"NodeParagraph","Properties":{"id":"20240613151050-dkzhc4k","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪四足"},{"Type":"NodeText","Data":"小寒。主伤挞诸败疮，下乳汁。"}]},{"ID":"20240613151050-zfbeioj","Type":"NodeParagraph","Properties":{"id":"20240613151050-zfbeioj","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心"},{"Type":"NodeText","Data":"主惊邪，忧恚。"}]},{"ID":"20240613151050-a8ab6xu","Type":"NodeParagraph","Properties":{"id":"20240613151050-a8ab6xu","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按日华子云∶心，治惊痫血癖，邪气。"}]},{"ID":"20240613151050-yhdppi4","Type":"NodeParagraph","Properties":{"id":"20240613151050-yhdppi4","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾"},{"Type":"NodeText","Data":"冷。和理肾气，通利膀胱。"}]},{"ID":"20240613151050-iznsh4z","Type":"NodeParagraph","Properties":{"id":"20240613151050-iznsh4z","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按孟诜云∶肾，主人肾虚，不可久食。日华子云∶肾，补水脏，暖腰膝，补膀胱，治耳聋。虽补肾，又令人少子。"}]},{"ID":"20240613151050-ajrq757","Type":"NodeParagraph","Properties":{"id":"20240613151050-ajrq757","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆"},{"Type":"NodeText","Data":"主伤寒热渴。"}]},{"ID":"20240613151050-01l71ba","Type":"NodeParagraph","Properties":{"id":"20240613151050-01l71ba","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按大便不通通用药云∶猪胆，微寒。"}]},{"ID":"20240613151050-oiw99r1","Type":"NodeParagraph","Properties":{"id":"20240613151050-oiw99r1","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肚"},{"Type":"NodeText","Data":"主补中益气，止渴利。"}]},{"ID":"20240613151050-jalohq4","Type":"NodeParagraph","Properties":{"id":"20240613151050-jalohq4","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按恶疮通用药云∶猪肚，微温。孟诜云∶肚，主暴痢虚弱。日华子云∶肚，补虚损，杀劳虫，止痢。酿黄糯米蒸捣为丸，甚治劳气并小儿疳蛔黄瘦病。"}]},{"ID":"20240613151050-mfbeu54","Type":"NodeParagraph","Properties":{"id":"20240613151050-mfbeu54","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"齿"},{"Type":"NodeText","Data":"主小儿惊痫。五月五日取。"}]},{"ID":"20240613151050-wwws6um","Type":"NodeParagraph","Properties":{"id":"20240613151050-wwws6um","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按惊痫通用药云∶猪齿，平。日华子云∶齿，治小儿惊痫。烧灰服，并治蛇咬。"}]},{"ID":"20240613151050-92snqjn","Type":"NodeParagraph","Properties":{"id":"20240613151050-92snqjn","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"膏"},{"Type":"NodeText","Data":"生发。"}]},{"ID":"20240613151050-3crwylg","Type":"NodeParagraph","Properties":{"id":"20240613151050-3crwylg","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按发秃通用药云∶猪 膏，微寒。"}]},{"ID":"20240613151050-dvja5ra","Type":"NodeParagraph","Properties":{"id":"20240613151050-dvja5ra","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肪膏"},{"Type":"NodeText","Data":"主煎诸膏药，解斑蝥、芫青毒。"}]},{"ID":"20240613151050-xrm738k","Type":"NodeParagraph","Properties":{"id":"20240613151050-xrm738k","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪肉"},{"Type":"NodeText","Data":"味酸，冷。疗狂病。"}]},{"ID":"20240613151050-wsiw8cr","Type":"NodeParagraph","Properties":{"id":"20240613151050-wsiw8cr","updated":"20240613151050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"凡猪肉"},{"Type":"NodeText","Data":"味苦。主闭血脉，弱筋骨，虚人肌。不可久食，病患、金疮者尤甚。"}]},{"ID":"20240613151050-klocopa","Type":"NodeParagraph","Properties":{"id":"20240613151050-klocopa","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"猪屎臣禹锡等谨按黄胆通用药云∶猪屎，寒。主寒热，黄胆，湿痹。陶隐居云∶猪，为用最多，唯肉不宜食，人有多食，皆能暴肥，此盖虚肥故也。其脂能悦皮肤，作手膏，不皲裂。肪膏煎药，无不用之。"}]},{"ID":"20240613151050-9h726qf","Type":"NodeParagraph","Properties":{"id":"20240613151050-9h726qf","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"勿令水中。腊月者历年不坏。"}]},{"ID":"20240613151050-4292wg2","Type":"NodeParagraph","Properties":{"id":"20240613151050-4292wg2","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"颈下膏谓之负革肪，入道家用。其屎汁疗温毒，热食其肉饮酒，不可卧秫稻穣中。又白猪，白蹄杂青者，不可食之。猪膏又忌乌梅。唐本注云∶《别录》云，猪耳中垢主蛇伤。猪脑主风眩、脑鸣及冻疮。血主贲豚，暴气中风头眩，淋沥。乳汁主小儿惊痫病。乳头亦主小儿惊痫及鬼毒，去来寒热，五癃。五脏主小儿惊痫，发汗。十二月上亥日，取肪脂，纳新瓦器中，埋亥地百日，主痈疽。名 （音瓯同）脂，方家用之。又，一升脂着鸡子白十四枚，更良。今按陈藏器本草云∶猪肉，寒。主压醋进之，当微泄，若先痢即勿服。胆，主湿 病，下脓血不止，干呕，羸瘦，多睡。面黄者，取胆和生姜汁、酽醋半合，灌下部，手急捻令醋气上至咽喉乃放手，当下五色恶物及虫子。又主瘦病，咳嗽，取胆和小便、生姜、桔皮、诃梨勒、桃皮煮服。又主大便不通，取猪、羊胆，以苇筒着胆，缚一头，纳下部入三寸，灌之，入腹立下。又主小儿头疮，取胆汁敷之。猪胰（音夷），缯帛，腊月猪脂杀虫，久留不败。猪黄，主金疮，血痢。"}]},{"ID":"20240613151050-tgb9qs2","Type":"NodeParagraph","Properties":{"id":"20240613151050-tgb9qs2","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"野猪脂，酒服下乳汁，可乳五儿。齿灰，主蛇咬。臣禹锡等谨按孟诜云∶大猪头，主补虚乏气力，去惊痫，五痔，下丹石。又，肠主虚渴，小便数，补下焦虚竭。又云东行母猪粪一升，宿浸去滓，顿服。治毒黄热病。日华子云∶猪，凉，微毒。肉疗水银风并掘土土坑内恶气，久食令人虚肥，动风气。又，不可同牛肉煮食，令人生寸白虫。又，脂治皮肤风，杀虫，敷恶疮。又，肠止小便，补下焦。生血，疗贲豚气及海外瘴气。又，乳治小儿惊痫，天吊，大人猪、鸡痫病。粪治天行热病，黄胆，蛊毒。东行牝猪者为良。窠内有草，治小儿夜啼，安席下勿令母知。大凡野猪肉食胜圈豢者。"}]},{"ID":"20240613151050-n4ydx9h","Type":"NodeParagraph","Properties":{"id":"20240613151050-n4ydx9h","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"图经曰∶豚卵，《本经》不着所出州土，云一名豚颠，阴干藏之，勿令败。谨按杨雄《方言》云∶猪，燕、朝鲜之间谓之 ，关东、西谓之彘，或谓之豕，南楚谓之 （音喜）。其子谓之 （音奚），吴杨之间谓之猪子，其实一种也。今云豚卵，当是猪子也。之猪之属，为用最多。唯肉不宜食，食之多暴肥，盖风虚所致也。心，热。主血不足，补虚劣，不可多食，能耗心气。又不与吴茱萸合食。肺，微寒。能补肺，得大麻人良。不与白花菜合食，令人气滞，发霍乱。肝，温。主冷泄，久滑赤白。乳妇赤白下方，用子肝一叶，薄批之，着煨熟诃又炙，尽半两末止。空腹细嚼，陈米饮送下，亦主冷劳腹脏虚者。脾，主脾胃虚热，以陈桔皮红、生姜、人参、葱白切拍之，合陈米，水煮如羹，去桔皮，空腹食之。肾，补虚壮气，消积滞，冬月不可食，损人真气，兼发虚壅。肚，主骨蒸热劳，血脉不行，补羸助气，四季宜食。张仲景有猪肚黄连丸是也。骨髓，寒。主扑损，恶疮。悬蹄，主痔，肠痈，内蚀。四蹄，主行妇人乳脉，滑肌肤，去寒热。《广济方》载其法云∶妇人乳无汁者，以猪蹄四枚，治如食法，以水二斗，煮取一斗，去蹄。土瓜根、通草、漏芦各三两，以汁煮取六升，去滓。纳葱白、豉如常，着少米煮作稀葱豉粥食之。食了，或身体微微热，有少汗出，佳。乳未下，更三、两剂，大验。肪膏，主诸恶疮，利血脉，解风热，润肺。入膏药，宜腊月亥日取之。肠脏，主大小肠风热，宜食之。"}]},{"ID":"20240613151050-x9mpnqg","Type":"NodeParagraph","Properties":{"id":"20240613151050-x9mpnqg","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"胰，寒。主肺气干胀喘急，润五脏，去皴 。并肪膏，并杀斑蝥、地胆、亭长等毒。然男子多食之损阳。崔元亮《海上方》着猪胰酒，疗冷痢久不瘥方云∶此是脾气不足，暴冷入脾，舌上生疮，饮食无味，纵吃食下还吐，小腹雷鸣，时时心闷，干皮细起，膝胫酸疼，两耳绝声，四肢沉重，渐瘦劣，重成鬼气，及妇人血气不通，逆饭忧烦，常行无力，四肢不举，丈夫 癖，两肋虚胀，变为水气，服之皆效验。此法出于《传尸方》。取猪胰一具，细切，与青蒿叶相和，以无灰酒一大升纳酒中。每日平旦空腹取一小盏服之，午时、夜间各再一服，甚验。忌热面、油腻等食。胆，大寒。主骨热劳极，伤寒及渴疾，小儿五疳，杀虫。"}]},{"ID":"20240613151050-un75e9o","Type":"NodeParagraph","Properties":{"id":"20240613151050-un75e9o","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"齿，主小儿惊痫，烧灰服之。屎，主寒热，黄是也。 猪汤，解诸毒虫魇。"}]},{"ID":"20240613151050-lphd3uf","Type":"NodeParagraph","Properties":{"id":"20240613151050-lphd3uf","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"凡猪，骨细、少筋、多膏，大者有重百余斤，食物至寡，故人畜养之，甚易生息。《尔雅》曰∶彘，五尺为KT 。郭璞注云∶尸子曰，大豕为KT ，今渔阳呼猪大者为KT 是也。又下野猪黄条，主金疮。又大寒，有毒。一名豪猪，鬃间有毫如箭，能射人。陕、洛、江东诸山中并有之。肉亦甘美，多膏，皆不可多食，发风气，利大肠，令人虚羸。"}]},{"ID":"20240613151050-kz6pmv3","Type":"NodeParagraph","Properties":{"id":"20240613151050-kz6pmv3","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"食疗肉，味苦，微寒。压丹石，疗热闭血脉。虚人动风，不可久食。令人少子精，发宿疹。主疗人肾虚。肉发痰，若患疟疾人切忌，食必再发。又云∶江猪，平。肉酸。多食令人体重。今捕人作脯，多皆不识。但食，少有腥气。又，舌，和五味煮，取汁饮，能健脾，补不足之气，令人能食。圣惠方∶治蛇入口并入七孔中。"}]},{"ID":"20240613151050-e7m1t6a","Type":"NodeParagraph","Properties":{"id":"20240613151050-e7m1t6a","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"割母猪尾头，沥血滴口中，即出。又方∶治少阴病，下痢，咽痛，胸满，心烦。猪肤一斤，以水一斗，煮取五升，去滓，加白蜜一升，粉五合，熬香和匀相得，温分六服。外台秘要疗毒热病攻手足肿，疼痛欲脱方∶猪膏和羊屎，涂之亦佳。"}]},{"ID":"20240613151050-5f29gsb","Type":"NodeParagraph","Properties":{"id":"20240613151050-5f29gsb","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"又方∶疗盲。猪胆一枚，微火上煎之，可丸如黍米大，纳眼中食顷，良。又方∶作小绳子如粗钗股大小，烧作灰，待冷，便以灰点翳上，不过三、五度即瘥。千金方∶治被打头青肿。炙猪肉热拓之，又贴猪肝。千金翼老人令面光泽方∶方∶治清净洗秃处，以生布揩令大热，腊月猪脂细研，入生铁煮沸三、二度，敷之遍生。又方∶治漏方∶以腊月猪脂纸沾，取纳疮孔中，日五夜三。又方∶治手足皴裂，血出疼热疼痛皆治。取猪脑髓着热酒中以洗之，瘥。肘后方∶治毒攻手足肿，疼痛欲断。猪蹄一具，合葱煮去滓，纳少许盐，以渍之。又方∶治卒肿病，身面皆洪大。生猪肝一具，细切，顿食之，勿与盐，乃可用苦酒，妙。又方∶疸病有五∶有黄胆、谷疸、酒疸、黑疸、女劳疸。黄汗，身体四肢微肿，胸满不得汗，汗出如黄柏汁，由大汗出，卒入水所致。猪脂一斤，令温热，尽服之，日三，当下下则稍愈。又方∶葛氏∶疥疮。"}]},{"ID":"20240613151050-dr14edw","Type":"NodeParagraph","Properties":{"id":"20240613151050-dr14edw","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"猪膏煎芫花，涂。又方∶若女子阴中苦痒，搔之痛闷。取猪肝炙热纳阴中，当有虫着肝出。"}]},{"ID":"20240613151050-zgzb2e1","Type":"NodeParagraph","Properties":{"id":"20240613151050-zgzb2e1","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"又方∶疗手足皴裂，面出血痛方∶以酒挪猪胰洗，并服。又方∶小便不通。猪胆大如鸡子者疗大便不通。又方∶胞衣不出，腹满则杀人。但多服脂，佳。又方∶小儿头生白秃，发不生。腊月猪屎，烧末敷之。经验方∶疗男子水脏虚惫，遗精，盗汗，往往夜梦鬼交空心稍热服之，便饮酒一盏，多亦甚妙。三、五服效。经验后方∶定喘化涎。猪蹄甲四十九个，净洗控干，每个指甲纳半夏、白矾各一字，入罐子内封闭，勿令烟出，火 通赤，去火细研，入麝香一钱匕。人有上喘咳嗽，用糯米饮下，小儿半钱，至妙。又方∶阴痿羸瘦，精髓虚弱，四肢少力，猪肾一对，去脂膜切，枸杞叶半斤，用豉汁二大盏半相和，煮作羹，入盐、椒、葱，空腹食之。梅师方∶蜈蚣入耳。以猪脂肉炙令香，掩耳自出。又方∶蚁子入耳。以猪、羊脂炙令香，安耳孔，自出。又方∶治产后虚劳，骨节疼痛，汗出不止。取猪肾造 ，以葱、豉、米，如法食之。又诸疽，发背，或发乳房初起微赤，不急治之即杀人。母猪蹄两只，通草六分，以绵裹和煮作羹食之。又方∶治热病有上下蚀人。猪胆一枚，苦酒一合，同煎三、二沸，满口饮之，虫立死，即愈。孙真人食忌云∶不可常食猪肉。白猪，白蹄者不可食也。又云∶腊月肪脂杀虫，可煎膏用之。食医心镜主脾胃气虚，食即汗出。猪肝一斤，薄起于瓦上，曝令熟干，捣筛为末，煮白粥，布绞取汁，和众手丸如梧桐子大。空心饮下五十丸，日五服。又主脾胃气冷，吃食呕逆，下赤白痢如面糊，腰脐切痛。猪肾一对研，着胡椒、桔皮、盐、酱、椒末又主消渴，日夜饮水数斗，小便数，瘦饮之，肉亦着五味，煮粥食之，佳。又方∶水气胀满浮肿。猪肝一具，煮作羹，任意下饭。又主上气咳嗽，胸隔妨满，气喘。猪肉细切作 子，于猪肺中煎食之。又猪肪脂四两，煮百沸以来，切，和酱、醋食之。又治一切肺病咳嗽，脓血不止。猪胰一具，削薄竹筒盛，于 火中炮令极熟，食上吃之。又理肿从足始，转上入腹。猪肝一具，细切，先布 ，更以醋洗，蒜齑食之，如食不尽三两，顿食亦可也。又理浮肿胀满，不下食，心闷。猪肝一具，洗切作脔，着葱白、豉、姜、椒，熟炙食之。又以熟水煮，单吃亦得。又煮猪膂一双切作生，以蒜齑食之。又理产后中风，血气，惊邪，忧悸，气逆。猪心一枚，切，于豉汁中煮，五味糁调和食之。又治小儿惊痫，发动无时。猪乳汁三合，以绵缠浸，令儿吮之，唯多尤佳。"}]},{"ID":"20240613151050-une8lta","Type":"NodeParagraph","Properties":{"id":"20240613151050-une8lta","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"又理肝脏壅热，目赤碜痛，兼明目，补肝气。用猪肝一具，细起薄切，以水淘，漉出漉干，即理狂病经久不瘥，或歌或笑，行走不休，发动无时。用 猪肉一斤，煮令熟，细切作脍，和酱、醋食之。或羹、粥炒。"}]},{"ID":"20240613151050-9cryxg6","Type":"NodeParagraph","Properties":{"id":"20240613151050-9cryxg6","updated":"20240613151050"},"Children":[{"Type":"NodeText","Data":"任性服之。又补虚气乏，去惊痫。豆牙猪头一枚，治如食法，煮令极熟，停冷作脍，以五辣、醋食之。范汪疗鼠 、瘰，取腊月猪膏调涂之。伤寒类要疗小儿寒热及热气中人。猪后蹄烧灰末，以乳汁调一撮服之，效。又方∶疗男子、女人黄胆病，医不愈，耳目悉黄，食饮不消，胃中胀热，生黄衣，盖胃中有干屎使病尔。用煎猪脂一小升，温热顿服之，日三，燥屎下去乃愈。千金髓治胎孕九个月，将产消息。用猪肚一个，根据常法着葱、五味，煮熟食之，食不尽再食，不与别人食。子母秘录∶疗吹奶，恶寒壮热。猪肪脂以冷水浸拓之，热即易，立效。姚和众小儿初生。猪胆一枚，以水七升，煎取四升，澄清浴儿，令永无疮疥。谭氏小儿方∶疗豌豆疮。取肉烂煮，取汁洗之，脯亦得。礼记云豕望视而交接，腥不可食。又云食豚去脑。"}]},{"ID":"20240613151030-klyh06y","Type":"NodeThematicBreak","Properties":{"id":"20240613151030-klyh06y"}},{"ID":"20240613151031-cvwbf6u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151031-cvwbf6u","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：豚卵"}]},{"ID":"20240613151031-zljpwgc","Type":"NodeParagraph","Properties":{"id":"20240613151031-zljpwgc","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613151031-8rz2cs5","Type":"NodeParagraph","Properties":{"id":"20240613151031-8rz2cs5","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" Tún Luǎn"}]},{"ID":"20240613151031-oq73nbm","Type":"NodeParagraph","Properties":{"id":"20240613151031-oq73nbm","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613151031-09gtesa","Type":"NodeParagraph","Properties":{"id":"20240613151031-09gtesa","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 豚颠（《本经》），猪石子（《济生方》），猪睾丸（《本草蒙筌》）。"}]},{"ID":"20240613151031-5gybs8g","Type":"NodeParagraph","Properties":{"id":"20240613151031-5gybs8g","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613151031-pr6bl9b","Type":"NodeParagraph","Properties":{"id":"20240613151031-pr6bl9b","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613151031-lygrauy","Type":"NodeParagraph","Properties":{"id":"20240613151031-lygrauy","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613151031-i4pej0c","Type":"NodeParagraph","Properties":{"id":"20240613151031-i4pej0c","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 为猪科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睾丸"},{"Type":"NodeText","Data":"。一般可在阉割小猪时收集。"}]},{"ID":"20240613151031-9udr48n","Type":"NodeParagraph","Properties":{"id":"20240613151031-9udr48n","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613151031-tipsaki","Type":"NodeParagraph","Properties":{"id":"20240613151031-tipsaki","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 动物形态详\"猪肉\"条。"}]},{"ID":"20240613151031-rpffzt1","Type":"NodeParagraph","Properties":{"id":"20240613151031-rpffzt1","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613151031-m2mczfh","Type":"NodeParagraph","Properties":{"id":"20240613151031-m2mczfh","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240613151031-0uidmjj","Type":"NodeParagraph","Properties":{"id":"20240613151031-0uidmjj","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，温。\""}]},{"ID":"20240613151031-2z8lgys","Type":"NodeParagraph","Properties":{"id":"20240613151031-2z8lgys","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613151031-u5g96fh","Type":"NodeParagraph","Properties":{"id":"20240613151031-u5g96fh","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"③《随息居饮食谱》：\"甘咸，温。\""}]},{"ID":"20240613151031-kzzi1se","Type":"NodeParagraph","Properties":{"id":"20240613151031-kzzi1se","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613151031-iaolfim","Type":"NodeParagraph","Properties":{"id":"20240613151031-iaolfim","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 补肾纳气，治哮喘，疝气，少腹急痛，癃闭。"}]},{"ID":"20240613151031-m9708be","Type":"NodeParagraph","Properties":{"id":"20240613151031-m9708be","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主惊痫，癫疾，除寒热，奔豚，五癃邪气挛缩。\""}]},{"ID":"20240613151031-w4854k4","Type":"NodeParagraph","Properties":{"id":"20240613151031-w4854k4","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"除阴茎中痛。\""}]},{"ID":"20240613151031-tvqlfvb","Type":"NodeParagraph","Properties":{"id":"20240613151031-tvqlfvb","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"治阴阳易病，少腹急痛，用热酒吞二枚。\""}]},{"ID":"20240613151031-x1q8ccp","Type":"NodeParagraph","Properties":{"id":"20240613151031-x1q8ccp","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613151031-y60qe4q","Type":"NodeParagraph","Properties":{"id":"20240613151031-y60qe4q","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 内服：煮食或煎汤，2个。"}]},{"ID":"20240613151031-pidtk1x","Type":"NodeParagraph","Properties":{"id":"20240613151031-pidtk1x","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613151031-85npb6l","Type":"NodeParagraph","Properties":{"id":"20240613151031-85npb6l","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" ①治惊痫中风，壮热瘈疭，吐舌出沫：豚卵一双（细切），当归二分。以醇酒三升，煮一升分服。（《普济方》）"}]},{"ID":"20240613151031-on1zy7u","Type":"NodeParagraph","Properties":{"id":"20240613151031-on1zy7u","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"②治小儿腹股沟疝：猪隐睾一个（阉割小猪时取）。放瓦片上，用另一瓦合上，放炉内焙干后取出研末，一次口服。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240613151031-70tldy5","Type":"NodeParagraph","Properties":{"id":"20240613151031-70tldy5","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613151031-3hwp1u2","Type":"NodeParagraph","Properties":{"id":"20240613151031-3hwp1u2","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性气管炎"}]},{"ID":"20240613151031-2t6odlb","Type":"NodeParagraph","Properties":{"id":"20240613151031-2t6odlb","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"用小猪睾丸制成10％注射液，肌肉注射，每日1次2毫升。试治20例，经20天观察，基本治愈15例，有效5例。基本治愈病人中，用药3～5天内症状消失的8例，6～10天消失的5例，11～15天消失的2例。继之治疗239例，观察14天，基本治愈37例，有效177例，无效25例。"}]},{"ID":"20240613151031-ecndzh3","Type":"NodeParagraph","Properties":{"id":"20240613151031-ecndzh3","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"②治疗支气管哮喘"}]},{"ID":"20240613151031-jfgre97","Type":"NodeParagraph","Properties":{"id":"20240613151031-jfgre97","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"用猪睾丸适量煮熟，连汤同服，每天2次，每次量为：2岁以内1/3个，2～5岁1/2个，6～10岁1个，11～15岁1个半，成人2个。观察11例，服后一般可缓解哮喘发作，或减少发作次数。"}]},{"ID":"20240613151031-qxihhod","Type":"NodeParagraph","Properties":{"id":"20240613151031-qxihhod","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613151031-iffuqi7","Type":"NodeParagraph","Properties":{"id":"20240613151031-iffuqi7","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613151031-km0wh9k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613151031-km0wh9k","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"《中华本草》：豚卵"}]},{"ID":"20240613151031-0grix17","Type":"NodeParagraph","Properties":{"id":"20240613151031-0grix17","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613151031-z6t2dj0","Type":"NodeParagraph","Properties":{"id":"20240613151031-z6t2dj0","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" Tún Luǎn"}]},{"ID":"20240613151031-6aczehg","Type":"NodeParagraph","Properties":{"id":"20240613151031-6aczehg","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613151031-ptlbci1","Type":"NodeParagraph","Properties":{"id":"20240613151031-ptlbci1","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 豚颠、猪石子、猪睾丸、猪外肾；猎隐睾"}]},{"ID":"20240613151031-22cbfnp","Type":"NodeParagraph","Properties":{"id":"20240613151031-22cbfnp","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613151031-w02ghgb","Type":"NodeParagraph","Properties":{"id":"20240613151031-w02ghgb","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" pig's testis"}]},{"ID":"20240613151031-gicpjfu","Type":"NodeParagraph","Properties":{"id":"20240613151031-gicpjfu","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613151031-21b3qkj","Type":"NodeParagraph","Properties":{"id":"20240613151031-21b3qkj","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240613151031-i5ewxxt","Type":"NodeParagraph","Properties":{"id":"20240613151031-i5ewxxt","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613151031-ov0h3hj","Type":"NodeParagraph","Properties":{"id":"20240613151031-ov0h3hj","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 药材基源：为猪科动物猪的睾丸。"}]},{"ID":"20240613151031-a1yibqk","Type":"NodeParagraph","Properties":{"id":"20240613151031-a1yibqk","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sus scrofa domestica Brisson"}]},{"ID":"20240613151031-u6ld14n","Type":"NodeParagraph","Properties":{"id":"20240613151031-u6ld14n","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"采收和储藏：将雄猎宰杀后，刮去猪毛，摘取睾丸，洗净。或阄害虫小猪时留下睾丸。"}]},{"ID":"20240613151031-9uz8dqj","Type":"NodeParagraph","Properties":{"id":"20240613151031-9uz8dqj","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613151031-egjmkfp","Type":"NodeParagraph","Properties":{"id":"20240613151031-egjmkfp","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 生态环境：杂食性家养物畜，繁殖力强，孕期约4个月。"}]},{"ID":"20240613151031-bsafnfk","Type":"NodeParagraph","Properties":{"id":"20240613151031-bsafnfk","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地均有饲养。"}]},{"ID":"20240613151031-dpv6mf5","Type":"NodeParagraph","Properties":{"id":"20240613151031-dpv6mf5","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613151031-d4o3ls5","Type":"NodeParagraph","Properties":{"id":"20240613151031-d4o3ls5","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 猪的品种繁多，达150多种，形态也有差异基本特微是：躯体肥胖，头大。鼻与口吻皆长略向上屈。眼小。耳壳有的大而下垂，有的较小而前挺。四肢短小，4趾，前2趾有蹄，后2趾有悬蹄。颈粗，项背疏生鬃毛。尾短小，末端有毛丛。毛色有纯黑、纯白或黑白混杂等。"}]},{"ID":"20240613151031-vi9xda7","Type":"NodeParagraph","Properties":{"id":"20240613151031-vi9xda7","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613151031-hoha3lv","Type":"NodeParagraph","Properties":{"id":"20240613151031-hoha3lv","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 豚卵含睾丸酮（testosterone）。"}]},{"ID":"20240613151031-avbrg9i","Type":"NodeParagraph","Properties":{"id":"20240613151031-avbrg9i","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613151031-9ndgrrn","Type":"NodeParagraph","Properties":{"id":"20240613151031-9ndgrrn","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 肾经"}]},{"ID":"20240613151031-f63kr5j","Type":"NodeParagraph","Properties":{"id":"20240613151031-f63kr5j","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613151031-smp4i5e","Type":"NodeParagraph","Properties":{"id":"20240613151031-smp4i5e","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 味甘；咸；性温"}]},{"ID":"20240613151031-ftva9gd","Type":"NodeParagraph","Properties":{"id":"20240613151031-ftva9gd","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613151031-fohb5vg","Type":"NodeParagraph","Properties":{"id":"20240613151031-fohb5vg","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 温肾散寒；镇惊定痫。主哮喘；睾丸肿痛；疝气痛；阴茎痛；癃闭；惊痫"}]},{"ID":"20240613151031-oy396sj","Type":"NodeParagraph","Properties":{"id":"20240613151031-oy396sj","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613151031-v8wcp1m","Type":"NodeParagraph","Properties":{"id":"20240613151031-v8wcp1m","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 内服：煮食或煎汤，2个。外用：适量，捣烂或煮膏涂敷。"}]},{"ID":"20240613151031-dw4p95p","Type":"NodeParagraph","Properties":{"id":"20240613151031-dw4p95p","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613151031-m905s6q","Type":"NodeParagraph","Properties":{"id":"20240613151031-m905s6q","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" ①治惊痫中风，壮热，吐舌出沫：豚卵一双(细切)，当归二分。以醇酒三升，煮一升分服。(《普济方》)②治小儿腹股沟疝：猪隐睾一个(阉割小猪时取)。放瓦片上，用另一瓦合上，放炉内焙千后取出研未，一次口服。(内蒙古《中草药新医疗法资料选编》)"}]},{"ID":"20240613151031-zflprnz","Type":"NodeParagraph","Properties":{"id":"20240613151031-zflprnz","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613151031-mv79eqz","Type":"NodeParagraph","Properties":{"id":"20240613151031-mv79eqz","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 1.治疗慢性气管炎：用小猪睾丸制成10% 注射液，肌肉注射，每日1次之毫升。试治20例，经20天观察，基本治愈15例，有效5例。基本治愈病人中，用药3-5天内症伏消失的8例，6-10天消失的5例，11-15天消失的2例，继之治疗239例，观察14天，基本治愈37例，有效177例，无效25例。"}]},{"ID":"20240613151031-pumz515","Type":"NodeParagraph","Properties":{"id":"20240613151031-pumz515","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"2.治疗支气管哮喘：用猪睾丸适量煮熟，连汤同服，每天2次。每次量为：2岁以内1/3个，2-5岁1／2个，6-10岁1个，11-15岁1个半，成人之个。观察11例，服后一般可缓解哮喘发作，或减少发作次数。"}]},{"ID":"20240613151031-mwec1sw","Type":"NodeParagraph","Properties":{"id":"20240613151031-mwec1sw","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613151031-h9jqp92","Type":"NodeParagraph","Properties":{"id":"20240613151031-h9jqp92","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主惊痫，癫疾，除寒热，奔豚，五癃邪气挛缩。"}]},{"ID":"20240613151031-2o4zvzn","Type":"NodeParagraph","Properties":{"id":"20240613151031-2o4zvzn","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"2.《千金·食治》：除阴茎中痛。"}]},{"ID":"20240613151031-xdgq9ph","Type":"NodeParagraph","Properties":{"id":"20240613151031-xdgq9ph","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：治阴阳易病，少腹急痛，用热酒吞二枚。"}]},{"ID":"20240613151031-kun0hla","Type":"NodeParagraph","Properties":{"id":"20240613151031-kun0hla","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613151031-u4va3wi","Type":"NodeParagraph","Properties":{"id":"20240613151031-u4va3wi","updated":"20240613151031"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613151032-uncl48e","Type":"NodeThematicBreak","Properties":{"id":"20240613151032-uncl48e"}},{"ID":"20240613151033-xp46vly","Type":"NodeParagraph","Properties":{"id":"20240613151033-xp46vly"}}]}