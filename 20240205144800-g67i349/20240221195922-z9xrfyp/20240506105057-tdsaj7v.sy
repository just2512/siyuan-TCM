t-style=\"width: 566px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240703102949-ck1kwo9","Type":"NodeParagraph","Properties":{"id":"20240703102949-ck1kwo9","updated":"20240827173628"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 498px;","style":"width: 488px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕鼯鼠6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕鼯鼠6-20240703102952-op47x00.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 488px;\" parent-style=\"width: 498px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 742px;","style":"width: 732px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕鼯鼠5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕鼯鼠5-20240703102843-7dumnft.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 732px;\" parent-style=\"width: 742px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703103150-33xovyp","Type":"NodeParagraph","Properties":{"id":"20240703103150-33xovyp","updated":"20240827173630"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕鼯鼠8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕鼯鼠8-20240703103150-xjnr8g5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 647px;","style":"width: 637px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕鼯鼠9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕鼯鼠9-20240703103214-sm7o431.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 637px;\" parent-style=\"width: 647px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240613154044-grzn8nm","Type":"NodeThematicBreak","Properties":{"id":"20240613154044-grzn8nm"}},{"ID":"20240613154135-cowg0yb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613154135-cowg0yb","updated":"20240613154142"},"Children":[{"Type":"NodeText","Data":"鼺鼠《神农本草经》"}]},{"ID":"20240613154131-pya00pj","Type":"NodeParagraph","Properties":{"id":"20240613154131-pya00pj","updated":"20240613154131"},"Children":[{"Type":"NodeText","Data":"主堕胎，令人产易。生平谷。"}]},{"ID":"20240613154131-t5wb8yo","Type":"NodeParagraph","Properties":{"id":"20240613154131-t5wb8yo","updated":"20240613154131"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生山都。"}]},{"ID":"20240613154131-44yj0al","Type":"NodeParagraph","Properties":{"id":"20240613154131-44yj0al","updated":"20240613154131"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上畾下鸟）鼠形，飞走且乳之鸟也，籀文作鸓.《广雅》云。（左刘去刂右鸟）（左申右鸟）飞鸓也。"}]},{"ID":"20240613154131-kjfjf7v","Type":"NodeParagraph","Properties":{"id":"20240613154131-kjfjf7v","updated":"20240613154131"},"Children":[{"Type":"NodeText","Data":"陶宏景云是鼯鼠，一名飞生见，《尔雅》云鼺鼠夷由也。旧作鼺，非。"}]},{"ID":"20240613154257-6e76nkb","Type":"NodeThematicBreak","Properties":{"id":"20240613154257-6e76nkb"}},{"ID":"20240613154258-ocwdp96","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613154258-ocwdp96","updated":"20240613154308"},"Children":[{"Type":"NodeText","Data":"鼺鼠《本草衍义》"}]},{"ID":"20240613154258-4mczvtm","Type":"NodeParagraph","Properties":{"id":"20240613154258-4mczvtm","updated":"20240613154258"},"Children":[{"Type":"NodeText","Data":"《经》中不言性味，惟是于难产通用药中云：鼺（音羸）鼠，微温，毛赤黑色，长尾，人捕得取皮为暖帽。但向下飞则可，亦不能致远。今关西山中甚有，毛极密，人谓之飞生者是也。《注》中又引水马，首如马，身如虾，背伛偻，身有竹节纹，长二三寸，今谓之海马。"}]},{"ID":"20240613154045-24vrzhs","Type":"NodeThematicBreak","Properties":{"id":"20240613154045-24vrzhs"}},{"ID":"20240613154046-8sbwv2s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613154046-8sbwv2s","updated":"20240613154057"},"Children":[{"Type":"NodeText","Data":"鼯鼠《证类本草》"}]},{"ID":"20240613154046-bskgtnn","Type":"NodeParagraph","Properties":{"id":"20240613154046-bskgtnn","updated":"20240613154046"},"Children":[{"Type":"NodeText","Data":"主堕胎，令产易。生山都平谷。"}]},{"ID":"20240613154046-qyii8m3","Type":"NodeParagraph","Properties":{"id":"20240613154046-qyii8m3","updated":"20240613154046"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶ 是鼯鼠。一名飞生。状如蝙蝠，大如鸱鸢，毛紫色暗，夜行飞生。人取其皮毛以与产妇持之，令儿易生。又有水马，生海中。是鱼虾类，状如马形，亦主易产。今按陈藏器本草云∶陶云有水马，生海中。主产。按水马，妇人临产带之，不尔，临时烧末饮服，亦《南州异物志》云∶妇人难产割裂而出者，手握此虫，如羊之产也。生物中羊产最易。臣禹锡等谨按难产通用药云∶鼠，微温。"}]},{"ID":"20240613154046-ifq8ocs","Type":"NodeParagraph","Properties":{"id":"20240613154046-ifq8ocs","updated":"20240613154103"},"Children":[{"Type":"NodeText","Data":"图经曰∶ 鼯鼠，出山都平谷，即飞生鸟也。今湖岭间山中多有之。状如蝙蝠，大如鸱鸢，毛紫色暗，夜行飞生。南人见之，多以为怪。捕取其皮毛以与产妇，临蓐持之，令儿易生。此但云执之，而《小品方》乃入服药，其方∶取飞生一枚，槐之、故弩箭羽各十四枚种水马，生南海中。头如马形，长五、六寸《异鱼图》云∶渔人布网罟，此鱼多挂网上，收之曝干，以雌雄各一为对。主难产及血气药亦用之。"}]},{"ID":"20240613154046-q92e4ih","Type":"NodeParagraph","Properties":{"id":"20240613154046-q92e4ih","updated":"20240613154046"},"Children":[{"Type":"NodeText","Data":"衍义曰∶ 鼠，《经》中不言性味，唯是于难产通用药中云∶ 鼠，微温。毛赤黑色，长尾，人捕得，取皮为暖帽。"}]},{"ID":"20240613154046-mlxraiw","Type":"NodeParagraph","Properties":{"id":"20240613154046-mlxraiw","updated":"20240613154046"},"Children":[{"Type":"NodeText","Data":"但向下飞则可，亦不能致远。今关西山中甚有，毛极密，人谓之飞生者是也。《注》中又引水马，首如马，身如虾，背伛偻，身有竹节纹，长二、三寸。今谓之海马。"}]},{"ID":"20240613154856-8l597e3","Type":"NodeThematicBreak","Properties":{"id":"20240613154856-8l597e3"}},{"ID":"20240613154857-s01suyk","Type":"NodeParagraph","Properties":{"id":"20240613154857-s01suyk","updated":"20240613154905"},"Children":[{"Type":"NodeText","Data":"【药 名】：鼺（léi ）鼠"}]},{"ID":"20240613154909-y0839ob","Type":"NodeParagraph","Properties":{"id":"20240613154909-y0839ob"},"Children":[{"Type":"NodeText","Data":"【来 源】：为鼯鼠科动物棕鼯鼠的全体。"}]},{"ID":"20240613154911-exl9q3v","Type":"NodeParagraph","Properties":{"id":"20240613154911-exl9q3v"},"Children":[{"Type":"NodeText","Data":"【功 效】：催生堕胎。"}]},{"ID":"20240613154913-6ny2si5","Type":"NodeParagraph","Properties":{"id":"20240613154913-6ny2si5"},"Children":[{"Type":"NodeText","Data":"【主 治】：治堕胎或难产皆可应用。【性味归经】：咸，温，有毒。①《本经》：“微温。”②《纲目》：“有毒。”入肝、肾经。"}]},{"ID":"20240613154916-acukog5","Type":"NodeParagraph","Properties":{"id":"20240613154916-acukog5"},"Children":[{"Type":"NodeText","Data":"【用法用量】：内服：入丸、散。"}]},{"ID":"20240613154920-c8bmdwb","Type":"NodeParagraph","Properties":{"id":"20240613154920-c8bmdwb"},"Children":[{"Type":"NodeText","Data":"【别 名】：耳鼠(《山海经》)、鼯鼠、夷由(《尔雅》)、飞鸓(《广雅》)、飞鼠(《上林赋》张揖注)、飞生(《尔雅》郭璞注)、飞生虫(《本草经集注》)、飞生鸟(《本草图经》)、飞虎、松猫儿(《中国经济动物志·兽类》)"}]},{"ID":"20240613154047-1jhqf6a","Type":"NodeThematicBreak","Properties":{"id":"20240613154047-1jhqf6a"}},{"ID":"20240613154207-gi70y75","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613154207-gi70y75","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鼺鼠"}]},{"ID":"20240613154207-jx31ykv","Type":"NodeParagraph","Properties":{"id":"20240613154207-jx31ykv","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613154207-uthwmdo","Type":"NodeParagraph","Properties":{"id":"20240613154207-uthwmdo","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" Léi Shǔ"}]},{"ID":"20240613154207-tej36c8","Type":"NodeParagraph","Properties":{"id":"20240613154207-tej36c8","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613154207-dvymf1n","Type":"NodeParagraph","Properties":{"id":"20240613154207-dvymf1n","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 耳鼠（《山海经，），鼯鼠、夷由（《尔雅》），飞鸓（《广雅》），飞鼠（《上林赋》张揖注），飞生（《尔雅》郭璞注），飞生虫（《本草经集注》），飞生鸟（《本草图经》），飞虎、松猫儿（《中国经济动物志·兽类》）。"}]},{"ID":"20240613154207-5epdnnr","Type":"NodeParagraph","Properties":{"id":"20240613154207-5epdnnr","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613154207-hmvuxdz","Type":"NodeParagraph","Properties":{"id":"20240613154207-hmvuxdz","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613154207-kdy2iug","Type":"NodeParagraph","Properties":{"id":"20240613154207-kdy2iug","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613154207-j88jz67","Type":"NodeParagraph","Properties":{"id":"20240613154207-j88jz67","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 为鼯鼠科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"棕鼯鼠"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全体"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613154207-sm7ehw0","Type":"NodeParagraph","Properties":{"id":"20240613154207-sm7ehw0","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613154207-2li5f71","Type":"NodeParagraph","Properties":{"id":"20240613154207-2li5f71","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 分布福建、台湾、广东、广西、四川、云南等地。"}]},{"ID":"20240613154207-al9lpvo","Type":"NodeParagraph","Properties":{"id":"20240613154207-al9lpvo","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613154207-7rd0gpi","Type":"NodeParagraph","Properties":{"id":"20240613154207-7rd0gpi","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 体长达40～50厘米。尾圆形，其长超过体长。吻圆而短。耳小，眼大。体背毛色黑蜗，腹面为浅橙红色，颈下黑褐色，并有褐色纵纹向下延伸到胸部。鼠蹊部至尾基为灰褐色，尾除基部下面外皆黑褐色。飞膜背面色如体背，但略深，腹面色较红，两者分界线甚显明。眼周具黑圈。耳壳背部具一黑斑。耳与眼之黑圈间为橙黄色。后足趾端黑色或灰白色。"}]},{"ID":"20240613154207-0uuwqxg","Type":"NodeParagraph","Properties":{"id":"20240613154207-0uuwqxg","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"多栖于山坡森林地带，巢筑于树洞或岩洞中。晨昏时活动较频繁，活动以攀、爬、滑翔相交替。食物以麻栗树叶、倪藤果、榕果、山姜子、山荔枝、野芭蕉等果实为主；偶亦食昆虫。2～4月换毛。"}]},{"ID":"20240613154207-tv3gyep","Type":"NodeParagraph","Properties":{"id":"20240613154207-tv3gyep","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613154207-dxp7emo","Type":"NodeParagraph","Properties":{"id":"20240613154207-dxp7emo","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"微温。\""}]},{"ID":"20240613154207-s8ne0uh","Type":"NodeParagraph","Properties":{"id":"20240613154207-s8ne0uh","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"有毒。\""}]},{"ID":"20240613154207-u7rjvo3","Type":"NodeParagraph","Properties":{"id":"20240613154207-u7rjvo3","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613154207-n7hwp21","Type":"NodeParagraph","Properties":{"id":"20240613154207-n7hwp21","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《本经》：\"主堕胎，令产易。\""}]},{"ID":"20240613154207-9pxndto","Type":"NodeParagraph","Properties":{"id":"20240613154207-9pxndto","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613154207-ljos4sh","Type":"NodeParagraph","Properties":{"id":"20240613154207-ljos4sh","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613154207-m9697kn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613154207-m9697kn","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鼺鼠"}]},{"ID":"20240613154207-06c7jvv","Type":"NodeParagraph","Properties":{"id":"20240613154207-06c7jvv","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613154207-tsnn4qx","Type":"NodeParagraph","Properties":{"id":"20240613154207-tsnn4qx","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" Léi Shǔ"}]},{"ID":"20240613154207-frwbg5v","Type":"NodeParagraph","Properties":{"id":"20240613154207-frwbg5v","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613154207-0mzqa2z","Type":"NodeParagraph","Properties":{"id":"20240613154207-0mzqa2z","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 耳鼠、鼯鼠、夷由、鸓、飞鸓、飞鼠、飞生、飞生虫、飞生鸟、飞虎、松猫儿、大鼯鼠"}]},{"ID":"20240613154207-x3pkbpm","Type":"NodeParagraph","Properties":{"id":"20240613154207-x3pkbpm","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613154207-7rdbo6s","Type":"NodeParagraph","Properties":{"id":"20240613154207-7rdbo6s","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" Trogopterus"}]},{"ID":"20240613154207-8iyacyq","Type":"NodeParagraph","Properties":{"id":"20240613154207-8iyacyq","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613154207-b4fbzg2","Type":"NodeParagraph","Properties":{"id":"20240613154207-b4fbzg2","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《别录》：鼺鼠，生山都平谷。"}]},{"ID":"20240613154207-ko5x5n2","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613154207-ko5x5n2","updated":"20240613154207"},"Children":[{"ID":"20240613154207-2w7niha","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240613154207-2w7niha","updated":"20240613154207"},"Children":[{"ID":"20240613154207-1zcjan4","Type":"NodeParagraph","Properties":{"id":"20240613154207-1zcjan4","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"陶弘景：鼺，状如蝙蝠，大如鸱鸢，毛紫色，暗夜行。"}]}]}]},{"ID":"20240613154207-l9q74ww","Type":"NodeParagraph","Properties":{"id":"20240613154207-l9q74ww","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：鼺鼠，今湖、岭间山中多有之。《小品方》乃入服药，其方取飞生一枚，槐子、故弩箭羽各十四枚。合捣，丸桐子大，以酒服二丸，令易产也。"}]},{"ID":"20240613154207-km3qbyf","Type":"NodeParagraph","Properties":{"id":"20240613154207-km3qbyf","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：鼯鼠，翅联四足及尾，与蝠同，故曰以尾飞。生岭南者好食龙眼。《济生方》治难产金液丸，用其腹下毛为丸服之。"}]},{"ID":"20240613154207-25nfcmf","Type":"NodeParagraph","Properties":{"id":"20240613154207-25nfcmf","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613154207-dnori7a","Type":"NodeParagraph","Properties":{"id":"20240613154207-dnori7a","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鼯鼠科动物棕鼯鼠的全体。"}]},{"ID":"20240613154207-qcjprn1","Type":"NodeParagraph","Properties":{"id":"20240613154207-qcjprn1","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Petaurista petaurista(Pallas)"}]},{"ID":"20240613154207-zp2rn4y","Type":"NodeParagraph","Properties":{"id":"20240613154207-zp2rn4y","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋季捕捉，捕后杀死，剥去皮毛，除去内脏，取肉骨，鲜用。"}]},{"ID":"20240613154207-qr3cf0q","Type":"NodeParagraph","Properties":{"id":"20240613154207-qr3cf0q","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613154207-b90ohhw","Type":"NodeParagraph","Properties":{"id":"20240613154207-b90ohhw","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 生态环境：栖息于南亚热带常绿阔呀林和热带雨林、季雨林中海拔一般不超过2500m。以岩洞、石 隙、树叉上其他大型鸟类的弃巢为穴。夜间活动。以树叶、嫩枝和果实为食。"}]},{"ID":"20240613154207-u0dzwsq","Type":"NodeParagraph","Properties":{"id":"20240613154207-u0dzwsq","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、台湾、广东、海南、广西、四川、贵州、云南等地。"}]},{"ID":"20240613154207-6pn0h98","Type":"NodeParagraph","Properties":{"id":"20240613154207-6pn0h98","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613154207-bxe42pn","Type":"NodeParagraph","Properties":{"id":"20240613154207-bxe42pn","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 棕鼯鼠，体长30-47cm，重400-1000g。耳基周围无细长簇毛。吻圆而短。头钝圆。眼大，耳小。尾长35-48cm，明显超过体长。体背色调一致，显棕红、栗褐、棕黄、茶褐、茶黄色，腹面为棕黄色或橙黄色，颈下部黑褐色，并有褐色纵纹向下延伸到胸部。飞膜背面色如体背，但略深，腹面色较红，两者分界线甚明显。眼圈具黑圈。耳郭背部具1黑斑。尾色与背色相同，但四川、贵州标本常杂有黑色，尾末端全变成黑色。"}]},{"ID":"20240613154207-b3ej0cr","Type":"NodeParagraph","Properties":{"id":"20240613154207-b3ej0cr","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613154207-umhq52c","Type":"NodeParagraph","Properties":{"id":"20240613154207-umhq52c","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240613154207-iex8muv","Type":"NodeParagraph","Properties":{"id":"20240613154207-iex8muv","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613154207-42u8kvc","Type":"NodeParagraph","Properties":{"id":"20240613154207-42u8kvc","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 味甘；性温"}]},{"ID":"20240613154207-jdu9kqu","Type":"NodeParagraph","Properties":{"id":"20240613154207-jdu9kqu","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613154207-ph4jrmt","Type":"NodeParagraph","Properties":{"id":"20240613154207-ph4jrmt","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《广西药用动物》：“血虚无瘀滞的人忌用，孕妇慎用。”"}]},{"ID":"20240613154207-pvbbgi8","Type":"NodeParagraph","Properties":{"id":"20240613154207-pvbbgi8","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613154207-lussk1s","Type":"NodeParagraph","Properties":{"id":"20240613154207-lussk1s","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 催产；止痛。主难产；产后腰痛；关节痛；头风痛"}]},{"ID":"20240613154207-temcets","Type":"NodeParagraph","Properties":{"id":"20240613154207-temcets","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613154207-9ypgyow","Type":"NodeParagraph","Properties":{"id":"20240613154207-9ypgyow","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 内服：泡酒服，15-30g。"}]},{"ID":"20240613154207-ur2rjqr","Type":"NodeParagraph","Properties":{"id":"20240613154207-ur2rjqr","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613154207-7gdilp0","Type":"NodeParagraph","Properties":{"id":"20240613154207-7gdilp0","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《本经》：主堕胎，令产易。"}]},{"ID":"20240613154207-e39w2wl","Type":"NodeParagraph","Properties":{"id":"20240613154207-e39w2wl","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613154207-va8q4k5","Type":"NodeParagraph","Properties":{"id":"20240613154207-va8q4k5","updated":"20240613154207"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613154209-aclnzdp","Type":"NodeThematicBreak","Properties":{"id":"20240613154209-aclnzdp"}},{"ID":"20240613154210-bgwnb1u","Type":"NodeParagraph","Properties":{"id":"20240613154210-bgwnb1u"}}]}