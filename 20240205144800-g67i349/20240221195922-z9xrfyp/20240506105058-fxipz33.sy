ta":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 315px;","style":"width: 305px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"溲疏 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/溲疏 1-20240827105713-zveriy7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 305px;\" parent-style=\"width: 315px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 419px;","style":"width: 409px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"溲疏8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/溲疏8-20240702160208-jjfcamx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 409px;\" parent-style=\"width: 419px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 417px;","style":"width: 407px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"溲疏9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/溲疏9-20240702160449-kj2qjfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 407px;\" parent-style=\"width: 417px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827110032-1viaqhx","Type":"NodeParagraph","Properties":{"id":"20240827110032-1viaqhx","updated":"20240827110137"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 405px;","style":"width: 395px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"溲疏 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/溲疏 2-20240827110032-qlr62g2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 395px;\" parent-style=\"width: 405px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 734px;","style":"width: 724px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"溲疏 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/溲疏 3-20240827110137-w875ncq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 724px;\" parent-style=\"width: 734px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827105151-6iqoo4s","Type":"NodeParagraph","Properties":{"id":"20240827105151-6iqoo4s","updated":"20240827105545"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：有一种开粉红色花朵的溲疏，属于园艺品种；"}]},{"ID":"20240613142833-cvtapk9","Type":"NodeThematicBreak","Properties":{"id":"20240613142833-cvtapk9","updated":"20240827105545"}},{"ID":"20240613142930-3k5owjd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142930-3k5owjd","updated":"20240613142934"},"Children":[{"Type":"NodeText","Data":"溲疏《神农本草经》"}]},{"ID":"20240613142930-hnnxz6f","Type":"NodeParagraph","Properties":{"id":"20240613142930-hnnxz6f","updated":"20240613142930"},"Children":[{"Type":"NodeText","Data":"味辛寒。"}]},{"ID":"20240613142930-4jcugoz","Type":"NodeParagraph","Properties":{"id":"20240613142930-4jcugoz","updated":"20240613142930"},"Children":[{"Type":"NodeText","Data":"主身皮肤中热，除邪气，止遗溺，可作浴汤。生山谷，及田野故邱虚地。"}]},{"ID":"20240613142930-3tbg0ns","Type":"NodeParagraph","Properties":{"id":"20240613142930-3tbg0ns","updated":"20240613142930"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名巨骨，生能耳山，四月采。"}]},{"ID":"20240613142930-95wvgmn","Type":"NodeParagraph","Properties":{"id":"20240613142930-95wvgmn","updated":"20240613142930"},"Children":[{"Type":"NodeText","Data":"案李当之云：溲疏，一名杨栌，一名牡荆，一名空疏，皮白中空，时时有节，子似枸杞，子冬日熟，色赤，味甘苦。"}]},{"ID":"20240613142939-ffpg1ml","Type":"NodeThematicBreak","Properties":{"id":"20240613142939-ffpg1ml"}},{"ID":"20240613142940-jl1ztod","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142940-jl1ztod","updated":"20240613142944"},"Children":[{"Type":"NodeText","Data":"溲疏《千金翼方》"}]},{"ID":"20240613142940-n70qngc","Type":"NodeParagraph","Properties":{"id":"20240613142940-n70qngc","updated":"20240613142940"},"Children":[{"Type":"NodeText","Data":"味辛苦，寒，微寒，无毒。主身皮肤中热，除邪气，止遗溺，通水利道，除胃中热，下气，可作浴汤。一名巨骨。生熊耳川谷及田野故丘墟地，四月采。"}]},{"ID":"20240613142833-vh6cebi","Type":"NodeThematicBreak","Properties":{"id":"20240613142833-vh6cebi"}},{"ID":"20240613142918-8s697ti","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142918-8s697ti","updated":"20240613142924"},"Children":[{"Type":"NodeText","Data":"溲疏《名医别录》"}]},{"ID":"20240613142918-64na7em","Type":"NodeParagraph","Properties":{"id":"20240613142918-64na7em","updated":"20240613142918"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒．通利水道，除胃中热，下气．一名巨骨．生掘耳及田野故丘墟地四月采．（漏芦为之使．）"}]},{"ID":"20240613142918-979hsx9","Type":"NodeParagraph","Properties":{"id":"20240613142918-979hsx9","updated":"20240613142918"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶溲疏，味辛，寒．主身皮肤中热，除邪气，止遗溺，可作浴汤，生山谷．"}]},{"ID":"20240613143954-yv0w4bs","Type":"NodeThematicBreak","Properties":{"id":"20240613143954-yv0w4bs"}},{"ID":"20240613143956-wlgyxwq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613143956-wlgyxwq","updated":"20240613144101"},"Children":[{"Type":"NodeText","Data":"溲疏《本经逢原》"}]},{"ID":"20240613143956-564a123","Type":"NodeParagraph","Properties":{"id":"20240613143956-564a123","updated":"20240613143956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名巨骨"}]},{"ID":"20240613143956-3uvz3n3","Type":"NodeParagraph","Properties":{"id":"20240613143956-3uvz3n3","updated":"20240613143956"},"Children":[{"Type":"NodeText","Data":"苦平。一云辛寒，无毒。"}]},{"ID":"20240613143956-3sgppw1","Type":"NodeParagraph","Properties":{"id":"20240613143956-3sgppw1","updated":"20240613143956"},"Children":[{"Type":"NodeText","Data":"《本经》主皮肤中热，除邪气，止遗溺，利水道。"}]},{"ID":"20240613143956-y9i7wx0","Type":"NodeParagraph","Properties":{"id":"20240613143956-y9i7wx0","updated":"20240613143956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"溲疏与枸杞相类，先哲虽以有刺无刺、树高树小分辨。然枸杞未尝无刺，但树小则刺多，树大则刺少。与酸枣、白棘无异。《本经》枸杞条下主五内邪气，热中消渴，即溲疏之除邪气也。枸杞条下主周痹风湿即溲疏之止遗溺、利水道也。除去五内之邪则热中消渴愈矣。疏利水道之热则周痹风湿痊矣。溲溺疏利则气化无滞，子脏安和。观《千金方》与梅核仁、辛荑、 本、泽兰子、葛上亭长同清子脏三十六疾，其清利风热之性可知。或云巨骨即地骨之大者，按∶种树书云，收子及掘根种肥壤中，待苗生剪为蔬食甚佳，溲疏之名未必非此。"}]},{"ID":"20240613144115-ywd4dfe","Type":"NodeThematicBreak","Properties":{"id":"20240613144115-ywd4dfe"}},{"ID":"20240613142833-65qu01r","Type":"NodeThematicBreak","Properties":{"id":"20240613142833-65qu01r"}},{"ID":"20240613142908-4tw2ujp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142908-4tw2ujp","updated":"20240613142912"},"Children":[{"Type":"NodeText","Data":"溲疏《本草经集注》"}]},{"ID":"20240613142908-tw61s1x","Type":"NodeParagraph","Properties":{"id":"20240613142908-tw61s1x","updated":"20240613142908"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，无毒。主治身皮肤中热，除邪气，止遗溺。通利水道，除胃中热。"}]},{"ID":"20240613142908-23rnuhf","Type":"NodeParagraph","Properties":{"id":"20240613142908-23rnuhf","updated":"20240613142908"},"Children":[{"Type":"NodeText","Data":"下气，可作浴汤。一名巨骨。生掘耳川谷及田野故丘墟地。四月采。（漏芦为之使。）李云溲疏一名杨栌，一名牡荆，一名空疏。皮白，中空，时时有节。子似枸杞子。冬月熟，色赤，味甘、苦。末代乃无识者，此实真也，非人篱援之杨栌也。李当之此说，于论牡荆，乃不为大乖，而滥引溲疏，恐斯误矣。又云∶溲疏与空疏亦不同。掘耳，疑应作熊耳。熊耳，山名。"}]},{"ID":"20240613142908-odp8v1j","Type":"NodeParagraph","Properties":{"id":"20240613142908-odp8v1j","updated":"20240613142908"},"Children":[{"Type":"NodeText","Data":"而都无掘耳之号也。"}]},{"ID":"20240613142833-2o7f3j5","Type":"NodeThematicBreak","Properties":{"id":"20240613142833-2o7f3j5"}},{"ID":"20240613142857-dipnmov","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142857-dipnmov","updated":"20240613142902"},"Children":[{"Type":"NodeText","Data":"溲疏《医学入门》"}]},{"ID":"20240613142857-rvfmhwd","Type":"NodeParagraph","Properties":{"id":"20240613142857-rvfmhwd","updated":"20240613142857"},"Children":[{"Type":"NodeText","Data":"与枸杞相似，但有刺，味辛苦耳，气寒，无毒。主皮肤中热，除邪气，止气溺，通水道，除胃中热下气。漏芦为使。"}]},{"ID":"20240613144424-988d1zz","Type":"NodeThematicBreak","Properties":{"id":"20240613144424-988d1zz"}},{"ID":"20240613142848-inneft2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142848-inneft2","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：溲疏"}]},{"ID":"20240613142848-si5rzvl","Type":"NodeParagraph","Properties":{"id":"20240613142848-si5rzvl","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613142848-ewmv4yg","Type":"NodeParagraph","Properties":{"id":"20240613142848-ewmv4yg","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" Sōu Shū"}]},{"ID":"20240613142848-lcnomah","Type":"NodeParagraph","Properties":{"id":"20240613142848-lcnomah","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613142848-ghmib3o","Type":"NodeParagraph","Properties":{"id":"20240613142848-ghmib3o","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 巨骨（《别录》），空木、卯花（《植物学大辞典》）。"}]},{"ID":"20240613142848-ytjrktw","Type":"NodeParagraph","Properties":{"id":"20240613142848-ytjrktw","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613142848-e4mpa4h","Type":"NodeParagraph","Properties":{"id":"20240613142848-e4mpa4h","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613142848-yip9fbf","Type":"NodeParagraph","Properties":{"id":"20240613142848-yip9fbf","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613142848-8od9e08","Type":"NodeParagraph","Properties":{"id":"20240613142848-8od9e08","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 为虎耳草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"溲疏"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613142848-t88dzix","Type":"NodeParagraph","Properties":{"id":"20240613142848-t88dzix","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613142848-2i6wvtb","Type":"NodeParagraph","Properties":{"id":"20240613142848-2i6wvtb","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 生于山地或栽植于庭园。分布长江流域及华北等地。"}]},{"ID":"20240613142848-y5uvjsd","Type":"NodeParagraph","Properties":{"id":"20240613142848-y5uvjsd","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613142848-1q94flu","Type":"NodeParagraph","Properties":{"id":"20240613142848-1q94flu","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 落叶灌木，高达2米。小枝中空，赤褐色，幼时有星状毛，老时则光滑成薄片状剥落，芽具多数覆瓦状鳞片，无毛。叶对生；有短柄；叶片卵形至卵状披针形，长5～12厘米，宽2～4厘米，先端尖以至钝渐尖，基部稍圆，边缘具小齿；两面有星状毛，背面的星状毛有10～15辐射枝。圆锥花序直立，长2.5～10厘米，花白色或外面有粉红色斑点，长1.2～1.8厘米：萼杯形，有5齿，裂片三角形，早落；花瓣5，长圆形，外面被有星状毛；雄蕊10，较长的花丝与花瓣等长，花丝先端具牙齿；花柱通常3枚，离生。蒴果近球形，顶端扁平，径4～5毫米，有多数细小种子。花期5～6月。"}]},{"ID":"20240613142848-4szso3d","Type":"NodeParagraph","Properties":{"id":"20240613142848-4szso3d","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613142848-ufijfk4","Type":"NodeParagraph","Properties":{"id":"20240613142848-ufijfk4","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240613142848-55kknd7","Type":"NodeParagraph","Properties":{"id":"20240613142848-55kknd7","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，寒。\""}]},{"ID":"20240613142848-g2y3f9k","Type":"NodeParagraph","Properties":{"id":"20240613142848-g2y3f9k","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，微寒，无毒。\""}]},{"ID":"20240613142848-evbmlcv","Type":"NodeParagraph","Properties":{"id":"20240613142848-evbmlcv","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"苦，平。\""}]},{"ID":"20240613142848-gtlp54y","Type":"NodeParagraph","Properties":{"id":"20240613142848-gtlp54y","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613142848-910vstt","Type":"NodeParagraph","Properties":{"id":"20240613142848-910vstt","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"漏芦为使。\""}]},{"ID":"20240613142848-v61u8vh","Type":"NodeParagraph","Properties":{"id":"20240613142848-v61u8vh","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613142848-kydp6de","Type":"NodeParagraph","Properties":{"id":"20240613142848-kydp6de","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"主身皮肤中热，除邪气，止遗溺，可作浴汤。\""}]},{"ID":"20240613142848-286re5c","Type":"NodeParagraph","Properties":{"id":"20240613142848-286re5c","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"通利水道，除胃中热，下气。\""}]},{"ID":"20240613142848-ikg06jw","Type":"NodeParagraph","Properties":{"id":"20240613142848-ikg06jw","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613142848-zmrtaoj","Type":"NodeParagraph","Properties":{"id":"20240613142848-zmrtaoj","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或作丸。外用：煎水洗。"}]},{"ID":"20240613142848-myfroxj","Type":"NodeParagraph","Properties":{"id":"20240613142848-myfroxj","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613142848-eu2ory4","Type":"NodeParagraph","Properties":{"id":"20240613142848-eu2ory4","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 治妇人下焦三十六疾，不孕绝产：梅核仁、辛夷各一升，葛上亭长七枚，泽兰子五台，溲疏二两，藁本一两。上六味，末之，蜜和丸，先食，服如大豆二丸，日三，不知稍增。（《千金方》承泽丸）"}]},{"ID":"20240613142848-zszij7x","Type":"NodeParagraph","Properties":{"id":"20240613142848-zszij7x","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613142848-660qpmz","Type":"NodeParagraph","Properties":{"id":"20240613142848-660qpmz","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613142848-2zqgjwx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142848-2zqgjwx","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"《中华本草》：溲疏"}]},{"ID":"20240613142848-l5xzn4a","Type":"NodeParagraph","Properties":{"id":"20240613142848-l5xzn4a","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613142848-yanx4vw","Type":"NodeParagraph","Properties":{"id":"20240613142848-yanx4vw","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" Sōu Shū"}]},{"ID":"20240613142848-eqnmvzs","Type":"NodeParagraph","Properties":{"id":"20240613142848-eqnmvzs","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613142848-65l4ud9","Type":"NodeParagraph","Properties":{"id":"20240613142848-65l4ud9","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 巨骨、空木、卯花。"}]},{"ID":"20240613142848-zm3gh8h","Type":"NodeParagraph","Properties":{"id":"20240613142848-zm3gh8h","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613142848-lr25zus","Type":"NodeParagraph","Properties":{"id":"20240613142848-lr25zus","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" Fruit of Scabrous Deutzia"}]},{"ID":"20240613142848-391p0af","Type":"NodeParagraph","Properties":{"id":"20240613142848-391p0af","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613142848-1b3q190","Type":"NodeParagraph","Properties":{"id":"20240613142848-1b3q190","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》；1.《唐本草》：溲疏形似空疏，树高丈许，白皮。其子八、九月熟，色赤，似枸杞子，味苦，必两两相并。与空疏不同，空疏一名杨栌，子为荚，不似溲疏。"}]},{"ID":"20240613142848-m9iplns","Type":"NodeParagraph","Properties":{"id":"20240613142848-m9iplns","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"2.《本草会编》：按李当之但言溲疏子似枸把子，不曾言树相似。马志因其子相似，遂谓树亦相似， 以有刺无刺为别。苏颂又因巨骨、地骨之名疑其相类，殊不知枸杞未尝无刺，但小则刺多，大则刺少耳。《本草》中异物同名甚多。况一骨字之同耳，以此为言"}]},{"ID":"20240613142848-eo53i20","Type":"NodeParagraph","Properties":{"id":"20240613142848-eo53i20","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613142848-ru9heju","Type":"NodeParagraph","Properties":{"id":"20240613142848-ru9heju","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 药材基源：为虎耳草科植物溲疏的果实。"}]},{"ID":"20240613142848-y7mq9ko","Type":"NodeParagraph","Properties":{"id":"20240613142848-y7mq9ko","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Deutzia scabra Thunb."}]},{"ID":"20240613142848-y5npso4","Type":"NodeParagraph","Properties":{"id":"20240613142848-y5npso4","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-10月采收果实，晒干。"}]},{"ID":"20240613142848-q9777fs","Type":"NodeParagraph","Properties":{"id":"20240613142848-q9777fs","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613142848-xlrx3zs","Type":"NodeParagraph","Properties":{"id":"20240613142848-xlrx3zs","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1200m以下的山坡灌丛或栽培于庭园。"}]},{"ID":"20240613142848-w1mvrvm","Type":"NodeParagraph","Properties":{"id":"20240613142848-w1mvrvm","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于山东、江苏、安徽、浙江、江西、湖北、贵州等地。"}]},{"ID":"20240613142848-oyellc2","Type":"NodeParagraph","Properties":{"id":"20240613142848-oyellc2","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613142848-5bsudd4","Type":"NodeParagraph","Properties":{"id":"20240613142848-5bsudd4","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 溲疏 落叶灌木，高达3m。小枝中空，赤褐色，幼时有星状毛，老时则光滑或呈薄片状剥落，芽具多数覆瓦状鳞片，无毛。叶对生；有短柄；叶片卵形至卵状披针形，长5-12cm，宽2-4cm，先端尖以至钝渐尖，基部稍圆，边缘具小齿；上面疏被辐射线5条的星状毛，下面被少而密的6-12条辐射线的星状毛，但表面仍露出。圆锥花序直立，长3-10cm，具星状毛；萼杯状，有5齿，齿三角形，早落；花瓣5，白色或外面有粉红色斑点，长圆形或长圆状卵形，长约8mm，外面有星状毛；雄蕊10，外轮雄蕊较花瓣稍短，花丝顶端具2齿；子房下位，花柱3，离生。蒴果近球形，先端扁平，径4-5mm，有多数细小种子。花期5-6月，果期7-10月。"}]},{"ID":"20240613142848-8misg32","Type":"NodeParagraph","Properties":{"id":"20240613142848-8misg32","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613142848-6nnl4v6","Type":"NodeParagraph","Properties":{"id":"20240613142848-6nnl4v6","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实近球形，直径1-3mm。表面深褐色，具三浅沟，及多数白色斑点，疏生浅黄色柔毛或无毛。顶端扁平，具花萼脱落痕或残基，基部有果柄或果柄脱落痕，果柄上有黄色柔毛，外果皮较薄，易破碎，横断面可见3室，每室充满黑色种子，种子肾形，极小。气微，味苦。"}]},{"ID":"20240613142848-69uzodu","Type":"NodeParagraph","Properties":{"id":"20240613142848-69uzodu","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613142848-malmkuh","Type":"NodeParagraph","Properties":{"id":"20240613142848-malmkuh","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 叶和花含黄酮类化合物：山柰酚-7-葡萄糖甙（kaempferol-7-glucoside），山柰酚-3-鼠李糖-7-葡萄糖甙（kaempferol 3-rhamno-7-glucoside），槲皮素-3-葡萄糖甙（quercetin-3-gluco side），槲皮素-3-鼠李糖-葡萄糖甙（quercetin-3-rhamnogluco side），山柰酚-3-三葡萄糖甙（kaempferol-3-triglucoside），山柰酚-3-葡萄果糖-鼠李糖-葡萄糖甙（kaempferol-3-glucorhamno glucoside）等；叶中尚含环烯醚萜类化合物：a，β-溲疏甙元（deutziogenin），a，β-卯花甙元（scabroge），卯花甙（scabroside），溲疏醇（deuziol）和卯花醇（scabrosideol）。"}]},{"ID":"20240613142848-8ua54l9","Type":"NodeParagraph","Properties":{"id":"20240613142848-8ua54l9","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613142848-0s8vk1o","Type":"NodeParagraph","Properties":{"id":"20240613142848-0s8vk1o","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 膀胱；肾；胃经"}]},{"ID":"20240613142848-j8xxn2d","Type":"NodeParagraph","Properties":{"id":"20240613142848-j8xxn2d","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613142848-lxgj2qy","Type":"NodeParagraph","Properties":{"id":"20240613142848-lxgj2qy","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 苦；辛；寒；小毒"}]},{"ID":"20240613142848-1eldte8","Type":"NodeParagraph","Properties":{"id":"20240613142848-1eldte8","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613142848-0yk247k","Type":"NodeParagraph","Properties":{"id":"20240613142848-0yk247k","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 本品有毒，应慎服。"}]},{"ID":"20240613142848-wbjh195","Type":"NodeParagraph","Properties":{"id":"20240613142848-wbjh195","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613142848-icqj8e0","Type":"NodeParagraph","Properties":{"id":"20240613142848-icqj8e0","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 清热；利尿。主发热；小便不利；遗尿"}]},{"ID":"20240613142848-mhduhlp","Type":"NodeParagraph","Properties":{"id":"20240613142848-mhduhlp","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613142848-i2o508w","Type":"NodeParagraph","Properties":{"id":"20240613142848-i2o508w","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或作丸。外用：适量，煎水洗。"}]},{"ID":"20240613142848-fg4w2hv","Type":"NodeParagraph","Properties":{"id":"20240613142848-fg4w2hv","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613142848-whloaww","Type":"NodeParagraph","Properties":{"id":"20240613142848-whloaww","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 治妇人下焦三十六疾，不孕绝产: 梅核仁、辛夷各一升，葛上亭长七枚，泽兰子五合，溲疏二两，藁本一两。上六味，末之，蜜和丸，先食，服如大豆二丸， 日三，不知稍增。 (《千金方》承泽丸)"}]},{"ID":"20240613142848-jhtboo8","Type":"NodeParagraph","Properties":{"id":"20240613142848-jhtboo8","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613142848-a5rsh4t","Type":"NodeParagraph","Properties":{"id":"20240613142848-a5rsh4t","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主身皮肤中热，除邪气，止遗溺，可作浴汤。"}]},{"ID":"20240613142848-3v2aua0","Type":"NodeParagraph","Properties":{"id":"20240613142848-3v2aua0","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"2.《别录》：通利水道，除胃中热，下气。"}]},{"ID":"20240613142848-jc5x9ks","Type":"NodeParagraph","Properties":{"id":"20240613142848-jc5x9ks","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613142848-jnzi6pd","Type":"NodeParagraph","Properties":{"id":"20240613142848-jnzi6pd","updated":"20240613142848"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613142850-py2391o","Type":"NodeThematicBreak","Properties":{"id":"20240613142850-py2391o"}},{"ID":"20240613142851-3jy8zkv","Type":"NodeParagraph","Properties":{"id":"20240613142851-3jy8zkv"}}]}