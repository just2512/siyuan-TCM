},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240703104532-fqsvsxc","Type":"NodeParagraph","Properties":{"id":"20240703104532-fqsvsxc","updated":"20240827174818"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 624px;","style":"width: 614px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"狗1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/狗1-20240703104801-nj4qvtm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 614px;\" parent-style=\"width: 624px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 597px;","style":"width: 587px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240703104532-amh47xv.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 587px;\" parent-style=\"width: 597px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827174935-7txp1i0","Type":"NodeParagraph","Properties":{"id":"20240827174935-7txp1i0","updated":"20240827174935"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"狗"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/狗-20240827174935-khqnj43.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613155702-853c6dd","Type":"NodeThematicBreak","Properties":{"id":"20240613155702-853c6dd"}},{"ID":"20240613160007-eflmn9i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160007-eflmn9i","updated":"20240613160020"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲（马、牛、羊、猪、狗、鸡）《神农本草经》"}]},{"ID":"20240613160007-p5kd1dt","Type":"NodeParagraph","Properties":{"id":"20240613160007-p5kd1dt","updated":"20240613160007"},"Children":[{"Type":"NodeText","Data":"味咸平。"}]},{"ID":"20240613160007-ztj7iec","Type":"NodeParagraph","Properties":{"id":"20240613160007-ztj7iec","updated":"20240613160007"},"Children":[{"Type":"NodeText","Data":"主鬼注，蛊毒，寒热，惊痫，瘨痓，狂走，骆驼毛，尤良。"}]},{"ID":"20240613160007-0ld036x","Type":"NodeParagraph","Properties":{"id":"20240613160007-0ld036x","updated":"20240613160007"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：六畜，谓马、牛、羊、猪、狗、鸡也，蹄，即踯省文。"}]},{"ID":"20240613155702-qgal803","Type":"NodeThematicBreak","Properties":{"id":"20240613155702-qgal803"}},{"ID":"20240613155703-awr84fy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155703-awr84fy","updated":"20240613155709"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《新修本草》"}]},{"ID":"20240613155703-ea5lehq","Type":"NodeParagraph","Properties":{"id":"20240613155703-ea5lehq","updated":"20240613155703"},"Children":[{"Type":"NodeText","Data":"味咸，平，有毒。主鬼疰，蛊毒，寒热，惊痫 ，癫疾，狂走；骆驼毛尤良。"}]},{"ID":"20240613155703-aqwqctj","Type":"NodeParagraph","Properties":{"id":"20240613155703-aqwqctj","updated":"20240613155703"},"Children":[{"Type":"NodeText","Data":"六畜，谓马、牛、羊、猪、狗、鸡也，骡、驴亦其类。骆驼出外国，方家并不复用。且马、牛、羊、鸡、猪、狗毛蹄，亦以各出其身之品类中，所主疗不必皆同此矣。"}]},{"ID":"20240613155703-3jkdugs","Type":"NodeParagraph","Properties":{"id":"20240613155703-3jkdugs","updated":"20240613155703"},"Children":[{"Type":"NodeText","Data":"〔谨案〕骆驼毛蹄甲，主妇人赤白带下，最善。"}]},{"ID":"20240613155703-ojudak2","Type":"NodeThematicBreak","Properties":{"id":"20240613155703-ojudak2"}},{"ID":"20240613155712-zshs0wy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155712-zshs0wy","updated":"20240613155719"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《医学入门》"}]},{"ID":"20240613155712-su8ssld","Type":"NodeParagraph","Properties":{"id":"20240613155712-su8ssld","updated":"20240613155712"},"Children":[{"Type":"NodeText","Data":"谓牛、马、猪、羊、狗、鸡也。味咸，平，有毒。主鬼疰，蛊毒，寒热惊痫，癫 。更宜于各品类中参之。"}]},{"ID":"20240613155713-3ii1f61","Type":"NodeThematicBreak","Properties":{"id":"20240613155713-3ii1f61"}},{"ID":"20240613155737-fwssgqs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155737-fwssgqs","updated":"20240613155746"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《本草经集注》"}]},{"ID":"20240613155740-b0r8dpx","Type":"NodeParagraph","Properties":{"id":"20240613155740-b0r8dpx"},"Children":[{"Type":"NodeText","Data":"味咸，平，有毒。主治鬼疰蛊毒，寒热，惊痫痉，癫疾，狂走，骆驼毛尤良。"}]},{"ID":"20240613155737-h4pxhqk","Type":"NodeParagraph","Properties":{"id":"20240613155737-h4pxhqk","updated":"20240613155737"},"Children":[{"Type":"NodeText","Data":"六畜，谓马、牛、羊、猪、狗、鸡也，骡、驴亦其类。骆驼出外国，方家并不复用。且马、牛、羊、鸡、猪、狗毛蹄，亦已各出其身之品类中，所主治不必皆同此矣。"}]},{"ID":"20240613155816-sxhryuj","Type":"NodeThematicBreak","Properties":{"id":"20240613155816-sxhryuj"}},{"ID":"20240613155818-j7bmowp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155818-j7bmowp","updated":"20240613155823"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《证类本草》"}]},{"ID":"20240613155818-tiobjpy","Type":"NodeParagraph","Properties":{"id":"20240613155818-tiobjpy","updated":"20240613155818"},"Children":[{"Type":"NodeText","Data":"味咸，平，有毒。主鬼疰蛊毒，寒热惊痫，癫 狂走。骆驼毛尤良。"}]},{"ID":"20240613155818-05l2jfg","Type":"NodeParagraph","Properties":{"id":"20240613155818-05l2jfg","updated":"20240613155818"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶六畜，谓马、牛、羊、猪、狗、鸡也。骡、驴亦其类，骆驼，方∶家并少用。"}]},{"ID":"20240613155818-9wpe7dn","Type":"NodeParagraph","Properties":{"id":"20240613155818-9wpe7dn","updated":"20240613155818"},"Children":[{"Type":"NodeText","Data":"且狗毛蹄，亦已各出其身之品类中，所主疗不必同此矣。唐本注云∶骆驼毛蹄甲，主妇人赤白带下最善。"}]},{"ID":"20240613155818-17wyw7g","Type":"NodeParagraph","Properties":{"id":"20240613155818-17wyw7g","updated":"20240613155818"},"Children":[{"Type":"NodeText","Data":"图经文具野驼脂条下。"}]},{"ID":"20240613155824-t55dslr","Type":"NodeThematicBreak","Properties":{"id":"20240613155824-t55dslr"}},{"ID":"20240613155829-nyks5zm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155829-nyks5zm","updated":"20240613155835"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《千金翼方》"}]},{"ID":"20240613155829-86crj1h","Type":"NodeParagraph","Properties":{"id":"20240613155829-86crj1h","updated":"20240613155829"},"Children":[{"Type":"NodeText","Data":"味咸，平，有毒。主鬼疰，蛊毒，寒热惊痫，癫 狂走。"}]},{"ID":"20240613155829-q2zgft7","Type":"NodeParagraph","Properties":{"id":"20240613155829-q2zgft7","updated":"20240613155829"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"骆驼毛"}]},{"ID":"20240613155829-dqei2b5","Type":"NodeParagraph","Properties":{"id":"20240613155829-dqei2b5","updated":"20240613155829"},"Children":[{"Type":"NodeText","Data":"尤良。"}]},{"ID":"20240613155830-pgxgm4k","Type":"NodeThematicBreak","Properties":{"id":"20240613155830-pgxgm4k"}},{"ID":"20240613155840-enrogz9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155840-enrogz9","updated":"20240613155846"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《神农本草经赞》"}]},{"ID":"20240613155840-4fqan21","Type":"NodeParagraph","Properties":{"id":"20240613155840-4fqan21","updated":"20240613155840"},"Children":[{"Type":"NodeText","Data":"味咸平。主鬼注蛊毒。寒热惊痫。狂走。骆驼毛尤良。"}]},{"ID":"20240613155840-vt9hh96","Type":"NodeParagraph","Properties":{"id":"20240613155840-vt9hh96","updated":"20240613155840"},"Children":[{"Type":"NodeText","Data":"六畜遂字。四体分施。附肤燎坠。剔腹益姿。圆歧蹄辨。攫裂甲披。明驼温缛。避暑毛吹。"}]},{"ID":"20240613155840-zy7hemu","Type":"NodeParagraph","Properties":{"id":"20240613155840-zy7hemu","updated":"20240613155840"},"Children":[{"Type":"NodeText","Data":"汉书传。六畜遂字。孟子。施于四体。燕书。贾坚弯弓射牛于百步之外。附肤落毛。柳文。覆坠之易如燎毛。抱朴子。剔腹背无益之毛。虞裕文。干阳也。故马蹄圆。淮南子。牛歧蹄而戴角。宋书传。熊罴厉爪蓄攫裂之心。酉阳杂俎。明驼千里足。多误作鸣字。埤雅。驼毛缛温浓。夏退毛尽。乃能避热。韩愈诗。吁无吹毛刃。"}]},{"ID":"20240613155841-hkrv3ag","Type":"NodeThematicBreak","Properties":{"id":"20240613155841-hkrv3ag"}},{"ID":"20240613155851-xr8xufn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155851-xr8xufn","updated":"20240613155857"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《名医别录》"}]},{"ID":"20240613155851-yp3ghrx","Type":"NodeParagraph","Properties":{"id":"20240613155851-yp3ghrx","updated":"20240613155851"},"Children":[{"Type":"NodeText","Data":"有毒．"}]},{"ID":"20240613155851-gqtrks5","Type":"NodeParagraph","Properties":{"id":"20240613155851-gqtrks5","updated":"20240613155851"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶六畜毛蹄甲，味咸，平．主鬼注蛊毒，寒热惊痫，癫 狂走．骆驼毛尤良．"}]},{"ID":"20240613155852-hsmpprk","Type":"NodeThematicBreak","Properties":{"id":"20240613155852-hsmpprk"}},{"ID":"20240613155934-373iwmu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613155934-373iwmu","updated":"20240613155942"},"Children":[{"Type":"NodeText","Data":"六畜毛蹄甲《本草纲目》"}]},{"ID":"20240613155934-an02mqm","Type":"NodeParagraph","Properties":{"id":"20240613155934-an02mqm","updated":"20240613155934"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240613155934-p99311z","Type":"NodeParagraph","Properties":{"id":"20240613155934-p99311z","updated":"20240613155934"},"Children":[{"Type":"NodeText","Data":"〖集解〗〔弘景曰〕六畜，谓牛、羊、猪、马、鸡、狗也。驴、骡亦其类，各条已有主疗，亦不必出此矣。〔时珍曰〕此系《本经》一品，姑存以见古迹。"}]},{"ID":"20240613155934-h32gcdl","Type":"NodeParagraph","Properties":{"id":"20240613155934-h32gcdl","updated":"20240613155934"},"Children":[{"Type":"NodeText","Data":"〖气味〗咸，平，有毒。"}]},{"ID":"20240613155934-c76wtt0","Type":"NodeParagraph","Properties":{"id":"20240613155934-c76wtt0","updated":"20240613155934"},"Children":[{"Type":"NodeText","Data":"〖主治〗鬼疰蛊毒，寒热惊痫，癫痉狂走。骆驼毛尤良。（《本经》）"}]},{"ID":"20240613155934-n2nxzh5","Type":"NodeThematicBreak","Properties":{"id":"20240613155934-n2nxzh5"}},{"ID":"20240613155935-etmd262","Type":"NodeParagraph","Properties":{"id":"20240613155935-etmd262"}}]}