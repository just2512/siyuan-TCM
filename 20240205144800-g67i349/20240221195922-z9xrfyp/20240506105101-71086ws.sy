eKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹蛏2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹蛏2-20240703110559-p4rwzow.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240827175255-g67ro9c","Type":"NodeParagraph","Properties":{"id":"20240827175255-g67ro9c","updated":"20240827175255"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹蛏"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹蛏-20240827175255-sxohqss.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹蛏5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹蛏5-20240703111110-heh78s7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827175339-v6zph9u","Type":"NodeParagraph","Properties":{"id":"20240827175339-v6zph9u","updated":"20240827175412"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹蛏 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹蛏 1-20240827175339-0b5s4xz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 896px;","style":"width: 886px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹蛏 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹蛏 2-20240827175412-65rvxlu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 886px;\" parent-style=\"width: 896px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613160711-coe27r3","Type":"NodeParagraph","Properties":{"id":"20240613160711-coe27r3","updated":"20240703110610"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：取图为竹蛏。"}]},{"ID":"20240613160711-0xomyj1","Type":"NodeThematicBreak","Properties":{"id":"20240613160711-0xomyj1"}},{"ID":"20240613160750-lntalwn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160750-lntalwn","updated":"20240613160756"},"Children":[{"Type":"NodeText","Data":"马刀《神农本草经》"}]},{"ID":"20240613160750-s42e46i","Type":"NodeParagraph","Properties":{"id":"20240613160750-s42e46i","updated":"20240613160750"},"Children":[{"Type":"NodeText","Data":"味辛微寒（《御览》有补中二字，《大观本》，黑字）。主漏下赤白，寒热，破石淋，杀禽兽贼鼠。生池泽。"}]},{"ID":"20240613160750-jpjuv4t","Type":"NodeParagraph","Properties":{"id":"20240613160750-jpjuv4t","updated":"20240613160750"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：马刀，一名齐蛤，神农岐伯桐君咸有毒，扁鹊小寒大毒，生池泽江海，采无时也（《御览》）。"}]},{"ID":"20240613160750-x5igw4z","Type":"NodeParagraph","Properties":{"id":"20240613160750-x5igw4z","updated":"20240613160750"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名马蛤，生江湖及东海，采无时。"}]},{"ID":"20240613160750-2p40oh2","Type":"NodeParagraph","Properties":{"id":"20240613160750-2p40oh2","updated":"20240613160750"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：马刀出河东，蓺文类聚引本经云：文蛤表有文，又曰马刀，一曰名蛤，则，岂古本与文蛤为一邪。"}]},{"ID":"20240613160924-n256ybk","Type":"NodeThematicBreak","Properties":{"id":"20240613160924-n256ybk"}},{"ID":"20240613160925-gaao4hi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160925-gaao4hi","updated":"20240613160931"},"Children":[{"Type":"NodeText","Data":"马刀《本草衍义》"}]},{"ID":"20240613160925-d5dickf","Type":"NodeParagraph","Properties":{"id":"20240613160925-d5dickf","updated":"20240613160925"},"Children":[{"Type":"NodeText","Data":"京师谓之 岸，春夏人多食，然发风痰，性微冷。又顺安军界河中亦出 ，大抵与马刀相类，肉颇淡，人作 以寄邻左，又不能致远。亦发风。此等皆不可多食。今蛤粉，皆此等众蛤灰也。"}]},{"ID":"20240613160801-eav7kq9","Type":"NodeThematicBreak","Properties":{"id":"20240613160801-eav7kq9"}},{"ID":"20240613160802-z1gw107","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160802-z1gw107","updated":"20240613160807"},"Children":[{"Type":"NodeText","Data":"马刀《名医别录》"}]},{"ID":"20240613160802-y1o3bp2","Type":"NodeParagraph","Properties":{"id":"20240613160802-y1o3bp2","updated":"20240613160802"},"Children":[{"Type":"NodeText","Data":"有毒．除五脏间热，肌中鼠 ，止烦满，补中，去厥痹，利机关．用之当炼，得水肠，又云得水良．一名马蛤．生江湖及东海．取无时．"}]},{"ID":"20240613160802-7s8zuxv","Type":"NodeParagraph","Properties":{"id":"20240613160802-7s8zuxv","updated":"20240613160802"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶马刀，味辛，微寒．主漏下赤白，寒热，破石淋，杀禽兽，贼鼠．生池泽．"}]},{"ID":"20240613160859-pb5wcqh","Type":"NodeThematicBreak","Properties":{"id":"20240613160859-pb5wcqh"}},{"ID":"20240613160900-uqrzi2u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160900-uqrzi2u","updated":"20240613160904"},"Children":[{"Type":"NodeText","Data":"马刀《神农本草经赞》"}]},{"ID":"20240613160900-oxtb0v0","Type":"NodeParagraph","Properties":{"id":"20240613160900-oxtb0v0","updated":"20240613160900"},"Children":[{"Type":"NodeText","Data":"味辛微寒。主漏下赤白。寒热。破石淋。杀禽兽贼鼠。生池泽。（即齐蛤）喧捞泥浦。巧类刀裁。夜侵灯影。寒孕珠胎。琼研粉细。紫吐唇开。短长狭正。众体兼该。"}]},{"ID":"20240613160900-g77dgc0","Type":"NodeParagraph","Properties":{"id":"20240613160900-g77dgc0","updated":"20240613160900"},"Children":[{"Type":"NodeText","Data":"元稹诗。泥浦喧捞蛤。苏颂曰。多生沙泥中。张诗。夜蚌侵灯影。埤雅。蚌孚乳以秋。"}]},{"ID":"20240613160900-2x974bu","Type":"NodeParagraph","Properties":{"id":"20240613160900-2x974bu","updated":"20240613160900"},"Children":[{"Type":"NodeText","Data":"其孕珠若怀妊然。谓之珠胎。苏恭曰。壳炼粉得火良。孔平仲诗。报君以淮南紫唇之蛤。李时珍曰。其形像刀。其类甚多。长短斜正。性味功用皆同。傅咸赋。体该众妙。"}]},{"ID":"20240613160827-r5mf4wa","Type":"NodeThematicBreak","Properties":{"id":"20240613160827-r5mf4wa"}},{"ID":"20240613160828-yq5spkr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160828-yq5spkr","updated":"20240613160833"},"Children":[{"Type":"NodeText","Data":"马刀《千金翼方》"}]},{"ID":"20240613160828-cevs69c","Type":"NodeParagraph","Properties":{"id":"20240613160828-cevs69c","updated":"20240613160828"},"Children":[{"Type":"NodeText","Data":"味辛，微寒，有毒。主漏下赤白，寒热，破石淋，杀禽兽贼鼠，除五脏间热，肌中鼠 ，止烦满，补中，去厥痹，利机关，用之当炼，得水烂人肠。又云得水良。一名马蛤。生江湖池泽及东海，取无时。"}]},{"ID":"20240613160711-7ytefxd","Type":"NodeThematicBreak","Properties":{"id":"20240613160711-7ytefxd"}},{"ID":"20240613160732-0z0h17a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160732-0z0h17a","updated":"20240613160743"},"Children":[{"Type":"NodeText","Data":"马刀《医学入门》"}]},{"ID":"20240613160732-ay3ku0v","Type":"NodeParagraph","Properties":{"id":"20240613160732-ay3ku0v","updated":"20240613160732"},"Children":[{"Type":"NodeText","Data":"在处有之。长三四寸，阔五六分，头小、锐，形如斩马刀，多在沙泥中，即蚌之类也。味辛，微寒，有毒。破石淋，主漏下赤白寒热，杀禽兽贼鼠，除五脏间热，肌中鼠 ，止烦满，补中，去厥痹，利机关。"}]},{"ID":"20240613160732-trrvsrw","Type":"NodeParagraph","Properties":{"id":"20240613160732-trrvsrw","updated":"20240613160732"},"Children":[{"Type":"NodeText","Data":"用之当炼得水，烂人肠肉，可为 ，然发风痰。丹溪云∶马刀与蚌蛤、蚶、蚬、螺蛳大同小异，属金而有水、木、土。《衍义》言其冷而不言湿，多食发疾，以其湿中有火，久则气上升不降，因生疾多热，则生风矣，何冷之有？今蛤粉皆此类为之。"}]},{"ID":"20240613160813-ur0aqbi","Type":"NodeThematicBreak","Properties":{"id":"20240613160813-ur0aqbi"}},{"ID":"20240613160814-gw0fqch","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160814-gw0fqch","updated":"20240613160822"},"Children":[{"Type":"NodeText","Data":"马刀《新修本草》"}]},{"ID":"20240613160814-h6t1omx","Type":"NodeParagraph","Properties":{"id":"20240613160814-h6t1omx","updated":"20240613160814"},"Children":[{"Type":"NodeText","Data":"味辛，微寒，有毒。主漏下赤白，寒热，破石淋，杀禽兽贼鼠。除五脏间热，肌中鼠 ，止利机关。用之当炼，得水烂人肠。又云得水良。一名马蛤。生江湖李云生江汉中，长六、七寸，汉间人名为单姥，亦食其肉，肉似蚌。今人多不识之，大都似今 KT 而非。方用至少。凡此类皆不可多食，而不正入药，惟蛤蜊煮之醒酒。蚬壳陈久者止痢。车螯、蚶蛎、之属，亦可为食，无损益，不见所主。雉入大水变为 ， 云是大蛤，乃是蚌尔，煮食诸蜊蜗与菜，皆不利人也。"}]},{"ID":"20240613160814-7p9ukjh","Type":"NodeParagraph","Properties":{"id":"20240613160814-7p9ukjh","updated":"20240613160814"},"Children":[{"Type":"NodeText","Data":"〔谨案〕蚬，冷，无毒。主时气开胃，压丹石药，及疔疮，下湿气，下乳，糟煮服良。生浸取汁，洗疔疮。多食发嗽，并冷气，消肾。陈壳，疗阴疮，止痢。蚬肉，寒，去暴热，明目，利小便，下热气，香港脚，湿毒，解酒毒，目黄。浸取汁服，主消渴。烂壳，温，烧为白灰饮下，主反胃，吐食，除心胸痰水。壳陈久，疗胃反及失精。"}]},{"ID":"20240613160711-a84xkya","Type":"NodeThematicBreak","Properties":{"id":"20240613160711-a84xkya"}},{"ID":"20240613160712-758jx5h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160712-758jx5h","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：马刀"}]},{"ID":"20240613160712-wuu23co","Type":"NodeParagraph","Properties":{"id":"20240613160712-wuu23co","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613160712-pqpmhqg","Type":"NodeParagraph","Properties":{"id":"20240613160712-pqpmhqg","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" Mǎ Dāo"}]},{"ID":"20240613160712-0wqqqo8","Type":"NodeParagraph","Properties":{"id":"20240613160712-0wqqqo8","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613160712-gd33zvr","Type":"NodeParagraph","Properties":{"id":"20240613160712-gd33zvr","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 长竹蛏、竹蛏子"}]},{"ID":"20240613160712-cdlrrqq","Type":"NodeParagraph","Properties":{"id":"20240613160712-cdlrrqq","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613160712-2lsjvvw","Type":"NodeParagraph","Properties":{"id":"20240613160712-2lsjvvw","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 软体动物门瓣鳃纲竹蛏科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长竹蛏"},{"Type":"NodeText","Data":"Solen gouldii Conrad，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"贝壳"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240613160712-e2wm48s","Type":"NodeParagraph","Properties":{"id":"20240613160712-e2wm48s","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613160712-ifzwhkb","Type":"NodeParagraph","Properties":{"id":"20240613160712-ifzwhkb","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 清瘿、止带。主治瘿气，赤白带下。"}]},{"ID":"20240613160712-x1k98vo","Type":"NodeParagraph","Properties":{"id":"20240613160712-x1k98vo","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613160712-v9la23b","Type":"NodeParagraph","Properties":{"id":"20240613160712-v9la23b","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 1～3钱。（煅用）"}]},{"ID":"20240613160712-m4rnyx0","Type":"NodeParagraph","Properties":{"id":"20240613160712-m4rnyx0","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613160712-p39am88","Type":"NodeParagraph","Properties":{"id":"20240613160712-p39am88","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613160712-8ggkq79","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160712-8ggkq79","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：马刀"}]},{"ID":"20240613160712-dnogn5j","Type":"NodeParagraph","Properties":{"id":"20240613160712-dnogn5j","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613160712-v718kwt","Type":"NodeParagraph","Properties":{"id":"20240613160712-v718kwt","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" Mǎ Dāo"}]},{"ID":"20240613160712-mrei09w","Type":"NodeParagraph","Properties":{"id":"20240613160712-mrei09w","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613160712-c3oea85","Type":"NodeParagraph","Properties":{"id":"20240613160712-c3oea85","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 蜌（《尔雅，），单姥（《李当之药录》），齐蛤（《吴普本草》），马蛤（《别录》），竹蛏（《医林纂要》）。"}]},{"ID":"20240613160712-hu3k8fa","Type":"NodeParagraph","Properties":{"id":"20240613160712-hu3k8fa","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613160712-y5mhr62","Type":"NodeParagraph","Properties":{"id":"20240613160712-y5mhr62","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613160712-uucsp9a","Type":"NodeParagraph","Properties":{"id":"20240613160712-uucsp9a","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613160712-2ehio3j","Type":"NodeParagraph","Properties":{"id":"20240613160712-2ehio3j","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 为竹蛏科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长竹蛏"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"贝壳"},{"Type":"NodeText","Data":"。全年均可捕捉。采集后洗净，去肉，晒干。"}]},{"ID":"20240613160712-o0a1oq0","Type":"NodeParagraph","Properties":{"id":"20240613160712-o0a1oq0","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613160712-ck9ewsf","Type":"NodeParagraph","Properties":{"id":"20240613160712-ck9ewsf","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 生活于浅海泥沙滩。分布黄海、渤海、南海一带。"}]},{"ID":"20240613160712-q8llrge","Type":"NodeParagraph","Properties":{"id":"20240613160712-q8llrge","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613160712-3cq7jyq","Type":"NodeParagraph","Properties":{"id":"20240613160712-3cq7jyq","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 贝壳2片，长形，质薄，两壳相等。壳长5～11厘米，长度约为高度的6～7倍。壳顶位于贝壳的最前端，背腹缘几乎平行，腹缘中部微凹，壳前端呈截形，后端圆，前端较后端略粗大。外韧带黄褐色。贝壳表面光滑，被有黄褐色外皮，生长线明显，后端有时形成褶襞。壳内面白色或淡黄色.铰合部小，每壳各具1主齿。前闭壳肌痕极细长，后闭壳肌痕前后长略呈半圆形。外套痕明显，前端向背缘凹入，外套窦半圆形。足发达，细长，呈柱状。"}]},{"ID":"20240613160712-mm3my62","Type":"NodeParagraph","Properties":{"id":"20240613160712-mm3my62","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613160712-3mbhp06","Type":"NodeParagraph","Properties":{"id":"20240613160712-3mbhp06","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 咸，凉。"}]},{"ID":"20240613160712-2tst4zu","Type":"NodeParagraph","Properties":{"id":"20240613160712-2tst4zu","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"《本经》：\"味辛，微寒。\""}]},{"ID":"20240613160712-ftp744e","Type":"NodeParagraph","Properties":{"id":"20240613160712-ftp744e","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613160712-o7kzsab","Type":"NodeParagraph","Properties":{"id":"20240613160712-o7kzsab","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 散结消痰，通淋。治水瘿，气瘿，痰饮，淋病，妇人赤白漏下。"}]},{"ID":"20240613160712-9mc9xn7","Type":"NodeParagraph","Properties":{"id":"20240613160712-9mc9xn7","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主漏下赤白，寒热，破石淋。\""}]},{"ID":"20240613160712-o23mzqp","Type":"NodeParagraph","Properties":{"id":"20240613160712-o23mzqp","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除五脏间热，肌中鼠鼷，止烦满，补中，去厥痹，利机关。\""}]},{"ID":"20240613160712-eyqe5fl","Type":"NodeParagraph","Properties":{"id":"20240613160712-eyqe5fl","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"消水瘿，气瘿，痰饮。\""}]},{"ID":"20240613160712-7yytc1h","Type":"NodeParagraph","Properties":{"id":"20240613160712-7yytc1h","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613160712-tnz1weu","Type":"NodeParagraph","Properties":{"id":"20240613160712-tnz1weu","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613160712-n4qn7sk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613160712-n4qn7sk","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"《中华本草》：马刀"}]},{"ID":"20240613160712-q8f1s4d","Type":"NodeParagraph","Properties":{"id":"20240613160712-q8f1s4d","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613160712-zy1rj7n","Type":"NodeParagraph","Properties":{"id":"20240613160712-zy1rj7n","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" Mǎ Dāo"}]},{"ID":"20240613160712-ak0rvsn","Type":"NodeParagraph","Properties":{"id":"20240613160712-ak0rvsn","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613160712-6lj81y7","Type":"NodeParagraph","Properties":{"id":"20240613160712-6lj81y7","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 蜌、单姥、齐蛤、马蛤、焷岸岸"}]},{"ID":"20240613160712-61u3fg3","Type":"NodeParagraph","Properties":{"id":"20240613160712-61u3fg3","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613160712-w9osrue","Type":"NodeParagraph","Properties":{"id":"20240613160712-w9osrue","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" razor clam shell"}]},{"ID":"20240613160712-q819n20","Type":"NodeParagraph","Properties":{"id":"20240613160712-q819n20","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613160712-gp8qa04","Type":"NodeParagraph","Properties":{"id":"20240613160712-gp8qa04","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613160712-sto4dxw","Type":"NodeParagraph","Properties":{"id":"20240613160712-sto4dxw","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：马刀长六七寸，（江）汉间人名为单姥、亦食其肉，肉似蚌。"}]},{"ID":"20240613160712-8shxoal","Type":"NodeParagraph","Properties":{"id":"20240613160712-8shxoal","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：马刀似蚌而小，形狭而长，其类甚多，长短大小，厚薄邪正，虽有不同，但性味功用，大抵则一。"}]},{"ID":"20240613160712-9hlpuim","Type":"NodeParagraph","Properties":{"id":"20240613160712-9hlpuim","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613160712-nzk9dc7","Type":"NodeParagraph","Properties":{"id":"20240613160712-nzk9dc7","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蚌科动物巨首楔蚌或短褐矛蚌及其近缘种的贝壳。"}]},{"ID":"20240613160712-h4mtknh","Type":"NodeParagraph","Properties":{"id":"20240613160712-h4mtknh","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cuneopsis capitata(Heude)2.Lanceolaria grayana(Lea)"}]},{"ID":"20240613160712-ieoj8tm","Type":"NodeParagraph","Properties":{"id":"20240613160712-ieoj8tm","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季捕捞，去肉，取壳，洗净，晒干。"}]},{"ID":"20240613160712-pyazer9","Type":"NodeParagraph","Properties":{"id":"20240613160712-pyazer9","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613160712-1qgsvce","Type":"NodeParagraph","Properties":{"id":"20240613160712-1qgsvce","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 生态环境： 1.多栖息于泥底或泥沙底的湖泊或河流中，尤喜在急流水域中生活。以微小生物和植物碎屑为食料。2.栖息于泥底或泥沙底的河流、湖泊及池塘内。"}]},{"ID":"20240613160712-5msmq7f","Type":"NodeParagraph","Properties":{"id":"20240613160712-5msmq7f","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于江苏、安徽、浙江、江西、湖北、湖南等地。"}]},{"ID":"20240613160712-wl89kkw","Type":"NodeParagraph","Properties":{"id":"20240613160712-wl89kkw","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"2.分布于黑龙江、河北、山东、江苏、安徽、浙江、江西、湖北、湖南等地。"}]},{"ID":"20240613160712-hhqkvxx","Type":"NodeParagraph","Properties":{"id":"20240613160712-hhqkvxx","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613160712-o0i4rjs","Type":"NodeParagraph","Properties":{"id":"20240613160712-o0i4rjs","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 1.巨首楔蚌，楔蚌中较大的一种，一般壳长约70mm，壳高约35mm，壳宽约25mm。壳质厚而坚硬。贝壳前部极膨大，向后高度和宽度急剧缩小，因此外形呈长三角楔状。贝壳前部之膨大处的后方有一凹陷，约位于壳中。壳顶位于背缘前端，高而膨大，常呈破蚀誊宙表面棕褐色，具有同心圆有生长线。铰合部发达，左壳具2枚拟主齿和2枚侧齿，前拟主齿呈片状，后拟主齿呈三角锥状，顶部有细的裂纹，2枚侧齿细长而平行；右壳只有1枚三角锥状的前拟主齿和1枚侧齿，其后拟主齿只留有痕迹。"}]},{"ID":"20240613160712-4tqcxr2","Type":"NodeParagraph","Properties":{"id":"20240613160712-4tqcxr2","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"2.短褐矛蚌，壳长达170mm，壳高44mm，壳宽39mm。壳坚厚，略膨胀，两侧不对称，狭长，呈长矛形。长度为高的4-5倍。壳顶部稍膨胀，低于背缘，常被腐蚀，靠近前端，在贝壳全长1/10处。前缘钝圆，前背缘直，后背后缘在壳长1/2处渐向下 斜，腹缘直，中部稍凹后缘略圆或锐角。小月面长形，发达。壳面灰褐色，生长纹细致。贝壳中部的生长纹间具有排列整齐的粗短颗粒形纵褐。并在壳顶处有锯齿状纵褐，故称短褐矛蚌。铰合部发达，左壳具有2枚略呈三角锥形的拟主齿，2枚长刃状的侧齿；右有2枚拟主齿，1枚侧齿。"}]},{"ID":"20240613160712-eu1yr06","Type":"NodeParagraph","Properties":{"id":"20240613160712-eu1yr06","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613160712-svzbpe8","Type":"NodeParagraph","Properties":{"id":"20240613160712-svzbpe8","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 肺；肾经"}]},{"ID":"20240613160712-8h9ruwk","Type":"NodeParagraph","Properties":{"id":"20240613160712-8h9ruwk","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613160712-tfmvdar","Type":"NodeParagraph","Properties":{"id":"20240613160712-tfmvdar","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 味咸；性凉"}]},{"ID":"20240613160712-2jffgpu","Type":"NodeParagraph","Properties":{"id":"20240613160712-2jffgpu","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613160712-k7a1lj3","Type":"NodeParagraph","Properties":{"id":"20240613160712-k7a1lj3","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 散结消痰；通淋除热；凉血止血；平肝熄风。主瘿瘤；痰饮；淋病；崩漏；吐血；衄血；眩晕；耳鸣"}]},{"ID":"20240613160712-zgm33cr","Type":"NodeParagraph","Properties":{"id":"20240613160712-zgm33cr","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613160712-nddy51v","Type":"NodeParagraph","Properties":{"id":"20240613160712-nddy51v","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 内服：煅研末，5-15g；或煎汤，15-50g。"}]},{"ID":"20240613160712-ih3swkv","Type":"NodeParagraph","Properties":{"id":"20240613160712-ih3swkv","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613160712-itxxb5m","Type":"NodeParagraph","Properties":{"id":"20240613160712-itxxb5m","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主漏下赤白，寒热，破石淋。"}]},{"ID":"20240613160712-8oym3oa","Type":"NodeParagraph","Properties":{"id":"20240613160712-8oym3oa","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"2.《别录》：除五脏间热，肌中鼠鼷，止烦满，补中，去厥痹，利机关。"}]},{"ID":"20240613160712-r576odu","Type":"NodeParagraph","Properties":{"id":"20240613160712-r576odu","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：消水瘿，气瘿，痰饮。"}]},{"ID":"20240613160712-go8pgya","Type":"NodeParagraph","Properties":{"id":"20240613160712-go8pgya","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613160712-qyk9qnq","Type":"NodeParagraph","Properties":{"id":"20240613160712-qyk9qnq","updated":"20240613160712"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613160714-qao3ugt","Type":"NodeThematicBreak","Properties":{"id":"20240613160714-qao3ugt"}},{"ID":"20240613160715-0hts4p3","Type":"NodeParagraph","Properties":{"id":"20240613160715-0hts4p3"}}]}