\"width: 880px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826144451-8dhgvf3","Type":"NodeParagraph","Properties":{"id":"20240826144451-8dhgvf3","updated":"20240826144451"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 491px;","style":"width: 481px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"皂荚 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚 6-20240826144451-na8uicj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 481px;\" parent-style=\"width: 491px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 679px;","style":"width: 669px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"皂荚7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚7-20240702113631-d26fu3r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 669px;\" parent-style=\"width: 679px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702113523-xxp14xp","Type":"NodeParagraph","Properties":{"id":"20240702113523-xxp14xp","updated":"20240702113523"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"皂荚6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚6-20240702113523-zj6gjh1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902124434-cys4wrh","Type":"NodeParagraph","Properties":{"id":"20240902124434-cys4wrh","updated":"20240902124437"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：猪牙皂是同科植物皂荚衰老或受伤害后所结的不育果实。；"}]},{"ID":"20240613130859-5bofbt2","Type":"NodeThematicBreak","Properties":{"id":"20240613130859-5bofbt2"}},{"ID":"20240613130922-bbnxeix","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130922-bbnxeix","updated":"20240613130926"},"Children":[{"Type":"NodeText","Data":"皂荚《神农本草经》"}]},{"ID":"20240613130922-nb40er1","Type":"NodeParagraph","Properties":{"id":"20240613130922-nb40er1","updated":"20240613130922"},"Children":[{"Type":"NodeText","Data":"味辛咸温。"}]},{"ID":"20240613130922-5fd3x2k","Type":"NodeParagraph","Properties":{"id":"20240613130922-5fd3x2k","updated":"20240613130922"},"Children":[{"Type":"NodeText","Data":"主风痹，死肌，邪气，风头，泪出，利九窍，杀精物。生川谷。"}]},{"ID":"20240613130922-7esop0j","Type":"NodeParagraph","Properties":{"id":"20240613130922-7esop0j","updated":"20240613130922"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生壅州，及鲁邹县，如猪牙者良，九月十月采，阴干。"}]},{"ID":"20240613130922-4k4yka2","Type":"NodeParagraph","Properties":{"id":"20240613130922-4k4yka2","updated":"20240613130922"},"Children":[{"Type":"NodeText","Data":"案《说文》云：荚草实。《范子计然》云：皂荚出三辅，上价一枚一钱。广志曰：鸡栖子，皂荚也（《御览》），皂即草省文。"}]},{"ID":"20240613131007-s4cvhp1","Type":"NodeThematicBreak","Properties":{"id":"20240613131007-s4cvhp1"}},{"ID":"20240613131008-1y2egun","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131008-1y2egun","updated":"20240613131014"},"Children":[{"Type":"NodeText","Data":"皂荚《神农本草经赞》"}]},{"ID":"20240613131008-0zbxhvq","Type":"NodeParagraph","Properties":{"id":"20240613131008-0zbxhvq","updated":"20240613131008"},"Children":[{"Type":"NodeText","Data":"味辛咸温。主风痹死肌。邪气风头。泪出。利九窍。杀精物。生川谷。"}]},{"ID":"20240613131008-aoiacap","Type":"NodeParagraph","Properties":{"id":"20240613131008-aoiacap","updated":"20240613131008"},"Children":[{"Type":"NodeText","Data":"长垂脂浓。短具牙形。铁封蕃茂。篾束飘零。熏烟溽散。调酒风停。苍鳞百岁。去垢常青。"}]},{"ID":"20240613131008-k78blmy","Type":"NodeParagraph","Properties":{"id":"20240613131008-k78blmy","updated":"20240613131008"},"Children":[{"Type":"NodeText","Data":"李时珍曰。一种长而肥浓多脂。一种小如猪牙。不结实者。树凿一孔。入生铁三五斤。"}]},{"ID":"20240613131008-wo0fwpo","Type":"NodeParagraph","Properties":{"id":"20240613131008-wo0fwpo","updated":"20240613131008"},"Children":[{"Type":"NodeText","Data":"泥封之。即结实。其树多刺。难以上采。以篾束之。一夜自落。寇宗曰。溽暑久雨。合苍术烧烟辟邪疫。简要方。中风口噤。温酒调服少许。张耒诗。不缘去垢须青荚。自爱苍鳞百岁根。"}]},{"ID":"20240613131030-qeyy0jq","Type":"NodeThematicBreak","Properties":{"id":"20240613131030-qeyy0jq"}},{"ID":"20240613131037-skc9f8j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131037-skc9f8j","updated":"20240613131042"},"Children":[{"Type":"NodeText","Data":"皂荚《本草简要方》"}]},{"ID":"20240613131037-o6539mv","Type":"NodeParagraph","Properties":{"id":"20240613131037-o6539mv","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"主治。利九窍。辟瘟疫。搜经络消痰化食。泻肝。利肺。开胃。拔毒。风痹。死肌。"}]},{"ID":"20240613131037-anzsjmb","Type":"NodeParagraph","Properties":{"id":"20240613131037-anzsjmb","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"骨蒸。中风。口噤口。身面卒肿。头风脑宣。急喉痹塞。咳逆上气。胸中痰。结坚症。外肾偏痛便毒肿痛自缢将死。（研末吹鼻中）妇人吹乳。产难。胞衣不下。痉风疠。疥癣。一切肿痛便毒痈疽。子刺功用略同。皂角丸。猪牙皂角枳壳羌活桑白皮槟榔杏仁麻仁防风白芷陈皮各等分。研末和丸梧子大。每服三五十丸。蜜汤下。治肠风大便秘涩。有热加大黄。"}]},{"ID":"20240613131037-21aaqsd","Type":"NodeParagraph","Properties":{"id":"20240613131037-21aaqsd","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"皂角刺丸。皂角刺二两。（烧烟尽存性）防风槐花各七钱五分。蛇床子白矾（）枳壳白蒺藜（炒）羌活各五钱。蜂房（炒焦）五倍子各二钱五分。研末。醋调绿豆粉煮糊丸梧子大。每服五十丸。食前苦楝根煎汤下。治痔漏。或痛或痒。时有脓血。皂角苦参丸。大皂角五两。苦参一斤。荆芥十二两。白芷大枫子肉防风各六两。川芎当归生何首乌大胡麻枸杞子牛蒡子（炒）威灵仙全蝎白附子蒺藜（炒）独活牛膝各五两。草乌（炮）苍术（炒）连翘天麻蔓荆子羌活青风藤甘草杜仲（酥炙）各三两。白花蛇（切片酥炙）缩砂仁（炒）各二两。人参一两。研末。"}]},{"ID":"20240613131037-ujx7pjw","Type":"NodeParagraph","Properties":{"id":"20240613131037-ujx7pjw","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"醋打老米糊丸梧子大。每服三四十丸。食前后温酒下。避风忌口。治粟疮作痒。日久肤如蛇虫。"}]},{"ID":"20240613131037-ckktya2","Type":"NodeParagraph","Properties":{"id":"20240613131037-ckktya2","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"皂角化痰丸。皂荚根白皮（酥炙）白附子（炮）半夏南星（炮）枯白矾赤苓人参各一两。枳壳（炒）二两。研末。生姜汁煮面糊丸梧子大。每服三十丸。食后下。治劳风心脾壅滞痰涎盛多。喉中不利。涕唾稠粘。嗌塞吐逆。或时昏愦。皂荚丸。皂荚（酥炙）八两。研末。蜜丸梧子大。每服三丸。枣膏和汤下。治肺痈初起咳逆上气吐浊。又方。蛇蜕七条。蝉蜕白术龙胆草玄精石生当归白菊花茯苓木贼连翘赤芍刺皮穿山甲谷精草各一两五钱。猪爪二十枚。"}]},{"ID":"20240613131037-t20uon9","Type":"NodeParagraph","Properties":{"id":"20240613131037-t20uon9","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"川芎五钱。人参一两。研末。一半入牙皂十二挺（烧存性）和研。蜜丸梧子大。每服一钱。"}]},{"ID":"20240613131037-zk96yjr","Type":"NodeParagraph","Properties":{"id":"20240613131037-zk96yjr","updated":"20240613131037"},"Children":[{"Type":"NodeText","Data":"五分。空腹杏仁汤下。一半入仙灵脾一两。研和每服三钱。用猪肝三片批开。夹药煮熟。临卧时细嚼。用原汁送下。治沉翳及内外障膜。如十六般内障。同生熟地黄丸用。又方。皂荚（去皮弦蜜炙）紫菀炙草桑白皮石菖蒲半夏各二钱。明矾杏仁白丑头末各一钱。胆星一钱五分研末。以百部一两二钱煎膏为丸梧子大。每服三四钱。治久哮。皂角散。皂角（烧灰）蛤粉（研）等分和匀。每服八字。热酒调下。治吹奶。又方。皂角莱菔子等分。研末。每服二钱。水煎服。取吐。皂刺散。皂角刺三斤。烧枯蒸一时久。晒干研末。每日饭后服二钱。大黄煎浓汤调下。治疠风半月后眉发再生。皂荚散大皂荚（炙去皮子）蜀椒各一两。细辛一两五钱。捣散囊贮纳阴中。欲便。或觉闷。则出之。已复纳入。治妇人黄瘕。俟恶血毕出。洗以温汤。三日勿近男子。"}]},{"ID":"20240613130933-y8u5ptz","Type":"NodeThematicBreak","Properties":{"id":"20240613130933-y8u5ptz"}},{"ID":"20240613130934-xrtk9pu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130934-xrtk9pu","updated":"20240613130938"},"Children":[{"Type":"NodeText","Data":"皂荚《本经逢原》"}]},{"ID":"20240613130934-lpkphcv","Type":"NodeParagraph","Properties":{"id":"20240613130934-lpkphcv","updated":"20240613130934"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名皂角"}]},{"ID":"20240613130934-aj509f6","Type":"NodeParagraph","Properties":{"id":"20240613130934-aj509f6","updated":"20240613130934"},"Children":[{"Type":"NodeText","Data":"辛咸温，小毒，入药去皮弦子，酥炙用。"}]},{"ID":"20240613130934-ozd7dpb","Type":"NodeParagraph","Properties":{"id":"20240613130934-ozd7dpb","updated":"20240613130934"},"Children":[{"Type":"NodeText","Data":"《本经》主风痹死肌，邪气头风泪出，利九窍，杀精物。"}]},{"ID":"20240613130934-2utz7nv","Type":"NodeParagraph","Properties":{"id":"20240613130934-2utz7nv","updated":"20240613130934"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"皂荚辛散属金，治厥阴风木之病。观《本经》主治风痹死肌，头风泪出，皆取其去风拔毒、通关利窍，有破坚积，逐风痰，辟邪气，杀虫毒之功。吹之、导之则通上下之窍。煎之、服之则治风痰喘满。涂之、擦之则散肿消毒，去面上风气。熏之、蒸之则通大便秘结。烧烟熏之则治 疮、湿毒，即《本经》治风痹死肌之意，用之无不效验。凡人卒中风昏昏如醉，形体不收，口角流涎者，急用稀涎散吐之。若南方类中由于阴虚火炎者，误用涌剂，愈竭其津液矣，得不在所切禁乎。然治湿热痰积，肺痈吐腥，及痰迷颠妄，千缗汤、皂荚丸、来苏膏等诚为圣药，惟孕妇禁服。按∶大小二皂所治稍有不同，用治风痰，牙皂最胜；"}]},{"ID":"20240613130934-m4qc7hq","Type":"NodeParagraph","Properties":{"id":"20240613130934-m4qc7hq","updated":"20240613130934"},"Children":[{"Type":"NodeText","Data":"若治湿痰，大皂力优。古方取用甚多，然入汤药最少。有疡医以牙皂煎汤涌吐风痰，服后遍体赤痱，数日后皮脱，大伤元气，不可不慎。至于锁喉风证尤为切禁。常见有激动其痰，锁住不能吐出，顷刻立毙者。其子烧灰存性，能治大肠风秘燥结，祛风逐秽之性可知。"}]},{"ID":"20240613130954-y2o3u8p","Type":"NodeThematicBreak","Properties":{"id":"20240613130954-y2o3u8p"}},{"ID":"20240613130955-9pvrj2b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130955-9pvrj2b","updated":"20240613131000"},"Children":[{"Type":"NodeText","Data":"皂荚《增广和剂局方药性总论》"}]},{"ID":"20240613130955-6z7bvsf","Type":"NodeParagraph","Properties":{"id":"20240613130955-6z7bvsf","updated":"20240613130955"},"Children":[{"Type":"NodeText","Data":"味辛咸，温，有小毒。主风痹死肌，邪气，风头泪出，利九窍，杀精物，疗腹胀满，谷，除咳嗽囊结，妇人胞不落，明目益精。《药性论》云∶使。主破坚症腹中痛，能堕胎日华子云∶通关节，除头风，消痰，杀劳虫，治骨蒸，开胃及中风口噤。一云∶核中白肉亦入治肺药。又炮复选中心黄嚼饵之，治膈痰吞酸。《梅师方》∶治霍乱转筋，又治卒外肾偏疼。柏实为之使。恶∶麦门冬。畏∶空青、人参、苦参。生∶雍州。"}]},{"ID":"20240613130943-jxhwlil","Type":"NodeThematicBreak","Properties":{"id":"20240613130943-jxhwlil"}},{"ID":"20240613130944-o82dj5u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130944-o82dj5u","updated":"20240613130950"},"Children":[{"Type":"NodeText","Data":"皂荚《本草衍义》"}]},{"ID":"20240613130944-6wvt76y","Type":"NodeParagraph","Properties":{"id":"20240613130944-6wvt76y","updated":"20240613130944"},"Children":[{"Type":"NodeText","Data":"皂荚其子炒，舂去赤皮、仁。将骨浸软，煮熟，以糖渍之，可食。甚疏导五脏风热壅。其荚不 肥者，微炙，为末，一两，入生白矾末半两，腻粉半两，风涎潮塞气不通，水调灌一二钱。但过咽则须吐涎。凡用白矾者，分隔下涎也。又暑中湿热时，或久雨，合苍术烧，辟温疫邪湿气。"}]},{"ID":"20240613130859-tllzbzq","Type":"NodeThematicBreak","Properties":{"id":"20240613130859-tllzbzq"}},{"ID":"20240613130910-lxryqr3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130910-lxryqr3","updated":"20240613130914"},"Children":[{"Type":"NodeText","Data":"皂荚《顾松园医镜》"}]},{"ID":"20240613130910-n5bk4cp","Type":"NodeParagraph","Properties":{"id":"20240613130910-n5bk4cp","updated":"20240613130910"},"Children":[{"Type":"NodeText","Data":"〔辛咸温，有小毒。刮去皮弦及子，酥炙。〕豁痰开胸膈，〔疏导壅滞，洗涤垢腻之功，取汁熬膏，丸如桐子大，每服十丸，治胸中痰结。〕搜风治癫疾。〔开窍通关，辛散杀虫之力，一方用皂刺三斤，烧灰蒸晒，研末，大黄煎汤空心调服一钱匕，下虫而愈。〕吹喉痹，熏便秘，〔二便因气秘不通者，烧烟熏之。〕杀虫治癣，〔醋熬嫩刺，涂癣甚良。〕敷毒消肿。〔便毒痈疽，醋熬膏敷之有效。〕性极尖利，无闭不开，无坚不破，为济急之神丹。皂角刺功用同皂英，更能直达疮所，为痈毒未溃之神药。"}]},{"ID":"20240613130910-q2xvlzx","Type":"NodeParagraph","Properties":{"id":"20240613130910-q2xvlzx","updated":"20240613130910"},"Children":[{"Type":"NodeText","Data":"类中风症，多有阴虚，世人每用稀涎散吐之，是愈竭其津液也，法所所最忌，孕妇亦禁。"}]},{"ID":"20240613130859-daequpi","Type":"NodeThematicBreak","Properties":{"id":"20240613130859-daequpi"}},{"ID":"20240613130900-8okgvi4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130900-8okgvi4","updated":"20240613130904"},"Children":[{"Type":"NodeText","Data":"皂荚《汤液本草》"}]},{"ID":"20240613130900-86qsfx4","Type":"NodeParagraph","Properties":{"id":"20240613130900-86qsfx4","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"气温，味辛、咸。有小毒。"}]},{"ID":"20240613130900-hfkkf6u","Type":"NodeParagraph","Properties":{"id":"20240613130900-hfkkf6u","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"引入厥阴经药。"}]},{"ID":"20240613130900-34f52h9","Type":"NodeParagraph","Properties":{"id":"20240613130900-34f52h9","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主风痹死肌邪气，风头泪出，利九窍，疗腹胀满，消谷，除咳嗽。治囊缩，妇人胞不落，明目，益精，可为沐药，不入汤。"}]},{"ID":"20240613130900-hzksaou","Type":"NodeParagraph","Properties":{"id":"20240613130900-hzksaou","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"《日华子》云∶通关节，除头风，消痰，杀劳虫，治骨蒸，开胃，破坚瘕，腹中痛，能堕胎。柏实为之使。恶麦门冬。畏空青、人参、苦参。"}]},{"ID":"20240613130900-z7kngnk","Type":"NodeParagraph","Properties":{"id":"20240613130900-z7kngnk","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"仲景治咳逆上气，唾浊，但坐不得卧，皂荚丸主之。杵末，一物蜜丸桐子大，用枣汤服一丸，日三夜一。"}]},{"ID":"20240613130900-5741xvz","Type":"NodeParagraph","Properties":{"id":"20240613130900-5741xvz","updated":"20240613130900"},"Children":[{"Type":"NodeText","Data":"《活人书》云∶治阴毒，正阳散内用皂荚，引入厥阴也。用之有蜜炙、酥炙、烧灰之异，等分依方。"}]},{"ID":"20240613130848-w3zxtzx","Type":"NodeThematicBreak","Properties":{"id":"20240613130848-w3zxtzx"}},{"ID":"20240613130849-b2blxel","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130849-b2blxel","updated":"20240613130853"},"Children":[{"Type":"NodeText","Data":"皂荚《千金翼方》"}]},{"ID":"20240613130849-73sxaw4","Type":"NodeParagraph","Properties":{"id":"20240613130849-73sxaw4","updated":"20240613130849"},"Children":[{"Type":"NodeText","Data":"味辛咸，温，有小毒。主风痹，死肌，邪气，风头泪出，利九窍，杀精物。疗腹满，消谷，除咳嗽，囊结，妇人胞不落，明目益精。可为沐药，不入汤。生雍州川谷及鲁邹县。如猪牙者良。九月十月采荚，阴干。"}]},{"ID":"20240613130739-sr3o0x8","Type":"NodeThematicBreak","Properties":{"id":"20240613130739-sr3o0x8"}},{"ID":"20240613130833-913jja3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130833-913jja3","updated":"20240613130843"},"Children":[{"Type":"NodeText","Data":"皂荚《本草图经》"}]},{"ID":"20240613130833-8ifq2r9","Type":"NodeParagraph","Properties":{"id":"20240613130833-8ifq2r9","updated":"20240613130838"},"Children":[{"Type":"NodeText","Data":"皂荚，出雍州川谷及鲁邹县，今所在有之，以怀、孟州者为胜。木极有高硕者。此有三种∶《本经》云∶形如猪牙者良。陶注云∶长尺二者良。唐注云∶长六寸，圆浓节促直者，皮薄多肉，味浓大好。今医家作疏风气丸、煎，多用长皂荚；治齿及取积药，多用猪牙皂荚。所用虽殊，大抵性味不相远。九月、十月采荚，阴干用。张仲景治杂病方∶咳逆上气唾浊，但坐不得卧，皂荚丸主之。皂荚杵末一物，以蜜丸，大如梧子，以枣膏和汤，服一丸，日三夜一服。崔元亮《海上方》∶疗腹胀满欲瘦病者，猪牙皂荚相续，量长一尺，微火煨去皮子，捣筛，蜜丸，大如梧子。欲服药，先吃煮羊肉两脔，呷汁三两口后，以肉汁下药十丸，以快利为度，觉得力更服，以利清水即停。瘥后一月以来，不得食肉及诸油腻。又治热劳，以皂荚长一尺续成者，亦可须无孔成实者，以土酥一大两，微微涂，于火上缓炙之，不得令酥下，待酥尽即捣筛，蜜丸如梧子大，每日空腹饮下十五丸，渐增至二十丸，重者不过两剂，瘥。"}]},{"ID":"20240613130833-rd02c2f","Type":"NodeParagraph","Properties":{"id":"20240613130833-rd02c2f","updated":"20240613130833"},"Children":[{"Type":"NodeText","Data":"其初生嫩叶芽以为蔬茹，更益人，核中白肉，亦入治肺药。又炮核取中黄心嚼饵之，治膈痰吞酸。又米醋熬嫩刺针作浓煎，以傅疮癣有奇效。"}]},{"ID":"20240613130739-eblfpzc","Type":"NodeThematicBreak","Properties":{"id":"20240613130739-eblfpzc"}},{"ID":"20240613130821-q3hhbdk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130821-q3hhbdk","updated":"20240613130827"},"Children":[{"Type":"NodeText","Data":"皂荚《本草蒙筌》"}]},{"ID":"20240613130821-wysvk6y","Type":"NodeParagraph","Properties":{"id":"20240613130821-wysvk6y","updated":"20240613130821"},"Children":[{"Type":"NodeText","Data":"味辛、咸，气温，有小毒。所在各处有生，怀孟州（并属河南）者独胜。恶麦门一味，畏空青二参。（人参、苦参。）"}]},{"ID":"20240613130821-fj4twmi","Type":"NodeParagraph","Properties":{"id":"20240613130821-fj4twmi","updated":"20240613130821"},"Children":[{"Type":"NodeText","Data":"入足厥阴引经，宜以柏实为使。种因有二，用亦各分。理气疏风，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长板荚"},{"Type":"NodeText","Data":"须觅；治齿取积，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪牙荚"},{"Type":"NodeText","Data":"当求。去弦去子，煨熟俱同。蜜炙酥炙，烧灰略异。制人。堪作散熬膏，勿为丸煎液。搐鼻喷嚏立至，敷肿疼痛即除。和生矾吐拦炼蜜为导箭。（即蜜导箭。）"}]},{"ID":"20240613130821-x0izlze","Type":"NodeParagraph","Properties":{"id":"20240613130821-x0izlze","updated":"20240613130821"},"Children":[{"Type":"NodeText","Data":"杀痨虫精物，主风痹死肌。利窍通关，破症堕胎。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"皂角刺"},{"Type":"NodeText","Data":"乃载外科圣药，治溃疡直达溃处成功。"}]},{"ID":"20240613130805-yr1l00z","Type":"NodeThematicBreak","Properties":{"id":"20240613130805-yr1l00z"}},{"ID":"20240613130806-p9l6r0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130806-p9l6r0d","updated":"20240613130810"},"Children":[{"Type":"NodeText","Data":"皂荚《医学入门》"}]},{"ID":"20240613130806-mbhwqzw","Type":"NodeParagraph","Properties":{"id":"20240613130806-mbhwqzw","updated":"20240613130806"},"Children":[{"Type":"NodeText","Data":"皂荚辛咸利窍关，卒中风痹头痛宽，消痰止嗽除胀满，祛痨贴肿堕胞难。"}]},{"ID":"20240613130806-7f58rri","Type":"NodeParagraph","Properties":{"id":"20240613130806-7f58rri","updated":"20240613130806"},"Children":[{"Type":"NodeText","Data":"皂，黑色；两相夹合而中藏子也。气温，小毒，入厥阴经。搐鼻可开关窍，内服可通关格不利。中风、中气、中恶、痰厥、鬼魇、卒死、卒头痛甚，并皆为末吹鼻。久患风痹，死肌疥癣，及痰嗽咳逆，坐不得卧，为末，蜜丸服之。兼疗腹胀满，谷食不消，杀痨虫，破 瘕腹痛，牙疼咽肿，妇人难产及胞衣不下。又和酒煎膏，贴一切肿毒，止痛。长荚者疏风气，如猪牙者治齿取积，俱要肥腻不蛀，去皮子酥炙，或蜜炙烧灰。柏实为使，恶麦门冬，畏空青、人参、苦参。皂子疏通五脏风热；皂刺凡痈疽未破者能开窍，已破者能引药达疮所，乃诸恶疮癣及疠风要药也。昔有患眼昏眉落鼻崩，服刺灰浓煎大黄汤下，七旬愈。又如米醋煎膏，敷疮癣奇效。"}]},{"ID":"20240613130739-3fbfkst","Type":"NodeThematicBreak","Properties":{"id":"20240613130739-3fbfkst"}},{"ID":"20240613130741-yig2w3j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130741-yig2w3j","updated":"20240613130800"},"Children":[{"Type":"NodeText","Data":"皂荚《本草述钩元》"}]},{"ID":"20240613130741-wpjwb5r","Type":"NodeParagraph","Properties":{"id":"20240613130741-wpjwb5r","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"亦名皂角。一种小如猪牙。一种长而肥浓多脂良。一种长而瘦薄枯燥者。不取。"}]},{"ID":"20240613130741-bwaeumu","Type":"NodeParagraph","Properties":{"id":"20240613130741-bwaeumu","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"味辛微咸。气温。有小毒。气味俱浓。浮而散。阳也。入足厥阴经气分。及手太阴手足阳明经气分。搜肝风。泻肝气。通关节。开痰涎。治中风口噤。风邪痫疾。并中暑风。中气中恶痰厥。鬼魇猝死。（为末吹鼻）急喉痹风。肿塞疼痛。头风猝痛。脑宣。及风涎眩晕。"}]},{"ID":"20240613130741-ri9hg3x","Type":"NodeParagraph","Properties":{"id":"20240613130741-ri9hg3x","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"痰结（治肺有寒邪。黑痰胶固不可拔。而为喘咳者。）喘咳。（痰嗽咳逆。坐不得卧。为末蜜丸服之。）胸膈痞塞。甚为症癖。更痰逆呕吐。除风湿肿满。利二便关格。开胃通肺及大肠气。（皂荚一嗅随嚏。若磁石之吸铁然。其亦肺邪出路耶。）治风疠杀虫。散疮肿（和酒煎膏。"}]},{"ID":"20240613130741-mgzaf7w","Type":"NodeParagraph","Properties":{"id":"20240613130741-mgzaf7w","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"贴一切肿毒止痛。）风痹。除死肌疥癣。烧烟熏久痢脱肛。活人书治阴毒正气散。用皂荚引入厥阴经也。皂荚禀木气而兼火金之性。（仲淳）皂荚属金。其味辛。而性燥。金胜木。燥胜风。故入厥阴治风木之病。气浮而散。吹之导之。则通上下诸窍。（濒湖）皂荚喜铁。得铁即有所生。铁器遇之而坏。有吸铁精华之能。然皂为北方色。铁为五金。水味辛且咸。子母相生。默相感召如此。（卢不远）黑龙膏。治九种喉痹。（急喉痹。缠喉风。结喉。"}]},{"ID":"20240613130741-llelrjt","Type":"NodeParagraph","Properties":{"id":"20240613130741-llelrjt","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"烂煎至一斗半。入人参末半两。甘草末一两。煎至五升。去渣。入无灰酒一升。釜煤二匕。煎如饧。入瓶封。埋地中一夜。每温酒化下一匙。或扫入喉内。取恶涎尽为度。后含甘草片。"}]},{"ID":"20240613130741-athi1zz","Type":"NodeParagraph","Properties":{"id":"20240613130741-athi1zz","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"按是木本金气之化。故以化气从治之。况其味兼咸。又为液之原。宜乎风壅痰涎诸证。取为首治。用釜煤者。所以活血也。下方用白矾者。分膈下涎也。稀涎散。治卒中风。昏昏如醉。形体不收。或倒或不倒。或口角流涎。斯须不治。便危。此证风涎上潮。胸痹不通。急用大皂荚肥实不蛀者四挺。去黑皮。明矾一两。为末。每用半钱。重者三字温水调灌。不大呕吐。只微微令稀冷涎出一二升。当待惺。惺乃用药调治。不可便大吐之。恐过剂伤人。脑宣不止。不蛀皂荚去皮子。蜜炙捶碎。入水。取浓汁。熬成膏。搐鼻。口内咬定。良久涎出为度。痰喘咳嗽。长皂荚三条。去皮子。一荚入麻油制巴豆十粒。一荚入蜜制半夏十粒。"}]},{"ID":"20240613130741-2saw15r","Type":"NodeParagraph","Properties":{"id":"20240613130741-2saw15r","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"一荚入姜汁制杏仁十粒。火炙黄色为末。每用一字。安手心。临卧以姜汁调服之。神效。胸中痰结。钓痰膏。用醋煮半夏研末。以皂荚膏和匀。入明矾少许。加柿饼捣膏。丸如弹子。"}]},{"ID":"20240613130741-mcg7xi7","Type":"NodeParagraph","Properties":{"id":"20240613130741-mcg7xi7","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"噙之。五痫膏。治风痫诸痰。取痰如神。大皂荚半斤。去皮子。以蜜四两涂上。慢火炙透。"}]},{"ID":"20240613130741-4p34rc4","Type":"NodeParagraph","Properties":{"id":"20240613130741-4p34rc4","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"捶碎。以热水浸一时。取汁。慢火熬成膏。入麝少许。摊夹绵纸上。晒干。剪作纸花。每用三四片。入淡浆水一小盏中洗淋。下以筒吹汁入鼻内。待痰涎流尽。吃脂麻饼一个。涎尽即愈。胸腹胀满欲令瘦者。猪牙皂角相续量长一尺。微火煨。去皮子。捣筛。蜜丸如梧子大。先吃羊肉两脔。汁三两口。后以肉汁吞药十丸。快利为度。觉得力。更服。以利清水即止。瘥后一月。不得食肉及诸油腻。二便关格。皂荚炙。去皮子。为末。酒面糊丸。每服皂荚烧烟于桶内。坐上熏之即通。便毒肿痛。用猪牙皂荚七片。"}]},{"ID":"20240613130741-hyv5wxv","Type":"NodeParagraph","Properties":{"id":"20240613130741-hyv5wxv","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"煨黄。去皮弦。出火毒。为末。空心温酒服五钱。"}]},{"ID":"20240613130741-cpexom9","Type":"NodeParagraph","Properties":{"id":"20240613130741-cpexom9","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"〔论〕皂荚木有不结实者。凿孔而灌以生铁。用泥封之。便有荚。是兹木生化之原在金也。夫风木变眚。皆由于不得化气耳。风木阳也。阳极于上。而不能得阴以化。阳盛则阴从之。故中风喉痹之证。皆痰涎随风而上涌。癫痫证肝风合于心火。亦痰涎壅伏于包络。又阳实而阴不化。如风湿之胸腹肿满。及二便关格。皆风木之化穷也。惟皂荚禀金之辛。归水之咸。（色之皂者亦水）使木得金之化气以趋水。而后木之生气乃能孕育以无穷。所谓有化乃有生也。（观其采以九月十月可知）以此对待风木之不得金化。如阳盛而阴上从。及阳实而阴不化者。庶几可以转其化气。裕其生气耳。视他风剂之以祛散为功。迥乎不侔矣。抑其多主痰涎谓何。曰。肝胆同为津液府。而风升肝胆之气。固与元气无二也。风之淫者。阳实而阴虚。大非阴阳合和而化之元气矣。气病而液亦病。并后天水谷所化之液。皆乏真气以化营卫。止聚而为痰涎矣。痰涎之聚。转病乎气。而升降之化阻。于是有肺气壅滞咳嗽上气者。"}]},{"ID":"20240613130741-wfy05db","Type":"NodeParagraph","Properties":{"id":"20240613130741-wfy05db","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"有肺胃俱伤气奔于上。喘咳烦悸。涕唾稠粘者有咳嗽喘闷。胸膈痞塞者。有胸腹结为症癖。"}]},{"ID":"20240613130741-pn5tpbi","Type":"NodeParagraph","Properties":{"id":"20240613130741-pn5tpbi","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"支满。两胁抢心疼痛者。有痰逆呕吐。饮食不下者。有痰厥头痛。风涎眩晕者。有风痫惊骇。"}]},{"ID":"20240613130741-juxxm44","Type":"NodeParagraph","Properties":{"id":"20240613130741-juxxm44","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"旋晕潮搐。口吐痰沫。仆地不省者。以上均由气病以病液。还因液病以病气。气之病于液者。"}]},{"ID":"20240613130741-nakra6z","Type":"NodeParagraph","Properties":{"id":"20240613130741-nakra6z","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"始于肝。液之病乎气者。归于肺胃。此味以辛而咸者。为风木化源。并为水液化源。是先天之气化也。又辛咸中有甘。风木又以中土为化源。是后天之气化也。故随证而投主剂。佐以皂荚。无不奏功。大抵海藏所谓搜肝风。泻肝气。日华所云开胃。濒湖所云通肺及大肠气。"}]},{"ID":"20240613130741-ivh65ao","Type":"NodeParagraph","Properties":{"id":"20240613130741-ivh65ao","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"三者合而此味乃能以风化合元气之化也。或曰。此味固治风淫之痰涎矣。至病于风而无与于痰涎。如偏头风。风狂风搐。并走注如行痹。及大便风秘等证。胥能治之。何也。曰。神在天为风。在地为木。在脏为肝。夫风木之主在金。而化原则水也。风之淫者。化原亏也。内经运气。凡有余不足之病。皆曰资其化源。况化源兼之水土。又何诸风之不静乎。要知此味。"}]},{"ID":"20240613130741-z8lg9sj","Type":"NodeParagraph","Properties":{"id":"20240613130741-z8lg9sj","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"能就风化转气化之用。不徒静风已也。试观风涎上逆。功在降之。而久痢脱肛。又能升之。"}]},{"ID":"20240613130741-zmm0iq6","Type":"NodeParagraph","Properties":{"id":"20240613130741-zmm0iq6","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"是岂一静风之为功乎。气化行而血化亦宣。即胸腹肿满大肠风秘等证。亦可以征其血化。至疮毒肿痛。并疠癣之治。又不必言矣。"}]},{"ID":"20240613130741-b51bhgz","Type":"NodeParagraph","Properties":{"id":"20240613130741-b51bhgz","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"皂荚宜于暴病气实者。孕妇忌服。若类中猝仆。频用稀涎涌吐。恐津液愈耗。经络无以荣养。为拘挛偏废。慎之。（仲淳）〔辨治〕九十月采荚阴干。长荚者疏风气。如猪牙者治齿取积。俱要肥腻不蛀。去皮子酥炙。或蜜炙。或绞汁。或烧灰。各依方法。疗风及风痰用。只微煨。不可煨久去其辛味。"}]},{"ID":"20240613130741-x0sn7al","Type":"NodeParagraph","Properties":{"id":"20240613130741-x0sn7al","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"皂荚子"}]},{"ID":"20240613130741-afhx0j0","Type":"NodeParagraph","Properties":{"id":"20240613130741-afhx0j0","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"气味辛温。其仁和血润肠。治风热大肠虚秘。其性得湿则滑。滑则燥结自除。治瘰肿毒疮癣。核中白肉。入治肺药。核中黄心。（能消肾气）嚼食治膈痰吞酸。疏导五脏风热壅。用子炒。舂去赤皮。以水浸软煮熟。糖渍食之。腰脚风痛。不能履地。皂角子一千二百个。洗净。以少酥熬香为末。蜜丸梧子大。每空心以蒺藜子酸枣仁汤下三十丸。大肠虚秘。（风人虚人香港脚人大肠或秘或利。）即用上方。服至百丸。以通为度。肠风下血。"}]},{"ID":"20240613130741-t44wlv4","Type":"NodeParagraph","Properties":{"id":"20240613130741-t44wlv4","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"皂荚子槐实一两。用粘谷糠炒香。去糠为末。陈粟米饮下一钱。"}]},{"ID":"20240613130741-dpf6ihv","Type":"NodeParagraph","Properties":{"id":"20240613130741-dpf6ihv","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"〔修治〕拣取圆硬不蛀者。煮熟。剥去硬皮。取向里白肉两片。去黄。（消人肾气）以铜刀切晒用。"}]},{"ID":"20240613130741-4nv0ury","Type":"NodeParagraph","Properties":{"id":"20240613130741-4nv0ury","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"皂木皮根皮"}]},{"ID":"20240613130741-yv72jua","Type":"NodeParagraph","Properties":{"id":"20240613130741-yv72jua","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"气味辛温。治风热痰气。杀虫。皂荚化痰丸。用皂角木白皮。治劳风。心脾壅滞。"}]},{"ID":"20240613130741-lyx4h7d","Type":"NodeParagraph","Properties":{"id":"20240613130741-lyx4h7d","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"痰涎盛多。喉中不利。涕唾稠粘。嗌塞吐逆。不思饮食。或时昏愦。方详准绳痰饮条。"}]},{"ID":"20240613130741-74nn7me","Type":"NodeParagraph","Properties":{"id":"20240613130741-74nn7me","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"刺"}]},{"ID":"20240613130741-sauhbie","Type":"NodeParagraph","Properties":{"id":"20240613130741-sauhbie","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"气味辛温。锐利直达病所。治痈肿妒乳。疠风恶疮。杀虫。下胎衣。凡痈疽未破者。"}]},{"ID":"20240613130741-f4y5err","Type":"NodeParagraph","Properties":{"id":"20240613130741-f4y5err","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"皂刺能开窍。已破者。能引药达疮所。乃诸恶疮癣及疠风要药。大风恶疾。双目昏盲。眉发自落。鼻梁崩倒。势不可救。异人传方。用皂刺（能出风毒于荣血中）三斤。烧灰。"}]},{"ID":"20240613130741-swrjv6t","Type":"NodeParagraph","Properties":{"id":"20240613130741-swrjv6t","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"蒸一时久。日干为末。食后。浓煎大黄汤。调一匕饮之。一旬眉发再生。肌润目明。又东加郁金白牵牛。即丹溪通天再造散。俱云服后便出黑虫为验。（新虫嘴赤。老虫嘴黑。）然则此味。诚为疠风要药矣。产后乳汁不泄结毒者。皂角刺蔓荆子各烧存性。等分为末。每温酒服二钱。腹内生疮在肠脏。不可药治者。取皂刺不拘多少。好酒一碗。煎至七分。温服。其浓血悉从小便出。不饮酒者。水煎亦可。疮肿无头。皂角刺烧灰。酒服三钱。嚼葵子三五粒。其处如针刺为效。"}]},{"ID":"20240613130741-g2eb22w","Type":"NodeParagraph","Properties":{"id":"20240613130741-g2eb22w","updated":"20240613130741"},"Children":[{"Type":"NodeText","Data":"痈疽已溃。不宜服。"}]},{"ID":"20240613130407-xxxuiwo","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-xxxuiwo"}},{"ID":"20240613130701-702hzwp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130701-702hzwp","updated":"20240613130709"},"Children":[{"Type":"NodeText","Data":"皂荚《证类本草》"}]},{"ID":"20240613130701-ruxkz1x","Type":"NodeParagraph","Properties":{"id":"20240613130701-ruxkz1x","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"味辛、咸，温，有小毒。主风痹死肌邪气，风头泪出，利九窍，杀精物，疗腹胀满，消谷，除咳嗽，囊结，妇人胞不落，明目，益精。可为沐药，不入汤。生雍州川谷及鲁邹县，如猪牙者良。九月、十月采荚，阴干。（柏实为之使，恶麦门冬，畏空青、人参、苦参。）"}]},{"ID":"20240613130701-j3cjqnp","Type":"NodeParagraph","Properties":{"id":"20240613130701-j3cjqnp","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今处处有，长尺二者良。俗人见其皆有虫孔而未尝见虫形，皆言不可近，令人恶病，殊不尔。其虫状如草菜上青虫，荚微欲黑便出，所以难见尔。但取青荚生者看，自知之。唐本注云∶此物有三种∶猪牙皂荚最下，其形曲戾薄恶，全无滋润，洗垢不去；其尺二寸者，粗大长虚而无润；若长六、七寸，圆浓节促直者，皮薄多肉，味浓大好。臣禹锡等谨按药性论云∶皂荚，使。主破坚症，腹中痛，能堕胎。又曰∶将皂荚于酒中，取尽其精，于火内煎之成膏，涂帛，贴一切肿毒，兼能止疼痛。陈藏器云∶鬼皂荚作浴汤，去风疮疥癣，挪叶去衣垢，沐头长发。生江南泽畔，如皂荚，高一、二尺。日华子云∶皂荚，通关节，除头风，消痰，杀劳虫，治骨蒸，开胃及中风口噤。入药去皮、子，以酥炙用。"}]},{"ID":"20240613130701-1n9aynh","Type":"NodeParagraph","Properties":{"id":"20240613130701-1n9aynh","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"图经曰∶皂荚，出雍州川谷及鲁邹县，今所在有之，以怀、孟州者为胜。木极有高硕者。"}]},{"ID":"20240613130701-ztbiw5d","Type":"NodeParagraph","Properties":{"id":"20240613130701-ztbiw5d","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"此有三种∶《本经》云∶形如猪牙者良。陶注云长尺二者良。唐注云长六寸，圆浓节促直者，皮薄多肉味浓，大好。今医家作疏风气丸、煎多用长皂荚，治齿及取积药多用猪牙皂荚，所用虽殊，大抵性味不相远。九月、十月采荚，阴干用。张仲景治杂病方，咳逆上气，唾浊但坐不得卧，皂角丸主之。皂荚杵末，一物以蜜丸大如梧子，以枣膏和汤服一丸，日三、夜一服。崔元亮《海上方》疗腹胀满欲瘦病者。猪牙皂角相续量长一尺，微火煨，去皮、子，捣筛，蜜丸大如梧子。欲服药先吃煮羊肉两脔，呷汁三两口，后以肉汁下药十丸，以快利为度。觉得力，更服，以利清水即停。瘥后一月以来，不得食肉及诸油腻。又治热劳。以皂荚长一尺续成者亦可，须无孔成实者，以土酥一大两微微涂，于火上缓炙之，不得令酥下，待酥尽即捣筛，蜜丸如梧子大。每日空腹饮下十五丸，渐增至二十丸。重者不过两剂瘥。其初生嫩叶芽，以为蔬茹更益人。核中白肉亦入治肺药。又，炮复选中黄心嚼饵之，治膈痰，吞酸。又，米醋熬嫩刺针作浓煎，以敷疮癣，有奇效。"}]},{"ID":"20240613130701-m6q3hsz","Type":"NodeParagraph","Properties":{"id":"20240613130701-m6q3hsz","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，须要赤腻肥并不 者，然用新汲水浸一宿了，用铜刀削上粗皮，用酥反复炙，酥尽为度。然出捶之，去子捣筛。皂荚一两，酥二分，子收得。拣取圆满坚硬不蛀者，用瓶盛下水于火畔煮，待泡熟，剥去硬皮一重了，取向里白嫩肉两片，去黄，其黄消人肾气。将白两片用铜刀细切，于日中干用。圣惠方∶治时气三日，头痛烦热。用皂角烧作灰为末，非时新汲水一中盏，生姜汁、蜜各少许，和二钱服之。先用暖水淋浴后服药，须臾汗出愈。外台秘要治卒中风口 。以皂角五两，去皮为末，以三年大醋和。右 涂左，左 涂右，干更敷之，瘥。又方∶龋齿方∶捣皂角去皮，炙为末，涂齿上，吐之。又方∶溺死一宿者尚活，捣皂角纸裹，纳下部，须臾出水即活。千金方∶ 鼻。炙皂角末如小豆，以竹管吹鼻中。又方∶鬼魇不悟。皂荚末刀圭起死人。又方∶难产。吞皂角子二枚，立瘥。肘后方∶卒肿满身面洪。用皂角剥炙令黄，锉三升，酒一斗渍，合器煮令沸，服一升，日三服，频作。又方∶小儿身上恶疮。先以皂角水洗，拭干。以少油麻捣烂，敷，焦即瘥。"}]},{"ID":"20240613130701-m1pjvui","Type":"NodeParagraph","Properties":{"id":"20240613130701-m1pjvui","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"经验方∶治食气遍身黄肿，气喘，食不得，心胸满闷。不蛀皂角（去皮及子，涂好醋炙令焦为末）一钱匕，巴豆七枚（去油、膜），二件以淡醋及研好墨，为丸如麻子大，每服三丸，食后一日增一丸，以利为度。如常服，消酒食。梅师方∶治霍乱转筋。皂荚末，吹一小豆鼻中，得嚏便瘥。又方∶治卒外肾偏疼。皂荚和皮为末，水调敷之良。孙真烧皂荚细研，粥饮下三钱，立通。又方∶伤寒无问阴阳神验方∶以皂角一挺（肥者），烧令赤为末，以水五合阴阳伤寒以酒和服。又方∶治腰脚不覆地。取子一千二百个，净洗令干，少酥熬令香子、酸枣子汤下三十丸。又方∶治卒死，以末吹入鼻中。又方∶治魇，以末吹鼻中。斗门方∶治卒头痛。以皂角末，吹入鼻中，令嚏则止。简要济众∶治中风口噤不开，涎潮吐方∶用皂角一挺去皮，涂色，为末。每服一钱匕，非时温酒服。如气实脉盛，调二钱匕。如牙关不开，用白梅揩齿，口开即灌药，以吐出风涎瘥。"}]},{"ID":"20240613130701-doa8n4t","Type":"NodeParagraph","Properties":{"id":"20240613130701-doa8n4t","updated":"20240613130701"},"Children":[{"Type":"NodeText","Data":"博济方∶治皂荚水并恶水入口内，热痛不止。以皂荚子烧存性一分，沙糖半两，先杀研皂子令细，续入沙糖匀和如膏，含之。十全方∶治牙疼。用不救方∶以皂荚去皮、子，下，须臾便破，少血出，即愈。孙尚药∶治卒中风，昏昏若醉，形体昏闷，四肢不收，或倒或不倒，或口角似利，微有涎出，斯须不治，便为大病，故伤人也。此证风涎潮于上，膈痹气不通，宜用救急稀涎散。猪牙皂角四挺，须是肥实不 ，削去黑皮，晋矾一两，光明通莹者，二味同捣罗为细末。再研为散。如有患者，可服半钱，重者三字匕，温水调灌下。不大呕吐，只是微微涎稀冷，出或一升、二升。当时惺惺次缓而调治。不可便大段吐之，恐过伤人命。累经效不能尽述。感应神仙传∶崔言者，职隶左亲骑军，一旦得疾，双眼昏，咫尺不辨人物，眉发自落，鼻梁崩倒，肌肤有疮如癣，皆为恶疾，势不可救。因为洋州骆谷子归寨使，遇一道流，自谷中出，不言名姓，授其方∶曰∶皂角刺一、二斤为灰，蒸久晒研为末。食上浓煎大黄汤调一钱匕，服。一旬鬓发再生，肌肤悦润，愈，眼目倍常明。得此方∶后却入山，不知所之，又铁砧以 金银，虽百衍义曰∶皂荚，其子炒，舂去赤皮、仁。将骨浸软，煮熟，以糖渍之，可食。甚疏导五脏风热壅。其荚不 肥者，微炙，为末一两，入生白矾末半两，腻粉半两。风涎潮塞气不通，水调则须吐涎。凡用白矾者，分隔下涎也。又暑中湿热时，或久雨，合苍术烧，辟温疫邪湿气。"}]},{"ID":"20240613130628-h6cydfk","Type":"NodeThematicBreak","Properties":{"id":"20240613130628-h6cydfk"}},{"ID":"20240613130648-zq2ugoy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130648-zq2ugoy","updated":"20240613130653"},"Children":[{"Type":"NodeText","Data":"皂荚《本草崇原》"}]},{"ID":"20240613130648-g5kxh78","Type":"NodeParagraph","Properties":{"id":"20240613130648-g5kxh78","updated":"20240613130648"},"Children":[{"Type":"NodeText","Data":"气味辛咸温，有小毒。主治风痹死肌，邪气风头泪出，利九窍，杀精物。"}]},{"ID":"20240613130648-ng713j7","Type":"NodeParagraph","Properties":{"id":"20240613130648-ng713j7","updated":"20240613130648"},"Children":[{"Type":"NodeText","Data":"（皂荚处处有之，其树高硕，叶如槐叶，枝间有刺，即皂角刺也。夏开细黄花，结实有三种，一种小如猪牙，一种大而肥浓，多脂而粘，一种长而瘦薄，枯燥不粘，皆可入药。《本经刺，难上采荚，以篾箍其树，一夜自落，有不结实者，树凿一孔入生铁三五斤，泥封之即结荚。人以铁砧捶皂荚，即自损，铁碾碾之，久则成孔，铁锅爨之多爆片落。）"}]},{"ID":"20240613130648-go90kmc","Type":"NodeParagraph","Properties":{"id":"20240613130648-go90kmc","updated":"20240613130648"},"Children":[{"Type":"NodeText","Data":"（愚按∶纳生铁而即结荚者，铁乃金类，色黑属水，得金水之气，则木茂而结荚也。铁遇之而剥损者，荚色紫赤，具太阳火热之气，火能克金也。蔑箍其皮，荚即落者，太阳之气自下而上行于肤表，箍其皮则阳气不能上升，太阳气殒而荚落矣。）"}]},{"ID":"20240613130648-fzg316b","Type":"NodeParagraph","Properties":{"id":"20240613130648-fzg316b","updated":"20240613130648"},"Children":[{"Type":"NodeText","Data":"皂荚枝有刺而味辛，禀金气也。色紫赤而味兼咸，禀水气也。太阳之气合金气而出于肤表，合水气而下挟膀胱，故味辛咸而气温热，辛咸温热，则有小毒矣。风邪迫于周身，则为风痹死肌之证。风邪上薄于头，则为风头泪出之证。皂荚禀金气而制风，故能治也。九窍为水注之气，皂荚禀水气，故利九窍。太阳阳热之气，若天与日，天日光明，则杀精物，精物，犹百精老物也。"}]},{"ID":"20240613130628-8sehbik","Type":"NodeThematicBreak","Properties":{"id":"20240613130628-8sehbik"}},{"ID":"20240613130639-zx4enf5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130639-zx4enf5","updated":"20240613130643"},"Children":[{"Type":"NodeText","Data":"皂荚《要药分剂》"}]},{"ID":"20240613130639-obqec2j","Type":"NodeParagraph","Properties":{"id":"20240613130639-obqec2j","updated":"20240613130639"},"Children":[{"Type":"NodeText","Data":"味辛咸。性温。无毒。禀木气而兼火金之性以生。升也。阳也。柏实为使。恶麦冬。"}]},{"ID":"20240613130639-a46wsgh","Type":"NodeParagraph","Properties":{"id":"20240613130639-a46wsgh","updated":"20240613130639"},"Children":[{"Type":"NodeText","Data":"畏空青、人参、苦参。伏丹砂。即皂角。"}]},{"ID":"20240613130639-mwblqx5","Type":"NodeParagraph","Properties":{"id":"20240613130639-mwblqx5","updated":"20240613130639"},"Children":[{"Type":"NodeText","Data":"【主治】主风痹死肌邪气。风头泪出。利九窍。杀精物。疗腹胀满。消谷。除咳嗽。囊结。"}]},{"ID":"20240613130639-72w1gvm","Type":"NodeParagraph","Properties":{"id":"20240613130639-72w1gvm","updated":"20240613130639"},"Children":[{"Type":"NodeText","Data":"风口噤【归经】入肺大肠二经。为通窍搜风之品。（能通上下关窍）【前论】好古曰。皂荚厥阴之药。活人书治阴毒。正气散内用皂荚。引入厥阴也。孙用和曰可使为秘为外科要药。功同皂荚。但更锋锐。直达患所。溃散痈疽。"}]},{"ID":"20240613130639-9genl6e","Type":"NodeParagraph","Properties":{"id":"20240613130639-9genl6e","updated":"20240613130639"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。似中风症。由阴虚火炎。煎熬成痰。热极生风。至猝然仆蹶。不可遽用稀【炮制】好古曰。凡用皂荚。有蜜炙、酥炙、绞汁、烧灰之异。各依方用。"}]},{"ID":"20240613130628-9b79wyw","Type":"NodeThematicBreak","Properties":{"id":"20240613130628-9b79wyw"}},{"ID":"20240613130629-1lzihkm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130629-1lzihkm","updated":"20240613130633"},"Children":[{"Type":"NodeText","Data":"皂荚《本草从新》"}]},{"ID":"20240613130629-b28gea7","Type":"NodeParagraph","Properties":{"id":"20240613130629-b28gea7","updated":"20240613130629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名皂角．宣、通窍搜风．"}]},{"ID":"20240613130629-8as1o0e","Type":"NodeParagraph","Properties":{"id":"20240613130629-8as1o0e","updated":"20240613130629"},"Children":[{"Type":"NodeText","Data":"辛咸而温．有小毒．入肺、大肠．兼入肝经．性极尖利．搜风泄热．吹之导之．则通上下关窍．而涌吐痰涎．搐鼻立作喷嚏．治中风口噤．胸痹喉痹．（凡中风不醒人事、口噤不能进药、急提头发、手掐人中、用皂荚末或半夏末、吹入鼻中、有嚏者生、无嚏者为肺气已绝、死、或用稀涎散吐之、皂荚末一两、白矾五钱、每用一钱、温水调灌、或加藜芦、麝少许、鹅翎探喉、令微吐稀涎、再用药治、年老气虚者忌用．）服之则除湿去垢．（最去油腻、刮人肠胃．）宣壅导滞．（取中段、汤泡服、治老人风秘．）消痰破坚．杀虫下胎．治风湿风癞．痰喘肿满．坚症囊结．（厥阴肝脉络阴器、寒客肝经、则为囊结．）涂之则散肿消毒．煎膏贴辟瘟疫湿气．济急颇有神效．稍涉虚者．切勿轻与．孕妇忌之．"}]},{"ID":"20240613130629-tp8joe8","Type":"NodeParagraph","Properties":{"id":"20240613130629-tp8joe8","updated":"20240613130629"},"Children":[{"Type":"NodeText","Data":"一种小如猪牙．一种长而枯燥．一种肥浓多脂者良．去皮子弦．或蜜炙、酥炙．绞汁烧灰．"}]},{"ID":"20240613130629-ron0c9u","Type":"NodeParagraph","Properties":{"id":"20240613130629-ron0c9u","updated":"20240613130629"},"Children":[{"Type":"NodeText","Data":"柏实为使．恶麦冬．畏人参、苦参．（性能消铁、不结荚者、凿树一孔、入铁封之、则结荚矣故此木不能烧爨．）子、去皮水浸软．煮糖渍食之．治大肠燥结．（汪机曰∶其性得湿则滑、时珍曰∶亦辛以润之之义、非得湿则滑也．）瘰 恶疮．（卒病头痛、皂荚末吹鼻取嚏、 不通、皂荚末吹之．）"}]},{"ID":"20240613130407-nf0bbu5","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-nf0bbu5"}},{"ID":"20240613130618-sjq2ahp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130618-sjq2ahp","updated":"20240613130622"},"Children":[{"Type":"NodeText","Data":"皂荚《本草新编》"}]},{"ID":"20240613130618-e023kfm","Type":"NodeParagraph","Properties":{"id":"20240613130618-e023kfm","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"皂荚，味辛、咸，气温，有小毒。入足厥阴、手少阴、手太阴三经。理气疏风，搐鼻喷噎，可救五绝痰迷、中风不语诸症。敷肿痛即除，吐风痰，杀痨虫精物，起风痹，治死肌，利窍开关，破症堕孕。此物备急用之药，药笼中不可无者也。"}]},{"ID":"20240613130618-43ondph","Type":"NodeParagraph","Properties":{"id":"20240613130618-43ondph","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"或问皂荚开关之药，单用以取捷乎？夫皂荚之功用，不止此也。凡心疼之病，随愈而随发者，必用皂荚，始可除根，此《本草》所未言也。张夫子曾传余治心痛之方，实有皂荚火炒一两、炒栀子一两、炙甘草五钱、白芍二两、广木香三钱，为细末。老黄米煮粥为丸，如米大，滚水送下即愈，永不再发。是皂荚又可以治心疼也。然而，皂荚非治心疼之药，借其开窍引入于心之中，使诸药直攻其邪也。"}]},{"ID":"20240613130618-q9ezxy2","Type":"NodeParagraph","Properties":{"id":"20240613130618-q9ezxy2","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"或问皂荚生用乎，抑熟用之乎？皂荚熟用则无益矣，必生用为佳。然而，生用切不可用蛀者。盖皂荚虫尤细，凡研末之时，蛀虫乘开关之际，直入肺中，反成大害。故必须拣不蛀者，研为细末，即包在纸包之内，亦必须常取出经风，以防其再蛀。我有一方，制之最佳，用麝香同包，断无再蛀之理，且又可借麝香之香，引入鼻窍，而开关更灵也。"}]},{"ID":"20240613130618-ptmfam2","Type":"NodeParagraph","Properties":{"id":"20240613130618-ptmfam2","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"或问用皂荚末以治中风，吐其痰而不愈，反成偏枯之症，何也？曰∶皂荚用末以吹鼻，使中风之人关开，实治方之功也。若入于稀涎散中吐之，非治也。盖近来中风者，皆非真中风，尽由于阴阳水火之虚，或阴虚火炎，煎熬津液，结而为痰，热极生风，猝然仆厥。使更吐痰，则愈损其津液矣。津液重伤，经络无水以相养，或气虚而无以相通，安得不变为拘挛偏废之症哉。"}]},{"ID":"20240613130618-881troj","Type":"NodeParagraph","Properties":{"id":"20240613130618-881troj","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"或疑神仙传载∶崔言逢异人传皂荚刺三斤烧灰，调大黄末，以治大麻风，虽将死尚可救。"}]},{"ID":"20240613130618-3se3s4t","Type":"NodeParagraph","Properties":{"id":"20240613130618-3se3s4t","updated":"20240613130618"},"Children":[{"Type":"NodeText","Data":"何子注《本草》略之乎？曰∶皂角刺安能救大麻风哉，此误传也。用此方以救之，是速之死耳。"}]},{"ID":"20240613130407-dj8f6mt","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-dj8f6mt"}},{"ID":"20240613130605-yw8ws8d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130605-yw8ws8d","updated":"20240613130611"},"Children":[{"Type":"NodeText","Data":"皂荚《本草乘雅半偈》"}]},{"ID":"20240613130605-m53on8k","Type":"NodeParagraph","Properties":{"id":"20240613130605-m53on8k","updated":"20240613130605"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613130605-9wrtxqx","Type":"NodeParagraph","Properties":{"id":"20240613130605-9wrtxqx","updated":"20240613130605"},"Children":[{"Type":"NodeText","Data":"【气味】辛咸温，有小毒。"}]},{"ID":"20240613130605-7do8xb2","Type":"NodeParagraph","Properties":{"id":"20240613130605-7do8xb2","updated":"20240613130605"},"Children":[{"Type":"NodeText","Data":"【主治】主风痹死肌邪气，风头泪出，利九窍，杀精物。"}]},{"ID":"20240613130605-mteg1sr","Type":"NodeParagraph","Properties":{"id":"20240613130605-mteg1sr","updated":"20240613130605"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出雍州山谷，及鲁邹县，近以怀、孟者为胜，所在有之。树极高硕，叶似槐，瘦长而尖。枝间多刺。夏作细花黄色。结实有三种∶一种短小，形似猪牙；一种长大肥浓多脂而粘手；一种细长瘦薄，枯燥而不粘手。入药肥浓多脂者佳。但树多丛刺，难于采取，用竹篾箍树本，其荚过夜尽落，亦一异也。有不结实者，将树本凿一大孔，入生铁三五斤，遂用泥封孔口，次年即结实，且倍往昔。有人以铁砧捶皂荚，砧即自损；或以铁碾之，碾即成孔；或以铁锅爨之，锅即暴片自落。岂皂荚与铁，有感召之情耶？修事，取赤色脂浓不蛀者，新汲水浸一宿，铜刀刮去粗皮，用乳酥反复炙透，捶去子、弦。每荚一两，用酥五钱。柏实为之使。恶麦门冬，畏空青、人参、苦参。"}]},{"ID":"20240613130605-1gss2gc","Type":"NodeParagraph","Properties":{"id":"20240613130605-1gss2gc","updated":"20240613130605"},"Children":[{"Type":"NodeText","Data":"【 】曰∶皂水色，咸水味，当为五木之水矣。灌铁木中，皂荚始茂，不为金所刑，转以铁为生者，即母令子实，递成生化，木藉金为用也。独辛金味胜，故主风痹死肌，风头泪出；以辛泻之，泻之者泻外身之外风也；亦以辛补之，补之者，补内身之风大也。若窍闭即风大不及。精物即外风太过，咸可补之泻之。顾补泻在病主之苦欲，随病主之苦欲，因名药物之补泻耳。"}]},{"ID":"20240613130407-cdc0lzm","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-cdc0lzm"}},{"ID":"20240613130554-f3ghjcq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130554-f3ghjcq","updated":"20240613130558"},"Children":[{"Type":"NodeText","Data":"皂荚《名医别录》"}]},{"ID":"20240613130554-j3bq3mn","Type":"NodeParagraph","Properties":{"id":"20240613130554-j3bq3mn","updated":"20240613130554"},"Children":[{"Type":"NodeText","Data":"有小毒．主治腹胀满，消谷，破咳嗽囊结，妇人胞下落，明目，益精．可为沐药，不汤．生雍州及鲁邹县．如猪牙者良．九月、十月采荚，阴干．（青葙子为之使，恶麦门冬畏空青、人参、苦参．）"}]},{"ID":"20240613130554-66rhqm9","Type":"NodeParagraph","Properties":{"id":"20240613130554-66rhqm9","updated":"20240613130554"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶皂荚，味辛、咸，温．主风痹死肌邪气，风头泪出，利九窍，杀精物．生川谷．"}]},{"ID":"20240613130407-b5r26ld","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-b5r26ld"}},{"ID":"20240613130536-oefzy04","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130536-oefzy04","updated":"20240613130549"},"Children":[{"Type":"NodeText","Data":"皂荚《本草经集注》"}]},{"ID":"20240613130536-ans1fhy","Type":"NodeParagraph","Properties":{"id":"20240613130536-ans1fhy","updated":"20240613130536"},"Children":[{"Type":"NodeText","Data":"味辛、咸，温，有小毒。主治风痹，死肌，邪气，风头泪出，下水，利九窍，杀鬼、精物。治腹胀满，消谷，破咳嗽囊结，妇人胞不落，明目益精。可为沐药，不入汤。生雍州川谷及鲁邹县，如猪牙者良。九月、十月采荚，阴干。（青葙子为之使，恶麦门冬，畏空青、人参、苦参。）"}]},{"ID":"20240613130536-jb89ytj","Type":"NodeParagraph","Properties":{"id":"20240613130536-jb89ytj","updated":"20240613130536"},"Children":[{"Type":"NodeText","Data":"今处处有，长尺二者良。世人见其皆有虫孔，而未尝见虫形，皆言不可近，令人恶病，殊不尔。其虫状如草菜上青虫，荚微欲黑，便出，所以难见尔。但取生者看，自知之也。"}]},{"ID":"20240613130407-7x9lsst","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-7x9lsst"}},{"ID":"20240613130441-j0xysmz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130441-j0xysmz","updated":"20240613130542"},"Children":[{"Type":"NodeText","Data":"皂荚《本草纲目》"}]},{"ID":"20240613130441-3ol8l74","Type":"NodeParagraph","Properties":{"id":"20240613130441-3ol8l74","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"「释名」皂角、鸡栖子、乌犀、悬刀。"}]},{"ID":"20240613130441-mw8r4m2","Type":"NodeParagraph","Properties":{"id":"20240613130441-mw8r4m2","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"「气味」"}]},{"ID":"20240613130441-angdyzg","Type":"NodeParagraph","Properties":{"id":"20240613130441-angdyzg","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"皂荚：辛、咸、温、有小毒。"}]},{"ID":"20240613130441-iu4ug0o","Type":"NodeParagraph","Properties":{"id":"20240613130441-iu4ug0o","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"皂角子：辛、温、无毒。"}]},{"ID":"20240613130441-16i9bbo","Type":"NodeParagraph","Properties":{"id":"20240613130441-16i9bbo","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"皂角刺：辛、温、无毒。"}]},{"ID":"20240613130441-zi7wpzw","Type":"NodeParagraph","Properties":{"id":"20240613130441-zi7wpzw","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"木皮、根皮：辛、温、无。"}]},{"ID":"20240613130441-j95knwl","Type":"NodeParagraph","Properties":{"id":"20240613130441-j95knwl","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613130441-t4fxok4","Type":"NodeParagraph","Properties":{"id":"20240613130441-t4fxok4","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"木皮、根皮：风热痰气，杀虫，产后肠脱。"}]},{"ID":"20240613130441-vndzxrv","Type":"NodeParagraph","Properties":{"id":"20240613130441-vndzxrv","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"皂角子："}]},{"ID":"20240613130441-r5mo2dg","Type":"NodeParagraph","Properties":{"id":"20240613130441-r5mo2dg","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"1、腰脚风痛、不能履地。用皂角子一千二百个，洗净，以、酥少许熬香，研为末，加蜜做成丸子，如梧子大。每服三十丸，空心服，以蒺藜子、酸仁汤送下。"}]},{"ID":"20240613130441-chwk6bb","Type":"NodeParagraph","Properties":{"id":"20240613130441-chwk6bb","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"2、大肠虚秘（时泻时秘）。治方同上，服至百丸，以通为度。"}]},{"ID":"20240613130441-otpxs5o","Type":"NodeParagraph","Properties":{"id":"20240613130441-otpxs5o","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"3、下痢不止。用皂角子瓦焙为末，加米糊和成丸子，如梧子大。每服四、五十丸，陈茶送下。"}]},{"ID":"20240613130441-h1973id","Type":"NodeParagraph","Properties":{"id":"20240613130441-h1973id","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"4、肠风下血。用皂角子、槐实各一两，加粘谷糠炒香，去糠，研为末，每服一钱，陈粟为汤送下。此方名“神效散”。"}]},{"ID":"20240613130441-g7lwwgt","Type":"NodeParagraph","Properties":{"id":"20240613130441-g7lwwgt","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"5、里急后重。用无蛀的皂角子（米糠炒过），加枳壳（炒过），等分为末，以饭和末成丸子，，如梧子大。每服三十丸，热汤送下。"}]},{"ID":"20240613130441-mxmhr6r","Type":"NodeParagraph","Properties":{"id":"20240613130441-mxmhr6r","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"6、小儿流涎（由于脾热有痰）。用皂角子仁半两、半夏（姜汤泡七次）王码电脑公司软件中心钱二分，共研为末，加姜汁调成丸子，如麻子大。每服五丸，温水送下。"}]},{"ID":"20240613130441-ixkl0ss","Type":"NodeParagraph","Properties":{"id":"20240613130441-ixkl0ss","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"7、妇女难产。吞皂角子二枚。"}]},{"ID":"20240613130441-j2b1xsv","Type":"NodeParagraph","Properties":{"id":"20240613130441-j2b1xsv","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"8、风虫牙痛。用皂角子研为末，棉裹末约弹子大两颗，醋煮热，交替熨患处。每且可熨三、五次。"}]},{"ID":"20240613130441-ukx6n9q","Type":"NodeParagraph","Properties":{"id":"20240613130441-ukx6n9q","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"9、一切疔肿："}]},{"ID":"20240613130441-bqifc56","Type":"NodeParagraph","Properties":{"id":"20240613130441-bqifc56","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（1）、中风口噤、涎潮上。用皂角一挺，去皮，以猪油涂炙成黄色，研为末，每服一钱，温酒调下。体壮者可服二钱，以吐出风涎为度。"}]},{"ID":"20240613130441-w69s8ar","Type":"NodeParagraph","Properties":{"id":"20240613130441-w69s8ar","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（2）、中风口。用皂角五两，去皮，为末，加陈年老醋调匀，左涂右侧，右涂左侧。药干再涂。"}]},{"ID":"20240613130441-x8q3jnl","Type":"NodeParagraph","Properties":{"id":"20240613130441-x8q3jnl","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（3）、中暑不省。用皂荚一两（烧存性）、甘草一两（微炒为末），以温水调一钱灌下。"}]},{"ID":"20240613130441-bqff9ye","Type":"NodeParagraph","Properties":{"id":"20240613130441-bqff9ye","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（4）、喉痹封口。用皂荚生研为末，取少许点患处，同时以醋调药厚涂项下。不久，病处裂破出血即愈。"}]},{"ID":"20240613130441-wbcffkp","Type":"NodeParagraph","Properties":{"id":"20240613130441-wbcffkp","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（5）、咽喉肿痛。用皂荚一挺，去皮，米醋浸、炙七次，勿令过焦，研为末。每次少放入咽，吐涎则痛止，病渐愈。"}]},{"ID":"20240613130441-iadhql8","Type":"NodeParagraph","Properties":{"id":"20240613130441-iadhql8","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（6）、风邪疾。用皂荚（烧存性）四两，苍耳根、茎、叶（日干）四两，密陀僧一两，共研为末，做成丸子，如梧子大，以朱砂为衣。每服三、四十丸，枣汤送下。一天服二次，病稍减，只服二十丸。此方名“抵住丸”。"}]},{"ID":"20240613130441-hrka4ha","Type":"NodeParagraph","Properties":{"id":"20240613130441-hrka4ha","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（7）、咳逆上气、唾浊，不能睡卧。用皂荚（炙，去皮、子）研为末，加蜜做成丸子，如梧子大。每服一丸，枣膏汤送下。白天服三次，夜间服一次。"}]},{"ID":"20240613130441-007l4vj","Type":"NodeParagraph","Properties":{"id":"20240613130441-007l4vj","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（8）、痰喘咳嗽。用长皂荚三长（去皮、子），一荚中装半夏十粒，一荚中装中巴豆，蜜制关夏。再一起火炙成黄色，研为末。每用二、三分，于临卧时以姜汁调服。用特效。"}]},{"ID":"20240613130441-sahbqbk","Type":"NodeParagraph","Properties":{"id":"20240613130441-sahbqbk","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（9）、牙病喘息、喉中有声。用肥皂荚两挺，酥炙取肉，研为末，加蜜做成丸子，如豆大。每服一丸，以微泻为度，不泻再服药。一天服一次。"}]},{"ID":"20240613130441-itlzt5j","Type":"NodeParagraph","Properties":{"id":"20240613130441-itlzt5j","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（10）、腹部肿痛。用皂荚（去皮、子）炙黄为末，加酒一斗，煮开以后饮服。一天服三次。"}]},{"ID":"20240613130441-ai4a4gm","Type":"NodeParagraph","Properties":{"id":"20240613130441-ai4a4gm","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（11）、二便不通用皂荚烧过，研为末，稀饭送服三钱，立通。又方：用皂荚炙过，去皮、子，研为末，加酒、面糊成丸子。每服五十丸。酒送下。又方；用皂荚烧出烟，放在桶内人坐桶上受烟熏。亦有效。"}]},{"ID":"20240613130441-hj7bcgk","Type":"NodeParagraph","Properties":{"id":"20240613130441-hj7bcgk","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（12）、黄肿气喘。用无蛀的皂角，去皮、子，醋涂，炙焦为末，取一钱，加巴豆（去油膜）七枚，以淡醋研好墨和成丸子，如麻子大。每服三丸，饭后服，陈桔皮汤送下。一天服三次，隔二日增药一丸，以愈为度。"}]},{"ID":"20240613130441-w3zp22l","Type":"NodeParagraph","Properties":{"id":"20240613130441-w3zp22l","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（13）、身、面发肿。用皂荚去皮炙黄。锉取三升，放酒一斗中浸透后煮沸。每服一升，一天服三次。"}]},{"ID":"20240613130441-6bqzpnp","Type":"NodeParagraph","Properties":{"id":"20240613130441-6bqzpnp","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（14）、脚气肿痛。用皂角、赤小豆，共研为末，酒醋调匀贴患处。"}]},{"ID":"20240613130441-vzqp8n2","Type":"NodeParagraph","Properties":{"id":"20240613130441-vzqp8n2","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（15）、突然头痛。用皂角研末，吹入鼻中，令打喷嚏。"}]},{"ID":"20240613130441-fvxdpjk","Type":"NodeParagraph","Properties":{"id":"20240613130441-fvxdpjk","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（16）、风热牙痛。用皂角一挺，去子，装满盐，再加白矾少许，黄泥封固，火煅后研为末，每日擦牙。"}]},{"ID":"20240613130441-6ckm7j6","Type":"NodeParagraph","Properties":{"id":"20240613130441-6ckm7j6","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（17）、风虫牙痛。用皂荚研末涂齿上，有涎即吐去。又方：用皂荚、食盐，等分为末，每日擦牙。"}]},{"ID":"20240613130441-qd09j2z","Type":"NodeParagraph","Properties":{"id":"20240613130441-qd09j2z","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（18）、肠风下血。用长皂角五挺，去皮、子、酥炙三次，研为末，精羊肉十两，细切，捣烂，和皂角末为丸，如梧子大。每服二十丸，温水送下。"}]},{"ID":"20240613130441-vhe2o90","Type":"NodeParagraph","Properties":{"id":"20240613130441-vhe2o90","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（19）、脱肛。用无蛀的皂角五挺，捶碎，加水揉取汁浸患处，自收上。收后以热水烫腰肚上下，令皂角气行，好不再脱肛。另外还须用皂角去皮，酥乐为末，加枣肉和成丸子，米汤送服三十丸。"}]},{"ID":"20240613130441-2nym6xz","Type":"NodeParagraph","Properties":{"id":"20240613130441-2nym6xz","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（20）、肾囊偏痛。用皂角连皮研末，调水敷涂痛处。"}]},{"ID":"20240613130441-omvmwkg","Type":"NodeParagraph","Properties":{"id":"20240613130441-omvmwkg","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（21）、肛门肿痛。用皂角（炒焦）、水粉（炒），等分为末，热醋调匀，摊巾贴患处，频频以水潮润。又方：用皂角七片，煨黄，去皮，出火毒后研为末。每服五钱，空心服，温酒送下。"}]},{"ID":"20240613130441-bt68r2s","Type":"NodeParagraph","Properties":{"id":"20240613130441-bt68r2s","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（22）、妇女吹乳。用皂角去皮，蜜炙，研细，酒送服一钱。又方：“妇人吹奶法如何？皂角烧灰蛤粉和。热酒一杯调八字（按：一字等于分五厘），管教时刻笑呵呵。”"}]},{"ID":"20240613130441-diabfuy","Type":"NodeParagraph","Properties":{"id":"20240613130441-diabfuy","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（23）、丁肿恶疮。用皂角去皮，酥炙焦。研为末，加麝香、人粪各少许，调匀涂患处，几天后疮根拔出。"}]},{"ID":"20240613130441-oqjrhn8","Type":"NodeParagraph","Properties":{"id":"20240613130441-oqjrhn8","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（24）、小儿头疮。用皂角烧黑为末，剥去疮痂敷涂。几次即愈。"}]},{"ID":"20240613130441-ce87rdw","Type":"NodeParagraph","Properties":{"id":"20240613130441-ce87rdw","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（25）、足上风疮（甚痒）。用皂角炙热烙患处。"}]},{"ID":"20240613130441-g1jdqrh","Type":"NodeParagraph","Properties":{"id":"20240613130441-g1jdqrh","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（26）、大风癞。用找皂角二十条，炙过，去皮、子，以酒煎稠，滤过。冷后，加入雪糕做成丸子，如梧子大。每服五十丸，酒送下。"}]},{"ID":"20240613130441-uukg14c","Type":"NodeParagraph","Properties":{"id":"20240613130441-uukg14c","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（27）、积年疮疮。用皂角放猪肚内煮熟，去掉皂角，只吃猪肚。"}]},{"ID":"20240613130441-746g1rb","Type":"NodeParagraph","Properties":{"id":"20240613130441-746g1rb","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（28）、鱼骨鲠咽。用皂角研末，吹鼻取嚏。"}]},{"ID":"20240613130441-rcuad07","Type":"NodeParagraph","Properties":{"id":"20240613130441-rcuad07","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"（29）、肾风阴痒。用稻草烧皂角，烟熏十多次，痒即止。用皂角子仁研末敷涂，几日可愈。"}]},{"ID":"20240613130441-izrptns","Type":"NodeParagraph","Properties":{"id":"20240613130441-izrptns","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"10、年久瘰疬。用无蛀皂角子一百粒、米醋一升、硇砂二钱，同煮干，炒信酥。依疬子多少，每一疬子服一粒，细嚼后米汤送下。酒浸煮服亦可。体虚的病人不用硇砂。"}]},{"ID":"20240613130441-sfa8e4g","Type":"NodeParagraph","Properties":{"id":"20240613130441-sfa8e4g","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"皂角刺："}]},{"ID":"20240613130441-5zj3jmk","Type":"NodeParagraph","Properties":{"id":"20240613130441-5zj3jmk","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"1、小便淋闭。用皂角刺（烧存性）、破故纸，等分为末，酒送服适量。"}]},{"ID":"20240613130441-wxpza4q","Type":"NodeParagraph","Properties":{"id":"20240613130441-wxpza4q","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"2、肠风下血。用皂角刺灰二两，胡桃仁、胡故纸（炒）、槐花（炒）各一两，共研为末。每服一钱，米汤送下。"}]},{"ID":"20240613130441-by4j1qj","Type":"NodeParagraph","Properties":{"id":"20240613130441-by4j1qj","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"3、伤风下痢（伤风久不愈，下痢脓血一天数十次）。用皂角刺、枳实（麸炒）、槐花（生用）各半两，共研为末，加炼蜜做丸子，如梧子大。每服三十丸，米汤送下。王码电脑公司软件中心天服二次。"}]},{"ID":"20240613130441-9alzm39","Type":"NodeParagraph","Properties":{"id":"20240613130441-9alzm39","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"4、胎衣不下。用皂角刺烧为灰，酒送服三钱，另嚼葵子三、五粒，以患处如针刺为见效。"}]},{"ID":"20240613130441-zrrmv3s","Type":"NodeParagraph","Properties":{"id":"20240613130441-zrrmv3s","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"5、乳痈。用皂角刺（烧存性）王码电脑公司软件中心两、蚌粉一钱，共研为末，每服一钱，温酒送下。"}]},{"ID":"20240613130441-3uscol4","Type":"NodeParagraph","Properties":{"id":"20240613130441-3uscol4","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"6、疮肿无头。用皂角刺烧灰，酒送服三钱，另嚼葵子三、五粒，以患处如针刺为见效。"}]},{"ID":"20240613130441-911dj6y","Type":"NodeParagraph","Properties":{"id":"20240613130441-911dj6y","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"7、大风疬疮。用黄蘖末、皂角刺灰各三钱，研匀，空心服，酒送下。服药后，吃粥两三天及补乞药数剂。如四肢浮肿，有针刺出水再服，忌一切鱼肉和引风之物。"}]},{"ID":"20240613130441-c7s8353","Type":"NodeParagraph","Properties":{"id":"20240613130441-c7s8353","updated":"20240613130441"},"Children":[{"Type":"NodeText","Data":"8、背疮不溃。用皂角刺（麦麸炒黄）王码电脑公司软件中心两、绵黄芪（焙）一两、甘草半两，共研为末。每服一钱，以酒一碗乳香去渣乘热送下。"}]},{"ID":"20240613130721-9x8rc8o","Type":"NodeThematicBreak","Properties":{"id":"20240613130721-9x8rc8o"}},{"ID":"20240613130722-9nqunq9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130722-9nqunq9","updated":"20240613130726"},"Children":[{"Type":"NodeText","Data":"皂荚（附：牙皂）《中药学》"}]},{"ID":"20240613130722-o92jwf1","Type":"NodeParagraph","Properties":{"id":"20240613130722-o92jwf1","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【药用】本品为豆科植物皂荚树的果实。"}]},{"ID":"20240613130722-60ktveg","Type":"NodeParagraph","Properties":{"id":"20240613130722-60ktveg","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温。有小毒。入肺、大肠经。"}]},{"ID":"20240613130722-vntki8p","Type":"NodeParagraph","Properties":{"id":"20240613130722-vntki8p","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【功效】袪痰、开窍。"}]},{"ID":"20240613130722-ke9kpgl","Type":"NodeParagraph","Properties":{"id":"20240613130722-ke9kpgl","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于寒湿壅滞、胸闷喘咳、痰多而咯吐不爽者。"}]},{"ID":"20240613130722-x8zvcgc","Type":"NodeParagraph","Properties":{"id":"20240613130722-x8zvcgc","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"皂荚有强烈的袪痰作用，治湿痰壅滞、咯吐不爽者，可单用本品焙干研末，用红枣煮汤调服；也可配合半夏、莱菔子等同用。"}]},{"ID":"20240613130722-5rqe6gf","Type":"NodeParagraph","Properties":{"id":"20240613130722-5rqe6gf","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"2.用于猝然昏迷，口噤不开，以及癫痫痰盛，关窍阻闭的病症。"}]},{"ID":"20240613130722-4wlguau","Type":"NodeParagraph","Properties":{"id":"20240613130722-4wlguau","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"皂荚辛散走窜，外用有通关开窍的功能。治猝然昏迷，口噤不开属于实闭之症者，可配合天南星、半夏、细辛、薄荷、雄黄等药研末，吹鼻取嚏，以促使苏醒。"}]},{"ID":"20240613130722-nmzm00o","Type":"NodeParagraph","Properties":{"id":"20240613130722-nmzm00o","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"此外，皂荚熬膏涂疮肿（未溃者），有退肿的功效。"}]},{"ID":"20240613130722-eeb600o","Type":"NodeParagraph","Properties":{"id":"20240613130722-eeb600o","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【处方用名】皂荚、皂角（洗净，晒干，去皮弦用）"}]},{"ID":"20240613130722-9tpf9fk","Type":"NodeParagraph","Properties":{"id":"20240613130722-9tpf9fk","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至二钱，煎服。焙焦研粉吞服每次二分至五分。内服剂量不宜过大，如服量过多，可引起呕吐及腹泻。本品辛散走窜，性及锐利，孕妇、体虚即有咯血倾向者均不宜用。"}]},{"ID":"20240613130722-5x68tky","Type":"NodeParagraph","Properties":{"id":"20240613130722-5x68tky","updated":"20240613130722"},"Children":[{"Type":"NodeText","Data":"【附药】牙皂：又叫猪牙皂。为豆科植物猪牙皂的果实。性味、功效、用量与皂荚相同。古代文献中往往将牙皂与皂荚列为一项，对其品质优劣各家说法不一，目前习惯认为猪牙皂质量较好，故常采用。"}]},{"ID":"20240613130407-mnsdmdj","Type":"NodeThematicBreak","Properties":{"id":"20240613130407-mnsdmdj"}},{"ID":"20240613130409-ixde2u0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130409-ixde2u0","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：皂荚"}]},{"ID":"20240613130409-icbjhtv","Type":"NodeParagraph","Properties":{"id":"20240613130409-icbjhtv","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613130409-5xtky00","Type":"NodeParagraph","Properties":{"id":"20240613130409-5xtky00","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" Zào Jiá"}]},{"ID":"20240613130409-uch0y4s","Type":"NodeParagraph","Properties":{"id":"20240613130409-uch0y4s","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613130409-zbb71q9","Type":"NodeParagraph","Properties":{"id":"20240613130409-zbb71q9","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 鸡栖子（《广志》），皂角（《肘后方》），大皂荚（《千金方》），长皂荚（《本草图经》），悬刀（《外丹本草》），长皂角（《仁斋直指方》），大皂角（《纲目》）。"}]},{"ID":"20240613130409-42q2ycu","Type":"NodeParagraph","Properties":{"id":"20240613130409-42q2ycu","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613130409-q90lkn3","Type":"NodeParagraph","Properties":{"id":"20240613130409-q90lkn3","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613130409-46dxsjn","Type":"NodeParagraph","Properties":{"id":"20240613130409-46dxsjn","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613130409-pz6fl27","Type":"NodeParagraph","Properties":{"id":"20240613130409-pz6fl27","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"皂荚"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。秋季果实成热时采摘，晒干。"}]},{"ID":"20240613130409-gpzd3a3","Type":"NodeParagraph","Properties":{"id":"20240613130409-gpzd3a3","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613130409-rjnn7q1","Type":"NodeParagraph","Properties":{"id":"20240613130409-rjnn7q1","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 生长于村边，路旁，向阳温暖的地方。全国大部分地区有分布。主产河北、山西、河南、山东。此外，东北地区及江苏、浙扛、湖北、广西、四川等地亦产。"}]},{"ID":"20240613130409-zpkqfhj","Type":"NodeParagraph","Properties":{"id":"20240613130409-zpkqfhj","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613130409-njvfcj2","Type":"NodeParagraph","Properties":{"id":"20240613130409-njvfcj2","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 落叶乔木，高达15米。棘刺粗壮，红褐色，常分枝。双数羽状复叶；小叶4～7对，小叶片卵形、卵状披针形或长椭圆状卵形，长3～8厘米，宽1～3.5厘米，先端钝，有时稍凸，基部斜圆形或斜楔形，边缘有细锯齿。花杂性，成腋生及顶生总状花序，花部均有细柔毛；花萼钟形，裂片4，卵状披针形；花瓣4，淡黄白色，卵形或长椭圆形；雄蕊8，4长4短；子房条形，扁平。荚果直而扁平，有光泽，紫黑色，被白色粉霜，长12～30厘米，直径2～4厘米。种子多数，扁平，长椭圆形，长约10毫米，红褐色，有光泽。花期5月。果期10月。"}]},{"ID":"20240613130409-66rozx6","Type":"NodeParagraph","Properties":{"id":"20240613130409-66rozx6","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"本植物的根皮（皂荚根皮）、叶（皂荚叶）、棘刺（皂角刺）、种子（皂荚子）以及由植株衰老或受伤害后所结的小型果实（猪牙皂）均供药用，各详专条。"}]},{"ID":"20240613130409-jm7q46w","Type":"NodeParagraph","Properties":{"id":"20240613130409-jm7q46w","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613130409-p1jsx4r","Type":"NodeParagraph","Properties":{"id":"20240613130409-p1jsx4r","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 干燥荚果呈长条形而扁，或稍弯曲，长15～25厘米，宽2～3.5厘米，厚0.8～1.4厘米。表面不平，红褐色或紫红色，被灰白色粉霜，擦去后有光泽。两端略尖，基部有短果柄或果柄断痕，背缝线突起成棱脊状。质坚硬，摇之有响声。剖开后呈浅黄色，内含多数种子。种子扁椭圆形，外皮黄棕色而光滑，质坚。气味辛辣，嗅其粉末则打喷嚏。以肥厚、饱满、质坚者为佳。"}]},{"ID":"20240613130409-2yw0f5k","Type":"NodeParagraph","Properties":{"id":"20240613130409-2yw0f5k","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613130409-l2oqvlj","Type":"NodeParagraph","Properties":{"id":"20240613130409-l2oqvlj","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 荚果含三萜皂甙、鞣质。此外，还含蜡醇、廿九烷、豆甾醇、谷甾醇等。"}]},{"ID":"20240613130409-da0bhr4","Type":"NodeParagraph","Properties":{"id":"20240613130409-da0bhr4","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"同属植物Gleditsia triacanthos L.的叶含大量生物碱三刺皂荚碱。"}]},{"ID":"20240613130409-e03etv1","Type":"NodeParagraph","Properties":{"id":"20240613130409-e03etv1","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613130409-31yvm1b","Type":"NodeParagraph","Properties":{"id":"20240613130409-31yvm1b","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" ①皂甙的一般特性"}]},{"ID":"20240613130409-3kwqzle","Type":"NodeParagraph","Properties":{"id":"20240613130409-3kwqzle","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"含皂甙的植物颇多，至少有50个不同科的400种植物含有之。它能降低表面张力。其溶液（1：10000）振摇时，则溶液中每个气泡的表面皆可被皂甙包围而形成一薄膜，故泡沫持久不灭。同样，遇油类物质亦可借皂甙薄膜而形成乳剂。它能改变细胞表面的通透性，而成为一般原浆毒。对胆甾醇有特别的亲和力，有很强的溶血作用（作用于血细胞表面的类脂质），胆甾醇可对抗其溶血作用。对鱼类的毒性很强，高等动物对它一般很少吸收，故主要为对局部粘膜的刺激作用，使分泌增加等。但如服用剂量过大或胃肠粘膜有损伤或注射给药，均可产生全身毒性，血细胞溶解；特别是影响中枢神经系统，先痉挛，后麻痹，呼吸中枢麻痹即导致死亡。国内曾报告有服皂荚煎剂（200克加老醋1杯）中毒死亡者。大量皂荚中所含之皂甙不仅刺激胃肠粘膜，10分钟后即呕吐，以后有腹泻；而且腐蚀胃粘膜，发生吸收中毒。"}]},{"ID":"20240613130409-fif7gcv","Type":"NodeParagraph","Properties":{"id":"20240613130409-fif7gcv","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"②祛痰作用"}]},{"ID":"20240613130409-5xwl0qz","Type":"NodeParagraph","Properties":{"id":"20240613130409-5xwl0qz","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"含皂甙类的药物，能刺激胃粘膜而反射性的促进呼吸道粘液的分泌，产生祛痰作用（恶心性祛痰药）。在猫身上，皂荚确能使呼吸道分泌增加，但较桔梗、前胡为差，持续时间较短"}]},{"ID":"20240613130409-ue2eqzy","Type":"NodeParagraph","Properties":{"id":"20240613130409-ue2eqzy","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240613130409-y3hv273","Type":"NodeParagraph","Properties":{"id":"20240613130409-y3hv273","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"在试管中，皂荚对某些革兰氏阴性肠内致病菌有抑制作用。其水浸剂（1：3）在试管中对某些皮肤真菌也有抑制作用。"}]},{"ID":"20240613130409-18fr8q3","Type":"NodeParagraph","Properties":{"id":"20240613130409-18fr8q3","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"美国皂角中所含之三刺皂荚碱有罂粟碱样作用，可治疗高血压病、支气管哮喘、消化性溃疡及慢性胆囊炎等。"}]},{"ID":"20240613130409-i4txcnk","Type":"NodeParagraph","Properties":{"id":"20240613130409-i4txcnk","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613130409-m11levh","Type":"NodeParagraph","Properties":{"id":"20240613130409-m11levh","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，洗净，晒干。用时捣碎。"}]},{"ID":"20240613130409-aefyr9k","Type":"NodeParagraph","Properties":{"id":"20240613130409-aefyr9k","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613130409-mal52pq","Type":"NodeParagraph","Properties":{"id":"20240613130409-mal52pq","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 辛，温，微毒。"}]},{"ID":"20240613130409-af84oh9","Type":"NodeParagraph","Properties":{"id":"20240613130409-af84oh9","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613130409-15lcbjk","Type":"NodeParagraph","Properties":{"id":"20240613130409-15lcbjk","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240613130409-bs0vy5y","Type":"NodeParagraph","Properties":{"id":"20240613130409-bs0vy5y","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613130409-6hwbr19","Type":"NodeParagraph","Properties":{"id":"20240613130409-6hwbr19","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 祛风痰，除湿毒，杀虫。治中风口眼歪斜，头风头痛，咳嗽痰喘，肠风便血，下痢噤口，痈肿便毒，疮癣疥癞。"}]},{"ID":"20240613130409-3upee6u","Type":"NodeParagraph","Properties":{"id":"20240613130409-3upee6u","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"《本草图经》：\"疏风气。\""}]},{"ID":"20240613130409-xw4mv5s","Type":"NodeParagraph","Properties":{"id":"20240613130409-xw4mv5s","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613130409-pk7w6ti","Type":"NodeParagraph","Properties":{"id":"20240613130409-pk7w6ti","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 内服：研末或入丸剂，3～5分。外用：煎汤洗、捣烂或烧存性研末敷。"}]},{"ID":"20240613130409-1o6td9b","Type":"NodeParagraph","Properties":{"id":"20240613130409-1o6td9b","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613130409-255zc9k","Type":"NodeParagraph","Properties":{"id":"20240613130409-255zc9k","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" ①治卒中风口歪：大皂荚一两（去皮、子，研末下筛）。以三年大酢和，左歪涂右，右歪涂左，干更涂之。（《千金方》）"}]},{"ID":"20240613130409-gm3zg4l","Type":"NodeParagraph","Properties":{"id":"20240613130409-gm3zg4l","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"②治头风头痛，暴发欲死：长皂荚一挺（去皮、弦、于）。切碎，蜜水拌微炒，研为极细末。每用一、二厘吹入鼻内，取嚏；再用一分，以当归川芎各一钱，煎汤调下。（《余居士选奇方》）"}]},{"ID":"20240613130409-ngha9jj","Type":"NodeParagraph","Properties":{"id":"20240613130409-ngha9jj","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"③治痰喘咳嗽：长皂荚三条（去皮、子），一荚入巴豆十粒，一荚入半夏十粒，一荚入杏仁十粒，用姜汁制杏仁，麻油制巴豆，蜜制半夏，一处火炙黄色，为末。每用一字，临卧以姜汁调下。（《余居士选奇方》）"}]},{"ID":"20240613130409-wv1ooo1","Type":"NodeParagraph","Properties":{"id":"20240613130409-wv1ooo1","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"④治大肠风毒，泻血不止：皂荚（长一尺二寸者）五挺（去黑皮，涂酥三两，炙尽为度），白羊精肉十两。上药，先捣皂荚为末，后与肉同捣令熟，丸如梧桐子大。每于食前以温水下二十丸。（《圣惠方》）"}]},{"ID":"20240613130409-fo6ah9o","Type":"NodeParagraph","Properties":{"id":"20240613130409-fo6ah9o","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"⑤治便毒痈疽：皂角（用尺以上者）一条，法醋煮烂，研成膏，敷之。（《仁斋直指方》）"}]},{"ID":"20240613130409-doxo58p","Type":"NodeParagraph","Properties":{"id":"20240613130409-doxo58p","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"⑥治大风诸癞：长皂角二十条。炙，去皮子，以酒煎稠，滤去渣，候冷，入雪糕，丸如梧子大。每酒下五十丸。（《仁斋直指方》皂角丸）"}]},{"ID":"20240613130409-lm3eowo","Type":"NodeParagraph","Properties":{"id":"20240613130409-lm3eowo","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"⑦治风癣疥癞或皮肤麻木，死肌，风痹顽皮等证：大皂荚二十条（去皮、子、弦）。切碎，水十五碗，熬成稠膏。每日用少许搽患处；再以十茶匙枸杞子汤调服。（《马敬思自得录方》）"}]},{"ID":"20240613130409-as0im2j","Type":"NodeParagraph","Properties":{"id":"20240613130409-as0im2j","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613130409-wsqwfly","Type":"NodeParagraph","Properties":{"id":"20240613130409-wsqwfly","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" ①治疗蛔虫性肠梗阻"}]},{"ID":"20240613130409-b63su6c","Type":"NodeParagraph","Properties":{"id":"20240613130409-b63su6c","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"取皂角1～3钱，研极细末和蜂蜜混合，加开水适量，频频口服（呕吐也坚持服），于1～2小时服完。同时配合肌注冬眠灵、阿托品、爱茂尔，针刺足三里、内关、天枢等。服药后以手轻柔腹部，于8～12小时后再以甘油20～30毫升，或10～20％氯化钠500～800毫升（以上药量小儿酌减）灌肠。治疗中需禁食，直至梗阻缓解为止；如呕吐重，禁食时间长，有水、电解质子衡紊乱者须予纠正。待有梗阻缓解征象（腹部包块、腹胀、阵发性腹痛、呕吐消失，排便排气）时即给予驱蛔剂。共观察40余例，皆于12～24小时之内梗阻解除。有的未及灌肠即自行排下棕红色粪便，有的混有蛔虫；大多数灌肠后排下粪便或蛔虫。蛔虫排出少者30余条，多者130余条。"}]},{"ID":"20240613130409-ue1n9qv","Type":"NodeParagraph","Properties":{"id":"20240613130409-ue1n9qv","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"②治疗耵聍栓塞"}]},{"ID":"20240613130409-w7ej1ht","Type":"NodeParagraph","Properties":{"id":"20240613130409-w7ej1ht","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"取皂荚1两，掰成1寸长的小段，加水4000毫升，文火煎取2000毫升，过滤，加防腐剂。用于滴耳，每次2～3滴。治疗500余例，快者可使耵聍在2～3小时内软化，当天能够冲洗；最慢者3～4天亦可软化溶解。"}]},{"ID":"20240613130409-97parzf","Type":"NodeParagraph","Properties":{"id":"20240613130409-97parzf","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"此外，皂荚粉与女贞子、千里光等配制成片剂，可用于治疗慢性气管炎。"}]},{"ID":"20240613130409-0d1dhbz","Type":"NodeParagraph","Properties":{"id":"20240613130409-0d1dhbz","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613130409-53rixqc","Type":"NodeParagraph","Properties":{"id":"20240613130409-53rixqc","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613130409-vhsp7hz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613130409-vhsp7hz","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"《中华本草》：皂荚"}]},{"ID":"20240613130409-vk5okzj","Type":"NodeParagraph","Properties":{"id":"20240613130409-vk5okzj","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613130409-sjffnf2","Type":"NodeParagraph","Properties":{"id":"20240613130409-sjffnf2","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" Zào Jiá"}]},{"ID":"20240613130409-bujp7py","Type":"NodeParagraph","Properties":{"id":"20240613130409-bujp7py","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613130409-xq3j40t","Type":"NodeParagraph","Properties":{"id":"20240613130409-xq3j40t","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 鸡栖子、皂角、大皂荚、长皂荚、悬刀、长皂角、大皂角、乌犀。"}]},{"ID":"20240613130409-uc1sr0e","Type":"NodeParagraph","Properties":{"id":"20240613130409-uc1sr0e","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613130409-7vfwm02","Type":"NodeParagraph","Properties":{"id":"20240613130409-7vfwm02","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" Chinese Honeylocust Fruit"}]},{"ID":"20240613130409-smxco5y","Type":"NodeParagraph","Properties":{"id":"20240613130409-smxco5y","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613130409-kt0efvh","Type":"NodeParagraph","Properties":{"id":"20240613130409-kt0efvh","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613130409-31m7l98","Type":"NodeParagraph","Properties":{"id":"20240613130409-31m7l98","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：皂荚，生雍州川谷及鲁邹县。如猪牙者良，九月、十月采荚，阴干。"}]},{"ID":"20240613130409-hgcri8x","Type":"NodeParagraph","Properties":{"id":"20240613130409-hgcri8x","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：皂荚，有三种，猪牙皂荚最下，其形曲戾薄恶，全无滋润，洗垢亦不去。其尺二寸者，粗大长虚无润也。若长六、七寸，圆厚节促直者，皮薄多肉味浓，大好也。"}]},{"ID":"20240613130409-su37g75","Type":"NodeParagraph","Properties":{"id":"20240613130409-su37g75","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：皂荚，今所在有之，以怀孟州者为胜。木极有高大者。此有三种，医家作疏风气丸煎，多用长皂荚；治齿及取积药，"}]},{"ID":"20240613130409-fahjud3","Type":"NodeParagraph","Properties":{"id":"20240613130409-fahjud3","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613130409-4hkpbm1","Type":"NodeParagraph","Properties":{"id":"20240613130409-4hkpbm1","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物皂荚的果实或不育果实。前者称皂荚，后者称猪牙皂。"}]},{"ID":"20240613130409-cwa5v7j","Type":"NodeParagraph","Properties":{"id":"20240613130409-cwa5v7j","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Gleditsia sinensis Lam.[G.horrida Willd.]"}]},{"ID":"20240613130409-zgwf36i","Type":"NodeParagraph","Properties":{"id":"20240613130409-zgwf36i","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培5-6年后即结果，秋季果实成熟变黑时采摘，晒干。"}]},{"ID":"20240613130409-lxin727","Type":"NodeParagraph","Properties":{"id":"20240613130409-lxin727","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613130409-b3rp3gc","Type":"NodeParagraph","Properties":{"id":"20240613130409-b3rp3gc","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于路边、沟旁、住宅附近。"}]},{"ID":"20240613130409-g0mj1zo","Type":"NodeParagraph","Properties":{"id":"20240613130409-g0mj1zo","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东、华南以及四川、贵州等地。"}]},{"ID":"20240613130409-iermp56","Type":"NodeParagraph","Properties":{"id":"20240613130409-iermp56","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613130409-leagr1h","Type":"NodeParagraph","Properties":{"id":"20240613130409-leagr1h","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 皂荚 乔木，高达15cm。刺粗壮，通常分枝，长可达16cm，圆柱形。小枝无毛。一回偶数羽状复叶，长12-18cm；小叶6-14片，长卵形、长椭圆形至卵状披针形，长3-8cm，宽1.5-3.5cm，先端钝或渐尖，基部斜圆形或斜楔形，边缘有细锯齿，无毛。花杂性，排成腋生的总状花序；花萼钟状，有4枚披针形裂片；花瓣4，白色；雄蕊6-8；子房条形，沿缝线有毛。荚果条形，不扭转，长12-30，宽2-4cm，微厚，黑棕色，被白色粉霜。花期4-5月，果期9-10月。"}]},{"ID":"20240613130409-n9zrr3t","Type":"NodeParagraph","Properties":{"id":"20240613130409-n9zrr3t","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613130409-6u2fr02","Type":"NodeParagraph","Properties":{"id":"20240613130409-6u2fr02","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖向阳的地区，对土壤要求不严，只要排水良好即可，山区、平坝、边角隙地均可栽培。"}]},{"ID":"20240613130409-57dgl9p","Type":"NodeParagraph","Properties":{"id":"20240613130409-57dgl9p","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖：10月采下果实，取出种子，随即播种；若春播，需将种子在水里泡胀后，再行播种。育苗时，开1.3m宽的高畦，撒施一层腐熟堆肥作为基肥，然后按行距33cm，开深约6-10cm的横沟，把种子每隔4-6cm播粒，播后施人畜粪水，并盖草木灰，最后盖土与畦面齐平。如遇天旱，要经常浇水。苗出齐后，要浅薅，并施人畜粪水，以后再中除、追肥1-2次。第2年再行1-2次中除、追肥等管理，到秋后即可移栽。移栽可按株距7-10m开穴，栽前把幼苗挖起，稍加修剪，每穴栽苗1株，盖土压实，最后再覆松土，使稍高于地面，浇水定根。"}]},{"ID":"20240613130409-53p19e3","Type":"NodeParagraph","Properties":{"id":"20240613130409-53p19e3","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"田间管理 栽后3-4年，每年要在穴边松土除草，并施草木灰或渣滓肥，促使迅速生长。"}]},{"ID":"20240613130409-e1viehs","Type":"NodeParagraph","Properties":{"id":"20240613130409-e1viehs","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613130409-kdys1nw","Type":"NodeParagraph","Properties":{"id":"20240613130409-kdys1nw","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （l）皂荚 果实呈扁长的剑鞘状而略弯曲．长15-20cm，宽2-3.5cm，厚0.8-1.5cm，表面深紫棕色至黑棕色，被灰色粉霜，种子所在处隆起，基部渐狭而略弯，有短果柄或果柄痕。两侧有明显的纵棱线，摇之有响声，质硬，剖开后，果皮断面黄色，纤维性。种子多数，扁椭圆形，黄棕色，光滑。气特异，有强烈刺激性，粉末嗅之有催嚏性，味辛辣。以肥厚、色紫褐者为佳。"}]},{"ID":"20240613130409-98i26wx","Type":"NodeParagraph","Properties":{"id":"20240613130409-98i26wx","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"（2）猪牙皂 果实国柱形，略扁，弯曲作镰刀状，长4-12cm，直径0.5-1.2cm。表面紫棕色或紫黑色，被灰白色蜡质粉霜，擦去后有光泽，并有细小疣状突起及线状或网状裂纹，先端有鸟喙状花柱残基，基部具果梗痕。质硬脆，断面棕黄色，外果皮革质，中果皮纤维性，内果皮粉性，中间疏松，有灰绿色或淡棕黄色丝状物。纵向剖开可见整齐的凹窝，偶有发育不全的种子．气微、有刺激性，味微苦、辛，粉末有催嚏性。以个小、饱满、色紫黑、有光泽、肉多而粘、断面淡绿色者为佳。"}]},{"ID":"20240613130409-t5bafcg","Type":"NodeParagraph","Properties":{"id":"20240613130409-t5bafcg","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"显微鉴别 猪牙皂果实（中部）横切面：外果皮1列细胞，类方形，排列紧密，外具角质层。中果皮外侧有石细胞组成的断续环带，维管束常斜向排列，纤维束多位于维管束内侧或外侧，草酸钙棱晶常见于石细胞群及维管束旁的薄壁细胞中，并有少数草酸钙簇晶；中果皮内侧有厚壁性孔纹细胞1至数列，类方形或长方形，其内外侧常伴有少量纤维束。内果皮厚，白色，由径向延长的薄壁细胞组成，并可见少数草酸钙小簇晶。"}]},{"ID":"20240613130409-lii7jhn","Type":"NodeParagraph","Properties":{"id":"20240613130409-lii7jhn","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613130409-9u3as9o","Type":"NodeParagraph","Properties":{"id":"20240613130409-9u3as9o","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 对鱼类的毒性很强，高等动物对它一般很少吸收，故主要为对局部粘膜的刺激作用，使分泌增加等。但如服用剂量过大或胃肠粘膜有损伤或注射给药，均可产生全身毒性，血细胞溶解；特别是影响中枢神经系统，先痉挛，后麻痹，呼吸中枢麻痹即导致死亡。国内曾报告有服皂荚煎剂（200g加老醋1杯）中毒死亡者。大量皂荚中所含之皂甙不仅刺激胃肠粘膜，10分钟后即呕吐，以后有腹泻；而且腐蚀胃粘膜，发生吸收中毒。"}]},{"ID":"20240613130409-x7tpmod","Type":"NodeParagraph","Properties":{"id":"20240613130409-x7tpmod","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613130409-q27xral","Type":"NodeParagraph","Properties":{"id":"20240613130409-q27xral","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 荚果含三萜皂式：皂荚甙（gledinin），甙甙元为皂荚甙元（gledigenin），皂荚皂甙（gleditschia saponin）。尚含蜡酸（ced alcohol），二十九烷（nonacosane），正二十七烷（hepta-cosane），豆甾醇（stigmasterol），谷甾醇（sitosterol），鞣质（tannin）等。"}]},{"ID":"20240613130409-erbd0ee","Type":"NodeParagraph","Properties":{"id":"20240613130409-erbd0ee","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613130409-wn97amj","Type":"NodeParagraph","Properties":{"id":"20240613130409-wn97amj","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 1.皂甙的一般特性：含皂甙的植物颇多，至少有50个不同科的400种植物含有之。它能降低表面张力。其溶液（1：10000）振摇时，则溶液中每个气泡的表面皆可被皂甙包围而形成一薄膜，故泡沫持久不灭。同样，遇油类物质亦可借皂甙薄膜而形成乳剂。它能改变细胞表面的通透件，而成为一般原浆毒。对胆甾醇有特别的亲和力，有很强的溶血作用（作用于血细胞表面的类脂质），胆甾醇可对抗其溶血作用。"}]},{"ID":"20240613130409-fy3qshv","Type":"NodeParagraph","Properties":{"id":"20240613130409-fy3qshv","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"2.祛痰作用：含皂甙类的药物，能刺激胃粘膜而反射性的促进呼吸道粘液的分泌，产生祛痰作用（恶心性祛痰药）。在猫身上，皂荚确能使呼吸道分泌增加，但较桔梗、前胡为差，持续时间较短。"}]},{"ID":"20240613130409-wytk95x","Type":"NodeParagraph","Properties":{"id":"20240613130409-wytk95x","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"3.抗菌作用：在试管中，皂荚对某些革兰氏阴性肠内致病菌有抑制作用。其水浸剂（1：3）在试管中对某些皮肤真菌也有抑制作用。美国皂角中所含之三刺皂荚碱（Triacanthin）有罂粟碱样作用，可治疗高血压病、支气管哮喘、消化性溃疡及慢性胆囊炎等。煎剂1g/kg给猫灌胃，能增加呼吸道粘液分泌，有祛痰作用。0.25%煎剂对离体大鼠子宫有兴奋作用。1：3水浸剂对堇色毛癣菌、星形奴卡菌有抑制作用。"}]},{"ID":"20240613130409-iq99hl8","Type":"NodeParagraph","Properties":{"id":"20240613130409-iq99hl8","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613130409-lbg1hns","Type":"NodeParagraph","Properties":{"id":"20240613130409-lbg1hns","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，洗净，晒干。用时捣碎。"}]},{"ID":"20240613130409-1922hbb","Type":"NodeParagraph","Properties":{"id":"20240613130409-1922hbb","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613130409-zoodde9","Type":"NodeParagraph","Properties":{"id":"20240613130409-zoodde9","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （l）取本品粉末0.5g，加乙醇5ml，煮沸2-3min，放冷，滤过，取滤液0.5ml，置小瓷血中，蒸干，放冷，加醋酐3滴，搅匀，加硫酸2滴，浙呈红紫色。（检查三萜类皂甙）（2）取生理盐水稀释的2％新鲜兔血1ml，沿管壁加入本品生理盐水浸液（l：0.1g）若干，迅速发生溶血现象。（检查皂甙）（3）薄层色谱 取本品粗粉1g，加甲醇30ml，加热回流6h，滤过，滤液蒸干，残渣溶于20ml水中，用乙醚提取2-3次，回收醚液，水层再用饱和的正丁醇提取3次，合并正丁醇提取液，减压浓缩至干，残渣用少量甲醇溶解，作供试液，以皂甙C（GSaC）作对照品。分别点样于同一硅胶G薄层板，以正丁醇-乙醇一氟水（10：2：5）展开，用20％磷银酸乙醇液喷雾后，于120℃烘烤10min，供试液色谱中在与对照品色谱的相应位置上显相同的深蓝色斑点。"}]},{"ID":"20240613130409-5prolmy","Type":"NodeParagraph","Properties":{"id":"20240613130409-5prolmy","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613130409-0ed6g6o","Type":"NodeParagraph","Properties":{"id":"20240613130409-0ed6g6o","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 肺；大肠经"}]},{"ID":"20240613130409-r4hgvqp","Type":"NodeParagraph","Properties":{"id":"20240613130409-r4hgvqp","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613130409-4tmf0eo","Type":"NodeParagraph","Properties":{"id":"20240613130409-4tmf0eo","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 辛；咸；温；有毒"}]},{"ID":"20240613130409-t0ylfwf","Type":"NodeParagraph","Properties":{"id":"20240613130409-t0ylfwf","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613130409-a1m0lea","Type":"NodeParagraph","Properties":{"id":"20240613130409-a1m0lea","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240613130409-hqvb1r9","Type":"NodeParagraph","Properties":{"id":"20240613130409-hqvb1r9","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613130409-tjph32x","Type":"NodeParagraph","Properties":{"id":"20240613130409-tjph32x","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 祛痰止咳；开窍通闭；杀虫散结。主痰咳喘满；中风口噤；痰涎壅盛；神昏不语；癫痫；喉痹；二便不通；痈肿疥癣"}]},{"ID":"20240613130409-kmyn90q","Type":"NodeParagraph","Properties":{"id":"20240613130409-kmyn90q","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613130409-nq5zpb6","Type":"NodeParagraph","Properties":{"id":"20240613130409-nq5zpb6","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 内服：1-3g，多入丸、散。外用：适量，研末搐鼻；或煎水洗；或研末掺或调敷；或熬膏涂；或烧烟熏。"}]},{"ID":"20240613130409-ms405hu","Type":"NodeParagraph","Properties":{"id":"20240613130409-ms405hu","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613130409-e2kr3g8","Type":"NodeParagraph","Properties":{"id":"20240613130409-e2kr3g8","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 1.《本经逢原》：按大小二皂，所治稍有不同，用治风痰，牙皂最胜，若治湿痰，大皂力优。"}]},{"ID":"20240613130409-hi2cw1t","Type":"NodeParagraph","Properties":{"id":"20240613130409-hi2cw1t","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：疏风气。"}]},{"ID":"20240613130409-mdlr8rr","Type":"NodeParagraph","Properties":{"id":"20240613130409-mdlr8rr","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613130409-qbpqteb","Type":"NodeParagraph","Properties":{"id":"20240613130409-qbpqteb","updated":"20240613130409"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613130410-eqng7kg","Type":"NodeThematicBreak","Properties":{"id":"20240613130410-eqng7kg"}},{"ID":"20240613130413-nkxm72f","Type":"NodeParagraph","Properties":{"id":"20240613130413-nkxm72f"}}]}