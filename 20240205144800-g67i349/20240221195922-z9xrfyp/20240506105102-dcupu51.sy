{"ID":"20240506105102-dcupu51","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506105102-dcupu51","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506105102-dcupu51\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506105102-q3pqjhn\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613144751-5rnutev\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240613145712-i82v6r2\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"326鼠李","type":"doc","updated":"20240827111740"},"Children":[{"ID":"20240827111724-isw53y0","Type":"NodeParagraph","Properties":{"id":"20240827111724-isw53y0","updated":"20240827111724"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 757px;","style":"width: 747px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李 7-20240827111724-z9m7pyv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 747px;\" parent-style=\"width: 757px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 342px;","style":"width: 332px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李 2-20240827111043-g2sqa5q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 332px;\" parent-style=\"width: 342px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827110648-cmgkzq4","Type":"NodeParagraph","Properties":{"id":"20240827110648-cmgkzq4","updated":"20240827110913"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"p