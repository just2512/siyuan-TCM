parent-style=\"width: 569px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240702162836-le67sm8","Type":"NodeParagraph","Properties":{"id":"20240702162836-le67sm8","updated":"20240827111215"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李 4-20240827111215-3h4mcu1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 540px;","style":"width: 530px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702161758-janawk0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 530px;\" parent-style=\"width: 540px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827110332-trqf6dn","Type":"NodeParagraph","Properties":{"id":"20240827110332-trqf6dn","updated":"20240827110342"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 323px;","style":"width: 313px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李-20240827110332-hl58hmq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 313px;\" parent-style=\"width: 323px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李4-20240702162046-m3ted3b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827111120-mkn1bet","Type":"NodeParagraph","Properties":{"id":"20240827111120-mkn1bet","updated":"20240827111124"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 584px;","style":"width: 574px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李 3-20240827111120-gwaayfp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 574px;\" parent-style=\"width: 584px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 584px;","style":"width: 574px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李1-20240702161826-mphwpxk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 574px;\" parent-style=\"width: 584px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702162523-5084hgr","Type":"NodeParagraph","Properties":{"id":"20240702162523-5084hgr","updated":"20240702162705"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 511px;","style":"width: 501px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠李9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠李9-20240702162705-84bwpa3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 501px;\" parent-style=\"width: 511px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702162523-hmwzupr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827111133-zr87gni","Type":"NodeParagraph","Properties":{"id":"20240827111133-zr87gni","updated":"20240827111138"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图未按品种分类；"}]},{"ID":"20240613145711-gzic7g4","Type":"NodeThematicBreak","Properties":{"id":"20240613145711-gzic7g4"}},{"ID":"20240613145712-i82v6r2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145712-i82v6r2","updated":"20240613145717"},"Children":[{"Type":"NodeText","Data":"鼠李《神农本草经》"}]},{"ID":"20240613145712-2z17go6","Type":"NodeParagraph","Properties":{"id":"20240613145712-2z17go6","updated":"20240613145712"},"Children":[{"Type":"NodeText","Data":"主寒热瘰疬创。生田野。"}]},{"ID":"20240613145712-un9krt2","Type":"NodeParagraph","Properties":{"id":"20240613145712-un9krt2","updated":"20240613145712"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：鼠李，一名牛李（《御览》）。"}]},{"ID":"20240613145712-ml7ha8q","Type":"NodeParagraph","Properties":{"id":"20240613145712-ml7ha8q","updated":"20240613145712"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名牛李，一名鼠梓，一名啤，采无时。"}]},{"ID":"20240613145712-6q271x9","Type":"NodeParagraph","Properties":{"id":"20240613145712-6q271x9","updated":"20240613145712"},"Children":[{"Type":"NodeText","Data":"案《说文》云：楰，鼠梓木。《尔雅》云楰，鼠梓。郭璞云：楸属也，今江东有虎梓。《毛诗》云：北山有楰.《传》云楰，鼠梓，据《名医》名鼠梓，未知是此否。《唐本》注云：一名赵李，一名皂李，一名乌槎。"}]},{"ID":"20240613144747-7dkeqpu","Type":"NodeThematicBreak","Properties":{"id":"20240613144747-7dkeqpu"}},{"ID":"20240613145607-w3z2vcn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145607-w3z2vcn","updated":"20240613145611"},"Children":[{"Type":"NodeText","Data":"鼠李《本草衍义》"}]},{"ID":"20240613145607-l5p1yi1","Type":"NodeParagraph","Properties":{"id":"20240613145607-l5p1yi1","updated":"20240613145607"},"Children":[{"Type":"NodeText","Data":"即牛李子也。木高七八尺，叶如李，但狭而不泽。子于条上四边生，熟则紫黑色，生则青。叶至秋则落，子尚在枝，是处皆有，故经不言所出处，今关陕及湖南、江南北甚多，木皮与子两用。"}]},{"ID":"20240613144747-bzorvs5","Type":"NodeThematicBreak","Properties":{"id":"20240613144747-bzorvs5"}},{"ID":"20240613145547-n1emjze","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145547-n1emjze","updated":"20240613145558"},"Children":[{"Type":"NodeText","Data":"鼠李《本经逢原》"}]},{"ID":"20240613145547-z3klof4","Type":"NodeParagraph","Properties":{"id":"20240613145547-z3klof4","updated":"20240613145547"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当作楮李子，一名牛李子，熬汁可以染绿，今造纸，马铺取汁刷印绿色，故又名"}]},{"ID":"20240613145547-w8k631b","Type":"NodeParagraph","Properties":{"id":"20240613145547-w8k631b","updated":"20240613145547"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"绿子"}]},{"ID":"20240613145547-h9jbhvr","Type":"NodeParagraph","Properties":{"id":"20240613145547-h9jbhvr","updated":"20240613145547"},"Children":[{"Type":"NodeText","Data":"苦凉微毒。"}]},{"ID":"20240613145547-8mlgtnu","Type":"NodeParagraph","Properties":{"id":"20240613145547-8mlgtnu","updated":"20240613145547"},"Children":[{"Type":"NodeText","Data":"《本经》主寒热瘰 疮。"}]},{"ID":"20240613145547-f8ej29l","Type":"NodeParagraph","Properties":{"id":"20240613145547-f8ej29l","updated":"20240613145547"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"牛李，生青熟黑，而带红紫，入肝肾血分。其味苦凉，善解诸经伏匿之毒。《本经》治寒热瘰 ，《大明》治水肿腹满，苏恭治下血及疝瘕积冷。捣敷牛马疮中生虫。时珍治疥癣有虫，总取其去湿热之功。惜乎世鲜知用。惟钱氏必胜膏治痘疮黑陷及出不快，或触秽气黑陷，方用牛李熬膏，桃胶汤化皂子大一丸；如人行十里再进一丸，其疮自然红活。盖牛李解毒去湿热，桃胶辟恶气活血耳。"}]},{"ID":"20240613144748-ajk402s","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-ajk402s"}},{"ID":"20240613145329-qdhxsgc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145329-qdhxsgc","updated":"20240613145344"},"Children":[{"Type":"NodeText","Data":"鼠李《千金翼方》"}]},{"ID":"20240613145329-yb1jkki","Type":"NodeParagraph","Properties":{"id":"20240613145329-yb1jkki","updated":"20240613145329"},"Children":[{"Type":"NodeText","Data":"主寒热瘰 疮。"}]},{"ID":"20240613145329-mqaqekl","Type":"NodeParagraph","Properties":{"id":"20240613145329-mqaqekl","updated":"20240613145329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其皮"}]},{"ID":"20240613145329-ma1czcf","Type":"NodeParagraph","Properties":{"id":"20240613145329-ma1czcf","updated":"20240613145540"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主除身皮热毒。一名牛李，一名鼠梓，一名 。生田野，采无时。"}]},{"ID":"20240613144748-x295e73","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-x295e73"}},{"ID":"20240613145308-xmu0c4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145308-xmu0c4n","updated":"20240613145314"},"Children":[{"Type":"NodeText","Data":"鼠李《证类本草》"}]},{"ID":"20240613145308-miroeg1","Type":"NodeParagraph","Properties":{"id":"20240613145308-miroeg1","updated":"20240613145308"},"Children":[{"Type":"NodeText","Data":"主寒热，瘰 疮。"}]},{"ID":"20240613145308-o5ngids","Type":"NodeParagraph","Properties":{"id":"20240613145308-o5ngids","updated":"20240613145308"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其皮"},{"Type":"NodeText","Data":"味苦，微寒，无毒。主除身皮热毒。一名牛李，一名鼠梓，一名 （音卑）。"}]},{"ID":"20240613145308-elwf2qi","Type":"NodeParagraph","Properties":{"id":"20240613145308-elwf2qi","updated":"20240613145308"},"Children":[{"Type":"NodeText","Data":"生田野，采无时。"}]},{"ID":"20240613145308-e0qlum2","Type":"NodeParagraph","Properties":{"id":"20240613145308-e0qlum2","updated":"20240613145308"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此药一名赵李，一名皂李，一名乌槎。树皮主诸疮，寒热毒痹。子主牛马六畜疮中虫，或生捣敷之，或和脂涂，皆效。子味苦，采取晒干，九蒸。酒渍服三合，日再，能下血及碎肉，除疝瘕积冷气，大良。皮、子俱有小毒。臣禹锡等谨按日华子云∶味苦，凉，微毒。治水肿，皮主风痹。"}]},{"ID":"20240613145308-bdr1uj1","Type":"NodeParagraph","Properties":{"id":"20240613145308-bdr1uj1","updated":"20240613145308"},"Children":[{"Type":"NodeText","Data":"图经曰∶鼠李，即乌巢子也。《本经》不载所出州土，但云生田野，今蜀川多有之。枝、叶KT黑，其汁紫色，味甘、苦，实熟时采，晒干。九蒸，酒渍服，能下一名牛李。刘禹锡《传信方》主大人口中疳疮并发背，万不失一。用山升，以水五大斗，煎至半日以来，汁浓，即于银、铜器中盛之，重汤煎至一、二升，看稍稠，即于瓷瓶子中盛。少少温含咽之，必瘥。忌酱、醋、油腻、热面，大约不宜食肉。如患发背，重汤煎令极稠，和如膏，以帛涂之疮上，神效。襄州军事柳岸妻窦氏患口疳十五年，齿尽落，龈亦断坏，不可近，用此方∶遂瘥。"}]},{"ID":"20240613145308-q0araqx","Type":"NodeParagraph","Properties":{"id":"20240613145308-q0araqx","updated":"20240613145308"},"Children":[{"Type":"NodeText","Data":"食疗云微寒。主腹胀满。其根有毒，煮浓汁含之治 齿。并疳虫蚀人脊骨者，可煮浓汁灌之良。其肉，主胀满谷胀，和面作饼子，空心食之，少时当泻。其煮根汁，亦空心服一盏，治衍义曰∶鼠李，即牛李子也。木高七、八尺，叶如李，但狭而不泽。子于条上四边生，熟则紫黑色，生则青。叶至秋则落，子尚在枝。是处皆有，故《经》不言所出处。今关陕及湖南、江南北甚多。木皮与子两用。"}]},{"ID":"20240613144748-diwf48n","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-diwf48n"}},{"ID":"20240613145256-1dn5z24","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145256-1dn5z24","updated":"20240613145300"},"Children":[{"Type":"NodeText","Data":"鼠李《新修本草》"}]},{"ID":"20240613145256-chbcwzf","Type":"NodeParagraph","Properties":{"id":"20240613145256-chbcwzf","updated":"20240613145256"},"Children":[{"Type":"NodeText","Data":"主寒热瘰 疮。皮，味苦，微寒，无毒。主除身皮热毒。一名牛李，一名鼠梓，一名柙。"}]},{"ID":"20240613145256-id2lyrl","Type":"NodeParagraph","Properties":{"id":"20240613145256-id2lyrl","updated":"20240613145256"},"Children":[{"Type":"NodeText","Data":"生田野，采无时。"}]},{"ID":"20240613145256-aoiiye0","Type":"NodeParagraph","Properties":{"id":"20240613145256-aoiiye0","updated":"20240613145256"},"Children":[{"Type":"NodeText","Data":"此条又附见，今亦在副品限也。"}]},{"ID":"20240613145256-xti2whm","Type":"NodeParagraph","Properties":{"id":"20240613145256-xti2whm","updated":"20240613145256"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药一名赵李，一名皂李，一名乌槎树。皮主诸疮寒热毒痹。子主牛马六畜疮中虫，或生捣敷之，或和脂涂皆效。子味苦，采取晒干，九蒸，酒渍，服三合，日二，能下血及碎肉，除疝瘕积冷气，大良。皮、子俱有小毒。"}]},{"ID":"20240613144748-vbuchk3","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-vbuchk3"}},{"ID":"20240613145246-nnqlwsy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613145246-nnqlwsy","updated":"20240613145250"},"Children":[{"Type":"NodeText","Data":"鼠李《医学入门》"}]},{"ID":"20240613145246-nv7p6ak","Type":"NodeParagraph","Properties":{"id":"20240613145246-nv7p6ak","updated":"20240613145246"},"Children":[{"Type":"NodeText","Data":"即牛李子也。木高七八丈，叶如李，但狭而不泽，子生于条上四边，生青熟黑，至秋叶落，子尚在枝，是处有之。味苦，小毒。主寒热瘰 、 疮，日干，九蒸，酒渍服。能下血，除疝瘕，积冷气，治水肿腹胀。皮主诸疮、寒热毒痹，除身皮热毒。根，主口中疳疮，和蔷薇根煎膏，含咽即瘥，亦可敷背发。煮浓汁含之，治 齿；服之治疳虫蚀脊。"}]},{"ID":"20240613144748-p6z97wr","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-p6z97wr"}},{"ID":"20240613144815-shlvojh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613144815-shlvojh","updated":"20240613144823"},"Children":[{"Type":"NodeText","Data":"鼠李《本草纲目》"}]},{"ID":"20240613144815-trhtj09","Type":"NodeParagraph","Properties":{"id":"20240613144815-trhtj09","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"「释名」楮李、鼠梓、山李子、牛李、皂李、赵李、牛皂子，乌槎子、乌巢。"}]},{"ID":"20240613144815-csiul9t","Type":"NodeParagraph","Properties":{"id":"20240613144815-csiul9t","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"「气味」（子）苦、凉、微毒。"}]},{"ID":"20240613144815-x5o9iyk","Type":"NodeParagraph","Properties":{"id":"20240613144815-x5o9iyk","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613144815-45pl8ph","Type":"NodeParagraph","Properties":{"id":"20240613144815-45pl8ph","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"1、诸疮寒热，用鼠李生捣敷涂。"}]},{"ID":"20240613144815-eew5xu3","Type":"NodeParagraph","Properties":{"id":"20240613144815-eew5xu3","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"2、虫牙肿痛。用鼠李煎汁，空腹饮一碗，是时频频含漱。"}]},{"ID":"20240613144815-wttbtgr","Type":"NodeParagraph","Properties":{"id":"20240613144815-wttbtgr","updated":"20240613144815"},"Children":[{"Type":"NodeText","Data":"3、痘疮黑毁。采黑熟了的鼠李子，捣烂取汁，熬成膏，瓷瓶收存，须令透气。每服如皂角大一团。煎桃胶汤化下。约过两小时，再服一次痘疮自然红活，方中加麝少许更好，如无新鲜鼠李子，取干者如水熬膏亦可。"}]},{"ID":"20240613144748-rs6nphk","Type":"NodeThematicBreak","Properties":{"id":"20240613144748-rs6nphk"}},{"ID":"20240613144749-isbtuq6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613144749-isbtuq6","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：鼠李"}]},{"ID":"20240613144749-h9ziru3","Type":"NodeParagraph","Properties":{"id":"20240613144749-h9ziru3","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613144749-ugxdgif","Type":"NodeParagraph","Properties":{"id":"20240613144749-ugxdgif","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" Shǔ Lǐ"}]},{"ID":"20240613144749-1m0y9hu","Type":"NodeParagraph","Properties":{"id":"20240613144749-1m0y9hu","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613144749-xyj9t2t","Type":"NodeParagraph","Properties":{"id":"20240613144749-xyj9t2t","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 老乌眼、老鸹眼、臭李子"}]},{"ID":"20240613144749-uuqish2","Type":"NodeParagraph","Properties":{"id":"20240613144749-uuqish2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613144749-48d1aaw","Type":"NodeParagraph","Properties":{"id":"20240613144749-48d1aaw","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 鼠李科鼠李属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鼠李"},{"Type":"NodeText","Data":"Rhamnus dahurica Pall.，或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌苏里鼠李"},{"Type":"NodeText","Data":"R. ussuriensis J. Vass.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"入药。春季采树皮，刮去外面粗皮，切丝晒干；秋季采果，晒干。"}]},{"ID":"20240613144749-95x1vcz","Type":"NodeParagraph","Properties":{"id":"20240613144749-95x1vcz","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613144749-k9q17co","Type":"NodeParagraph","Properties":{"id":"20240613144749-k9q17co","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 树皮：苦，寒。"}]},{"ID":"20240613144749-cjdpsq4","Type":"NodeParagraph","Properties":{"id":"20240613144749-cjdpsq4","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"果实：甘、微苦，平。有小毒。"}]},{"ID":"20240613144749-z444dr6","Type":"NodeParagraph","Properties":{"id":"20240613144749-z444dr6","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613144749-utv0rf9","Type":"NodeParagraph","Properties":{"id":"20240613144749-utv0rf9","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 树皮：清热，通便。用于大便秘结。"}]},{"ID":"20240613144749-8smwb5z","Type":"NodeParagraph","Properties":{"id":"20240613144749-8smwb5z","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"果实：止咳，祛痰。用于支气管炎，肺气肿，龋齿痛，痈疖。"}]},{"ID":"20240613144749-3ifslsu","Type":"NodeParagraph","Properties":{"id":"20240613144749-3ifslsu","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613144749-acih9rz","Type":"NodeParagraph","Properties":{"id":"20240613144749-acih9rz","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 树皮1～3钱，果实3～5分，可制成酒剂服；外用适量，果实捣烂敷患处。"}]},{"ID":"20240613144749-60rqpa2","Type":"NodeParagraph","Properties":{"id":"20240613144749-60rqpa2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613144749-8l14cin","Type":"NodeParagraph","Properties":{"id":"20240613144749-8l14cin","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613144749-9b6c6w4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613144749-9b6c6w4","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鼠李"}]},{"ID":"20240613144749-umvc3bs","Type":"NodeParagraph","Properties":{"id":"20240613144749-umvc3bs","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613144749-nf63ule","Type":"NodeParagraph","Properties":{"id":"20240613144749-nf63ule","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" Shǔ Lǐ"}]},{"ID":"20240613144749-z2a4d5b","Type":"NodeParagraph","Properties":{"id":"20240613144749-z2a4d5b","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613144749-n0gfoxa","Type":"NodeParagraph","Properties":{"id":"20240613144749-n0gfoxa","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 牛李（《吴普本草》），鼠梓、稗（《别录》），赵李、皂李（《唐本草》），山李子（刘禹锡《传信方》），乌巢子（《本草图经》），女儿茶、牛筋子（《救荒本草》），楮李、乌槎子、牛皂子（《纲目》），绿子（《本经逢原》），乌罡子、牛诮子、禾镰子（《医林纂要》），羊史子（《植物名实图考》），臭李子（《中国树木分类学》）。"}]},{"ID":"20240613144749-ihhb97j","Type":"NodeParagraph","Properties":{"id":"20240613144749-ihhb97j","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613144749-kij5lc2","Type":"NodeParagraph","Properties":{"id":"20240613144749-kij5lc2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613144749-jdbqxbp","Type":"NodeParagraph","Properties":{"id":"20240613144749-jdbqxbp","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613144749-41e0hdb","Type":"NodeParagraph","Properties":{"id":"20240613144749-41e0hdb","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 为鼠李科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鼠李"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。8～9月果实成熟时采收，除去果柄，微火烘干。"}]},{"ID":"20240613144749-ni5m8dd","Type":"NodeParagraph","Properties":{"id":"20240613144749-ni5m8dd","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613144749-thud422","Type":"NodeParagraph","Properties":{"id":"20240613144749-thud422","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 生于山地杂木林中。分布东北、河北、山东、山西、陕西、四川、湖北、湖南、贵州、云南、江苏、浙江等地。"}]},{"ID":"20240613144749-mzk8inl","Type":"NodeParagraph","Properties":{"id":"20240613144749-mzk8inl","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613144749-khk586l","Type":"NodeParagraph","Properties":{"id":"20240613144749-khk586l","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 鼠李，又名：乌槎树（《唐本草》），冻绿柴、老鹳眼、红皮绿树、大绿。"}]},{"ID":"20240613144749-23y81gl","Type":"NodeParagraph","Properties":{"id":"20240613144749-23y81gl","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"落叶小乔木或开张的大灌木，高可达10米。树皮灰褐色，小枝褐色而稍有光泽，顶端有大形芽。叶对生于长枝上，或丛生于短枝上；有长柄；长圆状卵形或阔倒披针形，长4～11厘米，宽2.5～5.5厘米，先端渐尖，基部圆形或楔形，边缘具圆细锯齿，上面亮绿色，下面淡绿色，无毛或有短柔毛，侧脉通常4～5对。花2～5束生于叶腋，黄绿色，雌雄异株，径4～5毫米；萼4裂，萼片狭卵形，锐头；花冠漏斗状钟形，4裂；雄花，雄蕊4，并有不育的雌蕊；雌花，子房球形，2～3室，花柱2～3裂，并有发育不全的雄蕊。核果近球形，径5～7毫米，成熟后紫黑色。花期5～6月。果期8～9月。"}]},{"ID":"20240613144749-z4aw5ya","Type":"NodeParagraph","Properties":{"id":"20240613144749-z4aw5ya","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"本植物的根（鼠李根），树皮（鼠李皮）亦供药用，另详专条。"}]},{"ID":"20240613144749-o97kw05","Type":"NodeParagraph","Properties":{"id":"20240613144749-o97kw05","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613144749-rxi3um8","Type":"NodeParagraph","Properties":{"id":"20240613144749-rxi3um8","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 干燥果实近球形，外表黑紫色。光泽而有皱缩纹。果肉疏松，内层坚硬，通常有果核2枚；果核卵圆形，背面有狭沟。"}]},{"ID":"20240613144749-9xub0w8","Type":"NodeParagraph","Properties":{"id":"20240613144749-9xub0w8","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613144749-skrb4m9","Type":"NodeParagraph","Properties":{"id":"20240613144749-skrb4m9","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 果实含大黄素、大黄酚、蒽酚；另含山柰酚。种子中有多种黄酮甙酶。树皮含大黄素、芦荟大黄素、大黄酚等多种蒽醌类。"}]},{"ID":"20240613144749-nck652e","Type":"NodeParagraph","Properties":{"id":"20240613144749-nck652e","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613144749-xjc45e4","Type":"NodeParagraph","Properties":{"id":"20240613144749-xjc45e4","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《本经逢原》：\"入肝、肾。\""}]},{"ID":"20240613144749-rxvqg31","Type":"NodeParagraph","Properties":{"id":"20240613144749-rxvqg31","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613144749-9cg45y7","Type":"NodeParagraph","Properties":{"id":"20240613144749-9cg45y7","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 苦甘，凉。"}]},{"ID":"20240613144749-np9fsag","Type":"NodeParagraph","Properties":{"id":"20240613144749-np9fsag","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味苦，有小毒。\""}]},{"ID":"20240613144749-kx5flgk","Type":"NodeParagraph","Properties":{"id":"20240613144749-kx5flgk","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"味甘苦。\""}]},{"ID":"20240613144749-icm5tvq","Type":"NodeParagraph","Properties":{"id":"20240613144749-icm5tvq","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"苦，微寒，无毒。\""}]},{"ID":"20240613144749-mvq9frg","Type":"NodeParagraph","Properties":{"id":"20240613144749-mvq9frg","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613144749-zgg6xyy","Type":"NodeParagraph","Properties":{"id":"20240613144749-zgg6xyy","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 清热利湿，消积杀虫。治水肿腹胀，疝瘕，瘰疬，疥癣，齿痛。"}]},{"ID":"20240613144749-izdsylv","Type":"NodeParagraph","Properties":{"id":"20240613144749-izdsylv","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热，瘰疬疮。\""}]},{"ID":"20240613144749-uw8pw5f","Type":"NodeParagraph","Properties":{"id":"20240613144749-uw8pw5f","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"主大热。\""}]},{"ID":"20240613144749-ewzm41o","Type":"NodeParagraph","Properties":{"id":"20240613144749-ewzm41o","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"下血及碎肉，除疝瘕积冷气，九蒸酒渍，服三合，日二。\""}]},{"ID":"20240613144749-vmz2qm9","Type":"NodeParagraph","Properties":{"id":"20240613144749-vmz2qm9","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"④《食疗本草》：\"主胀满、谷胀，和面作讲子，空心食之，少时当泻。\""}]},{"ID":"20240613144749-926m48g","Type":"NodeParagraph","Properties":{"id":"20240613144749-926m48g","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"治水肿。\""}]},{"ID":"20240613144749-7f8ljnh","Type":"NodeParagraph","Properties":{"id":"20240613144749-7f8ljnh","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"⑥《品汇精要》：\"杀虫，消毒。\""}]},{"ID":"20240613144749-x54sesy","Type":"NodeParagraph","Properties":{"id":"20240613144749-x54sesy","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"治痘疮黑陷及疥癣有虫。\""}]},{"ID":"20240613144749-k4n79ov","Type":"NodeParagraph","Properties":{"id":"20240613144749-k4n79ov","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"⑧《医林纂要》：\"取汁熬膏，滋阴，养肾，活血。\""}]},{"ID":"20240613144749-az2gz7t","Type":"NodeParagraph","Properties":{"id":"20240613144749-az2gz7t","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613144749-lq7wk9e","Type":"NodeParagraph","Properties":{"id":"20240613144749-lq7wk9e","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；研末或熬膏。外用：捣敷。"}]},{"ID":"20240613144749-y3cs0f2","Type":"NodeParagraph","Properties":{"id":"20240613144749-y3cs0f2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613144749-eeptyrs","Type":"NodeParagraph","Properties":{"id":"20240613144749-eeptyrs","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" ①治痘疮倒靥黑陷：牛李子杵汁，石器内密封，每服皂子大，煎杏胶汤化下。（《小儿药证直诀》牛李膏，一名必胜膏）"}]},{"ID":"20240613144749-ah2m2zv","Type":"NodeParagraph","Properties":{"id":"20240613144749-ah2m2zv","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"②治诸疮寒热毒痹：鼠李生捣敷之。（《圣惠方》）"}]},{"ID":"20240613144749-e23dlb2","Type":"NodeParagraph","Properties":{"id":"20240613144749-e23dlb2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"③治齿匿肿痛：牛李煮汁，空腹饮一盏，仍频含漱。（《圣济总录》）"}]},{"ID":"20240613144749-dv5g9mc","Type":"NodeParagraph","Properties":{"id":"20240613144749-dv5g9mc","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613144749-ekj15aa","Type":"NodeParagraph","Properties":{"id":"20240613144749-ekj15aa","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《本经逢原》：\"牛李，善解诸经伏匿之毒。《本经》治寒热瘰疬。《大明》治水肿腹满，苏恭治下血及疝瘕积冷，捣敷牛马疮中生虫，时珍治疥癣有虫，总取其去湿热之功。\""}]},{"ID":"20240613144749-jgif8tc","Type":"NodeParagraph","Properties":{"id":"20240613144749-jgif8tc","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613144749-2khsirv","Type":"NodeParagraph","Properties":{"id":"20240613144749-2khsirv","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613144749-wmtca11","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613144749-wmtca11","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鼠李"}]},{"ID":"20240613144749-jxwnc2j","Type":"NodeParagraph","Properties":{"id":"20240613144749-jxwnc2j","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613144749-r8olixe","Type":"NodeParagraph","Properties":{"id":"20240613144749-r8olixe","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" Shǔ Lǐ"}]},{"ID":"20240613144749-c729m6n","Type":"NodeParagraph","Properties":{"id":"20240613144749-c729m6n","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613144749-jnj3bqm","Type":"NodeParagraph","Properties":{"id":"20240613144749-jnj3bqm","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 牛李、鼠梓、赵李、皂李、山李子、乌巢子、牛李子、女儿茶、牛筋子、楮李、乌搓子、牛皂子、绿子、乌罡子、牛消子、禾镰子、羊史子、红冻、鹿梨、油葫芦子、大脑头。"}]},{"ID":"20240613144749-bo7429y","Type":"NodeParagraph","Properties":{"id":"20240613144749-bo7429y","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613144749-ptxo043","Type":"NodeParagraph","Properties":{"id":"20240613144749-ptxo043","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" Fruit of Davurian Buckthorn"}]},{"ID":"20240613144749-zwl875j","Type":"NodeParagraph","Properties":{"id":"20240613144749-zwl875j","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613144749-le2qqij","Type":"NodeParagraph","Properties":{"id":"20240613144749-le2qqij","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》；1.《本草衍义》：鼠李，木高七、八尺，叶如李.但狭而不泽，子于条上四边生，熟则紫黑色，生则青，叶至秋则落，子尚在枝。是处皆有，故《经》不言所出处，今关、陕及湖南、江南北甚多，木皮与子两用。"}]},{"ID":"20240613144749-1f0tc8w","Type":"NodeParagraph","Properties":{"id":"20240613144749-1f0tc8w","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：鼠李生道路边，其实附枝如穗，人采其嫩者取汁，刷染绿色。"}]},{"ID":"20240613144749-i4xhua7","Type":"NodeParagraph","Properties":{"id":"20240613144749-i4xhua7","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613144749-tiz6dua","Type":"NodeParagraph","Properties":{"id":"20240613144749-tiz6dua","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鼠李科植物冻绿的果实。"}]},{"ID":"20240613144749-kvqoyq3","Type":"NodeParagraph","Properties":{"id":"20240613144749-kvqoyq3","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rhamnus utilis Decne.[R.davarica auct.non Pall.]"}]},{"ID":"20240613144749-0zwezij","Type":"NodeParagraph","Properties":{"id":"20240613144749-0zwezij","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"采收和储藏：8-9月果实成熟时采收，除去果柄，鲜用或微火烘干。"}]},{"ID":"20240613144749-f2i7825","Type":"NodeParagraph","Properties":{"id":"20240613144749-f2i7825","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613144749-wnd61xv","Type":"NodeParagraph","Properties":{"id":"20240613144749-wnd61xv","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1500m以下的向阳山地、丘陵、山坡草丛、灌丛或疏林中。"}]},{"ID":"20240613144749-fqeni7n","Type":"NodeParagraph","Properties":{"id":"20240613144749-fqeni7n","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南及河北、山西、陕西、甘肃等地。"}]},{"ID":"20240613144749-yhzejnt","Type":"NodeParagraph","Properties":{"id":"20240613144749-yhzejnt","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613144749-ntbgwtk","Type":"NodeParagraph","Properties":{"id":"20240613144749-ntbgwtk","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 冻绿 落叶灌木或小乔木，高达4m。幼枝无毛，小枝褐色或紫红色，稍平滑，对生或近对生，枝端常具针刺；叶对生或近对生；叶柄长0.5-1.5cm，上面具沟；托叶披针形，常具疏毛，宿存；叶片纸质，椭圆形、长圆形或倒卵状椭圆形，长4-15cm，宽2-6.5cm，先端突尖或渐尖，基部楔形，边缘具细锯齿，上面无毛或仅中脉具疏柔毛，下面沿脉或脉腋有金黄色柔毛，侧脉5-6对，网脉明显。花单性，雌雄异株，黄绿色，无总梗的伞状聚伞花序生于枝端或叶腋；花萼4裂，裂片卵形；花瓣4，长椭圆形，小或无；雄花雄蕊4，花药狭长，丁字形着生，与花瓣一起着生于萼裂的基部，退化雌蕊子房扁球形，花柱2裂；雌花的子房球形，花柱长，柱头3裂，退化雄蕊4。核果近球形，径6-8mm，熟时黑色，具2分核。基部有宿存萼筒，果梗长5-12mm，无毛。种子近球形，背侧基部有短沟。花期4-6月，果期5-8月。"}]},{"ID":"20240613144749-e2pv972","Type":"NodeParagraph","Properties":{"id":"20240613144749-e2pv972","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613144749-1g7qf8r","Type":"NodeParagraph","Properties":{"id":"20240613144749-1g7qf8r","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 1.干燥果实近球形，外表黑紫色，光泽而有皱缩纹。"}]},{"ID":"20240613144749-cidb2os","Type":"NodeParagraph","Properties":{"id":"20240613144749-cidb2os","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"2.果肉疏松，内后坚硬，通常有果核2枚；果核卵圆形，背面有狭沟。"}]},{"ID":"20240613144749-okdgxe9","Type":"NodeParagraph","Properties":{"id":"20240613144749-okdgxe9","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613144749-qr0esan","Type":"NodeParagraph","Properties":{"id":"20240613144749-qr0esan","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 1.果实含大黄素(Emodin)、大黄酚(Chrysopha-nol)、蓖酚；另含山索酚(Kaempferol)。"}]},{"ID":"20240613144749-x6zy3ap","Type":"NodeParagraph","Properties":{"id":"20240613144749-x6zy3ap","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"2.种子中有多种黄酮贰酶(Rhamnodiastase)。"}]},{"ID":"20240613144749-fb3mds2","Type":"NodeParagraph","Properties":{"id":"20240613144749-fb3mds2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"3.树皮含大黄素、芦萎大黄索(Aloe-emodin)、大黄酚等多种葱酮类。"}]},{"ID":"20240613144749-uzvt5e9","Type":"NodeParagraph","Properties":{"id":"20240613144749-uzvt5e9","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613144749-3a40yv2","Type":"NodeParagraph","Properties":{"id":"20240613144749-3a40yv2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240613144749-a47f89v","Type":"NodeParagraph","Properties":{"id":"20240613144749-a47f89v","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613144749-qoko8i8","Type":"NodeParagraph","Properties":{"id":"20240613144749-qoko8i8","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 苦；甘；性凉"}]},{"ID":"20240613144749-4x8xmpa","Type":"NodeParagraph","Properties":{"id":"20240613144749-4x8xmpa","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613144749-2uxb661","Type":"NodeParagraph","Properties":{"id":"20240613144749-2uxb661","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 清热利湿；消积通便。主水肿腹胀；疝瘕；瘰疬；疮疡；便秘"}]},{"ID":"20240613144749-vm3bs9i","Type":"NodeParagraph","Properties":{"id":"20240613144749-vm3bs9i","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613144749-td02c4q","Type":"NodeParagraph","Properties":{"id":"20240613144749-td02c4q","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-12g；或研末；或熬膏。外用：适量，研末油调敷。"}]},{"ID":"20240613144749-owmbyw1","Type":"NodeParagraph","Properties":{"id":"20240613144749-owmbyw1","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613144749-e23m8kv","Type":"NodeParagraph","Properties":{"id":"20240613144749-e23m8kv","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" ①治痘疮倒靥黑陷： 牛李子杵汁，石器内密封，每服皂子大，煎杏胶汤化下。(刮、儿药证直诀》牛李膏，一名必胜膏)②治诸疮寒热毒痹： 鼠李生捣敷之。(《圣惠方》)③治齿露肿痛：牛李煮汁，空腹饮一盏，仍频含漱。 (《圣济总录》)"}]},{"ID":"20240613144749-771xa4y","Type":"NodeParagraph","Properties":{"id":"20240613144749-771xa4y","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613144749-oeaytav","Type":"NodeParagraph","Properties":{"id":"20240613144749-oeaytav","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 1.《本经逢原》：牛李，善解诸经伏匿之毒。《本经》治寒热瘰疠，大阴治水肿腹满，苏恭治下血及疝瘕冷积，捣敷牛马疮中生虫，时珍治疥癣有虫，总取其去湿热之功。"}]},{"ID":"20240613144749-qshpn31","Type":"NodeParagraph","Properties":{"id":"20240613144749-qshpn31","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主寒热，瘰疠疮。"}]},{"ID":"20240613144749-eiodjgt","Type":"NodeParagraph","Properties":{"id":"20240613144749-eiodjgt","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"3.《本草经集注》：主大热。"}]},{"ID":"20240613144749-rryw6hl","Type":"NodeParagraph","Properties":{"id":"20240613144749-rryw6hl","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"4.《唐本草》：下血及碎肉，除疝瘕积冷气，九蒸酒渍，服三合，日二。"}]},{"ID":"20240613144749-4b0nsi7","Type":"NodeParagraph","Properties":{"id":"20240613144749-4b0nsi7","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"5.《食疗本草》：主胀满、谷胀，和面作饼子，空心食之，少时当泻。"}]},{"ID":"20240613144749-y9vqlks","Type":"NodeParagraph","Properties":{"id":"20240613144749-y9vqlks","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治水肿。"}]},{"ID":"20240613144749-vg3egve","Type":"NodeParagraph","Properties":{"id":"20240613144749-vg3egve","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"7.《品汇精要》：杀虫，消毒。"}]},{"ID":"20240613144749-biqgk35","Type":"NodeParagraph","Properties":{"id":"20240613144749-biqgk35","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"8.《纲目》：治痘疮黑陷及疥癣有虫。"}]},{"ID":"20240613144749-wesr0dq","Type":"NodeParagraph","Properties":{"id":"20240613144749-wesr0dq","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"9.《医林纂要》：取汁熬膏，滋阴，养肾，活血。"}]},{"ID":"20240613144749-nellgf7","Type":"NodeParagraph","Properties":{"id":"20240613144749-nellgf7","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613144749-vqdtis2","Type":"NodeParagraph","Properties":{"id":"20240613144749-vqdtis2","updated":"20240613144749"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613144750-9lt0b0e","Type":"NodeThematicBreak","Properties":{"id":"20240613144750-9lt0b0e"}},{"ID":"20240613144751-5rnutev","Type":"NodeParagraph","Properties":{"id":"20240613144751-5rnutev"}}]}