"{: style=\"width: 587px;\" parent-style=\"width: 597px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827114220-2op3iyb","Type":"NodeParagraph","Properties":{"id":"20240827114220-2op3iyb","updated":"20240827125011"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 583px;","style":"width: 573px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栾花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栾花 8-20240827114206-bqbb9z3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 573px;\" parent-style=\"width: 583px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 654px;","style":"width: 644px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栾花 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栾花 9-20240827114438-v8haq0b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 644px;\" parent-style=\"width: 654px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827124101-fyaifj8","Type":"NodeParagraph","Properties":{"id":"20240827124101-fyaifj8","updated":"20240827124101"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 648px;","style":"width: 638px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栾树4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栾树4-20240702165251-y4nizzy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 638px;\" parent-style=\"width: 648px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 281px;","style":"width: 271px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702165319-coxi59l.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 271px;\" parent-style=\"width: 281px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827111956-9oix103","Type":"NodeParagraph","Properties":{"id":"20240827111956-9oix103","updated":"20240827113841"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为栾树的花，以上未按品种分类；"}]},{"ID":"20240613150214-7j1o4im","Type":"NodeThematicBreak","Properties":{"id":"20240613150214-7j1o4im"}},{"ID":"20240613150230-1odo60o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150230-1odo60o","updated":"20240613150235"},"Children":[{"Type":"NodeText","Data":"栾华《神农本草经》"}]},{"ID":"20240613150230-ho3ml7v","Type":"NodeParagraph","Properties":{"id":"20240613150230-ho3ml7v","updated":"20240613150230"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613150230-fhvapu7","Type":"NodeParagraph","Properties":{"id":"20240613150230-fhvapu7","updated":"20240613150230"},"Children":[{"Type":"NodeText","Data":"主目痛泪出，伤眦，消目肿，生川谷。"}]},{"ID":"20240613150230-1ihoadm","Type":"NodeParagraph","Properties":{"id":"20240613150230-1ihoadm","updated":"20240613150230"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中，五月采。"}]},{"ID":"20240613150230-9f3oyyx","Type":"NodeParagraph","Properties":{"id":"20240613150230-9f3oyyx","updated":"20240613150230"},"Children":[{"Type":"NodeText","Data":"案《说文》云：栾木似栏。《山海经》云：云雨之山，有木名栾，黄木赤枝青叶，群帝焉取药。曰虎通云：诸侯墓树柏，大夫栾，士槐。沈括补笔谈云：栾有一种，树生，其实可作数珠者，谓之木栾，即本草栾花是也。"}]},{"ID":"20240613150427-vy894e5","Type":"NodeThematicBreak","Properties":{"id":"20240613150427-vy894e5"}},{"ID":"20240613150428-cg1guc7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150428-cg1guc7","updated":"20240613150432"},"Children":[{"Type":"NodeText","Data":"栾华《千金翼方》"}]},{"ID":"20240613150428-sl2n3po","Type":"NodeParagraph","Properties":{"id":"20240613150428-sl2n3po","updated":"20240613150428"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主目痛泪出，伤 ，消目肿。生汉中川谷，五月采。"}]},{"ID":"20240613150512-4h5u1fr","Type":"NodeThematicBreak","Properties":{"id":"20240613150512-4h5u1fr"}},{"ID":"20240613150514-dgs4ywp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150514-dgs4ywp","updated":"20240613150518"},"Children":[{"Type":"NodeText","Data":"栾华《本草衍义》"}]},{"ID":"20240613150514-un78hwo","Type":"NodeParagraph","Properties":{"id":"20240613150514-un78hwo","updated":"20240613150514"},"Children":[{"Type":"NodeText","Data":"今长安山中亦有。其子即谓之木栾子，携至京都为数珠，未见其入药。"}]},{"ID":"20240613150214-clpgxnk","Type":"NodeThematicBreak","Properties":{"id":"20240613150214-clpgxnk"}},{"ID":"20240613150336-kwxgf6f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150336-kwxgf6f","updated":"20240613150340"},"Children":[{"Type":"NodeText","Data":"栾华《医学入门》"}]},{"ID":"20240613150336-kn8lk6j","Type":"NodeParagraph","Properties":{"id":"20240613150336-kn8lk6j","updated":"20240613150336"},"Children":[{"Type":"NodeText","Data":"出汉中，叶似木槿而薄细，花似槐而稍长，堪染黄色，子似豌豆而坚黑，堪为数珠。味苦，寒，无毒。和黄连煎膏，疗目痛赤烂、泪出伤 ，消目肿，大效。五六月采花，日干。决明为之使。"}]},{"ID":"20240613150341-dv3ncs9","Type":"NodeThematicBreak","Properties":{"id":"20240613150341-dv3ncs9"}},{"ID":"20240613150348-cc81o1w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150348-cc81o1w","updated":"20240613150352"},"Children":[{"Type":"NodeText","Data":"栾华《证类本草》"}]},{"ID":"20240613150348-ptkitrd","Type":"NodeParagraph","Properties":{"id":"20240613150348-ptkitrd","updated":"20240613150348"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主目痛泪出，伤 ，消目肿。生汉中川谷。五月采。（决明为之使。）"}]},{"ID":"20240613150348-5cnvh2i","Type":"NodeParagraph","Properties":{"id":"20240613150348-5cnvh2i","updated":"20240613150348"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此树，叶似木槿而薄细，花黄似槐而小长大。子壳似酸浆，其中有实如熟豌豆，圆黑坚硬，堪为数珠者，是也。五月、六月花可收，南人取合黄连作煎，疗目赤烂，大效。"}]},{"ID":"20240613150348-hn3pgir","Type":"NodeParagraph","Properties":{"id":"20240613150348-hn3pgir","updated":"20240613150348"},"Children":[{"Type":"NodeText","Data":"花以染黄色，甚鲜好。"}]},{"ID":"20240613150348-8escxsq","Type":"NodeParagraph","Properties":{"id":"20240613150348-8escxsq","updated":"20240613150348"},"Children":[{"Type":"NodeText","Data":"图经曰∶栾华，生汉中川谷，今南方∶及都下园圃中或有之。叶似木槿而薄细。花黄似槐而稍长大。子壳似酸浆，其中有实如熟豌豆，圆黑坚，堪为数珠者。五月采。其花亦可染黄，南人取以合黄连作煎，疗目赤烂，甚效。"}]},{"ID":"20240613150348-40o5f5q","Type":"NodeParagraph","Properties":{"id":"20240613150348-40o5f5q","updated":"20240613150348"},"Children":[{"Type":"NodeText","Data":"衍义曰∶栾华，今长安山中亦有，其子即谓之木栾子，携至京都为数珠，未见其入药。"}]},{"ID":"20240613150411-2ied377","Type":"NodeThematicBreak","Properties":{"id":"20240613150411-2ied377"}},{"ID":"20240613150412-8ta3867","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150412-8ta3867","updated":"20240613150417"},"Children":[{"Type":"NodeText","Data":"栾华《新修本草》"}]},{"ID":"20240613150412-uer54u7","Type":"NodeParagraph","Properties":{"id":"20240613150412-uer54u7","updated":"20240613150412"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主目痛泣出，伤 ，消目肿。生汉中川谷。五月采。"}]},{"ID":"20240613150412-edjx0oz","Type":"NodeParagraph","Properties":{"id":"20240613150412-edjx0oz","updated":"20240613150412"},"Children":[{"Type":"NodeText","Data":"决明为之使。"}]},{"ID":"20240613150412-a1gclex","Type":"NodeParagraph","Properties":{"id":"20240613150412-a1gclex","updated":"20240613150412"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此树，叶似木槿而薄细，花黄似槐少长大，子壳似酸浆，其中有实，如熟豌豆，圆黑坚硬，堪为数珠者是也。五月、六月花可收，南人取合黄连作煎，疗目赤烂大效。花以染黄色，甚鲜好也。"}]},{"ID":"20240613150357-6b9i821","Type":"NodeThematicBreak","Properties":{"id":"20240613150357-6b9i821"}},{"ID":"20240613150358-hqowmdd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150358-hqowmdd","updated":"20240613150407"},"Children":[{"Type":"NodeText","Data":"栾华《本草图经》"}]},{"ID":"20240613150358-kh5g3ii","Type":"NodeParagraph","Properties":{"id":"20240613150358-kh5g3ii","updated":"20240613150402"},"Children":[{"Type":"NodeText","Data":"栾华，生汉中川谷，今南方及都下园圃中或有之。叶似木槿而薄细；花黄似槐而稍长大；子壳似酸浆，其中有实如熟豌豆，圆黑坚，堪为数珠者。五月采其花，亦可染黄。南人取以合黄连作煎，疗目赤烂甚效。"}]},{"ID":"20240613150214-v9f3zqi","Type":"NodeThematicBreak","Properties":{"id":"20240613150214-v9f3zqi"}},{"ID":"20240613150221-ubp239z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150221-ubp239z","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：栾华"}]},{"ID":"20240613150221-ws3x6ye","Type":"NodeParagraph","Properties":{"id":"20240613150221-ws3x6ye","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613150221-h2rzz01","Type":"NodeParagraph","Properties":{"id":"20240613150221-h2rzz01","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" Luán Huá"}]},{"ID":"20240613150221-6udeony","Type":"NodeParagraph","Properties":{"id":"20240613150221-6udeony","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613150221-d5ckiw2","Type":"NodeParagraph","Properties":{"id":"20240613150221-d5ckiw2","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613150221-iy5xvtr","Type":"NodeParagraph","Properties":{"id":"20240613150221-iy5xvtr","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613150221-f67n8tv","Type":"NodeParagraph","Properties":{"id":"20240613150221-f67n8tv","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 为无患子科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栾树"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613150221-0kjr4d7","Type":"NodeParagraph","Properties":{"id":"20240613150221-0kjr4d7","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613150221-96w6uke","Type":"NodeParagraph","Properties":{"id":"20240613150221-96w6uke","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 多生于杂木林或灌木林中。分布黑龙江、吉林、辽宁、河北、河南、山东、江苏、浙江、安徽、福建、台湾、四川、陕西、甘肃、山西等地。"}]},{"ID":"20240613150221-656uymv","Type":"NodeParagraph","Properties":{"id":"20240613150221-656uymv","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613150221-p4p0yjc","Type":"NodeParagraph","Properties":{"id":"20240613150221-p4p0yjc","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 栾树（《正字通》），又名：木栾（《梦溪笔谈》），石栾树、黑叶树、木栏牙、山茶叶、软棒。"}]},{"ID":"20240613150221-3jil3np","Type":"NodeParagraph","Properties":{"id":"20240613150221-3jil3np","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"落叶灌木或乔木，高可达10米。小枝暗黑色，被柔毛。单数羽状复叶互生，有时呈2回或不完全的2回羽状复叶；小叶7～15，纸质，卵形或卵状披针形，长3.5～7.5厘米，宽2.5～3.5厘米，基部钝形或截头形，先端短尖或短渐尖，边缘锯齿状或分裂，有时羽状深裂达基部面呈2回羽状复叶。圆锥花序顶生，大，长25～40厘米；花淡黄色，中心紫色；萼片5，有小睫毛；花瓣4，被疏长毛；雄蕊8，花丝被疏长毛；雌蕊1，花盘有波状齿。蒴果长椭圆状卵形，边缘有膜质薄翅3片。种子圆形，黑色。花期7～8月。果期10月。"}]},{"ID":"20240613150221-ors6ci9","Type":"NodeParagraph","Properties":{"id":"20240613150221-ors6ci9","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613150221-4ydx4r2","Type":"NodeParagraph","Properties":{"id":"20240613150221-4ydx4r2","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 果实含甾醇、皂甙、黄酮甙、花色甙、鞣质和聚糖醛酸。皂甙中分出了栾树皂甙A和B。干燥种子含水分9.4％，粗蛋白17.5％，卵磷脂磷酸0.045％，淀粉7.0％，灰分9.0％，脂类20.9％。种仁含油38％，皂化后分出甾醇和棕榈酸。叶含没食子酸甲酯，对多种细菌和真菌具有抑制作用。"}]},{"ID":"20240613150221-4fr5jho","Type":"NodeParagraph","Properties":{"id":"20240613150221-4fr5jho","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613150221-8e9h46s","Type":"NodeParagraph","Properties":{"id":"20240613150221-8e9h46s","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味苦，寒。\""}]},{"ID":"20240613150221-upk5jjb","Type":"NodeParagraph","Properties":{"id":"20240613150221-upk5jjb","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613150221-sq9y2ot","Type":"NodeParagraph","Properties":{"id":"20240613150221-sq9y2ot","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613150221-mi8na0v","Type":"NodeParagraph","Properties":{"id":"20240613150221-mi8na0v","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"决明为使。\""}]},{"ID":"20240613150221-j8mkh2o","Type":"NodeParagraph","Properties":{"id":"20240613150221-j8mkh2o","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613150221-34epltu","Type":"NodeParagraph","Properties":{"id":"20240613150221-34epltu","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"主目痛泪出伤毗，消目肿。\""}]},{"ID":"20240613150221-w3f6sh7","Type":"NodeParagraph","Properties":{"id":"20240613150221-w3f6sh7","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"合黄连作煎，疗目赤烂。\""}]},{"ID":"20240613150221-tf1ru0v","Type":"NodeParagraph","Properties":{"id":"20240613150221-tf1ru0v","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613150221-lfn4kd3","Type":"NodeParagraph","Properties":{"id":"20240613150221-lfn4kd3","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613150221-h1eeb6s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150221-h1eeb6s","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"《中华本草》：栾华"}]},{"ID":"20240613150221-1r7x7dk","Type":"NodeParagraph","Properties":{"id":"20240613150221-1r7x7dk","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613150221-es0ubu1","Type":"NodeParagraph","Properties":{"id":"20240613150221-es0ubu1","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" Luán Huá"}]},{"ID":"20240613150221-harcuv5","Type":"NodeParagraph","Properties":{"id":"20240613150221-harcuv5","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613150221-ohfyf2v","Type":"NodeParagraph","Properties":{"id":"20240613150221-ohfyf2v","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" Flower of Paniculate Goldraintree"}]},{"ID":"20240613150221-5o41wlg","Type":"NodeParagraph","Properties":{"id":"20240613150221-5o41wlg","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613150221-53oym99","Type":"NodeParagraph","Properties":{"id":"20240613150221-53oym99","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240613150221-j71q6ck","Type":"NodeParagraph","Properties":{"id":"20240613150221-j71q6ck","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613150221-e3iq9dc","Type":"NodeParagraph","Properties":{"id":"20240613150221-e3iq9dc","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 药材基源：为无患子科植物栾树的花。"}]},{"ID":"20240613150221-uoygg13","Type":"NodeParagraph","Properties":{"id":"20240613150221-uoygg13","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Koelreuteria paniculata Laxm."}]},{"ID":"20240613150221-1xq4zni","Type":"NodeParagraph","Properties":{"id":"20240613150221-1xq4zni","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-7月采花，阴干或晒干。"}]},{"ID":"20240613150221-i1dawxg","Type":"NodeParagraph","Properties":{"id":"20240613150221-i1dawxg","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613150221-ghpn814","Type":"NodeParagraph","Properties":{"id":"20240613150221-ghpn814","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔200-1200m的疏林中。"}]},{"ID":"20240613150221-cvn8yez","Type":"NodeParagraph","Properties":{"id":"20240613150221-cvn8yez","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"资源分布：常栽培作庭园观赏树。产于我国大部分地区，东北自辽宁起经中部至西南部的云南均有分布。"}]},{"ID":"20240613150221-utsqkpw","Type":"NodeParagraph","Properties":{"id":"20240613150221-utsqkpw","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613150221-19lpi28","Type":"NodeParagraph","Properties":{"id":"20240613150221-19lpi28","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 栾树 落叶乔木或灌木。树皮厚，灰褐色至灰黑色；小枝具疣点，与叶轴、叶柄均被皱曲的短柔毛或无毛。叶丛生于当年生枝上，平展，一回、不完全二回或偶有为二回羽状复叶，长可达50cm；小叶纸质，（7-）11-18片，无柄或具极短的柄，对生或互生，卵形、阔卵形至卵状披针形，长（3-）5-10cm，宽3-6cm，先端短尖或短渐尖，基部钝至近截形，边缘有不规则的钝锯齿，齿端具小尖头，上面仅中脉上散生皱曲的短柔毛，下面在脉腋具髯毛，有时小叶背面被茸毛。花杂性同株或异株；聚伞圆锥花序长25-40cm，密被微柔毛，分枝长而扩展；苞片狭披针形，被小粗毛；花淡黄色，稍芬芳；花梗长2.5-5cm；萼裂片卵形，边缘具腺状缘毛，呈啮蚀状；花瓣4，开花时向外反折，线状长圆形，长5-9mm，被长柔毛，瓣片基部的鳞片初时黄色，开花时橙红色，参差不齐的深裂，被疣状皱曲的毛；雄蕊8，在雄花中的长7-9mm，雌花中的长4-5mm，花丝下半部密被白色、开展的长柔毛；花盘偏斜，有圆钝小裂片；子房三棱形，除棱上具缘毛外无毛，退化子房密被小粗毛。蒴果圆锥形，具三棱，长4-6cm，先端渐尖，果瓣卵形，外面有网纹，内面平滑且略有光泽。种子近球形，直径6-8mm。花期6-8月，果期9-10月。"}]},{"ID":"20240613150221-elkjv0z","Type":"NodeParagraph","Properties":{"id":"20240613150221-elkjv0z","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613150221-e2rd5ua","Type":"NodeParagraph","Properties":{"id":"20240613150221-e2rd5ua","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 生物学特性 耐寒，耐旱，稍能耐阴，耐瘠薄的土壤，在湿润肥沃的土壤上生长良好。深根性，萌蘖力强。"}]},{"ID":"20240613150221-xfy6s10","Type":"NodeParagraph","Properties":{"id":"20240613150221-xfy6s10","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"栽培技术 以种子繁殖为主：9-10月种子成熟，于蒴果未干时采下，晒干，经水选后干藏，一般发芽率70％-90％。种子有来年发芽的习性，秋播，让其自然越冬，春季发芽。或将种子与湿砂混拌，放背阴处低温处理，来年春季3月取出，用温水催芽，播后发芽整齐。苗高5-10cm时间苗，以每10m2留苗100株左右为宜。一年生小苗来年春季移植，培育3-4年养成大苗出圃。"}]},{"ID":"20240613150221-2lhmfht","Type":"NodeParagraph","Properties":{"id":"20240613150221-2lhmfht","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613150221-f8lmt7a","Type":"NodeParagraph","Properties":{"id":"20240613150221-f8lmt7a","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 叶含槲皮甙-2〃-没食子酸酯（quercitrin-2〃-gal late）。"}]},{"ID":"20240613150221-oas6iyp","Type":"NodeParagraph","Properties":{"id":"20240613150221-oas6iyp","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613150221-twmrlpt","Type":"NodeParagraph","Properties":{"id":"20240613150221-twmrlpt","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240613150221-ztwdco5","Type":"NodeParagraph","Properties":{"id":"20240613150221-ztwdco5","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613150221-668apbo","Type":"NodeParagraph","Properties":{"id":"20240613150221-668apbo","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 苦；寒"}]},{"ID":"20240613150221-uisq4hh","Type":"NodeParagraph","Properties":{"id":"20240613150221-uisq4hh","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613150221-jdrtttu","Type":"NodeParagraph","Properties":{"id":"20240613150221-jdrtttu","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：决阴为使。"}]},{"ID":"20240613150221-js1w2qq","Type":"NodeParagraph","Properties":{"id":"20240613150221-js1w2qq","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613150221-io4dbyf","Type":"NodeParagraph","Properties":{"id":"20240613150221-io4dbyf","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 清肝明目。主目赤肿痛；多泪"}]},{"ID":"20240613150221-eu6ck1n","Type":"NodeParagraph","Properties":{"id":"20240613150221-eu6ck1n","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613150221-2kdil1p","Type":"NodeParagraph","Properties":{"id":"20240613150221-2kdil1p","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g。"}]},{"ID":"20240613150221-5od5omw","Type":"NodeParagraph","Properties":{"id":"20240613150221-5od5omw","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613150221-0q0zill","Type":"NodeParagraph","Properties":{"id":"20240613150221-0q0zill","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主目痛泪出伤眦，消目肿。"}]},{"ID":"20240613150221-zw76riq","Type":"NodeParagraph","Properties":{"id":"20240613150221-zw76riq","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：台黄连作煎，疗目赤烂。"}]},{"ID":"20240613150221-el9fm18","Type":"NodeParagraph","Properties":{"id":"20240613150221-el9fm18","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613150221-n8qww95","Type":"NodeParagraph","Properties":{"id":"20240613150221-n8qww95","updated":"20240613150221"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613150223-2g60c5g","Type":"NodeThematicBreak","Properties":{"id":"20240613150223-2g60c5g"}},{"ID":"20240613150224-9snmr7a","Type":"NodeParagraph","Properties":{"id":"20240613150224-9snmr7a"}}]}