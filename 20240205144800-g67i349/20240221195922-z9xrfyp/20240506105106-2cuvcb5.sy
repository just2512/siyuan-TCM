ndcnl34","updated":"20240827163000"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为竹叶花椒"}]},{"ID":"20240827163018-zg0pv78","Type":"NodeParagraph","Properties":{"id":"20240827163018-zg0pv78","updated":"20240827163441"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹叶花椒 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹叶花椒 1-20240827163157-lq5abqs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 674px;","style":"width: 664px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹叶花椒 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹叶花椒 2-20240827163430-m1xxdh9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 664px;\" parent-style=\"width: 674px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827163022-h0d07af","Type":"NodeParagraph","Properties":{"id":"20240827163022-h0d07af","updated":"20240827163250"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为两面针"}]},{"ID":"20240827163339-4qth1k8","Type":"NodeParagraph","Properties":{"id":"20240827163339-4qth1k8","updated":"20240827163357"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"两面针 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/两面针 11-20240827163339-p79nz2a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 412px;","style":"width: 402px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"两面针 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/两面针 12-20240827163357-ytvjq53.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 402px;\" parent-style=\"width: 412px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827161856-rfz1feh","Type":"NodeParagraph","Properties":{"id":"20240827161856-rfz1feh","updated":"20240827163232"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：两面针跟竹叶花椒较相似，竹叶花椒有翼叶（叶柄中间附有叶状结构），两面针没有翼叶；两面针叶子有一股芳香气味；"}]},{"ID":"20240827164313-amb3xko","Type":"NodeParagraph","Properties":{"id":"20240827164313-amb3xko","updated":"20240827171805"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：两面针为木质藤本植物；（两面针小的时候为灌木，长大后就是藤类）"}]},{"ID":"20240827170929-zxjm692","Type":"NodeParagraph","Properties":{"id":"20240827170929-zxjm692","updated":"20240827171913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"两面针未找到其果实的图片"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，网上说法称其果实像花椒，但只找到一种叶面没有针也被称之为‘两面针’的本草果实（该本草除了没针跟两面针基本一致，据说属于另一类品种；除此之外也有只有一面有针的‘两面针’），斟酌良久，没有将之收录；个人认为既然古人取其名为‘两面针’，那么必有其独到之处，故该篇仅收录正宗的‘两面针’；"}]},{"ID":"20240613150655-fpbbxq7","Type":"NodeThematicBreak","Properties":{"id":"20240613150655-fpbbxq7","updated":"20240827161402"}},{"ID":"20240613150718-su7yv2i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150718-su7yv2i","updated":"20240613150722"},"Children":[{"Type":"NodeText","Data":"蔓椒《神农本草经》"}]},{"ID":"20240613150718-h2k4efx","Type":"NodeParagraph","Properties":{"id":"20240613150718-h2k4efx","updated":"20240613150718"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240613150718-8rqy0yc","Type":"NodeParagraph","Properties":{"id":"20240613150718-8rqy0yc","updated":"20240613150718"},"Children":[{"Type":"NodeText","Data":"主风寒湿痹，疬节疼，除四肢厥气，膝痛。一名家椒。生川谷及邱家间。"}]},{"ID":"20240613150718-2l6ve3o","Type":"NodeParagraph","Properties":{"id":"20240613150718-2l6ve3o","updated":"20240613150718"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名猪椒，一名彘椒，一名狗椒，生云中，采茎根煮，酿酒。"}]},{"ID":"20240613150718-qio1pj3","Type":"NodeParagraph","Properties":{"id":"20240613150718-qio1pj3","updated":"20240613150718"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：俗呼为樛，以椒小不香尔，一名稀椒，可以蒸病出汗也。"}]},{"ID":"20240613150718-il8o3xk","Type":"NodeParagraph","Properties":{"id":"20240613150718-il8o3xk","updated":"20240613150718"},"Children":[{"Type":"NodeText","Data":"上木，下品一十七种，旧十八种，今移芫华入草。"}]},{"ID":"20240613150727-yc2cilf","Type":"NodeThematicBreak","Properties":{"id":"20240613150727-yc2cilf"}},{"ID":"20240613150728-672xxh8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150728-672xxh8","updated":"20240613150732"},"Children":[{"Type":"NodeText","Data":"蔓椒《千金翼方》"}]},{"ID":"20240613150728-og91xjw","Type":"NodeParagraph","Properties":{"id":"20240613150728-og91xjw","updated":"20240613150728"},"Children":[{"Type":"NodeText","Data":"味苦，温，无毒。主风寒湿痹，历节疼。除四肢厥气，膝痛。一名豕椒，一名猪椒，一名彘椒，一名狗椒。生云中川谷及丘冢间，采茎、根，煮酿酒。"}]},{"ID":"20240613150738-hyb8ji2","Type":"NodeThematicBreak","Properties":{"id":"20240613150738-hyb8ji2"}},{"ID":"20240613150739-dszofe5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150739-dszofe5","updated":"20240613150744"},"Children":[{"Type":"NodeText","Data":"蔓椒《本草经集注》"}]},{"ID":"20240613150739-itw5cyl","Type":"NodeParagraph","Properties":{"id":"20240613150739-itw5cyl","updated":"20240613150739"},"Children":[{"Type":"NodeText","Data":"味苦，温，无毒。主治风寒湿痹，历节疼痛，除四肢厥气，膝痛。一名豕椒，一名猪椒，一名彘椒，一名狗椒。生云中山川谷及丘冢间。采茎、根，煮酿酒。"}]},{"ID":"20240613150739-5y42p9b","Type":"NodeParagraph","Properties":{"id":"20240613150739-5y42p9b","updated":"20240613150739"},"Children":[{"Type":"NodeText","Data":"山野处处有，世呼为 ，似椒 ，小不香尔，一名 杀，可以蒸病出汗也。"}]},{"ID":"20240613150813-vfjpw23","Type":"NodeThematicBreak","Properties":{"id":"20240613150813-vfjpw23"}},{"ID":"20240613150814-1lv3jn8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150814-1lv3jn8","updated":"20240613150817"},"Children":[{"Type":"NodeText","Data":"蔓椒《医学入门》"}]},{"ID":"20240613150814-9jx5lnv","Type":"NodeParagraph","Properties":{"id":"20240613150814-9jx5lnv","updated":"20240613150814"},"Children":[{"Type":"NodeText","Data":"俗呼为 。山野处处有之。味苦，温，无毒。主风寒马痹历节疼，除四肢厥气膝痛及游蛊飞尸。"}]},{"ID":"20240613150814-u1e5q8q","Type":"NodeParagraph","Properties":{"id":"20240613150814-u1e5q8q","updated":"20240613150814"},"Children":[{"Type":"NodeText","Data":"可蒸病出汗。"}]},{"ID":"20240613150748-nkdioec","Type":"NodeThematicBreak","Properties":{"id":"20240613150748-nkdioec"}},{"ID":"20240613150749-rc5r1vz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150749-rc5r1vz","updated":"20240613150753"},"Children":[{"Type":"NodeText","Data":"蔓椒《名医别录》"}]},{"ID":"20240613150749-v1xeyz3","Type":"NodeParagraph","Properties":{"id":"20240613150749-v1xeyz3","updated":"20240613150749"},"Children":[{"Type":"NodeText","Data":"无毒．一名猪椒，一名彘椒，一名狗椒．生云中山及丘冢间．采茎、根煮酿酒．"}]},{"ID":"20240613150749-slr0ikb","Type":"NodeParagraph","Properties":{"id":"20240613150749-slr0ikb","updated":"20240613150749"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶蔓椒，味苦，温．主风寒湿痹，历节疼，除四肢厥气，膝痛．一名豕椒．生川谷．"}]},{"ID":"20240613150835-0e0y6ln","Type":"NodeThematicBreak","Properties":{"id":"20240613150835-0e0y6ln"}},{"ID":"20240613150836-kk2z6gm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150836-kk2z6gm","updated":"20240613150841"},"Children":[{"Type":"NodeText","Data":"猪椒根《本经逢原》"}]},{"ID":"20240613150836-lx9tacv","Type":"NodeParagraph","Properties":{"id":"20240613150836-lx9tacv","updated":"20240613150836"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即蔓椒"}]},{"ID":"20240613150836-lgqafcs","Type":"NodeParagraph","Properties":{"id":"20240613150836-lgqafcs","updated":"20240613150836"},"Children":[{"Type":"NodeText","Data":"苦温无毒。其叶七瓣者猪椒也。"}]},{"ID":"20240613150836-hw3w80s","Type":"NodeParagraph","Properties":{"id":"20240613150836-hw3w80s","updated":"20240613150836"},"Children":[{"Type":"NodeText","Data":"《本经》主风寒湿痹历节疼，除四肢厥气膝痛，煎汤蒸浴取汗。"}]},{"ID":"20240613150836-rnpyvhh","Type":"NodeParagraph","Properties":{"id":"20240613150836-rnpyvhh","updated":"20240613150836"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":" 猪椒根蔓生气臭，故能通经脉，去风毒湿痹。《千金》治肝虚劳损，关节骨疼痛，筋挛烦闷，虎骨酒用之。又取枝叶煎熬如饴，治通身水肿，每日空腹食之。"}]},{"ID":"20240613150759-p3vobyb","Type":"NodeThematicBreak","Properties":{"id":"20240613150759-p3vobyb"}},{"ID":"20240613150800-17wg4ia","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150800-17wg4ia","updated":"20240613150808"},"Children":[{"Type":"NodeText","Data":"蔓椒《神农本草经赞》"}]},{"ID":"20240613150800-qm2fokm","Type":"NodeParagraph","Properties":{"id":"20240613150800-qm2fokm","updated":"20240613150800"},"Children":[{"Type":"NodeText","Data":"味苦温。主风寒湿痹。节疼。除四肢厥气。膝痛。一名家椒。生川谷。及邱冢间。"}]},{"ID":"20240613150800-6744rp6","Type":"NodeParagraph","Properties":{"id":"20240613150800-6744rp6","updated":"20240613150800"},"Children":[{"Type":"NodeText","Data":"亦椒似。刺人衣。豢闻说彘。俗听呼。临风蔓弱。含露丛依。气蒸汤浴。汗雨频挥。"}]},{"ID":"20240613150800-fculjm2","Type":"NodeParagraph","Properties":{"id":"20240613150800-fculjm2","updated":"20240613150800"},"Children":[{"Type":"NodeText","Data":"陶弘景曰。俗呼为子。似椒而小。裴迪诗。丹刺人衣。李时珍曰。此椒气如豕。故有彘椒椒诸名。枝软如蔓。其子丛生。庄子。祝宗人说彘曰。吾将三月汝。汉乐府。妃呼。尔雅疏。郁气谓郁蒸之气也。礼。汤请浴。国语。挥汗成雨。陶弘景曰。可以蒸病出汗。"}]},{"ID":"20240613150655-fiue49z","Type":"NodeThematicBreak","Properties":{"id":"20240613150655-fiue49z"}},{"ID":"20240613150709-8t0i8k5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150709-8t0i8k5","updated":"20240613150713"},"Children":[{"Type":"NodeText","Data":"蔓椒《证类本草》"}]},{"ID":"20240613150709-9tex0k9","Type":"NodeParagraph","Properties":{"id":"20240613150709-9tex0k9","updated":"20240613150709"},"Children":[{"Type":"NodeText","Data":"味苦，温，无毒。主风寒湿痹，历节疼，除四肢厥气，膝痛。一名豕椒，一名猪椒，一名彘椒，一名狗椒。生云中川谷及丘冢间。采茎、根，煮酿酒。"}]},{"ID":"20240613150709-6qaxmtl","Type":"NodeParagraph","Properties":{"id":"20240613150709-6qaxmtl","updated":"20240613150709"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶山野处处有，俗呼为 ，似椒、 （音党），小不香尔。一名 椒。可以蒸病出汗也。"}]},{"ID":"20240613150709-pnpy37q","Type":"NodeParagraph","Properties":{"id":"20240613150709-pnpy37q","updated":"20240613150709"},"Children":[{"Type":"NodeText","Data":"图经文具蜀椒条下。"}]},{"ID":"20240613150709-j59md7o","Type":"NodeParagraph","Properties":{"id":"20240613150709-j59md7o","updated":"20240613150709"},"Children":[{"Type":"NodeText","Data":"食疗主贼风挛急。"}]},{"ID":"20240613150655-g6fyi9l","Type":"NodeThematicBreak","Properties":{"id":"20240613150655-g6fyi9l"}},{"ID":"20240613150656-jq25sl9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613150656-jq25sl9","updated":"20240613150703"},"Children":[{"Type":"NodeText","Data":"蔓椒《新修本草》"}]},{"ID":"20240613150656-1we893o","Type":"NodeParagraph","Properties":{"id":"20240613150656-1we893o","updated":"20240613150656"},"Children":[{"Type":"NodeText","Data":"味苦，温，无毒。主风寒湿痹，历节疼痛，除四肢厥气，膝痛。一名豕椒，一名猪椒，一中山川谷及丘冢间。采茎、根，煮酿酒。"}]},{"ID":"20240613150656-e64wojn","Type":"NodeParagraph","Properties":{"id":"20240613150656-e64wojn","updated":"20240613150656"},"Children":[{"Type":"NodeText","Data":"山野处处有，俗呼为 ，似椒 ，小不香尔，一名 杀，可以蒸病出汁也。"}]},{"ID":"20240613150657-n3zknnn","Type":"NodeThematicBreak","Properties":{"id":"20240613150657-n3zknnn"}},{"ID":"20240613150658-4jj2k1a","Type":"NodeParagraph","Properties":{"id":"20240613150658-4jj2k1a"}}]}