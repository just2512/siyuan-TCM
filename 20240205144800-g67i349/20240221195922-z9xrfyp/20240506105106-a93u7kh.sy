"},{"Type":"NodeLinkDest","Data":"assets/石南叶5-20240702151251-fdnmqxt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 524px;\" parent-style=\"width: 534px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠 7-20240827104805-trd39yc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702151445-flayzb8","Type":"NodeParagraph","Properties":{"id":"20240702151445-flayzb8","updated":"20240827104846"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 579px;","style":"width: 569px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠 5-20240827104527-3ongr99.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 569px;\" parent-style=\"width: 579px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠 8-20240827104846-9du7q1u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827104006-xtwuw2e","Type":"NodeParagraph","Properties":{"id":"20240827104006-xtwuw2e","updated":"20240827104855"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠 4-20240827104125-oya3dzi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 595px;","style":"width: 585px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠 3-20240827104006-sffbpu8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702151003-jy3z75a","Type":"NodeParagraph","Properties":{"id":"20240702151003-jy3z75a","updated":"20240827104857"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠果1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠果1-20240702151003-6phnbo1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 862px;","style":"width: 852px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石南果3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石南果3-20240702151109-5p88hvy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 852px;\" parent-style=\"width: 862px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827103530-e5f1rr4","Type":"NodeParagraph","Properties":{"id":"20240827103530-e5f1rr4","updated":"20240827104859"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠-20240827103530-ynslwg0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石楠树3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石楠树3-20240702150408-i2x0ysz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240613140834-3hk25dr","Type":"NodeThematicBreak","Properties":{"id":"20240613140834-3hk25dr"}},{"ID":"20240613141727-mpbmm49","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141727-mpbmm49","updated":"20240613141739"},"Children":[{"Type":"NodeText","Data":"石南《神农本草经》"}]},{"ID":"20240613141727-pcpo0pq","Type":"NodeParagraph","Properties":{"id":"20240613141727-pcpo0pq","updated":"20240613141727"},"Children":[{"Type":"NodeText","Data":"味辛苦。"}]},{"ID":"20240613141727-aow6vqm","Type":"NodeParagraph","Properties":{"id":"20240613141727-aow6vqm","updated":"20240613141727"},"Children":[{"Type":"NodeText","Data":"主养肾气，内伤，阴衰，利筋骨皮毛。实，杀蛊毒，破积聚，逐风痹。一名鬼目。生山谷。"}]},{"ID":"20240613141727-o9k9erd","Type":"NodeParagraph","Properties":{"id":"20240613141727-o9k9erd","updated":"20240613141727"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生华阴，二月四月采实，阴干。"}]},{"ID":"20240613141747-1v78vbx","Type":"NodeThematicBreak","Properties":{"id":"20240613141747-1v78vbx"}},{"ID":"20240613141748-70g1qu0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141748-70g1qu0","updated":"20240613141806"},"Children":[{"Type":"NodeText","Data":"石南《本草图经》"}]},{"ID":"20240613141748-zt0596w","Type":"NodeParagraph","Properties":{"id":"20240613141748-zt0596w","updated":"20240613141752"},"Children":[{"Type":"NodeText","Data":"石南，生华阴山谷，今南北皆有之。生于石上，株极有高硕者。江湖间出者，叶如枇杷叶，有小刺，凌冬不凋；春生白花成簇；秋结细红实。关陇间出者，叶似莽草，青黄色，背有紫点；雨多则并生，长及二、三寸；根横细，紫色，无花实；叶至茂密。南北人多移以植庭院间，阴翳可爱，不透日气。入药以关中叶细者良。二月、四月采叶；四月采实，阴干。《魏王花木记》曰∶南方石南木，取皮中作鱼羹，和之尤美。今不闻用之。下有楠材条，其木颇似石南，而更高硕，叶差小，其材中梁柱。今医方亦稀用之。"}]},{"ID":"20240613141824-xsycja6","Type":"NodeThematicBreak","Properties":{"id":"20240613141824-xsycja6"}},{"ID":"20240613141848-nuf1kg1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141848-nuf1kg1","updated":"20240613141853"},"Children":[{"Type":"NodeText","Data":"石南《本经逢原》"}]},{"ID":"20240613141848-zd67qga","Type":"NodeParagraph","Properties":{"id":"20240613141848-zd67qga","updated":"20240613141848"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即黄荆"}]},{"ID":"20240613141848-n1zwlmn","Type":"NodeParagraph","Properties":{"id":"20240613141848-n1zwlmn","updated":"20240613141848"},"Children":[{"Type":"NodeText","Data":"实苦温，根茎甘苦平，茎沥甘平无毒。"}]},{"ID":"20240613141848-wpnbcqq","Type":"NodeParagraph","Properties":{"id":"20240613141848-wpnbcqq","updated":"20240613141848"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"荆为治风逐湿、祛痰解热之药。实除骨间寒热下气，治心痛及妇人白带。炒熟酒煎服治小肠疝气。酒浸治耳聋。叶治霍乱转筋，下部湿 香港脚肿满，以荆茎入坛中烧烟熏涌泉穴及痛处，汗出则愈。捣烂罨蛇伤。根主头心肢体诸风，解肌发汗。茎治火灼疮烂。煎水漱风牙痛。荆沥除风热，开经络，导痰涎，行血气，解热痢。《千金翼》云，凡患风人多热，尝宜以竹沥、荆沥、姜汁和匀热服，以瘥为度。热多用竹沥，寒多用荆沥。二汁同用并以姜汁助送则不凝滞。但气虚不能食者则用竹沥，气实能食者则用荆沥。"}]},{"ID":"20240613141813-xn73ld3","Type":"NodeThematicBreak","Properties":{"id":"20240613141813-xn73ld3"}},{"ID":"20240613141814-5coxf2o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141814-5coxf2o","updated":"20240613141819"},"Children":[{"Type":"NodeText","Data":"石南《千金翼方》"}]},{"ID":"20240613141814-d0vssk1","Type":"NodeParagraph","Properties":{"id":"20240613141814-d0vssk1","updated":"20240613141814"},"Children":[{"Type":"NodeText","Data":"味辛苦，平，有毒。主养肾气，内伤阴衰，利筋骨皮毛，疗脚弱，五脏邪气，除热。女子不可久服，令思男，实∶杀蛊毒，破积聚，逐风痹。一名鬼目。生华阴山谷，二月四月采叶，八叶采实，阴干。"}]},{"ID":"20240613140834-1ege1v8","Type":"NodeThematicBreak","Properties":{"id":"20240613140834-1ege1v8"}},{"ID":"20240613141641-unapycr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141641-unapycr","updated":"20240613141653"},"Children":[{"Type":"NodeText","Data":"石南《证类本草》"}]},{"ID":"20240613141641-zntuyfl","Type":"NodeParagraph","Properties":{"id":"20240613141641-zntuyfl","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"味辛、苦，平，有毒。主养肾气，内伤阴衰，利筋骨皮毛，疗脚弱，五脏邪气，除热。女子不可久服，令思男。"}]},{"ID":"20240613141641-39xiq90","Type":"NodeParagraph","Properties":{"id":"20240613141641-39xiq90","updated":"20240613141641"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"杀蛊毒，破积聚，逐风痹。一名鬼目。生华阴山谷。二月、四月采叶，八月采实，阴干。（五加皮为之使。）"}]},{"ID":"20240613141641-99b3xha","Type":"NodeParagraph","Properties":{"id":"20240613141641-99b3xha","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今庐江及东间皆有之。叶状如枇杷叶。方用亦稀。唐本注云∶叶似 草，凌冬不凋。以叶细者为良，关中者好。为疗风邪丸散之要。其江山以南者，长大如枇杷叶，无气味，殊不任用。今医家不复用实。臣禹锡等谨按蜀本云∶终南斜谷近石处甚饶。今市人多以云∶石南，臣。主除热，恶小蓟，无毒。能添肾气，治软脚，烦闷疼，杀虫，能逐诸风，虽能养肾内，令人阴痿。"}]},{"ID":"20240613141641-u8jb9n8","Type":"NodeParagraph","Properties":{"id":"20240613141641-u8jb9n8","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"图经曰∶石南，生华阴山谷，今南北皆有之。生于石上，株极有高硕者。江湖间出，叶如枇杷叶，有小刺，凌冬不凋。春生白花成簇。秋结细红实。关陇间出者，叶似莽草，青黄色，背有紫点，雨多则并生，长及二、三寸。根横细，紫色。无花实，叶至茂密。南北人多移以植庭宇间，阴翳可爱，不透日气。入药以关中叶细者良。二月、四月采叶，四月采实，阴干。《魏王花木记》曰∶南方∶石南木，取皮中作鱼羹，和之尤美。今不闻用之。"}]},{"ID":"20240613141641-0t3zt6n","Type":"NodeParagraph","Properties":{"id":"20240613141641-0t3zt6n","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"下有楠材条，其木颇似石南，而更高硕。叶差小，其材中梁柱，今医方亦稀用之。"}]},{"ID":"20240613141641-gi2hnhy","Type":"NodeParagraph","Properties":{"id":"20240613141641-gi2hnhy","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"衍义曰∶石南，叶状如枇杷叶之小者，但背无毛，光而不皱。正、二月间开花。冬有二叶为花苞，苞既开，中有十五余花，大小如椿花，甚细碎。每一苞约弹许大，成一球。一花六叶，一朵有七、八球，淡白绿色，叶末微淡赤色。花既开，蕊满花，但见蕊，不见花。花才罢，去年绿叶尽脱落，渐生新叶。治肾衰脚弱最相宜。"}]},{"ID":"20240613141641-ph9j1ij","Type":"NodeParagraph","Properties":{"id":"20240613141641-ph9j1ij","updated":"20240613141641"},"Children":[{"Type":"NodeText","Data":"但京洛、河北、河东、山东颇少，人以此故少用。湖南北、江东西、二浙甚多，故多用，南实今医家绝可用。"}]},{"ID":"20240613140834-479gm22","Type":"NodeThematicBreak","Properties":{"id":"20240613140834-479gm22"}},{"ID":"20240613141630-qcvsb0u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613141630-qcvsb0u","updated":"20240613141635"},"Children":[{"Type":"NodeText","Data":"石南《本草纲目》"}]},{"ID":"20240613141630-023htxl","Type":"NodeParagraph","Properties":{"id":"20240613141630-023htxl","updated":"20240613141630"},"Children":[{"Type":"NodeText","Data":"「释名」风药。"}]},{"ID":"20240613141630-h71onli","Type":"NodeParagraph","Properties":{"id":"20240613141630-h71onli","updated":"20240613141630"},"Children":[{"Type":"NodeText","Data":"「气味」（叶）辛、苦、平、有毒。"}]},{"ID":"20240613141630-psyqtkb","Type":"NodeParagraph","Properties":{"id":"20240613141630-psyqtkb","updated":"20240613141630"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613141630-22o9thk","Type":"NodeParagraph","Properties":{"id":"20240613141630-22o9thk","updated":"20240613141630"},"Children":[{"Type":"NodeText","Data":"1、鼠瘘不合。用石南、生地黄、茯苓、黄蘖、雌黄、等分为末，每天敷患处两次。"}]},{"ID":"20240613141630-0lm8363","Type":"NodeParagraph","Properties":{"id":"20240613141630-0lm8363","updated":"20240613141630"},"Children":[{"Type":"NodeText","Data":"2、小儿通睛（小儿误跌或头脑受伤，致使瞳仁不正，观东则见西，观西则见东）。用石南一两、藜芦三分、瓜丁五至七个，共研为末。每次吹少许入鼻中，一天三次。内服牛黄平肝的药物，此方名“石南散”。"}]},{"ID":"20240613142009-n8bwjex","Type":"NodeThematicBreak","Properties":{"id":"20240613142009-n8bwjex"}},{"ID":"20240613142013-dguaxal","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142013-dguaxal","updated":"20240613142020"},"Children":[{"Type":"NodeText","Data":"石南叶《本草述钩元》"}]},{"ID":"20240613142013-bl73lwi","Type":"NodeParagraph","Properties":{"id":"20240613142013-bl73lwi","updated":"20240613142013"},"Children":[{"Type":"NodeText","Data":"生于石间向阳处。故名。叶似枇杷。叶之小者。其背无毛。光而不皱。凌冬不凋。"}]},{"ID":"20240613142013-w8xb46w","Type":"NodeParagraph","Properties":{"id":"20240613142013-w8xb46w","updated":"20240613142013"},"Children":[{"Type":"NodeText","Data":"有二叶为花苞。二月开时如椿花。甚细碎。花罢渐生新叶。湖南北江西二浙甚多。（宗）味辛苦。气平。有小毒。可升可降。阴中阳也。入足厥阴少阴经。五加皮为之使。恶小蓟。主益肾气内伤阴衰。疗脚弱五脏邪气。除热。利筋骨皮毛。杀虫。逐诸风。浸酒饮。治头风。女子久服。令思男。能强肾治风痹。肾弱为要药。（濒湖）石南得火金之气。观其用当是金胜火微。止应有小毒。少阴属水。得金气之浓者。能生水。故养肾气。又肾肝在下而主筋骨。得所养则内伤阴衰自起。筋骨皮毛自利。脚弱自健也。（仲淳）同巴戟苁蓉锁阳鹿茸山萸枸杞。治肾经虚寒。精滑精冷。同白蒺藜桑叶首乌巴戟仙灵脾五加皮菟丝子威灵仙虎骨。治肝肾为风寒湿所乘。以致痹弱不能行动。小儿通睛。因误跌或打着头脑受惊。肝系受风。瞳仁不正。观东则见西。观西则见东。用石南散吹鼻通顶。石南一两。藜芦三分。瓜丁五七个。为末。每吹少许入鼻。一日三度。内服牛黄平肝药。"}]},{"ID":"20240613142013-ei8dsn3","Type":"NodeParagraph","Properties":{"id":"20240613142013-ei8dsn3","updated":"20240613142013"},"Children":[{"Type":"NodeText","Data":"〔论〕石南叶凌冬不凋。具足水中之阳。观其花于春。而叶即随发。是本水中元气以畅春木生化之用者。其味辛。是木媾于金而元气得以上达也。本经所云益肾气。盖益肾中阴气。（惟益阴气。故能疗五脏邪气。除热又逐诸风。）女子久服思男者。乃阴气盛则趋阳以化也。夫阴气盛而趋阳以化。则出地之风化得其正而风眚平。（阴气不足。则阳无以化而为风。"}]},{"ID":"20240613142013-pd3mzy0","Type":"NodeParagraph","Properties":{"id":"20240613142013-pd3mzy0","updated":"20240613142013"},"Children":[{"Type":"NodeText","Data":"阳之微。先于治风。在中风证多用之。亦以疗热痹。若不知本于肾气具足而趋所生。只等于辛散之风剂。则失之远矣。"}]},{"ID":"20240613142013-8169857","Type":"NodeParagraph","Properties":{"id":"20240613142013-8169857","updated":"20240613142013"},"Children":[{"Type":"NodeText","Data":"〔修治〕三四月采叶。阴干用。"}]},{"ID":"20240613142029-cpdm7f6","Type":"NodeThematicBreak","Properties":{"id":"20240613142029-cpdm7f6"}},{"ID":"20240613142031-s0zur8r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142031-s0zur8r","updated":"20240613142036"},"Children":[{"Type":"NodeText","Data":"石南叶《本草备要》"}]},{"ID":"20240613142031-jsdwgjc","Type":"NodeParagraph","Properties":{"id":"20240613142031-jsdwgjc","updated":"20240613142031"},"Children":[{"Type":"NodeText","Data":"宣，去风，补肾"}]},{"ID":"20240613142031-lj91fvy","Type":"NodeParagraph","Properties":{"id":"20240613142031-lj91fvy","updated":"20240613142031"},"Children":[{"Type":"NodeText","Data":"辛散风、苦坚肾。补内伤阴衰，利筋骨皮毛，为治肾虚、脚弱、风痹要药。妇人不可久服，令思男（时珍曰∶今人绝不知用，盖为《药性论》有令人阴痿之说也。不知此药能令肾强，人或借此纵欲，以致痿弱，归咎于药，良可慨也。昂按∶石南补阴祛风则有之，然味辛不热，不助相火，亦未闻淫邪方中用石南者，《别录》思男之说，殆不可信）。"}]},{"ID":"20240613142031-ukbma6a","Type":"NodeParagraph","Properties":{"id":"20240613142031-ukbma6a","updated":"20240613142031"},"Children":[{"Type":"NodeText","Data":"关中者佳。炙用。"}]},{"ID":"20240613142051-hz6m4la","Type":"NodeThematicBreak","Properties":{"id":"20240613142051-hz6m4la"}},{"ID":"20240613142052-k2wj9xo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142052-k2wj9xo","updated":"20240613142057"},"Children":[{"Type":"NodeText","Data":"石南叶《药性切用》"}]},{"ID":"20240613142052-w81ep4z","Type":"NodeParagraph","Properties":{"id":"20240613142052-w81ep4z","updated":"20240613142052"},"Children":[{"Type":"NodeText","Data":"辛苦性平，入肾而祛风坚肾，通利关节，为脚弱、风痹专药。微炒用。"}]},{"ID":"20240613142052-s45jx45","Type":"NodeParagraph","Properties":{"id":"20240613142052-s45jx45","updated":"20240613142052"},"Children":[{"Type":"NodeText","Data":"蔓荆子苦辛性平，入肝搜风，而治头痛齿痛，为轻浮疏散风热之专药。"}]},{"ID":"20240613142114-33qj0fj","Type":"NodeThematicBreak","Properties":{"id":"20240613142114-33qj0fj"}},{"ID":"20240613142115-3x33wxp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142115-3x33wxp","updated":"20240613142121"},"Children":[{"Type":"NodeText","Data":"石南叶《医学入门》"}]},{"ID":"20240613142115-by6mrul","Type":"NodeParagraph","Properties":{"id":"20240613142115-by6mrul","updated":"20240613142115"},"Children":[{"Type":"NodeText","Data":"石南叶辛苦却平，筋骨皮毛最灵，养肾强阴疗脚弱，痹风蛊毒子堪凭。"}]},{"ID":"20240613142115-0nhiyk6","Type":"NodeParagraph","Properties":{"id":"20240613142115-0nhiyk6","updated":"20240613142115"},"Children":[{"Type":"NodeText","Data":"生终南石上，如枇杷叶，无毛。有毒。女人久服思男。初夏采。猪脂炒，五加皮使。"}]},{"ID":"20240613142101-3biw6hs","Type":"NodeThematicBreak","Properties":{"id":"20240613142101-3biw6hs"}},{"ID":"20240613142103-fg4bbds","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142103-fg4bbds","updated":"20240613142109"},"Children":[{"Type":"NodeText","Data":"石南叶《本草撮要》"}]},{"ID":"20240613142103-7gn7t3v","Type":"NodeParagraph","Properties":{"id":"20240613142103-7gn7t3v","updated":"20240613142103"},"Children":[{"Type":"NodeText","Data":"味辛苦平有毒．入足厥阴经．功专治风痹脚弱．得藜芦瓜丁共为末．吹入鼻少许．一日三度．内服牛黄平肝药．治小儿通睛．炙用．五加皮为使．恶小蓟．"}]},{"ID":"20240613142041-ofsa2tm","Type":"NodeThematicBreak","Properties":{"id":"20240613142041-ofsa2tm"}},{"ID":"20240613142043-i38hkg0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613142043-i38hkg0","updated":"20240613142047"},"Children":[{"Type":"NodeText","Data":"石南叶《本草求真》"}]},{"ID":"20240613142043-46wvf99","Type":"NodeParagraph","Properties":{"id":"20240613142043-46wvf99","updated":"20240613142043"},"Children":[{"Type":"NodeText","Data":"（灌木）祛风逐热固肾"}]},{"ID":"20240613142043-mt8o1pv","Type":"NodeParagraph","Properties":{"id":"20240613142043-mt8o1pv","updated":"20240613142043"},"Children":[{"Type":"NodeText","Data":"石南叶（专入肝。）味辛而苦。按辛则有发散之能。苦则具有坚肾之力。若使辛苦而热。则云妇人久服思男。其理或可信矣。然此止属辛苦而性不热。则治止可以言祛风。而补阴之说。亦止因苦坚肾。而肾不泄。因辛散风。而阴不受其蹂躏也。（的解）若竟以为补阴。则理已属有碍。而尚可云以思男者乎？（医书类多如此惑人。）若果有之。则凡类于此者。何莫不为思男之品。而附桂之雄。又将置之于何等地矣。李时珍亦明医中人。何竟附和而有是言耶。 庵之辟。宜其有是。（汪昂曰。按石南叶补阴祛风则有之。然味辛不热。不助相火。亦未闻邪淫方中用石南叶者。别录思男之说。殆不可信。）出关中者炙用。五加皮为使。恶小蓟。"}]},{"ID":"20240613140836-9xik9yh","Type":"NodeThematicBreak","Properties":{"id":"20240613140836-9xik9yh"}},{"ID":"20240613141502-8j9cafu","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240613141502-8j9cafu","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"石南"}]},{"ID":"20240613141502-wkkgbnq","Type":"NodeParagraph","Properties":{"id":"20240613141502-wkkgbnq","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613141502-93ylnz0","Type":"NodeParagraph","Properties":{"id":"20240613141502-93ylnz0","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" Shí Nán"}]},{"ID":"20240613141502-mf3sy0y","Type":"NodeParagraph","Properties":{"id":"20240613141502-mf3sy0y","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613141502-tny5ik8","Type":"NodeParagraph","Properties":{"id":"20240613141502-tny5ik8","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 风药、栾茶"}]},{"ID":"20240613141502-vwuid3v","Type":"NodeParagraph","Properties":{"id":"20240613141502-vwuid3v","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613141502-3kxu31e","Type":"NodeParagraph","Properties":{"id":"20240613141502-3kxu31e","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" Chinese Photinia Leaf"}]},{"ID":"20240613141502-0m02vvt","Type":"NodeParagraph","Properties":{"id":"20240613141502-0m02vvt","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613141502-sggyqjs","Type":"NodeParagraph","Properties":{"id":"20240613141502-sggyqjs","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 出自1.《别录》：石南，生华阴山谷。二月、四月采叶，八月采实，阴干。"}]},{"ID":"20240613141502-nu83jc8","Type":"NodeParagraph","Properties":{"id":"20240613141502-nu83jc8","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：石南叶似菵草，凌冬不雕，以叶细者为良，关中者好，为疗风邪丸散之要。其江山已南者长大如枇杷叶，无气味，殊不任用。今医家不复用实。"}]},{"ID":"20240613141502-3kfvvpg","Type":"NodeParagraph","Properties":{"id":"20240613141502-3kfvvpg","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，石南，终南斜谷近石处甚饶。今布人多以瓦韦为石韦，以石韦为石南。不可不审之。"}]},{"ID":"20240613141502-rgzwytq","Type":"NodeParagraph","Properties":{"id":"20240613141502-rgzwytq","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：石南，株极有高大者，江湖间出，叶如枇杷叶，有小"}]},{"ID":"20240613141502-oj2l0rg","Type":"NodeParagraph","Properties":{"id":"20240613141502-oj2l0rg","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613141502-vxulkbp","Type":"NodeParagraph","Properties":{"id":"20240613141502-vxulkbp","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物石楠的叶或带叶嫩枝。"}]},{"ID":"20240613141502-zc9c6t9","Type":"NodeParagraph","Properties":{"id":"20240613141502-zc9c6t9","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Photinia serrulata Lindl．"}]},{"ID":"20240613141502-c2rwxyb","Type":"NodeParagraph","Properties":{"id":"20240613141502-c2rwxyb","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，但以夏、秋两季采收者为佳，采后晒干即可。"}]},{"ID":"20240613141502-d2qs22h","Type":"NodeParagraph","Properties":{"id":"20240613141502-d2qs22h","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613141502-vo3f07s","Type":"NodeParagraph","Properties":{"id":"20240613141502-vo3f07s","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1000-2500m的杂木林中。"}]},{"ID":"20240613141502-pbxtlkw","Type":"NodeParagraph","Properties":{"id":"20240613141502-pbxtlkw","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、甘肃、江苏、安徽、浙江、江西、福建、台湾、河南、湖北、湖南、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240613141502-szlwmsg","Type":"NodeParagraph","Properties":{"id":"20240613141502-szlwmsg","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613141502-7woexfe","Type":"NodeParagraph","Properties":{"id":"20240613141502-7woexfe","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 石楠 常绿灌木或小乔木，高4-6m，有时可达12m。小枝褐灰色，无毛。叶互生；叶柄粗壮，长2-4cm，老时无毛；叶片革质，长椭圆形、长倒卵形或倒卵状椭圆形，长9-22cm，宽3-6.5cm，先端尾尖，基部圆形或宽楔形，边缘有疏生具腺细锯齿，近基部全缘，上面光亮，幼时中脉有绒毛，成熟后两面皆无毛。"}]},{"ID":"20240613141502-pkwm5d9","Type":"NodeParagraph","Properties":{"id":"20240613141502-pkwm5d9","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"本种叶片形变异较大，幼苗期锯齿有针刺。花两性；复伞房花序顶生，总花梗和花梗无毛；花便长3-5mm；花密生，直径6-8mm；萼筒杯状，长约1mm；萼片5，阔三角形，长约1mm，先端急尖；花瓣5，白色，近圆形，直径3-4mm；雄蕊20，外轮较花瓣长，内轮较花瓣短，花药带紫色；花柱2，有时为3，基部合生，柱头头状，子房先端有柔毛。梨果球形，直径5-6mm，红色，鲜艳着目，后成褐紫色。种子1颗，卵形，长2mm，棕色，平滑。花期4-5月，果期10月。"}]},{"ID":"20240613141502-2hegdvi","Type":"NodeParagraph","Properties":{"id":"20240613141502-2hegdvi","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613141502-yepoxte","Type":"NodeParagraph","Properties":{"id":"20240613141502-yepoxte","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，茎呈圆柱形，直径0.4-0.8cm，有分枝；表面暗灰棕色，有纵皱纹，皮孔呈细点状；质坚脆，易折断，断面皮部薄，暗棕色，木部黄白色，裂片状。叶互生，具柄，长1-4cm，上面有一纵槽；叶片长椭圆形或倒卵状椭圆形，长8-15cm，宽2-6cm；先端尖或突尖，基部近圆形或楔形，边缘具细密的锯齿，齿端棕色，但在幼时及萌牙枝上的叶缘具芒状锯齿；上面棕色或棕绿色，无毛，羽状脉，中脉凹入。下面中脉明显突出。叶片革质而脆。气微，茎微苦，叶微涩。以枝嫩、条匀、叶完整无碎者为佳。"}]},{"ID":"20240613141502-hpkjdtx","Type":"NodeParagraph","Properties":{"id":"20240613141502-hpkjdtx","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"显微鉴别，叶横切面：上、下表皮均为1列近方形细胞，外侧被角质层。叶肉组织栅状细胞3-4列，不通过主脉，海绵组织疏松，中脉向下突出，上、下表皮内侧各有3-4列厚角细胞，壁角质化；维管束呈“U”字形，中柱鞘纤维与含黄色物质的薄壁细胞相间排列成继续的半球形。中脉部的厚角细胞、薄壁细胞、韧皮部和叶肉组织细胞中含草酸钙棱晶和簇晶。含黄色物质的细脉散在于海绵组织及中脉的薄壁组织中尤其是中脉维管束的周围为多。"}]},{"ID":"20240613141502-hkjpyzh","Type":"NodeParagraph","Properties":{"id":"20240613141502-hkjpyzh","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"叶表面观：上表皮细胞多角形，垂周壁平直，平周壁角质化，无气孔。下表皮细胞稍小，垂周壁平直，气孔稠密，不定式，副卫细胞4-8个。"}]},{"ID":"20240613141502-gta7jos","Type":"NodeParagraph","Properties":{"id":"20240613141502-gta7jos","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"粉末特征：棕色。纤维众多，无色或淡黄色，多成束，破碎，直径约13μm，周围薄壁细胞内含有草酸钙方晶形成晶鞘纤维。草酸钙方晶易察见，直径7-33μm。草酸钙簇晶，多存于叶肉薄壁细胞内，直径16-33μm。"}]},{"ID":"20240613141502-7bfjed6","Type":"NodeParagraph","Properties":{"id":"20240613141502-7bfjed6","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613141502-telkxpy","Type":"NodeParagraph","Properties":{"id":"20240613141502-telkxpy","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 对大鼠毒性较小，60及100mg／kg，服一个月，对生长无影响，肝及脂质代谢亦无改变。日本使用之石南乃杜鹃花属植物Rhododendron metternichii S. et Z.，其毒性（小鼠）较石南强2-3倍，能引起痉挛，二者不应混淆。"}]},{"ID":"20240613141502-kdind5y","Type":"NodeParagraph","Properties":{"id":"20240613141502-kdind5y","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613141502-mkeggxc","Type":"NodeParagraph","Properties":{"id":"20240613141502-mkeggxc","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 叶、枝含氰甙（Cyanophorie glycoside），根中不含。叶含游离的氢氰酸，其含量变化较大，约为0.015%-0.120%；另含野樱皮甙（prunasin）,水解后得葡萄糖、苯甲醛及氢氰酸。"}]},{"ID":"20240613141502-z1euty3","Type":"NodeParagraph","Properties":{"id":"20240613141502-z1euty3","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613141502-zf52fnm","Type":"NodeParagraph","Properties":{"id":"20240613141502-zf52fnm","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 10%叶浸剂在试管内可杀死日本血吸虫尾蚴，也能杀灭钉螺。70%叶乙醇浸出液能抑制离体蛙心，收缩离体兔耳血管，抑制离体肠管，降低麻醉犬血压。有强心、利尿、抑菌作用。3.7%煎剂对离体蛙心、100%煎剂经淋巴囊给药对在体蛙心，或75%煎剂10ml静脉注射对在体兔心均有兴奋作用。"}]},{"ID":"20240613141502-maiqx77","Type":"NodeParagraph","Properties":{"id":"20240613141502-maiqx77","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613141502-0i6o1mv","Type":"NodeParagraph","Properties":{"id":"20240613141502-0i6o1mv","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 洗净，微润,切丝晒干。"}]},{"ID":"20240613141502-62bcsjp","Type":"NodeParagraph","Properties":{"id":"20240613141502-62bcsjp","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613141502-2cf958r","Type":"NodeParagraph","Properties":{"id":"20240613141502-2cf958r","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 理化鉴别（1）取本品粉1g，加甲醇10ml，在水浴上回流提取1h，用滤液作下述试验：1.取上述甲醇提取液1ml，加镁粉少许，加浓盐酸4-5滴，在水浴上加热，即显要橙红色。2.取上述甲醇提取液1ml，置蒸发皿中在水浴上蒸干，加饮和硼酸丙酮溶液和10%枸椽酸溶液各1ml，继续蒸干，将残渣在紫外光灯下观察，可见强裂的黄绿光荧光。"}]},{"ID":"20240613141502-mpu02kq","Type":"NodeParagraph","Properties":{"id":"20240613141502-mpu02kq","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.5g，置试管中加水少许，使之湿润。试管加塞，寒与管壁间悬挂一条用苦味酸盐溶液湿润过的滤纸，将试管置60-70℃水浴中加热约15min，试纸显砖红色。"}]},{"ID":"20240613141502-r8y1azi","Type":"NodeParagraph","Properties":{"id":"20240613141502-r8y1azi","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醇10ml，温浸30min，滤过，取滤液2滴，点于滤纸上，滴加三氯醋酸试剂1-2滴，加热至100℃始显浅红色，渐变为淡紫色。"}]},{"ID":"20240613141502-7asgsxh","Type":"NodeParagraph","Properties":{"id":"20240613141502-7asgsxh","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613141502-l79r5us","Type":"NodeParagraph","Properties":{"id":"20240613141502-l79r5us","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240613141502-jiyu57o","Type":"NodeParagraph","Properties":{"id":"20240613141502-jiyu57o","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613141502-cnb3246","Type":"NodeParagraph","Properties":{"id":"20240613141502-cnb3246","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性平；小毒"}]},{"ID":"20240613141502-rolfety","Type":"NodeParagraph","Properties":{"id":"20240613141502-rolfety","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613141502-t4opjny","Type":"NodeParagraph","Properties":{"id":"20240613141502-t4opjny","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 祛风湿；止痒；强筋骨；益肝肾。主风湿痹痛；头风头痛；风疹；脚膝痿弱；肾虚腰痛；阳痿；遗精"}]},{"ID":"20240613141502-abznfux","Type":"NodeParagraph","Properties":{"id":"20240613141502-abznfux","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613141502-84wi6ec","Type":"NodeParagraph","Properties":{"id":"20240613141502-84wi6ec","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：适量，研末撒或吹鼻。"}]},{"ID":"20240613141502-vfulior","Type":"NodeParagraph","Properties":{"id":"20240613141502-vfulior","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613141502-erebnak","Type":"NodeParagraph","Properties":{"id":"20240613141502-erebnak","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 石南丸《圣济总录》：去风湿、活血脉。石南酒《圣济总录》：风疹不解；石南散《普济方》：息风定志。"}]},{"ID":"20240613141502-ul7ke8d","Type":"NodeParagraph","Properties":{"id":"20240613141502-ul7ke8d","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613141502-rh6ier5","Type":"NodeParagraph","Properties":{"id":"20240613141502-rh6ier5","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：石南，古方为治风痹肾弱要药，今人绝不知用，识者亦少，盖由甄氏《药性论》有令阴痿之说也。殊不知服此药者，能令肾强，嗜欲之人，借此放恣，以致痿弱，归咎于药，良可慨也。"}]},{"ID":"20240613141502-gbcba48","Type":"NodeParagraph","Properties":{"id":"20240613141502-gbcba48","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"2.《本草从新》：石楠叶祛风通利，是其所长，补肾之说，未可信也。《本经》：破积聚，逐风痹。"}]},{"ID":"20240613141502-oviumu2","Type":"NodeParagraph","Properties":{"id":"20240613141502-oviumu2","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613141502-fwvfhq9","Type":"NodeParagraph","Properties":{"id":"20240613141502-fwvfhq9","updated":"20240613141502"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613141503-gfh67az","Type":"NodeThematicBreak","Properties":{"id":"20240613141503-gfh67az"}},{"ID":"20240613141504-bdpm0cw","Type":"NodeParagraph","Properties":{"id":"20240613141504-bdpm0cw"}}]}