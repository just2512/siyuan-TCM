{"ID":"20240506105106-a93u7kh","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506105106-a93u7kh","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506105106-a93u7kh\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506105106-zby2zp0\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613141504-bdpm0cw\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240613142115-3x33wxp\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"323石楠（石南）","type":"doc","updated":"20240827104859"},"Children":[{"ID":"20240702151402-ojqfanx","Type":"NodeParagraph","Properties":{"id":"20240702151402-ojqfanx","updated":"20240702151402"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 338px;","style":"width: 328px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702151402-k4gdx82.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 328px;\" parent-style=\"width: 338px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702150803-25oq4y8","Type":"NodeParagraph","Properties":{"id":"20240702150803-25oq4y8","updated":"20240702151424"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石南1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石南1-20240702150803-4406bji.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"pa