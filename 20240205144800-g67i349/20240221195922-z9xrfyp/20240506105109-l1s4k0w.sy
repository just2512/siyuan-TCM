"width: 587px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240827173318-fm2uiym","Type":"NodeParagraph","Properties":{"id":"20240827173318-fm2uiym","updated":"20240827173354"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 636px;","style":"width: 626px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麋鹿 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麋鹿 1-20240827173317-g1g7qth.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 626px;\" parent-style=\"width: 636px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麋鹿 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麋鹿 2-20240827173354-9xkjpo1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703084238-ghnplne","Type":"NodeParagraph","Properties":{"id":"20240703084238-ghnplne","updated":"20240827173233"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 759px;","style":"width: 749px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麋鹿4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麋鹿4-20240703084629-4pcytm1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 749px;\" parent-style=\"width: 759px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 407px;","style":"width: 397px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麋鹿3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麋鹿3-20240703084206-ojodai4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 397px;\" parent-style=\"width: 407px;\"}"},{"Type":"NodeText","Data":"​​​​​​​​​"}]},{"ID":"20240613153130-8r60b7m","Type":"NodeParagraph","Properties":{"id":"20240613153130-8r60b7m","updated":"20240703084028"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为麋鹿脂肪。"}]},{"ID":"20240613153130-k2lqy13","Type":"NodeThematicBreak","Properties":{"id":"20240613153130-k2lqy13"}},{"ID":"20240613153549-mzcgvqy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153549-mzcgvqy","updated":"20240613153555"},"Children":[{"Type":"NodeText","Data":"麋脂《神农本草经》"}]},{"ID":"20240613153549-4m06p9q","Type":"NodeParagraph","Properties":{"id":"20240613153549-4m06p9q","updated":"20240613153549"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240613153549-5a32861","Type":"NodeParagraph","Properties":{"id":"20240613153549-5a32861","updated":"20240613153549"},"Children":[{"Type":"NodeText","Data":"主痈肿，恶创，死肌，寒风，湿痹，四肢拘缓不收，风头，肿气，通凑理。一名官脂。生山谷。"}]},{"ID":"20240613153549-o351nej","Type":"NodeParagraph","Properties":{"id":"20240613153549-o351nej","updated":"20240613153549"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生南山及淮海边，十月取。"}]},{"ID":"20240613153549-jotzt0b","Type":"NodeParagraph","Properties":{"id":"20240613153549-jotzt0b","updated":"20240613153549"},"Children":[{"Type":"NodeText","Data":"案《说文》云：麋，鹿属，冬至解其角。汉书云：刘向以为麋之为言迷也。盖牝兽之淫者也。"}]},{"ID":"20240613153131-qsfyrrp","Type":"NodeThematicBreak","Properties":{"id":"20240613153131-qsfyrrp"}},{"ID":"20240613153306-ct3c3ua","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153306-ct3c3ua","updated":"20240613153311"},"Children":[{"Type":"NodeText","Data":"麋脂《证类本草》"}]},{"ID":"20240613153306-i0rwuxg","Type":"NodeParagraph","Properties":{"id":"20240613153306-i0rwuxg","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主痈肿、恶疮、死肌，寒风湿痹，四肢拘缓不收，风头肿气，通腠理，柔皮肤。不可近阴，令痿。一名官脂。（畏大黄。）"}]},{"ID":"20240613153306-y7z12re","Type":"NodeParagraph","Properties":{"id":"20240613153306-y7z12re","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按孟诜云∶麋肉，益气补中，治腰脚。不与雉肉同食。谨按肉多无功用，所食亦微补五脏，不足气，多食令人弱房，发香港脚。骨，除虚劳至良。可煮骨作汁，酿酒饮之，令人肥白，美颜色。"}]},{"ID":"20240613153306-usu4k6f","Type":"NodeParagraph","Properties":{"id":"20240613153306-usu4k6f","updated":"20240613153306"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"角"},{"Type":"NodeText","Data":"味甘，无毒。主痹，止血，益气力。生南山山谷及淮海边。十月取。"}]},{"ID":"20240613153306-0duj7fz","Type":"NodeParagraph","Properties":{"id":"20240613153306-0duj7fz","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今海陵间最多，千百为群，多牝少牡。人言一牡辄交十余牝，交毕即死。其脂堕土中，经年，人得之方∶好，名曰遁脂，酒服至良。寻麋性乃尔淫快，不应痿人阴。一方∶言不可近阴，令阴不痿，此乃有理。麋肉不可合虾及生菜、梅、李、果实食之，皆病患。其角刮唐本注云∶麋茸，服之功力胜鹿茸，煮为胶亦胜白胶。言游牝毕即死者，此亦虚传，遍问山泽人，不闻游牝因致死者。"}]},{"ID":"20240613153306-0w8h3kg","Type":"NodeParagraph","Properties":{"id":"20240613153306-0w8h3kg","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按补虚劳，填髓。理角法∶可五寸截之，中破，炙令黄香后末。和酒空腹服三钱匕。若卒心痛，一服立瘥。常服之令人赤白如花，益阳道，不知何因与肉功不同尔。亦可煎作胶，与鹿角胶同功。茸，甚胜鹿茸，仙方∶甚重。又丈夫冷气及风，筋骨疼痛。作粉长服。又于浆水中研为泥，涂面令不皱，光华可爱。又常俗人以皮作靴熏脚气。陈士良云∶麋，大日华子云∶角，添精补髓，益血脉，暖腰膝，悦色，壮阳，疗风气，偏治丈夫胜鹿角。按《月令》∶麋角属阴，夏至角解，盖一阴生也。治腰膝不仁，补一切血病也。"}]},{"ID":"20240613153306-t0e2jy8","Type":"NodeParagraph","Properties":{"id":"20240613153306-t0e2jy8","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"图经文具第十七卷鹿茸条下。"}]},{"ID":"20240613153306-glfldwt","Type":"NodeParagraph","Properties":{"id":"20240613153306-glfldwt","updated":"20240613153306"},"Children":[{"Type":"NodeText","Data":"肘后方∶葛氏疗年少气盛，面主 疮，涂麋脂即瘥。经验方∶治老人骨髓虚竭。补益麋茸煎∶麋茸五两，去毛，涂酥炙微黄为末，以清酒二升，于银锅中慢火熬成膏，盛瓷器中。每服半匙，温水调下，空心食前服。何君谟云按《礼记·月令》∶仲夏鹿角解，仲冬麋角解。日华子兽，夏至得阴气而解角，麋是泽兽，故冬象。鹿是阳兽，情淫而游山，夏至得阴而解角，从阳退之象。沈存中笔谈麋茸利补阳，鹿茸利补阴，壮骨髓。茹茸太嫩长数寸，破之如朽木。端如玛KT 红玉者最善。青麋大鹿也。不如麂，似獐有毒。"}]},{"ID":"20240613153131-hgf2f4k","Type":"NodeThematicBreak","Properties":{"id":"20240613153131-hgf2f4k"}},{"ID":"20240613153146-lz0etqh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153146-lz0etqh","updated":"20240613153153"},"Children":[{"Type":"NodeText","Data":"麋脂《千金翼方》"}]},{"ID":"20240613153146-u24v7ji","Type":"NodeParagraph","Properties":{"id":"20240613153146-u24v7ji","updated":"20240613153146"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主痈肿，恶疮死肌，寒风湿痹，四肢拘缓不收，风头肿气，通腠理，柔皮肤，不可近阴令痿。一名宫脂。"}]},{"ID":"20240613153146-nl8r27h","Type":"NodeParagraph","Properties":{"id":"20240613153146-nl8r27h","updated":"20240613153146"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"角"}]},{"ID":"20240613153146-b0hg8pg","Type":"NodeParagraph","Properties":{"id":"20240613153146-b0hg8pg","updated":"20240613153146"},"Children":[{"Type":"NodeText","Data":"味甘，无毒。主痹止血，益气力，生南山山谷及淮海边，十月取。"}]},{"ID":"20240613153613-sp96zg8","Type":"NodeThematicBreak","Properties":{"id":"20240613153613-sp96zg8"}},{"ID":"20240613153616-jpgwjp4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153616-jpgwjp4","updated":"20240613153631"},"Children":[{"Type":"NodeText","Data":"麋脂《备急千金要方》"}]},{"ID":"20240613153614-s520gt4","Type":"NodeParagraph","Properties":{"id":"20240613153614-s520gt4","updated":"20240613153614"},"Children":[{"Type":"NodeText","Data":"麋脂，味辛温无毒，主痈肿恶疮死肌寒热，风寒湿痹四肢拘挛不收，风头肿气，通腠理柔皮之作痼疾。"}]},{"ID":"20240613153131-w7qrto9","Type":"NodeThematicBreak","Properties":{"id":"20240613153131-w7qrto9"}},{"ID":"20240613153133-431hvff","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153133-431hvff","updated":"20240613153138"},"Children":[{"Type":"NodeText","Data":"麋脂《新修本草》"}]},{"ID":"20240613153133-pxari8b","Type":"NodeParagraph","Properties":{"id":"20240613153133-pxari8b","updated":"20240613153133"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主痈肿，恶疮，死肌，寒风湿痹，四肢拘缓不收，风头肿气，通腠理，柔一名宫脂。畏大黄。角，味甘，无毒，主痹，止血，益气力。生南山山谷，及淮海边，十月取。"}]},{"ID":"20240613153133-iq24uu8","Type":"NodeParagraph","Properties":{"id":"20240613153133-iq24uu8","updated":"20240613153133"},"Children":[{"Type":"NodeText","Data":"今海陵间最多，千百为群，多牝少牡。人言一牡辄交十余牝，交毕即死。其脂堕土中，经年人得之方好，名曰遁脂，酒服至良。寻麋性乃尔 快，不应萎人阴。一方言不可近阴，令阴萎，此乃有理。麋肉不可合虾及生菜、梅、李、果实，食之皆病患。其角刮取屑，熬，香酒服之，大益人。事出彭祖传中。"}]},{"ID":"20240613153133-do60u94","Type":"NodeParagraph","Properties":{"id":"20240613153133-do60u94","updated":"20240613153133"},"Children":[{"Type":"NodeText","Data":"〔谨案〕麋茸，服之功力胜鹿茸。角，煮为胶，亦胜白胶，言游牝毕即死者，此亦虚传，遍问山泽人，不闻游牝因致死者。"}]},{"ID":"20240613153134-s5gal6h","Type":"NodeThematicBreak","Properties":{"id":"20240613153134-s5gal6h"}},{"ID":"20240613153836-tqy2ht4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613153836-tqy2ht4","updated":"20240613153847"},"Children":[{"Type":"NodeText","Data":"麋脂《神农本草经赞》"}]},{"ID":"20240613153836-329vl1i","Type":"NodeParagraph","Properties":{"id":"20240613153836-329vl1i","updated":"20240613153836"},"Children":[{"Type":"NodeText","Data":"味辛温。主痈肿。恶创死肌。寒风湿痹。四肢拘缓不收。风头肿气。通腠理。一名官脂。生山谷。"}]},{"ID":"20240613153836-mghiz74","Type":"NodeThematicBreak","Properties":{"id":"20240613153836-mghiz74"}},{"ID":"20240613153837-ikga8ee","Type":"NodeParagraph","Properties":{"id":"20240613153837-ikga8ee"}}]}