e":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 690px;\" parent-style=\"width: 700px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄刺蛾 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄刺蛾 1-20240828091902-538uacn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613175237-of9phu1","Type":"NodeParagraph","Properties":{"id":"20240613175237-of9phu1","updated":"20240828091917"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为黄刺蛾的茧。"}]},{"ID":"20240613175237-mjk69p2","Type":"NodeThematicBreak","Properties":{"id":"20240613175237-mjk69p2"}},{"ID":"20240613175306-o0qvq6z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175306-o0qvq6z","updated":"20240613175309"},"Children":[{"Type":"NodeText","Data":"雀瓮《神农本草经》"}]},{"ID":"20240613175306-nso7m88","Type":"NodeParagraph","Properties":{"id":"20240613175306-nso7m88","updated":"20240613175306"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240613175306-c6fhlzb","Type":"NodeParagraph","Properties":{"id":"20240613175306-c6fhlzb","updated":"20240613175306"},"Children":[{"Type":"NodeText","Data":"主小儿惊痫，寒热，结气，蛊毒。鬼注。一名躁舍。"}]},{"ID":"20240613175306-hg8svnn","Type":"NodeParagraph","Properties":{"id":"20240613175306-hg8svnn","updated":"20240613175306"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中，采蒸之，生树枝间，蛄蟖房也。八月取。"}]},{"ID":"20240613175306-rmfdl2t","Type":"NodeParagraph","Properties":{"id":"20240613175306-rmfdl2t","updated":"20240613175306"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蛄，蛄斯黑也。《尔雅》云蟔，蛄蟖.郭璞云：蛓属也，今青州人呼蛓为蛄蟖.按本经名为雀瓮者。瓮与蛹音相近，以其如雀子，又如茧虫之蛹，因呼之。"}]},{"ID":"20240613175320-jlvmndb","Type":"NodeThematicBreak","Properties":{"id":"20240613175320-jlvmndb"}},{"ID":"20240613175322-wrh3k5v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175322-wrh3k5v","updated":"20240613175338"},"Children":[{"Type":"NodeText","Data":"雀瓮《本经逢原》"}]},{"ID":"20240613175329-t412v73","Type":"NodeParagraph","Properties":{"id":"20240613175329-t412v73","updated":"20240613175329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名蛄 ，俗名 毛"}]},{"ID":"20240613175329-zjnhny5","Type":"NodeParagraph","Properties":{"id":"20240613175329-zjnhny5","updated":"20240613175329"},"Children":[{"Type":"NodeText","Data":"甘平小毒。"}]},{"ID":"20240613175329-5emook8","Type":"NodeParagraph","Properties":{"id":"20240613175329-5emook8","updated":"20240613175329"},"Children":[{"Type":"NodeText","Data":"《本经》主寒热结气，蛊毒鬼疰，小儿惊痫。"}]},{"ID":"20240613175329-od707vf","Type":"NodeParagraph","Properties":{"id":"20240613175329-od707vf","updated":"20240613175329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":" 雀瓮，蛄 壳也。其虫夏生叶上，背上有刺螫人，故名 毛。秋深叶尽欲老，口吐白沫，凝聚渐硬，在中成蛹如蚕，至夏羽化而出，其形有似蜻蜒而翅黑稍阔，放子叶上而生蛄 。谓雀瓮者，以雀好食其蛹也。入药惟取石榴树上者，连蛹炙焙用之。苏颂曰∶今医家治小儿惊痫，用雀瓮子连虫同白僵蚕、全蝎各三枚，微炒捣末，煎麻黄汤调服一字，日三服大效。藏器治小儿撮口不得饮乳，但先 口傍见血，以雀瓮打破取汁涂之。"}]},{"ID":"20240613175237-5jyq9v5","Type":"NodeThematicBreak","Properties":{"id":"20240613175237-5jyq9v5"}},{"ID":"20240613175238-0ejjvk5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175238-0ejjvk5","updated":"20240613175243"},"Children":[{"Type":"NodeText","Data":"雀瓮《本草经集注》"}]},{"ID":"20240613175238-d0byxb4","Type":"NodeParagraph","Properties":{"id":"20240613175238-d0byxb4","updated":"20240613175238"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治小儿惊痫，寒热，结气，蛊毒，鬼疰。一名躁舍。生汉中，采蒸之，生树枝间， 房也。八月取。"}]},{"ID":"20240613175238-ebh23px","Type":"NodeParagraph","Properties":{"id":"20240613175238-ebh23px","updated":"20240613175238"},"Children":[{"Type":"NodeText","Data":"，蚝虫也。此虫多在石榴树上，世呼为蚝虫，其背毛亦螫人。生卵，形如鸡子，大如巴豆，今方家亦不用此。蚝，一作 尔。"}]},{"ID":"20240613174849-x2fo04h","Type":"NodeThematicBreak","Properties":{"id":"20240613174849-x2fo04h"}},{"ID":"20240613175218-zb38lly","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175218-zb38lly","updated":"20240613175223"},"Children":[{"Type":"NodeText","Data":"雀瓮《名医别录》"}]},{"ID":"20240613175218-64gqdxx","Type":"NodeParagraph","Properties":{"id":"20240613175218-64gqdxx","updated":"20240613175218"},"Children":[{"Type":"NodeText","Data":"无毒．生汉中，采蒸之，生树枝间， 房也．八月取．"}]},{"ID":"20240613175218-he7iekr","Type":"NodeParagraph","Properties":{"id":"20240613175218-he7iekr","updated":"20240613175218"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶雀瓮，味甘，平．主小儿惊痫，寒热结气，蛊毒鬼注．一名躁舍．"}]},{"ID":"20240613174849-p6zuluc","Type":"NodeThematicBreak","Properties":{"id":"20240613174849-p6zuluc"}},{"ID":"20240613175120-of5firp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175120-of5firp","updated":"20240613175124"},"Children":[{"Type":"NodeText","Data":"雀瓮《新修本草》"}]},{"ID":"20240613175120-gw7aim7","Type":"NodeParagraph","Properties":{"id":"20240613175120-gw7aim7","updated":"20240613175120"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。"}]},{"ID":"20240613175120-xlpyoiv","Type":"NodeParagraph","Properties":{"id":"20240613175120-xlpyoiv","updated":"20240613175120"},"Children":[{"Type":"NodeText","Data":"主小儿惊痫，寒热，结气，蛊毒，鬼疰。一名躁舍。生汉中，采蒸之，生树枝间，房也。八月取。"}]},{"ID":"20240613175120-1ntljv9","Type":"NodeParagraph","Properties":{"id":"20240613175120-1ntljv9","updated":"20240613175120"},"Children":[{"Type":"NodeText","Data":"，蚝虫也。此虫多在石榴树上，俗呼为蚝虫，其背毛亦螫人。生卵，形如鸡子，大如巴豆，今方家亦不用此。"}]},{"ID":"20240613175120-15z1eyg","Type":"NodeParagraph","Properties":{"id":"20240613175120-15z1eyg","updated":"20240613175120"},"Children":[{"Type":"NodeText","Data":"蚝，一作 尔。"}]},{"ID":"20240613175120-3g2y06q","Type":"NodeParagraph","Properties":{"id":"20240613175120-3g2y06q","updated":"20240613175120"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物紫白间斑，状似车渠文可爱，大者如雀卵，在树间似螵蛸虫也。"}]},{"ID":"20240613174849-aekhw9v","Type":"NodeThematicBreak","Properties":{"id":"20240613174849-aekhw9v"}},{"ID":"20240613175055-7vccwev","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175055-7vccwev","updated":"20240613175059"},"Children":[{"Type":"NodeText","Data":"雀瓮《本草衍义》"}]},{"ID":"20240613175055-g3wf40r","Type":"NodeParagraph","Properties":{"id":"20240613175055-g3wf40r","updated":"20240613175055"},"Children":[{"Type":"NodeText","Data":"多在棘枝上，故又名棘刚子。研其间虫汁，灌小儿，治（原缺）。"}]},{"ID":"20240613174849-awcks7o","Type":"NodeThematicBreak","Properties":{"id":"20240613174849-awcks7o"}},{"ID":"20240613175042-q91l920","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175042-q91l920","updated":"20240613175047"},"Children":[{"Type":"NodeText","Data":"雀瓮《千金翼方》"}]},{"ID":"20240613175042-xm6v1u0","Type":"NodeParagraph","Properties":{"id":"20240613175042-xm6v1u0","updated":"20240613175042"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主小儿惊痫，寒热结气，蛊毒鬼疰。一名燥舍。生汉中，采蒸之，生树枝间， 房也，八月取。"}]},{"ID":"20240613174849-1cfaz6f","Type":"NodeThematicBreak","Properties":{"id":"20240613174849-1cfaz6f"}},{"ID":"20240613174930-7sfdr2o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174930-7sfdr2o","updated":"20240613174935"},"Children":[{"Type":"NodeText","Data":"雀瓮《本草纲目》"}]},{"ID":"20240613174936-wlsz0b2","Type":"NodeParagraph","Properties":{"id":"20240613174936-wlsz0b2","updated":"20240613174943"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）【释名】雀儿饭瓮（《蜀本》）、房经》）、天浆子藏器曰∶毛虫作茧，形如瓮，故名雀瓮。俗呼雀痈，声相近也。保升曰∶雀好食其瓮中子，故俗呼雀儿饭瓮。弘景曰∶背毛螫人，故名蚝（音刺），与同。时珍曰∶俗呼毛虫，又名杨瘌子，因有螫毒也。此虫多生石榴树上，故名天浆。天浆乃甜榴之名也。宗曰∶多在棘枝上，故曰棘刚子。"}]},{"ID":"20240613174949-u29vlze","Type":"NodeParagraph","Properties":{"id":"20240613174949-u29vlze"},"Children":[{"Type":"NodeText","Data":"【集解】《别录》曰∶雀瓮出汉中。生树枝间，弘景曰∶，蚝虫也。在石榴树上。其背毛螫人。生卵形如鸡子，大如巴豆。藏器曰∶蚝虫好在果树上，大小如蚕，。面背上有五色斑毛，有毒能刺螫人。欲老者，口中吐白汁，凝聚渐硬，正如雀卵。其虫以瓮为茧，在中成蛹，如蚕之在茧也。夏月羽化而出作蛾，放子于叶间如蚕子。陶言其生卵如鸡子，误矣。恭曰∶雀瓮在树间，似螵蛸虫。此物紫白裥斑，状似砗磲文可爱也。时珍曰∶处处树上有之，牡丹上尤多。入药惟取榴棘上桑上者。"}]},{"ID":"20240613174953-0l9pzfz","Type":"NodeParagraph","Properties":{"id":"20240613174953-0l9pzfz"},"Children":[{"Type":"NodeText","Data":"【气味】甘，平，无毒。日华曰∶有毒。"}]},{"ID":"20240613174955-l7ogzdn","Type":"NodeParagraph","Properties":{"id":"20240613174955-l7ogzdn"},"Children":[{"Type":"NodeText","Data":"【主治】寒热结气，蛊毒鬼疰，小儿惊痫（《本经》）。颂曰∶今医家治小儿慢惊。用天浆子（有虫者）、白僵蚕、干蝎三物各三枚，微炒捣末。煎麻黄汤，调服一字，日三服。随儿大小加减，大有效也。藏器曰∶雀瓮打破取汁，与小儿饮，令无疾。小儿病撮口者，渐渐口撮不得饮乳。但先口傍见血，以瓮研汁涂之。或同鼠者，盖厌禳之也。"}]},{"ID":"20240613174959-nqwbycs","Type":"NodeParagraph","Properties":{"id":"20240613174959-nqwbycs"},"Children":[{"Type":"NodeText","Data":"【附方】新六。撮口噤风∶用棘科上雀儿饭瓮子未开口者，取内物和乳汁研，灌之。又方∶棘刚子五枚，赤足蜈蚣一条，烧存性，研匀，饭丸麻子大。每服三、五丸，乳汁下。亦可末服一字。（并《圣惠》）小儿脐风∶白龙散∶用天浆子（有虫者）一枚，真僵蚕（炒）一枚，腻粉少许，研匀。以薄荷自然汁调，灌之。取下毒物神效。（《普济方》）急慢惊风，口眼斜，搐搦痰盛∶用天浆子房（去皮，生用）三枚，干蝎（生用）七枚，朱砂一钱，研匀，饭丸粟大。每服二丸，荆芥汤送下。（《圣惠方》）乳蛾喉痹∶用天浆子（即红姑娘），徐徐嚼咽。小儿痫疾∶棘枝上雀瓮，研，其间虫出，取汁灌之。（《圣惠方》）"}]},{"ID":"20240613175015-7d0roaj","Type":"NodeThematicBreak","Properties":{"id":"20240613175015-7d0roaj"}},{"ID":"20240613175017-dt42eg2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613175017-dt42eg2","updated":"20240613175025"},"Children":[{"Type":"NodeText","Data":"雀瓮《本草汇言》"}]},{"ID":"20240613175017-29mdoci","Type":"NodeParagraph","Properties":{"id":"20240613175017-29mdoci","updated":"20240613175017"},"Children":[{"Type":"NodeText","Data":"味甘，气平，有毒。"}]},{"ID":"20240613175017-9advx9k","Type":"NodeParagraph","Properties":{"id":"20240613175017-9advx9k","updated":"20240613175017"},"Children":[{"Type":"NodeText","Data":"陶隐居曰：雀瓮，名杨刺子，大小如蚕身，背上有五色斑，状如砗磲文，可爱也。通身四面皆有毛，能刺螫人，老者口中吐白汁，凝聚渐硬，结壳形如巴豆牢结树上，惟石榴树上尤多，壳中成蛹，如蚕之在茧也，夏月羽化而出壳子。如螫人，以毛刺人肉内，岛痛，用新丝绵揩之，毛刺即出。"}]},{"ID":"20240613175017-1rjqrbl","Type":"NodeParagraph","Properties":{"id":"20240613175017-1rjqrbl","updated":"20240613175017"},"Children":[{"Type":"NodeText","Data":"雀瓮子　治小儿急慢惊风，并脐风撮口之药也。"}]},{"ID":"20240613175017-paw2c5o","Type":"NodeParagraph","Properties":{"id":"20240613175017-paw2c5o","updated":"20240613175017"},"Children":[{"Type":"NodeText","Data":"集方　《圣惠方》：治小儿急慢惊风，口眼喎斜，搐搦痰盛。用雀瓮壳三枚（去壳取汁），全蝎五枚，朱砂（研细）一钱，再共研匀，饭丸粟米大，每服三四丸，姜汤下。"}]},{"ID":"20240613175017-o46rqm0","Type":"NodeParagraph","Properties":{"id":"20240613175017-o46rqm0","updated":"20240613175017"},"Children":[{"Type":"NodeText","Data":"治小儿脐风口噤。用雀瓮子五枚（取汁），蜈蚣一条（烧存性），取汁和匀，每服二分，乳汁调服。一方加真铅粉一分。"}]},{"ID":"20240613174850-zt3xoqd","Type":"NodeThematicBreak","Properties":{"id":"20240613174850-zt3xoqd"}},{"ID":"20240613174916-x0e96qd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174916-x0e96qd","updated":"20240613174922"},"Children":[{"Type":"NodeText","Data":"雀瓮《医学入门》"}]},{"ID":"20240613174916-dxkl9w3","Type":"NodeParagraph","Properties":{"id":"20240613174916-dxkl9w3","updated":"20240613174916"},"Children":[{"Type":"NodeText","Data":"雀瓮放子名天浆，甘平无毒抹诸疮，小儿惊痫不可缺，撮口风堪刺口傍。"}]},{"ID":"20240613174916-lg2i2st","Type":"NodeParagraph","Properties":{"id":"20240613174916-lg2i2st","updated":"20240613174916"},"Children":[{"Type":"NodeText","Data":"即毛虫房也。好在石榴树上，似蚕而短，背上有五色斑毛，刺人有毒。欲老者口吐白汁，凝聚渐坚硬如雀卵。其子在瓮中作蛹，久而作蛾，出枝叶上放子复为虫。又曰∶雀好食其瓮中子，故俗间呼为雀儿饭瓮，又名天浆子。八月采，蒸之。主小儿慢惊，惊痫，寒热结气，蛊毒鬼疰。又小儿撮口不得饮乳者，先刺口傍令见血，以瓮内汁和鼠妇捣涂之。《局方》皆以粪虫为天浆子，以之治疳则可，若治惊风方须用此也。"}]},{"ID":"20240613174850-rs7ow06","Type":"NodeThematicBreak","Properties":{"id":"20240613174850-rs7ow06"}},{"ID":"20240613174851-9sxe0ld","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174851-9sxe0ld","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：雀瓮"}]},{"ID":"20240613174851-7i6ez73","Type":"NodeParagraph","Properties":{"id":"20240613174851-7i6ez73","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613174851-uct68p8","Type":"NodeParagraph","Properties":{"id":"20240613174851-uct68p8","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" Què Wènɡ"}]},{"ID":"20240613174851-8qjly5i","Type":"NodeParagraph","Properties":{"id":"20240613174851-8qjly5i","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613174851-imj04gc","Type":"NodeParagraph","Properties":{"id":"20240613174851-imj04gc","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 黄刺蛾[成虫名]、枣刺蛾、刺毛虫、洋辣子、天浆子、枣八角"}]},{"ID":"20240613174851-5laqvdx","Type":"NodeParagraph","Properties":{"id":"20240613174851-5laqvdx","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613174851-i51k1yu","Type":"NodeParagraph","Properties":{"id":"20240613174851-i51k1yu","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 昆虫纲鳞翅目刺蛾科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄刺蛾"},{"Type":"NodeText","Data":"Monema flavescens Walker [Cnidocampa flavescens （Walker）]，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带有石灰质硬茧的蛹"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240613174851-wlmljjp","Type":"NodeParagraph","Properties":{"id":"20240613174851-wlmljjp","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613174851-veu6ltr","Type":"NodeParagraph","Properties":{"id":"20240613174851-veu6ltr","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 全国各地。"}]},{"ID":"20240613174851-36dj80v","Type":"NodeParagraph","Properties":{"id":"20240613174851-36dj80v","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613174851-8dv69ch","Type":"NodeParagraph","Properties":{"id":"20240613174851-8dv69ch","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 清热定惊。"}]},{"ID":"20240613174851-x763223","Type":"NodeParagraph","Properties":{"id":"20240613174851-x763223","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"治小儿惊风，痢疾。用量1～3枚。"}]},{"ID":"20240613174851-dxlhxhf","Type":"NodeParagraph","Properties":{"id":"20240613174851-dxlhxhf","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"治小儿急慢惊风：雀瓮，白僵蚕，全蝎各3枚，共研细面，每服2分，麻黄0.5钱，煎汤送下。"}]},{"ID":"20240613174851-hvrv9qz","Type":"NodeParagraph","Properties":{"id":"20240613174851-hvrv9qz","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"治乳蛾，喉痹：雀瓮去壳，慢慢嚼烟。"}]},{"ID":"20240613174851-96ygend","Type":"NodeParagraph","Properties":{"id":"20240613174851-96ygend","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613174851-9mtpn3f","Type":"NodeParagraph","Properties":{"id":"20240613174851-9mtpn3f","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613174851-4pjpc2p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174851-4pjpc2p","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：雀瓮"}]},{"ID":"20240613174851-44ul8jw","Type":"NodeParagraph","Properties":{"id":"20240613174851-44ul8jw","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613174851-nq2eimc","Type":"NodeParagraph","Properties":{"id":"20240613174851-nq2eimc","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" Què Wènɡ"}]},{"ID":"20240613174851-soc9riz","Type":"NodeParagraph","Properties":{"id":"20240613174851-soc9riz","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613174851-6gsn1tb","Type":"NodeParagraph","Properties":{"id":"20240613174851-6gsn1tb","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 躁舍（《本经》），帖嘶房（《别录》），雀儿饭瓮（《蜀本草》），蛓毛虫窠（《日华子本草》），棘刚子、天浆子（《本草图经》）。"}]},{"ID":"20240613174851-uxcog9w","Type":"NodeParagraph","Properties":{"id":"20240613174851-uxcog9w","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613174851-3hozrsh","Type":"NodeParagraph","Properties":{"id":"20240613174851-3hozrsh","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613174851-x2gd7re","Type":"NodeParagraph","Properties":{"id":"20240613174851-x2gd7re","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613174851-k22ozim","Type":"NodeParagraph","Properties":{"id":"20240613174851-k22ozim","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 为刺蛾科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄刺蛾"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虫茧"},{"Type":"NodeText","Data":"。8月采收。"}]},{"ID":"20240613174851-lhm6a3n","Type":"NodeParagraph","Properties":{"id":"20240613174851-lhm6a3n","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613174851-bqxmvfa","Type":"NodeParagraph","Properties":{"id":"20240613174851-bqxmvfa","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 幼虫多栖于梨、苹果、枣、柿、樱桃、李等果树上，食害嫩叶。我国华南、西南、华北等地均有分布。"}]},{"ID":"20240613174851-p6aha6n","Type":"NodeParagraph","Properties":{"id":"20240613174851-p6aha6n","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613174851-7yll1sl","Type":"NodeParagraph","Properties":{"id":"20240613174851-7yll1sl","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 体黄褐色，长约15毫米，翅展约35毫米；雄蛾体较小。头部褐色，复眼1对，椭圆形，黑褐色；触角鞭状，暗黄色；胸部密被细毛。翅2对，前翅自翅顶向后方伸出暗褐色斜线2条，由此内部的线条为界，其外侧至外缘均呈褐色；内侧呈黄色，并有褐色小点2个；后翅为淡黄褐色。足3对，内侧略现黑褐色。腹部雄虫较小，雌者肥大。幼虫初孵化时黄色，成熟时变为黄绿色，头小，腹部肥大，体两侧各节有小突起，上生褐色刺毛。7～8月间结茧，呈椭圆形，长约15毫米，灰白色，并有数条暗黑色粗斜线，质甚坚硬。"}]},{"ID":"20240613174851-aarr9kl","Type":"NodeParagraph","Properties":{"id":"20240613174851-aarr9kl","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613174851-dexjgjl","Type":"NodeParagraph","Properties":{"id":"20240613174851-dexjgjl","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味甘，平。\""}]},{"ID":"20240613174851-ai005zf","Type":"NodeParagraph","Properties":{"id":"20240613174851-ai005zf","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613174851-92qa8x2","Type":"NodeParagraph","Properties":{"id":"20240613174851-92qa8x2","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"有毒。\""}]},{"ID":"20240613174851-9q3pg6s","Type":"NodeParagraph","Properties":{"id":"20240613174851-9q3pg6s","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613174851-v6uim6u","Type":"NodeParagraph","Properties":{"id":"20240613174851-v6uim6u","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 治小儿惊风、脐风、痫疾。"}]},{"ID":"20240613174851-sxrkn5x","Type":"NodeParagraph","Properties":{"id":"20240613174851-sxrkn5x","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主小儿惊痫，寒热结气。\""}]},{"ID":"20240613174851-c1jaary","Type":"NodeParagraph","Properties":{"id":"20240613174851-c1jaary","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主小儿撮口病，先赘小儿口傍，令见血，以瓮碎取汁涂之，亦生捣鼠妇并雀瓮汁涂。\""}]},{"ID":"20240613174851-yhnxrkn","Type":"NodeParagraph","Properties":{"id":"20240613174851-yhnxrkn","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613174851-zry4i7y","Type":"NodeParagraph","Properties":{"id":"20240613174851-zry4i7y","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散。"}]},{"ID":"20240613174851-4qri7f8","Type":"NodeParagraph","Properties":{"id":"20240613174851-4qri7f8","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613174851-15rcsjl","Type":"NodeParagraph","Properties":{"id":"20240613174851-15rcsjl","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" ①治小儿慢惊：天浆子（有虫者）、白僵蚕、干蝎（三物微炒）各三枚。捣筛为末。煎麻黄汤调服一字，日三。肋、儿大小加减之。（《本草图经》）"}]},{"ID":"20240613174851-x7286uv","Type":"NodeParagraph","Properties":{"id":"20240613174851-x7286uv","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"②治小儿急惊风搐搦：天浆子（生用）三枚，干蝎（生用）七枚，朱砂一钱。上捣罗为散，以软饭和丸，如粟米大。不计时候，以荆芥汤下二丸。量儿大小，加减服之。"}]},{"ID":"20240613174851-9ji4gw0","Type":"NodeParagraph","Properties":{"id":"20240613174851-9ji4gw0","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"③治小儿撮口及发噤：㈠棘科上雀儿饭瓮子，未开口者，取瓮子内物，和奶汁研灌之。㈡赤足蜈蚣一枚，雀儿饭瓮子（不开口者）五个。和烧为灰，细研。每服以粥饮调下三字。"}]},{"ID":"20240613174851-rd47xsd","Type":"NodeParagraph","Properties":{"id":"20240613174851-rd47xsd","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"④治小儿脐风：天浆子（有虫者）一枚，真僵蚕（炒）一枚，腻粉少许。研匀，以薄荷自然汁调灌之，取下毒物。（白龙膏）"}]},{"ID":"20240613174851-3l56bt4","Type":"NodeParagraph","Properties":{"id":"20240613174851-3l56bt4","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"⑤治小儿痫疾：棘枝上雀瓮，研，其间虫出，取汁灌之。（②方以下出《圣惠方》）"}]},{"ID":"20240613174851-lrwrlo9","Type":"NodeParagraph","Properties":{"id":"20240613174851-lrwrlo9","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613174851-g3n74gb","Type":"NodeParagraph","Properties":{"id":"20240613174851-g3n74gb","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613174851-48kymzr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174851-48kymzr","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"《中华本草》：雀瓮"}]},{"ID":"20240613174851-g83ag4i","Type":"NodeParagraph","Properties":{"id":"20240613174851-g83ag4i","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613174851-zp6xq2r","Type":"NodeParagraph","Properties":{"id":"20240613174851-zp6xq2r","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" Què Wènɡ"}]},{"ID":"20240613174851-8y1oxtc","Type":"NodeParagraph","Properties":{"id":"20240613174851-8y1oxtc","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613174851-1zp5218","Type":"NodeParagraph","Properties":{"id":"20240613174851-1zp5218","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 躁舍、 蛄蟖房、雀儿饭瓮、蛓毛虫窠、棘刚子、天浆子"}]},{"ID":"20240613174851-xt0a533","Type":"NodeParagraph","Properties":{"id":"20240613174851-xt0a533","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613174851-3jo26ud","Type":"NodeParagraph","Properties":{"id":"20240613174851-3jo26ud","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" Moth cocoon"}]},{"ID":"20240613174851-v37lmvk","Type":"NodeParagraph","Properties":{"id":"20240613174851-v37lmvk","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613174851-dimh73p","Type":"NodeParagraph","Properties":{"id":"20240613174851-dimh73p","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613174851-9p714cb","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613174851-9p714cb","updated":"20240613174851"},"Children":[{"ID":"20240613174851-vizczbx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240613174851-vizczbx","updated":"20240613174851"},"Children":[{"ID":"20240613174851-k20m6bd","Type":"NodeParagraph","Properties":{"id":"20240613174851-k20m6bd","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"陶弘景： RAN 蟖，蚝虫也。此虫多在石榴树上，俗为蚝虫，其背毛亦螫人。生卵形如鸡子，大如巴豆。今方家亦不用此。"}]}]}]},{"ID":"20240613174851-nnpbdea","Type":"NodeParagraph","Properties":{"id":"20240613174851-nnpbdea","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"2.《纲目》： RAN蟖俗呼毛虫，又名杨瘌子，因有螫毒也。处处树上有之，牡丹上尤多。人药惟取榴棘上房内有蛹者，正如螵蛸取桑上者。"}]},{"ID":"20240613174851-d1w8a2c","Type":"NodeParagraph","Properties":{"id":"20240613174851-d1w8a2c","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613174851-xsuvi8q","Type":"NodeParagraph","Properties":{"id":"20240613174851-xsuvi8q","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 药材基源：为刺蛾科动物黄刺蛾的虫茧。"}]},{"ID":"20240613174851-4m58r64","Type":"NodeParagraph","Properties":{"id":"20240613174851-4m58r64","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cnidocampa flavescens Walker[Monema flavescens Walker]"}]},{"ID":"20240613174851-hh90b03","Type":"NodeParagraph","Properties":{"id":"20240613174851-hh90b03","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季从树枝上取下，蒸后，干燥即成。"}]},{"ID":"20240613174851-10m0koc","Type":"NodeParagraph","Properties":{"id":"20240613174851-10m0koc","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613174851-a0zr3rv","Type":"NodeParagraph","Properties":{"id":"20240613174851-a0zr3rv","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 生态环境：幼虫多栖于梨、苹果、枣、柿、樱桃、石榴、李等果树上，食害嫩叶，结茧于树权杈或枝干上越冬。全国大部分地区均有分布。"}]},{"ID":"20240613174851-50lturr","Type":"NodeParagraph","Properties":{"id":"20240613174851-50lturr","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"资源分布：全国大部分地区均有分布。"}]},{"ID":"20240613174851-bcr5hmm","Type":"NodeParagraph","Properties":{"id":"20240613174851-bcr5hmm","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613174851-28xfou3","Type":"NodeParagraph","Properties":{"id":"20240613174851-28xfou3","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 黄刺蛾，头和胸部黄色，足暗红褐色。前翅内半部黄色，外半部褐色，两条暗褐色横线从翅尖向后斜伸，内面一条伸到中室下角后呈松散圆斑，为内半部黄色的分界线，外面 一条伸达近后角处；后翅赭黄色，腹部雄虫较小，雌虫肥大。幼虫初孵化时黄色，成熟时变成黄绿色，头小，腹部肥大，体两侧各节有小突起，小生褐色刺毛。7-8月间结茧，呈椭圆形，长约15mm，灰白色，并有数条暗黑色斜线，质甚坚硬。"}]},{"ID":"20240613174851-a2hymav","Type":"NodeParagraph","Properties":{"id":"20240613174851-a2hymav","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613174851-p0ihfva","Type":"NodeParagraph","Properties":{"id":"20240613174851-p0ihfva","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，本品呈椭圆形的空壳，直径6-10mm，其一断侧面呈截断形，正面则为一圆口，表面灰色，有纵一菜褐色条纹，侧面有一棕色纵形条沟，为原附着树枝上的残痕。体轻，石灰质，捏则易碎，味淡。"}]},{"ID":"20240613174851-rhl8h79","Type":"NodeParagraph","Properties":{"id":"20240613174851-rhl8h79","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613174851-injkndl","Type":"NodeParagraph","Properties":{"id":"20240613174851-injkndl","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 1.抗缺氧作用，给小鼠腹腔注射雀瓮水提取液2g/kg，1.5g/kg和1g/kg，可以显着延长小鼠的缺氧存活时间。给大鼠股静脉注射0.5g/kg和0.25g/kg雀瓮水提取液，对垂体后叶素所引起的大鼠急性心肌缺血、心律失常、心率减慢均有明显的对抗作用。"}]},{"ID":"20240613174851-8z7agv4","Type":"NodeParagraph","Properties":{"id":"20240613174851-8z7agv4","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"2.抗惊劂作用，小鼠腹腔注射10g/kg,5g/kg,2.5g/kg雀瓮水提取液，可对抗戊四氮引起的惊劂。"}]},{"ID":"20240613174851-3gmwu4c","Type":"NodeParagraph","Properties":{"id":"20240613174851-3gmwu4c","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"3.催眠作用，小鼠腹腔注射20g/kg雀瓮水提取液，对硫喷妥钠阈下剂量催眼作用有协同作用。"}]},{"ID":"20240613174851-sbecirm","Type":"NodeParagraph","Properties":{"id":"20240613174851-sbecirm","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"4.镇痛作用，小鼠扭体法和尾电刺激法10kg/kg和20g/kg雀瓮水提取液腹腔注射给药，有明显的镇痛作用。25g/kg雀瓮水提取液腹腔注射给药，小鼠热板法的镇痛铲果不明显。"}]},{"ID":"20240613174851-vskqbiu","Type":"NodeParagraph","Properties":{"id":"20240613174851-vskqbiu","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"5.抗炎及抗溃疡作用，100%雀瓮幼虫水撮 液以10g/kg或20g/kg给大鼠灌胃4天，显着抑制角叉菜胶所至足肿胀作用。同样剂量，每日灌服2次，连续数月，对大鼠佐剂性关节炎继发性足肿胀有显着抑制作用。水提取液10g/kg剂量灌胃，每日2次，连续22天，对醋酸所致大鼠实验性胃溃疡有一定的抑制作用。"}]},{"ID":"20240613174851-95xjcs3","Type":"NodeParagraph","Properties":{"id":"20240613174851-95xjcs3","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"6.毒性，小鼠尾静脉注射雀瓮水提取液，按综合法计算：雀瓮水提取液LD50为14.68+/-1.16g/kg。"}]},{"ID":"20240613174851-1y07fw8","Type":"NodeParagraph","Properties":{"id":"20240613174851-1y07fw8","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613174851-yznv21b","Type":"NodeParagraph","Properties":{"id":"20240613174851-yznv21b","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240613174851-s4u1hue","Type":"NodeParagraph","Properties":{"id":"20240613174851-s4u1hue","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613174851-sitmns8","Type":"NodeParagraph","Properties":{"id":"20240613174851-sitmns8","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 味甘；性平"}]},{"ID":"20240613174851-5buhjt3","Type":"NodeParagraph","Properties":{"id":"20240613174851-5buhjt3","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613174851-kw2rmae","Type":"NodeParagraph","Properties":{"id":"20240613174851-kw2rmae","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 熄风止惊；解毒消肿。主小儿惊风；脐风；癫痫；乳蛾肿痛"}]},{"ID":"20240613174851-ed8llkq","Type":"NodeParagraph","Properties":{"id":"20240613174851-ed8llkq","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613174851-hk87i9i","Type":"NodeParagraph","Properties":{"id":"20240613174851-hk87i9i","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散，1-5个。"}]},{"ID":"20240613174851-56c87be","Type":"NodeParagraph","Properties":{"id":"20240613174851-56c87be","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613174851-rqhaazp","Type":"NodeParagraph","Properties":{"id":"20240613174851-rqhaazp","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" ①治小儿慢惊： 天浆子(有虫者)、白僵蚕、干蝎(三物微炒)各三枚。捣筛为末。煎麻黄汤调服一字，日三。随小儿大小加减之。(《本草图经》)②治小儿急惊风搐搦： 天浆子(生用)三枚， 干蝎(生用)七枚，朱砂一钱。上捣罗为散，以软饭和丸，如粟米大。不计时候，以荆芥汤下二丸。量儿大小，加减服之。③治小儿撮口及发噤： 一、棘科上雀儿饭瓮子，未开口者，取瓮子内物，和奶汁研灌之。二、赤足蜈蚣一枚，雀儿饭瓮子(不开口者)五个。和烧为灰，细研。每服以粥饮调下三④治小儿脐风： 天浆子(有虫者)一枚，真僵蚕(炒)一枚，腻粉少许。研匀，以薄荷自然汁调灌之，取下毒物。 (白龙膏)⑤治小儿痫疾： 棘枝上雀瓮，研，其间虫出，取汁灌之。(②方以下出《圣惠方》)"}]},{"ID":"20240613174851-jst1jir","Type":"NodeParagraph","Properties":{"id":"20240613174851-jst1jir","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613174851-v9cazmt","Type":"NodeParagraph","Properties":{"id":"20240613174851-v9cazmt","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主小儿惊痫，寒热结气。"}]},{"ID":"20240613174851-sazjc7t","Type":"NodeParagraph","Properties":{"id":"20240613174851-sazjc7t","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：主小儿撮口病，先小儿口傍，令见血，以瓮碎取汁涂之，亦生捣鼠妇并雀瓮汁涂。"}]},{"ID":"20240613174851-qau1qp1","Type":"NodeParagraph","Properties":{"id":"20240613174851-qau1qp1","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613174851-nzbx7zf","Type":"NodeParagraph","Properties":{"id":"20240613174851-nzbx7zf","updated":"20240613174851"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613174852-vnut6jv","Type":"NodeThematicBreak","Properties":{"id":"20240613174852-vnut6jv"}},{"ID":"20240613174853-7pkrlic","Type":"NodeParagraph","Properties":{"id":"20240613174853-7pkrlic"}}]}