odeLinkDest","Data":"assets/鼠妇 3-20240828093505-gatfjvc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240703153358-awg6p3s","Type":"NodeParagraph","Properties":{"id":"20240703153358-awg6p3s","updated":"20240828093528"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠妇6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠妇6-20240703153358-pe1n9st.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828093611-k7ccfoq","Type":"NodeParagraph","Properties":{"id":"20240828093611-k7ccfoq","updated":"20240828093611"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1035px;","style":"width: 1025px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鼠妇 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鼠妇 4-20240828093611-br8lq5p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1025px;\" parent-style=\"width: 1035px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614082415-58onwsu","Type":"NodeThematicBreak","Properties":{"id":"20240614082415-58onwsu"}},{"ID":"20240614082532-mopim27","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082532-mopim27","updated":"20240614082538"},"Children":[{"Type":"NodeText","Data":"鼠妇《神农本草经》"}]},{"ID":"20240614082532-52oe5es","Type":"NodeParagraph","Properties":{"id":"20240614082532-52oe5es","updated":"20240614082532"},"Children":[{"Type":"NodeText","Data":"味酸温。"}]},{"ID":"20240614082532-4u0kwyz","Type":"NodeParagraph","Properties":{"id":"20240614082532-4u0kwyz","updated":"20240614082532"},"Children":[{"Type":"NodeText","Data":"主气癃，不得小便，女人月闭，血症，痫痓，寒热，利水道。一名负蟠，一名威。生平谷。"}]},{"ID":"20240614082532-p5jktw3","Type":"NodeParagraph","Properties":{"id":"20240614082532-p5jktw3","updated":"20240614082532"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一蜲生魏郡及人家地上，五月五日取。"}]},{"ID":"20240614082532-a9epw5a","Type":"NodeParagraph","Properties":{"id":"20240614082532-a9epw5a","updated":"20240614082532"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（女尹）（女尹）威，委黍，委黍，鼠妇也，蟠鼠负也。《尔雅》云：蟠，鼠负。郭璞云：瓮器底虫。又（女尹）威委黍。郭璞云：旧说，鼠妇别名。《毛诗》云：伊威在室。《传》云：伊威，委黍也。陆玑云：在壁根下，瓮底中生，似白鱼。"}]},{"ID":"20240614082604-x2de31v","Type":"NodeThematicBreak","Properties":{"id":"20240614082604-x2de31v"}},{"ID":"20240614082606-4cbjv9e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082606-4cbjv9e","updated":"20240614082612"},"Children":[{"Type":"NodeText","Data":"鼠妇《新修本草》"}]},{"ID":"20240614082606-3de4axr","Type":"NodeParagraph","Properties":{"id":"20240614082606-3de4axr","updated":"20240614082606"},"Children":[{"Type":"NodeText","Data":"味酸，温，微寒，无毒。主气癃，不得小便，妇人月闭，血瘕，痫 ，寒热，利水道。"}]},{"ID":"20240614082606-qu29z4p","Type":"NodeParagraph","Properties":{"id":"20240614082606-qu29z4p","updated":"20240614082606"},"Children":[{"Type":"NodeText","Data":"一名负燔，一名KT ，一名KT 。生魏郡平谷及人家地上，五月五日取。"}]},{"ID":"20240614082606-erdxseg","Type":"NodeParagraph","Properties":{"id":"20240614082606-erdxseg","updated":"20240614082606"},"Children":[{"Type":"NodeText","Data":"一名鼠负，言鼠多在坎中，背则负之，今作妇字，如似乖理。又一名鼠姑。"}]},{"ID":"20240614082554-9gvvh00","Type":"NodeThematicBreak","Properties":{"id":"20240614082554-9gvvh00"}},{"ID":"20240614082555-0epb6vn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082555-0epb6vn","updated":"20240614082559"},"Children":[{"Type":"NodeText","Data":"鼠妇《医学入门》"}]},{"ID":"20240614082555-d8nd0pm","Type":"NodeParagraph","Properties":{"id":"20240614082555-d8nd0pm","updated":"20240614082555"},"Children":[{"Type":"NodeText","Data":"即地鸡。多足，色如蚓，背有横纹蹙起。生瓮底下湿处及土坎中，常负鼠背上故名。味酸，微寒，无毒。主利水道，气癃不得小便，妇人月闭血 ，痫 寒热，堕胎。仲景用治久疟者，以其主寒热也。端午采，日干，微炒。"}]},{"ID":"20240614082545-tslr2gs","Type":"NodeThematicBreak","Properties":{"id":"20240614082545-tslr2gs"}},{"ID":"20240614082546-ul5cb1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082546-ul5cb1g","updated":"20240614082550"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草纲目》"}]},{"ID":"20240614082546-jn5l49p","Type":"NodeParagraph","Properties":{"id":"20240614082546-jn5l49p","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"「释名」鼠负、负蟠、鼠姑、鼠粘，湿生虫、地鸡，地虱。"}]},{"ID":"20240614082546-2bqb5qb","Type":"NodeParagraph","Properties":{"id":"20240614082546-2bqb5qb","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"「气味」酸、温、无毒。"}]},{"ID":"20240614082546-vj73rcg","Type":"NodeParagraph","Properties":{"id":"20240614082546-vj73rcg","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614082546-t30q9rx","Type":"NodeParagraph","Properties":{"id":"20240614082546-t30q9rx","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"1、产妇尿秘。用鼠妇七个，熬过，研为末，酒送服。"}]},{"ID":"20240614082546-ank88dh","Type":"NodeParagraph","Properties":{"id":"20240614082546-ank88dh","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"2、撮口脐风。用鼠妇捣烂，绞取汁少许灌取。"}]},{"ID":"20240614082546-pkgbnse","Type":"NodeParagraph","Properties":{"id":"20240614082546-pkgbnse","updated":"20240614082546"},"Children":[{"Type":"NodeText","Data":"3、风牙疼痛。用鼠妇、巴豆仁、胡椒各一枚，共研为末，加饭做成丸子，如绿豆大。棉裹一丸咬住，涎出吐去。有奇效。"}]},{"ID":"20240614082619-wanrevb","Type":"NodeThematicBreak","Properties":{"id":"20240614082619-wanrevb"}},{"ID":"20240614082620-6hf4thy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082620-6hf4thy","updated":"20240614082626"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草乘雅半偈》"}]},{"ID":"20240614082620-wr3ig4p","Type":"NodeParagraph","Properties":{"id":"20240614082620-wr3ig4p","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240614082620-j1630x5","Type":"NodeParagraph","Properties":{"id":"20240614082620-j1630x5","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"【气味】酸温，无毒。"}]},{"ID":"20240614082620-ui74bl4","Type":"NodeParagraph","Properties":{"id":"20240614082620-ui74bl4","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"【主治】主治气癃，寒热，月闭，血瘕，堕胎。"}]},{"ID":"20240614082620-9igbs2a","Type":"NodeParagraph","Properties":{"id":"20240614082620-9igbs2a","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"【核】曰∶鼠妇，一名负蟠，一名湿生虫。出魏郡平谷，今处处有，多在下湿处，瓮器底土坎中。诗云∶ 在室，郑玄言∶家无人则生。大者长三四分，小者一二分，色灰褐，背有横纹，蹙起，双眸两须，多足奔趋，甚捷，断之无血，唯白浆耳。尔雅云∶每在坎中，粘负鼠背，因名鼠负。韩保升云∶犹 耳好着羊身，名羊负来也。食之善淫，故得妇名。一名鼠姑，犹鼠妇也。"}]},{"ID":"20240614082620-izs2gn9","Type":"NodeParagraph","Properties":{"id":"20240614082620-izs2gn9","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"【 】曰∶鼠妇，一名负蟠，湿生虫者，盖湿以合感，生必土坎瓮器之底，若举负而奔。"}]},{"ID":"20240614082620-c7guj06","Type":"NodeParagraph","Properties":{"id":"20240614082620-c7guj06","updated":"20240614082620"},"Children":[{"Type":"NodeText","Data":"虫之多足者，蟠也；犹鼠性善疑，畏明穴处，出则每不果，徘徊乃窜耳。如假血为瘕，而寒热生；假气为癃，而痹闭作。留爱纳想而乳字成，此非身所有者，窦而入之，悉皆消陨，倾营气之窠臼者也。"}]},{"ID":"20240614082658-kwtwcns","Type":"NodeThematicBreak","Properties":{"id":"20240614082658-kwtwcns"}},{"ID":"20240614082659-xygwwir","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082659-xygwwir","updated":"20240614082703"},"Children":[{"Type":"NodeText","Data":"鼠妇《长沙药解》"}]},{"ID":"20240614082659-k5tb01t","Type":"NodeParagraph","Properties":{"id":"20240614082659-k5tb01t","updated":"20240614082659"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味酸温。主气癃，不得小便，女人月闭，血癥，痫痓，寒热，利水道。一名负蟠，一名　威。生平谷。"}]},{"ID":"20240614082659-s6ilujg","Type":"NodeParagraph","Properties":{"id":"20240614082659-s6ilujg","updated":"20240614082659"},"Children":[{"Type":"NodeText","Data":"味酸，微寒。入足厥阴肝经。善通经脉，能化癥瘕。"}]},{"ID":"20240614082659-5wnte3w","Type":"NodeParagraph","Properties":{"id":"20240614082659-5wnte3w","updated":"20240614082659"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳖甲煎丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在鳖甲。"},{"Type":"NodeText","Data":"用之治病疟日久，结为癥瘕，以其破血而消坚也。"}]},{"ID":"20240614082659-lefgrp3","Type":"NodeParagraph","Properties":{"id":"20240614082659-lefgrp3","updated":"20240614082659"},"Children":[{"Type":"NodeText","Data":"炒枯存性，研细用。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"鼠妇，湿生虫，在砖石下，形如蠹鱼。"}]},{"ID":"20240614082721-bik9k90","Type":"NodeThematicBreak","Properties":{"id":"20240614082721-bik9k90"}},{"ID":"20240614082722-4df8ng4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082722-4df8ng4","updated":"20240614082726"},"Children":[{"Type":"NodeText","Data":"鼠妇《千金翼方》"}]},{"ID":"20240614082722-suochvo","Type":"NodeParagraph","Properties":{"id":"20240614082722-suochvo","updated":"20240614082722"},"Children":[{"Type":"NodeText","Data":"味酸，温，微寒，无毒。主气癃，不得小便，妇人月闭，血瘕痫 ，寒热，利水道。一名负蟠，一名 ，一名 。生魏郡平谷，及人家地上，五月五日取。"}]},{"ID":"20240614082732-rucqlzq","Type":"NodeThematicBreak","Properties":{"id":"20240614082732-rucqlzq"}},{"ID":"20240614082733-kdo4jox","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082733-kdo4jox","updated":"20240614082740"},"Children":[{"Type":"NodeText","Data":"鼠妇《汤液本草》"}]},{"ID":"20240614082733-7mwtft9","Type":"NodeParagraph","Properties":{"id":"20240614082733-7mwtft9","updated":"20240614082733"},"Children":[{"Type":"NodeText","Data":"气温，微寒，味酸。无毒。"}]},{"ID":"20240614082733-apijxhq","Type":"NodeParagraph","Properties":{"id":"20240614082733-apijxhq","updated":"20240614082733"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主气癃不得小便，妇人月水闭，血瘕痫痉，寒热，利水道。仲景治久疟，大鳖甲丸中使之。以其主寒热也。"}]},{"ID":"20240614082733-senea1z","Type":"NodeParagraph","Properties":{"id":"20240614082733-senea1z","updated":"20240614082733"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶鼠妇，湿生虫也。"}]},{"ID":"20240614082757-8vh1do7","Type":"NodeThematicBreak","Properties":{"id":"20240614082757-8vh1do7"}},{"ID":"20240614082759-2bunj73","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082759-2bunj73","updated":"20240614082803"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草衍义》"}]},{"ID":"20240614082759-j3plrk3","Type":"NodeParagraph","Properties":{"id":"20240614082759-j3plrk3","updated":"20240614082759"},"Children":[{"Type":"NodeText","Data":"鼠妇此湿生虫也，多足，其色如蚓，背有横纹蹙起，大者长三四分。在处有之，砖瓷及下湿处多，用处绝少。"}]},{"ID":"20240614082809-zxc0wtb","Type":"NodeThematicBreak","Properties":{"id":"20240614082809-zxc0wtb"}},{"ID":"20240614082810-i2jhq41","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082810-i2jhq41","updated":"20240614082815"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草经集注》"}]},{"ID":"20240614082810-zh7evjo","Type":"NodeParagraph","Properties":{"id":"20240614082810-zh7evjo","updated":"20240614082810"},"Children":[{"Type":"NodeText","Data":"味酸，温，微寒，无毒。主治气癃，不得小便，妇人月闭。血瘕，痫痉，寒热，利水道。"}]},{"ID":"20240614082810-vqmssxf","Type":"NodeParagraph","Properties":{"id":"20240614082810-vqmssxf","updated":"20240614082810"},"Children":[{"Type":"NodeText","Data":"一名负KT ，一名 ，一名 。生魏郡平谷及人家地上，五月五日取。"}]},{"ID":"20240614082810-zh1bjuy","Type":"NodeParagraph","Properties":{"id":"20240614082810-zh1bjuy","updated":"20240614082810"},"Children":[{"Type":"NodeText","Data":"一名鼠负，言鼠多在坎中，背则负之，今作妇字，如似乖理。又一名鼠姑。"}]},{"ID":"20240614082746-5k0hub2","Type":"NodeThematicBreak","Properties":{"id":"20240614082746-5k0hub2"}},{"ID":"20240614082747-7oa6sis","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082747-7oa6sis","updated":"20240614082751"},"Children":[{"Type":"NodeText","Data":"鼠妇《得配本草》"}]},{"ID":"20240614082747-0i7af0j","Type":"NodeParagraph","Properties":{"id":"20240614082747-0i7af0j","updated":"20240614082747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名地虱"}]},{"ID":"20240614082747-ap1v6tz","Type":"NodeParagraph","Properties":{"id":"20240614082747-ap1v6tz","updated":"20240614082747"},"Children":[{"Type":"NodeText","Data":"酸，温。入足厥阴经。治气癃，疗寒热，小儿撮口，痘疮倒 。葛洪又用以截疟。配巴豆、胡椒，饭丸，治风牙疼痛。（绵裹一丸咬之，良久涎出，吐去立效。）"}]},{"ID":"20240614082710-vnz6yew","Type":"NodeThematicBreak","Properties":{"id":"20240614082710-vnz6yew"}},{"ID":"20240614082711-p7uhjwm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082711-p7uhjwm","updated":"20240614082716"},"Children":[{"Type":"NodeText","Data":"鼠妇《本经逢原》"}]},{"ID":"20240614082711-slypyqv","Type":"NodeParagraph","Properties":{"id":"20240614082711-slypyqv","updated":"20240614082711"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名 ，即湿生虫"}]},{"ID":"20240614082711-6cvfs51","Type":"NodeParagraph","Properties":{"id":"20240614082711-6cvfs51","updated":"20240614082711"},"Children":[{"Type":"NodeText","Data":"酸咸无毒。"}]},{"ID":"20240614082711-jrlte5g","Type":"NodeParagraph","Properties":{"id":"20240614082711-jrlte5g","updated":"20240614082711"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"《金匮》治久疟，鳖甲煎丸中用之，以其主寒热去瘀积也。古方治惊痫血病多用之，厥阴血分药也。《千金》治产妇遗尿，以鼠妇七枚熬研，温酒服之。痘疮倒靥为末，酒服一字即起；又解射干、蜘蛛毒。"}]},{"ID":"20240614082647-ssqy7nb","Type":"NodeThematicBreak","Properties":{"id":"20240614082647-ssqy7nb"}},{"ID":"20240614082649-qevm5mj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082649-qevm5mj","updated":"20240614082653"},"Children":[{"Type":"NodeText","Data":"鼠妇《神农本草经赞》"}]},{"ID":"20240614082649-uij5ep0","Type":"NodeParagraph","Properties":{"id":"20240614082649-uij5ep0","updated":"20240614082649"},"Children":[{"Type":"NodeText","Data":"味酸温。主气癃。不得小便。妇人月闭血症。痫寒热。利水道。一名负蟠。一名威。生平谷。"}]},{"ID":"20240614082649-6cervbv","Type":"NodeParagraph","Properties":{"id":"20240614082649-6cervbv","updated":"20240614082649"},"Children":[{"Type":"NodeText","Data":"讹沿鼠妇。称溷鸡群。足垂多迹。脊蹙横纹。伴蛸寄寂。抱瓮持勤。赤头青股。丹戬形分。"}]},{"ID":"20240614082649-9lozsos","Type":"NodeParagraph","Properties":{"id":"20240614082649-9lozsos","updated":"20240614082649"},"Children":[{"Type":"NodeText","Data":"陶弘景曰。尔雅。名鼠妇。言鼠在坎中。背多粘负。今讹为妇。李时珍曰。俗名地鸡。"}]},{"ID":"20240614082649-slo1gaj","Type":"NodeParagraph","Properties":{"id":"20240614082649-slo1gaj","updated":"20240614082649"},"Children":[{"Type":"NodeText","Data":"白居易诗。未曾回眼向鸡群。寇宗曰。多足大者三四分。背有横纹蹙起。诗。伊芳威在室。蛸在户。黄庭坚诗。寄寂喧哄间。苏颂曰。在下湿处瓮器底。及土坎中。黄庭坚文。持勤补拙。名医曰。丹戬生蜀郡。青股赤头。状如鼠妇。"}]},{"ID":"20240614082633-s2xyhg5","Type":"NodeThematicBreak","Properties":{"id":"20240614082633-s2xyhg5"}},{"ID":"20240614082634-2j53mcx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082634-2j53mcx","updated":"20240614082638"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草易读》"}]},{"ID":"20240614082634-ss9l6wi","Type":"NodeParagraph","Properties":{"id":"20240614082634-ss9l6wi","updated":"20240614082634"},"Children":[{"Type":"NodeText","Data":"利水道而坠胎，破症结而通经。除久疟之寒热，解风虫之齿牙。治小儿之惊风，起痘疮之倒折伤接骨，土鳖焙末，每服三钱，神效。一方生者研汁酒服。一方同自然铜火 醋淬七次为末，每酒下二钱。又方土鳖一个，新瓦上焙干，巴豆一斤去壳，半夏一斤生用，乳香半分，没药半分，自然铜火 醋淬七次用，些须为细末，每服一厘，黄酒送下。不可多用，多则补得高起，其神效非常。用端午日制药，最忌妇女及鸡犬等物。（验方第一。）"}]},{"ID":"20240614082634-7l64dta","Type":"NodeParagraph","Properties":{"id":"20240614082634-7l64dta","updated":"20240614082634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄 虫丸"},{"Type":"NodeText","Data":"虫（二十枚，去足） 桃仁（二十枚） 大黄（二两）"}]},{"ID":"20240614082634-s145nlt","Type":"NodeParagraph","Properties":{"id":"20240614082634-s145nlt","updated":"20240614082634"},"Children":[{"Type":"NodeText","Data":"炼蜜分四丸，每酒下一丸，当下干血。治产妇积血腹痛。（诸方第一。）"}]},{"ID":"20240614082415-0it6t9x","Type":"NodeThematicBreak","Properties":{"id":"20240614082415-0it6t9x"}},{"ID":"20240614082523-08lqf5x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082523-08lqf5x","updated":"20240614082527"},"Children":[{"Type":"NodeText","Data":"鼠妇《本草崇原》"}]},{"ID":"20240614082523-q6usqyk","Type":"NodeParagraph","Properties":{"id":"20240614082523-q6usqyk","updated":"20240614082523"},"Children":[{"Type":"NodeText","Data":"气味酸温，无毒。主治气癃，不得小便，妇人月闭血瘕，痫 寒热，利水道，堕胎。"}]},{"ID":"20240614082523-x0vutvj","Type":"NodeParagraph","Properties":{"id":"20240614082523-x0vutvj","updated":"20240614082523"},"Children":[{"Type":"NodeText","Data":"（鼠妇处处有之，多在人家地上下湿处，凡瓮器底及土坎中更多，形似衣鱼，稍大，灰色，多足，背有横纹蹙起，《诗经》所谓 在室，即此虫也。）"}]},{"ID":"20240614082523-c6yvlld","Type":"NodeParagraph","Properties":{"id":"20240614082523-c6yvlld","updated":"20240614082523"},"Children":[{"Type":"NodeText","Data":"鼠妇感阴湿而生，气味酸温，禀太阳寒水厥阴风木之化。太阳水气行于肤表，则气癃而不得小便者可治也。厥阴木气上行外达，则妇人月闭而为血瘕者可治也。膀胱气癃，在内则不得小便，在外则有痫 寒热之病。鼠妇治气癃，则痫 之寒热亦可治也。不得小便，则水道不利，鼠妇治不得小便，则水道亦可利也。妇人恶血内闭，则为血瘕。新血内聚，则为妊娠。"}]},{"ID":"20240614082523-3j6nge3","Type":"NodeParagraph","Properties":{"id":"20240614082523-3j6nge3","updated":"20240614082523"},"Children":[{"Type":"NodeText","Data":"鼠妇治妇人月闭血瘕，则堕胎亦其验矣。"}]},{"ID":"20240614082415-4erexlr","Type":"NodeThematicBreak","Properties":{"id":"20240614082415-4erexlr"}},{"ID":"20240614082416-23yfjqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082416-23yfjqx","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：鼠妇"}]},{"ID":"20240614082416-8fg10v7","Type":"NodeParagraph","Properties":{"id":"20240614082416-8fg10v7","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614082416-3ldw23i","Type":"NodeParagraph","Properties":{"id":"20240614082416-3ldw23i","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" Shǔ Fù"}]},{"ID":"20240614082416-xesbk68","Type":"NodeParagraph","Properties":{"id":"20240614082416-xesbk68","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614082416-nmzo3ah","Type":"NodeParagraph","Properties":{"id":"20240614082416-nmzo3ah","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 潮湿虫、潮虫、地虱婆"}]},{"ID":"20240614082416-dh43aq2","Type":"NodeParagraph","Properties":{"id":"20240614082416-dh43aq2","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614082416-wmgr502","Type":"NodeParagraph","Properties":{"id":"20240614082416-wmgr502","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 为平甲虫科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"平甲虫"},{"Type":"NodeText","Data":"Armadillidium vulgare （Latreille）或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鼠妇"},{"Type":"NodeText","Data":"Porcellio scaber Latreille的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虫体"},{"Type":"NodeText","Data":"。春、夏、秋三季捕捉，用铁锅炒干，或开水烫死，晒干或焙干。"}]},{"ID":"20240614082416-v1644xp","Type":"NodeParagraph","Properties":{"id":"20240614082416-v1644xp","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614082416-ohqr9g9","Type":"NodeParagraph","Properties":{"id":"20240614082416-ohqr9g9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 酸，温。"}]},{"ID":"20240614082416-h3h3goj","Type":"NodeParagraph","Properties":{"id":"20240614082416-h3h3goj","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614082416-t8nnpgq","Type":"NodeParagraph","Properties":{"id":"20240614082416-t8nnpgq","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 利咽止痛，破瘀利水。用于慢性气管炎，术后疼痛，牙痛，口腔炎，鹅口疮，咽喉肿痛，小便不利，闭经。"}]},{"ID":"20240614082416-4e0fe03","Type":"NodeParagraph","Properties":{"id":"20240614082416-4e0fe03","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614082416-g9ifuye","Type":"NodeParagraph","Properties":{"id":"20240614082416-g9ifuye","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 1.5～3分（0.5～1克），研粉服。"}]},{"ID":"20240614082416-kqbhq2e","Type":"NodeParagraph","Properties":{"id":"20240614082416-kqbhq2e","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614082416-kil3sj8","Type":"NodeParagraph","Properties":{"id":"20240614082416-kil3sj8","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614082416-x0xseg3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082416-x0xseg3","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鼠妇"}]},{"ID":"20240614082416-6lr9ydn","Type":"NodeParagraph","Properties":{"id":"20240614082416-6lr9ydn","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614082416-clkb35g","Type":"NodeParagraph","Properties":{"id":"20240614082416-clkb35g","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" Shǔ Fù"}]},{"ID":"20240614082416-qybtt0t","Type":"NodeParagraph","Properties":{"id":"20240614082416-qybtt0t","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614082416-535lkf6","Type":"NodeParagraph","Properties":{"id":"20240614082416-535lkf6","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 伊威（《诗经》），蟠、鼠负（《尔雅》），负蟠、蛜蜮（《本经》），委黍（《说文》），负蠜（《广雅》），蜲黍（《别录》），鼠姑（陶弘景），鼠粘（《蜀本草》），鼠赖虫、湿生虫（《圣惠方》），地鸡（《寿域神方》），地虱（《纲目》），肥蛀蚋（《本草求原》），西瓜虫、蒲鞋头虫（《苏州本产药材》），潮湿虫（《中药志》），地虱婆（《四川中药志》），豌豆虫、瓢虫、潮虫子（《药材学》），土孵（《泉州本草》），暗板虫（《全展选编·外科》），鞋板虫（内蒙古《中草药新医疗法资料选编》）。"}]},{"ID":"20240614082416-kkdxdoq","Type":"NodeParagraph","Properties":{"id":"20240614082416-kkdxdoq","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614082416-av501sz","Type":"NodeParagraph","Properties":{"id":"20240614082416-av501sz","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614082416-k5ofs8u","Type":"NodeParagraph","Properties":{"id":"20240614082416-k5ofs8u","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614082416-pbcmlzn","Type":"NodeParagraph","Properties":{"id":"20240614082416-pbcmlzn","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 为鼠妇科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"平甲虫"},{"Type":"NodeText","Data":"的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全体"},{"Type":"NodeText","Data":"。一般多在4～9月间捕捉，捕得后用沸水烫死，晒干或炒干。"}]},{"ID":"20240614082416-7j7tice","Type":"NodeParagraph","Properties":{"id":"20240614082416-7j7tice","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614082416-451543b","Type":"NodeParagraph","Properties":{"id":"20240614082416-451543b","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 常集居于朽木、枯叶、石块等下面。分布江苏、浙江等地。"}]},{"ID":"20240614082416-jut5v3w","Type":"NodeParagraph","Properties":{"id":"20240614082416-jut5v3w","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614082416-2ew4vb5","Type":"NodeParagraph","Properties":{"id":"20240614082416-2ew4vb5","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 体长椭圆形，稍扁，长约10毫米；表面灰色，有光泽。头部前缘中央及其左右侧角突起显着。有眼1对，触角2对，第一对触角微小。共3节；第二对触角呈鞭状，共6节。胸部分7个环节，每节有同形等长的足1对；第一胸节前缘延向头部前边，后侧隅向后突出，第二至第七各节侧突不显着。腹部小，分为5个环节，第一及第二腹节狭，第三至第五腹节侧缘整齐而圆。尾肢扁平，外肢与第五腹节嵌合齐平。"}]},{"ID":"20240614082416-vm2d7rl","Type":"NodeParagraph","Properties":{"id":"20240614082416-vm2d7rl","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614082416-05qksel","Type":"NodeParagraph","Properties":{"id":"20240614082416-05qksel","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 干燥的虫体，多卷曲成球形或半圆形，长约7毫米，宽约6毫米；背平滑，腹向内陷。体灰白色，有光泽。质脆易碎。气腥臭。以干燥、完整、灰白色、无霉蛀者为佳。"}]},{"ID":"20240614082416-vltiwsj","Type":"NodeParagraph","Properties":{"id":"20240614082416-vltiwsj","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"主产江苏。"}]},{"ID":"20240614082416-pyi03sy","Type":"NodeParagraph","Properties":{"id":"20240614082416-pyi03sy","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"一般文献多以Porcellio scaber Latreille作鼠妇，但在目前商品中，很少使用。"}]},{"ID":"20240614082416-ba8nmg3","Type":"NodeParagraph","Properties":{"id":"20240614082416-ba8nmg3","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614082416-e9xczgm","Type":"NodeParagraph","Properties":{"id":"20240614082416-e9xczgm","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 平甲虫的还元糖与糖原含量因生长时期而变化；其粘多糖含软骨素硫酸A或C，或含玻璃（糖醛）酸所含脂类中有不皂化物10％，丙酮不溶脂5％，皂化后的脂肪酸组成为十四酸0.7，十六酸20.6，十八酸8.3，廿酸0.7，十八碳烯酸53.7，十八碳二烯酸10.1，十八碳三烯酸2.5，其它不饱和脂酸3.2％；不皂化物含41.0％甾醇，其中主要为胆甾醇，可能还含蚁酸。"}]},{"ID":"20240614082416-komyybw","Type":"NodeParagraph","Properties":{"id":"20240614082416-komyybw","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614082416-pu0rlhy","Type":"NodeParagraph","Properties":{"id":"20240614082416-pu0rlhy","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 鼠妇虫及欧洲产平甲虫以氯仿浸提，再用乙醇、丙酮、乙醚以次精制，最后作成溶液或片剂，口服或作成油膏局部应用，可治疗麻风。"}]},{"ID":"20240614082416-ow56bgf","Type":"NodeParagraph","Properties":{"id":"20240614082416-ow56bgf","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614082416-qy9aqz9","Type":"NodeParagraph","Properties":{"id":"20240614082416-qy9aqz9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 拣净杂质微火焙黄。"}]},{"ID":"20240614082416-6lu8nz5","Type":"NodeParagraph","Properties":{"id":"20240614082416-6lu8nz5","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614082416-9r8fk8s","Type":"NodeParagraph","Properties":{"id":"20240614082416-9r8fk8s","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"厥阴经。\""}]},{"ID":"20240614082416-7kvb4sw","Type":"NodeParagraph","Properties":{"id":"20240614082416-7kvb4sw","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614082416-5qmw63g","Type":"NodeParagraph","Properties":{"id":"20240614082416-5qmw63g","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 酸，凉。"}]},{"ID":"20240614082416-p085zr3","Type":"NodeParagraph","Properties":{"id":"20240614082416-p085zr3","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微寒，无毒。\""}]},{"ID":"20240614082416-95gz6vj","Type":"NodeParagraph","Properties":{"id":"20240614082416-95gz6vj","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"酸咸，无毒。\""}]},{"ID":"20240614082416-16zm8cu","Type":"NodeParagraph","Properties":{"id":"20240614082416-16zm8cu","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614082416-c3f8q5g","Type":"NodeParagraph","Properties":{"id":"20240614082416-c3f8q5g","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《品汇精要》：\"妊娠不可服。\""}]},{"ID":"20240614082416-4hblnjs","Type":"NodeParagraph","Properties":{"id":"20240614082416-4hblnjs","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614082416-qp02a89","Type":"NodeParagraph","Properties":{"id":"20240614082416-qp02a89","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 破血，利水，解毒，止痛。治久疟疟母，经闭症瘕，小便不通，惊风撮口，口齿疼痛，鹅口诸疮。"}]},{"ID":"20240614082416-z5mrv6r","Type":"NodeParagraph","Properties":{"id":"20240614082416-z5mrv6r","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主气癃不得小便，妇人月闭血瘕，痫、痓、寒热，利水道。\""}]},{"ID":"20240614082416-mcmv8c0","Type":"NodeParagraph","Properties":{"id":"20240614082416-mcmv8c0","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"通小便，能堕胎。\""}]},{"ID":"20240614082416-5drw4c4","Type":"NodeParagraph","Properties":{"id":"20240614082416-5drw4c4","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"治久疟寒热，风虫牙齿疼痛，小儿撮口惊风，鹅口疮，痘疮倒靥，解射工毒，蜘蛛毒，蚰蜒入耳。\""}]},{"ID":"20240614082416-mzns3vx","Type":"NodeParagraph","Properties":{"id":"20240614082416-mzns3vx","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"主寒热瘀积，湿痰，喉症，惊痫，血病，喘急。\""}]},{"ID":"20240614082416-fosk5xa","Type":"NodeParagraph","Properties":{"id":"20240614082416-fosk5xa","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614082416-tg62u8z","Type":"NodeParagraph","Properties":{"id":"20240614082416-tg62u8z","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱，亦入丸、散。外用：研末调敷。"}]},{"ID":"20240614082416-8rdzb46","Type":"NodeParagraph","Properties":{"id":"20240614082416-8rdzb46","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614082416-gtqg4d7","Type":"NodeParagraph","Properties":{"id":"20240614082416-gtqg4d7","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" ①治疟病：鼠妇、豆豉二七枚，合捣，令相和，未发时服二丸，欲发时服一丸。（《补缺肘后方》）"}]},{"ID":"20240614082416-3u1x3kv","Type":"NodeParagraph","Properties":{"id":"20240614082416-3u1x3kv","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"②治经闭：鼠妇一钱，赤芍四钱，桃仁三钱，红花三钱，丹参五钱。水煎服。（《山东中草药手册》）"}]},{"ID":"20240614082416-r7qjfbo","Type":"NodeParagraph","Properties":{"id":"20240614082416-r7qjfbo","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"③治小儿撮口及发噤：鼠赖虫，绞取汁，与儿少许服之。（《圣惠方》）"}]},{"ID":"20240614082416-t6czpcs","Type":"NodeParagraph","Properties":{"id":"20240614082416-t6czpcs","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"④治产后小便不利：鼠妇七枚。熬为屑，作一服，酒调下。（《千金方》）"}]},{"ID":"20240614082416-1ajulm3","Type":"NodeParagraph","Properties":{"id":"20240614082416-1ajulm3","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑤治小便不利：鼠妇一钱五分，车前子四钱，泽泻三钱，灯心一钱。水煎服。（《山东中草药手册》）"}]},{"ID":"20240614082416-u57o6gc","Type":"NodeParagraph","Properties":{"id":"20240614082416-u57o6gc","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑥治血淋：鼠妇九个。焙干研细末，一次服下，日二次。（《吉林中草药》）"}]},{"ID":"20240614082416-kodl92t","Type":"NodeParagraph","Properties":{"id":"20240614082416-kodl92t","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑦治子宫功能性出血：鼠妇焙黄研末，每服二钱，童便送下。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240614082416-lcow1i8","Type":"NodeParagraph","Properties":{"id":"20240614082416-lcow1i8","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑧治牙齿被虫蚀，有蛀孔疼痛：湿生虫一枚。绵裹于蛀疼处咬之。（《圣惠方》）"}]},{"ID":"20240614082416-0izql52","Type":"NodeParagraph","Properties":{"id":"20240614082416-0izql52","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑨治风牙疼痛：湿生虫、巴豆仁、胡椒各一枚。研匀，饭丸绿豆大，绵裹一丸咬之，良久涎出吐去。（《经验济世良方》）"}]},{"ID":"20240614082416-wxmp9nk","Type":"NodeParagraph","Properties":{"id":"20240614082416-wxmp9nk","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑩止痛镇静，治手术后疼痛：鼠妇虫洗净，温水杀死，干燥，研细，过筛，加入淀粉和糖，使成10％散剂，分装胶囊，每粒含鼠妇0.1克。每次服二至四粒。（《全展选编·外科》）"}]},{"ID":"20240614082416-sjvvk2n","Type":"NodeParagraph","Properties":{"id":"20240614082416-sjvvk2n","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"⑾治鹅口白疮：地鸡研水涂之。（《寿域神方》）"}]},{"ID":"20240614082416-mch6o3i","Type":"NodeParagraph","Properties":{"id":"20240614082416-mch6o3i","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614082416-7cw2hlr","Type":"NodeParagraph","Properties":{"id":"20240614082416-7cw2hlr","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性气管炎"}]},{"ID":"20240614082416-5vpxwml","Type":"NodeParagraph","Properties":{"id":"20240614082416-5vpxwml","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"将鼠妇粉碎，经60％酒精处理后压制成0.3、0.5克两种片剂。0.5克片剂每次2～5片，0.3克片剂每次3～8片，均日服3次，15天为一疗程。共治247例，近期痊愈24例，显效71例，进步107例，无效45例。总有效率81.8％，其中喘息型有效率83.4％，单纯型79.4％。以肺肾虚及偏寒型疗效较好。对喘、咳、痰均有一定效果。平喘作用一般在服药后2～4小时出现，持续4～6小时。服10～15天后咳、痰、喘相继明显减轻，但消炎作用不满意。治程中曾对80例患者进行肺功能测定，治后半数以上病例有所改善，其中有1例功能9（复正常。本品一般适用于非炎症性哮喘型气管炎患者。治疗中曾发现3名肺结核合并慢性气管炎肺气肿患者，服药2～3个月后症状明显减轻，但试用于支气管哮喘，则效果不显著。考虑鼠妇具有破瘀活血作用，可能改善肺微血管的循环、促使病变恢复，从而改善肺功能，使喘息减轻。副作用：多数服药后均有不同程度的口干反应，有3例服后出现鼻出血，停药后自行消失。"}]},{"ID":"20240614082416-i7md0d5","Type":"NodeParagraph","Properties":{"id":"20240614082416-i7md0d5","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"②治疗口腔炎、扁桃体炎"}]},{"ID":"20240614082416-jip7z2g","Type":"NodeParagraph","Properties":{"id":"20240614082416-jip7z2g","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"取活鼠妇30～40个，置瓦上焙干研末，加冰片少许，装瓶密封。同时取药末吹患处（尽量不吞下，可随即吐出），每日2～3次，治疗口腔炎，扁桃体炎及鹅口疮、牙龈炎等共260余例，一般在3～5天治愈。"}]},{"ID":"20240614082416-exg4ddo","Type":"NodeParagraph","Properties":{"id":"20240614082416-exg4ddo","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614082416-811ggeo","Type":"NodeParagraph","Properties":{"id":"20240614082416-811ggeo","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《本经疏证》：\"鼠妇利水，白鱼亦利水，又皆气血交阻。但白鱼所主是寒湿阻气，因而及血；鼠妇所主是气阻及血，因壅湿热，故有异云。\""}]},{"ID":"20240614082416-umfs0pk","Type":"NodeParagraph","Properties":{"id":"20240614082416-umfs0pk","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614082416-fiweqt6","Type":"NodeParagraph","Properties":{"id":"20240614082416-fiweqt6","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614082416-wbjkiuc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082416-wbjkiuc","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鼠妇"}]},{"ID":"20240614082416-l5y7usk","Type":"NodeParagraph","Properties":{"id":"20240614082416-l5y7usk","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614082416-nk3232b","Type":"NodeParagraph","Properties":{"id":"20240614082416-nk3232b","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" Shǔ Fù"}]},{"ID":"20240614082416-hdshoo9","Type":"NodeParagraph","Properties":{"id":"20240614082416-hdshoo9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614082416-xenqbl9","Type":"NodeParagraph","Properties":{"id":"20240614082416-xenqbl9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 伊威、蟠、鼠负、委黍、负蟠、负攀、鼠姑、鼠粘、鼠赖虫、湿生虫、地鸡、地虱、肥蛀蚋、西瓜虫、蒲鞋头虫、潮湿虫、地虱婆、豌豆虫、瓢虫、潮虫子、土孵、暗板虫、鞋板虫"}]},{"ID":"20240614082416-h20j0ym","Type":"NodeParagraph","Properties":{"id":"20240614082416-h20j0ym","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614082416-gjvt2lu","Type":"NodeParagraph","Properties":{"id":"20240614082416-gjvt2lu","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" Pillbug"}]},{"ID":"20240614082416-ytyyfvs","Type":"NodeParagraph","Properties":{"id":"20240614082416-ytyyfvs","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614082416-o27tc60","Type":"NodeParagraph","Properties":{"id":"20240614082416-o27tc60","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240614082416-fpdjojb","Type":"NodeParagraph","Properties":{"id":"20240614082416-fpdjojb","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614082416-e0l187e","Type":"NodeParagraph","Properties":{"id":"20240614082416-e0l187e","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 药材基源：为卷甲虫科动物普通卷甲虫或潮虫科动物鼠妇的全体。"}]},{"ID":"20240614082416-quunt0j","Type":"NodeParagraph","Properties":{"id":"20240614082416-quunt0j","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Armadillidium vulgare (Latrielle)2.Porcellio scaber Latreille"}]},{"ID":"20240614082416-nrcnzkd","Type":"NodeParagraph","Properties":{"id":"20240614082416-nrcnzkd","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"采收和储藏：一般多在4-9月间捕捉，捕后用开水烫死，晒干或焙干。本品易遭虫蛀，最好放在石灰缺中贮存。"}]},{"ID":"20240614082416-94txm6c","Type":"NodeParagraph","Properties":{"id":"20240614082416-94txm6c","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614082416-pf06cg9","Type":"NodeParagraph","Properties":{"id":"20240614082416-pf06cg9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.多栖于朽木、腐叶或石声下，喜阴暗潮湿的环境，有时也出现在房屋、庭院内。小边及海边石下也较多。"}]},{"ID":"20240614082416-lgx52pq","Type":"NodeParagraph","Properties":{"id":"20240614082416-lgx52pq","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"2.生境同普通卷甲虫。"}]},{"ID":"20240614082416-kj2ks1x","Type":"NodeParagraph","Properties":{"id":"20240614082416-kj2ks1x","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于河北、山东、江苏、浙江等地。"}]},{"ID":"20240614082416-4q6j3br","Type":"NodeParagraph","Properties":{"id":"20240614082416-4q6j3br","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"2.分布于吉林、河北、山东、江苏、浙江、广西等地。"}]},{"ID":"20240614082416-u9oq36x","Type":"NodeParagraph","Properties":{"id":"20240614082416-u9oq36x","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614082416-t4l4j8v","Type":"NodeParagraph","Properties":{"id":"20240614082416-t4l4j8v","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 1.普通卷甲虫，体长10mm左右，长为宽的2倍。体呈长椭圆形，背呈弓形。头前丝中央及左右角没有显着的突起。胸节7，第1、第2胸节的后侧板较第3、第7节的尖锐。腹节5，第1、第2节窄，第3-5节的侧缘与尾节后缘联成半圆形。体节上有多少不等的弯曲条纹。第2触角短。胸肢7对，腹肢5对。尾肢扁平，外肢与尾节嵌合齐平，内肢细小，被尾节掩盖。雄性第1腹肢的外肢台鳃盖状，内肢较细长，末端弯曲呈微钩状。体色有时灰色或暗褐色，有时局部带黄色，并具有光亮的斑点。"}]},{"ID":"20240614082416-0rg4j74","Type":"NodeParagraph","Properties":{"id":"20240614082416-0rg4j74","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"2.鼠妇，形状与普通卷甲虫颇为相似，全体呈椭圆形，长约10mm，宽约6mm，表面有光泽，卷曲时呈球形。胸部各节后侧锐尖，尾节呈三角形，尾枝呈棒状，长于尾节。"}]},{"ID":"20240614082416-ehwypvn","Type":"NodeParagraph","Properties":{"id":"20240614082416-ehwypvn","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614082416-nz8m5nd","Type":"NodeParagraph","Properties":{"id":"20240614082416-nz8m5nd","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，虫体多卷曲成球形或半圆形，长约7mm，宽约5mm。背隆起，平滑，腹向内陷。体灰白色，有光泽。由多数近于平行的环节构成，胸部7节，每节有同形的脚1对，向前、向后逐渐变长。腹部较短，宽圆形分5节。质脆易碎。气腥臭。"}]},{"ID":"20240614082416-8v30ut2","Type":"NodeParagraph","Properties":{"id":"20240614082416-8v30ut2","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614082416-irrcaq8","Type":"NodeParagraph","Properties":{"id":"20240614082416-irrcaq8","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 普通卷甲虫，肝胰含粘多糖；硫酸软骨素（chondrolin sulfuric acid）A或硫酸软骨素C，透明质酸（hyaluronic acid）；酶有透明质酸酶（hyaluronidase），神经胺酶（nearaminidase）；还含硫、磷、钠、钙、铁、镁等。"}]},{"ID":"20240614082416-2caueti","Type":"NodeParagraph","Properties":{"id":"20240614082416-2caueti","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"雄性生殖器及雄性腺含雄性激素（androgenic hormone）Ⅰ，雄性激素Ⅱ；雄性腺又含雄性激素；肥大肾上腺含雄性激素及雄性激素Ⅰ、Ⅱ。雄虫含卵黄蛋白原（vitellogenin）1、2、3、4。雌虫卵巢含卵黄磷蛋白（vitellin1）1、2、3、4。血淋巴含卵黄蛋白原1、2、3、4。外皮腺含多酚氧化酶（polyphenol oxidase）。全体含糖原（glycogen），糖（sugar），血淋巴蛋白（hemolymph protein），后内脏表皮腺三磷酸酶（hindeut epithelium adenosine triphosphatase），胆甾醇（cholesterol）。"}]},{"ID":"20240614082416-cl7lf6y","Type":"NodeParagraph","Properties":{"id":"20240614082416-cl7lf6y","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614082416-30jxv1t","Type":"NodeParagraph","Properties":{"id":"20240614082416-30jxv1t","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 治疗麻风作用：鼠妇虫及欧洲产平甲虫Armadillidium officinarum 以氯仿浸提，再用乙醇、丙酮、乙醚以次精制，最后作成溶液或片剂，口服或作成油膏局部应用，可治疗麻风。"}]},{"ID":"20240614082416-tca835v","Type":"NodeParagraph","Properties":{"id":"20240614082416-tca835v","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614082416-31p67zr","Type":"NodeParagraph","Properties":{"id":"20240614082416-31p67zr","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，微火焙黄。"}]},{"ID":"20240614082416-ow1dofb","Type":"NodeParagraph","Properties":{"id":"20240614082416-ow1dofb","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614082416-inn8uv2","Type":"NodeParagraph","Properties":{"id":"20240614082416-inn8uv2","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240614082416-9z8cs37","Type":"NodeParagraph","Properties":{"id":"20240614082416-9z8cs37","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614082416-txdv6o0","Type":"NodeParagraph","Properties":{"id":"20240614082416-txdv6o0","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 味酸；咸；性凉"}]},{"ID":"20240614082416-d3n5kyy","Type":"NodeParagraph","Properties":{"id":"20240614082416-d3n5kyy","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614082416-w97a6ad","Type":"NodeParagraph","Properties":{"id":"20240614082416-w97a6ad","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 孕妇及体虚无瘀者禁服。"}]},{"ID":"20240614082416-ml9jkoz","Type":"NodeParagraph","Properties":{"id":"20240614082416-ml9jkoz","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614082416-1x911z5","Type":"NodeParagraph","Properties":{"id":"20240614082416-1x911z5","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 破瘀消症；通经；利水；解毒；止痛。主症瘕；疟母；血瘀经闭；小便不通；惊风撮口；牙齿疼痛；鹅口诸疮"}]},{"ID":"20240614082416-fdind1a","Type":"NodeParagraph","Properties":{"id":"20240614082416-fdind1a","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614082416-y651ego","Type":"NodeParagraph","Properties":{"id":"20240614082416-y651ego","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g，或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240614082416-dpcpmiw","Type":"NodeParagraph","Properties":{"id":"20240614082416-dpcpmiw","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614082416-jv2nuon","Type":"NodeParagraph","Properties":{"id":"20240614082416-jv2nuon","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" ①治疟病： 鼠妇、豆豉二七枚。合捣，令相和，未发时服二九，欲发时服一九。(砷＞缺时后方》)②治经闭： 鼠妇一钱，赤芍四钱，桃仁三钱，红花三钱，丹参五钱。水煎服。(《山东中草药手册》)③治小儿撮口及发噤： 鼠赖虫，续取汁，与儿少许服之。(《圣惠方》)④治产后小便不利： 鼠妇七枚。熬为屑，作一服，酒调下。(《干金方》)⑤治小便不利： 鼠妇一钱五分，车前子四钱，泽泻三钱，灯心一钱。水煎服。 (《山东中草药手册》)⑥治血淋： 鼠妇九个。焙干研细末，一次服下，日二次。(《吉林中草药》)⑦治子宫功能性出血： 鼠妇焙黄研末，每服二钱，童便送下。 (内蒙古《中草药新医疗法资料选编》)⑧治牙齿被虫蚀，有蛀孔疼痛： 湿生虫一枚。锦裹干蛀疼处咬之。 (《圣惠方》)⑨治风牙疼痛： 湿生虫、巴豆仁、胡椒备一枚。研匀，饭丸绿豆大， 锦裹一九咬之， 良久涎出吐去。 (《经验济世良方》)⑩止痛镇静，治手术后疼痛： 鼠妇虫洗净，温水杀死，干燥，研细，过筛，加入淀粉和糖，使成10彩散剂，分装胶囊，每粒含鼠妇0．1克。每次服二至四粒。 (《全展选编·外科》)(11)治鹅口白疮： 地鸡研水涂之。 (《寿域神方》)"}]},{"ID":"20240614082416-0lvzy3x","Type":"NodeParagraph","Properties":{"id":"20240614082416-0lvzy3x","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614082416-5lg8gma","Type":"NodeParagraph","Properties":{"id":"20240614082416-5lg8gma","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 1.治疗慢性气管炎：将鼠妇粉碎，经60%酒精处理后压制成0.3、0.5g两种片剂。0.5g片剂每次2-5片，0.3克片剂每次3-8片，均日服3次，15天为一疗程。共治247例，近期痊愈24例，显效71例，进步107例，无效45例。总有效率81.8%，其中喘息型有效率83.4%，单纯型79.4%。以肺肾虚及偏寒型疗效较好。对喘、咳、痰均有一定效果。平喘作用一般在服药后2-4小时出现，持续4-6小时。服10-15天后咳、痰、喘相继明显减轻，但消炎作用不满意。治程中曾对80例患者进行肺功能测定，治后半数以上病例有所改善，其中有 l例功能恢复正常。本品一般适用于非炎症性哮喘型气管炎患者。治疗中曾发现3名肺结核合并慢性气管炎肺气肿患者，服药2-3个月后症状明显减轻，但试用于支气管哮喘，则效果不显着。考虑鼠妇具有破疯活血作用，可能改善肺微血管的循环、促使病变恢复，从而改善肺功能，使喘息减轻。副作用：多数服药后均有不同程度的口干反应，有3例服后出现鼻出血，停药后自行消失。"}]},{"ID":"20240614082416-vwspt2l","Type":"NodeParagraph","Properties":{"id":"20240614082416-vwspt2l","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"2.治疗口腔炎、扁桃体炎：取活鼠妇30-40个，置瓦上焙干研末，加冰片少许，装瓶密封。同时取药末吹患处(尽量不吞下，可随即吐出)，每曰2-3次。治疗口腔炎、肩挑体炎及鹅口疮、牙频炎等共250余例，一般在3-5天治愈。"}]},{"ID":"20240614082416-jm0zuc9","Type":"NodeParagraph","Properties":{"id":"20240614082416-jm0zuc9","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614082416-aimg2at","Type":"NodeParagraph","Properties":{"id":"20240614082416-aimg2at","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 1.《本经疏证》：鼠妇利水， 白鱼亦利水，又皆气血交阻。但白鱼所主是寒湿阻气，因而及血；鼠妇所主是气阻及血，因袭湿热，故有异云。"}]},{"ID":"20240614082416-uji010m","Type":"NodeParagraph","Properties":{"id":"20240614082416-uji010m","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主气癃不得小便，妇人月闭血瘕，痫、寒热、利水道。"}]},{"ID":"20240614082416-rleq9g0","Type":"NodeParagraph","Properties":{"id":"20240614082416-rleq9g0","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：通小便，能堕胎。"}]},{"ID":"20240614082416-t0i78jp","Type":"NodeParagraph","Properties":{"id":"20240614082416-t0i78jp","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治久疟寒热，风虫牙齿疼痛，小儿撮口惊风，鹅口疮，痘疮倒靥，解射工毒，蜘蛛毒，蚰蜒入耳。"}]},{"ID":"20240614082416-at8dpg0","Type":"NodeParagraph","Properties":{"id":"20240614082416-at8dpg0","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"5.《本草求原》：主寒热瘀积，湿痰，喉症，惊痫，血病，喘急。"}]},{"ID":"20240614082416-2x3lhhn","Type":"NodeParagraph","Properties":{"id":"20240614082416-2x3lhhn","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614082416-vl3goh8","Type":"NodeParagraph","Properties":{"id":"20240614082416-vl3goh8","updated":"20240614082416"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614082417-8mek1kk","Type":"NodeThematicBreak","Properties":{"id":"20240614082417-8mek1kk"}},{"ID":"20240614082418-v9ybezk","Type":"NodeParagraph","Properties":{"id":"20240614082418-v9ybezk"}}]}