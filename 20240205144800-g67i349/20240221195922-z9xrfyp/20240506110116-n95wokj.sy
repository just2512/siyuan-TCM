\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 538px;","style":"width: 528px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"萤火虫1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/萤火虫1-20240703155651-jefw687.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 528px;\" parent-style=\"width: 538px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828094259-b8mabhb","Type":"NodeParagraph","Properties":{"id":"20240828094259-b8mabhb","updated":"20240828094259"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 332px;","style":"width: 322px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"萤火虫4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/萤火虫4-20240703155828-ue1kou9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 322px;\" parent-style=\"width: 332px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 785px;","style":"width: 775px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"萤火虫2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/萤火虫2-20240703155754-p77md5y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 775px;\" parent-style=\"width: 785px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703160011-73y8fgk","Type":"NodeParagraph","Properties":{"id":"20240703160011-73y8fgk","updated":"20240828094244"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 649px;","style":"width: 639px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"萤火虫7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/萤火虫7-20240703160012-rtd801b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 639px;\" parent-style=\"width: 649px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240614090015-ku2nph3","Type":"NodeThematicBreak","Properties":{"id":"20240614090015-ku2nph3"}},{"ID":"20240614090307-5uu863n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090307-5uu863n","updated":"20240614090312"},"Children":[{"Type":"NodeText","Data":"荧火《神农本草经》"}]},{"ID":"20240614090307-itx1qfd","Type":"NodeParagraph","Properties":{"id":"20240614090307-itx1qfd","updated":"20240614090307"},"Children":[{"Type":"NodeText","Data":"味辛微温。"}]},{"ID":"20240614090307-nk7gavh","Type":"NodeParagraph","Properties":{"id":"20240614090307-nk7gavh","updated":"20240614090307"},"Children":[{"Type":"NodeText","Data":"主明目，小儿火创伤，热，气，蛊毒，鬼注，通神。一名夜光（《御览》引云，一名熠耀，一名即照，《大观本》，作黑字）。生池泽。"}]},{"ID":"20240614090307-2kgd4sj","Type":"NodeParagraph","Properties":{"id":"20240614090307-2kgd4sj","updated":"20240614090307"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：荧火一名夜照，一名熠耀，一名救火，一名景天，一名据火，一名挟火（艺文类聚）。"}]},{"ID":"20240614090307-ht39p8q","Type":"NodeParagraph","Properties":{"id":"20240614090307-ht39p8q","updated":"20240614090307"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名放光，一名熠耀，一名即照，生阶地，七月七日收，阴干。"}]},{"ID":"20240614090307-syllb2s","Type":"NodeParagraph","Properties":{"id":"20240614090307-syllb2s","updated":"20240614090307"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上炎下舛），兵死及牛马之血为磷，鬼火也，从炎舛。《尔雅》云：荧水即照。郭璞云：夜飞，腹下有火。《毛诗》云：熠耀宵行，《传》云熠耀，磷也，磷，荧火也，月令云：季夏之月，腐草化为荧。郑元云：萤飞虫，萤火也，据毛苌以萤为磷，是也，《说文》无萤字，当以磷为之，《尔雅》作荧，亦是，旧作萤，非。又按月令，腐草为萤，当是蠲字假音。"}]},{"ID":"20240614090015-knf9jdz","Type":"NodeThematicBreak","Properties":{"id":"20240614090015-knf9jdz"}},{"ID":"20240614090016-gx0isco","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090016-gx0isco","updated":"20240614090020"},"Children":[{"Type":"NodeText","Data":"萤火《本草撮要》"}]},{"ID":"20240614090016-uop0c6p","Type":"NodeParagraph","Properties":{"id":"20240614090016-uop0c6p","updated":"20240614090016"},"Children":[{"Type":"NodeText","Data":"味辛．入手太阴经．功专治温疫．务成子有萤火丸．"}]},{"ID":"20240614085129-7ir78y1","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-7ir78y1"}},{"ID":"20240614090008-yenkohh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090008-yenkohh","updated":"20240614090011"},"Children":[{"Type":"NodeText","Data":"萤火《吴普本草》"}]},{"ID":"20240614090008-43f875k","Type":"NodeParagraph","Properties":{"id":"20240614090008-43f875k","updated":"20240614090008"},"Children":[{"Type":"NodeText","Data":"《类聚》卷九十七"}]},{"ID":"20240614090008-jgoimib","Type":"NodeParagraph","Properties":{"id":"20240614090008-jgoimib","updated":"20240614090008"},"Children":[{"Type":"NodeText","Data":"一名夜照，一名熠耀，一名救火，一名景天，一名据火，一名挟火。"}]},{"ID":"20240614085129-9ldnocg","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-9ldnocg"}},{"ID":"20240614085959-0e6xyan","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085959-0e6xyan","updated":"20240614090003"},"Children":[{"Type":"NodeText","Data":"萤火《本经逢原》"}]},{"ID":"20240614085959-xfj864u","Type":"NodeParagraph","Properties":{"id":"20240614085959-xfj864u","updated":"20240614085959"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即熠耀，《本经》名夜光"}]},{"ID":"20240614085959-440c1t7","Type":"NodeParagraph","Properties":{"id":"20240614085959-440c1t7","updated":"20240614085959"},"Children":[{"Type":"NodeText","Data":"辛温无毒。"}]},{"ID":"20240614085959-w70nwmi","Type":"NodeParagraph","Properties":{"id":"20240614085959-w70nwmi","updated":"20240614085959"},"Children":[{"Type":"NodeText","Data":"《本经》明目。"}]},{"ID":"20240614085959-2yw8kbp","Type":"NodeParagraph","Properties":{"id":"20240614085959-2yw8kbp","updated":"20240614085959"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"萤火本腐草所化，得大火之余气而成。入胞络三焦，能辟邪、明目，取其照幽夜明之义。务成子萤火丸，辟五兵白刃，虎野狼蛇虺之毒，恶鬼疫疠之邪。庞安常亦极言其效，惜乎，世鲜备用。"}]},{"ID":"20240614085129-1f3ev3a","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-1f3ev3a"}},{"ID":"20240614085950-w1kpynb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085950-w1kpynb","updated":"20240614085954"},"Children":[{"Type":"NodeText","Data":"萤火《本草崇原》"}]},{"ID":"20240614085950-yis9zwk","Type":"NodeParagraph","Properties":{"id":"20240614085950-yis9zwk","updated":"20240614085950"},"Children":[{"Type":"NodeText","Data":"气味辛，微温，无毒。主明目。"}]},{"ID":"20240614085950-gpyfzim","Type":"NodeParagraph","Properties":{"id":"20240614085950-gpyfzim","updated":"20240614085950"},"Children":[{"Type":"NodeText","Data":"（萤火《本经》名夜光，《别录》云萤火，生阶地池泽，七月七日取阴干。萤有三种，一种茅根所化。《吕氏月令》所谓∶腐草化为萤者是也。一种长如蛆 ，尾后有光，无翼不飞，乃竹根所化，其名曰蠲。《明堂月令》所谓∶腐草化为蠲者是也。"}]},{"ID":"20240614085950-4z4e6i8","Type":"NodeParagraph","Properties":{"id":"20240614085950-4z4e6i8","updated":"20240614085950"},"Children":[{"Type":"NodeText","Data":"一种水萤，居水中。唐李子卿《水萤赋》所谓∶彼何为而草化，此何为而居泉是也。入药用飞萤。）"}]},{"ID":"20240614085950-978due0","Type":"NodeParagraph","Properties":{"id":"20240614085950-978due0","updated":"20240614085950"},"Children":[{"Type":"NodeText","Data":"润下作咸，其臭腐，腐草为萤，禀水气也。萤为火宿，名曰萤火，禀火气也。生于七月，其时大火西流，故气味辛温。水之精，火之神，共凑于目，故《本经》主明目，而《别录》又云∶通神精。"}]},{"ID":"20240614090143-kyzfevv","Type":"NodeThematicBreak","Properties":{"id":"20240614090143-kyzfevv"}},{"ID":"20240614090144-24zsepr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090144-24zsepr","updated":"20240614090148"},"Children":[{"Type":"NodeText","Data":"萤火《新修本草》"}]},{"ID":"20240614090144-00a8era","Type":"NodeParagraph","Properties":{"id":"20240614090144-00a8era","updated":"20240614090144"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主明目，小儿火疮，伤热气，蛊毒，鬼疰，通神精。一名夜光，一名放光，一名熠耀，一名即照。生阶地池泽。七月七日取，阴干。"}]},{"ID":"20240614090144-0hk15aw","Type":"NodeParagraph","Properties":{"id":"20240614090144-0hk15aw","updated":"20240614090144"},"Children":[{"Type":"NodeText","Data":"此是腐草及烂竹根所化，初犹未如虫，腹下以有光，数日便变而能飞。方术家捕取内酒中，令死乃干之，俗药用之亦稀。"}]},{"ID":"20240614090135-5thght2","Type":"NodeThematicBreak","Properties":{"id":"20240614090135-5thght2"}},{"ID":"20240614090136-4omijde","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090136-4omijde","updated":"20240614090139"},"Children":[{"Type":"NodeText","Data":"萤火《本草纲目》"}]},{"ID":"20240614090136-i2te6ml","Type":"NodeParagraph","Properties":{"id":"20240614090136-i2te6ml","updated":"20240614090136"},"Children":[{"Type":"NodeText","Data":"「释名」夜光、熠、景天、救火，据火、挟火。"}]},{"ID":"20240614090136-j76e566","Type":"NodeParagraph","Properties":{"id":"20240614090136-j76e566","updated":"20240614090136"},"Children":[{"Type":"NodeText","Data":"「气味」辛、微温、无毒。"}]},{"ID":"20240614090136-d7avf1w","Type":"NodeParagraph","Properties":{"id":"20240614090136-d7avf1w","updated":"20240614090136"},"Children":[{"Type":"NodeText","Data":"「主治」明目，疗青盲，治小儿火疮伤等。"}]},{"ID":"20240614090125-nlzegeb","Type":"NodeThematicBreak","Properties":{"id":"20240614090125-nlzegeb"}},{"ID":"20240614090126-i5ria3r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090126-i5ria3r","updated":"20240614090130"},"Children":[{"Type":"NodeText","Data":"萤火《证类本草》"}]},{"ID":"20240614090126-m4zrl90","Type":"NodeParagraph","Properties":{"id":"20240614090126-m4zrl90","updated":"20240614090126"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主明目，小儿火疮，伤热气，蛊毒，鬼疰，通神精。一名夜光，一名放光，一名熠（以入切） （以灼切），一名即 （音照）。生阶地池泽。七月七日取，阴干。"}]},{"ID":"20240614090126-o37yfnj","Type":"NodeParagraph","Properties":{"id":"20240614090126-o37yfnj","updated":"20240614090126"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此是腐草及烂竹根所化，初犹未如虫，腹下已有光，数日便变而能飞。方∶术家捕取纳酒中，令死乃干之，俗药用之亦稀。臣禹锡等谨按蜀本注云∶《尔雅》云，萤火，即。《注》曰，夜飞，腹下有火，按此虫是朽草所化也。《吕氏春秋》云∶腐草化为萤是也。"}]},{"ID":"20240614090126-8e98vzo","Type":"NodeParagraph","Properties":{"id":"20240614090126-8e98vzo","updated":"20240614090126"},"Children":[{"Type":"NodeText","Data":"药性论云∶萤火，亦可单用，治青盲。"}]},{"ID":"20240614090126-td35l14","Type":"NodeParagraph","Properties":{"id":"20240614090126-td35l14","updated":"20240614090126"},"Children":[{"Type":"NodeText","Data":"衍义曰∶萤，常在大暑前后飞出，是得大火之气而化，故如此明照也，今人用者少。《月令》虽曰腐草所化，然非阴湿处终无。"}]},{"ID":"20240614085129-mx4yvdv","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-mx4yvdv"}},{"ID":"20240614085258-ofqrwab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085258-ofqrwab","updated":"20240614085302"},"Children":[{"Type":"NodeText","Data":"萤火《千金翼方》"}]},{"ID":"20240614085258-3ij0xx4","Type":"NodeParagraph","Properties":{"id":"20240614085258-3ij0xx4","updated":"20240614085258"},"Children":[{"Type":"NodeText","Data":"味辛。微温，无毒。主明目，小儿火疮伤，热气蛊毒，鬼疰，通神精，一名夜光，一名放火，一名熠 ，一名即 ，生阶地池泽，七月七日取，阴干。"}]},{"ID":"20240614085129-3fxlhpd","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-3fxlhpd"}},{"ID":"20240614085246-k2x75ey","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085246-k2x75ey","updated":"20240614085254"},"Children":[{"Type":"NodeText","Data":"萤火《名医别录》"}]},{"ID":"20240614085246-i0ptasw","Type":"NodeParagraph","Properties":{"id":"20240614085246-i0ptasw","updated":"20240614085246"},"Children":[{"Type":"NodeText","Data":"无毒．一名放光，一名熠耀，一名即 ．生阶地．七月七日取，阴干．"}]},{"ID":"20240614085246-slh1fl9","Type":"NodeParagraph","Properties":{"id":"20240614085246-slh1fl9","updated":"20240614085246"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶萤火，味辛，微温．主明目，小儿火疮伤热气，蛊毒鬼注，通神精．一名夜光．生池泽．"}]},{"ID":"20240614085129-fz9aodw","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-fz9aodw"}},{"ID":"20240614085237-51qvoco","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085237-51qvoco","updated":"20240614085241"},"Children":[{"Type":"NodeText","Data":"萤火《新修本草》"}]},{"ID":"20240614085237-bp895jx","Type":"NodeParagraph","Properties":{"id":"20240614085237-bp895jx","updated":"20240614085237"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主明目，小儿火疮，伤热气，蛊毒，鬼疰，通神精。一名夜光，一名放光，一名熠耀，一名即照。生阶地池泽。七月七日取，阴干。"}]},{"ID":"20240614085237-zml7q1p","Type":"NodeParagraph","Properties":{"id":"20240614085237-zml7q1p","updated":"20240614085237"},"Children":[{"Type":"NodeText","Data":"此是腐草及烂竹根所化，初犹未如虫，腹下以有光，数日便变而能飞。方术家捕取内酒中，令死乃干之，俗药用之亦稀。"}]},{"ID":"20240614085129-cxgco4q","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-cxgco4q"}},{"ID":"20240614085148-thl18cl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085148-thl18cl","updated":"20240614085152"},"Children":[{"Type":"NodeText","Data":"萤火《医学入门》"}]},{"ID":"20240614085148-wwqqeqx","Type":"NodeParagraph","Properties":{"id":"20240614085148-wwqqeqx","updated":"20240614085148"},"Children":[{"Type":"NodeText","Data":"是腐草得大火气化成。味辛，温，无毒。主青盲明目，小儿火疮伤热气，蛊毒鬼疰，通神精。七夕采，阴干。"}]},{"ID":"20240614085129-tj440ze","Type":"NodeThematicBreak","Properties":{"id":"20240614085129-tj440ze"}},{"ID":"20240614085130-qsibym5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085130-qsibym5","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：萤火"}]},{"ID":"20240614085130-wmpy19a","Type":"NodeParagraph","Properties":{"id":"20240614085130-wmpy19a","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614085130-v0g2m9k","Type":"NodeParagraph","Properties":{"id":"20240614085130-v0g2m9k","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" Yínɡ Huǒ"}]},{"ID":"20240614085130-xnyb7uf","Type":"NodeParagraph","Properties":{"id":"20240614085130-xnyb7uf","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614085130-sfl731n","Type":"NodeParagraph","Properties":{"id":"20240614085130-sfl731n","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 宵行（《诗经》），磷（《毛诗传》），丹鸟、丹良（《夏小正》），即照（《尔雅》），夜光（《本经》），夜照、景天、救火、据火、挟火（《吴普本草》），耀夜、宵烛（崔豹《古今注》），放光（《别录》），磷然、照磷（《品汇精要》）。"}]},{"ID":"20240614085130-lsw93q9","Type":"NodeParagraph","Properties":{"id":"20240614085130-lsw93q9","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614085130-8udxhzq","Type":"NodeParagraph","Properties":{"id":"20240614085130-8udxhzq","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614085130-5ak0axv","Type":"NodeParagraph","Properties":{"id":"20240614085130-5ak0axv","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614085130-v48169b","Type":"NodeParagraph","Properties":{"id":"20240614085130-v48169b","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 为萤科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"萤火虫"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"。夏、秋间捕捉。"}]},{"ID":"20240614085130-v1tay96","Type":"NodeParagraph","Properties":{"id":"20240614085130-v1tay96","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614085130-2oa5k0k","Type":"NodeParagraph","Properties":{"id":"20240614085130-2oa5k0k","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 体形狭长，长1.5～2厘米，雌雄相等。体黑褐色，前胸背及尾瑞之2节暗黄色或桃色。头隐于前胸下，口尖，能咀嚼；触角鞭状，具灰色毛。前胸背中央有暗褐色直条纹，后缘角突出，多刻点。棱状部长三角形。翅2对，前翅为革质之鞘翅，上有隆起的直纹4条，间室多刻点；后翅膜质稍大，折叠于翅鞘下。足3对，前、中两肢的基节为圆柱形，后肢基节内方有圆锥状之突起，胫节无刺，腹6～7节，能扭动自如。尾节黄白色部分能发光。发光力雄虫较强，雌虫较弱。"}]},{"ID":"20240614085130-cy2g7tt","Type":"NodeParagraph","Properties":{"id":"20240614085130-cy2g7tt","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"成虫多栖于水边的草丛中，昼伏夜出。雌虫产卵于水边草根间，卵渐次发育时，自其内部发光：幼虫栖于水边，能捕食小虫及钉螺蛳。"}]},{"ID":"20240614085130-wkns1kj","Type":"NodeParagraph","Properties":{"id":"20240614085130-wkns1kj","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614085130-njcgp3p","Type":"NodeParagraph","Properties":{"id":"20240614085130-njcgp3p","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 《本草撮要》：\"入手太阴经。\""}]},{"ID":"20240614085130-36bbwsu","Type":"NodeParagraph","Properties":{"id":"20240614085130-36bbwsu","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614085130-7l0enhi","Type":"NodeParagraph","Properties":{"id":"20240614085130-7l0enhi","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味辛，微温。\""}]},{"ID":"20240614085130-bo5ct3q","Type":"NodeParagraph","Properties":{"id":"20240614085130-bo5ct3q","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240614085130-d5dmpbm","Type":"NodeParagraph","Properties":{"id":"20240614085130-d5dmpbm","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614085130-65bq6lz","Type":"NodeParagraph","Properties":{"id":"20240614085130-65bq6lz","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"主明目，小儿火疮伤，热气。\""}]},{"ID":"20240614085130-du9lan2","Type":"NodeParagraph","Properties":{"id":"20240614085130-du9lan2","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治青盲。\""}]},{"ID":"20240614085130-wca14ih","Type":"NodeParagraph","Properties":{"id":"20240614085130-wca14ih","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614085130-yblqnpk","Type":"NodeParagraph","Properties":{"id":"20240614085130-yblqnpk","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 治劳伤肝气，目暗：萤火虫二七枚，用鲤鱼胆二枚，纳萤火虫于胆中，阴干百日，捣罗为末。每用少许点之。（《圣惠方》）"}]},{"ID":"20240614085130-izd2248","Type":"NodeParagraph","Properties":{"id":"20240614085130-izd2248","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614085130-ztbjm9x","Type":"NodeParagraph","Properties":{"id":"20240614085130-ztbjm9x","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614085130-8cs8bj6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614085130-8cs8bj6","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"《中华本草》：萤火"}]},{"ID":"20240614085130-kldr1qf","Type":"NodeParagraph","Properties":{"id":"20240614085130-kldr1qf","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614085130-hbhp59z","Type":"NodeParagraph","Properties":{"id":"20240614085130-hbhp59z","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" Yínɡ Huǒ"}]},{"ID":"20240614085130-0obmapj","Type":"NodeParagraph","Properties":{"id":"20240614085130-0obmapj","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614085130-zh0gthz","Type":"NodeParagraph","Properties":{"id":"20240614085130-zh0gthz","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 宵行、即照、夜光、夜照、景天、救火、据火、挟火、耀夜、宵烛、放光、夜明虫"}]},{"ID":"20240614085130-krtodpi","Type":"NodeParagraph","Properties":{"id":"20240614085130-krtodpi","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614085130-o91bj4u","Type":"NodeParagraph","Properties":{"id":"20240614085130-o91bj4u","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" firefly, glowworm, lightning bug"}]},{"ID":"20240614085130-ui81q4d","Type":"NodeParagraph","Properties":{"id":"20240614085130-ui81q4d","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614085130-lwllday","Type":"NodeParagraph","Properties":{"id":"20240614085130-lwllday","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》；《纲目》：萤有三种：一种小而宵飞，腹下光明。一种长如蛆蠾，尾后有光、无翼不飞，一名趟，俗名萤蛆。一种水萤，居水中。入药用飞萤。"}]},{"ID":"20240614085130-m6dojf8","Type":"NodeParagraph","Properties":{"id":"20240614085130-m6dojf8","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614085130-6jo9tte","Type":"NodeParagraph","Properties":{"id":"20240614085130-6jo9tte","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 药材基源：为萤科动物萤火虫的全虫。"}]},{"ID":"20240614085130-5jgfct1","Type":"NodeParagraph","Properties":{"id":"20240614085130-5jgfct1","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Luciola vitticollis Kies"}]},{"ID":"20240614085130-srs0vdy","Type":"NodeParagraph","Properties":{"id":"20240614085130-srs0vdy","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季间捕捉，捕后用沸水烫死，晒干。"}]},{"ID":"20240614085130-6trs053","Type":"NodeParagraph","Properties":{"id":"20240614085130-6trs053","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614085130-8n7llzl","Type":"NodeParagraph","Properties":{"id":"20240614085130-8n7llzl","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 生态环境：成虫多栖二水边草丛中，昼伏夜出，雌虫产卵于水边草根间，卵渐次发育时，自其内部发光；幼虫栖于水边。能食小虫。"}]},{"ID":"20240614085130-oit1dyo","Type":"NodeParagraph","Properties":{"id":"20240614085130-oit1dyo","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"资源分布：全国大部分地区有分布。"}]},{"ID":"20240614085130-hv6s4nt","Type":"NodeParagraph","Properties":{"id":"20240614085130-hv6s4nt","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614085130-d4ctzib","Type":"NodeParagraph","Properties":{"id":"20240614085130-d4ctzib","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 萤火虫，体形狭长，长1.5-20mm。体黑褐色，前胸背及尾端的2节暗黄色或桃色。头隐于前胸下，口尖。触角鞭状，前胸背中面有暗褐色直条纹，后缘角突出，多刻点。棱状部长三角形。翅2对，前翅为革质的鞘翅，上有隆起的直径4条，间室多刻点；后翅膜质稍大，折叠于翅鞘下。足3对，腹6-7节，尾节黄白色部分能发光。发光力雄虫较强。"}]},{"ID":"20240614085130-nrqh8sx","Type":"NodeParagraph","Properties":{"id":"20240614085130-nrqh8sx","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614085130-qfna31o","Type":"NodeParagraph","Properties":{"id":"20240614085130-qfna31o","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 肺；肝经"}]},{"ID":"20240614085130-rvlkt3o","Type":"NodeParagraph","Properties":{"id":"20240614085130-rvlkt3o","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614085130-t07qiub","Type":"NodeParagraph","Properties":{"id":"20240614085130-t07qiub","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 味辛；性微温"}]},{"ID":"20240614085130-7am7tpw","Type":"NodeParagraph","Properties":{"id":"20240614085130-7am7tpw","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614085130-qxje5q0","Type":"NodeParagraph","Properties":{"id":"20240614085130-qxje5q0","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 明目；乌发；解毒。主青盲目暗；头发早白；水火烫伤"}]},{"ID":"20240614085130-y3z4poz","Type":"NodeParagraph","Properties":{"id":"20240614085130-y3z4poz","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614085130-4u55zlk","Type":"NodeParagraph","Properties":{"id":"20240614085130-4u55zlk","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，7-14只。外用：适量，研末点眼。"}]},{"ID":"20240614085130-txck4o5","Type":"NodeParagraph","Properties":{"id":"20240614085130-txck4o5","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614085130-05mzm7g","Type":"NodeParagraph","Properties":{"id":"20240614085130-05mzm7g","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 治劳伤肝气，目暗、萤火虫二七枚，用鲤鱼胆二枚，纳萤火虫于胆中，阴千百日，捣罗为未。每用少许点之。（《圣惠方》）"}]},{"ID":"20240614085130-ygumeop","Type":"NodeParagraph","Properties":{"id":"20240614085130-ygumeop","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614085130-vcudytv","Type":"NodeParagraph","Properties":{"id":"20240614085130-vcudytv","updated":"20240614085130"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614085132-m2n3fhj","Type":"NodeThematicBreak","Properties":{"id":"20240614085132-m2n3fhj"}},{"ID":"20240614085132-hvp7dge","Type":"NodeParagraph","Properties":{"id":"20240614085132-hvp7dge"}}]}