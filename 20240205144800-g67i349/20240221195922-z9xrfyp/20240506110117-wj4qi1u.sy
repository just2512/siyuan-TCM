{"ID":"20240506110117-wj4qi1u","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506110117-wj4qi1u","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506110117-wj4qi1u\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506110117-4y9ezel\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614090449-c4kwr8d\u0026quot;,\u0026quot;scrollTop\u0026quot;:730,\u0026quot;focusId\u0026quot;:\u0026quot;20240614090725-i799ogp\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"351衣鱼","type":"doc","updated":"20240828094556"},"Children":[{"ID":"20240703160306-4n0vhjp","Type":"NodeParagraph","Properties":{"id":"20240703160306-4n0vhjp","updated":"20240828094556"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 309px;","style":"width: 299px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼5-20240703160920-6pjmwup.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 299px;\" parent-style=\"width: 309px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 694px;","style":"width: 684px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼9-20240703161826-12n8ah5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 684px;\" parent-style=\"width: 694px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828094525-65bocdj","Type":"NodeParagraph","Properties":{"id":"20240828094525-65bocdj","updated":"20240828094526"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼4-20240703160817-rwnwjen.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 603px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼2-20240703160350-mtez6zv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703160432-pa9qvba","Type":"NodeParagraph","Properties":{"id":"20240703160432-pa9qvba","updated":"20240828094312"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 523px;","style":"width: 513px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼3-20240703160432-zvuqrys.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 513px;\" parent-style=\"width: 523px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 693px;","style":"width: 683px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼-20240703160306-30zmft1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 683px;\" parent-style=\"width: 693px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240828094404-jy0b1n8","Type":"NodeParagraph","Properties":{"id":"20240828094404-jy0b1n8","updated":"20240828094532"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼-20240828094404-juufvrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 642px;","style":"width: 632px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"衣鱼 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/衣鱼 1-20240828094443-xook8xy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 632px;\" parent-style=\"width: 642px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614090445-9fs3lwf","Type":"NodeThematicBreak","Properties":{"id":"20240614090445-9fs3lwf"}},{"ID":"20240614090549-4smix6v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090549-4smix6v","updated":"20240614090554"},"Children":[{"Type":"NodeText","Data":"衣鱼《神农本草经》"}]},{"ID":"20240614090549-vnnl4qa","Type":"NodeParagraph","Properties":{"id":"20240614090549-vnnl4qa","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"味咸温。"}]},{"ID":"20240614090549-xiohtbd","Type":"NodeParagraph","Properties":{"id":"20240614090549-xiohtbd","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"无毒，主妇人疝瘕，小便不利（《御览》作泄利），小儿中风（览作头风），项强（《御览》作强），背起摩之。一名白鱼，生平洋。"}]},{"ID":"20240614090549-285m5sb","Type":"NodeParagraph","Properties":{"id":"20240614090549-285m5sb","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：衣中白鱼，一名蟫（《御览》）。"}]},{"ID":"20240614090549-cbu8wa9","Type":"NodeParagraph","Properties":{"id":"20240614090549-cbu8wa9","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名蟫，生咸阳。"}]},{"ID":"20240614090549-yn2uo12","Type":"NodeParagraph","Properties":{"id":"20240614090549-yn2uo12","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蟫，白鱼也。《广雅》云：白鱼，蛃鱼也。《尔雅》云：蟫，白鱼。"}]},{"ID":"20240614090549-4pxgc6f","Type":"NodeParagraph","Properties":{"id":"20240614090549-4pxgc6f","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"郭璞云：衣书中虫，一名蚋鱼。"}]},{"ID":"20240614090549-49tpba2","Type":"NodeParagraph","Properties":{"id":"20240614090549-49tpba2","updated":"20240614090549"},"Children":[{"Type":"NodeText","Data":"上虫，鱼，下品一十八种，旧同。"}]},{"ID":"20240614090624-hr34sip","Type":"NodeThematicBreak","Properties":{"id":"20240614090624-hr34sip"}},{"ID":"20240614090626-3brtyd2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090626-3brtyd2","updated":"20240614090630"},"Children":[{"Type":"NodeText","Data":"衣鱼《医学入门》"}]},{"ID":"20240614090626-u7qd3hq","Type":"NodeParagraph","Properties":{"id":"20240614090626-u7qd3hq","updated":"20240614090626"},"Children":[{"Type":"NodeText","Data":"即书内蠹鱼。味咸温。无毒。卒患偏风口眼 斜， 右摩左耳下， 左摩右耳下，正即止。妇人瘕疝小便不利，小儿中风项强背起摩之，淋闭取摩脐及小腹即通。研烂敷瘢疮，又和乳汁点眼，治翳及沙石草落目中。"}]},{"ID":"20240614090723-8i47xco","Type":"NodeThematicBreak","Properties":{"id":"20240614090723-8i47xco"}},{"ID":"20240614090725-i799ogp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090725-i799ogp","updated":"20240614090729"},"Children":[{"Type":"NodeText","Data":"衣鱼《本草衍义》"}]},{"ID":"20240614090725-mswzhj9","Type":"NodeParagraph","Properties":{"id":"20240614090725-mswzhj9","updated":"20240614090725"},"Children":[{"Type":"NodeText","Data":"多在故书中，久不动帛中或有之，不若故纸中多也。身有浓粉，手搐之则落。亦啮毳衣，用处亦少。其形稍似鱼，其尾又分二歧，世用以灭瘢痕。"}]},{"ID":"20240614090652-mi9fyzu","Type":"NodeThematicBreak","Properties":{"id":"20240614090652-mi9fyzu"}},{"ID":"20240614090653-xf6fgnu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090653-xf6fgnu","updated":"20240614090657"},"Children":[{"Type":"NodeText","Data":"衣鱼《名医别录》"}]},{"ID":"20240614090653-jjq256h","Type":"NodeParagraph","Properties":{"id":"20240614090653-jjq256h","updated":"20240614090653"},"Children":[{"Type":"NodeText","Data":"无毒．主治淋，堕胎，涂疮，灭瘢．一名 ．生咸阳．"}]},{"ID":"20240614090653-jhmv6ch","Type":"NodeParagraph","Properties":{"id":"20240614090653-jhmv6ch","updated":"20240614090653"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶衣鱼，味咸，温．主妇人疝瘕，小便不利，小儿中风项强，背起摩之．一名白鱼．生平泽．"}]},{"ID":"20240614090713-ohlea1j","Type":"NodeThematicBreak","Properties":{"id":"20240614090713-ohlea1j"}},{"ID":"20240614090714-utqltkw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090714-utqltkw","updated":"20240614090717"},"Children":[{"Type":"NodeText","Data":"衣鱼《本经逢原》"}]},{"ID":"20240614090714-6lmeobl","Type":"NodeParagraph","Properties":{"id":"20240614090714-6lmeobl","updated":"20240614090714"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即蠹鱼"}]},{"ID":"20240614090714-jhmou20","Type":"NodeParagraph","Properties":{"id":"20240614090714-jhmou20","updated":"20240614090714"},"Children":[{"Type":"NodeText","Data":"咸温无毒，即衣帛书画中之蠹，碎之如银，有粉者是。"}]},{"ID":"20240614090714-t5jz1i0","Type":"NodeParagraph","Properties":{"id":"20240614090714-t5jz1i0","updated":"20240614090714"},"Children":[{"Type":"NodeText","Data":"《本经》主妇人疝瘕，小便不利，小儿中风，项强背起摩之。"}]},{"ID":"20240614090714-gwzbq47","Type":"NodeParagraph","Properties":{"id":"20240614090714-gwzbq47","updated":"20240614090714"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"衣鱼主中风项强，摩之即安。惊痫天吊口 、淋闭，服之即愈，皆手足太阳经病，乃《神农本经》之药。古方盛用，今人罕知。合鹰屎、白僵蚕敷疮瘢灭。"}]},{"ID":"20240614090701-yjp1t3n","Type":"NodeThematicBreak","Properties":{"id":"20240614090701-yjp1t3n"}},{"ID":"20240614090703-suk3o8g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090703-suk3o8g","updated":"20240614090706"},"Children":[{"Type":"NodeText","Data":"衣鱼《千金翼方》"}]},{"ID":"20240614090703-tysg6i3","Type":"NodeParagraph","Properties":{"id":"20240614090703-tysg6i3","updated":"20240614090703"},"Children":[{"Type":"NodeText","Data":"味咸，温，无毒。主妇人疝瘕，小便不利，小儿中风，项强背起。摩之。又疗淋，堕胎，涂疮灭瘢。一名白鱼，一名 。生咸阳平泽。"}]},{"ID":"20240614090636-yddxny3","Type":"NodeThematicBreak","Properties":{"id":"20240614090636-yddxny3"}},{"ID":"20240614090637-pueqzz6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090637-pueqzz6","updated":"20240614090643"},"Children":[{"Type":"NodeText","Data":"衣鱼《新修本草》"}]},{"ID":"20240614090637-ipciure","Type":"NodeParagraph","Properties":{"id":"20240614090637-ipciure","updated":"20240614090637"},"Children":[{"Type":"NodeText","Data":"味咸，温，无毒。主妇人疝瘕，小便不利，小儿中风项强背起，摩之，又疗淋，堕胎，涂。生咸阳平泽。"}]},{"ID":"20240614090637-hsgj146","Type":"NodeParagraph","Properties":{"id":"20240614090637-hsgj146","updated":"20240614090637"},"Children":[{"Type":"NodeText","Data":"衣中乃有，而不可常得，多在书中。亦可疗小儿淋闭，以摩脐及小腹，即溺通也。"}]},{"ID":"20240614090611-q4ldlgc","Type":"NodeThematicBreak","Properties":{"id":"20240614090611-q4ldlgc"}},{"ID":"20240614090612-z58awm6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090612-z58awm6","updated":"20240614090619"},"Children":[{"Type":"NodeText","Data":"衣鱼《本草经集注》"}]},{"ID":"20240614090612-vk2jhxz","Type":"NodeParagraph","Properties":{"id":"20240614090612-vk2jhxz","updated":"20240614090612"},"Children":[{"Type":"NodeText","Data":"味咸，温，无毒。主治妇人疝瘕，小便不利，小儿中风项强背起，摩之。又治淋，堕胎，涂疮灭瘢。一名白鱼，一名 。生咸阳平泽。"}]},{"ID":"20240614090612-ofzl7e1","Type":"NodeParagraph","Properties":{"id":"20240614090612-ofzl7e1","updated":"20240614090612"},"Children":[{"Type":"NodeText","Data":"衣中乃有，而不可常得，多在书中。亦可用于小儿淋闭，以摩脐及小腹，即溺通也。"}]},{"ID":"20240614090600-b3h5iki","Type":"NodeThematicBreak","Properties":{"id":"20240614090600-b3h5iki"}},{"ID":"20240614090601-0ka40mt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090601-0ka40mt","updated":"20240614090606"},"Children":[{"Type":"NodeText","Data":"衣鱼《本草崇原》"}]},{"ID":"20240614090601-0czyugu","Type":"NodeParagraph","Properties":{"id":"20240614090601-0czyugu","updated":"20240614090601"},"Children":[{"Type":"NodeText","Data":"气味咸温，无毒。主治妇人疝瘕，小便不利，小儿中风，项强背起，摩之。"}]},{"ID":"20240614090601-jqjsvd7","Type":"NodeParagraph","Properties":{"id":"20240614090601-jqjsvd7","updated":"20240614090601"},"Children":[{"Type":"NodeText","Data":"（衣鱼一名白鱼，即蠹鱼也，生衣帛及书纸中，故名衣鱼，形略似鱼身有白粉，其色光亮如银，故又名白鱼。俗传衣鱼入道经中，食神仙字，则身有五色，人得吞之，可至神仙，此方士谬传，不可信也。）"}]},{"ID":"20240614090601-w23b901","Type":"NodeParagraph","Properties":{"id":"20240614090601-w23b901","updated":"20240614090601"},"Children":[{"Type":"NodeText","Data":"衣鱼色白，碎之如银，禀金气也。命名曰鱼，气味咸温，禀水气也。水能生木，故治妇人之疝瘕。妇人疝瘕，肝木病也。金能生水，故治小便之不利。小便不利，水不行也。小儿经脉未充，若中于风，日久不愈，则项强背起，乃督脉为病，督脉合肝部，属太阳。衣鱼禀金水之化，故当用以摩之。"}]},{"ID":"20240614090445-q85m1at","Type":"NodeThematicBreak","Properties":{"id":"20240614090445-q85m1at"}},{"ID":"20240614090500-2lcvlwr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090500-2lcvlwr","updated":"20240614090522"},"Children":[{"Type":"NodeText","Data":"衣鱼《本草纲目》"}]},{"ID":"20240614090500-661o9cl","Type":"NodeParagraph","Properties":{"id":"20240614090500-661o9cl","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"「释名」白鱼、壁鱼、蠹鱼。"}]},{"ID":"20240614090500-i2ksko5","Type":"NodeParagraph","Properties":{"id":"20240614090500-i2ksko5","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"「气味」咸、温、无毒。"}]},{"ID":"20240614090500-14irq35","Type":"NodeParagraph","Properties":{"id":"20240614090500-14irq35","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614090500-p6bkw2w","Type":"NodeParagraph","Properties":{"id":"20240614090500-p6bkw2w","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"1、小儿天吊（眼向上翻）。用衣鱼干十个、湿者五个，加乳汁研匀灌下。"}]},{"ID":"20240614090500-esxdrw6","Type":"NodeParagraph","Properties":{"id":"20240614090500-esxdrw6","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"2、小儿疾。用衣鱼七个、竹茹一把，加酒一升，煎成二合，温服。此方名“白鱼散”。"}]},{"ID":"20240614090500-yh08rwv","Type":"NodeParagraph","Properties":{"id":"20240614090500-yh08rwv","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"3、目中浮翳。取书中衣鱼末，点少许在翳上。一天点二次。"}]},{"ID":"20240614090500-zs58zpz","Type":"NodeParagraph","Properties":{"id":"20240614090500-zs58zpz","updated":"20240614090500"},"Children":[{"Type":"NodeText","Data":"4、小便不通。有衣鱼、浓石乱发，等分为散。每服半匙，水送下。一天服三次，此方名“白鱼散”。"}]},{"ID":"20240614090446-tlm2cfi","Type":"NodeThematicBreak","Properties":{"id":"20240614090446-tlm2cfi"}},{"ID":"20240614090447-fwpql90","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090447-fwpql90","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：衣鱼"}]},{"ID":"20240614090447-0p5ha2z","Type":"NodeParagraph","Properties":{"id":"20240614090447-0p5ha2z","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090447-1s6fgz0","Type":"NodeParagraph","Properties":{"id":"20240614090447-1s6fgz0","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" Yī Yú"}]},{"ID":"20240614090447-u02g8p8","Type":"NodeParagraph","Properties":{"id":"20240614090447-u02g8p8","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614090447-lfu8fp9","Type":"NodeParagraph","Properties":{"id":"20240614090447-lfu8fp9","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 蠹鱼、毛衣鱼、多毛栉衣鱼"}]},{"ID":"20240614090447-zjpq09x","Type":"NodeParagraph","Properties":{"id":"20240614090447-zjpq09x","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090447-hx2h1t7","Type":"NodeParagraph","Properties":{"id":"20240614090447-hx2h1t7","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 昆虫纲缨尾目衣鱼科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多毛栉衣鱼"},{"Type":"NodeText","Data":"Ctenolepisma villosa Fabr.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240614090447-lcu0sfe","Type":"NodeParagraph","Properties":{"id":"20240614090447-lcu0sfe","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614090447-wht61et","Type":"NodeParagraph","Properties":{"id":"20240614090447-wht61et","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 南北各地。"}]},{"ID":"20240614090447-old8aqn","Type":"NodeParagraph","Properties":{"id":"20240614090447-old8aqn","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090447-mqrjz1n","Type":"NodeParagraph","Properties":{"id":"20240614090447-mqrjz1n","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 明目，袪风，利小便。主治中风惊痫，目中浮翳，尿血，小便不利等。"}]},{"ID":"20240614090447-eir29tc","Type":"NodeParagraph","Properties":{"id":"20240614090447-eir29tc","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090447-o8l354h","Type":"NodeParagraph","Properties":{"id":"20240614090447-o8l354h","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 7～10条。"}]},{"ID":"20240614090447-f042ml3","Type":"NodeParagraph","Properties":{"id":"20240614090447-f042ml3","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614090447-44zs10h","Type":"NodeParagraph","Properties":{"id":"20240614090447-44zs10h","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 治小便不通：滑石1钱，衣鱼10条，共为细面，白水送下，日服2次。"}]},{"ID":"20240614090447-k94smdr","Type":"NodeParagraph","Properties":{"id":"20240614090447-k94smdr","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"治痫疾：衣鱼10条，竹茹3钱，黄酒2两，水煎服。"}]},{"ID":"20240614090447-xz90kfd","Type":"NodeParagraph","Properties":{"id":"20240614090447-xz90kfd","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090447-wxxyuf2","Type":"NodeParagraph","Properties":{"id":"20240614090447-wxxyuf2","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614090447-9qupae6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090447-9qupae6","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：衣鱼"}]},{"ID":"20240614090447-z3g8m76","Type":"NodeParagraph","Properties":{"id":"20240614090447-z3g8m76","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090447-2hwyf7k","Type":"NodeParagraph","Properties":{"id":"20240614090447-2hwyf7k","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" Yī Yú"}]},{"ID":"20240614090447-ttzsr92","Type":"NodeParagraph","Properties":{"id":"20240614090447-ttzsr92","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614090447-lyplp4t","Type":"NodeParagraph","Properties":{"id":"20240614090447-lyplp4t","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 蟫、白鱼（《尔雅》），蛃鱼（《尔雅》郭虞注），壁鱼（《圣惠方》），蠹鱼（《尔雅翼》），铰剪虫（《陆川本草》）。"}]},{"ID":"20240614090447-emkskpe","Type":"NodeParagraph","Properties":{"id":"20240614090447-emkskpe","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614090447-lftnps9","Type":"NodeParagraph","Properties":{"id":"20240614090447-lftnps9","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614090447-jjkfqb7","Type":"NodeParagraph","Properties":{"id":"20240614090447-jjkfqb7","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090447-elpco83","Type":"NodeParagraph","Properties":{"id":"20240614090447-elpco83","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 为衣鱼科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"衣鱼"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240614090447-s64yx1m","Type":"NodeParagraph","Properties":{"id":"20240614090447-s64yx1m","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614090447-oqw047v","Type":"NodeParagraph","Properties":{"id":"20240614090447-oqw047v","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 体长而扁，长约1厘米。外被银色细鳞，头、胸、腹之区别不甚明显；头小，复眼细小，单眼缺如；触角细长，多节，成鞭状；口器虽退化，但善于咀嚼。胸部最阔，中胸及后胸各有气门1对；无翅，胸下有足3对。腹部10节，至尾部渐细，第1～8腹节各有气门1对。腹部末端有尾须3条，由多数环节组成。"}]},{"ID":"20240614090447-8dj390i","Type":"NodeParagraph","Properties":{"id":"20240614090447-8dj390i","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"多生于古旧的房屋和古书中。畏光，好蠹食书籍、衣服及浆糊、胶质等物。"}]},{"ID":"20240614090447-nd5s64l","Type":"NodeParagraph","Properties":{"id":"20240614090447-nd5s64l","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614090447-doje4f9","Type":"NodeParagraph","Properties":{"id":"20240614090447-doje4f9","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 《本草求原》：\"入小肠、膀胱、肝。\""}]},{"ID":"20240614090447-76u0c11","Type":"NodeParagraph","Properties":{"id":"20240614090447-76u0c11","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614090447-gd5ow8y","Type":"NodeParagraph","Properties":{"id":"20240614090447-gd5ow8y","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 咸，温。"}]},{"ID":"20240614090447-kc2ckmc","Type":"NodeParagraph","Properties":{"id":"20240614090447-kc2ckmc","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味咸，温。\""}]},{"ID":"20240614090447-3e17qkh","Type":"NodeParagraph","Properties":{"id":"20240614090447-3e17qkh","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"有毒。\""}]},{"ID":"20240614090447-53kx2th","Type":"NodeParagraph","Properties":{"id":"20240614090447-53kx2th","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"味咸，性温，无毒。\""}]},{"ID":"20240614090447-nm3xqj6","Type":"NodeParagraph","Properties":{"id":"20240614090447-nm3xqj6","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614090447-9foo77e","Type":"NodeParagraph","Properties":{"id":"20240614090447-9foo77e","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" ①《日华子本草》：\"畏芸草、莽草、莴苣。\""}]},{"ID":"20240614090447-rkclsor","Type":"NodeParagraph","Properties":{"id":"20240614090447-rkclsor","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"②《品汇精要》：\"妊娠不可服。\""}]},{"ID":"20240614090447-u86omb0","Type":"NodeParagraph","Properties":{"id":"20240614090447-u86omb0","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090447-8exqk8a","Type":"NodeParagraph","Properties":{"id":"20240614090447-8exqk8a","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 利尿，通淋，祛风，解毒。治淋病，小便不利，小儿惊痫，疮疖，目翳。"}]},{"ID":"20240614090447-q2qznlv","Type":"NodeParagraph","Properties":{"id":"20240614090447-q2qznlv","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主妇人疝瘕，小便不利。小儿中风，项强背起，摩之。\""}]},{"ID":"20240614090447-q7l68dl","Type":"NodeParagraph","Properties":{"id":"20240614090447-q7l68dl","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗淋，堕眙，涂疮灭瘢。\""}]},{"ID":"20240614090447-1fy679y","Type":"NodeParagraph","Properties":{"id":"20240614090447-1fy679y","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"主小儿脐风撮口，客忤天吊，风痫，口歪，重舌，目翳、目眯，尿血，转胞，小便不通。\""}]},{"ID":"20240614090447-94edq29","Type":"NodeParagraph","Properties":{"id":"20240614090447-94edq29","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"④《陆川本草》：\"破积，解毒。治疮疖。\""}]},{"ID":"20240614090447-g41kq41","Type":"NodeParagraph","Properties":{"id":"20240614090447-g41kq41","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090447-xzg8ypt","Type":"NodeParagraph","Properties":{"id":"20240614090447-xzg8ypt","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤或入散剂。外用：研末调敷或点眼。"}]},{"ID":"20240614090447-m8ys8id","Type":"NodeParagraph","Properties":{"id":"20240614090447-m8ys8id","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614090447-tsdxymv","Type":"NodeParagraph","Properties":{"id":"20240614090447-tsdxymv","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" ①治小便不利：滑石二分，乱发二分（烧），白鱼二分。上三味，杵为散。饮服半钱匕，日三服。（《金匮要略》滑石白鱼散）"}]},{"ID":"20240614090447-upt9l89","Type":"NodeParagraph","Properties":{"id":"20240614090447-upt9l89","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"②治小儿天吊，眼目搐上，并口手掣动：壁鱼儿一十五枚（干者十枚，湿者五枚）。以奶汁相和，研烂，更入奶汁，同灌入口。（《圣惠方》）"}]},{"ID":"20240614090447-whr47se","Type":"NodeParagraph","Properties":{"id":"20240614090447-whr47se","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"③治小儿撮口发噤：壁鱼子，细研作末。每服少许，令儿吮之（《圣惠方》）"}]},{"ID":"20240614090447-8mxqtb1","Type":"NodeParagraph","Properties":{"id":"20240614090447-8mxqtb1","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"④治痫：衣中白鱼七头，竹茹一握。上二味，以酒一升，煎取二合，顿服之。（《救急方》）"}]},{"ID":"20240614090447-3shdscv","Type":"NodeParagraph","Properties":{"id":"20240614090447-3shdscv","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"⑤治小儿重舌：衣鱼烧灰，敷舌上。（《千金翼方》）"}]},{"ID":"20240614090447-94urq7e","Type":"NodeParagraph","Properties":{"id":"20240614090447-94urq7e","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"⑥治瘢痕凸出：农白鱼二七枚，鹰屎白一两。上二味，末之，蜜和以敷，日三、五度。（《千金方》）"}]},{"ID":"20240614090447-unzmbsr","Type":"NodeParagraph","Properties":{"id":"20240614090447-unzmbsr","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"⑦治眼翳：书中白鱼末，注少许于翳上。（《僧深集方》）"}]},{"ID":"20240614090447-a20xqqh","Type":"NodeParagraph","Properties":{"id":"20240614090447-a20xqqh","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"⑧治砂石、草木人目中不出：书中白鱼和乳汁注目中。（《千金方》）"}]},{"ID":"20240614090447-tmn19lu","Type":"NodeParagraph","Properties":{"id":"20240614090447-tmn19lu","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090447-864lcpo","Type":"NodeParagraph","Properties":{"id":"20240614090447-864lcpo","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614090447-wqt0qyi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090447-wqt0qyi","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"《中华本草》：衣鱼"}]},{"ID":"20240614090447-k3cqhp3","Type":"NodeParagraph","Properties":{"id":"20240614090447-k3cqhp3","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090447-ey5eerj","Type":"NodeParagraph","Properties":{"id":"20240614090447-ey5eerj","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" Yī Yú"}]},{"ID":"20240614090447-wx38z4a","Type":"NodeParagraph","Properties":{"id":"20240614090447-wx38z4a","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614090447-faiezio","Type":"NodeParagraph","Properties":{"id":"20240614090447-faiezio","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 蟫、白鱼、蛃鱼、壁鱼、蠹鱼、铰剪虫"}]},{"ID":"20240614090447-0z0kdrc","Type":"NodeParagraph","Properties":{"id":"20240614090447-0z0kdrc","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614090447-hmonoq3","Type":"NodeParagraph","Properties":{"id":"20240614090447-hmonoq3","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" silverfish， fish moth， bookworm"}]},{"ID":"20240614090447-pl9m25m","Type":"NodeParagraph","Properties":{"id":"20240614090447-pl9m25m","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614090447-5bsb06k","Type":"NodeParagraph","Properties":{"id":"20240614090447-5bsb06k","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 1.出自《神农本草经》。"}]},{"ID":"20240614090447-3a77ikp","Type":"NodeParagraph","Properties":{"id":"20240614090447-3a77ikp","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》：衣鱼，多在故书中，久不动帛中或有之，不若故纸中多也。身有厚粉，手搐之则落，亦啮毳衣，用处亦少。其形稍似鱼，其尾又分二歧，世用以灭瘢痕。"}]},{"ID":"20240614090447-ot5xu6h","Type":"NodeParagraph","Properties":{"id":"20240614090447-ot5xu6h","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090447-anveefb","Type":"NodeParagraph","Properties":{"id":"20240614090447-anveefb","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 药材基源：为衣鱼科动物衣鱼和毛衣鱼的全体。"}]},{"ID":"20240614090447-siigrid","Type":"NodeParagraph","Properties":{"id":"20240614090447-siigrid","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Lepisma saccharina Linnaeus2.Ctenolepisma Villosa Fabr."}]},{"ID":"20240614090447-n7a8w1y","Type":"NodeParagraph","Properties":{"id":"20240614090447-n7a8w1y","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"采收和储藏：衣鱼为无变态昆虫，老熟若虫与成虫径难区别。一般以体长10-13mm、体呈灰白色，作为采收药用虫体的标准。用毛涮或毛笔将体刷至热水中烫死，捞出晾干，储存于干燥器皿中保存备用。"}]},{"ID":"20240614090447-l025sij","Type":"NodeParagraph","Properties":{"id":"20240614090447-l025sij","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614090447-qufc61x","Type":"NodeParagraph","Properties":{"id":"20240614090447-qufc61x","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生活于房屋中，以各种食物、浆糊、胶质、书籍、丝绸衣服等为食。"}]},{"ID":"20240614090447-t5k59ul","Type":"NodeParagraph","Properties":{"id":"20240614090447-t5k59ul","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.喜欢生活于黑暗、潮湿或密闭场所。是我国常见的仓库害虫之一，在储藏的谷类、豆类、油料、图书、衣服等物品中均可发现。"}]},{"ID":"20240614090447-xo6tyu5","Type":"NodeParagraph","Properties":{"id":"20240614090447-xo6tyu5","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"资源分布：1.全国各地均有分布。"}]},{"ID":"20240614090447-pnh0b6m","Type":"NodeParagraph","Properties":{"id":"20240614090447-pnh0b6m","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.全国各地均有分布。"}]},{"ID":"20240614090447-9ptkab6","Type":"NodeParagraph","Properties":{"id":"20240614090447-9ptkab6","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614090447-zrd1xgg","Type":"NodeParagraph","Properties":{"id":"20240614090447-zrd1xgg","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 1.衣鱼，体长而扁，长约10mm，体上披银灰色鳞片。复眼小，由许多小眼聚积而成，单眼退化。触角细长，超过体躯之半，由30节以上丝状环节构成。口器外口式，适于咀嚼。胸部最阔，中胸及后胸各有气门1对；无翅，足3对。腹部10节，至尾部渐细。腹末端有尾须3条。"}]},{"ID":"20240614090447-be5kp9d","Type":"NodeParagraph","Properties":{"id":"20240614090447-be5kp9d","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.毛衣鱼，与上种主要区别为：尾毛较长，几与体长相等。全身被密毛，在腹部各节上的毛呈密丝状。"}]},{"ID":"20240614090447-xfg0k1l","Type":"NodeParagraph","Properties":{"id":"20240614090447-xfg0k1l","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614090447-ir9dp0u","Type":"NodeParagraph","Properties":{"id":"20240614090447-ir9dp0u","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 生活习性，衣鱼喜栖息于树叶、石块、树干、青苔下等湿润处，以及蚁和白蚁的巢中，或房屋、厨房及炉周围等处。食性为杂食性，大部分为植食性，取食于干燥或腐败植物、菌类、地衣、苔藓等。房屋中居住的则取食各种食物、浆糊、纸张以及有淀粉的衣服，如丝绸、人造丝等。1年可发生多代，代数的多少与各地的食物多少、环境湿度变化等有关。"}]},{"ID":"20240614090447-virjgps","Type":"NodeParagraph","Properties":{"id":"20240614090447-virjgps","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"养殖技术，衣鱼多诱捕后饲养。选择未经污染的，以植物性原粒制成的纸张，裁成纸条，用面粉制成的浆糊粘成直径为1cm的有底纸筒。在干净玻璃瓶中放入若干个纸筒，将少许糕点碎渣撒入纸筒中制成诱捕器。"}]},{"ID":"20240614090447-259qzcc","Type":"NodeParagraph","Properties":{"id":"20240614090447-259qzcc","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"诱捕器侧放杂物堆下，3-5天后，于白天检查是否有衣鱼潜入纸筒中，若有，可将纸筒投入有盖的饲养缸中，放置黑暗外。饲养衣鱼的饲料有糕点碎渣、碎花生米、干馒头渣、拌有食糖的玉米面、少许干蛋黄粉等。为促其生长，提高繁殖离，可加入少许家畜肝粉。无论哪种饲料喂养，都要做到1次投料少，每星期2次，以投后吃完为准。"}]},{"ID":"20240614090447-ari5km1","Type":"NodeParagraph","Properties":{"id":"20240614090447-ari5km1","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614090447-xxs8rag","Type":"NodeParagraph","Properties":{"id":"20240614090447-xxs8rag","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 雄性及雌性义鱼血淋巴含脂质（lipid），包括10.5%的游离脂肪酸（free fatty acid），28.7%的磷脂（phospholipid），9.4%的单甘油酯（monoglyceride），29.1%的二酰甘油酯（diglyceride），22。3%的三酰甘油酯（triglyceride）。还含碳水化合物（carbohydrate），葡萄糖（glucose）。游离氨基酸包括内氨酸（alanine），甘氨酸（glycine），异亮氨酸（isoleucine）。亮氨酸（leucine），丝氨酸（serine），苏氨酸（threonine），缬氨酸（valine），苯丙氨酸（phenylalanine），酪氨酸（tyrosine），胱氨酸（cystine），蛋氨酸（methionine），脯氨酸（proline），天冬氨酸（aspartic acid），谷氨酸（glutamic acid），精氨酸（arginine），组氨酸（histidine）。赖氨酸（lysine），其中甘氨酸和脯氨酸含量高。脑组织中含施离氨其酸，有γ-氨基丁酸（GABA），谷氨酸，丙氨酸，脯氨酸，精氨酸，牛磺酸（taurine）。"}]},{"ID":"20240614090447-24asep9","Type":"NodeParagraph","Properties":{"id":"20240614090447-24asep9","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614090447-40u54ud","Type":"NodeParagraph","Properties":{"id":"20240614090447-40u54ud","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 膀胱；肝经"}]},{"ID":"20240614090447-qbffbtf","Type":"NodeParagraph","Properties":{"id":"20240614090447-qbffbtf","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614090447-p3qk5jz","Type":"NodeParagraph","Properties":{"id":"20240614090447-p3qk5jz","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 味咸；性温"}]},{"ID":"20240614090447-tk3l9hb","Type":"NodeParagraph","Properties":{"id":"20240614090447-tk3l9hb","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614090447-jp7tw0z","Type":"NodeParagraph","Properties":{"id":"20240614090447-jp7tw0z","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 1.《日华子本草》：畏芸草、莽草、莴苣。"}]},{"ID":"20240614090447-ic1rozg","Type":"NodeParagraph","Properties":{"id":"20240614090447-ic1rozg","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.《品汇精要》：妊娠不可服。"}]},{"ID":"20240614090447-fdysfvy","Type":"NodeParagraph","Properties":{"id":"20240614090447-fdysfvy","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090447-uzrhq4s","Type":"NodeParagraph","Properties":{"id":"20240614090447-uzrhq4s","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 利尿通淋；祛风明目；解毒散结。主淋病；尿闭；中风口；小狼惊痫；重舌；目翳；瘢痕疙瘩"}]},{"ID":"20240614090447-x0ny3eb","Type":"NodeParagraph","Properties":{"id":"20240614090447-x0ny3eb","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090447-6ftt59c","Type":"NodeParagraph","Properties":{"id":"20240614090447-6ftt59c","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤或研末，5-10只。外用：适量，研末撒、调敷或点眼。"}]},{"ID":"20240614090447-ujtj8dx","Type":"NodeParagraph","Properties":{"id":"20240614090447-ujtj8dx","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614090447-wcn05au","Type":"NodeParagraph","Properties":{"id":"20240614090447-wcn05au","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主妇人疝瘕，小便不利。小儿中风，项强背起，摩之。"}]},{"ID":"20240614090447-orhp7me","Type":"NodeParagraph","Properties":{"id":"20240614090447-orhp7me","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗淋，堕胎，涂疮灭瘢。"}]},{"ID":"20240614090447-2gaf6vp","Type":"NodeParagraph","Properties":{"id":"20240614090447-2gaf6vp","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：主小儿脐风撮口，客忤天吊，风癎，口喎，重舌，目翳、目眯，尿血，转胞，小便不通。"}]},{"ID":"20240614090447-a8vhxmt","Type":"NodeParagraph","Properties":{"id":"20240614090447-a8vhxmt","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"4.《陆川本草》：破积，解毒。治疮疖。"}]},{"ID":"20240614090447-g6a6hdg","Type":"NodeParagraph","Properties":{"id":"20240614090447-g6a6hdg","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：衣鱼乃太阳经药，故所主中风项强，惊癎、天吊，目翳，口喎，淋闭，皆手足太阳经病也。"}]},{"ID":"20240614090447-4r88g50","Type":"NodeParagraph","Properties":{"id":"20240614090447-4r88g50","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090447-ah97fuw","Type":"NodeParagraph","Properties":{"id":"20240614090447-ah97fuw","updated":"20240614090447"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614090448-ct5eb4y","Type":"NodeThematicBreak","Properties":{"id":"20240614090448-ct5eb4y"}},{"ID":"20240614090449-c4kwr8d","Type":"NodeParagraph","Properties":{"id":"20240614090449-c4kwr8d"}}]}