{"ID":"20240506110118-8fe01c4","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506110118-8fe01c4","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506110118-8fe01c4\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506110118-ghv6xig\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614081453-4979csy\u0026quot;,\u0026quot;scrollTop\u0026quot;:1638,\u0026quot;focusId\u0026quot;:\u0026quot;20240614081729-yzp6kt3\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:7\u0026#125;","title":"347马陆","type":"doc","updated":"20240828092812"},"Children":[{"ID":"20240703140504-qfmkwn1","Type":"NodeParagraph","Properties":{"id":"20240703140504-qfmkwn1","updated":"20240828092811"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 346px;","style":"width: 336px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆-20240703140503-a163f8e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 336px;\" parent-style=\"width: 346px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703140531-m4n1i5s","Type":"NodeParagraph","Properties":{"id":"20240703140531-m4n1i5s","updated":"20240828092812"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆2-20240703140628-25cisgd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 568px;","style":"width: 558px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆6-20240703140834-lup8mg7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 558px;\" parent-style=\"width: 568px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240703141132-ashsjiz","Type":"NodeParagraph","Properties":{"id":"20240703141132-ashsjiz","updated":"20240828092814"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 639px;","style":"width: 629px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆1-20240703140531-7lr5fqb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 629px;\" parent-style=\"width: 639px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 538px;","style":"width: 528px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆8-20240703141127-aehau18.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 528px;\" parent-style=\"width: 538px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703141146-1xh87gf","Type":"NodeParagraph","Properties":{"id":"20240703141146-1xh87gf","updated":"20240828092816"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 891px;","style":"width: 881px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆4-20240703140801-mk9dcsu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 881px;\" parent-style=\"width: 891px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 281px;","style":"width: 271px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆3-20240703140710-0lyhqwr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 271px;\" parent-style=\"width: 281px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240703141126-crj0hwc","Type":"NodeParagraph","Properties":{"id":"20240703141126-crj0hwc","updated":"20240828092818"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆7-20240703140940-iwj19rq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 439px;","style":"width: 429px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马陆9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马陆9-20240703141429-wtpmqcb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 429px;\" parent-style=\"width: 439px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240614081449-ax8td9a","Type":"NodeThematicBreak","Properties":{"id":"20240614081449-ax8td9a"}},{"ID":"20240614081650-6k0zoef","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081650-6k0zoef","updated":"20240614081655"},"Children":[{"Type":"NodeText","Data":"马陆《神农本草经》"}]},{"ID":"20240614081650-ucxlcna","Type":"NodeParagraph","Properties":{"id":"20240614081650-ucxlcna","updated":"20240614081650"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240614081650-zh32ewa","Type":"NodeParagraph","Properties":{"id":"20240614081650-zh32ewa","updated":"20240614081650"},"Children":[{"Type":"NodeText","Data":"主腹中大坚症，破积聚，息肉，恶创，白秃。一名百足。生川谷。"}]},{"ID":"20240614081650-gc1tbji","Type":"NodeParagraph","Properties":{"id":"20240614081650-gc1tbji","updated":"20240614081650"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：一名马轴，（《御览》）。"}]},{"ID":"20240614081650-5j4g64c","Type":"NodeParagraph","Properties":{"id":"20240614081650-5j4g64c","updated":"20240614081650"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名马轴，生元菟。"}]},{"ID":"20240614081650-dwau3vo","Type":"NodeParagraph","Properties":{"id":"20240614081650-dwau3vo","updated":"20240614081650"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蠲，马蠲也，从虫皿，益声，勹象形。明堂月令曰：腐草为蠲。《广雅》云，蛆蟝，马，马蚿也，又马践，蛆也。《尔雅》云：蛝，马践。郭璞云：马蠲匀，俗呼马蟝，《淮南子》时则训云：季夏之月，腐草化为蚈.高诱云：蚈，马蚈也，幽冀谓之秦渠，又蚈论训云：蚈足众，而走不若蛇，又兵略训云：若蚈之足。高诱云：蠸，马蚿也，方言云，马蚿，北燕谓之蛆渠，其大者谓之马蚰。《博物志》云：马蚿，一名百足，中断成两段，名行而去。"}]},{"ID":"20240614081449-4rfvdbu","Type":"NodeThematicBreak","Properties":{"id":"20240614081449-4rfvdbu"}},{"ID":"20240614081636-j89qse0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081636-j89qse0","updated":"20240614081640"},"Children":[{"Type":"NodeText","Data":"马陆《千金翼方》"}]},{"ID":"20240614081636-avur91w","Type":"NodeParagraph","Properties":{"id":"20240614081636-avur91w","updated":"20240614081636"},"Children":[{"Type":"NodeText","Data":"味辛，温，有毒。主腹中大坚症，破积聚，息肉恶疮，白秃。疗寒热痞结，胁下满。一名百足，一名马轴。生玄菟川谷。"}]},{"ID":"20240614081449-ctv16iw","Type":"NodeThematicBreak","Properties":{"id":"20240614081449-ctv16iw"}},{"ID":"20240614081622-jgkkehy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081622-jgkkehy","updated":"20240614081630"},"Children":[{"Type":"NodeText","Data":"马陆《本草纲目》"}]},{"ID":"20240614081622-catamaf","Type":"NodeParagraph","Properties":{"id":"20240614081622-catamaf","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240614081622-2ebkpzv","Type":"NodeParagraph","Properties":{"id":"20240614081622-2ebkpzv","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖释名〗百足（《本经》）百节（《衍义》）千足（《炮炙论》）马蚿（音弦）马蠸（音拳）马蠲（郭璞）马轴（《别录》）马[虫戋]（《尔雅》）飞蚿虫（李当之）刀环虫（苏恭）蛩（〔弘景曰〕此虫足甚多，寸寸断之，亦便寸行。故鲁连子云百足之虫，死而不僵，《庄子》蚿怜蛇是矣）"}]},{"ID":"20240614081622-dix042y","Type":"NodeParagraph","Properties":{"id":"20240614081622-dix042y","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖集解〗《别录》曰马陆生玄菟川谷。〔弘景曰〕李当之云：此虫长五六寸，状如大蛩，夏月登树鸣，冬则入蛰，今人呼为飞蚿虫。今有一种细黄虫，状如蜈蚣而甚长，俗名土虫。鸡食之，醉闷至死。方家既不复用，市人亦无取者，未详何者的是。〔恭曰〕此虫大如细笔管，长三四寸，斑色，亦如蚰蜒。襄阳人名为马蚿，亦呼马轴，又名刀环虫，以其死侧卧，状如刀环也。有人自毒，服一枚便死也。〔斅曰〕千足虫头上有白肉，面并嘴尖。把着，腥臭气入人顶，能致死也。〔宗奭曰〕百节，身如槎，节节有细蹙文起，紫黑色，光润，百足，死则侧卧如环，长二三寸，大者如小指。古墙壁中甚多，入药至鲜。〔时珍曰〕马蚿处处有之。形大如蚯蚓，紫黑色，其足比比至百，而皮极硬，节节有横文如金线，首尾一般大。触之即侧卧局缩如环，不必死也。能毒鸡犬。陶氏所谓土虫，乃蚰蜒也，死亦侧踡如环，鸡喜食之。当以李当之之说为准。"}]},{"ID":"20240614081622-80r5293","Type":"NodeParagraph","Properties":{"id":"20240614081622-80r5293","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖正误〗〔藏器曰〕按土虫无足，如一条衣带，长四五寸，身扁似韭叶，背上有黄黑裥，头如铲子，行处有白涎，生湿地，鸡吃即死。陶云土虫似蜈蚣者，乃蚰蜒，非土虫，亦非马陆也。苏云马陆如蚰蜒，亦误矣。按蚰蜒色黄不斑，其足无数。〔时珍曰〕按段成式《酉阳杂俎》云：度古俗呼土蛊，身形似衣带，色类蚯蚓，长一尺余，首如铲，背上有黄黑裥，稍触即断。常趁蚓掩之，则蚓化为水。有毒，鸡食之辄死。据此，则陈藏器所谓土虫者，盖土蛊也。陶氏误以蚰蜒为马陆，陈氏亦误以土蛊为土虫矣。"}]},{"ID":"20240614081622-curfeb4","Type":"NodeParagraph","Properties":{"id":"20240614081622-curfeb4","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖修治〗〔雷曰〕凡收得马陆，以糠头炒，至糠焦黑，取出去糠，竹刀刮去头、足，研末用。"}]},{"ID":"20240614081622-9319whh","Type":"NodeParagraph","Properties":{"id":"20240614081622-9319whh","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖气味〗辛，温，有毒。"}]},{"ID":"20240614081622-8fov07v","Type":"NodeParagraph","Properties":{"id":"20240614081622-8fov07v","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖主治〗腹中大坚癥，破积聚息肉，恶疮白秃。（《本经》）疗寒热痞结，胁下满。（《别录》）辟邪疟。（时珍）"}]},{"ID":"20240614081622-lt5ge18","Type":"NodeParagraph","Properties":{"id":"20240614081622-lt5ge18","updated":"20240614081622"},"Children":[{"Type":"NodeText","Data":"〖发明〗〔时珍曰〕马陆系神农药，雷氏备载炮炙之法，而古方鲜见用者，惟《圣惠》逐邪丸用之。其方治久疟发歇无时。用百节虫四十九枚，湿生虫四十九枚，砒霜三钱，粽子角七枚。五月五日日未出时，于东南上寻取两般虫，至午时向南研匀，丸小豆大。每发日早，男左女右，手把一丸，嗅之七遍，立效。修时忌孝子、妇人、师尼、鸡犬见之。亦合《别录》疗寒热之说。大抵毒物止可外用，不敢轻入丸、散中。"}]},{"ID":"20240614081708-ydd7b9z","Type":"NodeThematicBreak","Properties":{"id":"20240614081708-ydd7b9z"}},{"ID":"20240614081709-y0baqk5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081709-y0baqk5","updated":"20240614081713"},"Children":[{"Type":"NodeText","Data":"马陆《医学入门》"}]},{"ID":"20240614081709-fsq8u3c","Type":"NodeParagraph","Properties":{"id":"20240614081709-fsq8u3c","updated":"20240614081709"},"Children":[{"Type":"NodeText","Data":"即百节虫。长二三寸，大如小指，身如槎，节节有细蹙纹起，色紫黑光润，百足，死则侧卧如环。"}]},{"ID":"20240614081709-2kph3ub","Type":"NodeParagraph","Properties":{"id":"20240614081709-2kph3ub","updated":"20240614081709"},"Children":[{"Type":"NodeText","Data":"味辛，温，有毒。主恶疮、 肉、白秃，去坚 积聚，疗寒、热痞结胁满。有人自服一枚便死。和糠炒，令糠焦黑，去头足研用。"}]},{"ID":"20240614081718-pyqeo96","Type":"NodeThematicBreak","Properties":{"id":"20240614081718-pyqeo96"}},{"ID":"20240614081719-wibmxyt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081719-wibmxyt","updated":"20240614081724"},"Children":[{"Type":"NodeText","Data":"马陆《名医别录》"}]},{"ID":"20240614081719-8sl7jch","Type":"NodeParagraph","Properties":{"id":"20240614081719-8sl7jch","updated":"20240614081719"},"Children":[{"Type":"NodeText","Data":"有毒．主治寒热痞结，胁下满．一名马轴．生玄菟．"}]},{"ID":"20240614081719-atzy1m9","Type":"NodeParagraph","Properties":{"id":"20240614081719-atzy1m9","updated":"20240614081719"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶马陆，味辛，温．主腹中大坚症，破积聚息肉，恶疮白秃．一名百足．生川谷．"}]},{"ID":"20240614081728-5cr8yie","Type":"NodeThematicBreak","Properties":{"id":"20240614081728-5cr8yie"}},{"ID":"20240614081729-yzp6kt3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081729-yzp6kt3","updated":"20240614081736"},"Children":[{"Type":"NodeText","Data":"马陆《本草衍义》"}]},{"ID":"20240614081729-x3u4rhb","Type":"NodeParagraph","Properties":{"id":"20240614081729-x3u4rhb","updated":"20240614081729"},"Children":[{"Type":"NodeText","Data":"即今百节虫也。身如槎节，节有细蹙纹，起紫黑色，光润，百足。死则侧卧如环，长二三寸，尤者粗如小指。西京上阳宫及内城砖墙中甚多，入药至鲜。"}]},{"ID":"20240614081741-8b6u4ay","Type":"NodeThematicBreak","Properties":{"id":"20240614081741-8b6u4ay"}},{"ID":"20240614081743-mps3giq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081743-mps3giq","updated":"20240614081748"},"Children":[{"Type":"NodeText","Data":"马陆《雷公炮炙论》"}]},{"ID":"20240614081743-s78jnsq","Type":"NodeParagraph","Properties":{"id":"20240614081743-s78jnsq","updated":"20240614081743"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，收得后，糠头炒，令糠头焦黑，取马陆出，用竹刮足去头了，研成末用之。"}]},{"ID":"20240614081800-r8iq3gh","Type":"NodeThematicBreak","Properties":{"id":"20240614081800-r8iq3gh"}},{"ID":"20240614081801-5asxc0w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081801-5asxc0w","updated":"20240614081806"},"Children":[{"Type":"NodeText","Data":"马陆《本草经集注》"}]},{"ID":"20240614081801-9z9ci0b","Type":"NodeParagraph","Properties":{"id":"20240614081801-9z9ci0b","updated":"20240614081801"},"Children":[{"Type":"NodeText","Data":"味辛，温，有毒。主治腹中大坚症，破积聚，息肉，恶疮，白秃。治寒热痞结，胁下满。"}]},{"ID":"20240614081801-vnesjze","Type":"NodeParagraph","Properties":{"id":"20240614081801-vnesjze","updated":"20240614081801"},"Children":[{"Type":"NodeText","Data":"一名百足，一名马轴。生玄菟川谷。"}]},{"ID":"20240614081801-2kdp333","Type":"NodeParagraph","Properties":{"id":"20240614081801-2kdp333","updated":"20240614081801"},"Children":[{"Type":"NodeText","Data":"李云此虫形长五六寸，状如大蛩，夏月登树鸣，冬则蛰，今人呼为飞 虫也，恐不必是马陆尔。今有一细黄虫，状如蜈蚣而甚长，俗名土虫，鸡食之醉闷亦至死。书云百足之虫，至死不僵。此虫足甚多，寸寸断便寸行，或欲相似，方家既不复用，市人亦无取者，未详何者的是。"}]},{"ID":"20240614081819-xcwwin8","Type":"NodeThematicBreak","Properties":{"id":"20240614081819-xcwwin8"}},{"ID":"20240614081821-p4do8p4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081821-p4do8p4","updated":"20240614081825"},"Children":[{"Type":"NodeText","Data":"马陆《证类本草》"}]},{"ID":"20240614081821-k1fbda0","Type":"NodeParagraph","Properties":{"id":"20240614081821-k1fbda0","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"味辛，温，有毒。主腹中大坚症，破积聚，息肉，恶疮，白秃，疗寒热痞结，胁下满。一名百足，一名马轴。生玄菟川谷。"}]},{"ID":"20240614081821-qx5i734","Type":"NodeParagraph","Properties":{"id":"20240614081821-qx5i734","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶李云此虫形长五、六寸，状如大蛩，夏月登树鸣，冬则蛰，今人呼为飞 （音玄）"}]},{"ID":"20240614081821-6i2hhei","Type":"NodeParagraph","Properties":{"id":"20240614081821-6i2hhei","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"虫也，恐不必是马陆尔。今有一细黄虫，状如蜈蚣而甚长，俗名土虫，鸡食之醉闷亦至死。"}]},{"ID":"20240614081821-q2lzvv1","Type":"NodeParagraph","Properties":{"id":"20240614081821-q2lzvv1","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"书云∶百足之虫，至死不僵（居良切）。此虫足甚多，寸寸断便寸行，或欲相似，方∶家既不复用，市人亦无取者，未详何者的是。唐本注云∶此虫大如细笔管，长三、四寸，斑色，一如蚰蜒，襄阳人名为马 ，亦呼马轴，亦名刀环虫，以其死侧卧，状如刀环也。有人自毒，服一枚便死也。"}]},{"ID":"20240614081821-anakzyh","Type":"NodeParagraph","Properties":{"id":"20240614081821-anakzyh","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，收得后，糠头炒，令糠头焦黑，取马陆出，用竹刮足去头了，研成末用之。"}]},{"ID":"20240614081821-2el1lyk","Type":"NodeParagraph","Properties":{"id":"20240614081821-2el1lyk","updated":"20240614081821"},"Children":[{"Type":"NodeText","Data":"衍义曰∶马陆，即今百节虫也，身如槎节，节有细蹙纹，起紫黑色，光润，百足。死则侧卧如环，长二、三寸，尤者粗如小指。西京上阳宫及内城砖墙中甚多，入药至鲜。"}]},{"ID":"20240614081449-evu6x1g","Type":"NodeThematicBreak","Properties":{"id":"20240614081449-evu6x1g"}},{"ID":"20240614081516-izfas6l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081516-izfas6l","updated":"20240614081524"},"Children":[{"Type":"NodeText","Data":"马陆《新修本草》"}]},{"ID":"20240614081516-tcln6j4","Type":"NodeParagraph","Properties":{"id":"20240614081516-tcln6j4","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"味辛，温，有毒。主腹中大坚症，破积聚，息肉，恶疮，白秃。疗寒热痞结，胁下满。"}]},{"ID":"20240614081516-ieysbdj","Type":"NodeParagraph","Properties":{"id":"20240614081516-ieysbdj","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"一名百足，一名马轴。生玄菟川谷。"}]},{"ID":"20240614081516-pquhw0y","Type":"NodeParagraph","Properties":{"id":"20240614081516-pquhw0y","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"李云此虫形长五、六寸，状如大蛩，夏月登树鸣，冬则蛰，今人呼为飞 虫也，恐不必是马陆尔。今有一细黄虫，状如蜈蚣而甚长，俗名土虫，鸡食之醉闷亦至死。书云百足之虫，至死不僵。此虫足甚多，寸寸断便寸行，或欲相似，方家既不复用，市人亦无取者，未详何者的是〔谨案〕此虫大如细笔管，长三、四寸，斑色亦如蚰蜒，襄阳人名为马 ，亦呼马轴，亦名卷第十六【虫鱼下】味辛，平，无毒。主久聋咳逆，毒瓦斯出刺，出汗。疗鼻窒。其土房主痈肿，风头。一名土蜂，生熊耳川谷及 ，或人屋间。"}]},{"ID":"20240614081516-bmu3sxt","Type":"NodeParagraph","Properties":{"id":"20240614081516-bmu3sxt","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"此类甚多，虽名土蜂，不就土中为窟，谓 土作房尔。今一种黑色，腰甚细，衔泥于人室及器物边作房，如并竹管者是也。其生子如粟米大居中，乃捕取草上青蜘蛛十余枚满中，仍塞口，以拟其子大为粮也。"}]},{"ID":"20240614081516-0golbsm","Type":"NodeParagraph","Properties":{"id":"20240614081516-0golbsm","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"其一种入芦竹管中者，亦取草上青虫，一名蜾裸。诗人云∶螟蛉有子，蜾裸负之，言细腰物无雌，皆取青虫，教祝便变成己子，斯为谬矣。造诗者乃可不详，未审夫子何为因其僻邪。圣人有阙，多皆类也。"}]},{"ID":"20240614081516-2v1akwz","Type":"NodeParagraph","Properties":{"id":"20240614081516-2v1akwz","updated":"20240614081516"},"Children":[{"Type":"NodeText","Data":"〔谨案〕土蜂土中为窠，大如乌蜂，不伤人，非 ，不入土中为窠。虽一名土蜂，非 也。"}]},{"ID":"20240614081449-07dyzyk","Type":"NodeThematicBreak","Properties":{"id":"20240614081449-07dyzyk"}},{"ID":"20240614081450-t9b7kvd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081450-t9b7kvd","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：马陆"}]},{"ID":"20240614081450-354tgrg","Type":"NodeParagraph","Properties":{"id":"20240614081450-354tgrg","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614081450-p0hwdtb","Type":"NodeParagraph","Properties":{"id":"20240614081450-p0hwdtb","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" Mǎ Lù"}]},{"ID":"20240614081450-h46xhnb","Type":"NodeParagraph","Properties":{"id":"20240614081450-h46xhnb","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614081450-3d7oat4","Type":"NodeParagraph","Properties":{"id":"20240614081450-3d7oat4","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 蛟（《庄子》），百足（《本经》），马蚿、蛆蟝、马蚰（《方言》），马蠲（《说文》），秦渠（《淮南子》高诱注），飞蚿虫（李当之《药录》），马轴（《吴普本草》），蚐（《尔雅》郭璞注），千足（《雷公炮炙论》），刀环虫（《唐本草》），百节虫（《圣惠方》），蛩（《纲目》），千脚虫（《分类草药性》），篦子虫、锅耳朵（《贵州民间方药集》），大草鞋虫（《四川中药志》），百脚陆（《泉州本草》）。"}]},{"ID":"20240614081450-qyv7stw","Type":"NodeParagraph","Properties":{"id":"20240614081450-qyv7stw","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614081450-pe0s82k","Type":"NodeParagraph","Properties":{"id":"20240614081450-pe0s82k","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614081450-vlz8j4b","Type":"NodeParagraph","Properties":{"id":"20240614081450-vlz8j4b","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614081450-tm47yw3","Type":"NodeParagraph","Properties":{"id":"20240614081450-tm47yw3","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 为圆马陆科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"约安巨马陆"},{"Type":"NodeText","Data":"或其它马陆类动物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240614081450-63kgske","Type":"NodeParagraph","Properties":{"id":"20240614081450-63kgske","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614081450-r10q2aj","Type":"NodeParagraph","Properties":{"id":"20240614081450-r10q2aj","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 多栖于阴湿地区，食草根及腐败的植物，触之则蜷缩不动，并放出恶臭。全国大部地区均有分布。"}]},{"ID":"20240614081450-buf5q9b","Type":"NodeParagraph","Properties":{"id":"20240614081450-buf5q9b","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614081450-i3j90pi","Type":"NodeParagraph","Properties":{"id":"20240614081450-i3j90pi","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 体长圆形，表面光滑。长约12厘米，宽约7毫米，全体由多数环节组成，从颈板到肛节，约有体节64个。头部两侧有许多单眼，集合成2团，形似复眼。触角1对，有毛，长约5毫米。口器包括大小颚各1对，小颚愈合成为颚唇。体背面黑褐色，后缘淡褐色，前缘盖住部分淡黄色。颈板半圆形，深褐色。第2～4节为胸部，每节各有步肢1对；第5节以下为腹部，除末节外，每节有步肢2对。雄虫在第7节上的步肢变为生殖肢。自第6背板后各体节的两侧，有臭腺孔。幼虫环节少，足仅3对，每脱皮1次，则体节和足陆续增加。"}]},{"ID":"20240614081450-zjos0dh","Type":"NodeParagraph","Properties":{"id":"20240614081450-zjos0dh","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614081450-77stylh","Type":"NodeParagraph","Properties":{"id":"20240614081450-77stylh","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》：\"凡使（马陆），收得后，糠头炒，令糠头焦黑，取马陆出，用竹刀刮足去头了，研成末用之。\""}]},{"ID":"20240614081450-oqxm42j","Type":"NodeParagraph","Properties":{"id":"20240614081450-oqxm42j","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614081450-onq6xv3","Type":"NodeParagraph","Properties":{"id":"20240614081450-onq6xv3","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味辛，温。\""}]},{"ID":"20240614081450-8002hpw","Type":"NodeParagraph","Properties":{"id":"20240614081450-8002hpw","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有毒。\""}]},{"ID":"20240614081450-p7wke7n","Type":"NodeParagraph","Properties":{"id":"20240614081450-p7wke7n","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614081450-lakp8yf","Type":"NodeParagraph","Properties":{"id":"20240614081450-lakp8yf","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 有毒，内服宜慎。"}]},{"ID":"20240614081450-glzrml9","Type":"NodeParagraph","Properties":{"id":"20240614081450-glzrml9","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614081450-93d4ugi","Type":"NodeParagraph","Properties":{"id":"20240614081450-93d4ugi","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 破积；解毒.治症瘕，痞满，痈肿，毒疮。"}]},{"ID":"20240614081450-l3mgc4x","Type":"NodeParagraph","Properties":{"id":"20240614081450-l3mgc4x","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腹中大坚症，破积聚，瘪肉恶疮，白秃。\""}]},{"ID":"20240614081450-ywd8wmp","Type":"NodeParagraph","Properties":{"id":"20240614081450-ywd8wmp","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗寒热痞结，胁下满。\""}]},{"ID":"20240614081450-7zmx9gt","Type":"NodeParagraph","Properties":{"id":"20240614081450-7zmx9gt","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"辟邪疟。\""}]},{"ID":"20240614081450-dt4dlzq","Type":"NodeParagraph","Properties":{"id":"20240614081450-dt4dlzq","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"④《分类草药性》：\"治一切痒疮，敷鱼口痈毒。\""}]},{"ID":"20240614081450-ixrs7a0","Type":"NodeParagraph","Properties":{"id":"20240614081450-ixrs7a0","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"⑤《贵州民间方药集》：\"治麻风，去风湿。\""}]},{"ID":"20240614081450-heh8ebo","Type":"NodeParagraph","Properties":{"id":"20240614081450-heh8ebo","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614081450-30ajykx","Type":"NodeParagraph","Properties":{"id":"20240614081450-30ajykx","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 外用：熬膏、研末或捣敷。"}]},{"ID":"20240614081450-2visbys","Type":"NodeParagraph","Properties":{"id":"20240614081450-2visbys","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614081450-vubnxz9","Type":"NodeParagraph","Properties":{"id":"20240614081450-vubnxz9","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" ①治鼻息肉：马陆醋炙研末，棉花蘸塞鼻孔中。（《泉州本草》）"}]},{"ID":"20240614081450-lb6gcu0","Type":"NodeParagraph","Properties":{"id":"20240614081450-lb6gcu0","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"②治蛾子：马陆、鲜赤葛。共捣烂，敷颈部。（《四川中药志》）"}]},{"ID":"20240614081450-u99fno0","Type":"NodeParagraph","Properties":{"id":"20240614081450-u99fno0","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"③治一切疮毒：马陆、滚山珠、癞疙宝、乌梢蛇、壁虎、蜈蚣。共以桐油熬膏，外贴。（《四川中药志》）"}]},{"ID":"20240614081450-vjmcjgg","Type":"NodeParagraph","Properties":{"id":"20240614081450-vjmcjgg","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614081450-5s3uoag","Type":"NodeParagraph","Properties":{"id":"20240614081450-5s3uoag","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614081450-hnk7tml","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081450-hnk7tml","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"《中华本草》：马陆"}]},{"ID":"20240614081450-oxr9ji1","Type":"NodeParagraph","Properties":{"id":"20240614081450-oxr9ji1","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614081450-ki6t6pz","Type":"NodeParagraph","Properties":{"id":"20240614081450-ki6t6pz","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" Mǎ Lù"}]},{"ID":"20240614081450-4gxpnw6","Type":"NodeParagraph","Properties":{"id":"20240614081450-4gxpnw6","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614081450-b3dx7of","Type":"NodeParagraph","Properties":{"id":"20240614081450-b3dx7of","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 蚿、蛝、百足、马蚿、蛆蟝、马蚰、秦渠、飞蚿虫、马轴、蚐、千足、刀环虫、马驩、百节虫、"}]},{"ID":"20240614081450-hgbscpo","Type":"NodeParagraph","Properties":{"id":"20240614081450-hgbscpo","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614081450-gcrp3sl","Type":"NodeParagraph","Properties":{"id":"20240614081450-gcrp3sl","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" Millepede"}]},{"ID":"20240614081450-7cvern4","Type":"NodeParagraph","Properties":{"id":"20240614081450-7cvern4","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614081450-waimtju","Type":"NodeParagraph","Properties":{"id":"20240614081450-waimtju","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240614081450-lj180ul","Type":"NodeParagraph","Properties":{"id":"20240614081450-lj180ul","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614081450-3wu04mv","Type":"NodeParagraph","Properties":{"id":"20240614081450-3wu04mv","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 药材基源：为圆马陆科动物宽跗陇马陆的全体。"}]},{"ID":"20240614081450-a615luu","Type":"NodeParagraph","Properties":{"id":"20240614081450-a615luu","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Kronopolites svenhedind(Verhoeff)"}]},{"ID":"20240614081450-dqwgs7k","Type":"NodeParagraph","Properties":{"id":"20240614081450-dqwgs7k","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-8月捕捉，去净杂质、泥土，晒干或烘干。"}]},{"ID":"20240614081450-6ftz7g5","Type":"NodeParagraph","Properties":{"id":"20240614081450-6ftz7g5","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614081450-fqcpzis","Type":"NodeParagraph","Properties":{"id":"20240614081450-fqcpzis","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 生态环境：栖息于山崖阴面有腐殖质的草丛中或树阴凉处。"}]},{"ID":"20240614081450-vfyhrah","Type":"NodeParagraph","Properties":{"id":"20240614081450-vfyhrah","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于甘肃、四川。"}]},{"ID":"20240614081450-vn39ibd","Type":"NodeParagraph","Properties":{"id":"20240614081450-vn39ibd","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614081450-6ef78d7","Type":"NodeParagraph","Properties":{"id":"20240614081450-6ef78d7","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 宽跗陇马陆，身体呈圆柱形，长26-30mm，宽2.5-3.5mm。雄性略小。由20个体节组成，可分为头、胸、腹三部，头部有1对触角，无眼，有侧头器；胸部由1-4休节组成，第1体节无足，第2-4体节各有步足1对；腹部由5-20体节组成，第5-18体节的后环节腹面各有2对步足，第19-20体节无足。第20体节后端有肛门，称为肛节。侧突不甚发达，侧突后有臭腺。胫节与跗节愈合成的胫跗节部宽大，是此种与同属其他种的区别点。"}]},{"ID":"20240614081450-omka9sc","Type":"NodeParagraph","Properties":{"id":"20240614081450-omka9sc","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614081450-3vof7ot","Type":"NodeParagraph","Properties":{"id":"20240614081450-3vof7ot","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，虫体呈圆柱形，长2-3c m，直径2-3mm。表面淡黄色或黄白色，具20个环节，环节处较深，步足细长，色较浅。体轻，质脆，易断，断面边缘浅黄色，中央棕褐色。气微，味微咸。"}]},{"ID":"20240614081450-76ua7fi","Type":"NodeParagraph","Properties":{"id":"20240614081450-76ua7fi","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614081450-q8wniux","Type":"NodeParagraph","Properties":{"id":"20240614081450-q8wniux","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 含有芳香醛、酮类、多粮类物质、氨基酸、多肽和蛋白质、挥发油及油脂、醌类物质、碳酸钙等。芳香醛中主要有苯甲醛。此外，马陆还含多种微量元素，以μg/g生药计，钙4875，磷3028，镁1434，铅997，铁540，锌84，钴62.8，锰62.3，铜50.4，砷33，钨28.3，硅17.8，铬10.6，铅10.6，钒2.87，汞2.45，镉2.48，钼1.8。"}]},{"ID":"20240614081450-dfiipcu","Type":"NodeParagraph","Properties":{"id":"20240614081450-dfiipcu","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614081450-olfz6h9","Type":"NodeParagraph","Properties":{"id":"20240614081450-olfz6h9","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用，从掸子虫体内提取制得的陇马陆素抗菌剂（有效成分为苯甲醛）在体外抑菌试验中，表现出广谱抗菌作用。高浓度时对部分细菌有杀灭作用，但一般呈抑制作用。它对肠道菌有较好抑制效果。有青霉素联合使用有协同作用。"}]},{"ID":"20240614081450-iq2zx31","Type":"NodeParagraph","Properties":{"id":"20240614081450-iq2zx31","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的作用，掸子虫蒸馏液有短暂的升高血压、兴奋呼吸的作用，并可兴奋肠、子宫平滑肌，使之产生节律性收缩。从该虫蒸馏液中分离出的“虫酮”作用与蒸馏相同，而分离出的“虫胺”磷酸盐反而有降压作用。实验观察到虫酮与虫胺互相配合能更好地调节血管功能。"}]},{"ID":"20240614081450-5hunr2b","Type":"NodeParagraph","Properties":{"id":"20240614081450-5hunr2b","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614081450-amfxaa0","Type":"NodeParagraph","Properties":{"id":"20240614081450-amfxaa0","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》：凡使（马陆），收得后，糠头炒，令糠头焦黑，取马陆出，用竹刀刮足去头了，研成未用之。"}]},{"ID":"20240614081450-fz2mxkp","Type":"NodeParagraph","Properties":{"id":"20240614081450-fz2mxkp","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614081450-x86mhoq","Type":"NodeParagraph","Properties":{"id":"20240614081450-x86mhoq","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 心；肺经"}]},{"ID":"20240614081450-te599f1","Type":"NodeParagraph","Properties":{"id":"20240614081450-te599f1","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614081450-aic6xmd","Type":"NodeParagraph","Properties":{"id":"20240614081450-aic6xmd","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 味辛；性温；有毒"}]},{"ID":"20240614081450-dwi4xrz","Type":"NodeParagraph","Properties":{"id":"20240614081450-dwi4xrz","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614081450-207mhzc","Type":"NodeParagraph","Properties":{"id":"20240614081450-207mhzc","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 有毒，内服宜慎。"}]},{"ID":"20240614081450-cgf7xcr","Type":"NodeParagraph","Properties":{"id":"20240614081450-cgf7xcr","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614081450-0zlcxfi","Type":"NodeParagraph","Properties":{"id":"20240614081450-0zlcxfi","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 破积；解毒；和胃。主症积；痞满；胃痛食少；痈肿；毒疮"}]},{"ID":"20240614081450-b08rgcv","Type":"NodeParagraph","Properties":{"id":"20240614081450-b08rgcv","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614081450-x97md6p","Type":"NodeParagraph","Properties":{"id":"20240614081450-x97md6p","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 内服：研粉或制成片剂，1-2g。外用：适量，熬膏，研末，或捣敷。"}]},{"ID":"20240614081450-8uzhoe4","Type":"NodeParagraph","Properties":{"id":"20240614081450-8uzhoe4","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614081450-ew8rm7r","Type":"NodeParagraph","Properties":{"id":"20240614081450-ew8rm7r","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主腹中大坚症，破积聚，瘜肉恶疮，白秃。"}]},{"ID":"20240614081450-c3dufqa","Type":"NodeParagraph","Properties":{"id":"20240614081450-c3dufqa","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗寒热痞结，胁下满。"}]},{"ID":"20240614081450-tqzxce8","Type":"NodeParagraph","Properties":{"id":"20240614081450-tqzxce8","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：辟邪疟。"}]},{"ID":"20240614081450-jt313ii","Type":"NodeParagraph","Properties":{"id":"20240614081450-jt313ii","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"4.《分类草药性》：治一切痒疮，敷鱼口痈毒。"}]},{"ID":"20240614081450-fvm8p7q","Type":"NodeParagraph","Properties":{"id":"20240614081450-fvm8p7q","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"5.《贵州民间方药集》：治麻风，去风湿。"}]},{"ID":"20240614081450-vjo4sh9","Type":"NodeParagraph","Properties":{"id":"20240614081450-vjo4sh9","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614081450-i9i7pxs","Type":"NodeParagraph","Properties":{"id":"20240614081450-i9i7pxs","updated":"20240614081450"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614081452-5ue6kno","Type":"NodeThematicBreak","Properties":{"id":"20240614081452-5ue6kno"}},{"ID":"20240614081453-4979csy","Type":"NodeParagraph","Properties":{"id":"20240614081453-4979csy"}}]}