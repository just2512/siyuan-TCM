{"ID":"20240506110121-h0bnwwd","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506110121-h0bnwwd","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506110121-h0bnwwd\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506110121-n804uux\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240506110121-n804uux\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506110121-n804uux\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"343石蚕","type":"doc","updated":"20240828090737"},"Children":[{"ID":"20240703131150-f5l8t5c","Type":"NodeParagraph","Properties":{"id":"20240703131150-f5l8t5c","updated":"20240828090307"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 537px;","style":"width: 527px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕5-20240703131035-7rwe5lh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 527px;\" parent-style=\"width: 537px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828090400-f43tjtt","Type":"NodeParagraph","Properties":{"id":"20240828090400-f43tjtt","updated":"20240828090518"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕-20240828090400-1wmxzlb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 354px;","style":"width: 344px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕 1-20240828090439-5euix5r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 344px;\" parent-style=\"width: 354px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 389px;","style":"width: 379px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕 2-20240828090518-xsnuz19.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 379px;\" parent-style=\"width: 389px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703132043-5bcfogt","Type":"NodeParagraph","Properties":{"id":"20240703132043-5bcfogt","updated":"20240828090535"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 418px;","style":"width: 408px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕2-20240703130841-mhr8orl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 408px;\" parent-style=\"width: 418px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 484px;","style":"width: 474px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕3-20240703130925-kpx5u42.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 474px;\" parent-style=\"width: 484px;\"}"},{"Type":"NodeText","Data":"​​​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 441px;","style":"width: 431px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蚕4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蚕4-20240703131119-7xijfvp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240703131035-0e6dmin","Type":"NodeParagraph","Properties":{"id":"20240703131035-0e6dmin","updated":"20240828090554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 785px;","style":"width: 775px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蛾3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蛾3-20240703131425-2db95mo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 775px;\" parent-style=\"width: 785px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 258px;","style":"width: 248px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蛾1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蛾1-20240703131306-rehq64j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 248px;\" parent-style=\"width: 258px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828090713-on84rdl","Type":"NodeParagraph","Properties":{"id":"20240828090713-on84rdl","updated":"20240828090721"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 584px;","style":"width: 574px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蛾"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蛾-20240828090713-lqzr9jr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 574px;\" parent-style=\"width: 584px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 527px;","style":"width: 517px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蛾4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蛾4-20240703131750-uro1fm1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 517px;\" parent-style=\"width: 527px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703131825-rlx3wlp","Type":"NodeParagraph","Properties":{"id":"20240703131825-rlx3wlp","updated":"20240828090732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1114px;","style":"width: 1104px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石蛾6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石蛾6-20240703131825-uoyitoi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1104px;\" parent-style=\"width: 1114px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240613174352-vkqrb1k","Type":"NodeParagraph","Properties":{"id":"20240613174352-vkqrb1k","updated":"20240828090737"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：石蚕，为石蛾（石蚕蛾）的幼虫。"}]},{"ID":"20240613174352-fvwof4y","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-fvwof4y"}},{"ID":"20240613174540-v52n6x5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174540-v52n6x5","updated":"20240613174545"},"Children":[{"Type":"NodeText","Data":"石蚕《神农本草经》"}]},{"ID":"20240613174540-e2uq31t","Type":"NodeParagraph","Properties":{"id":"20240613174540-e2uq31t","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"味咸寒。"}]},{"ID":"20240613174540-i7jwtqy","Type":"NodeParagraph","Properties":{"id":"20240613174540-i7jwtqy","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"主五癃，破石淋，堕胎，内解结气，利水道，除热。一名沙虱。生池泽。"}]},{"ID":"20240613174540-xnp0xdu","Type":"NodeParagraph","Properties":{"id":"20240613174540-xnp0xdu","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：石蚕亦名沙虱，神农雷公酸无毒，生汉中，治五淋，破随内结气，利水道，除热（《御览》）。"}]},{"ID":"20240613174540-z45ovjs","Type":"NodeParagraph","Properties":{"id":"20240613174540-z45ovjs","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生江汉。"}]},{"ID":"20240613174540-gdqqbwx","Type":"NodeParagraph","Properties":{"id":"20240613174540-gdqqbwx","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：沙虱，也。淮南万毕术云：沙虱，一名蓬活，一名地脾。"}]},{"ID":"20240613174540-ygbo2h9","Type":"NodeParagraph","Properties":{"id":"20240613174540-ygbo2h9","updated":"20240613174540"},"Children":[{"Type":"NodeText","Data":"《御览》虫豸部引李当之云：类虫，形如老蚕，生附石。广志云：皆虱，虱色赤，大过虮，在水中，入人皮中，杀人，与李似不同。"}]},{"ID":"20240613174802-gf0l1ve","Type":"NodeThematicBreak","Properties":{"id":"20240613174802-gf0l1ve"}},{"ID":"20240613174803-wivt50w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174803-wivt50w","updated":"20240613174808"},"Children":[{"Type":"NodeText","Data":"石蚕《证类本草》"}]},{"ID":"20240613174803-woux11w","Type":"NodeParagraph","Properties":{"id":"20240613174803-woux11w","updated":"20240613174803"},"Children":[{"Type":"NodeText","Data":"无毒。主金疮止血，生肌，破石淋，血结。磨服之，当下碎石。生海岸石旁，状如蚕，其实石也。（今附）"}]},{"ID":"20240613174803-t5karg3","Type":"NodeParagraph","Properties":{"id":"20240613174803-t5karg3","updated":"20240613174803"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按药诀云∶石蚕，味苦，热，有毒。"}]},{"ID":"20240613174815-ga8yn7d","Type":"NodeThematicBreak","Properties":{"id":"20240613174815-ga8yn7d"}},{"ID":"20240613174816-b898pe4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174816-b898pe4","updated":"20240613174820"},"Children":[{"Type":"NodeText","Data":"石蚕《本草经集注》"}]},{"ID":"20240613174816-vgfzaxo","Type":"NodeParagraph","Properties":{"id":"20240613174816-vgfzaxo","updated":"20240613174816"},"Children":[{"Type":"NodeText","Data":"味咸，寒，有毒。主治五癃，破石淋，堕胎。肉∶解结气，利水道，除热。一名沙虱。"}]},{"ID":"20240613174816-87n2sbg","Type":"NodeParagraph","Properties":{"id":"20240613174816-87n2sbg","updated":"20240613174816"},"Children":[{"Type":"NodeText","Data":"生江汉池泽。"}]},{"ID":"20240613174816-olr9o6r","Type":"NodeParagraph","Properties":{"id":"20240613174816-olr9o6r","updated":"20240613174816"},"Children":[{"Type":"NodeText","Data":"李云江左无识此者，谓为草根，其实类虫，形如老、蚕，生附石。伧人得而食之，味咸而微辛。李之所言有理，但江汉非伧地尔。大都应是生气物，犹如海中蛎蛤辈，附石生不动，亦皆活物也。今世用草根黑色多角节，亦似蚕，恐未是实。方家不用沙虱，自是东间水中细虫。人入水浴，着人略不可见，痛如针刺，挑亦得之。今此名或同尔，非其所称也。"}]},{"ID":"20240613174622-wtz3ppd","Type":"NodeThematicBreak","Properties":{"id":"20240613174622-wtz3ppd"}},{"ID":"20240613174623-fc5yuxf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174623-fc5yuxf","updated":"20240613174734"},"Children":[{"Type":"NodeText","Data":"石蚕《名医别录》"}]},{"ID":"20240613174623-ju2hr2l","Type":"NodeParagraph","Properties":{"id":"20240613174623-ju2hr2l","updated":"20240613174623"},"Children":[{"Type":"NodeText","Data":"有毒，生江汉．"}]},{"ID":"20240613174623-u9j0r7i","Type":"NodeParagraph","Properties":{"id":"20240613174623-u9j0r7i","updated":"20240613174627"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶石蚕，味咸，寒．主五癃，破石淋，堕胎．肉，解结气，利水道，除热．一名沙虱．生池泽."}]},{"ID":"20240613174633-effqdp6","Type":"NodeThematicBreak","Properties":{"id":"20240613174633-effqdp6"}},{"ID":"20240613174634-rh5j8r7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174634-rh5j8r7","updated":"20240613174638"},"Children":[{"Type":"NodeText","Data":"石蚕《千金翼方》"}]},{"ID":"20240613174634-69ee6qw","Type":"NodeParagraph","Properties":{"id":"20240613174634-69ee6qw","updated":"20240613174634"},"Children":[{"Type":"NodeText","Data":"味咸，寒，有毒。主五癃，破石淋堕胎。"}]},{"ID":"20240613174634-5doe8r1","Type":"NodeParagraph","Properties":{"id":"20240613174634-5doe8r1","updated":"20240613174634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"}]},{"ID":"20240613174634-4mkmime","Type":"NodeParagraph","Properties":{"id":"20240613174634-4mkmime","updated":"20240613174634"},"Children":[{"Type":"NodeText","Data":"解结气，利水道，除热。一名沙虱。生江汉池泽。"}]},{"ID":"20240613174642-yczehya","Type":"NodeThematicBreak","Properties":{"id":"20240613174642-yczehya"}},{"ID":"20240613174643-psb5c2n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174643-psb5c2n","updated":"20240613174652"},"Children":[{"Type":"NodeText","Data":"石蚕《本草图经》"}]},{"ID":"20240613174643-8di5gd7","Type":"NodeParagraph","Properties":{"id":"20240613174643-8di5gd7","updated":"20240703130053"},"Children":[{"Type":"NodeText","Data":"生江汉池泽。旧注或以为草根，生石上，似蚕者。或以为生气物，犹如海中蛎蛤辈。"}]},{"ID":"20240613174643-0gut6ap","Type":"NodeParagraph","Properties":{"id":"20240613174643-0gut6ap","updated":"20240613174643"},"Children":[{"Type":"NodeText","Data":"又《本经》云：一名沙虱。沙虱自是水中细虫，都无定论。《蜀本草》注云：此虫所在水石间有之，人取以为钩饵。马湖石间出此最多，彼人亦好啖之，云味咸、小辛。今此类川、广中多有之。草根之似蚕者，亦名石蚕，出福州及信州山石上，四时常有，其苗青，亦有节，三月采根，焙干。主走注风，散血，止痛。其节亦堪单用，揭筛取末，酒温服之。"}]},{"ID":"20240613174605-5w2a4ct","Type":"NodeThematicBreak","Properties":{"id":"20240613174605-5w2a4ct"}},{"ID":"20240613174606-525hgmt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174606-525hgmt","updated":"20240613174612"},"Children":[{"Type":"NodeText","Data":"石蚕《本草衍义》"}]},{"ID":"20240613174606-338sglv","Type":"NodeParagraph","Properties":{"id":"20240613174606-338sglv","updated":"20240613174606"},"Children":[{"Type":"NodeText","Data":"谓之为草，则缪矣。经言“肉解结气”，《注》中更辨不定。此物在处有，附生水中石上，作丝茧如钗股，长寸许，以蔽其身，色如泥，蚕在其中。此所以谓之石蚕也。今方家用者绝稀。此亦水中虫耳，山河中多。"}]},{"ID":"20240613174554-8ci7grq","Type":"NodeThematicBreak","Properties":{"id":"20240613174554-8ci7grq"}},{"ID":"20240613174556-fgyovzl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174556-fgyovzl","updated":"20240613174600"},"Children":[{"Type":"NodeText","Data":"石蚕《玉楸药解》"}]},{"ID":"20240613174556-hh8z9kh","Type":"NodeParagraph","Properties":{"id":"20240613174556-hh8z9kh","updated":"20240613174556"},"Children":[{"Type":"NodeText","Data":"味苦，微凉，入足太阳膀胱经。通淋沥，生肌肉。"}]},{"ID":"20240613174556-9abfj4s","Type":"NodeParagraph","Properties":{"id":"20240613174556-9abfj4s","updated":"20240613174556"},"Children":[{"Type":"NodeText","Data":"石蚕清利膀胱，治石淋血结。磨服则下碎石。"}]},{"ID":"20240613174352-40xvn2e","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-40xvn2e"}},{"ID":"20240613174530-xg19ilk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174530-xg19ilk","updated":"20240613174535"},"Children":[{"Type":"NodeText","Data":"石蚕《神农本草经赞》"}]},{"ID":"20240613174530-nrkmtwo","Type":"NodeParagraph","Properties":{"id":"20240613174530-nrkmtwo","updated":"20240613174530"},"Children":[{"Type":"NodeText","Data":"味咸寒。主五癃。破石淋。堕胎。内解结气。利水道除热。一名沙虱。生池泽。"}]},{"ID":"20240613174530-8ccy9fn","Type":"NodeParagraph","Properties":{"id":"20240613174530-8ccy9fn","updated":"20240613174530"},"Children":[{"Type":"NodeText","Data":"蚕形石化。亦育中阿。候无眠起。乐在风波。身环泥茧。羽化灰蛾。云师雨虎。相荡相摩。"}]},{"ID":"20240613174530-9uxbbme","Type":"NodeParagraph","Properties":{"id":"20240613174530-9uxbbme","updated":"20240613174530"},"Children":[{"Type":"NodeText","Data":"马志曰。石蚕生海岸石旁。状如蚕。其实石也。李时珍曰。与此不同。诗。在彼中阿。"}]},{"ID":"20240613174530-r94brgs","Type":"NodeParagraph","Properties":{"id":"20240613174530-r94brgs","updated":"20240613174530"},"Children":[{"Type":"NodeText","Data":"韩保升曰。此虫所在。水石间有之。埤雅。蚕三眠三起。张志和词。乐在风波不用仙。寇宗曰。作丝茧长寸许。以蔽其身。其色如泥。陈藏器曰。春夏羽化。作小蛾水上飞。李时珍曰。"}]},{"ID":"20240613174530-2p9jxvp","Type":"NodeParagraph","Properties":{"id":"20240613174530-2p9jxvp","updated":"20240613174530"},"Children":[{"Type":"NodeText","Data":"霍山有云师。状如蚕。长六寸。雨虎。状如蚕。长七八寸。皆石蚕之类。易。刚柔相摩。八卦相荡。"}]},{"ID":"20240613174352-teuvlaz","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-teuvlaz"}},{"ID":"20240613174519-rqxllm6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174519-rqxllm6","updated":"20240613174525"},"Children":[{"Type":"NodeText","Data":"石蚕《吴普本草》"}]},{"ID":"20240613174519-tpcdv8v","Type":"NodeParagraph","Properties":{"id":"20240613174519-tpcdv8v","updated":"20240613174519"},"Children":[{"Type":"NodeText","Data":"《御览》卷八百二十五"}]},{"ID":"20240613174519-qec17n7","Type":"NodeParagraph","Properties":{"id":"20240613174519-qec17n7","updated":"20240613174519"},"Children":[{"Type":"NodeText","Data":"一名沙蚌。神农、雷公∶咸，无毒。生汉中，治五淋，破髓肉，解结气，利水道，除热。"}]},{"ID":"20240613174352-j25wih6","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-j25wih6"}},{"ID":"20240613174424-v3111x2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174424-v3111x2","updated":"20240613174428"},"Children":[{"Type":"NodeText","Data":"石蚕《新修本草》"}]},{"ID":"20240613174424-hymf5fy","Type":"NodeParagraph","Properties":{"id":"20240613174424-hymf5fy","updated":"20240613174424"},"Children":[{"Type":"NodeText","Data":"味咸，寒，有毒。主五癃，破石淋，堕胎。肉，解结气，利水道，除热。一名沙虱。生江汉池泽。"}]},{"ID":"20240613174424-p9y8t3c","Type":"NodeParagraph","Properties":{"id":"20240613174424-p9y8t3c","updated":"20240613174424"},"Children":[{"Type":"NodeText","Data":"李云江左无识此者，谓为草根，其实类虫，形如老蚕，生附石。伧人得而食之，味咸而微辛。李之所言有理，但江汉非伧地尔，大都应是生气物，犹如海中蛎蛤辈，附石生不动，亦皆活物也。今俗用草根黑色多角节，亦似蚕，恐未是实。方家不用沙虱，自是东间水中细虫。人入水浴，着人略不可见，痛如针刺，挑亦得之。"}]},{"ID":"20240613174424-p7k7d9z","Type":"NodeParagraph","Properties":{"id":"20240613174424-p7k7d9z","updated":"20240613174424"},"Children":[{"Type":"NodeText","Data":"今此名或同尔，非其所称也。"}]},{"ID":"20240613174424-z5aoik5","Type":"NodeParagraph","Properties":{"id":"20240613174424-z5aoik5","updated":"20240613174424"},"Children":[{"Type":"NodeText","Data":"〔谨案〕石采者遂绝尔。今陇州采送之。"}]},{"ID":"20240613174352-uw9uflk","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-uw9uflk"}},{"ID":"20240613174406-s8aop4f","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240613174406-s8aop4f","updated":"20240613174412"},"Children":[{"Type":"NodeText","Data":"石蚕《医学入门》"}]},{"ID":"20240613174406-2wedo6v","Type":"NodeParagraph","Properties":{"id":"20240613174406-2wedo6v","updated":"20240613174406"},"Children":[{"Type":"NodeText","Data":"在处有之，生水中石上，作茧以蔽其身，蚕在其中。味咸，寒，有毒。主五癃石淋，解结气，利水道，除热，堕胎。"}]},{"ID":"20240613174352-ggx36va","Type":"NodeThematicBreak","Properties":{"id":"20240613174352-ggx36va"}},{"ID":"20240613174353-ph2m1sj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174353-ph2m1sj","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：石蚕"}]},{"ID":"20240613174353-3mbivg5","Type":"NodeParagraph","Properties":{"id":"20240613174353-3mbivg5","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613174353-ud1tpcy","Type":"NodeParagraph","Properties":{"id":"20240613174353-ud1tpcy","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 石上藕"}]},{"ID":"20240613174353-6lqptqb","Type":"NodeParagraph","Properties":{"id":"20240613174353-6lqptqb","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613174353-r649l38","Type":"NodeParagraph","Properties":{"id":"20240613174353-r649l38","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 兰科斑叶兰属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"偏花斑叶兰"},{"Type":"NodeText","Data":"Goodyera secundiflora Lindl.，以全草入药。四季可采，洗净，鲜用或晒干。"}]},{"ID":"20240613174353-ghnf93f","Type":"NodeParagraph","Properties":{"id":"20240613174353-ghnf93f","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613174353-vo9bgcc","Type":"NodeParagraph","Properties":{"id":"20240613174353-vo9bgcc","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 甘、淡、微涩，凉。"}]},{"ID":"20240613174353-atbds57","Type":"NodeParagraph","Properties":{"id":"20240613174353-atbds57","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613174353-8y3mw4v","Type":"NodeParagraph","Properties":{"id":"20240613174353-8y3mw4v","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 润肺止咳，清热凉血。用于肺结核，咳嗽，咯血，百日咳，支气管炎。"}]},{"ID":"20240613174353-z1vfjwz","Type":"NodeParagraph","Properties":{"id":"20240613174353-z1vfjwz","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613174353-sj8j9ej","Type":"NodeParagraph","Properties":{"id":"20240613174353-sj8j9ej","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 3～5钱。水煎服。"}]},{"ID":"20240613174353-gizc3us","Type":"NodeParagraph","Properties":{"id":"20240613174353-gizc3us","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613174353-4niso43","Type":"NodeParagraph","Properties":{"id":"20240613174353-4niso43","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" （1）本品还可治神经衰弱、食欲不振、筋骨疼痛等症。"}]},{"ID":"20240613174353-h768e17","Type":"NodeParagraph","Properties":{"id":"20240613174353-h768e17","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613174353-89xgc7t","Type":"NodeParagraph","Properties":{"id":"20240613174353-89xgc7t","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613174353-qza1zim","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613174353-qza1zim","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：石蚕"}]},{"ID":"20240613174353-svstfif","Type":"NodeParagraph","Properties":{"id":"20240613174353-svstfif","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613174353-u1xqfws","Type":"NodeParagraph","Properties":{"id":"20240613174353-u1xqfws","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" Shí Cán"}]},{"ID":"20240613174353-bdsobvx","Type":"NodeParagraph","Properties":{"id":"20240613174353-bdsobvx","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613174353-vllnvn7","Type":"NodeParagraph","Properties":{"id":"20240613174353-vllnvn7","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 沙虱（《本经》），石蠹虫（《别录》），石下新妇（《本草拾遗》）。"}]},{"ID":"20240613174353-8lksta5","Type":"NodeParagraph","Properties":{"id":"20240613174353-8lksta5","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613174353-5m808r1","Type":"NodeParagraph","Properties":{"id":"20240613174353-5m808r1","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613174353-rn2224c","Type":"NodeParagraph","Properties":{"id":"20240613174353-rn2224c","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613174353-wxdb0yv","Type":"NodeParagraph","Properties":{"id":"20240613174353-wxdb0yv","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 为石蚕科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石蛾"},{"Type":"NodeText","Data":"或其近缘昆虫的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼虫"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613174353-2xacrqn","Type":"NodeParagraph","Properties":{"id":"20240613174353-2xacrqn","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613174353-sdb9yye","Type":"NodeParagraph","Properties":{"id":"20240613174353-sdb9yye","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 体形如蛾，黄褐色，长约2厘米，展翅阔6匣米。头部略星卵形，黄色，头顶密被黄色及白色刚毛。复眼1对，单眼3个。口器退化，小颚与下唇形成短吻管，适于啜吸。触角1对，基节及末端均黄色，其中央则呈黑褐色。前胸短小，前胸背密生黄色及白色刚毛。中胸背大，两侧各有1黑褐纹。翅2对，密生短毛，不透明，后翅大于前翅；前翅的前缘黄褐色，散布有小形的褐纹，中央有1黑色大纵条，内缘及后缘皆灰褐色，有褐色棱纹，后翅深黄色，外缘暗黑色。足3对，黄色，腿节及跗节的大部为黑褐色。尾端有突出的长刺2条。幼虫略似蚕，有胸足3对，腹部有原足1对，并有腮。"}]},{"ID":"20240613174353-b09gpf7","Type":"NodeParagraph","Properties":{"id":"20240613174353-b09gpf7","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"成虫多出现于水边的草木上。卵产于水边的石上或草根上，幼虫孵化后入水中，用丝腺的分泌物缀合叶片、木片、砂石等造成各种管状的栖管而藏身其中，露出头，胸及足匍行于水底，食水草或小虫，渐次化蛹而为成虫。"}]},{"ID":"20240613174353-enccdq8","Type":"NodeParagraph","Properties":{"id":"20240613174353-enccdq8","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613174353-mclrt63","Type":"NodeParagraph","Properties":{"id":"20240613174353-mclrt63","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 咸，寒。"}]},{"ID":"20240613174353-s9g3s7n","Type":"NodeParagraph","Properties":{"id":"20240613174353-s9g3s7n","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味咸，寒。\""}]},{"ID":"20240613174353-4s8r02a","Type":"NodeParagraph","Properties":{"id":"20240613174353-4s8r02a","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"雷公：咸，无毒。\""}]},{"ID":"20240613174353-y1f6yyc","Type":"NodeParagraph","Properties":{"id":"20240613174353-y1f6yyc","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"③李当之《药录》：\"味咸微辛。\""}]},{"ID":"20240613174353-bgywevx","Type":"NodeParagraph","Properties":{"id":"20240613174353-bgywevx","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"④《别录》：\"有毒。\""}]},{"ID":"20240613174353-dg4nnt5","Type":"NodeParagraph","Properties":{"id":"20240613174353-dg4nnt5","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613174353-3e5w8zz","Type":"NodeParagraph","Properties":{"id":"20240613174353-3e5w8zz","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"主五癃，破石淋，堕胎。内解结气，利水道，除热。\""}]},{"ID":"20240613174353-egjomum","Type":"NodeParagraph","Properties":{"id":"20240613174353-egjomum","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主石癃，小便不利。\""}]},{"ID":"20240613174353-a2jjl5j","Type":"NodeParagraph","Properties":{"id":"20240613174353-a2jjl5j","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613174353-u0o0pea","Type":"NodeParagraph","Properties":{"id":"20240613174353-u0o0pea","updated":"20240613174353"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613174355-92v20we","Type":"NodeThematicBreak","Properties":{"id":"20240613174355-92v20we"}},{"ID":"20240613174356-fgvip5d","Type":"NodeParagraph","Properties":{"id":"20240613174356-fgvip5d"}}]}