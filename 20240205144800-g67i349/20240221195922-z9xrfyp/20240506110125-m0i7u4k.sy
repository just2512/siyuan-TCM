penParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛2-20240704092611-683nj1h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 480px;\" parent-style=\"width: 490px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 766px;","style":"width: 756px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜘蛛4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛4-20240704092746-r7x4ica.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 756px;\" parent-style=\"width: 766px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828122515-d2l4f75","Type":"NodeParagraph","Properties":{"id":"20240828122515-d2l4f75","updated":"20240828122516"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 512px;","style":"width: 502px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜘蛛"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛-20240828122516-8b3vzgn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 502px;\" parent-style=\"width: 512px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 679px;","style":"width: 669px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜘蛛8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛8-20240704093312-du58c91.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 669px;\" parent-style=\"width: 679px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614100627-96yhm4k","Type":"NodeParagraph","Properties":{"id":"20240614100627-96yhm4k","updated":"20240828122558"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 497px;","style":"width: 487px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜘蛛5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛5-20240704092831-uc71jr4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 487px;\" parent-style=\"width: 497px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 728px;","style":"width: 718px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜘蛛 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜘蛛 1-20240828122558-ihwe7ef.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614101234-e8j42ct","Type":"NodeThematicBreak","Properties":{"id":"20240614101234-e8j42ct"}},{"ID":"20240614101351-z2va8xb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101351-z2va8xb","updated":"20240614101354"},"Children":[{"Type":"NodeText","Data":"蜘蛛《汤液本草》"}]},{"ID":"20240614101351-yqkuhga","Type":"NodeParagraph","Properties":{"id":"20240614101351-yqkuhga","updated":"20240614101351"},"Children":[{"Type":"NodeText","Data":"微寒。"}]},{"ID":"20240614101351-nbobd7t","Type":"NodeParagraph","Properties":{"id":"20240614101351-nbobd7t","updated":"20240614101351"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主大人小儿 疝。七月七日取其网，疗喜忘。仲景治杂病。狐疝，偏有大小，时时上下者，蜘蛛一十四个，熬焦，桂半两。研细为散。八分匕，酒调服，日再。蜜丸亦通。"}]},{"ID":"20240614101234-90inuiq","Type":"NodeThematicBreak","Properties":{"id":"20240614101234-90inuiq"}},{"ID":"20240614101235-dyyy8zj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101235-dyyy8zj","updated":"20240614101239"},"Children":[{"Type":"NodeText","Data":"蜘蛛《雷公炮炙论》"}]},{"ID":"20240614101235-lu9frd5","Type":"NodeParagraph","Properties":{"id":"20240614101235-lu9frd5","updated":"20240614101235"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用五色者，兼大身、上有刺毛生者；并薄小者。以上并不堪用。凡欲用，要在屋西面有网、身小尻大、腹内有苍黄脓者，真也。"}]},{"ID":"20240614101235-93a269u","Type":"NodeParagraph","Properties":{"id":"20240614101235-93a269u","updated":"20240614101235"},"Children":[{"Type":"NodeText","Data":"凡用，去头、足了，研如膏，投入药中用。"}]},{"ID":"20240614100627-lbs4npr","Type":"NodeThematicBreak","Properties":{"id":"20240614100627-lbs4npr"}},{"ID":"20240614101224-mdbo2u7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101224-mdbo2u7","updated":"20240614101229"},"Children":[{"Type":"NodeText","Data":"蜘蛛《冯氏锦囊秘录》"}]},{"ID":"20240614101224-1n0i7nk","Type":"NodeParagraph","Properties":{"id":"20240614101224-1n0i7nk","updated":"20240614101224"},"Children":[{"Type":"NodeText","Data":"蜘蛛，大人狐疝偏痛，睾丸或时上下者能瘥。小儿大腹丁奚，行步三年 者堪愈，久疟寒热可断，霍乱干呕堪驱。蛇虺咬捣汁涂，蜈蚣咬用活吸。疔肿作膏敷退。瘿瘤渍酒饮消，丝网疗健忘。七夕取食能使人巧。"}]},{"ID":"20240614101030-nb5hyqi","Type":"NodeThematicBreak","Properties":{"id":"20240614101030-nb5hyqi"}},{"ID":"20240614101208-mv1uw11","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101208-mv1uw11","updated":"20240614101216"},"Children":[{"Type":"NodeText","Data":"蜘蛛《名医别录》"}]},{"ID":"20240614101208-7zzldn3","Type":"NodeParagraph","Properties":{"id":"20240614101208-7zzldn3","updated":"20240614101208"},"Children":[{"Type":"NodeText","Data":"微寒。主治大人小儿。七月七日取其网，治喜忘。"}]},{"ID":"20240614101208-x592muf","Type":"NodeParagraph","Properties":{"id":"20240614101208-x592muf","updated":"20240614101208"},"Children":[{"Type":"NodeText","Data":"又，疗小儿大腹、丁奚，三年不能行者。"}]},{"ID":"20240614101031-14tbdty","Type":"NodeThematicBreak","Properties":{"id":"20240614101031-14tbdty"}},{"ID":"20240614101152-7dmx8lg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101152-7dmx8lg","updated":"20240614101200"},"Children":[{"Type":"NodeText","Data":"蜘蛛《本草图经》"}]},{"ID":"20240614101152-jrfmdqp","Type":"NodeParagraph","Properties":{"id":"20240614101152-jrfmdqp","updated":"20240614101154"},"Children":[{"Type":"NodeText","Data":"旧不著生出州郡，今处处有之。其类极多。《尔雅》云：次蟗（音秋），蜘蛛（音与知朱字同）。蜘蛛，蛛蝥。郭璞云：江东呼KT（音棳）蝥者。又云土蜘蛛，在地布网者；草蜘蛛，络幕草上者；KT（音萧）蛸（音鞘）、长踦，小蜘蛛长脚者，俗呼为喜子。陶隐居云：当用悬网状如鱼罾者，亦名KT。则《尔雅》所为蛛蝥。郭璞所谓KT蝥者是也。古方主蛇、蜂、蜈蚣毒及小儿大腹、丁奚、赘疣。今人蛇啮者，涂其汁；小儿腹疳者，烧熟啖之；赘疣者，取其网丝缠之；蜂及蜈蚣螫者，生置痛处，令吸其毒，皆有验。然此虫中人尤惨，惟饮羊乳汁，可制其毒。出刘禹锡《传信方》云。张仲景治杂病方，疗阴狐疝气偏，有大小，时时上下者，蜘蛛散主之。蜘蛛十四枚，熬焦，桂半两，二物为散，每服八分一匕，日再。蜜丸，亦通。"}]},{"ID":"20240614101039-mcce8rh","Type":"NodeThematicBreak","Properties":{"id":"20240614101039-mcce8rh"}},{"ID":"20240614101058-qyse9bk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101058-qyse9bk","updated":"20240614101102"},"Children":[{"Type":"NodeText","Data":"蜘蛛《千金翼方》"}]},{"ID":"20240614101058-m3mbo0p","Type":"NodeParagraph","Properties":{"id":"20240614101058-m3mbo0p","updated":"20240614101058"},"Children":[{"Type":"NodeText","Data":"微寒。主大人小儿 。七月七日取其网，疗喜忘。"}]},{"ID":"20240614101039-swicbk3","Type":"NodeThematicBreak","Properties":{"id":"20240614101039-swicbk3"}},{"ID":"20240614101050-f0siv5p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101050-f0siv5p","updated":"20240614101054"},"Children":[{"Type":"NodeText","Data":"蜘蛛《得配本草》"}]},{"ID":"20240614101050-yfz5ork","Type":"NodeParagraph","Properties":{"id":"20240614101050-yfz5ork","updated":"20240614101050"},"Children":[{"Type":"NodeText","Data":"畏蔓荆、雄黄。"}]},{"ID":"20240614101050-faq5k4j","Type":"NodeParagraph","Properties":{"id":"20240614101050-faq5k4j","updated":"20240614101050"},"Children":[{"Type":"NodeText","Data":"微寒。有小毒。治蛇伤，疗温疟，止呕逆霍乱，疗腹大丁奚。配肉桂，治狐疝。配铜绿，擦走马疳。（加麝香少许。）"}]},{"ID":"20240614101050-3ee7db4","Type":"NodeParagraph","Properties":{"id":"20240614101050-3ee7db4","updated":"20240614101050"},"Children":[{"Type":"NodeText","Data":"蜘蛛咬伤，腹大如孕，饮羊乳解之。以靛汁入麝香、雄黄，点咬处。"}]},{"ID":"20240614101039-wzm4yec","Type":"NodeThematicBreak","Properties":{"id":"20240614101039-wzm4yec"}},{"ID":"20240614101040-f0lsms2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101040-f0lsms2","updated":"20240614101044"},"Children":[{"Type":"NodeText","Data":"蜘蛛《本经逢原》"}]},{"ID":"20240614101040-qz6ebe5","Type":"NodeParagraph","Properties":{"id":"20240614101040-qz6ebe5","updated":"20240614101040"},"Children":[{"Type":"NodeText","Data":"微寒有毒。其种类不一，惟用悬网者入药。"}]},{"ID":"20240614101040-774q7bf","Type":"NodeParagraph","Properties":{"id":"20240614101040-774q7bf","updated":"20240614101040"},"Children":[{"Type":"NodeText","Data":"发明 仲景治阴狐疝气，偏有大小，时时上下者，蜘蛛散主之，以其入肝，性善循丝上下，故取以治睾丸上下之病。《别录》治大人、小儿 疝，又治干霍乱，服之能令人利，其邪得以下泄也。捣汁涂蛇伤效。"}]},{"ID":"20240614101031-8o6s7rf","Type":"NodeThematicBreak","Properties":{"id":"20240614101031-8o6s7rf"}},{"ID":"20240614101032-jdjfcnv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101032-jdjfcnv","updated":"20240614101035"},"Children":[{"Type":"NodeText","Data":"蜘蛛《新修本草》"}]},{"ID":"20240614101032-i8ad628","Type":"NodeParagraph","Properties":{"id":"20240614101032-i8ad628","updated":"20240614101032"},"Children":[{"Type":"NodeText","Data":"微寒。主大人小儿溃。七月七日取其网，疗喜忘。"}]},{"ID":"20240614101032-x5o0qtj","Type":"NodeParagraph","Properties":{"id":"20240614101032-x5o0qtj","updated":"20240614101032"},"Children":[{"Type":"NodeText","Data":"蜘蛛类数十种，《尔雅》止载七、八种尔，今此用悬网状如鱼曾者，亦名 。蜂及蜈蚣螫又以断疟及干呕霍乱。术家取其网着衣领中辟忘。"}]},{"ID":"20240614101032-60zwd12","Type":"NodeParagraph","Properties":{"id":"20240614101032-60zwd12","updated":"20240614101032"},"Children":[{"Type":"NodeText","Data":"有赤斑者，俗名络新妇，亦入方术用之。其余杂种，并不入药。《诗》云∶“ 蛸在户”。正谓此也。"}]},{"ID":"20240614101032-hm0xbf2","Type":"NodeParagraph","Properties":{"id":"20240614101032-hm0xbf2","updated":"20240614101032"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶疗小儿大疮中出丝，屡有死者。其网缠赘疣，七日消烂，有验矣。"}]},{"ID":"20240614100854-hgmlqhr","Type":"NodeThematicBreak","Properties":{"id":"20240614100854-hgmlqhr"}},{"ID":"20240614101020-k2cuug2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614101020-k2cuug2","updated":"20240614101026"},"Children":[{"Type":"NodeText","Data":"蜘蛛《长沙药解》"}]},{"ID":"20240614101020-zep86zw","Type":"NodeParagraph","Properties":{"id":"20240614101020-zep86zw","updated":"20240614101020"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614101020-iuniohh","Type":"NodeParagraph","Properties":{"id":"20240614101020-iuniohh","updated":"20240614101020"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，入足厥阴肝经。能消偏坠，善治狐疝。"}]},{"ID":"20240614101020-e4hcurw","Type":"NodeParagraph","Properties":{"id":"20240614101020-e4hcurw","updated":"20240614101020"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜘蛛散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蜘蛛十四枚，桂枝半两。为散，取八分匙，饮和。日再服。"},{"Type":"NodeText","Data":"治狐疝，偏坠有大小，时时上下。以水寒木陷，气郁为肿。出入无常，状如妖狐。蜘蛛破瘀而消肿，桂枝疏木而升陷也。"}]},{"ID":"20240614101020-6l9xasd","Type":"NodeParagraph","Properties":{"id":"20240614101020-6l9xasd","updated":"20240614101020"},"Children":[{"Type":"NodeText","Data":"炒枯存性，研细用。"}]},{"ID":"20240614100854-ijb8oiw","Type":"NodeThematicBreak","Properties":{"id":"20240614100854-ijb8oiw"}},{"ID":"20240614100906-mnkmdvc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100906-mnkmdvc","updated":"20240614101007"},"Children":[{"Type":"NodeText","Data":"蜘蛛《本草乘雅半偈》"}]},{"ID":"20240614100906-1hhol0b","Type":"NodeParagraph","Properties":{"id":"20240614100906-1hhol0b","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"（别录下品）"}]},{"ID":"20240614100906-697p10r","Type":"NodeParagraph","Properties":{"id":"20240614100906-697p10r","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"【气味】微寒，有小毒。"}]},{"ID":"20240614100906-brtuwwl","Type":"NodeParagraph","Properties":{"id":"20240614100906-brtuwwl","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"【主治】大人小儿 ，及小儿大腹丁奚，三年不能行者。"}]},{"ID":"20240614100906-8vjfm0a","Type":"NodeParagraph","Properties":{"id":"20240614100906-8vjfm0a","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"【核】曰∶蜘蛛，处处有之。色苍褐而斑，有棘毛，双眸巨口，六足大腹，爪牙锐利，啮人最毒，尿遗着人，遂作疮疡。腹下有细棱，丝从内放也。结网在人家檐角，篱头陋巷间，空中右绕作网，纶经二十有四，布纬七十有二，虫豸触着，即放丝捆扎细小，而后啖也。埤雅云∶蜘蛛结丝，以网飞虫，人之用计，安能过之，扫其网，置衣领中，令人知巧辟忘。入药唯用悬如鱼罾者，亦名 。赤斑者，名络新妇，入方术家用。余并不采取，种类甚多，大小颜色，亦不一也。尔雅但分蜘蛛、草、土，及 蛸四种。啮人甚毒，往往见于典籍。按刘禹锡传信方云∶判官张延赏，为斑蜘蛛咬颈上，一宿有二赤脉绕项下，至心前，头面肿如数斗，几至不救。一人以大蓝汁，入麝香、雄黄，取一蛛投入，随化为水，点咬处，两日愈。"}]},{"ID":"20240614100906-ppb1bug","Type":"NodeParagraph","Properties":{"id":"20240614100906-ppb1bug","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"贞元十年，崔从质员外，被蜘蛛咬，腹大如孕妇，僧教饮芋乳，数日而平。李绛兵部手集云∶蜘蛛咬人，遍身成疮，饮好酒至醉，则虫于肉中，似小米自出也。刘郁西域记云∶赤木儿城，有虫如蜘蛛，毒中人则烦渴，饮水立死，饮葡萄酒至醉，吐则解。元稹长庆集云∶巴中蜘蛛大而毒，甚者身运数寸， 长数倍，竹木被网皆死。中人，疮 、痛痒倍尝，惟以苦酒调雄黄涂之，仍用鼠负虫食其丝则愈。修治，火熬焦者良。"}]},{"ID":"20240614100906-re9bkmc","Type":"NodeParagraph","Properties":{"id":"20240614100906-re9bkmc","updated":"20240614100906"},"Children":[{"Type":"NodeText","Data":"【 】曰∶蜘蛛喷泄放丝，磨旋右转，结网以网飞虫，知物触而遂诛之，地以阳杀阴藏之谓乎。易曰∶结绳网罟，以佃以渔盖取诸离。象曰∶明两作离继明照于四方之火德欤，重门击柝，以待暴客，盖取诸豫。象曰∶雷出地奋，先王以作乐崇德，殷荐之上帝，以配祖考之木德欤，故圣人之作易也，仰观于天，俯察于地，而又观鸟兽之文，与地之宜，则所谓取才于物也。仲景两论，为方剂祖，蜘蛛辅木王之桂，曰蜘蛛散，主治阴狐疝，气偏有大小，时时上下，触突网募，乱作腹心者，尽诛之，卷束狂勃，剪灭不格也。陶隐居遵祖剂作别录，广治小儿三岁不能行。盖天道左旋，天以阳生阴长；地道右转，地以阳杀阴藏。地道也，坤道也，应地无疆，以顺天行之健。及小儿大腹疔，此高粱之变，洗除特易易耳。"}]},{"ID":"20240614100855-n802an6","Type":"NodeThematicBreak","Properties":{"id":"20240614100855-n802an6"}},{"ID":"20240614100856-3o190m1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100856-3o190m1","updated":"20240614100900"},"Children":[{"Type":"NodeText","Data":"蜘蛛《本草蒙筌》"}]},{"ID":"20240614100856-0od77ad","Type":"NodeParagraph","Properties":{"id":"20240614100856-0od77ad","updated":"20240614100856"},"Children":[{"Type":"NodeText","Data":"气微寒。有毒。品类极多，在处俱有。能牵丝网，巧不如蚕。凡入医方，须知选择。"}]},{"ID":"20240614100856-bmh4x1g","Type":"NodeParagraph","Properties":{"id":"20240614100856-bmh4x1g","updated":"20240614100856"},"Children":[{"Type":"NodeText","Data":"网布檐角者妙，腹大黑色者佳。收取无时，制服凭证。大人狐疝偏痛、睾丸或时上下者，宜研散调；小儿大腹丁奚、行步三年 蹶者，须煨熟啖。久疟寒热可断，干呕霍乱能驱。蛇虺咬捣汁涂，蜈蚣咬用活吸。疔肿作膏敷退，瘿核渍酒饮消。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"丝网"},{"Type":"NodeText","Data":"疗健忘，又能使人巧。"}]},{"ID":"20240614100856-a4kuqfh","Type":"NodeParagraph","Properties":{"id":"20240614100856-a4kuqfh","updated":"20240614100856"},"Children":[{"Type":"NodeText","Data":"七夕取食，方获奇功。系瘤赘烂消，缠痔 脱落。（此用花蜘蛛丝尤妙。）"}]},{"ID":"20240614100627-4ypw07h","Type":"NodeThematicBreak","Properties":{"id":"20240614100627-4ypw07h"}},{"ID":"20240614100821-ff20jbw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100821-ff20jbw","updated":"20240614100827"},"Children":[{"Type":"NodeText","Data":"蜘蛛《医学入门》"}]},{"ID":"20240614100821-bvoil1a","Type":"NodeParagraph","Properties":{"id":"20240614100821-bvoil1a","updated":"20240614100821"},"Children":[{"Type":"NodeText","Data":"蜘蛛寒毒敷诸疮，背疔瘰 卒脱肛，牙蛀口 腋下臭， 疝奚疳独可尝。"}]},{"ID":"20240614100821-d04i5yp","Type":"NodeParagraph","Properties":{"id":"20240614100821-d04i5yp","updated":"20240614100821"},"Children":[{"Type":"NodeText","Data":"有知觉，吐丝结网，飞虫触则诛之。发背疔疮，先挑四畔血出根露，捣烂醋和敷上，干即易之。瘰 ，无问有头无头，日干为末，酥调贴之。已有疮口出脓者，烧二七枚干糁。疣赘，取花蜘蛛丝于黄丹中养之，夜系旦落。卒脱肛及久泻脱肛疼痛，瓦合内烧存性，入黄丹少许为末，先用白矾汤洗净拭干，糁药软处，手掌托入。牙齿有孔，取壳一枚，绵裹按其内。中风口眼 僻，捣摩颊车上，候正即止。腋下狐臭，用盐泥、赤石脂为窠子，纳裹蜘蛛，烧为末，入轻粉一字，米醋调，临卧洗净腋下敷之，来早泻下恶汁恶物。以上皆外敷也。"}]},{"ID":"20240614100821-mzifzau","Type":"NodeParagraph","Properties":{"id":"20240614100821-mzifzau","updated":"20240614100821"},"Children":[{"Type":"NodeText","Data":"大人、小儿 疝，阴狐疝气，偏有大小，时时上下，小儿下奚疳，三年不能行，烧熟啖之或入丸服。有被毒蜂、蜈蚣咬者，生置痛处，令吸其毒，其蜘蛛醉死，以冷水浸之即活。蛇蝎咬，捣汁涂之。又七夕日取其网，置衣领中，疗喜忘。凡使，勿用五色者，要身小尻大，深灰色，腹内有苍黄脓，去头足，研膏用。然此物中人尤惨，惟饮羊乳可制其毒。若遗尿着人，令生疮癣。壁钱虫，似蜘蛛，在暗壁间作白幕如钱。无毒。主鼻衄及金疮下血不止，取虫汁点疮上及鼻中。亦疗外野鸡病下血。其钱幕主小儿吐逆，取二七煮汁饮之。"}]},{"ID":"20240614100627-u2ksy6y","Type":"NodeThematicBreak","Properties":{"id":"20240614100627-u2ksy6y"}},{"ID":"20240614100805-kbo114c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100805-kbo114c","updated":"20240614100815"},"Children":[{"Type":"NodeText","Data":"蜘蛛《证类本草》"}]},{"ID":"20240614100805-6mwveb0","Type":"NodeParagraph","Properties":{"id":"20240614100805-6mwveb0","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"微寒。主大人、小儿 。七月七日取其网，疗喜（音戏）忘。"}]},{"ID":"20240614100805-7l7dax4","Type":"NodeParagraph","Properties":{"id":"20240614100805-7l7dax4","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶蜘蛛类数十种，《尔雅》只载七、八种尔，今此用悬网状如鱼 者，亦名（章悦切） （音谋）。蜂及蜈蚣螫人，取置肉上，则能吸毒。又以断疟及干呕霍乱。术家取其网着衣领中辟忘。有赤斑者，俗名络新妇，亦入方∶术用之。其余杂种，并不入药。《诗》云∶（音萧）蛸（音鞘）在户，正谓此也。唐本注云∶《别录》云，疗小儿大腹疔奚，三年不能行者，又主蛇毒、温疟、霍乱，止呕逆。剑南、山东为此虫啮，疮中出丝，屡有死者。其网缠赘（之锐切）疣，七日消烂，有验矣。臣禹锡等谨按日华子云∶斑蜘蛛，冷，无毒。治疟疾，疔肿。网七夕朝取食，令人巧，去健忘。又云壁钱虫，平，微毒。治小儿吐逆，止鼻洪并疮。滴汁，敷鼻中及疮上，并敷 疮。是壁上作茧蜘蛛也。"}]},{"ID":"20240614100805-jz4ak59","Type":"NodeParagraph","Properties":{"id":"20240614100805-jz4ak59","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"图经曰∶蜘蛛，旧不着生出州郡，今处处有之。其类极多。《尔雅》云∶次蠹（音秋），蜘蛛（音与知朱字同）。蜘蛛，蛛蝥。郭璞云∶江东呼 （音 ）蝥者。又云∶土蜘蛛，在地布网者；草蜘蛛，络幕草上者； （音萧）蛸（音鞘）、长 ，小蜘蛛长脚者，俗呼为喜子。陶隐居云∶当用悬网状如鱼罾者，亦名 。则《尔雅》所为蛛蝥，郭璞所谓 蝥者是也。古方∶主蛇、蜂、蜈蚣毒及小儿大腹疔奚、赘疣。今人蛇啮者，涂其汁。小儿腹疳者，烧熟啖之。赘疣者，取其网丝缠之。蜂及蜈蚣毒者生置痛处，令吸其毒，皆有验。然此虫中人尤惨，惟饮羊乳汁可制其毒。出刘禹锡《传信方》云。张仲景治杂病方∶疗阴狐疝气，偏有大小，时时上下者，蜘蛛散主之。蜘蛛十四枚熬焦，桂半两，二物为散，每服八分一匕，日再。蜜丸，亦通。"}]},{"ID":"20240614100805-2pbs57t","Type":"NodeParagraph","Properties":{"id":"20240614100805-2pbs57t","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"雷公凡使，勿用五色者，兼大身上有刺毛生者，并薄小者，以上并不堪用。凡欲用，要在屋西面有网、身小尻大、腹内有苍黄脓者，真也。凡用，去头、足了，研如膏，投入药中用。"}]},{"ID":"20240614100805-nsjb8nl","Type":"NodeParagraph","Properties":{"id":"20240614100805-nsjb8nl","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"圣惠方治瘰 。无问有头、无头。用大蜘蛛五枚，晒干，细研，酥调如面脂，日两度贴之。"}]},{"ID":"20240614100805-o8k6l4h","Type":"NodeParagraph","Properties":{"id":"20240614100805-o8k6l4h","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"外台秘要崔氏治疣目。以蜘蛛网丝绕缠之，自落。千金方中风，口 僻。取蜘蛛子摩其偏急颊车上，候视正即止，亦可向火摩之。又方治背疮弥验方∶取户边蜘蛛，杵，以醋和。先挑四畔，令血出，根稍露，用药敷，干即易，旦至夜拔根出，大有神效。又方治鼠肿核痛，若已有疮口出脓水者。烧蜘蛛二七枚敷，良。又方治人心孔昏塞，多忘喜误。七月七日取蜘蛛网着领中，勿令人知，则永不忘也。又方卒脱肛，烧蜘蛛肚敷肛上。经验方孙真人《备急》治齿牙有孔。蜘蛛壳一枚，绵裹按其内。广利方治蝎螫人。研蜘蛛汁敷之，瘥。乘闲方治泻多时，脱肛疼痛。黑圣散大蜘蛛一个，瓠叶重裹线系定，合子内烧令黑色存性，取出细研，入黄丹少许，同研。凡有上件疾，先用白矾、葱、椒煎汤洗浴，拭干后，将药末糁在软处，帛上将手掌按托入收之，妙。谭氏方系指并赘瘤方以花蜘蛛网上大网丝，于黄丹中养之，系指与瘤，夜至旦自下。孙真人∶蜈蚣咬。取蜘蛛一枚，咬处安，当自饮毒，蜘蛛死，痛未止，更着生者。产宝方治产后咳逆，经三、五日不止。欲死方∶煎壁钱窠三、五个呷，瘥。"}]},{"ID":"20240614100805-rsau399","Type":"NodeParagraph","Properties":{"id":"20240614100805-rsau399","updated":"20240614100805"},"Children":[{"Type":"NodeText","Data":"衍义曰蜘蛛，品亦多，皆有毒，《经》不言用是何种。今人多用人家檐角、篱头、陋巷之间，空中作圆网。大腹、深灰色者，遗尿着人作疮癣。"}]},{"ID":"20240614100627-mbr1nh7","Type":"NodeThematicBreak","Properties":{"id":"20240614100627-mbr1nh7"}},{"ID":"20240614100640-zz1azdh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100640-zz1azdh","updated":"20240614100751"},"Children":[{"Type":"NodeText","Data":"蜘蛛《本草纲目》"}]},{"ID":"20240614100640-eo9b7ki","Type":"NodeParagraph","Properties":{"id":"20240614100640-eo9b7ki","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"「释名」次"}]},{"ID":"20240614100640-92mt4rr","Type":"NodeParagraph","Properties":{"id":"20240614100640-92mt4rr","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"「气味」微寒、有小毒。"}]},{"ID":"20240614100640-p6iderv","Type":"NodeParagraph","Properties":{"id":"20240614100640-p6iderv","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614100640-esw7gl8","Type":"NodeParagraph","Properties":{"id":"20240614100640-esw7gl8","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"1、婴儿口噤，不能吮乳，用蜘蛛一枚，去足，炙焦，研为末，加猪乳一合，和匀，分三次慢慢灌服。极效。"}]},{"ID":"20240614100640-badbo96","Type":"NodeParagraph","Properties":{"id":"20240614100640-badbo96","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"2、泄痢脱肛，用大蜘蛛一个，瓠叶两重，包扎定，烧存性，加黄丹少许，共研为末。先以白矾葱椒煎汤洗，揩干后，再以药末摊布上，把脱肠轻轻托上收进。"}]},{"ID":"20240614100640-3qikton","Type":"NodeParagraph","Properties":{"id":"20240614100640-3qikton","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"3、走马牙疳，出血用臭。用蜘蛛一枚、铜绿半钱、麝香少许，捣匀，擦患处。"}]},{"ID":"20240614100640-h08et03","Type":"NodeParagraph","Properties":{"id":"20240614100640-h08et03","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"4、颏下结核。用大蜘蛛不拘多少，好酒泡过，研烂，去渣，临卧时饮服。有效。"}]},{"ID":"20240614100640-i1tk1ra","Type":"NodeParagraph","Properties":{"id":"20240614100640-i1tk1ra","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"5、瘰疬结核。用大蜘蛛五枚，晒干，去足，研细，调油涂搽。一天二次。"}]},{"ID":"20240614100640-6e7imag","Type":"NodeParagraph","Properties":{"id":"20240614100640-6e7imag","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"6、疔肿拔根。用蜘蛛捣烂，和醋。先把疔肿四围挑出血令根稍露，然后敷药。干了就换，经一日夜，根即拔出。"}]},{"ID":"20240614100640-4b4z3rg","Type":"NodeParagraph","Properties":{"id":"20240614100640-4b4z3rg","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"7、虫、蛇、蜈蚣等咬伤。用蜘蛛研汁敷涂，有效。"}]},{"ID":"20240614100640-vidvley","Type":"NodeParagraph","Properties":{"id":"20240614100640-vidvley","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"8、一切恶疮。用蜘蛛晒干，研为还想，加轻粉、麻油涂搽。"}]},{"ID":"20240614100640-ukg7njb","Type":"NodeParagraph","Properties":{"id":"20240614100640-ukg7njb","updated":"20240614100640"},"Children":[{"Type":"NodeText","Data":"9、吐血。用蜘蛛风炒黄，研为末，酒送服。"}]},{"ID":"20240614100628-whmlvv9","Type":"NodeThematicBreak","Properties":{"id":"20240614100628-whmlvv9"}},{"ID":"20240614100629-yc53kab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100629-yc53kab","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：蜘蛛"}]},{"ID":"20240614100629-e2yrsqr","Type":"NodeParagraph","Properties":{"id":"20240614100629-e2yrsqr","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614100629-nseeo37","Type":"NodeParagraph","Properties":{"id":"20240614100629-nseeo37","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" Zhī Zhū"}]},{"ID":"20240614100629-s9dpnz2","Type":"NodeParagraph","Properties":{"id":"20240614100629-s9dpnz2","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614100629-gt4u486","Type":"NodeParagraph","Properties":{"id":"20240614100629-gt4u486","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 圆蛛、大腹圆网蛛、檐蛛、癞癞蛛、到麻[蒙名]"}]},{"ID":"20240614100629-sb7qp5a","Type":"NodeParagraph","Properties":{"id":"20240614100629-sb7qp5a","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614100629-j1f2289","Type":"NodeParagraph","Properties":{"id":"20240614100629-j1f2289","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 节肢动物门蛛形纲圆蛛科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大腹圆网蛛"},{"Type":"NodeText","Data":"Aranea ventricosa （L. Koch）；A. angulata，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"入药。夏、秋二季，捕捉后活用或用酒喷死或用开水烫死，晒干后备用。"}]},{"ID":"20240614100629-37vfvfp","Type":"NodeParagraph","Properties":{"id":"20240614100629-37vfvfp","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614100629-cr8line","Type":"NodeParagraph","Properties":{"id":"20240614100629-cr8line","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 全国各地。"}]},{"ID":"20240614100629-vbnc6w5","Type":"NodeParagraph","Properties":{"id":"20240614100629-vbnc6w5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614100629-jwmtgwu","Type":"NodeParagraph","Properties":{"id":"20240614100629-jwmtgwu","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 甘、微苦，微寒。"}]},{"ID":"20240614100629-fksbn2d","Type":"NodeParagraph","Properties":{"id":"20240614100629-fksbn2d","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614100629-1dkskej","Type":"NodeParagraph","Properties":{"id":"20240614100629-1dkskej","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 消炎，解毒，疗疮消瘰。主治瘰疬，疔疮，蜂蝎蛰伤。"}]},{"ID":"20240614100629-hqgzaxg","Type":"NodeParagraph","Properties":{"id":"20240614100629-hqgzaxg","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"治鼻瘜肉：蜘蛛、红糖各适量，共捣烂，涂鼻瘜肉上。"}]},{"ID":"20240614100629-0pim7m4","Type":"NodeParagraph","Properties":{"id":"20240614100629-0pim7m4","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"慢性睾丸炎，疝气：蜘蛛（新瓦焙黄）研粉，肉桂各1钱，每次0.5～1克，开水送服，日服2～3次。"}]},{"ID":"20240614100629-b327cwh","Type":"NodeParagraph","Properties":{"id":"20240614100629-b327cwh","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"小儿疳积：活蜘蛛1个，鸡蛋1个顶端打一小洞塞入蜘蛛，棉纸封固，再用黄泥包围，放入炭火中烧熟去泥，先服蜘蛛，后服鸡蛋，每3天服一个。"}]},{"ID":"20240614100629-we5qh2i","Type":"NodeParagraph","Properties":{"id":"20240614100629-we5qh2i","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"淋巴结核：活蜘蛛、活蜈蚣各数只，菜油浸泡20余天，外擦患处。"}]},{"ID":"20240614100629-aknemsd","Type":"NodeParagraph","Properties":{"id":"20240614100629-aknemsd","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"癣：活蜘蛛压破，涂患处。"}]},{"ID":"20240614100629-voj946c","Type":"NodeParagraph","Properties":{"id":"20240614100629-voj946c","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"狐臭：活蜘蛛数只，黄泥包，烧存性去泥研粉，加入密陀僧或轻粉适量，扑擦腋部，每日2～3次。"}]},{"ID":"20240614100629-5ijn9ht","Type":"NodeParagraph","Properties":{"id":"20240614100629-5ijn9ht","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614100629-u6ag913","Type":"NodeParagraph","Properties":{"id":"20240614100629-u6ag913","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614100629-ah6dfcg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100629-ah6dfcg","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蜘蛛"}]},{"ID":"20240614100629-7ftjlsj","Type":"NodeParagraph","Properties":{"id":"20240614100629-7ftjlsj","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614100629-lxsnwal","Type":"NodeParagraph","Properties":{"id":"20240614100629-lxsnwal","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" Zhī Zhū"}]},{"ID":"20240614100629-9fy2uy0","Type":"NodeParagraph","Properties":{"id":"20240614100629-9fy2uy0","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614100629-l3wj8oo","Type":"NodeParagraph","Properties":{"id":"20240614100629-l3wj8oo","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 次蟗、蛛蝥（《尔雅》），蠾蝓、蝳蜍（《方言》），网工（《广雅》），缀蝥（《尔雅》郭璞注），社公（《方言》郭璞解），蚰蟱（《别录》），网虫、扁蛛（《现代实用中药》），圆蛛、癞癞蛛、蛛蛛、到麻（《吉林中草药》）。"}]},{"ID":"20240614100629-iab4tu9","Type":"NodeParagraph","Properties":{"id":"20240614100629-iab4tu9","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614100629-250a78a","Type":"NodeParagraph","Properties":{"id":"20240614100629-250a78a","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240614100629-yrrw7dr","Type":"NodeParagraph","Properties":{"id":"20240614100629-yrrw7dr","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614100629-r1jd2al","Type":"NodeParagraph","Properties":{"id":"20240614100629-r1jd2al","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 为圆网蛛科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大腹圆网蛛"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"。夏、秋间捕捉，入沸水烫死，取出，晒干或烘干。"}]},{"ID":"20240614100629-2rczyqx","Type":"NodeParagraph","Properties":{"id":"20240614100629-2rczyqx","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614100629-ahdd6od","Type":"NodeParagraph","Properties":{"id":"20240614100629-ahdd6od","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 大部地区均有分布。"}]},{"ID":"20240614100629-jk6wle5","Type":"NodeParagraph","Properties":{"id":"20240614100629-jk6wle5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614100629-2m7d9pt","Type":"NodeParagraph","Properties":{"id":"20240614100629-2m7d9pt","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 体圆形或椭圆形，头胸部被有背甲1枚，无分节状态。口小，适于吮吸；单眼4对，位于头胸部背面的前端参差排列。下有附肢6对；第1对为钳角，似大颚，呈单螯状，内通毒腺；第2对为脚须，似触角，在雄性则末端膨大成交配器；其它4对均为步足，各由7节组成，其跗节末端有钩爪2枚，中间丛生细毛，有吸附作用。腹部圆大而软，与头胸部相连处，缢缩成细腰；前腹面中央有生殖孔，并有生殖板覆盖；其两侧有肺囊的气孔1对；后腹面有时有气管的气孔1对或台而为一；腹面后端有肛门；其前方有疣状的小突起3对，即纺锤突，尖端有孔，内通纺绩腺，能分泌一种粘液，凝结成丝而结网。"}]},{"ID":"20240614100629-66w6ytj","Type":"NodeParagraph","Properties":{"id":"20240614100629-66w6ytj","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"大多营单独生活，夜间则活跃，通常结网于树间、檐下、屋角等处，兜捕其他小虫为食，也吃其他蜘蛛。"}]},{"ID":"20240614100629-tqda7ns","Type":"NodeParagraph","Properties":{"id":"20240614100629-tqda7ns","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"本动物的蜕壳（蜘蛛蜕壳）、网丝（蜘蛛网）亦供药用，各详专条。"}]},{"ID":"20240614100629-4p6jlqo","Type":"NodeParagraph","Properties":{"id":"20240614100629-4p6jlqo","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614100629-fbq4ncs","Type":"NodeParagraph","Properties":{"id":"20240614100629-fbq4ncs","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" ①《雷公炮炙论》：\"凡用（蜘蛛）去头足了，研如膏，投入药中用。\""}]},{"ID":"20240614100629-df8lc9g","Type":"NodeParagraph","Properties":{"id":"20240614100629-df8lc9g","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"②《长沙药解》：\"炒枯存性研细用。\""}]},{"ID":"20240614100629-6jig21v","Type":"NodeParagraph","Properties":{"id":"20240614100629-6jig21v","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614100629-1mnlt7l","Type":"NodeParagraph","Properties":{"id":"20240614100629-1mnlt7l","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《长沙药解》：\"入足厥阴肝经。\""}]},{"ID":"20240614100629-w76g9vd","Type":"NodeParagraph","Properties":{"id":"20240614100629-w76g9vd","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614100629-kffzsgd","Type":"NodeParagraph","Properties":{"id":"20240614100629-kffzsgd","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 苦，寒，有毒。"}]},{"ID":"20240614100629-d8tzr67","Type":"NodeParagraph","Properties":{"id":"20240614100629-d8tzr67","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微寒。\""}]},{"ID":"20240614100629-s15lqf0","Type":"NodeParagraph","Properties":{"id":"20240614100629-s15lqf0","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"冷，无毒。\""}]},{"ID":"20240614100629-v2wipu2","Type":"NodeParagraph","Properties":{"id":"20240614100629-v2wipu2","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"性微寒，有毒。\""}]},{"ID":"20240614100629-s7ov1dv","Type":"NodeParagraph","Properties":{"id":"20240614100629-s7ov1dv","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614100629-pg0554g","Type":"NodeParagraph","Properties":{"id":"20240614100629-pg0554g","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《日华子本草》：\"畏蔓青、雄黄。\""}]},{"ID":"20240614100629-me8z5cc","Type":"NodeParagraph","Properties":{"id":"20240614100629-me8z5cc","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614100629-cph7xx9","Type":"NodeParagraph","Properties":{"id":"20240614100629-cph7xx9","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 祛风，消肿，解毒。治狐疝偏坠，中风口歪，小儿慢惊、口噤，疳积；疔肿，瘰疬，疮疡，蜈蚣、蜂、蝎螫伤。"}]},{"ID":"20240614100629-i7swnev","Type":"NodeParagraph","Properties":{"id":"20240614100629-i7swnev","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主大人小儿癀。\"\"疗小儿大腹丁奚三年不能行者。\""}]},{"ID":"20240614100629-ex2dfbx","Type":"NodeParagraph","Properties":{"id":"20240614100629-ex2dfbx","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"蜂及蜈蚣螫人，取置肉上，则能吸毒。又以断疟及干呕、霍乱。\""}]},{"ID":"20240614100629-o9cmoit","Type":"NodeParagraph","Properties":{"id":"20240614100629-o9cmoit","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"主蛇毒，温疟，霍乱，止呕逆。\""}]},{"ID":"20240614100629-8z20ulh","Type":"NodeParagraph","Properties":{"id":"20240614100629-8z20ulh","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"斑蜘蛛治疟疾，疔肿。\""}]},{"ID":"20240614100629-efjxd6j","Type":"NodeParagraph","Properties":{"id":"20240614100629-efjxd6j","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑤《本草图经》：\"蛇啮者涂其汁，小儿腹疳者，烧熟啖之。\""}]},{"ID":"20240614100629-prn0k6b","Type":"NodeParagraph","Properties":{"id":"20240614100629-prn0k6b","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"主口歪，脱肛，疔肿，胡臭，齿匿。\""}]},{"ID":"20240614100629-ya39sb5","Type":"NodeParagraph","Properties":{"id":"20240614100629-ya39sb5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑦《长沙药解》：\"破瘀消肿。\""}]},{"ID":"20240614100629-pvxqakr","Type":"NodeParagraph","Properties":{"id":"20240614100629-pvxqakr","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑧《本草求原》：\"治红云血癣。\""}]},{"ID":"20240614100629-ka531tx","Type":"NodeParagraph","Properties":{"id":"20240614100629-ka531tx","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑨《吉林中草药》：\"治瘰疬，疔疮，蜂、蝎螫伤。\""}]},{"ID":"20240614100629-uyx7bki","Type":"NodeParagraph","Properties":{"id":"20240614100629-uyx7bki","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614100629-r3b3m2r","Type":"NodeParagraph","Properties":{"id":"20240614100629-r3b3m2r","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散。外用：焙干研末撒、捣汁涂或调敷。"}]},{"ID":"20240614100629-kt4pjbr","Type":"NodeParagraph","Properties":{"id":"20240614100629-kt4pjbr","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614100629-no83pa9","Type":"NodeParagraph","Properties":{"id":"20240614100629-no83pa9","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" ①治阴狐疝气，偏有大小，时时上下：蜘蛛十四枚（熬焦），桂枝半两。共为散。取八分之一匕，饮和服，日再服。蜜丸亦可。（《金匮要略》蜘蛛散）"}]},{"ID":"20240614100629-u7ho4eb","Type":"NodeParagraph","Properties":{"id":"20240614100629-u7ho4eb","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"②治中风口歪僻：蜘蛛摩其偏急颊车上，候视正即止。亦可向火摩之。（《千金方》）"}]},{"ID":"20240614100629-klbbptx","Type":"NodeParagraph","Properties":{"id":"20240614100629-klbbptx","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"③治小儿慢脾风，初起寒热如疟，面黄肌瘦，啼声如猫吼：蜘蛛去头足，专用肚，火焙研末，每二分，配朱砂一分，共三分，为周岁内一次量，一岁以上者加倍，以白芥子煎汤送服。（《泉州本草》）"}]},{"ID":"20240614100629-17vhp8w","Type":"NodeParagraph","Properties":{"id":"20240614100629-17vhp8w","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"④初生儿口噤不开，不收乳：干蜘蛛一个（去足，口），新竹沥浸一宿，炙焦为末，干蝎梢七个（为末），腻粉一钱，同研匀，每服一字，乳汁调，时时滴儿口中。（《小儿卫生总微论方》立圣散）"}]},{"ID":"20240614100629-m47t0m3","Type":"NodeParagraph","Properties":{"id":"20240614100629-m47t0m3","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑤治疔毒：蜘蛛（去头），和乌糖捣烂贴患处。和酸饭粒及食盐捣贴亦可。（《泉州本草》）"}]},{"ID":"20240614100629-fr2cy3t","Type":"NodeParagraph","Properties":{"id":"20240614100629-fr2cy3t","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑥治瘰疬，无问有头无头：大蜘蛛五枚。晒干，细研，以酥调如血脂，每日两度贴之。（《圣惠方》）"}]},{"ID":"20240614100629-7tvpset","Type":"NodeParagraph","Properties":{"id":"20240614100629-7tvpset","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑦治颏下结核：大蜘蛛不拘多少。好酒浸过，同研烂，澄去滓，临卧时服之。（《医林集要》）"}]},{"ID":"20240614100629-5mdfkai","Type":"NodeParagraph","Properties":{"id":"20240614100629-5mdfkai","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑧治鼠瘘肿核痛，已有疮口出脓水者：蜘蛛二七枚。烧，敷之良。（《千金方》）"}]},{"ID":"20240614100629-6ciobdl","Type":"NodeParagraph","Properties":{"id":"20240614100629-6ciobdl","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑨治背疮：蜘蛛杵烂，醋和，先挑疮四畔令出血，根稍露，用药敷，干即易。（《千金方》）"}]},{"ID":"20240614100629-jyjhfzn","Type":"NodeParagraph","Properties":{"id":"20240614100629-jyjhfzn","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑩治走马牙疳，出血作臭：蜘蛛一枚，铜绿半钱，麝香少许。杵匀擦之。（《仁斋宜指方》）"}]},{"ID":"20240614100629-rh311l5","Type":"NodeParagraph","Properties":{"id":"20240614100629-rh311l5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑾治聤耳出脓：蜘蛛一个，胭脂胚子半钱，麝香一字。为末。用鹅翎吹之。（《纲目》）"}]},{"ID":"20240614100629-de3tanl","Type":"NodeParagraph","Properties":{"id":"20240614100629-de3tanl","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⑿治便毒初起：大黑蜘蛛一枚。研烂，热酒一碗，搅服，不退再服。（《寿域神方》）"}]},{"ID":"20240614100629-mb9c3r4","Type":"NodeParagraph","Properties":{"id":"20240614100629-mb9c3r4","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⒀治吹奶疼痛：蜘蛛一枚。面裹烧存性，为末。酒服。（《纲目》）"}]},{"ID":"20240614100629-siljncd","Type":"NodeParagraph","Properties":{"id":"20240614100629-siljncd","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⒁治恶疮：蜘蛛晒干，研末，入轻粉，麻油调涂。（《仁斋直指方》）"}]},{"ID":"20240614100629-dg3m0gf","Type":"NodeParagraph","Properties":{"id":"20240614100629-dg3m0gf","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⒂治鼻息肉：蜘蛛、红糖适量。共捣烂，涂鼻息肉上。（《吉林中草药》）"}]},{"ID":"20240614100629-69n0ugv","Type":"NodeParagraph","Properties":{"id":"20240614100629-69n0ugv","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⒃治蝎蟹人：蜘蛛研汁，敷之。（《广利方》）"}]},{"ID":"20240614100629-3o4yayq","Type":"NodeParagraph","Properties":{"id":"20240614100629-3o4yayq","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"⒄治卒脱肛：烧蜘蛛为灰末，敷肛。（《普济方》）"}]},{"ID":"20240614100629-cayof4e","Type":"NodeParagraph","Properties":{"id":"20240614100629-cayof4e","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614100629-vsnh91w","Type":"NodeParagraph","Properties":{"id":"20240614100629-vsnh91w","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614100629-roriwgv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614100629-roriwgv","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蜘蛛"}]},{"ID":"20240614100629-c48z20k","Type":"NodeParagraph","Properties":{"id":"20240614100629-c48z20k","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614100629-t9gbtmt","Type":"NodeParagraph","Properties":{"id":"20240614100629-t9gbtmt","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" Zhī Zhū"}]},{"ID":"20240614100629-pekna1q","Type":"NodeParagraph","Properties":{"id":"20240614100629-pekna1q","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614100629-dvlx8ev","Type":"NodeParagraph","Properties":{"id":"20240614100629-dvlx8ev","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 次蠹、蛛蝥、蠾 螋、蝳蜍、网工、蝃蝥、社公、网虫、扁蛛、圆蛛、癞癞蛛、蛛蛛、"}]},{"ID":"20240614100629-wuxxbti","Type":"NodeParagraph","Properties":{"id":"20240614100629-wuxxbti","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614100629-i7yz7h5","Type":"NodeParagraph","Properties":{"id":"20240614100629-i7yz7h5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" Spider"}]},{"ID":"20240614100629-07f3far","Type":"NodeParagraph","Properties":{"id":"20240614100629-07f3far","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614100629-msmp1da","Type":"NodeParagraph","Properties":{"id":"20240614100629-msmp1da","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 1.出自《雷公炮炙论》：凡使(蜘蛛)，勿用五色者，兼大身上有刺毛生者，薄小者，并不堪用。凡欲用，有网，身小尻大，腹内有苍黄脓者真也。"}]},{"ID":"20240614100629-idfj7ig","Type":"NodeParagraph","Properties":{"id":"20240614100629-idfj7ig","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：蜘蛛类数十种，《尔雅》止载七、八种尔。今此用悬网状如鱼罾者，有赤斑者俗名络新妇，亦用之。其余杂种，并不入药，3.《本草衍义》：蜘蛛品亦多，皆有毒，《经》不言用是何种。今人多用人家檐角、篱头、陋巷之间，空中作圆网，大腹，深灰色者。遗尿着人作疮癣。"}]},{"ID":"20240614100629-i97llgb","Type":"NodeParagraph","Properties":{"id":"20240614100629-i97llgb","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614100629-6gibba9","Type":"NodeParagraph","Properties":{"id":"20240614100629-6gibba9","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 药材基源：为圆蛛科动物大腹圆蛛的全体。"}]},{"ID":"20240614100629-koswd0g","Type":"NodeParagraph","Properties":{"id":"20240614100629-koswd0g","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Aranea ventricosa (L. Koch)"}]},{"ID":"20240614100629-bw96g8s","Type":"NodeParagraph","Properties":{"id":"20240614100629-bw96g8s","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季捕捉，入沸水烫死，晒干或烘干。"}]},{"ID":"20240614100629-dlcmdxn","Type":"NodeParagraph","Properties":{"id":"20240614100629-dlcmdxn","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614100629-3y9d5ad","Type":"NodeParagraph","Properties":{"id":"20240614100629-3y9d5ad","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 生态环境：多栖息于屋檐、墙角和树间，结车轮状网，傍晚及夜间活动，以昆虫为食。"}]},{"ID":"20240614100629-xtb6myo","Type":"NodeParagraph","Properties":{"id":"20240614100629-xtb6myo","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"资源分布：遍布于我国各地，是最常见的蜘蛛。"}]},{"ID":"20240614100629-d0agucm","Type":"NodeParagraph","Properties":{"id":"20240614100629-d0agucm","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614100629-i217v98","Type":"NodeParagraph","Properties":{"id":"20240614100629-i217v98","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 大腹圆蛛，雌性体长约30mm，雄性约15mm。头胸部短于腹部，皆黑褐色。头胸部梨形，扁平，有小白毛，8眼分聚于3归丘，前缘中央眼丘上有4眼，两侧眼丘各2眼。螯肢强壮，有7枚小齿。步足强大，多刺，肯深色环带。腹部近圆表而较大，肩部隆起，背面中央有清晰的叶状斑带，沿中线有8对细小圆斑。腹部有1对白斑。生殖大厣黑色，呈舌状体，纺缍形。"}]},{"ID":"20240614100629-ry5d627","Type":"NodeParagraph","Properties":{"id":"20240614100629-ry5d627","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614100629-w0lfkci","Type":"NodeParagraph","Properties":{"id":"20240614100629-w0lfkci","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，全体呈圆形或椭圆形，头胸部赤褐色，边缘黑色。腹部黄褐色，有明显的黑色叶状斑纹，有2对黑以的肌斑。腹部前端中央有黄以或红色斑点，腹部下面灰黄色。纺器黑褐色。步足黄褐色或黑褐色，有赤褐色或黑褐色环纹，附肢6对，常残缺。体轻，质脆。气微，味微苦、咸。"}]},{"ID":"20240614100629-m4krbhf","Type":"NodeParagraph","Properties":{"id":"20240614100629-m4krbhf","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614100629-v1i3yuo","Type":"NodeParagraph","Properties":{"id":"20240614100629-v1i3yuo","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》：“凡用，去头，足了，研如膏，投入药中用。”《圣惠方》：“去足及口，炙令焦，细研。”现行，取原药材，除去杂质。"}]},{"ID":"20240614100629-frogtua","Type":"NodeParagraph","Properties":{"id":"20240614100629-frogtua","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614100629-w32p3hs","Type":"NodeParagraph","Properties":{"id":"20240614100629-w32p3hs","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240614100629-552jhn5","Type":"NodeParagraph","Properties":{"id":"20240614100629-552jhn5","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614100629-nfagluh","Type":"NodeParagraph","Properties":{"id":"20240614100629-nfagluh","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒；有毒"}]},{"ID":"20240614100629-iqyirn3","Type":"NodeParagraph","Properties":{"id":"20240614100629-iqyirn3","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614100629-5mam1pp","Type":"NodeParagraph","Properties":{"id":"20240614100629-5mam1pp","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：“蜘蛛遗尿着人作疮癣。”2.《纲目》：“被蜘蛛咬，腹大如孕妇。饮羊乳数日而平。””"}]},{"ID":"20240614100629-hslhqz9","Type":"NodeParagraph","Properties":{"id":"20240614100629-hslhqz9","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614100629-g9o68wz","Type":"NodeParagraph","Properties":{"id":"20240614100629-g9o68wz","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 祛风；消肿；解毒；散结。主狐疝偏坠，中风口；小儿慢惊；口噤；疳积；喉风肿闭；牙疳；聤耳；痈肿疔毒；瘰疬；恶疮；痔漏；脱肛；蛇虫咬伤"}]},{"ID":"20240614100629-fniopbm","Type":"NodeParagraph","Properties":{"id":"20240614100629-fniopbm","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614100629-458x3zg","Type":"NodeParagraph","Properties":{"id":"20240614100629-458x3zg","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 内服：研末，0.3-1g；浸酒或入丸、散。不入汤剂。外用：适量，捣敷、绞汁涂；研末撒或调敷。"}]},{"ID":"20240614100629-jiiho0u","Type":"NodeParagraph","Properties":{"id":"20240614100629-jiiho0u","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614100629-v30qiy7","Type":"NodeParagraph","Properties":{"id":"20240614100629-v30qiy7","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" ①治阴狐疝气，偏有大小，时时上下：蜘蛛十四枚(熬焦)，桂枝半两。共为散。取八分之一匕，饮和服，日再服。蜜丸亦可。(《金匮要略》蜘蛛散)②治中风口歪僻：蜘蛛摩其偏急颊车上，候视正即止。亦可向火摩之。(《千金方》)③治小儿慢脾风，初起寒热如疟，面黄肌瘦，啼声如猫吼：蜘蛛去头足，专用肚，火焙研末，每二分，配朱砂一分，共三分，为周岁内一次量，一岁以上者加倍，以白芥子煎汤送服。(《泉州本草》)④初生儿口噤不开，不收乳：干蜘蛛一个(去足，口)，新竹沥浸一宿，炙焦为末，干蝎梢七个(为末)，腻粉一钱。同研匀，每服一字，乳汁调，时时滴儿口中。(《小儿卫生总微论方》立圣散)⑤治疔毒：蜘蛛(去头)，和乌糖捣烂贴患处。和酸饭粒及食盐捣贴亦可。(《泉州本草》)⑥治瘰疬，无问有头无头：大蜘蛛五枚。晒干，细研，以酥调如面脂，每日两度贴之。(《圣惠方》)⑦治颏下结核：大蜘蛛不拘多少。好酒浸过，同研烂，澄去滓，临卧时服之。(《医林集要》)⑧治鼠瘘肿核痛，已有疮口出脓水者：蜘蛛二七枚。烧，敷之良。(《千金方》)⑨治背疮：蜘蛛杵烂，醋和，先挑疮四畔令出血，根稍露，用药敷，干即易。(《千金方》)⑩治走马牙疳，出血作臭：蜘蛛一枚，铜绿半钱，麝香少许。杵匀擦之。(《仁斋直指方》)(11)治盯耳出脓：蜘蛛一个，脑脂胚子半钱，麝香一字。为末。用鹅翎吹之。(《纲目》)(12)治便毒初起：大黑蜘蛛一枚。研烂，热酒一碗，搅服，不退再服。(《寿域神方》)(13)治吹奶疼痛：蜘蛛一枚。面裹烧存性，为末。酒服。(《纲目》)(14)治恶疮：蜘蛛晒干，研末，入轻粉，麻油调涂。(《仁斋直指方》)(15)治鼻息肉：蜘蛛、红糖适量。共捣烂，涂鼻息肉上。(《吉林中草药》)(16)治蝎螫人：蜘蛛研汁，敷之。(《广利方》)(17)治卒脱肛：烧蜘蛛为灰末，敷肛。(《普济方》)"}]},{"ID":"20240614100629-gtgh69d","Type":"NodeParagraph","Properties":{"id":"20240614100629-gtgh69d","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614100629-mesexzx","Type":"NodeParagraph","Properties":{"id":"20240614100629-mesexzx","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 1.《别录》：主大人小儿溃。疗小儿大腹丁奚三年不能行者。"}]},{"ID":"20240614100629-weu3yt4","Type":"NodeParagraph","Properties":{"id":"20240614100629-weu3yt4","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：蜂及蜈蚣螫人，取置肉上，则能吸毒。又以断疟及干呕、霍乱。"}]},{"ID":"20240614100629-7vf1lu8","Type":"NodeParagraph","Properties":{"id":"20240614100629-7vf1lu8","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：主蛇毒，温疟，霍乱，止呕逆。"}]},{"ID":"20240614100629-pr6xwcr","Type":"NodeParagraph","Properties":{"id":"20240614100629-pr6xwcr","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：斑蜘蛛治疟疾，疔肿。"}]},{"ID":"20240614100629-zgxibk0","Type":"NodeParagraph","Properties":{"id":"20240614100629-zgxibk0","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：蛇啮者涂其汁；小儿腹疳者，烧熟啖。"}]},{"ID":"20240614100629-x9upcg8","Type":"NodeParagraph","Properties":{"id":"20240614100629-x9upcg8","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：主口喝，脱肛，疔肿，胡臭。"}]},{"ID":"20240614100629-24c3p6r","Type":"NodeParagraph","Properties":{"id":"20240614100629-24c3p6r","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"7.《长沙药解》：破瘀消肿。"}]},{"ID":"20240614100629-aqy0rih","Type":"NodeParagraph","Properties":{"id":"20240614100629-aqy0rih","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"8.《本草求原》：治红云血癣。"}]},{"ID":"20240614100629-b6zcxps","Type":"NodeParagraph","Properties":{"id":"20240614100629-b6zcxps","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"9.《吉林中草药》：治瘰疬，疔疮，蜂、蝎螫伤。"}]},{"ID":"20240614100629-6d66s8y","Type":"NodeParagraph","Properties":{"id":"20240614100629-6d66s8y","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614100629-uyz16dp","Type":"NodeParagraph","Properties":{"id":"20240614100629-uyz16dp","updated":"20240614100629"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614100631-fiwtd9q","Type":"NodeThematicBreak","Properties":{"id":"20240614100631-fiwtd9q"}},{"ID":"20240614100632-wmz54id","Type":"NodeParagraph","Properties":{"id":"20240614100632-wmz54id"}}]}