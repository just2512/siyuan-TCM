03190729-n60mneu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 577px;\" parent-style=\"width: 587px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703185951-20m0zhu","Type":"NodeParagraph","Properties":{"id":"20240703185951-20m0zhu","updated":"20240703190838"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 658px;","style":"width: 648px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水芹辨别5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水芹辨别5-20240703190826-si23r0m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 648px;\" parent-style=\"width: 658px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614092336-l8unj4t","Type":"NodeThematicBreak","Properties":{"id":"20240614092336-l8unj4t"}},{"ID":"20240614092347-tcqduph","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092347-tcqduph","updated":"20240614092454"},"Children":[{"Type":"NodeText","Data":"水靳《神农本草经》"}]},{"ID":"20240614092347-avyyecg","Type":"NodeParagraph","Properties":{"id":"20240614092347-avyyecg","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240614092347-9kjq0c8","Type":"NodeParagraph","Properties":{"id":"20240614092347-9kjq0c8","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"主女子赤沃，止血养精，保血脉，益气，令人肥健，嗜食。一名水英，生池泽。"}]},{"ID":"20240614092347-apr7zi2","Type":"NodeParagraph","Properties":{"id":"20240614092347-apr7zi2","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生南海。"}]},{"ID":"20240614092347-jfix7f2","Type":"NodeParagraph","Properties":{"id":"20240614092347-jfix7f2","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"案《说文》云：芹，楚葵也，近菜类也。《周礼》有近菹。《尔雅》云：芹，楚葵。"}]},{"ID":"20240614092347-vknqrbk","Type":"NodeParagraph","Properties":{"id":"20240614092347-vknqrbk","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"郭璞云：今水中芹菜。字林云：芹草生水中。根可缘器，又云荶菜，似蒜，生水中。"}]},{"ID":"20240614092347-42hsvlt","Type":"NodeParagraph","Properties":{"id":"20240614092347-42hsvlt","updated":"20240614092347"},"Children":[{"Type":"NodeText","Data":"上菜，下品二种，旧同。"}]},{"ID":"20240614093005-a09bwb6","Type":"NodeThematicBreak","Properties":{"id":"20240614093005-a09bwb6"}},{"ID":"20240614093006-9nkkxrp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614093006-9nkkxrp","updated":"20240614093010"},"Children":[{"Type":"NodeText","Data":"水芹《本经逢原》"}]},{"ID":"20240614093006-8uoqccj","Type":"NodeParagraph","Properties":{"id":"20240614093006-8uoqccj","updated":"20240614093006"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名水芹"}]},{"ID":"20240614093006-3xu9mtn","Type":"NodeParagraph","Properties":{"id":"20240614093006-3xu9mtn","updated":"20240614093006"},"Children":[{"Type":"NodeText","Data":"甘微辛，小毒。"}]},{"ID":"20240614093006-mpr1duy","Type":"NodeParagraph","Properties":{"id":"20240614093006-mpr1duy","updated":"20240614093006"},"Children":[{"Type":"NodeText","Data":"《本经》云∶女子赤沃下血，养精保血脉益气，令人肥健，嗜食。"}]},{"ID":"20240614093006-twqxtup","Type":"NodeParagraph","Properties":{"id":"20240614093006-twqxtup","updated":"20240614093006"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"按∶ 有两种，一种生平田者，曰旱 ，禀青阳之气而生，气味辛窜。能清理胃中浊湿，故《本经》主女子赤沃，浊湿去则胃气清纯，而精血有赖，令人肥健嗜食。一种生陂泽者，曰水 。得湿淫之气而生，气味辛浊。有虫子在叶间视之不见，食之令人为患，面青手青腹满如妊，痛不可忍，作蛟龙病，但服硬饧二三升，吐出便瘥，大抵是蛇虺之毒尔。"}]},{"ID":"20240614093006-maajbis","Type":"NodeParagraph","Properties":{"id":"20240614093006-maajbis","updated":"20240614093006"},"Children":[{"Type":"NodeText","Data":"其根白，盈尺者曰马 ，食之令人发疮疥，以其湿热之气最盛也。和醋食之损齿，有鳖瘕人不可食。"}]},{"ID":"20240614092956-sroc0ii","Type":"NodeThematicBreak","Properties":{"id":"20240614092956-sroc0ii"}},{"ID":"20240614092957-6oshf6u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092957-6oshf6u","updated":"20240614093001"},"Children":[{"Type":"NodeText","Data":"芹菜《本草求真》"}]},{"ID":"20240614092957-8t3sff9","Type":"NodeParagraph","Properties":{"id":"20240614092957-8t3sff9","updated":"20240614092957"},"Children":[{"Type":"NodeText","Data":"（荤辛）芹菜辛多于苦则能以治寒湿 苦多于辛则能以治热毒"}]},{"ID":"20240614092957-b99ptkz","Type":"NodeParagraph","Properties":{"id":"20240614092957-b99ptkz","updated":"20240614092957"},"Children":[{"Type":"NodeText","Data":"芹菜（专入肺胃肝）。地出。有水有旱。其味有苦有甘。有辛有酸之类。考之张璐有言。旱芹得青阳之气而生。气味辛窜。能理胃中湿浊。水芹得湿淫之气而生。气味辛浊。考之纲目有言。旱芹气味甘寒。能除心下烦热。水芹气味甘平。能治女子赤沃。两说绝不相类。讵知旱芹种类。或有得于阳气之浓。故味多辛而燥。得于阳气之微。故味苦而多湿。水芹种类。得于阳气之最。则气虽浊而仍清。得于阴气之胜。则味既苦而且浊。不得谓水芹尽属阴类。旱芹尽属阳类也。惟察辛多于苦。则芹多燥而不凉。苦胜于辛。则芹多寒而不温。辛胜于苦。则治当如本经所云。能治女子赤沃。俾浊湿去。胃气清。而精血有赖。令人肥健嗜食。苦胜于辛。及质粘滑。则治当如唐本所云。能治痈肿马毒。又安能入脾以助食。入阴以助精。入肝以保血乎！但芹在水。须防有虫在于叶间。（春夏之交。多有蜥蝎虺蛇在于此处遗精。）"}]},{"ID":"20240614092957-6b3uftq","Type":"NodeParagraph","Properties":{"id":"20240614092957-6b3uftq","updated":"20240614092957"},"Children":[{"Type":"NodeText","Data":"视之不见。令人为患面青手青。腹满如妊。痛不可忍。作蛟龙痛。须服硬饧二三斤。吐出便瘥。其根白盈尺者曰马 。食之令人发疮疥。以其湿热之气最盛也。和醋食之损齿。有鳖瘕人不可食。"}]},{"ID":"20240614092942-d6wfqvt","Type":"NodeThematicBreak","Properties":{"id":"20240614092942-d6wfqvt"}},{"ID":"20240614092943-cel1h80","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092943-cel1h80","updated":"20240614092948"},"Children":[{"Type":"NodeText","Data":"水芹《药性切用》"}]},{"ID":"20240614092943-lsi4nqc","Type":"NodeParagraph","Properties":{"id":"20240614092943-lsi4nqc","updated":"20240614092943"},"Children":[{"Type":"NodeText","Data":"性味甘凉，去热除风，利口齿及大小肠。可充菜蔬，腌熟醋拌食。"}]},{"ID":"20240614092933-928ip8z","Type":"NodeThematicBreak","Properties":{"id":"20240614092933-928ip8z"}},{"ID":"20240614092935-0jvzxo9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092935-0jvzxo9","updated":"20240614092938"},"Children":[{"Type":"NodeText","Data":"水芹《本草从新》"}]},{"ID":"20240614092935-xz7afog","Type":"NodeParagraph","Properties":{"id":"20240614092935-xz7afog","updated":"20240614092935"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、去伏热．"}]},{"ID":"20240614092935-a0znnqr","Type":"NodeParagraph","Properties":{"id":"20240614092935-a0znnqr","updated":"20240614092935"},"Children":[{"Type":"NodeText","Data":"甘平．去伏热．及头中风热．利口齿及大小肠．治烦渴．崩中带下．五种黄病．（小便出血、水芹捣汁、日服二合．）"}]},{"ID":"20240614092923-kw9x442","Type":"NodeThematicBreak","Properties":{"id":"20240614092923-kw9x442"}},{"ID":"20240614092924-mop9ki0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092924-mop9ki0","updated":"20240614092928"},"Children":[{"Type":"NodeText","Data":"水芹《千金翼方》"}]},{"ID":"20240614092924-cyjim33","Type":"NodeParagraph","Properties":{"id":"20240614092924-cyjim33","updated":"20240614092924"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主女子赤沃，止血养精，保血脉，益气，令人肥健，嗜食。一名水英。"}]},{"ID":"20240614092924-b2sv3gk","Type":"NodeParagraph","Properties":{"id":"20240614092924-b2sv3gk","updated":"20240614092924"},"Children":[{"Type":"NodeText","Data":"生南海池泽。"}]},{"ID":"20240614092910-v2r8vwz","Type":"NodeThematicBreak","Properties":{"id":"20240614092910-v2r8vwz"}},{"ID":"20240614092911-rargcu8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092911-rargcu8","updated":"20240614092920"},"Children":[{"Type":"NodeText","Data":"水芹《冯氏锦囊秘录》"}]},{"ID":"20240614092911-7gvhbr2","Type":"NodeParagraph","Properties":{"id":"20240614092911-7gvhbr2","updated":"20240614092911"},"Children":[{"Type":"NodeText","Data":"一名水英。味辛、微苦、性温、平，无毒。辛能入肺而益气，香能入胃而助食，苦能退黄，除热利二便也。其叶下常有虫子，视之不见，倘误食不免为殃，凡采务须洗净，堪作齑可置酒酱。"}]},{"ID":"20240614092911-623dv10","Type":"NodeParagraph","Properties":{"id":"20240614092911-623dv10","updated":"20240614092911"},"Children":[{"Type":"NodeText","Data":"水芹，能益气养精，令肥健嗜食，止烦渴，杀诸石药毒，保血脉，退五种急黄，利大小二肠，亦利口齿，止赤沃带下，仍止崩中，小儿身暴热可驱，大人酒后热可解。勿和醋食，损齿须防。八月食之，患蚊龙蛊，其时龙带精入芹中故也。"}]},{"ID":"20240614092855-v124bph","Type":"NodeThematicBreak","Properties":{"id":"20240614092855-v124bph"}},{"ID":"20240614092856-bdegoa1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092856-bdegoa1","updated":"20240614092859"},"Children":[{"Type":"NodeText","Data":"水芹《得配本草》"}]},{"ID":"20240614092856-nqvd0yw","Type":"NodeParagraph","Properties":{"id":"20240614092856-nqvd0yw","updated":"20240614092856"},"Children":[{"Type":"NodeText","Data":"甘，平。去热除烦，养精保血。退急黄，利二便，女子赤白带下，男子尿血淋痛。"}]},{"ID":"20240614092856-fhwsl98","Type":"NodeParagraph","Properties":{"id":"20240614092856-fhwsl98","updated":"20240614092856"},"Children":[{"Type":"NodeText","Data":"芹有赤白二种，赤芹害人不可食。"}]},{"ID":"20240614092856-yx1ecu3","Type":"NodeParagraph","Properties":{"id":"20240614092856-yx1ecu3","updated":"20240614092856"},"Children":[{"Type":"NodeText","Data":"蛇喜嗜芹，春夏之交，遗精于此，恐误食中毒。"}]},{"ID":"20240614092844-vcr3kd3","Type":"NodeThematicBreak","Properties":{"id":"20240614092844-vcr3kd3"}},{"ID":"20240614092845-d2e3698","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092845-d2e3698","updated":"20240614092850"},"Children":[{"Type":"NodeText","Data":"水芹《证类本草》"}]},{"ID":"20240614092845-p3n8329","Type":"NodeParagraph","Properties":{"id":"20240614092845-p3n8329","updated":"20240614092845"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主女子赤沃，止血，养精，保血脉，益气，令人肥健，嗜食。一名水英。生南海池泽。"}]},{"ID":"20240614092845-o6n6rjl","Type":"NodeParagraph","Properties":{"id":"20240614092845-o6n6rjl","updated":"20240614092845"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶论芹主疗，合是上品，末解何意，乃在下。其二月、三月作英时，可作菹及熟（音药）食之。又有渣（音楂）芹，可为生菜，亦可生啖，俗中皆作芹字。唐本注云∶芹花，味苦。主脉溢。今按∶别本注云∶即芹菜也。芹有两种∶ 芹，取根，白色；赤芹，取茎叶，并堪作菹及生菜。味甘，《经》云平，其性大寒，无毒。又按陈藏器本草云∶水芹茎叶，捣绞后热毒，鼻塞身热，利大小肠。茎、叶、根并寒。子，温，辛。"}]},{"ID":"20240614092845-77kzo5n","Type":"NodeParagraph","Properties":{"id":"20240614092845-77kzo5n","updated":"20240614092845"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按蜀本图经云∶生水中，叶似芎 ，花白色而无实，根亦白色。尔雅云∶芹，楚葵。注∶今水中芹菜。孟诜云∶水芹，寒。养神益力，杀药毒。置酒、酱中香美。又，和醋水芹，食之不如高田者宜人。余田中皆诸虫子在其叶下，视之不见，食之与人为患。高田者名白芹。日华子云∶治烦渴，疗崩中，带下。"}]},{"ID":"20240614092845-j2u3upp","Type":"NodeParagraph","Properties":{"id":"20240614092845-j2u3upp","updated":"20240614092845"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶渣芹，平。主女子赤白沃，止血，养精神，保血脉，益气，嗜饮食，利人口齿，去头中热风。和醋食之，亦能滋人。患鳖症不可食。食疗云∶寒。养神益力，令人肥健。杀石月勿食芹菜，恐病蛟龙瘕。发则似癫，面色青黄，小腹胀，状如怀妊也。食医心镜∶芹菜，主益筋力，去伏热，治五种黄病，女子白沃，漏下，止血，养精，保煮食并得。金匮方∶春秋二时，龙带精入芹菜中。人遇食之为病，发作蛟龙病。服硬糖三、二升，日二度。吐出如蜥蜴三、二，便瘥。子母饮，任性多少，得止。"}]},{"ID":"20240614092620-k5vhgka","Type":"NodeThematicBreak","Properties":{"id":"20240614092620-k5vhgka"}},{"ID":"20240614092622-1xx61xj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092622-1xx61xj","updated":"20240614092625"},"Children":[{"Type":"NodeText","Data":"芹菜《本草求真》"}]},{"ID":"20240614092622-qnkd235","Type":"NodeParagraph","Properties":{"id":"20240614092622-qnkd235","updated":"20240614092622"},"Children":[{"Type":"NodeText","Data":"（荤辛）芹菜辛多于苦则能以治寒湿 苦多于辛则能以治热毒"}]},{"ID":"20240614092622-gdu290c","Type":"NodeParagraph","Properties":{"id":"20240614092622-gdu290c","updated":"20240614092622"},"Children":[{"Type":"NodeText","Data":"芹菜（专入肺胃肝）。地出。有水有旱。其味有苦有甘。有辛有酸之类。考之张璐有言。旱芹得青阳之气而生。气味辛窜。能理胃中湿浊。水芹得湿淫之气而生。气味辛浊。考之纲目有言。旱芹气味甘寒。能除心下烦热。水芹气味甘平。能治女子赤沃。两说绝不相类。讵知旱芹种类。或有得于阳气之浓。故味多辛而燥。得于阳气之微。故味苦而多湿。水芹种类。得于阳气之最。则气虽浊而仍清。得于阴气之胜。则味既苦而且浊。不得谓水芹尽属阴类。旱芹尽属阳类也。惟察辛多于苦。则芹多燥而不凉。苦胜于辛。则芹多寒而不温。辛胜于苦。则治当如本经所云。能治女子赤沃。俾浊湿去。胃气清。而精血有赖。令人肥健嗜食。苦胜于辛。及质粘滑。则治当如唐本所云。能治痈肿马毒。又安能入脾以助食。入阴以助精。入肝以保血乎！但芹在水。须防有虫在于叶间。（春夏之交。多有蜥蝎虺蛇在于此处遗精。）"}]},{"ID":"20240614092622-vorsrt2","Type":"NodeParagraph","Properties":{"id":"20240614092622-vorsrt2","updated":"20240614092622"},"Children":[{"Type":"NodeText","Data":"视之不见。令人为患面青手青。腹满如妊。痛不可忍。作蛟龙痛。须服硬饧二三斤。吐出便瘥。其根白盈尺者曰马 。食之令人发疮疥。以其湿热之气最盛也。和醋食之损齿。有鳖瘕人不可食。"}]},{"ID":"20240614092526-ke4krg6","Type":"NodeThematicBreak","Properties":{"id":"20240614092526-ke4krg6"}},{"ID":"20240614092528-wcwoc4c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092528-wcwoc4c","updated":"20240614092540"},"Children":[{"Type":"NodeText","Data":"水芹《本经逢原》"}]},{"ID":"20240614092528-pw8rblo","Type":"NodeParagraph","Properties":{"id":"20240614092528-pw8rblo","updated":"20240614092528"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名水芹"}]},{"ID":"20240614092528-4yrbt6a","Type":"NodeParagraph","Properties":{"id":"20240614092528-4yrbt6a","updated":"20240614092528"},"Children":[{"Type":"NodeText","Data":"甘微辛，小毒。"}]},{"ID":"20240614092528-uv0443c","Type":"NodeParagraph","Properties":{"id":"20240614092528-uv0443c","updated":"20240614092528"},"Children":[{"Type":"NodeText","Data":"《本经》云∶女子赤沃下血，养精保血脉益气，令人肥健，嗜食。"}]},{"ID":"20240614092528-nok7lub","Type":"NodeParagraph","Properties":{"id":"20240614092528-nok7lub","updated":"20240614092528"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"按∶ 有两种，一种生平田者，曰旱 ，禀青阳之气而生，气味辛窜。能清理胃中浊湿，故《本经》主女子赤沃，浊湿去则胃气清纯，而精血有赖，令人肥健嗜食。一种生陂泽者，曰水 。得湿淫之气而生，气味辛浊。有虫子在叶间视之不见，食之令人为患，面青手青腹满如妊，痛不可忍，作蛟龙病，但服硬饧二三升，吐出便瘥，大抵是蛇虺之毒尔。"}]},{"ID":"20240614092528-zkfmb0x","Type":"NodeParagraph","Properties":{"id":"20240614092528-zkfmb0x","updated":"20240614092528"},"Children":[{"Type":"NodeText","Data":"其根白，盈尺者曰马 ，食之令人发疮疥，以其湿热之气最盛也。和醋食之损齿，有鳖瘕人不可食。"}]},{"ID":"20240614092701-dpntfnd","Type":"NodeThematicBreak","Properties":{"id":"20240614092701-dpntfnd"}},{"ID":"20240614092702-fpsak32","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092702-fpsak32","updated":"20240614092708"},"Children":[{"Type":"NodeText","Data":"水芹《医学入门》"}]},{"ID":"20240614092702-9zkm0vx","Type":"NodeParagraph","Properties":{"id":"20240614092702-9zkm0vx","updated":"20240614092702"},"Children":[{"Type":"NodeText","Data":"水芹味甘平无毒，能益气血养精神，更消烦渴除黄胆，带下崩中治妇人。"}]},{"ID":"20240614092702-1u3s127","Type":"NodeParagraph","Properties":{"id":"20240614092702-1u3s127","updated":"20240614092702"},"Children":[{"Type":"NodeText","Data":"芹，英也。产于水浒，而英秀异于他菜，可作菹食。无毒。益气，保血脉，养精神，壮筋力，令人肥健嗜食。除身热烦渴，利大小肠，治五种黄病，女人赤沃，崩中漏下，小儿霍乱吐泻；兼去头中热风，杀石药毒。醋和食之损齿，患鳖瘕人不可食。"}]},{"ID":"20240614092702-92iifyl","Type":"NodeParagraph","Properties":{"id":"20240614092702-92iifyl","updated":"20240614092702"},"Children":[{"Type":"NodeText","Data":"又三月、八月龙带精入芹菜中，人遇食之，变成蛟龙瘕，发则似癫面色青，小腹满痛，状如怀胎，服硬糖二三升，日二服，吐出如龙子，遂愈。"}]},{"ID":"20240614092551-jz3t74y","Type":"NodeThematicBreak","Properties":{"id":"20240614092551-jz3t74y"}},{"ID":"20240614092552-a2ur4at","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092552-a2ur4at","updated":"20240614092600"},"Children":[{"Type":"NodeText","Data":"水斳《本草纲目》"}]},{"ID":"20240614092552-cmysunq","Type":"NodeParagraph","Properties":{"id":"20240614092552-cmysunq","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240614092552-zv880vd","Type":"NodeParagraph","Properties":{"id":"20240614092552-zv880vd","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖释名〗芹菜（《别录》）水英（《本经》）楚葵（〔弘景曰〕斳字俗作芹字。论其主治，合在上品，未解何意乃在下品?二月、三月作英时，可作菹及熟瀹食。故名水英。〔时珍曰〕斳当作芹，从屮、斳，谐声也。后省作芹，从斤，亦谐声也。其性冷滑如葵，故尔雅谓之楚葵。吕氏春秋：菜之美者，有云梦之芹。云梦，楚地也。楚有蕲州、蕲县，俱音淇。罗愿尔雅翼云：地多产芹，故字从芹。蕲亦（音芹。徐锴注说文，蕲字，从屮，[单斤]。诸书无[单斤]字，惟说文别出䓄字（音银），疑相承误出也。据此，则蕲字亦当从斳，作芹字也）"}]},{"ID":"20240614092552-i4geer9","Type":"NodeParagraph","Properties":{"id":"20240614092552-i4geer9","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖集解〗〔《别录》曰〕水斳生南海池泽。〔恭曰〕水斳即芹菜也。有两种：荻芹白色取根，赤芹取茎、叶。并堪作菹及生菜。〔保升曰〕芹生水中，叶似芎藭，其花白色而无实，根亦白色。〔诜曰〕水芹生黑滑地，食之不如高田者宜人，置酒酱中香美。高田者名白芹。余田者皆有虫子在叶间，视之不见，食之令人为患。〔弘景曰〕又有渣芹，可为生菜，亦可生啖。〔时珍曰〕芹有水芹、旱芹。水芹生江湖陂泽之涯；旱芹生平地，有赤、白二种。二月生苗，其叶对节而生，似芎藭。其茎有节棱而中空，其气芬芳。五月开细白花，如蛇床花。楚人采以济饥，其利不小。诗云：觱沸槛泉，言采其芹。杜甫诗云：饭煮青泥坊底芹。又云：香芹碧涧羹。皆美芹之功。而列子言乡豪尝芹，蜇口惨腹，盖未得食芹之法耳）"}]},{"ID":"20240614092552-plhaqed","Type":"NodeParagraph","Properties":{"id":"20240614092552-plhaqed","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"茎"}]},{"ID":"20240614092552-gtsu4ix","Type":"NodeParagraph","Properties":{"id":"20240614092552-gtsu4ix","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖气味〗甘，平，无毒。（〔思邈曰〕苦、酸，冷，涩，无毒。〔诜曰〕和醋食，损齿。鳖瘕不可食。〔李廷飞曰〕赤芹害人，不可食）"}]},{"ID":"20240614092552-oncall5","Type":"NodeParagraph","Properties":{"id":"20240614092552-oncall5","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖主治〗女子赤沃，止血养精，保血脉，益气，令人肥健嗜食。（《本经》）去伏热，杀石药毒，捣汁服。（孟诜）饮汁，去小儿暴热，大人酒后热，鼻塞身热，去头中风热，利口齿，利大小肠。（藏器）治烦渴，崩中带下，五种黄病。（大明）"}]},{"ID":"20240614092552-p1p2hsr","Type":"NodeParagraph","Properties":{"id":"20240614092552-p1p2hsr","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖发明〗〔张仲景曰〕春秋二时，龙带精入芹菜中。人误食之为病，面青手青，腹满如妊，痛不可忍，作蛟龙病。俱服硬饧三二升，日三度。吐出蜥蜴便瘥。〔时珍曰〕芹菜生水涯。蛟龙虽云变化莫测，其精那得入此?大抵是蜥蜴、虺蛇之类，春夏之交，遗精于此故尔。且蛇喜嗜芹，尤为可证。别有马芹见后。"}]},{"ID":"20240614092552-xefzfwz","Type":"NodeParagraph","Properties":{"id":"20240614092552-xefzfwz","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖附方〗（旧一，新二）小儿吐泻（芹菜切细，煮汁饮之，不拘多少。《子母秘录》）小便淋痛（水芹菜白根者，去叶捣汁，井水和服。《圣惠方》）小便出血（水芹捣汁，日服六七合。《圣惠方》）"}]},{"ID":"20240614092552-qj7j4ge","Type":"NodeParagraph","Properties":{"id":"20240614092552-qj7j4ge","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"花"}]},{"ID":"20240614092552-6bvuxt2","Type":"NodeParagraph","Properties":{"id":"20240614092552-6bvuxt2","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖气味〗苦，寒，无毒。"}]},{"ID":"20240614092552-djcvov0","Type":"NodeParagraph","Properties":{"id":"20240614092552-djcvov0","updated":"20240614092552"},"Children":[{"Type":"NodeText","Data":"〖主治〗脉溢。（苏恭）"}]},{"ID":"20240614092336-jpo1qk6","Type":"NodeThematicBreak","Properties":{"id":"20240614092336-jpo1qk6"}},{"ID":"20240614092337-7fc1s30","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092337-7fc1s30","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：水芹"}]},{"ID":"20240614092337-ho4xjt1","Type":"NodeParagraph","Properties":{"id":"20240614092337-ho4xjt1","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614092337-5xb7c3o","Type":"NodeParagraph","Properties":{"id":"20240614092337-5xb7c3o","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" Shuǐ Qín"}]},{"ID":"20240614092337-8u7flrg","Type":"NodeParagraph","Properties":{"id":"20240614092337-8u7flrg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614092337-7i36qtl","Type":"NodeParagraph","Properties":{"id":"20240614092337-7i36qtl","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 水芹菜"}]},{"ID":"20240614092337-vrs8ncg","Type":"NodeParagraph","Properties":{"id":"20240614092337-vrs8ncg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614092337-3hkkjf2","Type":"NodeParagraph","Properties":{"id":"20240614092337-3hkkjf2","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 伞形科水芹菜属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水芹"},{"Type":"NodeText","Data":"Oenanthe javanica （Blume）DC.[Oenanthe stolonifera （Roxb.）Wall. ex DC.;O. decumbens （Thunb.）Koz.-Pol.]，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。夏秋采集，洗净晒干或鲜用。"}]},{"ID":"20240614092337-8ur4pzv","Type":"NodeParagraph","Properties":{"id":"20240614092337-8ur4pzv","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614092337-awxkr9t","Type":"NodeParagraph","Properties":{"id":"20240614092337-awxkr9t","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240614092337-or0b66y","Type":"NodeParagraph","Properties":{"id":"20240614092337-or0b66y","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614092337-t9jf4g5","Type":"NodeParagraph","Properties":{"id":"20240614092337-t9jf4g5","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 清热利湿，止血，降血压。用于感冒发热，呕吐腹泻，尿路感染，崩漏，白带，高血压。"}]},{"ID":"20240614092337-5k57wvo","Type":"NodeParagraph","Properties":{"id":"20240614092337-5k57wvo","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614092337-w5jfwst","Type":"NodeParagraph","Properties":{"id":"20240614092337-w5jfwst","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 2～3钱。鲜品可捣汁饮。"}]},{"ID":"20240614092337-2e2sl6i","Type":"NodeParagraph","Properties":{"id":"20240614092337-2e2sl6i","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614092337-jzeplum","Type":"NodeParagraph","Properties":{"id":"20240614092337-jzeplum","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" （1）同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"少花水芹"},{"Type":"NodeText","Data":"O. benghalensis （Roxb.）Kurz；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野水芹"},{"Type":"NodeText","Data":"（溪岸水芹）O. rivularis Dunn，亦应用于临床，功效相似。"}]},{"ID":"20240614092337-msc1m5b","Type":"NodeParagraph","Properties":{"id":"20240614092337-msc1m5b","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614092337-cvtjmgs","Type":"NodeParagraph","Properties":{"id":"20240614092337-cvtjmgs","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614092337-di792en","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092337-di792en","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：水芹"}]},{"ID":"20240614092337-716763q","Type":"NodeParagraph","Properties":{"id":"20240614092337-716763q","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614092337-2jbmygs","Type":"NodeParagraph","Properties":{"id":"20240614092337-2jbmygs","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" Shuǐ Qín"}]},{"ID":"20240614092337-xrn97g2","Type":"NodeParagraph","Properties":{"id":"20240614092337-xrn97g2","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614092337-old8p9o","Type":"NodeParagraph","Properties":{"id":"20240614092337-old8p9o","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 楚葵（《尔雅》），水斳、水英（《本经》），芹菜（《尔雅》郭璞注），水芹菜（《滇南本草》），野芹菜（《湖南药物志》）。"}]},{"ID":"20240614092337-lc12gxr","Type":"NodeParagraph","Properties":{"id":"20240614092337-lc12gxr","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614092337-al8d1sa","Type":"NodeParagraph","Properties":{"id":"20240614092337-al8d1sa","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 《千金翼本草》"}]},{"ID":"20240614092337-bbc6bl6","Type":"NodeParagraph","Properties":{"id":"20240614092337-bbc6bl6","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614092337-t02pjvg","Type":"NodeParagraph","Properties":{"id":"20240614092337-t02pjvg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水芹"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。9～10月采割地上部分，晒干。"}]},{"ID":"20240614092337-bdg9g02","Type":"NodeParagraph","Properties":{"id":"20240614092337-bdg9g02","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614092337-knd9k9e","Type":"NodeParagraph","Properties":{"id":"20240614092337-knd9k9e","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 喜生于低湿洼地或水沟中。分布河南、江苏、浙江、安徽、江西、湖北、湖南、四川、广东、广西、台湾等地。"}]},{"ID":"20240614092337-veoplo5","Type":"NodeParagraph","Properties":{"id":"20240614092337-veoplo5","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614092337-1x6h8ce","Type":"NodeParagraph","Properties":{"id":"20240614092337-1x6h8ce","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 多年生湿生或水生草本，全体光滑无毛，具匍匐茎。茎圆柱形，长可达1米，中空，直立或由匍匐的基部向上伸直，上部多分枝，常伸出水面，下部每节略胀大，通常生多数白色须根；茎表面绿色，有纵条纹。复叶互生，具柄及叶鞘，着生在茎下部的叶柄长达10厘米，鞘两边呈膜状；叶片1～2回羽状分裂；小叶或裂片卵圆形至菱状披针形，长2～5厘米，宽1～2厘米，先端尖，边缘具大小不等的尖齿或圆齿状锯齿，基部两侧不等；着生在茎上部的叶近于无柄。复伞形花序顶生，通常与顶生的叶相对；小伞形花序6～20；总苞无，小总苞2～8，线形；花白色，有柄，丝状而柔；萼齿5，形小，短尖；花瓣5，倒卵形，先端向内凹入，基部具短爪；雄蕊5，花丝长而微弯，花药线形而短；子房下位，2室，每室有胚珠1，花柱叉状，基部圆柱形。双悬果椭圆形或近圆锥形，上端有宿存的萼齿和花柱，果棱显著隆起，侧棱较其它3棱稍宽，木栓质。花期4～5月。"}]},{"ID":"20240614092337-vwoyflb","Type":"NodeParagraph","Properties":{"id":"20240614092337-vwoyflb","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"本植物的花（芹花）亦供药用，另详专条。"}]},{"ID":"20240614092337-ryqf1qw","Type":"NodeParagraph","Properties":{"id":"20240614092337-ryqf1qw","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614092337-6yhptv8","Type":"NodeParagraph","Properties":{"id":"20240614092337-6yhptv8","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 入肺、胃经。"}]},{"ID":"20240614092337-5c7evbb","Type":"NodeParagraph","Properties":{"id":"20240614092337-5c7evbb","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"①《本草求真》：\"入肺、胃、肝。\""}]},{"ID":"20240614092337-lp4hvhf","Type":"NodeParagraph","Properties":{"id":"20240614092337-lp4hvhf","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入心、肺二经。\""}]},{"ID":"20240614092337-82t5d73","Type":"NodeParagraph","Properties":{"id":"20240614092337-82t5d73","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》：\"入手足太阴、阳明经。\""}]},{"ID":"20240614092337-cwqkfek","Type":"NodeParagraph","Properties":{"id":"20240614092337-cwqkfek","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614092337-vzbx493","Type":"NodeParagraph","Properties":{"id":"20240614092337-vzbx493","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 甘辛，凉。"}]},{"ID":"20240614092337-3nj7cpg","Type":"NodeParagraph","Properties":{"id":"20240614092337-3nj7cpg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240614092337-0agx6uf","Type":"NodeParagraph","Properties":{"id":"20240614092337-0agx6uf","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"味苦酸涩，冷，无毒。\""}]},{"ID":"20240614092337-i5muwyc","Type":"NodeParagraph","Properties":{"id":"20240614092337-i5muwyc","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"③崔禹锡《食经》：’味甘，少冷，无毒。\""}]},{"ID":"20240614092337-5412aqe","Type":"NodeParagraph","Properties":{"id":"20240614092337-5412aqe","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"茎、叶、根：寒。子：温，辛。\""}]},{"ID":"20240614092337-8wfuoo8","Type":"NodeParagraph","Properties":{"id":"20240614092337-8wfuoo8","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614092337-8hy0uo1","Type":"NodeParagraph","Properties":{"id":"20240614092337-8hy0uo1","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：\"脾胃虚弱，中气寒乏者禁食之。\""}]},{"ID":"20240614092337-30pma55","Type":"NodeParagraph","Properties":{"id":"20240614092337-30pma55","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614092337-fqrwcab","Type":"NodeParagraph","Properties":{"id":"20240614092337-fqrwcab","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 清热，利水。治暴热烦渴，黄疸，水肿，淋病，带下，瘰疬，痄腮。"}]},{"ID":"20240614092337-0rsmj1a","Type":"NodeParagraph","Properties":{"id":"20240614092337-0rsmj1a","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主女子赤沃。止血养精，保血脉，益气，令人肥健嗜食。\""}]},{"ID":"20240614092337-omwi02y","Type":"NodeParagraph","Properties":{"id":"20240614092337-omwi02y","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"益筋力，去伏热。治五种黄病，生捣绞汁冷服一升，日二。\""}]},{"ID":"20240614092337-rrhlz0e","Type":"NodeParagraph","Properties":{"id":"20240614092337-rrhlz0e","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"③崔禹锡《食经》：\"利小便，除水胀。\""}]},{"ID":"20240614092337-voqft2j","Type":"NodeParagraph","Properties":{"id":"20240614092337-voqft2j","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"④孟诜：\"食之养神益力，杀石药毒。\""}]},{"ID":"20240614092337-yhrngra","Type":"NodeParagraph","Properties":{"id":"20240614092337-yhrngra","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑤《本草拾遗》：\"茎叶捣绞取汁，去小儿暴热，大人酒后热毒、鼻塞、身热，利大小肠。\""}]},{"ID":"20240614092337-90ya2et","Type":"NodeParagraph","Properties":{"id":"20240614092337-90ya2et","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"治烦渴，疗崩中带下。\""}]},{"ID":"20240614092337-dxbtm5p","Type":"NodeParagraph","Properties":{"id":"20240614092337-dxbtm5p","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"补心，去瘀，续伤。\""}]},{"ID":"20240614092337-etc724f","Type":"NodeParagraph","Properties":{"id":"20240614092337-etc724f","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑧《草再新》：’除烦解热，化痰下气，治血分，消瘰疬结核。\""}]},{"ID":"20240614092337-vblv7ef","Type":"NodeParagraph","Properties":{"id":"20240614092337-vblv7ef","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑨《随息居饮食谱》：\"清胃涤热，祛风，利口齿咽喉头目。\""}]},{"ID":"20240614092337-f2bwmzn","Type":"NodeParagraph","Properties":{"id":"20240614092337-f2bwmzn","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑩《中国药植志》：\"嫩茎捣汁服，可治高血压症。\""}]},{"ID":"20240614092337-m9v4kol","Type":"NodeParagraph","Properties":{"id":"20240614092337-m9v4kol","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑾《贵州民间方药集》：\"解热利尿，驱风。治风湿神经疼痛。\""}]},{"ID":"20240614092337-tkgdjdt","Type":"NodeParagraph","Properties":{"id":"20240614092337-tkgdjdt","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614092337-hkpfq17","Type":"NodeParagraph","Properties":{"id":"20240614092337-hkpfq17","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2两；或捣汁。外用：捣敷。"}]},{"ID":"20240614092337-lt9mb2x","Type":"NodeParagraph","Properties":{"id":"20240614092337-lt9mb2x","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614092337-wo2mmls","Type":"NodeParagraph","Properties":{"id":"20240614092337-wo2mmls","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" ①治小儿发热，月余不凉：水芹菜、大麦芽、车前子。水煎服。（《滇南本草》）"}]},{"ID":"20240614092337-fwyu9gg","Type":"NodeParagraph","Properties":{"id":"20240614092337-fwyu9gg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"②治小便淋痛：水芹菜白根者，去叶捣汁，井水和服。（《圣惠方》）"}]},{"ID":"20240614092337-894lrua","Type":"NodeParagraph","Properties":{"id":"20240614092337-894lrua","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"③治小便不利：水芹三钱。水煎服。（《湖南药物志》）"}]},{"ID":"20240614092337-brk0636","Type":"NodeParagraph","Properties":{"id":"20240614092337-brk0636","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"④治白带：水芹四钱，景天二钱。水煎服。（《湖南药物志》）"}]},{"ID":"20240614092337-6fd3avv","Type":"NodeParagraph","Properties":{"id":"20240614092337-6fd3avv","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑤治小便出血：水芹捣汁，日服六、七合。（《圣惠方》）"}]},{"ID":"20240614092337-510kctn","Type":"NodeParagraph","Properties":{"id":"20240614092337-510kctn","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑥治小儿霍乱吐痢：芹叶细切，煮熟汁饮。（《子母秘录》）"}]},{"ID":"20240614092337-ecy07vo","Type":"NodeParagraph","Properties":{"id":"20240614092337-ecy07vo","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"⑦治痄腮：水芹捣烂，加茶油敷患处。（《湖南药物志》）"}]},{"ID":"20240614092337-bysmirp","Type":"NodeParagraph","Properties":{"id":"20240614092337-bysmirp","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614092337-a34w7nb","Type":"NodeParagraph","Properties":{"id":"20240614092337-a34w7nb","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614092337-b0vfr6y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614092337-b0vfr6y","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"《中华本草》：水芹"}]},{"ID":"20240614092337-apu0xwl","Type":"NodeParagraph","Properties":{"id":"20240614092337-apu0xwl","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614092337-pvebkw7","Type":"NodeParagraph","Properties":{"id":"20240614092337-pvebkw7","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" Shuǐ Qín"}]},{"ID":"20240614092337-l64jqqk","Type":"NodeParagraph","Properties":{"id":"20240614092337-l64jqqk","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614092337-9yooz1h","Type":"NodeParagraph","Properties":{"id":"20240614092337-9yooz1h","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 楚葵、水斳、水英、芹菜、水芹菜、野芹菜、马芹、河芹、小叶芹"}]},{"ID":"20240614092337-i4o06tn","Type":"NodeParagraph","Properties":{"id":"20240614092337-i4o06tn","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614092337-nyjfzoq","Type":"NodeParagraph","Properties":{"id":"20240614092337-nyjfzoq","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" Herb of javan Waterdropwort"}]},{"ID":"20240614092337-0rzg3qt","Type":"NodeParagraph","Properties":{"id":"20240614092337-0rzg3qt","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614092337-jzsivnh","Type":"NodeParagraph","Properties":{"id":"20240614092337-jzsivnh","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 出自1.《千金翼本草》。"}]},{"ID":"20240614092337-5s9vmqg","Type":"NodeParagraph","Properties":{"id":"20240614092337-5s9vmqg","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：水芹，生南海池泽。"}]},{"ID":"20240614092337-et5btom","Type":"NodeParagraph","Properties":{"id":"20240614092337-et5btom","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：（水芹）二月、三月作英时，可作菹及熟沦食之。又有渣芹，可为生菜，亦可生啖。"}]},{"ID":"20240614092337-h0ar30u","Type":"NodeParagraph","Properties":{"id":"20240614092337-h0ar30u","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"4.《蜀本草》：《图经》云，（水芹）生水中，叶似芎穷，花白色而无实，根亦白色。"}]},{"ID":"20240614092337-zbb1ykp","Type":"NodeParagraph","Properties":{"id":"20240614092337-zbb1ykp","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：芹有水芹、旱芹，水芹生江湖陂泽之涯，旱芹生平地，有赤白二种。二月生苗，其叶对节而生，似芎穷。其茎有节棱而中空，其气芬芳。五月开细白"}]},{"ID":"20240614092337-tt5atv2","Type":"NodeParagraph","Properties":{"id":"20240614092337-tt5atv2","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614092337-hmhf80f","Type":"NodeParagraph","Properties":{"id":"20240614092337-hmhf80f","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物水芹的全草。"}]},{"ID":"20240614092337-qptd8jk","Type":"NodeParagraph","Properties":{"id":"20240614092337-qptd8jk","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Oenanthe javanica (Bl.) D C.[Sium ja-uanicum Bl.; Oenanthe decumbens K.-Pol.; O.stolnifera (Roxb.)Wall.ex DC.]"}]},{"ID":"20240614092337-oyqs9qc","Type":"NodeParagraph","Properties":{"id":"20240614092337-oyqs9qc","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月采割地上部分，洗净，鲜用或晒干。"}]},{"ID":"20240614092337-m4obfzj","Type":"NodeParagraph","Properties":{"id":"20240614092337-m4obfzj","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614092337-9jgv68t","Type":"NodeParagraph","Properties":{"id":"20240614092337-9jgv68t","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于浅水低洼湿地或池沼、水沟中，常栽培作蔬菜食用。"}]},{"ID":"20240614092337-6rfykx6","Type":"NodeParagraph","Properties":{"id":"20240614092337-6rfykx6","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"资源分布：分布几扁全国。"}]},{"ID":"20240614092337-ge9wu6b","Type":"NodeParagraph","Properties":{"id":"20240614092337-ge9wu6b","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614092337-ml9s8ci","Type":"NodeParagraph","Properties":{"id":"20240614092337-ml9s8ci","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高15-80cm。全株无毛。茎直立或基部匍匐，节上生根。基生叶叶柄长达10cm，基部有叶鞘；叶片轮廓三角形或三角状卵形，一至二回羽状分裂，末回裂片卵形或菱状披针形，长2-5cm，宽1-2cm，边缘有不整齐的尖齿或圆齿；茎上部叶无柄，叶较小。得伞形花序顶生；花序梗长达16cm；无总苞；伞辐6-16，长1-3cm；小总苞片2-8，线形；小伞形花序有花10-25；萼齿线状披针形；花瓣白色，倒卵形；花柱基圆锥形，花柱直立或叉形，每棱槽内有油管1，合生面油管2。花期6-7月，果期8-9月。"}]},{"ID":"20240614092337-m98sy6n","Type":"NodeParagraph","Properties":{"id":"20240614092337-m98sy6n","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614092337-wspapd2","Type":"NodeParagraph","Properties":{"id":"20240614092337-wspapd2","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品多皱缩成团，茎细而弯曲。匍匐茎节处有须状根。叶皱缩，展平后，基生叶三角形或三角状卵形，一至二回羽状分裂，最终裂片卵形至菱状披针形，长2-5cm，宽1-2cm，边缘不整齐尖齿或圆锯齿，叶柄长7-15cm，质脆易碎。气微香，味微辛、苦。"}]},{"ID":"20240614092337-m1uhgtf","Type":"NodeParagraph","Properties":{"id":"20240614092337-m1uhgtf","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614092337-cdr17g9","Type":"NodeParagraph","Properties":{"id":"20240614092337-cdr17g9","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 翅叶中含缬氨酸（L-valine)，丙氨酸（alanine)，异亮氨酸（isoleucine)1-二十醇（1-eicosanol)，1-二十二醇（1-do-cosanol)，1-二十四醇（1-tetracosanol)，β-谷甾醇（β-sitosterol)和C15-C29饱和碳氢化合物[1]。细胞壁上含多糖，主要同葡萄糖（glucose)，半乳糖（galactose)，木糖（xylose)，阿拉伯糖（arabinose)等组成[2]。另含5-AMP、ADP、ATP、CDP、GDP，5-UMP、UDP、及UDP-D-葡萄糖，UDP-D-半乳糖，UDP-D-木糖，UDP-D-阿拉伯糖的结合物[3]。根中含香豆精（coumarin)，伞形花内酯（um-belliferone)，二十二烷酸（behenic acid)，二十九烷酸（montanic acid)，蜂花酸（三十烷酸，melissic acid)，虫漆蜡酸（三十二烷酸，lacceroic acid)[4]，硬脂酸（stearic acid)，花生酸（arachic acid)，二十六烷酸（cerotic acid)[5]，β-水芹烯（β-phellandrene)，石竹烯（caryophyllene)，α-蒎烯（α-pinene)，莳萝油脑（dillapiol)，油酸（ole-ic acid)，亚油酸（linoleic acid)，十产烷酸（palmitic acid)[6]，全草含异鼠李素（isorhamnetin)，樟烯（camphene)，β-蒎烯（β-pinene)，香芹烯（carvacrol)，丁香油酚（eugenol)[7]。"}]},{"ID":"20240614092337-pjs3ki2","Type":"NodeParagraph","Properties":{"id":"20240614092337-pjs3ki2","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614092337-0ltanxt","Type":"NodeParagraph","Properties":{"id":"20240614092337-0ltanxt","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 1、保肝作用 50%水芹注射液10ml/kg，皮下注射每日1次，共6次，对四氯化碳所致大鼠急性肝损伤有明显的保护作用，血清丙氯酸转氨酶转氨酶平均下降37%[1，2].50%水芹全草水提取物对四氯化碳所致大鼠肝损伤也具有一定退黄和降酶作用[3]。水芹煎液12g生药/kg灌胃对α-萘异氰酸酯所致大鼠肝炎有明显退黄作用，降低血清胆管上皮变性坏死病理改变可明显减轻[4]。"}]},{"ID":"20240614092337-rpj21xi","Type":"NodeParagraph","Properties":{"id":"20240614092337-rpj21xi","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"2、抗心律失常作用 水芹注射液3ml/kg，静脉注射对乌头碱、氯化钡、及氯化钙-乙酰胆碱诱发大鼠或心律失常有良好的抗钡、及氯化钙-乙酰胆碱诱发大鼠或小鼠心律失常有良好的抗心律失常作用。同时其抗心律失常作用与利多卡因，奎尼丁比较出现的快，但转窦性心律后的维持时间短，且易发生反复。水芹的抗心律失常可能与其影响细胞膜对钾、钠、钙的通透性有关[5]。"}]},{"ID":"20240614092337-x7c7q5t","Type":"NodeParagraph","Properties":{"id":"20240614092337-x7c7q5t","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"同属植物水芹[O.Stolonifera (Roxb.) Wall]甲醇提取物给大鼠静注，可显着对抗心肌缺血引起的心律失常，缩小心肌梗死面积，同时可明显对抗心肌缺血再灌注引起的心律失常，甲醇提取物100mg/kg可明显降低血浆中脂质过氧化产物丙二醛的含量，保护超氧化物歧化酶的活性[6]。"}]},{"ID":"20240614092337-l9455tc","Type":"NodeParagraph","Properties":{"id":"20240614092337-l9455tc","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"3、降血脂作用 家兔喂饲水芹100g/kg和30ml/kg水芹浸汁（含水芹50g），共30d，实验表明，水芹有降低β脂蛋白、三酰甘油（甘油三酯）作用[7]。"}]},{"ID":"20240614092337-ofa7xp6","Type":"NodeParagraph","Properties":{"id":"20240614092337-ofa7xp6","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"4、抗过敏作用 50%水芹全草水醇提取液可使卵蛋白致敏的肠管收缩幅度下降，也可使组胺及乙酰胆碱所致的肠管收缩培强明显缓解。这种作用不是通过受体而是对平滑肌的作用，而且在平滑肌呈兴奋状态时作用明显。此外，水芹有抑制2，4-二硝基氯苯所致小鼠迟发型超敏反应[8]。"}]},{"ID":"20240614092337-c5vl3mt","Type":"NodeParagraph","Properties":{"id":"20240614092337-c5vl3mt","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614092337-uyxboms","Type":"NodeParagraph","Properties":{"id":"20240614092337-uyxboms","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 归肺；肝；膀胱经"}]},{"ID":"20240614092337-popq8f4","Type":"NodeParagraph","Properties":{"id":"20240614092337-popq8f4","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614092337-jg846ru","Type":"NodeParagraph","Properties":{"id":"20240614092337-jg846ru","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 味辛；甘；性凉"}]},{"ID":"20240614092337-rqbt34y","Type":"NodeParagraph","Properties":{"id":"20240614092337-rqbt34y","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614092337-sqxt1v7","Type":"NodeParagraph","Properties":{"id":"20240614092337-sqxt1v7","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒者，慎绞汁服。"}]},{"ID":"20240614092337-3ji3z12","Type":"NodeParagraph","Properties":{"id":"20240614092337-3ji3z12","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614092337-eyqu5i0","Type":"NodeParagraph","Properties":{"id":"20240614092337-eyqu5i0","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 清热解毒；利尿；止血。主感冒；暴热烦渴；吐泻；浮肿；小便不利；淋痛；尿血；便血；吐血；衄血；崩漏；经多；目赤；咽痛；喉肿；口疮；牙疳；乳痈；痈疸；瘰疬；痄腮；带状疱疹；痔疮；跌打伤肿"}]},{"ID":"20240614092337-2y14fxx","Type":"NodeParagraph","Properties":{"id":"20240614092337-2y14fxx","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614092337-oe69lep","Type":"NodeParagraph","Properties":{"id":"20240614092337-oe69lep","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，30-60g；或捣汁。外用：适量，捣蛋青；或捣汁涂。"}]},{"ID":"20240614092337-n3lamar","Type":"NodeParagraph","Properties":{"id":"20240614092337-n3lamar","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614092337-hde9li1","Type":"NodeParagraph","Properties":{"id":"20240614092337-hde9li1","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主女子赤沃。止血养精，保血脉，益气，令人肥健嗜食。"}]},{"ID":"20240614092337-pjbrf3g","Type":"NodeParagraph","Properties":{"id":"20240614092337-pjbrf3g","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"2.《千金·食治》：益筋力，去伏热。治五种黄病，生捣绞汁冷服一升，日二。"}]},{"ID":"20240614092337-6daf3aa","Type":"NodeParagraph","Properties":{"id":"20240614092337-6daf3aa","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"3.崔禹锡《食经》：利小便，除水胀。"}]},{"ID":"20240614092337-u6raehx","Type":"NodeParagraph","Properties":{"id":"20240614092337-u6raehx","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"4.孟诜：食之养神益力，杀石药毒。"}]},{"ID":"20240614092337-v6q00o3","Type":"NodeParagraph","Properties":{"id":"20240614092337-v6q00o3","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"5.《本草拾遗》：茎叶捣绞取汁，去小儿暴热，大人酒后热毒、鼻塞、身热，利大小肠。"}]},{"ID":"20240614092337-0hf6374","Type":"NodeParagraph","Properties":{"id":"20240614092337-0hf6374","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治烦渴，疗崩中带下。"}]},{"ID":"20240614092337-bfcsfkr","Type":"NodeParagraph","Properties":{"id":"20240614092337-bfcsfkr","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"7.《医林纂要》：补心，去瘀，续伤。"}]},{"ID":"20240614092337-5f9thcw","Type":"NodeParagraph","Properties":{"id":"20240614092337-5f9thcw","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"8.《本草再新》：除烦解热，化痰下气，治血分，消瘰疬结核。"}]},{"ID":"20240614092337-wfc30c5","Type":"NodeParagraph","Properties":{"id":"20240614092337-wfc30c5","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"9.《随息居饮食谱》：清胃涤热，祛风，利口齿咽喉头目。"}]},{"ID":"20240614092337-nhqxzau","Type":"NodeParagraph","Properties":{"id":"20240614092337-nhqxzau","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"10.《中国药植志》：嫩茎捣汁服，可治高血压症。"}]},{"ID":"20240614092337-0h1d132","Type":"NodeParagraph","Properties":{"id":"20240614092337-0h1d132","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"11.《贵州民间方药集》：解热利尿，驱风，治风湿神经疼痛。"}]},{"ID":"20240614092337-m0fyj4a","Type":"NodeParagraph","Properties":{"id":"20240614092337-m0fyj4a","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614092337-p2l7jzp","Type":"NodeParagraph","Properties":{"id":"20240614092337-p2l7jzp","updated":"20240614092337"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614092338-lryfy50","Type":"NodeThematicBreak","Properties":{"id":"20240614092338-lryfy50"}},{"ID":"20240614092339-uikr75q","Type":"NodeParagraph","Properties":{"id":"20240614092339-uikr75q"}}]}