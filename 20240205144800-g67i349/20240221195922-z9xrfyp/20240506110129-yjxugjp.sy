th: 643px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 556px;","style":"width: 546px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫青 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫青 1-20240828093206-xo2ch0c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 546px;\" parent-style=\"width: 556px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703142748-yiei8zd","Type":"NodeParagraph","Properties":{"id":"20240703142748-yiei8zd","updated":"20240828093218"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 588px;","style":"width: 578px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫菁7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫菁7-20240703142748-4nue8mh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 578px;\" parent-style=\"width: 588px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 570px;","style":"width: 560px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫菁6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫菁6-20240703142813-8ujyive.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 560px;\" parent-style=\"width: 570px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614081928-ybxmve2","Type":"NodeParagraph","Properties":{"id":"20240614081928-ybxmve2","updated":"20240703141902"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：取图为芫菁。"}]},{"ID":"20240614081928-xxpdawy","Type":"NodeThematicBreak","Properties":{"id":"20240614081928-xxpdawy"}},{"ID":"20240614082025-ohvpu90","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082025-ohvpu90","updated":"20240614082031"},"Children":[{"Type":"NodeText","Data":"地胆《神农本草经》"}]},{"ID":"20240614082025-crt21o0","Type":"NodeParagraph","Properties":{"id":"20240614082025-crt21o0","updated":"20240614082025"},"Children":[{"Type":"NodeText","Data":"味辛寒。"}]},{"ID":"20240614082025-mc9q4xl","Type":"NodeParagraph","Properties":{"id":"20240614082025-mc9q4xl","updated":"20240614082025"},"Children":[{"Type":"NodeText","Data":"主鬼注，寒热，鼠蝼，恶创，死肌，破症瘕，堕胎。一名蚖青，生川谷。"}]},{"ID":"20240614082025-g3h71c1","Type":"NodeParagraph","Properties":{"id":"20240614082025-g3h71c1","updated":"20240614082025"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：地胆，一名元青，一名杜龙，一名青虹（《御览》）。"}]},{"ID":"20240614082025-xwsyzuf","Type":"NodeParagraph","Properties":{"id":"20240614082025-xwsyzuf","updated":"20240614082025"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名青，生汶山，八月取。"}]},{"ID":"20240614082025-cxvjedo","Type":"NodeParagraph","Properties":{"id":"20240614082025-cxvjedo","updated":"20240614082025"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：地胆蛇要，青，青也，陶宏景云：状如大马蚁，有翼，伪者即班猫所化，状如大豆。"}]},{"ID":"20240614081928-qooe944","Type":"NodeThematicBreak","Properties":{"id":"20240614081928-qooe944"}},{"ID":"20240614082016-ljtm5qb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082016-ljtm5qb","updated":"20240614082020"},"Children":[{"Type":"NodeText","Data":"地胆《本草纲目》"}]},{"ID":"20240614082016-5zlk879","Type":"NodeParagraph","Properties":{"id":"20240614082016-5zlk879","updated":"20240614082016"},"Children":[{"Type":"NodeText","Data":"「释名」芫青、青"}]},{"ID":"20240614082016-7a4kh1q","Type":"NodeParagraph","Properties":{"id":"20240614082016-7a4kh1q","updated":"20240614082016"},"Children":[{"Type":"NodeText","Data":"「气味」辛、寒、有毒。"}]},{"ID":"20240614082016-12vp99p","Type":"NodeParagraph","Properties":{"id":"20240614082016-12vp99p","updated":"20240614082016"},"Children":[{"Type":"NodeText","Data":"「主治」宣拔瘰疬，治疝积疼痛，余功同斑蝥。"}]},{"ID":"20240614082113-4f1ljow","Type":"NodeThematicBreak","Properties":{"id":"20240614082113-4f1ljow"}},{"ID":"20240614082115-t53588h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082115-t53588h","updated":"20240614082122"},"Children":[{"Type":"NodeText","Data":"地胆《本草经集注》"}]},{"ID":"20240614082115-8egj5ha","Type":"NodeParagraph","Properties":{"id":"20240614082115-8egj5ha","updated":"20240614082115"},"Children":[{"Type":"NodeText","Data":"味辛，寒，有毒。主治鬼疰，寒热，鼠瘘，恶疮，死肌，破症瘕，堕胎。蚀疮中恶肉，鼻中息肉，散结气石淋，去子，服一刀圭即下。一名蚖青，一名青蛙。生汶山川谷，八月取。（恶甘草。）"}]},{"ID":"20240614082115-1lus1yp","Type":"NodeParagraph","Properties":{"id":"20240614082115-1lus1yp","updated":"20240614082115"},"Children":[{"Type":"NodeText","Data":"真者出梁州，状如大马蚁有翼；伪者即斑蝥所化，状如大豆，大都治体略同，必不能得真尔。此亦可用，故有蚖青之名。蚖字乃异。恐是相承误矣。"}]},{"ID":"20240614081929-hj4jfg9","Type":"NodeThematicBreak","Properties":{"id":"20240614081929-hj4jfg9"}},{"ID":"20240614082006-qsgtnw4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082006-qsgtnw4","updated":"20240614082010"},"Children":[{"Type":"NodeText","Data":"地胆《千金翼方》"}]},{"ID":"20240614082006-7v9ces5","Type":"NodeParagraph","Properties":{"id":"20240614082006-7v9ces5","updated":"20240614082006"},"Children":[{"Type":"NodeText","Data":"味辛，寒，有毒。主鬼疰，寒热，鼠 ，恶疮死肌，破症瘕，堕胎，蚀疮中恶肉，鼻中息肉，散结气石淋，去子，服一刀圭，即下。一名 青，一名青蛙。生汶山川谷，八月取。"}]},{"ID":"20240614082049-hlvm9px","Type":"NodeThematicBreak","Properties":{"id":"20240614082049-hlvm9px"}},{"ID":"20240614082050-0q3yaiv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082050-0q3yaiv","updated":"20240614082056"},"Children":[{"Type":"NodeText","Data":"地胆《本经逢原》"}]},{"ID":"20240614082050-ric8izw","Type":"NodeParagraph","Properties":{"id":"20240614082050-ric8izw","updated":"20240614082050"},"Children":[{"Type":"NodeText","Data":"辛温有毒。同糯米炒，去米用。"}]},{"ID":"20240614082050-olvmgb3","Type":"NodeParagraph","Properties":{"id":"20240614082050-olvmgb3","updated":"20240614082050"},"Children":[{"Type":"NodeText","Data":"《本经》主鬼疰，寒热鼠 ，恶疮死肌，破症瘕，堕胎。"}]},{"ID":"20240614082050-af4gtks","Type":"NodeParagraph","Properties":{"id":"20240614082050-af4gtks","updated":"20240614082050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"地胆有毒而能攻毒。性专破结堕胎，又能除鼻中息肉，下石淋功同斑蝥，力能上涌下泄。"}]},{"ID":"20240614082038-da23042","Type":"NodeThematicBreak","Properties":{"id":"20240614082038-da23042"}},{"ID":"20240614082040-igetq7l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082040-igetq7l","updated":"20240614082044"},"Children":[{"Type":"NodeText","Data":"地胆《新修本草》"}]},{"ID":"20240614082040-3da42tp","Type":"NodeParagraph","Properties":{"id":"20240614082040-3da42tp","updated":"20240614082040"},"Children":[{"Type":"NodeText","Data":"味辛，寒，有毒。主鬼疰，寒热，鼠 ，恶疮，死肌，破症瘕，堕胎。蚀疮中恶肉，鼻中服一刀圭即下。一名 青，一名青蛙。生汶山川谷，八月取。"}]},{"ID":"20240614082040-ha5qyue","Type":"NodeParagraph","Properties":{"id":"20240614082040-ha5qyue","updated":"20240614082040"},"Children":[{"Type":"NodeText","Data":"恶甘草。真者出梁州，状如大马蚁有翼；伪者即斑蝥所化，状如大豆，大都疗体略同，必不能得真尔，此亦可用，故有 青之名。 字乃异，恐是相承误矣。"}]},{"ID":"20240614082040-tqb070f","Type":"NodeParagraph","Properties":{"id":"20240614082040-tqb070f","updated":"20240614082040"},"Children":[{"Type":"NodeText","Data":"〔谨案〕形如大马蚁者，今见出 州者是也。状如大豆者，未见也。"}]},{"ID":"20240614081929-7cxq09s","Type":"NodeThematicBreak","Properties":{"id":"20240614081929-7cxq09s"}},{"ID":"20240614081954-m30qmdr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081954-m30qmdr","updated":"20240614082000"},"Children":[{"Type":"NodeText","Data":"地胆《医学入门》"}]},{"ID":"20240614081954-6yaqg55","Type":"NodeParagraph","Properties":{"id":"20240614081954-6yaqg55","updated":"20240614081954"},"Children":[{"Type":"NodeText","Data":"出梁州。状如大马蚁，有翼。味辛，寒，有毒。主寒热鼠 ，恶疮死肌，蚀疮中恶肉，鼻中 肉，鼻，能宣瘰 根，从小便出。兼破石淋、 瘕，堕胎，散结气，杀鬼疰蛊毒。恶甘草。抑考陶隐居云∶此一虫五变，疗皆相似。二三月在芫花上，呼为芫青，颇似斑蝥，但纯青绿色，背上一道黄文，尖喙；四五月在王不留行上，呼王不留行虫，六七月在葛花上，呼为葛上亭长，形似芫青，但身黑而头赤，如亭长之着玄衣赤帻也；八月在豆花上，呼为斑蝥；九月、十月欲还地蛰，呼为地胆，随时变耳。各以时采，阴干，制同斑蝥。"}]},{"ID":"20240614082141-z5zlayo","Type":"NodeThematicBreak","Properties":{"id":"20240614082141-z5zlayo"}},{"ID":"20240614082142-2vzhtzy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614082142-2vzhtzy","updated":"20240614082149"},"Children":[{"Type":"NodeText","Data":"地胆《名医别录》"}]},{"ID":"20240614082142-snl70dv","Type":"NodeParagraph","Properties":{"id":"20240614082142-snl70dv","updated":"20240614082142"},"Children":[{"Type":"NodeText","Data":"有毒．蚀疮中恶肉，鼻中息肉，散结气石淋，去子．服一刀圭即下．一名青蛙，生汶八月取．（恶甘草．）"}]},{"ID":"20240614082142-vag1jrf","Type":"NodeParagraph","Properties":{"id":"20240614082142-vag1jrf","updated":"20240614082142"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶地胆，味辛，寒．主鬼注寒热，鼠 恶疮死肌，破症瘕，堕胎．一名青．生川谷．"}]},{"ID":"20240614081929-3y5sugz","Type":"NodeThematicBreak","Properties":{"id":"20240614081929-3y5sugz"}},{"ID":"20240614081930-ihm01lo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081930-ihm01lo","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：地胆"}]},{"ID":"20240614081930-ax2e2gz","Type":"NodeParagraph","Properties":{"id":"20240614081930-ax2e2gz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614081930-5gwsi97","Type":"NodeParagraph","Properties":{"id":"20240614081930-5gwsi97","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" Dì Dǎn"}]},{"ID":"20240614081930-11ypoex","Type":"NodeParagraph","Properties":{"id":"20240614081930-11ypoex","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614081930-fwc6bi4","Type":"NodeParagraph","Properties":{"id":"20240614081930-fwc6bi4","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 圆胸地胆"}]},{"ID":"20240614081930-qg8v9bk","Type":"NodeParagraph","Properties":{"id":"20240614081930-qg8v9bk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614081930-aj8bkwa","Type":"NodeParagraph","Properties":{"id":"20240614081930-aj8bkwa","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 昆虫纲鞘翅目芫菁科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"圆胸地胆芫菁"},{"Type":"NodeText","Data":"Meloe corvinus Marseul，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240614081930-oubqv42","Type":"NodeParagraph","Properties":{"id":"20240614081930-oubqv42","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614081930-wvm3ujg","Type":"NodeParagraph","Properties":{"id":"20240614081930-wvm3ujg","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 东北。"}]},{"ID":"20240614081930-9a7d0bp","Type":"NodeParagraph","Properties":{"id":"20240614081930-9a7d0bp","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614081930-w8u2gdk","Type":"NodeParagraph","Properties":{"id":"20240614081930-w8u2gdk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 辛，热；有大毒。"}]},{"ID":"20240614081930-vkw7g8b","Type":"NodeParagraph","Properties":{"id":"20240614081930-vkw7g8b","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614081930-f6kjdex","Type":"NodeParagraph","Properties":{"id":"20240614081930-f6kjdex","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 本品有大毒，内服慎用，孕妇禁用。"}]},{"ID":"20240614081930-88kmcqd","Type":"NodeParagraph","Properties":{"id":"20240614081930-88kmcqd","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614081930-g9i8bgx","Type":"NodeParagraph","Properties":{"id":"20240614081930-g9i8bgx","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 破血消癓，功毒蚀疮，引赤发泡。用于癓瘕肿块，积年顽癣，瘰疬，赘疣，痈疽不溃，恶疮死肌。"}]},{"ID":"20240614081930-stu19sh","Type":"NodeParagraph","Properties":{"id":"20240614081930-stu19sh","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614081930-1m1185n","Type":"NodeParagraph","Properties":{"id":"20240614081930-1m1185n","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 0.03～0.06g，炮制后多入丸散用。外用适量，研末或浸酒醋，或制油膏涂敷患处，不宜大面积用。"}]},{"ID":"20240614081930-tk2nadh","Type":"NodeParagraph","Properties":{"id":"20240614081930-tk2nadh","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614081930-zc98p0o","Type":"NodeParagraph","Properties":{"id":"20240614081930-zc98p0o","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614081930-0pgmxwk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081930-0pgmxwk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：地胆"}]},{"ID":"20240614081930-ydo1knm","Type":"NodeParagraph","Properties":{"id":"20240614081930-ydo1knm","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614081930-21zpkha","Type":"NodeParagraph","Properties":{"id":"20240614081930-21zpkha","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" Dì Dǎn"}]},{"ID":"20240614081930-wlhi4g9","Type":"NodeParagraph","Properties":{"id":"20240614081930-wlhi4g9","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614081930-cpl7uhi","Type":"NodeParagraph","Properties":{"id":"20240614081930-cpl7uhi","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 蚖青（《本经》），杜龙、青虹（《吴普本草》），蛇要，青蟊、青蠵（《广雅》）。"}]},{"ID":"20240614081930-ocqh1zv","Type":"NodeParagraph","Properties":{"id":"20240614081930-ocqh1zv","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614081930-f32zazp","Type":"NodeParagraph","Properties":{"id":"20240614081930-f32zazp","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614081930-0ewxf89","Type":"NodeParagraph","Properties":{"id":"20240614081930-0ewxf89","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614081930-zyqcwqf","Type":"NodeParagraph","Properties":{"id":"20240614081930-zyqcwqf","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 为芫青科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地胆"},{"Type":"NodeText","Data":"的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全虫"},{"Type":"NodeText","Data":"。 夏、秋捕捉，用沸水烫死，晒干。"}]},{"ID":"20240614081930-bkpdf9y","Type":"NodeParagraph","Properties":{"id":"20240614081930-bkpdf9y","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614081930-2941ijf","Type":"NodeParagraph","Properties":{"id":"20240614081930-2941ijf","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 体细长，长约1.8厘米。蓝黑色，有光泽。头部有稀疏的刻点，额前端有复眼1对。触角11节，雄虫的触角中央甚膨大。前胸背细，略呈圆柱形，中央束狭，有稀疏的小刻点。鞘翅短，柔软，蓝色，翅端尖细，不达尾端，翅面多直皱。足3对。具2爪。"}]},{"ID":"20240614081930-7fcxypk","Type":"NodeParagraph","Properties":{"id":"20240614081930-7fcxypk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"成虫常栖于草丛中。幼虫形长，有尾毛2条，足3对，成长后则无足而呈蛆状，栖于树皮下。"}]},{"ID":"20240614081930-0nmjb3p","Type":"NodeParagraph","Properties":{"id":"20240614081930-0nmjb3p","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614081930-zqoivvm","Type":"NodeParagraph","Properties":{"id":"20240614081930-zqoivvm","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 同米炒，至米焦黄为度，取出，去米，除去翅、足用。"}]},{"ID":"20240614081930-603i9wz","Type":"NodeParagraph","Properties":{"id":"20240614081930-603i9wz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"用地胆，以铜刀刮作末子，细研，用重绢罗筛过，研千余下用。\""}]},{"ID":"20240614081930-widtl7f","Type":"NodeParagraph","Properties":{"id":"20240614081930-widtl7f","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614081930-6r9p18n","Type":"NodeParagraph","Properties":{"id":"20240614081930-6r9p18n","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 辛，寒，有毒。"}]},{"ID":"20240614081930-tn13cnz","Type":"NodeParagraph","Properties":{"id":"20240614081930-tn13cnz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，寒。\""}]},{"ID":"20240614081930-9mi6bw2","Type":"NodeParagraph","Properties":{"id":"20240614081930-9mi6bw2","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有毒。\""}]},{"ID":"20240614081930-m8rnj5h","Type":"NodeParagraph","Properties":{"id":"20240614081930-m8rnj5h","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"辛，温，有毒。\""}]},{"ID":"20240614081930-fva9tn9","Type":"NodeParagraph","Properties":{"id":"20240614081930-fva9tn9","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614081930-266ihzv","Type":"NodeParagraph","Properties":{"id":"20240614081930-266ihzv","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 有剧毒，内服宜慎；体虚及孕妇忌服。"}]},{"ID":"20240614081930-sdwuru5","Type":"NodeParagraph","Properties":{"id":"20240614081930-sdwuru5","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"《本草经集注》：\"恶甘草。\""}]},{"ID":"20240614081930-8xtkhc2","Type":"NodeParagraph","Properties":{"id":"20240614081930-8xtkhc2","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614081930-5xus5yz","Type":"NodeParagraph","Properties":{"id":"20240614081930-5xus5yz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 攻毒，逐瘀。外用治恶疮，鼻息肉；内服治瘰疬。"}]},{"ID":"20240614081930-u0ko1kc","Type":"NodeParagraph","Properties":{"id":"20240614081930-u0ko1kc","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热，鼠瘘，恶疮死肌，破症瘕，堕胎。\""}]},{"ID":"20240614081930-it1w1tk","Type":"NodeParagraph","Properties":{"id":"20240614081930-it1w1tk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"蚀疮中恶肉、鼻中息肉，散结气石淋，去子，服一刀圭即下。\""}]},{"ID":"20240614081930-dnrhz20","Type":"NodeParagraph","Properties":{"id":"20240614081930-dnrhz20","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能宣出瘰疬根从小便出，上亦吐之；治鼻齆。\""}]},{"ID":"20240614081930-ryhimz6","Type":"NodeParagraph","Properties":{"id":"20240614081930-ryhimz6","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治疝积疼痛，余功同斑蝥。\""}]},{"ID":"20240614081930-pl4ykh9","Type":"NodeParagraph","Properties":{"id":"20240614081930-pl4ykh9","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614081930-gzt6ipq","Type":"NodeParagraph","Properties":{"id":"20240614081930-gzt6ipq","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 外用：研末敷贴、发泡或酒煮汁涂。内服：研末入丸、散。"}]},{"ID":"20240614081930-gtgpnmo","Type":"NodeParagraph","Properties":{"id":"20240614081930-gtgpnmo","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614081930-ralfhxw","Type":"NodeParagraph","Properties":{"id":"20240614081930-ralfhxw","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" ①治鼻中息肉肿大，气息闭塞不通：生地胆十枚。细辛半分（末），白芷半分（末）。上以地胆压去汁，和药末，以涂于息肉之上，取消为度。亦单以地胆汁于竹简中盛，当上灌之。无生者，即酒煮汁用之。（《圣惠方》）"}]},{"ID":"20240614081930-px2enu2","Type":"NodeParagraph","Properties":{"id":"20240614081930-px2enu2","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"②治瘰疬成疮有脓：地胆（去头、足、翅，糯米炒，令米黄）、斑猫（去头、足、翅，糯米炒，令米黄）、牛黄（别研）各一分，芫青十枚（糯米炒，令米黄，去头、翅、足），生大豆黄三十枚。上五味，捣罗四味为末，入牛黄再研匀，炼蜜为丸，如梧桐子大。每服一丸，空心茶下。（《圣济总录》地胆丸）"}]},{"ID":"20240614081930-7fkh4g2","Type":"NodeParagraph","Properties":{"id":"20240614081930-7fkh4g2","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"③治小肠气痛：地胆（去翅、足、头，微炒）、朱砂各半两，滑石一两。为末，用苦杖酒食前调服二钱。（《宣明论方》）"}]},{"ID":"20240614081930-w9e1h39","Type":"NodeParagraph","Properties":{"id":"20240614081930-w9e1h39","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614081930-7ibzpda","Type":"NodeParagraph","Properties":{"id":"20240614081930-7ibzpda","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614081930-4n3yti4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614081930-4n3yti4","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"《中华本草》：地胆"}]},{"ID":"20240614081930-nnndp5w","Type":"NodeParagraph","Properties":{"id":"20240614081930-nnndp5w","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614081930-qpom58p","Type":"NodeParagraph","Properties":{"id":"20240614081930-qpom58p","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" Dì Dǎn"}]},{"ID":"20240614081930-j7abcto","Type":"NodeParagraph","Properties":{"id":"20240614081930-j7abcto","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614081930-i5jofg1","Type":"NodeParagraph","Properties":{"id":"20240614081930-i5jofg1","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 蚖青、杜龙、青虹、蛇要、青蟊、青蠵"}]},{"ID":"20240614081930-awr8ltl","Type":"NodeParagraph","Properties":{"id":"20240614081930-awr8ltl","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614081930-2l6vtpn","Type":"NodeParagraph","Properties":{"id":"20240614081930-2l6vtpn","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" all-grass of Canton sonerila"}]},{"ID":"20240614081930-td1t3ik","Type":"NodeParagraph","Properties":{"id":"20240614081930-td1t3ik","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614081930-0qigxja","Type":"NodeParagraph","Properties":{"id":"20240614081930-0qigxja","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》《本草纲目》：地胆，今处处有之，在地中或墙石内，盖芫青、亭长之类。冬月入蛰者，状如斑蝥。芫青青绿色，斑蝥黄斑色，亭长黑身赤头，地胆黑头赤尾，色虽不同，功亦相近。"}]},{"ID":"20240614081930-dbzw3xi","Type":"NodeParagraph","Properties":{"id":"20240614081930-dbzw3xi","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614081930-vssmpqk","Type":"NodeParagraph","Properties":{"id":"20240614081930-vssmpqk","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芫青科动物地胆和长地胆的全虫。"}]},{"ID":"20240614081930-vsswmho","Type":"NodeParagraph","Properties":{"id":"20240614081930-vsswmho","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Meloe coarctatus Motschulsky2.Meloe violcews Linnaeus"}]},{"ID":"20240614081930-cnaglp8","Type":"NodeParagraph","Properties":{"id":"20240614081930-cnaglp8","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋捕捉，用沸水烫死、晒干或烘干。"}]},{"ID":"20240614081930-gzzsh4d","Type":"NodeParagraph","Properties":{"id":"20240614081930-gzzsh4d","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614081930-nqqjh9v","Type":"NodeParagraph","Properties":{"id":"20240614081930-nqqjh9v","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.成虫常栖于草丛2.中常生活于田边、路边及林缘草丛中。"}]},{"ID":"20240614081930-tbdbvef","Type":"NodeParagraph","Properties":{"id":"20240614081930-tbdbvef","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"资源分布：1.全国大部他地区均有他布。"}]},{"ID":"20240614081930-ndbj4xf","Type":"NodeParagraph","Properties":{"id":"20240614081930-ndbj4xf","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"2.他布于我国东北。"}]},{"ID":"20240614081930-18fyluj","Type":"NodeParagraph","Properties":{"id":"20240614081930-18fyluj","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614081930-3i1in5r","Type":"NodeParagraph","Properties":{"id":"20240614081930-3i1in5r","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 1.全体黑蓝色，稍带紫色，有光泽。头部大，复眼圆形，黑褐色。触角蓝色。前胸背板狭长，圆柱形。鞘翅生，柔软，翅端尖细，翅面多纵皱，全翅黑紫色，有细刻点。腹部大部分露出翅2.外长 地胆，体长18-30mm。主要特征是翅鞘极短，色黑，具粗大刻点。腹部大部分外露。肢黑色，密生毛。"}]},{"ID":"20240614081930-2u1di9q","Type":"NodeParagraph","Properties":{"id":"20240614081930-2u1di9q","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614081930-fmgcdrl","Type":"NodeParagraph","Properties":{"id":"20240614081930-fmgcdrl","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）地胆，个体较小，长18-22mm。外表 黑蓝色，雄虫触角中部膨大，鞘翅短，腹部大部分露于翅处，腹部干瘪，足和触角常有缺损，质轻而脆。气微臭，味微辛，有毒。"}]},{"ID":"20240614081930-yli1f2i","Type":"NodeParagraph","Properties":{"id":"20240614081930-yli1f2i","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"（2）长地胆，个体较大，长18-30mm，雄虫触角中部不膨大，鞘翅极短，叶片状，其他与地胆相似。"}]},{"ID":"20240614081930-tflgxgm","Type":"NodeParagraph","Properties":{"id":"20240614081930-tflgxgm","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614081930-8fjiv7h","Type":"NodeParagraph","Properties":{"id":"20240614081930-8fjiv7h","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 1.同米炒，至米焦黄为度，取出，去米，除去翅、足用。"}]},{"ID":"20240614081930-hufpmc8","Type":"NodeParagraph","Properties":{"id":"20240614081930-hufpmc8","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》:用地胆，以铜刀刮作末子,细研，用重绢罗筛过，研千余下用。"}]},{"ID":"20240614081930-zng3jhi","Type":"NodeParagraph","Properties":{"id":"20240614081930-zng3jhi","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614081930-twcjhyn","Type":"NodeParagraph","Properties":{"id":"20240614081930-twcjhyn","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 理化鉴别，取本品粉末约0.15珩微量升华，玻片上显油状物，稍冷，析出升华物，镜检呈无色杆状结晶。升华物用石油醚洗2-3次，加硫酸（相对密度1.77）2-3滴，微热，溶解后转入试管内，再继续用小火加热至发生气泡，立即离火，滴入对二氨基苯甲醛硫酸溶液1滴，溶液即显樱红色或紫红色。"}]},{"ID":"20240614081930-csjvkl5","Type":"NodeParagraph","Properties":{"id":"20240614081930-csjvkl5","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614081930-g1dd0u4","Type":"NodeParagraph","Properties":{"id":"20240614081930-g1dd0u4","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 肺经"}]},{"ID":"20240614081930-bj72zif","Type":"NodeParagraph","Properties":{"id":"20240614081930-bj72zif","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614081930-q15ow8e","Type":"NodeParagraph","Properties":{"id":"20240614081930-q15ow8e","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 味辛；性微温；有毒"}]},{"ID":"20240614081930-2rbpeyw","Type":"NodeParagraph","Properties":{"id":"20240614081930-2rbpeyw","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614081930-p3ltolx","Type":"NodeParagraph","Properties":{"id":"20240614081930-p3ltolx","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 内服宜慎，体虚者及孕妇禁服。"}]},{"ID":"20240614081930-2bpo0dw","Type":"NodeParagraph","Properties":{"id":"20240614081930-2bpo0dw","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614081930-vqf053y","Type":"NodeParagraph","Properties":{"id":"20240614081930-vqf053y","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 玫毒；逐瘀；消症。主瘰疬；恶疮；鼻息肉；症瘕痞块"}]},{"ID":"20240614081930-sukmibo","Type":"NodeParagraph","Properties":{"id":"20240614081930-sukmibo","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614081930-5gzyfhs","Type":"NodeParagraph","Properties":{"id":"20240614081930-5gzyfhs","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 外用 ：适量，研末敷贴，发泡或酒煮涂搽。内服：入丸、散，0.3-0.6g，或1-2只。"}]},{"ID":"20240614081930-vro3yi9","Type":"NodeParagraph","Properties":{"id":"20240614081930-vro3yi9","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614081930-9zctifv","Type":"NodeParagraph","Properties":{"id":"20240614081930-9zctifv","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主寒热，鼠痿，恶疮死肌，破症瘕，堕胎。"}]},{"ID":"20240614081930-wh380i5","Type":"NodeParagraph","Properties":{"id":"20240614081930-wh380i5","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"2.《别录》：蚀疮中恶肉、鼻中息肉，散结气石淋，去子，服一刀圭即下。"}]},{"ID":"20240614081930-17tf4su","Type":"NodeParagraph","Properties":{"id":"20240614081930-17tf4su","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：能宣出瘰疬根从小便出，上亦吐之；治鼻WENG。"}]},{"ID":"20240614081930-rxb5wtz","Type":"NodeParagraph","Properties":{"id":"20240614081930-rxb5wtz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治疝积疼痛，余功同斑蝥。"}]},{"ID":"20240614081930-lkhatzl","Type":"NodeParagraph","Properties":{"id":"20240614081930-lkhatzl","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614081930-9e293fz","Type":"NodeParagraph","Properties":{"id":"20240614081930-9e293fz","updated":"20240614081930"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614081931-3491ssy","Type":"NodeThematicBreak","Properties":{"id":"20240614081931-3491ssy"}},{"ID":"20240614081932-gli6zim","Type":"NodeParagraph","Properties":{"id":"20240614081932-gli6zim"}}]}