ata":"span","Properties":{"parent-style":"width: 789px;","style":"width: 779px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茜草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茜草-20240717190537-oy88nr4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 779px;\" parent-style=\"width: 789px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614124841-glxyhyx","Type":"NodeParagraph","Properties":{"id":"20240614124841-glxyhyx","updated":"20240705115310"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为茜草的根。"}]},{"ID":"20240614124841-ytud95b","Type":"NodeThematicBreak","Properties":{"id":"20240614124841-ytud95b"}},{"ID":"20240614125725-01af5vd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125725-01af5vd","updated":"20240614125727"},"Children":[{"Type":"NodeText","Data":"新绛"}]},{"ID":"20240614124841-clbe3s8","Type":"NodeParagraph","Properties":{"id":"20240614124841-clbe3s8","updated":"20240614125722"},"Children":[{"Type":"NodeText","Data":"【产地】即大红帽之纬也。\n【性味】烧炙后用，味苦辛。\n【主治】主要用于止血行血。\n【用量】一般五分至一钱。\n【禁忌】忌与活血化血之药同用。"}]},{"ID":"20240614124842-s63jah1","Type":"NodeThematicBreak","Properties":{"id":"20240614124842-s63jah1"}},{"ID":"20240614124956-59r7ras","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124956-59r7ras","updated":"20240614125746"},"Children":[{"Type":"NodeText","Data":"新绛《长沙药解》"}]},{"ID":"20240614124956-xz891x0","Type":"NodeParagraph","Properties":{"id":"20240614124956-xz891x0","updated":"20240614124956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614124956-pxd3dpw","Type":"NodeParagraph","Properties":{"id":"20240614124956-pxd3dpw","updated":"20240614124956"},"Children":[{"Type":"NodeText","Data":"味平，入足厥阴肝经。行经脉而通瘀涩，敛血海而止崩漏。"}]},{"ID":"20240614124956-tdkrjgd","Type":"NodeParagraph","Properties":{"id":"20240614124956-tdkrjgd","updated":"20240614124956"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆花汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在旋覆花。"},{"Type":"NodeText","Data":"用之治妇女半产漏下，以其敛血而止漏泄也。新绛利水渗湿，湿去则木达而血升，故能止崩漏。其诸主治，止崩漏、吐衄、泄利诸血，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"诸血证皆缘土湿，以中气湿郁，故上溢而下泄也。"},{"Type":"NodeText","Data":"除男子"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"消渴，消渴，厥阴风木之病，亦缘太阴土湿。"},{"Type":"NodeText","Data":"通产后淋沥。"}]},{"ID":"20240614124956-dg7tllx","Type":"NodeParagraph","Properties":{"id":"20240614124956-dg7tllx","updated":"20240614124956"},"Children":[{"Type":"NodeText","Data":"止血，烧灰存性，研用。消渴、淋沥，煮汤，温服。"}]},{"ID":"20240614124842-d5flzih","Type":"NodeThematicBreak","Properties":{"id":"20240614124842-d5flzih"}}]}