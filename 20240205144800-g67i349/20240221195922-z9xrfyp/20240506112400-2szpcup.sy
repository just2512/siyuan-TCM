{"ID":"20240506112400-2szpcup","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506112400-2szpcup","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506112400-2szpcup\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506112400-v47mak7\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614122525-op9xx73\u0026quot;,\u0026quot;scrollTop\u0026quot;:2631,\u0026quot;focusId\u0026quot;:\u0026quot;20240614123149-e197s8z\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"376补19猪胆、猪肤","type":"doc","updated":"20240828143540"},"Children":[{"ID":"20240704174503-weckudo","Type":"NodeParagraph","Properties":{"id":"20240704174503-weckudo","updated":"20240704174503"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704174503-9d8ynhk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704174732-x496zjz","Type":"NodeParagraph","Properties":{"id":"20240704174732-x496zjz","updated":"20240704174732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 411px;","style":"width: 401px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪肤"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪肤-20240704174732-8vu9ixa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 401px;\" parent-style=\"width: 411px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828143540-hxxkyrz","Type":"NodeParagraph","Properties":{"id":"20240828143540-hxxkyrz","updated":"20240828143540"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪-20240703083235-1cqkaas.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪4-20240703083744-smeob73.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828143540-8t8r70n","Type":"NodeParagraph","Properties":{"id":"20240828143540-8t8r70n","updated":"20240828143540"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪5-20240703083821-jcs47mh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪3-20240703083629-w7cqxy6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828143540-1768tf2","Type":"NodeParagraph","Properties":{"id":"20240828143540-1768tf2","updated":"20240828143540"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 632px;","style":"width: 622px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猪2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猪2-20240703083556-qp612ky.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 622px;\" parent-style=\"width: 632px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 705px;","style":"width: 695px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"公野猪 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/公野猪 1-20240827173100-x8t3utv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 695px;\" parent-style=\"width: 705px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614122521-sqycdoo","Type":"NodeThematicBreak","Properties":{"id":"20240614122521-sqycdoo"}},{"ID":"20240614122842-2pywouk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122842-2pywouk","updated":"20240614122848"},"Children":[{"Type":"NodeText","Data":"猪胆汁《汤液本草》"}]},{"ID":"20240614122842-se7nmds","Type":"NodeParagraph","Properties":{"id":"20240614122842-se7nmds","updated":"20240614122842"},"Children":[{"Type":"NodeText","Data":"气寒，味苦、咸。苦，寒。"}]},{"ID":"20240614122842-55wwtvn","Type":"NodeParagraph","Properties":{"id":"20240614122842-55wwtvn","updated":"20240614122842"},"Children":[{"Type":"NodeText","Data":"《液》云∶仲景白通汤，加此汁，与人尿咸寒，同与热剂合，去格拒之寒。又，与醋相合，内谷道中，酸苦益阴，以润燥泻便。"}]},{"ID":"20240614122842-6489zwz","Type":"NodeParagraph","Properties":{"id":"20240614122842-6489zwz","updated":"20240614122842"},"Children":[{"Type":"NodeText","Data":"《本经》云∶治伤寒热渴。又∶白猪蹄，可用；杂青色者，不可食，疗疾亦不可。"}]},{"ID":"20240614122842-yzfg7tu","Type":"NodeParagraph","Properties":{"id":"20240614122842-yzfg7tu","updated":"20240614122842"},"Children":[{"Type":"NodeText","Data":"《心》云∶与人尿同体，补肝而和阴引置阳，不被格拒，能入心而通脉。"}]},{"ID":"20240614122521-9u19kwf","Type":"NodeThematicBreak","Properties":{"id":"20240614122521-9u19kwf"}},{"ID":"20240614122831-kof7s9j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122831-kof7s9j","updated":"20240614122836"},"Children":[{"Type":"NodeText","Data":"猪胆汁《长沙药解》"}]},{"ID":"20240614122831-uoe4ln1","Type":"NodeParagraph","Properties":{"id":"20240614122831-uoe4ln1","updated":"20240614122831"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614122831-txqs1m2","Type":"NodeParagraph","Properties":{"id":"20240614122831-txqs1m2","updated":"20240614122831"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入足少阳胆经。清相火而止干呕，润大肠而通结燥。"}]},{"ID":"20240614122831-1g4fqm5","Type":"NodeParagraph","Properties":{"id":"20240614122831-1g4fqm5","updated":"20240614122831"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白通加猪胆汁汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"葱白四茎，干姜一两，生附子一枚，人尿五合，猪胆汁一合。"},{"Type":"NodeText","Data":"治少阴病下利，厥逆无脉，干呕心烦者。以水寒土败，君相皆飞，甲木克胃，故生干呕，丁火失根，故觉心烦。猪胆汁清相火而止呕，人尿清君火而除烦也。"}]},{"ID":"20240614122831-e0mbicv","Type":"NodeParagraph","Properties":{"id":"20240614122831-e0mbicv","updated":"20240614122831"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通脉四逆加猪胆汁汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"甘草三两，干姜三两，大附子一枚，猪胆汁半合。"},{"Type":"NodeText","Data":"治霍乱吐下既止，汗出而厥，四肢拘急，脉微欲绝者。以相火逆升，汗孔疏泄，猪胆汁清相火而止汗也。"}]},{"ID":"20240614122831-rsilmcn","Type":"NodeParagraph","Properties":{"id":"20240614122831-rsilmcn","updated":"20240614122831"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪胆汁方"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大猪胆一枚，泻汁，和醋少许，灌谷道中，食顷，当大便出。"},{"Type":"NodeText","Data":"治阳明病，自汗出，小便利，津液内竭，大便硬者。以汗出水利，津亡便硬，证非胃实，不可攻下，猪胆汁合醋，清大肠而润燥也。"}]},{"ID":"20240614122831-4j0fh4g","Type":"NodeParagraph","Properties":{"id":"20240614122831-4j0fh4g","updated":"20240614122831"},"Children":[{"Type":"NodeText","Data":"猪胆汁苦寒滋润，泻相火而润燥金，胆热肠燥者宜之。"}]},{"ID":"20240614122521-5aaua30","Type":"NodeThematicBreak","Properties":{"id":"20240614122521-5aaua30"}},{"ID":"20240614122809-uacu28t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122809-uacu28t","updated":"20240614122815"},"Children":[{"Type":"NodeText","Data":"猪胆《本草乘雅半偈》"}]},{"ID":"20240614122809-6kzn4sq","Type":"NodeParagraph","Properties":{"id":"20240614122809-6kzn4sq","updated":"20240614122809"},"Children":[{"Type":"NodeText","Data":"（别录下品）"}]},{"ID":"20240614122809-8k226c3","Type":"NodeParagraph","Properties":{"id":"20240614122809-8k226c3","updated":"20240614122809"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，无毒。"}]},{"ID":"20240614122809-pi1rtly","Type":"NodeParagraph","Properties":{"id":"20240614122809-pi1rtly","updated":"20240614122809"},"Children":[{"Type":"NodeText","Data":"【主治】主伤寒热渴。陈藏器曰∶敷小儿头疮，治大便不通，以苇筒纳入下部三寸，灌之立下。"}]},{"ID":"20240614122809-tq8fxc7","Type":"NodeParagraph","Properties":{"id":"20240614122809-tq8fxc7","updated":"20240614122809"},"Children":[{"Type":"NodeText","Data":"【核】曰∶猪豕也，易击坎为豕，性趋下俯首，喜卑秽。天将雨，则进涉水波，为水畜也。盖十二子，亥为豕，故亥象形。以一阴生于午，至亥而六阴备，谓其嫌于无阳也。是以猪之在物，以从豕，在气，以从亥，其应水也，为能克其类焉。牝曰 ，曰彘；牡曰KT ，曰。皮肤血肉、筋骨髓脑、脏腑膏膜、头胪脬卵、悬蹄耳垢、 汤绳缚，咸归药用。若豕，其"}]},{"ID":"20240614122809-r8vl0dd","Type":"NodeParagraph","Properties":{"id":"20240614122809-r8vl0dd","updated":"20240614122809"},"Children":[{"Type":"NodeText","Data":"【 】曰∶胆者，肝之腑、谋虑决断之所出焉。经云∶十一脏皆取决于胆、其所赖以断判流行者众矣。囊皮裹汁，气用为先，是非块然肉好之比。性濡滑，味大苦，气大寒，大凡火热为眚，燥涸为证者，对待治之。至续脉慰劳，利肠涤垢此则气用前通，并得洁齐形脏。盖胆者，甲乙之始，阴阳之兆，所赖以断判行流，岂小补云乎哉。"}]},{"ID":"20240614122521-4hcq6qa","Type":"NodeThematicBreak","Properties":{"id":"20240614122521-4hcq6qa"}},{"ID":"20240614122753-mthxq95","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122753-mthxq95","updated":"20240614122801"},"Children":[{"Type":"NodeText","Data":"猪胆汁《中药学》"}]},{"ID":"20240614122753-8gcduto","Type":"NodeParagraph","Properties":{"id":"20240614122753-8gcduto","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【药用】本品为猪的胆汁。"}]},{"ID":"20240614122753-dy29q03","Type":"NodeParagraph","Properties":{"id":"20240614122753-dy29q03","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。入心、肝、胆经。"}]},{"ID":"20240614122753-r2s8sj5","Type":"NodeParagraph","Properties":{"id":"20240614122753-r2s8sj5","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【功效】清热解毒。"}]},{"ID":"20240614122753-7uliayn","Type":"NodeParagraph","Properties":{"id":"20240614122753-7uliayn","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于目赤肿痛、肺热咳嗽、百日咳、湿热黄疸等症。"}]},{"ID":"20240614122753-0yuss27","Type":"NodeParagraph","Properties":{"id":"20240614122753-0yuss27","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"猪胆汁的清热解毒作用比较显着，为临床所常用。如用治肝火上炎、目赤肿痛，以及小儿百日咳，都可单用本品隔水蒸熟饮服；用治老年慢性支气管炎，也可配合白花蛇舌草、平地木等同用。此外，据报导对黄疸传染性肝炎也有一定疗效。"}]},{"ID":"20240614122753-v2kel83","Type":"NodeParagraph","Properties":{"id":"20240614122753-v2kel83","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【处方用名】猪胆汁（用新鲜的胆汁或煎熬成膏用）"}]},{"ID":"20240614122753-g5lxvqf","Type":"NodeParagraph","Properties":{"id":"20240614122753-g5lxvqf","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，炖服，胆汁膏每服三分。"}]},{"ID":"20240614122753-n0d2dx9","Type":"NodeParagraph","Properties":{"id":"20240614122753-n0d2dx9","updated":"20240614122753"},"Children":[{"Type":"NodeText","Data":"【按语】动物的胆汁供药用的颇多，如鸭胆汁治百日咳；羊胆汁用治肺结核；蛇胆汁用治目疾、风湿痛；熊胆汁用治肝热目赤、热摁抽搐等。但是，青鱼胆有毒，不宜服用。"}]},{"ID":"20240614122521-edstbzo","Type":"NodeThematicBreak","Properties":{"id":"20240614122521-edstbzo"}},{"ID":"20240614122612-sohzah7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122612-sohzah7","updated":"20240614122616"},"Children":[{"Type":"NodeText","Data":"猪胆《本草易读》"}]},{"ID":"20240614122612-pdgaklf","Type":"NodeParagraph","Properties":{"id":"20240614122612-pdgaklf","updated":"20240614122612"},"Children":[{"Type":"NodeText","Data":"瘭疽出汗，手足肩背累累如赤豆者是也。剥净涂之。（验方第一。）"}]},{"ID":"20240614122612-kyck63z","Type":"NodeParagraph","Properties":{"id":"20240614122612-kyck63z","updated":"20240614122612"},"Children":[{"Type":"NodeText","Data":"大便硬结，取汁纳肛中。（第二。）"}]},{"ID":"20240614122612-ig7117u","Type":"NodeParagraph","Properties":{"id":"20240614122612-ig7117u","updated":"20240614122612"},"Children":[{"Type":"NodeText","Data":"大便火结，取汁点服之。（第三。）"}]},{"ID":"20240614122612-7rh35rc","Type":"NodeParagraph","Properties":{"id":"20240614122612-7rh35rc","updated":"20240614122612"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白通加胆汁汤"},{"Type":"NodeText","Data":"干姜 附子 葱白 胆汁 人尿水煎服。治下痢不止，厥逆无脉，干呕。（诸方第一。）"}]},{"ID":"20240614122612-yvqhahk","Type":"NodeParagraph","Properties":{"id":"20240614122612-yvqhahk","updated":"20240614122612"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪胆鸡子汤"},{"Type":"NodeText","Data":"胆汁 苦酒 鸡子合煎服，出汗。治伤寒斑出。（第二。）"}]},{"ID":"20240614122612-19cltfg","Type":"NodeParagraph","Properties":{"id":"20240614122612-19cltfg","updated":"20240614122612"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆汁丸"}]},{"ID":"20240614122612-2dy6rmm","Type":"NodeParagraph","Properties":{"id":"20240614122612-2dy6rmm","updated":"20240614122612"},"Children":[{"Type":"NodeText","Data":"将胆汁熬稠，丸米大，每纳一丸目中。治目翳目盲。（第三。）"}]},{"ID":"20240614123042-muev41m","Type":"NodeThematicBreak","Properties":{"id":"20240614123042-muev41m"}},{"ID":"20240614123043-af3g0ww","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123043-af3g0ww","updated":"20240614123050"},"Children":[{"Type":"NodeText","Data":"猪肤《本草蒙筌》"}]},{"ID":"20240614123043-50n1jeg","Type":"NodeParagraph","Properties":{"id":"20240614123043-50n1jeg","updated":"20240614123043"},"Children":[{"Type":"NodeText","Data":"味甘，气微寒。无毒。猪养甚多，择健猪中，遍身纯黑色者才妙；肤论弗一，系 猪时，附皮薄黑肤者为真。先哲尝言∶浅肤之义，《礼韵疏》曰∶肤革外薄皮，肤内浓皮，亦指此也。《汤液》云∶猪为水畜之流，（猪之性能水，牧猪之所必择水草之交，故曰水畜也。）其气必先入肾。少阴客热，惟此解之。仲景制猪肤汤，深义盖本诸此。加白蜜润燥除烦，和白粉益气断痢。劫去"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪卵"},{"Type":"NodeText","Data":"，即双睾丸。却小儿惊悸癫痫，驱大人鬼疰蛊毒。疗五癃挛缩，治寒热贲豚。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四蹄"},{"Type":"NodeText","Data":"主伤挞溃疡，更下乳汁；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"悬蹄"},{"Type":"NodeText","Data":"去悬痈内蚀，仍理痔疮。"}]},{"ID":"20240614123043-04uir0d","Type":"NodeParagraph","Properties":{"id":"20240614123043-04uir0d","updated":"20240614123043"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心"},{"Type":"NodeText","Data":"托心气镇惊，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾"},{"Type":"NodeText","Data":"主脾伤除热。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肺"},{"Type":"NodeText","Data":"食多补肺，且治肺咳连声，（得火麻仁尤良。）若共白花菜煮尝，紧防滞气；食多损阳，亦治肺胀喘急，欲炼缯绢帛洁净，必用合膏。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆中汁"},{"Type":"NodeText","Data":"纳谷道通便，解伤寒热渴；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心内血"},{"Type":"NodeText","Data":"（初剖猪腹取出时，勿沾水，切开得之。）丸诸药养血，（安神丸必用。）禁邪梦纷纭。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌"},{"Type":"NodeText","Data":"煮浓汤，益无阳健脾进食；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肝"},{"Type":"NodeText","Data":"炙燥热，纳阴户止养引虫。（不次纳入则虫俱引出，而痒自止也。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾"},{"Type":"NodeText","Data":"止腰疼，古方煨肾散可睹；肚扶胃弱，新刊莲肚丸须知。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":"多食令人虚肥，动风动痰亦速，仍闭血脉，损筋骨勿谓无伤；乳频进使人润泽，生精生血可知，更禁猪痫，除天吊（脐风撮口尤验。）诚为有益。乳头煮啖却鬼毒，及寒热五癃；牙齿烧灰镇惊风，并蛇虫伤齿。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肪膏"},{"Type":"NodeText","Data":"利血脉，解风热润肺。脂油悦皮肤，涂疮疥杀虫。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脑髓"},{"Type":"NodeText","Data":"治头 脑鸣，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鬃膏"},{"Type":"NodeText","Data":"涂发落鬓秃。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大肠脏"},{"Type":"NodeText","Data":"捣连壳丸内，（黄连酒煮十两，枳壳麸炒四两，以大肠脏七寸，入水浸糯米于内，蒸烂捣为丸。）能消内痔益肠；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"疹骨髓"},{"Type":"NodeText","Data":"入补阴丸中，可助真阴生髓。血补中风眩晕，贲豚暴气、海外瘴气齐驱；屎消中湿肿黄，天行疫毒，腹胀蛊毒并解。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳中垢"},{"Type":"NodeText","Data":"亦有验，能敷虫啮蛇伤。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪窠草"},{"Type":"NodeText","Data":"止小儿客忤夜啼，安席下勿令母见；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪汤"},{"Type":"NodeText","Data":"理产妇血刺心痛，饮腹内何惧证危。"}]},{"ID":"20240614123043-rya37rn","Type":"NodeParagraph","Properties":{"id":"20240614123043-rya37rn","updated":"20240614123043"},"Children":[{"Type":"NodeText","Data":"（谟）按∶猪饲养甚多，盖图生息繁，食物寡容易长大；人啖食弗厌，乃嗜脂膏盛，筋膜少不胜滑肥。《本经》款中，戒勿多食。是又有所据也。丹溪云∶猪肉惟补气，补气即补阳。人身中阳常有余，阴常不足。凡患虚损证者，俱属阴虚，谓多食肉能补。是犹以火济火，反助有余，愈损不足，安能保长寿哉？何者？内性本热，入胃则热便作，热作则痰生，痰生则气不升降。诸证之至，岂有已耶！予每见患感者食之，证愈增剧。患疟者食之，寒热复来。患金疮食之，血滚衰涸。肥人多食，动风发痰。瘦人多食，助火作热。是皆助其有余之邪，而犯不戒之韪也。孔子曰∶肉虽多，不使胜，食气。圣人亦此戒人，岂无意欤？"}]},{"ID":"20240614123055-vbtq04t","Type":"NodeThematicBreak","Properties":{"id":"20240614123055-vbtq04t"}},{"ID":"20240614123056-v30gsvj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123056-v30gsvj","updated":"20240614123102"},"Children":[{"Type":"NodeText","Data":"猪肤《本草分经》"}]},{"ID":"20240614123056-xiip2b1","Type":"NodeParagraph","Properties":{"id":"20240614123056-xiip2b1","updated":"20240614123056"},"Children":[{"Type":"NodeText","Data":"古注性寒味甘，治咽痛。猪水畜也，其气先入肾，解少阴客热，肤者肌肤之义，宜用猪皮上黑肤也。按∶仪礼注云肤豕肉也，惟 者有肤， 字本作 训，为火热又云火熟物也， 此则明是取猪肉火炙而用其皮上烧焦之肤皮矣乃有用，生猪皮者大谬。"}]},{"ID":"20240614123108-r9lv2wr","Type":"NodeThematicBreak","Properties":{"id":"20240614123108-r9lv2wr"}},{"ID":"20240614123127-f8jvu5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123127-f8jvu5j","updated":"20240614123133"},"Children":[{"Type":"NodeText","Data":"猪肤《长沙药解》"}]},{"ID":"20240614123127-lr5rw1h","Type":"NodeParagraph","Properties":{"id":"20240614123127-lr5rw1h","updated":"20240614123127"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614123127-8xpq4pn","Type":"NodeParagraph","Properties":{"id":"20240614123127-8xpq4pn","updated":"20240614123127"},"Children":[{"Type":"NodeText","Data":"味甘，微寒，入手太阴肺经。利咽喉而消肿痛，清心肺而除烦满。"}]},{"ID":"20240614123127-5bdo35n","Type":"NodeParagraph","Properties":{"id":"20240614123127-5bdo35n","updated":"20240614123127"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪肤汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"猪肤一斤，白蜜一斤，白粉五合。"},{"Type":"NodeText","Data":"治少阴病，下利咽痛，胸满心烦者。以少阴寒水，侵侮脾胃，脾土下陷，肝脾不升，则为下利。胃土上逆，胆胃不降，相火刑金，则为咽痛。浊气冲塞，宫城不清，则胸满而心烦。猪肤、白蜜，清金而止痛，润燥而除烦，白粉涩滑溏而收泄利也。"}]},{"ID":"20240614123127-h9wt1ot","Type":"NodeParagraph","Properties":{"id":"20240614123127-h9wt1ot","updated":"20240614123127"},"Children":[{"Type":"NodeText","Data":"肺金清凉而司皮毛，猪肤秉金气之凉肃，善于清肺。肺气清降，君相归根，则咽痛与烦满自平也。猪膏在四卷。"}]},{"ID":"20240614123147-dbvs4i9","Type":"NodeThematicBreak","Properties":{"id":"20240614123147-dbvs4i9"}},{"ID":"20240614123149-e197s8z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123149-e197s8z","updated":"20240614123154"},"Children":[{"Type":"NodeText","Data":"猪肤《汤液本草》"}]},{"ID":"20240614123149-zc34avw","Type":"NodeParagraph","Properties":{"id":"20240614123149-zc34avw","updated":"20240614123149"},"Children":[{"Type":"NodeText","Data":"气寒，味甘。"}]},{"ID":"20240614123149-o14iry7","Type":"NodeParagraph","Properties":{"id":"20240614123149-o14iry7","updated":"20240614123149"},"Children":[{"Type":"NodeText","Data":"入足少阴经。"}]},{"ID":"20240614123149-b045prd","Type":"NodeParagraph","Properties":{"id":"20240614123149-b045prd","updated":"20240614123149"},"Children":[{"Type":"NodeText","Data":"《液》云∶猪皮，味甘，寒。猪，水畜也，其气先入肾。解少阴客热，是以猪肤解之，加白蜜，以润燥除烦；白粉，以益气断痢。"}]},{"ID":"20240614123138-xz2ow3b","Type":"NodeThematicBreak","Properties":{"id":"20240614123138-xz2ow3b"}},{"ID":"20240614123139-g0f34g3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123139-g0f34g3","updated":"20240614123143"},"Children":[{"Type":"NodeText","Data":"猪肤《本草思辨录》"}]},{"ID":"20240614123139-xkysz76","Type":"NodeParagraph","Properties":{"id":"20240614123139-xkysz76","updated":"20240614123139"},"Children":[{"Type":"NodeText","Data":"少阴之热，上为咽痛，以少阴同气之物而留连于上以除热，非猪肤莫任。故医家多用此取效，而仲圣猪肤汤实开其先，今试以鄙说备一解焉。下利、咽痛、心烦，皆少阴病，惟胸满疑涉少阳，不知少阴脉之支别，从肺出络心注胸中。下利既泄其肾阴，其虚阳之上乘者，遂得因中土无权，纷扰于经气所到之处，而致咽痛与胸满心烦。以其虚而非实，故胸满不至于痛，不必用攻陷之剂。此时伏邪初发，尚未由血及气，亦无事于苦寒伤正。猪水畜而肤甘寒轻浮，自能从上引下而客热以平。然下利非湿也，非加白蜜，不足以润燥益阴。患见于上下则宜建中，非加白粉熬香，不足以悦脾振困。此证无与于少阳固矣，而邹氏更以痉病用大承气汤有胸满字，为涉阳明之据，又岂足为训欤。"}]},{"ID":"20240614123121-tmc3ylh","Type":"NodeThematicBreak","Properties":{"id":"20240614123121-tmc3ylh"}},{"ID":"20240614123122-8ngi8bo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123122-8ngi8bo"},"Children":[{"Type":"NodeText","Data":"猪肤《冯氏锦囊秘录》"}]},{"ID":"20240614123110-v7twpyq","Type":"NodeParagraph","Properties":{"id":"20240614123110-v7twpyq","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"猪肤，即猪皮也。仲景治足少阴下利，咽痛胸满心烦者，有猪肤汤。用猪肤一斤，水一斗，煮五升，取汁，入白蜜一升，白粉五合，熬香分服。盖取其性甘寒，气先入肾，以解少阴客热，加白蜜以润燥除烦，白粉以益气断利也。猪乃水畜，在辰属亥，在卦属坎，其肉气味虽寒，多食令人暴肥，性能作湿生痰，易惹风热，殊无利益。悬蹄乃蹄甲之悬起不着地者，味咸寒无毒，入手足阳明经，咸寒能除肠胃之湿热，故主五痔伏热，肠痈内蚀。得牛角腮、槐角子、 皮、象牙末、金头蜈蚣、蛀竹屑、明矾、地榆、青黛、白蜡、治通肠痔漏，令漏管自出。又治痘后目翳半年已上者，用猪悬蹄三两（瓦瓶固济）、 蝉蜕一两、羚羊角三钱为末，每岁一字，三岁以上二钱，温水服。日三次，一月取效。猪四足，味甘、咸，气寒，主下乳汁，伤挞败疮，外科有猪蹄汤，为洗痈疽渍疡之要药。人乳属阳明，脉弱则乳汁不通。能益阳明经气血，故能下乳。伤挞败疮，必血热作病，甘咸而寒，故凉血止痛，煮汤以洗溃疡，亦此义耳。猪肾，味咸，气冷，能泻肾气，肾虚寒者不宜食。《本经》云∶主理肾气，通利膀肤，乃借其同气以引导之，不言补而言理，意有在矣。肾与膀胱为表里，故复能利膀胱也。今人认为补肾，恣意食之大为有损，日华子云∶久食令人无子，孟诜云∶久食令人伤肾。盖猪被戮时，其惊气入心，绝气归肾，病后尤勿多食，以其性冷而无生发之气耳。猪胆，主伤寒热渴，盖胆味苦气寒，总曰“热淫于内，寒以胜之，苦以泄之”，故主伤寒热渴也。又仲景胆导法，以猪胆汁和醋少许，灌谷道中，通大便神效。入猪牙皂角，细末二分，搅匀更速，盖取酸苦，益阴润燥而泻便也。又治少阴下利不止，厥逆无脉，干呕烦者，以白通汤加猪胆汁主之，使同气相从而无拒格之患，此寒因热用，热因寒用之义也。葱白四茎、干姜一两、生附子一枚、米三升、煮一升，入人尿五合，猪胆汁一合，分服。猪肚，主止渴利，补中益气。夫猪肚属土，味甘，气微温，乃猪一身无害之物，为补脾胃之要品，脾胃得补则中气益而渴利自止矣。日华子云∶“主补虚损。”苏颂云∶“主骨蒸劳热。”血脉不行，皆取其补益脾胃，则精血自生，虚劳自愈，根本固而五脏皆安也。"}]},{"ID":"20240614123110-6d4hcwh","Type":"NodeParagraph","Properties":{"id":"20240614123110-6d4hcwh","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"《普济方》∶治水泻不止，用猪肤一枚，煮烂，入平胃散，捣丸服效。仲景方∶猪肚黄连丸，治消渴，用猪肚一枚，入黄连末五两、栝蒌根、白粱米各四两、知母三两、麦门冬二两、缝定蒸熟捣丸，梧子大，每服三十丸，米饮下。《千金方》∶温养胎气，胎至九月，消息，用猪肚一枚，如常着五味煮食，至尽。又猪肚丸，治脏毒下血，黄连一味，为细末，量肚大小实之，煮令极烂，捣匀为丸，梧子大。又方，治腹胀大，用乌芋去皮，入雄肚线缝，砂器煮糜食之。勿入盐。治效可见如此其功矣。肪膏即脂油也。"}]},{"ID":"20240614123110-czfejha","Type":"NodeParagraph","Properties":{"id":"20240614123110-czfejha","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"味甘气寒性滑泽，能凉血解毒润燥，故主煎诸膏药解斑蝥、芫青毒也。又能利肠胃，通大小便，散风热，疗恶疮者，甘寒之功也《万氏方》∶治肺热暴喑。猪脂油一斤，炼过，入白蜜一斤，再炼少倾，滤净，冷定。不时挑服一匙即愈，乃润燥之力也。胰，一名肾脂，生两肾中间，似脂非脂，似肉非肉，俗名胰干，乃人物之命门、三焦发原处也。主肺痿咳嗽，肺气干胀喘急，润五脏，去皴 等症，盖甘寒滑泽之物，甘寒则津液生，滑泽则垢腻去，和枣肉浸酒服，亦主 癖，羸瘦，然男子多食，损阳薄大肠，盖其功专去垢腻，故染家凡浣垢衣必用此也。"}]},{"ID":"20240614123110-fcyhvgu","Type":"NodeParagraph","Properties":{"id":"20240614123110-fcyhvgu","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"按∶猪为食味中常用之物，脏腑肠胃，咸无弃焉。然一身除肚膏外，余皆有毒发病，壮实者，或暂食无害，有疾者不可不忌，故列其害于后。肉，多食令人虚肥，生痰热，热病后食之复发。头肉食起生风发疾，脑食之损男子阳道，临房不能行事，酒后尤不可食。血，能败血损阳，服地黄首乌诸补药者，尤忌之，多食耗心气。肝，服药人不可食，合鱼 食生痈疽，合鲤鱼肠子食，伤人神，且猪临宰惊气入心，绝气归肝，故俱不可多食。肺不可与白花菜合食，令人气滞发霍乱，八月和饴食，至冬发疽。肾久食令人损阳。肠，多食动冷气。鼻唇多食动风舌多食损心。"}]},{"ID":"20240614123110-l9scx1m","Type":"NodeParagraph","Properties":{"id":"20240614123110-l9scx1m","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"猪肤，多飧令人虚肥，动风发痰，但虚损精血不足者，暂供口吻，补之以味也。仲景论猪肤汤，取性甘寒，气先入肾，少阴客热燥气，可以解之，总血肉之类，借充口腹。若调养得所，则为长养气血之需，倘动静乖张，则为发热生痰之本，况万物主味者则柔，每多柔嫩之功不全赖以重轻，主气者则刚，便有刚烈之体。损益凭之以消长，肥脂血肉，必润而下，五谷甘淡，必平而缓，非若草木得偏气，而有大力也。劫出猪卵，即双睾丸，小儿惊悸癫痫，大人鬼疰蛊毒，五癃挛缩，寒热奔豚。四蹄能下乳汁。心，托心气镇惊。脾，主脾伤除热。肺，补肺治咳声连。 ，食多损阳亦主肺胀喘咳。胆中汁纳谷道便通。新剖心内血，丸诸药，养血安神，丸中必用，禁邪梦纷纭。舌煮浓汤，益元阳健脾进食。肝炙燥热纳阴户止痒引虫。肾止腰痛，煨肾散可服。冬月忌食。肚扶脾弱，莲肚丸堪尝。乳使人润泽，生精生血，除天吊猪痈，脐风撮口。脂油敷疮疥杀虫。脑髓治脑鸣头眩，一云能令滑精。大肠捣连壳丸内，能消五痔益肠。脊骨髓入补阴丸中，可助真阴生髓。除脊痛，退骨蒸，调寒水石，治汤烫火伤，血补中风眩晕，奔豚暴气。屎消中湿肿，黄时疫。肿胀蛊毒。猪窠草密置席下，止小儿客忤夜啼。"}]},{"ID":"20240614123110-1pn3f5q","Type":"NodeParagraph","Properties":{"id":"20240614123110-1pn3f5q","updated":"20240614123110"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 猪肉，宜少盐腌，饭中煮食，则脾胃不伤，借其动风之性，可助发生，且血肉以补血肉也。"}]},{"ID":"20240614122924-q361s53","Type":"NodeThematicBreak","Properties":{"id":"20240614122924-q361s53"}},{"ID":"20240614122925-yhaamu8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122925-yhaamu8","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：猪胆"}]},{"ID":"20240614122925-yb0y0ye","Type":"NodeParagraph","Properties":{"id":"20240614122925-yb0y0ye","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122925-7hpixaz","Type":"NodeParagraph","Properties":{"id":"20240614122925-7hpixaz","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" Zhū Dǎn"}]},{"ID":"20240614122925-rdvuaqv","Type":"NodeParagraph","Properties":{"id":"20240614122925-rdvuaqv","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122925-5p4n74p","Type":"NodeParagraph","Properties":{"id":"20240614122925-5p4n74p","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240614122925-9ulo39b","Type":"NodeParagraph","Properties":{"id":"20240614122925-9ulo39b","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122925-xxa1ygo","Type":"NodeParagraph","Properties":{"id":"20240614122925-xxa1ygo","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 为猪科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆汁"},{"Type":"NodeText","Data":"，取得后，挂起晾干，或在半干时稍稍压扁，再干燥之。"}]},{"ID":"20240614122925-x02j6uu","Type":"NodeParagraph","Properties":{"id":"20240614122925-x02j6uu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122925-f1lryz6","Type":"NodeParagraph","Properties":{"id":"20240614122925-f1lryz6","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 动物形态详\"猪肉\"条。"}]},{"ID":"20240614122925-kpv3711","Type":"NodeParagraph","Properties":{"id":"20240614122925-kpv3711","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122925-biwprlp","Type":"NodeParagraph","Properties":{"id":"20240614122925-biwprlp","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 胆汁中主要成分为胆汁酸类、胆色素、粘蛋白、脂类及无机物等。胆汁酸中有鹅脱氧胆酸、3α-羟基-6-氧-5α-胆烷酸和石胆酸，它们几乎完全与甘氨酸结合而存在。另含猪胆酸和猪脱氧胆酸。"}]},{"ID":"20240614122925-0lco7d1","Type":"NodeParagraph","Properties":{"id":"20240614122925-0lco7d1","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614122925-yb3welt","Type":"NodeParagraph","Properties":{"id":"20240614122925-yb3welt","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" ①镇咳、平喘作用"}]},{"ID":"20240614122925-e989r3x","Type":"NodeParagraph","Properties":{"id":"20240614122925-e989r3x","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用电刺激麻醉猫喉上神经引起咳嗽的方法证明，静脉注射胆酸钠（20毫克/公斤）有镇咳作用，脱氧胆酸钠及牛磺胆酸钠则无此作用。同样方法用猪胆粉（0.5～1.0克/公斤）灌胃，也有上咳作用，在给药后30～60分钟作用最明显，持续2～2.5小时左右。四此，胆汁可抑制咳嗽中枢的兴奋性，用小鼠氨水喷雾法证明，从鸡胆中提出的鹅脱氧胆酸钠有止咳作用，而粗制品则较差；也有报告，从猪胆中提出的胆酸（钠）有止咳效果，而复方（猪胆、桔梗、半夏、地龙）效果更好一些。"}]},{"ID":"20240614122925-5g2wx14","Type":"NodeParagraph","Properties":{"id":"20240614122925-5g2wx14","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用豚鼠组织胺喷雾法初步表明，鹅脱氧胆酸钠有平喘作用。胆酸灌胃（1克/公斤）1小时后，再用组织胺-乙酰胆碱混合液喷雾，对豚鼠亦有某些平喘作用，复方效果更好一些。用豚鼠离体肺灌流，胆汁能解除组织胺引起的支气管痉挛，胆酸钠为此种解痉的有效成分。也有初步报告，对小鼠有祛痰作用。"}]},{"ID":"20240614122925-eig28ee","Type":"NodeParagraph","Properties":{"id":"20240614122925-eig28ee","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②消炎、抗过敏作用"}]},{"ID":"20240614122925-a0fce9j","Type":"NodeParagraph","Properties":{"id":"20240614122925-a0fce9j","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"以兔耳在热水（60℃）中烫1分钟以造成炎症，12小时后以猪胆粉0.5克/公斤灌胃，可使炎症（兔耳体积及颜色）消退较对照组为快、对大鼠的甲醛性\"关节炎\"也有一定的抗炎作用。以组织化学法观察肝、脾、肾上腺，肠系膜淋巴结的酸性磷酸酶染色，网状纤维染色及肝脏星状细胞活体染色，作了初步观察，胆汁似能提高抗炎能力。以马血清（0.5毫升，共注射16天）使豚鼠致敏后，心内注射胆酸（5毫克/公斤），10只豚鼠中有7只在接受马血清再注射时，不发生休克现象，而对照组则全部发生。对组织胺性及乙酰胆碱性休克，如能多次注射胆酸，据称也可防止休克的发生，即胆酸有抗过敏性休克的作用。"}]},{"ID":"20240614122925-7zkmvv3","Type":"NodeParagraph","Properties":{"id":"20240614122925-7zkmvv3","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"③抑菌作用"}]},{"ID":"20240614122925-md6fyzc","Type":"NodeParagraph","Properties":{"id":"20240614122925-md6fyzc","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"在试管中，动物（猪、牛、鸡）的胆汁在高浓度时，对百日咳杆菌有抑制作用，但不如黄连，在体外，羊胆于高浓度（1：100）时，对人型、牛型结核杆菌有抑制作用，而牛胆汁作用很差，服羊胆汁2周后再接种结核杆菌，则豚鼠器官病变较对照组似较轻。对呼吸道常见细菌也有不同程度的抑菌作用，胆酸作用强于复方，尤其肺炎双球菌及流感杆菌较为敏感。对奈瑟氏菌无抑制作用。民间用以治疗痢疾的黑虎丹（以猪胆汁与小米混合制成）在体外对痢疾杆菌、金黄色葡萄球菌、沙门氏杆菌、大肠杆菌等有不同程度的抑菌作用。"}]},{"ID":"20240614122925-u4r97dx","Type":"NodeParagraph","Properties":{"id":"20240614122925-u4r97dx","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240614122925-m81vlia","Type":"NodeParagraph","Properties":{"id":"20240614122925-m81vlia","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"早年国外报告，牛黄之镇静及抗痉作用主要由其中所含之胆酸及钙盐引起。国内科学工作者亦证明，胆酸敖有拮抗可卡因对小鼠的惊厥作用。在兔肺伸张反射的实验中证明；静脉注射胆酸钠能抑制呼吸中枢的兴奋性；对离体肠管，胆酸钠小剂量有兴奋作用（增加紧张性、节律性），大剂量则抑制。胆汁或胆盐口服后可刺激胆汁分泌，增加肠蠕动，使脂肪易于消化，促进脂溶性物质如胡萝卜素类、维生素K及铁的吸收，并有轻泻作用，能抑制离体蛙心；在蛙全身灌流时能扩张血管。如注入血循环，可引起皂甙样作用，导致溶血。大剂量抑制心脏及神经，对神经、肌肉有直接的毒性作用。"}]},{"ID":"20240614122925-imklr7u","Type":"NodeParagraph","Properties":{"id":"20240614122925-imklr7u","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122925-pj7p1vy","Type":"NodeParagraph","Properties":{"id":"20240614122925-pj7p1vy","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 入肝、胆、肺、大肠经。"}]},{"ID":"20240614122925-1mpm69r","Type":"NodeParagraph","Properties":{"id":"20240614122925-1mpm69r","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入心。\""}]},{"ID":"20240614122925-6rs4uky","Type":"NodeParagraph","Properties":{"id":"20240614122925-6rs4uky","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手足阳明经。\""}]},{"ID":"20240614122925-r7fx9uu","Type":"NodeParagraph","Properties":{"id":"20240614122925-r7fx9uu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122925-ox6lb3q","Type":"NodeParagraph","Properties":{"id":"20240614122925-ox6lb3q","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240614122925-zgbv8qp","Type":"NodeParagraph","Properties":{"id":"20240614122925-zgbv8qp","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微寒。\""}]},{"ID":"20240614122925-bust6c5","Type":"NodeParagraph","Properties":{"id":"20240614122925-bust6c5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②《本草图经》；\"大寒。\""}]},{"ID":"20240614122925-0t6xlyn","Type":"NodeParagraph","Properties":{"id":"20240614122925-0t6xlyn","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"味苦咸，寒。\""}]},{"ID":"20240614122925-t2mfr5h","Type":"NodeParagraph","Properties":{"id":"20240614122925-t2mfr5h","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122925-6pshwzs","Type":"NodeParagraph","Properties":{"id":"20240614122925-6pshwzs","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 清热，润燥，解毒。治热病里热燥渴、便秘，黄疸，百日咳，哮喘，泄泻，痢疾，目赤，喉痹，聤耳，痈肿疔疮。"}]},{"ID":"20240614122925-1gfbwwr","Type":"NodeParagraph","Properties":{"id":"20240614122925-1gfbwwr","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"疗伤寒热渴。\""}]},{"ID":"20240614122925-1t7lual","Type":"NodeParagraph","Properties":{"id":"20240614122925-1t7lual","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主小儿头疮，取胆汁敷之。\""}]},{"ID":"20240614122925-mwnz9bb","Type":"NodeParagraph","Properties":{"id":"20240614122925-mwnz9bb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"主骨热劳极，伤寒及渴疾，小儿五疳，杀虫。\""}]},{"ID":"20240614122925-gqnxyn3","Type":"NodeParagraph","Properties":{"id":"20240614122925-gqnxyn3","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"通小便，敷恶疮，杀疳匿，治日赤、目翳，明日，清心脏，凉肝脾。\""}]},{"ID":"20240614122925-pb85cnk","Type":"NodeParagraph","Properties":{"id":"20240614122925-pb85cnk","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑤《随息居饮食谱》：\"补胆，清热，治热痢，通热秘。治厥颠疾。\""}]},{"ID":"20240614122925-kjuguuq","Type":"NodeParagraph","Properties":{"id":"20240614122925-kjuguuq","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614122925-oqw4w2t","Type":"NodeParagraph","Properties":{"id":"20240614122925-oqw4w2t","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 内服；煎汤，取汁冲服1～2钱；或入丸，散。外用：涂敷、点眼或灌肠。"}]},{"ID":"20240614122925-a053qch","Type":"NodeParagraph","Properties":{"id":"20240614122925-a053qch","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614122925-gasxcik","Type":"NodeParagraph","Properties":{"id":"20240614122925-gasxcik","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" ①治伤寒五、六日，斑出：猪胆、苦酒各三合，鸡子一枚。三味合煎三沸，强人尽服之，羸人须煎六、七沸，分为二服，汗出即愈。（《千金方》猪胆汤）"}]},{"ID":"20240614122925-cvwrpi1","Type":"NodeParagraph","Properties":{"id":"20240614122925-cvwrpi1","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②治口中干燥无津液而渴：雄猪胆五枚，定粉（《纲目》引作天花粉）一两。-上二味，以酒煮胆，候皮烂，即入粉研细，同煎成煎，丸如鸡头大，每服二丸，含化咽津。（《圣济总录》猪胆煎）"}]},{"ID":"20240614122925-7yttcqn","Type":"NodeParagraph","Properties":{"id":"20240614122925-7yttcqn","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"③治阳明病津液内竭，大便硬，不可攻：大猪胆汁一枚，泻汁，和少许法醋，以灌谷道内，如一食顷，当大便出宿食恶物。（《伤寒论》猪胆汁导法）"}]},{"ID":"20240614122925-sc1kbwl","Type":"NodeParagraph","Properties":{"id":"20240614122925-sc1kbwl","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"④治大便燥结：猪胆、蜂蜜，煎服。（《四川中药志》）"}]},{"ID":"20240614122925-0jhr8jb","Type":"NodeParagraph","Properties":{"id":"20240614122925-0jhr8jb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑤治少阴病，下利脉微者，与白通汤，利不止，厥逆无脉，乾呕烦者：葱白四茎，干姜一两，附子一枚（生，去皮，破八片），人尿五合猪胆汁一合。上五味，以水三升，煮取一升，去滓，内胆汁，人尿，和令相得，分温再服。（《伤寒论》白通加猪胆汁汤）"}]},{"ID":"20240614122925-jrfh4lv","Type":"NodeParagraph","Properties":{"id":"20240614122925-jrfh4lv","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑥治黄病：猪胆一个，鸡蛋一个。共调匀，不拘时服。如嫌苦难下，用于糕咽之，连服三次。（《梅氏验方新编》猪胆蛋）"}]},{"ID":"20240614122925-kqeluhu","Type":"NodeParagraph","Properties":{"id":"20240614122925-kqeluhu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑦治瘦病咳嗽：猪胆和小便、生姜、橘皮、诃梨勒、桃皮。煮服。（《本草拾遗》）"}]},{"ID":"20240614122925-qxg6771","Type":"NodeParagraph","Properties":{"id":"20240614122925-qxg6771","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑧治目赤病及胎赤：猪胆和绿盐五分，点眦。（《广济方》）"}]},{"ID":"20240614122925-xbujv5f","Type":"NodeParagraph","Properties":{"id":"20240614122925-xbujv5f","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑨治翳膜：猪胆一只，硇砂（细研）穰在猪胆中成膏，系定，悬当风处，候白衣如霜出，扫下收瓷合子内，旋旋用柱子点入眦中，觉痒乃罢，便无翳膜，未尽再点之。（《鸡峰普济方》猪胆膏）"}]},{"ID":"20240614122925-snmipz1","Type":"NodeParagraph","Properties":{"id":"20240614122925-snmipz1","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑩治喉痛：猪胆、射干、玄明粉、人中白、知母。煎服。（《四川中药志》）"}]},{"ID":"20240614122925-167rx2a","Type":"NodeParagraph","Properties":{"id":"20240614122925-167rx2a","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑾治痔疮：猪胆七枚，取汁，炭火熬成膏，用单纸摊敷，须先用槐根白皮煎汤温洗。然后敷药。（《仁斋直指方》猪胆膏）"}]},{"ID":"20240614122925-jvnkcmg","Type":"NodeParagraph","Properties":{"id":"20240614122925-jvnkcmg","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑿治汤火伤疮：猪胆调黄柏末涂之。（《外台》）"}]},{"ID":"20240614122925-dhnrcz5","Type":"NodeParagraph","Properties":{"id":"20240614122925-dhnrcz5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⒀治诸般痫搐：半夏一两（汤洗七遍），狼猪胆三个，取汁浸半夏于瓷器中，晒干，切片焙燥，为细末，生姜自然汁煮面和丸，桐子大，每服五、七丸至十丸，煎麦门冬熟水下，食后临卧各一服。（《小儿卫生总微论方》猪胆半夏丸）"}]},{"ID":"20240614122925-nw3k996","Type":"NodeParagraph","Properties":{"id":"20240614122925-nw3k996","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614122925-xmfz1w8","Type":"NodeParagraph","Properties":{"id":"20240614122925-xmfz1w8","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" ①预防白喉"}]},{"ID":"20240614122925-z78ohdu","Type":"NodeParagraph","Properties":{"id":"20240614122925-z78ohdu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"职新鲜猪胆汁，或猪、鱼胆汁混合，加等量砂糖，蒸30～60分钟。托儿所小孩每次服1～2毫升，幼儿园小孩每次服2～3毫升，每天服2次，连服4天。咽拭培养阳性的隔1个月再服4天。曾先后在流行区的托儿所、幼儿园用上法给药2046人，经1年以上观察，无1例发病。其中320人在服药前做过咽液培养，阳性带菌者34人，经第1次服药后1～2周复查，28例转阴，4例第2次服药后转阴。同时期散居的儿童未经预防服药者有4例发病。经3次抑菌试验，证明猪胆汁对白喉杆菌有一定的抑菌能力，但无杀灭作用。"}]},{"ID":"20240614122925-zsn87xk","Type":"NodeParagraph","Properties":{"id":"20240614122925-zsn87xk","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"②治疗急性胃肠炎、菌痢等"}]},{"ID":"20240614122925-k3jbkal","Type":"NodeParagraph","Properties":{"id":"20240614122925-k3jbkal","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用新鲜猪胆汁100毫升，加入绿豆粉1斤混合搅拌，制成药丸（绿胆丸）。成人每次2～3钱，儿童每次3分，日服3～4次。治疗急性胃肠炎31例，治愈28例，好转1例，无效2例：细菌性痢疾26例，治愈24例，好转2例；慢性肠炎4例，治愈2例，好转1例。无效1例；小儿单纯性消化不良4例，治愈3例，好转1例；卡他性肠炎8例，好转1例，无效2例；慢性结肠炎7例，治愈3例，好转2例，无效2例；泌尿系感染13例，治愈12例，好转1例。遇有脱水现象者仍须补液。部分病例在用药1～2天内即出现疗效，并无副作用。"}]},{"ID":"20240614122925-4zi3hga","Type":"NodeParagraph","Properties":{"id":"20240614122925-4zi3hga","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"③治疗百日咳"}]},{"ID":"20240614122925-4cb9dgf","Type":"NodeParagraph","Properties":{"id":"20240614122925-4cb9dgf","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"采用猪胆汁粉剂、糖浆和流浸膏等，胆汁粉剂，6个月以内，每次0.2克，每天1～2次；6个月至1岁，每次0.3克，每日2次；1～4岁每次0.4克，每天2次；4～7岁每次0.5～0.6克，每日2次；胆汁流浸膏，1～2岁每次1.5～2.0毫升，2～4岁每次2～3毫升，4～6岁每次3～4毫升，均每日3次，食后服；7.7％猪胆汁糖浆，6个月以下每次5毫升，6个月至1岁每次8毫升，1～4岁每次10毫升，4～7岁每次13～15毫升，日服2次，连服3～5日。根据1215例的治疗结果，一般服后2～4天开始生效，疗程为5～14天，总有效率约在62～97％之间。"}]},{"ID":"20240614122925-9g2nffi","Type":"NodeParagraph","Properties":{"id":"20240614122925-9g2nffi","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"④治疗急性传染性肝炎"}]},{"ID":"20240614122925-x886q0n","Type":"NodeParagraph","Properties":{"id":"20240614122925-x886q0n","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"将鲜猪胆汁烘干研粉，装胶囊，治疗黄疸型肝炎10例，用量以黄疸指数为依据，黄疸指数在10～40单位者每次1钱，日服3次；40～70单位者，每日4钱，分3次服；70～100单位者，每日5钱，分3次服。均在服药3天后消化道症状有不同程度改善，7天后食量大增；黄疸指数在1～2周内恢复正常，黄疸消失平均9.9天。疗程11～25天。随访1年均未复发。有用猪胆汁片（含猪胆汁粉0.2克），每次1～2片，日服3次，治疗传染性肝炎32例（其中黄疸型7例）。治疗后食欲不振、腹胀、乏力、肝区疼痛等自觉症状均有明显改善，7例黄疸型患者1周后黄疸全部消失；肝肿大26例，治疗后恢复正常者13例，不同程度缩小者8例，无改变者5例；肝功能检查，有前后对照者14例，治疗后对麝香草酚絮状试验及转氨酶等，均有较明显的改善。"}]},{"ID":"20240614122925-u4c6gv7","Type":"NodeParagraph","Properties":{"id":"20240614122925-u4c6gv7","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑤治疗慢性气管炎"}]},{"ID":"20240614122925-4qp5zm5","Type":"NodeParagraph","Properties":{"id":"20240614122925-4qp5zm5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用鲜猪胆汁加热浓缩，烘干磨细粉，装入胶囊，每次0.5克，日服3次（空腹开水送下）；治疗143例，近期控制13例（9.03％），显效35例（24.48％）。或用鲜胆汁1份，淀粉2份，混合炒拌均匀，待干燥后研粉压制成片，每片含猪胆汁0.3克，每次2～3片，日服3次，7天为一疗程；经治疗119例，显效12例，占10％。其中以单纯型患者的效果较好。又可采用猪胆汁（浓缩）注射液，每安瓿2毫升（含猪胆汁原液3毫升），肌肉注射，每次2毫升，每日或隔日1次，10天为一疗程。共治疗64例，近期控制5例，显效21例，两者共占40.62％。对合并肺结核及支气管扩张症者，其止咳、祛痰、平喘疗效并不受影响，但注射后多有局部疼痛。也可用猪胆汁与维生素C注射液等量作穴位注射。选穴：主穴为定喘、肺俞；配穴为大杼、肺热、心俞。各穴交替使用，每次选用1～2穴，每穴注入0.2～0.35毫升，每用2次，4～5次为一疗程。间隔10～15天，再进行下一疗程。治疗51例，临床治愈6例，显效16例，两者共占43.1％。副作用有不同程度的背部发沉、疼痛，一般持续12～36小时，个别患者有发冷发烧，局部肿胀等，予以一股对症处理即可。"}]},{"ID":"20240614122925-fbgzmg5","Type":"NodeParagraph","Properties":{"id":"20240614122925-fbgzmg5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"此外，临床曾以猪胆汁分别配合半夏、赤小豆、何首乌、淫羊藿、地龙、百部和甘草、细辛和白胡椒、白花蛇舌草等组成多种复方，观察数十例或数百例，总有效率约在71.4～94.3％之间。实验证明猪苦胆具有明显的镇咳作用，用药后能使咳嗽的兴奋阈增高。"}]},{"ID":"20240614122925-nrinp49","Type":"NodeParagraph","Properties":{"id":"20240614122925-nrinp49","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑥治疗单纯性消化不良"}]},{"ID":"20240614122925-3p5l4xr","Type":"NodeParagraph","Properties":{"id":"20240614122925-3p5l4xr","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用3％猪胆汁粉糖浆，6个月以下每日4毫升，6个月至1岁6毫升，1～4岁3毫升，4～7岁10毫升，分3～4次内服。可连用数天，无任何副作用。治疗81例，治愈71例，好转7例，无效3例。病程以2～10天为多，最长者为5个月。用药后多在2～4天见愈。认为猪胆汁能溶解脂肪酸并助其吸收，从而减少肠内易于腐败物质之产生，故能发挥良好的治疗作用。"}]},{"ID":"20240614122925-jzbp5b3","Type":"NodeParagraph","Properties":{"id":"20240614122925-jzbp5b3","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑦用于妇产科各种手术及炎症感染"}]},{"ID":"20240614122925-90zyzzg","Type":"NodeParagraph","Properties":{"id":"20240614122925-90zyzzg","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用猪胆汁、黄芩素制成注射液，每次肌肉注射2毫升，每日2次。曾用于卵巢肿瘤切除、宫外孕手术、绝育手术等术后感染，及慢性盆腔炎、尿路感染等疾病计200例，代替抗菌素，有效率92％。取鲜猪胆汁、白矾制成粉剂作宫颈喷撒，曾试治慢性宫颈炎100余例，有一定疗效。"}]},{"ID":"20240614122925-x8cc47n","Type":"NodeParagraph","Properties":{"id":"20240614122925-x8cc47n","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑧治疗砂眼"}]},{"ID":"20240614122925-62iuvb4","Type":"NodeParagraph","Properties":{"id":"20240614122925-62iuvb4","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"取鲜猪胆汁过滤使呈清亮溶液，用生理盐水稀释成10％浓度，高压消毒后点眼。治疗砂眼患者39人，每次每眼1滴，每日3次，10日为一疗程。结果痊愈及基本痊愈率为66.67％，较对照组用黄连液点眼的治愈率为高。另法用鲜猪胆汁50毫升，1：1000肾上腺素1毫升，5％普鲁卡因5毫升，混合过滤后在水浴上煮沸1分钟，每日点眼3次；治疗989例，治愈率为60.13～72.7％，而对照组用0.5％金霉素溶液的治愈率为15.4％。"}]},{"ID":"20240614122925-5qxtca5","Type":"NodeParagraph","Properties":{"id":"20240614122925-5qxtca5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑨治疗慢性化脓性中耳炎"}]},{"ID":"20240614122925-oab2o31","Type":"NodeParagraph","Properties":{"id":"20240614122925-oab2o31","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"取鲜猪胆汁烘干研粉，加等量或2倍明矾粉拌匀。用于治疗一般慢性化脓性中耳炎，无骨质破坏和胆脂瘤者。使用前先用双氧水清洗外耳道，拭干后将胆矾粉均匀喷入鼓膜穿孔处。量勿过多，以免妨碍引流。治疗149例，计163只耳。经3次喷药治疗后干耳者为75.2％，全部病例的干耳率为96％。治疗次数平均为3.2次。多数患者第一次上药后，次日分泌物增多变稀，2～3日后分泌物锐减，逐渐干燥。经较长时期观察，有26例复发。防止呼吸道感染，清除鼻咽部感染灶是防止复发的有效措施。实验室对66例化脓性中耳炎分泌物用胆矾粉作了抑菌试验，多数细菌均有不同程度的敏感性，而对抗菌素则产生耐药性。"}]},{"ID":"20240614122925-59bqcm5","Type":"NodeParagraph","Properties":{"id":"20240614122925-59bqcm5","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"⑩用作通便剂"}]},{"ID":"20240614122925-4bsv3py","Type":"NodeParagraph","Properties":{"id":"20240614122925-4bsv3py","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"新鲜猪胆汁经高压蒸汽消毒或煮沸消毒10分钟，冷藏。成人6O～100毫升，儿童30～40毫升，加温至27℃左右作保留灌肠。试用于腹部手术后及产妇便秘，手术后气胀，麻痹性肠梗阻等病人，计394例，多数病人经半小时左右可排便，少数病人需延长至2小时。便量多而自感舒适者382例（97％）。6例肠梗阻病人应用胆汁灌肠后，梗阻现象在短时间内解除，未采用其他方法处理。"}]},{"ID":"20240614122925-0skshxb","Type":"NodeParagraph","Properties":{"id":"20240614122925-0skshxb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122925-a0jxl3m","Type":"NodeParagraph","Properties":{"id":"20240614122925-a0jxl3m","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"方家用猪胆，取其寒能胜热，滑能润燥，苦能入心，又能去肝胆之火也。\""}]},{"ID":"20240614122925-fl90kxm","Type":"NodeParagraph","Properties":{"id":"20240614122925-fl90kxm","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122925-zp0cbz7","Type":"NodeParagraph","Properties":{"id":"20240614122925-zp0cbz7","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614122925-13jhqin","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122925-13jhqin","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"《中华本草》：猪胆"}]},{"ID":"20240614122925-ncv24pb","Type":"NodeParagraph","Properties":{"id":"20240614122925-ncv24pb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122925-h75lced","Type":"NodeParagraph","Properties":{"id":"20240614122925-h75lced","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" Zhū Dǎn"}]},{"ID":"20240614122925-0a3h2k1","Type":"NodeParagraph","Properties":{"id":"20240614122925-0a3h2k1","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614122925-vhmdpwp","Type":"NodeParagraph","Properties":{"id":"20240614122925-vhmdpwp","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" Pig's gallbladder"}]},{"ID":"20240614122925-6esg3zb","Type":"NodeParagraph","Properties":{"id":"20240614122925-6esg3zb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122925-x7ymrhe","Type":"NodeParagraph","Properties":{"id":"20240614122925-x7ymrhe","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》"}]},{"ID":"20240614122925-7hf95c8","Type":"NodeParagraph","Properties":{"id":"20240614122925-7hf95c8","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122925-dsm4aaw","Type":"NodeParagraph","Properties":{"id":"20240614122925-dsm4aaw","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 药材基源：为猪科动物猪的胆汁。"}]},{"ID":"20240614122925-jstnawo","Type":"NodeParagraph","Properties":{"id":"20240614122925-jstnawo","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sus scrofa domestica Brisson"}]},{"ID":"20240614122925-gvar3zd","Type":"NodeParagraph","Properties":{"id":"20240614122925-gvar3zd","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"采收和储藏：宰杀后，剖腹取出胆囊，取胆汗鲜用或将胆囊挂起晾干，或在半干时稍稍压扁，再干燥之。"}]},{"ID":"20240614122925-4wn0yxb","Type":"NodeParagraph","Properties":{"id":"20240614122925-4wn0yxb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614122925-8akmsy6","Type":"NodeParagraph","Properties":{"id":"20240614122925-8akmsy6","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 生态环境：杂食性家养物畜，繁殖力强，孕期约4个月。"}]},{"ID":"20240614122925-eqwjact","Type":"NodeParagraph","Properties":{"id":"20240614122925-eqwjact","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地均有饲养。"}]},{"ID":"20240614122925-yekmfkz","Type":"NodeParagraph","Properties":{"id":"20240614122925-yekmfkz","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122925-8hkohim","Type":"NodeParagraph","Properties":{"id":"20240614122925-8hkohim","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 猪的品种繁多，达150多种，形态也有差异基本特微是：躯体肥胖，头大。鼻与口吻皆长略向上屈。眼小。耳壳有的大而下垂，有的较小而前挺。四肢短小，4趾，前2趾有蹄，后2趾有悬蹄。颈粗，项背疏生鬃毛。尾短小，末端有毛丛。毛色有纯黑、纯白或黑白混杂等。"}]},{"ID":"20240614122925-b9cd37g","Type":"NodeParagraph","Properties":{"id":"20240614122925-b9cd37g","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614122925-lcxirbu","Type":"NodeParagraph","Properties":{"id":"20240614122925-lcxirbu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 大剂量抑制心脏及神经，对神经、肌肉有直接的毒性作用。"}]},{"ID":"20240614122925-qu0uc71","Type":"NodeParagraph","Properties":{"id":"20240614122925-qu0uc71","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122925-6qod4kw","Type":"NodeParagraph","Properties":{"id":"20240614122925-6qod4kw","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 猪胆汁中主要成分为胆汁酸类，胆色素、粘蛋白、脂类及无机物等。胆汁酸中有鹅脱氧胆酸(chenodeoxycholic acid)、3a- 羟基- 6- 氧- 5α-胆烷酸(3α- hydroxy-6- oxo-5α-cholanic acid)和石胆酸(llthocholic acid)，它们几乎完全与甘氨酸结合而存在。另含猪胆酸(hyocholic acid),猪脱氧胆酸(hyodeoxycholic acid)，3β，6α-二羟基胆烷酸（3β，6α-dihydroxycholanic acid）。"}]},{"ID":"20240614122925-2jmfyky","Type":"NodeParagraph","Properties":{"id":"20240614122925-2jmfyky","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614122925-c85fdbu","Type":"NodeParagraph","Properties":{"id":"20240614122925-c85fdbu","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 1.镇咳、平喘作用：用电刺激麻醉猫喉上神经引起咳嗽的方法证明，静脉注射胆酸钠（20mg／kg）有镇咳作用，脱氧胆酸钠及牛磺胆酸钠则无此作用。同样方法用猪胆粉（0.5-1.Og／kg）灌胃，也有止咳作用，在给药后30-60分钟作用最明显，持续2-2.5小时左右。因此，胆汁可抑制咳嗽中枢的兴奋性，用小鼠氨水喷雾法证明，从鸡胆中提出的鹅脱氧胆酸钠有止咳作用，而粗制品则较差：也有报告，从猪胆中提出的胆酸（钠）有止咳效果，而复方（猪胆、桔梗、半夏、地龙）效果更好一些。用豚鼠组织胺喷雾法初步表明，鹅脱氧胆酸钠有平喘作用。胆酸灌胃（1 g／kg）1小时后，再用组织胺- 乙酞胆碱混合液喷雾，对豚鼠亦有某些平喘作用，复方效果更好一些。用豚鼠离体肺灌流，胆汁能解除组织胺引起的支气管痉挛。胆酸钠为此种解痉的有效成分。也有初步报告，对小鼠有祛痰作用。"}]},{"ID":"20240614122925-n70ybgv","Type":"NodeParagraph","Properties":{"id":"20240614122925-n70ybgv","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"2.消炎、抗过敏作用：以免耳在热水（60℃）中烫1分钟以造成炎症，12小时后以猪胆粉0.5g／kg灌胃，可使炎症（兔耳体积及颜色）消退较对照组为快。对大鼠的甲醛性关节炎也有一定的抗炎作用。以组织化学法观察肝、脾、肾上腺，肠系膜淋巴结的酸性磷酸酶染色，网状纤维染色及肝脏星状细胞活体染色，作了初步观察，胆汁似能提高抗炎能力。以马血清（0.5ml，共注射16天）使豚鼠致敏后，心内注射胆酸（5mg／kg），10只豚鼠中有7只在接受马血清再注射时，不发生休克现象，而对照组则全部发生。对组织胺性及乙酰胆碱性休克，如能多次注射胆酸，据称也可防止休克的发生，即胆酸有抗过敏性休克的作用。"}]},{"ID":"20240614122925-ry4pj3w","Type":"NodeParagraph","Properties":{"id":"20240614122925-ry4pj3w","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"3.抑菌作用：在试管中，动物（猪、牛、鸡）的胆汁在高浓度时，对百日咳杆菌有抑制作用，但不如黄连，在体外，羊胆于高浓度（1∶100）时，对人型、牛型结核杆菌有抑制作用，而牛胆汁作用很差，服羊胆汁2周后再接种结核杆菌，则豚鼠器官病变较对照组似较轻。对呼吸道常见细菌也有不同程度的抑菌作用，胆酸作用强于复方，尤其肺炎双球菌及流感杆菌较为敏感。对奈瑟氏菌无抑制作用。民间用以治疗痢疾的黑虎丹（以猪胆汁与小米混合制成）在体外对痢疾杆菌、金黄色葡萄球菌、沙门氏杆菌、大肠杆菌等有不同程度的抑菌作用。"}]},{"ID":"20240614122925-ke1zwev","Type":"NodeParagraph","Properties":{"id":"20240614122925-ke1zwev","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"4.其他作用：早年国外报告，牛黄之镇静及抗痉作用主要由其中所含之胆酸及钙盐引起。国内科学工作者亦证明，胆酸盐有拮抗可卡因对小鼠的惊厥作用。在兔肺伸张反射的实验中证明，静脉注射胆酸钠能抑制呼吸中枢的兴奋性，对离体肠管，胆酸钠小剂量有兴奋作用（增加紧张性、节律性），大剂量则抑制。胆汁或胆盐口服后可刺激胆汁分泌，增加肠蠕动，使脂肪易于消化，促进脂溶性物质如胡萝卜素类，维生素K及铁的吸收，并有轻泻作用。能抑制离体蛙心；在蛙全身灌流时能扩张血管。如注入血循环，可引起皂甙样作用，导致溶血。"}]},{"ID":"20240614122925-ekj9ihd","Type":"NodeParagraph","Properties":{"id":"20240614122925-ekj9ihd","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122925-fvtr6ym","Type":"NodeParagraph","Properties":{"id":"20240614122925-fvtr6ym","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 肝；胆；肺；大肠经"}]},{"ID":"20240614122925-1fps942","Type":"NodeParagraph","Properties":{"id":"20240614122925-1fps942","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122925-0lr7z88","Type":"NodeParagraph","Properties":{"id":"20240614122925-0lr7z88","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240614122925-80a9o2x","Type":"NodeParagraph","Properties":{"id":"20240614122925-80a9o2x","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122925-3i9wjig","Type":"NodeParagraph","Properties":{"id":"20240614122925-3i9wjig","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 清热；润燥；解毒。主热病燥渴；大便秘结；咳嗽；哮喘；目赤；目翳；泄痢；黄疸；喉痹；聤耳；痈疽疔疮；鼠瘘；湿疹；头癣"}]},{"ID":"20240614122925-k3ata73","Type":"NodeParagraph","Properties":{"id":"20240614122925-k3ata73","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614122925-74cddly","Type":"NodeParagraph","Properties":{"id":"20240614122925-74cddly","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g；或取汁中，每次3-6g；或入丸、散。外用：适量，涂敷、点眼或灌肠。"}]},{"ID":"20240614122925-rdqad19","Type":"NodeParagraph","Properties":{"id":"20240614122925-rdqad19","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122925-0mtoje4","Type":"NodeParagraph","Properties":{"id":"20240614122925-0mtoje4","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 《纲目》：方家用猪胆，取其寒能胜热，滑能润燥，苦能入心，又能去肝胆之火也。"}]},{"ID":"20240614122925-iui9xfb","Type":"NodeParagraph","Properties":{"id":"20240614122925-iui9xfb","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122925-8kwzw95","Type":"NodeParagraph","Properties":{"id":"20240614122925-8kwzw95","updated":"20240614122925"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614122522-3srv88f","Type":"NodeThematicBreak","Properties":{"id":"20240614122522-3srv88f"}},{"ID":"20240614122540-nbbaw6o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122540-nbbaw6o","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：猪肤"}]},{"ID":"20240614122540-3zcvt2t","Type":"NodeParagraph","Properties":{"id":"20240614122540-3zcvt2t","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122540-r102bpi","Type":"NodeParagraph","Properties":{"id":"20240614122540-r102bpi","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" Zhū Fū"}]},{"ID":"20240614122540-klmase2","Type":"NodeParagraph","Properties":{"id":"20240614122540-klmase2","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614122540-c3pdxm7","Type":"NodeParagraph","Properties":{"id":"20240614122540-c3pdxm7","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 猪皮（《汤液本草》）。"}]},{"ID":"20240614122540-u2v4qqr","Type":"NodeParagraph","Properties":{"id":"20240614122540-u2v4qqr","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122540-pogawgh","Type":"NodeParagraph","Properties":{"id":"20240614122540-pogawgh","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《汤液本草》"}]},{"ID":"20240614122540-4whu4y5","Type":"NodeParagraph","Properties":{"id":"20240614122540-4whu4y5","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122540-vuyl4p6","Type":"NodeParagraph","Properties":{"id":"20240614122540-vuyl4p6","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 为猪科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"皮肤"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240614122540-8zbpx9u","Type":"NodeParagraph","Properties":{"id":"20240614122540-8zbpx9u","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122540-rid4xvf","Type":"NodeParagraph","Properties":{"id":"20240614122540-rid4xvf","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 动物形态详\"猪肉\"条。"}]},{"ID":"20240614122540-txpy0ab","Type":"NodeParagraph","Properties":{"id":"20240614122540-txpy0ab","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122540-bgkvvpn","Type":"NodeParagraph","Properties":{"id":"20240614122540-bgkvvpn","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 含水分46％，蛋白质26.4％，脂肪22.7％，灰分0.6％。"}]},{"ID":"20240614122540-p61w05k","Type":"NodeParagraph","Properties":{"id":"20240614122540-p61w05k","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122540-9nl3i9p","Type":"NodeParagraph","Properties":{"id":"20240614122540-9nl3i9p","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《汤液本草》：\"入足少阴经。\""}]},{"ID":"20240614122540-k8wzjpy","Type":"NodeParagraph","Properties":{"id":"20240614122540-k8wzjpy","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122540-208dj2y","Type":"NodeParagraph","Properties":{"id":"20240614122540-208dj2y","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 甘，凉。"}]},{"ID":"20240614122540-14wxgdc","Type":"NodeParagraph","Properties":{"id":"20240614122540-14wxgdc","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"①《注解伤寒论》：\"味甘，寒。\""}]},{"ID":"20240614122540-jxvy5xl","Type":"NodeParagraph","Properties":{"id":"20240614122540-jxvy5xl","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"味甘，气微寒，无毒。\""}]},{"ID":"20240614122540-ywrn39i","Type":"NodeParagraph","Properties":{"id":"20240614122540-ywrn39i","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122540-vnvk4em","Type":"NodeParagraph","Properties":{"id":"20240614122540-vnvk4em","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"治少阴下痢、咽痛。\""}]},{"ID":"20240614122540-ksfs9hg","Type":"NodeParagraph","Properties":{"id":"20240614122540-ksfs9hg","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614122540-26z9pk5","Type":"NodeParagraph","Properties":{"id":"20240614122540-26z9pk5","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 治少阴病下利、咽痛、胸满、心烦：猪肤一斤。以水一斗，煮取五升，去滓，加白蜜一升，白粉五合，熬香和合相得。温分六服。（《伤寒论》猪肤汤）"}]},{"ID":"20240614122540-805btcb","Type":"NodeParagraph","Properties":{"id":"20240614122540-805btcb","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614122540-6ku0mje","Type":"NodeParagraph","Properties":{"id":"20240614122540-6ku0mje","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 试用猪皮移植烧伤创面"}]},{"ID":"20240614122540-1qjyjom","Type":"NodeParagraph","Properties":{"id":"20240614122540-1qjyjom","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"体重10～20公斤的小猪宰杀后去毛，取皮浸泡于1：2000新洁尔灭液中15～20分钟，或用1‰硫柳汞酊或75％酒精消毒2～3次；再在无菌操作下，将猪皮自脂肪层剥下（头、脚、爪、尾均不用），反贴于鼓式取皮机的鼓面上，切除脂肪层及一部分真皮层，使皮片的厚度为0.2～0.6毫米，切成所需要的大小移植于创面。如果当时不用，应立即置于0～4℃的冰箱中储存，保存时间不超过3周。曾在6例Ⅲ度烧伤的创面上试用，烧伤总面积60～95％不等，其中Ⅲ度烧伤面积占15～80％，猪皮植皮面积2～50％不等。结果5例生长良好，1例存活月余，对饶伤创面能起保护作用，无不良反应。冷藏20天的猪皮仍可存活。"}]},{"ID":"20240614122540-5ek9djz","Type":"NodeParagraph","Properties":{"id":"20240614122540-5ek9djz","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122540-ukkbudk","Type":"NodeParagraph","Properties":{"id":"20240614122540-ukkbudk","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" ①《长沙药解》：\"猪肤，利咽喉而消肿痛，清心肺而除烦满。《伤寒》猪肤汤治少阴病下利咽痛，胸满心烦者，猪肤、白蜜清金而止痛，润燥而除烦，白粉涩滑溏而收泄利也。肺金清凉而司皮毛，猪肤善于清肺，肺气清降，浮火归根，则咽痛与烦满自平也。\""}]},{"ID":"20240614122540-zmfr7xp","Type":"NodeParagraph","Properties":{"id":"20240614122540-zmfr7xp","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"②《随息居饮食谱》：\"猪皮即肤也，猪肤甘凉清虚热，治下利、心烦、咽痛，今医罕用此药矣。若无心烦、咽痛兼症者，是寒滑下利，不宜用此。\""}]},{"ID":"20240614122540-ch7l0z0","Type":"NodeParagraph","Properties":{"id":"20240614122540-ch7l0z0","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122540-rlq3nfj","Type":"NodeParagraph","Properties":{"id":"20240614122540-rlq3nfj","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614122540-tet0onx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122540-tet0onx","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"《中华本草》：猪肤"}]},{"ID":"20240614122540-aezyv8v","Type":"NodeParagraph","Properties":{"id":"20240614122540-aezyv8v","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122540-4yooarq","Type":"NodeParagraph","Properties":{"id":"20240614122540-4yooarq","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" Zhū Fū"}]},{"ID":"20240614122540-1lbjp6u","Type":"NodeParagraph","Properties":{"id":"20240614122540-1lbjp6u","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614122540-mdngbgy","Type":"NodeParagraph","Properties":{"id":"20240614122540-mdngbgy","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 猪皮"}]},{"ID":"20240614122540-ysnj9v4","Type":"NodeParagraph","Properties":{"id":"20240614122540-ysnj9v4","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614122540-v6imw25","Type":"NodeParagraph","Properties":{"id":"20240614122540-v6imw25","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" Pigskin"}]},{"ID":"20240614122540-jo38ova","Type":"NodeParagraph","Properties":{"id":"20240614122540-jo38ova","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122540-2xqhy53","Type":"NodeParagraph","Properties":{"id":"20240614122540-2xqhy53","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 出自《汤液本草》"}]},{"ID":"20240614122540-dj5zyr1","Type":"NodeParagraph","Properties":{"id":"20240614122540-dj5zyr1","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122540-q32kk2w","Type":"NodeParagraph","Properties":{"id":"20240614122540-q32kk2w","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 药材基源：为猪科动物猪的皮肤。"}]},{"ID":"20240614122540-o4mcz4j","Type":"NodeParagraph","Properties":{"id":"20240614122540-o4mcz4j","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sus scrofa domestica Brisson"}]},{"ID":"20240614122540-2u0qsgp","Type":"NodeParagraph","Properties":{"id":"20240614122540-2u0qsgp","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"采收和储藏：宰杀后，刮去猪毛，剥取皮肤，洗净，鲜用或冷藏。"}]},{"ID":"20240614122540-iznxsep","Type":"NodeParagraph","Properties":{"id":"20240614122540-iznxsep","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614122540-8xcm4qf","Type":"NodeParagraph","Properties":{"id":"20240614122540-8xcm4qf","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 生态环境：杂食性家养物畜，繁殖力强，孕期约4个月。"}]},{"ID":"20240614122540-quz080v","Type":"NodeParagraph","Properties":{"id":"20240614122540-quz080v","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地均有饲养。"}]},{"ID":"20240614122540-2xoxwhy","Type":"NodeParagraph","Properties":{"id":"20240614122540-2xoxwhy","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122540-qvj5jcn","Type":"NodeParagraph","Properties":{"id":"20240614122540-qvj5jcn","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 猪的品种繁多，达150多种，形态也有差异基本特微是：躯体肥胖，头大。鼻与口吻皆长略向上屈。眼小。耳壳有的大而下垂，有的较小而前挺。四肢短小，4趾，前2趾有蹄，后2趾有悬蹄。颈粗，项背疏生鬃毛。尾短小，末端有毛丛。毛色有纯黑、纯白或黑白混杂等。"}]},{"ID":"20240614122540-tzt5mpv","Type":"NodeParagraph","Properties":{"id":"20240614122540-tzt5mpv","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122540-s5dqutp","Type":"NodeParagraph","Properties":{"id":"20240614122540-s5dqutp","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 含水分46% ，蛋白质26.4% ，脂肪22.7% ，灰分0.6%及硫酸皮肤素（dermatan sulfate）即硫酸软骨素（chondroitin sulfate）B。"}]},{"ID":"20240614122540-ugrs33q","Type":"NodeParagraph","Properties":{"id":"20240614122540-ugrs33q","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614122540-fo0i6rb","Type":"NodeParagraph","Properties":{"id":"20240614122540-fo0i6rb","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 1.对血液和造血系统的作用由猪皮制取的新阿胶有促进骨髓造血功能的作用,0.1g/只灌胃，每日1次，连续15d，对60Co动照射所致骨髓造血功能损害的小鼠，能使其59Fe摄取量显着高于对照组，骨髓有核细胞数的增高与50Fe摄取率的增高相一致，并使血红素含量有一定程度提高。另有报道，新阿胶1.56g/（kgd）灌胃，连续10d，对60Co照射所致造血功能损害小鼠，使其外周血中血红素含量，白细胞数和骨髓有核细胞数均显着高于对照组，其疗效优于阿胶。"}]},{"ID":"20240614122540-47hxb5g","Type":"NodeParagraph","Properties":{"id":"20240614122540-47hxb5g","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"从猪皮提取的硫酸皮肤素（ dermatan sulfate,DS）是一种低抗凝性的抗栓因子。DS的抗凝作用比肝素（UFH）弱，DS延长凝血酶时间（TT）和激活部分凝血活酶时间（APTT）的最低有效浓度分别为 25mg·L-1和12mg·L-1，而UFH分别为0.38mg·L-1和0.75mg·L-1，可见DS的抗凝血酶活性约是UFH的1/60，抗部分凝血活酶活性约是UFH的1/16：DS和UFH有明显地协同抗凝作用。 DS40mg·L-1和UFHO。25mg·L-1最大凝血酶生成的抑制率分别为44.4%和45.l%， DS的抗凝血酶生成作用约是UFH的1/160，两者合用也有显着协同作用。DS诱导血小板聚集的作用也明显弱于FHD，DS和UFH的作用机制不同,UFH与血浆抗凝血酶Ⅲ（AT－Ⅲ）结合，而发挥较强的抗凝作用和抑制凝血酶生成作用；DS不依赖AT-Ⅲ，而是通过肝素辅因子Ⅱ（Heparin cofactorⅡ，HC-Ⅱ）催化抑制凝血酶。DS尚能直接激活血管内皮细胞释放组织型纤溶酶原激活剂（t－PA），t－PA只引起局部溶栓，而不产生全身纤溶作用，动物实验和临床试用证明 t－PA使血栓再通率达70%左右;DS在TT、APTT不延长的情况下，阻止实验性血栓形成，连续静滴4h后，可抑制已存在的血栓生长。为较理想的新型抗栓药。"}]},{"ID":"20240614122540-gbmksdq","Type":"NodeParagraph","Properties":{"id":"20240614122540-gbmksdq","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"由猪皮制取的明胶代血浆双氧化聚合明胶，对犬放血所致急性出血性休克，使血压回升，100%构存活；每1ml5%溶液可释放氧0.5-0.8ml，因此，这些代血浆不仅有扩容作用和抗体克作用，尚能向组织输送一定量的氧。"}]},{"ID":"20240614122540-oocv33a","Type":"NodeParagraph","Properties":{"id":"20240614122540-oocv33a","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"2.促进皮肤粘膜损伤愈合作用由新鲜猪皮制取的胶原，在小鼠烧伤后立即局部涂抹，每次用0.5%型胶原0.4ml，每日至次，连续10d，创面愈合率明显高于对照组（ P＜0.05）；光镜检查，新生上皮下纤维组织的增生现象，成纤维细胞向纤维细胞分化及胶原化的趋势均明显强于对照组，对创而愈合有明显促进作用。另有报道，胶原蛋白（简称胶原）3ml/只对乙醇所致大鼠胃粘膜损伤有促进修复和保护作用，主要表现为胃粘膜损伤较轻，胃出血病死率和胃粘膜脂质过氧化物（LPO）减少，胃粘膜 DNA含量增加。"}]},{"ID":"20240614122540-38uvg6k","Type":"NodeParagraph","Properties":{"id":"20240614122540-38uvg6k","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"3．其他作用由猪皮提取的表皮抑素，对细胞分裂有显着抑制作用，用于治疗寻常型银屑病的有效率达77．27%。在皮报部位用作外科敷料的冻干猪皮（LPO），对大呼吸、血压、心率、心电图、血细胞比穿、血凝与纤溶，及对免体温均无影响；LPS提取物给猫静脉注射，引起短暂的血压下降（苯海拉明可对抗）。"}]},{"ID":"20240614122540-5py2nyu","Type":"NodeParagraph","Properties":{"id":"20240614122540-5py2nyu","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"4．毒性猪皮制取的明胶代血浆和氧化聚合明肢无明显毒性及抗原性。明胶代血浆用大进行慢性毒性试验，病理学检查未发现心、肝、脾、肺、肾有形态学变化；犬试验无明显降压作用。冻干猪皮刺激试验，对兔皮肤和眼无刺激作用。"}]},{"ID":"20240614122540-ia5s10j","Type":"NodeParagraph","Properties":{"id":"20240614122540-ia5s10j","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122540-ft3j0ab","Type":"NodeParagraph","Properties":{"id":"20240614122540-ft3j0ab","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 肾经"}]},{"ID":"20240614122540-jbwlagg","Type":"NodeParagraph","Properties":{"id":"20240614122540-jbwlagg","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122540-yq272aj","Type":"NodeParagraph","Properties":{"id":"20240614122540-yq272aj","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 味甘；性凉"}]},{"ID":"20240614122540-iu3q4vi","Type":"NodeParagraph","Properties":{"id":"20240614122540-iu3q4vi","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614122540-8n3jl00","Type":"NodeParagraph","Properties":{"id":"20240614122540-8n3jl00","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《随息居饮食谱》：“若无心烦、咽痛兼证者，是寒滑下利，不宜用此。”"}]},{"ID":"20240614122540-xpvtqze","Type":"NodeParagraph","Properties":{"id":"20240614122540-xpvtqze","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122540-e94zeo3","Type":"NodeParagraph","Properties":{"id":"20240614122540-e94zeo3","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 清热养阴；利咽；止血。主阴客热下痢；咽痛；吐血；血衄；月经不调；崩漏"}]},{"ID":"20240614122540-a6vumut","Type":"NodeParagraph","Properties":{"id":"20240614122540-a6vumut","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614122540-shvf7k8","Type":"NodeParagraph","Properties":{"id":"20240614122540-shvf7k8","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤或煮食，50-100g。"}]},{"ID":"20240614122540-4c4ful9","Type":"NodeParagraph","Properties":{"id":"20240614122540-4c4ful9","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614122540-80k5vmm","Type":"NodeParagraph","Properties":{"id":"20240614122540-80k5vmm","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 洽少阴病下利、咽痛、胸满、心烦：猪肤一斤。以水一斗，煮取五升，去滓，加白蜜一升，白粉五合，熬香和合相得。温分六服。(《伤寒论》猪肤汤)"}]},{"ID":"20240614122540-gbr26nv","Type":"NodeParagraph","Properties":{"id":"20240614122540-gbr26nv","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614122540-8gkl1fq","Type":"NodeParagraph","Properties":{"id":"20240614122540-8gkl1fq","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 试用猪皮移植烧伤创面。体重10-30kg的小猪宰杀后去毛，取皮浸泡干1：2000新洁尔灭液中15-20分钟，或用1%硫柳汞酊或75% 酒精消毒2-3次；再在无菌操作下，将猪皮自脂肪层剥下（头、脚、爪、尾均不用），反贴于鼓式取皮机的鼓面上，切除脂肪层及一部分真皮层，使皮片的厚度为0.2-0.6mm，切成所需要的大小移植于创面。如果当时不用，应立即置于0-4℃的冰箱中储存，保存时间不超过3周。曾在6例正度烧伤的创面上试用，烧伤总面积60-95%不等，其中皿度烧伤面积占15-18%，猪皮植皮面积2-50% 不等。结果5例生长良好，1例存后月余，对烧伤创面能起保护作用，无不良反应。冷藏20天的猪皮仍可存活。"}]},{"ID":"20240614122540-e1nqs0t","Type":"NodeParagraph","Properties":{"id":"20240614122540-e1nqs0t","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122540-x44hu9w","Type":"NodeParagraph","Properties":{"id":"20240614122540-x44hu9w","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 1.《长沙药解》：猪肤，利咽喉而消肿痛，清心肺而除烦满。《伤寒》猪肤汤治少阴病下利咽痛，胸满心烦者，猪肤、白蜜清金而止痛，润燥而除烦，白粉涩滑清而收泄利也。肺金清凉而司皮毛，猪肤善于清肺，肺气清降，浮火归根，则咽痛与烦满自平也。"}]},{"ID":"20240614122540-f4l50xh","Type":"NodeParagraph","Properties":{"id":"20240614122540-f4l50xh","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"2.《随息居饮食谱》：猪皮即肤也，猪肤甘凉清虚热，洽下利、心烦、咽痛，今医罕用此药矣。若无心烦。咽痛兼症者，是寒滑下利，不宜用此。"}]},{"ID":"20240614122540-1jusd9j","Type":"NodeParagraph","Properties":{"id":"20240614122540-1jusd9j","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：治少阴下痢、咽痛。"}]},{"ID":"20240614122540-m8i4hf4","Type":"NodeParagraph","Properties":{"id":"20240614122540-m8i4hf4","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122540-3eyhcji","Type":"NodeParagraph","Properties":{"id":"20240614122540-3eyhcji","updated":"20240614122540"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614122522-8ghljeb","Type":"NodeThematicBreak","Properties":{"id":"20240614122522-8ghljeb"}},{"ID":"20240614122522-eqme857","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122522-eqme857","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：猪胆"}]},{"ID":"20240614122522-inlu6lx","Type":"NodeParagraph","Properties":{"id":"20240614122522-inlu6lx","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122522-cyf1p7k","Type":"NodeParagraph","Properties":{"id":"20240614122522-cyf1p7k","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" Zhū Dǎn"}]},{"ID":"20240614122522-6uv139p","Type":"NodeParagraph","Properties":{"id":"20240614122522-6uv139p","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122522-slyuiva","Type":"NodeParagraph","Properties":{"id":"20240614122522-slyuiva","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240614122522-ngmdchm","Type":"NodeParagraph","Properties":{"id":"20240614122522-ngmdchm","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122522-1rihi5h","Type":"NodeParagraph","Properties":{"id":"20240614122522-1rihi5h","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 为猪科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"猪"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆汁"},{"Type":"NodeText","Data":"，取得后，挂起晾干，或在半干时稍稍压扁，再干燥之。"}]},{"ID":"20240614122522-s8771sx","Type":"NodeParagraph","Properties":{"id":"20240614122522-s8771sx","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122522-nmjv2nv","Type":"NodeParagraph","Properties":{"id":"20240614122522-nmjv2nv","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 动物形态详\"猪肉\"条。"}]},{"ID":"20240614122522-o9pzi64","Type":"NodeParagraph","Properties":{"id":"20240614122522-o9pzi64","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122522-ofqgc66","Type":"NodeParagraph","Properties":{"id":"20240614122522-ofqgc66","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 胆汁中主要成分为胆汁酸类、胆色素、粘蛋白、脂类及无机物等。胆汁酸中有鹅脱氧胆酸、3α-羟基-6-氧-5α-胆烷酸和石胆酸，它们几乎完全与甘氨酸结合而存在。另含猪胆酸和猪脱氧胆酸。"}]},{"ID":"20240614122522-460yzo1","Type":"NodeParagraph","Properties":{"id":"20240614122522-460yzo1","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614122522-9c0zu4b","Type":"NodeParagraph","Properties":{"id":"20240614122522-9c0zu4b","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" ①镇咳、平喘作用"}]},{"ID":"20240614122522-bf7d7u3","Type":"NodeParagraph","Properties":{"id":"20240614122522-bf7d7u3","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用电刺激麻醉猫喉上神经引起咳嗽的方法证明，静脉注射胆酸钠（20毫克/公斤）有镇咳作用，脱氧胆酸钠及牛磺胆酸钠则无此作用。同样方法用猪胆粉（0.5～1.0克/公斤）灌胃，也有上咳作用，在给药后30～60分钟作用最明显，持续2～2.5小时左右。四此，胆汁可抑制咳嗽中枢的兴奋性，用小鼠氨水喷雾法证明，从鸡胆中提出的鹅脱氧胆酸钠有止咳作用，而粗制品则较差；也有报告，从猪胆中提出的胆酸（钠）有止咳效果，而复方（猪胆、桔梗、半夏、地龙）效果更好一些。"}]},{"ID":"20240614122522-t1qe4x7","Type":"NodeParagraph","Properties":{"id":"20240614122522-t1qe4x7","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用豚鼠组织胺喷雾法初步表明，鹅脱氧胆酸钠有平喘作用。胆酸灌胃（1克/公斤）1小时后，再用组织胺-乙酰胆碱混合液喷雾，对豚鼠亦有某些平喘作用，复方效果更好一些。用豚鼠离体肺灌流，胆汁能解除组织胺引起的支气管痉挛，胆酸钠为此种解痉的有效成分。也有初步报告，对小鼠有祛痰作用。"}]},{"ID":"20240614122522-0zzhl51","Type":"NodeParagraph","Properties":{"id":"20240614122522-0zzhl51","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②消炎、抗过敏作用"}]},{"ID":"20240614122522-59hvhrl","Type":"NodeParagraph","Properties":{"id":"20240614122522-59hvhrl","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"以兔耳在热水（60℃）中烫1分钟以造成炎症，12小时后以猪胆粉0.5克/公斤灌胃，可使炎症（兔耳体积及颜色）消退较对照组为快、对大鼠的甲醛性\"关节炎\"也有一定的抗炎作用。以组织化学法观察肝、脾、肾上腺，肠系膜淋巴结的酸性磷酸酶染色，网状纤维染色及肝脏星状细胞活体染色，作了初步观察，胆汁似能提高抗炎能力。以马血清（0.5毫升，共注射16天）使豚鼠致敏后，心内注射胆酸（5毫克/公斤），10只豚鼠中有7只在接受马血清再注射时，不发生休克现象，而对照组则全部发生。对组织胺性及乙酰胆碱性休克，如能多次注射胆酸，据称也可防止休克的发生，即胆酸有抗过敏性休克的作用。"}]},{"ID":"20240614122522-hgtkpod","Type":"NodeParagraph","Properties":{"id":"20240614122522-hgtkpod","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"③抑菌作用"}]},{"ID":"20240614122522-ymbehh6","Type":"NodeParagraph","Properties":{"id":"20240614122522-ymbehh6","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"在试管中，动物（猪、牛、鸡）的胆汁在高浓度时，对百日咳杆菌有抑制作用，但不如黄连，在体外，羊胆于高浓度（1：100）时，对人型、牛型结核杆菌有抑制作用，而牛胆汁作用很差，服羊胆汁2周后再接种结核杆菌，则豚鼠器官病变较对照组似较轻。对呼吸道常见细菌也有不同程度的抑菌作用，胆酸作用强于复方，尤其肺炎双球菌及流感杆菌较为敏感。对奈瑟氏菌无抑制作用。民间用以治疗痢疾的黑虎丹（以猪胆汁与小米混合制成）在体外对痢疾杆菌、金黄色葡萄球菌、沙门氏杆菌、大肠杆菌等有不同程度的抑菌作用。"}]},{"ID":"20240614122522-0v3q2nt","Type":"NodeParagraph","Properties":{"id":"20240614122522-0v3q2nt","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240614122522-zlfeeud","Type":"NodeParagraph","Properties":{"id":"20240614122522-zlfeeud","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"早年国外报告，牛黄之镇静及抗痉作用主要由其中所含之胆酸及钙盐引起。国内科学工作者亦证明，胆酸敖有拮抗可卡因对小鼠的惊厥作用。在兔肺伸张反射的实验中证明；静脉注射胆酸钠能抑制呼吸中枢的兴奋性；对离体肠管，胆酸钠小剂量有兴奋作用（增加紧张性、节律性），大剂量则抑制。胆汁或胆盐口服后可刺激胆汁分泌，增加肠蠕动，使脂肪易于消化，促进脂溶性物质如胡萝卜素类、维生素K及铁的吸收，并有轻泻作用，能抑制离体蛙心；在蛙全身灌流时能扩张血管。如注入血循环，可引起皂甙样作用，导致溶血。大剂量抑制心脏及神经，对神经、肌肉有直接的毒性作用。"}]},{"ID":"20240614122522-84i2s3w","Type":"NodeParagraph","Properties":{"id":"20240614122522-84i2s3w","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122522-jidtzq2","Type":"NodeParagraph","Properties":{"id":"20240614122522-jidtzq2","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 入肝、胆、肺、大肠经。"}]},{"ID":"20240614122522-3h8zu2l","Type":"NodeParagraph","Properties":{"id":"20240614122522-3h8zu2l","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入心。\""}]},{"ID":"20240614122522-dvyrtja","Type":"NodeParagraph","Properties":{"id":"20240614122522-dvyrtja","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手足阳明经。\""}]},{"ID":"20240614122522-0jfxte2","Type":"NodeParagraph","Properties":{"id":"20240614122522-0jfxte2","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122522-nfrmoqh","Type":"NodeParagraph","Properties":{"id":"20240614122522-nfrmoqh","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240614122522-mktr9rk","Type":"NodeParagraph","Properties":{"id":"20240614122522-mktr9rk","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微寒。\""}]},{"ID":"20240614122522-x6t5oj2","Type":"NodeParagraph","Properties":{"id":"20240614122522-x6t5oj2","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②《本草图经》；\"大寒。\""}]},{"ID":"20240614122522-8peowcj","Type":"NodeParagraph","Properties":{"id":"20240614122522-8peowcj","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"味苦咸，寒。\""}]},{"ID":"20240614122522-5v8mg74","Type":"NodeParagraph","Properties":{"id":"20240614122522-5v8mg74","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122522-moxh3tq","Type":"NodeParagraph","Properties":{"id":"20240614122522-moxh3tq","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 清热，润燥，解毒。治热病里热燥渴、便秘，黄疸，百日咳，哮喘，泄泻，痢疾，目赤，喉痹，聤耳，痈肿疔疮。"}]},{"ID":"20240614122522-pd1uisf","Type":"NodeParagraph","Properties":{"id":"20240614122522-pd1uisf","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"疗伤寒热渴。\""}]},{"ID":"20240614122522-mi0o2y9","Type":"NodeParagraph","Properties":{"id":"20240614122522-mi0o2y9","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主小儿头疮，取胆汁敷之。\""}]},{"ID":"20240614122522-85z187z","Type":"NodeParagraph","Properties":{"id":"20240614122522-85z187z","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"主骨热劳极，伤寒及渴疾，小儿五疳，杀虫。\""}]},{"ID":"20240614122522-nyf5d25","Type":"NodeParagraph","Properties":{"id":"20240614122522-nyf5d25","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"通小便，敷恶疮，杀疳匿，治日赤、目翳，明日，清心脏，凉肝脾。\""}]},{"ID":"20240614122522-go0a4gw","Type":"NodeParagraph","Properties":{"id":"20240614122522-go0a4gw","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑤《随息居饮食谱》：\"补胆，清热，治热痢，通热秘。治厥颠疾。\""}]},{"ID":"20240614122522-e70klh8","Type":"NodeParagraph","Properties":{"id":"20240614122522-e70klh8","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614122522-vsvr5zs","Type":"NodeParagraph","Properties":{"id":"20240614122522-vsvr5zs","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 内服；煎汤，取汁冲服1～2钱；或入丸，散。外用：涂敷、点眼或灌肠。"}]},{"ID":"20240614122522-vynxffm","Type":"NodeParagraph","Properties":{"id":"20240614122522-vynxffm","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614122522-ha8bx8a","Type":"NodeParagraph","Properties":{"id":"20240614122522-ha8bx8a","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" ①治伤寒五、六日，斑出：猪胆、苦酒各三合，鸡子一枚。三味合煎三沸，强人尽服之，羸人须煎六、七沸，分为二服，汗出即愈。（《千金方》猪胆汤）"}]},{"ID":"20240614122522-3iksmls","Type":"NodeParagraph","Properties":{"id":"20240614122522-3iksmls","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②治口中干燥无津液而渴：雄猪胆五枚，定粉（《纲目》引作天花粉）一两。-上二味，以酒煮胆，候皮烂，即入粉研细，同煎成煎，丸如鸡头大，每服二丸，含化咽津。（《圣济总录》猪胆煎）"}]},{"ID":"20240614122522-t2h442p","Type":"NodeParagraph","Properties":{"id":"20240614122522-t2h442p","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"③治阳明病津液内竭，大便硬，不可攻：大猪胆汁一枚，泻汁，和少许法醋，以灌谷道内，如一食顷，当大便出宿食恶物。（《伤寒论》猪胆汁导法）"}]},{"ID":"20240614122522-odfauos","Type":"NodeParagraph","Properties":{"id":"20240614122522-odfauos","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"④治大便燥结：猪胆、蜂蜜，煎服。（《四川中药志》）"}]},{"ID":"20240614122522-6bte4ns","Type":"NodeParagraph","Properties":{"id":"20240614122522-6bte4ns","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑤治少阴病，下利脉微者，与白通汤，利不止，厥逆无脉，乾呕烦者：葱白四茎，干姜一两，附子一枚（生，去皮，破八片），人尿五合猪胆汁一合。上五味，以水三升，煮取一升，去滓，内胆汁，人尿，和令相得，分温再服。（《伤寒论》白通加猪胆汁汤）"}]},{"ID":"20240614122522-r0132xx","Type":"NodeParagraph","Properties":{"id":"20240614122522-r0132xx","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑥治黄病：猪胆一个，鸡蛋一个。共调匀，不拘时服。如嫌苦难下，用于糕咽之，连服三次。（《梅氏验方新编》猪胆蛋）"}]},{"ID":"20240614122522-dlvhbev","Type":"NodeParagraph","Properties":{"id":"20240614122522-dlvhbev","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑦治瘦病咳嗽：猪胆和小便、生姜、橘皮、诃梨勒、桃皮。煮服。（《本草拾遗》）"}]},{"ID":"20240614122522-lwl4cvb","Type":"NodeParagraph","Properties":{"id":"20240614122522-lwl4cvb","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑧治目赤病及胎赤：猪胆和绿盐五分，点眦。（《广济方》）"}]},{"ID":"20240614122522-drw9xod","Type":"NodeParagraph","Properties":{"id":"20240614122522-drw9xod","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑨治翳膜：猪胆一只，硇砂（细研）穰在猪胆中成膏，系定，悬当风处，候白衣如霜出，扫下收瓷合子内，旋旋用柱子点入眦中，觉痒乃罢，便无翳膜，未尽再点之。（《鸡峰普济方》猪胆膏）"}]},{"ID":"20240614122522-0y4t3u3","Type":"NodeParagraph","Properties":{"id":"20240614122522-0y4t3u3","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑩治喉痛：猪胆、射干、玄明粉、人中白、知母。煎服。（《四川中药志》）"}]},{"ID":"20240614122522-owmcsny","Type":"NodeParagraph","Properties":{"id":"20240614122522-owmcsny","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑾治痔疮：猪胆七枚，取汁，炭火熬成膏，用单纸摊敷，须先用槐根白皮煎汤温洗。然后敷药。（《仁斋直指方》猪胆膏）"}]},{"ID":"20240614122522-2t3h77z","Type":"NodeParagraph","Properties":{"id":"20240614122522-2t3h77z","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑿治汤火伤疮：猪胆调黄柏末涂之。（《外台》）"}]},{"ID":"20240614122522-lz1yyww","Type":"NodeParagraph","Properties":{"id":"20240614122522-lz1yyww","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⒀治诸般痫搐：半夏一两（汤洗七遍），狼猪胆三个，取汁浸半夏于瓷器中，晒干，切片焙燥，为细末，生姜自然汁煮面和丸，桐子大，每服五、七丸至十丸，煎麦门冬熟水下，食后临卧各一服。（《小儿卫生总微论方》猪胆半夏丸）"}]},{"ID":"20240614122522-qkyr9j1","Type":"NodeParagraph","Properties":{"id":"20240614122522-qkyr9j1","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614122522-fq4vtsf","Type":"NodeParagraph","Properties":{"id":"20240614122522-fq4vtsf","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" ①预防白喉"}]},{"ID":"20240614122522-jphrw9h","Type":"NodeParagraph","Properties":{"id":"20240614122522-jphrw9h","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"职新鲜猪胆汁，或猪、鱼胆汁混合，加等量砂糖，蒸30～60分钟。托儿所小孩每次服1～2毫升，幼儿园小孩每次服2～3毫升，每天服2次，连服4天。咽拭培养阳性的隔1个月再服4天。曾先后在流行区的托儿所、幼儿园用上法给药2046人，经1年以上观察，无1例发病。其中320人在服药前做过咽液培养，阳性带菌者34人，经第1次服药后1～2周复查，28例转阴，4例第2次服药后转阴。同时期散居的儿童未经预防服药者有4例发病。经3次抑菌试验，证明猪胆汁对白喉杆菌有一定的抑菌能力，但无杀灭作用。"}]},{"ID":"20240614122522-vc8sl8l","Type":"NodeParagraph","Properties":{"id":"20240614122522-vc8sl8l","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"②治疗急性胃肠炎、菌痢等"}]},{"ID":"20240614122522-038a75b","Type":"NodeParagraph","Properties":{"id":"20240614122522-038a75b","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用新鲜猪胆汁100毫升，加入绿豆粉1斤混合搅拌，制成药丸（绿胆丸）。成人每次2～3钱，儿童每次3分，日服3～4次。治疗急性胃肠炎31例，治愈28例，好转1例，无效2例：细菌性痢疾26例，治愈24例，好转2例；慢性肠炎4例，治愈2例，好转1例。无效1例；小儿单纯性消化不良4例，治愈3例，好转1例；卡他性肠炎8例，好转1例，无效2例；慢性结肠炎7例，治愈3例，好转2例，无效2例；泌尿系感染13例，治愈12例，好转1例。遇有脱水现象者仍须补液。部分病例在用药1～2天内即出现疗效，并无副作用。"}]},{"ID":"20240614122522-5l8ei6a","Type":"NodeParagraph","Properties":{"id":"20240614122522-5l8ei6a","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"③治疗百日咳"}]},{"ID":"20240614122522-zqq8px3","Type":"NodeParagraph","Properties":{"id":"20240614122522-zqq8px3","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"采用猪胆汁粉剂、糖浆和流浸膏等，胆汁粉剂，6个月以内，每次0.2克，每天1～2次；6个月至1岁，每次0.3克，每日2次；1～4岁每次0.4克，每天2次；4～7岁每次0.5～0.6克，每日2次；胆汁流浸膏，1～2岁每次1.5～2.0毫升，2～4岁每次2～3毫升，4～6岁每次3～4毫升，均每日3次，食后服；7.7％猪胆汁糖浆，6个月以下每次5毫升，6个月至1岁每次8毫升，1～4岁每次10毫升，4～7岁每次13～15毫升，日服2次，连服3～5日。根据1215例的治疗结果，一般服后2～4天开始生效，疗程为5～14天，总有效率约在62～97％之间。"}]},{"ID":"20240614122522-mmrl9wk","Type":"NodeParagraph","Properties":{"id":"20240614122522-mmrl9wk","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"④治疗急性传染性肝炎"}]},{"ID":"20240614122522-he8d1x9","Type":"NodeParagraph","Properties":{"id":"20240614122522-he8d1x9","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"将鲜猪胆汁烘干研粉，装胶囊，治疗黄疸型肝炎10例，用量以黄疸指数为依据，黄疸指数在10～40单位者每次1钱，日服3次；40～70单位者，每日4钱，分3次服；70～100单位者，每日5钱，分3次服。均在服药3天后消化道症状有不同程度改善，7天后食量大增；黄疸指数在1～2周内恢复正常，黄疸消失平均9.9天。疗程11～25天。随访1年均未复发。有用猪胆汁片（含猪胆汁粉0.2克），每次1～2片，日服3次，治疗传染性肝炎32例（其中黄疸型7例）。治疗后食欲不振、腹胀、乏力、肝区疼痛等自觉症状均有明显改善，7例黄疸型患者1周后黄疸全部消失；肝肿大26例，治疗后恢复正常者13例，不同程度缩小者8例，无改变者5例；肝功能检查，有前后对照者14例，治疗后对麝香草酚絮状试验及转氨酶等，均有较明显的改善。"}]},{"ID":"20240614122522-v3dldbu","Type":"NodeParagraph","Properties":{"id":"20240614122522-v3dldbu","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑤治疗慢性气管炎"}]},{"ID":"20240614122522-9obrffg","Type":"NodeParagraph","Properties":{"id":"20240614122522-9obrffg","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用鲜猪胆汁加热浓缩，烘干磨细粉，装入胶囊，每次0.5克，日服3次（空腹开水送下）；治疗143例，近期控制13例（9.03％），显效35例（24.48％）。或用鲜胆汁1份，淀粉2份，混合炒拌均匀，待干燥后研粉压制成片，每片含猪胆汁0.3克，每次2～3片，日服3次，7天为一疗程；经治疗119例，显效12例，占10％。其中以单纯型患者的效果较好。又可采用猪胆汁（浓缩）注射液，每安瓿2毫升（含猪胆汁原液3毫升），肌肉注射，每次2毫升，每日或隔日1次，10天为一疗程。共治疗64例，近期控制5例，显效21例，两者共占40.62％。对合并肺结核及支气管扩张症者，其止咳、祛痰、平喘疗效并不受影响，但注射后多有局部疼痛。也可用猪胆汁与维生素C注射液等量作穴位注射。选穴：主穴为定喘、肺俞；配穴为大杼、肺热、心俞。各穴交替使用，每次选用1～2穴，每穴注入0.2～0.35毫升，每用2次，4～5次为一疗程。间隔10～15天，再进行下一疗程。治疗51例，临床治愈6例，显效16例，两者共占43.1％。副作用有不同程度的背部发沉、疼痛，一般持续12～36小时，个别患者有发冷发烧，局部肿胀等，予以一股对症处理即可。"}]},{"ID":"20240614122522-eqatvvb","Type":"NodeParagraph","Properties":{"id":"20240614122522-eqatvvb","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"此外，临床曾以猪胆汁分别配合半夏、赤小豆、何首乌、淫羊藿、地龙、百部和甘草、细辛和白胡椒、白花蛇舌草等组成多种复方，观察数十例或数百例，总有效率约在71.4～94.3％之间。实验证明猪苦胆具有明显的镇咳作用，用药后能使咳嗽的兴奋阈增高。"}]},{"ID":"20240614122522-thgmi0v","Type":"NodeParagraph","Properties":{"id":"20240614122522-thgmi0v","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑥治疗单纯性消化不良"}]},{"ID":"20240614122522-1nswgvo","Type":"NodeParagraph","Properties":{"id":"20240614122522-1nswgvo","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用3％猪胆汁粉糖浆，6个月以下每日4毫升，6个月至1岁6毫升，1～4岁3毫升，4～7岁10毫升，分3～4次内服。可连用数天，无任何副作用。治疗81例，治愈71例，好转7例，无效3例。病程以2～10天为多，最长者为5个月。用药后多在2～4天见愈。认为猪胆汁能溶解脂肪酸并助其吸收，从而减少肠内易于腐败物质之产生，故能发挥良好的治疗作用。"}]},{"ID":"20240614122522-3oog79o","Type":"NodeParagraph","Properties":{"id":"20240614122522-3oog79o","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑦用于妇产科各种手术及炎症感染"}]},{"ID":"20240614122522-l45er5u","Type":"NodeParagraph","Properties":{"id":"20240614122522-l45er5u","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用猪胆汁、黄芩素制成注射液，每次肌肉注射2毫升，每日2次。曾用于卵巢肿瘤切除、宫外孕手术、绝育手术等术后感染，及慢性盆腔炎、尿路感染等疾病计200例，代替抗菌素，有效率92％。取鲜猪胆汁、白矾制成粉剂作宫颈喷撒，曾试治慢性宫颈炎100余例，有一定疗效。"}]},{"ID":"20240614122522-kxni271","Type":"NodeParagraph","Properties":{"id":"20240614122522-kxni271","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑧治疗砂眼"}]},{"ID":"20240614122522-4yr6o5f","Type":"NodeParagraph","Properties":{"id":"20240614122522-4yr6o5f","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"取鲜猪胆汁过滤使呈清亮溶液，用生理盐水稀释成10％浓度，高压消毒后点眼。治疗砂眼患者39人，每次每眼1滴，每日3次，10日为一疗程。结果痊愈及基本痊愈率为66.67％，较对照组用黄连液点眼的治愈率为高。另法用鲜猪胆汁50毫升，1：1000肾上腺素1毫升，5％普鲁卡因5毫升，混合过滤后在水浴上煮沸1分钟，每日点眼3次；治疗989例，治愈率为60.13～72.7％，而对照组用0.5％金霉素溶液的治愈率为15.4％。"}]},{"ID":"20240614122522-3v6vkkx","Type":"NodeParagraph","Properties":{"id":"20240614122522-3v6vkkx","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑨治疗慢性化脓性中耳炎"}]},{"ID":"20240614122522-1yj9gm9","Type":"NodeParagraph","Properties":{"id":"20240614122522-1yj9gm9","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"取鲜猪胆汁烘干研粉，加等量或2倍明矾粉拌匀。用于治疗一般慢性化脓性中耳炎，无骨质破坏和胆脂瘤者。使用前先用双氧水清洗外耳道，拭干后将胆矾粉均匀喷入鼓膜穿孔处。量勿过多，以免妨碍引流。治疗149例，计163只耳。经3次喷药治疗后干耳者为75.2％，全部病例的干耳率为96％。治疗次数平均为3.2次。多数患者第一次上药后，次日分泌物增多变稀，2～3日后分泌物锐减，逐渐干燥。经较长时期观察，有26例复发。防止呼吸道感染，清除鼻咽部感染灶是防止复发的有效措施。实验室对66例化脓性中耳炎分泌物用胆矾粉作了抑菌试验，多数细菌均有不同程度的敏感性，而对抗菌素则产生耐药性。"}]},{"ID":"20240614122522-eh93irb","Type":"NodeParagraph","Properties":{"id":"20240614122522-eh93irb","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"⑩用作通便剂"}]},{"ID":"20240614122522-63o74h4","Type":"NodeParagraph","Properties":{"id":"20240614122522-63o74h4","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"新鲜猪胆汁经高压蒸汽消毒或煮沸消毒10分钟，冷藏。成人6O～100毫升，儿童30～40毫升，加温至27℃左右作保留灌肠。试用于腹部手术后及产妇便秘，手术后气胀，麻痹性肠梗阻等病人，计394例，多数病人经半小时左右可排便，少数病人需延长至2小时。便量多而自感舒适者382例（97％）。6例肠梗阻病人应用胆汁灌肠后，梗阻现象在短时间内解除，未采用其他方法处理。"}]},{"ID":"20240614122522-3wd9u1b","Type":"NodeParagraph","Properties":{"id":"20240614122522-3wd9u1b","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122522-p8ur38k","Type":"NodeParagraph","Properties":{"id":"20240614122522-p8ur38k","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"方家用猪胆，取其寒能胜热，滑能润燥，苦能入心，又能去肝胆之火也。\""}]},{"ID":"20240614122522-i4151v0","Type":"NodeParagraph","Properties":{"id":"20240614122522-i4151v0","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122522-xtfbori","Type":"NodeParagraph","Properties":{"id":"20240614122522-xtfbori","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614122522-k26msgw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614122522-k26msgw","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"《中华本草》：猪胆"}]},{"ID":"20240614122522-kgdisit","Type":"NodeParagraph","Properties":{"id":"20240614122522-kgdisit","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614122522-tn8vh62","Type":"NodeParagraph","Properties":{"id":"20240614122522-tn8vh62","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" Zhū Dǎn"}]},{"ID":"20240614122522-xvml46e","Type":"NodeParagraph","Properties":{"id":"20240614122522-xvml46e","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614122522-pa2ipmv","Type":"NodeParagraph","Properties":{"id":"20240614122522-pa2ipmv","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" Pig's gallbladder"}]},{"ID":"20240614122522-ey6ollb","Type":"NodeParagraph","Properties":{"id":"20240614122522-ey6ollb","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614122522-7jkqor1","Type":"NodeParagraph","Properties":{"id":"20240614122522-7jkqor1","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》"}]},{"ID":"20240614122522-ul86agr","Type":"NodeParagraph","Properties":{"id":"20240614122522-ul86agr","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614122522-6wv4bw7","Type":"NodeParagraph","Properties":{"id":"20240614122522-6wv4bw7","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 药材基源：为猪科动物猪的胆汁。"}]},{"ID":"20240614122522-syg4qx8","Type":"NodeParagraph","Properties":{"id":"20240614122522-syg4qx8","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sus scrofa domestica Brisson"}]},{"ID":"20240614122522-to2qikz","Type":"NodeParagraph","Properties":{"id":"20240614122522-to2qikz","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"采收和储藏：宰杀后，剖腹取出胆囊，取胆汗鲜用或将胆囊挂起晾干，或在半干时稍稍压扁，再干燥之。"}]},{"ID":"20240614122522-41chm5q","Type":"NodeParagraph","Properties":{"id":"20240614122522-41chm5q","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614122522-az9kz9j","Type":"NodeParagraph","Properties":{"id":"20240614122522-az9kz9j","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 生态环境：杂食性家养物畜，繁殖力强，孕期约4个月。"}]},{"ID":"20240614122522-j3gelrz","Type":"NodeParagraph","Properties":{"id":"20240614122522-j3gelrz","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地均有饲养。"}]},{"ID":"20240614122522-3dcr0re","Type":"NodeParagraph","Properties":{"id":"20240614122522-3dcr0re","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614122522-xnoqk39","Type":"NodeParagraph","Properties":{"id":"20240614122522-xnoqk39","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 猪的品种繁多，达150多种，形态也有差异基本特微是：躯体肥胖，头大。鼻与口吻皆长略向上屈。眼小。耳壳有的大而下垂，有的较小而前挺。四肢短小，4趾，前2趾有蹄，后2趾有悬蹄。颈粗，项背疏生鬃毛。尾短小，末端有毛丛。毛色有纯黑、纯白或黑白混杂等。"}]},{"ID":"20240614122522-le16730","Type":"NodeParagraph","Properties":{"id":"20240614122522-le16730","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614122522-w9x6i0x","Type":"NodeParagraph","Properties":{"id":"20240614122522-w9x6i0x","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 大剂量抑制心脏及神经，对神经、肌肉有直接的毒性作用。"}]},{"ID":"20240614122522-27abvh7","Type":"NodeParagraph","Properties":{"id":"20240614122522-27abvh7","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614122522-6ufmgwm","Type":"NodeParagraph","Properties":{"id":"20240614122522-6ufmgwm","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 猪胆汁中主要成分为胆汁酸类，胆色素、粘蛋白、脂类及无机物等。胆汁酸中有鹅脱氧胆酸(chenodeoxycholic acid)、3a- 羟基- 6- 氧- 5α-胆烷酸(3α- hydroxy-6- oxo-5α-cholanic acid)和石胆酸(llthocholic acid)，它们几乎完全与甘氨酸结合而存在。另含猪胆酸(hyocholic acid),猪脱氧胆酸(hyodeoxycholic acid)，3β，6α-二羟基胆烷酸（3β，6α-dihydroxycholanic acid）。"}]},{"ID":"20240614122522-dsswbyq","Type":"NodeParagraph","Properties":{"id":"20240614122522-dsswbyq","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614122522-uilyax0","Type":"NodeParagraph","Properties":{"id":"20240614122522-uilyax0","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 1.镇咳、平喘作用：用电刺激麻醉猫喉上神经引起咳嗽的方法证明，静脉注射胆酸钠（20mg／kg）有镇咳作用，脱氧胆酸钠及牛磺胆酸钠则无此作用。同样方法用猪胆粉（0.5-1.Og／kg）灌胃，也有止咳作用，在给药后30-60分钟作用最明显，持续2-2.5小时左右。因此，胆汁可抑制咳嗽中枢的兴奋性，用小鼠氨水喷雾法证明，从鸡胆中提出的鹅脱氧胆酸钠有止咳作用，而粗制品则较差：也有报告，从猪胆中提出的胆酸（钠）有止咳效果，而复方（猪胆、桔梗、半夏、地龙）效果更好一些。用豚鼠组织胺喷雾法初步表明，鹅脱氧胆酸钠有平喘作用。胆酸灌胃（1 g／kg）1小时后，再用组织胺- 乙酞胆碱混合液喷雾，对豚鼠亦有某些平喘作用，复方效果更好一些。用豚鼠离体肺灌流，胆汁能解除组织胺引起的支气管痉挛。胆酸钠为此种解痉的有效成分。也有初步报告，对小鼠有祛痰作用。"}]},{"ID":"20240614122522-snnoa1z","Type":"NodeParagraph","Properties":{"id":"20240614122522-snnoa1z","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"2.消炎、抗过敏作用：以免耳在热水（60℃）中烫1分钟以造成炎症，12小时后以猪胆粉0.5g／kg灌胃，可使炎症（兔耳体积及颜色）消退较对照组为快。对大鼠的甲醛性关节炎也有一定的抗炎作用。以组织化学法观察肝、脾、肾上腺，肠系膜淋巴结的酸性磷酸酶染色，网状纤维染色及肝脏星状细胞活体染色，作了初步观察，胆汁似能提高抗炎能力。以马血清（0.5ml，共注射16天）使豚鼠致敏后，心内注射胆酸（5mg／kg），10只豚鼠中有7只在接受马血清再注射时，不发生休克现象，而对照组则全部发生。对组织胺性及乙酰胆碱性休克，如能多次注射胆酸，据称也可防止休克的发生，即胆酸有抗过敏性休克的作用。"}]},{"ID":"20240614122522-ecm3maf","Type":"NodeParagraph","Properties":{"id":"20240614122522-ecm3maf","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"3.抑菌作用：在试管中，动物（猪、牛、鸡）的胆汁在高浓度时，对百日咳杆菌有抑制作用，但不如黄连，在体外，羊胆于高浓度（1∶100）时，对人型、牛型结核杆菌有抑制作用，而牛胆汁作用很差，服羊胆汁2周后再接种结核杆菌，则豚鼠器官病变较对照组似较轻。对呼吸道常见细菌也有不同程度的抑菌作用，胆酸作用强于复方，尤其肺炎双球菌及流感杆菌较为敏感。对奈瑟氏菌无抑制作用。民间用以治疗痢疾的黑虎丹（以猪胆汁与小米混合制成）在体外对痢疾杆菌、金黄色葡萄球菌、沙门氏杆菌、大肠杆菌等有不同程度的抑菌作用。"}]},{"ID":"20240614122522-2shb72h","Type":"NodeParagraph","Properties":{"id":"20240614122522-2shb72h","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"4.其他作用：早年国外报告，牛黄之镇静及抗痉作用主要由其中所含之胆酸及钙盐引起。国内科学工作者亦证明，胆酸盐有拮抗可卡因对小鼠的惊厥作用。在兔肺伸张反射的实验中证明，静脉注射胆酸钠能抑制呼吸中枢的兴奋性，对离体肠管，胆酸钠小剂量有兴奋作用（增加紧张性、节律性），大剂量则抑制。胆汁或胆盐口服后可刺激胆汁分泌，增加肠蠕动，使脂肪易于消化，促进脂溶性物质如胡萝卜素类，维生素K及铁的吸收，并有轻泻作用。能抑制离体蛙心；在蛙全身灌流时能扩张血管。如注入血循环，可引起皂甙样作用，导致溶血。"}]},{"ID":"20240614122522-t8vhl47","Type":"NodeParagraph","Properties":{"id":"20240614122522-t8vhl47","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614122522-37fjcmq","Type":"NodeParagraph","Properties":{"id":"20240614122522-37fjcmq","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 肝；胆；肺；大肠经"}]},{"ID":"20240614122522-clwu6yg","Type":"NodeParagraph","Properties":{"id":"20240614122522-clwu6yg","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614122522-7oqevjp","Type":"NodeParagraph","Properties":{"id":"20240614122522-7oqevjp","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240614122522-955b5wp","Type":"NodeParagraph","Properties":{"id":"20240614122522-955b5wp","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614122522-8xhnhf3","Type":"NodeParagraph","Properties":{"id":"20240614122522-8xhnhf3","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 清热；润燥；解毒。主热病燥渴；大便秘结；咳嗽；哮喘；目赤；目翳；泄痢；黄疸；喉痹；聤耳；痈疽疔疮；鼠瘘；湿疹；头癣"}]},{"ID":"20240614122522-h0r3c3z","Type":"NodeParagraph","Properties":{"id":"20240614122522-h0r3c3z","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614122522-qw2zwsi","Type":"NodeParagraph","Properties":{"id":"20240614122522-qw2zwsi","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g；或取汁中，每次3-6g；或入丸、散。外用：适量，涂敷、点眼或灌肠。"}]},{"ID":"20240614122522-zl8oqkg","Type":"NodeParagraph","Properties":{"id":"20240614122522-zl8oqkg","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614122522-4w23rae","Type":"NodeParagraph","Properties":{"id":"20240614122522-4w23rae","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 《纲目》：方家用猪胆，取其寒能胜热，滑能润燥，苦能入心，又能去肝胆之火也。"}]},{"ID":"20240614122522-nus75oo","Type":"NodeParagraph","Properties":{"id":"20240614122522-nus75oo","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614122522-o49gv7z","Type":"NodeParagraph","Properties":{"id":"20240614122522-o49gv7z","updated":"20240614122522"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614122524-hhjop7q","Type":"NodeThematicBreak","Properties":{"id":"20240614122524-hhjop7q"}},{"ID":"20240614122525-op9xx73","Type":"NodeParagraph","Properties":{"id":"20240614122525-op9xx73"}}]}