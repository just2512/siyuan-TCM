{"ID":"20240506112403-8km9z24","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506112403-8km9z24","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506112403-8km9z24\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506112403-5x435wi\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614114932-e6svgry\u0026quot;,\u0026quot;scrollTop\u0026quot;:40,\u0026quot;focusId\u0026quot;:\u0026quot;20240614115318-dk03q1i\u0026quot;,\u0026quot;focusStart\u0026quot;:11,\u0026quot;focusEnd\u0026quot;:11\u0026#125;","title":"372补15粳米","type":"doc","updated":"20240828142507"},"Children":[{"ID":"20240704154354-t79ghzn","Type":"NodeParagraph","Properties":{"id":"20240704154354-t79ghzn","updated":"20240704154421"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米6-20240704154354-uynrpr1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704154525-oziqlm8","Type":"NodeParagraph","Properties":{"id":"20240704154525-oziqlm8","updated":"20240704154525"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 578px;","style":"width: 568px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米5-20240704154525-9ng5o2e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 568px;\" parent-style=\"width: 578px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828142449-c3j3o0c","Type":"NodeParagrap