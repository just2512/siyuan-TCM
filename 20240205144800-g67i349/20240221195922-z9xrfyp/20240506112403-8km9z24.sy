\"width: 841px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828142224-8cn6edh","Type":"NodeParagraph","Properties":{"id":"20240828142224-8cn6edh","updated":"20240828142231"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 445px;","style":"width: 435px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米 1-20240828142224-dtfm73a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 435px;\" parent-style=\"width: 445px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 804px;","style":"width: 794px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米2-20240704154026-5cqdapx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 794px;\" parent-style=\"width: 804px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828142321-85ykr0p","Type":"NodeParagraph","Properties":{"id":"20240828142321-85ykr0p","updated":"20240828142326"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米 2-20240828142321-w50hnk1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 672px;","style":"width: 662px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米3-20240704154129-6h4zylk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 662px;\" parent-style=\"width: 672px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704155534-svu71el","Type":"NodeParagraph","Properties":{"id":"20240704155534-svu71el","updated":"20240828142457"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 761px;","style":"width: 751px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"梗米11"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/梗米11-20240704155635-cma6x9o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 751px;\" parent-style=\"width: 761px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 377px;","style":"width: 367px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"梗米叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/梗米叶-20240704155454-zq6k5rr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 367px;\" parent-style=\"width: 377px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704155826-8zpnk23","Type":"NodeParagraph","Properties":{"id":"20240704155826-8zpnk23","updated":"20240828142432"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 767px;","style":"width: 757px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粳米12"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粳米12-20240704155826-fojz3sx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 757px;\" parent-style=\"width: 767px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828142507-1de8ug8","Type":"NodeParagraph","Properties":{"id":"20240828142507-1de8ug8","updated":"20240828142507"}},{"ID":"20240704153448-gwkf1bp","Type":"NodeParagraph","Properties":{"id":"20240704153448-gwkf1bp","updated":"20240704153451"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对比"}]},{"ID":"20240704153541-fg7na1w","Type":"NodeParagraph","Properties":{"id":"20240704153541-fg7na1w","updated":"20240704153541"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1214px;","style":"width: 1204px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大米对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大米对比-20240704153541-2ay44fx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1204px;\" parent-style=\"width: 1214px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704153244-krbhtbn","Type":"NodeParagraph","Properties":{"id":"20240704153244-krbhtbn","updated":"20240704153734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：大米分三种，分别是粳米，籼米，糯米。糯米粘稠度高，一般用于制作甜点；我们所说的长粒米就是籼米，圆粒米就是粳米；"}]},{"ID":"20240614115308-nxj1p62","Type":"NodeThematicBreak","Properties":{"id":"20240614115308-nxj1p62"}},{"ID":"20240614115318-hzifwin","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115318-hzifwin","updated":"20240614115324"},"Children":[{"Type":"NodeText","Data":"粳米《汤液本草》"}]},{"ID":"20240614115318-ai04yy4","Type":"NodeParagraph","Properties":{"id":"20240614115318-ai04yy4","updated":"20240614115318"},"Children":[{"Type":"NodeText","Data":"气微寒，味甘、苦。甘平。无毒。"}]},{"ID":"20240614115318-g6dzdne","Type":"NodeParagraph","Properties":{"id":"20240614115318-g6dzdne","updated":"20240614115318"},"Children":[{"Type":"NodeText","Data":"入手太阴经、少阴经。"}]},{"ID":"20240614115318-dk03q1i","Type":"NodeParagraph","Properties":{"id":"20240614115318-dk03q1i","updated":"20240614115318"},"Children":[{"Type":"NodeText","Data":"《液》云∶主益气，止烦、止渴、止泄。与熟鸡头相合，作粥食之，可以益精强志，耳目聪明。本草诸家共言益脾胃，如何白虎汤用之入肺？以其阳明为胃之经，色为西方之白，故入肺也。然治阳明之经，即在胃也。色白，味甘寒，入手太阴。又少阴证桃花汤用此，甘以补正气；竹叶石膏汤用此，甘以益不足。"}]},{"ID":"20240614115318-i4yq9qe","Type":"NodeParagraph","Properties":{"id":"20240614115318-i4yq9qe","updated":"20240614115318"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶平和五脏，补益胃气，其功莫逮。然稍生，则复不益脾；过熟，则佳。"}]},{"ID":"20240614115308-m5nwej5","Type":"NodeThematicBreak","Properties":{"id":"20240614115308-m5nwej5"}},{"ID":"20240614115309-qt5k9r0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115309-qt5k9r0","updated":"20240614115313"},"Children":[{"Type":"NodeText","Data":"粳米《本草衍义》"}]},{"ID":"20240614115309-n1iyc38","Type":"NodeParagraph","Properties":{"id":"20240614115309-n1iyc38","updated":"20240614115309"},"Children":[{"Type":"NodeText","Data":"白晚米为第一，早熟米不及也。平和五脏，补益胃气，其功莫逮。然稍生则复不益脾，过熟则佳。"}]},{"ID":"20240614115210-qldowj8","Type":"NodeThematicBreak","Properties":{"id":"20240614115210-qldowj8"}},{"ID":"20240614115236-joln48y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115236-joln48y","updated":"20240614115241"},"Children":[{"Type":"NodeText","Data":"粳米《药征续编》"}]},{"ID":"20240614115236-0wqcjzc","Type":"NodeParagraph","Properties":{"id":"20240614115236-0wqcjzc","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"白虎汤、白虎加桂枝汤、白虎加人参汤。"}]},{"ID":"20240614115236-tb1zfmg","Type":"NodeParagraph","Properties":{"id":"20240614115236-tb1zfmg","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"上三方，粳米各六合。"}]},{"ID":"20240614115236-ayyvzd0","Type":"NodeParagraph","Properties":{"id":"20240614115236-ayyvzd0","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"附子粳米汤、竹叶石膏汤。"}]},{"ID":"20240614115236-h97plyt","Type":"NodeParagraph","Properties":{"id":"20240614115236-h97plyt","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"上二方，粳米各半升。"}]},{"ID":"20240614115236-ok028xz","Type":"NodeParagraph","Properties":{"id":"20240614115236-ok028xz","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"桃花汤。"}]},{"ID":"20240614115236-il1vmid","Type":"NodeParagraph","Properties":{"id":"20240614115236-il1vmid","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"上一方，粳米一升。"}]},{"ID":"20240614115236-20dkuxm","Type":"NodeParagraph","Properties":{"id":"20240614115236-20dkuxm","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"麦门冬汤。"}]},{"ID":"20240614115236-7qsfu14","Type":"NodeParagraph","Properties":{"id":"20240614115236-7qsfu14","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"上一方，粳米三合。"}]},{"ID":"20240614115236-spljfk4","Type":"NodeParagraph","Properties":{"id":"20240614115236-spljfk4","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240614115236-n9b0or4","Type":"NodeParagraph","Properties":{"id":"20240614115236-n9b0or4","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"粳者，稻之不粘者，又名粳。罗愿曰∶稻。一名 ，然有粘不粘者，今人以粘为糯，不粘为粳。"}]},{"ID":"20240614115236-t5rlim4","Type":"NodeParagraph","Properties":{"id":"20240614115236-t5rlim4","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"【辨误】"}]},{"ID":"20240614115236-i2kuaxq","Type":"NodeParagraph","Properties":{"id":"20240614115236-i2kuaxq","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"明·李春懋曰∶凡仲景方法，用米者皆稻米。王叔和改稻米作粳米，后世方家仿之，不知其是非。余曰∶其是是非非，春懋所能知也。夫人未尝知所以仲景方法，与病证相对，而何得分辨糯粳二米之功乎哉？夫稻也者，粳糯通称也。 亦然。颜师古刊误正俗（《本草纲目》掌禹锡所引证）。《本草》稻米，即今糯米也。或通呼粳糯为稻。《礼记》曰∶稻，曰嘉蔬。"}]},{"ID":"20240614115236-gw8axye","Type":"NodeParagraph","Properties":{"id":"20240614115236-gw8axye","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"孔子曰∶食夫稻。《周官》有稻人。郑玄曰∶以水泽之地，种谷也。 按∶谷者粳糯并称焉。汉有稻田使者，是通指糯粳而言。所以后人混称，不知稻即糯也。颜说非也，禹锡亦不知其非也。既谓通呼粳糯为稻，并通指粳糯而言，而又云后人混称，不知稻是即糯也。今根据此二说，而谓汉以上无粳米，皆是臆度不足取焉，李春懋亦未知此谬矣。王叔和改稻米作粳米。此说未知出于何书，但《外台秘要》第五温疟病方内，引《千金》论白虎加桂枝汤，服度煮法后曰∶《伤寒论》云∶用秕粳米。不熟稻米是也。今校之《千金》二方，无所见焉。古本有此说，亦不可知矣。我们常根据仲景之方，而试粳米之功，奏其方之效，则今粳米，即古粳米，不俟余辨矣。医者苟用之，不别粳糯亦可也。殊不知粳糯，即是一稻米矣。又按《肘后方》，治卒腹痛，粳米煮饮之，是即附子粳米汤方内，用粳米之意，葛洪盖取之乎。"}]},{"ID":"20240614115236-97iflit","Type":"NodeParagraph","Properties":{"id":"20240614115236-97iflit","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240614115236-01wt0kb","Type":"NodeParagraph","Properties":{"id":"20240614115236-01wt0kb","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"《尔雅翼》引汜胜之云∶三月种粳稻，四月种秫稻。稻若诗书之文，自根据所用而解之。"}]},{"ID":"20240614115236-rn9rif4","Type":"NodeParagraph","Properties":{"id":"20240614115236-rn9rif4","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"如论语食夫稻。则稻是粳。《月令》∶秫稻必齐，则稻是糯。《周礼》∶牛宜 。则 是粳。诗∶丰年多黍多 ，为酒为醴，则 是糯。又稻人职掌，稼下地至泽草所生，则种之。芒种是明稻，有芒有不芒者，今之粳，则有芒，至糯则无，是得通称 稻之明验也。然《说文》所谓，沛国谓稻曰糯，至郭氏《解雅》∶ 稻乃云∶今沛国称 。不知《说文》亦岂谓此 讹为糯邪？将与郭自异义也。 按∶许慎东汉人，郭璞西晋人，许岂有将与郭自异义之理乎？"}]},{"ID":"20240614115236-bkr9dw5","Type":"NodeParagraph","Properties":{"id":"20240614115236-bkr9dw5","updated":"20240614115236"},"Children":[{"Type":"NodeText","Data":"盖许慎之说方言也，郭璞之说 ，亦稻之属也，近来古方家，或惑本草者流之说，而偏用今之糯米者非也。"}]},{"ID":"20240614115211-1ohixto","Type":"NodeThematicBreak","Properties":{"id":"20240614115211-1ohixto"}},{"ID":"20240614115226-y8n71um","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115226-y8n71um","updated":"20240614115230"},"Children":[{"Type":"NodeText","Data":"粳米《本草思辨录》"}]},{"ID":"20240614115226-q1h3qbb","Type":"NodeParagraph","Properties":{"id":"20240614115226-q1h3qbb","updated":"20240614115226"},"Children":[{"Type":"NodeText","Data":"稼穑作甘，为土之正味。不似他物之甘，独有所偏。粳米平调五脏，补益中气，有时委顿乏力，一饭之后，便舒适异常，真有人参不逮者，可以想其功能矣。"}]},{"ID":"20240614115226-5ajhm3m","Type":"NodeParagraph","Properties":{"id":"20240614115226-5ajhm3m","updated":"20240614115226"},"Children":[{"Type":"NodeText","Data":"粳米得金水之气多，于益气之中兼能养阴，故补剂寒剂，无不可赞助成功。"}]},{"ID":"20240614115226-cm4oml4","Type":"NodeParagraph","Properties":{"id":"20240614115226-cm4oml4","updated":"20240614115226"},"Children":[{"Type":"NodeText","Data":"谷为人生至宝，而霍乱痧胀，与夫欲吐不吐，欲泻不泻之证，周时内咽米饮一口，即不可救。盖暑湿秽恶之邪，充斥隧络，而米饮入胃输脾归肺，又适以恢张之，使无一隙之余，所以告危如是之速。"}]},{"ID":"20240614115211-s9qe45a","Type":"NodeThematicBreak","Properties":{"id":"20240614115211-s9qe45a"}},{"ID":"20240614115212-h683wyu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115212-h683wyu","updated":"20240614115216"},"Children":[{"Type":"NodeText","Data":"粳米《得配本草》"}]},{"ID":"20240614115212-9eylz1w","Type":"NodeParagraph","Properties":{"id":"20240614115212-9eylz1w","updated":"20240614115212"},"Children":[{"Type":"NodeText","Data":"甘，平。得天地中和之气，同造化生育之功。和五脏，通血脉，壮筋骨，长肌肉。晚收色白者，得金气多，性凉入肺，清热除烦，解渴、凉血、利便；早米粉，扑小儿初生无皮。粳米粉，扑自汗不止。频嚼白米，卧时涂小儿甜疮。"}]},{"ID":"20240614115212-rwqxsm3","Type":"NodeParagraph","Properties":{"id":"20240614115212-rwqxsm3","updated":"20240614115212"},"Children":[{"Type":"NodeText","Data":"粳有早、中、晚三收。北粳凉，南粳温。赤粳热，白粳凉。新粳热，陈粳凉。凡人嗜生米，久成米瘕，治之以鸡屎白。不可和苍耳食，令人卒心痛，急烧仓米灰和蜜浆服之，不尔即死。"}]},{"ID":"20240614114729-txn7w0w","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-txn7w0w"}},{"ID":"20240614115202-oqvwhlj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115202-oqvwhlj","updated":"20240614115205"},"Children":[{"Type":"NodeText","Data":"粳米《长沙药解》"}]},{"ID":"20240614115202-59kqdat","Type":"NodeParagraph","Properties":{"id":"20240614115202-59kqdat","updated":"20240614115202"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614115202-5fl3640","Type":"NodeParagraph","Properties":{"id":"20240614115202-5fl3640","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"味甘，入足太阴脾、足阳明胃、手太阴肺经。入太阴而补脾精，走阳明而化胃气，培土和中，分清泌浊，生津而止燥渴，利水而通热涩。"}]},{"ID":"20240614115202-a2b7hba","Type":"NodeParagraph","Properties":{"id":"20240614115202-a2b7hba","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"附子粳米汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"附子一枚，粳米半升，半夏半升，甘草一两，大枣十枚。"},{"Type":"NodeText","Data":"治腹中寒气，雷鸣切痛，胸胁逆满，呕吐。以火虚土败，水寒木郁，肝木克脾，故腹中雷鸣而为切痛，胆木克胃，故胸胁逆满而作呕吐。粳米、甘、枣，补土和中，附子驱下焦之湿寒，半夏降上脘之冲逆也。"}]},{"ID":"20240614115202-933awzb","Type":"NodeParagraph","Properties":{"id":"20240614115202-933awzb","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃花汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在赤石脂"},{"Type":"NodeText","Data":"。用之治少阴病，腹痛下利，小便不利，便脓血者。以土湿水寒，木郁血陷，粳米补土而和中，利水而泻湿也。"}]},{"ID":"20240614115202-x4t9dxy","Type":"NodeParagraph","Properties":{"id":"20240614115202-x4t9dxy","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"人之中气冲和，升降不反，则清阳弗陷而浊阴弗逆。中气亏损，升降倒行，清气下陷，痛坠而泄利，浊气上逆，痛满而呕吐，则冲和之地，变而为急迫之场矣。物之冲和，莫如谷气，粳米得谷气之完，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"《素问》：稻米者完。"},{"Type":"NodeText","Data":"最补中焦，而理清浊。附子粳米汤以此和平厚重之气助其中宫，桃花汤以此和煦发达之气益其中脘，中旺则癸水将退，而后干姜奏其回阳之效，己土将复，而后石脂成其固脱之功，阴邪欲遁，而后附子展其破寒之能，胃气欲平，而后半夏施其降逆之力。若非粳米握其中权，虽以半夏、附子之长于降浊，何足恃其前茅，干姜、石脂之善于升清，安得逞其后劲。常山率然，但有首尾，未能如此呼应之灵也。"}]},{"ID":"20240614115202-hc6usy8","Type":"NodeParagraph","Properties":{"id":"20240614115202-hc6usy8","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"饮食入腹，是变精气，谷气化精，归于肝脾，谷精化气，归于肺胃。物之润泽，莫过于气，气清而化津水，津旺则金润，水利则土燥。水愈利则土愈燥而气愈清，气愈清则津愈旺而水愈利。故止渴之法，机在益气而清金，清金之法，机在利水而燥土。以土燥则清气飘洒，津液流布，脏腑被泽，是以不渴，土湿则浊气湮郁，痰涎凝结，脏腑失滋，是以渴也。粳米清液淳浓，最能化气生津，清金止渴，长于利水而燥土。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白虎汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在石膏"},{"Type":"NodeText","Data":"。用之治伤寒表解之热渴，石膏、知母，清金而化水，粳米益气而生津也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"人参白虎汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在人参"},{"Type":"NodeText","Data":"。用之治伤寒汗后之燥渴，石膏、知母，清金而化水，粳米、人参，益气而生津也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"竹叶石膏汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在竹叶"},{"Type":"NodeText","Data":"。用之治大病差后，虚羸少气，气逆欲吐，麦冬、石膏，清金而化水，粳米、人参，益气而生津也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麦门冬汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在麦冬"},{"Type":"NodeText","Data":"。用之治咳嗽，火逆上气，咽喉不利，麦冬清金而化水，粳米、人参，益气而生津也。"}]},{"ID":"20240614115202-o6xon03","Type":"NodeParagraph","Properties":{"id":"20240614115202-o6xon03","updated":"20240614115202"},"Children":[{"Type":"NodeText","Data":"盖非气则津不化，非津则水不生，譬之水沸而气腾焉。气上之熏泽而滋润者，津也，气下之泛洒而滴沥者，水也，使无粳米、人参益气生津之药，徒以知、膏、麦冬清金化水之品，求其止渴，断乎不能！人之夏热饮水，肠鸣腹胀而燥渴不止者，水不化气故也。"}]},{"ID":"20240614115128-os1jo0p","Type":"NodeThematicBreak","Properties":{"id":"20240614115128-os1jo0p"}},{"ID":"20240614115150-x1lt6sp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115150-x1lt6sp","updated":"20240614115155"},"Children":[{"Type":"NodeText","Data":"粳米《本草蒙筌》"}]},{"ID":"20240614115150-2oymc07","Type":"NodeParagraph","Properties":{"id":"20240614115150-2oymc07","updated":"20240614115150"},"Children":[{"Type":"NodeText","Data":"（即晚大米） 味甘、苦，气平、微寒。无毒。水田堪莳，霜降才收。谷大多芒，米粘曰粳。有赤白两种（赤者江右多莳）。入心肺二经。拯病煎汤，惟白最胜。充飧为饭，过熟则佳。益气填补中焦，止泄平和五脏。合熟鸡头（芡实熟者）"}]},{"ID":"20240614115150-luhmp56","Type":"NodeParagraph","Properties":{"id":"20240614115150-luhmp56","updated":"20240614115150"},"Children":[{"Type":"NodeText","Data":"煮粥，明目强志益精。伤寒方中，亦多加入。各有取义，未尝一拘。少阴证，桃花汤每加，取甘以补正气也。竹叶石膏汤频用，取甘以益不足焉。白虎汤入手太阴，亦同甘草用者，取甘以缓之，使不速于下尔。"}]},{"ID":"20240614115150-ig0yuag","Type":"NodeParagraph","Properties":{"id":"20240614115150-ig0yuag","updated":"20240614115150"},"Children":[{"Type":"NodeText","Data":"又"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"陈廪米"},{"Type":"NodeText","Data":"味兼咸、酸。即粳米贮仓廪年深，致性缓调脾胃效捷。易消化频止泄痢，多滋润意解渴烦胃进食。若蒸作饭和醋，能封肿毒立差。研汁下咽，去卒心痛。惟忌马肉同食，恐发痼疾难瘳。炊"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"寒食饭"},{"Type":"NodeText","Data":"敷，灭瘢痕，捣泥烂才妙；煮"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒米汤"},{"Type":"NodeText","Data":"饮，润喉燥，去火毒良方火毒去尽才煮，不尔则反助燥渴。）"}]},{"ID":"20240614115150-mzypd44","Type":"NodeParagraph","Properties":{"id":"20240614115150-mzypd44","updated":"20240614115150"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"米"},{"Type":"NodeText","Data":"秧莳高田，早秋便可收割。谷长无刺，米小不粘。色赤白亦有两般，凭炊煮任充正用。温中健脉，益卫养荣。仍长肌肤，尤调脏腑。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稻米"},{"Type":"NodeText","Data":"亦小，味甘气温。收近重阳，舂甚洁白。若粘滞者曰糯，不沾滞者曰杭。商贾贸钱，竟谓粘米。煮饴诚妙，酿酒弥佳。充不宜，恋膈难化。昏五脏令人贪睡，动正气致人发风。"}]},{"ID":"20240614115150-w9sjbba","Type":"NodeParagraph","Properties":{"id":"20240614115150-w9sjbba","updated":"20240614115150"},"Children":[{"Type":"NodeText","Data":"但霍乱吐逆不休，用清水研服即止。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稻稳"},{"Type":"NodeText","Data":"（即秕芒也）治蛊毒作胀，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稻秆"},{"Type":"NodeText","Data":"疗黄胆如金。并用煎脓，莫惜时啜。"}]},{"ID":"20240614115150-cnggsuh","Type":"NodeParagraph","Properties":{"id":"20240614115150-cnggsuh","updated":"20240614115150"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稻秆灰"},{"Type":"NodeText","Data":"治跌损，淋汁沃痛渐苏。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杵头细糠"},{"Type":"NodeText","Data":"，堪治能送食饮过喉，斯亦舂捣义尔。"}]},{"ID":"20240614115150-eqyazwt","Type":"NodeParagraph","Properties":{"id":"20240614115150-eqyazwt","updated":"20240614115150"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"糠秕"},{"Type":"NodeText","Data":"勿用筑枕，枕则令人损明（谟）按∶东坡云∶稻者， 谷通名。罗氏亦曰∶在谷通谓之稻。故今人号 为早稻，号粳为晚稻。《论语》曰∶食夫稻，是亦指粳而谓。何独《本经》款中直指稻为糯米，与前诸说大相戾焉？"}]},{"ID":"20240614115150-kai0ly8","Type":"NodeParagraph","Properties":{"id":"20240614115150-kai0ly8","updated":"20240614115150"},"Children":[{"Type":"NodeText","Data":"或者云∶糯与粳有粘不粘之异，故书通名以标之，未必得其意也。"}]},{"ID":"20240614115128-jpxx8a1","Type":"NodeThematicBreak","Properties":{"id":"20240614115128-jpxx8a1"}},{"ID":"20240614115137-40w8y84","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115137-40w8y84","updated":"20240614115143"},"Children":[{"Type":"NodeText","Data":"粳米《本草求真》"}]},{"ID":"20240614115137-fz376l8","Type":"NodeParagraph","Properties":{"id":"20240614115137-fz376l8","updated":"20240614115137"},"Children":[{"Type":"NodeText","Data":"（麻麦稻）固中清热除烦"}]},{"ID":"20240614115137-ww19obm","Type":"NodeParagraph","Properties":{"id":"20240614115137-ww19obm","updated":"20240614115137"},"Children":[{"Type":"NodeText","Data":"粳米（专入脾胃。兼入心脾）。即人常食之米也。禀天地中和之气。味甘性平。（时珍曰。北粳凉。南粳温。赤粳热。白粳凉。晚白粳寒。新粳热。陈粳凉。凡人嗜生米。久成米瘕。治之以鸡屎白焉。）人非此物不能养生。故性专主脾胃。而兼及他脏。凡五脏血脉。靡不因此而灌溉。五脏积液。靡不因此而充溢。他如周身筋骨肌肉皮肤。靡不因此而强健。故凡白虎桃花竹叶石膏等汤。靡不用此以为固中清热。然米既有早晚之不同。复有地土出处之各异。（颖曰。新米乍食动风。陈者。病患尤宜。）早米受气既早。性虽温而质多粘。食之反能恋膈。（脾有湿滞者最忌。）晚米受气既迟。其性稍凉。服之不无稍清。而白晚性滞。尤觉滋害。出于高地。则米硬而质洁。出于洼处。则米润而性阴。然总于中是固。诸方用此佐助。盖恐药性苦寒。得此甘缓同入。俾胃气不致顿损。而热与烦亦得与之俱安矣。此虽常食之物。服之不甚有益。而一参以药投。则其力甚巨。未可等为泛常而忽视也。"}]},{"ID":"20240614115128-uvzr3ds","Type":"NodeThematicBreak","Properties":{"id":"20240614115128-uvzr3ds"}},{"ID":"20240614115130-whniqf8","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240614115130-whniqf8","updated":"20240614115130"},"Children":[{"Type":"NodeText","Data":"粳米"}]},{"ID":"20240614115130-r32arox","Type":"NodeParagraph","Properties":{"id":"20240614115130-r32arox","updated":"20240614115130"},"Children":[{"Type":"NodeText","Data":"（麻麦稻）固中清热除烦"}]},{"ID":"20240614115130-sd264da","Type":"NodeParagraph","Properties":{"id":"20240614115130-sd264da","updated":"20240614115130"},"Children":[{"Type":"NodeText","Data":"粳米（专入脾胃。兼入心脾）。即人常食之米也。禀天地中和之气。味甘性平。（时珍曰。北粳凉。南粳温。赤粳热。白粳凉。晚白粳寒。新粳热。陈粳凉。凡人嗜生米。久成米瘕。治之以鸡屎白焉。）人非此物不能养生。故性专主脾胃。而兼及他脏。凡五脏血脉。靡不因此而灌溉。五脏积液。靡不因此而充溢。他如周身筋骨肌肉皮肤。靡不因此而强健。故凡白虎桃花竹叶石膏等汤。靡不用此以为固中清热。然米既有早晚之不同。复有地土出处之各异。（颖曰。新米乍食动风。陈者。病患尤宜。）早米受气既早。性虽温而质多粘。食之反能恋膈。（脾有湿滞者最忌。）晚米受气既迟。其性稍凉。服之不无稍清。而白晚性滞。尤觉滋害。出于高地。则米硬而质洁。出于洼处。则米润而性阴。然总于中是固。诸方用此佐助。盖恐药性苦寒。得此甘缓同入。俾胃气不致顿损。而热与烦亦得与之俱安矣。此虽常食之物。服之不甚有益。而一参以药投。则其力甚巨。未可等为泛常而忽视也。"}]},{"ID":"20240614114729-ncovlql","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-ncovlql"}},{"ID":"20240614115119-4cm09w8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115119-4cm09w8","updated":"20240614115122"},"Children":[{"Type":"NodeText","Data":"粳米《本草经解》"}]},{"ID":"20240614115119-x22r8hk","Type":"NodeParagraph","Properties":{"id":"20240614115119-x22r8hk","updated":"20240614115119"},"Children":[{"Type":"NodeText","Data":"气平．味甘苦．无毒．主益气．止烦止泄．粳米气平．禀天秋成之金气．入手太阴肺经．味甘苦无毒．得地中南火土之味．入足太阴脾经、手少阴心经．气味降多于升．阴也．肺主气．气平益肺．所以益气．脾为阴气之原．脾阴充足．则五脏血脉精髓．周身皮肉筋骨．皆因之强健．自无心烦下泄之事矣．所以止烦止泄也．"}]},{"ID":"20240614115119-5qrglmi","Type":"NodeParagraph","Properties":{"id":"20240614115119-5qrglmi","updated":"20240614115119"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614115119-kocjpa9","Type":"NodeParagraph","Properties":{"id":"20240614115119-kocjpa9","updated":"20240614115119"},"Children":[{"Type":"NodeText","Data":"白米五合．鸡屎一升．同炒焦为末．水一升顿服．治食生米成瘕．炒焦入药．开胃下气．"}]},{"ID":"20240614114729-zxqzfgd","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-zxqzfgd"}},{"ID":"20240614115053-b7c65ry","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115053-b7c65ry","updated":"20240614115057"},"Children":[{"Type":"NodeText","Data":"粳《本草纲目》"}]},{"ID":"20240614115053-1n6b0z7","Type":"NodeParagraph","Properties":{"id":"20240614115053-1n6b0z7","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"「气味」粳米：甘、苦、平、无毒。淅二泔：甘、寒、无毒。"}]},{"ID":"20240614115053-52i2wh2","Type":"NodeParagraph","Properties":{"id":"20240614115053-52i2wh2","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614115053-86mnwly","Type":"NodeParagraph","Properties":{"id":"20240614115053-86mnwly","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"粳米："}]},{"ID":"20240614115053-68wj24r","Type":"NodeParagraph","Properties":{"id":"20240614115053-68wj24r","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"1、霍乱吐泻，烦渴欲绝。用粳米二合，研成粉，加水二碗，再研成汁，和淡竹沥一合，一次服下。"}]},{"ID":"20240614115053-pj2xrd9","Type":"NodeParagraph","Properties":{"id":"20240614115053-pj2xrd9","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"2、自汗不止。有粳米粉代扑粉，经常扑身上，有效。"}]},{"ID":"20240614115053-9l4tpec","Type":"NodeParagraph","Properties":{"id":"20240614115053-9l4tpec","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"3、心气痛。用粳米一升加水六升煮开六、七次服下。"}]},{"ID":"20240614115053-03wairv","Type":"NodeParagraph","Properties":{"id":"20240614115053-03wairv","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"4、胎动腹痛。用粳米五升、黄芪六两，加水七升煎成二升，分四次服下。"}]},{"ID":"20240614115053-p09150y","Type":"NodeParagraph","Properties":{"id":"20240614115053-p09150y","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"5、疔肿。用粳米粉熬黑，调蜜敷涂。"}]},{"ID":"20240614115053-ui022cw","Type":"NodeParagraph","Properties":{"id":"20240614115053-ui022cw","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"淅二泔：清热，止烦渴，利小便，凉血。"}]},{"ID":"20240614115053-fcsi2u2","Type":"NodeParagraph","Properties":{"id":"20240614115053-fcsi2u2","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"炒米汤：益胃，除湿。"}]},{"ID":"20240614115053-cmjzgo9","Type":"NodeParagraph","Properties":{"id":"20240614115053-cmjzgo9","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"粳谷奴：走马喉痹。取粳谷取烧、研，以酒冲服一匙，立效。"}]},{"ID":"20240614115053-61m9jlt","Type":"NodeParagraph","Properties":{"id":"20240614115053-61m9jlt","updated":"20240614115053"},"Children":[{"Type":"NodeText","Data":"禾秆：解砒毒。用禾秆烧灰，淋汁滤清，冷服一碗，能将毒排出。"}]},{"ID":"20240614114729-j9yuwrm","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-j9yuwrm"}},{"ID":"20240614115033-chklw40","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614115033-chklw40","updated":"20240614115038"},"Children":[{"Type":"NodeText","Data":"粳米《本草分经》"}]},{"ID":"20240614115033-q79cikz","Type":"NodeParagraph","Properties":{"id":"20240614115033-q79cikz","updated":"20240614115033"},"Children":[{"Type":"NodeText","Data":"甘平，得天地中和之气，平和五脏，补益气血，入肺清热利便，晚收者性凉，尤能清热。北粳凉，南粳温，新粳热，陈粳凉，赤粳热，白粳凉，新米动气。米泔清热凉血利小便，用第二次者。"}]},{"ID":"20240614114729-8qxiuv0","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-8qxiuv0"}},{"ID":"20240614114952-knumuwm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114952-knumuwm","updated":"20240614114956"},"Children":[{"Type":"NodeText","Data":"粳米《本草分经》"}]},{"ID":"20240614114952-05pmssk","Type":"NodeParagraph","Properties":{"id":"20240614114952-05pmssk","updated":"20240614114952"},"Children":[{"Type":"NodeText","Data":"甘平，得天地中和之气，平和五脏，补益气血，入肺清热利便，晚收者性凉，尤能清热。北粳凉，南粳温，新粳热，陈粳凉，赤粳热，白粳凉，新米动气。米泔清热凉血利小便，用第二次者。"}]},{"ID":"20240614114729-mcr5aii","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-mcr5aii"}},{"ID":"20240614114843-bf7pcyj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114843-bf7pcyj","updated":"20240614114850"},"Children":[{"Type":"NodeText","Data":"粳米《医学入门》"}]},{"ID":"20240614114843-5khmp6i","Type":"NodeParagraph","Properties":{"id":"20240614114843-5khmp6i","updated":"20240614114843"},"Children":[{"Type":"NodeText","Data":"粳米无毒甘平味，能和五脏补脾胃，长肌坚骨止泄烦，强志益精又益气，孽米温中宿食消，杵糠下噎取其义。"}]},{"ID":"20240614114843-bgpq81u","Type":"NodeParagraph","Properties":{"id":"20240614114843-bgpq81u","updated":"20240614114843"},"Children":[{"Type":"NodeText","Data":"粳，硬也，坚硬于糯米也。即今白晚米与早米。赤白大小异族，惟白晚米为最。入手太阴、少阴经。平和五脏，补益胃气，长肌肉，壮筋骨，止烦渴泄痢，强心志，益肾精，益肺气。养生书云∶气精皆从米变化而生，故字皆从米。有病者，煮粥食之，不杂一物，其病自愈。造饭过熟则佳。食干饭止泻，若常食干饭，令人热中，唇口干。和苍耳食，令卒心痛，烧陈仓米和蜜浆解之。和马肉同食，发痼疾。新熟者动气，经再年者发病。《液》云，白虎汤用之入肺，以阳明为胃之经，色为西方之白也；少阴症桃花汤用此，甘以补正气；竹叶汤用此，甘以益不足。孽米，即谷芽也。去壳，止取孽中之米，故曰孽米。味苦，温，无毒。主寒中下气。"}]},{"ID":"20240614114843-6bojabc","Type":"NodeParagraph","Properties":{"id":"20240614114843-6bojabc","updated":"20240614114843"},"Children":[{"Type":"NodeText","Data":"开胃消食，除烦热。性温于麦芽。杵糠，即舂杵头细糠也。性平。主卒噎不下及反胃不止，刮取含之即去。亦取其舂捣之义耳。又烧末服之令易产。以糠作枕，损人眼目。"}]},{"ID":"20240614114729-escfinw","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-escfinw"}},{"ID":"20240614114823-mkaqz5o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114823-mkaqz5o","updated":"20240614114831"},"Children":[{"Type":"NodeText","Data":"粳米《本草从新》"}]},{"ID":"20240614114823-wtialy3","Type":"NodeParagraph","Properties":{"id":"20240614114823-wtialy3","updated":"20240614114823"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和胃补中、清肺．"}]},{"ID":"20240614114823-4n7zu9b","Type":"NodeParagraph","Properties":{"id":"20240614114823-4n7zu9b","updated":"20240614114823"},"Children":[{"Type":"NodeText","Data":"甘平．（北粳凉、南粳温、赤粳热、白粳凉、新粳热、陈粳凉．）得天地中和之气．平和五脏．补益气血．色白入肺．除烦清热．利便止渴．有早中晚三收．晚者得金气多．性凉．尤能清热．新米乍食动气．（凡人嗜生米、久成米瘕、治以鸡屎白．）泔、（古名米沈、第二次者、清而可用．）清热止烦渴．利小便凉血．"}]},{"ID":"20240614114729-t1blg92","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-t1blg92"}},{"ID":"20240614114812-mmhkfz7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114812-mmhkfz7","updated":"20240614114817"},"Children":[{"Type":"NodeText","Data":"粳米《名医别录》"}]},{"ID":"20240614114812-4g6nfeh","Type":"NodeParagraph","Properties":{"id":"20240614114812-4g6nfeh","updated":"20240614114812"},"Children":[{"Type":"NodeText","Data":"味甘、苦，平，无毒．主益气，止烦，止泄．"}]},{"ID":"20240614114729-p76ee2l","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-p76ee2l"}},{"ID":"20240614114805-n5fz6n3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114805-n5fz6n3","updated":"20240614114808"},"Children":[{"Type":"NodeText","Data":"粳米《本草备要》"}]},{"ID":"20240614114805-okchvuc","Type":"NodeParagraph","Properties":{"id":"20240614114805-okchvuc","updated":"20240614114805"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"粳，硬也"}]},{"ID":"20240614114805-4vgfk77","Type":"NodeParagraph","Properties":{"id":"20240614114805-4vgfk77","updated":"20240614114805"},"Children":[{"Type":"NodeText","Data":"补脾清肺"}]},{"ID":"20240614114805-gqcquxf","Type":"NodeParagraph","Properties":{"id":"20240614114805-gqcquxf","updated":"20240614114805"},"Children":[{"Type":"NodeText","Data":"甘凉。得天地中和之气，和胃补中，色白入肺。除烦清热，煮汁止渴（仲景白虎汤、桃花汤、竹叶石膏汤，并用之以清热、补不足。张文潜《粥记》∶粥能畅胃气，生津液，每晨空腹食之，所补不细。昂按∶今人终日食粥，不知其妙。迨病中食之，觉与脏腑相宜，迥非他物之所能及也）。粳，乃稻之总名，有早、中、晚三收。晚者得金气多，性凉，尤能清热（北粳凉，南粳温，白粳凉，红粳温，新米食之动气）。"}]},{"ID":"20240614114805-e61bmnz","Type":"NodeParagraph","Properties":{"id":"20240614114805-e61bmnz","updated":"20240614114805"},"Children":[{"Type":"NodeText","Data":"陈廪米冲淡可以养胃，煮汁煎药，亦取其调肠胃、利小便、去湿热，除烦渴之功（《集成》云∶陈米饭扎作团，火 存性，麻油，腻粉调，敷一切恶疮、百药不效者）。"}]},{"ID":"20240614114729-hhtqby8","Type":"NodeThematicBreak","Properties":{"id":"20240614114729-hhtqby8"}},{"ID":"20240614114730-xco674n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114730-xco674n","updated":"20240614114758"},"Children":[{"Type":"NodeText","Data":"粳米《本草择要纲目》"}]},{"ID":"20240614114730-7kwaln2","Type":"NodeParagraph","Properties":{"id":"20240614114730-7kwaln2","updated":"20240614114730"},"Children":[{"Type":"NodeText","Data":"（粳音庚．粳乃谷稻之总名也．有早中晚三收．诸本草独以晚稻为粳者非矣．）"}]},{"ID":"20240614114730-qppftgm","Type":"NodeParagraph","Properties":{"id":"20240614114730-qppftgm","updated":"20240614114730"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614114730-5x8fujm","Type":"NodeParagraph","Properties":{"id":"20240614114730-5x8fujm","updated":"20240614114730"},"Children":[{"Type":"NodeText","Data":"甘苦平无毒．（生者寒．燔者热．北粳凉．南粳温．赤粳热．白粳凉．晚白粳寒．新粳热．陈粳凉．新米乍食动风气．陈者下气．病患尤宜．常食干粳饭．令人热中唇口干．不可同马肉食发痼疾．不可和苍耳食．令人卒心痛．急烧仓米灰和蜜浆服之．不尔即死．）"}]},{"ID":"20240614114730-pr1hq2t","Type":"NodeParagraph","Properties":{"id":"20240614114730-pr1hq2t","updated":"20240614114730"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240614114730-o33kyti","Type":"NodeParagraph","Properties":{"id":"20240614114730-o33kyti","updated":"20240614114730"},"Children":[{"Type":"NodeText","Data":"益气止烦．止渴止泄．温中和胃气．长肌肉．补中壮筋骨益肠胃．煮汁主心痛．止渴．断热毒下痢．合芡实作粥食．益精强志．聪耳明目．通五脏．好颜色．常食干粳饭．令人不噎．粳有早中晚三收．以晚白米为第一．得天地中和之气．同造化生育之功．非他物可比．本草言粳米益脾胃．而张仲景白虎汤用之入肺．以味甘为阳明之经．色白为西方之象．而气寒入手太阴也．桃花汤用之以补少阴之正气．竹叶石膏汤用之以益不足．"}]},{"ID":"20240614114731-uqicpe6","Type":"NodeThematicBreak","Properties":{"id":"20240614114731-uqicpe6"}},{"ID":"20240614114929-e2n74ge","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114929-e2n74ge","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：粳米"}]},{"ID":"20240614114929-qm0gcsb","Type":"NodeParagraph","Properties":{"id":"20240614114929-qm0gcsb","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614114929-la933d5","Type":"NodeParagraph","Properties":{"id":"20240614114929-la933d5","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" Jīnɡ Mǐ"}]},{"ID":"20240614114929-bv9t1sm","Type":"NodeParagraph","Properties":{"id":"20240614114929-bv9t1sm","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614114929-b65bd23","Type":"NodeParagraph","Properties":{"id":"20240614114929-b65bd23","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 白米"}]},{"ID":"20240614114929-6qqtmmz","Type":"NodeParagraph","Properties":{"id":"20240614114929-6qqtmmz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614114929-15fqwg7","Type":"NodeParagraph","Properties":{"id":"20240614114929-15fqwg7","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 禾本科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粳米"},{"Type":"NodeText","Data":"Oryza sativa L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240614114929-e1ct4nu","Type":"NodeParagraph","Properties":{"id":"20240614114929-e1ct4nu","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614114929-rcy5oll","Type":"NodeParagraph","Properties":{"id":"20240614114929-rcy5oll","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 全国各地。"}]},{"ID":"20240614114929-0e9whit","Type":"NodeParagraph","Properties":{"id":"20240614114929-0e9whit","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614114929-oj3mbxb","Type":"NodeParagraph","Properties":{"id":"20240614114929-oj3mbxb","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 温中和胃，益气止泄。主治烦躁口渴，赤痢热躁，伤暑发热。"}]},{"ID":"20240614114929-odlkbkz","Type":"NodeParagraph","Properties":{"id":"20240614114929-odlkbkz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614114929-43lixt7","Type":"NodeParagraph","Properties":{"id":"20240614114929-43lixt7","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 0.3～1两。"}]},{"ID":"20240614114929-42mklqj","Type":"NodeParagraph","Properties":{"id":"20240614114929-42mklqj","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614114929-d0znj9x","Type":"NodeParagraph","Properties":{"id":"20240614114929-d0znj9x","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614114929-j865dv3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114929-j865dv3","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：粳米"}]},{"ID":"20240614114929-x5swz47","Type":"NodeParagraph","Properties":{"id":"20240614114929-x5swz47","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614114929-5s0xu6c","Type":"NodeParagraph","Properties":{"id":"20240614114929-5s0xu6c","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" Jīnɡ Mǐ"}]},{"ID":"20240614114929-ncoit34","Type":"NodeParagraph","Properties":{"id":"20240614114929-ncoit34","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614114929-1nvt9pr","Type":"NodeParagraph","Properties":{"id":"20240614114929-1nvt9pr","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 大米（《滇南本草》），硬米（《本草求原》）。"}]},{"ID":"20240614114929-bb4lr3n","Type":"NodeParagraph","Properties":{"id":"20240614114929-bb4lr3n","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614114929-hbo06nw","Type":"NodeParagraph","Properties":{"id":"20240614114929-hbo06nw","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240614114929-n7tjhcg","Type":"NodeParagraph","Properties":{"id":"20240614114929-n7tjhcg","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614114929-8ec6cgz","Type":"NodeParagraph","Properties":{"id":"20240614114929-8ec6cgz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 为禾本科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稻"},{"Type":"NodeText","Data":"（粳稻）的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种仁"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240614114929-wvmjxxl","Type":"NodeParagraph","Properties":{"id":"20240614114929-wvmjxxl","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614114929-psj71wn","Type":"NodeParagraph","Properties":{"id":"20240614114929-psj71wn","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 水生或陆生。全国各地均有栽培。"}]},{"ID":"20240614114929-hzahsj7","Type":"NodeParagraph","Properties":{"id":"20240614114929-hzahsj7","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614114929-221hsxo","Type":"NodeParagraph","Properties":{"id":"20240614114929-221hsxo","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 稻（《诗经》），又名：稌（《诗经》），嘉蔬（《礼记》），水稻。"}]},{"ID":"20240614114929-goqrwux","Type":"NodeParagraph","Properties":{"id":"20240614114929-goqrwux","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"一年生草本。秆直立，丛生，高约1米左右；中空，有节，有分蘖。叶具叶鞘，叶鞘无毛，与节间等长或下部者较长；叶舌膜质而较硬，披针形，基部两侧下延与叶鞘边缘相结合，长8～25毫米，幼时具明显的叶耳；叶片线形，扁平，长30～60厘米，宽6～15毫米；粗糙，叶脉明显。圆锥花序疏松，成熟时向下弯垂，分枝具角棱，常粗糙；小穗长圆形，长6～8毫米；每小穗仅具1花，不育花外稃锥刺状，无毛；可育花外稃硬纸质，具5脉，遍被细毛或稀无毛，无芒或有芒；内稃3脉，亦被细毛；鳞被2枚，卵圆形，长约1毫米；雄蕊6，花药长约2毫米，花丝细弱；子房长圆形，光滑，花柱2枚，柱头羽毛状，有时有第三枝退化的花柱。颖果矩圆形，平滑，淡黄色、白色。种子具明显的线状种脐。花期7～8月。果期8～9月。"}]},{"ID":"20240614114929-bv8o3yw","Type":"NodeParagraph","Properties":{"id":"20240614114929-bv8o3yw","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614114929-g9hmhd0","Type":"NodeParagraph","Properties":{"id":"20240614114929-g9hmhd0","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 约含75％以上的淀粉，8％左右的蛋白质，0.5～1％的脂肪。尚含有少量B族维生素；维生素的含量因稻子的种类和种植地点而异。脂肪部分含有酯型胆甾醇和自由胆甾醇，菜油甾醇，豆甾醇，谷甾醇，甘油一、二、三酯，磷酯，廿四酰基鞘氨醇葡萄糖，自由脂肪酸。尚含有乙酸、延胡索酸、琥珀酸、甘醇酸、柠檬酸和苹果酸等多种有机酸，葡萄糖、果糖、麦芽糖等单糖。"}]},{"ID":"20240614114929-kzvggcw","Type":"NodeParagraph","Properties":{"id":"20240614114929-kzvggcw","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614114929-daqe805","Type":"NodeParagraph","Properties":{"id":"20240614114929-daqe805","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 抗肿瘤作用。应用自然长菌风化陈年（3年以上）的糯木粽子，剔去其发黑者，80℃焙干，磨粉，做成水混悬液、水提取液及乙醇提取液。给小鼠接种腹水型肝癌后，每天灌服水混悬液或皮下注射水或乙醇提取液，连续10天，对于腹水型肝癌小鼠的腹水生成均有一定的抑制作用，其抑制率分别为77.6％、56.4％和52.1％。在腹水涂片上看到用药组的癌细胞退变现象都较对照组为着，肉眼观察，对照组腹腔内肿瘤生长较给药组广泛，粘连情况也较严重。但接种癌细胞后11天，对照组与用药组动物死亡情况并无明显差异。"}]},{"ID":"20240614114929-gue7vur","Type":"NodeParagraph","Properties":{"id":"20240614114929-gue7vur","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614114929-ayl6scu","Type":"NodeParagraph","Properties":{"id":"20240614114929-ayl6scu","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《本草求真》：\"入脾、胃经。\""}]},{"ID":"20240614114929-gfsqod5","Type":"NodeParagraph","Properties":{"id":"20240614114929-gfsqod5","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614114929-b6zx3qj","Type":"NodeParagraph","Properties":{"id":"20240614114929-b6zx3qj","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240614114929-tpvsb1r","Type":"NodeParagraph","Properties":{"id":"20240614114929-tpvsb1r","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味苦，平，无毒，\""}]},{"ID":"20240614114929-z60lch9","Type":"NodeParagraph","Properties":{"id":"20240614114929-z60lch9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"味辛苦，平，无毒。生者冷，燔者热。\""}]},{"ID":"20240614114929-uq162ka","Type":"NodeParagraph","Properties":{"id":"20240614114929-uq162ka","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"③《七卷食经》：\"味甘，微寒。\""}]},{"ID":"20240614114929-1i0lgwz","Type":"NodeParagraph","Properties":{"id":"20240614114929-1i0lgwz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"北粳：凉，南粳：温，赤粳：热，白粳：凉，晚白粳：寒，新粳：热，陈粳：凉。\""}]},{"ID":"20240614114929-17c3map","Type":"NodeParagraph","Properties":{"id":"20240614114929-17c3map","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614114929-8l2w9x9","Type":"NodeParagraph","Properties":{"id":"20240614114929-8l2w9x9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"炒米汤不去火毒，令人作渴。\""}]},{"ID":"20240614114929-1xh9x0g","Type":"NodeParagraph","Properties":{"id":"20240614114929-1xh9x0g","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614114929-jt97vz1","Type":"NodeParagraph","Properties":{"id":"20240614114929-jt97vz1","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 补中益气，健脾和胃，除烦渴，止泻痢。"}]},{"ID":"20240614114929-2wfit89","Type":"NodeParagraph","Properties":{"id":"20240614114929-2wfit89","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主益气，止烦，止泄。\""}]},{"ID":"20240614114929-h8kjtsl","Type":"NodeParagraph","Properties":{"id":"20240614114929-h8kjtsl","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"平胃气，长肌肉。\""}]},{"ID":"20240614114929-rdiirmd","Type":"NodeParagraph","Properties":{"id":"20240614114929-rdiirmd","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"③孟诜：\"温中，益气，补下元。\""}]},{"ID":"20240614114929-jbu2kqu","Type":"NodeParagraph","Properties":{"id":"20240614114929-jbu2kqu","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"壮筋骨，补肠胃。\""}]},{"ID":"20240614114929-0zbtmpn","Type":"NodeParagraph","Properties":{"id":"20240614114929-0zbtmpn","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"治诸虚百损，强阴壮骨，生津，明目，长智。\""}]},{"ID":"20240614114929-t1iky97","Type":"NodeParagraph","Properties":{"id":"20240614114929-t1iky97","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"粳米粥：利小便，止烦渴，养肠胃。\"\"炒米汤：益胃除湿。\""}]},{"ID":"20240614114929-vsjqp98","Type":"NodeParagraph","Properties":{"id":"20240614114929-vsjqp98","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614114929-5su4km9","Type":"NodeParagraph","Properties":{"id":"20240614114929-5su4km9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤。"}]},{"ID":"20240614114929-qd5zf5g","Type":"NodeParagraph","Properties":{"id":"20240614114929-qd5zf5g","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614114929-0mq7h1i","Type":"NodeParagraph","Properties":{"id":"20240614114929-0mq7h1i","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" ①治霍乱狂闷，烦渴，吐泻无度，气欲绝者：淡竹沥一合，粳米一合（炒，以水二盏同研，去滓取汁）。上二味，和匀顿服之。（《圣济总录》竹沥饮）"}]},{"ID":"20240614114929-yd2vgse","Type":"NodeParagraph","Properties":{"id":"20240614114929-yd2vgse","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"②治赤痢热躁：粳米半升。水研取汁，入油瓷瓶中，蜡纸封口，沉井底一夜，平旦服之。（《普济方》）"}]},{"ID":"20240614114929-tgcwime","Type":"NodeParagraph","Properties":{"id":"20240614114929-tgcwime","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"③治受胎未足，初生无皮，色赤，但有红筋：早白米粉扑之。（《圣济总录》）"}]},{"ID":"20240614114929-xdbv4gd","Type":"NodeParagraph","Properties":{"id":"20240614114929-xdbv4gd","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614114929-35epvdr","Type":"NodeParagraph","Properties":{"id":"20240614114929-35epvdr","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" ①宁原《食鉴本草》：\"粳米，即今之白晚米，惟味香甘，与早熟米及各土所产亦白大小异族四、五种，犹同一类也，皆能补脾，益五脏，壮气力，止泄痢，惟粳米之功为第一耳。\""}]},{"ID":"20240614114929-z5asniw","Type":"NodeParagraph","Properties":{"id":"20240614114929-z5asniw","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"粳米，伤寒方中，亦多加入，各有取义，未尝一拘。少阴证，桃花汤每加，取甘以补正气也；竹叶石膏汤频用，取甘以益不足焉；白虎汤入手太阴，亦同甘草用者，取甘以缓之，使不速于下尔。\""}]},{"ID":"20240614114929-6wpcqfl","Type":"NodeParagraph","Properties":{"id":"20240614114929-6wpcqfl","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"梗稻六、七月收者为早粳，止可充食；八、九月收者为迟粳，十月收者为晚粳。北方气寒，粳性多凉，八、九月收者，即可入药；南方气热，粳性多温，惟十月晚稻气凉，乃可入药。\"\"按罗天益《宝鉴》云，粳粟米粥气薄味淡，阳中之阴也。所以淡渗下行，能利小便，又张耒《粥记》云，每日起，食粥一大碗，空腹胃虚，谷气便作，所补不细，又极柔腻，与肠胃相得，最为饮食之妙诀。\""}]},{"ID":"20240614114929-mry1v89","Type":"NodeParagraph","Properties":{"id":"20240614114929-mry1v89","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"粳米即人所常食米，为五谷之长，人相赖以为命者也。其味甘而淡，其性平而无毒，虽专主脾胃，而五脏生气，血脉精髓，因之以充溢，周身筋骨肌肉皮肤，因之而强健。《本经》益气止烦止泄，特其余事耳。\""}]},{"ID":"20240614114929-2qvvsg9","Type":"NodeParagraph","Properties":{"id":"20240614114929-2qvvsg9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"⑤《随息居饮食谱》：\"粳米甘平，宜煮粥食，功与籼同，籼亦可粥而粳较稠，粳亦可饭而籼耐饥。粥饭为世间第一补人之物，强食亦能致病戕生，患停饮者不宜吸粥。痧胀霍乱虽米汤不可入口，以其性补，能闭塞隧络也。故贫人患虚证，以浓米饮代参汤。至病人、产妇粥养最宜，以其较籼为柔，而较糯不粘也。炒米虽香，性燥助火，非中寒便泻者忌之。又有一种香粳米，自然有香，亦名香珠米，煮粥时加入之，香美异常，尤能醒胃。凡煮粥宜用井泉水，则味更佳也。\""}]},{"ID":"20240614114929-28artxo","Type":"NodeParagraph","Properties":{"id":"20240614114929-28artxo","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614114929-zva1157","Type":"NodeParagraph","Properties":{"id":"20240614114929-zva1157","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 稻的类型很多，按米粒的粘性不同，可分为粳稻、籼稻、糯稻等种。粳稻植株较矮，秆硬，叶幅狭，谷粒较短圆，米的粘性较强，胀性小。籼稻植株较高，秆软，叶幅宽，谷粒细长，米的粘性差，胀性大。糯稻在以上二种类型中都有，其米粒中含有多量糊精，粘性最强，胀性小。"}]},{"ID":"20240614114929-n6a9kn3","Type":"NodeParagraph","Properties":{"id":"20240614114929-n6a9kn3","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614114929-m2qfcz1","Type":"NodeParagraph","Properties":{"id":"20240614114929-m2qfcz1","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614114929-j98skc5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614114929-j98skc5","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"《中华本草》：粳米"}]},{"ID":"20240614114929-2mj2ijk","Type":"NodeParagraph","Properties":{"id":"20240614114929-2mj2ijk","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614114929-wan7zc7","Type":"NodeParagraph","Properties":{"id":"20240614114929-wan7zc7","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" Jīnɡ Mǐ"}]},{"ID":"20240614114929-c3el55c","Type":"NodeParagraph","Properties":{"id":"20240614114929-c3el55c","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614114929-fc6cbeu","Type":"NodeParagraph","Properties":{"id":"20240614114929-fc6cbeu","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 白米、粳粟米、稻米、大米、硬米"}]},{"ID":"20240614114929-ind7rub","Type":"NodeParagraph","Properties":{"id":"20240614114929-ind7rub","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614114929-k81f5ja","Type":"NodeParagraph","Properties":{"id":"20240614114929-k81f5ja","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" Rice"}]},{"ID":"20240614114929-qhr2jfb","Type":"NodeParagraph","Properties":{"id":"20240614114929-qhr2jfb","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614114929-mxawz1m","Type":"NodeParagraph","Properties":{"id":"20240614114929-mxawz1m","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》；1.《药性裁成》：粳米造饭， 用荷叶煮汤者宽中，芥菜叶者豁痰，紫苏叶者行气解肌，薄荷叶者清热，淡竹叶者避暑。造粥则白粥之外，入茯苓酪者清上实下，薯蓣粉者理胃，花椒汁者辟LAN瘴，姜、葱、鼓汁者发汗，与夫古方羊肾、猪肾之类无非药力也。"}]},{"ID":"20240614114929-am1exvm","Type":"NodeParagraph","Properties":{"id":"20240614114929-am1exvm","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614114929-7o294td","Type":"NodeParagraph","Properties":{"id":"20240614114929-7o294td","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 药材基源：为禾本科植物稻(粳稻)去壳的种仁。"}]},{"ID":"20240614114929-p56o96m","Type":"NodeParagraph","Properties":{"id":"20240614114929-p56o96m","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Oryza sativa L."}]},{"ID":"20240614114929-5zpb7yt","Type":"NodeParagraph","Properties":{"id":"20240614114929-5zpb7yt","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季颖果成熟时，采收，脱下果实，晒干，除去稻壳即可。"}]},{"ID":"20240614114929-cro8kzt","Type":"NodeParagraph","Properties":{"id":"20240614114929-cro8kzt","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614114929-crszsqo","Type":"NodeParagraph","Properties":{"id":"20240614114929-crszsqo","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 生态环境：我国南北各地均有水稻的栽培区。"}]},{"ID":"20240614114929-73ibioo","Type":"NodeParagraph","Properties":{"id":"20240614114929-73ibioo","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"资源分布：我国南北各地均有水稻的栽培区。"}]},{"ID":"20240614114929-lwqfbq8","Type":"NodeParagraph","Properties":{"id":"20240614114929-lwqfbq8","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614114929-afjm5dh","Type":"NodeParagraph","Properties":{"id":"20240614114929-afjm5dh","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 稻 一年生栽培植物。秆直立，丛生，高约1m左右。叶鞘无毛，下部者长于节间；叶舌膜质而较硬，披针形，基部两侧下延与叶鞘边缘相结合，长5-25mm，幼时具明显的叶耳；叶片扁平，披针形至条状披针形，长30-60cm，宽6-15cm。圆锥花序疏松，成熟时向下弯曲，分枝具角棱，常粗糙；小穗长圆形，两侧压扁，长6-8mm，含3小花，下方两小花退化仅存极小的外稃而位于1两性小花之下；颖极退化，在小穗柄之顶端呈半月形的痕迹；退化外稃长3-4mm，两性小花外稃，有5脉，常具细毛，有芒或无芒，内稃3脉，亦被细毛；鳞被2，卵圆形，长1mm；雄蕊6；花药长2mm；花柱2枚，筒短，柱头帚刷状，自小花两侧伸出。颖果平滑。花、果期6-10月。"}]},{"ID":"20240614114929-7ow2etr","Type":"NodeParagraph","Properties":{"id":"20240614114929-7ow2etr","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614114929-ldj1mrl","Type":"NodeParagraph","Properties":{"id":"20240614114929-ldj1mrl","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 呈扁椭圆形，长3-4mm，宽2-3mm。一端圆钝；另端有胚脱落而稍歪斜。表面浅白色，半透明，光滑。质坚硬，断面粉性。气微，味甘。 显微鉴别 粉末特征：类白色。单粒淀粉圆球形，4-12边形，直径2-4μm，脐点、层纹均不明显；复粒淀粉由2-8（-30）个分粒组成。"}]},{"ID":"20240614114929-w85957n","Type":"NodeParagraph","Properties":{"id":"20240614114929-w85957n","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614114929-65tr41n","Type":"NodeParagraph","Properties":{"id":"20240614114929-65tr41n","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 约含75%以上的淀粉（starch），8%左右蛋白质（protein），0.5%-1￥脂肪（fat），另含少量B族维生素B1、B2、B6等。脂肪部分主要为胆甾醇（cholesterol），菜油甾醇（campesterol），豆甾醇（stigmasterol）谷甾醇（sitosterol），一、二、三酰甘油（monoglyceride，diglyceride，triglyceride），磷脂（phospholipids），还含有二十四酰基鞘氨醇葡萄糖（N-lignoceryl sphingosylglucose），自由脂肪酸（free fatty acid）。尚含乙酸（acetic acid），延胡素酸（fumaric acid），琥珀酸（succinic acid），羟基代乙酸（glycolic acid），枸橼酸（citric acid），苹果酸（malic acid）等15种有机酸，葡萄糖（glucose），果糖（fructose），麦芽糖（maltose）等单糖和双糖。"}]},{"ID":"20240614114929-tvr3ta9","Type":"NodeParagraph","Properties":{"id":"20240614114929-tvr3ta9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614114929-vcb81bk","Type":"NodeParagraph","Properties":{"id":"20240614114929-vcb81bk","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 抗肿瘤作用：应用自然长菌风化陈年(3年以上)的糯米粽子，剔去其发黑者，80℃焙干，磨粉，做成水混悬液、水提取液及乙醇提取液。给小鼠接种腹水型肝癌后，每天灌服水混悬液或皮下注射水或乙醇提取液，连续10天，对于腹水型肝癌小鼠的腹水生成均有一定的抑制作用，其抑制率分别为77.6%、56.4%和52.1%。在腹水涂片上看到用药组的癌细胞退变现象都较对照组为着。肉眼观察，对照组腹腔内肿瘤生长较给药组广泛，粘连情况也较严重。但接种癌细胞后11天，对照组与用药组动物死亡情况并无明显差异。"}]},{"ID":"20240614114929-1aewty5","Type":"NodeParagraph","Properties":{"id":"20240614114929-1aewty5","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614114929-mdxblxs","Type":"NodeParagraph","Properties":{"id":"20240614114929-mdxblxs","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取粉末2g，加水4ml，置研钵中研磨，静置片刻后吸取上清液，滤过，滤液供试。 （1）取上述水提取液，点于滤纸上，喷洒茚三酮试剂，在100℃左右烘箱中放置1-2min，斑点呈紫色。 （2）取上述水提取液，点于滤纸上，喷洒苯胺-邻苯二甲酸试剂，105℃烘5min，呈现棕色斑点。（3）取上述水提取液，加1滴碘-碘化钾溶液，显紫蓝色。"}]},{"ID":"20240614114929-63ttemq","Type":"NodeParagraph","Properties":{"id":"20240614114929-63ttemq","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614114929-1dco1ag","Type":"NodeParagraph","Properties":{"id":"20240614114929-1dco1ag","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 脾；胃；肺经"}]},{"ID":"20240614114929-isr79cz","Type":"NodeParagraph","Properties":{"id":"20240614114929-isr79cz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614114929-wzzjov2","Type":"NodeParagraph","Properties":{"id":"20240614114929-wzzjov2","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 甘；平"}]},{"ID":"20240614114929-cigswsa","Type":"NodeParagraph","Properties":{"id":"20240614114929-cigswsa","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614114929-avsjct6","Type":"NodeParagraph","Properties":{"id":"20240614114929-avsjct6","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《食疗本草》：“新熟者动气，常食干饭，令人热中，唇口干；不可和苍耳食品店之，令人卒心痛；不可与马肉同食之，发痼疾。”"}]},{"ID":"20240614114929-hktw4qd","Type":"NodeParagraph","Properties":{"id":"20240614114929-hktw4qd","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614114929-y2pi5rz","Type":"NodeParagraph","Properties":{"id":"20240614114929-y2pi5rz","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 补气健脾；除烦渴；止泻痢。主脾胃气虚；食少纳呆；倦怠乏力；心烦口渴；泻下痢疾"}]},{"ID":"20240614114929-7j4uw57","Type":"NodeParagraph","Properties":{"id":"20240614114929-7j4uw57","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614114929-e4tdnk0","Type":"NodeParagraph","Properties":{"id":"20240614114929-e4tdnk0","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-30g；或水研取汁。"}]},{"ID":"20240614114929-yhzbz05","Type":"NodeParagraph","Properties":{"id":"20240614114929-yhzbz05","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614114929-utb5n15","Type":"NodeParagraph","Properties":{"id":"20240614114929-utb5n15","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" ①治霍乱狂闷，烦渴，吐泻无度，气欲绝者： 淡竹沥一台，粳米一合(炒，以水二盏同研，去滓取汁)。上二味，和匀顿服之。(《圣济总录》竹沥饮)②治赤痢热躁： 粳米半升。水研取汁，入油瓷瓶中，蜡纸封口，沉井底一夜，平旦服之。 (《普济方》)③治受胎未足，初生无皮，色赤，但有红筋： 早白米粉扑之。 (《圣济总录》)"}]},{"ID":"20240614114929-1aa876e","Type":"NodeParagraph","Properties":{"id":"20240614114929-1aa876e","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614114929-k8o81en","Type":"NodeParagraph","Properties":{"id":"20240614114929-k8o81en","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 1.宁原《食鉴本草》：粳米， 即今之白晚米，惟味香甘，与早熟米及各土所产赤白大小异族四、五种，犹同一类也，皆能补脾，益五脏，壮气力，止泄痢，惟粳米之功为第一耳。"}]},{"ID":"20240614114929-cd1wcrl","Type":"NodeParagraph","Properties":{"id":"20240614114929-cd1wcrl","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"2.《本草蒙筌》：粳米，伤寒方中，亦多加入，各有取义，未尝一拘。少阴证，桃花汤每加，取甘以补正气也；竹叶石膏汤频用，取甘以益不足焉；白虎汤入手太阴，亦同甘草用看，取甘以缓之，使不速于下尔。"}]},{"ID":"20240614114929-b0k0m55","Type":"NodeParagraph","Properties":{"id":"20240614114929-b0k0m55","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：粳稻六、七月收者为早粳，止可充食：八、九月收者为迟粳，十月收者为晚粳。北方气寒，粳性多凉，八、九月收者，即可入药；南方气热，粳性多温，惟十月晚稻气凉，乃可入药。按罗天益《宝鉴》云，粳粟米粥气薄味谈，阳中之阴也。所以谈渗下行，能利小便。又张耒《粥记》云，每日起，食粥一大碗，空腹胃虚，谷气便作，所补不细，又极柔腻，与肠胃相得，最为饮食之妙诀。"}]},{"ID":"20240614114929-wtmos3h","Type":"NodeParagraph","Properties":{"id":"20240614114929-wtmos3h","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：粳米即人所常食米，为五谷之长，人相赖以为命者也。其味甘而淡，其性平而无毒，虽专主脾胃，而五脏生气，血脉精髓，因之以充溢，周身筋骨肌肉皮肤，因之而强健。《本经》益气止烦止泄，特其余事耳。"}]},{"ID":"20240614114929-xpoyh1g","Type":"NodeParagraph","Properties":{"id":"20240614114929-xpoyh1g","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"5.《随息居饮食谱》：粳米甘平，宜煮粥食，功与籼同，籼亦可粥而粳较稠，粳亦可饭而籼耐饥。粥饭为世间第一补人之物。患停饮者不宜啜粥。痧胀霍乱虽米汤不可入口，以其性补，能闭塞隧络也。故贫人患虚证，以浓米饮代参汤。至病人、产妇粥养最宜，以其较籼为柔，而较糯不粘也。炒米虽香，性燥助火，非中寒便泻者忌之。又有一种香粳米，自然有香，亦名香珠米，煮粥时加入之，香美异常，尤能醒胃。凡煮粥宜用并泉水，则味更佳也。"}]},{"ID":"20240614114929-uwga2a9","Type":"NodeParagraph","Properties":{"id":"20240614114929-uwga2a9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"6.《别录》：主益气，止烦，止泄。"}]},{"ID":"20240614114929-ul81y6g","Type":"NodeParagraph","Properties":{"id":"20240614114929-ul81y6g","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"7.《千金·食治》：平胃气，长肌肉。"}]},{"ID":"20240614114929-r4psx7k","Type":"NodeParagraph","Properties":{"id":"20240614114929-r4psx7k","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"8.孟诜：温中，益气，补下元。"}]},{"ID":"20240614114929-dl9jt81","Type":"NodeParagraph","Properties":{"id":"20240614114929-dl9jt81","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"9.《日华子本草》：壮筋骨，补肠胃。"}]},{"ID":"20240614114929-q44ekd8","Type":"NodeParagraph","Properties":{"id":"20240614114929-q44ekd8","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"10.《滇南本草》：治诸虚百损，强阴壮骨，生津，明目，长智。"}]},{"ID":"20240614114929-mjweqfs","Type":"NodeParagraph","Properties":{"id":"20240614114929-mjweqfs","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"11.《纲目》：粳米粥：利小便，止烦渴，养肠胃。炒米汤：益胃除湿。"}]},{"ID":"20240614114929-wyt8fhc","Type":"NodeParagraph","Properties":{"id":"20240614114929-wyt8fhc","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614114929-q5cduh9","Type":"NodeParagraph","Properties":{"id":"20240614114929-q5cduh9","updated":"20240614114929"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614114931-57l0rw8","Type":"NodeThematicBreak","Properties":{"id":"20240614114931-57l0rw8"}},{"ID":"20240614114932-e6svgry","Type":"NodeParagraph","Properties":{"id":"20240614114932-e6svgry"}}]}