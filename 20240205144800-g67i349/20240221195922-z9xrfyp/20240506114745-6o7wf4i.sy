idth: 349px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芪 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芪 9-20240806153601-81aiep4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 349px;\" parent-style=\"width: 359px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 475px;","style":"width: 465px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芪 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芪 12-20240806153853-1z6ryu1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 465px;\" parent-style=\"width: 475px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806153709-x70kffp","Type":"NodeParagraph","Properties":{"id":"20240806153709-x70kffp","updated":"20240806153920"},"Children":[{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240722165152-trt53ny","Type":"NodeParagraph","Properties":{"id":"20240722165152-trt53ny","updated":"20240722165157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芪、红芪对比"}]},{"ID":"20240722165158-ajiu3np","Type":"NodeParagraph","Properties":{"id":"20240722165158-ajiu3np","updated":"20240806150039"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红芪黄芪对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红芪黄芪对比-20240722161812-cf3b029.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722165207-kxgxvvb","Type":"NodeParagraph","Properties":{"id":"20240722165207-kxgxvvb","updated":"20240806160111"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：红芪的茎杆是红色的，生长要比黄芪缓慢许多，且红芪的根部是深红或者暗红色，比较偏黑一点。黄芪的根部采挖出来是土灰色或者灰白色的；据说红芪有跟黄芪一样的效果，更优于黄芪，但因为分布较少所以无法大量应用；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205165631-u3uhmcx","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"红芪"}]},{"ID":"20240722165223-pm8a6na","Type":"NodeParagraph","Properties":{"id":"20240722165223-pm8a6na","updated":"20240806163653"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：苦参跟黄芪相似，黄芪叶片小且尾部较圆，苦参叶片狭长且尾部较尖；黄芪茎杆有绒毛且较软，苦参茎杆没有毛且较硬，较光滑；苦参的豆荚细而长，黄芪的豆荚短而宽；还有黄芪茎杆咀嚼有豆腥味，苦参茎杆咀嚼是苦味；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205153843-5szukmh","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"161苦参"}]},{"ID":"20240616131300-pd14dvr","Type":"NodeThematicBreak","Properties":{"id":"20240616131300-pd14dvr"}},{"ID":"20240616131649-hnomorr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131649-hnomorr","updated":"20240616131652"},"Children":[{"Type":"NodeText","Data":"黄耆《神农本草经》"}]},{"ID":"20240616131649-l070pnm","Type":"NodeParagraph","Properties":{"id":"20240616131649-l070pnm","updated":"20240616131649"},"Children":[{"Type":"NodeText","Data":"味甘微温。"}]},{"ID":"20240616131649-8rvh31p","Type":"NodeParagraph","Properties":{"id":"20240616131649-8rvh31p","updated":"20240616131649"},"Children":[{"Type":"NodeText","Data":"主痈疽久败创，排脓止痛，大风，痢疾，五痔，鼠瘘，补虚，小儿百病。一名戴糁。生山谷。"}]},{"ID":"20240616131649-zwizbo3","Type":"NodeParagraph","Properties":{"id":"20240616131649-zwizbo3","updated":"20240616131649"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名戴椹，一名独椹，一名芰草，一名蜀脂，一名百本，生蜀郡白水汉中，二月十月采，阴干。"}]},{"ID":"20240616131701-l0weinp","Type":"NodeThematicBreak","Properties":{"id":"20240616131701-l0weinp"}},{"ID":"20240616131702-z36e40n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131702-z36e40n","updated":"20240616131706"},"Children":[{"Type":"NodeText","Data":"黄芪《本草分经》"}]},{"ID":"20240616131702-q3g64za","Type":"NodeParagraph","Properties":{"id":"20240616131702-q3g64za","updated":"20240616131702"},"Children":[{"Type":"NodeText","Data":"气虚难汗者可发，表疏多汗者可止，生用泻火，炙用补中，为内托疮痈要药，但滞胃尔。"}]},{"ID":"20240616131300-6srggx0","Type":"NodeThematicBreak","Properties":{"id":"20240616131300-6srggx0"}},{"ID":"20240616131502-ivar8cu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131502-ivar8cu","updated":"20240616131511"},"Children":[{"Type":"NodeText","Data":"黄芪《本草备要》"}]},{"ID":"20240616131502-l584a46","Type":"NodeParagraph","Properties":{"id":"20240616131502-l584a46","updated":"20240616131502"},"Children":[{"Type":"NodeText","Data":"补气，固表，泻火"}]},{"ID":"20240616131502-nwzq1at","Type":"NodeParagraph","Properties":{"id":"20240616131502-nwzq1at","updated":"20240616131502"},"Children":[{"Type":"NodeText","Data":"甘温。生用固表，无汗能发，有汗能止（丹溪云∶黄芪大补阳虚自汗，若表虚有邪，发汗不出者，服此又能自汗。朱震亨，号丹溪，着《本草补遗》）。温分肉，实腠理，泻阴火，解肌热。炙用补中，益元气，温三焦，壮脾胃（脾胃一虚，土不能生金，则肺气先绝。脾胃缓和，则肺气旺而肌表固实。补中即所以固表也）。生血生肌（气能生血、血充则肉长，经曰∶血生肉），排脓内托，疮痈圣药（毒瓦斯化则成脓，补气故能内托。痈疽不能成脓者，死不治，毒瓦斯盛而元气衰也，痘症亦然）。痘症不起，阳虚无热者宜之（新安汪机治痘症虚寒不起，用四君子汤加黄芪、紫草多效，间有枯萎而死者，自咎用药之不精，思之至忘寝食，忽悟曰∶白术燥湿，茯苓渗水，宜痘浆之不行也。乃减去二味，加官桂、糯米，以助其力，因名保元汤。人参、白术、茯苓、甘草，名四君子汤。王好古曰∶黄芪实卫气，是表药；益脾胃，是中州药；治伤寒尺脉不至，补肾元，是里药。甄权谓∶其补肾者，气为水母也。日华谓∶其止崩带者，气盛则无陷下之忧也。《蒙筌》曰∶补气药多，补血药亦从而补气，补血药多，补气药亦从而补血。益气汤虽加当归，因势寡，功被参、 所据；补血汤数倍于当归，亦从当归所引而补血。黄芪一两、当归二钱，名补血汤。气药多而云补血者，气能生血，又有当归为引也。表旺者不宜用，阴虚者宜少用，恐升气于表，而里愈虚矣。汪机，号石山，着《本草会编》。王好古，号海藏，着《汤液本草》。甄权，着《药性论》。日华，着《大明本草》。陈嘉谟，着《本草蒙筌》）。为补药之长，故名耆（俗作 ）。"}]},{"ID":"20240616131502-5yi8ade","Type":"NodeParagraph","Properties":{"id":"20240616131502-5yi8ade","updated":"20240616131502"},"Children":[{"Type":"NodeText","Data":"皮黄肉白，坚实者良。入补中药槌扁，蜜炙。达表生用（或曰，补肾及治崩带淋浊，宜盐水浸炒。昂按∶此说非也。前症用黄芪，非欲抑黄芪使入肾也。取其补中升气，则肾受荫，而带浊崩淋自止。即日华∶气盛自无陷下之忧也。有上病而下取，有下病而上取，补彼经而益及此经者，此类是也）。茯苓为使。恶龟甲、白鲜皮。畏防风（东垣曰∶黄芪得防风，其功益大，乃相畏而更以相使也。李东垣，着《用药法篆》）。"}]},{"ID":"20240616131339-vkitjl8","Type":"NodeThematicBreak","Properties":{"id":"20240616131339-vkitjl8"}},{"ID":"20240616131340-fjy04du","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131340-fjy04du","updated":"20240616131345"},"Children":[{"Type":"NodeText","Data":"黄芪《本草纲目》"}]},{"ID":"20240616131340-bkfbftr","Type":"NodeParagraph","Properties":{"id":"20240616131340-bkfbftr","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"「释名」亦名戴糁、戴椹、草、百本、王孙。（“芪”原作为“耆”）。"}]},{"ID":"20240616131340-3ra8i4j","Type":"NodeParagraph","Properties":{"id":"20240616131340-3ra8i4j","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"「气味」（根）甘、微温、无毒。"}]},{"ID":"20240616131340-67ahzfc","Type":"NodeParagraph","Properties":{"id":"20240616131340-67ahzfc","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616131340-rkspmzg","Type":"NodeParagraph","Properties":{"id":"20240616131340-rkspmzg","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"1、小便不通。用黄芪二钱，加水二碗，煎成一碗，温服。小儿减半。"}]},{"ID":"20240616131340-1pf2y4n","Type":"NodeParagraph","Properties":{"id":"20240616131340-1pf2y4n","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"2、酒疸黄疾（醉后感寒，身上发赤、黑、黄斑）。用黄芪二两、木兰一两，共研细。每服少许。一天服三次，酒送下。"}]},{"ID":"20240616131340-n34w9i1","Type":"NodeParagraph","Properties":{"id":"20240616131340-n34w9i1","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"3、白浊。用盐炒黄芪半两、茯苓一两，共研细。每服一钱。"}]},{"ID":"20240616131340-owvsdrw","Type":"NodeParagraph","Properties":{"id":"20240616131340-owvsdrw","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"4、萎黄焦渴（每与痈疽发作，先后伴随）。用黄芪六两，一半生焙，一半加盐水在饭上蒸熟；另用甘草一两，也是一半生用，一半灸黄。二药共研细。每服二钱，一天两次。也可以煎服。此方名“黄芪六一汤”。"}]},{"ID":"20240616131340-p76p57h","Type":"NodeParagraph","Properties":{"id":"20240616131340-p76p57h","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"5、老人便秘。用黄芪、陈皮各半两，研细。另用大麻子一合，捣烂，加水揉出浆汁，煎至半干，调入白蜜一匙，再煮过，把黄芪、陈皮末加入调匀服下。两服可通便。可以常服。"}]},{"ID":"20240616131340-ixoglad","Type":"NodeParagraph","Properties":{"id":"20240616131340-ixoglad","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"6、血淋。用黄芪、黄连，等分为末，加面糊做成丸子，如绿豆大。每服三十丸。"}]},{"ID":"20240616131340-26idr7l","Type":"NodeParagraph","Properties":{"id":"20240616131340-26idr7l","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"7、少淋。用黄芪、人参，等分为末。另用萝卜四、五片，加蜜二两，稍稍灸过后，蘸药末吃下，以盐水送服。"}]},{"ID":"20240616131340-98k372d","Type":"NodeParagraph","Properties":{"id":"20240616131340-98k372d","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"8、吐血。用黄芪二钱半、紫背浮萍五钱，共研为末。每服一钱，姜蜜水送下。"}]},{"ID":"20240616131340-9ybxgtl","Type":"NodeParagraph","Properties":{"id":"20240616131340-9ybxgtl","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"9、咳脓咳血，咽干（这是虚热，不可吃凉药）。用黄芪四两、甘草一两，共研为末。每服二钱，热水送下。"}]},{"ID":"20240616131340-324x1n7","Type":"NodeParagraph","Properties":{"id":"20240616131340-324x1n7","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"10、肺痈。用黄芪二两研细，每取二钱煎汤服。一天可服三、四次。"}]},{"ID":"20240616131340-osp9n28","Type":"NodeParagraph","Properties":{"id":"20240616131340-osp9n28","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"11、甲疽（趾甲边红肉突出成疽）。用黄芪二两、茹一两，醋浸一宿，加入猪油五合，微火煎成二合。去渣，取脂涂疮上。一天三次。"}]},{"ID":"20240616131340-4lmgy3r","Type":"NodeParagraph","Properties":{"id":"20240616131340-4lmgy3r","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"12、胎动不安（腹痛，下黄汁）。用黄芪、芎各一两，糯米一合，水一升，一起煮到半到。分次服下。"}]},{"ID":"20240616131340-xgjysvj","Type":"NodeParagraph","Properties":{"id":"20240616131340-xgjysvj","updated":"20240616131340"},"Children":[{"Type":"NodeText","Data":"13、阴汗湿痒。用黄芪酒炒后研细，切熟猪心蘸着吃，有效。"}]},{"ID":"20240616131300-94r4rad","Type":"NodeThematicBreak","Properties":{"id":"20240616131300-94r4rad"}},{"ID":"20240616131312-63qi1l3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131312-63qi1l3","updated":"20240616131315"},"Children":[{"Type":"NodeText","Data":"黄芪《长沙药解》"}]},{"ID":"20240616131312-qoyu8m5","Type":"NodeParagraph","Properties":{"id":"20240616131312-qoyu8m5","updated":"20240616131312"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】黄耆。味甘微温。主痈疽久败创，排脓止痛，大风，痢疾，五痔，鼠瘘，补虚，小儿百病。一名戴糁。生山谷。"}]},{"ID":"20240616131312-t8fagoa","Type":"NodeParagraph","Properties":{"id":"20240616131312-t8fagoa","updated":"20240616131312"},"Children":[{"Type":"NodeText","Data":"味甘，气平，入足阳明胃、手太阴肺经。入肺胃而补气，走经络而益营，医黄汗血痹之证，疗皮水风湿之疾，历节肿痛最效，虚劳里急更良，善达皮腠，专通肌表。"}]},{"ID":"20240616131312-fm5t8s0","Type":"NodeParagraph","Properties":{"id":"20240616131312-fm5t8s0","updated":"20240616131312"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芪芍药桂酒汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄芪五两，芍药三两，桂枝三两，苦酒一升。"},{"Type":"NodeText","Data":"治黄汗身肿，发热汗出而渴，汗沾衣，色黄如柏叶，脉自沉者。以汗出入水，水从窍入，淫泆于经络之间，阻其卫气，壅而为肿。卫气不行，遏其营血，郁而为热。脾为己土，肌肉司焉，水气浸淫，肌肉滋湿，营行经络之中，遏于湿土之内，郁热熏蒸，化而为黄。营秉肝气，而肝司五色，入脾为黄，营热蒸发，卫不能闭，则开其皮毛，泄为黄汗，缘营血闭遏，而木郁风动，行其疏泄之令也。风热消烁，津液耗伤，是以发渴。木气遏陷，不得升达，是以脉沉。黄芪走皮毛而行卫郁，桂枝走经络而达营郁，芍药、苦酒，泻营热而清风木也。"}]},{"ID":"20240616131312-02in97k","Type":"NodeParagraph","Properties":{"id":"20240616131312-02in97k","updated":"20240616131312"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝加黄芪汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桂枝三两，芍药三两，甘草二两，大枣十二枚，生姜三两，黄芪二两。"},{"Type":"NodeText","Data":"治黄汗，两胫自冷，腰髋弛痛，如有物在皮中，身疼重，烦躁，腰以上汗出，小便不利。以水在经络，下注关节，外阻卫阳而内遏营阴。营遏木陷，温气沦郁，内热不宣，故两胫自冷。风木郁勃，经络鼓荡，故腰髋弛痛，如有物在皮中。湿淫外束，故疼重烦躁。木陷而郁于湿土，故小便不利。风升而开其孔窍，故腰以上汗出。水谷未消，中气满胀，营愈郁而热愈发，故食已则汗。暮而卫气入阴，为营气所阻，不得内敛，故外泄皮毛而为盗汗。营热郁隆，不为汗减，热蒸血败，不能外华皮腠，久而肌肤枯涩，必至甲错。血肉腐溃，必生恶疮。甘、枣、生姜，补宣中气，芍药泻营热而清风木，桂枝达营气之郁，黄芪行卫气之郁，助以热粥而发微汗，经热自随汗泄也。"}]},{"ID":"20240616131312-l79n2ij","Type":"NodeParagraph","Properties":{"id":"20240616131312-l79n2ij","updated":"20240616131312"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芪桂枝五物汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄芪三两，桂枝三两，芍药三两，生姜六两，大枣十二枚。"},{"Type":"NodeText","Data":"治血痹，身体不仁，状如风痹，脉尺寸关上俱微，尺中小紧。以疲劳汗出，气蒸血沸之时，安卧而被微风，皮毛束闭，营血凝涩，卫气郁遏，渐生麻痹。营卫阻梗，不能煦濡肌肉，久而枯槁无知，遂以不仁。营卫不行，经络无气，故尺寸关上俱微。营遏木陷，郁动水内，而不能上达，故尺中小紧。大枣、芍药，滋营血而清风木，姜、桂、黄芪，宣营卫而行瘀涩，倍生姜者，通经而开痹也。"}]},{"ID":"20240616131312-p43j5qt","Type":"NodeParagraph","Properties":{"id":"20240616131312-p43j5qt","updated":"20240616131312"},"Children":[{"Type":"NodeText","Data":"肝脾左旋，癸水温升而化血，肺胃右转，丁火清降而化气。血司于肝，其在经络则曰营，气司于肺，其在经络则曰卫。营行脉中，为卫之根，卫行脉外，为营之叶。营卫周行，一日五十度，阴阳相贯，如环无端。其流溢之气，内溉脏腑，外濡腠理。营卫者，气血之精华者也。二十二难：脉有是动、有所生病。是动者，气也，所生病者，血也。气主煦之，血主濡之，气留而不行者，气先病也，血滞而不濡者，血后病也。血阴而气阳，阴静而阳动，阴则内守，阳则外散，静则不辟，动则不阖。而卫反降敛，以其清凉而含阴魄，营反温升，以其温暖而抱阳魂也。卫本动也，有阴以阖之，则动者化而为降敛，营本静也，有阳以辟之，则静者变而为升发。然则血之温暖，气煦之也，营之流动，卫运之也，是以气有所动，则血病生焉。气冷而后血寒，卫梗而后营瘀，欲调血病，必益血中之温气，欲调营病，必理营外之卫阳。卫气者，逆则不敛，陷则不发，郁则不运，阻则不通，是营血受病之原也。黄芪清虚和畅，专走经络，而益卫气。逆者敛之，陷者发之，郁者运之，阻者通之，是燮理卫气之要药，亦即调和营血之上品。辅以姜、桂、芍药之类，奏功甚捷，余药不及也。"}]},{"ID":"20240616131312-tnbrzoy","Type":"NodeParagraph","Properties":{"id":"20240616131312-tnbrzoy","updated":"20240616131312"},"Children":[{"Type":"NodeText","Data":"五行之气，凉则收而寒则藏，气之清凉而收敛者，秉金气也。黄芪入肺胃而益卫气，佐以辛温则能发，辅以酸凉则善敛，故能发表而出汗，亦能敛表而止汗。小儿痘病，卫为营闭，不得外泄。卫旺则发，卫衰则陷，陷而不发者，最宜参芪，助卫阳以发之。凡一切疮疡，总忌内陷，悉宜黄芪。"}]},{"ID":"20240616131312-32kbk43","Type":"NodeParagraph","Properties":{"id":"20240616131312-32kbk43","updated":"20240616131312"},"Children":[{"Type":"NodeText","Data":"蜜炙用。生用微凉，清表敛汗宜之。"}]},{"ID":"20240616131300-7yakkbd","Type":"NodeThematicBreak","Properties":{"id":"20240616131300-7yakkbd"}},{"ID":"20240616131301-i1h6z5g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131301-i1h6z5g","updated":"20240616131306"},"Children":[{"Type":"NodeText","Data":"黄芪《本草新编》"}]},{"ID":"20240616131301-hqhxzv9","Type":"NodeParagraph","Properties":{"id":"20240616131301-hqhxzv9","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"黄芪，味甘，气微温，气薄而味浓，可升可降，阳中之阳也，无毒。专补气。入手太阴、足太阴、手少阴之经。其功用甚多，而其独效者，尤在补血。夫黄芪乃补气之圣药，如何补血独效。盖气无形，血则有形。有形不能速生，必得无形之气以生之。黄芪用之于当归之中，自能助之以生血也。夫当归原能生血，何藉黄芪，不知血药生血其功缓，气药生血其功速，况气分血分之药，合而相同，则血得气而速生，又何疑哉。或疑血得气而生，少用黄芪足矣，即不少用，与当归平用亦得，何故补血汤中反少用当归而倍用黄芪？不知补血之汤，名虽补血，其实单补气也。失血之后，血已倾盆而出，即用补血之药，所生之血不过些微，安能遍养五脏六腑，是血失而气亦欲失也。在血不能速生，而将绝未绝之气，若不急为救援，一旦解散，顷刻亡矣。故补血必先补气也。但恐补气则阳偏旺而阴偏衰，所以又益之当归以生血，使气生十之七而血生十之三，则阴阳有制，反得大益。生气而又生血，两无他害也。至于补中益气汤之用黄芪，又佐人参以成功者也。人参得黄芪，兼能补营卫而固腠理，健脾胃而消痰食，助升麻、柴胡，以提气于至阴之中，故益气汤中无人参，则升提乏力，多加黄芪、白术，始能升举。倘用人参、白术而减去黄芪，断不能升气于至阴也。故气虚之人，毋论各病，俱当兼用黄芪，而血虚之人尤宜多用。惟骨蒸痨热与中满之人忌用，然亦当临症审量。（〔批〕无黄芪不能提气于至阴，创论亦是确论。）"}]},{"ID":"20240616131301-ubc49ov","Type":"NodeParagraph","Properties":{"id":"20240616131301-ubc49ov","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪性畏防风，而古人云黄芪得防风，其功愈大，谓是相畏而相使也，其说然乎？"}]},{"ID":"20240616131301-ddtr8dk","Type":"NodeParagraph","Properties":{"id":"20240616131301-ddtr8dk","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"此说亦可信不可信之辞也。黄芪无毒，何畏防风，无畏而言畏者，以黄芪性补而防风性散也，合而用之，则补者不至大补，而散者不至大散，故功用反大耳。（〔批〕黄芪欲防风者，以防风能通达上下周身之气，得黄芪而生，黄芪达表，防风御风，外来之风得黄芪而拒绝也。）"}]},{"ID":"20240616131301-2uriryq","Type":"NodeParagraph","Properties":{"id":"20240616131301-2uriryq","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪补气，反增胀满，似乎黄芪不可补气也，岂有药以解其胀，抑可不用黄芪耶？"}]},{"ID":"20240616131301-aaklu56","Type":"NodeParagraph","Properties":{"id":"20240616131301-aaklu56","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"夫黄芪乃补气药，气虚不用黄芪，又用何药。然服之而增胀满者，非黄芪之助气，乃黄芪之不助气也。阴阳有根，而后气血可补。阴阳之根将绝。服补药而反不受补。药见病不能受，亦不去补病矣。此黄芪补气而反增胀满，乃不生气之故。然亦因其不可生而不生也，又岂有别药以解其胀哉。"}]},{"ID":"20240616131301-wft073f","Type":"NodeParagraph","Properties":{"id":"20240616131301-wft073f","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪气分之药，吾子以为补血之品，是凡有血虚之症，俱宜用黄芪矣，何以古人用补血之药多，用四物汤、佛手散，绝不见用黄芪之补血者，岂古人非欤？古人未尝非也，第以血症不同，有顺有逆。顺则宜用血药以补血，逆则宜用气药以补血也。盖血症之逆者，非血逆而气逆也，气逆而后血逆耳。血逆而仍用血分之药，则气不顺而血愈逆矣，故必须补气以安血也。气逆则血逆，气安则血安，此不易之理也。凡血不宜上行，呕咯吐衄之血，皆逆也。血犹洪水，水逆则泛滥于天下，血逆则腾沸于上焦，徒治其血，又何易奏平成哉。故必用补气之药于补血之中，虽气生夫血，亦气行夫血也。此黄芪补血汤所以独胜于千古也。（〔批〕补血分气逆气顺，确有见解。）"}]},{"ID":"20240616131301-rmy3gz0","Type":"NodeParagraph","Properties":{"id":"20240616131301-rmy3gz0","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪以治气逆之血，发明独绝，然而亦有用四物汤、佛手散以止血而效者，又是何故？"}]},{"ID":"20240616131301-jg9xrkx","Type":"NodeParagraph","Properties":{"id":"20240616131301-jg9xrkx","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"洵乎吾子之善问也。夫血逆亦有不同，有大逆，有小逆。大逆者，必须补气以止血；小逆者，亦可调血以归经。用四物汤、佛手散治血而血止者，血得补而归经也。盖血最难归经，何以四物、佛手偏能取效，正因其血逆之轻耳。逆轻者，气逆之小也；逆重者，气逆之大也。"}]},{"ID":"20240616131301-no0stb1","Type":"NodeParagraph","Properties":{"id":"20240616131301-no0stb1","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"以四物汤、佛手散治血而血安，虽亦取效，终必得效之迟，不若补血汤治气而血止得效之捷也。"}]},{"ID":"20240616131301-cpsl3dx","Type":"NodeParagraph","Properties":{"id":"20240616131301-cpsl3dx","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪补气，初作胀满，而少顷安然者，何也？此气虚见补，反作不受也。黄芪补气之虚，而胃中之望补，更甚于别脏腑。黄芪一入胃中，惟恐有夺其补者，乃闭关而不肯吐，此胀满所由生也。治之法，用黄芪不可单用，增入归、芎、麦冬三味，使之分散于上下之间，自无胀满之忧矣。故服黄芪胀满有二症，一不能受而一过于受也。过于受者，服下胀而少顷宽；不能受者，初胀轻而久反重。以此辨之最易别耳。"}]},{"ID":"20240616131301-uy9n3fq","Type":"NodeParagraph","Properties":{"id":"20240616131301-uy9n3fq","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪补气之圣药，宜乎凡气虚者，俱可补之矣，何喘满之病反不用者？恐其助满而增胀也。先生既明阴阳之道，深知虚实之宜，必有以教我也。曰∶黄芪补气而不可治胀满者，非黄芪之故，不善用黄芪之故也。夫人喘大满，乃肾气欲绝，奔腾而上升，似乎气之有余，实是气之不足。古人用人参大剂治之者，以人参不能助胀而善能定喘耳，用之实宜。然天下贫人多而富人少，安得多备人参救急哉。古人所以用黄芪代之，而喘满增剧，遂不敢复用，且志之书曰∶喘满者不可用黄芪，因自误而不敢误人也。谁知黄芪善用之以治喘满实神。铎受异人传，不敢隐也。黄芪用防风之汁炒而用之，再不增胀增满，但制之实有法。防风用少，则力薄不能制黄芪，用多则味浓，又嫌过制黄芪，不惟不能补气，反有散气之忧。大约黄芪用一斤，用防风一两。先将防风用水十碗煎数沸，漉去防风之渣，泡黄芪二刻，湿透，以火炒之干。再泡透，又炒干，以汁干为度。再用北五味三钱，煎汤一大碗，又泡半干半湿，复炒之，火焙干，得地气，然后用之。凡人参该用一两者，黄芪亦用一两。定喘如神，而又不增添胀满，至妙之法，亦至便之法也。凡用黄芪，俱宜如此制之。虽古人用黄芪加入防风，治病亦能得效，然其性尚未制伏，终有跳梁之虞，不若先制之为宜，彼此畏忌而成功更神，又何喘病之不可治哉。（〔批〕用制黄芪以治喘者，救贫寒之人也。若富贵膏梁之子，毕竟宜用人参。）"}]},{"ID":"20240616131301-dqpccrd","Type":"NodeParagraph","Properties":{"id":"20240616131301-dqpccrd","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或疑黄芪得防风其功更大，用黄芪加入防风足矣，而必先制而后用，毋乃太好奇乎？不知用黄芪而加防风，则防风之性与黄芪尚有彼此之分，不若先制之，调和其性情，制伏其手足，使之两相亲而两相合，绝不知有同异之分。如异姓之兄弟胜于同胞，相顾而收其全功也。"}]},{"ID":"20240616131301-q5ad42q","Type":"NodeParagraph","Properties":{"id":"20240616131301-q5ad42q","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或疑黄芪补气之虚，止可补初起之虚，而不可补久病之虚，予问其故。曰∶初虚之病，用黄芪易受；久虚之病，用黄芪难受也。嗟乎。虚病用补，宜新久之皆可受，其不可受者，非气之虚，乃气之逆也。气逆之虚，必用人参，而不可用黄芪。在初虚气逆之时，即忌黄芪矣，何待久病而后不可用哉。若气虽虚而无逆，则久病正宜黄芪，未有不服之而安然者也。谁谓黄芪之难受乎。（〔批〕黄芪不能补气逆之虚，妙论。）"}]},{"ID":"20240616131301-2pz2gk6","Type":"NodeParagraph","Properties":{"id":"20240616131301-2pz2gk6","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或疑黄芪补气，何以必助之当归以补血，岂气非血不生耶？不知气能生血，而血不能生气，不能生气，而补气必补血者，非取其助气也。盖气虚之人，未有不血亦随之而俱耗者也。我大用黄芪以生气，则气旺而血衰，血不能配气之有余，气必至生血之不足，反不得气之益，而转得气之害矣。故补气必须补血之兼施也。但因气虚以补气，而复补其血，则血旺而气仍衰，奈何。不知血旺则气不去生血，故补血而气自旺，不必忧有偏胜之虞。然多补其气而少补其血，则又调剂之甚宜也。"}]},{"ID":"20240616131301-296rncq","Type":"NodeParagraph","Properties":{"id":"20240616131301-296rncq","updated":"20240616131301"},"Children":[{"Type":"NodeText","Data":"或问黄芪何故必须蜜炙，岂生用非耶？然疮疡之门，偏用生黄芪，亦有说乎？曰∶黄芪原不必蜜炙也，世人谓黄芪炙则补而生则泻，其实生用未尝不补也。"}]},{"ID":"20240616131324-120pmg0","Type":"NodeThematicBreak","Properties":{"id":"20240616131324-120pmg0"}},{"ID":"20240616131325-ath2p2o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131325-ath2p2o","updated":"20240616131329"},"Children":[{"Type":"NodeText","Data":"黄耆《中药学》"}]},{"ID":"20240616131325-651vdp5","Type":"NodeParagraph","Properties":{"id":"20240616131325-651vdp5","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为豆科植物内蒙黄耆、膜荚黄耆或其它同属相近种植物的根。"}]},{"ID":"20240616131325-irrmb3p","Type":"NodeParagraph","Properties":{"id":"20240616131325-irrmb3p","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，微温。入脾、肺经。"}]},{"ID":"20240616131325-j5jznre","Type":"NodeParagraph","Properties":{"id":"20240616131325-j5jznre","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【功效】补气升阳，固表止汗，托疮生肌，利水退肿。"}]},{"ID":"20240616131325-7593su8","Type":"NodeParagraph","Properties":{"id":"20240616131325-7593su8","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于气虚衰弱，倦怠乏力，或中气下陷、脱肛、子宫脱垂等症。"}]},{"ID":"20240616131325-szhirl4","Type":"NodeParagraph","Properties":{"id":"20240616131325-szhirl4","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"黄耆健脾益气，且具升阳举陷的功效，故可用于气虚乏力及中气下陷等症。在临床上用于补气健脾，常与党参、白朮等配伍；用于益气升阳而举陷，常与党参、升麻、柴胡、炙甘草等合用。"}]},{"ID":"20240616131325-9ewf3me","Type":"NodeParagraph","Properties":{"id":"20240616131325-9ewf3me","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"2.用于表虚不固的自汗症。"}]},{"ID":"20240616131325-t7xcirk","Type":"NodeParagraph","Properties":{"id":"20240616131325-t7xcirk","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"黄耆功能固护卫阳、实表止汗。用于表虚自汗，常与麻黄根、浮小麦、牡蛎等配伍；如表虚易感风寒者，可与防风、白朮同用。"}]},{"ID":"20240616131325-eot3zwf","Type":"NodeParagraph","Properties":{"id":"20240616131325-eot3zwf","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"3.用于气血不足、疮疡内陷、脓成不溃或久溃不敛者。"}]},{"ID":"20240616131325-3l12ebh","Type":"NodeParagraph","Properties":{"id":"20240616131325-3l12ebh","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"黄耆能温养脾胃而生肌，补益元气而托疮，故一般称为疮痈要药，临床上多用于气血不足、疮痈内陷、脓成不溃、或溃破后久不收口等症。如用于疮疡内陷、或久溃不敛，可与党参、肉桂、当归等配伍；用于脓成不溃，可与当归、银花、白芷、穿山甲、皂角刺等同用。"}]},{"ID":"20240616131325-es9ofv9","Type":"NodeParagraph","Properties":{"id":"20240616131325-es9ofv9","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"4.用于水肿、脚气、面目浮肿等症。"}]},{"ID":"20240616131325-37ujumj","Type":"NodeParagraph","Properties":{"id":"20240616131325-37ujumj","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"黄耆能益气而健脾，运阳而利水，故可用于水肿而兼有气虚症状者，多配合白朮、茯苓等同用。"}]},{"ID":"20240616131325-c18rm5b","Type":"NodeParagraph","Properties":{"id":"20240616131325-c18rm5b","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"此外，本品又可与活血袪瘀通络药如当归、川芍、桃仁、红花、地龙等配伍，用于中风偏枯、半身不遂之症，有益气活血、通络利痹的功效。对于消渴病症，也可应用，常与生地、麦冬、天花粉、山药等配伍．"}]},{"ID":"20240616131325-my5v830","Type":"NodeParagraph","Properties":{"id":"20240616131325-my5v830","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【处方用名】生黄耆、绵黄耆、北口耆（生用，多用于固表、托疮、利水、利痹等。）、炙黄耆（蜜炙用，用于补气健脾。）、清炙黄耆（用麸皮拌炒至微黄色，用于补气。）"}]},{"ID":"20240616131325-pgrhbcu","Type":"NodeParagraph","Properties":{"id":"20240616131325-pgrhbcu","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240616131325-nnqnj02","Type":"NodeParagraph","Properties":{"id":"20240616131325-nnqnj02","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【按语】1.黄耆一药，原名黄耆，始载于《本经》是一味临床常用药物。黄耆具有下列的特点，它不仅常与补养药同用以益气补虚；且常与袪邪药同用以扶正袪邪。在益气补虚方面，如配人参，则大补元气；配附子，则补气助阳；配白朮，则益气补脾；配当归，则补气生血；配参、朮、升、柴，则补气升阳。在扶正袪邪方面，如在玉屏风散中配白朮、防风，则补散兼施、固表止汗，治卫虚自汗，易感风寒；在四妙汤中配当归、银花、甘草，则内补托毒，治体虚痈疮疖肿难愈者；在防己茯苓汤中配茯苓、防己、桂枝、甘草，则益气运阳而利水，治皮水肢肿；在补阳还五汤中配归、芎、赤芍、桃仁、红花、地龙，则益气活血、散瘀通络，治半身不遂。诸如此类，可见它临床应用的范围至为广泛。"}]},{"ID":"20240616131325-rt7j4fg","Type":"NodeParagraph","Properties":{"id":"20240616131325-rt7j4fg","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"2.本品与人参、党参相比较，人参的补气作用较强，且能生津、安神；党参功专补肺脾而益气；黄耆的补气作用不及人参，但益气升阳，固表内托，且能利水退肿的作用则为人参、党参所不具。黄耆为补气扶阳的药物，故凡气滞湿阻、食滞胸闷、热毒疮疡、表实邪盛及阴虚阳亢等症，不宜应用。"}]},{"ID":"20240616131325-iixhjyj","Type":"NodeParagraph","Properties":{"id":"20240616131325-iixhjyj","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【方剂举例】补中益气汤（《脾胃论》）：黄耆、人参、白朮、当归、升麻、柴胡、陈皮、甘草。治中气不足、清阳下陷、子宫下垂、脱肛，以及肢倦气短、气虚发热等。"}]},{"ID":"20240616131325-5b543g1","Type":"NodeParagraph","Properties":{"id":"20240616131325-5b543g1","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"【文献搞录】《大明本草》：「助气，壮筋骨，长肉，补血....血崩，带下。」"}]},{"ID":"20240616131325-tci1dtc","Type":"NodeParagraph","Properties":{"id":"20240616131325-tci1dtc","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"《珍珠囊》：「治虚劳自汗，补肺气....实皮毛，益胃气。」"}]},{"ID":"20240616131325-8owbv1w","Type":"NodeParagraph","Properties":{"id":"20240616131325-8owbv1w","updated":"20240616131325"},"Children":[{"Type":"NodeText","Data":"《本草备要》：「生用固表，无汗能发，有汗能止，温分肉，实腠理泻阴火，解肌热，炙用补中益元气，温三焦，壮脾胃排脓内托。」"}]},{"ID":"20240616131823-e18z790","Type":"NodeThematicBreak","Properties":{"id":"20240616131823-e18z790"}},{"ID":"20240616131825-gizlivi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131825-gizlivi","updated":"20240616131837"},"Children":[{"Type":"NodeText","Data":"黄耆《本草述钩元》"}]},{"ID":"20240616131825-pqbrp3d","Type":"NodeParagraph","Properties":{"id":"20240616131825-pqbrp3d","updated":"20240616131839"},"Children":[{"Type":"NodeText","Data":"（一作黄芪）"}]},{"ID":"20240616131825-v1bu2w3","Type":"NodeParagraph","Properties":{"id":"20240616131825-v1bu2w3","updated":"20240616131841"},"Children":[{"Type":"NodeText","Data":"本出蜀郡、汉中，今惟白水、原州、华原山谷者最胜，宜宁二州者亦佳。八月采根，长二三尺，紧实若箭干，皮色黄褐，折之柔韧如绵，肉理中黄外白，嚼之甘美可口。若坚脆味苦者，即苜蓿根也，勿误用。（别说出绵上者为良，盖以地产言也。若以柔韧为绵，则伪者亦柔韧，但当以坚脆而味苦者为别耳。）木耆草形类真相似，只是生时叶短根黄耳。（之颐）"}]},{"ID":"20240616131825-to9mpz4","Type":"NodeParagraph","Properties":{"id":"20240616131825-to9mpz4","updated":"20240616131843"},"Children":[{"Type":"NodeText","Data":"味甘，气微温。气厚于味，可升可降，阴中阳也。入手足太阴气分，又入手少阳、足少阴命门，兼入手阳明经。茯苓为之使。恶龟甲、白藓皮。甘温纯阳，主益肺气，温分肉，实皮毛间腠理虚，大补表之元气虚弱。通和阳气，利阴气，泄火邪。能活血脉生血，助胃气。（治脾胃虚弱，脉弦，血脉不行，羸瘦腹痛。）益三焦元阳，补五脏诸虚不足，丈夫虚损羸瘦，短气虚喘，肾衰耳聋，泻久肠风，老人气虚肠閟。更治虚烦肌热，虚劳自汗盗汗。若表虚有邪，发汗不出，服之自汗。并内托阴疽，排脓止痛，长肉生肌，为疮家圣药。又治女子月候不匀，血崩带下，胎前产后气耗血虚。疗小儿百病。方书治消瘅，中风著痹挛痿，鹤膝风，脚气。吐血咳血，鼻衄溲血诸见血证。黄疸水肿，伤暑疟头痛心痛胃脘痛腹痛腰痛，身重颤振眩晕，惊悸痞厥恶寒，往来寒热，发热，破伤风不能食，滞下。赤白浊淋，小便不通，遗精，疝。黄耆独茎丛生，作叶扶疏。百本戴在首，如卫气出目行头。（卫出下焦，其行始于睛明穴。）自上而下，从外而内，百骸百脉，咸卫外而固矣。其行可久可速，能知卫气出入之道路，便能了知黄耆之功用矣。（卢不远）补三焦，实卫气，与桂同功。特比桂甘平，不辛热为异耳。盖桂则通血脉，能破血而实卫气，芪则益气也。（东垣）　其治气虚盗汗，并自汗及肤痛，是皮表之药；治咯血柔脾胃，是中州之药；治伤寒尺脉不至，补肾脏元气，是里药。乃上中下内外三焦之药也。（好古）　参耆俱益虚损，但人参惟补元气调中，黄耆兼补卫气实表。如共剂而用，须别主辅。凡内伤脾胃，发热恶寒，怠惰嗜卧，呕吐泄泻，及胀满痞塞，形羸力乏，脉微神短，参为君，芪为臣；若表虚而自汗盗汗，渐至亡阳，诸溃疡多耗脓血，婴儿痘疹未灌全浆，一切阴毒不起之疾，治之又须实卫护营，当以耆为君，参为臣。（嘉谟）　防风能制黄耆，黄耆得防风，其功愈大，（助真气以周于身，亦有治风之功。）乃相畏而相使也。唐柳太后病风不能言，脉沉口噤，许允宗制黄耆防风汤数斛，于床下蒸之，药入腠理，周时而瘥。凡小儿脾胃伏火，劳役不足而成慢惊，当于心经中，以甘温补土之源，更于脾土中，以甘寒泻火，以酸凉补金，使金旺火衰，风木自平，用黄耆汤。炙黄耆二钱，人参一钱，炙草五分，白芍五分，水一大盏，煎半盏，温服。在补中益气汤，甘温能除大热，为治劳倦发热之要剂。同生熟地黄芩连柏当归，加枣仁炒研，为治阴虚盗汗之正法。本方去三黄，加人参、五味、枣仁，治表虚自汗。同桂枝、白芍、防风、炙草，能实表，治表虚畏风，伤风自汗。与茅术、生地等分，黄柏、牛膝减半，作丸，治积年湿毒臁疮，百药不效。同白芷、白芨、甘草、银花、皂角刺，排脓止痛。同人参、甘草，为除躁热肌热之圣药，又治天行痘疮阳虚无热证。"}]},{"ID":"20240616131825-izwwsgz","Type":"NodeParagraph","Properties":{"id":"20240616131825-izwwsgz","updated":"20240617115323"},"Children":[{"Type":"NodeText","Data":"〔附方〕小便不通。绵耆二钱，水二盏，煎一盏，温服，小儿减半。气虚白浊。黄耆盐炒五钱，茯苓一两，为末。每服一钱，白汤下。老人閟塞。绵耆五钱，陈皮去白五钱，为末。每服三钱，用大麻子一合研烂，以水滤浆，煎至乳起，入白蜜一匙，再煎沸，调药。空心服，甚者不过二服。此药不冷不热，常服无閟塞之患。肠风泻血。黄耆、黄连，等分为末，面糊丸绿豆大。每服三十丸，米饮下。咳嗽脓血咽干，乃虚中有热，不可服凉药。以好黄耆四两，甘草一两，为末。每服二钱，点汤服。胎动不安，腹痛，下黄汁。黄耆、川芎各一两，糯米一合，水一升，煎半升，分服。"}]},{"ID":"20240616131825-4az582j","Type":"NodeParagraph","Properties":{"id":"20240616131825-4az582j","updated":"20240616131848"},"Children":[{"Type":"NodeText","Data":"〔论〕黄耆甘温，禀中土之气味。花至七月开，而根以八月采。中黄外白，是由脾胃以至于肺，为是物之功用，其入手足太阴气分宜矣。乃以为更入三焦命门者，原其所自始也。其言益卫气，又曰益胃气者，原其生化之地也。《经》曰：人受气于谷，谷入于胃，以传于肺，五脏六腑，皆以受气。又曰：肺气从太阴而行之，其行也，以息往来。又曰：宗气积于胸中，出于喉咙，以贯心脉而行呼吸。然则胃为后天生气之原，而脏腑之所以受气者，皆统于主气之肺。肺之所以主气者，本于息之往来。而其所由以息往来，又本于水火升降贯心脉而行呼吸也。肺司卫气之行，而其气更原于肾。《经》曰：卫气昼行于阳，夜行于阴。尝从足少阴之分间，行于五脏六腑。（卫出下焦，乃足太阳膀胱。膀胱属肾，而肺之以息往来者，又根于肾。）又曰：少阳（三焦也。）属肾，肾上连肺。是则卫气之布，皆司于肺者，岂不合于三焦之气，而本于肾中之命门乎？夫三焦为元气之别使，《经》尝言之。然非主气之肺统之，则无以神三焦为使之气化，俾气之自下而上者，复自上而下，自内而外者，复自外而内。《经》固谓三焦属肾，肾上连肺也。是则黄耆之补气，原合胃与三焦，以为周身之利益矣。第阳气卫外而为固，而洁古乃推其化血生血岂卫外之阳反能生阴哉？不知云雾不精，则白露不降。惟分肉腠理之间，可以征元气之充与否。若分肉腠理一有不充，即是膻中之气化不足，而云雾不精也。真阳不充，则阴气何以滋？阴气不滋，而阳气何以四布乎？试就其益卫而即能生血者参之，可知血固液所化，液即气所化也。（《经》曰；三焦出气以温肌肉，充皮肤，为其津，其流而不行者为液。又曰：卫气先行皮肤，先充络脉，络脉先盛，故卫气已平，营气乃满，而经脉乃大盛，经脉盛则并纳于卫任而为海。）营气之化，根于卫气之充。不可识耆之益表气，通阳和，即以滋营而和经，俾藏于卫任，达之命门，以归元阳而疗诸虚乎？（世止言黄耆补气，讵知化血生血，乃所以竟其气之用耳。即东垣所云泻阴火，是指内伤阳气下陷而为虚热，非阴分相火之火也，亦是由气化血之义。然则用耆不可但执补气之说，而必究其功用之精微矣。）试更以阴生阳，阳化阴，分合之义言之，《经》曰：水火者，阴阳之征兆也。金木者，生成之终始也。是则合肾与脾以上于肺者，肝也，合心与胃以至于肝者，肺也。肝得乎水中之火，故为阴中之少阳而主升。如水不足，是本先拨也，即水中之火郁亦病乎升之机而气病者也。肺得乎火中之水，故为阳中之少阴而主降。如火不足，是本先拨也，即火中之水郁亦病乎降之机而气病者也。若脾固以水为体，以火为用，坎中之离，借风木以上交。故脾能化气于上，而胃为表以达之。胃则以火为体，以水为用，离中之坎，借燥金以下交。故胃能化血以下，而脾为里以统之。夫肝挟肾与脾以至于肺者，因肺为肾之母也。肺挟心与胃以至于肝者，因肝为心之母也。若脾与胃，执升降之枢，以为子母之权舆者也。故上而至天，下而际地焉。黄耆之功，正有体立而用以行者。盖阳中太阳合于阳中之少阴，使阳得化阴而随阴以降，此其所以自上而下自外而内也。知此则《别录》益气，更曰利阴气，甄权所主虚喘肾衰耳聋，皆可明其功矣。总之，黄耆补肺而利阴，不治阳有余而阴不足之病，乃治阳不足而阴亦不利之病。观方书所治，固主益气，然于血分多有功，津液汗溺为病，需之不少。则以肺阳裕而阴生，肺阴降而阳随，为自上而下自外而内之权舆焉？又《本经》首主痈疽，久败疮，排脓止痛，此由气及血，以至于分肉也。至大风癞疾，并妇人子脏风邪，皆缘阴气虚以为风也。他如逐五脏间恶血，破症癖瘰疬瘿赘，治肠风血崩带下，其由阳及阴之功，种种明著矣。人身天气，由化而生。（与地气由生而化者不同。）如肺阴下降而生血，其絪緼变化之地在膻中。（膻中固肺所治。）中焦之营血，此为橐籥。能使胃阳不亢，而气得下行者，非肺之力欤？知肺之力，则知耆之功用矣。抑《经》曰卫出下焦，然则黄耆益卫气，其自上而下者，必先自下而上也。其自外而内者，必先自内而外也。洁古谓耆为足太阳发表药，缘卫气由足太阳而达之天表也。试参虚损有膀胱热而尿血不止者，入黄耆于蒲黄丸中以补下焦之卫，而后清热如地麦辈，始得奏功。盖不止用耆以补虚，固藉其升阳以达表，然后水腑之热可除也。明于阳气下陷之义，则知阳不得正其治于上，阴即不能顺其化于下矣。"}]},{"ID":"20240616131825-8pktkh8","Type":"NodeParagraph","Properties":{"id":"20240616131825-8pktkh8","updated":"20240616131851"},"Children":[{"Type":"NodeText","Data":"缪氏曰：凡气实内塞，胸膈闭闷，肠胃有积滞，及多怒肝气不和者，勿服。其阳盛阴虚，或上焦热甚、下焦虚寒者，忌之。痘疮血分热甚者，禁用。"}]},{"ID":"20240616131825-h6mn7r4","Type":"NodeParagraph","Properties":{"id":"20240616131825-h6mn7r4","updated":"20240616131825"},"Children":[{"Type":"NodeText","Data":"〔修治〕去头，刮皮。治痈疽，生用；治肺气虚，蜜炙用；治下虚，盐水或蒸或炒用。"}]},{"ID":"20240616131926-i8rn1rj","Type":"NodeThematicBreak","Properties":{"id":"20240616131926-i8rn1rj"}},{"ID":"20240616131927-b81n276","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616131927-b81n276","updated":"20240616131942"},"Children":[{"Type":"NodeText","Data":"黄耆《证类本草》"}]},{"ID":"20240616131927-toz6sv3","Type":"NodeParagraph","Properties":{"id":"20240616131927-toz6sv3","updated":"20240616131947"},"Children":[{"Type":"NodeText","Data":"味甘，微温。无毒。主痈疽久败疮，排脓止痛，大风癞疾，五痔鼠 ，补虚，小儿百病，妇人子脏风邪气，逐五脏间恶血，补丈夫虚损，五劳羸瘦，止渴，腹痛，泄痢，益气，利阴气。生白水者冷，补。其茎叶疗渴，及筋挛，痈肿疽疮。一名戴糁，一名戴椹，一名独椹，一名芰草，一名蜀脂，一名百本。生蜀郡山谷、白水、汉中，二月、十月采，阴干。"}]},{"ID":"20240616131927-wamrl0y","Type":"NodeParagraph","Properties":{"id":"20240616131927-wamrl0y","updated":"20240616131949"},"Children":[{"Type":"NodeText","Data":"（恶龟甲。）"}]},{"ID":"20240616131927-4cqzjy7","Type":"NodeParagraph","Properties":{"id":"20240616131927-4cqzjy7","updated":"20240616131951"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶第一出陇西叨阳，色黄白，甜美，今亦难得。次用黑水宕昌者，色白，肌肤粗，新者，亦甘，温，补。又有蚕陵白水者，色理胜蜀中者而冷补。又有赤色者，可作膏贴用，消痈肿，俗方多用，道家不须。唐本注云∶此物叶似羊齿，或如蒺藜。独茎，或作丛生。"}]},{"ID":"20240616131927-yismkhg","Type":"NodeParagraph","Properties":{"id":"20240616131927-yismkhg","updated":"20240616131953"},"Children":[{"Type":"NodeText","Data":"今出原州及华原者最良，蜀汉不复采用之。臣禹锡等谨按蜀本图经云∶叶似羊齿草，独茎，枝扶疏，紫花，根如甘草，皮黄肉白，长二、三尺许。今原州者好，宜州、宁州亦佳。药性论云∶黄 ，一名王孙。治发背，内补，主虚喘，肾衰，耳聋，疗寒热。生陇西者下，补五脏。蜀白水赤皮者，微寒，此治客热用之。萧炳云∶出原州华原谷子山，花黄。日华子云∶黄 ，恶白藓皮。助气壮筋骨，长肉，补血，破症癖，瘰 瘿赘，肠风，血崩，带下，赤白痢，产前后一切病，月候不匀，消渴，痰嗽，并治头风，热毒赤目等。药中补益，呼为羊肉。又云白水 ，凉，无毒。排脓，治血及烦闷热毒，骨蒸劳。功次黄 。赤水 ，凉，无毒。治血，退热毒，余功用并同上。木 ，凉，无毒。治烦，排脓。力微于黄 ，遇阙即倍用之。"}]},{"ID":"20240616131927-cic9pcd","Type":"NodeParagraph","Properties":{"id":"20240616131927-cic9pcd","updated":"20240617115318"},"Children":[{"Type":"NodeText","Data":"图经曰∶黄 ，生蜀郡山谷、白水、汉中，今河东、陕西州郡多有之。根长二、三尺以来。独茎，作丛生，枝秆去地二、三寸。其叶扶疏作羊齿状，又如蒺藜苗。七月中开黄紫花，其实作荚子，长寸许。八月中采根用。其皮折之如绵，谓之绵黄 。然有数种∶有白水 、有赤水 、有木 ，功用并同，而力不及白水 。木 短而理横。今人多以苜蓿根假作黄 ，折皮亦似绵，颇能乱真。但苜蓿根坚而脆，黄 至柔韧，皮微黄褐色，肉中白色，此为异耳。唐·许裔宗初仕陈为新蔡王外兵参军时，柳太后感风不能言，脉沉而口噤。裔宗曰∶既不能下药，宜汤气熏之，药入腠理，周时可瘥。乃造黄防风汤数斛，置于床下，气如烟雾，其夕便得语。药力熏蒸，其效如此，因附着之。使善医者，知所取法焉。"}]},{"ID":"20240616131927-vnkgcd6","Type":"NodeParagraph","Properties":{"id":"20240616131927-vnkgcd6","updated":"20240616131957"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用木 ，草真相似，只是生时叶短并根横。先须去头上皱皮了，蒸半日，出后，用手擘令细，于槐砧上锉用。圣惠方∶治肺壅得吐。以黄 二两，杵为细末。每服三钱，水一中盏，煎至六分，温服，日三、四服。又方∶治缓疽。以一两杵散，不计时候，温水调下二钱匕。外台秘要∶主甲疽疮，肿烂生脚指甲边，赤肉出，时瘥时发者。以黄 二两， 茹三两，苦酒浸一宿，以猪脂五合，微火上煎取三合，绞去滓，以封疮上，日三、两度，其肉即消。肘后方∶治酒疸，心懊痛，足胫满，小便黄，饮酒发赤黑黄斑，由大醉当风，入水所致。"}]},{"ID":"20240616131927-ovedlma","Type":"NodeParagraph","Properties":{"id":"20240616131927-ovedlma","updated":"20240616131959"},"Children":[{"Type":"NodeText","Data":"黄二两，木兰一两，为末。酒服方寸匕，日三服。梅师方∶补肺排脓。以黄 六两，锉碎，以水三升，煎取一升，去滓服。初虞世治陷甲生入肉，常有血，疼痛。黄 、当归等分为末，贴疮上。若有恶肉，更研少硫黄末同贴。孙用和∶治肠风泻血。黄 、黄连等分，右为末，面糊丸如绿豆大。每服三十丸，米饮下。席延赏∶治虚中有热，咳嗽脓血，口舌咽干，又不可服凉药。好黄 四两，甘草一两，为末。每服三钱，如茶点、羹、粥中亦可服。别说云∶谨按黄本出绵上为良，故名绵黄 。今《图经》所绘宪水者即绵上，地相邻尔。若以谓柔韧如绵，即谓之绵黄 ，然黄 本皆柔韧，若伪者，但以干脆为别尔。"}]},{"ID":"20240616131927-5gdgjhj","Type":"NodeParagraph","Properties":{"id":"20240616131927-5gdgjhj","updated":"20240616131927"},"Children":[{"Type":"NodeText","Data":"衍义曰∶防风、黄 ，世多相须而用。唐许嗣（嗣本羊晋切，犯庙讳，今改为嗣）宗为新蔡王外兵参军，王太后病风，不能言，脉沉难对，医告术穷。嗣宗曰∶饵液不可进。即以黄 、防风煮汤数十斛，置床下，气如雾重薄之，是夕语。"}]},{"ID":"20240607123121-r8zzia8","Type":"NodeThematicBreak","Properties":{"id":"20240607123121-r8zzia8"}},{"ID":"20240607123122-l0oo0v1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123122-l0oo0v1","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"《中国药典》：黄芪"}]},{"ID":"20240607123122-ouajdwi","Type":"NodeParagraph","Properties":{"id":"20240607123122-ouajdwi","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123122-bedsuxo","Type":"NodeParagraph","Properties":{"id":"20240607123122-bedsuxo","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qí"}]},{"ID":"20240607123122-glxrasn","Type":"NodeParagraph","Properties":{"id":"20240607123122-glxrasn","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123122-ia1m9p6","Type":"NodeParagraph","Properties":{"id":"20240607123122-ia1m9p6","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" RADIX ASTRAGALI"}]},{"ID":"20240607123122-kvfmyae","Type":"NodeParagraph","Properties":{"id":"20240607123122-kvfmyae","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123122-c5nunf4","Type":"NodeParagraph","Properties":{"id":"20240607123122-c5nunf4","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 本品为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒙古黄芪"},{"Type":"NodeText","Data":"Astragalus membranaceus （Fisch.） Bge. var. mongholicus （Bge.）Hsiao 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"膜荚黄芪"},{"Type":"NodeText","Data":"Astragalus membranaceus （Fisch.） Bge.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干燥根"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去须根及根头，晒干。"}]},{"ID":"20240607123122-x7t4eno","Type":"NodeParagraph","Properties":{"id":"20240607123122-x7t4eno","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123122-8hutkpz","Type":"NodeParagraph","Properties":{"id":"20240607123122-8hutkpz","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 本品呈圆柱形，有的有分枝，上端较粗，长30～90cm，直径1～3.5cm。表面淡棕黄色或淡棕褐色，有不整齐的纵皱纹或纵沟。质硬而韧，不易折断，断面纤维性强，并显粉性，皮部黄白色，木部淡黄色，有放射状纹理及裂隙，老根中心偶有枯朽状，黑褐色或呈空洞。气微，味微甜，嚼之微有豆腥味。"}]},{"ID":"20240607123122-yywkn69","Type":"NodeParagraph","Properties":{"id":"20240607123122-yywkn69","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607123122-0xr7jym","Type":"NodeParagraph","Properties":{"id":"20240607123122-0xr7jym","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮，防蛀。"}]},{"ID":"20240607123122-hp4ni72","Type":"NodeParagraph","Properties":{"id":"20240607123122-hp4ni72","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123122-roq50at","Type":"NodeParagraph","Properties":{"id":"20240607123122-roq50at","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 除去杂质，大小分开，洗净，润透，切厚片，干燥。"}]},{"ID":"20240607123122-itx2pr4","Type":"NodeParagraph","Properties":{"id":"20240607123122-itx2pr4","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"蜜黄芪：取黄芪片，照蜜炙法（附录Ⅱ D）炒至不粘手。"}]},{"ID":"20240607123122-6heqvho","Type":"NodeParagraph","Properties":{"id":"20240607123122-6heqvho","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607123122-cxa46od","Type":"NodeParagraph","Properties":{"id":"20240607123122-cxa46od","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：木栓细胞多列。栓内层为3～5列厚角细胞。韧皮部射线外侧常弯曲，有裂隙；纤维成束，壁厚，木化或微木化，与筛管群交互排列；近栓内层处有时可见石细胞。形成层成环。木质部导管单个散在或2～3个相聚；导管间有木纤维；射线中有时可见单个或2～4个成群的石细胞。薄壁细胞含淀粉粒。粉末黄白色。纤维成束或散离，直径8～30μm，壁厚，表面有纵裂纹，初生壁常与次生壁分离，两端常断裂成须状，或较平截。具缘纹孔导管无色或橙黄色，具缘纹孔排列紧密。石细胞少见，圆形、长圆形或形状不规则，壁较厚。"}]},{"ID":"20240607123122-8x4qat3","Type":"NodeParagraph","Properties":{"id":"20240607123122-8x4qat3","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末3g，加甲醇20ml，加热回流1 小时，滤过，滤液加于中性氧化铝柱（100～120目，5g，内径10～15mm）上，用40％甲醇100ml 洗脱，收集洗脱液，蒸干，残渣加水30ml使溶解，用水饱和的正丁醇提取2 次，每次20ml，合并正丁醇液；用水洗涤2 次，每次20ml；弃去水液，正丁醇液蒸干，残渣加甲醇0.5ml 使溶解，作为供试品溶液。另取黄芪甲苷对照品，加甲醇制成每1ml含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一硅胶Ｇ薄层板上，以氯仿－甲醇－水（13:7:2）的下层溶液为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在105℃ 加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，日光下显相同的棕褐色斑点，紫外光灯（365nm） 下显相同的橙黄色荧光斑点。"}]},{"ID":"20240607123122-hsdy09r","Type":"NodeParagraph","Properties":{"id":"20240607123122-hsdy09r","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607123122-49hamxu","Type":"NodeParagraph","Properties":{"id":"20240607123122-49hamxu","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 取本品粗粉约1.5g[同时另取本品粗粉测定水分（附录Ⅸ H第一法）]，精密称定，置索氏提取器中，加甲醇40ml，冷浸过夜，再加甲醇适量，回流4 小时，提取液回收甲醇并浓缩至干，残渣加水10ml，微热使溶解，用水饱和的正丁醇振摇提取3次，每次20ml，合并正丁醇提取液，用氨试液提取2 次，每次20ml，弃去氨液，正丁醇液蒸干，残渣加水3～5ml使溶解，放冷，通过Ｄ101 型大孔吸附树脂柱 （内径1.5cm,长12cm）,以水50ml洗脱，弃去水液，再用40％乙醇30ml洗脱，弃去40％乙醇洗脱液，继用70％乙醇50ml洗脱，收集洗脱液，蒸干，用甲醇溶解并转移至2ml 量瓶内，加甲醇至刻度，摇匀，作为供试品溶液。另精密称取黄芪甲苷对照品，加甲醇制成每1ml 含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，精密吸取供试品溶液2μl与6μl、对照品溶液2μl与4μl，分别交叉点于同一硅胶Ｇ薄层板上，以氯仿－甲醇－水（13:6:2）10℃以下放置过夜的下层溶液为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在100℃加热至斑点显色清晰，取出，在薄层板上覆盖同样大小的玻璃板，周围用胶布固定，照薄层色谱法（附录Ⅵ B薄层扫描法）进行扫描，波长：λs=530nm,λR=700nm,测量供试品吸收度积分值与对照品吸收度积分值，计算，即得。"}]},{"ID":"20240607123122-pes1yam","Type":"NodeParagraph","Properties":{"id":"20240607123122-pes1yam","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含黄芪甲苷（C41H68O14）不得少于0.040％。"}]},{"ID":"20240607123122-qhrmgbl","Type":"NodeParagraph","Properties":{"id":"20240607123122-qhrmgbl","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123122-41o6ko6","Type":"NodeParagraph","Properties":{"id":"20240607123122-41o6ko6","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 归肺、脾经。"}]},{"ID":"20240607123122-cqi0rvo","Type":"NodeParagraph","Properties":{"id":"20240607123122-cqi0rvo","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123122-712r6b2","Type":"NodeParagraph","Properties":{"id":"20240607123122-712r6b2","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240607123122-4mc7hwq","Type":"NodeParagraph","Properties":{"id":"20240607123122-4mc7hwq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123122-9q713vf","Type":"NodeParagraph","Properties":{"id":"20240607123122-9q713vf","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 补气固表，利尿托毒，排脓，敛疮生肌。用于气虚乏力，食少便溏，中气下陷，久泻脱肛，便血崩漏，表虚自汗，气虚水肿，痈疽难溃，久溃不敛，血虚痿黄，内热消渴；慢性肾炎蛋白尿，糖尿病。"}]},{"ID":"20240607123122-shx4qv2","Type":"NodeParagraph","Properties":{"id":"20240607123122-shx4qv2","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123122-bqjh63j","Type":"NodeParagraph","Properties":{"id":"20240607123122-bqjh63j","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 9～30g。"}]},{"ID":"20240607123122-8m5qk4a","Type":"NodeParagraph","Properties":{"id":"20240607123122-8m5qk4a","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123122-fb41fpt","Type":"NodeParagraph","Properties":{"id":"20240607123122-fb41fpt","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607123122-5ixtbst","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123122-5ixtbst","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：黄芪"}]},{"ID":"20240607123122-5ohpp5t","Type":"NodeParagraph","Properties":{"id":"20240607123122-5ohpp5t","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123122-0l22pj3","Type":"NodeParagraph","Properties":{"id":"20240607123122-0l22pj3","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qí"}]},{"ID":"20240607123122-kg57kf8","Type":"NodeParagraph","Properties":{"id":"20240607123122-kg57kf8","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123122-gk5m05k","Type":"NodeParagraph","Properties":{"id":"20240607123122-gk5m05k","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 绵芪、绵黄芪"}]},{"ID":"20240607123122-bllaxaj","Type":"NodeParagraph","Properties":{"id":"20240607123122-bllaxaj","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123122-h3jrjo7","Type":"NodeParagraph","Properties":{"id":"20240607123122-h3jrjo7","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 为豆科黄芪属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"膜荚黄芪"},{"Type":"NodeText","Data":"Astragalus membranaceus （Fisch.） Bunge 及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内蒙古黄芪"},{"Type":"NodeText","Data":"A. mongholicus Bunge的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。野生品秋季挖根；栽培品播种后4～5年春季萌芽前或秋季落叶后采挖，除去茎苗及须根，晒干。"}]},{"ID":"20240607123122-2pkmftg","Type":"NodeParagraph","Properties":{"id":"20240607123122-2pkmftg","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123122-th86dyd","Type":"NodeParagraph","Properties":{"id":"20240607123122-th86dyd","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1.膜荚黄芪：生于山坡灌丛及旱坡砂质壤土地区。分布于黑龙江、吉林、辽宁、河北、山西、内蒙古、陕西、甘肃、宁夏、青海、山东、四川和西藏等省区。"}]},{"ID":"20240607123122-0qw286u","Type":"NodeParagraph","Properties":{"id":"20240607123122-0qw286u","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2.内蒙古黄芪：生于山野。分布于黑龙江、吉林、内蒙古、河北、山西和西藏等省区。"}]},{"ID":"20240607123122-r4n7j3v","Type":"NodeParagraph","Properties":{"id":"20240607123122-r4n7j3v","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123122-z6exx4m","Type":"NodeParagraph","Properties":{"id":"20240607123122-z6exx4m","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1.膜荚黄芪（卜奎芪、口芪）多年生草本，高0.5～1.5米。根直而长，圆柱形，稍带木质，长20～50厘米，根头部径1.5～3厘米，表明淡棕黄色至深棕色。茎直立，具分枝，被长柔毛。单数羽状复叶互生，叶柄基部有披针形托叶，叶轴被毛；小叶13～31片，卵状披针形或椭圆形，长0.8～3厘米，先端稍钝，有短尖，基部楔形，全缘，两面被有白色长柔毛，无小叶柄。夏季叶腋抽出总状花序，较叶稍长；花萼5浅裂，筒状；蝶形花冠淡黄色，长约1.6厘米，旗瓣三角状倒卵形，翼瓣和龙骨瓣均有柄状长爪。荚果膜质，膨胀，卵状长圆形，长2厘米余，先端有喙，被黑色短柔毛。种子5～6粒，肾形，棕褐色。"}]},{"ID":"20240607123122-tguyk8r","Type":"NodeParagraph","Properties":{"id":"20240607123122-tguyk8r","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2.内蒙古黄芪（红蓝芪、白皮芪） 形似上种，惟其托叶呈三角状卵形，小叶较多，25～37片，小叶片短小而宽，呈椭圆形。花冠黄色，长不及2厘米。荚果无毛，有显著网纹。"}]},{"ID":"20240607123122-njbx30y","Type":"NodeParagraph","Properties":{"id":"20240607123122-njbx30y","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607123122-xhoqwoz","Type":"NodeParagraph","Properties":{"id":"20240607123122-xhoqwoz","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 适应性强，南北各地均可栽培，以土层深厚、排水良好的砂质壤土及石灰质壤土生长较好。种子繁殖，北方，春季4～5月或秋季9～10月播种，条播，行距1尺，开浅沟，深约1寸，将种子均匀撒播沟内，覆土半寸左右，每亩播种量2～3斤，播种后注意浇水保湿，约2～3周出苗；秋播者需至第二年春季出苗，出苗后，生有4～6片叶时，间苗，株距4～6寸。若采用穴播，每穴可播种5～7粒。生长期间可追肥1～2次；秋季注意排水以预防白粉病及根腐病发生，如发现后则可喷洒0.3波美度石硫合剂防治。"}]},{"ID":"20240607123122-fuy82z4","Type":"NodeParagraph","Properties":{"id":"20240607123122-fuy82z4","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123122-mjs8c4x","Type":"NodeParagraph","Properties":{"id":"20240607123122-mjs8c4x","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1.膜荚黄芪根含2’,4’二羟基-5，6-二甲氧基异黄酮（2’,4’-dihydroxy-5,6-dimethoxyisoflavone）、胆碱（choline）、甜菜碱（betaine）、氨基酸、蔗糖、葡萄糖醛酸及微量的叶酸。"}]},{"ID":"20240607123122-dso0mqt","Type":"NodeParagraph","Properties":{"id":"20240607123122-dso0mqt","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2.内蒙古黄芪根含β-谷甾醇、亚油酸及亚麻酸。"}]},{"ID":"20240607123122-3vhaujr","Type":"NodeParagraph","Properties":{"id":"20240607123122-3vhaujr","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607123122-papxges","Type":"NodeParagraph","Properties":{"id":"20240607123122-papxges","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1、正常大鼠饲以含黄芪粉末的事务1周后，测其耗氧量比服药前逐渐增加。"}]},{"ID":"20240607123122-9xh2uvq","Type":"NodeParagraph","Properties":{"id":"20240607123122-9xh2uvq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2、能加强正常心脏收缩，对衰竭的心脏有强心作用。"}]},{"ID":"20240607123122-tzamcr3","Type":"NodeParagraph","Properties":{"id":"20240607123122-tzamcr3","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"3、本品能使管状血管和肾脏血管扩张，并使全身末梢血管扩张，皮肤循环畅盛，使高血压患者血压下降。"}]},{"ID":"20240607123122-kb2mq5q","Type":"NodeParagraph","Properties":{"id":"20240607123122-kb2mq5q","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"4、实验者在自己身上进行了利尿试验，证明黄芪有中等的利尿作用。"}]},{"ID":"20240607123122-rycqgfr","Type":"NodeParagraph","Properties":{"id":"20240607123122-rycqgfr","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"5、黄芪磨成粉末加入饲料给大白鼠喂服3日，有阻抑实验性肾炎的作用。"}]},{"ID":"20240607123122-4160fsp","Type":"NodeParagraph","Properties":{"id":"20240607123122-4160fsp","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"6、黄芪对小白鼠有镇静作用，能维持数小时。"}]},{"ID":"20240607123122-kss9tjn","Type":"NodeParagraph","Properties":{"id":"20240607123122-kss9tjn","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"7、家兔口服黄芪，可使血糖明显下降。"}]},{"ID":"20240607123122-0acs2hq","Type":"NodeParagraph","Properties":{"id":"20240607123122-0acs2hq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"8、对大白鼠离体子宫具有兴奋收缩作用。"}]},{"ID":"20240607123122-pgfskrm","Type":"NodeParagraph","Properties":{"id":"20240607123122-pgfskrm","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"9、抑菌试验：本品在体外对志贺氏痢疾杆菌、炭疽杆菌、甲型溶血性链球菌、乙型溶血性链球菌、白喉杆菌、假白喉杆菌、肺炎双球菌、金黄色葡萄球菌、柠檬色葡萄球菌、枯草杆菌等均有抑制作用。"}]},{"ID":"20240607123122-wf7r5yy","Type":"NodeParagraph","Properties":{"id":"20240607123122-wf7r5yy","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123122-ap5a06p","Type":"NodeParagraph","Properties":{"id":"20240607123122-ap5a06p","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜黄芪"},{"Type":"NodeText","Data":"：将黄芪片加炼熟的蜂蜜与少许开水，拌匀稍闷，放锅内炒至黄色并不粘手时，取出晾凉（每100斤用炼熟的蜂蜜25斤）。"}]},{"ID":"20240607123122-hmpyav0","Type":"NodeParagraph","Properties":{"id":"20240607123122-hmpyav0","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123122-jzkjbif","Type":"NodeParagraph","Properties":{"id":"20240607123122-jzkjbif","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 甘，微温。"}]},{"ID":"20240607123122-9uzlcyq","Type":"NodeParagraph","Properties":{"id":"20240607123122-9uzlcyq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123122-nc863pu","Type":"NodeParagraph","Properties":{"id":"20240607123122-nc863pu","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 补气固表，托疮生肌。主治体虚自汗，久泻，脱肛，子宫脱垂，慢性肾炎，体虚浮肿，慢性溃疡，疮口久不愈合。"}]},{"ID":"20240607123122-7chjuuc","Type":"NodeParagraph","Properties":{"id":"20240607123122-7chjuuc","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123122-lb291or","Type":"NodeParagraph","Properties":{"id":"20240607123122-lb291or","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 3～5钱，大量可用至1～2两。"}]},{"ID":"20240607123122-idd3b9k","Type":"NodeParagraph","Properties":{"id":"20240607123122-idd3b9k","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123122-bowq77h","Type":"NodeParagraph","Properties":{"id":"20240607123122-bowq77h","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1、体虚自汗：（玉屏风散）黄芪5钱，白术3钱，防风2钱。水煎服。"}]},{"ID":"20240607123122-4dsmpcb","Type":"NodeParagraph","Properties":{"id":"20240607123122-4dsmpcb","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2、脾胃虚弱以及气虚下陷引起的胃下垂，肾下垂，子宫脱垂，脱肛：（补中益气汤）黄芪4钱，党参、白术、当归各3钱，炙甘草、陈皮、升麻、柴胡各1.5钱。水煎服。"}]},{"ID":"20240607123122-jly1f4c","Type":"NodeParagraph","Properties":{"id":"20240607123122-jly1f4c","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"3、失血体虚：黄芪1两，当归2钱。水煎服。"}]},{"ID":"20240607123122-x9hkd8d","Type":"NodeParagraph","Properties":{"id":"20240607123122-x9hkd8d","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"4、血小板减少性紫癜：黄芪1两，当归、龙眼肉、五味子各5钱，红枣10枚，黑豆1两。水煎服。"}]},{"ID":"20240607123122-1m7flsj","Type":"NodeParagraph","Properties":{"id":"20240607123122-1m7flsj","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"5、脑血栓：黄芪0.5～1两，川芎2钱，当归、赤芍、地龙、桃仁、牛膝、丹参各3钱。水煎服。"}]},{"ID":"20240607123122-k9ciyo4","Type":"NodeParagraph","Properties":{"id":"20240607123122-k9ciyo4","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"6、白细胞减少症、贫血：生黄芪、鸡血藤各2两，当归1两，党参、熟地黄各5钱。每日1剂，水煎2次，分2次服。孕妇当归减量。"}]},{"ID":"20240607123122-siv458t","Type":"NodeParagraph","Properties":{"id":"20240607123122-siv458t","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"7、乳汁缺乏：黄芪1两，当归5钱，王不留行、路路通、丝瓜络、炮山甲各2钱。水煎服。"}]},{"ID":"20240607123122-etjn5i2","Type":"NodeParagraph","Properties":{"id":"20240607123122-etjn5i2","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"8、各种神经性皮炎：黄芪、党参、山药各5钱，当归、莲子、苡米、荆芥、蛇床子、牛蒡子、地肤子、蝉蜕各4钱，甘草2钱。有感染者加生地黄3钱，黄柏4钱。老人、儿童酌减。水煎服。早晚各服1次，并用热药渣搽患处。"}]},{"ID":"20240607123122-msduf8i","Type":"NodeParagraph","Properties":{"id":"20240607123122-msduf8i","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607123122-oxoh1re","Type":"NodeParagraph","Properties":{"id":"20240607123122-oxoh1re","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1、同属植物中下列数种植物的根在不同地区也作黄芪入药。"}]},{"ID":"20240607123122-x4jlklc","Type":"NodeParagraph","Properties":{"id":"20240607123122-x4jlklc","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（1）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黑毛果黄芪"},{"Type":"NodeText","Data":"（白芪）Astragalus tongolensis Ulbr.，分布于甘肃、青海和四川等省。其根甘肃称白大芪、马芪，青海称土黄芪，亦作黄芪入药。"}]},{"ID":"20240607123122-sh8nyfi","Type":"NodeParagraph","Properties":{"id":"20240607123122-sh8nyfi","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（2）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"金翼黄芪"},{"Type":"NodeText","Data":"Astragalus chrysopterus Bunge，分布于河北、山西、陕西、甘肃、青海、四川等省。其根河北称小黄芪，甘肃南部作小白芪入药。"}]},{"ID":"20240607123122-5kf6ubz","Type":"NodeParagraph","Properties":{"id":"20240607123122-5kf6ubz","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（3）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多花黄芪"},{"Type":"NodeText","Data":"Astragalus floridus Benth.，分布于甘肃南部，四川西部及西藏地区。其根四川作川绵芪或白绵芪入药。"}]},{"ID":"20240607123122-w91po91","Type":"NodeParagraph","Properties":{"id":"20240607123122-w91po91","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（4）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茂汶黄芪"},{"Type":"NodeText","Data":"Astragalus maowenensis Hsiao,mss.产四川茂汶县。"}]},{"ID":"20240607123122-rfjhjom","Type":"NodeParagraph","Properties":{"id":"20240607123122-rfjhjom","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（5）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云南黄芪"},{"Type":"NodeText","Data":"Astragalus yunnanensis Franch.，分布于云南、西藏等地。在西藏部分地区以根作黄芪入药。"}]},{"ID":"20240607123122-3eitgtr","Type":"NodeParagraph","Properties":{"id":"20240607123122-3eitgtr","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"（6）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"梭果黄芪"},{"Type":"NodeText","Data":"Astragalus ernestii Comb.，其根具有膜荚黄芪的利尿降压作用，但强度较弱。四川理塘有以代黄芪用者。"}]},{"ID":"20240607123122-ikuiu5j","Type":"NodeParagraph","Properties":{"id":"20240607123122-ikuiu5j","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2、同科岩黄芪属（Hedysarum）的多种植物，商品称为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红芪"},{"Type":"NodeText","Data":"，有时作黄芪入药。"}]},{"ID":"20240607123122-0ntbmc9","Type":"NodeParagraph","Properties":{"id":"20240607123122-0ntbmc9","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"3、个别地区过去常有将豆科苜蓿属植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苜蓿"},{"Type":"NodeText","Data":"Medicago sativa L.（安徽），草木樨属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"草木樨"},{"Type":"NodeText","Data":"Melilotus suaveolens Ledeb.（东北），"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白香草木樨"},{"Type":"NodeText","Data":"Melilotus albus Desr.（山西），锦鸡儿属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"锦鸡儿"},{"Type":"NodeText","Data":"Caragana sinica （Buchoz） Rehd.（华东），棘豆属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蓝花棘豆"},{"Type":"NodeText","Data":"Oxytropis caerulea （Pall.） DC.（河北、山西），"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小花棘豆"},{"Type":"NodeText","Data":"Oxytropis glabra DC.（青海），野扁豆属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"毛野扁豆"},{"Type":"NodeText","Data":"Dunbaria villosa Makino（河南）和锦葵科锦葵属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"圆叶锦葵"},{"Type":"NodeText","Data":"Malva rotundifolia L.（江苏），蜀葵属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药蜀葵"},{"Type":"NodeText","Data":"Althaea officinalis L.（新疆）等的根称“土黄芪”或直接混称“黄芪”的，应注意鉴别，不要误作黄芪使用。"}]},{"ID":"20240607123122-1ur16fd","Type":"NodeParagraph","Properties":{"id":"20240607123122-1ur16fd","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123122-2ad8u2z","Type":"NodeParagraph","Properties":{"id":"20240607123122-2ad8u2z","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607123122-i98c2ys","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123122-i98c2ys","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：黄芪"}]},{"ID":"20240607123122-6z804gd","Type":"NodeParagraph","Properties":{"id":"20240607123122-6z804gd","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123122-cwiqo11","Type":"NodeParagraph","Properties":{"id":"20240607123122-cwiqo11","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qí"}]},{"ID":"20240607123122-wxrkqfj","Type":"NodeParagraph","Properties":{"id":"20240607123122-wxrkqfj","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123122-rnhh2wc","Type":"NodeParagraph","Properties":{"id":"20240607123122-rnhh2wc","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 绵黄芪"}]},{"ID":"20240607123122-xa1qlim","Type":"NodeParagraph","Properties":{"id":"20240607123122-xa1qlim","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123122-i2k59g2","Type":"NodeParagraph","Properties":{"id":"20240607123122-i2k59g2","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" Radix Astragali"}]},{"ID":"20240607123122-4nxn7ib","Type":"NodeParagraph","Properties":{"id":"20240607123122-4nxn7ib","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123122-09n886e","Type":"NodeParagraph","Properties":{"id":"20240607123122-09n886e","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒙古黄芪"},{"Type":"NodeText","Data":"Astragalus membranaceus Bge. var．mongholicus（Bge.）Hsiao的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋季采挖，除去泥土、须根及根头，晒至六七成干，理直扎捆后晒干。"}]},{"ID":"20240607123122-rqs4jxq","Type":"NodeParagraph","Properties":{"id":"20240607123122-rqs4jxq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123122-dtxfh5u","Type":"NodeParagraph","Properties":{"id":"20240607123122-dtxfh5u","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 生于向阳草地及山坡。主产内蒙古、山西及黑龙江；现广为栽培。"}]},{"ID":"20240607123122-k3d793j","Type":"NodeParagraph","Properties":{"id":"20240607123122-k3d793j","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123122-eyfyuk0","Type":"NodeParagraph","Properties":{"id":"20240607123122-eyfyuk0","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 多年生草本。茎直立，上部有分枝。奇数羽状复叶互生，小叶12～18对；小叶片广椭圆形或椭圆形，下面被柔毛；托叶披针形。总状花序腋生；花萼钟状，密被短柔毛，具5萼齿；花冠黄色，旗瓣长圆状倒卵形，翼瓣及龙骨瓣均有长爪；雄蕊10，二体；子房有长柄。荚果膜质，半卵圆形，无毛。花期6～7月，果期7～9月。"}]},{"ID":"20240607123122-ns0hmen","Type":"NodeParagraph","Properties":{"id":"20240607123122-ns0hmen","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123122-da0t7ge","Type":"NodeParagraph","Properties":{"id":"20240607123122-da0t7ge","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 根圆柱形，有的有分枝，上端较粗，略扭曲，长30～90cm，直径0.7～3.5cm。表面淡棕黄色至淡棕褐色，有不规则纵皱纹及横长皮孔，栓皮易剥落而露出黄白色皮部，有的可见网状纤维束。质坚韧，断面强纤维性。气微，味微甜，有豆腥味。"}]},{"ID":"20240607123122-4m50moi","Type":"NodeParagraph","Properties":{"id":"20240607123122-4m50moi","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123122-i8yjnhv","Type":"NodeParagraph","Properties":{"id":"20240607123122-i8yjnhv","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 含黄酮类成分毛蕊异黄酮（calycosin）、3- 羟基- 9，10- 二甲氧基紫檀烷，还含黄芪皂甙Ⅰ、Ⅴ、Ⅲ（ astragalosideⅠ、Ⅴ、Ⅲ） 。"}]},{"ID":"20240607123122-of8pzi6","Type":"NodeParagraph","Properties":{"id":"20240607123122-of8pzi6","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123122-6dp6bo5","Type":"NodeParagraph","Properties":{"id":"20240607123122-6dp6bo5","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 性温，味甘。"}]},{"ID":"20240607123122-ufl6k45","Type":"NodeParagraph","Properties":{"id":"20240607123122-ufl6k45","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123122-15e30n3","Type":"NodeParagraph","Properties":{"id":"20240607123122-15e30n3","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 补气固表，托毒排脓，利尿，生肌。用于气虚乏力、久泻脱肛、自汗、水肿、子官脱垂、慢性肾炎蛋白尿、糖尿病、疮口久不愈合。"}]},{"ID":"20240607123122-yx9grmt","Type":"NodeParagraph","Properties":{"id":"20240607123122-yx9grmt","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123122-5gf6rml","Type":"NodeParagraph","Properties":{"id":"20240607123122-5gf6rml","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 1、小便不通。用黄芪二钱，加水二碗，煎成一碗，温服。小儿减半。"}]},{"ID":"20240607123122-934henc","Type":"NodeParagraph","Properties":{"id":"20240607123122-934henc","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"2、酒疸黄疾（醉后感寒，身上发赤、黑、黄斑）。用黄芪二两、木兰一两，共研细。每服少许。一天服三次，酒送下。"}]},{"ID":"20240607123122-nmz4fo0","Type":"NodeParagraph","Properties":{"id":"20240607123122-nmz4fo0","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"3、白浊。用盐炒黄芪半两、茯苓一两，共研细。每服一钱。"}]},{"ID":"20240607123122-qqpqrrh","Type":"NodeParagraph","Properties":{"id":"20240607123122-qqpqrrh","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"4、萎黄焦渴（每与痈疽发作，先后伴随）。用黄芪六两，一半生焙，一半加盐水在饭上蒸熟；另用甘草一两，也是一半生用，一半灸黄。二药共研细。每服二钱，一天两次。也可以煎服。此方名“黄芪六一汤”。"}]},{"ID":"20240607123122-i3z9x0j","Type":"NodeParagraph","Properties":{"id":"20240607123122-i3z9x0j","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"5、老人便秘。用黄芪、陈皮各半两，研细。另用大麻子一合，捣烂，加水揉出浆汁，煎至半干，调入白蜜一匙，再煮过，把黄芪、陈皮末加入调匀服下。两服可通便。可以常服。"}]},{"ID":"20240607123122-wgqn46b","Type":"NodeParagraph","Properties":{"id":"20240607123122-wgqn46b","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"6、血淋。用黄芪、黄连，等分为末，加面糊做成丸子，如绿豆大。每服三十丸。"}]},{"ID":"20240607123122-0deshwg","Type":"NodeParagraph","Properties":{"id":"20240607123122-0deshwg","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"7、少淋。用黄芪、人参，等分为末。另用萝卜四、五片，加蜜二两，稍稍灸过后，蘸药末吃下，以盐水送服。"}]},{"ID":"20240607123122-7bph4h0","Type":"NodeParagraph","Properties":{"id":"20240607123122-7bph4h0","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"8、吐血。用黄芪二钱半、紫背浮萍五钱，共研为末。每服一钱，姜蜜水送下。"}]},{"ID":"20240607123122-vg95xax","Type":"NodeParagraph","Properties":{"id":"20240607123122-vg95xax","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"9、咳脓咳血，咽干（这是虚热，不可吃凉药）。用黄芪四两、甘草一两，共研为末。每服二钱，热水送下。"}]},{"ID":"20240607123122-dfvitiq","Type":"NodeParagraph","Properties":{"id":"20240607123122-dfvitiq","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"10、肺痈。用黄芪二两研细，每取二钱煎汤服。一天可服三、四次。"}]},{"ID":"20240607123122-pigzyzn","Type":"NodeParagraph","Properties":{"id":"20240607123122-pigzyzn","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"11、甲疽（趾甲边红肉突出成疽）。用黄芪二两、茹一两，醋浸一宿，加入猪油五合，微火煎成二合。去渣，取脂涂疮上。一天三次。"}]},{"ID":"20240607123122-3ttnxux","Type":"NodeParagraph","Properties":{"id":"20240607123122-3ttnxux","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"12、胎动不安（腹痛，下黄汁）。用黄芪、芎各一两，糯米一合，水一升，一起煮到半到。分次服下。"}]},{"ID":"20240607123122-f6porvi","Type":"NodeParagraph","Properties":{"id":"20240607123122-f6porvi","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"13、阴汗湿痒。用黄芪酒炒后研细，切熟猪心蘸着吃，有效。"}]},{"ID":"20240607123122-akiz4ct","Type":"NodeParagraph","Properties":{"id":"20240607123122-akiz4ct","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123122-pl26z55","Type":"NodeParagraph","Properties":{"id":"20240607123122-pl26z55","updated":"20240607123122"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607123123-6f9od0p","Type":"NodeThematicBreak","Properties":{"id":"20240607123123-6f9od0p"}},{"ID":"20240607123124-0j5p50u","Type":"NodeParagraph","Properties":{"id":"20240607123124-0j5p50u"}}]}