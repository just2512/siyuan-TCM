a":"百部 (26)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百部 26-20240718095119-02j4b52.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 752px;\" parent-style=\"width: 762px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718093026-qhpy99h","Type":"NodeParagraph","Properties":{"id":"20240718093026-qhpy99h","updated":"20240718095326"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 791px;","style":"width: 781px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"百部 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百部 16-20240718093026-x07kk2k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 781px;\" parent-style=\"width: 791px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 449px;","style":"width: 439px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"百部 (28)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百部 28-20240718095326-2wbdgxl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 439px;\" parent-style=\"width: 449px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718092128-e7eso2d","Type":"NodeThematicBreak","Properties":{"id":"20240718092128-e7eso2d"}},{"ID":"20240902115530-s3n8byh","Type":"NodeParagraph","Properties":{"id":"20240902115530-s3n8byh","updated":"20240902115540"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：百部"}]},{"ID":"20240902115530-agwz6qk","Type":"NodeParagraph","Properties":{"id":"20240902115530-agwz6qk","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部《中国药典》"}]},{"ID":"20240902115530-x953g2x","Type":"NodeParagraph","Properties":{"id":"20240902115530-x953g2x","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【拼音名】BǎiBù"}]},{"ID":"20240902115530-ruh38i6","Type":"NodeParagraph","Properties":{"id":"20240902115530-ruh38i6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXSTEMONAE"}]},{"ID":"20240902115530-031h8bn","Type":"NodeParagraph","Properties":{"id":"20240902115530-031h8bn","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【别名】百条根、百部草、闹虱药、药虱药"}]},{"ID":"20240902115530-j2htutd","Type":"NodeParagraph","Properties":{"id":"20240902115530-j2htutd","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【来源】本品为百部科植物直立百部Stemonasessilifolia（Miq.）Miq.、蔓生百部Stemonajaponica（Bl.）Miq.或对叶百部StemonatuberosaLour.的干燥块根。春、秋二季采挖，除去须根，洗净，置沸水中略烫或蒸至无白心，取出，晒干。"}]},{"ID":"20240902115530-r2927jx","Type":"NodeParagraph","Properties":{"id":"20240902115530-r2927jx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902115530-97e0tum","Type":"NodeParagraph","Properties":{"id":"20240902115530-97e0tum","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"直立百部：呈纺锤形，上端较细长，皱缩弯曲，长5～12cm，直径0.5～1cm。表面黄白色或淡棕黄色，有不规则深纵沟，间或有横皱纹。质脆，易折断,断面平坦，角质样，淡黄棕色或黄白色，皮部较宽，中柱扁缩。气微，味甘、苦。"}]},{"ID":"20240902115530-c0abfag","Type":"NodeParagraph","Properties":{"id":"20240902115530-c0abfag","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"蔓生百部：两端稍狭细，表面多不规则皱褶及横皱纹。"}]},{"ID":"20240902115530-re9f0rz","Type":"NodeParagraph","Properties":{"id":"20240902115530-re9f0rz","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"对叶百部：呈长纺锤形或长条形，长8～24cm，直径0.8～2cm。表面浅黄棕色至灰棕色，具浅纵皱纹或不规则纵槽。质坚实，断面黄白色至暗棕色，中柱较大，髓部类白色。"}]},{"ID":"20240902115530-5urepsq","Type":"NodeParagraph","Properties":{"id":"20240902115530-5urepsq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【毒性】服用过量中毒，常引起呼吸中枢麻痹。解救方法应立即给氧或人工呼吸；注射山梗菜碱或尼可刹米等呼吸兴奋剂；静脉滴注葡萄糖盐水等对症治疗。"}]},{"ID":"20240902115530-agxrcb1","Type":"NodeParagraph","Properties":{"id":"20240902115530-agxrcb1","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902115530-zik4kzx","Type":"NodeParagraph","Properties":{"id":"20240902115530-zik4kzx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：直立百部根被为3～4列细胞，壁木栓化及木化，具致密的细条纹。皮层较宽。中柱韧皮部束与木质部束各19～27个，间隔排列，韧皮部束内侧有少数非木化纤维；木质部束导管2～5个，并有木纤维及管胞，导管类多角形，径向直径约至48μｍ，偶有导管深入至髓部。髓部散有少数细小纤维。"}]},{"ID":"20240902115530-3jp23mo","Type":"NodeParagraph","Properties":{"id":"20240902115530-3jp23mo","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"蔓生百部根被为3～6列细胞。韧皮部纤维木化。导管径向直径约至184μm，通常深入至髓部，与外侧导管束作2～3轮状排列。"}]},{"ID":"20240902115530-8k6kv19","Type":"NodeParagraph","Properties":{"id":"20240902115530-8k6kv19","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"对叶百部根被为3列细胞，细胞壁无细条纹，其内层细胞的内壁特厚。皮层外侧散有纤维，类方形，壁微木化。中柱韧皮部束36～40个。木质部束导管圆多角形，直径至107μm，其内侧与木纤维及微木化的薄壁细胞连接成环层。"}]},{"ID":"20240902115530-5d8fdy0","Type":"NodeParagraph","Properties":{"id":"20240902115530-5d8fdy0","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末5g，加70％乙醇50ml，加热回流1小时，滤过，滤液蒸去乙醇，残渣加浓氨试液调节pH值至10～11，再加氯仿5ml振摇提取，分取氯仿层，蒸干，残渣加1％盐酸溶液5ml使溶解，滤过。滤液分作两份：一份中滴加碘化铋钾试液，生成橙红色沉淀；另一份中滴加硅钨酸试液，生成乳白色沉淀。"}]},{"ID":"20240902115530-v6g8ciq","Type":"NodeParagraph","Properties":{"id":"20240902115530-v6g8ciq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902115530-pivorgx","Type":"NodeParagraph","Properties":{"id":"20240902115530-pivorgx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部：除去杂质，洗净，润透，切厚片，干燥。本品呈不规则厚片、或不规则条形斜片；表面灰白色、棕黄色，有深纵皱纹；切面灰白色、淡黄棕色或黄白色，角质样；皮部较厚、中柱扁缩。质韧软。气微、味甘、苦。"}]},{"ID":"20240902115530-jltqn8b","Type":"NodeParagraph","Properties":{"id":"20240902115530-jltqn8b","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"蜜百部：取百部片，照蜜炙法（附录ⅡD）炒至不粘手。每100kg百部，用炼蜜12.5kg。本品形同百部片，表面棕黄色或褐棕色、略带焦斑，稍有黏性。味甜。"}]},{"ID":"20240902115530-uj3vtod","Type":"NodeParagraph","Properties":{"id":"20240902115530-uj3vtod","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性味】甘、苦，微温。"}]},{"ID":"20240902115530-ykndkxx","Type":"NodeParagraph","Properties":{"id":"20240902115530-ykndkxx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【归经】归肺经。有小毒。"}]},{"ID":"20240902115530-pyb4epg","Type":"NodeParagraph","Properties":{"id":"20240902115530-pyb4epg","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【功能主治】润肺下气止咳，杀虫。用于新久咳嗽，肺痨咳嗽，百日咳；外用于头虱，体虱，蛲虫病，阴痒。蜜百部润肺止咳。用于阴虚劳嗽。"}]},{"ID":"20240902115530-n4zjenp","Type":"NodeParagraph","Properties":{"id":"20240902115530-n4zjenp","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。外用适量，水煎或酒浸。"}]},{"ID":"20240902115530-5b3mpmp","Type":"NodeParagraph","Properties":{"id":"20240902115530-5b3mpmp","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902115530-wh76dna","Type":"NodeParagraph","Properties":{"id":"20240902115530-wh76dna","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部《*辞典》"}]},{"ID":"20240902115530-yy2gpe9","Type":"NodeParagraph","Properties":{"id":"20240902115530-yy2gpe9","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【出处】《本草经集注》"}]},{"ID":"20240902115530-ay8x1sc","Type":"NodeParagraph","Properties":{"id":"20240902115530-ay8x1sc","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【拼音名】BǎiBù"}]},{"ID":"20240902115530-et6x6dw","Type":"NodeParagraph","Properties":{"id":"20240902115530-et6x6dw","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【别名】嗽药（陶弘景），百条根、野天门冬、百奶（《杨氏经验方》），九丛根（《草木便方》），九虫根（《分类草药性》），一窝虎（《江苏植药志》），九十九条根（《中国土农药志》），山百根（《中药志》），牛虱鬼（《闽东本草》）。"}]},{"ID":"20240902115530-a8ogsxo","Type":"NodeParagraph","Properties":{"id":"20240902115530-a8ogsxo","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【来源】为百部科植物蔓生百部、直立百部或对叶百部等的块根。春季新芽出土前及秋季苗将枯萎时挖取，洗净泥土，除去须根，置沸水中浸烫后，取出晒干。"}]},{"ID":"20240902115530-hl9d71m","Type":"NodeParagraph","Properties":{"id":"20240902115530-hl9d71m","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902115530-bi7qedw","Type":"NodeParagraph","Properties":{"id":"20240902115530-bi7qedw","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①蔓生百部，又名：百部草（啪朴子》），婆妇草（《日华子本草》），蔓草百部。"}]},{"ID":"20240902115530-u1psipq","Type":"NodeParagraph","Properties":{"id":"20240902115530-u1psipq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～90厘米，全体平滑无毛。根肉质，通常作纺锤形，数个至数十个簇生。茎上部蔓状，具纵纹。叶通常4片轮生；卵形或卵状披针形，长3～9厘米，宽1.5～4厘米，先端锐尖或渐尖，全缘或带微波状，基部圆形或近于截形，偶为浅心形，中脉5～9条；叶柄线形，长1.5～2.5厘米。花梗丝状，长1.5～2.5厘米，其基部贴生于叶片中脉上，每梗通常单生1花；花被4片，淡绿色，卵状披针形至卵形；雄蕊4，紫色，花丝短，花药内向，线形，顶端有一线形附属体；子房卵形，甚小，无花柱。蒴果广卵形而扁；内有长椭圆形的种子数粒。花期5月。果期7月。"}]},{"ID":"20240902115530-awzeld9","Type":"NodeParagraph","Properties":{"id":"20240902115530-awzeld9","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"生长于阳坡灌木林下或竹林下。分布山东、安徽、江苏、浙江、福建、江西、湖南、湖北、四川、陕西等地。"}]},{"ID":"20240902115530-ot8z20p","Type":"NodeParagraph","Properties":{"id":"20240902115530-ot8z20p","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②直立百部"}]},{"ID":"20240902115530-6nk10le","Type":"NodeParagraph","Properties":{"id":"20240902115530-6nk10le","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～60屋米。茎直立，不分枝，有纵纹。叶常3～4片轮生，偶为5片；卵形、卵状椭圆形至卵状披针形，长3.5～5.5厘米，宽1.8～3.8厘米，先端急尖或渐尖，基部楔形，叶脉通常5条，中间3条特别明显；有短柄或几无柄。花腋生，多数生于近茎下部呈鳞片状的苞腋间；花梗细长，直立或斜向上。花期3～4月。"}]},{"ID":"20240902115530-292xyk0","Type":"NodeParagraph","Properties":{"id":"20240902115530-292xyk0","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"生长于山地林下或竹林下。分布山东、河南、安徽、江苏、浙江、福建、江西等地。"}]},{"ID":"20240902115530-yf1prt7","Type":"NodeParagraph","Properties":{"id":"20240902115530-yf1prt7","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③对叶百部"}]},{"ID":"20240902115530-qtfft4p","Type":"NodeParagraph","Properties":{"id":"20240902115530-qtfft4p","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"多年生攀援草本，高达5米。块根肉质，纺锤形或圆柱形，长15～30厘米。茎上部缠绕。叶通常对生；广卵形，长8～30厘米，宽2.5～10厘米，基部浅心形，全缘或微波状，叶脉7～11条；叶柄长4～6厘米。花腋生；花下具1披针形的小苞片；花被4片，披针形，黄绿色，有紫色脉纹。蒴果倒卵形而扁.花期5～6月。"}]},{"ID":"20240902115530-o2b014p","Type":"NodeParagraph","Properties":{"id":"20240902115530-o2b014p","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"生长于向阳的灌木林下。分布台湾、福建、广东、广西、湖南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240902115530-kxxll1h","Type":"NodeParagraph","Properties":{"id":"20240902115530-kxxll1h","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"此外，尚有同属植物细花百部（海南）、狭叶百部（云南丽江），亦同等入药。"}]},{"ID":"20240902115530-56wxfuh","Type":"NodeParagraph","Properties":{"id":"20240902115530-56wxfuh","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902115530-gw51xwo","Type":"NodeParagraph","Properties":{"id":"20240902115530-gw51xwo","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①蔓生百部和直立百部的块根略呈纺锤形，平直或略弯曲，两端细，长约4-18厘米，直径约1厘米。表面黄白色至土黄色，极皱缩，具不规则的深纵沟及纵皱。质硬，易折断。断面微带角质，淡黄白色至暗棕色，中心柱多扁缩。气微，味先甜而后苦。以粗壮、肥润、坚实、色白者为佳。"}]},{"ID":"20240902115530-mofq9kq","Type":"NodeParagraph","Properties":{"id":"20240902115530-mofq9kq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"主产于安徽、浙江、江苏、山东等地；此外江西、河南及湖北、四川部分地区亦产。"}]},{"ID":"20240902115530-6f9fux6","Type":"NodeParagraph","Properties":{"id":"20240902115530-6f9fux6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②对叶百部的根较粗大，长约12～25厘米，直径约1～2厘米，纵皱较浅。质较坚硬。折断面微呈角质状，中心柱白色。以肥壮、色黄白者为佳。"}]},{"ID":"20240902115530-wd9ltn2","Type":"NodeParagraph","Properties":{"id":"20240902115530-wd9ltn2","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"主产湖北、广西、云南、四川等地；此外，广东、安徽、湖南部分地区及贵州、福建、台湾等地亦产。"}]},{"ID":"20240902115530-0e5xk3n","Type":"NodeParagraph","Properties":{"id":"20240902115530-0e5xk3n","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902115530-6rfoihx","Type":"NodeParagraph","Properties":{"id":"20240902115530-6rfoihx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"块根含多种生物碱。"}]},{"ID":"20240902115530-rrhinwq","Type":"NodeParagraph","Properties":{"id":"20240902115530-rrhinwq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"蔓生百部：根含百部碱。百部定碱、异百部定碱、原百部碱、百部宁碱、华百部碱等。"}]},{"ID":"20240902115530-l9ctltd","Type":"NodeParagraph","Properties":{"id":"20240902115530-l9ctltd","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"直立百部：根含百部碱、原百部碱、百部定碱、异百部定碱、对叶百部碱、霍多林碱、直立百部碱。"}]},{"ID":"20240902115530-42m6hvg","Type":"NodeParagraph","Properties":{"id":"20240902115530-42m6hvg","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"对叶百部：根含百部碱、对叶百部碱、异对叶百部碱、斯替宁碱、次对叶百部碱、氧化对叶百部碱。尚含糖2.32％，脂类O.84％，蛋白质9.25％，灰分12.1％，以及乙酸、甲酸、苹果酸、琥珀酸、草酸等。"}]},{"ID":"20240902115530-nbv5zaq","Type":"NodeParagraph","Properties":{"id":"20240902115530-nbv5zaq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902115530-s11g4dc","Type":"NodeParagraph","Properties":{"id":"20240902115530-s11g4dc","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①抗菌作用"}]},{"ID":"20240902115530-tnqdn43","Type":"NodeParagraph","Properties":{"id":"20240902115530-tnqdn43","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"体外试验时百部（品种未鉴定）煎剂及对叶百部酒精浸液对多种致病菌如肺炎球菌、乙型溶血型链球菌、脑膜炎球菌、金黄色葡萄球菌、白色葡萄球菌与痢疾杆菌，伤寒杆菌、副伤寒杆菌、大肠杆菌、变形杆菌，白喉杆菌、肺炎杆菌、鼠疫杆菌、炭疽杆菌、枯草杆菌，以及霍乱弧菌、人型结核杆菌等都有不同程度的抑菌作用。蔓生百部水浸液在体外对某些致病真菌有一定的抑制作用；但也有报道对真菌并无抗菌作用的。百部（品种不明）能延长培养新城病毒的鸡胚的寿命至36小时。"}]},{"ID":"20240902115530-iyo4zrx","Type":"NodeParagraph","Properties":{"id":"20240902115530-iyo4zrx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②杀虫作用"}]},{"ID":"20240902115530-49sglwg","Type":"NodeParagraph","Properties":{"id":"20240902115530-49sglwg","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"蔓生百部与其他种百部（品种未鉴定）的水浸液及乙醇浸液，对蚊蝇幼虫、头虱、衣虱以及臭虫等皆有杀灭作用。高浓度百部（品种不明）在体外且能杀死鼠蛲虫。"}]},{"ID":"20240902115530-mskom2a","Type":"NodeParagraph","Properties":{"id":"20240902115530-mskom2a","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240902115530-r4bnehx","Type":"NodeParagraph","Properties":{"id":"20240902115530-r4bnehx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"用1％碘液1～1。5毫升注入猫的右肋膜腔使产生肋膜炎以引起咳嗽，灌服百部（品种未鉴定）煎剂0.6～0.9克／公斤，并无镇咳作用。从百部属植物中分离出的百部宁碱能引起印防己毒素样惊厥。"}]},{"ID":"20240902115530-y9nfvzm","Type":"NodeParagraph","Properties":{"id":"20240902115530-y9nfvzm","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902115530-l8keqr1","Type":"NodeParagraph","Properties":{"id":"20240902115530-l8keqr1","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部：拣净杂质，除去须根，洗净，润透后切段，晒干。蜜百部：取百部段，用炼蜜（百部段100斤用蜜12斤8两）加入适量开水烊化，拌匀，稍闷，俟蜜水吸收，置锅内文火炒至微黄色不粘手为度，取出，放凉。"}]},{"ID":"20240902115530-7eymloh","Type":"NodeParagraph","Properties":{"id":"20240902115530-7eymloh","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使百部，用竹刀劈破，去心皮，花作效十条，于檐下悬令风吹，待土干后，却用酒浸一宿，滤出，焙干，细锉用。\""}]},{"ID":"20240902115530-bqr49pr","Type":"NodeParagraph","Properties":{"id":"20240902115530-bqr49pr","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902115530-bqy1qa2","Type":"NodeParagraph","Properties":{"id":"20240902115530-bqy1qa2","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"甘苦，微温。"}]},{"ID":"20240902115530-4zsfp7p","Type":"NodeParagraph","Properties":{"id":"20240902115530-4zsfp7p","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微温。\""}]},{"ID":"20240902115530-p4lu875","Type":"NodeParagraph","Properties":{"id":"20240902115530-p4lu875","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"似天门冬而苦强，亦有小毒。\""}]},{"ID":"20240902115530-tc00h3k","Type":"NodeParagraph","Properties":{"id":"20240902115530-tc00h3k","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味甘，无毒。\""}]},{"ID":"20240902115530-upc3k7x","Type":"NodeParagraph","Properties":{"id":"20240902115530-upc3k7x","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"味苦，无毒。\""}]},{"ID":"20240902115530-hotig1z","Type":"NodeParagraph","Properties":{"id":"20240902115530-hotig1z","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902115530-zwlyrk3","Type":"NodeParagraph","Properties":{"id":"20240902115530-zwlyrk3","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"入肺经。"}]},{"ID":"20240902115530-4jfr1dx","Type":"NodeParagraph","Properties":{"id":"20240902115530-4jfr1dx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入肺。\""}]},{"ID":"20240902115530-gr1xd6e","Type":"NodeParagraph","Properties":{"id":"20240902115530-gr1xd6e","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入肺经，亦入脾、胃。\""}]},{"ID":"20240902115530-1bo5hcr","Type":"NodeParagraph","Properties":{"id":"20240902115530-1bo5hcr","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902115530-r52mqg9","Type":"NodeParagraph","Properties":{"id":"20240902115530-r52mqg9","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"温润肺气，止咳，杀虫。治风寒咳嗽，百日咳，肺结核，老年咳喘，蛔虫、蛲虫病，皮肤疥癣、湿疹。"}]},{"ID":"20240902115530-3lo6frh","Type":"NodeParagraph","Properties":{"id":"20240902115530-3lo6frh","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（1）润肺止咳：用于新久咳嗽，如急、慢性支气管炎、百日咳及肺结核等。配麻黄、杏仁治小儿风寒咳喘；配紫菀、贝母、寒水石治小儿肺热咳嗽。（2）灭虱杀虫：用于头虱、体虱。浓煎灌肠治蛲虫。"}]},{"ID":"20240902115530-q0kdywy","Type":"NodeParagraph","Properties":{"id":"20240902115530-q0kdywy","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①《抱朴子》：\"治咳及杀虫。\""}]},{"ID":"20240902115530-c72mijh","Type":"NodeParagraph","Properties":{"id":"20240902115530-c72mijh","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主咳嗽上气。\""}]},{"ID":"20240902115530-xr4qwib","Type":"NodeParagraph","Properties":{"id":"20240902115530-xr4qwib","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"百部火炙酒渍，饮之疗咳嗽，亦主去虱。又主暴嗽。\""}]},{"ID":"20240902115530-wd0wmeg","Type":"NodeParagraph","Properties":{"id":"20240902115530-wd0wmeg","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治肺家热，上气，咳嗽，主润益肺。\""}]},{"ID":"20240902115530-21dqi0i","Type":"NodeParagraph","Properties":{"id":"20240902115530-21dqi0i","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑤《本草拾遗》：\"火炙浸酒空腹饮，去虫蚕咬，兼疥癣疮。\""}]},{"ID":"20240902115530-001wo02","Type":"NodeParagraph","Properties":{"id":"20240902115530-001wo02","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"治疳蛔及传尸骨蒸劳，杀蛔虫，寸白、蛲虫。\""}]},{"ID":"20240902115530-ukvlt32","Type":"NodeParagraph","Properties":{"id":"20240902115530-ukvlt32","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑦《滇南本草》：\"润肺，治肺热咳嗽：消痰定喘，止虚痨咳嗽，杀虫。\""}]},{"ID":"20240902115530-4iw1r3r","Type":"NodeParagraph","Properties":{"id":"20240902115530-4iw1r3r","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑧《中国药植志》：\"与猪蹄煮服，可以治风湿症。\""}]},{"ID":"20240902115530-7xuhwlz","Type":"NodeParagraph","Properties":{"id":"20240902115530-7xuhwlz","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑨广州部队《常用中草药手册》：\"治百日咳，肺结核，支气管炎，皮炎，湿疹，荨麻疹，脚癣，阿米巴痢疾。\""}]},{"ID":"20240902115530-cevdelw","Type":"NodeParagraph","Properties":{"id":"20240902115530-cevdelw","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；浸酒或入丸、散。外用：煎水洗或研末调敷。"}]},{"ID":"20240902115530-57k151q","Type":"NodeParagraph","Properties":{"id":"20240902115530-57k151q","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【注意】《得配本草》：\"热嗽，水亏火炎者禁用。\""}]},{"ID":"20240902115530-jhbnts4","Type":"NodeParagraph","Properties":{"id":"20240902115530-jhbnts4","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902115530-vb7s7q4","Type":"NodeParagraph","Properties":{"id":"20240902115530-vb7s7q4","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①治肺寒壅嗽，微有痰：百部三两（炒），麻黄，杏仁四十个。上为末，炼蜜丸如芡实大，热水化下，加松子仁肉五十粒，糖丸之，含化大妙。（《小儿药证直诀》百部丸）"}]},{"ID":"20240902115530-xokymvk","Type":"NodeParagraph","Properties":{"id":"20240902115530-xokymvk","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②治寒邪侵于皮毛，连及于肺，令人咳：桔梗-钱五分，甘草（炙）五分，白前一钱五分，橘红一钱；百部一钱五分，紫菀一钱五分。水煎服。（《医学心悟》止嗽散）"}]},{"ID":"20240902115530-foeytaz","Type":"NodeParagraph","Properties":{"id":"20240902115530-foeytaz","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③治卒得咳嗽：生姜汁，百部汁。和同合煎，服二合。（《补缺肘后方，）"}]},{"ID":"20240902115530-r7yn7yg","Type":"NodeParagraph","Properties":{"id":"20240902115530-r7yn7yg","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"④治暴嗽：百部藤根捣自然汁，和蜜等分，沸汤煎成膏咽之。（《续十全方》）"}]},{"ID":"20240902115530-il1ynsb","Type":"NodeParagraph","Properties":{"id":"20240902115530-il1ynsb","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑤治暴咳嗽：百部根渍酒，每温服一升，日三服。（张文仲）"}]},{"ID":"20240902115530-0u0ohjm","Type":"NodeParagraph","Properties":{"id":"20240902115530-0u0ohjm","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑥治久嗽不巳，咳吐痰涎，重亡津液，渐成肺痿，下午发热，鼻塞项强，脚胁胀满，卧则偏左其嗽少止，偏右嗽必连发，甚则喘急，病必危殆：百部、薏苡仁、百合、麦门冬各三钱，桑白皮、白茯苓、沙参、黄耆、地骨皮各-钱五分。水煎服。（《本草汇言》百部汤）"}]},{"ID":"20240902115530-0a5fhew","Type":"NodeParagraph","Properties":{"id":"20240902115530-0a5fhew","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑦治三十年嗽：百部根二十斤，捣取汁，煎如饴，服一方寸匕，日三服。（《千金方》）"}]},{"ID":"20240902115530-py9o296","Type":"NodeParagraph","Properties":{"id":"20240902115530-py9o296","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑧治遍身黄肿：掘新鲜百部根，洗捣，罨脐上，以糯米饭半升，拌水酒半合，揉软盖在药上，以帛包住，待一、二日后，口内作酒气，则水从小便中出，肿自消也。（《杨氏经验方》）"}]},{"ID":"20240902115530-32qq8bt","Type":"NodeParagraph","Properties":{"id":"20240902115530-32qq8bt","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑨治牛皮癣：百部、白鲜皮、萆蔴子（去壳）、鹤虱。黄柏、当归、生地各一两，黄蜡二两，明雄黄末五钱，麻油八两.先将百部等七味入袖熬枯，滤去渣，复将油熬至滴水成珠，再下黄蜡，试水中不散为度，端起锅来将雄黄末和入，侯稍冷，倾入磁盆中收贮，退火听用。（《外科十法》百部膏）"}]},{"ID":"20240902115530-rykof4h","Type":"NodeParagraph","Properties":{"id":"20240902115530-rykof4h","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑩治蚰蜒入耳：百部（切、焙），捣罗为末，以一字，生油调涂于耳门上。（《圣济总录》）"}]},{"ID":"20240902115530-85g3ke2","Type":"NodeParagraph","Properties":{"id":"20240902115530-85g3ke2","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（11）咳嗽。用百部根泡酒，每温服一升，一天服三次。又方：用百部、生姜，各捣汁，等分，取二合煎服。又方：用百部藤根捣自然汁，加蜜等分，以沸汤煎成膏，噙咽。"}]},{"ID":"20240902115530-xftcku6","Type":"NodeParagraph","Properties":{"id":"20240902115530-xftcku6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（12）遍身黄肿。用新鲜百部根，洗净，捣烂，敷脐上，以糯米饭半升，拌水酒半合，揉软，盖在药上，外用布包好。一、二天之后，口内有酒气，水从小便出，肿亦渐消。"}]},{"ID":"20240902115530-3s0dm77","Type":"NodeParagraph","Properties":{"id":"20240902115530-3s0dm77","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"（13）熏衣虱。和百部、秦艽，共研为末，烧烟熏衣，虱自落。用上两药煮汤洗亦可。"}]},{"ID":"20240902115530-uc1ndu6","Type":"NodeParagraph","Properties":{"id":"20240902115530-uc1ndu6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902115530-m129xih","Type":"NodeParagraph","Properties":{"id":"20240902115530-m129xih","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"①治疗百日咳"}]},{"ID":"20240902115530-7yrel8t","Type":"NodeParagraph","Properties":{"id":"20240902115530-7yrel8t","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"用百部250克制成糖浆800毫升，小儿每次3～5毫升，4小时1次；或每次用百部糖浆10～15毫升，每日3次，连服1周。亦可将百部晒干研粉，炼蜜为丸，如梧桐子大，日服3次，1岁以下每次3～10丸，2～4岁20～30丸，5～8岁40～50丸。据百余例的观察，有效率在85％以上，对痉咳期效果特别显着。一般用药2～4日即可见效，治愈时间最快3天左右，最慢15～19天。有合并症者须加用其它药物。百部糖浆亦可作预防用药。另有报道以百部配合其它中药组成复方应用。"}]},{"ID":"20240902115530-09en4js","Type":"NodeParagraph","Properties":{"id":"20240902115530-09en4js","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"②治疗肺结核"}]},{"ID":"20240902115530-oqoie8h","Type":"NodeParagraph","Properties":{"id":"20240902115530-oqoie8h","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部晒干研粉，以童雌鸡（未产卵的）加水煨汁，调和为丸（每斤百部粉约需净鸡1斤煨成鸡汁12两）。每次3钱，早晚各服1次，20～30天为一疗程，视病情需要可以继续再服。此方用于慢性发作的肺结核效果较好，对长期应用西药抗痨药物效果不显的病例，有时疗效尤为显著。据153例的观察，多数服药一、二疗程后症状改善，食欲增进，体重增加；X线复查也有不同程度的进步。对于病情发展迅速、症状急剧或血沉增速至第一小时末40毫米以上者，此药难以控制，不宜应用。服药后除个别病例有咽干现象外，尚未发现其它不良反应。"}]},{"ID":"20240902115530-gqj8yy8","Type":"NodeParagraph","Properties":{"id":"20240902115530-gqj8yy8","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"③治疗慢性气管炎"}]},{"ID":"20240902115530-v39p8wp","Type":"NodeParagraph","Properties":{"id":"20240902115530-v39p8wp","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"以百部为主（每剂6～8钱），配伍甘草、紫菀、白果、黄芩、麻黄等，组成几个不同方剂，治疗老年性慢性气管炎100例，经1年的随访观察，总有效率为75％，其中初步治愈率为25％，显效率为9％，好转率为41％。服药后1～2天即觉咳嗽减轻，连服10天之内可出现最高效果。男性及喘息型患者效果较差。少数病例服药后有口干、腹痛、眼睑浮肿等轻微反应，不影响治疗。此外，有用百部配伍等量麻黄、杏仁，以蜂蜜制成丸剂（每丸2钱），早晚各服2丸，10天为一疗程。于夏季观察181例，经1～2疗程后，有效率达88.3％（临床治愈率23.1％，显效率21％，好转率44.2％）。一般在5～10天即见明显疗效。"}]},{"ID":"20240902115530-h57gxm8","Type":"NodeParagraph","Properties":{"id":"20240902115530-h57gxm8","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"④治疗蛲虫病"}]},{"ID":"20240902115530-8ylda8d","Type":"NodeParagraph","Properties":{"id":"20240902115530-8ylda8d","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"小儿每次用百部1两，加水浓煎成30毫升（成人用量加倍），于夜间11时左右作保留灌肠，10～12天为一疗程。通过133例观察，治愈者占62％。如辅以使君子粉和大黄浸泡液内服，则疗效可显著提高。或用20％百部煎液每次30毫升灌肠，每日1次，7次为一疗程，多数病例在一疗程内即获治愈。另报告52例，系用百部5两，配合苦楝皮2两、乌梅3钱，加水800毫升，煎成400毫升，每次用20～30毫升于临睡前作保留灌肠，结果有51例治愈。为了使用方便，以后改为百部5钱，苦楝皮1两，鹤虱5钱，研粉混合装入胶囊，于临睡前取1粒插入肛门内，连用7～10天。"}]},{"ID":"20240902115530-i36f5t1","Type":"NodeParagraph","Properties":{"id":"20240902115530-i36f5t1","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑤治疗滴虫性阴道炎"}]},{"ID":"20240902115530-h1mszj8","Type":"NodeParagraph","Properties":{"id":"20240902115530-h1mszj8","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"用百部2两，加水1000毫升，煎成600毫升，冲洗阴道，而后用雄黄粉均匀地喷入阴道皱襞。每日1次，5日为一疗程。观察60例，多数为一个疗程，少数经过2～3个疗程治愈。平均用药3～5日，阴道分泌物显著减少，外阴部瘙痒等自觉症状消失。少数病例复发（多于月经后或流产后），再次治疗仍可获愈。远期效果尚待观察。"}]},{"ID":"20240902115530-qk8iwos","Type":"NodeParagraph","Properties":{"id":"20240902115530-qk8iwos","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"⑥治疗癣症"}]},{"ID":"20240902115530-kyyyl2g","Type":"NodeParagraph","Properties":{"id":"20240902115530-kyyyl2g","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"用百部20克，浸入50％酒精100毫升中48小时，过滤后再加酒精至100毫升，患处洗净后即以棉签蘸药液涂擦。轻症约3～4天即可见效。"}]},{"ID":"20240902115530-1x8zfv6","Type":"NodeParagraph","Properties":{"id":"20240902115530-1x8zfv6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"此外，用百部制成试剂作百部白雾反应试验，诊断血吸虫病，据1091例血吸虫病患者观察，阳性率占96.72％。"}]},{"ID":"20240902115530-yngxex3","Type":"NodeParagraph","Properties":{"id":"20240902115530-yngxex3","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【备注】云南、四川少数地区，有用百合科植物羊齿天门冬的块根作百部用，名\"土百部\"，详\"土百部\"条；广西有以石刁柏的块根作百部用，名\"小百部\"，详\"小百部\"条。"}]},{"ID":"20240902115530-but51oh","Type":"NodeParagraph","Properties":{"id":"20240902115530-but51oh","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902115530-9vguzzq","Type":"NodeParagraph","Properties":{"id":"20240902115530-9vguzzq","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"百部《中华本草》"}]},{"ID":"20240902115530-qzy0h17","Type":"NodeParagraph","Properties":{"id":"20240902115530-qzy0h17","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902115530-hlbhai7","Type":"NodeParagraph","Properties":{"id":"20240902115530-hlbhai7","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"出自《本草经集注》。"}]},{"ID":"20240902115530-xg5fq1u","Type":"NodeParagraph","Properties":{"id":"20240902115530-xg5fq1u","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：百部，山野处处有，根数十相连，似天门冬而苦强。……亦主去虱；煮作汤洗牛犬虱即去。《博物志》云：九真有一种草似百部，但长大尔，悬火上令干，夜取四、五寸，短切，含咽汁，主暴嗽甚良，名为嗽药。疑此是百部，恐其土肥润处，是以长大尔。"}]},{"ID":"20240902115530-q3kg93p","Type":"NodeParagraph","Properties":{"id":"20240902115530-q3kg93p","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：百部根，旧不出州土，今江、湖、淮、陕、齐、鲁州郡皆有之。春生苗，作藤蔓，叶大而尖长"}]},{"ID":"20240902115530-tm746hr","Type":"NodeParagraph","Properties":{"id":"20240902115530-tm746hr","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【拼音名】BǎiBù"}]},{"ID":"20240902115530-6m3orht","Type":"NodeParagraph","Properties":{"id":"20240902115530-6m3orht","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【英文名】SessileStemonaRoot，JapaneseStemonaRoot，TuberStemonaRoot"}]},{"ID":"20240902115530-2l24ztv","Type":"NodeParagraph","Properties":{"id":"20240902115530-2l24ztv","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【别名】百部根、白并、玉箫、箭杆、嗽药、百条根、野天门冬、百奶、九丛根、九虫根、一窝虎、九十九条根、山百根、牛虱鬼、药虱药"}]},{"ID":"20240902115530-eb8ccqw","Type":"NodeParagraph","Properties":{"id":"20240902115530-eb8ccqw","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902115530-bws768n","Type":"NodeParagraph","Properties":{"id":"20240902115530-bws768n","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"药材基源：为百部科植物直立百部、蔓生百部和对叶百部的根。"}]},{"ID":"20240902115530-hxqm34x","Type":"NodeParagraph","Properties":{"id":"20240902115530-hxqm34x","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Stemonasessilifolia(Miq.)Franch.etSav.2.Stemonajaponica(Bl.)Miq.3.StemonatuberosaLour."}]},{"ID":"20240902115530-zfbth5n","Type":"NodeParagraph","Properties":{"id":"20240902115530-zfbth5n","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"采收和储藏：移栽2-3年后采挖。于冬季地上部枯萎后或春季萌芽前，挖出块根，除去细根、泥土、在沸水中刚煮透时，取出晒干或烘干。也可鲜用。"}]},{"ID":"20240902115530-2z6505v","Type":"NodeParagraph","Properties":{"id":"20240902115530-2z6505v","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【原形态】1.直立百部多年生草本，高30-60cm。块根簇生，肉质，纺锤形。茎直立，不分枝。叶3-4片轮生；有短柄或几无柄；叶片卵形，至椭圆形，长3.5-5.5cm，宽1.8-3.8cm，先端急尖或渐尖，基部楔形；叶脉通常5条，中间3条特别明显。花腋生，多数生于茎下部鳞叶腋内，花梗细长；花被片4，卵状披针形；雄蕊4，紫色，药隔膨大成披针形附属物，花药线形，先端有狭卵状附属物；子房卵形，柱头短。蒴果。花期4-5月，果期7月。2.蔓生百部多年生草本，高60-90cm。全株无毛。根肉质，数个至数十个簇生。茎下部直立，上部蔓状。叶3-4片轮生；叶柄长1.5-3cm；叶片卵形或卵状披针形，长4-9cm，宽1.8-4cm，先端锐尖或渐尖，基部圆形或截形，全缘；叶脉5-9条。花梗丝状，长1.5-2.5cm，其基部贴生于叶片中脉上，每梗通常单生1花；花被4片，淡绿色，卵状披针形至卵形；雄蕊4，紫色，花丝短，花药内向，线形，先端有一箭头状附属物；子房卵形，甚小，无花柱。蒴果广卵形面扁，内脏长椭圆形种子数颗。花期5月，果期7月。3.对叶百部多年生攀援草本，高达5m。块根肉质，纺锤形或圆柱形，茎缠绕。叶通常对生；叶柄长3-10cm；叶片广卵形，长8-30cm，宽2.5-10cm，基部浅心形，全缘或微波状；叶脉7-15条。花梗腋生，不贴生于叶片中脉上，花单生或2-3朵成总状花序，黄绿色带紫色条纹，花药附属物呈钻状或披针形。蒴果倒卵形而扁。花期5-6月。"}]},{"ID":"20240902115530-tv4oukj","Type":"NodeParagraph","Properties":{"id":"20240902115530-tv4oukj","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902115530-ucp01k5","Type":"NodeParagraph","Properties":{"id":"20240902115530-ucp01k5","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"生态环境：1.蔓生百部生于山地林下或竹林下。"}]},{"ID":"20240902115530-6qffdf7","Type":"NodeParagraph","Properties":{"id":"20240902115530-6qffdf7","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.直立百部生于阳坡灌丛中或竹林下。"}]},{"ID":"20240902115530-gf5ie1g","Type":"NodeParagraph","Properties":{"id":"20240902115530-gf5ie1g","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.对叶百部生于向阳的灌木林下。"}]},{"ID":"20240902115530-5p9ivga","Type":"NodeParagraph","Properties":{"id":"20240902115530-5p9ivga","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"资源分布：1.蔓生百部分布化东及河南、湖北等地。"}]},{"ID":"20240902115530-e6gzl7r","Type":"NodeParagraph","Properties":{"id":"20240902115530-e6gzl7r","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.直立百部分布华东及陕西、湖南、湖北、四川等地。"}]},{"ID":"20240902115530-wdtv3my","Type":"NodeParagraph","Properties":{"id":"20240902115530-wdtv3my","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.对叶百部分布浙江、福建、台湾、湖北、湖南、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240902115530-wu9q16i","Type":"NodeParagraph","Properties":{"id":"20240902115530-wu9q16i","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【栽培】生物学特性喜较温暖、潮湿、阴凉环境，耐寒，忌积水。以土层深厚、疏松肥沃、富含腐殖质、排水良好的砂质壤土栽培为宜。栽培技术用种子或分株繁殖。种子繁殖：用育苗移栽法北方3月下旬-4月上旬：南方8-9月播种，在畦上开横沟，沟心距25-30cm，深7-10cm，播幅约10cm，将种子匀播沟中，每1hm2用种子30-37.5kg。施人畜粪水，盖草木灰，再盖细土4-5cm，然后盖谷壳。第2年春季出苗，冬季移栽。按行株距50cm×35cm，穴深15-20cm，底平，每穴1株，覆土，浇淡人畜粪水。分株每殖：在冬季倒苗后或春季未萌发前，结合收获，挖出块根剪下大个的供药用，分割成小株，每株具有壮芽1-2个和小块根2-3个，开穴栽种。田间管理每年4月和6月各进行1次中耕除草追肥。苗高20cm左右时，在株旁插一竹竿或树枝，供蔓茎缠绕，并将相邻的竹竿顶端每3-4个扎在一起，更为坚固，便于管理。冬季清除干枯茎叶后培土，并施杂肥1次。病虫害防治棉红蜘蛛，成、若虫吸食叶片汗液，用40%水胺硫磷1500倍液或20%双甲脒乳油1000倍液喷雾。蛞蝓，咬食化梗、果柄、叶片，可在清晨撒石灰粉或人工捕杀。"}]},{"ID":"20240902115530-gf5w3pf","Type":"NodeParagraph","Properties":{"id":"20240902115530-gf5w3pf","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别（1）直立百部块根纺锤形，上端较细长。下端有的作长尾状弯曲，长5-17cm，直径0.5-1cm。表面黄白色或淡土黄色，有不规则深纵沟，间或有横皱纹。质脆，受潮后韧软，断面平坦，角质样，淡黄棕色或黄白色，皮部宽广，中柱扁小。气微，味甘、苦。（2）蔓生百部两端较狭细，表面淡灰白色，多不规则皱褶及横皱纹；味较苦。（3）对叶百部长纺锤形或长条形，长8-24cm，直径0.8-2cm。表面淡黄棕色至灰棕色，具浅纵皱纹或不规则纵槽。质坚实，断面黄白色至暗棕色，中柱较大，髓部类白色；味苦。均以条粗壮、质坚实者为佳。显微鉴别块根横切面：（1）直立百部根被为3-4列类多角形细胞，壁木栓化及木化，具致密的细条纹。皮层宽广，外皮层细胞排列整齐，薄壁细胞有的含草酸钙针晶；内皮层细胞隐约可见凯氏点。中柱鞘为1-2列薄壁细胞。中柱韧皮部束与木质部束各19-27个，相间排列；韧皮部束内侧有单个或2-3个成束的非木化纤维；木质部束有导管2-5个。并有少数木纤维及管胞，导管多角形，偶有单个或2-3个并列的导管深入于髓部外缘，呈2轮状排列。髓部散有单个或2-3个成束的细小纤维。（2）蔓生百部根被细胞3-6列；韧皮部纤维木化；导管通常深入于髓部，与外侧导管束作2-3轮状排列。（3）地叶百部根被细胞约3列，细胞壁强木化，无细条纹，其最内层细胞的内壁特厚；皮层外缘散有纤维，呈类方形，壁非木化或微木化；韧皮部束36-40个；木质部导管圆多角形，与木纤维及微木化的木薄壁细胞连成环层；髓部纤维少，常单个散在。粉末特征：（1）直立百部灰黄色。①根被细胞淡黄棕色或无色。表面观呈长方形或长多角形，壁木栓化及木化，整个细胞壁均有致密交织的细条纹。②具缘纹孔导管直径16-80μm，导管分子端壁常华侨，具长的梯形穿孔板，具缘纹孔较密，有的横向延长并数个连接。③内皮层细胞表面观呈长方形，直径约至24μm，壁稍厚，纵向壁细波状或螺旋状弯曲，横向壁平直，非木化或微木化。④木纤维较长，直径12-24μm，壁稍厚，木化，具单斜纹孔或具缘纹孔，纹孔口相交成人字形或十字形。⑤导管旁木薄壁细胞长方形，端壁平截，少数稍倾斜或一端渐尖，直径22-35μm，有较大的类圆形单纹孔。⑥草酸钙针晶较少，常不规则充塞于薄壁细胞中甚细，长约60μm少数较粗，直径约5μm，似细柱状。（2）蔓生百部根的粉末特征与直立百部相似。但具缘纹孔导管较大，直径64-136μm；木纤维直径约至32μm；草酸钙针晶难察见。（3）对叶百部①淀粉粒众多，蚌壳形、螺丝形、扇形、棒槌形、肾形、类圆形、或不规则形，边缘大多凹凸不平，直径5-52μm，长约至75μm，经烫煮加工的商品，大多糊化。②根被细胞表面观类多角形，壁稍厚、木化，无致密的细条纹。③皮层纤维细长，稍弯曲，一边略呈齿状突出，直径16-54μm，壁厚5-15μm，非木化，纹孔及孔沟偶可察见。商品规格分直立百部、蔓生百部、对叶百部3种，各分大、小2种。福建、贵州、河南、广西等地所产者较大；山东、江苏、四川、安徽、浙江所产者较细小。"}]},{"ID":"20240902115530-vpnytlp","Type":"NodeParagraph","Properties":{"id":"20240902115530-vpnytlp","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【化学成份】1.直立百部根含百部碱（stemonine），原百部碱（protostemonine），对叶百部碱（tuberostemonine），百部定碱（stemonidine），异百部定碱（isostemonidine），霍多林碱（hordorine），直立百部碱（sessilistemonine）。2.蔓生百部根含百部碱，百部定碱，异百部定碱，原百部碱，蔓生百部碱（stemonamine），异蔓生百部碱（isostemonamine）。茎叶含蔓生百部叶碱（stemofoline）。3.对叶百部根含百部碱，对叶百部碱，异对叶百部碱（isotuberostemonine），百部次碱（stenine），次对叶百部碱（hyoptuberostemonine），氧代对叶百部碱（oxotuberostemonine），滇百部碱（stemotinine），异滇百部碱（isostemotinine），对叶百部酮碱（tuberostemonone），对叶百部醇碱（tuberostemonol），对叶百部酰胺（stemoamide），对叶百部螺碱（tuberostemospironine），二去氢对叶百部碱（didehydrotuberostemonine）。还含糖2.32%，脂类0.84%，蛋白质9.25%，灰分12.1%以及甲酸（formicacid），乙酸（aceticacid），苹果酸（malicacid），枸橼酸（citricacid），琥珀酸（succinicacid），草酸（oxalicacid）等。"}]},{"ID":"20240902115530-wnro9dx","Type":"NodeParagraph","Properties":{"id":"20240902115530-wnro9dx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902115530-enddfha","Type":"NodeParagraph","Properties":{"id":"20240902115530-enddfha","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"1.抗菌作用：体外试验时百部煎剂及对叶百部酒精浸液对多种致病菌如肺炎球菌、乙型溶血型链球菌、脑膜炎球菌。金黄色葡萄球菌、白色葡萄球菌与痢疾杆菌、伤寒杆菌、副伤寒杆菌、大肠杆菌、变形杆菌、白喉杆菌、肺炎杆菌、鼠疫杆菌、炭疽杆菌、枯草杆菌，以及霍乱弧菌。人型结核杆菌等都有不同程度的抑菌作用。蔓生百部水浸液在体外对某些致病真菌有一定的抑制作用；但也有报道对真菌并无抗菌作用的。百部（品种不明）能延长培养新城病毒的鸡胚的寿命至36小时。"}]},{"ID":"20240902115530-n1l9fwx","Type":"NodeParagraph","Properties":{"id":"20240902115530-n1l9fwx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.杀虫作用：蔓生百部与其他种百部（品种未鉴定）的水浸液及乙醇浸液，对蚊蝇幼虫、头虱、衣虱以及臭虫等皆有杀灭作用。高浓度百部（品种不明）在体外且能杀死鼠蛲虫。"}]},{"ID":"20240902115530-vk4k8ds","Type":"NodeParagraph","Properties":{"id":"20240902115530-vk4k8ds","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.镇咳作用:动物试验证明百部有镇咳作用，能降低呼吸中枢的兴奋性。"}]},{"ID":"20240902115530-7wfk1lz","Type":"NodeParagraph","Properties":{"id":"20240902115530-7wfk1lz","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"4.对流感病毒作用：百部能降低亚洲甲型流感病毒对小鼠的致病力，对未感染流感病毒的小鼠有一定的预防作用。对已感染病毒的小鼠亦有治疗作用。"}]},{"ID":"20240902115530-6kbgyg3","Type":"NodeParagraph","Properties":{"id":"20240902115530-6kbgyg3","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240902115530-xwexclo","Type":"NodeParagraph","Properties":{"id":"20240902115530-xwexclo","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"1.百部碱服用过多可减低呼吸中枢兴奋性，继而导致呼吸中枢麻痹。"}]},{"ID":"20240902115530-bqsm9d7","Type":"NodeParagraph","Properties":{"id":"20240902115530-bqsm9d7","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"体外试验表明，百部醇浸剂在1：100-1：1600浓度时对H37RV人型结核抑菌有抑制作用，在1：80浓度10分钟内可将其杀死。"}]},{"ID":"20240902115530-ijha1my","Type":"NodeParagraph","Properties":{"id":"20240902115530-ijha1my","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.此外，百部煎剂对多种细菌及皮肤真菌亦有一定的抑制作用。"}]},{"ID":"20240902115530-nfyuduy","Type":"NodeParagraph","Properties":{"id":"20240902115530-nfyuduy","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.并能降低亚洲甲型流感病毒对小鼠的致病力。对已感染的小鼠也有治疗作用。"}]},{"ID":"20240902115530-zcm7g14","Type":"NodeParagraph","Properties":{"id":"20240902115530-zcm7g14","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"4.用鸡胚培养的新城病毒试验，表明百部能延长鸡胚寿命36小时。置鼠晓虫于50%百部药液内，经11小时已有少数死亡，20小时全部死亡。"}]},{"ID":"20240902115530-ec5y5yx","Type":"NodeParagraph","Properties":{"id":"20240902115530-ec5y5yx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）本品80%乙醇提取液，蒸去乙醇，残留液加氨水调节Qh至10-11，用氯仿萃取，氯仿液蒸干后加1%盐酸溶解，滤过。滤液分两份，一份中加碘化铋钾试液，产生橙红色沉淀；另一份滴加硅钨酸试液，产生乳白色沉淀。（检查生物碱）（2）薄怪色谱取本品粉末0.5g，加水饱和正丁醇50ml，放置过夜，再超声提取20min，取上清液减压蒸干，加甲醇1ml溶解作样品溶液。另取对叶百部碱和原百部次碱各1mg，分别加甲醇1ml，溶解，作对照品溶液。在硅胶G-CMC薄层板上，分别点上述溶液各10μl，以氯仿-乙醚-甲醇（10：2：1）为展开剂，展距10cm，取出晾干。喷改良碘化铋钾试液显色。样品色谱在与对照品色谱的相应位置上，显相同颜色的斑点。"}]},{"ID":"20240902115530-33tc1ib","Type":"NodeParagraph","Properties":{"id":"20240902115530-33tc1ib","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902115530-cimxruo","Type":"NodeParagraph","Properties":{"id":"20240902115530-cimxruo","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"1.百部：拣净杂质，除去须根，洗净，润透后切段，晒干。"}]},{"ID":"20240902115530-5dn75hi","Type":"NodeParagraph","Properties":{"id":"20240902115530-5dn75hi","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.蜜制：取百部段，用炼蜜（百部段100斤用蜜12斤8两）加入适量开水烊化，拌匀，稍闷，俟蜜水吸收，置锅内文火炒至微黄色不粘手为度，取出，放凉。"}]},{"ID":"20240902115530-t4kj5cv","Type":"NodeParagraph","Properties":{"id":"20240902115530-t4kj5cv","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.甘草制：取甘草加水煎汤，加入百部片浸泡后捞出晒干，每百部片100kg，用甘草8kg。"}]},{"ID":"20240902115530-t4m2ood","Type":"NodeParagraph","Properties":{"id":"20240902115530-t4m2ood","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"4.炒制：取百部用火炒至微黄色。《雷公炮炙论》:凡使百部，用竹刀劈破，去心皮，花作数十条，于檐下悬令风吹，待上干后，却用酒浸一宿，滤出，焙干，细锉用。"}]},{"ID":"20240902115530-iogaacx","Type":"NodeParagraph","Properties":{"id":"20240902115530-iogaacx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【性味】甘；苦；微温"}]},{"ID":"20240902115530-33i1x5o","Type":"NodeParagraph","Properties":{"id":"20240902115530-33i1x5o","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【归经】肺经"}]},{"ID":"20240902115530-5j8bvsb","Type":"NodeParagraph","Properties":{"id":"20240902115530-5j8bvsb","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【功能主治】润肺止咳；杀虫灭虱。主新久咳嗽；肺痨；百日咳；蛲虫病；体虱；癣疥"}]},{"ID":"20240902115530-4e8z7l1","Type":"NodeParagraph","Properties":{"id":"20240902115530-4e8z7l1","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；外用：适量，煎水洗；或研末外敷；或浸酒涂擦。"}]},{"ID":"20240902115530-2e4r6b3","Type":"NodeParagraph","Properties":{"id":"20240902115530-2e4r6b3","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃有热者慎用。《得配本草》：热嗽，水亏火炎者禁用。"}]},{"ID":"20240902115530-1y8lydj","Type":"NodeParagraph","Properties":{"id":"20240902115530-1y8lydj","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【附方】1.止嗽散(《医学心悟》)，止咳化痰，疏表宣肺，主治感受风寒，咳痰不爽，或微恶风寒，头痛。2.月华丸(《医学心悟》)，滋阴降火，消痰祛瘀，止咳定喘，保肺平肝，杀虫。主治阴虚咳嗽，劳瘵久嗽。3.百部丸(《鸡峰普济方》)，主治寒邪壅肺，咳嗽微喘。4.百部汤(《本草汇言》)，主治久咳不已，咳吐痰涎，重亡津液，渐成肺痿，下午发热，甚则喘急。5.百部膏(《外科十法》)，外用治牛皮癣。6.百部丸(《小儿药证直诀》)，主治肺寒咳嗽，微有痰。7.百部散(《太平圣惠方》)，主治小儿咳嗽，头热。"}]},{"ID":"20240902115530-d56rovt","Type":"NodeParagraph","Properties":{"id":"20240902115530-d56rovt","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902115530-64xljtu","Type":"NodeParagraph","Properties":{"id":"20240902115530-64xljtu","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"1.《抱朴子》：治咳及杀虫。"}]},{"ID":"20240902115530-ltvvna6","Type":"NodeParagraph","Properties":{"id":"20240902115530-ltvvna6","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主咳嗽上气。"}]},{"ID":"20240902115530-nzi79x5","Type":"NodeParagraph","Properties":{"id":"20240902115530-nzi79x5","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：百部火炙酒渍，饮之疗咳嗽，亦主去虱。又主暴嗽。"}]},{"ID":"20240902115530-iv0k6be","Type":"NodeParagraph","Properties":{"id":"20240902115530-iv0k6be","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：治肺家热，上气，咳嗽，主润益肺。"}]},{"ID":"20240902115530-tm1wt56","Type":"NodeParagraph","Properties":{"id":"20240902115530-tm1wt56","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"5.《本草拾遗》：火炙浸酒空腹饮，去虫蚕咬，兼疥癣疮。"}]},{"ID":"20240902115530-vnnhner","Type":"NodeParagraph","Properties":{"id":"20240902115530-vnnhner","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治疳蛔及传尸骨蒸劳，杀蛔虫、寸白、蛲虫。"}]},{"ID":"20240902115530-gjmtjis","Type":"NodeParagraph","Properties":{"id":"20240902115530-gjmtjis","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：润肺，治肺热咳嗽；消痰定喘，止虚痨咳嗽，杀虫。"}]},{"ID":"20240902115530-7eiq3ic","Type":"NodeParagraph","Properties":{"id":"20240902115530-7eiq3ic","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"8.《中国药植志》：与猪蹄煮服，可以治风湿症。"}]},{"ID":"20240902115530-hyat0dt","Type":"NodeParagraph","Properties":{"id":"20240902115530-hyat0dt","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"9.广州部队《常用中草药手册》：治百日咳，肺结核，支气管炎，皮炎，湿疹，荨麻疹，脚癣，阿米巴痢疾。"}]},{"ID":"20240902115530-fh4qrpx","Type":"NodeParagraph","Properties":{"id":"20240902115530-fh4qrpx","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：百部，亦天门冬之类，故皆治肺病杀虫，但百部气温而不寒，寒嗽宜之;天门冬性寒而不热，热嗽宜之，此为异耳。"}]},{"ID":"20240902115530-gjghg99","Type":"NodeParagraph","Properties":{"id":"20240902115530-gjghg99","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》:百部根，《蜀本》云微寒，《日华子》言苦，《本经》言微温者误也。苦而下泄，故善降，肺气升则喘嗽，故善治咳嗽上气。能散肺热，故《药性论》主润肺。其性长于杀虫，传尸骨蒸劳，往往有虫，故亦主之。疳热有虫，及蛔虫、寸白虫、蛲虫，皆能杀之。百部味苦，脾虚胃弱人宜兼保脾安胃药同用，庶不伤胃气。"}]},{"ID":"20240902115530-9bqbypd","Type":"NodeParagraph","Properties":{"id":"20240902115530-9bqbypd","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"12.《本草述》：百部，乃先哲多谓其能治久嗽，损庵所云，治久嗽用以保肺者也。以此治暴嗽者，宜于肺气素虚之人，而随分寒热，有以佐之，如寒则生姜，热则和蜜，如治久嗽者加蜜，固为其虚而定有热也，岂浸无区别乎哉！13.《本草新编》：百部，杀虫而不耗气血，最有益于人，但其力甚微，用之不妨多也。然必与参、茯、芪、术同用为佳。大约用百部自一钱为始，可用至三、四钱止，既益肺胃脾之气，又能杀虫。倘痨病有传尸之虫者，须同地骨皮、沙参、丹皮、熟地、山茱共用为好。"}]},{"ID":"20240902115530-mj2rbbw","Type":"NodeParagraph","Properties":{"id":"20240902115530-mj2rbbw","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"14.《本草正义》：百部，善于杀虫，……即劳瘵家肺中有虫，亦是虚热，此其专药，似不可谓之性温，故甄权以为甘，《大明》以为苦，苏恭且以为微寒，缪氏《经疏》直谓《别录》为误，盖亦有理。然即曰微温，亦如紫菀温润，专治肺咳之例，究非温热之温，故凡有咳嗽，可通用之。本是草根，而多者可数十茎，性专下降，故治上气。濒湖谓百部亦天门冬之类，故皆治肺病，杀虫，但百部气温而不寒，寒嗽宜之，天门冬性寒而不热，热嗽宜之。颐谓濒湖此说，尚嫌太泥，实则门冬甘腻，止可治燥热之嗽，而肺有寒饮痰滞者，皆其大忌。百部虽曰微温，然润而不燥，且能开泄降气，凡嗽无不宜之，而尤为久嗽虚嗽必需良药。程钟龄《医学心悟》止嗽散，颇有捷效，功力实在紫菀、百部二味，宣通肺气；《千金方》谓一味取汁浓煎，可愈三十年嗽，有自来矣。石顽谓肺热劳瘵喘嗽，有寸白虫者宜之，蛲虫痢及传尸骨蒸多用之。又谓脾胃虚人弗用，以其味苦伤胃之故。颐谓专主上气，正其味苦之功，凡嗽皆肺气上逆，非此不治，若嫌其微伤胃土中和，以参、术补中之品相辅而行可也。"}]},{"ID":"20240902115530-1joctmc","Type":"NodeParagraph","Properties":{"id":"20240902115530-1joctmc","updated":"20240902115557"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902115532-8v7by6q","Type":"NodeThematicBreak","Properties":{"id":"20240902115532-8v7by6q","updated":"20240902115557"}},{"ID":"20240902115533-yfvsuyn","Type":"NodeParagraph","Properties":{"id":"20240902115533-yfvsuyn","updated":"20240902115557"}}]}