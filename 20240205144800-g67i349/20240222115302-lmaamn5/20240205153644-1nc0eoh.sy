deText","Data":"​"}]},{"ID":"20240717162448-16zkqx8","Type":"NodeParagraph","Properties":{"id":"20240717162448-16zkqx8","updated":"20240717162448"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"银杏树 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/银杏树 10-20240717162448-2k3o8sz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717161121-lslwvk4","Type":"NodeParagraph","Properties":{"id":"20240717161121-lslwvk4","updated":"20240717161310"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：白果为银杏树的果实；银杏树雌雄异株，只有雌树才能长出果实；"}]},{"ID":"20240717161312-emm5jo7","Type":"NodeParagraph","Properties":{"id":"20240717161312-emm5jo7","updated":"20240717161348"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：银杏树雌树的树叶开裂比较浅，雄树树叶开裂比较深；"}]},{"ID":"20240717161121-vlmd01h","Type":"NodeThematicBreak","Properties":{"id":"20240717161121-vlmd01h"}},{"ID":"20240902111611-6zqrm75","Type":"NodeParagraph","Properties":{"id":"20240902111611-6zqrm75","updated":"20240902111622"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白果"}]},{"ID":"20240902111611-6emassg","Type":"NodeParagraph","Properties":{"id":"20240902111611-6emassg","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"白果《中国药典》"}]},{"ID":"20240902111611-3rhqgjc","Type":"NodeParagraph","Properties":{"id":"20240902111611-3rhqgjc","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiGuǒ"}]},{"ID":"20240902111611-yl474rc","Type":"NodeParagraph","Properties":{"id":"20240902111611-yl474rc","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENGINKGO"}]},{"ID":"20240902111611-u22hiux","Type":"NodeParagraph","Properties":{"id":"20240902111611-u22hiux","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【别名】白果仁"}]},{"ID":"20240902111611-6lovfot","Type":"NodeParagraph","Properties":{"id":"20240902111611-6lovfot","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【来源】本品为银杏科植物银杏（白果树、公孙树）GinkgobilobaL.的干燥成熟种子。秋季种子成熟时采收，除去肉质外种皮，洗净，稍蒸或略煮后，烘干。"}]},{"ID":"20240902111611-softx67","Type":"NodeParagraph","Properties":{"id":"20240902111611-softx67","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性状】本品略呈椭圆形，一端稍尖，另端钝，长1.5～2.5cm，宽1～2cm，厚约1cm。表面黄白色或淡棕黄色，平滑，具2～3条棱线。中种皮（壳）骨质，坚硬。内种皮膜质，种仁宽卵球形或椭圆形，一端淡棕色，另一端金黄色，横断面外层黄色，胶质样，内层淡黄色或淡绿色，粉性，中间有空隙。无臭，味甘、微苦。"}]},{"ID":"20240902111611-vqvfpae","Type":"NodeParagraph","Properties":{"id":"20240902111611-vqvfpae","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末10g，加甲醇40ml，加热回流1小时，滤过，滤液蒸干，残渣加水15ml使溶解，通过少量棉花滤过，滤液通过聚酰胺小柱（80～100目，3g，内径10～15mm），用水70ml洗脱，洗脱液用醋酸乙酯振摇提取2次，每次40ml，合并醋酸乙酯液，蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取银杏内酯A、C对照品，加甲醇制成每1ml各含0.5mg的混合溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl，分别点于同一以含4％醋酸钠的羧甲基纤维素钠溶液为黏合剂的硅胶G薄层板上，以甲苯-醋酸乙酯-丙酮-甲醇（10：5：5：0.6）为展开剂，展开，取出，晾干，喷以醋酐，在140～160℃加热30分钟，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240902111611-1f5qplz","Type":"NodeParagraph","Properties":{"id":"20240902111611-1f5qplz","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902111611-vgqsrs1","Type":"NodeParagraph","Properties":{"id":"20240902111611-vgqsrs1","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"白果仁：取白果，除去杂质及硬壳，用时捣碎。"}]},{"ID":"20240902111611-4xq4rqu","Type":"NodeParagraph","Properties":{"id":"20240902111611-4xq4rqu","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"炒白果仁：取净白果仁，照清炒法（附录ⅡD）炒至有香气，用时捣碎。"}]},{"ID":"20240902111611-4um89vl","Type":"NodeParagraph","Properties":{"id":"20240902111611-4um89vl","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性味】甘、苦、涩，平；有毒。"}]},{"ID":"20240902111611-ylrs09y","Type":"NodeParagraph","Properties":{"id":"20240902111611-ylrs09y","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【归经】归肺经。"}]},{"ID":"20240902111611-dt1owez","Type":"NodeParagraph","Properties":{"id":"20240902111611-dt1owez","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【功能主治】敛肺定喘，止带浊，缩小便。用于痰多喘咳，带下白浊，遗尿尿频。"}]},{"ID":"20240902111611-ckypk9q","Type":"NodeParagraph","Properties":{"id":"20240902111611-ckypk9q","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。"}]},{"ID":"20240902111611-39awy04","Type":"NodeParagraph","Properties":{"id":"20240902111611-39awy04","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【注意】生食有毒。"}]},{"ID":"20240902111611-jx57dvr","Type":"NodeParagraph","Properties":{"id":"20240902111611-jx57dvr","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【备注】（1）服用过量中毒，可出现发烧、呕吐、腹泻、惊厥、抽搐、肢体强直、皮肤青紫、瞳孔散大、脉弱而乱，甚者昏迷不醒。解救方法：可洗胃，导泻，服鸡蛋清，活性炭，并对症处理：如皮肤青紫可给氧气或人工呼吸；出现抽搐可给镇静剂，遇有昏迷可吸入氨水，注射兴奋剂。"}]},{"ID":"20240902111611-hluqq6w","Type":"NodeParagraph","Properties":{"id":"20240902111611-hluqq6w","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902111611-dm3ufpo","Type":"NodeParagraph","Properties":{"id":"20240902111611-dm3ufpo","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"白果《*辞典》"}]},{"ID":"20240902111611-dz1l6vs","Type":"NodeParagraph","Properties":{"id":"20240902111611-dz1l6vs","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【出处】《日用本草》"}]},{"ID":"20240902111611-sc4x9xd","Type":"NodeParagraph","Properties":{"id":"20240902111611-sc4x9xd","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiGuǒ"}]},{"ID":"20240902111611-n9f22me","Type":"NodeParagraph","Properties":{"id":"20240902111611-n9f22me","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【别名】灵眼（《太仓州志》），佛指甲（《浙江通志》），佛指柑（《一握坤舆》）。"}]},{"ID":"20240902111611-4cdc6ed","Type":"NodeParagraph","Properties":{"id":"20240902111611-4cdc6ed","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【来源】为银杏科植物银杏的种子。10～11月采收成熟果实，堆放地上，或浸入水中，使肉质外种皮腐烂（亦可捣去外种皮），洗净，晒干。"}]},{"ID":"20240902111611-ifgasaq","Type":"NodeParagraph","Properties":{"id":"20240902111611-ifgasaq","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【原形态】银杏，又名：鸭脚（《宛陵集》），公孙树（《汝南圃史》），鸭掌树。落叶乔木，高可达40米。树干直立，树皮灰色。枝有长短两种，叶在短枝上簇生，在长枝上互生。叶片扇形，长4～8厘米，宽5～10厘米，先端中间2浅裂，基部楔形，叶脉平行，叉形分歧；叶柄长2.5～7厘米。花单性，雌雄异株；雄花呈下垂的短柔荑花序，4～6个生于短枝上的叶腋内，有多数雄蕊，花药2室，生于短柄的顶端；雌花每2～3个聚生于短枝上，每花有一长柄，柄端两叉，各生1心皮，胚珠附生于上，通常只有1个胚珠发育成熟。种子核果状，倒卵形或椭圆形，长2.5～3厘米，淡黄色，被白粉状蜡质；外种皮肉质，有臭气；内种皮灰白色，骨质，两侧有棱边；胚乳丰富，子叶2。花期4～5月。果期7～10月。"}]},{"ID":"20240902111611-c3z3c38","Type":"NodeParagraph","Properties":{"id":"20240902111611-c3z3c38","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的种子呈倒卵形或椭圆形，略扁，长径1.5～2.5厘米，短径1～1.5厘米。外壳（种皮）白色或灰白色，平滑，坚硬，边缘有2条棱线盘绕，顶端渐尖，基部有圆点状种柄痕。壳内有长而扁圆形的种仁，剥落时一端有淡棕色的薄膜。种仁淡黄色或黄绿色，内部白色，粉质。中心有空隙。靠近顶端有子叶2枚或更多。气微，味甘、微苦涩。以外壳白色、种仁饱满、里面色白者佳。全国大部分地区有产。主产广西、四川、河南、山东、湖北、辽宁等地。"}]},{"ID":"20240902111611-72mdwki","Type":"NodeParagraph","Properties":{"id":"20240902111611-72mdwki","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902111611-tqgo2az","Type":"NodeParagraph","Properties":{"id":"20240902111611-tqgo2az","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"种子含少量氰甙、赤霉素和动力精样物质。内胚乳中还分离出两种核糖核酸酶。一般组成为：蛋白质6.4、脂肪2.4、碳水化物36％，钙10毫克、磷218毫克、铁1毫克％，胡萝卜素320微克、核黄素50微克％，以及多种氨基酸。"}]},{"ID":"20240902111611-4xuvh4f","Type":"NodeParagraph","Properties":{"id":"20240902111611-4xuvh4f","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"外种皮含有毒成分白果酸、氢化白果酸、氢化白果亚酸、白果酚和白果醇。尚含天门冬素、甲酸、丙酸、丁酸、辛酸、廿九烷醇-10等。"}]},{"ID":"20240902111611-n266kff","Type":"NodeParagraph","Properties":{"id":"20240902111611-n266kff","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"花粉含多种氨基酸、谷氨酰胺、天门冬素、蛋白质、柠檬酸、蔗糖等。雄花含棉子糖可达鲜重的4％。"}]},{"ID":"20240902111611-0rt8atw","Type":"NodeParagraph","Properties":{"id":"20240902111611-0rt8atw","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【毒性】白果中毒，古代即有记载，近年来亦屡有报告。大多发生在入秋白果成熟季节，因炒食或煮食过量所致。以10岁以下小儿为多，成人偶亦有之。中毒者服食量小儿自7粒至150粒，成人自40粒至300粒不等。中毒出现的时间在食后1～12小时不等。症状以中枢神经系统为主，表现为呕吐，昏迷，嗜睡，恐惧，惊厥，或神志呆钝，体温升高，呼吸困难，面色青紫，瞳孔缩小或散大，对光反应迟钝，及腹痛、腹泻等，白细胞总数及嗜中性粒细胞升高。少数病例并有末梢神经功能障碍表现，呈两下肢完全性弛缓性瘫痪或轻瘫，触痛觉均消失。多数患者，经救治可获恢复，但也有少数因中毒重或抢救过迟而死亡。一般认为引起中毒及中毒的轻重，与年龄大小、体质强弱及服食景的多少有密切关系。年龄愈小中毒可能性愈大，中毒程度也愈重；服食量愈多，体质愈弱，则死亡率也愈高。"}]},{"ID":"20240902111611-m681dkj","Type":"NodeParagraph","Properties":{"id":"20240902111611-m681dkj","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【炮制】白果仁：拣净杂质，除去硬壳。熟白果：取拣净的白果，蒸熟、炒熟或煨熟，去壳。"}]},{"ID":"20240902111611-s7t8l5l","Type":"NodeParagraph","Properties":{"id":"20240902111611-s7t8l5l","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902111611-or2m4ic","Type":"NodeParagraph","Properties":{"id":"20240902111611-or2m4ic","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"甘苦涩，平，有毒。"}]},{"ID":"20240902111611-0jcj1uj","Type":"NodeParagraph","Properties":{"id":"20240902111611-0jcj1uj","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"①《饮膳正要》：\"味甘苦，无毒。\""}]},{"ID":"20240902111611-q56hfac","Type":"NodeParagraph","Properties":{"id":"20240902111611-q56hfac","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"味甘，平，性寒。\""}]},{"ID":"20240902111611-g3jijy7","Type":"NodeParagraph","Properties":{"id":"20240902111611-g3jijy7","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘苦，平，涩。\"\"熟食小苦微甘，性温，有小毒。\""}]},{"ID":"20240902111611-9c0pfkr","Type":"NodeParagraph","Properties":{"id":"20240902111611-9c0pfkr","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902111611-wj0kwlx","Type":"NodeParagraph","Properties":{"id":"20240902111611-wj0kwlx","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"入肺、肾经。"}]},{"ID":"20240902111611-xqgbok8","Type":"NodeParagraph","Properties":{"id":"20240902111611-xqgbok8","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入肺经。\""}]},{"ID":"20240902111611-y3va2sn","Type":"NodeParagraph","Properties":{"id":"20240902111611-y3va2sn","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手太阴、大阳经。\""}]},{"ID":"20240902111611-4gegim8","Type":"NodeParagraph","Properties":{"id":"20240902111611-4gegim8","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心、肺、肾三经。\""}]},{"ID":"20240902111611-3hbpkxr","Type":"NodeParagraph","Properties":{"id":"20240902111611-3hbpkxr","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902111611-h7c7plr","Type":"NodeParagraph","Properties":{"id":"20240902111611-h7c7plr","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"敛肺气，定喘嗽，止带浊，缩小便。治哮喘，痰嗽，白带，白浊，遗精，淋病，小便频数。"}]},{"ID":"20240902111611-0ixy7e9","Type":"NodeParagraph","Properties":{"id":"20240902111611-0ixy7e9","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"①《三元延寿书》：\"生食解酒。\""}]},{"ID":"20240902111611-5en519l","Type":"NodeParagraph","Properties":{"id":"20240902111611-5en519l","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"大疮不出头者，白果肉同糯米蒸合蜜丸：与核桃捣烂为膏服之，治噎食反胃，白浊、冷淋；捣烂敷太阳穴，止头风眼疼，又敷无名肿毒。\""}]},{"ID":"20240902111611-bgltq6c","Type":"NodeParagraph","Properties":{"id":"20240902111611-bgltq6c","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"煨熟食之，止小便频数。\""}]},{"ID":"20240902111611-lgad3bw","Type":"NodeParagraph","Properties":{"id":"20240902111611-lgad3bw","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"④《医学入门》：\"清肺胃浊气，化痰定喘，止咳。\""}]},{"ID":"20240902111611-7z6czxk","Type":"NodeParagraph","Properties":{"id":"20240902111611-7z6czxk","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"熟食温肺益气，定喘嗽，缩小便，止白浊；生食降痰，消毒杀虫；（捣）涂鼻面手足，去皶泡，皯黯，皴皱及疥癣疳匿、阴虱。\""}]},{"ID":"20240902111611-yc83fbw","Type":"NodeParagraph","Properties":{"id":"20240902111611-yc83fbw","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"补气养心，益肾滋阴，止咳除烦，生肌长肉，排脓拔毒，消疮疥疽瘤。\""}]},{"ID":"20240902111611-y12ezvn","Type":"NodeParagraph","Properties":{"id":"20240902111611-y12ezvn","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑦《本草便读》：\"上敛肺金除咳逆，下行湿浊化痰涎。\""}]},{"ID":"20240902111611-159gl9g","Type":"NodeParagraph","Properties":{"id":"20240902111611-159gl9g","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑧《现代实用中药》：\"核仁治喘息，头晕，耳鸣，慢性淋浊及妇人带下。果肉捣碎作贴布剂，有发泡作用；菜油浸一年以上，用于肺结核。\""}]},{"ID":"20240902111611-cyzhgse","Type":"NodeParagraph","Properties":{"id":"20240902111611-cyzhgse","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑨《山东中药》：\"治遗精，遗尿。\""}]},{"ID":"20240902111611-949smui","Type":"NodeParagraph","Properties":{"id":"20240902111611-949smui","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；捣汁或入丸、散。外用：捣敷。"}]},{"ID":"20240902111611-j535bku","Type":"NodeParagraph","Properties":{"id":"20240902111611-j535bku","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902111611-gvu0bsm","Type":"NodeParagraph","Properties":{"id":"20240902111611-gvu0bsm","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"有实邪者忌服。"}]},{"ID":"20240902111611-kqvhna2","Type":"NodeParagraph","Properties":{"id":"20240902111611-kqvhna2","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"①《日用本草》：\"多食壅气动风。小儿多食昏霍，发惊引疳。同鳗鲡鱼食患软风。\""}]},{"ID":"20240902111611-u5hn86f","Type":"NodeParagraph","Properties":{"id":"20240902111611-u5hn86f","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"多食令人胪胀。\""}]},{"ID":"20240902111611-p0kxrps","Type":"NodeParagraph","Properties":{"id":"20240902111611-p0kxrps","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902111611-g2stz7t","Type":"NodeParagraph","Properties":{"id":"20240902111611-g2stz7t","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"①治鼩喘：白果二十一枚（去壳砸碎，炒黄色），麻黄三钱，苏子二钱，甘草一钱，款冬花三钱，杏仁一钱五分（去皮尖），桑皮三钱（蜜炙），黄芩一钱五分（微炒），法制半夏三钱（如无，用甘草汤泡七次，去脐用）。上用水三钟，煎二钟，作二服，每服一钟，不拘时。（《摄生众妙方》定喘汤）"}]},{"ID":"20240902111611-44omdek","Type":"NodeParagraph","Properties":{"id":"20240902111611-44omdek","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"②治梦遗：银杏三粒。酒煮食，连食四至五日。（《湖南药物志》）"}]},{"ID":"20240902111611-kb3wd5q","Type":"NodeParagraph","Properties":{"id":"20240902111611-kb3wd5q","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"③治赤白带下，下元虚惫：白果、莲肉、江米各五钱。为末，用乌骨鸡一只，去肠盛药煮烂，空心食之。（《濒湖集简方》）"}]},{"ID":"20240902111611-hmmuzeq","Type":"NodeParagraph","Properties":{"id":"20240902111611-hmmuzeq","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"④治小儿腹泻：白果二个，鸡蛋一个。将白果去皮研末，鸡蛋打破一孔，装入白果末，烧熟食。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240902111611-1pyn5rp","Type":"NodeParagraph","Properties":{"id":"20240902111611-1pyn5rp","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑤治诸般肠风脏毒：生银杏四十九个。去壳膜，烂研，入百药煎末，丸如弹子大。每服三丸，空心细嚼米饮下。（《证治要诀》）"}]},{"ID":"20240902111611-rf0x11r","Type":"NodeParagraph","Properties":{"id":"20240902111611-rf0x11r","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑥治牙齿虫露：生银杏，每食后嚼一个，良。（《永类钤方》）"}]},{"ID":"20240902111611-3tc8nok","Type":"NodeParagraph","Properties":{"id":"20240902111611-3tc8nok","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑦治鼻面酒皶：银杏、酒酻糟。同嚼烂，夜涂旦洗。（《医林集要》）"}]},{"ID":"20240902111611-d44e8jk","Type":"NodeParagraph","Properties":{"id":"20240902111611-d44e8jk","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑧治头面癣疮：生白果仁切断，频擦取效。（《秘传经验方》）"}]},{"ID":"20240902111611-35d7ndr","Type":"NodeParagraph","Properties":{"id":"20240902111611-35d7ndr","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑨治下部疳疮：生白果，杵，涂之。（《济急仙方》）"}]},{"ID":"20240902111611-kyudl5v","Type":"NodeParagraph","Properties":{"id":"20240902111611-kyudl5v","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"⑩治乳痈溃烂：银杏半斤。以四两研酒服之，以四两研敷之。（《救急易方》）"}]},{"ID":"20240902111611-9hhvdz2","Type":"NodeParagraph","Properties":{"id":"20240902111611-9hhvdz2","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗肺结核:对改善症状有一些作用。服药后部分病人的发热、盗汗、咳嗽、气喘、咳血、食欲不振等，可见不同程度的好转。用法：在中秋节前夕，将半青带黄的银杏（选取外表丝毫无损的大颗粒）摘下，不用水洗，亦不去柄，随即浸入生菜油内，浸满100天后即可使用。每日早、中、晚各服1粒（小儿酌减），饭前服，视病情连服1～3个月"}]},{"ID":"20240902111611-tx8rqlu","Type":"NodeParagraph","Properties":{"id":"20240902111611-tx8rqlu","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902111611-wqqkcds","Type":"NodeParagraph","Properties":{"id":"20240902111611-wqqkcds","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"白果《中华本草》"}]},{"ID":"20240902111611-fsi46rl","Type":"NodeParagraph","Properties":{"id":"20240902111611-fsi46rl","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902111611-yeqivaj","Type":"NodeParagraph","Properties":{"id":"20240902111611-yeqivaj","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"出自1.《日用本草》。"}]},{"ID":"20240902111611-1dfpcpa","Type":"NodeParagraph","Properties":{"id":"20240902111611-1dfpcpa","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：银杏，原生江南，以宣城者为胜，树高二、三丈，叶薄，纵理俨如鸭掌形，有刻缺，面绿背淡，二月开花成簇，青白色，二更开花，随即卸落，人罕见之。一枝结子百十，状如柿子，经霜乃熟，烂去肉取核为果，其核两头尖，其仁嫩时绿色，久则黄。"}]},{"ID":"20240902111611-8vax9v3","Type":"NodeParagraph","Properties":{"id":"20240902111611-8vax9v3","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"3.《随息居饮食谱》：中银杏毒者，昏晕如醉，白果壳或白鲞头煎汤解之。食或太多，甚至不救，慎生者不可不知也。"}]},{"ID":"20240902111611-1to6hwu","Type":"NodeParagraph","Properties":{"id":"20240902111611-1to6hwu","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"4.《四川中药"}]},{"ID":"20240902111611-8h7lwob","Type":"NodeParagraph","Properties":{"id":"20240902111611-8h7lwob","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiGuǒ"}]},{"ID":"20240902111611-cdh0ect","Type":"NodeParagraph","Properties":{"id":"20240902111611-cdh0ect","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【别名】鸭脚子、灵眼、佛指甲、佛指柑"}]},{"ID":"20240902111611-juwmqdx","Type":"NodeParagraph","Properties":{"id":"20240902111611-juwmqdx","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902111611-xvcgpl0","Type":"NodeParagraph","Properties":{"id":"20240902111611-xvcgpl0","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"药材基源：为银杏科植物银杏的种子。"}]},{"ID":"20240902111611-6lmmd1p","Type":"NodeParagraph","Properties":{"id":"20240902111611-6lmmd1p","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：GinkgobilobaL."}]},{"ID":"20240902111611-dl15v2r","Type":"NodeParagraph","Properties":{"id":"20240902111611-dl15v2r","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋末种子成熟后采收，除去肉质外种皮，洗净，晒干，用时打碎取种仁。"}]},{"ID":"20240902111611-m1afhjq","Type":"NodeParagraph","Properties":{"id":"20240902111611-m1afhjq","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【原形态】银杏，落叶乔木，高可达40m。枝有有长枝与短枝，幼树树皮淡灰褐色，浅纵裂，老则灰褐色，深纵裂。叶在长枝上螺旋状散生，在短枝上3-5（-8）簇生；柄长3-10cm；叶片扇形，淡绿色，无毛，有多数2叉状并列的细脉，上缘宽5-8cm，浅波状，有时中央浅裂或深裂。雌雄异株，花单性，稀同株；球花生于短枝顶端的鳞片状叶的腋内；雄球花成柔荑花序状，下垂；雌球花有长梗，梗端常分2叉，每叉顶生一盘状珠座，每珠座生一胚珠，仅一个发育成种子。种子核果状，椭圆形至近球形，长2.5-3.5cm，径约2cm；外种皮肉质，有白粉，熟时淡黄色或橙黄色；中种皮骨质，白色，具2-3棱；内种皮膜质，胚乳丰富。花期3-4月，种子成熟期9-10月。"}]},{"ID":"20240902111611-usnf87h","Type":"NodeParagraph","Properties":{"id":"20240902111611-usnf87h","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902111611-ju2xlp6","Type":"NodeParagraph","Properties":{"id":"20240902111611-ju2xlp6","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔500-1000m的酸性土壤，排水良好地带的天然林中。"}]},{"ID":"20240902111611-ekmrevs","Type":"NodeParagraph","Properties":{"id":"20240902111611-ekmrevs","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于北自沈阳，南达广州，东起华东，西南至贵州、云南都有栽培。"}]},{"ID":"20240902111611-wvrlsuq","Type":"NodeParagraph","Properties":{"id":"20240902111611-wvrlsuq","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902111611-ea1hrng","Type":"NodeParagraph","Properties":{"id":"20240902111611-ea1hrng","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"1.生物学特性喜温暖湿润气候，喜阳、耐寒、耐旱、忌涝。在年平均温度10-18℃，冬季绝对最低气温不低于零下20℃，年降雨量600-1500mm的气候及土层深厚的砂质壤地中生长良好。不宜在阴坡、积水或盐分太重的地壤中栽种。"}]},{"ID":"20240902111611-q21c5pk","Type":"NodeParagraph","Properties":{"id":"20240902111611-q21c5pk","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.栽培技术用种子、分株和嫁接繁殖。种子繁殖种子秋季采收后，当年播种或翌年春播种，春播需混砂催芽，播种量每1hm600-675kg，横向开沟，沟距25-30cm，深4cm，每隔10cm播1粒种子，覆土3-4cm，当年苗高25-30cm，秋季落叶后可移栽。分株繁殖从壮龄雌性母树根蘖苗中选留4-5株健壮苗，高1m左右时移栽。嫁接繁殖在30年生，长势旺盛而丰产的雌株上选2-3年生的枝条为接穗，砧木用种子繁殖的实生苗，采用切接或皮下枝接法嫁接。定植，一般早春定植，株行距5-6cm或7-8m，定植前按树苗大小开穴，穴深40-50cm，宽60-70cm，起苗后如主根过长，可稍加修剪。穴栽，填土浇水踏实，然后培土成丘。按总数的5%配置雄树，雄树按风向分散栽植，以利授粉。"}]},{"ID":"20240902111611-p1vp3x7","Type":"NodeParagraph","Properties":{"id":"20240902111611-p1vp3x7","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"3.田间管理种子发芽后，4-5月除草1次，可追施人畜粪水或氮素化肥催苗。7月和10月各除草后追施人畜粪水或土杂肥。定植后每年春季发芽前及秋季落叶后，在距主干60-100cm外开环状沟，施人畜粪水各1次。嫁接后4-5年如分枝过多过密，需适当修剪，以利生长。"}]},{"ID":"20240902111611-6ctfys6","Type":"NodeParagraph","Properties":{"id":"20240902111611-6ctfys6","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"4.病虫害防治苗木茎腐病，一般在雨季后发生。病苗基部初现褐色斑块，以后韧皮部腐烂碎裂，苗木枯死。防治方法，夏季应搭荫棚，插树枝或在行间盖草保墒、遮荫。虫害有天牛，可用人工捕杀或放天敌肿腿蜂进行生物防治。樟蚕可于冬刮除树上越冬卵，6-7月摘除蚕蛹，以及用马拉松1000倍液喷杀初孵化幼虫。另有铜绿金龟子、黑胸散白蚁为害。"}]},{"ID":"20240902111611-irit979","Type":"NodeParagraph","Properties":{"id":"20240902111611-irit979","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902111611-d6pza3p","Type":"NodeParagraph","Properties":{"id":"20240902111611-d6pza3p","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"性状鉴定除去外种皮的种子卵形或椭圆形，长1.5-3cm，宽1-2.2cm。外壳（中种皮骨质，光滑，表面黄白色或淡棕黄色，基部有一圆点状突起，边缘各有1条棱线，偶见3条棱线。内种皮膜质，红褐色或淡黄棕色。种仁扁球形，淡黄色，胚乳肥厚，粉质，中间有空隙；胚极小。气无，味微甘、苦。以壳色黄白、种仁饱满，断面色淡黄者为佳。"}]},{"ID":"20240902111611-1vhw9ti","Type":"NodeParagraph","Properties":{"id":"20240902111611-1vhw9ti","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别粉末特征淡黄棕色。①淀粉粒单粒攻圆形、圆形或卵圆形，长5-18μm脐点点状，裂缝状、头鸟状或三叉状，大粒可见层纹。②石细胞类圆形、长圆形或贝壳形，长61-322μm，直径27-125μm，壁厚，纹孔及孔沟明显，可见层纹，有的胞腔含黄棕色或红棕色物。③内种皮薄壁细胞类方形、长方形或多角形。④胚乳细胞类圆形或长圆形，含淀粉粒。⑤具缘纹孔管胞多破碎，直径33-72μm，末端渐尖或钝圆。"}]},{"ID":"20240902111611-5crx7ho","Type":"NodeParagraph","Properties":{"id":"20240902111611-5crx7ho","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含有毒成分，为4-O-甲基吡哆醇（4-O-methylpyridoxine）,称为银杏毒素（ginkgotoxin）。还含6-（8-十五碳烯基）-2，4-二羟基苯甲酸[6-（pentadec-8-enyl）-2,4-dihy-droxybenzoicacid],6-十三烷基-2，4-二羟基苯甲酸（6-tridecy-2,4-dihydroxybenzoicacid）,腰果酸（anacaridcacid和钾、磷、镁、钙、锌、铜等25种无素）。种仁含蛋白质，脂肪、碳水化合物、糖等。"}]},{"ID":"20240902111611-61czx7m","Type":"NodeParagraph","Properties":{"id":"20240902111611-61czx7m","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902111611-5jivzkv","Type":"NodeParagraph","Properties":{"id":"20240902111611-5jivzkv","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"1.抗菌作用白果肉、白果汁、白果酚，尤其是白果酸体外试验时对人型结核杆菌和牛型结核杆菌有抑制作用。白果提取物150-200mｇ／kｇ／天灌胃对感染人型结核杆菌的豚鼠有明显的治疗作用。亦有报道，白果汁、白果肉、白果酚、白果酸，在体内试验(小鼠及豚鼠的实验治疗)，无显着疗效，或毒性太大。油浸白果之果浆含有的抗菌成分对若干种革兰氏阳性及阴性细菌均有作用(葡萄球菌、链球菌、白喉杆菌、炭疽杆菌、枯草杆菌、大肠杆菌、伤寒杆菌等)，对结核杆菌作用极显着。此菌成分经加热85℃则对大肠杆菌失去作用，而经100℃30分钟对结核扦菌仍有抑制性的作用。白果的水浸液(1：2)在体外对堇色毛癣菌、奥杜盎氏小芽胞癣菌、星形奴犬氏菌等7种皮肤真菌表现为抑菌作用。白果果肉的抗菌力较果皮强。"}]},{"ID":"20240902111611-cxaqz1u","Type":"NodeParagraph","Properties":{"id":"20240902111611-cxaqz1u","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.对呼吸系统的作用白果乙醇提取物给小鼠腹腔注射，可使呼吸道酚红排泌增加，似有祛痰作用。对离体豚鼠气管平滑肌表现有微弱的松弛作用。"}]},{"ID":"20240902111611-x23o52c","Type":"NodeParagraph","Properties":{"id":"20240902111611-x23o52c","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"3.对循环系统的作用白果二酚500mｇ／kｇ对兔有短暂的降压作用。毛细血管的通透性增加，以豚鼠最为明显，其次是大鼠和兔，大鼠下肢灌流实验表明，白果二酚有组胺释放作用、引起毛细管通透性增加，导致水肿，此作用又为扑尔敏所对抗。"}]},{"ID":"20240902111611-itav299","Type":"NodeParagraph","Properties":{"id":"20240902111611-itav299","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"4.对自由基的清除作用：银杏外种皮水溶性成分能清除在有氧存在下黄嘌呤氧化酶系统产生的超氧自由基，抑制化学发光；老年小鼠口服12天后，能阻止脾脏组织的老年色素颗粒形成，并使已形成的色素颗粒变得分散，数量减少。"}]},{"ID":"20240902111611-8hpz4wg","Type":"NodeParagraph","Properties":{"id":"20240902111611-8hpz4wg","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"5.其他作用：新鲜白果中提出的白果酚甲，对离休兔肠有麻痹作用，使离体子宫收缩，对蛙心无影响。白果种仁含无氮的中性成分，给小鼠皮下注射6mg/13g，半小时后可致惊厥，延髓麻痹，随即呼吸、心跳停止而死。旧说其中含氢氰酸，能镇咳并致中毒，但未能检得氢氰酸的存在；也有说不能证明白果中含有对小鼠引起惊厥的物质。白果肉尚有收敛作用。"}]},{"ID":"20240902111611-pk922l5","Type":"NodeParagraph","Properties":{"id":"20240902111611-pk922l5","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【毒性】有谓白果仁中提得一种中性结晶成分，对小白鼠有致惊厥作用，后来实验未能证实含有此种物质，对动物大量饲以白果，亦未获得任何特殊的中毒现象。有谓外种皮中含有引起皮炎的银杏毒(Ginkgotoxin)，与斑蝥素类似。非洲人榨果汁后，往往引起皮肤刺激症状如脱皮、触痛，口服产生强烈胃肠道刺激。给小鼠饲以大量白果粉或每日给豚鼠灌胃白果肉粗提物酸性成分150-200mｇ／kｇ，共60天，又出现食欲不振、体重减轻，不等程度的肝损害、肾小球肾炎，甚至死亡。白果酸有溶血作用，白果仁所含的中性成分，小鼠皮下注射6mｇ／kｇ又引起惊厥和死亡。"}]},{"ID":"20240902111611-8io4cru","Type":"NodeParagraph","Properties":{"id":"20240902111611-8io4cru","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902111611-frfa5vv","Type":"NodeParagraph","Properties":{"id":"20240902111611-frfa5vv","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"1.白果仁：拣净杂质，除去硬壳。"}]},{"ID":"20240902111611-y00bumd","Type":"NodeParagraph","Properties":{"id":"20240902111611-y00bumd","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.熟白果：取拣净的白果，蒸熟、炒熟或煨熟，去壳。"}]},{"ID":"20240902111611-d5jn2gg","Type":"NodeParagraph","Properties":{"id":"20240902111611-d5jn2gg","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【性味】甘；苦；涩；性平；小毒"}]},{"ID":"20240902111611-bqqe4od","Type":"NodeParagraph","Properties":{"id":"20240902111611-bqqe4od","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【归经】肺；肾经"}]},{"ID":"20240902111611-4lhjxc1","Type":"NodeParagraph","Properties":{"id":"20240902111611-4lhjxc1","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【功能主治】敛肺定喘；止带缩尿。主哮喘痰嗽；白带；白浊；遗精；尿频；无名肿毒；皶鼻；癣疮"}]},{"ID":"20240902111611-eq14bvc","Type":"NodeParagraph","Properties":{"id":"20240902111611-eq14bvc","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；或捣汁。外用：适量，捣敷；或切片涂。"}]},{"ID":"20240902111611-fs25wmd","Type":"NodeParagraph","Properties":{"id":"20240902111611-fs25wmd","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【注意】1.有实邪者忌服。生食或炒食过量可致中毒，小儿误服中毒尤为常见。"}]},{"ID":"20240902111611-18052te","Type":"NodeParagraph","Properties":{"id":"20240902111611-18052te","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【附方】定喘汤《摄生众妙方》；易黄汤《傅青主女科》；"}]},{"ID":"20240902111611-37tsu7b","Type":"NodeParagraph","Properties":{"id":"20240902111611-37tsu7b","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902111611-uhig187","Type":"NodeParagraph","Properties":{"id":"20240902111611-uhig187","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：银杏，宋初始着名，而修本草者不收，近时方药亦时用之。其气薄味厚，性涩而收，益肺气，定喘嗽，缩小便，又能杀虫消毒。然食多则收令太过，令人气壅胪胀昏顿。故《物类相感志》言银杏能醉人，而《三元延寿书》言昔有饥者，同以白果代饭食饱，次日皆死也。熟食温肺益气，定喘嗽，缩小便，止白浊；生食降痰，消毒杀虫；(捣)涂鼻面手足，去疹泡，皴皱及疥癣疳、阴虱。"}]},{"ID":"20240902111611-vajxy57","Type":"NodeParagraph","Properties":{"id":"20240902111611-vajxy57","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"2.《三元延寿书》：生食解酒。"}]},{"ID":"20240902111611-1ev1mp2","Type":"NodeParagraph","Properties":{"id":"20240902111611-1ev1mp2","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"3.《滇南本草》：大疮不出头者，白果肉同糯米蒸合蜜丸；与核桃捣烂为膏服之，治噎食反胃，白浊、冷淋；捣烂敷太阳穴，止头风眼疼，又敷无名肿毒。"}]},{"ID":"20240902111611-kdh61us","Type":"NodeParagraph","Properties":{"id":"20240902111611-kdh61us","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"4.《品汇精要》：煨熟食之，止小便频数。"}]},{"ID":"20240902111611-wsxk0pq","Type":"NodeParagraph","Properties":{"id":"20240902111611-wsxk0pq","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"5.《医学入门》：清肺胃浊气，化痰定喘，止咳。"}]},{"ID":"20240902111611-xm0xzcb","Type":"NodeParagraph","Properties":{"id":"20240902111611-xm0xzcb","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"6.《本草再新》：补气养心，益肾滋阴，止咳除烦，生肌长肉，排脓拔毒，消疮疥疽瘤。"}]},{"ID":"20240902111611-hanb00x","Type":"NodeParagraph","Properties":{"id":"20240902111611-hanb00x","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"7.《本草便读》：上敛肺金除咳逆，下行湿浊化痰涎。"}]},{"ID":"20240902111611-zyhavse","Type":"NodeParagraph","Properties":{"id":"20240902111611-zyhavse","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"8.《现代实用中药》：核仁治喘息，头晕，耳鸣，慢性淋浊及妇人带下。果肉捣碎作贴布剂，有发泡作用；菜油浸一年以上，用于肺结核。"}]},{"ID":"20240902111611-wvs64zn","Type":"NodeParagraph","Properties":{"id":"20240902111611-wvs64zn","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"9.《山东中药》：治遗精，遗尿。"}]},{"ID":"20240902111611-i9vvk6k","Type":"NodeParagraph","Properties":{"id":"20240902111611-i9vvk6k","updated":"20240902111628"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902111612-fifwmbq","Type":"NodeThematicBreak","Properties":{"id":"20240902111612-fifwmbq","updated":"20240902111628"}},{"ID":"20240902111613-g06tg62","Type":"NodeParagraph","Properties":{"id":"20240902111613-g06tg62","updated":"20240902111628"}}]}