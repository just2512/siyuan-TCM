ldren":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 552px;","style":"width: 542px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"前胡 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/前胡 20-20240710112528-xbmdh6p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 542px;\" parent-style=\"width: 552px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 602px;","style":"width: 592px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"前胡 (22)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/前胡 22-20240710112703-bab8vnu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710113245-7sf1vsm","Type":"NodeParagraph","Properties":{"id":"20240710113245-7sf1vsm","updated":"20240830153929"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 630px;","style":"width: 620px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"前胡 (26)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/前胡 26-20240710113345-bm0qfya.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 620px;\" parent-style=\"width: 630px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 476px;","style":"width: 466px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"前胡 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/前胡 25-20240710113245-fiz4a8v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 466px;\" parent-style=\"width: 476px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807094304-it6pctr","Type":"NodeParagraph","Properties":{"id":"20240807094304-it6pctr","updated":"20240913155923"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：药用上白花前胡比紫花前胡更好；"}]},{"ID":"20240802151356-f03si2z","Type":"NodeParagraph","Properties":{"id":"20240802151356-f03si2z","updated":"20240913155924"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：当归与独活、前胡极为相似，外观鉴别网上辨别方法少且混杂，部分说辞略有矛盾，难以信服，因未找到可信服的辨别方法，已尽量筛选，如有错误烦请指正；"}]},{"ID":"20240913155925-hgk1hra","Type":"NodeParagraph","Properties":{"id":"20240913155925-hgk1hra","updated":"20240913160053"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"十注：防风、升麻、当归、前胡、独活、白芷外形相似，虽附有辨别方法，但辨别仍有难度；请在专业的老师指导下分辨。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240710113352-6on0n21","Type":"NodeThematicBreak","Properties":{"id":"20240710113352-6on0n21"}},{"ID":"20240830154005-yujvwxm","Type":"NodeParagraph","Properties":{"id":"20240830154005-yujvwxm","updated":"20240830154015"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：前胡"}]},{"ID":"20240830154005-hfgayq5","Type":"NodeParagraph","Properties":{"id":"20240830154005-hfgayq5","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡《中国药典》"}]},{"ID":"20240830154005-g44m9gm","Type":"NodeParagraph","Properties":{"id":"20240830154005-g44m9gm","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiánHú"}]},{"ID":"20240830154005-s6ji6au","Type":"NodeParagraph","Properties":{"id":"20240830154005-s6ji6au","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXPEUCEDANI"}]},{"ID":"20240830154005-diz218k","Type":"NodeParagraph","Properties":{"id":"20240830154005-diz218k","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【来源】本品为伞形科植物白花前胡PeucedanumpraeruptorumDunn或紫花前胡PeucedanumdecursivumMaxim.的干燥根。冬季至次春茎叶枯萎或未抽花茎时采挖，除去须根，洗净，晒干或低温干燥。"}]},{"ID":"20240830154005-n9aj8c3","Type":"NodeParagraph","Properties":{"id":"20240830154005-n9aj8c3","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830154005-f5vadfr","Type":"NodeParagraph","Properties":{"id":"20240830154005-f5vadfr","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"白花前胡：呈不规则的圆柱形、圆锥形或纺锤形，稍扭曲，下部常有分枝，长3～15cm，直径1～2cm。表面黑褐色或灰黄色，根头部多有茎痕及纤维状叶鞘残基，上端有密集的细环纹，下部有纵沟、纵皱纹及横向皮孔。质较柔软，干者质硬，可折断，断面不整齐，淡黄白色，皮部散有多数棕黄色油点，形成层环纹棕色，射线放射状。气芳香，味微苦、辛。"}]},{"ID":"20240830154005-lsr5qzj","Type":"NodeParagraph","Properties":{"id":"20240830154005-lsr5qzj","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"紫花前胡：根头顶端有的有残留茎基，茎基周围常有膜状叶鞘基部残留。断面类白色，射线不明显。"}]},{"ID":"20240830154005-12eq1z9","Type":"NodeParagraph","Properties":{"id":"20240830154005-12eq1z9","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830154005-mjxzxup","Type":"NodeParagraph","Properties":{"id":"20240830154005-mjxzxup","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"（1）取本品粉末1g，加乙醚10ml，浸渍2小时后，取乙醚液2滴，分别点于两张小滤纸片上，置紫外光灯（365nm）下观察，显淡天蓝色荧光。然后滴加15％氢氧化钠溶液数滴，2分钟后荧光消失。将一张滤纸片避光保存，另一张滤纸片曝光，约3小时后，置紫外光灯（365nm）下观察，曝光者天蓝色荧光加强，避光者不显荧光。"}]},{"ID":"20240830154005-7sokjg3","Type":"NodeParagraph","Properties":{"id":"20240830154005-7sokjg3","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末5g，加甲醇30ml，加热回流10分钟，滤过。取滤液2ml，蒸干，残渣加冰醋酸1ml使溶解，再加乙酰氯5滴和氯化锌数粒，置水浴中加热1～2分钟，溶液显红色。"}]},{"ID":"20240830154005-t9ko4ur","Type":"NodeParagraph","Properties":{"id":"20240830154005-t9ko4ur","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830154005-afk86ki","Type":"NodeParagraph","Properties":{"id":"20240830154005-afk86ki","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡：除去杂质，洗净，润透，切薄片，晒干。"}]},{"ID":"20240830154005-rjlfruy","Type":"NodeParagraph","Properties":{"id":"20240830154005-rjlfruy","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"蜜前胡：取前胡片，照蜜炙法（附录ⅡD）炒至不粘手（每100斤用炼蜜20斤）。"}]},{"ID":"20240830154005-2hlwepr","Type":"NodeParagraph","Properties":{"id":"20240830154005-2hlwepr","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性味】苦、辛，微寒。"}]},{"ID":"20240830154005-uuksz6r","Type":"NodeParagraph","Properties":{"id":"20240830154005-uuksz6r","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【归经】归肺经。"}]},{"ID":"20240830154005-alkh88l","Type":"NodeParagraph","Properties":{"id":"20240830154005-alkh88l","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【功能主治】散风清热，降气化痰。用于风热咳嗽痰多，痰热喘满，咯痰黄稠。"}]},{"ID":"20240830154005-27d8pc7","Type":"NodeParagraph","Properties":{"id":"20240830154005-27d8pc7","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240830154005-frdykur","Type":"NodeParagraph","Properties":{"id":"20240830154005-frdykur","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防霉，防蛀。"}]},{"ID":"20240830154005-4655bca","Type":"NodeParagraph","Properties":{"id":"20240830154005-4655bca","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830154005-j661h01","Type":"NodeParagraph","Properties":{"id":"20240830154005-j661h01","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡《*辞典》"}]},{"ID":"20240830154005-vc0ti8w","Type":"NodeParagraph","Properties":{"id":"20240830154005-vc0ti8w","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【出处】《雷公炮炙论》"}]},{"ID":"20240830154005-2q5yx7i","Type":"NodeParagraph","Properties":{"id":"20240830154005-2q5yx7i","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiánHú"}]},{"ID":"20240830154005-e42elb5","Type":"NodeParagraph","Properties":{"id":"20240830154005-e42elb5","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【来源】为伞形科植物白花前胡或紫花前胡的根。秋、冬地上部分枯萎时采收，挖出主根，除去茎叶、须根、泥土，晒干或炕干。"}]},{"ID":"20240830154005-q4jom0d","Type":"NodeParagraph","Properties":{"id":"20240830154005-q4jom0d","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830154005-tf0ow6o","Type":"NodeParagraph","Properties":{"id":"20240830154005-tf0ow6o","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①白花前胡，又名：姨妈菜、罗鬼菜（李宗防《黔志》），水前胡（《植物名实图考》），野芹菜、岩风、南石防风，坡地石防风、鸡脚前胡、岩川芎。"}]},{"ID":"20240830154005-wo414ux","Type":"NodeParagraph","Properties":{"id":"20240830154005-wo414ux","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～120厘米。根圆锥形。茎直立，单一，上部分枝。基生叶和下部叶纸质，圆形至宽卵形，长5～9厘米，2～3回三出式羽状分裂，最终裂片菱状倒卵形，不规则羽状分裂，有圆锯齿；叶柄长6～20厘米，基部有宽鞘，抱茎；顶端叶片生在膨大的叶鞘上。复伞形花序，顶生或腋生，总伞梗7～18，不等长，无总苞，小总苞片条状披针形，有缘毛；花萼5，短三角形；花瓣白色，广卵形或近于圆形，先端有向内曲的舌片；雄蕊5，花药卵圆形；子房有毛，花柱2枚极短。双悬果椭圆形或卵圆形，光滑无毛，背棱和中棱线状，侧棱有窄翅。花期8～10月。果期10～11月。"}]},{"ID":"20240830154005-n3rp2p8","Type":"NodeParagraph","Properties":{"id":"20240830154005-n3rp2p8","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"野生于向阳山坡草丛中。分布山东、陕西、安徽、江苏、浙江、福建、广西、江西、湖南、湖北、四川等地。"}]},{"ID":"20240830154005-ix3hf8r","Type":"NodeParagraph","Properties":{"id":"20240830154005-ix3hf8r","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②紫花前胡，又名：土当归（《植物名实图考》），鸭脚七、野辣菜、山芫荽、桑根子苗、鸭脚前胡、鸭脚板。"}]},{"ID":"20240830154005-cxfssis","Type":"NodeParagraph","Properties":{"id":"20240830154005-cxfssis","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"多年生草本，高70～140厘米。根圆锥形，棕黄色至棕褐色，浓香。茎直立，单一，圆形，表面有棱，上部少分枝。基生叶和下部叶纸质，三角状宽卵形，1～2回羽状全裂，1回裂片3～5片，再3～5裂，叶轴翅状，顶生裂片和侧生裂片基部连合，基部下延成翅状，最终裂片狭卵形或长椭圆形，有尖齿；茎上部叶简化成叶鞘。复伞形花序顶生，总伞梗12～20枚，不等长；总苞片1～2片，卵形，紫色；小伞梗多数；小总苞片披针形；萼齿5，三角形；花瓣深紫色，长卵形，先端渐尖，有1条中肋；雄蕊5，花药卵形；子房无毛，花柱2枚，极短。双悬果椭圆形，长4～7毫米，背棱和中棱较尖锐，呈丝线状，侧棱发展成狭翅。花期8～9月。果期9～10月。"}]},{"ID":"20240830154005-cea9qlo","Type":"NodeParagraph","Properties":{"id":"20240830154005-cea9qlo","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"野生在山坡路旁或丛林下。分布山东、河南、安徽、江苏、浙江、广西、江西、湖南、湖北、四川、台湾等地。"}]},{"ID":"20240830154005-9sikk75","Type":"NodeParagraph","Properties":{"id":"20240830154005-9sikk75","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830154005-b214ybt","Type":"NodeParagraph","Properties":{"id":"20240830154005-b214ybt","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①白花前胡"}]},{"ID":"20240830154005-urmnvo2","Type":"NodeParagraph","Properties":{"id":"20240830154005-urmnvo2","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"又名：云前胡、信前胡。主根形状不一，圆锥形、圆柱形或纺锤形，稍弯曲，或有支根，但根端及支根多已除去，长3～9厘米，直径1～1.5厘米。表面黑褐色或灰黄色。根头部有茎痕及残留的粗毛（叶鞘）。根的上端密生环纹，多发黑，下部有纵沟及纵皱纹，并有横列皮孔和须根痕。质较柔软，易折断；断面疏松；皮部占根的主要部分，周边乳白色，内层有黄棕色的圈，中心木质部窄，有淡黄白色的菊花纹；抽点金黄色，散在，多数。有香气，味甘而后苦。以条整齐、身长、断面黄白色、香气浓者为佳。"}]},{"ID":"20240830154005-nvnap8r","Type":"NodeParagraph","Properties":{"id":"20240830154005-nvnap8r","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"主产浙江、湖南、四川。此外，广西、安徽、江苏、湖北、江西亦产。"}]},{"ID":"20240830154005-0v98xd7","Type":"NodeParagraph","Properties":{"id":"20240830154005-0v98xd7","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②紫花前胡"}]},{"ID":"20240830154005-xy3qfql","Type":"NodeParagraph","Properties":{"id":"20240830154005-xy3qfql","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"主根分歧或有侧根。主根圆柱形，长8～15厘米，直径0.8～1.7厘米，根头部有茎痕及残留的粗毛（叶鞘）；侧根数条，长7～30厘米，直径2～4毫米，细圆柱形。根的表面黑褐色或灰黄色，有细纵皱纹和灰白色的横长皮孔。主根质坚实，不易折断，断面不齐，皮部与木部极易分离，皮部较窄，浅棕色，散生黄色油点，接近形成层处较多；中央本质部黄白色，占根的绝大部分；支根质脆软，易折断，木部近白色。有香气，味淡而后苦辛。以条整齐、身长、质坚实、断面黄白色、香气浓者为佳。"}]},{"ID":"20240830154005-ye9tmyl","Type":"NodeParagraph","Properties":{"id":"20240830154005-ye9tmyl","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"主产浙江、安徽、江西。此外，山东、山西、陕西等地亦产。"}]},{"ID":"20240830154005-vizpvx5","Type":"NodeParagraph","Properties":{"id":"20240830154005-vizpvx5","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"除上述二种外，尚有同属植物石防风的根，在陕西、河北、河南、广西等地，也作前胡使用，商品称为\"硬苗前胡\"。参见\"石防风\"条。"}]},{"ID":"20240830154005-s0fbebl","Type":"NodeParagraph","Properties":{"id":"20240830154005-s0fbebl","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【化学成份】紫花前胡根含呋哺香豆精类：前胡甙约1.61％。还含海绵甾醇、甘露醇、挥发油。挥发油的主成分为爱草脑及柠檬烯。白花前胡根含白花前胡甲素、乙素、丙素、丁素。"}]},{"ID":"20240830154005-5rss1kc","Type":"NodeParagraph","Properties":{"id":"20240830154005-5rss1kc","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【药理作用】用麻醉猫收集气管粘液分泌的方法证明口服紫花前胡煎剂1克/公斤，能显着增加呼吸道粘液的分泌，故具祛痰作用。用1％碘液1～1.5毫升注入猫的肋膜腔引起咳嗽，服煎剂0.8～2克/公斤，并无明显止咳作用。前胡甙元（参见\"石防风\"条）有抗菌、抗真菌作用。"}]},{"ID":"20240830154005-ga5tje6","Type":"NodeParagraph","Properties":{"id":"20240830154005-ga5tje6","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830154005-80bk87h","Type":"NodeParagraph","Properties":{"id":"20240830154005-80bk87h","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡：拣净杂质，去芦，洗净泥土，稍浸泡，捞出，润透，切片晒干。蜜前胡：取前胡片，用炼熟的蜂蜜和适量开水拌匀，稍闷，置锅内用文火炒至不粘手为度，取出放凉。（每前胡片100斤，用炼熟蜂蜜20斤）"}]},{"ID":"20240830154005-flpu8lx","Type":"NodeParagraph","Properties":{"id":"20240830154005-flpu8lx","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡修事前胡，先用刀刮上苍黑皮并髭、土了，细锉，用甜竹沥浸令润，于日中晒干用之。\""}]},{"ID":"20240830154005-fvrwi2t","Type":"NodeParagraph","Properties":{"id":"20240830154005-fvrwi2t","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830154005-xeoi3aa","Type":"NodeParagraph","Properties":{"id":"20240830154005-xeoi3aa","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"苦辛，凉。"}]},{"ID":"20240830154005-z36g8j0","Type":"NodeParagraph","Properties":{"id":"20240830154005-z36g8j0","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"味甘微苦。\""}]},{"ID":"20240830154005-bxkhxil","Type":"NodeParagraph","Properties":{"id":"20240830154005-bxkhxil","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"味苦，微寒，无毒。\""}]},{"ID":"20240830154005-9setzcx","Type":"NodeParagraph","Properties":{"id":"20240830154005-9setzcx","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味甘辛。\""}]},{"ID":"20240830154005-gq1jzjf","Type":"NodeParagraph","Properties":{"id":"20240830154005-gq1jzjf","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"性寒，味苦辛。\""}]},{"ID":"20240830154005-dw1f661","Type":"NodeParagraph","Properties":{"id":"20240830154005-dw1f661","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"味甘辛，气微平。\""}]},{"ID":"20240830154005-g3s3j3d","Type":"NodeParagraph","Properties":{"id":"20240830154005-g3s3j3d","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830154005-4ottxdu","Type":"NodeParagraph","Properties":{"id":"20240830154005-4ottxdu","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"入肺、脾经。"}]},{"ID":"20240830154005-d72eut0","Type":"NodeParagraph","Properties":{"id":"20240830154005-d72eut0","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"手足太阴、阳明。\""}]},{"ID":"20240830154005-yk60d82","Type":"NodeParagraph","Properties":{"id":"20240830154005-yk60d82","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、肝、脾、膀胱四经。\""}]},{"ID":"20240830154005-4ej0umk","Type":"NodeParagraph","Properties":{"id":"20240830154005-4ej0umk","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入手太阴、少阳。\""}]},{"ID":"20240830154005-i28bnad","Type":"NodeParagraph","Properties":{"id":"20240830154005-i28bnad","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830154005-noae4jq","Type":"NodeParagraph","Properties":{"id":"20240830154005-noae4jq","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"宣散风热，下气，消痰。治风热头痛，痰热咳喘，呕逆，胸膈满闷。"}]},{"ID":"20240830154005-w9edqe8","Type":"NodeParagraph","Properties":{"id":"20240830154005-w9edqe8","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主疗痰满胸胁中痞，心腹结气，风头痛，去痰实，下气。治伤寒寒热，推陈致新，明目益精。\""}]},{"ID":"20240830154005-4d97dxv","Type":"NodeParagraph","Properties":{"id":"20240830154005-4d97dxv","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"去热实，下气，主时气内外俱热，单煮服佳。\""}]},{"ID":"20240830154005-jx408cg","Type":"NodeParagraph","Properties":{"id":"20240830154005-jx408cg","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治一切劳，下一切气，止嗽，破症结，开胃下食，通五脏，主霍乱转筋，骨节烦闷，反胃，呕逆，气喘，安胎，小儿一切疳气。\""}]},{"ID":"20240830154005-g8s8aqe","Type":"NodeParagraph","Properties":{"id":"20240830154005-g8s8aqe","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"解散伤风伤寒，发汗要药，止咳嗽，升降肝气，明目退翳，出内外之痰。\""}]},{"ID":"20240830154005-661lsm5","Type":"NodeParagraph","Properties":{"id":"20240830154005-661lsm5","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"清肺热，化痰热，散风邪。\""}]},{"ID":"20240830154005-8uzrp8n","Type":"NodeParagraph","Properties":{"id":"20240830154005-8uzrp8n","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240830154005-rewp1tl","Type":"NodeParagraph","Properties":{"id":"20240830154005-rewp1tl","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830154005-c41fi6k","Type":"NodeParagraph","Properties":{"id":"20240830154005-c41fi6k","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"半夏为之使。恶皂荚。畏藜芦。\""}]},{"ID":"20240830154005-3v2aml3","Type":"NodeParagraph","Properties":{"id":"20240830154005-3v2aml3","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"不可施诸气虚血少之病。凡阴虚火炽，煎熬真阴，凝结为痰而发咳喘；真气虚而气不归元，以致胸胁逆满；头痛不因于痰，而因于阴血虚；内热心烦，外现寒热而非外感者，法并禁用。\""}]},{"ID":"20240830154005-5ynugkt","Type":"NodeParagraph","Properties":{"id":"20240830154005-5ynugkt","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830154005-u3mevmb","Type":"NodeParagraph","Properties":{"id":"20240830154005-u3mevmb","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①治咳嗽涕唾稠粘，心胸不利，时有烦热：前胡一两（去芦头），麦门冬一两半（去心），贝母一两（煨微黄），桑根白皮一两（锉），杏仁半两（汤浸，去皮尖，麸炒微黄），甘草一分（炙微赤，锉）。上药捣筛为散。每服四钱，以水一中盏，入生姜半分，煎至六分，去滓，不计时候，温服。（《圣惠方》前胡散）"}]},{"ID":"20240830154005-a6xpy6y","Type":"NodeParagraph","Properties":{"id":"20240830154005-a6xpy6y","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②治肺热咳嗽，痰壅，气喘不安：前胡（去芦头）一两半，贝母（去心）、白前各一两；麦门冬（去心，焙）一两半，枳壳（去瓤、麸炒）一两，芍药（亦者）、麻黄（去根节）各一两半，大黄（蒸）一两。上八味，细切，如麻豆。每服三钱匕，以水一盏，煎取七分，去滓，食后温服，日二。（《圣济总录》前胡饮）"}]},{"ID":"20240830154005-h6cjd6i","Type":"NodeParagraph","Properties":{"id":"20240830154005-h6cjd6i","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830154005-4bpy1z6","Type":"NodeParagraph","Properties":{"id":"20240830154005-4bpy1z6","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"前胡，乃手足太阴、阳明之药，与柴胡纯阳上升，入少阳、厥阴者不同也。其功长于下气，故能治痰热喘嗽、痞膈呕逆诺疾。气下则火降，痰亦降矣，所以有推陈致新之绩，为痰气要药。陶弘景言其与柴胡同功非矣，治证虽同，而所入所主则异。\""}]},{"ID":"20240830154005-5txsiyp","Type":"NodeParagraph","Properties":{"id":"20240830154005-5txsiyp","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"前胡，散风寒、净表邪、温肺气、消痰嗽之药也。如伤风之证，咳嗽痰喘，声重气盛，此邪在肺经也；伤寒之证，头痛恶寒，发热骨疼，此邪在膀胱经也；胸胁痞满，气结不舒，此邪在中膈之分也。又妊娠发热，饮食不甘；小儿发热，疮疹未形；大人痰热，逆气隔拒，此邪气壅闭在腠理之间也，用前胡俱能治之。\"\"罗一经云，前胡去寒痰，半夏去湿痰，南星去风痰，枳实去实痰，蒌仁治燥痰，贝母、麦门冬治虚痰，黄连、天花粉治热痰，各有别也。\""}]},{"ID":"20240830154005-zq2vp32","Type":"NodeParagraph","Properties":{"id":"20240830154005-zq2vp32","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"前胡，肺肝药也。散风驱热，消痰下气，开胃化食，止呕定喘，除嗽安胎，止小儿夜啼。柴胡、前胡，均为风药，但柴胡主升，前胡主降为不同耳。种种功力，皆是搜风下气之效，肝胆经风痰为患者，舍此莫能疗。忌火。\""}]},{"ID":"20240830154005-k0q7iu6","Type":"NodeParagraph","Properties":{"id":"20240830154005-k0q7iu6","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830154005-9p8wrd6","Type":"NodeParagraph","Properties":{"id":"20240830154005-9p8wrd6","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡《中华本草》"}]},{"ID":"20240830154005-wryfcev","Type":"NodeParagraph","Properties":{"id":"20240830154005-wryfcev","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830154005-jgopi1p","Type":"NodeParagraph","Properties":{"id":"20240830154005-jgopi1p","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"出自《雷公炮炙论》：凡使前胡，勿用野蒿根，缘真似前胡，只是味粗酸。若误用，令人反胃不受食。"}]},{"ID":"20240830154005-8x92g53","Type":"NodeParagraph","Properties":{"id":"20240830154005-8x92g53","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：前胡似茈胡而柔软，为疗殆欲同。而《神农本草经》上品有茈胡而无此，晚来医乃用之，亦有畏恶，明畏恶，非尽出《神农本草经》也。此近道皆有，生下湿地，出吴兴者为胜。"}]},{"ID":"20240830154005-r0vx9nk","Type":"NodeParagraph","Properties":{"id":"20240830154005-r0vx9nk","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：前胡，春生苗，青白色，似斜蒿，初出时有白芽，长三、四寸，味甚香美，又似茎蒿。七月内开白花，与葱花相类，八月"}]},{"ID":"20240830154005-6y8w62e","Type":"NodeParagraph","Properties":{"id":"20240830154005-6y8w62e","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiánHú"}]},{"ID":"20240830154005-ejxj531","Type":"NodeParagraph","Properties":{"id":"20240830154005-ejxj531","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【英文名】RootofWhiteflowerHogfennel,RootofCommonHogfennel"}]},{"ID":"20240830154005-rv101fv","Type":"NodeParagraph","Properties":{"id":"20240830154005-rv101fv","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830154005-vftgnwv","Type":"NodeParagraph","Properties":{"id":"20240830154005-vftgnwv","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"药材基源：为伞形科植物白花前胡和紫花前胡的根。"}]},{"ID":"20240830154005-hh7aly3","Type":"NodeParagraph","Properties":{"id":"20240830154005-hh7aly3","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.PeucedanumpraeruptorumDunn2.Angelicadecursiua(Miq.)Franch.EtSaw.[PorphyrosciasdecursiuaMiq.;Peucedanumdecursiuum(Miq.)Maxim.]"}]},{"ID":"20240830154005-ayhln3n","Type":"NodeParagraph","Properties":{"id":"20240830154005-ayhln3n","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后2-3年秋、冬季挖取根部，除去地上茎及泥土，晒干。"}]},{"ID":"20240830154005-7nz4emm","Type":"NodeParagraph","Properties":{"id":"20240830154005-7nz4emm","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830154005-iu0xs0j","Type":"NodeParagraph","Properties":{"id":"20240830154005-iu0xs0j","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60-100cm。根圆锥形，有少数侧根，表面黄褐色至棕黑色，根头处残留多数棕褐色叶鞘纤维。茎直立，圆柱形，上部分枝，被短柔毛，下部无毛。基生叶有长柄，基部扩大成鞘状，抱茎；叶片宽三角状卵形，三出或二至三回羽状分裂，长15-20cm，宽约12cm，第一回羽片2-3对，最下方的1对有长柄，柄长3.5-6cm，其他有短柄或无柄；末回裂片菱状倒卵形，先端渐尖，基部楔形至截形，边缘具不整齐的3-4粗或圆锯齿，有时下部锯齿呈浅裂或深裂状，长1.5-6cm，宽1.2-4cm，下表面叶脉明显突起，两面无毛，或有时在下表面叶脉上以及边缘有稀疏短毛；茎生叶和基生叶相似，较小；茎上部叶无柄，叶片三出分裂，裂片狭窄，基部楔形，中间一枚基部下延。复伞形花序顶生或侧生，伞辐6-18，不等长，长1.5-4.5cm，有柔毛；总苞片1至数片，花后脱落，线状披针形，长0.7-1cm，边缘膜质，有柔毛；小伞形花序有花15-20，花梗不等长，有柔毛；小总苞片7-12，卵状披针形，先端长渐尖，长3-5mm，宽0.6-1mm，与花梗等长或超过，有柔毛；萼齿不显着；花瓣5，白色，广卵形至近圆形；雄蕊5；花柱短，弯曲，花柱基圆锥形。果实卵圆形，背部扁压，长约4mm，宽约3mm，棕色，被稀疏短毛，背棱线形稍突起，侧棱呈翅状，比果体狭，稍厚，棱槽内有油管3-5，合生面有油管6-10，胚乳腹面平直。花期7-9月，果期10-11月。"}]},{"ID":"20240830154005-mq5gaqp","Type":"NodeParagraph","Properties":{"id":"20240830154005-mq5gaqp","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"多年生草本，高1-2m。根圆锥形，常数支根，表面黄褐色至棕褐色。茎直立，圆柱形，具浅纵沟纹，光滑，紫色，上部分枝被柔毛。根生叶和茎生叶有长柄，柄长13-36cm，基部膨大成圆形的紫色叶鞘，抱茎外，面无毛；叶片三角形至卵圆形，坚纸质，长10-25cm，一回三全裂或片和顶端叶片有基部联合，沿叶轴呈翅状延长，侧方裂片和顶端叶片有基部联合，沿叶轴呈翅状延长，侧方裂片和顶凋叶片有基部联合，沿叶轴叶翅状延长，翅边缘有锯齿；末回裂片卵形或长圆状披针形，长5-15cm，宽2-5cm，先端锐尖，边缘有白色软骨质锯齿，齿端有尖头，上面深绿色，脉上有短糙毛，下面绿白色，主脉常带紫色，无毛；茎上部叶简化成囊状膨大的紫色叶鞘。复伞形花序顶生和侧生，花序梗长3-8cm，有柔毛；伞辐10-22，长2-4cm；总苞片1-3，卵圆形，阔鞘状，宿存，反折，紫色；小总苞片3-8，线形至披针形，无毛；伞辐及花柄有毛；花深紫色；萼齿明显，线状锥形或三角状锥形；花瓣倒卵形或椭圆状披针形，先端通常不内折成凹头状；花药暗紫色。果实长圆形至卵状圆形，长4-7mm，宽3-5mm，无毛，背棱线形隆起，尖锐，侧棱有较厚的狭翅，与果体近等宽，棱槽内有油管1-3，合生面有油管4-7mm，宽3-5mm，无毛，背棱线形隆起，尖锐，侧棱有较厚的狭翅，与果体近等宽，棱槽内有油管1-3，合生面有油管4-6，胚乳腹面有油管4-6，胚乳腹面凹入。花期8-9月，果期9-11月。"}]},{"ID":"20240830154005-op0lzpe","Type":"NodeParagraph","Properties":{"id":"20240830154005-op0lzpe","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830154005-qbp3jm2","Type":"NodeParagraph","Properties":{"id":"20240830154005-qbp3jm2","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔250-2000m的山坡林缘、路旁或单位阴性的山坡草丛中。生于山坡林缘、溪沟边或杂木林灌丛中。"}]},{"ID":"20240830154005-ug0786t","Type":"NodeParagraph","Properties":{"id":"20240830154005-ug0786t","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于甘肃；江苏；安徽；浙江；江西；福建；河南；湖北；湖南；广西；四川；贵州等地。分布于辽宁、河北、陕西、江苏、安徽、浙江、江西、台湾、河南、湖北、湖南、广东、广西、四川等地。"}]},{"ID":"20240830154005-dx1g3yb","Type":"NodeParagraph","Properties":{"id":"20240830154005-dx1g3yb","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830154005-j0alazk","Type":"NodeParagraph","Properties":{"id":"20240830154005-j0alazk","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"生物学特性喜冷凉湿润气候，耐旱、耐寒。适应性较强，在山地及平原均可生长。以肥沃深厚的腐残质壤土生长最好，得粘土及对过于低湿地方不宜栽种。"}]},{"ID":"20240830154005-2qz6kdt","Type":"NodeParagraph","Properties":{"id":"20240830154005-2qz6kdt","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子和分根繁殖。种子繁殖：种子采收后，立即播种，撒播或条播，播后覆土以不见种子为度，稍加镇压，浇水。苗出土后40d即可移栽，按行株距60cm×45cm开穴栽植。分根繁殖；春季挖出老根，有新芽的作种栽，按行株距60cm×45cm开穴种植。"}]},{"ID":"20240830154005-mjg1322","Type":"NodeParagraph","Properties":{"id":"20240830154005-mjg1322","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"田间管理移栽成活后，及时松土除草，夏季雨后须松土，于8月中旬可追施磷肥和钾肥。"}]},{"ID":"20240830154005-ruxz0xp","Type":"NodeParagraph","Properties":{"id":"20240830154005-ruxz0xp","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830154005-bjo0zy8","Type":"NodeParagraph","Properties":{"id":"20240830154005-bjo0zy8","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）白花前胡根近圆柱形、圆锥形或纺锤形，稍扭曲，下部有分枝，长3-15cm，直径1-2cm。根头部常有茎痕及纤维状叶鞘残基；表面灰棕色至黑褐色，有不规则纵沟及纵皱纹，并有横向皮孔；上部有密集的环纹。质较柔软，干者质硬，可折断，折断面不整齐，疏松，于放大镜下可邮众多细小黄棕色油点散在；皮部厚，淡黄白色，形成层环明显，木部淡黄色。气芳香，味微苦、辛。"}]},{"ID":"20240830154005-usj8ve1","Type":"NodeParagraph","Properties":{"id":"20240830154005-usj8ve1","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"（2）紫花前胡根头部较粗短，根少有纤维状叶鞘残基。折断面皮部易与木部分离。气芳香，味微苦、辛。"}]},{"ID":"20240830154005-tvhaw95","Type":"NodeParagraph","Properties":{"id":"20240830154005-tvhaw95","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"均以条粗壮、质柔软、香气浓者为佳。"}]},{"ID":"20240830154005-se99ejm","Type":"NodeParagraph","Properties":{"id":"20240830154005-se99ejm","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"显微鉴别根横切面：（1）白花前胡木栓细胞10余殖。韧皮部散有同室，径向40-78μm，切向50-120μm，韧皮射线稍弯曲。形成层成环。本质部有较多油室，木射线宽2-4列细胞。本品薄壁细胞含淀粉粒。"}]},{"ID":"20240830154005-x86gp7p","Type":"NodeParagraph","Properties":{"id":"20240830154005-x86gp7p","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"（2）紫花前胡韧皮众多油室，径向44-90μm切向58-150μm，韧皮射线较平直。木质部无油室，木射线宽2-3列细胞。"}]},{"ID":"20240830154005-it43mpy","Type":"NodeParagraph","Properties":{"id":"20240830154005-it43mpy","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830154005-1la3smy","Type":"NodeParagraph","Properties":{"id":"20240830154005-1la3smy","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"1.白花前胡根含香豆精类化合物：外消旋白花前胡素（praeruptorin)A即Pd、Ia、B即Pd-Ⅱ右旋白花前胡素C、D[1]及E[2]，右旋白Ib(Pd-Ib)、Ⅲ（Pd-Ⅲ），前者即为右旋-3′（R）-当归酰氧基-4′-酮基-3′，4′-二氢邪蒿素[3′（R）-angeloyloxy-4′-keto-3′，4′-dihydroseselin]，后者即为右旋-3（S）-当归酰氧基-4′-（S）-异戊酰氧基-3′，4′-dihydroseselin)[3,4]，北美芹素（pteryxin)，白花前胡香豆精（peucedanocoumarin)Ⅰ、Ⅱ、Ⅲ[5]，前胡香豆精（qianhucoumarin)A，补骨脂素（Psoralen)，5-甲氧基补骨脂素（5-methoxypsoralen)，8-甲氧基补骨脂素（8-methoxypso-ralen)[6]，左旋白花前胡醇（peucedanol)[7]；香豆精糖甙类化合物：紫花前胡甙（nodakenin)[1]，印度榅桲甙（marmesinin)，茵芋甙（skimmin)[7]，靶香呋喃香豆醇葡萄糖甙（rutarin)，异芸香呋喃香豆醇葡萄糖甙（isorutarin)，东莨菪甙（scoploin)，白花前胡甙（praeroside)Ⅰ、Ⅱ、Ⅲ、Ⅳ及Ⅴ[8，9]，紫花前胡种甙（decuroside)Ⅳ，芨芨芹菜糖基茵芋甙（apiosylskimmin)[10]；其他：D-甘露醇（D-mannitol)[2]，β-谷甾醇（βsitosterol)[6]，半乳糖醇（galactitol)，胡萝卜甘（daucosterol)[7]及紫花前胡皂甙Ⅴ（Pd-saponinⅤ即3-O-α-L-吡喃阿拉伯糖基-常春藤皂甙元-28-O-β-龙胆二糖甙（3-O-α-L-arabinopyranosylhederagenin-28-O-β-gentiobioside）[10]。"}]},{"ID":"20240830154005-v2xygci","Type":"NodeParagraph","Properties":{"id":"20240830154005-v2xygci","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"2.紫花前胡根含香豆精类化合物：紫花前胡素（decur-sidin)，紫花前胡素C-I（Pd-C-I）即3′（S）-（3甲基-2-丁烯酰氧基）-4′（R）-羟基-3′，4′-二氢花椒内酯[3′（S）-senecioyloxy-4′（R）-hydroxy-3′，4′-dihydroxanthyletin]，紫花前胡素CⅡ(Pd-C-Ⅱ）即3′（S）-羟基-4′（R—）-（3-甲基-2-丁烯酰氧基）-3′，4′-二氢花椒内酯[3′（S）-hydroxy4′-二氢花椒内酯[3′（S）-angeloyloxy-4′（R）-acetoxy-3′，4′-dihydroxanthyletin][4]，紫花前胡素C-Ⅳ（Pd-C-Ⅳ）即3′（S）-乙酰氧基-4′（R）-（3-甲基-2-烯酰氧基）-3′，4′-二氢花椒内酯[3′（S）-acetoxy-4′（R）-senecioyloxy-3′，4′-dihydroxanthyletin]，紫花前胡素C-Ⅴ(Pd-C-Ⅴ）即为3′（S）-乙酰氧基-4′（R）-异戊酰氧基-3′，4′-二氢花椒内酯（3′（S）-acetoxy-4′（R）-isovaleryloxy-3′4′-di-hydroxanthyletin]与3′（S）-乙酰氧基-4′（R）-当归酰氧基-3′，4′-二氢花椒内酯[3′-（S）-acetoxy-4′（R）-angeloyloxy-3′，4′-dihydrox-anthyletin]的等量混合物，紫花前胡素Ⅰ（AD-Ⅰ）即3（S）-当归酰氧基-4′（R）-异戊酰氧基-3′，4′-二氢花椒内酯[3′（S）-angeloy-loxy-4′-(S)-isovaleryloxy-3′，4′-dihydroxanthyletin][11]，紫花前胡甙元（nodakenetin)及香柑内酯[4]；香豆精糖甙类化合物：紫花前胡甙[4]，紫花前胡种甙Ⅰ、Ⅱ、Ⅲ、Ⅳ及Ⅴ[12]；皂甙：紫花前胡皂甙（Pd-saponin)Ⅰ、Ⅱ、Ⅲ、Ⅳ、及Ⅴ[13]。"}]},{"ID":"20240830154005-6kdb3vg","Type":"NodeParagraph","Properties":{"id":"20240830154005-6kdb3vg","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830154005-0u5cx96","Type":"NodeParagraph","Properties":{"id":"20240830154005-0u5cx96","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"1.钙结抗剂作用：白花前胡乙醇提取物对抗由乙酰胆碱和组胺引起的离体豚鼠回肠收缩，较水提液或丁醇提取液强，这种作用是非竞争性的。白花前胡甲素可非竞争性缓解由乙酰胆碱引起的回肠收缩，还能抑制由于细胞外Ca2+的流入引起的豚鼠结肠带K去极化的收缩作用，抑制45Ca2+进入平滑肌。白花前胡甲素和pd-c-Ⅱ、pd-c-Ⅲ可抑制由ConA和磷脂酰丝氨酸引起的大鼠肥大细胞释放过敏性介质，其IC50分别为79，100，102μm。"}]},{"ID":"20240830154005-7va4n7u","Type":"NodeParagraph","Properties":{"id":"20240830154005-7va4n7u","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"2.对血小板凝集的作用：Nodakenin、Nodakenetin对油2μmol/lADP引起的原发性和继发性血小板凝集有强烈的抑制作用。Pd一cv和pd一Ia（即白花前胡甲素）对原发性血小极凝集有促进作用。"}]},{"ID":"20240830154005-0p54kev","Type":"NodeParagraph","Properties":{"id":"20240830154005-0p54kev","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"3.祛痰作用：用麻醉猫收集呼吸道分泌的方法，灌服前胡煎剂1g/kg，能增加呼吸道分泌液，说明有祛痰作用，且作用时间较长。"}]},{"ID":"20240830154005-sufglat","Type":"NodeParagraph","Properties":{"id":"20240830154005-sufglat","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"4.扩张冠脉作用：白花前胡丙素能增加心冠脉流量，但不影响心主率和心收缩力。白花前胡素（E）对小鼠具有耐缺氧作用。"}]},{"ID":"20240830154005-xvhgcv0","Type":"NodeParagraph","Properties":{"id":"20240830154005-xvhgcv0","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"前胡丙素（pd-Ⅲ）对离体豚鼠心脏有浓度依赖性抑制左心房收缩力的作用，50%抑制浓度（IC50）为49μm；并可浓度依赖性地缩短功能性不应期；终浓度10μm时对右心房的自律性及CaCl2的正性频率有明显抑制作用，对异丙肾上腺素的正性频率作用表现为非竞争性拮抗，PD'2为4.8，而对肾上腺素诱发的异位自率性无影响。终浓度5-50μm对左心房兴奋性无影响。临床上，肥厚性心肌病患者口服pd-Ⅲ90mg/天，连续2周后，心肌顺应性有一定改善。对离体兔主动脉条，pd-Ⅲ能非竞争性抑制CaCl2和高钾除极化所致的收缩，IC50分别为5.30和6.37μm,PD'2分别为4.9和5.0，终浓度1或10μm能抑制5-HT诱导的依外钙性收缩，但不影响依内钙性收缩及去甲肾上腺素诱导的收缩；5-50μm之间能浓度依赖性地抑制豚鼠左心房的收缩阶梯现象。Pd-Ⅲ对血管和心脏的抑制作用可能与拮抗Ca2+有关，且主要影响经电压敏感性钙通道的外钙内流。Pd-Ⅲ抑制血管与心脏的IC50之比为1：8，提示pd-Ⅲ有一定的选择性扩血管作用。麻醉猫静脉注射白花前胡甲醇提取物6.25，12.5mg/kg或正丁醇提取物5.0，30mg/kg均能增加冠脉血流量，对心率及心电图无明显影响。但甲醇提取物起效慢、持续长、强度稍弱，同时不引起血压变化；而正丁醇提取物起效快、持续短、强度较大，在增加冠脉血流量的同时引起血压降低。"}]},{"ID":"20240830154005-voaz1hu","Type":"NodeParagraph","Properties":{"id":"20240830154005-voaz1hu","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830154005-q457j6g","Type":"NodeParagraph","Properties":{"id":"20240830154005-q457j6g","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末1g，加乙醚10ml，浸渍2h，取乙醚液2滴，分别点于两线小滤纸下上，置紫外学灯（365nm）下观察，显淡天蓝色荧光，然后滴加15%氢氧化催深液数滴，2min后荧光消失。将一张滤纸片避光保存，另一张滤纸片曝光，约3h后，置紫外光灯下观察，曝光者天蓝色荧光加强，避光者不显荧光。"}]},{"ID":"20240830154005-erksmo0","Type":"NodeParagraph","Properties":{"id":"20240830154005-erksmo0","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末5g，加甲醇30ml，加热回流10min，滤过，取滤液2ml，蒸干，残潭加冰醋酸1ml使溶解，再加乙酰氯5滴和氧化锌数粒，置水浴中加热1-2min，深液显红色。（检查甾醇）(3)薄层色谱取本品粉末2g，加乙醚6ml冷浸4h，滤过，滤液至干，残潭加氯仿制成点样液。取白花前胡丙素和丁素与伞形花内酯分别制成对照品溶液。取白花前胡丙素和丁素与伞形花内酯分别制成对照品溶液，分别取各溶液点于同一硅胶G-CMC薄层板上，用石油醚-乙酸乙酯（1：1）展开，置荧光灯下观察，白花前胡色谱中与色谱中，与伞形花内酯相应位置显相同荧光斑点。"}]},{"ID":"20240830154005-6lgsqla","Type":"NodeParagraph","Properties":{"id":"20240830154005-6lgsqla","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【炮制】前胡：拣净杂质，去芦，洗净泥土，稍浸泡，捞出，润透，切片晒干。蜜前胡：取前胡片，用炼熟的蜂蜜和适量开水拌匀，稍闷，置锅内用文火炒至不粘手为度，取出放凉。(每前胡片100斤，用炼熟蜂蜜20斤)《雷公炮炙论》：凡修事前胡，先用刀刮上苍黑皮并髭、土了，细锉，用甜竹沥浸令润，于日中晒干用之。"}]},{"ID":"20240830154005-pykuahy","Type":"NodeParagraph","Properties":{"id":"20240830154005-pykuahy","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；辛；性微寒"}]},{"ID":"20240830154005-4ymd149","Type":"NodeParagraph","Properties":{"id":"20240830154005-4ymd149","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；脾；肝经"}]},{"ID":"20240830154005-9x6uukl","Type":"NodeParagraph","Properties":{"id":"20240830154005-9x6uukl","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【功能主治】疏散风热；降气化痰。主外感风热；肺热痰郁；咳喘痰多；痰黄稠粘；哎逆食少；胸膈满闷"}]},{"ID":"20240830154005-0alblpd","Type":"NodeParagraph","Properties":{"id":"20240830154005-0alblpd","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-10g；或入丸、散。"}]},{"ID":"20240830154005-x8wd6mv","Type":"NodeParagraph","Properties":{"id":"20240830154005-x8wd6mv","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：不可施诸气虚血少之病。凡阴虚火炽，煎熬真阴，凝结为痰而发咳喘；真气虚而气不归元，以致胸胁逆满；头痛不因于痰，而因于阴血虚；内热心烦，外现寒热而非外感者，法并禁用。"}]},{"ID":"20240830154005-6wiyegn","Type":"NodeParagraph","Properties":{"id":"20240830154005-6wiyegn","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【附方】①治咳嗽涕唾稠粘，心胸不利，时有烦热：前胡一两(去芦头)，麦门冬一两半(去心)，贝母一两(煨微黄)，桑根白皮一两(锉)，杏仁半两(汤浸，去皮尖，麸炒微黄)，甘草一分(炙微赤，锉)。上药捣筛为散。每服四钱，以水一中盏，入生姜半分，煎至六分，去滓，不计时候，温服。(《圣惠方》前胡散)②治肺热咳嗽，痰壅，气喘不安：前胡(去芦头)一两半，贝母(去心)、白前各一两，麦门冬(去心，焙)一两半，枳壳(去瓤、麸炒)一两，芍药(赤者)、麻黄(去根节)各一两半，大黄(蒸)一两。上八味，细切，如麻豆。每服三钱匕，以水一盏，煎取七分，去滓，食后温服，日二。(《圣济总录》前胡饮)"}]},{"ID":"20240830154005-lcxfi6g","Type":"NodeParagraph","Properties":{"id":"20240830154005-lcxfi6g","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830154005-bdw000k","Type":"NodeParagraph","Properties":{"id":"20240830154005-bdw000k","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：前胡，乃手足太阴、阳明之药，与柴胡纯阳上升，入少阳、厥阴者不同也。其功长于下气，故能治痰热喘嗽、痞膈呕逆诸疾。气下则火降，痰亦降矣，所以有推陈致新之绩，为痰气要药。陶弘景言其与柴胡同功非矣，治证虽同，而所入所主则异。"}]},{"ID":"20240830154005-red6c28","Type":"NodeParagraph","Properties":{"id":"20240830154005-red6c28","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：前胡，散风寒、净表邪、温肺气、消痰嗽之药也。如伤风之证，咳嗽痰喘，声重气盛，此邪在肺经也；伤寒之证，头痛恶寒，发热骨疼，此邪在膀胱经也；胸胁痞满，气结不舒，此邪在中膈之分也。又妊娠发热，饮食不甘；小儿发热，疮疹未形；大人痰热，逆气隔拒，此邪气壅闭在腠理之间也，用前胡俱能治之。罗一经云，前胡去寒痰，半夏去湿痰，南星去风痰，枳实去实痰，蒌仁治燥痰，贝母、麦门冬治虚痰，黄连、天花粉治热痰，各有别也。"}]},{"ID":"20240830154005-qxuqzoc","Type":"NodeParagraph","Properties":{"id":"20240830154005-qxuqzoc","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：前胡，肺肝药也。散风驱热，消痰下气，开胃化食，止呕定喘，除嗽安胎，止小儿夜啼。柴胡、前胡，均为风药，但柴胡主升，前胡主降为不同耳。种种功力，皆是搜风下气之效，肝胆经风痰为患者，舍此莫能疗。忌火。"}]},{"ID":"20240830154005-d3lspld","Type":"NodeParagraph","Properties":{"id":"20240830154005-d3lspld","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"4.《别录》：主疗痰满胸胁中痞，心腹结气，风头痛，去痰实，下气。治伤寒寒热，推陈致新，明目益精。"}]},{"ID":"20240830154005-3blf3v0","Type":"NodeParagraph","Properties":{"id":"20240830154005-3blf3v0","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"5.《药性论》：去热实，下气，主时气内外俱热，单煮服佳。"}]},{"ID":"20240830154005-58x7dcp","Type":"NodeParagraph","Properties":{"id":"20240830154005-58x7dcp","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治一切劳，下一切气，止嗽，破症结，开胃下食，通五脏，主霍乱转筋，骨节烦闷，反胃，呕逆，气喘，安胎，小儿一切疳气。"}]},{"ID":"20240830154005-zpq6v34","Type":"NodeParagraph","Properties":{"id":"20240830154005-zpq6v34","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：解散伤风伤寒，发汗要药，止咳嗽，升降肝气，明目退翳，出内外之痰。"}]},{"ID":"20240830154005-sm3078t","Type":"NodeParagraph","Properties":{"id":"20240830154005-sm3078t","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"8.《纲目》：清肺热，化痰热，散风邪。"}]},{"ID":"20240830154005-q0zjwrv","Type":"NodeParagraph","Properties":{"id":"20240830154005-q0zjwrv","updated":"20240830154034"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830154007-3989mxv","Type":"NodeThematicBreak","Properties":{"id":"20240830154007-3989mxv","updated":"20240830154034"}},{"ID":"20240830154008-gl6tz1c","Type":"NodeParagraph","Properties":{"id":"20240830154008-gl6tz1c","updated":"20240830154034"}}]}