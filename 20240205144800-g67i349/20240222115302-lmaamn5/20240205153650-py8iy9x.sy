{"ID":"20240205153650-py8iy9x","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153650-py8iy9x","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153650-py8iy9x\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240205163931-isjre66\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205163931-isjre66\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240205163931-isjre66\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"黄毒块茎（黄毒、黄独）","type":"doc","updated":"20240903094553"},"Children":[{"ID":"20240205163931-isjre66","Type":"NodeParagraph","Properties":{"id":"20240205163931-isjre66","updated":"20240205163931"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄药子（黄毒块茎）"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄药子（黄毒块茎）-20240205163931-2yzhry3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731141715-5vd1325","Type":"NodeParagraph","Properties":{"id":"20240731141715-5vd1325","updated":"20240731162702"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄药子 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄药子 19-20240731162507-9taxvbq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731141919-75rwlyf","Type":"NodeParagraph","Properties":{"id":"20240731141919-75rwlyf","updated":"20240731162657"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 511px;","style":"width: 501px;"},"Children":[{"Typ