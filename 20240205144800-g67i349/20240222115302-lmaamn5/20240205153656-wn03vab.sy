L","Data":"{: style=\"width: 634px;\" parent-style=\"width: 644px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714085334-flg7xyu","Type":"NodeParagraph","Properties":{"id":"20240714085334-flg7xyu","updated":"20240714091753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 573px;","style":"width: 563px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 5-20240714085322-ccwqlg0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 563px;\" parent-style=\"width: 573px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 645px;","style":"width: 635px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 9-20240714085659-zq5tmkm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 635px;\" parent-style=\"width: 645px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714091603-uru71wc","Type":"NodeParagraph","Properties":{"id":"20240714091603-uru71wc","updated":"20240714091753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 775px;","style":"width: 765px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 24-20240714091632-13mq8hs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 765px;\" parent-style=\"width: 775px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 23-20240714091603-ezx3y9b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​​​​​​"}]},{"ID":"20240714085732-kyd9a72","Type":"NodeParagraph","Properties":{"id":"20240714085732-kyd9a72","updated":"20240714090311"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 12-20240714090009-3kbswam.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"延胡索 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/延胡索 16-20240714090311-mham88c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240714091008-54r7z67","Type":"NodeThematicBreak","Properties":{"id":"20240714091008-54r7z67"}},{"ID":"20240830170159-gi2x9y1","Type":"NodeParagraph","Properties":{"id":"20240830170159-gi2x9y1","updated":"20240830170210"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：延胡索"}]},{"ID":"20240830170159-dch5fih","Type":"NodeParagraph","Properties":{"id":"20240830170159-dch5fih","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索《中国药典》"}]},{"ID":"20240830170159-ti6nmn9","Type":"NodeParagraph","Properties":{"id":"20240830170159-ti6nmn9","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánHúSuǒ"}]},{"ID":"20240830170159-2kn913t","Type":"NodeParagraph","Properties":{"id":"20240830170159-2kn913t","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMACORYDALIS"}]},{"ID":"20240830170159-21vt5zn","Type":"NodeParagraph","Properties":{"id":"20240830170159-21vt5zn","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【别名】玄胡素、元胡"}]},{"ID":"20240830170159-og5qlbk","Type":"NodeParagraph","Properties":{"id":"20240830170159-og5qlbk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【来源】本品为罂粟科植物延胡索CorydalisyanhusuoW.T.Wang的干燥块茎。夏初茎叶枯萎时采挖，除去须根，洗净，置沸水中煮至恰无白心时，取出，晒干。"}]},{"ID":"20240830170159-57xsiur","Type":"NodeParagraph","Properties":{"id":"20240830170159-57xsiur","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则的扁球形，直径0.5～1.5cm。表面黄色或黄褐色，有不规则网状皱纹。顶端有略凹陷的茎痕，底部常有疙瘩状凸起。质硬而脆，断面黄色，角质样，有蜡样光泽。气微，味苦。"}]},{"ID":"20240830170159-9fu71pn","Type":"NodeParagraph","Properties":{"id":"20240830170159-9fu71pn","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830170159-eol0lty","Type":"NodeParagraph","Properties":{"id":"20240830170159-eol0lty","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末绿黄色。糊化淀粉粒团块淡黄色或近无色。下皮厚壁细胞绿黄色，细胞多角形、类方形或长条形，壁稍弯曲，木化，有的成连珠状增厚，纹孔细密。石细胞淡黄色，类圆形或长圆形，直径约至60μｍ，壁较厚，纹孔细密。螺纹导管直径16～32μｍ。"}]},{"ID":"20240830170159-ng8tlnl","Type":"NodeParagraph","Properties":{"id":"20240830170159-ng8tlnl","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加0.25mol/L硫酸溶液20ml，振摇片刻，滤过。取滤液2ml,加1％铁氰化钾溶液0.4ml与1％三氯化铁溶液0.3ml的混合液，即显深绿色，渐变深蓝色，放置后底部有较多深蓝色沉淀。另取滤液2ml,加重铬酸钾试液1滴，即生成黄色沉淀。"}]},{"ID":"20240830170159-uino27l","Type":"NodeParagraph","Properties":{"id":"20240830170159-uino27l","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加甲醇50ml，超声处理30分钟，滤过，滤液蒸干，残渣加水溶解，加浓氨试液调至碱性，用乙醚提取3次，每次10ml，合并乙醚液，蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取延胡索对照药材1g,同法制成对照药材溶液。再取延胡索乙素对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述三种溶液各2～3μl,分别点于同一用1％氢氧化钠制备的硅胶Ｇ薄层板上，以正己烷－氯仿－甲醇（7.5:4:1）为展开剂，置以展开剂预饱和的展开缸内，展开，取出，晾干，以碘蒸气熏至斑点显色清晰。日光下检视，供试品色谱中，在与对照药材和对照品色谱相应的位置上，显相同颜色的斑点；在空气中挥尽板上吸附的碘后，置紫外光灯（365nm）下检视，供试品色谱中，在与对照药材和对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240830170159-aousg1w","Type":"NodeParagraph","Properties":{"id":"20240830170159-aousg1w","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830170159-13ja8lj","Type":"NodeParagraph","Properties":{"id":"20240830170159-13ja8lj","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索：除去杂质，洗净，干燥，切厚片或用时捣碎。"}]},{"ID":"20240830170159-cy1yenh","Type":"NodeParagraph","Properties":{"id":"20240830170159-cy1yenh","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"醋延胡索：取净延胡索，照醋炙法（附录ⅡD）炒干，或照醋煮法（附录ⅡD）煮至醋吸尽，切厚片或用时捣碎。（每100斤用醋20斤）。"}]},{"ID":"20240830170159-mrdfjb2","Type":"NodeParagraph","Properties":{"id":"20240830170159-mrdfjb2","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，温。"}]},{"ID":"20240830170159-8zi524d","Type":"NodeParagraph","Properties":{"id":"20240830170159-8zi524d","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾经。"}]},{"ID":"20240830170159-hrh88b5","Type":"NodeParagraph","Properties":{"id":"20240830170159-hrh88b5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血，利气，止痛。用于胸胁、脘腹疼痛，经闭痛经，产后瘀阻，跌扑肿痛。"}]},{"ID":"20240830170159-ftxtkza","Type":"NodeParagraph","Properties":{"id":"20240830170159-ftxtkza","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g；研末吞服，一次1.5～3g。"}]},{"ID":"20240830170159-aeuu2g2","Type":"NodeParagraph","Properties":{"id":"20240830170159-aeuu2g2","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇慎用。"}]},{"ID":"20240830170159-2wv5i81","Type":"NodeParagraph","Properties":{"id":"20240830170159-2wv5i81","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防蛀。"}]},{"ID":"20240830170159-m4ppeuy","Type":"NodeParagraph","Properties":{"id":"20240830170159-m4ppeuy","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830170159-wcfgz9a","Type":"NodeParagraph","Properties":{"id":"20240830170159-wcfgz9a","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索《*辞典》"}]},{"ID":"20240830170159-1v43qid","Type":"NodeParagraph","Properties":{"id":"20240830170159-1v43qid","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【出处】《本草拾遗》"}]},{"ID":"20240830170159-g8k8st3","Type":"NodeParagraph","Properties":{"id":"20240830170159-g8k8st3","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánHúSuǒ"}]},{"ID":"20240830170159-q7yx57l","Type":"NodeParagraph","Properties":{"id":"20240830170159-q7yx57l","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【别名】延胡（《雷公炮炙论》），玄胡索（《济生方》），元胡索（《药品化义》）。"}]},{"ID":"20240830170159-4uxo17j","Type":"NodeParagraph","Properties":{"id":"20240830170159-4uxo17j","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【来源】为罂粟科植物延胡索的块茎。5～6月间当茎叶枯萎时采挖。挖取后，搓掉外面浮皮，洗净，分别大小，放入开水中烫煮，随时翻动，至内部无白心呈黄色时，捞出晒干，置于干燥通风处，防潮及虫蛀。"}]},{"ID":"20240830170159-ygoc3g6","Type":"NodeParagraph","Properties":{"id":"20240830170159-ygoc3g6","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本，高10～20厘米。块茎球形。地上茎短，纤细，稍带肉质，在基部之上生1鳞片。基生叶和茎生叶同形，有柄；茎生叶为互生，2回3出复叶，第2回往往分裂不完全而呈深裂状，小叶片长椭圆形、长卵圆形或线形，长约2厘米，先端钝或锐尖，全缘。总状花序，顶生或对叶生；苞片阔披针形；花红紫色，横着于纤细的小花梗上，小花梗长约6毫米；花萼早落；花瓣4，外轮2片稍大，边缘粉红色，中央青紫色，上部1片，尾部延伸成长距，距长约占全长的一半，内轮2片比外轮2片狭小，上端青紫色，愈合，下部粉红色；雄蕊6，花丝连合成两束，每束具3花药；子房扁柱形，花柱细短，柱头2，似小蝴蝶状。果为蒴果。花期4月，果期5～6月。"}]},{"ID":"20240830170159-73frxr8","Type":"NodeParagraph","Properties":{"id":"20240830170159-73frxr8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山地林下，或为栽培。分布河北、山东、江苏、浙江等地。主产浙江。"}]},{"ID":"20240830170159-0shev5b","Type":"NodeParagraph","Properties":{"id":"20240830170159-0shev5b","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性状】干燥块茎，呈不规则扁球形，直径1～2厘米，表面黄色或褐黄色，顶端中间有略凹陷的茎痕，底部或有疙瘩状凸起。质坚硬而脆，断面黄色，角质，有蜡样光泽。无臭，味苦。以个大、饱满、质坚、色黄、内色黄亮者为佳。个小、色灰黄、中心有白色者质次。"}]},{"ID":"20240830170159-jlmbqf4","Type":"NodeParagraph","Properties":{"id":"20240830170159-jlmbqf4","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830170159-3zjggbc","Type":"NodeParagraph","Properties":{"id":"20240830170159-3zjggbc","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"从延胡索的块茎中共提出生物碱10余种，其中经鉴定的有紫堇碱、dl-四氢掌叶防己碱、原阿片碱、L-四氢黄连碱、dl-四氢黄连碱、L-四氢非洲防己碱、紫堇鳞茎碱、β-高白屈菜碱、黄连碱、去氢紫堇碱，还有紫堇达明碱、去氢紫堇达明碱。"}]},{"ID":"20240830170159-tqp0g2u","Type":"NodeParagraph","Properties":{"id":"20240830170159-tqp0g2u","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"东北延胡索块茎含多种原小蘖碱型生物碱，其中有紫堇碱、紫堇达明碱、去氢紫堇达明碱、去氢紫堇碱、黄连碱、四氢黄连碱、四氢非洲防己碱、四氢掌叶防己碱、紫堇鳞茎碱等。另含原阿片碱。"}]},{"ID":"20240830170159-va9f0s5","Type":"NodeParagraph","Properties":{"id":"20240830170159-va9f0s5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"迷延胡索块茎含原小檗碱型生物碱，有紫堇碱、去氢紫堇碱、紫堇鳞茎碱、紫茧把明碱、L-四氢黄连碱、黄连碱。另含原阿片碱型生物碱原阿片碱和β-高白屈菜碱，又含刺激性挥发油。"}]},{"ID":"20240830170159-nl8c39p","Type":"NodeParagraph","Properties":{"id":"20240830170159-nl8c39p","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"土延胡的块茎中含原阿片碱、L-四氢黄连碱、比枯枯灵、苏延胡碱甲、苏延胡碱乙。"}]},{"ID":"20240830170159-i2fpugj","Type":"NodeParagraph","Properties":{"id":"20240830170159-i2fpugj","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"朝鲜产延胡索含原小檗碱型生物碱：小檗碱氢化小檗碱、四氢黄连碱、黄连碱、四氢刻叶紫堇明碱、四氢非洲防己碱和斯氏紫堇碱；阿朴芬型生物碱：紫堇定、异紫堇定、去甲异紫堇定和海罂栗碱；以及原阿片碱型生物碱：原阿片碱、β-高白屈菜碱。尚含羟链霉素、豆甾醇、油酸、亚油酸、亚麻酸等。"}]},{"ID":"20240830170159-yeucilg","Type":"NodeParagraph","Properties":{"id":"20240830170159-yeucilg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830170159-r5012np","Type":"NodeParagraph","Properties":{"id":"20240830170159-r5012np","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①对中枢神经系统的作用"}]},{"ID":"20240830170159-zqhjop0","Type":"NodeParagraph","Properties":{"id":"20240830170159-zqhjop0","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"㈠止痛：有明显的止痛作用，粉剂的止痛效价约为阿片的1％。各种剂型中以醇制浸膏及醋制流浸膏作用最强，毒性则以醋制剂最强，临床上最好采用粉剂或醇制浸膏。以吗啡的镇痛效力为100，则延胡索总碱为40，汉防己总碱约为13。如后两者合用时，其止痛效力并不增强，反而减弱。紫堇碱、四氢掌叶防己碱（或称延胡索甲素、乙素）及延胡索丑素都有明显的止痛作用，丑素较强，乙素次之，甲素最弱，镇痛指数则以乙素较高，丑素次之，甲素最差，但均不及吗啡。癸紊也有微弱的止痛作用。大鼠对乙素和丑素的镇痛作用能产生耐药性，但产生速度约比吗啡慢1倍，并与吗啡之间有交叉耐药现象。㈡催旺、镇静与安定作用：四氢掌叶防己碱较大剂量时对兔、狗、猴均有明显催眠作用，但感觉仍存在，易被惊醒。狗于皮下注射后5～20分钟内出现睡眠，维持80分钟左右，多次给药后呈现一定的耐药性。四氢掌叶防己碱可抑制条件反射，对动物的分化相无明显改变，对非条件反射则无明显作用。此作用与氯丙嗪及蛇根碱相似。它还能延长环己巴比妥钠的催眠时间，减少小鼠自发性与被动性活动，使家兔外观安静，脑电波转变为高电压慢波。并有对抗小量苯丙胺的兴奋现象，也有降低大量苯丙胺的毒性作用。对猴也有一定的驯服作用。在小鼠并有对抗墨斯卡林的作用，因此具有安定剂的一些特性。丑素的镇静、安定作用不及四氢掌叶防己碱，癸素则更弱。㈢其他作用：四氢掌叶防己碱能使士的宁容易产生惊厥，但能抑制五甲烯四氮唑的惊厥作用，不能对抗电休克的发生，略能协同苯妥因钠抗电休克的作用。对狗有轻度中枢性镇吐作用，对大鼠能轻度降低体温。㈣作用原理：四氢掌叶防己碱对皮层及皮层下的电活动都能抑制，尤以皮层运动感觉区较敏感。但是把药直接涂于皮层上及在孤离皮层的试验中，均证明它对皮层无直接影响。把药注入脑室中，可产生镇静与催眠，四氢掌叶防己碱能明显抑制由刺激皮肤引起的惊醒反应，抑制中脑网状结构和下丘脑的诱发电位，对于脑干网状结构一些下行性功能也有阻断作用。因此对皮层下结构有一定的选择作用。在对脑干网状结构下行性功能的作用上与氯丙嗪有相似之处，但也有不同的作用部位，故二者的作用不完全一致。对脊髓电活动虽也有抑制，但不及对脑干的作用明显。四氢掌叶防己碱对大鼠脑内5-羟色胺含量并无明显影响。利血平的镇静作用能被单胺氧化酶抑制剂翻转成为兴奋活动，四氢掌叶防己碱的镇静作用则不受其影响，说明它与利血平的作用方式不同。四氢掌叶防己碱对交感神经节后末梢介质释放的影响与利血平及吗啡亦有区别。它的止痛作用与吗啡有相似处，也有不同处。应用两药的溶液敷于兔脑皮层运动感觉区，均无镇痛作用出现，表示对皮层无直接麻痹作用。但第三脑室周围灰质对吗啡作用较敏感，小鼠脑内注射吗啡有明显的镇痛作用，而这些部位对四氢掌叶防己碱均不甚敏感。因此，四氢掌叶防己碱是一种新型的中枢抑制剂。其镇痛作用的选择性不及吗啡高，安定作用不及氯丙嗪明显，其特点表现在镇静催眠上。作用迅速而显著，易于控制时间。㈤化学结构与作用的关系：四氢掌叶防己碱的左、右旋光异构体作用不同，左旋体具镇痛、镇静作用，右旋体则无；左、右旋光异构体都有协同士的宁惊厥的作用，但以右旋体作用明显。左旋体是中枢抑制剂，右旋体则相反，有短时兴奋现象。"}]},{"ID":"20240830170159-o0jk93t","Type":"NodeParagraph","Properties":{"id":"20240830170159-o0jk93t","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"根据对38个四氢掌叶防己碱类似物的比较研究尚可看出：A.在第Ⅲ环的饱和是保证镇痛；镇静作用的必要条件；B.在母核上以甲基或卤族元素置换时，会使作用减弱；C.四氢掌叶防己碱的甲氧基醚键为其他烷氧基醚键或酯键所代替时，也使作用变弱；D.保持母核四个环的完整性很重要。当母核的第Ⅱ、Ⅲ两环分别裂开仍保持环型三级胺时，使效能减弱。第Ⅱ、Ⅲ两环沟通时，则作用消失。第Ⅱ、Ⅲ两环或第Ⅱ、Ⅲ、Ⅳ三环同时裂开成为链型三级胺时，则作用性质改变，失去中枢抑制作用而出现短时兴奋现象。化学结构与四氢掌叶防己碱很相似的四氢小檗碱也具有镇痛、镇静与安定作用，但四氢掌叶防己碱的镇痛和催眠作用较强，后者则以镇静、安定作用较强，可能与后者结构中出现次甲双氧基有关。"}]},{"ID":"20240830170159-xw0zd6s","Type":"NodeParagraph","Properties":{"id":"20240830170159-xw0zd6s","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②对胃肠道的作用"}]},{"ID":"20240830170159-v5nbdfk","Type":"NodeParagraph","Properties":{"id":"20240830170159-v5nbdfk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"狗皮下注射四氧掌叶防己碱对胃液分泌量没有显著影响，大量则使胃液分泌总量显著减少，胃液酸度及消化力也明显降低。健康成人服延胡索浸剂10克对胃肠运动的影响不大。对于不同动物的在体与离体肠管作用的报道材料尚无一致看法。"}]},{"ID":"20240830170159-tcdlcmg","Type":"NodeParagraph","Properties":{"id":"20240830170159-tcdlcmg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"自延胡索提出之Coryloid，其中含去氢紫堇碱（简称DHC）、右旋紫堇碱、四氢掌叶防己碱、原阿片碱（以前称丙素）。Coryloid或DHC（皮下注射）有显著的抗大鼠实验性胃溃疡特别是幽门结扎及阿司匹林引起的溃疡，原阿片碱对幽门结扎性溃疡、四氢掌叶防己碱对饥饿引起的溃疡有轻度抑制作用，对利血平引起的溃疡则无效。Coryloid及DHC对胃液分泌有抑制作用。其抑制胃液分泌及抗溃疡的作用与副交感神经的阻断无关，可能与机体内儿茶酚胺的作用有关。四氢掌叶防己碱有明显的抗5-羟色胺作用，在整体大鼠并不增加体内5-羟色胺的释放。"}]},{"ID":"20240830170159-kog1j1e","Type":"NodeParagraph","Properties":{"id":"20240830170159-kog1j1e","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"③对内分泌腺的作用"}]},{"ID":"20240830170159-7nn8fad","Type":"NodeParagraph","Properties":{"id":"20240830170159-7nn8fad","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"四氢掌叶防已碱能促进大鼠垂体分泌促肾上腺皮质激素，其作用部位可能在下视丘。小鼠胸腺萎缩法也证明它具有这一作用。大鼠连续注射四氢掌叶防己碱后，便对刺激促皮质素分泌的作用产生耐受或适应，对低温刺激引起的促皮质素释放有明显抑制作用，连续注射还能使甲状脓的重量明显增加，说明还能影响甲状腺的机能。每天皮下注射，对小鼠动情周期有明显抑制作用。"}]},{"ID":"20240830170159-xfbat6x","Type":"NodeParagraph","Properties":{"id":"20240830170159-xfbat6x","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"④吸收、分布与排泄"}]},{"ID":"20240830170159-7hizlfm","Type":"NodeParagraph","Properties":{"id":"20240830170159-7hizlfm","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"小鼠口服四氢掌叶防己碱后吸收迅速而完全，大鼠皮下注射1小时后主要分布于肺、肝、肾。髀及脂肪，而心、血液及脑中含量较少，此后内脏含量下降，脂肪中含量却增加。兔静脉注射时易于透过血脑屏障进入脑组织，在皮层的含量和在丘脑-中脑的相似，持续时间也相近。但脑内含量迅速下降，2小时后低于血中的含量，这可能是四氢掌叶防己碱疗效不持久的原因。兔腹腔注射后24小时内以原形从尿、粪排出者极微。其在机体内转化情况尚未阐明（甲基橙法测定），醉猫血压和心电图则均无明显影响。"}]},{"ID":"20240830170159-h9r2ybr","Type":"NodeParagraph","Properties":{"id":"20240830170159-h9r2ybr","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"猴灌服四氢掌叶防己碱85或110毫升公斤或皮下注射80毫克／公斤无明显毒性，灌服180毫克／公斤，先出现短时兴奋，继之为较严重的后抑制，极度镇静和较深度的催眠作用，感觉并不丧失，随后有四肢震颤和震颤性麻痹，心电图和呼吸均正常，尿中出现管型，数天后可恢复。如每天灌服85毫克／公斤，共2周，除镇静、催眠作用外，第4～7天出现肌肉紧张、四肢震颤，尿中有管型，病理解剖观察内脏无明显变化，切片检查发现心脏和肾脏有轻度混浊肿胀。"}]},{"ID":"20240830170159-fxb6pv8","Type":"NodeParagraph","Properties":{"id":"20240830170159-fxb6pv8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"土延胡的总生物碱有止痛作用，对大鼠离体子宫，小量兴奋，大量则抑制并能对抗乙酰胆碱的兴奋作用。也有协同戊巴比妥钠的镇静作用。对小鼠的半数致死量口服为18.54克生药／公斤、皮下注射为6.24克生药／公斤，较迷延胡索毒性大，疗效指数也较小。"}]},{"ID":"20240830170159-d3wheh8","Type":"NodeParagraph","Properties":{"id":"20240830170159-d3wheh8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"从土延胡中提出一种生物碱单体，暂定名为苏延胡碱。对蛙、小鼠、猫、兔均有强烈的惊厥作用，惊厥形式为阵挛性发作转为强直型。惊厥是作用于整个中枢神经系统的结果，但脊髓以上的中枢更敏感。次惊厥剂量使麻醉兔及猫血压轻度上升，惊厥剂量才出现呼吸兴奋。用苯巴比妥钠可显著减少其惊厥死亡率，三甲双酮较弱，苯妥因钠无效。"}]},{"ID":"20240830170159-akgo45q","Type":"NodeParagraph","Properties":{"id":"20240830170159-akgo45q","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"承德专区野生元胡为齿瓣延胡索及其变种线齿瓣延胡索和为数较少的栉裂齿瓣延胡索，据化学分析含紫堇碱、四氢掌叶防己碱、丑素，但不含原阿片碱、β-高白屈菜碱和四氢黄连碱，而有比枯枯灵存在。"}]},{"ID":"20240830170159-srdgy4d","Type":"NodeParagraph","Properties":{"id":"20240830170159-srdgy4d","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"总生物碱有止痛作用，对大鼠离体子宫小量兴奋，大量抑制并有对抗乙酰胆碱兴奋子宫的作用。小鼠口服总碱，半数致死量为125.3克生药／公斤，而浙江产延胡索为36.59克生药／公斤。二者的安全范围在口服时相近，但皮下注射时，承德品种较小。"}]},{"ID":"20240830170159-5bvb61d","Type":"NodeParagraph","Properties":{"id":"20240830170159-5bvb61d","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【炮制】延胡索：拣去杂质，用水浸泡，洗净，硒晾，润至内外湿度均匀，切片或打碎。醋延胡索：取净延胡索，用醋拌匀。浸润，至醋吸尽，置锅内用文火炒至微干，取出，放凉；或取净延胡索，加醋置锅内共煮，至醋吸净，烘干，取出，放凉。（每延胡索100斤，用醋20斤）"}]},{"ID":"20240830170159-llvk8q9","Type":"NodeParagraph","Properties":{"id":"20240830170159-llvk8q9","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830170159-8bk0s91","Type":"NodeParagraph","Properties":{"id":"20240830170159-8bk0s91","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"辛苦，温。"}]},{"ID":"20240830170159-2dy8cez","Type":"NodeParagraph","Properties":{"id":"20240830170159-2dy8cez","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①《海药本草》：\"味苦甘，无毒。\""}]},{"ID":"20240830170159-yaar8ft","Type":"NodeParagraph","Properties":{"id":"20240830170159-yaar8ft","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"味辛，温，无毒。\""}]},{"ID":"20240830170159-jg5yl1w","Type":"NodeParagraph","Properties":{"id":"20240830170159-jg5yl1w","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830170159-tnjb5j1","Type":"NodeParagraph","Properties":{"id":"20240830170159-tnjb5j1","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"入肝、胃经。"}]},{"ID":"20240830170159-gm2phog","Type":"NodeParagraph","Properties":{"id":"20240830170159-gm2phog","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手足太阴经。\""}]},{"ID":"20240830170159-epdzv1z","Type":"NodeParagraph","Properties":{"id":"20240830170159-epdzv1z","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"入太阴脾、肺，一云又走肝经。\""}]},{"ID":"20240830170159-n7rc94f","Type":"NodeParagraph","Properties":{"id":"20240830170159-n7rc94f","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入心、肺、脾、胃四经。\""}]},{"ID":"20240830170159-ekipasm","Type":"NodeParagraph","Properties":{"id":"20240830170159-ekipasm","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830170159-usre3bz","Type":"NodeParagraph","Properties":{"id":"20240830170159-usre3bz","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"活血，散瘀，理气，止痛。治心腹腰膝诸痛，月经不调，症瘕，崩中，产后血晕，恶露不尽，跌打损伤。"}]},{"ID":"20240830170159-dep848v","Type":"NodeParagraph","Properties":{"id":"20240830170159-dep848v","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"治心痛欲死。\""}]},{"ID":"20240830170159-ppge5e1","Type":"NodeParagraph","Properties":{"id":"20240830170159-ppge5e1","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"除风，治气，暖腰膝，破症癖，扑损瘀血，落胎，及暴腰痛。\""}]},{"ID":"20240830170159-dfrtocv","Type":"NodeParagraph","Properties":{"id":"20240830170159-dfrtocv","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"主破血，产后诸病，因血所为者。妇人月经不调，腹中结块，崩中淋露，产后血运，暴血冲上，因损下血，或酒摩及煮服。\""}]},{"ID":"20240830170159-35skb5u","Type":"NodeParagraph","Properties":{"id":"20240830170159-35skb5u","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"治脾胃气结滞不散，主虚劳冷泻，心腹痛，下气消食。\""}]},{"ID":"20240830170159-u8eh7ly","Type":"NodeParagraph","Properties":{"id":"20240830170159-u8eh7ly","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"活血，利气，止痛，通小便。\""}]},{"ID":"20240830170159-n6p635m","Type":"NodeParagraph","Properties":{"id":"20240830170159-n6p635m","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240830170159-ryldcl4","Type":"NodeParagraph","Properties":{"id":"20240830170159-ryldcl4","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830170159-zbmn32a","Type":"NodeParagraph","Properties":{"id":"20240830170159-zbmn32a","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"孕妇忌服。"}]},{"ID":"20240830170159-7e4vs2j","Type":"NodeParagraph","Properties":{"id":"20240830170159-7e4vs2j","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"妊娠不可服。\""}]},{"ID":"20240830170159-00fm1iz","Type":"NodeParagraph","Properties":{"id":"20240830170159-00fm1iz","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"经事先期及一切血热为病，法所应禁。\""}]},{"ID":"20240830170159-7txp5q7","Type":"NodeParagraph","Properties":{"id":"20240830170159-7txp5q7","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"产后血虚或经血枯少不利，气虚作痛者，皆大非所宜。\""}]},{"ID":"20240830170159-f0p2dz0","Type":"NodeParagraph","Properties":{"id":"20240830170159-f0p2dz0","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830170159-rph3yf8","Type":"NodeParagraph","Properties":{"id":"20240830170159-rph3yf8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①治热瓢心痛，或发或止，久不愈，身热足寒者：玄胡索（去皮）、金铃子肉等分。为末。每温酒或白汤下二钱。（《圣惠方》）"}]},{"ID":"20240830170159-2ylxya2","Type":"NodeParagraph","Properties":{"id":"20240830170159-2ylxya2","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②治下痢腹痛：延胡索三钱，米饮服之，痛即减，调理而安。（《纲目》）"}]},{"ID":"20240830170159-9abiykk","Type":"NodeParagraph","Properties":{"id":"20240830170159-9abiykk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"③治咳喘：醋制玄胡七成，枯矾三成。共研细粉。一日三次，每服一钱。（沈阳《中草药、验方、制剂、栽培选编》）"}]},{"ID":"20240830170159-f1oxvdz","Type":"NodeParagraph","Properties":{"id":"20240830170159-f1oxvdz","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"④治室女血气相搏，腹中刺痛，痛引心端，经行涩少，或经事不调，以致疼痛：玄胡索（醋煮去皮）；当归（去芦，酒浸锉略炒）各一两，橘红二两.上为细末，酒煮米糊为丸，如梧桐子大。每服七十丸，加至一百丸，空心艾汤卞，米饮亦得。（《济生方》三神丸）"}]},{"ID":"20240830170159-efzkw7v","Type":"NodeParagraph","Properties":{"id":"20240830170159-efzkw7v","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑤治产后恶露下不尽，腹内痛：延胡索末，以温酒调下一钱。（《圣惠方》）"}]},{"ID":"20240830170159-ycphyyp","Type":"NodeParagraph","Properties":{"id":"20240830170159-ycphyyp","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑥治坠落车马，筋骨疼痛不止：延胡索一两。捣细罗为散，不计时候，以豆淋酒调下二钱。（《圣惠方》）"}]},{"ID":"20240830170159-nyw74my","Type":"NodeParagraph","Properties":{"id":"20240830170159-nyw74my","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑦治跌打损伤：玄胡炒黄研细，每服一至二钱，开水送服，亦可加黄酒适量同服。（《单方验方调查资料选编》）"}]},{"ID":"20240830170159-k1hmoy7","Type":"NodeParagraph","Properties":{"id":"20240830170159-k1hmoy7","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑧治疝气危急：玄胡索（盐炒）、全竭（去毒，生用）等分。为末，每服半钱，空心盐酒下。（《仁斋直指方》）"}]},{"ID":"20240830170159-sezfd8o","Type":"NodeParagraph","Properties":{"id":"20240830170159-sezfd8o","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑨治小儿盘肠气痛：延胡索、茴香等分。炒研，空心米饮，量儿大小与服。（《卫生易简方》）"}]},{"ID":"20240830170159-aq1wdrg","Type":"NodeParagraph","Properties":{"id":"20240830170159-aq1wdrg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑩治偏正头痛不可忍者：玄胡索七枚，青黛二钱，牙皂二个（去皮子）。为末，水和丸如杏仁大。每以水化一丸，灌入病人鼻内，当有涎出。（《永类钤方》）"}]},{"ID":"20240830170159-9jvsvmx","Type":"NodeParagraph","Properties":{"id":"20240830170159-9jvsvmx","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑾治小便尿血：延胡索一两，朴消七钱半。为末，每服四钱，水煎服。（《类证活人书》）"}]},{"ID":"20240830170159-2fyf42w","Type":"NodeParagraph","Properties":{"id":"20240830170159-2fyf42w","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⑿咳嗽。用延胡索一两、朴硝七钱半，共研为末。每服二钱，软糖一块和药含咽。"}]},{"ID":"20240830170159-lqw661q","Type":"NodeParagraph","Properties":{"id":"20240830170159-lqw661q","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒀尿血。用延胡索一两、朴硝七钱半，共研为末。每服四钱，水煎服。"}]},{"ID":"20240830170159-xv2cs4e","Type":"NodeParagraph","Properties":{"id":"20240830170159-xv2cs4e","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒁皮下气痛或气块痛。用延胡索研细，将猪胰一个，切成小块，灸热蘸药末随时吃下。"}]},{"ID":"20240830170159-5k6ayxn","Type":"NodeParagraph","Properties":{"id":"20240830170159-5k6ayxn","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒂久患心痛，身热足寒。用延胡索（去皮）、金铃子肉，等分为末。每服二钱，温酒或白开水送下。"}]},{"ID":"20240830170159-yq355u5","Type":"NodeParagraph","Properties":{"id":"20240830170159-yq355u5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒃下痢腹痛。用延胡索三钱，米汤送下。"}]},{"ID":"20240830170159-m569l5f","Type":"NodeParagraph","Properties":{"id":"20240830170159-m569l5f","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒄妇女血气前（月经不调，腹中刺痛）。用延胡索（去皮，醋炒）、当归（酒浸，炒）各一两，桔红二两，共研为末，酒煮米糊和药做成丸子，如梧子大。每服一百丸，空心服，艾醋汤送下。"}]},{"ID":"20240830170159-3rchjke","Type":"NodeParagraph","Properties":{"id":"20240830170159-3rchjke","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒅产后诸病（血污不净，产后血晕，腹满心梗，寒热不足，手足烦热等）。用延胡索炒后研细，每服二钱，酒送下，甚效。"}]},{"ID":"20240830170159-pv689d5","Type":"NodeParagraph","Properties":{"id":"20240830170159-pv689d5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒆疝气。用延胡索（盐炒）、全蝎（去毒，生用），等分为末。每服半钱，空心服，盐酒送下。"}]},{"ID":"20240830170159-j8hnlzn","Type":"NodeParagraph","Properties":{"id":"20240830170159-j8hnlzn","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"⒇腰体痛。用延胡索、当归、桂心，等分为末。每服三、四钱，温酒送下。"}]},{"ID":"20240830170159-a6hyqfi","Type":"NodeParagraph","Properties":{"id":"20240830170159-a6hyqfi","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"（21）偏、正头风。用延胡索七枚、青黛二钱、牙皂（去皮，去子）二个，共研为末，滴水各丸，如杏杜大。每次水化一丸，灌入鼻内。偏头产，则在痛侧的鼻孔灌药。同时，令病人咬铜钱一个，当有涎汁大量流出，病即渐愈。"}]},{"ID":"20240830170159-s6u4gk9","Type":"NodeParagraph","Properties":{"id":"20240830170159-s6u4gk9","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830170159-thu3tob","Type":"NodeParagraph","Properties":{"id":"20240830170159-thu3tob","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"①用于止痛"}]},{"ID":"20240830170159-eo06y99","Type":"NodeParagraph","Properties":{"id":"20240830170159-eo06y99","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索有良好的止痛作用，可治疗多种癌症。临床应用除复方煎剂、研粉吞服外，还提取出四氢掌叶防己碱供止痛之用。临床曾对下列两种疾病进行了较系统的观察。㈠麻风神经痛：每日用延胡索3钱，酒炒研末煎服，7天为一疗程。观察43例，平均服药24天后有13例疼痛消失，25例疼痛减轻。以初用时效果较为显着。如调成软膏敷于患处，亦可止痛，但不及内服显着㈡月经痛：用四氢掌叶防己碱50毫克，日服3次（或每日1次用100～150毫克）。治疗44例，显效14例，症状减轻18倒。服药后镇痛作用开始时间在10分钟以后，持续4～24小时不等。副作用有月经减少、嗜睡、头昏、头痛等。"}]},{"ID":"20240830170159-xop4imk","Type":"NodeParagraph","Properties":{"id":"20240830170159-xop4imk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"②用于局部麻醉"}]},{"ID":"20240830170159-5p33hkk","Type":"NodeParagraph","Properties":{"id":"20240830170159-5p33hkk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"用延胡索加工提取制成0.2％延胡索碱注射液行局部麻醉，共作门诊手术105例，效果满意（切皮无反应，手术过程无疼痛感觉，能顺利完成手术）者98例（93.4％）；欠佳（手术过程有轻度疼痛感，但能完成手术）者6例（5.7％）；失败1例（0.9％）。术后随访，大多数切口可预期愈合，仅1例（滑囊炎切除术）切口愈合迟缓。有些患者术后镇痛时间较长；有两例小儿患者（六指切除术）于注射后入睡。未见不良反应及副作用。用法用量：均采用局部浸润麻醉的给药方法。根据手术部位与要求酌情增减用量，最小量6毫克，最大量90毫克。其中5例曾在延胡索注射液中加入1～2滴肾上腺素注射液，以增强麻醉效果。"}]},{"ID":"20240830170159-xy1vv95","Type":"NodeParagraph","Properties":{"id":"20240830170159-xy1vv95","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240830170159-1ayjngd","Type":"NodeParagraph","Properties":{"id":"20240830170159-1ayjngd","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"东北辽宁等地产一种山延胡索，为同属植物东北延胡索的块茎。在《本草》中最早捉及的即为此种，如《本草拾遗》云：\"延胡索生奚国，从安东来，根如半夏，色黄。\"东北地区所产的山延胡索，除上述品种外，还有同属植物迷延胡索和齿瓣延胡索的块茎。"}]},{"ID":"20240830170159-w3uw00k","Type":"NodeParagraph","Properties":{"id":"20240830170159-w3uw00k","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"江苏所产的苏延胡，为同属植物土延胡的块茎，药材直径0.5～1.2厘米，表面黄色至土黄色；断面黄白色，粉状，中间多已裂或空隙，品质较差，产量极小。"}]},{"ID":"20240830170159-0z1j5tg","Type":"NodeParagraph","Properties":{"id":"20240830170159-0z1j5tg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830170159-46l6jeg","Type":"NodeParagraph","Properties":{"id":"20240830170159-46l6jeg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索《中华本草》"}]},{"ID":"20240830170159-w4nwfx8","Type":"NodeParagraph","Properties":{"id":"20240830170159-w4nwfx8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830170159-2m9r8s5","Type":"NodeParagraph","Properties":{"id":"20240830170159-2m9r8s5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.出自《本草纲目拾遗》。"}]},{"ID":"20240830170159-w4btts6","Type":"NodeParagraph","Properties":{"id":"20240830170159-w4btts6","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：延胡索，今二茅山西上龙洞种之。每年寒露后栽，立春后生苗。叶如竹叶样，三月长三寸高；根丛生如芋卵样，立夏掘起。"}]},{"ID":"20240830170159-943wn8o","Type":"NodeParagraph","Properties":{"id":"20240830170159-943wn8o","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánHúSuǒ"}]},{"ID":"20240830170159-hc2fmzx","Type":"NodeParagraph","Properties":{"id":"20240830170159-hc2fmzx","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【英文名】Yanhusuo"}]},{"ID":"20240830170159-53ajdcj","Type":"NodeParagraph","Properties":{"id":"20240830170159-53ajdcj","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【别名】延胡、玄胡索、元胡索、元胡。"}]},{"ID":"20240830170159-vn53uvu","Type":"NodeParagraph","Properties":{"id":"20240830170159-vn53uvu","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830170159-aij89wt","Type":"NodeParagraph","Properties":{"id":"20240830170159-aij89wt","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"药材基源：为罂粟科植物延胡索的块茎。"}]},{"ID":"20240830170159-w65kxmr","Type":"NodeParagraph","Properties":{"id":"20240830170159-w65kxmr","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CorydalisyanhusuoW.T.Wang"}]},{"ID":"20240830170159-q368gjt","Type":"NodeParagraph","Properties":{"id":"20240830170159-q368gjt","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月间当茎叶枯萎时采挖。挖取后，搓掉外面浮皮，洗净，分别大小，放入开水中烫煮，随时翻动，至内部无白心呈黄色时，捞出晒干，置于干燥通风处，防潮及虫蛀。"}]},{"ID":"20240830170159-2brn9e9","Type":"NodeParagraph","Properties":{"id":"20240830170159-2brn9e9","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830170159-48vzxwg","Type":"NodeParagraph","Properties":{"id":"20240830170159-48vzxwg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"延胡索多年生草本，高9-20cm，全株无毛。块茎扁球形，直径7-15mm，上部略凹陷，下部生须根，有时纵裂成数瓣，断面深黄色。"}]},{"ID":"20240830170159-amldg9b","Type":"NodeParagraph","Properties":{"id":"20240830170159-amldg9b","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"茎直立或倾斜，常单一，近基部具鳞片1枚，茎节处常膨大成小块茎，小块茎生新茎，新茎节处又成小块茎，常3-4个成串。基生叶2-4枚；柄长3-8cm；叶片轮廓宽三角形，长3-6cm，宽4-8cm，二回三出全裂，一回裂片具柄，本回裂片近无柄，裂片被针形至长椭圆形，长20-30mm，宽5-8mm，全缘，少数上半部2深裂至浅裂；茎生叶常2枚，互生，较基生叶小而同形。总状花序顶生，长2-5cm，疏生花3-8朵；苞片卵形至狭卵形，位于在序下部者长约10mm，先端3-5栉裂，位于上部者全缘；萼片2，细小，早落；花冠淡紫红色，花瓣4，2轮，外轮上瓣最大，长15-25mm，上部舒展成宽倒卵形至宽椭圆形的兜状瓣片，边缘具小齿，先端有浅凹陷，中下部延伸成长距，下瓣较短，形同上瓣，基部具浅囊状突起，内轮两瓣长10-15mm，合抱裹于雄蕊外，上部宽倒卵形，中、下部细长成爪；雄蕊6，略短于内轮花瓣，每3枚合生成束；于房条形，长8-10mm，花枝细短，柱头近圆形，具乳突8个。葫果条形，长1.7-2.2cm，花柱、柱头宿存，熟时2瓣裂。种子1列，数粒，细小，扁长圆形，黑色，有光泽，表面密布小凹点。栽培品常只开花，果不及成熟即凋落。花期3-4月，果期4-5月。"}]},{"ID":"20240830170159-xxwz9bh","Type":"NodeParagraph","Properties":{"id":"20240830170159-xxwz9bh","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830170159-mhpmkb7","Type":"NodeParagraph","Properties":{"id":"20240830170159-mhpmkb7","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山地林下，或为栽培。"}]},{"ID":"20240830170159-5xh9y2b","Type":"NodeParagraph","Properties":{"id":"20240830170159-5xh9y2b","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"资源分布：分布河北、山东、江苏、浙江等地。药材主产浙江。"}]},{"ID":"20240830170159-cwn7jqz","Type":"NodeParagraph","Properties":{"id":"20240830170159-cwn7jqz","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830170159-gha99gx","Type":"NodeParagraph","Properties":{"id":"20240830170159-gha99gx","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.气候土壤：喜温暖湿润的气候。宜排水良好、肥沃疏松、富有腐殖质的砂质壤土。"}]},{"ID":"20240830170159-wta7113","Type":"NodeParagraph","Properties":{"id":"20240830170159-wta7113","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.整地：秋分前将土地翻耕细耙3-4次，施腐熟堆肥或厩肥作基肥，然后作畦。畦宽1.3m，高30cm。"}]},{"ID":"20240830170159-spy93pj","Type":"NodeParagraph","Properties":{"id":"20240830170159-spy93pj","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.种植：用块茎繁殖。选择芽多、无病虫害、质地坚实的块茎。栽种期以9月下旬至10月上旬（秋分至寒露）时为宜，按行距15-20cm开浅沟，以株距6-10cm栽种块茎，覆土3-5cm，然后施盖腐熟细碎的厩肥或堆肥。每亩约需块茎25-30kg。"}]},{"ID":"20240830170159-cwfionl","Type":"NodeParagraph","Properties":{"id":"20240830170159-cwfionl","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"4.随时拔除杂草，不能松土。2月上旬幼苗长出土面时及4月上旬开花后，各施追肥1次，肥料可用人粪尿或硫酸铵，施用时须用水稀释，不可过浓，以免造成枝叶枯萎或死亡。"}]},{"ID":"20240830170159-axli33h","Type":"NodeParagraph","Properties":{"id":"20240830170159-axli33h","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"5.病虫害防治：5.1.病害：在4月间生长初期,如遇多雨，易引起霜霉病，叶面现白霉，叶片变灰褐，常致植株成片死亡，可用1：1：150的波尔多液进行防治。"}]},{"ID":"20240830170159-pwomlni","Type":"NodeParagraph","Properties":{"id":"20240830170159-pwomlni","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"5.2.虫害：有地老虎，喜食延胡索茎，白丝虫喜食延胡索块茎，如发现苗叶枯萎，即有虫害。可在早晨轻轻翻土捕捉。或在整地时每亩施入6%六六六粉3斤。"}]},{"ID":"20240830170159-lhtcq7i","Type":"NodeParagraph","Properties":{"id":"20240830170159-lhtcq7i","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830170159-zjsq4t0","Type":"NodeParagraph","Properties":{"id":"20240830170159-zjsq4t0","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.1.干燥块茎，呈不规则扁球形，直径1-2cm，表面黄色或褐黄色，顶端中间有略凹陷的茎痕，底部或有疙瘩状凸起。"}]},{"ID":"20240830170159-4svd6xm","Type":"NodeParagraph","Properties":{"id":"20240830170159-4svd6xm","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.2.质坚硬而脆，断面黄色，角质，有蜡样光泽。"}]},{"ID":"20240830170159-ykid1kk","Type":"NodeParagraph","Properties":{"id":"20240830170159-ykid1kk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.3.无臭，味苦。"}]},{"ID":"20240830170159-h06425q","Type":"NodeParagraph","Properties":{"id":"20240830170159-h06425q","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.4.以个大、饱满、质坚、色黄、内色黄亮者为佳。个小、色灰黄、中心有白色者质次。"}]},{"ID":"20240830170159-cjxk4yb","Type":"NodeParagraph","Properties":{"id":"20240830170159-cjxk4yb","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.显微鉴定：2.1.粉末：绿黄色。"}]},{"ID":"20240830170159-vuzsuk0","Type":"NodeParagraph","Properties":{"id":"20240830170159-vuzsuk0","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.1.淀粉粒为粉末的主体。商品多已糊化。未糊化淀粉粒单粒类圆形或长圆形，直径5-30μm,脐点较明显，点状、星状、短缝状或人字状，位于中央或偏向一端，大粒层纹明显；复粒由2-5（-6）分粒组成，以2-3分粒的多见，有的复粒的一分粒较小或较大，大的分粒可见层纹。"}]},{"ID":"20240830170159-fv5ypns","Type":"NodeParagraph","Properties":{"id":"20240830170159-fv5ypns","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.2.下皮厚壁细胞成片，细胞长条形或类多角形，有的一端弯曲，直径21-72μm，长约至230μm，壁厚5-14μm，木化，纹孔细点状，较密，孔沟较短而密，有的呈连珠状。"}]},{"ID":"20240830170159-xv512ka","Type":"NodeParagraph","Properties":{"id":"20240830170159-xv512ka","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.3.皮层厚壁细胞单个散在或少数2个成群，细胞类多角形、纺缍形或类长圆形，边缘不平整，有的凹凸，直径25-90μm，长36-216μm，壁厚5-16μm，木化，纹孔细点状，较密，孔沟较短而密。"}]},{"ID":"20240830170159-j62w2dv","Type":"NodeParagraph","Properties":{"id":"20240830170159-j62w2dv","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.4.石细胞（块茎凹陷部位）单个散离或成群，细胞呈类方形、类圆形、类多角形，有的不明显，孔沟短而密。"}]},{"ID":"20240830170159-7z1khim","Type":"NodeParagraph","Properties":{"id":"20240830170159-7z1khim","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.5.螺纹导管直径18-53μm，有的导管分子边缘不平整，螺状加厚壁互相联结成网状螺纹导管。"}]},{"ID":"20240830170159-o40u319","Type":"NodeParagraph","Properties":{"id":"20240830170159-o40u319","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830170159-qog3dlt","Type":"NodeParagraph","Properties":{"id":"20240830170159-qog3dlt","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.从延胡索的块茎中共提出生物碱10余种，其中经鉴定的有紫堇碱(Corydaline)、dl-四氢掌叶防己碱(dl一Tetra-hydropalmatine)、原阿片碱(Protopine)、L一四氢黄连碱(L-Tetrahy-drocoptisine，L-Stylopin)dl一四氢黄连碱、L-四氢非洲防己碱(L一Tetrahy-drocolumbamine)紫堇鳞茎碱(Corybulbine)、β一高白屈菜碱(β-Homoche-lidonine)、黄连碱(Coptisine)、去氢紫堇碱(De-hydrocorydaline)，还有紫堇达明碱(Corydalmine即紫堇鳞茎碱)、去氢紫堇达明碱。"}]},{"ID":"20240830170159-x0t2097","Type":"NodeParagraph","Properties":{"id":"20240830170159-x0t2097","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.东北延胡索块茎含多种原小檗碱型生物碱，其中有紫堇碱、紫堇达明碱、去氢紫堇达明碱、去氢紫堇碱、黄连碱、四氢黄连碱、四氢非洲防己碱、四氢掌叶防己碱、紫堇鳞茎碱等。另含原阿片碱。迷延胡索块茎含原小檗碱型生物碱，有紫堇碱、去氢紫堇碱。紫堇鳞茎碱、紫堇把明碱(Corypalmine，即四氢药根碱)、L一四氢黄连碱、黄连碱。另含原阿片碱型生物碱原阿片碱和β一高白屈菜碱。又含刺激性挥发油。"}]},{"ID":"20240830170159-c3trrdt","Type":"NodeParagraph","Properties":{"id":"20240830170159-c3trrdt","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.土延胡的块茎中含原阿片碱、L一四氢黄连碱、比枯枯灵(Bicuculline)、苏延胡碱甲(C23H23O7N，熔点205℃)、苏延胡碱乙(C18H19O6N，熔点191-192℃)。朝鲜产延胡索Corydalisbulbosavar.TypicaR.(C.RemotaMaxim.)含原小檗碱型生物碱：小檗碱(Berberine)、氢化小檗碱(Canadine)、四氢黄连碱、黄连碱、四氢刻叶紫堇明碱(Tetrahydrocorysamine)、四氢非洲防己碱和斯氏紫堇碱(Scoulerine)；阿朴芬型生物碱：紫堇定(Corydine)、异紫堇定、去甲异紫堇定(Noriso-corydin)和海罂粟碱(Glaucine)；以及原阿片碱型生物碱：原阿片碱、β一高白屈菜碱(或名α一别隐品碱α一Allocryptopine)。尚含羟链霉素(Reticulin)、豆甾醇、油酸、亚油酸、亚麻酸等。"}]},{"ID":"20240830170159-e7gvb09","Type":"NodeParagraph","Properties":{"id":"20240830170159-e7gvb09","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830170159-4zablho","Type":"NodeParagraph","Properties":{"id":"20240830170159-4zablho","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.对中枢神经系统的影响:1.1.镇痛作用:用电刺激小鼠尾巴法证明，ig延胡索粉有镇痛作用，其效价为阿片的1/10，作用持续2小时。小鼠热板法证明，延胡索甲素、丑素均有显着的镇痛作用。兔乙热刺激法和电总和刺激法证明，iv乙素15-20mg/kg、丑素10-15mg/kg或甲素30-40mg/kg均有镇痛作用。而以乙素、丑素为最强，甲素次之。大鼠sc乙素50mg/kg或丑素40mg/kg也具有与兔相似的镇痛效力。而丙素对小鼠腹腔注射醋酸所致扭体反应以及电刺激法等镇痛试验亦有明显的镇痛作用，但较吗啡弱。大鼠对乙素和丑素的镇痛作用能产生耐受性，产生的速度比吗啡慢1倍，并与吗啡之间有交叉耐受性；实验还表明乙素未发现有成瘾性。"}]},{"ID":"20240830170159-mrbzxl3","Type":"NodeParagraph","Properties":{"id":"20240830170159-mrbzxl3","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.1.催眠、镇静与安定作用:经兔、鼠、犬、猴等试验，较大剂量延胡索乙素有明显的催眠作用。乙素能明显降低小鼠自发活动与被动活动，但不能消除其翻正反射，显示无麻醉作用。乙素能对抗咖啡因和苯丙胺的中枢兴奋作用，对抗戊四氨所致的惊厥，但对土的宁所致的惊厥可增敏。乙素对动物的条件反射有选择性的抑制作用。与氯丙嗪和利血平相似。丑素和癸素的镇静作用均较乙素弱，乙素的中枢作用原理为，对大脑皮层及皮层下的电活动都能抑制，尤以皮层运动区较为敏感。但把药液直按涂于皮层上或孤离皮层的实验中，均证明乙素不是直接影响皮层。把药液注入脑室，大剂量时可产生镇痛及镇静作用，乙素能明显的抑制刺激皮肤引起的惊醒反应，并能阻断网状结构上行激活系统及下行性功能。这些都证明乙素对皮层下结构有一定的选择作用。乙素的作用部位广泛，不象吗啡作用部位专一，其镇痛作用虽不如吗啡强大，但有较好的镇静和安定效能。乙素的光学异构体作用亦不同，左旋乙素有镇痛和镇静作用，较大剂量对猴子有震颤表现；右旋体反而有短时兴奋作用。左、右旋体都有增敏士的宁惊厥的作用，但以右旋体为明显。乙素对犬有轻度的中枢性镇吐作用，对大鼠有轻度的降温作用。"}]},{"ID":"20240830170159-d7q3exg","Type":"NodeParagraph","Properties":{"id":"20240830170159-d7q3exg","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.对消化系统的作用:延胡索浸剂对豚鼠离体肠管（1：1000-1：10，000）呈兴奋作用，但对兔及大鼠离体小肠无显着作用。而乙索在1：2×10浓度时，能抑制兔离体肠管活动，并能阻断乙酰胆碱、氯化钡及脑垂体后叶素和5一HT对肠肌的兴奋作用。乙素对大鼠离体的胃和结肠，能对抗5-HT引起的收缩。但在整体动物，如在巴甫洛夫小胃的犬做试验，乙素20-40mg/kg，对胃液分泌及胃酸无明显影响，应用大剂量（80mg/kg）时胃液的分泌才受到明显抑制，胃液酸度及消化力亦有减弱。去氢延胡索甲素能保护因饥饿或药物（考的松、利血平等）所产生的大鼠实验性溃疡病，减少胃液分泌、胃酸及胃蛋白酶的量，在切断迷走神经后仍有抗分泌作用，可见对副交感神经无阻断作用。消旋体四氢巴马汀对麻醉开胸犬iv后，LVSP，dp/dtmax及VcE±dp/dtmax等指标均出现明显的先兴奋后抑制的双向作用，另dl-四氢巴马汀有抗失律失常作用。"}]},{"ID":"20240830170159-y0juft7","Type":"NodeParagraph","Properties":{"id":"20240830170159-y0juft7","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的影响：延胡索醇提物有显着扩张离体兔心和在体猫心的冠状血管、降低冠脉阻力与增加血流量的作用。对麻醉犬冠状动脉的扩张作用最明显，颈内动脉次之。对股动脉也有一定的扩张作用，其扩张血管的作用可能是解除疼痛作用的原因之一。延胡索醇提物还能增加麻醉犬的心输出量、降低血压和总外周阻力，对左心室压和左心室dp/dtmax无明显影响。表明延胡索并不加强心肌的收缩力，心输出量增加可能是由于外周血管扩张之故。小鼠ip给药可使心肌对86Rb的摄取量明显增加。延胡索总碱5或10mg/kgiv，能对抗脑垂体后叶素所致豚鼠异常心电图。多次给予延胡索醇提物，可明显减轻皮下大剂量给于异丙基肾上腺素所产生的心肌坏死程度，也提示延胡索具有改善坏死边缘区营养性供血的能力。对心肌梗塞可能有一定的防治作用。延胡索醇提物ip于小鼠，可明显提高动物对常压或减压缺氧的耐受能力。延胡索总碱对乌头碱诱发的大鼠心律失常有明显的治疗作用。总碱水中不溶部分明显超过相同剂量的总碱治疗组，说明乌头碱心律失常的成分存在于水不溶部分中，可能属于叔胺碱部分。"}]},{"ID":"20240830170159-fwwgc22","Type":"NodeParagraph","Properties":{"id":"20240830170159-fwwgc22","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"4.对垂体-肾上腺皮质系统功能的影响：给大鼠sc延胡索乙素50或70mg/kg（有效镇痛和安定剂量）后，肾上腺维生素C含量明显下降，说明延胡索乙素有兴奋垂体肾上腺系统的作用。给去垂体大鼠注射延胡索乙素并不能引起肾上腺维生素C含量下降，表明延胡索乙素兴奋垂体-肾上腺系统的作用在于引起垂体促肾上腺皮质激素的分泌，而不是直接兴奋肾上腺皮质，给大鼠注射戊巴比妥钠40mg/kg，或注射去氢皮质醇（Prednisolone）15mg/kg后，延胡索乙素引起垂体促肾上腺皮质激素释放的作用消失，说明延胡索乙素的这一作用部位有可能在下视丘。每日给大鼠注射延胡索乙素70mg/kg，连续6次后，对低温（8℃或4℃）刺激引起的ACTH释放有明显的抑制作用。"}]},{"ID":"20240830170159-1iliysf","Type":"NodeParagraph","Properties":{"id":"20240830170159-1iliysf","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"5.对肌肉的松弛作用溴化甲基延胡索乙素、四氢巴马汀对兔、离体豚鼠的实验表明，对其肌肉有松弛作用。"}]},{"ID":"20240830170159-h807myz","Type":"NodeParagraph","Properties":{"id":"20240830170159-h807myz","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"6.炮制品的药理作用采用小白鼠扭体法和热板法测定了产地醋制元胡和传统醋制的镇痛作用。结果表明产地醋制元胡比传统醋制镇痛作用强（表9，表10）。其小白鼠ig的LD50分别为135.765g/kg（传统醋制品）；146.554g/kg（产地醋品）。"}]},{"ID":"20240830170159-r2erv6o","Type":"NodeParagraph","Properties":{"id":"20240830170159-r2erv6o","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240830170159-vxmwxn5","Type":"NodeParagraph","Properties":{"id":"20240830170159-vxmwxn5","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.毒性四氢掌叶防已碱、癸素、丑素、B一高白屈菜碱静脉注射对小鼠最小致死量分别为102、42、150、41mg/kg。紫堇碱、四氢掌叶防己碱、原阿片碱、丑素静脉注射半数致死量分别为146、151-158、35.9、100mg/kg（小鼠），癸素腹腔注射为127mg/kg（小鼠）。麻醉猫静脉注射四氢掌叶防己碱40mg/kg，血压稍降，一小时恢复，对心机能无明显影响；丑素30mg/kg，多数猫血压无严重影响，但心电图有T波倒置，毒性比四氢掌叶防己碱大，安全范围比四氢掌叶防己碱小；紫堇碱对麻醉猫血压和心电图则均无明显影响。猴灌服四氢掌叶防己碱85或110mg/kg或皮下注射80mg/kg无明显毒性，灌服180mg/kg，先出现短时兴奋，继之为较严重的后抑制，极度镇静和较深度的催眠作用，感觉并不丧失，随后有四肢震颤和震颤性麻痹，心电图和呼吸均正常，尿中出现管型，数天后可恢复。如每天灌服85mg/kg，共2周，除镇静、催眠作用外，第4-7天出现肌肉紧张、四肢震颤，尿中有管型，病理解剖观察内脏无明显变化，切片检查发现心脏和肾脏有轻度混浊肿胀。"}]},{"ID":"20240830170159-vrkj4wq","Type":"NodeParagraph","Properties":{"id":"20240830170159-vrkj4wq","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.土延胡的总生物碱有止痛作用，对大鼠离体子宫，小量兴奋，大量则抑制并能对抗乙酰胆碱的兴奋作用。也有协同戊巴比妥钠的镇静作用。对小鼠的半数致死量口服为18.54g生药/kg、皮下注射为6.24g生药/kg，较迷延胡索毒性大，疗效指数也较小。从土延胡中提出一种生物碱单体，暂定名为苏延胡碱。对蛙、小鼠、猫、兔均有强烈的惊厥作用，惊厥形式为阵挛性发作转为强直型。惊厥是作用于整个中枢神经系统的结果，但脊髓以上的中枢更敏感。次惊厥剂量使麻醉兔及猫血压轻度上升，惊厥剂量才出现呼吸兴奋。用苯巴比妥钠可显着减少其惊厥死亡率，三甲双酮较弱，苯妥因钠无效。承德专区野生元胡为齿瓣延胡索及其变种线齿瓣延胡索（CorydalisremotaFischvar.LinearilobaMaxim）和为数较少的栉裂齿瓣3.延胡索（CorydalisremotaFischvar.pectinataKom），据化学分析含紫堇碱、四氢掌叶防已碱、丑素，但不含原阿片碱、B一高白屈菜碱和四氢黄连碱，而有比枯枯灵存在。总生物碱有止痛作用，对大鼠离体子宫小量兴奋，大量抑制并有对抗乙酰胆碱兴奋子宫的作用。小鼠口服总碱，半数致死量为125.3g生药/kg，而浙江产延胡索为36.59g生药/kg。二者的安全范围在口服时相近，但皮下注射时，承德品种较小。给猴一次灌胃乙素85mg/kg或110mg/kg,或者皮下注射80mg/kg,均未见明显毒性，仅有镇静、催眠现象；如给予180mg/kg，则先出现短时间的兴奋，继而转为较严重的抑制，随后发生四肢震颤和巴金森综合症，尿中有管型。猴每天灌胃乙素85mg/kg，给药1-3天的反应与上述1次给予85mg/kg或110mg/kg的反应相似，给药4-7天的反应与一次给药180mg/kg的情况相似。连用2周后作病理切片检查，发现心、肾有轻度水肿。乙素、甲素、丑素小鼠静脉注射的LD50分别为151mg/kg、146mg/kg及100mg/kg，癸素小鼠腹腔注射的LD50为127mg/kg。去氢延胡索素对小鼠的LD50，灌胃为277.5±19.0mg/kg，腹腔注射为21.1±1.4mg/kg,静脉注射为8.8±0.4mg/kg。延胡索醇浸膏对小鼠po的LD50为100±4.53g/kg，延胡索乙素、丙素、丑素给小鼠ivLD50分别为146、151-158、100mg/kg。癸素ip对小鼠的LD50为127mg/kg。麻醉猫iv乙素40mg/kg后，则使血压略降，心率减慢，心脏功能无明显变化，正常兔iv乙素20-40mg/kg时，呼吸短暂兴奋，剂量增大至60mg/kg时，则呼吸呈现抑制。猴1次ig乙素85或100mg/kg，或sc80mg/kg无明显毒性；igl80mg/kg，先出现短时兴奋，继而较严重的抑制，极度镇静和较深度的催眠作用，感觉并不丧失，随后发生四肢震颤性巴金森氏综合征，心电图和呼吸均正常，尿中有管型，数天后可恢复。当每天ig85mg/kg，连续2周,除出现镇静、催眠作用外，于第4-7天的反应基本与igl80mg/kg者相似。肉眼观察内脏无明显变化，组织病理检查发现心脏和肾脏有轻度混浊肿胀。"}]},{"ID":"20240830170159-xo0z2vx","Type":"NodeParagraph","Properties":{"id":"20240830170159-xo0z2vx","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【鉴别】1.取本品粉末2g，加硫酸液0.25mol/L20ml，振摇片刻，滤过。取滤液2ml，加1%铁氰化钾溶液0.4ml与1%三氯化铁溶液0.3ml的混合液，即显深绿色，放置后底部有较多深蓝色沉淀。（酚类反应）2.取本品粉末2g,加10%醋酸20ml,振摇片刻，滤过。取滤液2ml,滴加碘化铋钾试液，立即产生桔红色沉淀。(生物碱反应)3.薄层层析：取本品粉末2g,加浓氨水数滴使润湿，密塞15分钟，加苯20ml冷浸24小时，滤过，滤液水浴上浓缩至约2ml供点样。另取四氢巴马亭配成每ml含1mg的对照品溶液5μl，以环己烷-氯仿-甲醇-二乙胺（5:3:0.5:1滴）为展开剂，展距13cm，取出晾干后置碘蒸气中3-5S，取出在紫外光灯（365nm）下观察，四氢巴马亭显亮绿黄色荧光斑点，样品液色谱中显相同荧光斑点，Rf值约0.45。"}]},{"ID":"20240830170159-gseq81h","Type":"NodeParagraph","Properties":{"id":"20240830170159-gseq81h","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830170159-mzflh6f","Type":"NodeParagraph","Properties":{"id":"20240830170159-mzflh6f","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.延胡索：拣去杂质，用水浸泡，洗净，晒晾，润至内外湿度均匀，切片或打碎。"}]},{"ID":"20240830170159-8ie8jin","Type":"NodeParagraph","Properties":{"id":"20240830170159-8ie8jin","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.醋延胡索：取净延胡索，用醋拌匀，浸润，至醋吸尽，置锅内用文火炒至微干，取出，放凉；或取净延胡索，加醋置锅内共煮，至醋吸净，烘干，取出，放凉。（每延胡索100斤，用醋20斤）。"}]},{"ID":"20240830170159-rthv9o6","Type":"NodeParagraph","Properties":{"id":"20240830170159-rthv9o6","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.酒延胡索：取净延胡索片或碎块，加黄酒拌匀，闷透，置锅内用文火加热，炒干，取出放凉。每延胡索100kg，黄酒20kg。"}]},{"ID":"20240830170159-tdd5voi","Type":"NodeParagraph","Properties":{"id":"20240830170159-tdd5voi","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【性味】辛；苦；温；无毒"}]},{"ID":"20240830170159-8oqwp7f","Type":"NodeParagraph","Properties":{"id":"20240830170159-8oqwp7f","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【归经】肝；胃；心；肺；脾经"}]},{"ID":"20240830170159-orfuo9m","Type":"NodeParagraph","Properties":{"id":"20240830170159-orfuo9m","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血；散瘀；理气；止痛。主心腹腰膝诸痛；月经不调；症瘕；崩中；产后血晕；恶露不尽；跌打损伤"}]},{"ID":"20240830170159-8wfntg3","Type":"NodeParagraph","Properties":{"id":"20240830170159-8wfntg3","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5-3钱；或入丸、散。"}]},{"ID":"20240830170159-te2ktaa","Type":"NodeParagraph","Properties":{"id":"20240830170159-te2ktaa","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830170159-qz12e77","Type":"NodeParagraph","Properties":{"id":"20240830170159-qz12e77","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"血热气虚及孕妇忌服。"}]},{"ID":"20240830170159-fo7f4s0","Type":"NodeParagraph","Properties":{"id":"20240830170159-fo7f4s0","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.《品汇精要》:妊娠不可服。"}]},{"ID":"20240830170159-44sbg06","Type":"NodeParagraph","Properties":{"id":"20240830170159-44sbg06","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：经事先期及一切血热为病，法所应禁。"}]},{"ID":"20240830170159-7vo5vxa","Type":"NodeParagraph","Properties":{"id":"20240830170159-7vo5vxa","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：产后血虚或经血枯少不利，气虚作痛者，皆大非所宜。"}]},{"ID":"20240830170159-6c6u1c4","Type":"NodeParagraph","Properties":{"id":"20240830170159-6c6u1c4","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【附方】1.金铃子散(《素问病机气宜保命集》)，主治肝郁有热，心腹胁肋诸痛，时发时目，口苦，舌红苔黄，脉弦数。2.延胡索散(《济生方》)，活血行气，调经止痛，主治妇人室女，七情伤感，遂使气与血并，心腹作痛，或连腰胁，上下攻刺，经候不调，一切血气疼痛。3.手拈散(《奇效良方》)，主治心腹刺痛。4.三棱丸(《妇科准绳》)，主治妇女经脉不通，气滞带下血瘕。5.三神丸(《济生方》)，主治室女血气相搏，腹中刺痛，痛引心端，经行涩少，或经事不调，以致疼痛。6.沉香降气散(《张氏医通》)，主治胃脘胀闷，嗳气频繁，大便不畅，疼痛。7.少腹逐瘀汤、膈下逐瘀汤(《医林改错》)，活血祛瘀，行气止痛，主治瘀在膈下，形成积块；或小儿痞块；或肚腹疼痛，疼处不移；或卧侧腹坠似有物。"}]},{"ID":"20240830170159-aeyc1y3","Type":"NodeParagraph","Properties":{"id":"20240830170159-aeyc1y3","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830170159-6n1u8zu","Type":"NodeParagraph","Properties":{"id":"20240830170159-6n1u8zu","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：治心痛欲死。"}]},{"ID":"20240830170159-3y8h6ew","Type":"NodeParagraph","Properties":{"id":"20240830170159-3y8h6ew","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：除风，治气，暖腰膝，破症癖，扑损瘀血，落胎，及暴腰痛。"}]},{"ID":"20240830170159-0o7cqa8","Type":"NodeParagraph","Properties":{"id":"20240830170159-0o7cqa8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"3.《开宝本草》：主破血，产后诸病，因血所为者。妇人月经不调，腹中结块，崩中淋露，产后血运，暴血冲上，因损下血，或酒摩及煮服。"}]},{"ID":"20240830170159-h6bjb7m","Type":"NodeParagraph","Properties":{"id":"20240830170159-h6bjb7m","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"4.《医学启源》：治脾胃气结滞不散，主虚劳冷泻，心腹痛，下气消食。"}]},{"ID":"20240830170159-8yotujj","Type":"NodeParagraph","Properties":{"id":"20240830170159-8yotujj","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：活血，利气，止痛，通小便。"}]},{"ID":"20240830170159-uv94w8q","Type":"NodeParagraph","Properties":{"id":"20240830170159-uv94w8q","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"6.《海药本草》:延胡索，主肾气，破产后恶露及儿枕，与三棱、鳖甲、大黄为散，能散气，通经络。蛀蚛成末者，使之惟良，偏生产后病也。"}]},{"ID":"20240830170159-siygx67","Type":"NodeParagraph","Properties":{"id":"20240830170159-siygx67","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"7.《纲目》:延胡索，能行血中气滞，气中血滞，故专治一身上下诸痛，用之中的，妙不可言。8.《本草经疏》:延胡索，温则能和畅，和畅则气行；辛则能润而走散，走散则血活。血活气行，故能主破血及产后诸病因血所为者。妇人月经之所以不调者，无他，气血不和，因而凝滞，则不能以时至，而多后期之证也。腹中结块，产后血晕，暴血冲上，因损下血等证，皆须气血和而后愈，故悉主之也。崩中淋露，利守不利走，此则非与补气血药同用，未见其可。9.《本草汇言》:玄胡索，凡用之行血，酒制则行；用之上血，醋制则止；用之破血，非生用不可；用之调血，非炒用不神。随病制宜，应用无穷者也。"}]},{"ID":"20240830170159-4ftv3bk","Type":"NodeParagraph","Properties":{"id":"20240830170159-4ftv3bk","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"10.《本草求真》:延胡索，不论是血是气，积而不散者，服此力能通达，以其性温，则于气血能行能畅，味辛则于气血能润能散，所以理一身上下诸痛，往往独行功多。然此既无益气之情，复少养营之义，徒仗辛温攻凝逐滞，虚人当兼补药同用，否则徒损无益。"}]},{"ID":"20240830170159-qc9lnxu","Type":"NodeParagraph","Properties":{"id":"20240830170159-qc9lnxu","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"11.《本草正义》：延胡，虽为破滞行血之品，然性情尚属和缓，不甚猛烈，古人必以酒为导引，助其运行，其本性之不同于峻厉，亦可想见。而又兼能行气，不专于破瘀见长，故能治内外上下气血不宣之病，通滞散结，主一切肝胃胸腹诸痛，盖攻破通导中之冲和品也。"}]},{"ID":"20240830170159-mmg7ou8","Type":"NodeParagraph","Properties":{"id":"20240830170159-mmg7ou8","updated":"20240830170251"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830170201-j0wsr79","Type":"NodeThematicBreak","Properties":{"id":"20240830170201-j0wsr79","updated":"20240830170251"}},{"ID":"20240830170202-yg99m7g","Type":"NodeParagraph","Properties":{"id":"20240830170202-yg99m7g","updated":"20240830170251"}}]}