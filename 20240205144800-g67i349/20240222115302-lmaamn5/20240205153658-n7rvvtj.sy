rties":{"id":"20240724101957-6d47i4i","updated":"20240724102043"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苏木 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苏木 14-20240724101957-prx8sta.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 431px;","style":"width: 421px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苏木 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苏木 15-20240724102043-3l3jk87.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 421px;\" parent-style=\"width: 431px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724102315-zk3gttp","Type":"NodeParagraph","Properties":{"id":"20240724102315-zk3gttp","updated":"20240724102320"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：苏木入药的部位是去除树皮后的树干中心部分"}]},{"ID":"20240724100755-8a9p2zc","Type":"NodeParagraph","Properties":{"id":"20240724100755-8a9p2zc","updated":"20240724102323"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：古代的官服就是用苏木染出来的，也常用于制作胭脂；"}]},{"ID":"20240724100756-c0vhrlr","Type":"NodeThematicBreak","Properties":{"id":"20240724100756-c0vhrlr"}},{"ID":"20240902160920-zjf9kbw","Type":"NodeParagraph","Properties":{"id":"20240902160920-zjf9kbw","updated":"20240902160927"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：苏木"}]},{"ID":"20240902160920-iti2no2","Type":"NodeParagraph","Properties":{"id":"20240902160920-iti2no2","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木《中国药典》"}]},{"ID":"20240902160920-vu3ro04","Type":"NodeParagraph","Properties":{"id":"20240902160920-vu3ro04","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【拼音名】SūMù"}]},{"ID":"20240902160920-7h9wppq","Type":"NodeParagraph","Properties":{"id":"20240902160920-7h9wppq","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【英文名】LIGNUMSAPPAN"}]},{"ID":"20240902160920-b50b7a6","Type":"NodeParagraph","Properties":{"id":"20240902160920-b50b7a6","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【别名】苏方木"}]},{"ID":"20240902160920-smlm460","Type":"NodeParagraph","Properties":{"id":"20240902160920-smlm460","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【来源】本品为豆科云实属植物苏木CaesalpiniasappanL.的干燥心材。多于秋季采伐，除去白色边材，干燥。"}]},{"ID":"20240902160920-19hpsei","Type":"NodeParagraph","Properties":{"id":"20240902160920-19hpsei","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈长圆柱形或对剖半圆柱形，长10～100cm，直径3～12cm。表面黄红色至棕红色，具刀削痕，常见纵向裂缝。横断面略具光泽，年轮明显，有的可见暗棕色、质松、带亮星的髓部。质坚硬。无臭，味微涩。"}]},{"ID":"20240902160920-nn1r2jz","Type":"NodeParagraph","Properties":{"id":"20240902160920-nn1r2jz","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902160920-lajyzqj","Type":"NodeParagraph","Properties":{"id":"20240902160920-lajyzqj","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"（1）取本品一小块，滴加氢氧化钙试液显深红色。"}]},{"ID":"20240902160920-s1yy7sf","Type":"NodeParagraph","Properties":{"id":"20240902160920-s1yy7sf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"（2）本品横切面；射线宽1～2列细胞。导管类圆形，直径约至160μｍ，常含黄棕色或红棕色物。木纤维多角形，壁极厚。木薄壁细胞壁厚，木化，有的含草酸钙方晶。髓部薄壁细胞不规则多角形，大小不一，壁微木化，具纹孔。"}]},{"ID":"20240902160920-g73mopd","Type":"NodeParagraph","Properties":{"id":"20240902160920-g73mopd","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末10g，加水50ml，放置4小时，时时振摇，滤过，滤液显橘红色，置紫外光灯（365nm）下观察，显黄绿色荧光；取滤液5ml，加氢氧化钠试液2滴，显猩红色，置紫外光灯（365nm）下观察，显蓝色荧光，再加盐酸使呈酸性后，溶液变为橙色，置紫外光灯（365nm）下观察，显黄绿色荧光。"}]},{"ID":"20240902160920-fkwg1ld","Type":"NodeParagraph","Properties":{"id":"20240902160920-fkwg1ld","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【炮制】锯成长约3cm的段，再劈成片或碾成粗粉。"}]},{"ID":"20240902160920-5yzagy5","Type":"NodeParagraph","Properties":{"id":"20240902160920-5yzagy5","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性味】甘、咸，平。"}]},{"ID":"20240902160920-r2v6al2","Type":"NodeParagraph","Properties":{"id":"20240902160920-r2v6al2","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【归经】归心、肝、脾经。"}]},{"ID":"20240902160920-0xxr11p","Type":"NodeParagraph","Properties":{"id":"20240902160920-0xxr11p","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【功能主治】行血祛瘀，消肿止痛。用于经闭痛经，产后瘀阻，胸腹刺痛，外伤肿痛。"}]},{"ID":"20240902160920-2808c1i","Type":"NodeParagraph","Properties":{"id":"20240902160920-2808c1i","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240902160920-ez6vjyy","Type":"NodeParagraph","Properties":{"id":"20240902160920-ez6vjyy","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【注意】月经过多及孕妇慎用。"}]},{"ID":"20240902160920-037hy1w","Type":"NodeParagraph","Properties":{"id":"20240902160920-037hy1w","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902160920-772yomt","Type":"NodeParagraph","Properties":{"id":"20240902160920-772yomt","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902160920-w6atud4","Type":"NodeParagraph","Properties":{"id":"20240902160920-w6atud4","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木《*辞典》"}]},{"ID":"20240902160920-gl6oo5s","Type":"NodeParagraph","Properties":{"id":"20240902160920-gl6oo5s","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【出处】《医学启源》"}]},{"ID":"20240902160920-sa17or3","Type":"NodeParagraph","Properties":{"id":"20240902160920-sa17or3","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【拼音名】SūMù"}]},{"ID":"20240902160920-wjsxnck","Type":"NodeParagraph","Properties":{"id":"20240902160920-wjsxnck","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【别名】苏枋（《南方草木状》），苏方（《肘后方》），苏方木（《唐本草》），窊木（《诸蕃志》），棕木（《中国主要植物图说·豆科》），赤木（《兽医国药及处方》），红柴（《四川中药志》）。"}]},{"ID":"20240902160920-i283f3i","Type":"NodeParagraph","Properties":{"id":"20240902160920-i283f3i","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【来源】为豆科植物苏木的干燥心材。全年可采。除去外皮及边材，取心材，晒干。"}]},{"ID":"20240902160920-8m1rc7d","Type":"NodeParagraph","Properties":{"id":"20240902160920-8m1rc7d","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿小乔木，高可达5～10米。树干有小刺，小枝灰绿色，具圆形凸出的皮孔，新枝被微柔毛，其后脱落。叶为2回双数羽状复叶，全长达30厘米或更长；羽片对生，9～13对，长6～15厘米，叶轴被柔毛；小叶9～16对，长圆形，长约14毫米，宽约6毫米，先端钝形微凹，全缘，上面绿色无毛，下面具细点，无柄；具锥刺状托叶。圆锥花序，顶生，宽大多花，与叶等长，被短柔毛；花黄色，径10～15毫米；萼基部合生，上部5裂，裂片略不整齐；花瓣5，其中4片圆形，等大，最下1片较小，上部长方倒卵形，基部约1／2处窄缩成爪状；雄蕊10，花丝下部被棉状毛；子房上位，1室。荚果长圆形，偏斜，扁平，厚革质，无刺，无刚毛，顶端一侧有尖喙，长约7.5厘米，直径约3.5厘米，成熟后暗红色，具短茸毛，不开裂，含种子4～5。花期5～6月。果期9～10月。"}]},{"ID":"20240902160920-tesy7xm","Type":"NodeParagraph","Properties":{"id":"20240902160920-tesy7xm","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【生境分布】分布广西、广东、台湾、贵州、云南、四川等地。产于广西、云南、台湾、广东（海南岛）、四川等地。"}]},{"ID":"20240902160920-rdr8im9","Type":"NodeParagraph","Properties":{"id":"20240902160920-rdr8im9","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902160920-h748yww","Type":"NodeParagraph","Properties":{"id":"20240902160920-h748yww","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"干燥心材呈圆柱形，有的连接根部，呈不规则稍弯曲的长条状，长8～100厘米，直径3～10厘米。表面暗棕色或黄棕色，可见红黄色相间的纵走条纹，有刀削痕及细小的凹入油孔。横断面有显着的年轮，有时中央可见黄白色的髓，并具点状闪光。质致密，坚硬而重，无臭，味微涩。将本品投入热水中，水染成鲜艳的桃红色，加醋则变为黄色，再加碱又变为红色。以粗大、坚实、色红黄者为佳。"}]},{"ID":"20240902160920-nops63q","Type":"NodeParagraph","Properties":{"id":"20240902160920-nops63q","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木刨片为不规则的长条形，厚约0.5毫米，宽狭不一，通常宽约1厘米左右，全体呈红黄色或黄棕色，少数带有黄白色的边材；表面有纵纹。质脆，易断。"}]},{"ID":"20240902160920-hw919ai","Type":"NodeParagraph","Properties":{"id":"20240902160920-hw919ai","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【化学成份】木部含无色的原色素-巴西苏木素约2％。巴西苏木素遇空气即氧化为巴西苏木红素。另含苏木酚，可做有机试剂，检查铝离子。又含挥发油，油的主要成分为水芹烯及罗勒烯。还含鞣质。"}]},{"ID":"20240902160920-179oio9","Type":"NodeParagraph","Properties":{"id":"20240902160920-179oio9","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902160920-3n20vva","Type":"NodeParagraph","Properties":{"id":"20240902160920-3n20vva","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①对心血管的作用"}]},{"ID":"20240902160920-hvnqi0j","Type":"NodeParagraph","Properties":{"id":"20240902160920-hvnqi0j","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"在蟾蜍下肢灌流时，苏木水能使血管轻度收缩；以后用亚硝酸钠也不能使血管扩张。如先用亚硝酸钠，再用苏木才同样不能使血管收缩。在离体蛙心标本上，适量苏木水能使收缩力增强，并可使由枳壳煎剂减弱的心收缩力有所恢复。还能解除水合氯醛、奎宁、毛果芸香碱、毒扁豆碱、尼可丁等对离体蛙心的毒性。"}]},{"ID":"20240902160920-qgki55z","Type":"NodeParagraph","Properties":{"id":"20240902160920-qgki55z","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②中枢抑制作用"}]},{"ID":"20240902160920-zbnqlc4","Type":"NodeParagraph","Properties":{"id":"20240902160920-zbnqlc4","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"适量苏木水，用不同给药方法，对小鼠、兔、豚鼠均有催眠作用，大量尚有麻醉作用，甚至死亡。能对抗士的宁与可卡因的中枢兴奋作用。但不能对抗吗啡的兴奋性。"}]},{"ID":"20240902160920-osoaj2c","Type":"NodeParagraph","Properties":{"id":"20240902160920-osoaj2c","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240902160920-tx3gkgu","Type":"NodeParagraph","Properties":{"id":"20240902160920-tx3gkgu","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木煎液（10％）对金黄色葡萄球菌和伤寒杆菌作用较强，效价均达1：1600（纸碟法及试管法）。浸、煎剂对白喉杆菌、流感杆菌、副伤寒丙杆菌、弗氏痢疾杆菌、金黄色葡萄球菌、溶血性链球菌、肺炎球菌等作用显著，对百日咳杆菌、伤寒杆菌、副伤寒甲、乙杆菌及肺炎杆菌等亦有作用（试管法和平板法）。"}]},{"ID":"20240902160920-3c7i3j0","Type":"NodeParagraph","Properties":{"id":"20240902160920-3c7i3j0","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240902160920-6qwym1s","Type":"NodeParagraph","Properties":{"id":"20240902160920-6qwym1s","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木煎剂必须在10％以上对体外肝蛭才有效；试用于牛体内，抗肝蛭作用不确实。腹腔或皮下注射适量苏木水，可使犬呕吐与腹泻。无抗组织胺及减轻局部刺激作用。对离体子宫略有抑制，若与肾上腺素合用则作用明显。无解热作用。"}]},{"ID":"20240902160920-ooc3e0b","Type":"NodeParagraph","Properties":{"id":"20240902160920-ooc3e0b","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"同属植物鹰叶刺的核仁的醇提取物对麻醉动物有降压作用，并能抑制蛙心。苦味的树脂部分有中枢抑制、退热作用及对离体肠管的解痉作用，还有明显的杀虫（蚯蚓法）作用。对各种细菌，水-醇提取物及树脂部分也有某些抑制作用"}]},{"ID":"20240902160920-vtzu9cn","Type":"NodeParagraph","Properties":{"id":"20240902160920-vtzu9cn","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【炮制】《雷公炮炙论》：\"凡使（苏木），去上粗皮并节了……细锉了，重捣，拌细条梅枝蒸，从巳至申，出，阴干用。\""}]},{"ID":"20240902160920-waegbbo","Type":"NodeParagraph","Properties":{"id":"20240902160920-waegbbo","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902160920-vlplupx","Type":"NodeParagraph","Properties":{"id":"20240902160920-vlplupx","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"甘咸，平。"}]},{"ID":"20240902160920-d4am5vf","Type":"NodeParagraph","Properties":{"id":"20240902160920-d4am5vf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味甘咸，平，无毒。\""}]},{"ID":"20240902160920-ndsdmw3","Type":"NodeParagraph","Properties":{"id":"20240902160920-ndsdmw3","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"寒。\""}]},{"ID":"20240902160920-vovbabv","Type":"NodeParagraph","Properties":{"id":"20240902160920-vovbabv","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"《主治秘诀》云，性凉，味微辛。\""}]},{"ID":"20240902160920-vbgsos1","Type":"NodeParagraph","Properties":{"id":"20240902160920-vbgsos1","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"④《汤液本草》：\"甘而酸辛，性平。\""}]},{"ID":"20240902160920-n7vbdwz","Type":"NodeParagraph","Properties":{"id":"20240902160920-n7vbdwz","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑤《会约医镜》：\"味甘辛咸，微温。\""}]},{"ID":"20240902160920-34gda64","Type":"NodeParagraph","Properties":{"id":"20240902160920-34gda64","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902160920-is9fgju","Type":"NodeParagraph","Properties":{"id":"20240902160920-is9fgju","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"入心、肝经。"}]},{"ID":"20240902160920-lp3a2c4","Type":"NodeParagraph","Properties":{"id":"20240902160920-lp3a2c4","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"三阴经血分。\""}]},{"ID":"20240902160920-otm467m","Type":"NodeParagraph","Properties":{"id":"20240902160920-otm467m","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②《本草经琉》：\"入足厥阴、手少阴、足阳明经。\""}]},{"ID":"20240902160920-h71l39x","Type":"NodeParagraph","Properties":{"id":"20240902160920-h71l39x","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入肝、胃、大肠三经。\""}]},{"ID":"20240902160920-mlftzzu","Type":"NodeParagraph","Properties":{"id":"20240902160920-mlftzzu","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902160920-0cj4f74","Type":"NodeParagraph","Properties":{"id":"20240902160920-0cj4f74","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"行血，破瘀，消肿，止痛。治妇人血气心腹痛，经闭，产后瘀血胀痛喘急，痢疾，破伤风，痈肿，扑损瘀滞作痛。"}]},{"ID":"20240902160920-vlbshyf","Type":"NodeParagraph","Properties":{"id":"20240902160920-vlbshyf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"主破血，产后血胀闷欲死者。\""}]},{"ID":"20240902160920-2fswh2t","Type":"NodeParagraph","Properties":{"id":"20240902160920-2fswh2t","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主霍乱呕逆及人常呕吐，用水煎服之。破血当以酒煮为良。\""}]},{"ID":"20240902160920-m107utn","Type":"NodeParagraph","Properties":{"id":"20240902160920-m107utn","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③《海药本草》：\"主虚劳血癖气壅滞；产后恶露不安，腹中搅痛；及经络不通，男女中风，口噤不语。宜细研乳头香细末方寸匕，酒煎苏方去滓调服，立吐恶物瘥。\""}]},{"ID":"20240902160920-7orvvnp","Type":"NodeParagraph","Properties":{"id":"20240902160920-7orvvnp","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治妇人血气心腹痛，月侯不调及蓐劳。排脓止痛，消痈肿扑损瘀血，女人失音，血噤，赤白痢并后分急痛。\""}]},{"ID":"20240902160920-x73fwr5","Type":"NodeParagraph","Properties":{"id":"20240902160920-x73fwr5","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑤《医学启源》：\"《主治秘诀》云，发散表里风气。\"\"破死血。\""}]},{"ID":"20240902160920-s0njsxf","Type":"NodeParagraph","Properties":{"id":"20240902160920-s0njsxf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑥李杲：\"破疮疡死血，产后败血。\""}]},{"ID":"20240902160920-n5w4g9o","Type":"NodeParagraph","Properties":{"id":"20240902160920-n5w4g9o","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑦《医林篆要》：\"补心散瘀，除血分妄作之风热。\""}]},{"ID":"20240902160920-wirog0i","Type":"NodeParagraph","Properties":{"id":"20240902160920-wirog0i","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；研末或熬膏。外用：研末撒。"}]},{"ID":"20240902160920-gbmoagn","Type":"NodeParagraph","Properties":{"id":"20240902160920-gbmoagn","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902160920-yu05jxv","Type":"NodeParagraph","Properties":{"id":"20240902160920-yu05jxv","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"血虚无瘀者不宜，孕妇忌服。"}]},{"ID":"20240902160920-ejdf10q","Type":"NodeParagraph","Properties":{"id":"20240902160920-ejdf10q","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"忌铁。\""}]},{"ID":"20240902160920-gg1eokw","Type":"NodeParagraph","Properties":{"id":"20240902160920-gg1eokw","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"产后恶霹已净，由血虚腹痛者不宜用。\""}]},{"ID":"20240902160920-1o1yes4","Type":"NodeParagraph","Properties":{"id":"20240902160920-1o1yes4","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"大便不实者禁用。\""}]},{"ID":"20240902160920-gbmpu9f","Type":"NodeParagraph","Properties":{"id":"20240902160920-gbmpu9f","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902160920-ok4gamf","Type":"NodeParagraph","Properties":{"id":"20240902160920-ok4gamf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"①治妇人月水不通，烦热疼痛：苏枋木二两（锉），硇砂半两（研），川大黄（末）一两。上药，先以水三大盏，煎苏木至一盏半，去滓，入硇砂、大黄末，同熬成膏。每日空心，以温酒调下半大匙。（《圣惠方》苏枋木煎）"}]},{"ID":"20240902160920-faak2m3","Type":"NodeParagraph","Properties":{"id":"20240902160920-faak2m3","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"②治产后气滞作喘：苏木、人参、麦门冬，水煎服。（《妇科玉尺》苏木汤）"}]},{"ID":"20240902160920-k74rzn0","Type":"NodeParagraph","Properties":{"id":"20240902160920-k74rzn0","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"③治产后血运，腹闷，气喘急欲死：苏枋木（末）二两，荷叶（炙）一枚，芍药一两半，桂（去粗皮）一两，鳖甲（去裙襕，醋炙）一两半。上五味，锉如麻豆大，以水五盏，藕汁一合。同煎取二盏，去滓，入红雪一两，分温二服，粥食前，如人行三、五里再服。（《圣济总录》苏枋饮）"}]},{"ID":"20240902160920-0qfn8cm","Type":"NodeParagraph","Properties":{"id":"20240902160920-0qfn8cm","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"④治血晕：苏木五钱，煎水，加童便一杯，顿服。（《陆川本草》）"}]},{"ID":"20240902160920-h936229","Type":"NodeParagraph","Properties":{"id":"20240902160920-h936229","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑤治被打伤损，因疮中风：苏木（槌令烂，研）二两。用酒二升，煎取一升。分三服，空心、午时、夜卧各一服。（《圣济总录》苏木酒）"}]},{"ID":"20240902160920-q608gsx","Type":"NodeParagraph","Properties":{"id":"20240902160920-q608gsx","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑥治破伤风：苏枋木不拘多少，捣罗为细散。每服三钱匕，酒调服之。（《圣济总录》独圣散）"}]},{"ID":"20240902160920-rrd6ucc","Type":"NodeParagraph","Properties":{"id":"20240902160920-rrd6ucc","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑦治指断，亦治其余皮肤刀矢伤：真正沉重苏木，为细末，敷断指间，外用蚕茧包缚完固。（《摄生众妙方》接指方）"}]},{"ID":"20240902160920-td9yiau","Type":"NodeParagraph","Properties":{"id":"20240902160920-td9yiau","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"⑧治偏坠肿痛：用苏木二两，好酒一壶。煮熟频饮。（《濒湖集简方》）"}]},{"ID":"20240902160920-2cffpv1","Type":"NodeParagraph","Properties":{"id":"20240902160920-2cffpv1","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902160920-ywe7253","Type":"NodeParagraph","Properties":{"id":"20240902160920-ywe7253","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"苏木《中华本草》"}]},{"ID":"20240902160920-8ff60xu","Type":"NodeParagraph","Properties":{"id":"20240902160920-8ff60xu","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902160920-ue32ks2","Type":"NodeParagraph","Properties":{"id":"20240902160920-ue32ks2","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"出自《医学启源》。"}]},{"ID":"20240902160920-v2g3fqq","Type":"NodeParagraph","Properties":{"id":"20240902160920-v2g3fqq","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：苏方木，若有中心文横如紫角者，号曰木中尊色，其力倍常百等。"}]},{"ID":"20240902160920-gs2fy4q","Type":"NodeParagraph","Properties":{"id":"20240902160920-gs2fy4q","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：苏木，煎汁忌铁器，则色黯。其木蠹之粪，名曰紫纳，亦可用。"}]},{"ID":"20240902160920-uo1h77m","Type":"NodeParagraph","Properties":{"id":"20240902160920-uo1h77m","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【拼音名】SūMù"}]},{"ID":"20240902160920-f1mfjjf","Type":"NodeParagraph","Properties":{"id":"20240902160920-f1mfjjf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【英文名】SappanWood"}]},{"ID":"20240902160920-od7hkum","Type":"NodeParagraph","Properties":{"id":"20240902160920-od7hkum","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【别名】苏枋、苏方、苏方木、棕木、赤木、红柴、红苏木、落文树"}]},{"ID":"20240902160920-r93c928","Type":"NodeParagraph","Properties":{"id":"20240902160920-r93c928","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902160920-946fxvo","Type":"NodeParagraph","Properties":{"id":"20240902160920-946fxvo","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物苏木的心材。"}]},{"ID":"20240902160920-qlmuolf","Type":"NodeParagraph","Properties":{"id":"20240902160920-qlmuolf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CaesalpiniasappanL."}]},{"ID":"20240902160920-u6hhwpb","Type":"NodeParagraph","Properties":{"id":"20240902160920-u6hhwpb","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"采收和储藏：苏木种植后8年可采入药。把树干砍下，削去外围的白色边材，截成每段长60cm，粗者对半剖开，阴干后，扎捆置阴凉干燥处贮藏。"}]},{"ID":"20240902160920-ofiznpi","Type":"NodeParagraph","Properties":{"id":"20240902160920-ofiznpi","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【原形态】苏木灌木或小乔木，高5-10。树干有刺。小枝灰绿色，具圆形突出的皮孔，新枝被柔毛。二回羽状复叶，长达40cm，羽片7-13对，对生，叶轴被柔毛；小叶9-17对，对生，长圆形至长圆状菱形，长约14mm，宽约6mm，先端钝形微凹，基部歪斜，全缘。上面绿色，无毛，下面具腺点，中脉偏斜。圆锥花序项生或腋生。长约与叶相等，被短柔毛；苞片大，披针形，早落；花梗长约15mm，被细柔毛；花托浅钟形；萼片5，稍不等，下面1片比较大，呈兜状；花瓣黄色，阔倒卵形，长约9mm，最上面1片基部带粉红色，具柄；雄蕊10，离生，2轮排列，稍伸出，花丝细，上部扭曲，下部密被柔毛；雌蕊1.花柱细长，子房有灰色绒毛，花柱被毛，柱头截平。荚果木质、稍压扁，近长圆形至长圆状倒卵形，长约7cm，宽3.5-4cm，基部稍狭，先端斜向平截，先端有喙，红棕色，不开裂。种子3-4颗，长圆形，稍扁，长约2cm，褐黄色。花期5-10月，果期7月至翌年3月。"}]},{"ID":"20240902160920-7pf2zrp","Type":"NodeParagraph","Properties":{"id":"20240902160920-7pf2zrp","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902160920-eyp5q6u","Type":"NodeParagraph","Properties":{"id":"20240902160920-eyp5q6u","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔200-1050m的山谷丛林中或栽培。"}]},{"ID":"20240902160920-o7i8o1i","Type":"NodeParagraph","Properties":{"id":"20240902160920-o7i8o1i","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于云南金沙江河谷和红河河谷。福建、台湾、广东、海南、广西、四川、贵州、云南等地有栽培。"}]},{"ID":"20240902160920-niji7qv","Type":"NodeParagraph","Properties":{"id":"20240902160920-niji7qv","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902160920-ckxs6l1","Type":"NodeParagraph","Properties":{"id":"20240902160920-ckxs6l1","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"生物学特性喜向阳，忌阴和积水，耐旱。多分布在雨量较少的地区。耐轻霜。一般热带和南亚热带地区都可种植。对土壤要求不严，适于破壤、粘壤及冲积土上种植。"}]},{"ID":"20240902160920-bpx50f0","Type":"NodeParagraph","Properties":{"id":"20240902160920-bpx50f0","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖，多采用育苗移栽法，也可直播。育苗移栽，可用塑料袋育苗和苗床育苗，2月份选饱满无虫蛀、有光泽、坚实的种子播入袋内土中或苗床上。每袋播种l-2颗；苗床育苗按行距20cm×5cm开沟点播。待苗高30cm左右时，选择阴雨天移苗定植。大田直播，雨季选阴雨天进行，每穴播种2-3颗，深1．5-2cm，盖草保湿，出苗时揭去稻草。直播苗高20cm时间苗，每穴留粗壮苗1株。"}]},{"ID":"20240902160920-h0lae9g","Type":"NodeParagraph","Properties":{"id":"20240902160920-h0lae9g","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"田间管理苗期经常除草、松土、浇水、保证成活，待苗高至1．5-2m时进行修技，把主干基部的分枝剪去，促使主干粗大，加速药用心材的增加。高2.5m以后，管理可以粗放。采伐作药后留下的树桩，进行松土施肥，浇水，促使萌发更新。"}]},{"ID":"20240902160920-ktuqfma","Type":"NodeParagraph","Properties":{"id":"20240902160920-ktuqfma","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"病虫害防治有吹绵介壳虫为害茎叶。若虫期可用波美0.5度石硫合剂或50%马拉硫磷乳剂600倍液喷雾。成虫期用乙硫磷1000-2000倍液或25%亚胺硫磷乳剂1000倍液喷雾防治。"}]},{"ID":"20240902160920-igun3en","Type":"NodeParagraph","Properties":{"id":"20240902160920-igun3en","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902160920-piwv8fb","Type":"NodeParagraph","Properties":{"id":"20240902160920-piwv8fb","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"性状鉴别本品呈长圆柱形或对剖半圆柱形，长10-100cm，直径3-12cm。表面黄红色至棕红色，具刀削痕和枝痕，常见纵向裂缓。横断面略具光泽，年轮明显，有的可见暗棕色、质松、带亮点的髓部。质坚硬。无臭，味徽涩。"}]},{"ID":"20240902160920-jzjvvtg","Type":"NodeParagraph","Properties":{"id":"20240902160920-jzjvvtg","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"显微鉴别心材横切面：射线宽1-2列细胞。导管类圆形，直径约至160μm，常含黄棕色或红棕色物。木纤维多角形，壁极厚。木薄壁细胞壁厚，木化，有的含草酸钙方晶。髓部薄壁细胞不规则多角形，大小不一，壁微木化，具纹孔。"}]},{"ID":"20240902160920-m95fjlt","Type":"NodeParagraph","Properties":{"id":"20240902160920-m95fjlt","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄红色。①木纤维及晶纤维极多，成束，橙黄色或无色。纤维细长，直径9-22μm，壁厚或稍厚，斜纹孔稀疏，胞腔线形或较宽大。有的纤维束周围细胞中含草酸钙方晶，形成晶纤维，含晶细胞类方形，壁不均匀增厚，木化。②木射线径向纵断面碎片较易见，细胞呈长方形，长32-60μm，直径16-26μm，壁连珠状增厚，木化，具单纹孔，切向壁及纹孔较密，孔沟明显；切向纵断面射线宽l-2（-3）列细胞，高约至62个细胞，纹孔显着。③具线纹孔导管大小不一，大者直径约至160μm，多破碎，具缘纹孔排列较密，互列．纹孔口椭圆形或短缝状，导管中常含棕色块状物。④草酸钙方品较少，板状、长方形、类方形或类双锥形，直径约至17μm。⑤木细胞长方形或狭长，长58-108μpm，直径约17μm，壁稍厚，木化，纹孔明显。⑥棕色块呈不规则块状。"}]},{"ID":"20240902160920-awp9ono","Type":"NodeParagraph","Properties":{"id":"20240902160920-awp9ono","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【化学成份】心材含色原烷类化合物：3-（3’，4-二羟基苄基）-7-羟基-4-色原烷酮[3-（3，ˊ4ˊ-dihydroxybenzvl）-7-hydroxychroman-4-one]即是3-脱氧苏木酮B（3-deoxysappaneB），3-（3ˊ，4ˊ-二羟基亚苄基）-7-羟基-4-色原烷酮[3-（3ˊ，4ˊ-dihydroxybenzylidene）-7-hydroxychroman-4-one]，3-（3ˊ，4ˊ-二羟基苄基）-3，7-二羟基-4色原烷酮[3-（3ˊ，4ˊ-dihydroxybenzyl）-3，7-dihy-droxychroman-4-one]即是苏木酮B（sappanoneB），3-（3ˊ，4ˊ-二羟基苄基）-4，7-二羟基色原烷醇［3-（3ˊ4ˊ-dihydroxybenzyl）-4，7-dihydroxychromanol]，3ˊ（3ˊ，4ˊ-二羟基苄基）-7-羟基-4-甲氧基色原烷醇[3-（3ˊ，4ˊ-dihydroxybenzyl）-7-hydroxy-4-methoxychromanol）的左旋体和右旋体，7-羟基-（4ˊ-羟基亚苄基）-4-色原烷酮（7-hydroxy-3-（4ˊ-hydroxybenzylidene）-chroman-4-one]，3，7-二羟基-3-（4ˊ-羟基苄基）-4-色原烷酮［3，7-dihydroxy-3-（4ˊ-hydroxybonzyl)chroman-4-one]即是3ˊ-去氧苏木酮B（3ˊ-deoxysappanoneB），7-羟基-8-甲氧基-3-（4ˊ-甲氧基亚苄基）-4-色原烷酮[7-hydroxy-8-methoxy-3-（4ˊ-methoxybenzylidene）chroman-4-one]，3，4，7-三羟基-3-（4ˊ-羟基苄基）色原烷［3，4，7-trihydroxy-3-(4ˊ-hydroxybenzyl)chroman]，苏木酚(sappanol)，表苏木酚(episappanol)，3ˊ-去氧苏木酚(3ˊ-deoxysappanol)，3ˊ-O-甲基苏木酚(3ˊ-O-methylsappanol)，3ˊ-O-甲基表苏木酚(3ˊ-O-methylepisappanol)，4-O-甲基苏木酚(4-O-methylsappanol)，4-O-甲基表苏木酚(4-O-methylepisappanol)。还含巴西苏木素(drazilin)，3ˊ-O-甲基巴西苏木素(3ˊ-O-methylbrazilin)和巴西苏木素衍生物(brazilinderivatives)1及2。又含商陆黄素(ombuin)，鼠李素(rhamnetin)，槲皮素(quercetin)等黄酮类和4，4ˊ-二羟基-2ˊ-甲氧基查耳酮(4，4ˊ-dihydroxy-2ˊ-methoxychalcone)，2ˊ-甲氧基-3，4，4ˊ-三羟基查耳酮(2ˊ-methoxy-3，4，4ˊ-trihydroxychalcone)即是苏木查耳酮(sappanchalcone)。又含二苯并环氧庚烷类化合物：原苏木素(protosappanin)A、B、C、E-1、E-2及10-O-甲基原苏木素B(10-O-methylprotosappaninB)。还含苏木苦素(calsalpin)J、P，二十八醇(octacosanol)，β-谷甾醇(β-sitosterol)及蒲公英赛醇(taraxerol)。"}]},{"ID":"20240902160920-b7hn4yo","Type":"NodeParagraph","Properties":{"id":"20240902160920-b7hn4yo","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902160920-o4f78m8","Type":"NodeParagraph","Properties":{"id":"20240902160920-o4f78m8","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"1．对循环系统的影响对于肾上腺素所致小鼠肠系膜微循环障碍，苏木水煎醇提取液能显着促进微动脉血流促进微循环和管径的恢复，但在所试20种活血化瘀药中苏木的作用仅属中等强度。犬静注苏木水煎醇提取液还可增加冠脉流量，降低冠脉阻力，减少心率，减低左室作功，但增；加心肌耗氧量。当以20mg（生药）/kg股动脉直接注射时，是所试活血化瘀药中唯一不能显着增加麻醉犬外周血流量的药物。"}]},{"ID":"20240902160920-hnl28fv","Type":"NodeParagraph","Properties":{"id":"20240902160920-hnl28fv","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"2．对血液的影响对于静注高分子右旋糖酐引起实验性血瘀证家兔的血液，苏木注射液在试管内能显着降低血液粘度在各种切速下苏木的作用均非常显着，但在所试20种活血药中苏木的作用为较弱者；对于红细胞聚集指数苏木无显着影响。对于ADP诱导的大鼠血小板聚集，100mg/ml的苏木有抑制作用。巴西苏木素衍生物1，2均有抗高胆固醇血症的作用。"}]},{"ID":"20240902160920-c6hls8g","Type":"NodeParagraph","Properties":{"id":"20240902160920-c6hls8g","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"3．抗癌作用以人早幼粒白血病细胞株HL-60为靶细胞，苏木水提取液0.5mg(生药)/kg有细胞毒作用，对小鼠淋巴瘤细胞株Yac-1、人红髓白血病细胞株K562及小鼠成纤维细胞株L929苏木煎剂也有较强作用。EAC荷瘤小鼠苏木煎剂腹腔注射也能显着延长其生存时间。对于小鼠实验性白血病，苏木也能显着延长P388及L1210的生存时间，1：1煎剂每日腹腔注射0．1ml及0．2ml，连续7d的延长百分率分别为97．8%、107．8%（P388）及102．6%、117．5%（L1210）。日本报告苏木于体外对HL-60细胞的最低抑制浓度为0．2%，在此浓度作用下，3、6h后抑制率分别为20%及35%，增加苏木浓度，抑制作用增强，但即使苏木浓度仍为0．2%，作用时间延长至24h，其制率也可达50%以上。在苏木作用下，HL-60的谷氨酰胺合成酶的活性也受抑制，此作用也随药浓度增加而加强。此外，苏木还有抑制诱变效果。"}]},{"ID":"20240902160920-fiiy48p","Type":"NodeParagraph","Properties":{"id":"20240902160920-fiiy48p","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"4．其他作用苏木还有抑制醛糖还原酶抑制作用，其所含山苏查耳酮对该酶的IC50为1．2×10-6mol/L。另早年曾有报告，苏木对小鼠、兔、豚鼠于不同给药途径均有催眠作用，剂量加大还有麻醉作用，并能对抗士的宁、可卡因的中枢兴奋作用。此外，苏木混剂和煎剂在体外对金黄色葡萄球菌、溶血性链球菌、肺炎链球菌、白喉杆菌、流感杆菌、弗氏痢疾杆菌及副伤寒丙杆菌等多种细菌有较强的抑菌作用，对百日咳杆菌、伤寒杆菌、副伤寒甲、乙杆菌及肺炎杆菌也有抑制作用。"}]},{"ID":"20240902160920-ddo2saw","Type":"NodeParagraph","Properties":{"id":"20240902160920-ddo2saw","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"5．毒性苏木煎剂腹腔注射对小鼠的LD50为18.9/kg。"}]},{"ID":"20240902160920-j0908ms","Type":"NodeParagraph","Properties":{"id":"20240902160920-j0908ms","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【毒性】毒性：苏木水提液腹腔注射对小鼠的LD50为18.9g/kg。苏木水提液腹腔注射给于小鼠的LD50为18.9ml／kg。"}]},{"ID":"20240902160920-soh1cvq","Type":"NodeParagraph","Properties":{"id":"20240902160920-soh1cvq","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【鉴别】（1）取本品1小块，滴加氢氧化钙试液显深红色。（检查苏木色素）（2）取本品粉末1g,加水50ml，放置4h，时时振摇，滤过，滤液显橘红色，置紫外光灯（365nm）下观察，显黄绿色荧光；取滤波5ml，加氢氧化钠试液2滴，显猩红色，置紫外光灯（365nm）下观察，显蓝色荧光，再加盐酸使呈酸性后，溶液变为橙色，置紫外光灯（365nm）下观察，显黄绿色荧光。（检查巴西苏木素）"}]},{"ID":"20240902160920-0yg9ukc","Type":"NodeParagraph","Properties":{"id":"20240902160920-0yg9ukc","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【炮制】去上粗皮并节了细锉了，重捣，拌细条梅枝蒸，从已至申，出，阴干用。"}]},{"ID":"20240902160920-8lp1wgu","Type":"NodeParagraph","Properties":{"id":"20240902160920-8lp1wgu","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【性味】甘；咸；平；无毒"}]},{"ID":"20240902160920-161sxpr","Type":"NodeParagraph","Properties":{"id":"20240902160920-161sxpr","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【归经】心；肝；胃；大肠经"}]},{"ID":"20240902160920-pwlsyhw","Type":"NodeParagraph","Properties":{"id":"20240902160920-pwlsyhw","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血祛瘀，消肿定痛。主妇人血滞经闭，痛经，产后瘀阻心腹痛，产后血晕，痈肿，跌打损伤，破伤风"}]},{"ID":"20240902160920-1jfgd2f","Type":"NodeParagraph","Properties":{"id":"20240902160920-1jfgd2f","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g,或研末。外用：适量，研末撒。"}]},{"ID":"20240902160920-eq212fg","Type":"NodeParagraph","Properties":{"id":"20240902160920-eq212fg","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902160920-g60s1lf","Type":"NodeParagraph","Properties":{"id":"20240902160920-g60s1lf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"1.血虚无瘀者不宜，孕妇忌服。"}]},{"ID":"20240902160920-7bb9t9o","Type":"NodeParagraph","Properties":{"id":"20240902160920-7bb9t9o","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：忌铁。"}]},{"ID":"20240902160920-lqrfkvs","Type":"NodeParagraph","Properties":{"id":"20240902160920-lqrfkvs","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：产后恶露已净，由血虚腹痛者不宜用。"}]},{"ID":"20240902160920-tpui9jp","Type":"NodeParagraph","Properties":{"id":"20240902160920-tpui9jp","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：大便不实者禁用。"}]},{"ID":"20240902160920-o4q9qqq","Type":"NodeParagraph","Properties":{"id":"20240902160920-o4q9qqq","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【附方】1.苏枋木煎(《太平圣惠方》)，用治妇人月水不通，烦热疼痛等症。2.苏木汤(《妇科玉尺》)，用治产后气滞作喘。3.苏枋饮(《圣济总录》)，用治产后血晕，腹闷，气喘急欲死者。4.苏木酒(《圣济总录》)，治跌打损伤，因疮中风等症。5.独圣散(《圣济总录》)，治破伤风。6.接指方(《摄生众妙方》)，用治指断，亦治皮肤刀矢伤。7.苏木散(《痧胀玉衡》)，用治痧毒血瘀成块，坚硬突起不移者。"}]},{"ID":"20240902160920-97x1kth","Type":"NodeParagraph","Properties":{"id":"20240902160920-97x1kth","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902160920-l2hrb73","Type":"NodeParagraph","Properties":{"id":"20240902160920-l2hrb73","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：主破血，产后血胀闷欲死者。"}]},{"ID":"20240902160920-uew4sh3","Type":"NodeParagraph","Properties":{"id":"20240902160920-uew4sh3","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：主霍乱呕逆及人常呕吐，用水煎服之。破血当以酒煮为良。"}]},{"ID":"20240902160920-ryb5fgn","Type":"NodeParagraph","Properties":{"id":"20240902160920-ryb5fgn","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"3.《海药本草》：主虚劳血癖气壅滞；产后恶露不安，腹中搅痛；及经络不通，男女中风，口噤不语。宜细研乳头香细末方寸匕，酒煎苏方去滓调服，立吐恶物瘥。"}]},{"ID":"20240902160920-gm2d2nf","Type":"NodeParagraph","Properties":{"id":"20240902160920-gm2d2nf","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治妇人血气心腹痛，月候不调及蓐劳。排脓止痛，消痈肿扑损瘀血，女人失音，血噤，赤白痢并后分急痛。"}]},{"ID":"20240902160920-yszyqr3","Type":"NodeParagraph","Properties":{"id":"20240902160920-yszyqr3","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"5.《医学启源》：《主治秘诀》云，发散表里风气。破死血。"}]},{"ID":"20240902160920-jq3eb9s","Type":"NodeParagraph","Properties":{"id":"20240902160920-jq3eb9s","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"6.李果：破疮疡死血，产后败血。"}]},{"ID":"20240902160920-oian5lt","Type":"NodeParagraph","Properties":{"id":"20240902160920-oian5lt","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"7.《医林纂要》：补心散瘀，除血分妄作之风热。"}]},{"ID":"20240902160920-w22s0so","Type":"NodeParagraph","Properties":{"id":"20240902160920-w22s0so","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"8.《用药心法》：苏木，去风与防风同用。"}]},{"ID":"20240902160920-aoiqanj","Type":"NodeParagraph","Properties":{"id":"20240902160920-aoiqanj","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"9.《本草纲目》：苏枋木，少用则和血，多用则破血。"}]},{"ID":"20240902160920-t0yhe48","Type":"NodeParagraph","Properties":{"id":"20240902160920-t0yhe48","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"10.《本草经疏》：苏方木，凡积血与夫产后血胀闷欲死，无非心、肝二经为病，此药咸主入血，辛能走散，败浊瘀积之血行，则二经清宁，而诸证自愈。《日华子》、《海药》所主，悉取其入血行血。辛咸消散，亦兼有软坚润下之功，故能祛一切凝滞留结之血，妇人产后尤为所须耳。"}]},{"ID":"20240902160920-x21fwfw","Type":"NodeParagraph","Properties":{"id":"20240902160920-x21fwfw","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"11.《本经逢原》：苏木阳中之阴，降多升少，肝经血分药也。性能破血，产后血胀闷欲死者，苦酒煮浓汁服之。本虚不可攻者，用二味参苏饮，补中寓泻之法，凛然可宗。但能开泄大便，临症宜审。若因恼怒气阻经闭者，宜加用之。"}]},{"ID":"20240902160920-x9e2vnj","Type":"NodeParagraph","Properties":{"id":"20240902160920-x9e2vnj","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"12.《本草求真》：苏木，功用有类红花，少用则能和血，多用则能破血。但红花性微温和，此则性微寒凉也。故凡病因表里风起，而致血滞不行，暨产后血晕胀满以（欲）死，及血痛血瘕、经闭气壅、痈肿、跌扑损伤等症，皆宜相症合以他药调治。"}]},{"ID":"20240902160920-g670z0v","Type":"NodeParagraph","Properties":{"id":"20240902160920-g670z0v","updated":"20240902160955"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902160921-j4w0dzr","Type":"NodeThematicBreak","Properties":{"id":"20240902160921-j4w0dzr","updated":"20240902160955"}},{"ID":"20240902160922-vapcdzp","Type":"NodeParagraph","Properties":{"id":"20240902160922-vapcdzp","updated":"20240902160955"}}]}