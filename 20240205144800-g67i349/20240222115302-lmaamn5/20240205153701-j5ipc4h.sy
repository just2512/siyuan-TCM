apn3mx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 760px;\" parent-style=\"width: 770px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730105924-tys6xx1","Type":"NodeParagraph","Properties":{"id":"20240730105924-tys6xx1","updated":"20240730105924"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 693px;","style":"width: 683px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马钱子 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马钱子 9-20240730105924-47kjtrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 683px;\" parent-style=\"width: 693px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马钱子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马钱子 10-20240730110130-8t57vxl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730110323-ud2xdsh","Type":"NodeParagraph","Properties":{"id":"20240730110323-ud2xdsh","updated":"20240730110323"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 725px;","style":"width: 715px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马钱子 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马钱子 11-20240730110323-4rs7w67.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 715px;\" parent-style=\"width: 725px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 547px;","style":"width: 537px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马钱子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马钱子 2-20240730104941-oanjyro.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 537px;\" parent-style=\"width: 547px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730111520-bsuo5tj","Type":"NodeParagraph","Properties":{"id":"20240730111520-bsuo5tj","updated":"20240730111633"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"钩吻、马钱子"}]},{"ID":"20240730111644-ovvarsi","Type":"NodeParagraph","Properties":{"id":"20240730111644-ovvarsi","updated":"20240730111644"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 438px;","style":"width: 428px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻、马钱子对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻、马钱子对比-20240730111644-2tk6nun.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 428px;\" parent-style=\"width: 438px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730111520-419fsrv","Type":"NodeParagraph","Properties":{"id":"20240730111520-419fsrv","updated":"20240903092153"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：马钱子跟钩吻的花有些微相像，两者都有剧毒，注意甄别；（马钱子是树，钩吻是藤；）"}]},{"ID":"20240730111651-5lr0dqf","Type":"NodeParagraph","Properties":{"id":"20240730111651-5lr0dqf","updated":"20240730111705"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：马钱子剧毒，请在专业人士指导下使用；"}]},{"ID":"20240730112345-m3qb35i","Type":"NodeParagraph","Properties":{"id":"20240730112345-m3qb35i","updated":"20240730112503"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：为马钱子植物的种子；"}]},{"ID":"20240730102611-oo9usug","Type":"NodeThematicBreak","Properties":{"id":"20240730102611-oo9usug"}},{"ID":"20240903092113-nq78ymv","Type":"NodeParagraph","Properties":{"id":"20240903092113-nq78ymv","updated":"20240903092122"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：马钱子"}]},{"ID":"20240903092113-rezxahm","Type":"NodeParagraph","Properties":{"id":"20240903092113-rezxahm","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱子《全国中草药汇编》"}]},{"ID":"20240903092113-zk1qdn8","Type":"NodeParagraph","Properties":{"id":"20240903092113-zk1qdn8","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎQiánZǐ"}]},{"ID":"20240903092113-qhda43i","Type":"NodeParagraph","Properties":{"id":"20240903092113-qhda43i","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENSTRYCHNI"}]},{"ID":"20240903092113-bja8exs","Type":"NodeParagraph","Properties":{"id":"20240903092113-bja8exs","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【别名】番木鳖"}]},{"ID":"20240903092113-sky8yp4","Type":"NodeParagraph","Properties":{"id":"20240903092113-sky8yp4","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【来源】本品为马钱科植物马钱StrychnosnuxvomicaL.或云南马钱StrychnospierrianaA.W.Hill的干燥成熟种子。冬季采收成熟果实，取出种子，晒干。"}]},{"ID":"20240903092113-jl4q7s2","Type":"NodeParagraph","Properties":{"id":"20240903092113-jl4q7s2","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈钮扣状圆板形，常一面隆起，一面稍凹下，直径1.5～3cm，厚0.3～0.6cm。表面密被灰棕或灰绿色绢状茸毛，自中间向四周呈辐射状排列，有丝样光泽。边缘稍隆起，较厚，有突起的珠孔，底面中心有突起的圆点状种脐。质坚硬，平行剖面可见淡黄色白色胚乳，角质状，子叶心形，叶脉5～7条。无臭，味极苦。"}]},{"ID":"20240903092113-wqo92tm","Type":"NodeParagraph","Properties":{"id":"20240903092113-wqo92tm","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240903092113-7qq29rb","Type":"NodeParagraph","Properties":{"id":"20240903092113-7qq29rb","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末灰黄色。非腺毛单细胞，基部膨大似石细胞，壁极厚,多碎断，木化。胚乳细胞多角形，壁厚，内含脂肪油及糊粉粒。"}]},{"ID":"20240903092113-0pfd4dd","Type":"NodeParagraph","Properties":{"id":"20240903092113-0pfd4dd","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（2）取本品干燥种子的胚乳部分作切片，加1％钒酸铵的硫酸溶液1滴，胚乳即显紫色；另取胚乳切片，加发烟硝酸1滴，即显橙红色。"}]},{"ID":"20240903092113-qsgc218","Type":"NodeParagraph","Properties":{"id":"20240903092113-qsgc218","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0.5g，加氯仿-乙醇（10:1）混合液5ml与浓氨试液0.5ml，密塞，振摇5分钟，放置2小时，滤过，滤液作为供试品溶液。另取士的宁和马钱子碱对照品，加氯仿制成每1ml各含2mg的混合溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl，分别点于同一硅胶Ｇ薄层板上，以甲苯-丙酮-乙醇-浓氨试液（4:5:0.6:0.4）为展开剂，展开，取出，晾干，喷以稀碘化铋钾试液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240903092113-32xkx5i","Type":"NodeParagraph","Properties":{"id":"20240903092113-32xkx5i","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903092113-j7ekvxt","Type":"NodeParagraph","Properties":{"id":"20240903092113-j7ekvxt","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"生马钱子：除去杂质；制马钱子：将砂子放锅内炒热，加入拣净的马钱子，炒至外面呈棕黄色并鼓起时取出，筛去砂子，去毛即可；"}]},{"ID":"20240903092113-v7ilfdv","Type":"NodeParagraph","Properties":{"id":"20240903092113-v7ilfdv","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"油马钱子：将拣净的马钱子，煮沸后取出，再用清水浸泡，捞出，刮去皮毛，稍晾，切成薄片，用少许烧热的麻油炒至微黄色，取出晾凉。"}]},{"ID":"20240903092113-tfj9fiz","Type":"NodeParagraph","Properties":{"id":"20240903092113-tfj9fiz","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性味】苦，温；有大毒。"}]},{"ID":"20240903092113-0v3d0tb","Type":"NodeParagraph","Properties":{"id":"20240903092113-0v3d0tb","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾经。"}]},{"ID":"20240903092113-qbk8g52","Type":"NodeParagraph","Properties":{"id":"20240903092113-qbk8g52","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【功能主治】通络止痛，散结消肿。用于风湿顽痹，麻木瘫痪，跌扑损伤，痈疽肿痛；小儿麻痹后遗症，类风湿性关节痛。"}]},{"ID":"20240903092113-kouvxm5","Type":"NodeParagraph","Properties":{"id":"20240903092113-kouvxm5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.3～0.6g，炮制后入丸散用。"}]},{"ID":"20240903092113-j8qtbt5","Type":"NodeParagraph","Properties":{"id":"20240903092113-j8qtbt5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【注意】不宜生用、多服久服；孕妇禁用。"}]},{"ID":"20240903092113-aqidluf","Type":"NodeParagraph","Properties":{"id":"20240903092113-aqidluf","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240903092113-x6l8bwj","Type":"NodeParagraph","Properties":{"id":"20240903092113-x6l8bwj","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【备注】（1）马钱子毒性大，内服必须炮制。如服过量中毒，出现颈项僵硬，瞳孔散大，呼吸急促与困难，甚至抽搐，角弓反张，痉笑等症状出现。中毒的解救：（1）立即给乙醚吸入作轻度麻醉，或用中、短时或超短时作用的巴比妥类药物，如戊巴比妥钠0.1～0.3克、环已巴比妥钠0.2克或硫喷妥钠0.2克作经脉注射，以制止惊厥。亦可用10％水合氯醛20毫升保留灌肠。禁用吗啡，因其能引起惊厥。（2）吞服的毒物在数分钟内未完全吸收时，可于麻醉情况下，用1:2000高锰酸钾溶液洗胃。吞服过久或已发生惊厥者，不应洗胃。（3）置暗室，防止外冷刺激，减少诱发惊厥的因素。"}]},{"ID":"20240903092113-3wz8eup","Type":"NodeParagraph","Properties":{"id":"20240903092113-3wz8eup","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240903092113-lmu542x","Type":"NodeParagraph","Properties":{"id":"20240903092113-lmu542x","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱子《*辞典》"}]},{"ID":"20240903092113-8rinmkh","Type":"NodeParagraph","Properties":{"id":"20240903092113-8rinmkh","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目》"}]},{"ID":"20240903092113-cstasig","Type":"NodeParagraph","Properties":{"id":"20240903092113-cstasig","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎQiánZǐ"}]},{"ID":"20240903092113-txq0ey5","Type":"NodeParagraph","Properties":{"id":"20240903092113-txq0ey5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【别名】番木鳖、苦实把豆儿（《飞鸿集》），火失刻把都（《纲目》），苦实（《本草原始》），马前，牛银（《本草求原》），大方八（《中药材手册》）。"}]},{"ID":"20240903092113-087elll","Type":"NodeParagraph","Properties":{"id":"20240903092113-087elll","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【来源】为马钱科植物马钱的成熟种子。果实成熟时采摘，除去果肉，取出种子，晒干。"}]},{"ID":"20240903092113-8gnt7gd","Type":"NodeParagraph","Properties":{"id":"20240903092113-8gnt7gd","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903092113-qgl95fx","Type":"NodeParagraph","Properties":{"id":"20240903092113-qgl95fx","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱（《纲目》）"}]},{"ID":"20240903092113-7vicy1k","Type":"NodeParagraph","Properties":{"id":"20240903092113-7vicy1k","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"乔木，高10～13米。树皮灰色，具皮孔，枝光滑。叶对生，叶柄长4～6毫米；叶片草质，广卵形或近于圆形，长6～15厘米，宽3～8.5厘米，先端急尖或微凹，基部广楔形或圆形，全缘，两面均光滑无毛，有光泽，主脉5条罕3条，在背面凸起，两侧者较短，不达叶端，细脉成不规则的网状，在叶的两面均明显；叶腋有短卷须。聚伞花序顶生枝端，长3～5厘米，直径2.5～5厘米，被短柔毛；总苞片及小苞片均小，三角形，先端尖，被短柔毛；花白色，几无梗，花萼绿色，先端5裂，被短柔毛；花冠筒状，长10～12毫米，先端5裂，裂片卵形，长约2.5～4毫米，内面密生短毛；雄蕊5，花药黄色，椭圆形，无花丝；子房卵形，光滑无毛，花柱细长，柱头头状。浆果球形，直径6～13厘米，幼时绿色，成熟时橙色，表面光滑。种子3～5粒或更多，圆盘形，直径1.5～2.5厘米，表面灰黄色，密被银色茸毛，柄生于一面的中央，另一面略凹入，有丝光。"}]},{"ID":"20240903092113-b3uidf5","Type":"NodeParagraph","Properties":{"id":"20240903092113-b3uidf5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长热带。分布印度、越南、缅甸、泰国、斯里兰卡等地。"}]},{"ID":"20240903092113-yq28vcp","Type":"NodeParagraph","Properties":{"id":"20240903092113-yq28vcp","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903092113-67l5xpq","Type":"NodeParagraph","Properties":{"id":"20240903092113-67l5xpq","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"干燥成熟的种子呈扁圆形，钮扣状，略弯曲，边缘微隆起，常一面稍凹下，另一面稍突起，直径1～3厘米.厚3～6毫米，表面灰棕色或灰绿色，密生匍伏的银灰色毛茸，呈辐射状排列，有丝光，底面中央有一稍突出的圆点，边缘有一小突起，在圆点与小突起之间有一条棱线。质坚硬，难破碎，破开后种仁淡黄白色，稍透明，角质状。纵切面可见心形的子叶。无臭，味极苦。毒性剧烈，口尝宜特别谨慎.以个大、肉厚、质坚者为佳。"}]},{"ID":"20240903092113-r5plmhf","Type":"NodeParagraph","Properties":{"id":"20240903092113-r5plmhf","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"主产印度、越南、缅甸等地。"}]},{"ID":"20240903092113-kps060v","Type":"NodeParagraph","Properties":{"id":"20240903092113-kps060v","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱子历来多为进口药，现我国云南有马钱藤，经测定种子含番木鳖碱，可以代替进口马钱子。生药外形与马钱子相似，长径20～30毫米，短径15～22毫米，中央厚6～10毫米，每个重1.3～2.7克；外面密被棕白色至棕色，光亮的绢毛，自中央向四周辐射状匍匐排列；种脐在种子中央，珠孔在种子的边缘。"}]},{"ID":"20240903092113-90vafbk","Type":"NodeParagraph","Properties":{"id":"20240903092113-90vafbk","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【化学成份】含番木鳖碱（strychnine）、马钱子碱（brucine）、α-及β-可鲁勃（α-,β-colubrine）、番木鳖次碱（vomicine）、马钱子新碱（novacine）、依卡精（icajine）、番木鳖甙（loganin）等。"}]},{"ID":"20240903092113-4mxh7z6","Type":"NodeParagraph","Properties":{"id":"20240903092113-4mxh7z6","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903092113-2njzgh7","Type":"NodeParagraph","Properties":{"id":"20240903092113-2njzgh7","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱子粉：取砂子，置锅内炒热，加入拣净的马钱子，炒至呈深黄色并鼓起，取出，筛去砂子，刮去毛，研粉。油马钱子：取拣净的马钱子，加水煮沸，取出，再用水浸泡，捞出，刮去皮毛，微晾，切成薄片。另取麻油少许，置锅内烧热，加入马钱子片，炒至微黄色，取出，放凉。"}]},{"ID":"20240903092113-a12x4ei","Type":"NodeParagraph","Properties":{"id":"20240903092113-a12x4ei","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"或云以豆腐制过用之良。\""}]},{"ID":"20240903092113-gs1p4oa","Type":"NodeParagraph","Properties":{"id":"20240903092113-gs1p4oa","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903092113-q25rkn2","Type":"NodeParagraph","Properties":{"id":"20240903092113-q25rkn2","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"苦，寒，有毒。"}]},{"ID":"20240903092113-pj567z1","Type":"NodeParagraph","Properties":{"id":"20240903092113-pj567z1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"苦，寒，无毒。\""}]},{"ID":"20240903092113-y4uad47","Type":"NodeParagraph","Properties":{"id":"20240903092113-y4uad47","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"②《本草原始》：\"味苦，寒，大毒。\""}]},{"ID":"20240903092113-zrbc7fw","Type":"NodeParagraph","Properties":{"id":"20240903092113-zrbc7fw","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903092113-x21fymw","Type":"NodeParagraph","Properties":{"id":"20240903092113-x21fymw","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"散血热，消肿，止痛。治咽喉痹痛，痈疽肿毒，风痹疼痛，骨折。并治面神经麻痹，重症肌无力。通络止痛，散结消肿。用于风湿顽痹、麻木瘫痪、跌扑损伤、痈疽肿痛。"}]},{"ID":"20240903092113-y2g2sb1","Type":"NodeParagraph","Properties":{"id":"20240903092113-y2g2sb1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"治伤寒热病，咽喉痹痛，消痞块，并含之咽汁，或磨水噙咽。\""}]},{"ID":"20240903092113-ux2t5tx","Type":"NodeParagraph","Properties":{"id":"20240903092113-ux2t5tx","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"②《中药志》：\"散血热，消肿毒。治痈疽，恶疮。\""}]},{"ID":"20240903092113-bn9h9y1","Type":"NodeParagraph","Properties":{"id":"20240903092113-bn9h9y1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：入丸、散，1～2分（一日量）。外用：醋磨涂，研末吹喉或调敷。"}]},{"ID":"20240903092113-pcr46e5","Type":"NodeParagraph","Properties":{"id":"20240903092113-pcr46e5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240903092113-pvgtz64","Type":"NodeParagraph","Properties":{"id":"20240903092113-pvgtz64","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"孕妇及体虚者忌服。"}]},{"ID":"20240903092113-pqty5la","Type":"NodeParagraph","Properties":{"id":"20240903092113-pqty5la","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：\"气血虚弱、脾胃不实者，慎勿用之。\""}]},{"ID":"20240903092113-6nfcaaa","Type":"NodeParagraph","Properties":{"id":"20240903092113-6nfcaaa","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903092113-9hlh2rv","Type":"NodeParagraph","Properties":{"id":"20240903092113-9hlh2rv","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"①治喉痹作痛：番木鳖，青木香、山豆根等分。为末吹。（《医方摘要》）"}]},{"ID":"20240903092113-37kp92g","Type":"NodeParagraph","Properties":{"id":"20240903092113-37kp92g","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"②治缠喉风肿：番木鳖仁一个，木香三分。同磨水，调熊胆三分，胆矾五分，以鸡毛扫患处。（《唐瑶经验方》）"}]},{"ID":"20240903092113-nilvea5","Type":"NodeParagraph","Properties":{"id":"20240903092113-nilvea5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"③治痈疽初起，跌扑内伤，风痹疼痛：番木鳖（入砂锅内，黄土拌炒焦黄为度，石臼中捣磨，筛去皮毛，拣净末）、山芝麻（去壳，酒炒）、乳香末（箬叶烘出汗）各五钱，穿山甲（黄土炒脆）一两。共研末。每服一钱，酒下，不可多服，服后避风，否则令人发战栗不止，如人虚弱，每服五分。（《救生苦海》马前散）"}]},{"ID":"20240903092113-2cei3af","Type":"NodeParagraph","Properties":{"id":"20240903092113-2cei3af","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"④治中耳炎：㈠番木鳖一个，以井水磨汁滴耳内。（《光华医学杂志》11：38，1933）㈡马钱子五钱，焙黄去毛皮，然后用胡麻油一两煎之，至漂起为度，去马钱子，留油备用。治疗时先洗去脓垢，然后漓入药油两滴。一日二次。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240903092113-63ed0p8","Type":"NodeParagraph","Properties":{"id":"20240903092113-63ed0p8","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑤治脚气，手足麻痹，半身不遂，小便不禁或自遗：番木鳖（去皮，磨细粉）六分，甘草（细粉）六分。炼蜜为丸40粒，每日三次，每次1～2粒，食后温水送服，连服七日，停七日再服。（《现代实用中药》）"}]},{"ID":"20240903092113-hh5wnzp","Type":"NodeParagraph","Properties":{"id":"20240903092113-hh5wnzp","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑥治骨折：马钱子、枳壳。每斤生马钱子加甘草一两，同置缸内用冷水浸泡，每日换水一次，16天后将马钱子毛刮净，切片晒干，用细砂炒成黄色，再浸在童便中（冬季2～3周，夏季4～5天），然后用流水冲洗一天半，阴干碾细。枳壳（生熟皆可），用童便浸泡2～3天，取出用水洗净，阴干碾细。将马钱子粉与枳壳粉按1：2混合即可，也可制为蜜丸。成人日服三次，每次2克，极量一日8克。儿童酌减。同时进行断骨复位，小夹板固定。孕妇、高血压、高烧及精神病人慎用。服药量大时，出现肌肉抽搐，患处跳动感，头晕，可大量饮水（或甘草水）解之。（《全展选编·外科》）"}]},{"ID":"20240903092113-d4vye6j","Type":"NodeParagraph","Properties":{"id":"20240903092113-d4vye6j","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑦治热牙痛不可忍：番木鳖半个，井花水磨一小盏，含漱，热即吐去，水完则疼止。（《握灵本草》）"}]},{"ID":"20240903092113-7x7uzn5","Type":"NodeParagraph","Properties":{"id":"20240903092113-7x7uzn5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑧治癍疮入目：苦实把豆儿半个，轻粉、水花银朱各五分，片脑、麝香、枯矾少许。为末，左目吹右耳，右目吹左耳，日二次。（《飞鸿集》）"}]},{"ID":"20240903092113-mf23zrz","Type":"NodeParagraph","Properties":{"id":"20240903092113-mf23zrz","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑨治狂犬病：马前子一粒，酒磨成粉末，开水吞服。（《贵州省中医验方秘方》）"}]},{"ID":"20240903092113-yfndsma","Type":"NodeParagraph","Properties":{"id":"20240903092113-yfndsma","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903092113-i5ca211","Type":"NodeParagraph","Properties":{"id":"20240903092113-i5ca211","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"①治疗面神经麻痹"}]},{"ID":"20240903092113-27tu3g1","Type":"NodeParagraph","Properties":{"id":"20240903092113-27tu3g1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"将马钱子湿润后，切成薄片，1.2钱约可切18～24片，排列于橡皮膏上，贴敷于患侧面部（向左歪贴右，向右歪贴左），约7～10天调换1张，至恢复正常为止。一般轻症贴2次即可。治疗15000人次，约80％有效。"}]},{"ID":"20240903092113-0fj6fp3","Type":"NodeParagraph","Properties":{"id":"20240903092113-0fj6fp3","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"②治疗重症肌无力症"}]},{"ID":"20240903092113-a7p1nsx","Type":"NodeParagraph","Properties":{"id":"20240903092113-a7p1nsx","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"将马钱子用水泡（冬天温水，夏天凉水）10～14天，去皮，放入煮沸的花生油内，文火煎约30余分钟，至焦黄色（以手击之即碎为度）时取出，拌于滑石粉内以吸去油质，约经10～14小时筛去滑石粉，再以清水冲洗1次.待干后研粉即可服用。开始每日1.5分，分3次服，逐渐增至每日3.2分或4分。试治3例，2例获得较好的近期疗效，1例无效。其中1例先用新斯的明等治疗，开始疗效尚好，以后渐减，改用马钱子治疗，肌力渐恢复，握力增加，无复视感，能自理生活。"}]},{"ID":"20240903092113-77zbtl6","Type":"NodeParagraph","Properties":{"id":"20240903092113-77zbtl6","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"③治疗结核病"}]},{"ID":"20240903092113-xeuzc0x","Type":"NodeParagraph","Properties":{"id":"20240903092113-xeuzc0x","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"曾用马钱子药蛋试治颈淋巴结核、结核性腹膜炎、慢性纤维性空洞性肺结核合并胸膜炎各1例，均有一定疗效。方法：取马钱子4钱砸碎（对形成窦道的颈淋巴结核加川黄连1两），用开水浸泡1小时，再放入鸡蛋7个，文火煮1小时，将蛋捞出，用冷水浸泡片刻，再放回原药液中泡1小时，即成马钱子药蛋，捞出放凉处备用。每天早晨空腹服药蛋1个，7天为一疗程。间隔7天，再继续下一疗程。一般用2～4个疗程。煮蛋和泡蛋的过程中谨防将蛋弄破，破蛋应弃去，不能服用。1例颈淋巴结核取得很好效果；1例结核性腹膜炎经用抗痨药物治疗4个多月无明显效果，加用马钱子药蛋经三个疗程，腹部包块消失，大便正常，仅于触诊时肝区及右下腹有不明显的索状物，又续服药蛋2个疗程后痊愈出院；另1例慢性纤维性空洞性肺结核合并胸膜炎，胸腔积液，10天内抽胸水4次，经加用药蛋二个疗程后，胸水全部吸收。此外，对3例肺门淋巴结核，使用药蛋后也有明显效果。但对其他一些肺结核病人，在抗痨化学治疗的同时加用盐酸士的宁，都未见效果。"}]},{"ID":"20240903092113-0i80hht","Type":"NodeParagraph","Properties":{"id":"20240903092113-0i80hht","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"④治疗子宫颈糜烂"}]},{"ID":"20240903092113-n4xjoxr","Type":"NodeParagraph","Properties":{"id":"20240903092113-n4xjoxr","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"取马钱子仁置香油中炸后滤去药渣，然后加入适量凡士林，调制成软膏备用.先用过锰酸钾水冲洗阴道，揩净阴道、子宫颈口的分泌物，将带线的棉塞蘸马钱子油膏放于糜烂处，线尾留在阴道外，经6小时后取出.每日或隔日上药1次，6次为一疗程，未愈者可继续二、三个疗程。观察34例，13例痊愈，20例有效，1例无变化。"}]},{"ID":"20240903092113-dqiinj4","Type":"NodeParagraph","Properties":{"id":"20240903092113-dqiinj4","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"⑤治疗痈肿"}]},{"ID":"20240903092113-mfsvr2a","Type":"NodeParagraph","Properties":{"id":"20240903092113-mfsvr2a","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"取马钱子投入铜锅内，加麻油炸至呈深黄色时取出，刮去毛，研成细末，用米糊为丸或装胶囊（平均1粒马钱子制4粒）。成人体壮者，每天3～4丸，临睡前用米汤1次送服。孕妇、体弱或6岁以下儿童禁服。治疗1500余例，均获明显效果。"}]},{"ID":"20240903092113-cb0cdvf","Type":"NodeParagraph","Properties":{"id":"20240903092113-cb0cdvf","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903092113-rgef6e6","Type":"NodeParagraph","Properties":{"id":"20240903092113-rgef6e6","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱子《中华本草》"}]},{"ID":"20240903092113-6gg77je","Type":"NodeParagraph","Properties":{"id":"20240903092113-6gg77je","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903092113-morl2tj","Type":"NodeParagraph","Properties":{"id":"20240903092113-morl2tj","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.出自《本草纲目》：番木鳖，蔓生，夏开黄花，七、八月结实如括楼，生青熟赤，亦如木鳖，其核小于木鳖而色白。"}]},{"ID":"20240903092113-0pv14n1","Type":"NodeParagraph","Properties":{"id":"20240903092113-0pv14n1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.《本草原始》：番木鳖，木如木鳖子大，形圆而扁，有白毛，味苦。鸟中其毒，则麻木搐急而毙；狗中其毒，则苦痛断肠而毙。若误服之，令人四肢拘挛。"}]},{"ID":"20240903092113-onc7tgy","Type":"NodeParagraph","Properties":{"id":"20240903092113-onc7tgy","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎQiánZǐ"}]},{"ID":"20240903092113-kn5c4pg","Type":"NodeParagraph","Properties":{"id":"20240903092113-kn5c4pg","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【别名】番木鳖、苦实把豆儿、火失刻把都、苦实、马前、马前子、牛银"}]},{"ID":"20240903092113-ck3p8yl","Type":"NodeParagraph","Properties":{"id":"20240903092113-ck3p8yl","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903092113-91713xm","Type":"NodeParagraph","Properties":{"id":"20240903092113-91713xm","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"药材基源：为马钱科植物马钱、长籽马钱的种子。"}]},{"ID":"20240903092113-77nb7xj","Type":"NodeParagraph","Properties":{"id":"20240903092113-77nb7xj","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．SemenStrychiNux-vomicae2．SemenStrychniWallichianae"}]},{"ID":"20240903092113-sj2x2lc","Type":"NodeParagraph","Properties":{"id":"20240903092113-sj2x2lc","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬季果实成熟时摘下，取出种子，洗净附着的果肉，晒干。"}]},{"ID":"20240903092113-ejgm9fu","Type":"NodeParagraph","Properties":{"id":"20240903092113-ejgm9fu","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903092113-wgh935z","Type":"NodeParagraph","Properties":{"id":"20240903092113-wgh935z","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.乔木，高10-13m。树皮灰色，具皮孔,枝光滑。单叶对生；叶柄长5-12mm；叶片革质，广卵形或近圆形，长6-15cm，宽3-9cm，先端急尖或微凹，基部广楔形或圆形，全缘，光滑，无毛，主脉3-5条，背面突起，细脉成不规则网状；叶腋有短卷须。圆锥状聚伞花序腋生，长3-5cm，直径2.5-5cm，被短柔毛；总苞片及小苞片均小，三角形，先端尖，被短柔毛；花白色，几无梗；花萼绿色，先端5裂，密被短柔毛；花冠筒状，先端5裂，裂片卵形，内面密生短毛；雄蕊5，着生于花冠管喉部，花丝极短，花药黄色，椭圆形；雌蕊长9.5-12mm，花柱圆柱形，长达11mm，柱头头状；于房卵形。浆果球形，直径2-4cm，幼时绿色，熟时橙色，表面光滑。种子1-4颗，圆盘形，直径1-3cm，表面灰黄色，密被银色绒毛。花期春、夏季，果明8月至翌年1月。"}]},{"ID":"20240903092113-8mpn4yq","Type":"NodeParagraph","Properties":{"id":"20240903092113-8mpn4yq","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.木质大藤本，长达20m。树皮灰白色；小枝圆柱形，常变态成为单生或成对的螺旋状曲钩。叶对生；叶柄长5-7mm；叶片革质，椭圆形至倒卵形，长7-12cm，宽3-4.5cm，先端急尖或短渐尖，基部楔形或近圆形，全缘，两面均光滑无毛；叶脉为离基3脉，背面隆起。圆锥状聚伞花序顶生，长约4cm；总花梗和小花梗被短柔毛；花萼绿色，先端5裂，裂片卵形，外面被微毛，边缘有睫毛；花冠筒状，黄白色，长约10mm，先端5裂，裂片卵形，长约4mm，内面基部被柔毛；雄蕊5，着生于花冠筒的喉部，花丝极短，花药微露；雌蕊长约8mm，花柱细长，柱头头状；子房狭卵形。浆果球形，直径4-6cm，熟时橘红色。种子长圆形，长2-3cm，扁平，被浅灰色绢毛。花期4-6月，果期8月至翌年1月。"}]},{"ID":"20240903092113-zrhllbh","Type":"NodeParagraph","Properties":{"id":"20240903092113-zrhllbh","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903092113-3rww8ba","Type":"NodeParagraph","Properties":{"id":"20240903092113-3rww8ba","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生长热带。"}]},{"ID":"20240903092113-fiw0bcv","Type":"NodeParagraph","Properties":{"id":"20240903092113-fiw0bcv","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.生于海拔600m以下的较炎热的半山坡凹地、山谷湿处或杂木林、树丛中。"}]},{"ID":"20240903092113-xmxr42y","Type":"NodeParagraph","Properties":{"id":"20240903092113-xmxr42y","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"资源分布：1.福建、台湾、广东、海南、广西、云南等地有栽培。"}]},{"ID":"20240903092113-a3plirk","Type":"NodeParagraph","Properties":{"id":"20240903092113-a3plirk","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.分布于云南。"}]},{"ID":"20240903092113-qfpl0q6","Type":"NodeParagraph","Properties":{"id":"20240903092113-qfpl0q6","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240903092113-r5plks7","Type":"NodeParagraph","Properties":{"id":"20240903092113-r5plks7","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"生物学特性长籽马钱喜温暖湿润气候，不耐寒、不耐旱。宜选朝南山坡，土壤微酸性至微碱性，质地疏松、富含腐殖质的砂质壤上或粘壤土栽种。"}]},{"ID":"20240903092113-xzjunw1","Type":"NodeParagraph","Properties":{"id":"20240903092113-xzjunw1","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖或芽接繁殖。种子繁殖：在果肉软化或果皮橙红色时采收，取出种子洗净阴干。去皮后15d内播种，或瓶装2个月内播种。先在沙床上催芽，待幼苗出土展子叶时，即可按行株距20cm×20cm移栽于苗床或营养袋中。当年6～7月，苗高30～50cm时即可定植。芽接繁殖：直用印度马钱作砧木。当砧木离地高20～30cm处茎粗达2cm以上，即可在雨季树皮易剥离时进行大田芽接，或苗圃芽接后，用芽接苗定植。定植宜选阴天或小雨天进行，按行株距4m×4m挖穴，穴宽50cm，深40cm。植后浇定根水，盖草保湿。"}]},{"ID":"20240903092113-wrmhf7v","Type":"NodeParagraph","Properties":{"id":"20240903092113-wrmhf7v","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"田间管理注意保护接芽，经常清除砧木上的萌芽，保证芽接苗生长健壮。加强除草、松土，雨季开沟施入有机肥或压青，旱季施人粪。幼龄期保持适当荫蔽，树高达1m以上后，逐步除去荫蔽，只留少量攀绕树。要进行整形修剪，使多分化结果枝。"}]},{"ID":"20240903092113-nbdvhfn","Type":"NodeParagraph","Properties":{"id":"20240903092113-nbdvhfn","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903092113-31g06gn","Type":"NodeParagraph","Properties":{"id":"20240903092113-31g06gn","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）马钱子种子扁圆形，钮扣状，直径1－3cm，厚3-6mm，边缘微隆起，常一面凹下，另一面稍突出。表面灰棕色或灰绿色，密生匍匐的银灰色毛，有丝状光泽，由中央向四周射出。边缘有一条隆起脊线，并有一小形突起的珠孔，底面中心有一稍突出的圆点状种脐，珠孔与种脐间隐约可见一条隆起线。质坚硬，难破碎。浸软后沿边缘纵向剖开，可见淡黄色角质肥厚的胚乳，胚乳中央部分有空隙，近珠孔处有心形的胚，子叶2枚，菲薄，长5-6mm，有5条掌状脉，胚根长约4mm。气微，味极苦，剧毒。"}]},{"ID":"20240903092113-0m36s0b","Type":"NodeParagraph","Properties":{"id":"20240903092113-0m36s0b","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（2）长籽马钱子种子长扁圆形，边缘较薄略向上翘成盘状，长2-3cm，直径1．5-2．2cm，表面密生灰黄色或淡棕色光亮的毛茸，自中央向四周辐射状匍匐排列。子叶卵形而薄，叶脉3条。气微，味极苦，剧毒。"}]},{"ID":"20240903092113-a8vp7x2","Type":"NodeParagraph","Properties":{"id":"20240903092113-a8vp7x2","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"以个大饱满、质坚肉厚、色灰黄有光泽者佳。"}]},{"ID":"20240903092113-75orytd","Type":"NodeParagraph","Properties":{"id":"20240903092113-75orytd","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"显微鉴别种子横切面（1）马钱子种皮表皮细胞向一方倾斜，延长成单细胞非腺毛，长500-1000（-1700）μm，宽约25μm，壁厚，强木化，壁约有10条纵肋线，基部稍膨膨大，有纹孔及孔沟，似石细胞样。表皮下有数列棕色颓废的薄壁细胞。胚乳细胞多角形，壁厚，半纤维素性，隐约可见胞间连丝，用碘液封藏较明显，细胞内含脂肪油及少量糊粉粒。（2）长籽马钱子表皮非腺毛长520-1040μm，宽约20μm，平直或多少扭曲，壁具9-10个纵肋，常自然分离成无色细长条状，先端尖锐或钝圆，基部仍互相连合，毛茸基部不规则增厚，有纹孔。"}]},{"ID":"20240903092113-6q8wumw","Type":"NodeParagraph","Properties":{"id":"20240903092113-6q8wumw","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取种子胚乳横切，加硫钒酸试液（钒酸铵1g溶于浓硫酸100ml中）1滴，胚乳内层应显蓝紫色（检查番木鳖碱）。另取一切片，加浓硝酸1滴，胚乳外层应显橙红色（检查马钱子碱）。"}]},{"ID":"20240903092113-skij87m","Type":"NodeParagraph","Properties":{"id":"20240903092113-skij87m","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（2）取种子粉末0．8-1．5g加乙醇20ml，冷浸2h，并适当振摇，滤过。滤液蒸去溶剂，加1mol／L盐酸3ml溶解，移至分液漏斗中，用氢氧化铵调节pH至9．0，用氯仿3ml提取3次，氯仿溶液稍浓缩后，取2-3ml，在分液漏斗中加1mol／L盐酸1．5ml，振摇提取，分出酸液，加浓盐酸及锌粉少许，用小火加热至沸，放冷后，加亚硝酸钠溶液（1：20）1涌，应立即显樱红色（检查番木鳖碱）。"}]},{"ID":"20240903092113-crzd4cj","Type":"NodeParagraph","Properties":{"id":"20240903092113-crzd4cj","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"（3）薄层色谱取上述制备液作供试品，以马钱子碱、番木鳖碱为对照品，分别点样于硅胶G板上，以乙酸乙酯-异丙醇-浓氨水（6：3：1）展开，用改良碘化铋钾试剂喷雾。供试品色谱中，在与对照品色谱相应的位置上显相同的色斑。品质标志《中华人民共和国药典》1995年版规定：本品按干燥品计算含番木鳖碱（C21；H22N2O2）应为1．20％-2．20％。"}]},{"ID":"20240903092113-atqhozy","Type":"NodeParagraph","Properties":{"id":"20240903092113-atqhozy","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240903092113-v9sej1c","Type":"NodeParagraph","Properties":{"id":"20240903092113-v9sej1c","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"马钱种子含多种生物碱，可分为三种类型：①“正”系列（normalseries）生物碱：番木鳖碱（strychnine），马钱子碱（brucine），异番木鳖碱（isostrychnine），异马钱子碱（isobrucine），番木鳖碱N-氧化物（strychnineN－oxide），马钱子碱N-氧化物（brucineN－oxide）,β-可鲁勃林（β－colubrine），16-羟基-β-可鲁勃林（16－hydroxy-β-colubrine），16-羟基-α-可鲁勃林。②“伪”系列（pseudoseries）生物碱：伪番木鳖碱（pseudo-strychnine），伪马钱子碱（pseudobrucine）。③“N”-甲基伪”系列（N－methylpseudoseries）生物碱：N-甲基-断-伪番木鳖碱（icajine），番木鳖次碱（vomicine），N-甲基-断-伪马钱子碱（no-vacine）。种子所含生物碱以“正”系列为主［1-3］。种子经高温加热（220～260℃，3min），剧毒成分番木鳖碱、马钱子碱含量明显降低，而异番木鳖碱、异马钱子碱、番木鳖碱N-氧化物及马钱子碱N-氧化物含量增高［3］.根皮、根木质部含“正”系列生物碱为主，茎皮含“伪”及“N-甲基伪”系列生物碱为主，叶则含“N-甲基伪”系列生物碱为主[1]。果皮、果肉均含番木鳖碱，马钱子碱，4-羟基番木鳖碱（4-hydroxystrychnine），番木鳖碱N-氧化物，马钱子碱N-氧化物，伪番木鳖碱，伪马钱子碱，N-甲基-断-伪番木鳖碱，番木鳖次碱，N-甲基-断-伪马钱子碱，果肉另含β-可鲁勃林。果肉还含环烯醚单萜类（iridoid）化合物：马钱子甙（loganin），马钱子甙酸（lo－ganicacid），去氧马钱子甙（deoxyloganin），马钱子酮甙（ketolo－ganin），开链马钱子甙（secologanin）[4]。"}]},{"ID":"20240903092113-361b522","Type":"NodeParagraph","Properties":{"id":"20240903092113-361b522","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"长籽马钱种子含多种生物碱，可分为三种类型：①“正”系列生物碱：4-羟基-3-甲氧基-番木鳖碱（4-hydroxy－3－methoxystrychnine），番木鳖碱，马钱子碱，4-羟基番木鳖碱，番木鳖碱N-氧化物，α-可鲁勃林。②“伪”系列生物碱：伪番木鳖碱，伪马钱子碱。③“N-甲基伪”系列生物碱：N-甲基-断-伪番木鳖碱，番木鳖次碱，N-甲基-断-伪马钱子碱及4-羟基-3-甲氧基-N-甲基-断-伪番木鳖碱（4－hydroxy－3－methoxy-N－methyl-sec－pseu－dostrychnine）[5,6]。种子所含生物碱以“正”系列为主[5]。根皮、根木质部含“正”系列生物碱为主，茎皮含“伪”及“N-甲基伪”系列生物碱为主，叶则含“N-甲基伪”系列生物碱为主[5]。此外，叶还含有N-氰基-断-伪番木鳖碱（N-cyano-sec－pseudostrychnine）及N-氰基-断-伪马钱子碱（N－cyano-sec-pseu－dobrucine）[7，8]。"}]},{"ID":"20240903092113-lymzho9","Type":"NodeParagraph","Properties":{"id":"20240903092113-lymzho9","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903092113-sgq3rqw","Type":"NodeParagraph","Properties":{"id":"20240903092113-sgq3rqw","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.对中枢神经系统的作用本品所含的番木鳖碱对整个中枢神经系统都有兴奋作用，首先兴奋脊髓的反射机能，其次兴奋延髓的呼吸中枢及血管运动中枢，并能提高大脑皮质的感觉中枢机能。"}]},{"ID":"20240903092113-tih33p4","Type":"NodeParagraph","Properties":{"id":"20240903092113-tih33p4","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.1.对脊髓作用脊髓对番木鳖碱有高度的敏感性，给蛙皮下注射0.02%硝酸番木鳖碱溶液0.5ml，可见反射兴奋提高，轻轻触动皮肤表面，就能引起动物震颤；给截除大脑的猫静脉注射0.01%硝酸番木鳖碱0.2mg/kg，亦见反射性增高。剂量增加时可出现强直性惊厥。治疗剂量的番木鳖碱使神经冲动在脊髓中传导容易，并能提高脊髓反射兴奋性，因此可缩短脊髓反射时间，增高反射强度，且不破坏脊髓中枢的交互抑制过程，但中毒剂量的番木鳖碱能破坏此交互抑制过程。出现强直性惊厥。番木鳖碱在试管中，能抑制胆碱酯酶对乙酰胆碱的分解，因此曾有人认为此即为番木鳖碱兴奋作用产生的原理。另有资料认为系由于番木鳖碱能与突触后抑制性介质甘氨酸竞争突触后抑制部位，因此能选择性阻断运动神经元和中间神经元的突触后抑制，使运动神经元对传入刺激起较大反应。同时也能阻断脊髓中闰绍细胞(RenshawCell)对运动神经元的抑制作用，这样减弱或消除了对抗肌(伸肌与屈肌)之间的交互抑制，因此大剂量可致强直性惊厥。"}]},{"ID":"20240903092113-dltbail","Type":"NodeParagraph","Properties":{"id":"20240903092113-dltbail","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.2.对延髓的作用据资料记载，给箭毒麻痹的犬静脉注射2mg/kg的硝酸番木鳖碱，血压立刻升高(10-20mmHg)，并长时间持续在高度水平。但如破坏动物的延髓，血压随即下降，增大番木鳖碱剂量，血压也不再上l，说明番木鳖碱能提高血管运动中枢的兴奋性，增进血液循环。番木鳖碱还具有兴奋迷走神经中枢作用，可出现心动徐缓。番木鳖碱亦能提高呼吸中枢的兴奋性，使呼吸加深加快，特别是在上述中枢被抑制时这些作用更加明显。此外，它还可以兴奋咳嗽中枢。"}]},{"ID":"20240903092113-bs56f48","Type":"NodeParagraph","Properties":{"id":"20240903092113-bs56f48","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.3.对大脑皮质的作用小剂量的番木鳖碱能加强皮质的兴奋过程，促使处于抑制状态的病人苏醒。还能提高味觉、触觉、听觉和视觉等感觉器官的功能。治疗剂量的番木鳖碱对犬和猴的实验性神经官能症呈现良好作用，能促使兴奋和抑制过程之间的正常关系的恢复。大剂量的番木鳖碱(接近中毒量)，在短暂的提高兴奋过程后，即发生超限抑制现象。"}]},{"ID":"20240903092113-vsyljfi","Type":"NodeParagraph","Properties":{"id":"20240903092113-vsyljfi","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.对人体淋巴细胞的作用临床上有报道，硝酸番木鳖碱治疗慢性再生障碍性贫血有效。刘德祥等观察了马钱子分煎液不同剂量对体外培养人淋巴细胞有丝分裂指数的影响，结果表明，当煎液浓度为0.3-0.7mg/ml时，分裂指数基本一致，当浓度为0.2mg/ml时，分裂指数基本一致，当浓度为0.1mg/ml时，分裂指数达9.975%，急剧上l，超过对照组。"}]},{"ID":"20240903092113-7nzji4k","Type":"NodeParagraph","Properties":{"id":"20240903092113-7nzji4k","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"3.对消化系统的作用番本鳖碱具有强烈苦味，可刺激味觉感受器反射性增加胃液分泌，促进消化机能和食欲，病人肠痿管试验证明，番木鳖碱对人体胃肠平滑肌无兴奋作用。"}]},{"ID":"20240903092113-k0szjxk","Type":"NodeParagraph","Properties":{"id":"20240903092113-k0szjxk","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"4.对呼吸系统的影响新疆维吾尔自治区防治老年慢性气管炎药物药理协作组报道，以二氧化硫或氨雾引咳法试验证明，马钱子碱50mg/kg灌胃对小鼠有明显的镇咳作用，其作用强度超过可待因。小鼠酚红排泌法证明，马钱子碱40mg/kg有明显的祛痰作用，强度与氯化氨无显着差别。平喘作用弱。但动物实验发现，当用药时间延长，用量增加时，能加强家兔抗组织胺的作用。"}]},{"ID":"20240903092113-g8o85a5","Type":"NodeParagraph","Properties":{"id":"20240903092113-g8o85a5","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"5.抗菌作用：马钱子的水煎剂(1：2)在试管内对许兰氏黄癣菌，奥杜盎氏小芽胞癣菌有不同程度的抑制作用。体外试验表明，0.1%马钱子碱能完全抑制流感嗜血杆菌，肺炎双球菌，甲型链球菌和卡他球菌的生长。"}]},{"ID":"20240903092113-rp67s03","Type":"NodeParagraph","Properties":{"id":"20240903092113-rp67s03","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"6.其它作用SollmanTA报告马钱子碱对感觉神经末梢有麻痹作用，5-10%马钱子碱溶液可使口腔粘膜麻醉，马钱子碱和番木鳖碱极大剂量时，均可阻断神经肌肉传导呈现箭毒样作用，此种作用在整体动物上被全身性惊厥所掩盖，只在离体神经肌肉标本上才能表现出来。"}]},{"ID":"20240903092113-d51yjhr","Type":"NodeParagraph","Properties":{"id":"20240903092113-d51yjhr","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240903092113-4v9h0uc","Type":"NodeParagraph","Properties":{"id":"20240903092113-4v9h0uc","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"中毒者初有嚼肌及颈部肌抽筋感，咽下困难，全身不安、然后伸肌与屈肌同时极度收缩而出现强直性惊厥。可用乙醚作轻度麻醉或用巴比妥类药物静脉注射以抑制惊厥，另用高锰酸钾洗胃。毒性：对小鼠皮下注射的半数致死量，士的宁为0.47mg/kg及0.85mg/kg，4-羟基士的宁为0.556mg/kg；马钱子碱给狗静脉注射的致死量为8mg/kg。"}]},{"ID":"20240903092113-5jpr4uj","Type":"NodeParagraph","Properties":{"id":"20240903092113-5jpr4uj","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"番木鳖碱、马钱子碱和马钱子仁对小鼠灌胃的急性半数致死量分别为3.27、233和234.5mg/kg；小鼠腹腔注射的急性半数致死量分别为1.53、69和77.76mg/kg。马钱子碱给犬静脉注射的半数致死量为8mg/kg。成人1次服5-10mg的番木鳖碱可致中毒，30mg可致死亡。曾报道用马钱子治疗白喉，总剂量达50.54mg时引起中毒；并有服马钱子7粒中毒致死的病例报告。死亡原因为强直性惊厥反复发作造成衰竭及窒息死亡。1988年有人比较了马钱子及不同炮制品的毒性。"}]},{"ID":"20240903092113-lwbhzux","Type":"NodeParagraph","Properties":{"id":"20240903092113-lwbhzux","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【炮制】马钱子粉：取沙子，置锅内炒热，加入拣净的马钱子，炒至呈深黄色并鼓起，取出，筛去砂子，刮去毛，研粉。油马钱子：取拣净的马钱子，加水煮沸，取出，再用水浸泡，捞出，刮去皮毛，微晾，切成薄片。另取麻油少许，置锅内烧热，加入马钱子片，炒至微黄色，取出，放凉。《纲目》：或云以豆腐制过用之良，"}]},{"ID":"20240903092113-mzzzd7e","Type":"NodeParagraph","Properties":{"id":"20240903092113-mzzzd7e","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【性味】苦；性寒；大毒"}]},{"ID":"20240903092113-qpe43li","Type":"NodeParagraph","Properties":{"id":"20240903092113-qpe43li","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾经"}]},{"ID":"20240903092113-fkmnzq7","Type":"NodeParagraph","Properties":{"id":"20240903092113-fkmnzq7","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【功能主治】通络；强筋；散结；止痛；消肿；解毒。主风湿痹痛；肌肤麻木；肢体瘫痪；跌打损伤；骨折肿痛；痈疽疮毒。喉痹；牙痛；疠风；顽癣；恶性肿瘤"}]},{"ID":"20240903092113-jnvefxc","Type":"NodeParagraph","Properties":{"id":"20240903092113-jnvefxc","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：炮制后入丸、散、，每次0.2-0.6g。大剂量0.9g。外用：适量，研末撒，浸水，醋磨、煎油涂敷或熬膏摊贴。内服，如按其成分番鳖碱（士的宁）计算，一次量控制在6mg为宜。内服一般从小剂量开始，逐渐加量，加至患都感觉肌肉有一过性轻微颤动为取佳有效量，此反应也表明不可再加量。"}]},{"ID":"20240903092113-xrbuhzi","Type":"NodeParagraph","Properties":{"id":"20240903092113-xrbuhzi","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇及体虚者忌服。《本草经疏》：气血虚弱、脾胃不实者，慎勿用之。毒性马钱子含有番木鳖碱，成人用5-10mg即可发生中毒现象，30mg可致死亡。曾报道用马钱子治疗白喉总剂量达50.54mg时，引起中毒。亦有服九转回生丹(主要成分为马钱子与地龙)而致中毒或马钱子7粒中毒致死的病例。"}]},{"ID":"20240903092113-7urp9yg","Type":"NodeParagraph","Properties":{"id":"20240903092113-7urp9yg","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903092113-umqbosi","Type":"NodeParagraph","Properties":{"id":"20240903092113-umqbosi","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：治伤寒热病，咽喉痹痛，消痞块，并含之咽汁，或磨水噙咽。"}]},{"ID":"20240903092113-r0nujr4","Type":"NodeParagraph","Properties":{"id":"20240903092113-r0nujr4","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"2.《中药志》：散血热，消肿毒。治痈疽，恶疮。"}]},{"ID":"20240903092113-tjawb69","Type":"NodeParagraph","Properties":{"id":"20240903092113-tjawb69","updated":"20240903092143"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903092114-re3ejrs","Type":"NodeThematicBreak","Properties":{"id":"20240903092114-re3ejrs","updated":"20240903092143"}},{"ID":"20240903092115-yf0bp8v","Type":"NodeParagraph","Properties":{"id":"20240903092115-yf0bp8v","updated":"20240903092143"}}]}