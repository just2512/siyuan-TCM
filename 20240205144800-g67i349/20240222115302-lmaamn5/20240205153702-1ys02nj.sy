g"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705095925-8z97msn.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 628px;\" parent-style=\"width: 638px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"姜黄11"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/姜黄11-20240705095905-h2mv8mh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712101106-4vnrdzd","Type":"NodeParagraph","Properties":{"id":"20240712101106-4vnrdzd","updated":"20240712101106"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 463px;","style":"width: 453px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"姜黄10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/姜黄10-20240705095236-xfd0oih.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 453px;\" parent-style=\"width: 463px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 489px;","style":"width: 479px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"姜黄12"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/姜黄12-20240705100038-y8txuho.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 479px;\" parent-style=\"width: 489px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712101153-vrqxx2a","Type":"NodeParagraph","Properties":{"id":"20240712101153-vrqxx2a","updated":"20240712101155"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705085212-t293lce.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712101154-2mty3jy","Type":"NodeParagraph","Properties":{"id":"20240712101154-2mty3jy","updated":"20240712101346"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：块根是由许多根长在一起形成的，呈球形、椭圆形或不规则形状，有明显的节和芽；根茎是一段较长的变态根，有时呈横走的圆柱形，有时呈扁平的块状；"}]},{"ID":"20240712101125-h1vo2zh","Type":"NodeThematicBreak","Properties":{"id":"20240712101125-h1vo2zh"}},{"ID":"20240830164552-kqgxnhz","Type":"NodeParagraph","Properties":{"id":"20240830164552-kqgxnhz","updated":"20240830164601"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：姜黄"}]},{"ID":"20240830164552-519p2hs","Type":"NodeParagraph","Properties":{"id":"20240830164552-519p2hs","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄《中国药典》"}]},{"ID":"20240830164552-v47quv4","Type":"NodeParagraph","Properties":{"id":"20240830164552-v47quv4","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【拼音名】JiānɡHuánɡ"}]},{"ID":"20240830164552-yleir5h","Type":"NodeParagraph","Properties":{"id":"20240830164552-yleir5h","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMACURCUMAELONGAE"}]},{"ID":"20240830164552-7i549l7","Type":"NodeParagraph","Properties":{"id":"20240830164552-7i549l7","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【别名】黄姜、毛姜黄、宝鼎香、黄丝郁金"}]},{"ID":"20240830164552-6id4hzo","Type":"NodeParagraph","Properties":{"id":"20240830164552-6id4hzo","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【来源】本品为姜科植物姜黄CurcumalongaL.的干燥根茎。冬季茎叶枯萎时采挖，洗净，煮或蒸至透心，晒干，除去须根。"}]},{"ID":"20240830164552-rs9uoto","Type":"NodeParagraph","Properties":{"id":"20240830164552-rs9uoto","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则卵圆形、圆柱形或纺锤形，常弯曲，有的具短叉状分枝，长2～5cm，直径1～3cm。表面深黄色，粗糙，有皱缩纹理和明显环节，并有圆形分枝痕及须根痕。质坚实，不易折断，断面棕黄色至金黄色，角质样，有蜡样光泽，内皮层环纹明显，维管束呈点状散在。气香特异，味苦、辛。"}]},{"ID":"20240830164552-q8wvhfz","Type":"NodeParagraph","Properties":{"id":"20240830164552-q8wvhfz","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830164552-j7cojq9","Type":"NodeParagraph","Properties":{"id":"20240830164552-j7cojq9","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：表皮细胞为1列，细胞扁平，壁薄。皮层宽广，有叶迹维管束；外侧近表皮处有6～8列木栓细胞，扁平，壁薄，排列较整齐；内皮层细胞凯氏点明显。中柱鞘为1～2列薄壁细胞；维管束有限外韧型，散列，近中柱鞘处较多，向内渐减少。薄壁细胞含油滴、淀粉粒及红棕色色素。"}]},{"ID":"20240830164552-qmae2qq","Type":"NodeParagraph","Properties":{"id":"20240830164552-qmae2qq","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末少量，置滤纸上，滴加乙醇与乙醚各1滴，待干，除去粉末，滤纸染成黄色，加热硼酸饱和溶液1滴，则渐变为橙红色，再加氨试液1滴，则变成蓝黑色，后渐变为褐色，久置，则又变为橙红色。"}]},{"ID":"20240830164552-ua90g18","Type":"NodeParagraph","Properties":{"id":"20240830164552-ua90g18","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，略泡，洗净，润透，切厚片，晒干。"}]},{"ID":"20240830164552-h88v7k5","Type":"NodeParagraph","Properties":{"id":"20240830164552-h88v7k5","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，温。"}]},{"ID":"20240830164552-zb8aj0f","Type":"NodeParagraph","Properties":{"id":"20240830164552-zb8aj0f","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、肝经。"}]},{"ID":"20240830164552-yb1hpb4","Type":"NodeParagraph","Properties":{"id":"20240830164552-yb1hpb4","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【功能主治】破血行气，通经止痛。用于胸胁剌痛，闭经，癓瘕，风湿肩臂疼痛，跌扑肿痛。"}]},{"ID":"20240830164552-x5oofws","Type":"NodeParagraph","Properties":{"id":"20240830164552-x5oofws","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g；外用适量。"}]},{"ID":"20240830164552-u6eego0","Type":"NodeParagraph","Properties":{"id":"20240830164552-u6eego0","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240830164552-x1rndwz","Type":"NodeParagraph","Properties":{"id":"20240830164552-x1rndwz","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830164552-lmzyn2a","Type":"NodeParagraph","Properties":{"id":"20240830164552-lmzyn2a","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄《*辞典》"}]},{"ID":"20240830164552-ecpcnoy","Type":"NodeParagraph","Properties":{"id":"20240830164552-ecpcnoy","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【出处】《唐本草》"}]},{"ID":"20240830164552-qqj8kbw","Type":"NodeParagraph","Properties":{"id":"20240830164552-qqj8kbw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【拼音名】JiānɡHuánɡ"}]},{"ID":"20240830164552-75yb2li","Type":"NodeParagraph","Properties":{"id":"20240830164552-75yb2li","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【别名】宝鼎香（《纲目》），黄姜（《生草药性备要》）。"}]},{"ID":"20240830164552-mgkevzi","Type":"NodeParagraph","Properties":{"id":"20240830164552-mgkevzi","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【来源】为姜科植物姜黄或郁金的根茎。秋，冬采挖，洗净，煮熟至透心为度，晒干，撞去外皮，再晒干。浙江地区将郁金根茎在鲜时切片晒干，名\"片姜黄\"。"}]},{"ID":"20240830164552-4vz9kin","Type":"NodeParagraph","Properties":{"id":"20240830164552-4vz9kin","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830164552-9a9xdu0","Type":"NodeParagraph","Properties":{"id":"20240830164552-9a9xdu0","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①姜黄"}]},{"ID":"20240830164552-mouz0ol","Type":"NodeParagraph","Properties":{"id":"20240830164552-mouz0ol","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"多年生宿根草本。根粗壮，末端膨大成长卵形或纺锤状块根，灰褐色。根茎卵形，内面黄色，侧根茎圆柱状，红黄色。叶根生；叶片椭圆形或较狭，长20～45厘米，宽6～15厘米，先端渐尖，基部渐狭；叶柄长约为叶片之半，有时几与叶片等长；叶鞘宽，约与叶柄等长。穗状花序稠密，长13～19厘米；总花梗长20～30厘米；苞片阔卵圆形，每苞片内含小花数朵，顶端苞片卵形或狭卵形，腋内无花；萼3钝齿；花冠管上部漏斗状，3裂；雄蕊药隔矩形，花丝扁阔，侧生退化雄蕊长卵圆形；雌蕊1，子房下位，花柱丝状，基部具2棒状体，柱头2唇状。蒴果膜质，球形，3瓣裂。种子卵状长圆形，具假种皮。花期8～11月。"}]},{"ID":"20240830164552-b360qf0","Type":"NodeParagraph","Properties":{"id":"20240830164552-b360qf0","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"栽培或野生于平原、山间草地或灌木丛中。分布福建、广东、广西、云南、四川、湖北、陕西、江西、台湾等地。"}]},{"ID":"20240830164552-wlncpnc","Type":"NodeParagraph","Properties":{"id":"20240830164552-wlncpnc","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"本植物的块根（郁金）亦供药用，另详专条。"}]},{"ID":"20240830164552-2i4nxz3","Type":"NodeParagraph","Properties":{"id":"20240830164552-2i4nxz3","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②郁金，参见\"郁金\"条。"}]},{"ID":"20240830164552-9t14a45","Type":"NodeParagraph","Properties":{"id":"20240830164552-9t14a45","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830164552-rftwdle","Type":"NodeParagraph","Properties":{"id":"20240830164552-rftwdle","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①姜黄"}]},{"ID":"20240830164552-xbxl6yi","Type":"NodeParagraph","Properties":{"id":"20240830164552-xbxl6yi","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"为植物姜黄的干燥根茎，呈圆柱形、卵圆形或纺锤形，形似姜而分叉少，长2.5～5.5厘米，直径10～20毫米。表面深黄棕色，常带黄色粉末，多皱缩，并具有明显的环状节及须根残痕。质坚实而重，难折断，断面棕黄色或黄色，角质状或蜡样光泽，近外围有一黄色的环纹，中部常有黄色的筋脉小点。微有香气，味苦辛。咀嚼时唾液染黄色。以圆柱形、外皮有皱纹、断面棕黄色、质坚实者为佳。"}]},{"ID":"20240830164552-rcndenz","Type":"NodeParagraph","Properties":{"id":"20240830164552-rcndenz","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"主产四川、福建等地。此外，江西、台湾、湖南、陕西、云南等地亦产。"}]},{"ID":"20240830164552-7mnz5kl","Type":"NodeParagraph","Properties":{"id":"20240830164552-7mnz5kl","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②片姜黄（《临症指南》）"}]},{"ID":"20240830164552-0277zpc","Type":"NodeParagraph","Properties":{"id":"20240830164552-0277zpc","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"又名：片子姜黄（《纲目》）。为植物郁金根茎的干燥切片，呈长圆形或不规则的片状，大小不一，长3～6厘米，宽1.5～3厘米，厚3毫米左右。外皮灰黄色，粗糙皱缩，有时可见环节及须根痕，切面黄白色或灰黄色，有1圈环纹及多数筋脉小点散在。质坚实，粉质，有筋脉。有姜香气，味苦而辛凉。以片大、色黄白、质坚实、起粉者为佳。"}]},{"ID":"20240830164552-wy3hrtx","Type":"NodeParagraph","Properties":{"id":"20240830164552-wy3hrtx","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"主产浙江。"}]},{"ID":"20240830164552-yx7nlji","Type":"NodeParagraph","Properties":{"id":"20240830164552-yx7nlji","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【化学成份】姜黄含挥发油4.5％、6％。挥发油中含姜黄酮58％、姜油烯25％、水芹烯1％、1，8-桉叶素1％、香桧烯0.5％、龙脑0.5％、去氢姜黄酮等。还含姜黄素0.3％、1.1％、4.8％及阿拉伯糖1.1％，果糖12％、葡萄糖28％，脂肪油、淀粉、草酸盐等。"}]},{"ID":"20240830164552-lpyh4mn","Type":"NodeParagraph","Properties":{"id":"20240830164552-lpyh4mn","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830164552-10f74b9","Type":"NodeParagraph","Properties":{"id":"20240830164552-10f74b9","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①利胆作用"}]},{"ID":"20240830164552-h7tf03f","Type":"NodeParagraph","Properties":{"id":"20240830164552-h7tf03f","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄煎剂及浸剂能增加犬的胆汁分泌，使胆汁成分恢复正常，并增加胆囊收缩，其作用弱而持久，可持续1～2小时。姜黄素或其钠盐有利胆作用，静脉注射于狗，可减少固体成分的含量而增加胆汁分泌量，但从总的绝对值来看，胆盐、胆红素、胆甾醇分泌量均增加，脂肪酸成分保持恒定。另一种同属植物中提出的挥发油增加胆汁分泌，色素则引起胆囊收缩。Curcumen为胆甾醇溶剂，可用以治疗胆道结石。50％姜黄煎剂可促进食欲。"}]},{"ID":"20240830164552-h24zii4","Type":"NodeParagraph","Properties":{"id":"20240830164552-h24zii4","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②对子宫的作用"}]},{"ID":"20240830164552-rbpnvxw","Type":"NodeParagraph","Properties":{"id":"20240830164552-rbpnvxw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"片姜黄及色姜黄煎剂及浸剂（2％盐酸作溶剂）对小白鼠、豚鼠离体子宫呈兴奋作用，对家兔子宫瘘管引起周期性收缩，1次给药可持续5～7小时。"}]},{"ID":"20240830164552-ehob3qz","Type":"NodeParagraph","Properties":{"id":"20240830164552-ehob3qz","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③降压作用"}]},{"ID":"20240830164552-k7k9zqs","Type":"NodeParagraph","Properties":{"id":"20240830164552-k7k9zqs","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄醇提取液，对麻醉犬表现降压作用，此作用不因注射阿托品及切除迷走神经而受影响。如预先注射麦角流浸膏，可使降压作用翻转为升压作用（与黄连碱的翻转作用有相似之处），醚提取成分降压作用极弱。"}]},{"ID":"20240830164552-i5vazq7","Type":"NodeParagraph","Properties":{"id":"20240830164552-i5vazq7","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"④抗菌作用"}]},{"ID":"20240830164552-fdc870b","Type":"NodeParagraph","Properties":{"id":"20240830164552-fdc870b","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄素及挥发油部分对金黄色葡萄球菌有较好的抗菌作用。姜黄水浸剂在试管内对多种皮肤真菌有不同程度的抑制作用。煎剂对接种病毒的小鼠，能延长其生存时间，但对在病毒性肝炎墓础上加上化学性（四氯化碳）的肝伤害则无效。此外姜黄制剂可杀蝇。"}]},{"ID":"20240830164552-r3pylsj","Type":"NodeParagraph","Properties":{"id":"20240830164552-r3pylsj","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑤其他作用"}]},{"ID":"20240830164552-wd87lww","Type":"NodeParagraph","Properties":{"id":"20240830164552-wd87lww","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄煎剂有镇痛作用，对离体蛙心引起显著的抑制。"}]},{"ID":"20240830164552-sr37sob","Type":"NodeParagraph","Properties":{"id":"20240830164552-sr37sob","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【炮制】姜黄：拣去杂质，用水浸泡，捞起，润透后切片，晾干。片姜黄：拣去杂质及残留须根，刷洗泥屑，晾干。"}]},{"ID":"20240830164552-lnizjkc","Type":"NodeParagraph","Properties":{"id":"20240830164552-lnizjkc","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830164552-49lakme","Type":"NodeParagraph","Properties":{"id":"20240830164552-49lakme","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"辛苦，温。"}]},{"ID":"20240830164552-24vj4jw","Type":"NodeParagraph","Properties":{"id":"20240830164552-24vj4jw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味辛苦，大寒，无毒。\""}]},{"ID":"20240830164552-q4jsos3","Type":"NodeParagraph","Properties":{"id":"20240830164552-q4jsos3","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"味辛，温，无毒。\""}]},{"ID":"20240830164552-r771std","Type":"NodeParagraph","Properties":{"id":"20240830164552-r771std","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③李杲：\"味苦甘辛，大寒，无毒。\""}]},{"ID":"20240830164552-xaxjn4v","Type":"NodeParagraph","Properties":{"id":"20240830164552-xaxjn4v","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"④《东医宝鉴》：\"性热，味辛苦，无毒。\""}]},{"ID":"20240830164552-l0apz3z","Type":"NodeParagraph","Properties":{"id":"20240830164552-l0apz3z","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830164552-8ikrvio","Type":"NodeParagraph","Properties":{"id":"20240830164552-8ikrvio","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"入脾、肝经。"}]},{"ID":"20240830164552-cbftdqt","Type":"NodeParagraph","Properties":{"id":"20240830164552-cbftdqt","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入心、脾。\""}]},{"ID":"20240830164552-srg2vdj","Type":"NodeParagraph","Properties":{"id":"20240830164552-srg2vdj","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肺二经。\""}]},{"ID":"20240830164552-hvv7ecy","Type":"NodeParagraph","Properties":{"id":"20240830164552-hvv7ecy","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足太阴、厥阴。\""}]},{"ID":"20240830164552-xzoql8y","Type":"NodeParagraph","Properties":{"id":"20240830164552-xzoql8y","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830164552-dty3aa2","Type":"NodeParagraph","Properties":{"id":"20240830164552-dty3aa2","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"破血，行气，通经，止痛。治心腹痞满胀痛，臂痛，症瘕，妇女血瘀经闭，产后瘀停腹痛，跌扑损伤，痈肿。"}]},{"ID":"20240830164552-g6z5y5s","Type":"NodeParagraph","Properties":{"id":"20240830164552-g6z5y5s","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"用于气滞血瘀的胸腹痛、痛经及肢体疼痛，常配元胡、香附。"}]},{"ID":"20240830164552-bokgecf","Type":"NodeParagraph","Properties":{"id":"20240830164552-bokgecf","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"主心腹结积，疰忤，下气，破血，除风热，消痈肿。功力烈于郁金。\""}]},{"ID":"20240830164552-q4c4x2h","Type":"NodeParagraph","Properties":{"id":"20240830164552-q4c4x2h","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治症瘕血块，痈肿，通月经，治跌扑瘀血，消肿毒；止暴风痛冷气，下食。\""}]},{"ID":"20240830164552-drexeuu","Type":"NodeParagraph","Properties":{"id":"20240830164552-drexeuu","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"治气胀及产后败血攻心。\""}]},{"ID":"20240830164552-ikqdg1y","Type":"NodeParagraph","Properties":{"id":"20240830164552-ikqdg1y","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治风痹臂痛。\""}]},{"ID":"20240830164552-ahcmizu","Type":"NodeParagraph","Properties":{"id":"20240830164552-ahcmizu","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"除心腹气结气胀，冷气食积疼痛。\""}]},{"ID":"20240830164552-exi748j","Type":"NodeParagraph","Properties":{"id":"20240830164552-exi748j","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑥《本草述》：\"治气证痞证，胀满喘噎，胃脘痛，腹胁肩背及臂痛，痹，疝。\""}]},{"ID":"20240830164552-thaoska","Type":"NodeParagraph","Properties":{"id":"20240830164552-thaoska","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"治四肢之风寒湿痹。\""}]},{"ID":"20240830164552-gyt09wn","Type":"NodeParagraph","Properties":{"id":"20240830164552-gyt09wn","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑧《现代实用中药》：\"为芳香健胃药，有利胆道及肝脏之消毒作用。用于黄疸，胸满痞闷疼痛。又为止血剂，治吐血、衄血、尿血，并治痔疾。外用于脓肿创伤。\""}]},{"ID":"20240830164552-kwf9xfl","Type":"NodeParagraph","Properties":{"id":"20240830164552-kwf9xfl","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；或入丸，散。外用：研末调敷。"}]},{"ID":"20240830164552-8ehnj88","Type":"NodeParagraph","Properties":{"id":"20240830164552-8ehnj88","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830164552-l14ofd7","Type":"NodeParagraph","Properties":{"id":"20240830164552-l14ofd7","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"血虚而无气滞血瘀者忌服。"}]},{"ID":"20240830164552-g6i4814","Type":"NodeParagraph","Properties":{"id":"20240830164552-g6i4814","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"《本草经疏）：\"凡病因血虚臂痛，血虚腹痛，而非瘀血凝滞、气塑上逆作胀者，切勿误用。误则愈伤血分，令病转剧。\""}]},{"ID":"20240830164552-wafgqlg","Type":"NodeParagraph","Properties":{"id":"20240830164552-wafgqlg","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830164552-cz9bwfe","Type":"NodeParagraph","Properties":{"id":"20240830164552-cz9bwfe","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①治心痛不可忍：姜黄（微炒）、当归（切，焙）各一两，木香、乌药（微炒）各半两。上四味，捣罗为散，每服二钱匕，煎茱萸醋汤调下。（《圣济总录》姜黄散）"}]},{"ID":"20240830164552-nldhf8x","Type":"NodeParagraph","Properties":{"id":"20240830164552-nldhf8x","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②治九种心痛，发作无时，及虫痛不可忍者：姜黄三分，槟榔半两，干漆（捣碎，炒令烟出）半两，石灰（炒令黄色）一两。上药为细末，每服二钱，温酒调下，不拘时候。（《杨氏家藏方》姜黄散）"}]},{"ID":"20240830164552-cxlyjxh","Type":"NodeParagraph","Properties":{"id":"20240830164552-cxlyjxh","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③治胃炎，胆道炎，腹胀闷，疼痛，呕吐，黄疸：姜黄一钱五分，黄连六分，肉桂三分，延胡索一钱二分，广郁金一钱五分，绵茵陈一钱五分。水煎服。（《现代实用中药》）"}]},{"ID":"20240830164552-724b3id","Type":"NodeParagraph","Properties":{"id":"20240830164552-724b3id","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"④治臂背痛，非风非痰：姜黄、甘草、羌活各一两，白术二两。每服一两，水煎。腰以下痛，加海桐皮、当归、芍药。（《赤水玄珠》姜黄散）"}]},{"ID":"20240830164552-bqlp390","Type":"NodeParagraph","Properties":{"id":"20240830164552-bqlp390","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑤治室女月水滞涩，调顺营气：姜黄、丁香、当归（切，焙）、芍药各半两。上四味，捣细罗为散，每服二钱匕，温酒调下。经脉欲来，先服此药，不拘时候。（《圣济总录》姜黄散）"}]},{"ID":"20240830164552-03xbnxt","Type":"NodeParagraph","Properties":{"id":"20240830164552-03xbnxt","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑥治经水先期而至，血涩少，其色赤者：当归、熟地、赤芍、川芎、姜黄、黄芩、丹皮、延胡索、香附（制）各等分。水煎服。（《医宗金鉴》姜芩四物汤）"}]},{"ID":"20240830164552-r1wyefn","Type":"NodeParagraph","Properties":{"id":"20240830164552-r1wyefn","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑦治妊娠胎漏，下血不止，腹痛：姜黄一两，当归一两（锉，微炒），熟干地黄一两，艾叶一两（微妙），鹿角胶一两（捣碎，炒令黄燥）。上药，捣筛为散，每服四钱，以水一中盏，入生姜半分，枣三枚，煎至六分，去滓，每于食前温服。（《圣惠方》姜黄散）"}]},{"ID":"20240830164552-6xr70g6","Type":"NodeParagraph","Properties":{"id":"20240830164552-6xr70g6","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑧治产后腹痛：姜黄二分，没药一分。上为末，以水及童子小便各一盏，入药煎至一盏半，分作三服，通口服，约人行五、七里，再进一服。（《普济方》姜黄散）"}]},{"ID":"20240830164552-iv2iror","Type":"NodeParagraph","Properties":{"id":"20240830164552-iv2iror","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑨治一切跌打：桃仁、兰叶、丹皮、姜黄、苏木、当归、陈皮、牛膝、川芎、生地、肉桂、乳香、没药。水、酒、童便煎服。（《伤科方书》姜黄汤）"}]},{"ID":"20240830164552-xy7qva6","Type":"NodeParagraph","Properties":{"id":"20240830164552-xy7qva6","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑩治牙痛不可忍：姜黄、细辛、白芷等分。上为细末，并擦二、三次，盐汤漱。（《百一选方》姜黄散）"}]},{"ID":"20240830164552-xlfyx7l","Type":"NodeParagraph","Properties":{"id":"20240830164552-xlfyx7l","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑾治诸疮癣初生时痛痒：姜黄敷之。（《千金方》）"}]},{"ID":"20240830164552-kedske7","Type":"NodeParagraph","Properties":{"id":"20240830164552-kedske7","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑿心痛难忍。用姜黄一两、桂三两，共研为末，每服一钱，醋汤送下。"}]},{"ID":"20240830164552-7qw78fk","Type":"NodeParagraph","Properties":{"id":"20240830164552-7qw78fk","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⒀胎寒腹痛（婴儿啼哭吐乳，大便色青，状如惊风，出冷汗）。用姜黄一钱，没药、没香、乳香各二钱，共研为末，加蜜调成丸了，如芡子大。每服一丸，钩藤煎汤化下。"}]},{"ID":"20240830164552-3ouyiop","Type":"NodeParagraph","Properties":{"id":"20240830164552-3ouyiop","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⒁产后血痛（腹内有血块）。用姜黄、桂心，等分为末，酒冲服一匙，血下尽后即愈。"}]},{"ID":"20240830164552-flf5f7o","Type":"NodeParagraph","Properties":{"id":"20240830164552-flf5f7o","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⒂疮癣初发。用姜黄研末擦上，甚效。"}]},{"ID":"20240830164552-btgob6c","Type":"NodeParagraph","Properties":{"id":"20240830164552-btgob6c","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830164552-mims6p1","Type":"NodeParagraph","Properties":{"id":"20240830164552-mims6p1","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"姜黄，性热不冷，《本经》云寒，误也。\""}]},{"ID":"20240830164552-1l5812t","Type":"NodeParagraph","Properties":{"id":"20240830164552-1l5812t","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"姜黄、郁金、蒁药三物，形状功用皆相近，但郁金入心治血，而姜黄兼入脾，兼治气，蒁药则入肝，兼治气中之血，为不同尔。古方五痹汤，用片子姜黄治风寒湿气手臂痛。戴原礼《要诀》云，片子姜黄能入手臂治痛，其兼理血中之气可知。\""}]},{"ID":"20240830164552-lk58d0x","Type":"NodeParagraph","Properties":{"id":"20240830164552-lk58d0x","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"姜黄，其味苦胜辛劣，辛香燥烈，性不应寒。…苦能泄热，辛能散结，故主心腹结积之属血分者。兼能治气，故又云下气。总其辛苦之力，破血除风热，消痈肿，其能事也。《日华子》谓其能治癥瘕血块，又通月经及扑损瘀血，苏颂谓其祛邪辟恶，治气胀及产后败血攻心，…何莫非下气破血辛走苦泄之功欤。察其气味治疗，乃介乎京三棱、郁金之药也。\""}]},{"ID":"20240830164552-u48xlr1","Type":"NodeParagraph","Properties":{"id":"20240830164552-u48xlr1","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"④《本草述》：\"姜黄，试阅方书诸证之主治，如气证、痞证、胀满、喘、噎、胃皖痛、腹胁肩背及臂痛、痹，疝，虽所投有多寡，然何莫非以气为其所治之的，…未有专为治血而用兹味，如《本草》所说也。且此味亦不等于破决诸剂，…此味能致血化者，较与他血药有原委，不察于是，而漫谓其破血，讵知姜黄不任受’破’之一字也。\""}]},{"ID":"20240830164552-fq4qtm5","Type":"NodeParagraph","Properties":{"id":"20240830164552-fq4qtm5","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑤《本草求真》：\"姜黄，功用颇类郁金、三棱、蓬术、延胡索，但郁金入心，专泻心胞之血；莪术入肝，治气中之血；三棱入肝，治血中之气；延胡索则于心肝血分行气，气分行血；此则入脾，既治气中之血，复兼血中之气耳。陈藏器曰：此药辛少苦多，性气过于郁金，破血立通，下气最速，凡一切结气积气，癥瘕瘀血，血闭痈疽，并皆有效，以其气血兼理耳，\""}]},{"ID":"20240830164552-9w9zbyk","Type":"NodeParagraph","Properties":{"id":"20240830164552-9w9zbyk","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑥《本草求原》：\"姜黄，益火生气，辛温达火化气，气生化则津液行于三阴三阳，清者注于肺，浊者注于经、溜于海，而血自行，是理气散结而兼泄血也。\""}]},{"ID":"20240830164552-g1izs0c","Type":"NodeParagraph","Properties":{"id":"20240830164552-g1izs0c","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"⑦《本草正义》：\"姜黄始见《唐本草》，称其辛苦大寒，藏器已辨其非，谓辛少苦多，性热不冷，则《唐本》寒字，盖亦传写之误。石顽谓有二种。按：今市肆姜黄，确有二种，名片姜黄者，是本已切为厚片，而后晒干，形似干姜，色不黄，质亦不坚，治风寒湿者即此。又一种则坚实光亮，其色深黄，乃如郁金，是为染色之用，不入药剂者。《唐本》谓治心腹结积，疰忤，下气破血，盖辛能散，温能通，故可破结辟恶，消瘀下气，是物功用，即在此数者之中。然又谓除风热，消痈肿，功力烈于郁金，则正以入血泄散，故痈疡之坚肿可消；疡科普通敷药之如意金黄散用之，即是此意。固非疏风清热之作用，而乃竟以为除风热，宜乎有辛苦大寒之误矣。\""}]},{"ID":"20240830164552-vl20ge0","Type":"NodeParagraph","Properties":{"id":"20240830164552-vl20ge0","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830164552-buotgz4","Type":"NodeParagraph","Properties":{"id":"20240830164552-buotgz4","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄《中华本草》"}]},{"ID":"20240830164552-nufms8o","Type":"NodeParagraph","Properties":{"id":"20240830164552-nufms8o","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830164552-5i53wws","Type":"NodeParagraph","Properties":{"id":"20240830164552-5i53wws","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"出自《唐本草》：姜黄，叶、根都似郁金，花春生于根，与苗并出，入夏花烂无子。根有黄、青、白三色，其作之方法与郁金同尔。西戎人谓之蒁药。其味辛少苦多，与郁金同，惟花生异耳。"}]},{"ID":"20240830164552-a8jinpp","Type":"NodeParagraph","Properties":{"id":"20240830164552-a8jinpp","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目拾遗》：姜黄真者是经种三年以上老姜。能生花，花在根际，一如蘘荷。根节坚硬，气味辛辣，种姜处有之，终是难得。西番亦有来者，与郁金、蒁药相似，如苏敬所附，即是蒁药而非姜黄，苏不能分别二物也。又蒁味苦温，主恶气疰忤心"}]},{"ID":"20240830164552-b5hj45n","Type":"NodeParagraph","Properties":{"id":"20240830164552-b5hj45n","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【拼音名】JiānɡHuánɡ"}]},{"ID":"20240830164552-8oj6xmg","Type":"NodeParagraph","Properties":{"id":"20240830164552-8oj6xmg","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【英文名】Turmeric"}]},{"ID":"20240830164552-qzp06vb","Type":"NodeParagraph","Properties":{"id":"20240830164552-qzp06vb","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【别名】宝鼎香、黄姜"}]},{"ID":"20240830164552-ow897lv","Type":"NodeParagraph","Properties":{"id":"20240830164552-ow897lv","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830164552-yyighcw","Type":"NodeParagraph","Properties":{"id":"20240830164552-yyighcw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"药材基源：为姜科植物姜黄的根茎。"}]},{"ID":"20240830164552-7ivqi6o","Type":"NodeParagraph","Properties":{"id":"20240830164552-7ivqi6o","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CurcumalongaL."}]},{"ID":"20240830164552-pwqhafl","Type":"NodeParagraph","Properties":{"id":"20240830164552-pwqhafl","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"采收和储藏：12月下旬挖出地下部分，去掉泥圭和茎秆，先出种根；摘下块根作黄丝郁金。将根茎水洗，放入开水中焯熟，烘干，撞去粗皮，即得干姜黄；也可将根茎切成0.7cm厚的薄片，晒干。"}]},{"ID":"20240830164552-nhknq0m","Type":"NodeParagraph","Properties":{"id":"20240830164552-nhknq0m","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【原形态】姜黄，多年生草本，高1-1.5m。根茎发达，成丛，分枝呈椭圆形或圆柱状，橙黄色，极香；根粗壮，末端膨大成块根。叶基生，5-7片，2列；叶柄长20-45cm；叶片长圆形或窄椭圆形，长20-50cm，宽5-15cm，先端渐尖，基部楔形，下延至叶柄，上面黄绿色，下面浅绿色，无毛。花葶由叶鞘中抽出，总花梗长12-20cm，穗状花序圆柱状，长12-18cm；上部无花的苞片粉红色或淡红紫色，长椭圆形，长4-6cm，宽1-1.5cm，中下部有花的苞片嫩绿色或绿白色，卵形至近圆形，长3-4cm；花萼简绿白色，具3齿；花冠管漏斗形，长约1.5cm，淡黄色，喉部密生柔毛，裂片3；能育雄蕊1，花丝短而扁平，花药长圆形，基部有距；子房下位，外被柔毛，花柱细长，基部有2个棒状腺体，柱头稍膨大，略呈唇形。花期8月。"}]},{"ID":"20240830164552-m7viqvg","Type":"NodeParagraph","Properties":{"id":"20240830164552-m7viqvg","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830164552-dwf9f3f","Type":"NodeParagraph","Properties":{"id":"20240830164552-dwf9f3f","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"生态环境：多为栽培。植于向阳、土壤肥厚质松的田园中偶有野生的。"}]},{"ID":"20240830164552-pduutto","Type":"NodeParagraph","Properties":{"id":"20240830164552-pduutto","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江西、福建、台湾、广东、广西、四川、云南等地。"}]},{"ID":"20240830164552-msdgqee","Type":"NodeParagraph","Properties":{"id":"20240830164552-msdgqee","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830164552-vwtbrq2","Type":"NodeParagraph","Properties":{"id":"20240830164552-vwtbrq2","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"1.气候土壤：宜温暖湿润的气候。以土层深厚、排水良好、疏松肥沃的砂质壤土为佳。"}]},{"ID":"20240830164552-vkoq3ki","Type":"NodeParagraph","Properties":{"id":"20240830164552-vkoq3ki","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"2.整地：一般不须深耕，在种前将土地翻耙2-3次，整平作畦。施足基肥。"}]},{"ID":"20240830164552-bugfrgw","Type":"NodeParagraph","Properties":{"id":"20240830164552-bugfrgw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"3.种植：用根茎繁殖。栽种期在四川、陕西等地，多于夏至前后，浙江地区在清明前后。按行距33-40cm，株距25-33cm开穴，每穴放入姜种3-5个，覆盖细土2-3cm。栽后约20天左右即可出苗。"}]},{"ID":"20240830164552-4uqi96d","Type":"NodeParagraph","Properties":{"id":"20240830164552-4uqi96d","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"4.苗高10-13cm时用稀人粪追肥一次；第2次追肥在处暑前后；第三次在白露前3-4天，宜用饼肥及草木灰；每次追肥前，必先锄草、松土。当干旱少雨时，须于早上或夜晚浇水，使苗叶生长正常。"}]},{"ID":"20240830164552-dt9leom","Type":"NodeParagraph","Properties":{"id":"20240830164552-dt9leom","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"5.病虫害防治：虫害主要为土蚕和蛴螬，可用6%六六六粉在整地时撒入防治，或用人工捕捉或堆草法诱杀。"}]},{"ID":"20240830164552-4fmtx2c","Type":"NodeParagraph","Properties":{"id":"20240830164552-4fmtx2c","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830164552-f4o7459","Type":"NodeParagraph","Properties":{"id":"20240830164552-f4o7459","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"性状鉴别，姜黄根茎呈不规则卵圆形、圆柱形或纺锤形，常弯曲，表面深黄色，粗糙，有皱缩纹理和明显环节，并有圆形分枝痕及须根痕。质坚实，不易折断，断面棕黄色至金黄色，角质样，有蜡样光泽。内皮层环纹明显，维管束呈点状散在。气香特异味苦、辛。"}]},{"ID":"20240830164552-fourgz6","Type":"NodeParagraph","Properties":{"id":"20240830164552-fourgz6","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"以质坚实、断面金黄、香气浓厚者为佳。"}]},{"ID":"20240830164552-2lh3o2d","Type":"NodeParagraph","Properties":{"id":"20240830164552-2lh3o2d","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"显微鉴别，根茎横切面：外方4-10余列木栓化细胞，常发生在皮层部会，其外有时可见表皮及皮层细胞。皮层宽广，有叶迹维管束；内皮层明显。中柱鞘为1-2列细胞；维管束有限外韧形，近中柱鞘处较多，向内渐少。本品薄壁细胞含淀粉粒及棕色色素；薄壁组织中散有油细胞。"}]},{"ID":"20240830164552-iipzcuj","Type":"NodeParagraph","Properties":{"id":"20240830164552-iipzcuj","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【化学成份】根茎含姜黄素类化合物：姜黄素(curcumin)，对，对-二羟基二桂皮酰甲烷(p,p-dihydroxydicinnamoylmethane)，即双去甲氧基姜黄素(bisdemethoxycurcumin)，对-羟基桂皮酰阿魏酰基甲烷(p-hydroxycinnamoylferuloylmethane)，即去甲氧基姜黄素(demethoxycurcumin)，二氢姜黄素(dihydrocurcumin)；倍半萜类化合物：姜黄新酮(curlone)，姜黄酮醇(turmeronol)A、B，大牻牛儿酮-13醛(germacrone-13-al)，4-羟基甜没药-2，10-二烯-9-酮(4-hydroxybisabola-2，10-diene-9-one)，4-甲氧基-5-羟基甜没药-2，10-二烯-9-酮(4-methoxy-5-hydroxybisabola-2,10-diene-9-one)，2，5-二羟基-甜没药-3，10-二烯(2,5-dihydroxybisabola-3,10-diene)，原莪术二醇(procurcumadiol)，莪述双环烯酮(curcumenone)，去氢莪述二酮(drhydrocurdione)，(4S，5S)-大牻牛儿酮-4，5-环氧化物[(4S,5S)-germacron-4,5-epoxide]，α-姜黄酮(α-turmerone)，甜没药姜黄醇(bisacurone)，莪述烯醇(curcumenol)，异原莪述烯醇(isoprocurcumenol)，莪述奥酮二醇(zedoaronediol)，原莪述烯醇(procurcumenol)，表原莪述烯醇(eiprocurcumenol)，4，5-二羟基-甜没药-2，10-二烯(4，5-dihydroxybisabola-2,10-diene)；酸性多糖：姜黄多糖(utonan)A、B、C、D。挥发油(4.2%)，其主要成分有姜黄酮，芳香-姜黄酮(arturmerone)，姜黄烯(curcumene)，大牻牛儿酮(germacrone)，芳-香姜黄烯(ar-curcumene)，桉叶素(cineole)，松油烯(terpinene)，莪术醇(curcumol)，莪述呋喃烯酮(curzerenone)，莪述二酮(curdione)，α-蒎烯(α-pinene)，β-蒎烯(β-pinene)，柠檬烯(limonene)，芳樟醇(linalool)，丁香烯(caryophyllene)，龙脑(borneol)等。还含菜油甾醇(campesterol)，豆甾醇(stigmasterol)，β-谷甾醇(β-sitosterol)，胆甾醇(cholesterol)，脂肪酸及金属元素钾、钠、镁、钙、锰、铁、铜、锌等，锌/铜=3.7。"}]},{"ID":"20240830164552-3z4mqm0","Type":"NodeParagraph","Properties":{"id":"20240830164552-3z4mqm0","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830164552-1glwjdl","Type":"NodeParagraph","Properties":{"id":"20240830164552-1glwjdl","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"1．降血脂作用：姜黄醇或醚提取物、姜黄素和挥发油灌胃，对实验性高脂血症大鼠和家兔都有明显的降血浆总胆固醇和B-脂蛋白的作用，并能降低肝胆固醇，纠正a-和B-脂蛋白比例失调，但对内源性胆固醇无影响；对降血浆甘油三酯的作用更为显着，能使血浆中甘油三酯降低至正常水平以下。高蔗糖饮食能引起大鼠产生高脂血症，姜黄素能对抗此高脂血症产生。灌胃姜黄素能降低肝重，减少肝中甘油三酯、游离脂肪酸、磷脂含量及血清总甘油三酯、VLDL＋LDL甘油三酯，HDL甘油三酯、VLDL＋LDL胆固醇和血中游离脂肪酸的含量，也能提高血清总胆固醇和HDL胆固醇含量。用肝匀浆体外保温法，以14C-醋酸为底物试验，初步结果表明，姜黄素能抑制脂肪酸的合成。"}]},{"ID":"20240830164552-jivl4sw","Type":"NodeParagraph","Properties":{"id":"20240830164552-jivl4sw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"2.抗肿瘤作用：用鼠Dalton氏淋巴腹水瘤细胞进行组织培养及在体实验，姜黄醇提物能抑制癌细胞生长。在0.4mg/ml时能抑制中国仓鼠卵巢细胞生长，并对淋巴细胞和Dalton氏淋巴细胞具有细胞毒性作用，并能减少动物肿瘤的生长，其活性成分主要是姜黄素。在巴豆油促进下，7，12-二甲基苯蒽能诱发小鼠产生乳头癌，姜黄素可明显减少在此情况下乳头癌产生的机会，也能抑制由2O-甲基氯蒽诱导的肿瘤形成。姜黄素还能减少突变原致癌的可能性。姜黄素还能抑制TPA（12-O-Tetradecanoylphorbol-13-acetate）的诱癌作用。当局部应用10μmol/L姜黄素时，对由5nmol/LTPA诱发的鸟苷酸脱羧酶活性的抑制率达91%；10μmol/L的姜黄素与2nmol/L的TPA-起局部应用，对TPA激发的3H-胸腺嘧啶嵌合入表皮DNA中的抑制率为49%，其抑制率与浓度有关。因此，姜黄素可能作为一种抗癌剂。"}]},{"ID":"20240830164552-a3o1lyl","Type":"NodeParagraph","Properties":{"id":"20240830164552-a3o1lyl","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"3.抗炎作用：姜黄素能对抗角义菜胶诱发的大鼠脚趾肿胀，在30mg/kg范围内有剂量依赖性，而剂量在60mg/kg时，则抑制这种抗炎作用。姜黄素钠可逆地抑制尼古丁、乙酰胆碱、5-羟色胺、氯化钡及组胺诱发的离体豚鼠回肠收缩，类似于非固醇类抗炎药。"}]},{"ID":"20240830164552-ls54ueo","Type":"NodeParagraph","Properties":{"id":"20240830164552-ls54ueo","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"4.抗病原微生物作用：体外试验，姜黄素百分之一浓度时，对细球菌（Micrococuspyogenesvar.Aureus）有抑制作用。挥发油有强力抗真菌作用。姜黄能延长接种病毒小鼠的生存时间。"}]},{"ID":"20240830164552-8zs8jv4","Type":"NodeParagraph","Properties":{"id":"20240830164552-8zs8jv4","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"5.对心血管系统的影响：姜黄素静脉注射对血压无明显影响，对肾上腺素、组胺和乙酰胆碱引起的血压亦无明显影响。用姜黄素灌胃能对抗垂体后叶素静脉注射引起的大鼠心电图S-T、T波变化，灌胃还能增加小鼠心肌营养性血流量。姜黄素对血小板聚集及血液粘度有明显影响，正常人体外实验姜黄素浓度为1×10（-4）mol/L，显着抑制血小板聚集，抑制率为35.4%（P＜0.01）。大鼠灌胃5天后（剂量分别为20、40、60、80mg/（kg.天）与对照组相比，血小板聚集作用减弱，血浆粘度和全血粘度降低。其中以40mg/（kg.天）组抑制血小板聚集作用最强，抑制率为34.6%（P＜0.05）。继续增加给药量，抑制作用未见进行性增强。在低切变率（37.5秒-1）条件下，降低全血和血浆粘度作用显着，而高切变率（150秒-1）时，无显着性差异。"}]},{"ID":"20240830164552-jj2zij2","Type":"NodeParagraph","Properties":{"id":"20240830164552-jj2zij2","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"6.利胆作用：姜黄提取物、姜黄素、挥发油、姜黄酮以及姜烯、龙脑和倍半萜醇等，都有利胆作用，能增加胆汁的生成和分泌，并能促进胆囊收缩，而以姜黄素的作用为最强。"}]},{"ID":"20240830164552-gpxrnmh","Type":"NodeParagraph","Properties":{"id":"20240830164552-gpxrnmh","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"7.对终止妊娠的作用：姜黄制成100%（生药1g/ml）和200%水煎剂。小鼠在妊娠早期（6-7天）、中期（10-14天）和晚期（16-18天）分别腹腔注射或皮下注射姜黄水煎剂10g/kg，每日1次，连续2天。早、中期妊娠小鼠在给药1次后，次日清晨可见阴道出血，解剖可见子宫内有坏死、变性胚胎，晚期妊娠小鼠在给药1次后，大部分在24小时内娩出小鼠。表明腹腔注射或皮下注射给药对小鼠各期妊娠都有明显作用（口服50g/kg无效），终止妊娠率为90-100%，而对照组胚胎发育正常。家兔于妊娠早期（8-10天）、中期（13-15天）和晚期（23-25天）腹腔注射或皮下注射姜黄水煎剂8g/kg，每日1次，连续2-3天，8只早期妊娠家兔和4只中期妊娠家兔全部终止妊娠，4只晚期妊娠家兔亦全部流产。对照组6只家兔全部正常妊娠。以未成熟小鼠子宫增重法，测定姜黄的雌激素与抗雌激素活性，表明姜黄水煎剂10g/kg腹腔注射或皮下注射无雌激素活性和抗雌激素活性。姜黄10g/kg所致的终止动物早期妊娠作用可被黄体酮（1mg/鼠）拮抗，姜黄10g/kg还可明显抑制假孕小鼠创伤性子宫蜕膜瘤的生长，因此推测姜黄引起动物早期流产作用的机理，可能是由于它具有抗孕激素活性和宫缩作用。"}]},{"ID":"20240830164552-9hz0n9z","Type":"NodeParagraph","Properties":{"id":"20240830164552-9hz0n9z","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"姜黄粉依次用石油醚、95%乙醇和水提取物，于妊娠第l-7天连续灌胃，三种提取物的剂量为100mg/kg时，对雌性大鼠的终止妊娠率分别为100，70和100%。出生的幼鼠无畸形。上述3种提取物对硫酸铜诱发的兔排卵均无影响。"}]},{"ID":"20240830164552-on3kbdi","Type":"NodeParagraph","Properties":{"id":"20240830164552-on3kbdi","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"8.抗氧化作用：以NIH小鼠脑、心、肝、肾、脾等器官制成一定浓度匀浆液，以不饱和脂肪酸被氧化成过氧化脂质时，过氧化脂质很快又转变成丙二醛，在加热条件下丙二醛与硫代巴比妥酸反应生成红色化合物的原理进行检测，结果姜黄素对五大脏器的脂质过氧化作用都有明显对抗作用。各脏器匀浆浓度分别为，脑3.39%，心1.16%，肝（1）3.97%，肝（2）3.94%，肾2.08%，脾1.67%；姜黄素剂量（mg/100ml）分别为，脑0.31-0.123，心20.4-0.8，肝（1）20.4-0.8,肝（2）0.8-0.128，肾20.4-0.8，脾0.8-0.123，与空白对照比较，除脾中剂量0.32、低剂量0.123P＞0.005，脑高剂量0.32P＜0.01外，其余均为P＜0．001。亦有报道，姜黄素和4-Hydroxycinnamoyl（geruloyl）methane，bis（4-Hydroxycinnamoyl）methane均有抗氧作用，以姜黄素最好，对亚油酸的空气氧化的50%抑制浓度为1.83×10（-2）%（硫巴比妥值）和1．15×10（-2）%（过氧化物值），均高于维生素E。"}]},{"ID":"20240830164552-i2y9esz","Type":"NodeParagraph","Properties":{"id":"20240830164552-i2y9esz","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"9.光效应作用：姜黄素在通常情况下杀菌能力较弱，但当给于光照射时，微克量的姜黄素就显示出很强的光毒性反应。革兰氏阴性菌对于姜黄素光毒性的抵抗力比革兰氏阳性强。姜黄素的这种光毒性只有在有氧情况下才能产生。因此姜黄素可能作为一种光敏化药物应用于牛皮癣、癌症、细菌和病毒性疾病的光疗。姜黄素还能对易光解的药物起稳定的作用。如对硝苯吡啶的光稳定作用特别强，使它半衰期延长6倍，可增强其疗效。"}]},{"ID":"20240830164552-8isrd87","Type":"NodeParagraph","Properties":{"id":"20240830164552-8isrd87","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"10.其它作用：姜黄素可抑制PGS的生物合成。姜黄还可杀蝇。姜黄的氯仿和乙醚提取物体外对发癣菌和石膏样小孢子菌有抑制作用。TurmeronolA和B可抑制大豆脂氧合酶，其IC50分别为16和19μmol/L。这二种化合物在-200ppm浓度时可防止亚油酸的自动氧化。"}]},{"ID":"20240830164552-wux9jua","Type":"NodeParagraph","Properties":{"id":"20240830164552-wux9jua","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【毒性】小鼠可只灌胃姜黄醇浸液40-100g（中药），观察3天，未发生死亡。以姜黄浸膏5、2和0.5g/kg（相当于临床用量的50、20和5倍）拌入饲料中喂大鼠，共30天，体重、食量和活动未见异常。取心、肝、肾、主动脉、肾上腺作病理组织学检查，均未见明显病理改变，姜黄素小鼠灌胃的半数致死量大于2g/kg。"}]},{"ID":"20240830164552-1c2cqhi","Type":"NodeParagraph","Properties":{"id":"20240830164552-1c2cqhi","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830164552-1le6cc5","Type":"NodeParagraph","Properties":{"id":"20240830164552-1le6cc5","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末少量，置滤纸上，滴加乙醇及乙醚各1滴，待干，除去粉末，滤纸染成黄色，加热硼酸饱和溶液1滴，则渐变为橙红色。再加氨试液1滴，则变成蓝黑色，后渐变为褐色，久置，则又变为橙红色。"}]},{"ID":"20240830164552-tsiex8i","Type":"NodeParagraph","Properties":{"id":"20240830164552-tsiex8i","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"（2）取本品细粉10mg，加醋酐2ml，振摇后加硫酸1-2滴，在荧光灯（365nm）下呈血红色。"}]},{"ID":"20240830164552-r3osd4y","Type":"NodeParagraph","Properties":{"id":"20240830164552-r3osd4y","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【炮制】姜黄：拣去杂质，用水浸泡，捞起，润透后切片，晾干。片姜黄：拣去杂质及残留须根，刷洗泥屑，晾干。"}]},{"ID":"20240830164552-1m37yoo","Type":"NodeParagraph","Properties":{"id":"20240830164552-1m37yoo","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；辛；性温"}]},{"ID":"20240830164552-t8n2g4e","Type":"NodeParagraph","Properties":{"id":"20240830164552-t8n2g4e","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肝经"}]},{"ID":"20240830164552-w8b4w3c","Type":"NodeParagraph","Properties":{"id":"20240830164552-w8b4w3c","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【功能主治】破血行气；通经止痛。主血瘀气滞诸证；胞腹胁痛；妇女痛经；闭经；产后瘀滞腹痛；风湿痹痛；跌打损伤；痈肿"}]},{"ID":"20240830164552-qtcrw9l","Type":"NodeParagraph","Properties":{"id":"20240830164552-qtcrw9l","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240830164552-deuf6fg","Type":"NodeParagraph","Properties":{"id":"20240830164552-deuf6fg","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【注意】血虚无气滞血瘀及孕妇慎服。"}]},{"ID":"20240830164552-bcc6rs1","Type":"NodeParagraph","Properties":{"id":"20240830164552-bcc6rs1","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【附方】①治心痛不可忍：姜黄(微炒)、当归(切，焙)各一两，木香、乌药(微炒)各半两。上四味，捣罗为散，每服二钱匕，煎茱萸醋汤调下。(《圣济总录》姜黄散)②治九种心痛，发作无时，及虫痛不可忍者：姜黄三分，槟榔半两，干漆(捣碎，炒令烟出)半两，石灰(炒令黄色)一两。上药为细末，每服二钱，温酒调下，不拘时候。(《杨氏家藏方》姜黄散)③治胃炎，胆道炎，腹胀闷，疼痛，呕吐，黄疸：姜黄一钱五分，黄连六分，肉桂三分，延胡索一钱二分，广郁金一钱五分，绵菌陈一钱五分。水煎服。(《现代实用中药》)④治臂背痛，非风非痰：姜黄、甘草、羌活各一两，白术二两。每服一两，水煎。腰以下痛，加海桐皮、当归、芍药。(《赤水玄珠》姜黄散)⑤治室女月水滞涩，调顺营气：姜黄、丁香、当归(切，焙)、芍药各半两。上四味，捣细罗为散，每服二钱匕，温酒调下。经脉欲来，先服此药，不拘时候。(《圣济总录》姜黄散)⑥治经水先期而至，血涩少，其色赤者：当归、熟地、赤芍、川芎、姜黄、黄芩、丹皮、延胡索、香附(制)各等分。水煎服。(《医宗金鉴》姜芩四物汤)⑦治妊娠胎漏，下血不止，腹痛：姜黄一两，当归一两(挫，微炒)，熟干地黄一两，艾叶一两(微炒)，鹿角胶一两(捣碎，炒令黄燥)。上药，捣筛为散，每服四钱，以水一中盏，入生姜半分，枣三枚，煎至大分，去滓，每于食前温服。(《圣惠方》姜黄散)⑧治产后腹痛：姜黄二分，没药一分。上为末，以水及童子小便各一盏，入药煎至一盏半，分作三服，通口服，约人行五、七里，再进一服。(《普济方》姜黄散)⑨治一切跌打：桃仁、兰叶、丹皮、姜黄、苏木、当归、陈皮、牛膝、川芎、生地、肉桂、乳香、没药。水、酒、童便煎服。(《伤科方书》姜黄汤)⑩治牙痛不可忍：姜黄、细辛、白芷等分。上为细末，并擦二、三次，盐汤漱。(《百一选方》姜黄散)11.治诸疮癣初生时痛痒：姜黄敷之。(《千金方》)"}]},{"ID":"20240830164552-f7uttwf","Type":"NodeParagraph","Properties":{"id":"20240830164552-f7uttwf","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830164552-xoo6cgw","Type":"NodeParagraph","Properties":{"id":"20240830164552-xoo6cgw","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：姜黄，性热不冷，《本经》云寒，误也。"}]},{"ID":"20240830164552-4hiadfy","Type":"NodeParagraph","Properties":{"id":"20240830164552-4hiadfy","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：姜黄、郁金、蒁药三物，形状功用皆相近，但郁金入心治血，而姜黄兼入脾，兼治气，蒁药则入肝，兼治气中之血，为不同尔。古方五痹汤，用片子姜黄治风寒湿气手臂痛。戴原礼《要诀》云，片子姜黄能入手臂治痛，其兼理血中之气可知。"}]},{"ID":"20240830164552-xjz9fb6","Type":"NodeParagraph","Properties":{"id":"20240830164552-xjz9fb6","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：姜黄，其味苦胜辛劣，辛香燥烈，性不应寒。，苦能泄热，辛能散结，故主心腹结积之属血分者。兼能治气，故又云下气。总其辛苦之力，破血除风热，消痈肿，其能事也。《日华子》谓其能治症瘕血块，又通月经及扑损瘀血，苏颂谓其祛邪辟恶，治气胀及产后败血攻心，何莫非下气破血辛走苦泄之功欤。察其气味治疗，乃介乎京三棱、郁金之药也。"}]},{"ID":"20240830164552-lgh1xuc","Type":"NodeParagraph","Properties":{"id":"20240830164552-lgh1xuc","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"4.《本草述》：姜黄，试阅方书诸证之主治，如气证、痞证、胀满、喘、噎、胃脘痛、腹胁肩背及臂痛、痹、疝，虽所投有多寡，然何莫非以气为其所治之的，未有专为治血而用兹味，如《本草》所说也。且此味亦不等于破决诸剂，此味能致血化者，较与他血药有原委，不察于是，而漫谓其破血，讵知姜黄不任受'破'之一字也。"}]},{"ID":"20240830164552-o4l6bj2","Type":"NodeParagraph","Properties":{"id":"20240830164552-o4l6bj2","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：姜黄，功用颇类郁金、三棱、蓬术、延胡索，但郁金入心，专泻心胞之血；莪术入肝，治气中之血；三棱入肝，治血中之气；延胡索则于心肝血分行气，气分行血；此则入脾，既治气中之血，复兼血中之气耳。陈藏器曰：此药辛少苦多，性气过于郁金，破血立通，下气最速，凡一切结气积气，症瘕瘀血；血闭痈疽，并皆有效，以其气血兼理耳。"}]},{"ID":"20240830164552-3toq1qp","Type":"NodeParagraph","Properties":{"id":"20240830164552-3toq1qp","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"6.《本草求原》：姜黄，益火生气，辛温这火化气，气生化则津液行于三阴三阳；清者注于肺，浊者注于经、溜于海，而血自行，是理气散结而兼泄血也。"}]},{"ID":"20240830164552-cfn14rn","Type":"NodeParagraph","Properties":{"id":"20240830164552-cfn14rn","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"7.《本草正义》：姜黄始见《唐本草》，称其辛苦大寒，藏器已辨其非，谓辛少苦多，性热不冷，则《唐本》寒字，盖亦传写之误。石顽谓有二种。按：今市肆姜黄，确有二种，名片姜黄者，是本巳切为厚片，而后晒干，形似干姜，色不黄，质亦不坚，治风寒湿者即此。又一种则坚实光亮，其色深黄，乃如郁金，是为染色之用，不入药剂者。《唐本》谓治心腹结积，疰忤，下气破血，盖辛能散，温能通，故可破结辟恶，消痰下气，是物功用，即在此数者之中。然又谓除风热，消痈肿，功力烈于郁金，则正以入血泄散，故痈疡之坚肿可消，疡科普通敷药之如意金黄散用之，即是此意。固非疏风清热之作用，而乃竟以为除风热，宜乎有辛苦大寒之误矣。"}]},{"ID":"20240830164552-akf1k6j","Type":"NodeParagraph","Properties":{"id":"20240830164552-akf1k6j","updated":"20240830164624"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830164553-nt1xk3z","Type":"NodeThematicBreak","Properties":{"id":"20240830164553-nt1xk3z","updated":"20240830164624"}},{"ID":"20240830164554-btlnbl3","Type":"NodeParagraph","Properties":{"id":"20240830164554-btlnbl3","updated":"20240830164624"}}]}