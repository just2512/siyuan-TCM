deText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 374px;","style":"width: 364px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡血藤 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡血藤 10-20240730160950-i0dfa3c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 788px;","style":"width: 778px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡血藤 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡血藤 15-20240730161440-pdyyrqq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 778px;\" parent-style=\"width: 788px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730161439-jchotun","Type":"NodeParagraph","Properties":{"id":"20240730161439-jchotun","updated":"20240730161846"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 557px;","style":"width: 547px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡血藤 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡血藤 16-20240730161836-d8eiit9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 547px;\" parent-style=\"width: 557px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 361px;","style":"width: 351px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡血藤 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡血藤 12-20240730161130-rgesu6y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 351px;\" parent-style=\"width: 361px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 373px;","style":"width: 363px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡血藤 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡血藤 14-20240730161300-42dcrfa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 363px;\" parent-style=\"width: 373px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240730160252-d24ll0l","Type":"NodeParagraph","Properties":{"id":"20240730160252-d24ll0l","updated":"20240730160252"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240730160252-fd2fce7.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730154813-w06qtgx","Type":"NodeParagraph","Properties":{"id":"20240730154813-w06qtgx","updated":"20240730154912"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：鸡血藤藤茎切面会流‘血’；"}]},{"ID":"20240730154307-3zo0oxw","Type":"NodeThematicBreak","Properties":{"id":"20240730154307-3zo0oxw"}},{"ID":"20240903092810-7j7a43c","Type":"NodeParagraph","Properties":{"id":"20240903092810-7j7a43c","updated":"20240903092817"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：鸡血藤"}]},{"ID":"20240903092810-cayu535","Type":"NodeParagraph","Properties":{"id":"20240903092810-cayu535","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"鸡血藤《中国药典》"}]},{"ID":"20240903092810-l5h0fak","Type":"NodeParagraph","Properties":{"id":"20240903092810-l5h0fak","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīXuèTénɡ"}]},{"ID":"20240903092810-lk9kqrf","Type":"NodeParagraph","Properties":{"id":"20240903092810-lk9kqrf","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【英文名】CAULISSPATHOLOBI"}]},{"ID":"20240903092810-yvkmpwc","Type":"NodeParagraph","Properties":{"id":"20240903092810-yvkmpwc","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【别名】血风、血藤、大血藤、血风藤、三叶鸡血藤、九层风"}]},{"ID":"20240903092810-bcpvgfy","Type":"NodeParagraph","Properties":{"id":"20240903092810-bcpvgfy","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【来源】本品为豆科植物密花豆（大血藤、血风藤、三叶鸡血藤、九层风）SpatholobussuberectusDunn的干燥藤茎。秋、冬二季采收，除去枝叶，切片，晒干。"}]},{"ID":"20240903092810-5k553ut","Type":"NodeParagraph","Properties":{"id":"20240903092810-5k553ut","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性状】本品为椭圆形、长矩圆形或不规则的斜切片，厚0.3～1cm。栓皮灰棕色，有的可见灰白色斑，栓皮脱落处显红棕色。切面木部红棕色或棕色，导管孔多数；韧皮部有树脂状分泌物呈红棕色至黑棕色，与木部相间排列呈3～8个偏心性半圆形环；髓部偏向一侧。质坚硬。气微，味涩。"}]},{"ID":"20240903092810-em8342v","Type":"NodeParagraph","Properties":{"id":"20240903092810-em8342v","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品横切面：木栓细胞数列，含棕红色物。皮层较窄，散有石细胞群，胞腔内充满棕红色物；薄壁细胞含草酸钙方晶。维管束异型，由韧皮部与木质部相间排列成数轮。韧皮部最外侧为石细胞群与纤维束组成的厚壁细胞层；射线多被挤压；分泌细胞甚多，充满棕红色物，常数个至10多个切向排列成层；纤维束较多，非木化至微木化，周围细胞含草酸钙方晶，形成晶纤维，含晶细胞壁木化增厚；石细胞群散在。木质部射线有的含棕红色物；导管多单个散在，类圆形，直径约至400μm；木纤维束亦均形成晶纤维；木薄壁细胞少数含棕红色物。"}]},{"ID":"20240903092810-vfx4ls7","Type":"NodeParagraph","Properties":{"id":"20240903092810-vfx4ls7","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切碎，晒干。"}]},{"ID":"20240903092810-9x40om2","Type":"NodeParagraph","Properties":{"id":"20240903092810-9x40om2","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性味】苦、甘，温。"}]},{"ID":"20240903092810-yyobvox","Type":"NodeParagraph","Properties":{"id":"20240903092810-yyobvox","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾经。"}]},{"ID":"20240903092810-cp1wki7","Type":"NodeParagraph","Properties":{"id":"20240903092810-cp1wki7","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【功能主治】补血，活血，通络。用于月经不调，血虚萎黄，麻木瘫痪，风湿痹痛。"}]},{"ID":"20240903092810-p69iz6y","Type":"NodeParagraph","Properties":{"id":"20240903092810-p69iz6y","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240903092810-xvbp8mq","Type":"NodeParagraph","Properties":{"id":"20240903092810-xvbp8mq","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防霉，防蛀。"}]},{"ID":"20240903092810-vquqn2i","Type":"NodeParagraph","Properties":{"id":"20240903092810-vquqn2i","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240903092810-28ujo41","Type":"NodeParagraph","Properties":{"id":"20240903092810-28ujo41","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"（1）同名品种甚多，常见的有：崖豆藤属植物香花崖豆藤（丰城鸡血藤、贯肠血藤、山鸡血藤）MillettiadielsianaHarmsexDiels.；崖豆藤属植物网络鸡血藤MillettiareticulataBenth.南方个别地区以此作鸡血藤；光叶崖豆藤MillettianitidaBent.两广地区以根作鸡血藤入药；油麻藤属植物常绿油麻藤MucunasempervirensHemsl.福建以此为鸡血藤；白花油麻藤MucunabirdwoodianaTutch.其藤广州称血风藤，有混作鸡血藤用者；大血藤科大血藤属植物大血藤Sargentodoxacuneata（Oliv.）Rehd.etWils.北京地区作鸡血藤。"}]},{"ID":"20240903092810-90m511l","Type":"NodeParagraph","Properties":{"id":"20240903092810-90m511l","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"（2）云南鸡血藤膏非前述豆科鸡血藤原植物的藤茎熬制而成，主要由木兰科南五味子属植物内南五味子KadsurainteriorA.C.Smith和异型南五味子K.heterolita（Roxb.）Craib的藤茎切片熬膏而得。商品常称“凤庆（旧称顺宁）鸡血藤膏”，此膏并非单膏，往往还要加入土牛膝、红花、黑豆、糯米及饴糖等共同配制而成。另有所谓“禄劝鸡血藤膏”者，则系豆科铁藤（巴豆藤）CraspedolobiumschochiiHarms的藤茎熬制而得，常为单膏。由于药材来源不一，因此，其疗效也不一致。"}]},{"ID":"20240903092810-ai7c2yc","Type":"NodeParagraph","Properties":{"id":"20240903092810-ai7c2yc","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903092810-58a3mk6","Type":"NodeParagraph","Properties":{"id":"20240903092810-58a3mk6","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"鸡血藤《*辞典》"}]},{"ID":"20240903092810-4gwarnh","Type":"NodeParagraph","Properties":{"id":"20240903092810-4gwarnh","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目拾遗》"}]},{"ID":"20240903092810-i5rct6z","Type":"NodeParagraph","Properties":{"id":"20240903092810-i5rct6z","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīXuèTénɡ"}]},{"ID":"20240903092810-3amdrpk","Type":"NodeParagraph","Properties":{"id":"20240903092810-3amdrpk","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【别名】血风藤（《中药志》）"}]},{"ID":"20240903092810-rhxq3li","Type":"NodeParagraph","Properties":{"id":"20240903092810-rhxq3li","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【来源】为豆科植物密花豆、白花油麻藤、香花岩豆藤或亮叶岩豆藤等的藤茎。全年可采，或9～10月采收，截成长约40厘米的段，晒干。"}]},{"ID":"20240903092810-9fua7fb","Type":"NodeParagraph","Properties":{"id":"20240903092810-9fua7fb","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903092810-j5mzxe6","Type":"NodeParagraph","Properties":{"id":"20240903092810-j5mzxe6","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①密花豆，又名：三叶鸡血藤。"}]},{"ID":"20240903092810-5s8efgb","Type":"NodeParagraph","Properties":{"id":"20240903092810-5s8efgb","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"攀援灌木。茎无毛。小叶3，阔椭圆形，长12～20厘米，宽7～15厘米，先端锐尖，基部圆形或近心形，上面疏被短硬毛，下面沿脉疏被短硬毛，脉腋间有髯毛。花多数，排列成大型圆锥花序；花长约10毫米；萼筒状，两面被白色短硬毛，萼齿5，三角形，上面2齿近合生；花冠蝶形，白色；花药2型，5个大，5个稍小；子房密被白色短硬毛。荚果刀状，长8～10.5厘米，宽2.5～3厘米，被绒毛，有网脉，沿腹缝线增厚，仅顶部有一个种子。"}]},{"ID":"20240903092810-d6waylr","Type":"NodeParagraph","Properties":{"id":"20240903092810-d6waylr","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"生于林中或灌丛中。分布广东、广西、云南等地。"}]},{"ID":"20240903092810-phombfb","Type":"NodeParagraph","Properties":{"id":"20240903092810-phombfb","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②白花油麻藤"}]},{"ID":"20240903092810-g4iw1h0","Type":"NodeParagraph","Properties":{"id":"20240903092810-g4iw1h0","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"藤本。叶为羽状复叶。窄小叶3片，革质，长圆状椭圆形至卵状椭圆形，长8～16厘米，宽2.5～7.5厘米，先端渐尖，基部广楔形，两面均无毛或疏被毛。侧生小叶较小，基部斜形；叶柄无毛，小叶柄有疏长硬毛；托叶卵形，早落。总状花序腋生，长30～38厘米；具花20～30朵；萼钟状，萼齿5，上面2齿合生，有稀疏棕色长硬毛；花冠蝶形。灰白色，长7.5～8.5厘米，旗瓣卵状广椭圆形，长约为龙骨瓣的1／2；雄蕊为9+1的两组，花药2型；子房密生锈色短柔毛，花柱丝状。荚果木质，长矩形，长22～40厘米，宽约3厘米左右，外被棕色短柔毛，两侧有狭翅，种子间有紧缩；种子10余枚，肾形，黑色。花、果期4～9月。"}]},{"ID":"20240903092810-147vp37","Type":"NodeParagraph","Properties":{"id":"20240903092810-147vp37","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"分布广东、广西等地。"}]},{"ID":"20240903092810-2ag6tmo","Type":"NodeParagraph","Properties":{"id":"20240903092810-2ag6tmo","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"③香花岩豆藤，又名：山鸡血藤、贯肠血藤、苦藤、猪婆藤、大活血、过山龙、野奶豆。"}]},{"ID":"20240903092810-ab4lwba","Type":"NodeParagraph","Properties":{"id":"20240903092810-ab4lwba","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"攀援灌木。幼枝和花序被金黄色绒毛。羽状复叶互生，小叶5，狭椭圆形，或披针形，长5～15厘米，宽2.5～5厘米，先端钝尖，基部圆楔形，下面疏生短毛或无毛；小托叶锥形。圆锥花序顶生，长达15厘米。萼钟形，密生锈色毛；花蝶形，紫色，长1.2～2厘米；旗瓣椭圆形，基部有短爪，外面白色，密被锈色丝状毛；雄蕊成9+1的两组；雌蕊的子房密被长绒毛。荚果条形，长7～12厘米，宽约2厘米，近木质，密被黄褐色绒毛。种子扁长圆形。花期夏季。果期秋季。"}]},{"ID":"20240903092810-mr4ys2i","Type":"NodeParagraph","Properties":{"id":"20240903092810-mr4ys2i","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"生于山坡灌丛中。分布于浙江、江西、福建、广东、广西、湖南、湖北、四川、云南、贵州等地。"}]},{"ID":"20240903092810-4c4io9h","Type":"NodeParagraph","Properties":{"id":"20240903092810-4c4io9h","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"本植物的根（岩豆根）亦供药用，另详专条。"}]},{"ID":"20240903092810-ljqszkm","Type":"NodeParagraph","Properties":{"id":"20240903092810-ljqszkm","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"④亮叶岩豆藤，又名：血节藤、血藤、血筋藤。"}]},{"ID":"20240903092810-r6dhsad","Type":"NodeParagraph","Properties":{"id":"20240903092810-r6dhsad","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"攀援灌木。形态与上种相似，幼枝有平贴丝状细毛，后变光滑。小叶披针形或卵形，长5～8厘米，两面光亮。圆锥花序顶生，长6～10厘米；花长约2厘米；萼钟状，密生绢毛；花冠紫色，旗瓣外面白色，有绢毛，基部有2个胼胝体状附属物。荚果条状矩圆形，长10～14厘米，有绒毛；种子4～5粒."}]},{"ID":"20240903092810-cedqkkx","Type":"NodeParagraph","Properties":{"id":"20240903092810-cedqkkx","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"生溪边、山谷疏林下。分布广东、广西。"}]},{"ID":"20240903092810-0va8bdb","Type":"NodeParagraph","Properties":{"id":"20240903092810-0va8bdb","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903092810-2srwoh4","Type":"NodeParagraph","Properties":{"id":"20240903092810-2srwoh4","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①密花豆的藤茎呈扁圆柱形，稍弯曲，直径2～7厘米。表面灰棕色，栓皮脱落处呈红褐色，有明显的纵沟及小形点状皮孔。横切面可见小形的髓，偏向一侧，木质部淡红色，导管呈孔洞状不规则排列，韧皮部有树脂状分泌物呈红褐色或黑棕色。二者相间排列呈偏心性半圆形的环。质坚实，难折断，折断面呈不整齐的裂片状。气微，味涩。"}]},{"ID":"20240903092810-zc82ph9","Type":"NodeParagraph","Properties":{"id":"20240903092810-zc82ph9","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"产于广西。"}]},{"ID":"20240903092810-ed2f2lm","Type":"NodeParagraph","Properties":{"id":"20240903092810-ed2f2lm","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②白花袖麻藤的干燥藤茎，呈扁圆柱形，稍弯曲，长约40厘米，长径约4.5厘米，短径约3厘米。表面灰棕色，栓皮剥落处现红棕色，有明显纵沟及横向皮孔，节处微突起，有时具分枝痕。横切面中央有偏心性的小髓（中心性者极罕见），木质部淡红棕色，韧皮部呈赤褐色至棕黑色的圆环，韧皮部外方为木质部与韧皮部相间排列的同心半圆环。新鲜时亦褐色的环状部位有鲜红色液汁流出，形如鸡血。液汁干后凝成亮黑色胶丝状斑点。质坚，折断时片裂状。气微，味涩。以条匀、切面有赤褐色层圃、并有渗出物者为佳。"}]},{"ID":"20240903092810-3htvoiv","Type":"NodeParagraph","Properties":{"id":"20240903092810-3htvoiv","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"主产于广西。"}]},{"ID":"20240903092810-01msfxh","Type":"NodeParagraph","Properties":{"id":"20240903092810-01msfxh","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"③香花岩豆藤的干燥藤茎，又名：丰城鸡血藤。呈圆柱形，表面灰褐色，有纵纹。横断面皮部占半径的1／4，密布红棕色胶状斑点，向外渐疏，木质部黄色，导管呈细孔状。质坚实。气微、味微苦涩。以外皮灰褐、内色淡黄、五层圈者为佳。"}]},{"ID":"20240903092810-oi0ck2l","Type":"NodeParagraph","Properties":{"id":"20240903092810-oi0ck2l","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"产江西、福建、云南、四川等地。"}]},{"ID":"20240903092810-4qitu8g","Type":"NodeParagraph","Properties":{"id":"20240903092810-4qitu8g","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"④亮叶岩豆藤的干燥藤茎与上种相似。"}]},{"ID":"20240903092810-pf72ric","Type":"NodeParagraph","Properties":{"id":"20240903092810-pf72ric","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"产广西。"}]},{"ID":"20240903092810-gizbvlh","Type":"NodeParagraph","Properties":{"id":"20240903092810-gizbvlh","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"鸡血藤药材除上述，品种外，尚有下列几种："}]},{"ID":"20240903092810-nhw9axj","Type":"NodeParagraph","Properties":{"id":"20240903092810-nhw9axj","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①木通科植物大血藤的藤茎，产于河南、福建、广东，使用地区较广。参见\"大血藤\"条。"}]},{"ID":"20240903092810-lxeehjt","Type":"NodeParagraph","Properties":{"id":"20240903092810-lxeehjt","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②豆科植物常绿油麻藤的藤茎。其药材呈圆柱形，直径3～15厘米.表面灰褐色，粗糙，具有纵向的陷沟、横环纹和疣状凸起的皮孔，尚可见瘤状凸起的侧枝痕迹。横切面皮部薄，韧皮部具树脂状分泌物呈棕褐色，本质部灰黄色，导管呈孔洞状，多放射性整齐排列。韧皮部与木质部相间排列呈数层同心性环，髓部细小，射线致密呈放射状。质坚体重，难折断，折断面呈纤维性。气微弱，味涩而微甜。产福建。参见\"牛马藤\"条。"}]},{"ID":"20240903092810-9ncq9fq","Type":"NodeParagraph","Properties":{"id":"20240903092810-9ncq9fq","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"③豆科植物昆明鸡血藤的藤茎，产广东、广西、甘肃等地。参见\"昆明鸡血藤\"条。"}]},{"ID":"20240903092810-g98kqr1","Type":"NodeParagraph","Properties":{"id":"20240903092810-g98kqr1","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【化学成份】香花岩豆藤含鸡血藤醇。"}]},{"ID":"20240903092810-ucy36mj","Type":"NodeParagraph","Properties":{"id":"20240903092810-ucy36mj","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903092810-asg4jb2","Type":"NodeParagraph","Properties":{"id":"20240903092810-asg4jb2","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①丰城鸡血藤酊剂给大鼠灌胃（40％，0.5毫升／100克）对甲醛性\"关节炎\"有显着疗效.煎剂或酊剂静脉注射，相当生药0.01～0.4克／公斤时，对麻醉犬的呼吸、血压及蟾蜍下肢血管灌流无显着影响。大鼠腹腔注射酊剂（10毫升／公斤）有镇静、催眠作用。犬静脉注射相当生药4.25克／公斤时中毒死亡，用给小鼠注射p32后，测组织的总p32的\"相对比放射性\"的方法，观察到鸡血藤（品种未载明）煎剂（0.25克／毫升，每日1次，0.5毫升灌胃，共3天），可促进肾脏及子宫的总磷代谢，认为这是鸡血藤增强小鼠肾脏及子宫的能量代谢及合成代谢的反映。此外还能促进小鼠对水及氯化物的排泄。"}]},{"ID":"20240903092810-7jt35ie","Type":"NodeParagraph","Properties":{"id":"20240903092810-7jt35ie","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②密花豆干燥根的煎剂对离体、在体蟾蜍心脏有抑制作用，可使麻醉兔及犬的血压下降；对离体兔耳及蟾蜍血管却为收缩作用。"}]},{"ID":"20240903092810-ykgf30k","Type":"NodeParagraph","Properties":{"id":"20240903092810-ykgf30k","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【炮制】用水润透，切片，或蒸软后乘热切片，晒干。"}]},{"ID":"20240903092810-hs5s0lv","Type":"NodeParagraph","Properties":{"id":"20240903092810-hs5s0lv","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903092810-gs7wgea","Type":"NodeParagraph","Properties":{"id":"20240903092810-gs7wgea","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"苦甘，温。"}]},{"ID":"20240903092810-w9svp0w","Type":"NodeParagraph","Properties":{"id":"20240903092810-w9svp0w","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①《饮片新参》：\"苦涩香微甘。\""}]},{"ID":"20240903092810-53ebyza","Type":"NodeParagraph","Properties":{"id":"20240903092810-53ebyza","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②《本草正义》：\"温。\""}]},{"ID":"20240903092810-k937nmr","Type":"NodeParagraph","Properties":{"id":"20240903092810-k937nmr","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"③江西《中草药学》：\"苦温微甘。\""}]},{"ID":"20240903092810-sm76ac5","Type":"NodeParagraph","Properties":{"id":"20240903092810-sm76ac5","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【归经】《本草再新》：\"入心、脾二经。\""}]},{"ID":"20240903092810-su5nwq9","Type":"NodeParagraph","Properties":{"id":"20240903092810-su5nwq9","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903092810-0f0jjvu","Type":"NodeParagraph","Properties":{"id":"20240903092810-0f0jjvu","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"活血、舒筋。治腰膝酸痛，麻木瘫痪，月经不调。"}]},{"ID":"20240903092810-ii17rg1","Type":"NodeParagraph","Properties":{"id":"20240903092810-ii17rg1","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"①《纲目拾遗》：\"活血，暖腰膝，已风瘫。\""}]},{"ID":"20240903092810-xzqtvu4","Type":"NodeParagraph","Properties":{"id":"20240903092810-xzqtvu4","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"补中燥胃。\""}]},{"ID":"20240903092810-z705kp8","Type":"NodeParagraph","Properties":{"id":"20240903092810-z705kp8","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"③《饮片新参》：\"去瘀血，生新血，流利经脉。治暑痧，风血痹症。\""}]},{"ID":"20240903092810-redclqz","Type":"NodeParagraph","Properties":{"id":"20240903092810-redclqz","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"④《现代实用中药》：\"为强壮性之补血药，适用于贫血性之神经麻痹症，如肢体及腰膝酸痛，麻木不仁等。又用于妇女月经不调，月经闭止等，有活血镇痛之效。\""}]},{"ID":"20240903092810-gx5f003","Type":"NodeParagraph","Properties":{"id":"20240903092810-gx5f003","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱（大剂1两）；或浸酒。"}]},{"ID":"20240903092810-ay6rq2k","Type":"NodeParagraph","Properties":{"id":"20240903092810-ay6rq2k","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【附方】治放射线引起的白血病：鸡血藤一两。长期煎服。（江西《中草药学》）"}]},{"ID":"20240903092810-l6wi4q7","Type":"NodeParagraph","Properties":{"id":"20240903092810-l6wi4q7","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗闭经：鸡血藤糖浆10～30毫升，日服3次，疗程1～4周。治疗190例，近期有效65例。一般于服药后7～20天通经。"}]},{"ID":"20240903092810-h09vrda","Type":"NodeParagraph","Properties":{"id":"20240903092810-h09vrda","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903092810-ka7yjvw","Type":"NodeParagraph","Properties":{"id":"20240903092810-ka7yjvw","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"鸡血藤《中华本草》"}]},{"ID":"20240903092810-s86bgwf","Type":"NodeParagraph","Properties":{"id":"20240903092810-s86bgwf","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目拾遗》。"}]},{"ID":"20240903092810-v0g3joc","Type":"NodeParagraph","Properties":{"id":"20240903092810-v0g3joc","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīXuèTénɡ"}]},{"ID":"20240903092810-e4fb6ti","Type":"NodeParagraph","Properties":{"id":"20240903092810-e4fb6ti","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【英文名】SuberectSpatholobusStem,StemofSuberectSpatholobus"}]},{"ID":"20240903092810-zfvejva","Type":"NodeParagraph","Properties":{"id":"20240903092810-zfvejva","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【别名】血风藤、马鹿藤、紫梗藤、猪血藤、九层风、红藤、活血藤、大血藤、血龙藤、过岗龙、五层血。"}]},{"ID":"20240903092810-sqjrv6p","Type":"NodeParagraph","Properties":{"id":"20240903092810-sqjrv6p","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903092810-mr6j2r9","Type":"NodeParagraph","Properties":{"id":"20240903092810-mr6j2r9","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物密花豆的藤茎。"}]},{"ID":"20240903092810-1cqhmw2","Type":"NodeParagraph","Properties":{"id":"20240903092810-1cqhmw2","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SpatholobussuberectusDunn[Buteasuberecta（Dunn）Blatter]"}]},{"ID":"20240903092810-b91jgh8","Type":"NodeParagraph","Properties":{"id":"20240903092810-b91jgh8","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收茎藤，除去枝叶，锯成段，晒干。或鲜时切片，晒干。"}]},{"ID":"20240903092810-ihsrwxp","Type":"NodeParagraph","Properties":{"id":"20240903092810-ihsrwxp","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【原形态】密花豆本质藤本，长达数十米。老茎砍断时可见数圈偏心环，鸡血状汁液从环处渗出。三出复叶互生；顶生小叶阔椭圆形，长12-20cm，宽7-15cm，先锐尖，基部圆形或近心形，上面疏被短硬毛，背面脉间具黄色短髯毛，侧生小叶基部偏斜，小叶柄长约6mm；小托叶针状。圆锥花序腋生，大型，花多而密，花序轴、花梗被黄色柔毛；花长约10mm；花萼肉质筒状，5齿，上面2齿合生，两面具黄色柔毛；花冠白色，肉质，旗瓣近圆形，具爪，翼瓣与龙骨瓣均长约7mm，具爪及耳；雄蕊10，2组，花药5大5小；子房具白色硬毛。荚果舌形，长8-10cm，有黄色柔毛；种子1颗，生荚果先端。花期6-7月，果期8-12月。0"}]},{"ID":"20240903092810-h5zbgom","Type":"NodeParagraph","Properties":{"id":"20240903092810-h5zbgom","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903092810-njjlhjp","Type":"NodeParagraph","Properties":{"id":"20240903092810-njjlhjp","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山谷林间、溪边及灌丛中。"}]},{"ID":"20240903092810-zhx4bsv","Type":"NodeParagraph","Properties":{"id":"20240903092810-zhx4bsv","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、广东、广西、云南。"}]},{"ID":"20240903092810-nr6nnhf","Type":"NodeParagraph","Properties":{"id":"20240903092810-nr6nnhf","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903092810-hy4j669","Type":"NodeParagraph","Properties":{"id":"20240903092810-hy4j669","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"性状鉴别茎藤呈扁圆柱形，稍弯曲，直径2-7cm。表面灰棕色，有时可见灰白色斑，栓皮脱落处显红棕色，有明显的纵沟及小形点状皮孔。质坚硬，难折断，折断面呈不整齐的裂片状。血藤片为椭圆形、长矩圆形或不规则的斜切片，厚3-10mm。切面木部红棕色或棕色，导管孔多数，不规则排列，皮部有树脂状分泌物，呈红棕色至黑棕色，并与木部相间排列成3-10个偏心性半圆形或圆形环。髓小，偏于一侧。气微，昧涩。以树脂状分泌物多者为佳。"}]},{"ID":"20240903092810-ngqq7ut","Type":"NodeParagraph","Properties":{"id":"20240903092810-ngqq7ut","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎藤横切面：木栓细胞数列至数十列，微木化至木化，有的含棕色物。栓内层为2-4列细胞，内含棕色物。皮层窄，细胞10余列，含黄棕色物；石细胞众多，成群散在，层纹、孔沟明显，胞腔内充满红棕色物，少数含草酸钙方晶，其周围有的薄壁细胞含草酸钙方晶，含晶细胞壁木化增厚；分泌细胞少数，散在。维管束异型，由韧皮部与木质部相间排列成数个偏心性环。每轮韧皮部最外侧为石细胞与纤维组成的厚壁组织环带，环带内外两侧细胞有时含草酸钙方晶；韧皮部分泌细胞常数个至10多个切向排列成层，含黄棕色、红棕色或金黄色分泌物；纤维束众多，散在，其周围细胞含草酸钙方晶形成晶纤维；石细胞少数，散在；射线宽l-4列细胞，弯曲，多被挤压。形成层明显。木质部导管多单个或2个并列散在，直径约400μm，有的内壁附有棕色块状物，多呈新月形；木薄壁细胞多围绕导管，壁稍厚，多含棕色物，其间散布分泌细胞；木纤维亦均形成晶纤维，几呈层状排列；木质部射线细胞纹孔明显，有的含棕色物。髓小，偏心，环髓分泌细胞多数。"}]},{"ID":"20240903092810-jxp7jma","Type":"NodeParagraph","Properties":{"id":"20240903092810-jxp7jma","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"粉末特征：棕红色。①石细胞多成群，呈长方形、类圆形、三角形或方形，直径10-80μm，有的胞腔内含红棕色色素；少数含草酸钙棱晶。②纤维成束，纹孔及胞腔不明显，纤维束周围的细胞束含草酸钙棱晶，形成晶鞘纤维。③内含红棕色树脂状色素的分泌细胞众多，排列成条状或不规则块状。④导管碎片主要为具缘纹孔。⑤木栓细胞表面观多角形，壁有长圆状纹孔。⑥木薄壁细胞纹孔细密。"}]},{"ID":"20240903092810-do8j47m","Type":"NodeParagraph","Properties":{"id":"20240903092810-do8j47m","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240903092810-o0d0g2r","Type":"NodeParagraph","Properties":{"id":"20240903092810-o0d0g2r","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"藤茎含表无羁萜醇（friedelan-3β-ol），胡萝卜甙（daucosterol），β-谷甾醇（β-sitosterol），7-酮基-β-谷甾醇（7-oxo-β-sitosterol），刺芒柄花素（formonone-tin），芒柄花甙（ononin），樱黄素（prunetin），阿佛洛莫生（afrormosin），大豆素（daidzein），3，7-二羟基-6-甲氧基二氢黄酮醇（3，7-dihydroxy-6-methoxy-dihy－droflavonol），表儿茶精（epicatechin），异甘草甙元（isoliquiritigenin）3，4，2’，4’-四羟基查耳酮（3，4，2’，4’-tetrahydroxychalcone），甘草查耳酮（licochalcone）A，苜猪酚（medicagol），原儿茶酸（protocatechuicacid），9-甲氧基香豆雌酚（9-methoxycoumestrol），木豆异黄酮（cajanin）。"}]},{"ID":"20240903092810-a2vkcbk","Type":"NodeParagraph","Properties":{"id":"20240903092810-a2vkcbk","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"根中含5-豆甾烯-3β，7a-二醇（stigmast-5-ene-3β，7a-diol），5a-豆甾烷-3β6a-二醇（5a-stigmastane-3β，6a-diol）。"}]},{"ID":"20240903092810-lkcq1dk","Type":"NodeParagraph","Properties":{"id":"20240903092810-lkcq1dk","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903092810-nl0p9t4","Type":"NodeParagraph","Properties":{"id":"20240903092810-nl0p9t4","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"1.对造血系统的作用：据何淑玛等报道，密花豆藤煎剂（100%）对实验性家兔贫血有补血作用，能使血细胞增加，血红蛋白升高。较香花崖豆藤作用强。1989年张淑芳等报道鸡血藤煎剂（2g／kg）对失血性贫血家兔末梢细胞、血色素及网织红细胞的恢复无明显影响：实验用家免7窝，其中5窝每窝4只，余2窝各2只，共24只。雌性13只，雄性11只，体重1.42-2.58kg。同一窝4只家兔，按随机分配成丹参、当归、鸡血藤及对照组，每组5只。另有4只仅观察其正常值。实验时于每晨8时半（第一次喂食后）由耳静脉取血测定血色素，红细胞计数，网织红细胞计数，俟三项指标数值恒定后，再连续测定3天，作为该兔之正常值。从第4天起，每天晨8时半从兔耳尖处剪的V形口放血。每天1次，连续3天，每次放血相当于当日体重的1%，总放出量相当于总血量50%。放血后即以5%葡萄糖液灌胃以补充损失的体液，用量为体重的1%。从放血完毕后1天始，各组分别灌胃以20%丹参、当归、鸡血藤煎剂，按每lkg体重2g剂量给予，另一只按每lkg体重给予10ml生理盐水以资对照，每天1次，连续10天，于放血后1天至13天及l6、18、21天，每天上午8时半由耳静脉取血检查血象。以放血前红细胞数及血色素值为100%，各组家兔放血后平均恢复至95%时之天数分别见表1、表2；以放血前网织红细胞正常值为100%，则放血后网织红细胞出现高峰时间与其21天后之水平见表3。以上结果表明，鸡血藤对失血性贫血家兔耳缘静脉中红细胞，血色素及网织红细胞的恢复无明显影响。"}]},{"ID":"20240903092810-9wqzmkd","Type":"NodeParagraph","Properties":{"id":"20240903092810-9wqzmkd","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"2.对凝血、纤溶的作用：对犬血体外凝血和纤溶过程的影响实验用犬，麻醉后暴露股动脉，采血（取血后即将试管放冰中），抗凝剂（草酸钠、枸橼酸钠）1份加全血9份，离心分离血浆，将血浆分装成3份，分别加入生理盐水、丹参注射液、鸡血藤注射液0.03ml。测定复钙时间（反映内在凝血过程）、凝血酶原时间、凝血酶凝固时间、血浆纤维蛋白原定量及伏球蛋白溶解试验。可见鸡血藤（每1ml含生药3mg）对离体犬血的凝血和纤溶过程没有明显影响。"}]},{"ID":"20240903092810-g2fkm7h","Type":"NodeParagraph","Properties":{"id":"20240903092810-g2fkm7h","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"3.抑制心脏和降低血压作用：50%鸡血藤煎剂对蟾蜍离体和在体心脏微呈抑制作用。给麻醉家免0.43-0.5g生药／kg煎剂和犬0.3g生药／kg煎剂均可引起血压下降；但对离体免耳及蟾蜍血管却呈收缩作用。"}]},{"ID":"20240903092810-42ivtdx","Type":"NodeParagraph","Properties":{"id":"20240903092810-42ivtdx","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"4.抗癌作用：体外试验剂量500毫微克（热水提取物）/ml，对JTC-26抑制率为94、4%；噬菌体法筛选抗肿瘤药物，本品有抗噬菌体作用。"}]},{"ID":"20240903092810-7z7nhok","Type":"NodeParagraph","Properties":{"id":"20240903092810-7z7nhok","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"5.对脂质代谢的调节：日本鹌鹑以鸡血藤煎剂6g/kg灌胃14天及47天，可升高HDL2-C，降低HDL3-C，使HDL2-C／HDL3-C的比值升高，此比值是评价脂质代谢和动脉硬化的重要指标（冠心病患者HDL2-C／HDL3-C的比值较无冠心病者为低）。对主动脉及头臂动脉病变，鸡血藤有抑制作用。"}]},{"ID":"20240903092810-j5g62i6","Type":"NodeParagraph","Properties":{"id":"20240903092810-j5g62i6","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别薄层色谱：取本品细粉2g，用乙醇回流提取，提取液减压浓缩至浸膏状，加入浸膏重3倍量的硅胶（青岛海洋化工厂，60目）拌匀后室温晾干（或烤干），装入短柱中用氯仿洗脱至洗脱液几乎无色，后改用氯仿一甲醇（8：2）洗脱。两种洗脱液分别浓缩至干，供点样用。以芒柄花素和原儿茶酸为对照品。同点子硅胶G高效薄层预制板上，以氯仿一甲醇（9：1）为展开剂。展距10cm。在紫外光灯（254nm）下观察。洗脱液的斑点与芒柄花素和原儿茶酸的位置相应者显暗紫色荧光斑点。"}]},{"ID":"20240903092810-bbuwli4","Type":"NodeParagraph","Properties":{"id":"20240903092810-bbuwli4","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【炮制】用水润透，切片，或蒸软后乘热切片，晒干。"}]},{"ID":"20240903092810-7bd2yz7","Type":"NodeParagraph","Properties":{"id":"20240903092810-7bd2yz7","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；微甘；性温"}]},{"ID":"20240903092810-uq3fsbp","Type":"NodeParagraph","Properties":{"id":"20240903092810-uq3fsbp","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【归经】心；脾经"}]},{"ID":"20240903092810-kctrsn8","Type":"NodeParagraph","Properties":{"id":"20240903092810-kctrsn8","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血舒筋；养血调经。主手足麻木；肢体瘫痪；风湿痹痛；妇女有经不调；痛经；闭经"}]},{"ID":"20240903092810-irv1zg8","Type":"NodeParagraph","Properties":{"id":"20240903092810-irv1zg8","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-15g，大剂量可用至30g；或浸酒。"}]},{"ID":"20240903092810-pvy1mbc","Type":"NodeParagraph","Properties":{"id":"20240903092810-pvy1mbc","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚火亢者慎用。"}]},{"ID":"20240903092810-cp9t21n","Type":"NodeParagraph","Properties":{"id":"20240903092810-cp9t21n","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903092810-rnpmyll","Type":"NodeParagraph","Properties":{"id":"20240903092810-rnpmyll","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目拾遗》：活血，暖腰膝，已风瘫。"}]},{"ID":"20240903092810-3y2tnof","Type":"NodeParagraph","Properties":{"id":"20240903092810-3y2tnof","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"2.《本草再新》：补中燥胃。"}]},{"ID":"20240903092810-rg64vvl","Type":"NodeParagraph","Properties":{"id":"20240903092810-rg64vvl","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"3.《饮片新参》：去瘀血，生新血，流利经脉。治暑痧，风血痹症。"}]},{"ID":"20240903092810-x9txu8u","Type":"NodeParagraph","Properties":{"id":"20240903092810-x9txu8u","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"4.《现代实用中药》：为强壮性之补血药，适用于贫血性之神经麻痹症，如肢体及腰膝酸痛，麻木不仁等。又用于妇女月经不调，月经闭止等，有活血镇痛之效。"}]},{"ID":"20240903092810-kw2nfsg","Type":"NodeParagraph","Properties":{"id":"20240903092810-kw2nfsg","updated":"20240903092841"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903092811-pb3ox6g","Type":"NodeThematicBreak","Properties":{"id":"20240903092811-pb3ox6g","updated":"20240903092841"}},{"ID":"20240903092813-ssgx0pu","Type":"NodeParagraph","Properties":{"id":"20240903092813-ssgx0pu","updated":"20240903092841"}}]}