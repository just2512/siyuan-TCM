mdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715140032-tjtd5qf","Type":"NodeParagraph","Properties":{"id":"20240715140032-tjtd5qf","updated":"20240715140043"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 839px;","style":"width: 829px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 16-20240715140032-o2c1kkr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 829px;\" parent-style=\"width: 839px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 424px;","style":"width: 414px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 7-20240715135019-nv2leyu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 414px;\" parent-style=\"width: 424px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715134835-a0g274y","Type":"NodeParagraph","Properties":{"id":"20240715134835-a0g274y","updated":"20240715135036"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 420px;","style":"width: 410px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 6-20240715134835-ksk5i1a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 832px;","style":"width: 822px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 2-20240715134511-pqqhrb6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 822px;\" parent-style=\"width: 832px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715134314-kcgym2d","Type":"NodeParagraph","Properties":{"id":"20240715134314-kcgym2d","updated":"20240715134653"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 861px;","style":"width: 851px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 4-20240715134653-wh01zdw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 851px;\" parent-style=\"width: 861px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"棕榈 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/棕榈 3-20240715134558-mpewnl7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715133256-dfnio3r","Type":"NodeParagraph","Properties":{"id":"20240715133256-dfnio3r","updated":"20240715133329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：中药棕榈，为棕榈科植物棕榈的干燥叶柄；"}]},{"ID":"20240715133256-8vx7l94","Type":"NodeThematicBreak","Properties":{"id":"20240715133256-8vx7l94"}},{"ID":"20240902093221-i2ola4f","Type":"NodeParagraph","Properties":{"id":"20240902093221-i2ola4f","updated":"20240902093230"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：棕榈皮"}]},{"ID":"20240902093221-ox0o572","Type":"NodeParagraph","Properties":{"id":"20240902093221-ox0o572","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"棕榈皮《*辞典》"}]},{"ID":"20240902093221-elnwo2n","Type":"NodeParagraph","Properties":{"id":"20240902093221-elnwo2n","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【出处】《日华子本草》"}]},{"ID":"20240902093221-2nm3w7x","Type":"NodeParagraph","Properties":{"id":"20240902093221-2nm3w7x","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZōnɡLǘPí"}]},{"ID":"20240902093221-jlkbo7q","Type":"NodeParagraph","Properties":{"id":"20240902093221-jlkbo7q","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【别名】拼榈木皮（《本草拾遗》），棕毛（《普济方》），棕皮（《本草求原》）。"}]},{"ID":"20240902093221-t2c4gqm","Type":"NodeParagraph","Properties":{"id":"20240902093221-t2c4gqm","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【来源】为棕榈科植物棕榈的叶鞘纤维。全年可采，一般多于9～10月间采收其剥下的纤维状鞘片，除去残皮，晒干。"}]},{"ID":"20240902093221-u3py1ii","Type":"NodeParagraph","Properties":{"id":"20240902093221-u3py1ii","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902093221-ri6ep8l","Type":"NodeParagraph","Properties":{"id":"20240902093221-ri6ep8l","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"棕榈（《本草拾遗》），又名：棕（《山海经》），栟榈（杨孚《异物志》），棕衣树、百页草、定海针。"}]},{"ID":"20240902093221-f2bfm9t","Type":"NodeParagraph","Properties":{"id":"20240902093221-f2bfm9t","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高达15米。杆圆柱形，不分枝。叶簇生于杆顶，圆扇形，革质，长约70厘米，有皱折，开展时掌状，深裂至叶片的中部以上，裂片具主脉，先端2尖裂，两面均光滑无毛；叶柄长可达1米以上，质坚硬，上面子坦，下面凸起呈棱形，或有时两面凸起，两侧边缘具刺，柄基部有抱茎的叶鞘，分裂为棕褐色纤维状毛（即棕衣），叶鞘脱落后，在杆上留下呈环状痕迹的节。肉穗状花序短，自叶丛中抽出，下部有多数大形鞘状苞；花小，多数，淡黄色，单性，雌雄异株；花被6片，卵形，排列成2轮，外轮小于内轮，镊合状；雄蕊6，花药背着生，花丝极短；子房上位，雌蕊3，基部合生，1室，胚珠1。核果球形或近肾形，直径7～9毫米，具短柄，常有宿存的花被片。种子1，扁球形或肾形，暗灰色或淡黑色。花期4～5月。果期11～12月。"}]},{"ID":"20240902093221-1m6gdai","Type":"NodeParagraph","Properties":{"id":"20240902093221-1m6gdai","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"本植物的根（棕树根）、心材（棕树心）、叶（棕榈叶）、花（棕榈花）、果实（棕榈子）等亦供药用，各详专条。"}]},{"ID":"20240902093221-b1f6lmn","Type":"NodeParagraph","Properties":{"id":"20240902093221-b1f6lmn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【生境分布】栽培于村边、溪边、田边、丘陵地或山地。分布河南、安徽、江苏、浙江、福建、台湾、广东、广西、江西、湖南、湖北、贵州、云南、甘肃等地。"}]},{"ID":"20240902093221-xg71v52","Type":"NodeParagraph","Properties":{"id":"20240902093221-xg71v52","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902093221-vqadzmk","Type":"NodeParagraph","Properties":{"id":"20240902093221-vqadzmk","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"棕榈皮的陈久者，名\"陈棕皮\"。商品中有用叶柄部分或废棕绳。将叶柄削去外面纤维，晒干，名为\"棕骨\"；废棕绳多取自破旧的棕床，名为\"陈棕\"。"}]},{"ID":"20240902093221-r9vi67k","Type":"NodeParagraph","Properties":{"id":"20240902093221-r9vi67k","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"①陈棕皮"}]},{"ID":"20240902093221-f72j0j1","Type":"NodeParagraph","Properties":{"id":"20240902093221-f72j0j1","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"为粗长的纤维，成束状或片状，长20～40厘米，大小不等。色棕褐，质韧，不易撕断。气无，味淡。以无粗皮、杂质及陈久者为佳。"}]},{"ID":"20240902093221-93jtu1g","Type":"NodeParagraph","Properties":{"id":"20240902093221-93jtu1g","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②棕骨"}]},{"ID":"20240902093221-bjxgv1q","Type":"NodeParagraph","Properties":{"id":"20240902093221-bjxgv1q","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"又名：棕板。呈长条形，长短不一，红棕色，基部较宽而扁平，或略向内弯曲，向上则渐窄而厚，背面中央隆起，成三角形，背面两侧平坦，上有厚密的红棕色毛茸，腹面平坦，或略向内凹，有左右交叉的纹理。撕去表皮后，可见坚韧的纤维。质坚韧，不能折断。气无，味淡。以红棕色、片大、质厚、陈久者为佳。"}]},{"ID":"20240902093221-b9noozn","Type":"NodeParagraph","Properties":{"id":"20240902093221-b9noozn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"③陈棕"}]},{"ID":"20240902093221-71swr2b","Type":"NodeParagraph","Properties":{"id":"20240902093221-71swr2b","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"呈破碎的网状。色深棕，粗糙。质坚韧，不易断。气微，味淡。以深黑色、无杂质者为佳。"}]},{"ID":"20240902093221-hmjyfd1","Type":"NodeParagraph","Properties":{"id":"20240902093221-hmjyfd1","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"产于江西、江苏、安徽、浙江、福建、台湾、广东、广西、湖南、湖北、四川、贵州、云南等地。华南、西南地区多用陈棕皮；华北、东北、西北等地区多用棕骨；华东地区则多用陈棕。"}]},{"ID":"20240902093221-ysyt7ii","Type":"NodeParagraph","Properties":{"id":"20240902093221-ysyt7ii","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【化学成份】棕毛及叶、花均富含鞣质。"}]},{"ID":"20240902093221-z3bmkc7","Type":"NodeParagraph","Properties":{"id":"20240902093221-z3bmkc7","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【炮制】棕榈炭：取净棕榈皮，置锅内，覆盖一口径稍小的锅，锅上粘贴白纸一张，于两锅接合处用黄泥严封，微火煅至白纸呈焦黄色停火，侯冷取出。"}]},{"ID":"20240902093221-wmsquwu","Type":"NodeParagraph","Properties":{"id":"20240902093221-wmsquwu","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902093221-67fuzdc","Type":"NodeParagraph","Properties":{"id":"20240902093221-67fuzdc","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"苦涩，平。"}]},{"ID":"20240902093221-92r43da","Type":"NodeParagraph","Properties":{"id":"20240902093221-92r43da","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"味苦涩，平，无毒。\""}]},{"ID":"20240902093221-zx4nu4v","Type":"NodeParagraph","Properties":{"id":"20240902093221-zx4nu4v","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"平温。\""}]},{"ID":"20240902093221-q1re7to","Type":"NodeParagraph","Properties":{"id":"20240902093221-q1re7to","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【归经】《要药分剂》：\"入肝、脾二经。\""}]},{"ID":"20240902093221-uedexfd","Type":"NodeParagraph","Properties":{"id":"20240902093221-uedexfd","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902093221-p2xnsf9","Type":"NodeParagraph","Properties":{"id":"20240902093221-p2xnsf9","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"收涩止血。治吐血，衄血，便血，血淋，尿血，下痢，血崩，带下，金疮，疥癣。"}]},{"ID":"20240902093221-yfajnum","Type":"NodeParagraph","Properties":{"id":"20240902093221-yfajnum","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"①《本革拾遗》：\"烧作灰，主破血止血。\""}]},{"ID":"20240902093221-r5iw4ta","Type":"NodeParagraph","Properties":{"id":"20240902093221-r5iw4ta","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"主金疮疥癣，生肌止血，并宜烧灰使用。\""}]},{"ID":"20240902093221-uaundge","Type":"NodeParagraph","Properties":{"id":"20240902093221-uaundge","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"止鼻洪、吐血，破症，治崩中、带下、肠风、赤白痢。入药烧灰用，不可绝过。\""}]},{"ID":"20240902093221-c1w4o5o","Type":"NodeParagraph","Properties":{"id":"20240902093221-c1w4o5o","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"④《本草衍义》：\"烧为黑灰，止妇人血露及吐血，仍佐之他药。\""}]},{"ID":"20240902093221-fynryi1","Type":"NodeParagraph","Properties":{"id":"20240902093221-fynryi1","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；研末，1～2钱。外用：研末撒。"}]},{"ID":"20240902093221-33furyp","Type":"NodeParagraph","Properties":{"id":"20240902093221-33furyp","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：\"暴得吐血，瘀滞方动；暴得崩中，恶霉未竭；湿热下痢初发；肠风带下方炽，悉不宜遽用。即用亦无效。\""}]},{"ID":"20240902093221-n7bgbsg","Type":"NodeParagraph","Properties":{"id":"20240902093221-n7bgbsg","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902093221-gopyjek","Type":"NodeParagraph","Properties":{"id":"20240902093221-gopyjek","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"①治鼻血不止：棕榈灰，随左右吹之。（《简易方论》）"}]},{"ID":"20240902093221-fe6yxyh","Type":"NodeParagraph","Properties":{"id":"20240902093221-fe6yxyh","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②治久鼻衄不止：棕榈、刺蓟、桦皮，龙骨等分。为细末，每服二钱，米饮调下。（《鸡峰普济方》棕榈散）"}]},{"ID":"20240902093221-s9x3uj9","Type":"NodeParagraph","Properties":{"id":"20240902093221-s9x3uj9","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"③治妇人崩中，下血数升，气欲绝：棕桐三两（烧灰），紫参一两，麝香一钱（细研），伏龙肝二两（细研）。上药捣细罗为散，入麝香研令匀，不计时候，以热酒调二钱。（《圣惠方》棕榈散）"}]},{"ID":"20240902093221-9pvhgrb","Type":"NodeParagraph","Properties":{"id":"20240902093221-9pvhgrb","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"④治血崩：棕榈皮（烧存性，细研如粉）一钱，牡蛎（火煅，研如粉）五分。入麝香少许，拌令匀，空心米饮调下。（《百一选方》）"}]},{"ID":"20240902093221-3vfbtut","Type":"NodeParagraph","Properties":{"id":"20240902093221-3vfbtut","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑤治血崩不止：棕榈皮烧存性，为束，空心淡酒服三钱。（《妇人良方》）"}]},{"ID":"20240902093221-uv54ykz","Type":"NodeParagraph","Properties":{"id":"20240902093221-uv54ykz","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑥治妇人经血不止：棕榈皮（烧灰），柏叶（焙）各一两。上二味捣罗为散，酒调下二钱，（《圣济总录，棕榈皮散）"}]},{"ID":"20240902093221-e3yh2k6","Type":"NodeParagraph","Properties":{"id":"20240902093221-e3yh2k6","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑦治赤白带下，崩漏，胎气久冷，脐腹疼痛：棕毛（烧存性）、蒲黄（炒）各等分。每服三钱。好酒调下，空心食前，日进二服。（《普济方》棕毛散）"}]},{"ID":"20240902093221-j5z4cbe","Type":"NodeParagraph","Properties":{"id":"20240902093221-j5z4cbe","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑧妊娠胎动，下血不止，脐腹疼痛：棕榈皮（烧灰），原蚕沙（炒）各一两，阿胶（炙燥）三分。上三味捣罗为散，每服二钱匕，温酒调下。（《圣济总录》棕灰散）"}]},{"ID":"20240902093221-si76wuq","Type":"NodeParagraph","Properties":{"id":"20240902093221-si76wuq","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑨治肠风泻血：棕榈灰二两，熟艾（捣罗成者）一两。上二昧用熟鸡子两个，同研得所；别炮附子去皮脐，为末，每服用水一盏，附子末一钱，煎敷沸放温，调前药二钱匕，空心食前服。（《圣济总录》棕艾散）"}]},{"ID":"20240902093221-d0987le","Type":"NodeParagraph","Properties":{"id":"20240902093221-d0987le","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑩治水谷痢下：棕榈皮，烧研，水服方寸匕。（《近效方》）"}]},{"ID":"20240902093221-06jqgzr","Type":"NodeParagraph","Properties":{"id":"20240902093221-06jqgzr","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑾治血淋不止：棕榈皮，半烧半炒为末。每服二钱，甚效。（《卫生家宝方》）"}]},{"ID":"20240902093221-btygj7t","Type":"NodeParagraph","Properties":{"id":"20240902093221-btygj7t","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⑿治小便不通：棕树皮毛，烧灰存性，以水酒调下二钱。（《摄生众妙方》）"}]},{"ID":"20240902093221-3d7f6c5","Type":"NodeParagraph","Properties":{"id":"20240902093221-3d7f6c5","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"⒀治高血压：鲜棕榈皮六钱，鲜向日葵花盘二两。水煎服，每日一剂。（《江西草药》）"}]},{"ID":"20240902093221-wbj5xeb","Type":"NodeParagraph","Properties":{"id":"20240902093221-wbj5xeb","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902093221-6c6g0xe","Type":"NodeParagraph","Properties":{"id":"20240902093221-6c6g0xe","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"棕灰性涩，若失血去多，瘀滞已尽者，用之切当，所谓涩可去脱也。与乱发同用更良。年久败棕入药尤妙。\""}]},{"ID":"20240902093221-3064gnl","Type":"NodeParagraph","Properties":{"id":"20240902093221-3064gnl","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②《本草求原》：\"棕皮，能引血归经，止上下失血，止下血尤良。不但性涩能收脱也。同发灰，侧柏、卷柏灰饭丸或煎服，止远年下血。此物止血，不在烧灰，但血见黑则止之说，痼习已久，姑从之。\""}]},{"ID":"20240902093221-pdcr7fi","Type":"NodeParagraph","Properties":{"id":"20240902093221-pdcr7fi","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902093221-flzqjbh","Type":"NodeParagraph","Properties":{"id":"20240902093221-flzqjbh","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"棕榈皮《中华本草》"}]},{"ID":"20240902093221-xpksvo0","Type":"NodeParagraph","Properties":{"id":"20240902093221-xpksvo0","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【出处】出自《日华子本草》"}]},{"ID":"20240902093221-nzevzao","Type":"NodeParagraph","Properties":{"id":"20240902093221-nzevzao","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZōnɡLǘPí"}]},{"ID":"20240902093221-h2b84yn","Type":"NodeParagraph","Properties":{"id":"20240902093221-h2b84yn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【英文名】leafsheathfibresofFortuneWindmillpalm"}]},{"ID":"20240902093221-mmvbsi6","Type":"NodeParagraph","Properties":{"id":"20240902093221-mmvbsi6","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【别名】拼榈木皮、棕毛、棕皮、棕、拼榈、棕衣树、百页草、定海针"}]},{"ID":"20240902093221-bc9zwal","Type":"NodeParagraph","Properties":{"id":"20240902093221-bc9zwal","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902093221-ryyqpfe","Type":"NodeParagraph","Properties":{"id":"20240902093221-ryyqpfe","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"药材基源：为棕榈科植物棕榈的叶鞘纤维。"}]},{"ID":"20240902093221-mv7mvl4","Type":"NodeParagraph","Properties":{"id":"20240902093221-mv7mvl4","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Trachycarpusfortunei(Hook).H.Wendi.[ChaemaeropsforteuneiHook]"}]},{"ID":"20240902093221-s7ujzq1","Type":"NodeParagraph","Properties":{"id":"20240902093221-s7ujzq1","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，一般多于9-10月间采收期剥下的纤维状鞘片，除去残皮，晒干。"}]},{"ID":"20240902093221-ehi40wo","Type":"NodeParagraph","Properties":{"id":"20240902093221-ehi40wo","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【原形态】棕榈，常绿乔木，高达10m。茎杆圆柱形，粗装挺立，不分枝，径约20cm，残留的褐色纤维状老叶鞘层层包被于茎杆上，脱落后呈环状的节。叶簇生于茎顶，向外展开；叶柄坚硬，长约1m，横切面近三角形，边缘有小齿，基部具褐煞费苦心纤维状叶鞘，新叶柄直立，老叶柄常下垂；叶片近圆扇状，直径60-100cm，具多数皱折，掌状分裂至中部，有裂片30-50，各裂片先端浅2裂，上面绿色，下面具蜡粉，革质。肉穗花序，自茎顶叶腋抽出，基部具多数大型鞘状苞片，淡黄色，具柔毛。雌雄异株；雄花小，多数，淡黄色，花被6，2轮，宽卵形，雄蕊6，花丝短，分离；雌花花被同雄花，子房上位，密被白柔毛，花柱3裂。核果球形或近肾形，直径约1cm，熟时外果皮灰蓝色，被蜡粉。花期4-5月，果期10-12月。"}]},{"ID":"20240902093221-wagoubu","Type":"NodeParagraph","Properties":{"id":"20240902093221-wagoubu","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902093221-emu2qwn","Type":"NodeParagraph","Properties":{"id":"20240902093221-emu2qwn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"生态环境：栽培于村边、溪边、田边、丘陵地或山地。"}]},{"ID":"20240902093221-iqqxqk7","Type":"NodeParagraph","Properties":{"id":"20240902093221-iqqxqk7","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"资源分布：长江以南各地多有分布。"}]},{"ID":"20240902093221-swnrlla","Type":"NodeParagraph","Properties":{"id":"20240902093221-swnrlla","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902093221-v1wpu73","Type":"NodeParagraph","Properties":{"id":"20240902093221-v1wpu73","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"生物学特性，喜温暖湿润气候，不耐严寒，喜肥耐荫，选排水良好、土层深厚的壤土或砂质壤土栽培，不宜在干旱、土层瘠薄的土壤上栽种。"}]},{"ID":"20240902093221-swk32my","Type":"NodeParagraph","Properties":{"id":"20240902093221-swk32my","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"栽培技术，用种子繁殖，直播或育苗移栽。选择健壮的棕树，10-11月待种子成熟时连果枝割下，采摘种子，铺成10-15cm厚摊晾，堆藏或与湿沙混藏。如立即播种，呵用草木灰液浸泡3-5天，搓去种子上的蜡质，或堆沤3-4天寺蜡。直播法：早春2-3月播种，按行株距2m×2m开穴，每穴播5-7粒，每1hm2用种75kg。播后穴骨填细土，穴面平整，上面用细肥土覆盖3cm左右，出苗后每穴保留1株壮苗。育苗移栽法：冬播或早春播按行距20cm开沟条播每1hm2用种量600-1125kg，播后用细土覆盖2-3cm，上盖稻草。出苗后及时除去盖草，定期除草、施肥2-3次，按株距10cm间苗，2年后按行株距2m×2m挖穴移栽。"}]},{"ID":"20240902093221-g2jirfe","Type":"NodeParagraph","Properties":{"id":"20240902093221-g2jirfe","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"田间管理，在春、秋两季松土、除草、施肥各1次。行间可间种农作物。"}]},{"ID":"20240902093221-sb9bk23","Type":"NodeParagraph","Properties":{"id":"20240902093221-sb9bk23","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"病虫害防治，病害有烂心病，十年以下幼树易发生，发病后梢心腐烂致死，发病初期可用50%代森锌300-400倍液喷洒。虫害有介壳虫7，为害幼苗，在介壳虫若虫期，用500-800倍50%严胺硫磷乳剂或15-20倍的石油乳剂喷杀。"}]},{"ID":"20240902093221-j3sku04","Type":"NodeParagraph","Properties":{"id":"20240902093221-j3sku04","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902093221-e9ikekg","Type":"NodeParagraph","Properties":{"id":"20240902093221-e9ikekg","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"棕榈皮的陈久者，名陈棕皮。商品中有用叶柄部分或废棕绳。将叶柄削去面纤维，晒干，名为棕骨；废棕绳多取自破旧的棕床，名为陈棕。"}]},{"ID":"20240902093221-fmby5bo","Type":"NodeParagraph","Properties":{"id":"20240902093221-fmby5bo","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"1.陈棕皮：为粗长的纤维，成束状或片状，长20-40cm，大小不等。色棕褐，质韧，不易撕断。气无，味谈、以无粗皮、杂质及陈久者为佳。"}]},{"ID":"20240902093221-yye6caj","Type":"NodeParagraph","Properties":{"id":"20240902093221-yye6caj","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"2.棕骨：棕板。呈长条形，长短不一，红棕色，基部较宽而扁平，或略向内弯曲，向上则渐窄而厚，背面中央隆起，成三角形，背面两侧平坦，上有密的红棕色毛茸，腹面平坦，或略向内凹，有左右交叉的纹理。撕去表皮后，可见坚韧的纤。质坚韧，不能折断。气无，味淡。以红棕色、片大、质厚、陈久者为佳。"}]},{"ID":"20240902093221-vnum2xs","Type":"NodeParagraph","Properties":{"id":"20240902093221-vnum2xs","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"3.陈棕：呈破碎的网状。色深棕，粗糙。质坚韧，不易断。气微，味淡。"}]},{"ID":"20240902093221-85dmrns","Type":"NodeParagraph","Properties":{"id":"20240902093221-85dmrns","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"显微鉴别叶柄基部横切面：上、下表皮细胞略相似，呈类方形，排列紧密有气孔，外被角质层，下表皮中央外向隆起。内层为基本薄壁组织，上、下表皮内侧1-2层薄壁细胞切向延长，其内的基本组织细胞圆形或椭圆形，有的含棕色小颗粒或草酸钙针晶来，针晶长65-70μm；众多的晶鞘纤维束及有限外韧型线管京星散分布于基本组织中；在下表皮突出处内方约有10多个维管束聚集在一起，每个维管束的上下两例均有维管束鞘纤维，下方的纤维极多，且有晶鞘，上方的纤维极少，无晶鞘；韧皮都被纤维隔开略呈“八”字形，韧皮薄壁细胞含棕色内含物；木质部导管数个，大形。以上晶鞘细胞中的结晶全为小簇晶。"}]},{"ID":"20240902093221-exc6vou","Type":"NodeParagraph","Properties":{"id":"20240902093221-exc6vou","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"陈拣发粉卡特拉：褐棕色。①晶鞘纤维众多，纤维甚长，直径12-15μm，壁厚约2.5m，木化，胞腔明显，晶鞘细胞成行排列，草酸钙小簇晶直径约17μm。"}]},{"ID":"20240902093221-w396wvl","Type":"NodeParagraph","Properties":{"id":"20240902093221-w396wvl","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"②导管网纹，直径34-85μm，还有螺纹及梯纹管胞。③气孔大多呈类圆形，直径40-45μm，副卫细胞窄长，5-6个。④草酸钙针晶长65-70μm。"}]},{"ID":"20240902093221-yql0cif","Type":"NodeParagraph","Properties":{"id":"20240902093221-yql0cif","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"理化鉴别取本品粉末1g，加水20ml，加热smin，滤过，滤液用水稀释成20ml。取滤液1ml，加二氯化铁试液2-3滴，即生成污绿色絮状沉淀；另取滤液1ml，加氯化钠明胶试液3滴，即显白色浑浊。"}]},{"ID":"20240902093221-0pvpjgn","Type":"NodeParagraph","Properties":{"id":"20240902093221-0pvpjgn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【化学成份】棕榈叶中含木犀草素-7-O-葡萄糖甙(luteolin-7-O-glucoside)，木犀草素-7-O-芸香糖甙(luteolin-7-O-rutinoside)，甲基原薯蓣皂甙元甲糖甙(methylproto-diosgenintetraglycoside)。"}]},{"ID":"20240902093221-bubdkff","Type":"NodeParagraph","Properties":{"id":"20240902093221-bubdkff","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【药理作用】小鼠腹腔注射陈棕炭具有显着的止血作用。"}]},{"ID":"20240902093221-rzkvh30","Type":"NodeParagraph","Properties":{"id":"20240902093221-rzkvh30","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【炮制】棕榈炭：取净棕榈皮，置锅内，覆盖一口径稍小的锅，锅上粘贴白纸一张，两锅接合处用黄泥严封，微火煅至白纸呈焦黄色停火，候冷取出。"}]},{"ID":"20240902093221-uw6wvn8","Type":"NodeParagraph","Properties":{"id":"20240902093221-uw6wvn8","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；涩；性平"}]},{"ID":"20240902093221-s0xp6qc","Type":"NodeParagraph","Properties":{"id":"20240902093221-s0xp6qc","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾；大肠经"}]},{"ID":"20240902093221-4wmsc3h","Type":"NodeParagraph","Properties":{"id":"20240902093221-4wmsc3h","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【功能主治】收敛止血。主吐血；衄血；便血；血淋；尿血；血崩；外伤出血"}]},{"ID":"20240902093221-67t9gv1","Type":"NodeParagraph","Properties":{"id":"20240902093221-67t9gv1","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-15g。外用：适量，研末，外敷。"}]},{"ID":"20240902093221-yooac7s","Type":"NodeParagraph","Properties":{"id":"20240902093221-yooac7s","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【注意】出血诸证瘀滞未尽者不宜独用。"}]},{"ID":"20240902093221-n6f26zn","Type":"NodeParagraph","Properties":{"id":"20240902093221-n6f26zn","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【附方】①治鼻血不止：棕榈灰，随左右吹之。(《简易方论》)②治久鼻衄不止：棕榈、刺蓟、桦皮、龙骨等分。为细末，每服二钱，米饮调下。(《鸡峰普济方》棕榈散)③治妇人崩中，下血数升，气欲绝：棕榈三两(烧灰)，紫参一两，麝香一钱(细研)，伏龙肝二两细研)。上药捣细罗为散，入麝香研令匀，不计时候，以热酒调下二钱。(《圣惠方》棕榈散)④治血崩：棕榈皮(烧存性，细研如粉)一钱，牡蛎(火煅，研如粉)五分。人麝香少许，拌令匀，空心米饮调下。(《百一选方》)⑤治血崩不止：棕榈皮烧存性，为末，空心淡酒服三钱。(《妇人良方》)⑥治妇人经血不止：棕榈皮(烧灰)，柏叶(焙)各一两。上二昧捣罗为散，酒调下二钱。(《圣济总录》棕榈皮散)⑦治赤白带下，崩漏，胎气久冷，脐腹疼痛：毛(烧存性)、蒲黄(炒)各等分。每服三钱。好酒调下，空心食前，日进二服。(《普济方》棕毛散)⑧妊娠胎动，下血不止，脐腹疼痛：棕榈皮(烧灰)，原蚕沙(炒)各一两，阿胶(炙燥)三分。上三味捣罗为散，每服二钱匕，温酒调下。(《圣济总录》棕灰散)⑨治肠风泻血：棕榈灰二两，熟艾(捣罗成者)一两。上二味用熟鸡子两个，同研得所；别炮附子去皮脐，为末，每服用水一盏，附子末一钱，煎数沸放温，调前药二钱匕，空心食前服。(《圣济总录》棕艾散)⑩治水谷痢下：棕榈皮，烧研，水服方寸匕。(《近效方》)(11)治血淋不止：棕榈皮，半烧半炒为末。每服二钱，甚效。(《卫生家宝方》)(12)治小便不通：棕树皮毛，烧灰存性，以水酒调下二钱。(《摄生众妙方》)(13)治高血压：鲜棕榈皮六钱，鲜向日葵花盘二两。水煎服，每日一剂。(《江西草药》)"}]},{"ID":"20240902093221-0f19tp7","Type":"NodeParagraph","Properties":{"id":"20240902093221-0f19tp7","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902093221-vt924xc","Type":"NodeParagraph","Properties":{"id":"20240902093221-vt924xc","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：棕灰性涩，若失血去多，瘀滞巳尽看，用之切当，所谓涩可去脱也。与乱发同用更良。年久败棕入药尤妙。"}]},{"ID":"20240902093221-0v74nyq","Type":"NodeParagraph","Properties":{"id":"20240902093221-0v74nyq","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"2.《本草求原》：棕皮，能引血归经，止上下失血，止下血尤良。不但性涩能收脱也。同发灰，侧柏、卷柏灰饭丸或煎服，止远年下血。此物止血，不在烧灰，但血见黑则止之说，痼习已久，姑从之。"}]},{"ID":"20240902093221-xwl7wwq","Type":"NodeParagraph","Properties":{"id":"20240902093221-xwl7wwq","updated":"20240902093245"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902093223-d52fl0j","Type":"NodeThematicBreak","Properties":{"id":"20240902093223-d52fl0j","updated":"20240902093245"}},{"ID":"20240902093224-vpwzz23","Type":"NodeParagraph","Properties":{"id":"20240902093224-vpwzz23","updated":"20240902093245"}}]}