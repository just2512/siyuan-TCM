{"ID":"20240205153708-7d3n9ae","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153708-7d3n9ae","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153708-7d3n9ae\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240205162847-4wfgowh\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205162847-4wfgowh\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240205162847-4wfgowh\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"苎麻根","type":"doc","updated":"20240902160758"},"Children":[{"ID":"20240205162847-4wfgowh","Type":"NodeParagraph","Properties":{"id":"20240205162847-4wfgowh","updated":"20240205162847"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根-20240205162847-wxblldy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724085519-2jgys9o","Type":"NodeParagraph","Properties":{"id":"20240724085519-2jgys9o","updated":"20240724085619"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 472px;","style":"width: 462px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 5-20240724085519-xkylk1s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 462px;\" parent-style=\"width: 472px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 495px;","style":"width: 485px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenPar