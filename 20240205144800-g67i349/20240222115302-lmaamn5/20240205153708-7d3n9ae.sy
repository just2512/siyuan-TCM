e":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 1-20240724090253-mn0jbr2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724091245-pea1uq6","Type":"NodeParagraph","Properties":{"id":"20240724091245-pea1uq6","updated":"20240724091305"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 6-20240724091245-hpqftri.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 7-20240724091305-mlhsggy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724091352-pbpjz8l","Type":"NodeParagraph","Properties":{"id":"20240724091352-pbpjz8l","updated":"20240724091352"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 667px;","style":"width: 657px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 2-20240724085209-jvluplq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 657px;\" parent-style=\"width: 667px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 3-20240724085300-5p0vvze.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724091339-eh4p5qr","Type":"NodeParagraph","Properties":{"id":"20240724091339-eh4p5qr","updated":"20240724091339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 2-20240724090646-8m5ug6j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 635px;","style":"width: 625px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 4-20240724085433-w05x7l8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 625px;\" parent-style=\"width: 635px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724091339-eqajpoc","Type":"NodeParagraph","Properties":{"id":"20240724091339-eqajpoc","updated":"20240724091339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 394px;","style":"width: 384px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 5-20240724090946-q2mnh94.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 384px;\" parent-style=\"width: 394px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 778px;","style":"width: 768px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 3-20240724090756-wcokm6z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 768px;\" parent-style=\"width: 778px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724090851-dpcbesw","Type":"NodeParagraph","Properties":{"id":"20240724090851-dpcbesw","updated":"20240724090851"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 4-20240724090851-nktqq6i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724084816-1dot3i7","Type":"NodeParagraph","Properties":{"id":"20240724084816-1dot3i7","updated":"20240902160621"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：苎麻根，植物名叫做苎麻，别名叫做白麻，也被称为中国草，世界上纤维品质最好的植物，苎麻其叶名为白背叶。"}]},{"ID":"20240724084817-hosbsyr","Type":"NodeThematicBreak","Properties":{"id":"20240724084817-hosbsyr"}},{"ID":"20240902160751-k9gkrso","Type":"NodeParagraph","Properties":{"id":"20240902160751-k9gkrso","updated":"20240902160758"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：苎麻根"}]},{"ID":"20240902160751-77ki8vb","Type":"NodeParagraph","Properties":{"id":"20240902160751-77ki8vb","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"苎麻根《*辞典》"}]},{"ID":"20240902160751-u9x0re7","Type":"NodeParagraph","Properties":{"id":"20240902160751-u9x0re7","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZhùMáGēn"}]},{"ID":"20240902160751-ys6h7q1","Type":"NodeParagraph","Properties":{"id":"20240902160751-ys6h7q1","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【英文名】RadixBoehmeriae"}]},{"ID":"20240902160751-7q7ofxc","Type":"NodeParagraph","Properties":{"id":"20240902160751-7q7ofxc","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【别名】家苎麻、野麻、白麻、园麻、青麻"}]},{"ID":"20240902160751-hrdo3xl","Type":"NodeParagraph","Properties":{"id":"20240902160751-hrdo3xl","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【来源】为荨麻科植物苎麻Boehmerianivea（L..）Gaud．的根。冬春季采挖，洗净，晒干。"}]},{"ID":"20240902160751-3xc9kgz","Type":"NodeParagraph","Properties":{"id":"20240902160751-3xc9kgz","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本或亚灌木，高1～2m。根呈不规则圆柱形，略弯曲。茎直立，分枝，绿色，有短或长毛。叶互生，阔卵形或近圆形，长5～16cm，宽3.5～14cm，先端尾尖，基部宽楔形或圆形，边缘具粗齿，上面粗糙，下面密生白色绵毛。花单性同株，花序圆锥形；雄花序在雌花序下，雄花花被片4，雄花4，有退化雌蕊；雌花序簇生或球形，花被管状，4齿裂，子房1室，内含l胚珠。瘦果椭圆形，有毛，外被宿存花被，顶有宿存柱头，丝状。花期5～8月，果期8～10月。"}]},{"ID":"20240902160751-xy0tuy9","Type":"NodeParagraph","Properties":{"id":"20240902160751-xy0tuy9","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于荒地、山坡或栽培。主产浙江、江苏、安徽。"}]},{"ID":"20240902160751-to2x7hr","Type":"NodeParagraph","Properties":{"id":"20240902160751-to2x7hr","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性状】根不规则园柱形，略弯曲，长4～30cm，直径0.4～5cm。表面灰棕色，密生疣状突起及横向皮孔。切面皮部棕色，易剥落，木部黄白色。质坚硬，断面粉性。气微，味淡，有粘性。"}]},{"ID":"20240902160751-9lzgva3","Type":"NodeParagraph","Properties":{"id":"20240902160751-9lzgva3","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含有大黄素（emodin）、大黄素甲醚-8-BETA-葡萄糖甙。"}]},{"ID":"20240902160751-q9xu2c1","Type":"NodeParagraph","Properties":{"id":"20240902160751-q9xu2c1","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性味】性寒，味甘。"}]},{"ID":"20240902160751-lcwaemu","Type":"NodeParagraph","Properties":{"id":"20240902160751-lcwaemu","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热利尿，安胎止血，解毒。用于感冒发热、麻疹高烧、尿路感染、肾炎水肿、孕妇腹痛、胎动不安、先兆流产、跌打损伤、骨折、疮疡肿痛、出血性疾病。"}]},{"ID":"20240902160751-s9egwf8","Type":"NodeParagraph","Properties":{"id":"20240902160751-s9egwf8","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902160751-o2yfcj7","Type":"NodeParagraph","Properties":{"id":"20240902160751-o2yfcj7","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"苎麻根《*辞典》"}]},{"ID":"20240902160751-qkkabit","Type":"NodeParagraph","Properties":{"id":"20240902160751-qkkabit","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【出处】《药性论》"}]},{"ID":"20240902160751-ms193n0","Type":"NodeParagraph","Properties":{"id":"20240902160751-ms193n0","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZhùMáGēn"}]},{"ID":"20240902160751-hh2hdm8","Type":"NodeParagraph","Properties":{"id":"20240902160751-hh2hdm8","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【别名】苎根（《别录》），苎麻头（《南宁市药物志》）。"}]},{"ID":"20240902160751-0y6d0cu","Type":"NodeParagraph","Properties":{"id":"20240902160751-0y6d0cu","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【来源】为荨麻科植物苎麻的根。冬、春采挖，除去地上茎和泥土，晒干。"}]},{"ID":"20240902160751-a5usqni","Type":"NodeParagraph","Properties":{"id":"20240902160751-a5usqni","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902160751-nmxxekz","Type":"NodeParagraph","Properties":{"id":"20240902160751-nmxxekz","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"苎麻（《药性论》），又名：纻（《诗经》），天青地白草、川绵葱、野苎麻（王安卿《采药志》），银苎、天名精（《纲目拾遗》），园麻、线麻、白苎麻、山麻、红苎麻。"}]},{"ID":"20240902160751-vwfgrsv","Type":"NodeParagraph","Properties":{"id":"20240902160751-vwfgrsv","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"多年生草本，高达2米。茎直立，分枝，有柔毛。单叶互生，阔卵形或卵圆形，长7～15厘米，宽6～14厘米，先端渐尖，边缘有粗锯齿，基部浑圆或阔楔形，上面绿色，粗糙，下面除叶脉外全部密被白色绵毛；托叶锥尖形，脱落；叶柄有柔毛。花单性，雌雄同株，花小成束，为腋生的圆锥花序；雄花黄白色，花被4片，雄蕊4；雌花淡绿色，花被4片，紧抱子房，花柱1。瘦果细小，椭圆形，集合成小球状，上有毛，花柱突出。花期5～6月。果熟期9～10月。"}]},{"ID":"20240902160751-nddhf3s","Type":"NodeParagraph","Properties":{"id":"20240902160751-nddhf3s","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"本植物的茎皮（苧麻皮）、叶（苧麻叶）、花（苧麻花）亦供药用，各详专条。"}]},{"ID":"20240902160751-zdclabl","Type":"NodeParagraph","Properties":{"id":"20240902160751-zdclabl","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【生境分布】野生于山坡、山沟、路旁等处。我国中部、南部、西南及山东、江苏、安徽、浙江、陕西、河南等地均有栽培。主产江苏、山东、陕西等地。"}]},{"ID":"20240902160751-5aent93","Type":"NodeParagraph","Properties":{"id":"20240902160751-5aent93","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性状】干燥根呈不规则圆柱形或稍带扁圆形，略弯曲，长6～10厘米，直径，1～2厘米。外皮灰棕色，极粗糙。有突起的根痕和许多疣状凸起，皮部有时脱落而呈现棕褐色或棕黄色的纤维状。质硬体轻，断面纤维性，略有粉质，嫩者实心，有时可见中间有数个同心环纹，老者空心。气微，味淡，嚼之略有粘性。以灰棕色、条匀、坚实者为佳。"}]},{"ID":"20240902160751-jwnu9to","Type":"NodeParagraph","Properties":{"id":"20240902160751-jwnu9to","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含酚类、三萜（或甾醇）、绿原酸。全草和种子含氢氰酸。"}]},{"ID":"20240902160751-5eonxrp","Type":"NodeParagraph","Properties":{"id":"20240902160751-5eonxrp","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902160751-rygqx5w","Type":"NodeParagraph","Properties":{"id":"20240902160751-rygqx5w","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①止血作用"}]},{"ID":"20240902160751-ujeapg3","Type":"NodeParagraph","Properties":{"id":"20240902160751-ujeapg3","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"用野苎麻的提取物\"血凝\"浸泡大、小白鼠尾端的人工创面，可使出血量减少，出血时间缩短，如给小鼠口服或腹腔注射，亦可得到同样效果。家兔肌肉注射\"血凝\"后，凝血时间缩短，但血小板计数未见明显变化。用浸有\"血凝\"的药棉覆盖于大鼠的肝、肾伤口，未见明显的止血作用。有报道用根包扎创伤有止血作用。"}]},{"ID":"20240902160751-3u9tyqm","Type":"NodeParagraph","Properties":{"id":"20240902160751-3u9tyqm","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②从对苎麻的成分研究过程中，发现咖啡酸有明显的止血作用，因此人工合成了\"血凝酸胺（咖啡酸二乙胺盐）\"，按7毫克／公斤静脉注射于家兔，10毫克／20克注射于小鼠腹腔，凝血时间及出血时间均显著缩短，\"血凝酸胺\"在试管内无抗纤维蛋白溶解作用，但对钴照射的小鼠能使白细胞及血小板显著增加。"}]},{"ID":"20240902160751-m0naran","Type":"NodeParagraph","Properties":{"id":"20240902160751-m0naran","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，分开大小条，用水浸泡，洗净，捞出，润透后切片，晒干。"}]},{"ID":"20240902160751-xtb6sqn","Type":"NodeParagraph","Properties":{"id":"20240902160751-xtb6sqn","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902160751-a4u9i81","Type":"NodeParagraph","Properties":{"id":"20240902160751-a4u9i81","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"甘，寒。"}]},{"ID":"20240902160751-iec8y3x","Type":"NodeParagraph","Properties":{"id":"20240902160751-iec8y3x","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"寒。\""}]},{"ID":"20240902160751-jn9dzrr","Type":"NodeParagraph","Properties":{"id":"20240902160751-jn9dzrr","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味甘，平。\""}]},{"ID":"20240902160751-k6btjvh","Type":"NodeParagraph","Properties":{"id":"20240902160751-k6btjvh","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"味甘，滑，冷，无毒。\""}]},{"ID":"20240902160751-sp42pnb","Type":"NodeParagraph","Properties":{"id":"20240902160751-sp42pnb","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"④《浙江民间草药》：\"性寒，味酸，无毒。\""}]},{"ID":"20240902160751-01e04rg","Type":"NodeParagraph","Properties":{"id":"20240902160751-01e04rg","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902160751-hjtm2xu","Type":"NodeParagraph","Properties":{"id":"20240902160751-hjtm2xu","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入足厥阴经血分。\""}]},{"ID":"20240902160751-eqg1goo","Type":"NodeParagraph","Properties":{"id":"20240902160751-eqg1goo","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"人手、足太阴经。\""}]},{"ID":"20240902160751-jc5ephn","Type":"NodeParagraph","Properties":{"id":"20240902160751-jc5ephn","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902160751-pikyh3y","Type":"NodeParagraph","Properties":{"id":"20240902160751-pikyh3y","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"清热，止血，解毒，散瘀。治热病大渴、大狂，血淋，癃闭，吐血，下血，赤白带下，丹毒，痈肿，跌打损伤，蛇虫咬伤。"}]},{"ID":"20240902160751-2vkr38i","Type":"NodeParagraph","Properties":{"id":"20240902160751-2vkr38i","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主小儿赤丹；渍苎汁疗渴，安胎。\""}]},{"ID":"20240902160751-irkbyno","Type":"NodeParagraph","Properties":{"id":"20240902160751-irkbyno","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治心膈热，漏胎下血，产前后心烦闷，天行热疾，大渴大狂，罯毒箭、蛇虫咬。\""}]},{"ID":"20240902160751-7x507ls","Type":"NodeParagraph","Properties":{"id":"20240902160751-7x507ls","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"主白丹，浓煮浴之，日三、四。\""}]},{"ID":"20240902160751-lqr31wr","Type":"NodeParagraph","Properties":{"id":"20240902160751-lqr31wr","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"④《本草备要》：\"补阴，破瘀，解热，润燥。治痈疽，发背，金疮，折伤，鸡、鱼骨哽。\""}]},{"ID":"20240902160751-7vglpha","Type":"NodeParagraph","Properties":{"id":"20240902160751-7vglpha","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑤《纲目拾遗》：\"治诸毒，活血，止血，功能发散，止渴，安胎；涂小儿丹毒，通蛊胀，崩漏，白浊，滑精，牙痛，喉闭，骨哽，疝气，火丹，疖毒，胡蜂、毒蛇咬，发背，疔疮，跌扑损伤。\""}]},{"ID":"20240902160751-4l0sqqq","Type":"NodeParagraph","Properties":{"id":"20240902160751-4l0sqqq","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑥《分类草药性》：\"疗砍伤、跌扑，敷续筋骨；疯狗咬伤。\""}]},{"ID":"20240902160751-9nnqs0b","Type":"NodeParagraph","Properties":{"id":"20240902160751-9nnqs0b","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑦《现代实用中药》：\"根、叶并用，治肛门肿痛，脱肛不收。\""}]},{"ID":"20240902160751-llhwfq4","Type":"NodeParagraph","Properties":{"id":"20240902160751-llhwfq4","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑨《南宁市药物志》：\"治小儿麻疹，创伤出血肿痛。\""}]},{"ID":"20240902160751-u3shjg4","Type":"NodeParagraph","Properties":{"id":"20240902160751-u3shjg4","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～5钱；或捣汁。外用：捣敷或煎水洗。"}]},{"ID":"20240902160751-2d991do","Type":"NodeParagraph","Properties":{"id":"20240902160751-2d991do","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：\"胃弱泄泻者勿服；诸病不由血热者，亦不宜用。\""}]},{"ID":"20240902160751-5p2frs9","Type":"NodeParagraph","Properties":{"id":"20240902160751-5p2frs9","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902160751-wxebj28","Type":"NodeParagraph","Properties":{"id":"20240902160751-wxebj28","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①治五淋：苎麻根两茎，打碎，以水一碗半，煎取半碗，频服。（《斗门方》）"}]},{"ID":"20240902160751-vzue3aa","Type":"NodeParagraph","Properties":{"id":"20240902160751-vzue3aa","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②治血淋，脐腹及阴茎涩痛：麻根十枚，捣碎，以水二大盏，煎取一大盏，去滓，分为二服，如人行十里再服。（《圣惠方》）"}]},{"ID":"20240902160751-4lnkl4c","Type":"NodeParagraph","Properties":{"id":"20240902160751-4lnkl4c","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"③治小便不通：㈠苎麻根，洗，研，摊绢上，贴小腹连阴际。（《摘元方》）"}]},{"ID":"20240902160751-2xshggc","Type":"NodeParagraph","Properties":{"id":"20240902160751-2xshggc","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"㈡麻根半两，蛤粉半两。上药，捣细罗为散。每于空心，以新汲水调下二钱。（《圣惠方》）"}]},{"ID":"20240902160751-1jru0as","Type":"NodeParagraph","Properties":{"id":"20240902160751-1jru0as","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"④治叶：血不止：苎麻根、人参、白垩、蛤粉各一分。上四味，捣罗为散。每服一钱匕，糯米饮调下，不拘时候。（《圣济总录》苎根散）"}]},{"ID":"20240902160751-j8g81ua","Type":"NodeParagraph","Properties":{"id":"20240902160751-j8g81ua","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑤治肠风：苎麻根四钱。煎服。（《浙江民间草药》）"}]},{"ID":"20240902160751-0q4tvab","Type":"NodeParagraph","Properties":{"id":"20240902160751-0q4tvab","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑥治习惯性流产：苧麻干根一两，莲子五钱，怀山药五钱。水煎服。（《福建中草药》）"}]},{"ID":"20240902160751-flp6p3g","Type":"NodeParagraph","Properties":{"id":"20240902160751-flp6p3g","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑦治妊娠胎动，忽下黄汁如胶，或如小豆汁，腹痛不可忍者：苧根去黑皮，切二升，银一块，水九升，煮四升。每服以水一升，入酒半升，煎一升，分作二服。一方不用银。（《梅师集验方》）"}]},{"ID":"20240902160751-b7ez94q","Type":"NodeParagraph","Properties":{"id":"20240902160751-b7ez94q","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑧治血热崩漏：苧麻干根一两。水煎服。（《福建中草药》）"}]},{"ID":"20240902160751-l6rhvvl","Type":"NodeParagraph","Properties":{"id":"20240902160751-l6rhvvl","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑨治哮喘：苧麻根和沙糖烂煮，时时嚼咽下。（《医学正传》）"}]},{"ID":"20240902160751-y1ly3oe","Type":"NodeParagraph","Properties":{"id":"20240902160751-y1ly3oe","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑩治痰哮咳嗽：苧根，煅存性为末，生豆腐蘸三、五钱食；未全可者，以肥猪肉二、三片蘸食。（《医学正传》）"}]},{"ID":"20240902160751-43a68yj","Type":"NodeParagraph","Properties":{"id":"20240902160751-43a68yj","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑾治白丹：苧根三斤，小豆四升。水二斗，煮以浴，日三、四遍。（《备急方》）"}]},{"ID":"20240902160751-32zv416","Type":"NodeParagraph","Properties":{"id":"20240902160751-32zv416","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⑿治痈疽发背，或发乳房初起微赤：捣苧根敷之，数易。（《梅师集验方》）"}]},{"ID":"20240902160751-k0kfx9c","Type":"NodeParagraph","Properties":{"id":"20240902160751-k0kfx9c","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⒀治跌打闪挫：大鲫鱼一尾，独核肥皂一个，胡椒七粒，黄栀子九个，老姜一片，葱头三个，野苧麻根一段，干面一撮，香糟一团，绍酒随数用，同前药合捣如泥，炒热熨敷患处，外用布包扎紧，次日青出。（《纲目拾遗》）"}]},{"ID":"20240902160751-91upkar","Type":"NodeParagraph","Properties":{"id":"20240902160751-91upkar","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⒁治跌扑：野苧根一两，捣碎，好酒煎服，尽量饮醉。（《百草镜，）"}]},{"ID":"20240902160751-4jkbl44","Type":"NodeParagraph","Properties":{"id":"20240902160751-4jkbl44","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⒂治蛇咬伤：鲜苧麻根，捣烂罨包。（《浙江民间草药》）"}]},{"ID":"20240902160751-vj89ah1","Type":"NodeParagraph","Properties":{"id":"20240902160751-vj89ah1","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"⒃治鸡鱼骨哽：苧麻根捣汁，以匙挑灌之。（《谈野翁试验方》）"}]},{"ID":"20240902160751-1apre0e","Type":"NodeParagraph","Properties":{"id":"20240902160751-1apre0e","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902160751-a7tyg35","Type":"NodeParagraph","Properties":{"id":"20240902160751-a7tyg35","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"苎根，《别录》在小儿赤丹，为其寒能凉血也。渍苎汁疗渴者，除热之功也。《日华子》用以治心膈热，漏胎下血，胎前产后心烦，天行热疾，大渴发狂，及罯毒箭、蛇虫咬，皆以其性寒能解热凉血故也。\""}]},{"ID":"20240902160751-bsbmuu2","Type":"NodeParagraph","Properties":{"id":"20240902160751-bsbmuu2","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"②《本草述》：\"苎根，丹溪谓其大补阴而即行滞血，足以补为行也。夫甘寒之药能泻火，此味止血淋、治丹毒，或入血分而泻热乎?但就其安胎治漏血尤效，则补阴活血之功，又岂徒以泻热与他味问论乎。……其和血便在补阴，而能行能止之故可以思矣。\""}]},{"ID":"20240902160751-ovzqomb","Type":"NodeParagraph","Properties":{"id":"20240902160751-ovzqomb","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"白苎性寒，古方多言其主治小便不通，五淋热结等证，则有泄热通利之力，是以《日华本草》谓其甘寒而滑。乃近人偏以为安胎之用，实则既寒且滑，必非胎动者所宜；且根主下行，尤为妊娠禁品。考古今医药诸书，惟《梅师集验方》用以治胎动忽下黄汁，此外殊不多见，丹溪且言其行滞血，则更与胎动大相刺谬，又何可为安胎套药耶。\""}]},{"ID":"20240902160751-z11t9tn","Type":"NodeParagraph","Properties":{"id":"20240902160751-z11t9tn","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902160751-kzk8b6c","Type":"NodeParagraph","Properties":{"id":"20240902160751-kzk8b6c","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"苎麻根《中华本草》"}]},{"ID":"20240902160751-r1st8ab","Type":"NodeParagraph","Properties":{"id":"20240902160751-r1st8ab","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【出处】苎根始见于《别录》，《本草经集注》云：“苎麻，即今之绩苎尔，又有山苎亦相似，可入用也。”《本草图经》云：“苎根旧不载所出州土，今闽、蜀、江、浙多有之。其皮可以绩布。苗高七、八尺；叶如楮叶，面青背白，有短毛。夏秋间着细穗、青花，其根黄白而轻虚。二月、八月采。又一种山苎亦相似。”《纲目》云：“苎，家苎也；又有山苎，野苎也；有紫苎，叶面紫；白苎，叶面青；其背皆白。”《纲目拾遗》云：“野苎麻，生山上河堑旁"}]},{"ID":"20240902160751-3tll3jb","Type":"NodeParagraph","Properties":{"id":"20240902160751-3tll3jb","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZhùMáGēn"}]},{"ID":"20240902160751-9bc6cv0","Type":"NodeParagraph","Properties":{"id":"20240902160751-9bc6cv0","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【别名】苎根、野苎根、苎麻茹"}]},{"ID":"20240902160751-qdl0chg","Type":"NodeParagraph","Properties":{"id":"20240902160751-qdl0chg","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902160751-e94bvy8","Type":"NodeParagraph","Properties":{"id":"20240902160751-e94bvy8","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"药材基源：为荨麻科植物苎麻的根和根茎。"}]},{"ID":"20240902160751-uz8t0ws","Type":"NodeParagraph","Properties":{"id":"20240902160751-uz8t0ws","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Boehmerianivea(L.)Gaud.［UrticaniveaL.］"}]},{"ID":"20240902160751-d8kmzhq","Type":"NodeParagraph","Properties":{"id":"20240902160751-d8kmzhq","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬、春季采挖，除去地上茎和泥土，晒干。一般选择食指粗细的根，太粗者不易切片，药效亦不佳。"}]},{"ID":"20240902160751-nydq2ew","Type":"NodeParagraph","Properties":{"id":"20240902160751-nydq2ew","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生半灌木，高1-2m。茎直立，圆柱形，多分枝，青褐色，密生粗长毛。叶互生；叶柄长2-11cm；托叶2，分离，早落；叶片宽卵形或卵形，长7-15cm，宽6-12cm，先端渐尖或近尾状，基部宽楔形或截形，边缘密生齿牙，上面绿色，粗糙，并散生疏毛，下面密生交织的白色柔毛，基出脉3条。花单性，雌雄通常同株；花序呈圆锥状，腋生，长5-10cm，雄花序通常位于雌花序之下；雄花小，无花梗，黄白色，花被片4，雄蕊4，有退化雌蕊；雌花淡绿色，簇球形，直径约2mm，花被管状，宿存，花柱1。瘦果小，椭圆形，密生短毛，为宿存花被包裹，内有种子1颗。花期9月，果期10月。"}]},{"ID":"20240902160751-64g1yo1","Type":"NodeParagraph","Properties":{"id":"20240902160751-64g1yo1","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【生境分布】在我国河南、山东及陕西以南各地广为栽培，也有野生。"}]},{"ID":"20240902160751-1svh0dr","Type":"NodeParagraph","Properties":{"id":"20240902160751-1svh0dr","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902160751-l5xcv8i","Type":"NodeParagraph","Properties":{"id":"20240902160751-l5xcv8i","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，发芽适宜气温22-25℃，生长最适温度为23-30℃，气温在8℃以下幼苗停止生长，0℃以下苗易冻死。年降水量800-1000mm，相对湿度80％左右最为适宜。怕风，忌渍水。对土壤适应性强，以土层深厚、疏松肥沃、富含腐殖质、排水良好、土壤pH5.5-6.5的砂质壤土或粘壤土栽培为宜。"}]},{"ID":"20240902160751-0y306aq","Type":"NodeParagraph","Properties":{"id":"20240902160751-0y306aq","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"栽培技术苎麻品种繁多，有白叶苎麻和绿叶苎麻等。分深根型、中根型、浅根型三类。用种子、分根、扦插、压条、分株繁殖，亦可用组织培养方法培育试管苗。种子繁殖：用育苗移栽法，选背风向阳、灌排方便、土质疏松之处作苗床。春季3月上。中旬或秋季8月上、中旬播种，种子可与细土或草木灰拌匀后撒播于苗床，薄覆细土，以不见种子为度，盖草，浇水，保持湿度。出苗后，待有10-12片真叶时，即可移栽。每1hm2用种量7.5-15kg。分根繁殖：又称分蔸繁殖，将种根挖出，分切成数块，选健壮、无病虫害的带有节及芽的种块，随即栽种。亦可用边蔸、抽亮、抽行等方法获得种根。或将细很切成小段，早春育苗，待苗高20cm时移栽。扦插繁殖：选租壮麻茎，剪成12-15cm小段，具有3-4个芽，斜插在苗床上，覆土压实，保持土壤湿度，待生根出苗后移栽。压条繁殖：待头麻开始成熟，茎杆大部变褐色时，在植株旁挖深约5cm的浅沟，将茎杆弯曲至地面，在靠地面处，切一伤口，麻杆顶端露出土面，填土压实，待生根后与母体分离移栽。分株繁殖：苗高15-20cm时，切取过密较矮的麻苗，稍带细根，摘除部分叶片，剪去梢部栽种。移栽方法，秋末、冬初或早春空穴栽，每lhm2按深根型栽3.75万-4.5万兜、浅根型2.5万-3万蔸。实生苗4.5万-6万蔸，每蔸2-3株。穴深10-15cm，穴径12-18cm。栽后填土压实，浇水。"}]},{"ID":"20240902160751-7vfeu41","Type":"NodeParagraph","Properties":{"id":"20240902160751-7vfeu41","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"田间管理头麻追肥2-3次，一般施催苗肥、提苗肥、壮苗肥；二、三麻追肥2次，施催苗肥、齐苗肥。冬季施有机肥，可沟施或穴施，并结合培土。苗高1m时，可割除茎杆，促进地下部生长，称“破杆”，可兼收1次麻。或在植株高60cm时，将麻株扭曲挽成小结，称“闭蔸”。遇雨季要及时排涝。冬季要齐地砍杆，清理麻园。"}]},{"ID":"20240902160751-ls7jlgj","Type":"NodeParagraph","Properties":{"id":"20240902160751-ls7jlgj","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有立枯病、根腐线虫病、青枯病、疫霉病、白纹羽病、茎腐病、角斑病、褐斑病等，虫害有苎麻赤蛱蝶、苎麻天牛、银纹夜蛾、卷叶虫、苎麻黄蛱蝶、金龟子等为害。"}]},{"ID":"20240902160751-pj7uzi6","Type":"NodeParagraph","Properties":{"id":"20240902160751-pj7uzi6","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902160751-hxzvzq6","Type":"NodeParagraph","Properties":{"id":"20240902160751-hxzvzq6","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"性状鉴别根茎呈不规则圆柱形，稍弯曲，长4-30cm，直径0.4-5cm；表面灰棕色，有纵纹及多数皮孔，并有多数疣状突起及残留须恨；质坚硬，不易折断，折断面纤维性，皮部棕色，木部淡棕色，有的中间有数个同心环纹，中央有髓或中空。根略呈纺锤形，长约10cm，直径1-1.3cm；表面灰棕色，有纵皱纹及横长皮孔；断面粉性。气微，味淡，有粘性。"}]},{"ID":"20240902160751-ubze1q5","Type":"NodeParagraph","Properties":{"id":"20240902160751-ubze1q5","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"以色灰棕、无空心者为佳。"}]},{"ID":"20240902160751-ftnivkd","Type":"NodeParagraph","Properties":{"id":"20240902160751-ftnivkd","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"显微鉴别根茎横切面：木栓层为数列木栓细胞，外侧破碎。皮层约10余列细胞，近中柱鞘纤维处为厚角细胞。中柱鞘纤维壁极厚，胞腔小。韧皮射线明显；韧皮纤维单个或数个成束，壁厚，非木化。形成层成环。本质部射线宽2-10列细胞；导管单个散在或数个径向排列，少数切向排列。髓部薄壁细胞较大。本品薄壁细胞含淀粉粒，并含草酸钙簇晶，木射线细胞尚含方晶；另有粘液道及含揉质细胞。"}]},{"ID":"20240902160751-71y7b7g","Type":"NodeParagraph","Properties":{"id":"20240902160751-71y7b7g","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"根横切面：韧皮部狭窄，韧皮纤维较少，韧皮射线不明显；木质部主要为薄壁细胞，充满淀粉粒，导管稀少；无髓。"}]},{"ID":"20240902160751-8hdmgfq","Type":"NodeParagraph","Properties":{"id":"20240902160751-8hdmgfq","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"3.理化鉴别本品水煎液加三氯化铁试液，显墨绿色。取水煎液滴在滤纸上，于紫外光灯下显蓝色荧光。"}]},{"ID":"20240902160751-974iia4","Type":"NodeParagraph","Properties":{"id":"20240902160751-974iia4","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含绿原酸(chlorogenicacid)，在稀酸中加热可生成咖啡酸(caffeicacid)及奎宁酸(quinicacid)[1]。"}]},{"ID":"20240902160751-8fioaqa","Type":"NodeParagraph","Properties":{"id":"20240902160751-8fioaqa","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【药理作用】止血作用用野苎麻的提取物“血凝”浸泡大、小鼠尾端的人工创面，可使出血量减少，出血时间缩短；如给小鼠口服或腹腔注射，也可得到同样的效果。家兔肌内注射“血凝”后，凝血时间缩短，但血小板计数未见明显变化。用浸有“血凝”的药棉覆盖于大鼠的肝、肾伤口，未见明显的止血作用。从对苎麻的成分研究过程中，发现咖啡酸有明显的止血作用，因此人工合成了“血凝酸胺(咖啡酸二乙胺盐)”，给家兔静脉注射7mg/kg，或小鼠腹腔注射10mg/20g，凝血时间及出血时间均显着缩短，“血凝酸胺”在试管内无抗纤维蛋白溶解作用，但对60Co照射的小鼠能使白细胞及血小板显着增加。"}]},{"ID":"20240902160751-4qxvm2t","Type":"NodeParagraph","Properties":{"id":"20240902160751-4qxvm2t","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【毒性】“血凝酸胺”毒性极低，小鼠腹腔注射LD50为1583±80mg／kg。家兔静脉注射，对血压、呼吸无明显影响，连续静脉注射10日对心电图及肝、肾功能也均无改变。"}]},{"ID":"20240902160751-12uzp2v","Type":"NodeParagraph","Properties":{"id":"20240902160751-12uzp2v","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902160751-fe057yj","Type":"NodeParagraph","Properties":{"id":"20240902160751-fe057yj","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"1.苎麻根取原药材，除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240902160751-9bt68sw","Type":"NodeParagraph","Properties":{"id":"20240902160751-9bt68sw","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"2.苎麻根炭《医学正传》：“煅存性。”现行，取净苎麻根片，置锅内，用武火加热，炒至表面呈焦黑色，内部焦黄色时，喷淋清水少许，熄灭火星，取出，凉透。"}]},{"ID":"20240902160751-8in6mgc","Type":"NodeParagraph","Properties":{"id":"20240902160751-8in6mgc","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"饮片性状：苎麻根为圆形或类圆形厚片，木部淡黄色，中间有数个同心环纹，纤维性，皮部灰褐色。周边灰棕色至灰褐色。气微，味淡，嚼之略有粘性。苎麻根炭表面焦黑色，内部焦黄色，味微苦。"}]},{"ID":"20240902160751-wjk0elq","Type":"NodeParagraph","Properties":{"id":"20240902160751-wjk0elq","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【性味】甘；性寒；"}]},{"ID":"20240902160751-bpi72rb","Type":"NodeParagraph","Properties":{"id":"20240902160751-bpi72rb","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【归经】肝；心；膀胱经"}]},{"ID":"20240902160751-h3bhy97","Type":"NodeParagraph","Properties":{"id":"20240902160751-h3bhy97","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【功能主治】凉血止血；清热安胎；利尿；解毒。主血热妄行所致的咯血；吐血；衄血；血淋；便血；崩漏；紫癜；胎动不安；胎漏下血；小便淋沥；痈疮肿毒；虫蛇咬伤"}]},{"ID":"20240902160751-tkqjt34","Type":"NodeParagraph","Properties":{"id":"20240902160751-tkqjt34","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-30g；或捣汁。外用：适量，鲜品捣敷；或煎汤熏洗。"}]},{"ID":"20240902160751-7mp1rq6","Type":"NodeParagraph","Properties":{"id":"20240902160751-7mp1rq6","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【注意】无实热者慎服。《本草经疏》：“病人胃弱泄泻者勿服，诸病不由血热者亦不宜用。”"}]},{"ID":"20240902160751-066swa5","Type":"NodeParagraph","Properties":{"id":"20240902160751-066swa5","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【附方】李时珍《本草纲目》：“苎麻作纻，可以绩纻，故谓之纻(今按：此纻字疑应作苎)。凡麻丝之细者为絟，粗者为纻。陶弘景云：苎即今绩苎麻是也。麻字从广从林(音派)，象屋下林麻之形，广音掩。”今按：《说文》：“宁(音zhu)，办积物也。”绩纻需久沤，故名为纻。苎麻则又因绩纻而名。"}]},{"ID":"20240902160751-lxb0w5x","Type":"NodeParagraph","Properties":{"id":"20240902160751-lxb0w5x","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【各家论述】1.《草木疏》：“纻，亦麻也，科生数十茎，宿根在地中，至春自生，不岁种也。荆扬之间，一岁三收，今官园种之，岁再刈，刈便生，剥之以铁，若竹刮其表，厚皮自脱，但得其里韧如筋者，煮之，用缉，谓之徽纻。今南越纻布皆用此麻。”2.《蜀本草》:“苗高丈已来，南人剥其皮为布，二月、八月采。江左山南皆有之。”3.《本草衍义》：“苎如荨麻，花如白杨而长，成穗生，每一朵凡数十穗，青白色。”4.《纲目》：“苎，可刮洗煮食救荒，味甘美。其子茶褐色，九月收之，二月可种。宿根亦自生。”5.《三农纪》：“苎，植艺：收子作种，头麻者佳，余不堪用。霜降后收子晒干，以沙土匀拌，盛筐内，遇种时以水试之，沉者佳。种宜春深，沙土为上，两合土次之，劚土三四遍，作畦阔半步，长四五步，成畦种之，随用润上半升，苎子一合拌匀，撒毕以帚扫，苗生，有草即拔去。喜润，不宜燥，但干以水浇。约苗高三寸，择肥土作畦移植，子生者三五年方可刈。苎已盛时，宜于周围掘取新科移栽，则本科长茂。或三五年移，将根科最盛者，间此一畦，移栽彼一畦，此畦既盛，又掘彼畦，若此更代，滋生无穷，月月可栽，但得土润为妙。根苗宜收室下，停露地即用苫盖。若根见星月，即变野苎，不堪用。上以糠秕、烘，宜大粪和水，最忌猪屎，栽根，以刀截作半尺，卧栽，每穴二、三尺，各离尺五一窠，次年方堪再刈。若岁久科根盘结，宜分植。若欲致远，密裹封固，禁见天日。”6.《植物名实图考》：“苎麻，《别录》下品。《农政全书》谓苎徙丝，非苎，北地寒不宜。考《救荒本草》，苎根味甘，煮食甜美。许州田园亦有种者。盖自淮而北，近时皆致力于棉花，御寒时久，而御暑时暂。絺绤之用，唯城市为殷，故种莳者少耳。野苎极繁，芟除为难，不任绩。山苎稍劲，花作长穗翘出，稍异。”"}]},{"ID":"20240902160751-cyafsz6","Type":"NodeParagraph","Properties":{"id":"20240902160751-cyafsz6","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【备注】【药论】1.论苎麻根清热凉血之功缪希雍：“(苎根)《别录》专主小儿赤丹，为其寒能凉血也。渍苎汁疗渴者，除热之功也。《日华子》用以治心膈热，漏胎下血，胎前产后心烦，天行热疾，大渴发狂，及服金石药人心热，罯毒箭、蛇虫咬，皆以其性寒能解热凉血故也。”(《本草经疏》)2.论苎麻根安胎机制①汪绂：“孕妇两三月后，相火日盛，血益热，胎多不安。苎根甘咸入心，能布散其光明，而不为郁热，此安胎良药也。”(《医林纂要·药性》)②张秉成：“苎麻根，甘寒养阴，长于滑窍凉血，血分有湿热者亦属相宜。大抵胎动因于血热者多，或因伤血瘀者亦有之。安胎之义，其即此乎。”(《本草便读》)3.论苎麻根补行兼备①朱丹溪：“苎，大补肺金而行滞血，方药似未曾用，故表而出之。”(《本草衍义补遗》)②刘若金：“苎根，丹溪谓其大补阴而即行滞血，是以补为行也。夫甘寒之药能泻火，此味止血淋，治丹毒，或入血分而泻热乎？但就其安胎、治漏血尤效，则补阴活血之功，又岂徒以泻热与他味同论乎。其和血者便在补阴，而能行能止之故可以思矣。”(《本草述》)4.论苎麻根泄热通利而下行，非胎动者所宜张山雷：“白苎性寒，古方多言其主治小便不通，五淋热结等证，则有泄热通利之力，是以《日华本草》谓其甘寒而滑。乃近人偏以为妊娠安胎之用，盖以苎麻之质坚韧，取其坚固胎元之意。实则既寒且滑，必非胎动者所宜。且根主下行，尤为妊娠禁品。考古今医药诸书，惟《梅师方》用以治胎动忽下黄汁，此外殊不多见。丹溪且言其行滞血，则更与胎动大相刺谬，又何可为安胎套药耶？”(《本草正义》)5.论苎麻根、葛根之异同汪绂：“苎根亦如葛，皆能养心清肺散火。但葛色白，入气分，散阳明之火；苎色赤，入血分，散厥阴之火。散火即以补心也。”(《医林纂要·药性》)"}]},{"ID":"20240902160751-f5a1ok5","Type":"NodeParagraph","Properties":{"id":"20240902160751-f5a1ok5","updated":"20240902160817"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902160752-oaj812i","Type":"NodeThematicBreak","Properties":{"id":"20240902160752-oaj812i","updated":"20240902160817"}},{"ID":"20240902160753-yw3290h","Type":"NodeParagraph","Properties":{"id":"20240902160753-yw3290h","updated":"20240902160817"}}]}