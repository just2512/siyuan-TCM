{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"槐花2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/槐花2-20240619171502-zab28cw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715150416-c4kubdg","Type":"NodeParagraph","Properties":{"id":"20240715150416-c4kubdg","updated":"20240715150416"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 497px;","style":"width: 487px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"槐树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/槐树-20240715144608-i8w3dc1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 487px;\" parent-style=\"width: 497px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 558px;","style":"width: 548px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"槐树 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/槐树 8-20240715145837-a095xs2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 548px;\" parent-style=\"width: 558px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902094023-zyfx022","Type":"NodeThematicBreak","Properties":{"id":"20240902094023-zyfx022"}},{"ID":"20240902094302-nlw1em1","Type":"NodeParagraph","Properties":{"id":"20240902094302-nlw1em1","updated":"20240902094312"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：槐花"}]},{"ID":"20240902094302-1wizrhz","Type":"NodeParagraph","Properties":{"id":"20240902094302-1wizrhz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花《中国药典》"}]},{"ID":"20240902094302-j8wnzob","Type":"NodeParagraph","Properties":{"id":"20240902094302-j8wnzob","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuáiHuā"}]},{"ID":"20240902094302-0q20sd5","Type":"NodeParagraph","Properties":{"id":"20240902094302-0q20sd5","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSSOPHORAE"}]},{"ID":"20240902094302-mnqxeya","Type":"NodeParagraph","Properties":{"id":"20240902094302-mnqxeya","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【别名】金药树、护房树、豆槐、槐米"}]},{"ID":"20240902094302-ryg6emc","Type":"NodeParagraph","Properties":{"id":"20240902094302-ryg6emc","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【来源】本品为豆科植物槐SophorajaponicaL.的干燥花及花蕾。夏季花开放或花蕾形成时采收，及时干燥，除去枝、梗及杂质。前者习称“槐花”，后者习称“槐米”。"}]},{"ID":"20240902094302-jqrj008","Type":"NodeParagraph","Properties":{"id":"20240902094302-jqrj008","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902094302-cj9vceo","Type":"NodeParagraph","Properties":{"id":"20240902094302-cj9vceo","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花：本品皱缩而卷曲，花瓣多散落。完整者花萼钟状，黄绿色，先端5浅裂；花瓣5，黄色或黄白色，1片较大，近圆形，先端微凹，其余4片长圆形。雄蕊10，其中9个基部连合，花丝细长。雌蕊圆柱形，弯曲。体轻。无臭，味微苦。"}]},{"ID":"20240902094302-41hcp0f","Type":"NodeParagraph","Properties":{"id":"20240902094302-41hcp0f","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐米：呈卵形或椭圆形，长2～6mm，直径约2mm。花萼下部有数条纵纹。萼的上方为黄白色未开放的花瓣。花梗细小。体轻，手捻即碎。无臭，味微苦涩。"}]},{"ID":"20240902094302-83bzdey","Type":"NodeParagraph","Properties":{"id":"20240902094302-83bzdey","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902094302-hfmlq4m","Type":"NodeParagraph","Properties":{"id":"20240902094302-hfmlq4m","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末黄绿色。花粉粒类球形或钝三角形，直径14～19μm。具3个萌发孔。非腺毛1～3细胞，长86～660μm，气孔不定式，副卫细胞4～8个。草酸钙方晶少见。"}]},{"ID":"20240902094302-duv6uf9","Type":"NodeParagraph","Properties":{"id":"20240902094302-duv6uf9","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.1g，加乙醇10ml，加热5分钟，滤过。取滤液1ml，加镁粉少量与盐酸2～3滴，即显樱红色。"}]},{"ID":"20240902094302-wnfqqa7","Type":"NodeParagraph","Properties":{"id":"20240902094302-wnfqqa7","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0.2g，加甲醇5ml,密塞，振摇10分钟，放置10分钟，滤过，滤液作为供试品溶液。另取芦丁对照品，加甲醇制成每1ml含4mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl,分别点于同一硅胶Ｇ薄层板上，以醋酸乙酯－甲酸－水（8:1:1）为展开剂，展开，取出，晾干，喷以三氯化铝试液，待乙醇挥干后，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240902094302-1ntw6oz","Type":"NodeParagraph","Properties":{"id":"20240902094302-1ntw6oz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902094302-momadpl","Type":"NodeParagraph","Properties":{"id":"20240902094302-momadpl","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花：除去杂质及灰屑。"}]},{"ID":"20240902094302-xpl33xd","Type":"NodeParagraph","Properties":{"id":"20240902094302-xpl33xd","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"炒槐花：取净槐花，照清炒法（附录ⅡD）炒至表面深黄色。"}]},{"ID":"20240902094302-vmin41f","Type":"NodeParagraph","Properties":{"id":"20240902094302-vmin41f","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花炭：取净槐花，照炒炭法（附录ⅡD）炒至表面焦褐色。"}]},{"ID":"20240902094302-avvqkph","Type":"NodeParagraph","Properties":{"id":"20240902094302-avvqkph","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性味】苦，微寒。"}]},{"ID":"20240902094302-v9fi81b","Type":"NodeParagraph","Properties":{"id":"20240902094302-v9fi81b","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、大肠经。"}]},{"ID":"20240902094302-myh1mqm","Type":"NodeParagraph","Properties":{"id":"20240902094302-myh1mqm","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【功能主治】凉血止血，清肝泻火。用于便血，痔血，血痢，崩漏，吐血，衄血，肝热目赤，头痛眩晕。"}]},{"ID":"20240902094302-kpwntic","Type":"NodeParagraph","Properties":{"id":"20240902094302-kpwntic","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【用法用量】5～9g。"}]},{"ID":"20240902094302-yc6kyfa","Type":"NodeParagraph","Properties":{"id":"20240902094302-yc6kyfa","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防潮，防蛀。"}]},{"ID":"20240902094302-lxz6nvc","Type":"NodeParagraph","Properties":{"id":"20240902094302-lxz6nvc","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902094302-plzuo1q","Type":"NodeParagraph","Properties":{"id":"20240902094302-plzuo1q","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花《*辞典》"}]},{"ID":"20240902094302-n27s1er","Type":"NodeParagraph","Properties":{"id":"20240902094302-n27s1er","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【出处】《日华子本草》"}]},{"ID":"20240902094302-dmaf9a2","Type":"NodeParagraph","Properties":{"id":"20240902094302-dmaf9a2","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuáiHuā"}]},{"ID":"20240902094302-quhr1jq","Type":"NodeParagraph","Properties":{"id":"20240902094302-quhr1jq","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【别名】槐蕊（《本草正》）。"}]},{"ID":"20240902094302-699vbqw","Type":"NodeParagraph","Properties":{"id":"20240902094302-699vbqw","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【来源】为豆科植物槐的花朵或花蕾。夏季，花初开放时采收花朵，商品称\"槐花\"；花未开时采收花蕾，商品称\"槐米\"。除去杂质，当日晒干。"}]},{"ID":"20240902094302-57k0jsb","Type":"NodeParagraph","Properties":{"id":"20240902094302-57k0jsb","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902094302-y39za8b","Type":"NodeParagraph","Properties":{"id":"20240902094302-y39za8b","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐（《尔雅》），又名：豆槐、白槐、细叶槐、金药树、护房树。"}]},{"ID":"20240902094302-6rop461","Type":"NodeParagraph","Properties":{"id":"20240902094302-6rop461","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达25米。树皮灰色或深灰色，粗糙纵裂。内皮鲜黄色，有臭味；枝棕色，幼时绿色，具毛，皮孔明显。单数羽状复叶互生，长达25厘米，叶柄基部膨大；小叶7～15，卵状长圆形咸卵状披针形，长2.5～5厘米，宽1.5～2.6厘米，先端尖，基部圆形或阔楔形，全缘，上面绿色，微亮，下面伏生白色短毛；小叶柄长2.5毫米；托叶镰刀状，早落。圆锥花序顶生；花乳白色，长1.5厘米；萼钟形，5浅裂；花冠蝶形，旗瓣同心形，有短爪，脉微紫；雄蕊10，分离不等长；子房筒状，有细长毛，花柱弯曲。荚果长2.5～5厘米，有节，呈连珠状，无毛，绿色，肉质，不开裂，种子间极细缩。种子1～6粒，深棕色，肾形。花期7～8月。果期10～11月。"}]},{"ID":"20240902094302-5jpihjb","Type":"NodeParagraph","Properties":{"id":"20240902094302-5jpihjb","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡、平原或植于庭园。我国大部地区有分布。我国大部分地区多有生产。而以河北、山东、河南、江苏、广东、广西、辽宁等地为主产区。"}]},{"ID":"20240902094302-9e3ryr6","Type":"NodeParagraph","Properties":{"id":"20240902094302-9e3ryr6","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902094302-hoxs1v2","Type":"NodeParagraph","Properties":{"id":"20240902094302-hoxs1v2","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①槐花"}]},{"ID":"20240902094302-cn3nlhq","Type":"NodeParagraph","Properties":{"id":"20240902094302-cn3nlhq","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"干燥花朵，花瓣多数散落，完整的花呈飞鸟状，直径约1.5厘米，花瓣5枚，黄色或淡棕色，皱缩、卷曲。基部萼筒黄绿色，先端5浅裂。雄蕊淡黄色，须状，有时弯曲。子房膨大。质轻，气弱，味微苦。以色黄白、整齐、无枝梗杂质者为佳。"}]},{"ID":"20240902094302-5zd8p12","Type":"NodeParagraph","Properties":{"id":"20240902094302-5zd8p12","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②槐米"}]},{"ID":"20240902094302-1jc3vhn","Type":"NodeParagraph","Properties":{"id":"20240902094302-1jc3vhn","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"又名：槐花米（《医方易简》）。系干燥的花蕾，呈卵形或长椭圆形，长2.5～5毫米，宽1.5～2毫米。外表黄褐色或黄绿色，稍皱缩，下部为钟状花萼，先端具不甚明显的5齿裂，有时有短柄，上部为未开放的花冠，大小不一，花萼和花冠的外面均疏生白色短柔毛。质松脆。气弱，味微苦。以花蕾足壮、花萼色绿而厚、无枝梗者为佳。"}]},{"ID":"20240902094302-aye8jvw","Type":"NodeParagraph","Properties":{"id":"20240902094302-aye8jvw","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902094302-jhx8pe3","Type":"NodeParagraph","Properties":{"id":"20240902094302-jhx8pe3","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"含芸香甙，花蕾中含量多，开放后含量少。又从干花蕾中得三萜皂甙0.4％，水解后得白桦脂醇、槐花二醇和葡萄糖、葡萄糖醛酸。"}]},{"ID":"20240902094302-nkn0r8j","Type":"NodeParagraph","Properties":{"id":"20240902094302-nkn0r8j","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"另从花蕾中得槐花米甲素（14％）、乙素（1.25％）和丙素（0.35％），甲素是和芸香甙不同的黄酮类，乙素和丙素为甾醇类。又含鞣质，生槐花含0.66％，槐花炭鞣质含量约为生槐花的4倍。"}]},{"ID":"20240902094302-ftdm5dc","Type":"NodeParagraph","Properties":{"id":"20240902094302-ftdm5dc","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902094302-rxafkl6","Type":"NodeParagraph","Properties":{"id":"20240902094302-rxafkl6","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①对毛细血管的影响"}]},{"ID":"20240902094302-b5m6di7","Type":"NodeParagraph","Properties":{"id":"20240902094302-b5m6di7","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花中的成分芸香甙及其甙元槲皮素能保持毛细血管正常的抵抗力，减少血管通透性，可使因脆性增加而出血的毛细血管恢复正常的弹性，槲皮素可增强豚鼠、大鼠皮肤毛细血管的抵抗力（用负压引起正常及肝素化动物皮肤出现瘀点的方法），降低血管通透性（用兔-氯仿法），其对毛细血管稳定性的作用较芸香甙强1/3。近年报道槲皮素等黄酮醇型化合物对Arthusphenomenon（致敏动物皮下注射抗原，引起局部水肿及坏死）有抑制作用。黄酮类化合物中的无色矢车菊素对豚鼠及人增强毛细血管抵抗力有双相作用：早期暂时性使毛细血管抵抗力增加，随后是强而长时间的作用，可持续几天，但另一些黄酮类对毛细血管的抵抗力仅表现单相作用。连续大量应用芸香甙及槲皮素，可阻止由于减压而引起的鼠肺出血。"}]},{"ID":"20240902094302-e9k8bex","Type":"NodeParagraph","Properties":{"id":"20240902094302-e9k8bex","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②抗炎作用"}]},{"ID":"20240902094302-2otasff","Type":"NodeParagraph","Properties":{"id":"20240902094302-2otasff","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"芸香甙及槲皮素对大白鼠因组织胺、蛋清、5-羟色胺、甲醛、多乙烯吡咯酮引起的脚爪浮肿，以及透明质酸酶引起的足躁部浮肿有抑制作用。芸香甙能显著抑制大鼠创伤性浮肿，并能阻止结膜炎、耳廓炎、肺水肿的发展，对兔由于芥子油引起的结膜水肿，仅有轻微的抑制作用，如将芸香甙溶于丙二醇中，预防炎症的效果更好。静脉注射芸香甙能抑制兔因马血清引起的皮肤、关节过敏性炎症及Arthusphenomenon，这可能是由于它对毛细血管壁有保护作用，使毛细血管致密，抑制渗出所致芸香甙硫酸酯的钠盐能加速狗因注射松节油引起的后肢血栓性静脉炎的恢复。关于芸香甙类黄酮的抗炎原理，说法很多，如兴奋肾上腺皮质（给予芸香甙衍化物后，肾上腺中维生素C及胆甾醇含量降低，血浆中甾醇类显著增加），血中肾上腺素增多（可能是由于与儿茶酚胺氧位甲基转移酶或单胺氧化酶产生竞争性抑制所致），间接的抑制了毛细血管的通透性，并使血管前括约肌张力增加，降低真毛细血管充血的总量；有认为系抑制了透明质酸酶所致；也有认为是由于保护了肥大细胞的\"裂解\"及\"脱粒\"，因此抑制了前致炎胺的释放，以及阻碍肾上腺素分解两种因素综合所致。从生化方面认为是由于其阻断了多种酶的巯基，并与酶中的主要金属离子复合而表现抗炎作用。关于其抗水肿的作用，则认为是由于增加了透明质酸的粘度，及抑制了胞膜三磷酸腺甙酶。"}]},{"ID":"20240902094302-5gs44mx","Type":"NodeParagraph","Properties":{"id":"20240902094302-5gs44mx","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③解痉、抗溃疡作用"}]},{"ID":"20240902094302-fn9idoe","Type":"NodeParagraph","Properties":{"id":"20240902094302-fn9idoe","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槲皮素能降低肠、支气管平滑肌的张力，其解痉作用较芸香甙强5倍，用X线研究证明，芸香甙能降低大鼠的胃运动功能，并能解除氯化钡引起的小肠平滑肌痉挛，效力仅为凯林的1/14，皮下注射芸香甙5～10毫克/公斤，能显著降低大鼠因结扎幽门引起的胃溃疡的病灶数目，对反射性胃溃疡的效力较凯林强。槐花液（含芸香甙甚微）注入兔肠腔内，能刺激肠粘膜使渗出液增加。"}]},{"ID":"20240902094302-b08n66n","Type":"NodeParagraph","Properties":{"id":"20240902094302-b08n66n","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"④对心血管系统的影响"}]},{"ID":"20240902094302-nz0zdxh","Type":"NodeParagraph","Properties":{"id":"20240902094302-nz0zdxh","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花液对离体蛙心有轻度兴奋作用，对心传导系统有阻滞作用。芸香甙、槲皮素、槲皮甙亦能增加离体及在位蛙心的收缩力及输出量，并减少心率。芸香甙使蟾蜍下肢及兔耳血管收缩。槲皮素可扩张冠状血管，改善心肌循环。槐米400毫克/公斤连服三天，可增加小鼠的冠状血管流量（铷88示踪法）。对垂体后叶素引起的兔冠脉收缩（T波增高），有轻度的对抗作用。能降低大鼠心肌耗氧量（瓦伯氏呼吸器法）。目前人工合成的许多黄酮衍化物多有扩张冠状血管及抗心律不齐等作用。槐花液、槐花酊剂对麻醉犬、猫有暂时显著的降低血压作用，芸香甙及其制剂有降压作用，槲皮素亦能短时间的降压。"}]},{"ID":"20240902094302-5zt93oc","Type":"NodeParagraph","Properties":{"id":"20240902094302-5zt93oc","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑤对血脂质的影响"}]},{"ID":"20240902094302-f1cc0m8","Type":"NodeParagraph","Properties":{"id":"20240902094302-f1cc0m8","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"用胆甾醇30毫克/公斤及6甲基硫脲嘧啶90毫克/公斤混于食物中饲养大白鼠，形成高胆甾醇血症，同时皮下注射槲皮素10毫克/公斤，能有效的降低肝、主动脉及血中的胆甾醇量，并增加胆甾醇-蛋白复合物的稳定性，对实验性动脉硬化症有预防及治疗效果。"}]},{"ID":"20240902094302-m5zo1h4","Type":"NodeParagraph","Properties":{"id":"20240902094302-m5zo1h4","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑥其他作用"}]},{"ID":"20240902094302-b2h20bk","Type":"NodeParagraph","Properties":{"id":"20240902094302-b2h20bk","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"芸香甙及槲皮素在试管内对某些细菌有抗菌作用，也有认为无抗菌作用者。对病毒、真菌试管内亦表现抑制。芸香甙对大鼠肉瘤-45及小鼠肺腺瘤均无抑制作用，但日本学者则认为对某些肿瘤有抑制作用。两者对多种酶亦有影响。此外芸香甙对X线照射有保护作用（小鼠的残存率较对照组高），并能使接受致死量尼笃命的小鼠减少死亡率。槐树含有血球凝集素，对血球有凝集作用。大剂量槐花酊剂引起某些中枢反射机能的抑制。"}]},{"ID":"20240902094302-pqzzc3a","Type":"NodeParagraph","Properties":{"id":"20240902094302-pqzzc3a","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"一般认为，芸香甙口服不吸收，因此对其口服时究竟有无治疗作用，很值得怀疑。也有人认为，口服后还是可以吸收的。"}]},{"ID":"20240902094302-w1xbfs5","Type":"NodeParagraph","Properties":{"id":"20240902094302-w1xbfs5","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【炮制】槐花炭：将净槐花入锅内，炒至焦黑色，存性，略喷清水，取出晾干。"}]},{"ID":"20240902094302-xvzmzjz","Type":"NodeParagraph","Properties":{"id":"20240902094302-xvzmzjz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902094302-jbyp1pt","Type":"NodeParagraph","Properties":{"id":"20240902094302-jbyp1pt","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"苦，凉。"}]},{"ID":"20240902094302-z32lte5","Type":"NodeParagraph","Properties":{"id":"20240902094302-z32lte5","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"味苦，平，无毒。\""}]},{"ID":"20240902094302-klyhfwg","Type":"NodeParagraph","Properties":{"id":"20240902094302-klyhfwg","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"味苦涩，性寒。\""}]},{"ID":"20240902094302-lhprvvy","Type":"NodeParagraph","Properties":{"id":"20240902094302-lhprvvy","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"味苦，气凉。\""}]},{"ID":"20240902094302-up5gnpg","Type":"NodeParagraph","Properties":{"id":"20240902094302-up5gnpg","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"苦咸，寒。\""}]},{"ID":"20240902094302-7kqags5","Type":"NodeParagraph","Properties":{"id":"20240902094302-7kqags5","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902094302-6sgtjqt","Type":"NodeParagraph","Properties":{"id":"20240902094302-6sgtjqt","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"入肝、大肠经。"}]},{"ID":"20240902094302-q8jw4s4","Type":"NodeParagraph","Properties":{"id":"20240902094302-q8jw4s4","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"入手阳明、足厥阴经。\""}]},{"ID":"20240902094302-kwwt15p","Type":"NodeParagraph","Properties":{"id":"20240902094302-kwwt15p","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入肺、大肠二经。\""}]},{"ID":"20240902094302-caxuirs","Type":"NodeParagraph","Properties":{"id":"20240902094302-caxuirs","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入手太阴肺经、手少阴心经。\""}]},{"ID":"20240902094302-ig5u4p1","Type":"NodeParagraph","Properties":{"id":"20240902094302-ig5u4p1","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902094302-e31z70v","Type":"NodeParagraph","Properties":{"id":"20240902094302-e31z70v","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"清热，凉血，止血。治肠风便血，痔血，尿血，血淋，崩漏，衄血，赤白痢下，风热目赤，痈疽疮毒。并用于预防中风。"}]},{"ID":"20240902094302-nrrypda","Type":"NodeParagraph","Properties":{"id":"20240902094302-nrrypda","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"治五痔，心痛，眼赤，杀腹藏虫及热，治皮肤风，并肠风泻血，赤白痢。\""}]},{"ID":"20240902094302-rmbhk8j","Type":"NodeParagraph","Properties":{"id":"20240902094302-rmbhk8j","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"凉大肠热。\""}]},{"ID":"20240902094302-3cvkunb","Type":"NodeParagraph","Properties":{"id":"20240902094302-3cvkunb","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"炒香频嚼，治失音及喉痹。又疗吐血，衄，崩中漏下。\""}]},{"ID":"20240902094302-icr6w1d","Type":"NodeParagraph","Properties":{"id":"20240902094302-icr6w1d","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"④《本草正》：\"凉大肠，杀疳虫。治痈疽疮毒，阴疮湿痒，痔漏，解杨梅恶疮，下疳伏毒。\""}]},{"ID":"20240902094302-ac03q9x","Type":"NodeParagraph","Properties":{"id":"20240902094302-ac03q9x","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"泄肺逆，泻心火，清肝火，坚肾水。\""}]},{"ID":"20240902094302-8in22ma","Type":"NodeParagraph","Properties":{"id":"20240902094302-8in22ma","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑥《本草求真》：\"治大、小便血，舌衄。\""}]},{"ID":"20240902094302-rjfxasd","Type":"NodeParagraph","Properties":{"id":"20240902094302-rjfxasd","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"为凉血要药。治胃脘卒痛，杀蛔虫。\""}]},{"ID":"20240902094302-i4lp23b","Type":"NodeParagraph","Properties":{"id":"20240902094302-i4lp23b","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑧《东北药植志》：\"治疗糖尿病的视网膜炎。\""}]},{"ID":"20240902094302-5shotrx","Type":"NodeParagraph","Properties":{"id":"20240902094302-5shotrx","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～5钱；或入丸、散。外用：煎水熏洗或研末撒。"}]},{"ID":"20240902094302-3t6v8mt","Type":"NodeParagraph","Properties":{"id":"20240902094302-3t6v8mt","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者慎服。"}]},{"ID":"20240902094302-3am8xza","Type":"NodeParagraph","Properties":{"id":"20240902094302-3am8xza","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902094302-318x5er","Type":"NodeParagraph","Properties":{"id":"20240902094302-318x5er","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①治大肠下血：槐花、荆芥穗等分。为末，酒服一钱匕。（《经验方》）"}]},{"ID":"20240902094302-6xklynk","Type":"NodeParagraph","Properties":{"id":"20240902094302-6xklynk","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②治脏毒，酒病，便血：槐花（半两炒，半两生），山栀子一两（去皮，炒）。上为末。每服二钱，新汲水调下。食前服。（《经验良方》槐花散）"}]},{"ID":"20240902094302-5cfyx8h","Type":"NodeParagraph","Properties":{"id":"20240902094302-5cfyx8h","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③治暴热下血：生猪脏一条，洗净，控干，以炒槐花末填满扎定，米醋炒，锅内煮烂，擂，丸弹子大，日干。每服一丸，空心，当归煎酒化下。（《永类钤方》）"}]},{"ID":"20240902094302-05l6bvs","Type":"NodeParagraph","Properties":{"id":"20240902094302-05l6bvs","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"④治诸痔出血：槐花二两，地榆、苍术各一两五钱，甘草一两。俱微炒，研为细末，每早晚各食前服二钱。气痔（因劳损中气而出血者）人参汤调服；酒痔（因酒积毒过多而出血者）陈皮、干葛汤调服；虫痔（因痒而内有虫动出血者）乌梅汤调服；脉痔（因劳动有伤，痔窍血出远射如线者）阿胶汤调服。（《杜氏家抄方》）"}]},{"ID":"20240902094302-txlqb0u","Type":"NodeParagraph","Properties":{"id":"20240902094302-txlqb0u","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑤治小便尿血：槐花（炒）、郁金（煨）各一两。为末。每服二钱，淡豉汤下。（《箧中秘宝方》）"}]},{"ID":"20240902094302-0vzi6xa","Type":"NodeParagraph","Properties":{"id":"20240902094302-0vzi6xa","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑥治血淋：槐花烧过，去火毒，杵为末。每服一钱，水酒送下。（《滇南本草》）"}]},{"ID":"20240902094302-61uiqre","Type":"NodeParagraph","Properties":{"id":"20240902094302-61uiqre","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑦治血崩：陈槐花一两，百草霜半两。为末。每服三、四钱，温酒调下；若昏愦不省人事，则烧红秤锤淬酒下。（《良朋汇集》槐花散）"}]},{"ID":"20240902094302-gbsboje","Type":"NodeParagraph","Properties":{"id":"20240902094302-gbsboje","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑧治白带不止：槐花（炒）、牡蛎（煅）等分。为末。每酒服三钱，取效。（《摘元方》）"}]},{"ID":"20240902094302-q6lcl4k","Type":"NodeParagraph","Properties":{"id":"20240902094302-q6lcl4k","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑨治衄血不止：槐花、乌贼鱼骨等分。半生半炒，为末，吹鼻。（《世医得效方》）"}]},{"ID":"20240902094302-e5aw8db","Type":"NodeParagraph","Properties":{"id":"20240902094302-e5aw8db","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑩治吐血不止：槐花不拘多少。火烧存性，研细，入麝香少许。每服三钱匕，温糯米饮调下。（《圣济总录》槐香散）"}]},{"ID":"20240902094302-ie1q1so","Type":"NodeParagraph","Properties":{"id":"20240902094302-ie1q1so","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑾治舌出血不止，名曰舌衄：槐花，晒干研末，敷舌上，或火炒，出火毒，为末敷。（《奇效良方，，槐花敢）"}]},{"ID":"20240902094302-ubhsx9h","Type":"NodeParagraph","Properties":{"id":"20240902094302-ubhsx9h","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⑿治赤白痢疾：槐花（微炒）三钱，白芍药（炒）二钱，枳壳（麸炒）一钱。甘草五分。水煎服。（《本草汇言》）"}]},{"ID":"20240902094302-sqm7ht9","Type":"NodeParagraph","Properties":{"id":"20240902094302-sqm7ht9","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⒀治疔疮肿毒，一切痈疽发背，不问已成未成，但焮痛者皆治：槐花（微炒）、核桃仁二两，无灰酒一钟。煎千余沸，热服。（《医方摘要》）"}]},{"ID":"20240902094302-v3jrutr","Type":"NodeParagraph","Properties":{"id":"20240902094302-v3jrutr","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⒁治疮疡：槐花二合，金银花五钱。酒二碗煎服之，取汗。（《医学启蒙》槐花金银花酒）"}]},{"ID":"20240902094302-eq4itue","Type":"NodeParagraph","Properties":{"id":"20240902094302-eq4itue","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⒂治杨梅疮，棉花疮毒及下疳，初感或毒盛经久难愈者：槐花蕊（拣净，不必炒），每食前清酒吞下三钱许，早中晚每日三服。如不能饮酒，滚水盐汤俱可送下。（《景岳全书》）"}]},{"ID":"20240902094302-dxirtt7","Type":"NodeParagraph","Properties":{"id":"20240902094302-dxirtt7","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"⒃治中风失音：炒槐花，三更后仰卧嚼咽。（《世医得效方》）"}]},{"ID":"20240902094302-queg732","Type":"NodeParagraph","Properties":{"id":"20240902094302-queg732","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902094302-0sm6ylb","Type":"NodeParagraph","Properties":{"id":"20240902094302-0sm6ylb","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"①治疗银屑病"}]},{"ID":"20240902094302-dcucsfg","Type":"NodeParagraph","Properties":{"id":"20240902094302-dcucsfg","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"取槐花炒黄研成细粉，每次1钱，每日2次，饭后用温开水送服。亦可将槐花制成蜜丸内服，剂量同上。临床观察53例，痊愈6例，显着进步22例，进步19例，无效6例。此药对有胃肠道疾病的人有一定副作用，服药时加用维生素B1，B6可以缓解。也有部分病人开始有腹泻，几天后自行消失，因此服药宜从小剂量开始，2～3天后加至全量。"}]},{"ID":"20240902094302-7dpwuis","Type":"NodeParagraph","Properties":{"id":"20240902094302-7dpwuis","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"②治疗颈淋巴结结核"}]},{"ID":"20240902094302-zl1g1ga","Type":"NodeParagraph","Properties":{"id":"20240902094302-zl1g1ga","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"取槐米2份，糯米1份，炒黄研末，每天晨空腹服2匙（约10克）。服药期间禁止服糖。临床治疗30多例，均获治愈。"}]},{"ID":"20240902094302-rn245kz","Type":"NodeParagraph","Properties":{"id":"20240902094302-rn245kz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"③治疗暑疖"}]},{"ID":"20240902094302-y90oae8","Type":"NodeParagraph","Properties":{"id":"20240902094302-y90oae8","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"用干槐花米1～2两，加水1500毫升煎汁，用棉花蘸洗局部。药汁可反复加热，1日洗2～3次。同时将药渣捣烂如泥敷于患部。一般用药1～2日后局部即可消肿而愈。"}]},{"ID":"20240902094302-iid0nth","Type":"NodeParagraph","Properties":{"id":"20240902094302-iid0nth","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"④注意过敏反应"}]},{"ID":"20240902094302-t9rknla","Type":"NodeParagraph","Properties":{"id":"20240902094302-t9rknla","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"曾报告1例小儿，因口含槐花后引起过敏反应，出现发烧，颜面、颈及四肢皮肤潮红，表面有大小不等的密集丘疹，加压不退，瘙痒，刺痛，面颊及颈前区有直径约0.5厘米圆形隆起的白色水泡和片状糜烂，并有少许渗液；斑贴试验阳性。初用苯海拉明治疗效果不佳，后改给氢化考的松而渐恢复。"}]},{"ID":"20240902094302-x78a6d8","Type":"NodeParagraph","Properties":{"id":"20240902094302-x78a6d8","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902094302-n5jml16","Type":"NodeParagraph","Properties":{"id":"20240902094302-n5jml16","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"槐花《中华本草》"}]},{"ID":"20240902094302-mutgjrr","Type":"NodeParagraph","Properties":{"id":"20240902094302-mutgjrr","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902094302-akr7r2d","Type":"NodeParagraph","Properties":{"id":"20240902094302-akr7r2d","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"出自《名医别录》。"}]},{"ID":"20240902094302-4xgnl0m","Type":"NodeParagraph","Properties":{"id":"20240902094302-4xgnl0m","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：槐，今处处有之，其木有极高大者。谨按《尔雅》，槐有数种，昼合夜开者名守宫槐，叶细而青绿者但谓之槐，其功用不言有别。四月、五月开花，六月、七月结实，七月采嫩实捣取汁作煎，十月采老实入药，皮根采无时。今医家用槐者最多。"}]},{"ID":"20240902094302-sp95c3m","Type":"NodeParagraph","Properties":{"id":"20240902094302-sp95c3m","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuáiHuā"}]},{"ID":"20240902094302-nwmycf6","Type":"NodeParagraph","Properties":{"id":"20240902094302-nwmycf6","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【英文名】FlowerofJapanesePagodatree,PagodatreeFlowerBud"}]},{"ID":"20240902094302-8vso7dq","Type":"NodeParagraph","Properties":{"id":"20240902094302-8vso7dq","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【别名】槐蕊"}]},{"ID":"20240902094302-pn3ivib","Type":"NodeParagraph","Properties":{"id":"20240902094302-pn3ivib","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902094302-f0mmq5c","Type":"NodeParagraph","Properties":{"id":"20240902094302-f0mmq5c","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物槐的花及花蕾。"}]},{"ID":"20240902094302-y5mm4f8","Type":"NodeParagraph","Properties":{"id":"20240902094302-y5mm4f8","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SophorajaponicaL."}]},{"ID":"20240902094302-vz76uvq","Type":"NodeParagraph","Properties":{"id":"20240902094302-vz76uvq","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季花蕾形成时采收，及时干燥，除去枝、梗和杂质。亦可在花开放时，在树下铺布、席等，将花打落，收集晒干。"}]},{"ID":"20240902094302-izma9ja","Type":"NodeParagraph","Properties":{"id":"20240902094302-izma9ja","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【原形态】槐落叶乔木，高8-20m。树皮灰棕色，具不规则纵裂，内皮鲜黄色，具臭味；嫩枝暗绿褐色，近光滑或有短细毛，皮孔明显。奇数现状复叶，互生，长15-25cm，叶轴有毛，基部膨大；小叶7-15，柄长约2mm，密生白色短柔毛；托叶镰刀状，早落；小叶片卵状长圆形，长2.5-7.5cm，宽1.5-3cm，先端渐尖具细突尖，基部宽楔形，全缘，上面绿色，微亮，背面优生白色短毛。圆锥花序顶生，长15-30cm；萼钟状，5浅裂；花冠蝶形，乳白色，旗瓣阔心形，有短爪，脉微紫，翼瓣和龙骨瓣均为长方形；雄蕊10，分离，不等长；于房筒状，有细长毛，花柱弯曲。荚果肉质，串珠状，长2.5-5cm，黄绿色，无毛，不开裂，种子间极细缩。种子1-6颗，肾形，深棕色。花期7-8月，果期10-11月。"}]},{"ID":"20240902094302-ypgkpu0","Type":"NodeParagraph","Properties":{"id":"20240902094302-ypgkpu0","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902094302-yaf7ndc","Type":"NodeParagraph","Properties":{"id":"20240902094302-yaf7ndc","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"生态环境：栽培于屋边、路边。"}]},{"ID":"20240902094302-zeo3uaz","Type":"NodeParagraph","Properties":{"id":"20240902094302-zeo3uaz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地普遍栽培。"}]},{"ID":"20240902094302-svmk5ru","Type":"NodeParagraph","Properties":{"id":"20240902094302-svmk5ru","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902094302-tydur6x","Type":"NodeParagraph","Properties":{"id":"20240902094302-tydur6x","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"生物学特性对气候适应性较强，在土层较深厚的地方均可栽培，以湿润、深厚、肥沃、排水良好的砂质壤土为佳。但石灰性及轻度盐碱地也能正常生长。"}]},{"ID":"20240902094302-dwgxk8k","Type":"NodeParagraph","Properties":{"id":"20240902094302-dwgxk8k","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖或分株繁殖。种子繁殖：3月上旬用80℃清水浸种5-6h，捞出后掺入两倍的湿沙，拌匀平摊于室内，堆积厚度20-25cm，上面用湿沙盖严，为避免种子裸露，可再覆盖1层塑料薄膜，保温保湿。每隔3-5d翻倒1次，至3月下旬至4月上旬种子有25％-30％裂嘴后，即可播种。大田垄播，按50-65cm行距作垄。播时在垄上开浅沟条播，每1hm2需用种子150-250kg。播后覆土2-3cm，压实保墒。分株繁殖：从老树脚下挖取分x苗进行移栽。栽前按1.5-2.5m的行株距开穴，每穴栽苗1株，栽完填土踏实，浇水封垵。数年后即成材。"}]},{"ID":"20240902094302-35l6jdz","Type":"NodeParagraph","Properties":{"id":"20240902094302-35l6jdz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"田间管理育苗期间，每年中耕除草和追肥2-3次。病虫害防治病害有腐烂病，发病时通常于幼苗绿色枝干上先出现溃疡病斑，然后逐渐扩大，严重时甚至全株死亡。防治应加强水肥管理，保护伤口，提高苗木的生长势，并于早春在树干上刷白涂剂（生石灰5份，硫黄粉1.5份，食盐2份，水36份）；如苗木上已发生病斑，可用100％托布津1000倍液喷洒。"}]},{"ID":"20240902094302-af4jd12","Type":"NodeParagraph","Properties":{"id":"20240902094302-af4jd12","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"虫害有槐尺蠖，一年发生3代，防治不及时能吃光树叶。防治应于3月前在树冠下及周围松土中挖蛹，发现初龄幼虫时，应立即喷松毛虫杆菌500倍液或Bt乳剂500倍液。"}]},{"ID":"20240902094302-ka7vhxp","Type":"NodeParagraph","Properties":{"id":"20240902094302-ka7vhxp","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902094302-kw2au93","Type":"NodeParagraph","Properties":{"id":"20240902094302-kw2au93","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）槐花多皱缩而卷曲，花瓣多散落。完整者花萼钟状，黄绿色，先端5浅裂；花瓣5，黄色或黄白色，1片较大，近圆形，先端微凹，其余4片长圆形；雄蕊10，其中9个基部联合，花丝细长；雌蕊圆柱形，弯曲。以个大、紧缩、色黄绿、无梗叶者为佳。"}]},{"ID":"20240902094302-hhmgqvz","Type":"NodeParagraph","Properties":{"id":"20240902094302-hhmgqvz","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"（2）槐米呈卵形或椭圆形，长2-6mm，直径2-3mm。花萼下部有数条纵纹。萼的上方为黄白色未开放的花瓣。花梗细小。体轻，气微，味微苦涩。"}]},{"ID":"20240902094302-yjs2ea0","Type":"NodeParagraph","Properties":{"id":"20240902094302-yjs2ea0","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：黄绿色。①花粉粒类球形或钝三角形，直径球形或钝三角形，直径14-22μm，具3个萌发孔。②非腺毛l-6细胞，长64-709μm，直径7-23μm，壁厚9μm，具不规则角质螺纹，有的可见微小疣状突起。③萼片表皮细胞表面观多角形，可见非腺毛及毛脱落痕迹；气孔不定式，副卫细胞4-8个。此外，可见花冠表皮细胞、花粉囊内壁细胞及草酸钙方晶。"}]},{"ID":"20240902094302-n71gaew","Type":"NodeParagraph","Properties":{"id":"20240902094302-n71gaew","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【化学成份】槐花与槐米所含成分基本相同，主含三萜皂成：赤豆皂甙（azukisaponin）Ⅰ、Ⅱ、Ⅴ，大豆皂甙（soyasaponin）I、Ⅲ，槐花皂甙（kaikasaponin）Ⅰ、Ⅱ、Ⅲ。还含黄酮类：槲皮素（quercetin），芸香甙（rutin），异鼠李素（isorhamnetin），异鼠李素-3-芸香糖甙（isorhamnetin-3-rutinoside），山奈酚-3-芸香糖甙（kaempferol-3-rutinoside）。又含白桦脂醇（betulin），槐花二醇（sophoradiol）。花油中含月桂酸（lauricacid），十二碳烯酸（dodecenoicacid），肉豆蔻酸（myristicacid），十四碳烯酸（tetradecenoicacid）十四碳二烯酸（teradecadienoicacid），棕榈酸（palmiticacid），十六碳烯酸（hexadecenoicacid），硬脂酸（stearicacid），十八碳二烯酸（octadecadienoicacid），十作碳三烯酸（octadecatrienoicacid），花生酸（arachidicacid）等脂肪酸和β-谷甾醇（β-sitosterol）。另含鞣质。"}]},{"ID":"20240902094302-io3r4m4","Type":"NodeParagraph","Properties":{"id":"20240902094302-io3r4m4","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902094302-uk2xf4d","Type":"NodeParagraph","Properties":{"id":"20240902094302-uk2xf4d","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"1.抗炎作用：大鼠ip本品所含的芦丁,对植入羊毛球的发炎过程有明显的抑制作用。"}]},{"ID":"20240902094302-x1fuhg8","Type":"NodeParagraph","Properties":{"id":"20240902094302-x1fuhg8","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"2.维生素P样作用：芦丁具有维持血管抵抗力。降低其通透性，减少脆性等作用，对脂肪浸润的肝有祛脂作用，与谷胱甘酞合用祛脂效果更明显。"}]},{"ID":"20240902094302-c5llyvx","Type":"NodeParagraph","Properties":{"id":"20240902094302-c5llyvx","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"3.抗病毒作用：200ug/ml浓度时，对水疱性口炎病毒有最大的抑制作用。"}]},{"ID":"20240902094302-4nqc0xs","Type":"NodeParagraph","Properties":{"id":"20240902094302-4nqc0xs","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"4.抑制醛糖还原酶作用：芦丁10－5mol/L浓度时抑制率为95%。此作用有利于糖尿病型白内障的治疗。"}]},{"ID":"20240902094302-6i5t5xg","Type":"NodeParagraph","Properties":{"id":"20240902094302-6i5t5xg","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"5.祛痰、止咳等作用：本品所含的槲皮素有一定的平喘作用。此外还有降低血压，增强毛细血管抵抗力，减少毛细血管脆性、降血脂，扩张冠状动脉，增加冠脉血流量等作用。"}]},{"ID":"20240902094302-ws46b08","Type":"NodeParagraph","Properties":{"id":"20240902094302-ws46b08","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"6.其它作用：槐花提取物对15－羟前列腺素脱氢酶的抑制活性为34.4%，抑制率为60.6%，有强的抑制活性。抑制15一羟前列腺素脱氢酶可延长前列腺素E2（PGE2）的利尿作用。本品所含的Quercetin［2（3，4-dihydroxyphenyl）-3，5，7，-trihydroxy-4H-1-benzopyran-4-one〕具有剂量依赖性的抗出血作用。"}]},{"ID":"20240902094302-qggpsan","Type":"NodeParagraph","Properties":{"id":"20240902094302-qggpsan","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【毒性】芦丁小鼠ivLD50为950mg/kg。槲皮素小鼠po的LD50为160mg/kg。"}]},{"ID":"20240902094302-5093vy3","Type":"NodeParagraph","Properties":{"id":"20240902094302-5093vy3","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品0.2g，加乙醇5ml，水浴温热5min，滤过。取滤液2ml，加镁粉少许，混匀，滴加盐酸数滴，即显樱红色。（检查黄酮）品质标志《中华人民共和国药典》1995年版规定：本品于60℃干燥6h，含芦丁（C27H30O6）槐花不得少于8.0％，槐米不得少于20.0％。"}]},{"ID":"20240902094302-fws6gzw","Type":"NodeParagraph","Properties":{"id":"20240902094302-fws6gzw","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【炮制】槐花炭：将净槐花入锅内，炒至焦黑色，存性，略喷清水，取出晾干。"}]},{"ID":"20240902094302-nyiyb1f","Type":"NodeParagraph","Properties":{"id":"20240902094302-nyiyb1f","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；性微寒"}]},{"ID":"20240902094302-6jyiihi","Type":"NodeParagraph","Properties":{"id":"20240902094302-6jyiihi","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肺；心；大肠经"}]},{"ID":"20240902094302-zmwatvs","Type":"NodeParagraph","Properties":{"id":"20240902094302-zmwatvs","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【功能主治】凉血止血；清肝明目。主肠风便血；痔疮下血；血痢；尿血；血淋；崩漏；吐血；衄血；肝热头痛；目赤肿痛；痈肿疮疡"}]},{"ID":"20240902094302-mnzpq21","Type":"NodeParagraph","Properties":{"id":"20240902094302-mnzpq21","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-10g；或入丸、散。外用：适量，煎水熏洗；或研末撒。"}]},{"ID":"20240902094302-gw36hsi","Type":"NodeParagraph","Properties":{"id":"20240902094302-gw36hsi","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者慎服。"}]},{"ID":"20240902094302-qizi63y","Type":"NodeParagraph","Properties":{"id":"20240902094302-qizi63y","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【附方】①治大肠下血：槐花、荆芥穗等分。为末，酒服一钱匕。(《经验方》)②治脏毒，酒病，便血：槐花(半两炒，半两生)，山栀子一两(去皮，炒)。上为末，每服二钱，新汲水调下，食前服。(《经验良方》槐花散)③治暴热下血：生猪脏一条，洗净，控干，以炒槐花末填满扎定，米醋炒，锅内煮烂，擂，丸弹子大，日干。每服一丸，空心，当归煎酒化下。(《永类钤方》)④治诸痔出血：槐花二两，地榆、苍术各一两五钱，甘草一两。俱微炒，研为细末，每早晚各食前服二钱。气痔(因劳损中气而出血者)人参汤调服；酒痔(因酒积毒过多而出血者)陈皮、干葛汤调服；虫痔(因痒而内有虫动出血者)乌梅汤调服；脉痔(因劳动有伤，痔窍血出远射如线者)阿胶汤调服。(《杜氏家抄方》)⑤治小便尿血：槐花(炒)、郁金(煨)各一两。为末。每服二钱，淡豉汤下。(《箧中秘宝方》)⑥治血淋：槐花烧过，去火毒，杵为末。每服一钱，水酒送下。(《滇南本草》)⑦治血崩：陈槐花一两，百草霜半两。为末。每服三、四钱，温酒调下；若昏愦不省人事，则烧红秤锤淬酒下。(《良朋汇集》槐花散)⑧治白带不止：槐花(炒)、牡蛎(煅)等分。为末。每酒服三钱，取效。(《摘元方》)⑨治衄血不止：槐花、乌贼鱼骨等分。半生半炒，为末，吹鼻。(《世医得效方》)⑩治吐血不止：槐花不拘多少。火烧存性，研细，入麝香少许。每服三钱巴，温糯米饮调下。(《圣济总录》槐香散)(11)治舌出血不止，名曰舌衄：槐花，晒干研末，敷舌上，或火炒，出火毒，为末敷。(《奇效良方》槐花散)(12)治赤白痢疾：槐花(微炒)三钱，白芍药(炒)二钱，枳壳(麸炒)一钱，甘草五分。水煎服。(《本草汇言》)(13)治疗疮肿毒，一切痈疽发背，不问已成未成，但焮痛名皆治：槐花(微炒)、核桃仁二两，无灰酒一钟。煎千余沸，热服。(《医方摘要》)(14)治疮疡：槐花二合，金银花五钱。酒二碗煎服之，取汗。(《医学启蒙》槐花金银花酒)(15)治杨梅疮，棉花疮毒及下疳，初感或毒盛经久难愈者：槐花蕊(拣净，不必炒)，每食前清酒吞下三钱许，早中晚每日三服。如不能饮酒，滚水盐汤俱可送下。(《景岳全书》)(16)治中风失音：炒槐花，三更后仰卧嚼咽。(《世医得效方》)"}]},{"ID":"20240902094302-61csv29","Type":"NodeParagraph","Properties":{"id":"20240902094302-61csv29","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902094302-f3ti8yx","Type":"NodeParagraph","Properties":{"id":"20240902094302-f3ti8yx","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"1.《日华子本草》：治五痔，心痛，眼赤，杀腹藏虫及热，治皮肤风，并肠风泻血，赤白痢。2.《医学启源》：凉大肠热。"}]},{"ID":"20240902094302-8pw3ofk","Type":"NodeParagraph","Properties":{"id":"20240902094302-8pw3ofk","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：炒香频嚼，治失音及喉痹。又疗吐血，衄，崩中漏下。"}]},{"ID":"20240902094302-awveccl","Type":"NodeParagraph","Properties":{"id":"20240902094302-awveccl","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"4.《本草正》：凉大肠，杀疳虫。治痈疽疮毒，阴疮湿痒，痔漏，解杨梅恶疮，下疳伏毒。"}]},{"ID":"20240902094302-hy2m2os","Type":"NodeParagraph","Properties":{"id":"20240902094302-hy2m2os","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"5.《医林纂要》：泄肺逆，泻心火，清肝火，坚肾水。"}]},{"ID":"20240902094302-cmvuqks","Type":"NodeParagraph","Properties":{"id":"20240902094302-cmvuqks","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"6.《本草求真》：治大、小便血，舌衄。"}]},{"ID":"20240902094302-3lvjpej","Type":"NodeParagraph","Properties":{"id":"20240902094302-3lvjpej","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"7.《本草求原》：为凉血要药。治胃脘卒痛，杀蛔虫。"}]},{"ID":"20240902094302-a6w1w0i","Type":"NodeParagraph","Properties":{"id":"20240902094302-a6w1w0i","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"8.《东北药植志》：治疗糖尿病的视网膜炎。"}]},{"ID":"20240902094302-npldw9n","Type":"NodeParagraph","Properties":{"id":"20240902094302-npldw9n","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902094302-fn2eqgn","Type":"NodeParagraph","Properties":{"id":"20240902094302-fn2eqgn","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"1.治疗银屑病：取槐花炒黄研成细粉，每次1钱，每日2次，饭后用温开水送服。亦可将槐花制成蜜丸内服，剂量同上。临床观察53例，痊愈6例，显着进步22例，进步19例，无效6例。此药对有胃肠道疾病的人有一定副作用，服药时加用维生素B1、B6可以缓解。也有部分病人开始有腹泻，几天后自行消失，因此服药宜从小剂量开始，2-3天后加至全量。"}]},{"ID":"20240902094302-fd7jeoj","Type":"NodeParagraph","Properties":{"id":"20240902094302-fd7jeoj","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"2.治疗颈淋巴结核：取槐米2份，糯米l份，炒黄研末，每天晨空腹服2匙(约10g)。服药期间禁止服糖。临床治疗30多例，均获治愈。"}]},{"ID":"20240902094302-k000o2e","Type":"NodeParagraph","Properties":{"id":"20240902094302-k000o2e","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"3.治疗暑疗：用干槐花米1-2两，加水1500ml煎汁，用棉花蘸洗局部。药汁可反复加热，1日洗2-3次。同时将药渣捣烂如泥敷于患部。一般用药1-2日后局部即可消肿而愈。"}]},{"ID":"20240902094302-xqraebi","Type":"NodeParagraph","Properties":{"id":"20240902094302-xqraebi","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"4.注意过敏反应：曾报告1例小儿，因口含槐花后引起过敏反应，出现发烧，颜面、颈及四肢皮肤潮红，表面有大小不等的密集丘疹，加压不退，瘙痒、刺痛，面颊及颈前区有直径约0.5cm圆形隆起的白色水泡和片状糜烂，并有少许渗液；斑贴试验阳性。初用苯海拉明治疗效果不佳，后改给氢化考的松而渐恢复。"}]},{"ID":"20240902094302-z4jk9pj","Type":"NodeParagraph","Properties":{"id":"20240902094302-z4jk9pj","updated":"20240902094321"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902094303-coln4jf","Type":"NodeThematicBreak","Properties":{"id":"20240902094303-coln4jf","updated":"20240902094321"}},{"ID":"20240902094304-pgdf3gy","Type":"NodeParagraph","Properties":{"id":"20240902094304-pgdf3gy","updated":"20240902094321"}}]}