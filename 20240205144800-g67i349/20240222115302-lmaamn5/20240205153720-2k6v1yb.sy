t-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"使君子 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/使君子 8-20240709155935-bs7umfu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709155629-oiue41g","Type":"NodeParagraph","Properties":{"id":"20240709155629-oiue41g","updated":"20240709160244"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 518px;","style":"width: 508px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"使君子 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/使君子 9-20240709155958-vr3fo5p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 508px;\" parent-style=\"width: 518px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 686px;","style":"width: 676px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"使君子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/使君子 10-20240709160244-aw1ve55.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 676px;\" parent-style=\"width: 686px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709160546-nh7x0k4","Type":"NodeParagraph","Properties":{"id":"20240709160546-nh7x0k4","updated":"20240709160546"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"使君子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/使君子 13-20240709160546-bcn1sir.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709160648-hrxnh6n","Type":"NodeThematicBreak","Properties":{"id":"20240709160648-hrxnh6n"}},{"ID":"20240830135844-m28vdb7","Type":"NodeParagraph","Properties":{"id":"20240830135844-m28vdb7","updated":"20240830135852"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：使君子"}]},{"ID":"20240830135844-t0zrpbu","Type":"NodeParagraph","Properties":{"id":"20240830135844-t0zrpbu","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子《中国药典》"}]},{"ID":"20240830135844-afe05v7","Type":"NodeParagraph","Properties":{"id":"20240830135844-afe05v7","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShǐJūnZǐ"}]},{"ID":"20240830135844-sygng85","Type":"NodeParagraph","Properties":{"id":"20240830135844-sygng85","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSQUISQUALIS"}]},{"ID":"20240830135844-8o2nuzj","Type":"NodeParagraph","Properties":{"id":"20240830135844-8o2nuzj","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【别名】留球子"}]},{"ID":"20240830135844-udh50gy","Type":"NodeParagraph","Properties":{"id":"20240830135844-udh50gy","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【来源】本品为使君子科植物使君子QuisqualisindicaL.的干燥成熟果实。秋季果皮变紫黑色时采收，除去杂质，干燥。"}]},{"ID":"20240830135844-xd9ujbb","Type":"NodeParagraph","Properties":{"id":"20240830135844-xd9ujbb","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈椭圆形或卵圆形，具5条纵棱，偶有4～9棱，长2.5～4cm，直径约2cm。表面黑褐色至紫黑色，平滑，微具光泽。顶端狭尖，基部钝圆，有明显圆形的果梗痕。质坚硬，横切面多呈五角星形，棱角处壳较厚，中间呈类圆形空腔。种子长椭圆形或纺锤形，长约2cm,直径约1cm；表面棕褐色或黑褐色，有多数纵皱纹；种皮薄，易剥离；子叶2,黄白色，有油性，断面有裂纹。气微香，味微甜。"}]},{"ID":"20240830135844-wih78gx","Type":"NodeParagraph","Properties":{"id":"20240830135844-wih78gx","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830135844-ofq4ibb","Type":"NodeParagraph","Properties":{"id":"20240830135844-ofq4ibb","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子：除去杂质。用时捣碎。"}]},{"ID":"20240830135844-a5c3nwm","Type":"NodeParagraph","Properties":{"id":"20240830135844-a5c3nwm","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子仁：取净使君子除去外壳。"}]},{"ID":"20240830135844-kpkfgoe","Type":"NodeParagraph","Properties":{"id":"20240830135844-kpkfgoe","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"炒使君子仁：取使君子仁，照清炒法（附录ⅡD）炒至有香气。"}]},{"ID":"20240830135844-ocyqtog","Type":"NodeParagraph","Properties":{"id":"20240830135844-ocyqtog","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性味】甘，温。"}]},{"ID":"20240830135844-bn65g3f","Type":"NodeParagraph","Properties":{"id":"20240830135844-bn65g3f","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃经。"}]},{"ID":"20240830135844-pbb32di","Type":"NodeParagraph","Properties":{"id":"20240830135844-pbb32di","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫消积。用于蛔虫、蛲虫病，虫积腹痛，小儿疳积。"}]},{"ID":"20240830135844-krtvrco","Type":"NodeParagraph","Properties":{"id":"20240830135844-krtvrco","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【用法用量】使君子9～12g，捣碎入煎剂；使君子仁6～9g,多入丸散用或单用，作1～2次分服。"}]},{"ID":"20240830135844-io0bsmk","Type":"NodeParagraph","Properties":{"id":"20240830135844-io0bsmk","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【注意】服药时忌饮浓茶。"}]},{"ID":"20240830135844-eunsh09","Type":"NodeParagraph","Properties":{"id":"20240830135844-eunsh09","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防霉，防蛀。"}]},{"ID":"20240830135844-w2jjnzp","Type":"NodeParagraph","Properties":{"id":"20240830135844-w2jjnzp","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【备注】（1）大量服用能引起呃逆、眩晕、精神不振、恶心，甚至呕吐、腹泻等反应。与茶同服亦能引起呃逆。"}]},{"ID":"20240830135844-zqr2njb","Type":"NodeParagraph","Properties":{"id":"20240830135844-zqr2njb","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830135844-qksx2bd","Type":"NodeParagraph","Properties":{"id":"20240830135844-qksx2bd","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子《*辞典》"}]},{"ID":"20240830135844-0xjn62h","Type":"NodeParagraph","Properties":{"id":"20240830135844-0xjn62h","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【出处】《开宝本草》"}]},{"ID":"20240830135844-hm76nvd","Type":"NodeParagraph","Properties":{"id":"20240830135844-hm76nvd","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShǐJūnZǐ"}]},{"ID":"20240830135844-bu7is1a","Type":"NodeParagraph","Properties":{"id":"20240830135844-bu7is1a","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【别名】留求子（《南方草木状》），史君子（侯宁极《药诺》），五梭子（《药材资料汇编》），索子果（《南宁市药物志》），冬均子、病柑子（《中药材手册》）。"}]},{"ID":"20240830135844-66o300c","Type":"NodeParagraph","Properties":{"id":"20240830135844-66o300c","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【来源】为使君子科植物使君子的成熟果实。9～10月间种子成熟，果皮变紫黑色时采摘，晒干或用微火烘干，即为使君子，一称\"壳君子\"。置通风干燥处，防蛀。"}]},{"ID":"20240830135844-0021q77","Type":"NodeParagraph","Properties":{"id":"20240830135844-0021q77","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830135844-b0gum7k","Type":"NodeParagraph","Properties":{"id":"20240830135844-b0gum7k","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"藤状灌木，嫩枝幼叶具黄色柔毛。叶对生，长圆形或长圆妆披针形，长4.5～15厘米，宽2～6厘米，先端渐尖，基部圆形或略呈心脏形，全缘，老叶下面，尤以叶脉及边缘处存留柔毛；叶柄长5～15毫米，下部有关节。叶落后关节以下部分成为棘状物；穗状花序生于枝条的顶端，下垂，略有芳香；每花下具有苞片1枚，披针形或线形，脱落性；萼筒细管状，伸出于子房上，长约6厘米，先端5裂齿，短三角形，有柔毛及腺毛；花瓣5，长圆形或倒卵形，长约1厘米，先端圆，基部宽楔形，与萼齿互生，蕾呈紫红色，而被覆盖的1/2部分呈白色，开放后渐转紫红色；雄蕊10，排成上下两轮，花丝着于萼筒，上轮5枚外露；雌蕊1，子房下位，圆柱状纺锤形，有5纵枝，具柔毛及腺毛，花柱细长，外露，下部与萼筒合生，柱头短。果实橄榄状，长2.5～4厘米，黑褐色或棕色，有5棱。花期5～9月。果期6～10月。"}]},{"ID":"20240830135844-ggty7oz","Type":"NodeParagraph","Properties":{"id":"20240830135844-ggty7oz","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"本植物的根（使君子根）、叶（使君子叶）亦供药用，各详专条。"}]},{"ID":"20240830135844-zs6fnt4","Type":"NodeParagraph","Properties":{"id":"20240830135844-zs6fnt4","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于平原灌木丛或路旁。分布福建、台湾、广西、江西、湖南、四川、贵州、云南及广东海南岛等地。主产四川、广东、广西。此外，福建、江西、云南、贵州等地亦产。"}]},{"ID":"20240830135844-dk0i5ht","Type":"NodeParagraph","Properties":{"id":"20240830135844-dk0i5ht","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实长卵形或椭圆形，具5条纵棱，两端尖，形如棱状，长2.5～4厘米，直径1.5～2厘米。外壳黑褐色或紫黑色，平滑，微有光泽；质坚硬，体轻，不易折断。切断面五角星形，棱角部皮较厚。内藏种子一粒。种仁狭纺锤形，长1.8～2.6厘米，直径0.6～1厘米。种皮灰白色，有黑灰斑块，质薄，易剥离而露出黄色的子叶，表面有多数纵皱纹。子叶2片，肥厚，边缘不整齐，胚根不明显。气微香；炒熟后较显着，味淡。以个大、颗粒饱满、种仁色黄、味香甜而带油性者为佳。"}]},{"ID":"20240830135844-q05oi29","Type":"NodeParagraph","Properties":{"id":"20240830135844-q05oi29","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含使君子酸钾，并含脂肪油20～27％。油中含油酸48.2％、棕树酸29.2％、硬脂酸9.1％、亚油酸9.0％、肉豆蔻酸4.5％、花生酸、甾醇。种子尚含蔗糖、葡萄糖、果糖、戊聚糖、苹果酸、柠檬酸、琥珀酸、生物碱如N-甲基烟酸内盐、脯氨酸等。果壳也含使君子酸钾。花含矢车菊素单糖甙。"}]},{"ID":"20240830135844-xd1aqom","Type":"NodeParagraph","Properties":{"id":"20240830135844-xd1aqom","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830135844-lgu00fh","Type":"NodeParagraph","Properties":{"id":"20240830135844-lgu00fh","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①驱虫作用"}]},{"ID":"20240830135844-b5m7r6d","Type":"NodeParagraph","Properties":{"id":"20240830135844-b5m7r6d","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"在体外试验中，使君子对猪蛔、蚯蚓、蚂蝗均有较强的驱除效能，并认为早年报告使君子无驱虫效力，乃因药品过于陈旧之故。用猪蛔首部描记法，证明使君子仁的提取物，在体外确有麻痹猪蛔首部的作用。并证明其有效成分为水溶性，甲醇中亦溶之，石油醚不溶，氯仿及纯乙醇似亦不溶。至于其驱虫有效成分究是何物，尚有争论。早期有人多方证明使君子对蚯蚓的作用可由其中所含之钾盐说明之，但钾盐对猪蛔并无作用，以蚯蚓作驱虫试验，实不可靠。曾从使君子中提取使君子酸钾，认为系驱虫的有效成分，但遭到怀疑，因为一则仅在蚯蚓身上有效，二则使君子酸的钠盐即使对蚯蚓也并无作用。后来试验使君子酸钾在玻管中对整体猪蛔有抑制现象，但作用较弱。在临床试验中，亦证明使君子酸钾的驱蛔能力与新鲜使君子仁的效力相近，而逊于山道年。亦有报告其中所含的吡啶与驱虫作用有关。另报告使君子固定油与蓖麻油混合剂对动物与人排虫率高，且无显著副作用（如呃逆、呕吐）。"}]},{"ID":"20240830135844-yve6kgi","Type":"NodeParagraph","Properties":{"id":"20240830135844-yve6kgi","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240830135844-9h2ke38","Type":"NodeParagraph","Properties":{"id":"20240830135844-9h2ke38","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子粉剂对自然感染的鼠蛲虫病有一定的驱蛲作用。与百部粉剂合用，效力较单用时好，且对幼虫亦稍有作用。水浸剂（1：3）在试管中对某些皮肤真菌有某些抑制作用。"}]},{"ID":"20240830135844-9mhel23","Type":"NodeParagraph","Properties":{"id":"20240830135844-9mhel23","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【炮制】使君子仁：除去外壳，取净仁。炒使君子仁：置锅内用文火炒至微有香气，取出，放凉。"}]},{"ID":"20240830135844-rz3c7cl","Type":"NodeParagraph","Properties":{"id":"20240830135844-rz3c7cl","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830135844-ypvsc12","Type":"NodeParagraph","Properties":{"id":"20240830135844-ypvsc12","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"甘，温。有毒。"}]},{"ID":"20240830135844-1v4aptr","Type":"NodeParagraph","Properties":{"id":"20240830135844-1v4aptr","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"味甘，温，无毒。\""}]},{"ID":"20240830135844-o9cfugv","Type":"NodeParagraph","Properties":{"id":"20240830135844-o9cfugv","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②《本草正》：\"味甘，气温，有小毒。\""}]},{"ID":"20240830135844-mts3w6i","Type":"NodeParagraph","Properties":{"id":"20240830135844-mts3w6i","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830135844-dzek6n7","Type":"NodeParagraph","Properties":{"id":"20240830135844-dzek6n7","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"入脾、胃经。"}]},{"ID":"20240830135844-jvzpne1","Type":"NodeParagraph","Properties":{"id":"20240830135844-jvzpne1","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾、胃二经。\""}]},{"ID":"20240830135844-tj2mwba","Type":"NodeParagraph","Properties":{"id":"20240830135844-tj2mwba","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入脾、胃、大肠。\""}]},{"ID":"20240830135844-dhg6ifd","Type":"NodeParagraph","Properties":{"id":"20240830135844-dhg6ifd","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足厥阴肝经、足太阴脾经。\""}]},{"ID":"20240830135844-1za1yai","Type":"NodeParagraph","Properties":{"id":"20240830135844-1za1yai","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830135844-w5kk8jg","Type":"NodeParagraph","Properties":{"id":"20240830135844-w5kk8jg","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"杀虫，消积，健脾。治蛔虫腹痛，小儿疳积，乳食停滞，腹胀，泻痢。"}]},{"ID":"20240830135844-b0iwaur","Type":"NodeParagraph","Properties":{"id":"20240830135844-b0iwaur","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"主小儿五疳，小便白浊，疗泻痢。\""}]},{"ID":"20240830135844-xdajix9","Type":"NodeParagraph","Properties":{"id":"20240830135844-xdajix9","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"健脾胃，除虚热。治小儿百病疮癣。\""}]},{"ID":"20240830135844-ymqn519","Type":"NodeParagraph","Properties":{"id":"20240830135844-ymqn519","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；或入丸、散。"}]},{"ID":"20240830135844-6tjbzr4","Type":"NodeParagraph","Properties":{"id":"20240830135844-6tjbzr4","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830135844-hun4tug","Type":"NodeParagraph","Properties":{"id":"20240830135844-hun4tug","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"服药时忌饮热茶。大量服用能引起呃逆、眩晕，呕吐等反应。"}]},{"ID":"20240830135844-g4emuih","Type":"NodeParagraph","Properties":{"id":"20240830135844-g4emuih","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"忌饮热茶，犯之即泻。\""}]},{"ID":"20240830135844-3h162ra","Type":"NodeParagraph","Properties":{"id":"20240830135844-3h162ra","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"忌食热物。\""}]},{"ID":"20240830135844-9v3u54e","Type":"NodeParagraph","Properties":{"id":"20240830135844-9v3u54e","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"脾胃虚寒之子，又不宜多用，多食则发呃。\"\"苟无虫积，服之必致损人。\""}]},{"ID":"20240830135844-ozlmxka","Type":"NodeParagraph","Properties":{"id":"20240830135844-ozlmxka","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830135844-5yqdcac","Type":"NodeParagraph","Properties":{"id":"20240830135844-5yqdcac","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①治小儿蛔虫咬痛，口吐清沫：使君子（去壳）为极细末，用米饮调，五更早空心服。（《补要袖珍小儿方论》使君子散）"}]},{"ID":"20240830135844-iaii9gs","Type":"NodeParagraph","Properties":{"id":"20240830135844-iaii9gs","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②治小儿疳蛔：使君子十个（瓦上炒，为末），甘草（胆汁浸一夕）、白芜荑各一分，苦楝子五个（炮，去核）。上末之，每服一钱，水煎服。（《幼科准绳》使君子散）"}]},{"ID":"20240830135844-12vcqcs","Type":"NodeParagraph","Properties":{"id":"20240830135844-12vcqcs","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"③治小儿五疳，脾胃不和，心腹膨胀，时复疞痛，不进饮食，渐致羸瘦：厚朴（去皮，姜汁炙）、陈皮（去白）、川芎各一分，使君子仁（浸，去黑皮）一两。上为细末。炼蜜丸如皂子大。三岁以上一粒，三岁以下半粒，陈米饮化下。（《局方》使君子丸）"}]},{"ID":"20240830135844-2teee1v","Type":"NodeParagraph","Properties":{"id":"20240830135844-2teee1v","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"④治小儿痞块腹大，肌瘦面黄，渐成疳疾：使君子仁三钱，木鳖子仁五钱。为末，水丸龙眼大。每以一丸，用鸡子一个破顶，入药在内，饭上蒸热，空心食。（《简便单方》）"}]},{"ID":"20240830135844-3207y2a","Type":"NodeParagraph","Properties":{"id":"20240830135844-3207y2a","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑤治黄病爱吃生米、茶叶、桴炭、泥土、瓦屑之类：使君子肉二两（切碎，微炒），槟榔二两，南星三两（俱用姜汁拌炒）。共为末，红曲打糊为丸，如梧桐子大。每服百余丸，乌梅，花椒汤送下。（《万病回春》）"}]},{"ID":"20240830135844-ci7iw4v","Type":"NodeParagraph","Properties":{"id":"20240830135844-ci7iw4v","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑥治虫牙疼痛：使君子煎汤，频漱。（《濒湖集简方》）"}]},{"ID":"20240830135844-675ojzm","Type":"NodeParagraph","Properties":{"id":"20240830135844-675ojzm","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑦治头瘗面疮：使君子仁，以香油少许，浸三、五个，临卧时细嚼，香油送下，久而自愈。（《普济方》）"}]},{"ID":"20240830135844-0c7jx39","Type":"NodeParagraph","Properties":{"id":"20240830135844-0c7jx39","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑧小儿脾疳。用使君子、芦荟，等分为末。每服一钱，米汤送下。"}]},{"ID":"20240830135844-3vnbxe2","Type":"NodeParagraph","Properties":{"id":"20240830135844-3vnbxe2","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑨小儿痞块（腹大，肌瘦而黄，渐成疳疾）。用使君子仁三钱、木鳖子仁五钱，共研为末，滴水做成丸子，如龙眼大。每取一丸，放入一个破了顶的鸡蛋中，饭上蒸熟，空心服。"}]},{"ID":"20240830135844-v0c5pep","Type":"NodeParagraph","Properties":{"id":"20240830135844-v0c5pep","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑩蛔虫病。用使君子为末，五更时以米汤调服一钱。"}]},{"ID":"20240830135844-26jqc9k","Type":"NodeParagraph","Properties":{"id":"20240830135844-26jqc9k","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑾小儿虚肿（头面、阴囊都有浮肿）。用使君子一两，去壳，加蜜五钱炙炙药，研细。每服一钱，饭后服，米汤送下。"}]},{"ID":"20240830135844-89l2j8e","Type":"NodeParagraph","Properties":{"id":"20240830135844-89l2j8e","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"⑿虫牙疼痛。有使君子煎汤频嗽。"}]},{"ID":"20240830135844-rup1d7y","Type":"NodeParagraph","Properties":{"id":"20240830135844-rup1d7y","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830135844-8j0c792","Type":"NodeParagraph","Properties":{"id":"20240830135844-8j0c792","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"凡杀虫药多是苦辛，惟使君、榧子，甘而杀虫，亦一异也。凡大人小儿有虫病，侵晨空腹食使君子仁数枚，或以壳煎汤咽下，次日虫皆死而出也。或云七生七煨食亦良。此物味甘气温，既能杀虫，又益脾胃，所以能敛虚热而止泻痢，为小儿诸病要药。\""}]},{"ID":"20240830135844-jgcshxv","Type":"NodeParagraph","Properties":{"id":"20240830135844-jgcshxv","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"使君子，为补脾健胃之要药。小儿五辩，便浊泻痢及腹虫，莫不皆由脾虚胃弱，因而乳食停滞，湿热瘀塞而成。脾健胃开，则乳饮自消，湿热自散，水道自利，而前证俱除矣。不苦不辛，而能杀疳蛔，此所以为小儿上药也。\""}]},{"ID":"20240830135844-9tnqr60","Type":"NodeParagraph","Properties":{"id":"20240830135844-9tnqr60","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"使君子，凡小儿食此，亦不宜频而多，大约性滑，多则能伤脾也。但使君子专杀蛔虫，榧子专杀寸白虫耳。\""}]},{"ID":"20240830135844-04kyw4a","Type":"NodeParagraph","Properties":{"id":"20240830135844-04kyw4a","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"④《本草正义》：\"使君子，甘温是温和之温，殊非温燥可比，故能助饮食之运化，而疏导肠中积滞，且富有脂液，所以滑利流通。《开宝》所谓小便白浊者，即指疳积症而言。凡小儿腹膨有积，每每小便如粉浆，此盖肾中输尿之路，分泄不清，即以饮食所化之精液，并入小溲而出，所见最多，非大人之赤白浊，不可误认。又谓其主泻痢，亦是疳积中之一症，惟其消化失职，以致大便改常，或为泄泻，或为积滞，此物又能助消化，且去积滞，故并治之，即濒湖所谓能益脾胃，除虚热，治小儿百病之意也。\""}]},{"ID":"20240830135844-tpapqqv","Type":"NodeParagraph","Properties":{"id":"20240830135844-tpapqqv","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830135844-c2jx1tr","Type":"NodeParagraph","Properties":{"id":"20240830135844-c2jx1tr","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"①治疗蛔虫病"}]},{"ID":"20240830135844-t63kgpr","Type":"NodeParagraph","Properties":{"id":"20240830135844-t63kgpr","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子用于驱蛔，近代作了较多观察，但结果不尽一致。据数十例至数百例的报告，服药后的排虫率自30左右至86％不等，大便复查虫卵阴转率一般约在30～40％上下，但亦有低至15.4％的。有人认为服药后多数患者蛔虫不能1次驱净，有重复用药的必要；但也有指出，反复用药并无多大裨益。用法：使君子仁（生仁或炒至香脆）嚼碎吞服，或然干研末开水送服，亦可制成煎剂服用。每日1决于空腹时或食后2小时左右服下，或每日2～3次分服，或连服2～3日。部分病例服后曾加服泻剂。剂量：有按每岁1粒服用的，有按每岁1克或每岁加1克（例如2岁为3克，3岁为4克，余类推）给药的，有按每公斤体重0.5克计算为1日量的，亦有按年龄大小给服5～10克不等的。但似以1岁1克或1岁加1克，最高量不超过10或16克；及按年龄大小给服10克（12岁以下）或20克（13岁以上）者效果较好。疗效高低与用法、剂量等有一定关系。煎剂效果不及原药吞服高，但副作用则较小。1次顿服较分次服用效果为佳。连服2日或3日并不比单次服用的疗效显著。剂量与疗效成一定的正比关系，用量小的（如1岁1粒）较用量大的（如1岁1克）疗效为低，副作用也较小。加服泻剂有谓可增加效力，但亦有认为易引起呕吐反应，无加用必要。副反应：最常见的为呃逆，其次为头晕、头痛、腹痛、腹泻等。一般均较轻微，可自行消失。"}]},{"ID":"20240830135844-cynklsf","Type":"NodeParagraph","Properties":{"id":"20240830135844-cynklsf","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"②治疗蛲虫病"}]},{"ID":"20240830135844-tqzlbgh","Type":"NodeParagraph","Properties":{"id":"20240830135844-tqzlbgh","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"将使君子仁炒熟，于饭前半小时嚼食。小儿每日3～15粒，，成人15～30粒，分3次服。连服15天为一疗程，隔1月再服一疗程。服药前后忌饮浓茶。一般经1～2疗程，症状即可消失。"}]},{"ID":"20240830135844-mi8wi2l","Type":"NodeParagraph","Properties":{"id":"20240830135844-mi8wi2l","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"③治疗肠道滴虫病"}]},{"ID":"20240830135844-bmwybt1","Type":"NodeParagraph","Properties":{"id":"20240830135844-bmwybt1","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"将使君子炒黄，成人嚼服，儿童研末服。剂量：1岁以内每日1钱，1～2次分服，1～3岁每日服1.5钱，成人日服1次，每次5钱，连服3～5天为一疗程；必要时隔3～5天后再服1～2个疗程。观察7例，其中成人3例，经一疗程治愈；婴儿4例，经2～3疗程治愈。"}]},{"ID":"20240830135844-bql5xhm","Type":"NodeParagraph","Properties":{"id":"20240830135844-bql5xhm","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830135844-zfv1jlm","Type":"NodeParagraph","Properties":{"id":"20240830135844-zfv1jlm","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"使君子《中华本草》"}]},{"ID":"20240830135844-8e2bpd5","Type":"NodeParagraph","Properties":{"id":"20240830135844-8e2bpd5","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830135844-7q92dqv","Type":"NodeParagraph","Properties":{"id":"20240830135844-7q92dqv","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"出自《开宝本草》。"}]},{"ID":"20240830135844-xfex7i7","Type":"NodeParagraph","Properties":{"id":"20240830135844-xfex7i7","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"1.《开宝本草》：使君子，生交、广等州。形如栀子，棱瓣深而两头尖，亦似诃黎勒而轻。俗传始因潘州郭使君疗小儿，多是独用此物，后来医家因号为使君子也。"}]},{"ID":"20240830135844-d5p3wtc","Type":"NodeParagraph","Properties":{"id":"20240830135844-d5p3wtc","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》：使君子，今医家或兼用壳。"}]},{"ID":"20240830135844-diy8r6k","Type":"NodeParagraph","Properties":{"id":"20240830135844-diy8r6k","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShǐJūnZǐ"}]},{"ID":"20240830135844-veukwgg","Type":"NodeParagraph","Properties":{"id":"20240830135844-veukwgg","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【英文名】RangooncreeperFruit,FruitofRangooncreeper"}]},{"ID":"20240830135844-n45561u","Type":"NodeParagraph","Properties":{"id":"20240830135844-n45561u","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【别名】留求子、史君子、五棱子、索子果、冬均子、病柑子、君子仁、冬君子、病疳子。"}]},{"ID":"20240830135844-qzvcdq9","Type":"NodeParagraph","Properties":{"id":"20240830135844-qzvcdq9","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830135844-ont2pta","Type":"NodeParagraph","Properties":{"id":"20240830135844-ont2pta","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"药材基源：为使君子科植物使君子的成熟果实。"}]},{"ID":"20240830135844-ohysj3l","Type":"NodeParagraph","Properties":{"id":"20240830135844-ohysj3l","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：QuisqualisindicaL."}]},{"ID":"20240830135844-rd7trft","Type":"NodeParagraph","Properties":{"id":"20240830135844-rd7trft","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后3年开始结果。8月以后，当果壳由绿变棕褐或黑褐色时采收。用竹竿击落果实，晒干或烘干。"}]},{"ID":"20240830135844-9gtc673","Type":"NodeParagraph","Properties":{"id":"20240830135844-9gtc673","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶攀援状灌木，高2-8m。幼枝被棕黄色短柔毛。叶对生或的对生；吉柄无关节，在落叶后宿存；叶片膜质，卵形或椭圆形，长5-11cm，宽2.5-5.5cm，先端短渐尖，基部钝圆，表面无毛，背面有时疏被棕色柔毛，顶生穗状花序组成伞房状序；花两性；苞片卵形至线状披针形，被毛；萼管长5-9cm，被共同色柔毛，先端具广展、外弯、小形的萼齿5枚；花瓣5，长1.8-2.4cm，宽4-10mm，先端钝圆，初为白色，后转淡红色；雄蕊10.2轮，不突出冠外，花药长约1.5mm；子房下位。果卵形，短尖，长2.7-4cm，径1.2-2.3cm，无毛，具明显的锐棱角5条，成熟时外果皮脆薄，呈青黑色或栗色。种子1颗，折色，圆柱状纺锤形，长2.5cm，径约1cm。花期5-9月，果期秋末。"}]},{"ID":"20240830135844-wcjs1fw","Type":"NodeParagraph","Properties":{"id":"20240830135844-wcjs1fw","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830135844-19eutqo","Type":"NodeParagraph","Properties":{"id":"20240830135844-19eutqo","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"生态环境：生于平地、山坡、路旁等向阳灌丛中，变有栽培。"}]},{"ID":"20240830135844-lkck178","Type":"NodeParagraph","Properties":{"id":"20240830135844-lkck178","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及江西、福建、台湾、湖南、广东、广西等地。"}]},{"ID":"20240830135844-cn17a7a","Type":"NodeParagraph","Properties":{"id":"20240830135844-cn17a7a","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830135844-7qesl2p","Type":"NodeParagraph","Properties":{"id":"20240830135844-7qesl2p","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿泣气候，不耐寒，怕霜冻，耐荫蔽。宜选向阳避风土层深厚、中等肥力、黄色或黑色的砂壤土栽培、栽培技术用种子、分株、扦插和压条繁殖。种子育苗移栽：于秋季采成熟饱满果实，随采随播，或混湿沙贮藏春播。实生苗高30cm左右即可定植。分株繁殖：于3月份，按取健壮母株的萌蘖移栽。扦插繁殖：有枝插法和根插法。枝插法，2-3月或9-10月，剪取1-2年生健壮枝条作插条，插条长20-25cm，斜插于苗床上，于次年移植。根插法，12月至次年1-2月，将距离主根30cm以外的部分侧根切断挖出，选径粗1cm以上的剪成长约20cm的插条，扦插于苗床，1年后移植。压条繁殖：2-3月先健壮长枝，弯曲埋入土中，或波状压条，生根后截取移植。以上方法繁殖的种苗，在2月中、下旬或雨季定植。行株距3.3m×2.3m，穴中施厩肥，与土混匀，每穴栽苗1株，栽后浇水定根。"}]},{"ID":"20240830135844-0dmgkhc","Type":"NodeParagraph","Properties":{"id":"20240830135844-0dmgkhc","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"田间管理定植后1-2年，经常中耕除草，每年追肥2-3次。进入结果期后，後年于萌芽时及采果后各追肥1次。冬季要注意培土或覆盖杂草于基部防寒。成往栽种的应搭棚供其攀缘。每年早春或采果后修剪1次，使枝条分布均匀。成片栽种的应搭棚供其攀缘。"}]},{"ID":"20240830135844-dr02kus","Type":"NodeParagraph","Properties":{"id":"20240830135844-dr02kus","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"病虫害防治防止诃子瘤蚜为害，防治方法参邮“诃子”条。"}]},{"ID":"20240830135844-6837xn1","Type":"NodeParagraph","Properties":{"id":"20240830135844-6837xn1","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830135844-6u5cn7a","Type":"NodeParagraph","Properties":{"id":"20240830135844-6u5cn7a","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"性状鉴别果实椭圆形或卵圆形，具5条纵棱，偶有4-9棱，长2.5-4cm，直径约2cm，表面黑褐色至紫褐色，平滑，微具光泽，先端狭尖，基部钝圆，有明显圆形的果梗痕；质坚硬，横切面多呈五角星形，棱角外壳较厚，中间呈类圆形空腔。种子长椭圆形或纺锤形，长约2cm，直径约1cm，表面棕褐色或黑褐色，有多数纵皱纹；种皮薄，易剥离；子叶2，黄白色，有油性，断面有裂纹。气微香，味微甜。"}]},{"ID":"20240830135844-wubicgv","Type":"NodeParagraph","Properties":{"id":"20240830135844-wubicgv","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"以个大、表面具紫褐色光泽、仁饱满、色共同白者为佳。"}]},{"ID":"20240830135844-4pqv4kl","Type":"NodeParagraph","Properties":{"id":"20240830135844-4pqv4kl","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"显微鉴别种子横切面：种皮表皮细胞由大形薄壁细胞组成，内含棕色物质。表皮以下为网纹细胞层，细胞切向延长，有网状纹理，并常散有小形维管束。子叶细胞含脂肪油滴和众多草酸钙簇晶，直径10-15μm。"}]},{"ID":"20240830135844-jydgtpu","Type":"NodeParagraph","Properties":{"id":"20240830135844-jydgtpu","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830135844-7xe3nei","Type":"NodeParagraph","Properties":{"id":"20240830135844-7xe3nei","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"种子含使君子氨酸（quisqualicacid)[1]，使君子氨酸钾（potassiumquisqualate)，甘露醇（D-mannitlo)[2]；脂肪油23.9%，油中含肉豆蔻酸（myristicacid)4。5%，棕榈酸（palmiticacid)29.2%，硬脂酸（stearicacid)9.1%，油酸（oleicacid)48.2%，亚油酸（linoleicacid)9.0%等脂肪酸；并含甾醇，以植物甾醇（phytosterol)为主[3]。"}]},{"ID":"20240830135844-0omt1ea","Type":"NodeParagraph","Properties":{"id":"20240830135844-0omt1ea","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"果肉含胡芦巴碱（trigonelline)[4]，枸椽酸（citricacid)，琥珀酸（succinicacid)，苹果酸（malicacid)，蔗糖（sucrose)，葡萄糖（glucose)；脂肪油中含棕榈酸32.0%，油酸49.0%，另含甾醇0.4%[5]。"}]},{"ID":"20240830135844-5wexqq2","Type":"NodeParagraph","Properties":{"id":"20240830135844-5wexqq2","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830135844-xobzi98","Type":"NodeParagraph","Properties":{"id":"20240830135844-xobzi98","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"1.驱蛔虫作用：使君子在体外试验中对蚯蚓、水蛭、猪蛔等均有较强的抑制效果。如曾报告10%的使君子水浸膏于0.5-2小时内可使蚯蚓昏迷或死亡，但95%乙醇浸膏无效。有人试验了20种中药的50%乙醇提出物对猪蛔、蚯蚓及水蛭的杀虫效果，结果使君子、鹤虱、芜荑、槟榔、贯众、川楝子、雷丸及吴茱萸等8种有显着作用，其中尤以使君子的作用为强。猪蛔首部描记法实验表明，使君子仁提取物有较强的麻痹猪蛔首部作用，在麻痹之前，往往先有刺激现象，其有效成分为水溶性，高浓度酒精、石油醚及氯仿提出物均无效，使君子灰分也无效。使君子驱蛔有效成分一般认为系其所含之使君子酸钾。使君子酸钾在体外对整体猪蛔有明显的抑制作用，但不能杀死它。日本人从毛使君子中提得的使君子酸，对猪蛔也有明显作用，能引起整体猪蛔运动失调，其最低有效浓度为1：1000。但也有人曾从使君子提得吡啶及其同类物，含量约千分之一，而吡啶类有杀虫及驱虫效能，故认为使君子的驱蛔作用可能与此也有关。另还有报告使君子油与蓖麻油之混合物对人与动物也均有明显的驱蛔效果。"}]},{"ID":"20240830135844-32ux9w6","Type":"NodeParagraph","Properties":{"id":"20240830135844-32ux9w6","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"2.驱蛲虫作用：对于自然感染鼠蛲虫的小鼠的实验结果表明，使君子粉、使君子和百部粉合用均有一定的驱蛲作用，对于幼虫，使君子粉剂无效，但使君子粉剂和百部粉剂合用，则稍有效果。"}]},{"ID":"20240830135844-8chcul0","Type":"NodeParagraph","Properties":{"id":"20240830135844-8chcul0","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"3.抗皮肤真菌作用：使君子水浸剂在体外对堇色毛癣菌、同心性毛癣菌、许兰氏黄癣菌、奥杜盎氏小芽孢癣菌、铁锈色小芽孢癣菌、羊毛状小芽孢癣菌、腹股沟表皮癣菌、星形奴卡氏菌等皮肤真菌有不同程度的抑制作用。"}]},{"ID":"20240830135844-z92n1wi","Type":"NodeParagraph","Properties":{"id":"20240830135844-z92n1wi","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"4.其他作用：使君子粉剂对自然感染的鼠蛲虫病有一定的驱蛲作用。与百部粉剂合用，效力较单用时好，且对幼虫亦稍有作用。水浸剂（1：3）在试管中对某些皮肤真菌有某些抑制作用。抗肠寄生虫：水浸剂或乙醇浸剂36%浓度，对体外保温培养的猪蛔虫5分钟可使麻痹；使君子油40%浓度，经30分钟，尚不能麻痹猪蛔虫，而去油水浸剂19%浓度3分钟即可使猪蛔虫麻痹，在虫体麻痹前均先有短暂兴奋现象；使君子仁、壳及叶100%前剂对蚯蚓有麻痹作用，叶作用强于仁、壳，而毒性较小；0.1%使君子酸钾可使蚯蚓在8小时内死亡，对猪蛔虫亦有抑制作用。"}]},{"ID":"20240830135844-c7xbqyp","Type":"NodeParagraph","Properties":{"id":"20240830135844-c7xbqyp","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【毒性】使君子毒性不大，粗制品（26.6g/kg）给犬口服，除产生呕吐、呃逆外，并无其他中毒症状，其树胶于0.83g/kg时亦产生同样作用。水浸膏皮下注射于小鼠，数分钟后，即呈抑制状态，呼吸缓慢不整，1-2小时后全身发生轻度惊厥，随即呼吸停止。最小致死量约为20g/kg。使君子油50-100mg／10g给小鼠或家兔口服，未见中毒现象。毒性：粗制剂26.6g/kg或所含树胶0.83g/kg灌胃，均可使狗产生呃逆、呕吐及中枢抑制；小鼠皮下注射先呈抑制，继而痉挛，最后因呼吸抑制致死，最小致死量为20g/kg。"}]},{"ID":"20240830135844-prh3bti","Type":"NodeParagraph","Properties":{"id":"20240830135844-prh3bti","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粗粉5g，用石油醚50ml，50℃浸1h脱脂，滤过。残渣用40%已醇20ml，滤过，滤液减压浓缩至干。取少量浓缩物，用50%甲醇水溶液溶液解，点于滤纸上，喷洒茚三酮试液，在100℃左右烘箱中放置1-2min，呈现紫色斑点。（检查氨基酸）（2）薄层色谱取上述已醇提取的浓缩物，用50%甲醇溶解，以使君子酸钾、α-脯氨酸、α-天冬素为对照。同点于硅胶G薄层板上，以正丁醇-醋酸-水（4：1：1）展开，展距13cm。用茚三酮试剂显色，样品与对照品对应的位置处显相同颜色的斑点。"}]},{"ID":"20240830135844-i7y7k9m","Type":"NodeParagraph","Properties":{"id":"20240830135844-i7y7k9m","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【炮制】使君子仁：除去外壳，取净仁。炒使君子仁：置锅内用文火炒至微有香气，取出，放凉。"}]},{"ID":"20240830135844-p4oerk1","Type":"NodeParagraph","Properties":{"id":"20240830135844-p4oerk1","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；性温；小毒"}]},{"ID":"20240830135844-ezpaudr","Type":"NodeParagraph","Properties":{"id":"20240830135844-ezpaudr","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【归经】归脾；胃经"}]},{"ID":"20240830135844-csm4zud","Type":"NodeParagraph","Properties":{"id":"20240830135844-csm4zud","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫；消积；健脾。主蛔虫腹痛；小儿疳积；乳食停滞；腹胀；泻痢"}]},{"ID":"20240830135844-nn3hh6n","Type":"NodeParagraph","Properties":{"id":"20240830135844-nn3hh6n","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-15g，捣碎入煎；或入丸、散；去壳炒香嚼服，小儿每岁每日1粒-1粒半，总量不起过20粒。"}]},{"ID":"20240830135844-jr578k9","Type":"NodeParagraph","Properties":{"id":"20240830135844-jr578k9","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【注意】服药时忌饮热茶。大量服用能引起呃逆、眩晕、呕吐等反应。《纲目》：忌饮热茶，犯之即泻。《本草经疏》：忌食热物。《本草汇言》：脾胃虚寒之子，又不宜多用，多食则发呃。苟无虫积，服之必致损人。"}]},{"ID":"20240830135844-h5nl3sx","Type":"NodeParagraph","Properties":{"id":"20240830135844-h5nl3sx","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【附方】使君子散《补要袖珍小儿方论》；使君子散《幼科准绳》；使君子丸《和剂局方》"}]},{"ID":"20240830135844-ev1vm80","Type":"NodeParagraph","Properties":{"id":"20240830135844-ev1vm80","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830135844-6yszjm2","Type":"NodeParagraph","Properties":{"id":"20240830135844-6yszjm2","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目》：凡杀虫药多是苦辛，惟使君、榧子，甘而杀虫，亦一异也。凡大人小儿有虫病，侵晨空腹食使君子仁数枚，或以壳煎汤咽下，次日虫皆死而出也。或云七生七煨食亦良。此物味甘气温，既能杀虫，又益脾胃，所以能敛虚热而止泻痢，为小儿诸病要药。"}]},{"ID":"20240830135844-f37up0e","Type":"NodeParagraph","Properties":{"id":"20240830135844-f37up0e","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：使君子，为补脾健胃之要药，小儿五疳，便浊泻痢及腹虫，莫不皆由脾虚胃弱，因而乳食停滞，湿热瘀塞而成，脾健胃开，则乳饮自消，湿热自散，水道自利，而前证俱除矣。不苦不辛，而能杀疳蛔，此所以为小儿上药也。"}]},{"ID":"20240830135844-8juro10","Type":"NodeParagraph","Properties":{"id":"20240830135844-8juro10","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：使君子，凡小儿食此，亦不宜频而多，大约性滑，多则能伤脾也。但使君子专杀蛔虫，榧子专杀寸白虫耳。"}]},{"ID":"20240830135844-d0eqx9z","Type":"NodeParagraph","Properties":{"id":"20240830135844-d0eqx9z","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：使君子，甘温是温和之温，殊非温燥可比，故能助饮食之运化，而疏导肠中积滞，且富有脂液，所以滑利流通。《开宝》所谓小便白浊者，即指疳积症而言。凡小儿腹膨有积，每每小便如粉浆，此盖肾中输尿之路，分泄不清，即以饮食所化之精液，并入小溲而出，所见最多，非大人之赤白浊，不可误认。又谓其主泻痢，亦是疳积中之一症，惟其消化失职，以致大便改常，或为泄泻，或为积滞，此物又能助消化，且去积滞，故并治之，即濒湖所谓能益脾胃，除虚热，治小儿百病之意也。"}]},{"ID":"20240830135844-md81ulj","Type":"NodeParagraph","Properties":{"id":"20240830135844-md81ulj","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"5.《开宝本草》：主小儿五疳，小便白浊，疗泻痢。"}]},{"ID":"20240830135844-bq76bfa","Type":"NodeParagraph","Properties":{"id":"20240830135844-bq76bfa","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"6.《本草纲目》：健脾胃，除虚热。治小儿百病疮癣。"}]},{"ID":"20240830135844-ujnnwsk","Type":"NodeParagraph","Properties":{"id":"20240830135844-ujnnwsk","updated":"20240830135919"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830135845-mn3y8og","Type":"NodeThematicBreak","Properties":{"id":"20240830135845-mn3y8og","updated":"20240830135919"}},{"ID":"20240830135846-rsh60u0","Type":"NodeParagraph","Properties":{"id":"20240830135846-rsh60u0","updated":"20240830135919"}}]}