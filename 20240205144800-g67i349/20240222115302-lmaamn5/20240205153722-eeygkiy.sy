ype":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实 3-20240826145859-xjalrh7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 563px;\" parent-style=\"width: 573px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 328px;","style":"width: 318px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实2-20240702115155-ncjx1v7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 318px;\" parent-style=\"width: 328px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161504-cxpnji9","Type":"NodeParagraph","Properties":{"id":"20240902161504-cxpnji9","updated":"20240902161504"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"width: 621px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实 4-20240826150015-t70clh6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 621px;\" parent-style=\"width: 631px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 634px;","style":"width: 624px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实10-20240702122310-w3068mj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 624px;\" parent-style=\"width: 634px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161504-pj2aswi","Type":"NodeParagraph","Properties":{"id":"20240902161504-pj2aswi","updated":"20240902161504"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 785px;","style":"width: 775px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦楝树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦楝树-20240902161403-8velu5m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 775px;\" parent-style=\"width: 785px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 446px;","style":"width: 436px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实 6-20240826150233-pvytps9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 436px;\" parent-style=\"width: 446px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161504-b39fgwk","Type":"NodeParagraph","Properties":{"id":"20240902161504-b39fgwk","updated":"20240902161504"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 459px;","style":"width: 449px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702115742-4pw7h44.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 449px;\" parent-style=\"width: 459px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 808px;","style":"width: 798px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实7-20240702115620-neiqzvp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 798px;\" parent-style=\"width: 808px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724102627-mf9cjyb","Type":"NodeThematicBreak","Properties":{"id":"20240724102627-mf9cjyb"}},{"ID":"20240902161530-cxdendb","Type":"NodeParagraph","Properties":{"id":"20240902161530-cxdendb","updated":"20240902161539"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：苦楝皮"}]},{"ID":"20240902161530-p7qf011","Type":"NodeParagraph","Properties":{"id":"20240902161530-p7qf011","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝皮《全国中草药汇编》"}]},{"ID":"20240902161530-dqjide6","Type":"NodeParagraph","Properties":{"id":"20240902161530-dqjide6","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【拼音名】KǔLiànPí"}]},{"ID":"20240902161530-ez1y1io","Type":"NodeParagraph","Properties":{"id":"20240902161530-ez1y1io","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【英文名】CORTEXMELIAE"}]},{"ID":"20240902161530-jgf2p61","Type":"NodeParagraph","Properties":{"id":"20240902161530-jgf2p61","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【别名】苦楝、楝树果、楝枣子、苦楝树、森树、翠树、紫花树、川楝皮"}]},{"ID":"20240902161530-0of3kkt","Type":"NodeParagraph","Properties":{"id":"20240902161530-0of3kkt","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【来源】本品为楝科植物川楝Meliatoosendansieb.etZucc.或楝MeliaazedarachL.的干燥树皮及根皮。春、秋二季剥取，晒干，或除去粗皮，晒干。"}]},{"ID":"20240902161530-upc5xsz","Type":"NodeParagraph","Properties":{"id":"20240902161530-upc5xsz","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则板片状、槽状或半卷筒状，长宽不一，厚2～6mm。外表面灰棕色或灰褐色，粗糙，有交织的纵皱纹及点状灰棕色皮孔，除去粗皮者淡黄色；内表面类白色或淡黄色。质韧，不易折断，断面纤维性，呈层片状，易剥离。无臭，味苦。"}]},{"ID":"20240902161530-k5ggpgx","Type":"NodeParagraph","Properties":{"id":"20240902161530-k5ggpgx","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902161530-gr9xy0x","Type":"NodeParagraph","Properties":{"id":"20240902161530-gr9xy0x","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"（1）取本品一段，用手折叠揉搓，可分为多层薄片，层层黄白相间，每层薄片有极细的网纹。"}]},{"ID":"20240902161530-dffaxww","Type":"NodeParagraph","Properties":{"id":"20240902161530-dffaxww","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末约1g，加乙醚10ml，浸渍2小时，时时振摇，滤过。取滤液1ml，挥干后，滴加对二甲氨基苯甲醛试液数滴，显红色；另取滤液1ml，置试管中，挥干后，加醋酐1ml，搅拌，沿管壁加硫酸数滴，醋酐层显绿色，硫酸层显红色至紫红色。"}]},{"ID":"20240902161530-krxa7ki","Type":"NodeParagraph","Properties":{"id":"20240902161530-krxa7ki","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末2g，加丙酮25ml，超声处理25分钟，滤过，滤液蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取苦楝皮对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上，以苯-丙酮（40：1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240902161530-12uw6cm","Type":"NodeParagraph","Properties":{"id":"20240902161530-12uw6cm","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切丝，干燥。"}]},{"ID":"20240902161530-f36oq28","Type":"NodeParagraph","Properties":{"id":"20240902161530-f36oq28","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒；有毒。"}]},{"ID":"20240902161530-j5dbmi9","Type":"NodeParagraph","Properties":{"id":"20240902161530-j5dbmi9","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾、胃经。"}]},{"ID":"20240902161530-u2eo3g1","Type":"NodeParagraph","Properties":{"id":"20240902161530-u2eo3g1","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【功能主治】驱虫，疗癣。用于蛔蛲虫病，虫积腹痛；外治疥癣瘙痒。"}]},{"ID":"20240902161530-8c8llj2","Type":"NodeParagraph","Properties":{"id":"20240902161530-8c8llj2","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。外用适量，研末，用猪脂调敷患处。"}]},{"ID":"20240902161530-pwyc1xs","Type":"NodeParagraph","Properties":{"id":"20240902161530-pwyc1xs","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【注意】肝炎、肾炎患者慎服。"}]},{"ID":"20240902161530-dh9e7kb","Type":"NodeParagraph","Properties":{"id":"20240902161530-dh9e7kb","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防潮。"}]},{"ID":"20240902161530-80u0rul","Type":"NodeParagraph","Properties":{"id":"20240902161530-80u0rul","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902161530-a0y7b1i","Type":"NodeParagraph","Properties":{"id":"20240902161530-a0y7b1i","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝皮《*辞典》"}]},{"ID":"20240902161530-ke3iw9m","Type":"NodeParagraph","Properties":{"id":"20240902161530-ke3iw9m","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【出处】《证类本草》"}]},{"ID":"20240902161530-mwbr062","Type":"NodeParagraph","Properties":{"id":"20240902161530-mwbr062","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【拼音名】KǔLiànPí"}]},{"ID":"20240902161530-altw0pv","Type":"NodeParagraph","Properties":{"id":"20240902161530-altw0pv","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【别名】楝皮（《斗门方》），楝根木皮（《纲目》），双白皮（《南京民间药草》）。"}]},{"ID":"20240902161530-ewvjm1h","Type":"NodeParagraph","Properties":{"id":"20240902161530-ewvjm1h","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【来源】为楝科植物苦楝或川楝的根皮或干皮。四时可采，但以春末夏初为宜。砍下树干或挖出树根，剥取根皮或干皮，洗净晒干。"}]},{"ID":"20240902161530-b5qm434","Type":"NodeParagraph","Properties":{"id":"20240902161530-b5qm434","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902161530-pbsf619","Type":"NodeParagraph","Properties":{"id":"20240902161530-pbsf619","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①苦楝（《证类本草》），义名：翠树、紫花树、森树、楝枣树、火棯树、花心树、苦辣树、洋花森。"}]},{"ID":"20240902161530-s4k01ts","Type":"NodeParagraph","Properties":{"id":"20240902161530-s4k01ts","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高15～20米。树皮暗褐色，幼枝有星状毛，旋即脱落，老枝紫色，有细点状皮孔。2回羽状复叶，互生，长20～80厘米；小叶卵形至椭圆形，长3～7厘米，宽2～3厘米，基部阔楔形或圆形，先端长尖，边缘有齿缺，上面深绿，下面浅绿，幼时有星状毛，稍后除叶脉上有白毛外，余均无毛。圆锥花序腋生；花淡紫色，长约1厘米；花萼5裂，裂片披针形，两面均有毛；花瓣5，平展或反曲，倒披针形；雄蕊管通常暗紫色，长约7毫米。核果圆卵形或近球形，长约3厘米，淡黄色，4～5室，每室具种子1枚。花期4～5月。果期10～11月。"}]},{"ID":"20240902161530-jfgc6dn","Type":"NodeParagraph","Properties":{"id":"20240902161530-jfgc6dn","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"多生于路旁、坡脚，或栽于屋旁、篱边。北至河北，南至云南、广西，西至四川，都有分布。"}]},{"ID":"20240902161530-gz1vjhx","Type":"NodeParagraph","Properties":{"id":"20240902161530-gz1vjhx","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②川楝，详\"川楝子\"条。"}]},{"ID":"20240902161530-hp2r42k","Type":"NodeParagraph","Properties":{"id":"20240902161530-hp2r42k","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产四川、湖北、安徽、江苏、河南、贵州等地。此外，陕西、山东、云南、甘肃等地亦产。"}]},{"ID":"20240902161530-lbmk0mf","Type":"NodeParagraph","Properties":{"id":"20240902161530-lbmk0mf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902161530-zq441su","Type":"NodeParagraph","Properties":{"id":"20240902161530-zq441su","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①根皮"}]},{"ID":"20240902161530-7y56e1z","Type":"NodeParagraph","Properties":{"id":"20240902161530-7y56e1z","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"呈不规则条块、片状或槽状，长短宽窄不一，厚约3～6毫米。外表面灰褐色或灰棕色，皮孔大而明显，有不规则的纵裂深沟纹，木栓层常作鳞片状，衰老的栓皮常剥落。露出砖红色的内皮；内表面淡黄色，有细纵纹。质坚韧，不易折断。断面纤维成层，可层层剥离，剥下的薄片，有极细的网纹。气微弱，味极苦。以干燥、皮厚、条大、无槽朽、去栓皮者为佳。"}]},{"ID":"20240902161530-rvusnbw","Type":"NodeParagraph","Properties":{"id":"20240902161530-rvusnbw","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②干皮"}]},{"ID":"20240902161530-c1rukgf","Type":"NodeParagraph","Properties":{"id":"20240902161530-c1rukgf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"呈槽形的片状或长卷筒状。长短不一，长约30～100厘米，宽3～10厘米，厚3～7毫米，外表面灰褐色或灰棕色，较平坦，有多数纵向裂纹及横向延长的皮孔。内表面白色或淡黄色。质坚脆，易折断，断面纤维性层片状。气味与根皮同。以外表皮光滑、不易剥落，可见多皮孔的幼嫩树皮为佳。"}]},{"ID":"20240902161530-uxt2ajk","Type":"NodeParagraph","Properties":{"id":"20240902161530-uxt2ajk","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902161530-mpxejsr","Type":"NodeParagraph","Properties":{"id":"20240902161530-mpxejsr","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝含有多种苦味的三萜类成分。"}]},{"ID":"20240902161530-9shuyou","Type":"NodeParagraph","Properties":{"id":"20240902161530-9shuyou","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"在根皮、干皮中的主要苦味成分为苦楝素，即川楝素和另一尚未完全确定的微量成分。还含有其他苦味成分：印楝波灵A、印楝波灵B、梣皮酮、葛杜宁、苦里酮、苦内酯、苦洛内酯，以及苦楝子三醇等。"}]},{"ID":"20240902161530-iat5qmf","Type":"NodeParagraph","Properties":{"id":"20240902161530-iat5qmf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"在干皮中还有正卅烷、β-谷甾醇、葡萄糖和其他微量成分。"}]},{"ID":"20240902161530-pm75c0l","Type":"NodeParagraph","Properties":{"id":"20240902161530-pm75c0l","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"从日本产苦楝的韧皮部中，曾得到一个具有与山道年类似杀虫作用的化合物，还分离出香荚兰酸和dl-儿茶精，前者能驱除蛔虫与短膜壳绦虫。又从苦楝变种的叶子，分离出二种黄酮体：芸香甙和山柰酚-3-L-鼠李糖-D-葡萄糖甙。"}]},{"ID":"20240902161530-rdotpbl","Type":"NodeParagraph","Properties":{"id":"20240902161530-rdotpbl","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"果实中的苦味成分有苦楝子酮、苦楝子醇。还有4，4，8-三甲基-3β，7α，23-三羟基-胆甾-14，24-二烯-21-羧酸-21，23-内酯。"}]},{"ID":"20240902161530-0lgjr8w","Type":"NodeParagraph","Properties":{"id":"20240902161530-0lgjr8w","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"从日本苦楝的果实和果皮中，除得到苦楝子酮外，还有楝酮乙酸酯和去乙酰杜楝质等。"}]},{"ID":"20240902161530-t78hxsy","Type":"NodeParagraph","Properties":{"id":"20240902161530-t78hxsy","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"种子油含多种脂肪酸，其中不饱和酸约占35％，主成分为亚油酸（45～50％）、油酸（32～40％）。果实油含肉豆蔻酸、亚油酸、油酸、棕榈酸、棕榈油酸。"}]},{"ID":"20240902161530-9a2ghmx","Type":"NodeParagraph","Properties":{"id":"20240902161530-9a2ghmx","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902161530-nqw3naf","Type":"NodeParagraph","Properties":{"id":"20240902161530-nqw3naf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"川楝、苦楝的根皮或干皮（剥去外层棕色粗皮的内白皮）中所含的苦楝素，有驱蛔作用。早年即证明，苦楝皮的酒精提取物在体外对猪蛔，特别对其头部具有麻痹作用，自提得其有效成分苦楝素后，作用远较酒精提取物为强，与山道年相比，则缓慢而持久。对其作用原理有二种说法：用较高浓度（1：1000以上）的苦楝素对猪蛔作用的观察，认为它能麻痹猪蛔，特别是其头部的神经节；用较低浓度（1：5000～9000）的苦楝素，则观察到对猪蛔及其节段（头部及中部）有明显的兴奋作用，表现为自发活动增强，间歇地出现异常的剧烈收缩，破坏其运动的规律性（活动增强与减弱相交替），并能持续较长时期（10～24小时）。此种兴奋作用乃是苦楝素透过虫体表皮，直接作用于蛔虫肌肉，扰乱其能量代谢，导致收缩性疲劳而痉挛，最后使虫体不能附着肠壁而被驱除体外。所谓麻痹作用，可能是虫体长期受药物作用后而呈间歇性痉挛收缩的貌似静止状态。临床上服苦楝素排虫时间较迟（24～48小时），排出的虫体多数尚能活动，由此可得到解释。"}]},{"ID":"20240902161530-169dvd5","Type":"NodeParagraph","Properties":{"id":"20240902161530-169dvd5","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"高浓度的苦楝药液（25～50％）在体外对鼠蛲虫也有麻痹作用。苦楝子的酒精浸液，对若干常见的致病性真菌在体外有较明显的抑制作用；热水提取物也有抗真菌作用；但水浸剂特别是煎剂，效力较醇浸剂弱。因此，苦楝子治疗头癣等真菌感染时，用酒精制剂可望提高疗效。苦楝素能兴奋兔在位及离体肠肌，使张力和收缩力增加，故用以驱虫时，不需另加泻药，对血象、血压，呼吸、子宫等均无明显影响。"}]},{"ID":"20240902161530-kcc57pr","Type":"NodeParagraph","Properties":{"id":"20240902161530-kcc57pr","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【炮制】洗净，稍浸泡，润透，切丝，晒干。"}]},{"ID":"20240902161530-oosj2e2","Type":"NodeParagraph","Properties":{"id":"20240902161530-oosj2e2","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902161530-q9ijj0d","Type":"NodeParagraph","Properties":{"id":"20240902161530-q9ijj0d","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦，寒，有毒。"}]},{"ID":"20240902161530-qzct81a","Type":"NodeParagraph","Properties":{"id":"20240902161530-qzct81a","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微寒。\""}]},{"ID":"20240902161530-4mixk51","Type":"NodeParagraph","Properties":{"id":"20240902161530-4mixk51","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"苦，微毒。\""}]},{"ID":"20240902161530-ee5ge68","Type":"NodeParagraph","Properties":{"id":"20240902161530-ee5ge68","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑧《医林籍要》：\"大苦，大寒。\""}]},{"ID":"20240902161530-hv79okg","Type":"NodeParagraph","Properties":{"id":"20240902161530-hv79okg","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902161530-08wprvh","Type":"NodeParagraph","Properties":{"id":"20240902161530-08wprvh","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"清热，燥湿，杀虫。治蛔虫，蛲虫，风疹，疥癣。"}]},{"ID":"20240902161530-0n4xu13","Type":"NodeParagraph","Properties":{"id":"20240902161530-0n4xu13","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"疗蛔虫，利大肠。\""}]},{"ID":"20240902161530-jxt2yht","Type":"NodeParagraph","Properties":{"id":"20240902161530-jxt2yht","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"根：以苦酒摩涂疥；煮汁作糜，食之去蛔虫。\""}]},{"ID":"20240902161530-gpfsulx","Type":"NodeParagraph","Properties":{"id":"20240902161530-gpfsulx","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治游风热毒，风疹恶疮疥癞，小儿壮热，并煎汤浸洗。\""}]},{"ID":"20240902161530-7f904gp","Type":"NodeParagraph","Properties":{"id":"20240902161530-7f904gp","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"根皮杀小儿寸白虫。\""}]},{"ID":"20240902161530-pvaauo2","Type":"NodeParagraph","Properties":{"id":"20240902161530-pvaauo2","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"杀疳、治疽。\""}]},{"ID":"20240902161530-j9ng9y5","Type":"NodeParagraph","Properties":{"id":"20240902161530-j9ng9y5","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"根皮对绦虫、蛔虫、蛲虫都有效。\""}]},{"ID":"20240902161530-xno5dae","Type":"NodeParagraph","Properties":{"id":"20240902161530-xno5dae","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑦《湖南药物志》：\"治冻疮。\""}]},{"ID":"20240902161530-fw9uprp","Type":"NodeParagraph","Properties":{"id":"20240902161530-fw9uprp","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～3钱（鲜者1～2两）：或入丸、散。外用：煎水洗或研末调敷。"}]},{"ID":"20240902161530-bxzsmwe","Type":"NodeParagraph","Properties":{"id":"20240902161530-bxzsmwe","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【注意】体弱及脾胃虚寒者忌服。"}]},{"ID":"20240902161530-ojcm302","Type":"NodeParagraph","Properties":{"id":"20240902161530-ojcm302","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902161530-fkn1y7s","Type":"NodeParagraph","Properties":{"id":"20240902161530-fkn1y7s","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①治小儿蛔虫：㈠樟木，削上苍皮，以水煎取汁饮之，量大小多少。此为有小毒。（《千金方》）㈡樟根白皮，去粗，二斤，切。水一斗，煮取三升，砂锅（熬）成膏，五更初温酒服一匙，以虫下为度。（《简便单方》）"}]},{"ID":"20240902161530-d087ybh","Type":"NodeParagraph","Properties":{"id":"20240902161530-d087ybh","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②治小儿虫痛不可忍者：苦楝根白皮二两，白芜荑半两。为末，每服一钱，水-小盏，煎取半盏，放冷，待发时服，量大小加减，无时。（《小儿卫生总微论方》抵圣散）"}]},{"ID":"20240902161530-cx3kn96","Type":"NodeParagraph","Properties":{"id":"20240902161530-cx3kn96","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"③杀蛲虫：楝根皮二钱，苦参二钱，蛇床子一钱，皂角五分。共为末，以蜜炼成丸，如枣大，纳入肛门或阴道内。（《药物图考》楝皮杀虫丸）"}]},{"ID":"20240902161530-mcf6mo9","Type":"NodeParagraph","Properties":{"id":"20240902161530-mcf6mo9","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"④治钩虫病：苦楝皮（去粗皮）十斤，加水五十斤，熬成十斤；另用石榴皮八两，加水五斤，熬成二斤，两种药水混合搅匀，成人每次服一两。（《湖南药物志》）"}]},{"ID":"20240902161530-dbgh1r5","Type":"NodeParagraph","Properties":{"id":"20240902161530-dbgh1r5","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑤治瘾疹：楝皮浓煎浴。（《斗门方》）"}]},{"ID":"20240902161530-1zh1pbe","Type":"NodeParagraph","Properties":{"id":"20240902161530-1zh1pbe","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑥治疥疮风虫：楝根皮、皂角（去皮子）等分。为末，猪脂调涂。（《奇效良方》）"}]},{"ID":"20240902161530-aezu3ys","Type":"NodeParagraph","Properties":{"id":"20240902161530-aezu3ys","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑦治顽固性湿癣：楝根皮，洗净晒干烧灰，调茶抽涂抹患处，隔日洗去再涂，如此三、四次。（《福建中医药》（2）：43，1959）"}]},{"ID":"20240902161530-eflqe9v","Type":"NodeParagraph","Properties":{"id":"20240902161530-eflqe9v","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑧治瘘疮：楝树白皮、鼠肉、当归各二两，薤白三两，生地黄五两，腊月猪脂三升。煎膏成，敷之孔上，令生肉。（《刘涓子鬼遗方》坐肉膏）"}]},{"ID":"20240902161530-mhel18w","Type":"NodeParagraph","Properties":{"id":"20240902161530-mhel18w","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑨治小儿秃疮及诸恶疮，蠷螋疮：楝树枝皮烧灰，和猪膏敷之。（《千金方》）"}]},{"ID":"20240902161530-e49g1ud","Type":"NodeParagraph","Properties":{"id":"20240902161530-e49g1ud","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑩治虫牙痛：苦楝树皮煎汤漱口。（《湖南药物志》）"}]},{"ID":"20240902161530-egh3q8k","Type":"NodeParagraph","Properties":{"id":"20240902161530-egh3q8k","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"⑾治蛇咬伤：苦楝树二层皮、韭菜各四两，加米酒半斤、醋四两，炖热放凉后用。伤口先行扩创，用药酒自上而下外擦，药渣外敷，内服少许药酒。（广东《中草药处方选编》）"}]},{"ID":"20240902161530-nkbmohq","Type":"NodeParagraph","Properties":{"id":"20240902161530-nkbmohq","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902161530-74uclz3","Type":"NodeParagraph","Properties":{"id":"20240902161530-74uclz3","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝皮驱蛔虫，民间使用已久，疗效确实。解放后，各地临床报道，病例数以万计。但在实践过程中，对药用部分的选择、制备、剂量、服法等均不一致，其驱虫效果及毒性反应差距也很大。现根据部分临床报道，综述于下："}]},{"ID":"20240902161530-4y8wu8y","Type":"NodeParagraph","Properties":{"id":"20240902161530-4y8wu8y","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"①药用部分及采集季节"}]},{"ID":"20240902161530-dn9e4x0","Type":"NodeParagraph","Properties":{"id":"20240902161530-dn9e4x0","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝树的干皮、根皮都可驱蛔。从唐《千金方》等历代有关23种方书查考，其中有16种主要采用根皮。明代以后的记载更多采用根皮。根据近年临床应用结果证明，根皮比树皮疗效高1倍；近根的树皮（约在地面之上5寸处）较上层树皮为优，其疗效与根皮近似。在时间上以冬季或春季抽芽前采集的根皮，疗效最高。此外，楝属植物的各地品种不同，一般均认为以四川产的川楝为佳。"}]},{"ID":"20240902161530-duw9wso","Type":"NodeParagraph","Properties":{"id":"20240902161530-duw9wso","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"②制备方法、剂量与服法"}]},{"ID":"20240902161530-yqwxo82","Type":"NodeParagraph","Properties":{"id":"20240902161530-yqwxo82","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"一般采用煎剂，亦可制成片剂。苦楝皮有效成分难溶于水，需用文火久煎，才有确实疗效。有人作对比试验，分别以2、4、6两用文火煎11小时，其疗效比以8两用武火煎4小时者为高。剂量：根据1963年版《中国药典》规定和有关记载，苦楝皮的成人剂量为1.5～3.0钱（干皮），但实际用量颇不-致，高的竟有用至9～11克／公斤体重者。有人建议成人用4～6两（鲜皮），小儿按3～6克／公斤体重计算。川楝片每片含川楝素结晶0.025克，成人剂量为6～8片，2～4岁2片，4～8岁3～4片。苦楝素片每片含苦楝素25～50毫克，用于儿童以5毫克／公斤体重疗效最好。或每2岁服用1片（4岁用2片……14岁用7片），16岁以上用10片。服法：睡前或晨间空腹顿服，或在睡前和次晨分服。煎剂服时可加糖矫味，不必另服泻药。有主张在服药前先吃些油类食物，以减少药物对胃粘膜的刺激，防止胃肠道反应的发生。"}]},{"ID":"20240902161530-iaucta4","Type":"NodeParagraph","Properties":{"id":"20240902161530-iaucta4","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"③驱虫效果"}]},{"ID":"20240902161530-fgk6u0h","Type":"NodeParagraph","Properties":{"id":"20240902161530-fgk6u0h","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"根据采用苦楝皮（或粗制苦楝片）治疗的20000余例，及川（苦）楝素片治疗约5000例肠蛔虫病的临床分析来看，一般在服药后数小时或2～3天内排出蛔虫，以24～48小时排出者居多。排虫率20.2～100％不等，大便阴转率5.5～92.8％不等。曾有介绍，以苦楝皮煎剂治疗小儿蛔虫性肠梗阻50例，获得显效。方法以25％煎剂200毫升作保留灌肠，半小时后再用300～500毫升作第2次灌肠，1小时后再用600毫升行第3次灌肠，此为一疗程。若经24小时未见排出，可再进行第二疗程。对严重失水者可先补液矫正脱水。也有用川楝片内服治疗蛔虫性肠梗阻，剂量：1岁2片，2～4岁2～3片，5～8岁4片，9～12岁5片，均日服2次，并可根据情况给予50％硫酸镁25毫升。此外，用鲜苦楝根4～6两（不去皮）煎成100％煎剂治疗胆道蛔虫病，亦取得一定疗效；12岁以下每日1剂，分3次服，12岁以上每日1剂分2次服，2～3剂为一疗程。一般服药后2～3小时痛即减轻，从第1次大便开始，即有蛔虫排出。一个疗程后，尚有轻度症状者，可隔1～2日后再续服一个疗程。又苦楝根皮对驱除蛲虫、绦虫、鞭虫，亦有一定效果。"}]},{"ID":"20240902161530-4cl5vhk","Type":"NodeParagraph","Properties":{"id":"20240902161530-4cl5vhk","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"④毒性反应"}]},{"ID":"20240902161530-hhzfabo","Type":"NodeParagraph","Properties":{"id":"20240902161530-hhzfabo","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝皮的副作用，一般在服药后1～6小时尚未排虫之前发生，通常为头晕、头痛、思睡、恶心、腹痛等，其发生率高者可达100％，低者不到1％，持续时间大多在数分钟或1～3小时，最长16小时，可自行消失。严重反应或严重中毒时，可出现呼吸中枢麻痹、类似莨菪类植物中毒症状及内脏出血、中毒性肝炎、精神失常、视力障碍等，严重者可导致死亡。\"川楝素240\"系从川楝皮中提出的白色晶体，具有蓄积作用，对胃肠有刺激性，对肝脏亦有损害；为了避免中毒，不宜连续服用。苦楝根外层紫褐色皮，古人曾指出有毒，但经近人试用，并未见副作用增加。引起上述各种严重反应或中毒现象，多因药物过量，或因患者机体的特殊敏感性所致，临床应用时务须注意。"}]},{"ID":"20240902161530-nieew0h","Type":"NodeParagraph","Properties":{"id":"20240902161530-nieew0h","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902161530-6qxaix6","Type":"NodeParagraph","Properties":{"id":"20240902161530-6qxaix6","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"苦楝皮《中华本草》"}]},{"ID":"20240902161530-utbn1gb","Type":"NodeParagraph","Properties":{"id":"20240902161530-utbn1gb","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【出处】参见\"川楝子\"条。"}]},{"ID":"20240902161530-64j105q","Type":"NodeParagraph","Properties":{"id":"20240902161530-64j105q","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【拼音名】KǔLiànPí"}]},{"ID":"20240902161530-tv2hgp7","Type":"NodeParagraph","Properties":{"id":"20240902161530-tv2hgp7","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【别名】楝木皮、楝树枝皮、苦楝树白皮、东行楝根白皮、楝皮、楝根皮、楝根木皮、苦楝树皮、苦楝根皮。"}]},{"ID":"20240902161530-m2d59vu","Type":"NodeParagraph","Properties":{"id":"20240902161530-m2d59vu","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902161530-34n6wav","Type":"NodeParagraph","Properties":{"id":"20240902161530-34n6wav","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"药材基源：为楝科植物楝和川楝的树皮及根皮。"}]},{"ID":"20240902161530-5hnfqvw","Type":"NodeParagraph","Properties":{"id":"20240902161530-5hnfqvw","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.MeliaazedarachL.2.MeliatoosendanSieb.etZucc."}]},{"ID":"20240902161530-izsvjcz","Type":"NodeParagraph","Properties":{"id":"20240902161530-izsvjcz","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年或春、秋季采收，剥取干皮或根皮，除去泥沙，晒干。"}]},{"ID":"20240902161530-54o9m4a","Type":"NodeParagraph","Properties":{"id":"20240902161530-54o9m4a","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902161530-gtkjx5j","Type":"NodeParagraph","Properties":{"id":"20240902161530-gtkjx5j","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"1.楝落叶乔木，高15-20m。树皮暗褐色，纵裂，老枝紫色，有多数细小皮孔。二至三回奇数羽状复叶互生；小叶卵形至椭圆形，长3-7cm，宽2-3cm，先端长尖，基部宽楔形或圆形，边缘有钝尖锯齿，上面深绿色，下面淡绿色，幼时有星状毛，稍后除叶脉上有白毛外，余均无毛。圆锥花序腋生或顶生；花淡紫色，长约1cm；花萼5裂，裂片披针形，两面均有毛；花瓣5，平展或反曲，倒披针形；雄蕊管通常暗紫色，长约7mm；子房上位。核果圆卵形或近球形，长1.5-2cm，淡黄色，4-5室，每室具1颗种子。花期4-5月，果熟期10-11月。"}]},{"ID":"20240902161530-cvc37qm","Type":"NodeParagraph","Properties":{"id":"20240902161530-cvc37qm","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2.川楝乔木，高达10m。树皮灰褐色；幼嫩部分密被星状鳞片。二至三回奇数羽状复叶，长约35cm；羽片4-5对；小叶卵形或窄卵形，长4-10cm，宽2-4cm，全缘或少有疏锯齿。圆锥花序腋生；花萼灰绿色，萼片5-6；花瓣5-6，淡紫色；雄蕊10或12，花丝合生成筒。核果大，椭圆形或近球形，长约3cm，黄色或粟棕色，果皮为坚硬木质，有棱，6-8室，种子长椭圆形，扁平。花期3-4月，果期9-11月。"}]},{"ID":"20240902161530-cw7k3vv","Type":"NodeParagraph","Properties":{"id":"20240902161530-cw7k3vv","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902161530-4vjyljy","Type":"NodeParagraph","Properties":{"id":"20240902161530-4vjyljy","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"生态环境：1．生于旷野或路旁，常栽培于屋前房后。"}]},{"ID":"20240902161530-ti4esz9","Type":"NodeParagraph","Properties":{"id":"20240902161530-ti4esz9","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2.生于海拔500-2100m的杂木林和疏林内或平坝、丘陵地带湿润处，常栽培于村旁附近或公路边。"}]},{"ID":"20240902161530-zx135bh","Type":"NodeParagraph","Properties":{"id":"20240902161530-zx135bh","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布北至河北，南至广西、云南，西至四川等地。"}]},{"ID":"20240902161530-wstytax","Type":"NodeParagraph","Properties":{"id":"20240902161530-wstytax","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2.分布于甘肃、河南、湖北、湖南、广西、四川、贵州、云南等地。"}]},{"ID":"20240902161530-3b3vwg5","Type":"NodeParagraph","Properties":{"id":"20240902161530-3b3vwg5","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902161530-j2e5wbf","Type":"NodeParagraph","Properties":{"id":"20240902161530-j2e5wbf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"1．楝生物学特性喜温暖湿润气候，耐寒、耐碱、耐瘠薄。适应性较强。以上层深厚、疏松肥沃、排水良好、富含腐殖质的砂质壤土栽培为宜。"}]},{"ID":"20240902161530-d56yzpo","Type":"NodeParagraph","Properties":{"id":"20240902161530-d56yzpo","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。育苗移栽法：10-11月选择20年以上的老树，进行采种。春季4月播种前用温水浸种4-5d按行距30-45cm开条沟，沟深6cm，将种子播火，覆土压实。培育1年，翌年春季移栽。按行株距5m×5m开穴，穴径1.2m，深80cm，底层施厩肥，上覆细土10cm，每穴栽种1株，栽种时要使根部舒展，土壤与根部密接，覆土压实，浇水。"}]},{"ID":"20240902161530-x4k4z9c","Type":"NodeParagraph","Properties":{"id":"20240902161530-x4k4z9c","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"田间管理幼树栽种后，每年要松土除草、施肥2-3次，冬季进行培土，遇雨季要及时开沟排除积水。"}]},{"ID":"20240902161530-qqgevfe","Type":"NodeParagraph","Properties":{"id":"20240902161530-qqgevfe","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有溃疡病、褐斑病、丛技病、花叶病、叶斑病；虫害有黄刺蛾、扁刺蛾、斑衣蜡蝉、星天牛等。"}]},{"ID":"20240902161530-70ihtjs","Type":"NodeParagraph","Properties":{"id":"20240902161530-70ihtjs","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2.生物学特性喜温暖湿润气候，喜阳，不耐荫蔽，在海拔1000m以下均可生长。以选阳光充足，土层深厚，疏松肥沃的砂质壤上栽培为宜。"}]},{"ID":"20240902161530-jw8eicp","Type":"NodeParagraph","Properties":{"id":"20240902161530-jw8eicp","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖，育苗移栽法。11-12月采摘浅黄色成熟果实作种，用清水浸泡2-3d，去果肉，取出果核，晾干，用湿沙贮藏催芽。翌年2月下旬至3月下旬播种。条播，按行距30cm开横沟，深约6cm，株距12cm。每穴放果核1枚，随即施人稀粪水，覆土8-10cm。播后1个月左右出苗，每枚果核可出苗3-5株。苗高10-15cm时中耕除草1次，施人粪尿；苗高18-20cm时，进行第2次中耕除草。培育1年，于冬季或第2年春季发芽前移栽。按行株距（2.5-3.5）cm×（2.5-3.5）cm开穴，每穴栽苗1株，填上压实，浇足水。"}]},{"ID":"20240902161530-90pa53f","Type":"NodeParagraph","Properties":{"id":"20240902161530-90pa53f","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"田间管理幼树要加强管理，以利成活。成年树每年春、秋季中耕除草，结合追肥；冬季进行修枝。遇旱及时灌水。"}]},{"ID":"20240902161530-z5eymr6","Type":"NodeParagraph","Properties":{"id":"20240902161530-z5eymr6","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902161530-jaouw4y","Type":"NodeParagraph","Properties":{"id":"20240902161530-jaouw4y","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"性状鉴别干皮呈不规则块片状、槽状或半卷筒状，长宽不一，厚3-7mm。外表面粗糙，灰棕色或灰褐色，有交织的纵皱纹及点状灰棕色皮孔。除去粗皮者淡黄色；内表面类白色或淡黄色。质韧，不易折断，断面纤维性，呈层片状，易剥离成薄片，层层黄白相间，每层薄片均可见，极细的网纹。无臭，味苦。根皮呈不规则片状或卷曲，厚1-5mm。外表面灰棕色或棕紫色，微有光泽，粗糙，多裂纹。干皮以皮细、可见多数皮孔的幼嫩树皮为佳。根皮以皮厚、去栓皮者为佳。"}]},{"ID":"20240902161530-wpm80dn","Type":"NodeParagraph","Properties":{"id":"20240902161530-wpm80dn","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"显微鉴别干皮横切面：外侧有3-4条木栓组织层带。木栓层常已深入到韧皮部。老皮多已不见皮层。韧皮部有切向延长的纤维束与薄壁组织相间排列成层；纤维束周围的薄壁细胞中含草酸钙方晶形成晶鞘纤维；方晶直径6-31μm，纤维壁厚，木化。初生射线喇叭形，开口处的细胞常含有草酸钙簇晶。薄壁细胞中含淀粉粒，圆形、类圆形或卵圆形，单位或由2-5个分粒组成的复粒。根皮横切面。落皮层较厚，其内侧可见射线及颓废筛管群；木栓层为多列木栓细胞。韧皮部韧皮射线波状弯曲，宽3-5列细胞；韧皮纤维排列成多层断续的环层，纤维束周围的细胞含草酸钙方晶，形成晶纤维。本品薄壁细胞含淀粉粒，有的含草酸钙方晶。"}]},{"ID":"20240902161530-4n929ip","Type":"NodeParagraph","Properties":{"id":"20240902161530-4n929ip","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"粉末特征：红棕色。①纤维甚长，直径15-27μm，壁极厚，木化；纤维束周围的细胞常含草酸钙方晶，形成晶纤维；含晶细胞壁不均匀木化增厚，厚约至14μm，方晶正立方形或多面形，直径13-29μm。②木化韧皮薄壁细胞常紧附纤维束旁，类长方形、长条形或类圆形，长43-130μm，直径15-37μm，壁稍厚，微木化，具稀疏纹孔。此外，有木栓组织碎片，有的含红棕色物；淀粉粒单粒直径约至13μm；稀有簇晶。"}]},{"ID":"20240902161530-9n761og","Type":"NodeParagraph","Properties":{"id":"20240902161530-9n761og","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902161530-e5k097z","Type":"NodeParagraph","Properties":{"id":"20240902161530-e5k097z","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"1．棕树皮中含有川楝素（toosendanin），苦楝酮（kulinone），苦楝萜酮内酯（kulactone），苦楝萜醇内酯（kulo-lactone），苦楝植酸甲酯（methylkulonate），苦楝子三醇（melianotriol），葛杜宁-3-O-β-O-D-吡喃葡萄糖甙（7a-acetoxy-l4β，15β-epoxy-gedunan-1-ene-3-O-β-Dglucopyranoside），1，8-二羟基-2-甲基蒽醌-3-O-β-D-吡喃半乳糖甙（1，8-dihydroxy-2-methylanthraquinone-3-O-β-D-galactopyranoside），1，5-二羟基-8-甲氧基-2-甲基蒽醌-3-O-a-L-吡喃鼠李糖甙（1，5-dihydroxy-8-metho-xy-2-methylanthraquinone-3-O-a-L-rhamnopyranoside），4＇，5-二羟基黄酮-7-O-a-L-吡喃鼠李糖基-（1→4）-β-D-吡喃葡萄糖甙［4’，5-dihydroxyflavone-7-O-a-L-rhamnopyranosyl-（l→4）-β-D-glucopyranoside］，异川楝素（isotoosendanin）。另有β-谷甾醇（β-sitosterol），正十三烷及水溶性成分。樟树木材中含印楝波灵（nimbolin）A及B，秦皮酮（fraxinellone），葛杜宁（gedu-nin）。樟树根中含芹菜素-5-O-β-D-吡喃半乳糖甙（apigenin-5－O-β-D-galactopyranoside）。"}]},{"ID":"20240902161530-xw2p40z","Type":"NodeParagraph","Properties":{"id":"20240902161530-xw2p40z","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2．川楝树皮含川楝素、异川楝素，根皮中四川楝素的含量较树皮中的略高。"}]},{"ID":"20240902161530-6dzramg","Type":"NodeParagraph","Properties":{"id":"20240902161530-6dzramg","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902161530-oo47hqd","Type":"NodeParagraph","Properties":{"id":"20240902161530-oo47hqd","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"1．驱虫作用：经猪试验表明，该药煎剂或醇提取物均对猪蛔虫有抑制以至麻痹作用。驱蛔作用的有效成分为川楝素，比乙醇提取物的作用强。低浓度（1：5000-9000）的川楝素，对整条猪蛔虫及其节段（头部及中部）有明显的兴奋作用，表现为自发活动增强，间歇地出现异常的剧烈收缩，破坏其运动的规律性（活动增强与减弱相交替），持续10-24小时，最后逐渐转入痉挛性收缩。川楝素能透过虫体表皮，直接作用于蛔虫肌肉，扰乱其能量代谢，导致收缩性疲劳而痉挛。此浓度的川楝索对蛔虫神经-肌肉的兴奋作用不被阿托品所阻断，提示川楝素并非拟胆碱药。高浓度（l：1000）的川楝素对猪蛔虫特别是头部的神经节有麻痹作用。这种麻痹作用，可能是虫体受药物作用后呈间歇性痉挛收缩的结果。经Ammon法和瓦氏呼吸器分别测定虫体匀浆的胆碱酯酶活力和呼吸酵解，结果证明均无明显影响，表明川楝素不是通过糖代谢而起作用。另从蛔虫肌肉中的ATP和无机磷的实验结果中可以看出，川楝素能使ATP的分解代谢加快，从而造成蛔虫有能量供应短缺而导致收缩疲劳，而被排出体外。高浓度的苦楝皮药液（25%-50%）在体外对小鼠蛲虫也有麻痹作用。"}]},{"ID":"20240902161530-am14u63","Type":"NodeParagraph","Properties":{"id":"20240902161530-am14u63","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"2．对呼吸中枢的影响：大剂量的川楝素（每只大鼠，静脉或肌内注射2mg）能引起大鼠呼吸衰竭。这主要是由于该成分对中枢的抑制作用。延脑呼吸中枢部位直接给予川楝素（每只大鼠0.10-0.15mg），能支持上述结果。中枢兴奋药尼可刹米对川楝素引起的呼吸抑制有轻微的对抗作用。"}]},{"ID":"20240902161530-itndfdc","Type":"NodeParagraph","Properties":{"id":"20240902161530-itndfdc","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"3．对神经肌肉传递功能的影响：川楝素对大鼠有不可逆地阻遏间接刺激引起的肌肉收缩，但不影响神经的兴奋传导，也不降低肌肉对直接刺激的反应；川楝素是1个选择性地作用于突触前的神经肌肉传递阻断剂。其作用部位在突触前神经末梢，作用方式是抑制刺激神经诱发的乙酰胆碱释放。电子显微镜观察表明川楝素对小白鼠神经肌肉接头的亚显微结构有明显的作用，表现在突触间隙宽度增加和突触囊泡数目减少。这两种变化不同时出现在同一个接头。"}]},{"ID":"20240902161530-d1usfl4","Type":"NodeParagraph","Properties":{"id":"20240902161530-d1usfl4","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"4．抗肉毒中毒：川楝素对肉毒中毒动物具有治疗作用。对致死量A型肉毒中毒的小鼠，中毒后6小时给予川楝素，有明显治疗作用；对致死量A型肉毒中毒的猴子，中毒后24小时给予川楝素，可治愈半数以上动物；对B型肉毒中毒的小鼠，川楝素也有保护作用。此外，川楝素能明显增强抗毒血清对肉毒中毒小鼠和家兔的治疗作用。"}]},{"ID":"20240902161530-o42f5tz","Type":"NodeParagraph","Properties":{"id":"20240902161530-o42f5tz","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"5．对心乳头肌电和机械特性的影响：楝素浓度依赖性地使快反应电位复极至90%的时程（APD90）延长，用氯化钡阻断Ik1，可取消川楝素延长APD90的作用，川楝素使慢反应电e坏腁PD延长和收缩力（FC）增强，用氯化钡后，可取消川楝素的上述作用，但延长APD的作用存在。此外，川楝素可使离体蛙心收缩节律异常，持续l小时可自动恢复。"}]},{"ID":"20240902161530-4mpe7q6","Type":"NodeParagraph","Properties":{"id":"20240902161530-4mpe7q6","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"6．其他作用：楝素（200mg／kg）家兔灌胃以及浓度为0.2×10（-4）mg的川楝素均对在位兔及离体兔肠的张力和收缩力有显着增加。浓度为0.2×l0（-3）mg的川楝素能使肠肌呈现痉挛性收缩。此兴奋作用能被苯海拉明所对抗，而不被阿托品所阻断。10%苦楝皮水浸液对多种致病性真菌有抑制作用。苦楝根皮提取物治疗小鼠实验性曼氏血吸虫病，从动物体内存活虫数及孵化试验等方面证实，有一定疗效。"}]},{"ID":"20240902161530-vi2sxpy","Type":"NodeParagraph","Properties":{"id":"20240902161530-vi2sxpy","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【毒性】川楝素小鼠腹腔、静脉、皮下和口服的半数致死量分别为13.8±1.2mg/kg、14.6±0.9mg／kg、14.3±1.5mg／kg和244.2±44.0mg／kg。大鼠皮下注射和家兔静注的半数致死量分别为9.8mg／kg和4.2mg／kg。川楝素对胃有刺激性，其程度因动物种类而异，口服川楝素后，大鼠胃粘膜发生水肿、炎症及溃疡，部分犬呕吐。还可引起犬、兔、猴肝细胞肿胀变性、肝窦极度狭窄，小鼠血浆ALT升高，灌服大剂量川楝素，可引起动物急性中毒致死，死亡原因是由于血管通透性增加，引起内脏出血，血压下降而形成急性循环衰竭。小鼠蓄积性毒性的半数致死量为18.7mg/kg，蓄积系数为1.13，属强蓄积性药物。猴亚急性中毒最明显的表现是ALT升高，其次是肌无力。大体解剖发现，各剂量组的动物均有不同程度的内脏瘀血。显微镜检发现，猴小血管内膜表面有棕黄色颗粒沉积，且剂量越大沉积越多。肝细胞肿胀，胞浆疏松，可见枯否细胞及吞噬颗粒；脑血管扩张充血，部分血管内皮细胞肿胀，胶质细胞和小血管周围间隙明显增加。"}]},{"ID":"20240902161530-q2unnci","Type":"NodeParagraph","Properties":{"id":"20240902161530-q2unnci","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品粉末约1g，加乙醚10ml，浸渍2h，时时振摇，滤过。取滤波1ml，挥干后，滴加对二甲氨基苯甲醛试液数滴，显红色；另取滤液1ml，置试管中，挥干后，加醋研1ml，搅拌，沿管壁加硫酸数滴，醋研层显绿色，硫酸层显红色至紫红色。（检查三萜类）"}]},{"ID":"20240902161530-7oedddf","Type":"NodeParagraph","Properties":{"id":"20240902161530-7oedddf","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【炮制】1.《圣惠方》：\"锉。\"2.《博济方》：\"细切。\"3.《斗门方》：\"去其苍者，焙干为末。\"4.《卫生宝鉴》：\"去浮皮。\"5.《医学纲目》：\"去皮。\"6.《景岳全书》间\"刮去皮土。\"7.《外科全生集》：\"去皮取白肉。\"现行，取原药材，除去杂质，洗净，润透，切丝，干燥。饮片性状：参见\"药材鉴别\"项。贮干燥容器内，置阴凉干燥处，防霉，防蛀。"}]},{"ID":"20240902161530-14y2sv2","Type":"NodeParagraph","Properties":{"id":"20240902161530-14y2sv2","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【性味】苦；寒；有毒"}]},{"ID":"20240902161530-g5kgj94","Type":"NodeParagraph","Properties":{"id":"20240902161530-g5kgj94","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃；肝经"}]},{"ID":"20240902161530-kq1ndbb","Type":"NodeParagraph","Properties":{"id":"20240902161530-kq1ndbb","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫；疗癣。主蛔虫病；钩虫病；蛲虫病；阴道滴虫病；疥疮；头癣"}]},{"ID":"20240902161530-bavyzns","Type":"NodeParagraph","Properties":{"id":"20240902161530-bavyzns","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-15g，鲜品15-30g；或入丸、散。外用：适量，煎水洗：或研末调敷。"}]},{"ID":"20240902161530-7rhgc3t","Type":"NodeParagraph","Properties":{"id":"20240902161530-7rhgc3t","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902161530-y2tyf2h","Type":"NodeParagraph","Properties":{"id":"20240902161530-y2tyf2h","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"体弱及肝肾功能障碍者、孕妇及脾胃虚寒者均慎服。亦不宜持续和过量服用。苦楝皮有一定的毒副反应，服药中毒后可有头痛、头晕、恶心、吐吐、腹痛等症状。严重中毒，可出现内脏出血、中毒性肝炎、精神失常、呼吸中枢麻痹，甚至休克、昏迷死亡。"}]},{"ID":"20240902161530-nzm4kj5","Type":"NodeParagraph","Properties":{"id":"20240902161530-nzm4kj5","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"1．《新修本草》：“此有两种，有雄有雌。雄者根赤无子有毒，服之多使人吐不能止，时有至死者。雌者根白有子微毒，用当取雌者。”2．《福建药物志》：“苦楝根皮驱虫有效，但有一定的毒性，应结合患者的年龄、体质等情况，慎重投药。”"}]},{"ID":"20240902161530-e2s46ly","Type":"NodeParagraph","Properties":{"id":"20240902161530-e2s46ly","updated":"20240902161605"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902161531-0beqyu7","Type":"NodeThematicBreak","Properties":{"id":"20240902161531-0beqyu7","updated":"20240902161605"}},{"ID":"20240902161532-0zaodi3","Type":"NodeParagraph","Properties":{"id":"20240902161532-0zaodi3","updated":"20240902161605"}}]}