}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 641px;\" parent-style=\"width: 651px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731090753-ah2ne2j","Type":"NodeParagraph","Properties":{"id":"20240731090753-ah2ne2j","updated":"20240731090753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 726px;","style":"width: 716px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 5-20240731090001-iwz1axq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 716px;\" parent-style=\"width: 726px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 532px;","style":"width: 522px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 4-20240731085748-wpg65v2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 522px;\" parent-style=\"width: 532px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731090753-a0jovgz","Type":"NodeParagraph","Properties":{"id":"20240731090753-a0jovgz","updated":"20240731090753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 2-20240731085316-8cpts2b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 768px;","style":"width: 758px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 3-20240731085538-1snidjl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 758px;\" parent-style=\"width: 768px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730173631-wuhudhm","Type":"NodeParagraph","Properties":{"id":"20240730173631-wuhudhm","updated":"20240731085836"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为天名精的干燥成熟果实；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240504161427-orhlc1w","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"066天名精（野烟）"}]},{"ID":"20240730173631-qvrf73o","Type":"NodeThematicBreak","Properties":{"id":"20240730173631-qvrf73o"}},{"ID":"20240903093640-1950ljq","Type":"NodeParagraph","Properties":{"id":"20240903093640-1950ljq","updated":"20240903093646"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：鹤虱"}]},{"ID":"20240903093640-76pjwld","Type":"NodeParagraph","Properties":{"id":"20240903093640-76pjwld","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"鹤虱《*辞典》"}]},{"ID":"20240903093640-7q8p9za","Type":"NodeParagraph","Properties":{"id":"20240903093640-7q8p9za","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【出处】《唐本草》"}]},{"ID":"20240903093640-3vtmppl","Type":"NodeParagraph","Properties":{"id":"20240903093640-3vtmppl","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【拼音名】HèShī"}]},{"ID":"20240903093640-shjo2x7","Type":"NodeParagraph","Properties":{"id":"20240903093640-shjo2x7","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【别名】鹄虱（《唐本草》），鬼虱（《本草崇原》），北鹤虱（《中药志》）。"}]},{"ID":"20240903093640-j6yrk0i","Type":"NodeParagraph","Properties":{"id":"20240903093640-j6yrk0i","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【来源】为菊科植物天名精的果实。秋季果实成热时采摘，晒干，除去皮屑，杂质。"}]},{"ID":"20240903093640-5po08uk","Type":"NodeParagraph","Properties":{"id":"20240903093640-5po08uk","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产河南、山西、贵州。陕西、甘肃，湖北等地亦产。"}]},{"ID":"20240903093640-vir3kju","Type":"NodeParagraph","Properties":{"id":"20240903093640-vir3kju","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实呈圆柱状，细小，长约3～4毫米，宽不达1毫米，无毛，表面黄褐色，有多数纵棱及沟纹，顶端收缩呈线状短喙，先端有灰白色的环状物。横断面类圆形，种仁黄白色，有油性。气微味微苦，尝之有粘性。以粒匀、充实、尝之有粘性者为佳。"}]},{"ID":"20240903093640-pj31wxr","Type":"NodeParagraph","Properties":{"id":"20240903093640-pj31wxr","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240903093640-1qrmu62","Type":"NodeParagraph","Properties":{"id":"20240903093640-1qrmu62","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"天名精果实中含有缬草酸、正己酸、油酸、右旋亚麻酸、卅一烷、豆甾醇和天名精内酯、天名精酮等内酯化台物。"}]},{"ID":"20240903093640-m9zn2o8","Type":"NodeParagraph","Properties":{"id":"20240903093640-m9zn2o8","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"野胡萝卜果实含挥发油约2％，中含细辛醚、甜没药烯、巴豆酸、细辛醛。北高加索产Daucuscarota种子含挥发油约2％，中含牻牛儿醇约30％，l-香桧烯20％，一种多氢薁类二环倍半萜7.7％，β-蒎烯等。亦有谓牻牛儿醇乙酸酯是野胡萝卜种子挥发油中的主要成分，其中含量可达50％。不同产地野胡萝卜果实挥发油的成分的变异很大，其中尚可以有芳樟醇、α-蒎烯、柠檬烯、佛手柑油烯、胡萝卜烯、榄香脂素、α-姜黄烯、莰烯、α-松油烯、松油烯-4-醇、α-松油醇、龙脑乙酸酯、γ-癸内酯、β-芹子烯、α-古芸烯、香豆精、胡萝卜醇、胡萝卜次醇等。另有谓培植胡萝卜果实含挥发油0.6～2.1％，中含胡萝卜次醇9～63％，牻牛儿醇乙酸酯0～48％，环氧二氢齐墩果酸2.5～20％。野胡萝卜果实中尚含黄酮类、糖、季铵生物碱（可能是乙酰胆碱）、氨基酸、胡萝卜苦甙、甾醇和扩张冠状血管的成分。"}]},{"ID":"20240903093640-o19v4xr","Type":"NodeParagraph","Properties":{"id":"20240903093640-o19v4xr","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"窃衣果实含挥发油1.4％。挥发油中主含毕澄茄烯和窃衣烯。又含油约10％，其中脂肪酸有洋芫荽子酸、油酸、亚油酸等。又谓含窃衣醇、窃衣醇酮。种子含窃衣素。"}]},{"ID":"20240903093640-ktq3ssq","Type":"NodeParagraph","Properties":{"id":"20240903093640-ktq3ssq","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"东北鹤虱种子含油量19.48％。"}]},{"ID":"20240903093640-2bomklr","Type":"NodeParagraph","Properties":{"id":"20240903093640-2bomklr","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903093640-g8fxsv8","Type":"NodeParagraph","Properties":{"id":"20240903093640-g8fxsv8","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"①天名精子有驱虫作用。1％天名精子酊5滴加入生理食盐水25毫升中，加温37℃再放入犬绦虫，结果1～2分钟即死。"}]},{"ID":"20240903093640-2b8um8l","Type":"NodeParagraph","Properties":{"id":"20240903093640-2b8um8l","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"②野胡萝卜种子的醇提取物的水溶性部分，有两种季铵型生物碱，一种从化学及药理上均确定其为胆碱，故有胆碱样作用；另一种则尚未确定。在动物试验中（离体豚鼠、大鼠小肠、大鼠子宫、猫支气管、离体蛙心等），还显示有罂粟碱样作用。种子还含黄酮类，据云能扩张冠状血管，有用于心绞痛者。种子中的甙性成分，对麻醉犬有短暂的降压和抑制呼吸，能松弛大鼠、兔小肠及未孕子宫。也有报告，其提取物（可能为叶）对已孕或未孕的猫、豚鼠子宫有收缩作用。果实的热乙醇提取物有扩张冠状动脉（离体猫心）的作用，与柯柯碱相似。其变种的种子中提出的精油，对麻醉犬小量可短暂的降低血压而不影响呼吸，大量则能导致持久性的降压并抑制呼吸。此精油对蛙心、在位犬心有直接抑制作用；对大鼠无镇痛作用，但却能抑制其中枢神经系统；它对士的宁及戊四氮引起的惊厥（蛙），有轻度的保护作用；它能松弛离体大鼠及兔小肠、大鼠子宫平滑肌；在离体蛙横纹趴标本上，它能降隔乙酰胆碱引起的收缩。"}]},{"ID":"20240903093640-0r8nl2v","Type":"NodeParagraph","Properties":{"id":"20240903093640-0r8nl2v","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"东北鹤虱的果实，试管内对蚯蚓、猪蛔虫、水蛭均有杀虫作用；10％鹤虱酒精提取物1毫升于试管内对猪蛔头部作用不明显，须加入25毫升才能使之挛缩停止。50％及25％浓度的鹤虱液体外实验，20小时后仅有少数的鼠蛲虫死亡。"}]},{"ID":"20240903093640-ttqxycc","Type":"NodeParagraph","Properties":{"id":"20240903093640-ttqxycc","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903093640-1ugt6vf","Type":"NodeParagraph","Properties":{"id":"20240903093640-1ugt6vf","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"苦辛，平，有毒。"}]},{"ID":"20240903093640-019bd67","Type":"NodeParagraph","Properties":{"id":"20240903093640-019bd67","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"昧苦，平，有小毒。\""}]},{"ID":"20240903093640-e3dl70u","Type":"NodeParagraph","Properties":{"id":"20240903093640-e3dl70u","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"苦辛，有小毒。\""}]},{"ID":"20240903093640-lomzczz","Type":"NodeParagraph","Properties":{"id":"20240903093640-lomzczz","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"苦辛，温。\""}]},{"ID":"20240903093640-fllmchl","Type":"NodeParagraph","Properties":{"id":"20240903093640-fllmchl","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【归经】《木经逢原》：\"入厥阴肝经。\""}]},{"ID":"20240903093640-9l8gu7z","Type":"NodeParagraph","Properties":{"id":"20240903093640-9l8gu7z","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903093640-epgg06x","Type":"NodeParagraph","Properties":{"id":"20240903093640-epgg06x","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"杀虫。治虫积腹痛。"}]},{"ID":"20240903093640-jutnb6x","Type":"NodeParagraph","Properties":{"id":"20240903093640-jutnb6x","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"主蛔、蛲虫，用之为散，以肥肉臛汁，服方寸匕；亦丸、散中用。\""}]},{"ID":"20240903093640-lbac7by","Type":"NodeParagraph","Properties":{"id":"20240903093640-lbac7by","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"杀五脏虫，止疟及敷恶疮上。\""}]},{"ID":"20240903093640-5tt1eu5","Type":"NodeParagraph","Properties":{"id":"20240903093640-5tt1eu5","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"心痛，以淡醋和半匕服。\""}]},{"ID":"20240903093640-50mq8en","Type":"NodeParagraph","Properties":{"id":"20240903093640-50mq8en","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"善调逆气，治一身痰疑气滞，杀虫。\""}]},{"ID":"20240903093640-55wn06m","Type":"NodeParagraph","Properties":{"id":"20240903093640-55wn06m","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"⑤《岭南采药录》：\"疗恶疮，解蛇毒，均捣敷。\""}]},{"ID":"20240903093640-oxx37o7","Type":"NodeParagraph","Properties":{"id":"20240903093640-oxx37o7","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"治腹痛，为绦虫、蛲虫、蛔虫之驱除剂。\""}]},{"ID":"20240903093640-2ln4hcw","Type":"NodeParagraph","Properties":{"id":"20240903093640-2ln4hcw","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"⑦《药材资料汇编》：\"治久痢。\""}]},{"ID":"20240903093640-8aujue0","Type":"NodeParagraph","Properties":{"id":"20240903093640-8aujue0","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；或入丸、散。"}]},{"ID":"20240903093640-6huti0t","Type":"NodeParagraph","Properties":{"id":"20240903093640-6huti0t","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903093640-jzp3k0j","Type":"NodeParagraph","Properties":{"id":"20240903093640-jzp3k0j","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"①治小儿疾病多有诸虫，腹中疼痛，发作肿聚，往来上下，痛无休止，亦攻心痛，呕哕涎沫，或吐清水，四肢羸困，面色青黄，饮食虽进，不生肌肤，或寒或热，沉沉嘿嘿：胡粉（炒）、鹳虱（去土）、槟榔、苦楝根（去浮皮）各五十两，白矾（枯）十二两半。上为末，以面糊为丸，如麻子大。一岁儿服五丸，温浆水入生麻油一两点，调匀下之，温米饮下亦得，不拘时侯。（《局方》化虫丸）"}]},{"ID":"20240903093640-hrbsthy","Type":"NodeParagraph","Properties":{"id":"20240903093640-hrbsthy","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"②治蛔咬痛：鹤虱十两。捣筛，蜜和丸如梧子。以蜜汤空腹吞四十丸，日增至五十丸。慎酒肉。（《古今录验方》）"}]},{"ID":"20240903093640-epvu6n4","Type":"NodeParagraph","Properties":{"id":"20240903093640-epvu6n4","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"③治大肠虫出不断，断之复生，行坐不得：鹳虱末，水调半两服。（《怪证奇方》）"}]},{"ID":"20240903093640-l3czpcv","Type":"NodeParagraph","Properties":{"id":"20240903093640-l3czpcv","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"④治齿痛：㈠鹤虱一枚，擢置齿中。（《纲目》）㈡鹤虱煎米醋漱口。（《纲目》）"}]},{"ID":"20240903093640-3txvq1c","Type":"NodeParagraph","Properties":{"id":"20240903093640-3txvq1c","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗钩虫病:取鹤虱3两，洗净后水煎两次，药液混合浓缩至6O毫升（每10毫升相当原生药5钱），过滤，加少量白糖调味，成人每晚睡前服30毫升，连服两晚。小儿及年老体弱者酌减，观察57例，治疗后15天复查大便，钩虫卵阴性者45例，阳性者12例，阴转率79％。治疗前合并蛔虫感染31例，治疗后复查大便，结果有19例蛔虫卵阴转。说明鹤虱亦有驱蛔作用。少数病例服药后数小时或第二天有轻微头晕、恶心、耳鸣、腹痛等反应，可自行消失。"}]},{"ID":"20240903093640-5xlymwm","Type":"NodeParagraph","Properties":{"id":"20240903093640-5xlymwm","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240903093640-jut1zjm","Type":"NodeParagraph","Properties":{"id":"20240903093640-jut1zjm","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"除上述品种外，某些地区作鹅虱使用者，尚有下列几种："}]},{"ID":"20240903093640-j20klld","Type":"NodeParagraph","Properties":{"id":"20240903093640-j20klld","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"①南鹤虱，为伞形科植物野胡萝卜（参见\"鹤虱风\"条）的果实。呈椭圆形，多已分裂成两瓣，长约3～4毫米，宽1.5～2.5毫米，表面棕黄色或黄褐色，顶端有残留花柱，基部圆形，偶有小果柄。果瓣背面隆起，有吐条突起的纵梭线，其上密生一列黄白色钩刺。接合面稍平坦，有3条纵脉纹，脉上有短柔毛。横切面略呈半圆形，每一棱线内方有1个油管，接合面有2个油管。种仁类白色，有油性。具特殊香气，味辛微苦。"}]},{"ID":"20240903093640-xp6z7ru","Type":"NodeParagraph","Properties":{"id":"20240903093640-xp6z7ru","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"产江苏、浙江、安徽、湖北、四川、云南、贵州、山西等地。"}]},{"ID":"20240903093640-7lhdybk","Type":"NodeParagraph","Properties":{"id":"20240903093640-7lhdybk","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"②华南鹤虱，为伞形科植物窃衣的果实。呈椭圆形，药材多为分果，长3～4毫米，宽1.5～2毫米，表面棕绿色，黄棕色，顶端残留花柱，基部有小果柄，背面隆起，主棱稍突起，次棱及槽内密生钩刺；接合面凹陷成槽状，中央有1条脉纹。横切面呈半圆形，接合面处有2个油管，周边有4个油管。种仁类白色，显油性。具特殊香气，味微辣而后苦。"}]},{"ID":"20240903093640-772nwf0","Type":"NodeParagraph","Properties":{"id":"20240903093640-772nwf0","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"产湖南、广东、四川、广西等地。"}]},{"ID":"20240903093640-nactwlu","Type":"NodeParagraph","Properties":{"id":"20240903093640-nactwlu","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"③东北鹤虱，为紫草科植物东北鹤虱（又名：赖毛子）的果实。为4个直立的小坚果，全体呈卵状圆锥形，长2～3毫米，宽约3毫米，基部有小果柄。药材多为分开的小坚果，呈卵状三棱形，顶端尖锐，椭圆形，表面棕褐色，少数呈灰绿色，密布瘤状突起，腹面有线形突起的着生痕迹，背面边缘有2列钩刺，背面中央有小钩刺或无。果皮硬。种仁类白色，显油性。气微，味淡。"}]},{"ID":"20240903093640-hps2vva","Type":"NodeParagraph","Properties":{"id":"20240903093640-hps2vva","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"产辽宁、黑龙江、吉林、内蒙古、新疆、青海。"}]},{"ID":"20240903093640-a3816zx","Type":"NodeParagraph","Properties":{"id":"20240903093640-a3816zx","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"黑龙江地区尚以同属植物蒙古鹤虱的果实作东北鹅虱入药。性状与上种近似，惟背面边缘的钩刺为1列，背面中央通常无刺。"}]},{"ID":"20240903093640-7n6snbb","Type":"NodeParagraph","Properties":{"id":"20240903093640-7n6snbb","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903093640-unh2yz7","Type":"NodeParagraph","Properties":{"id":"20240903093640-unh2yz7","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"鹤虱《中华本草》"}]},{"ID":"20240903093640-pusxex6","Type":"NodeParagraph","Properties":{"id":"20240903093640-pusxex6","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903093640-mymjo1f","Type":"NodeParagraph","Properties":{"id":"20240903093640-mymjo1f","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"1．《唐本草》：鹤虱，生西戎。子似蓬蒿子而细，合叶茎而用之。"}]},{"ID":"20240903093640-dqw47us","Type":"NodeParagraph","Properties":{"id":"20240903093640-dqw47us","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"2．《本草图经》：鹤虱，今江淮、衡湘问皆有之。春生苗叶，皱似紫苏，大而尖长，不光，茎高二尺许，七月生黄白花，似菊，八月结实，子极尖细，干即黄黑色，采无时。杀虫方中此为最要。"}]},{"ID":"20240903093640-tw5bc24","Type":"NodeParagraph","Properties":{"id":"20240903093640-tw5bc24","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"3．《植物名实图考》：天名精，子极臬而刺人衣，诸家皆云子名鹤虱。湘中土匡有用鹤虱者，命取视之，乃野胡萝卜子。"}]},{"ID":"20240903093640-kwcdtwi","Type":"NodeParagraph","Properties":{"id":"20240903093640-kwcdtwi","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【拼音名】HèShī"}]},{"ID":"20240903093640-arwm3l1","Type":"NodeParagraph","Properties":{"id":"20240903093640-arwm3l1","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【英文名】CommonCarpesiumFruit"}]},{"ID":"20240903093640-mwodeza","Type":"NodeParagraph","Properties":{"id":"20240903093640-mwodeza","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【别名】鹄虱、鬼虱、北鹤虱"}]},{"ID":"20240903093640-wb8q2vk","Type":"NodeParagraph","Properties":{"id":"20240903093640-wb8q2vk","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903093640-xljonqz","Type":"NodeParagraph","Properties":{"id":"20240903093640-xljonqz","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"药材基源：为菊科植物天名精的果实。"}]},{"ID":"20240903093640-mig0ny9","Type":"NodeParagraph","Properties":{"id":"20240903093640-mig0ny9","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CarpesiumabrotanoidesL.."}]},{"ID":"20240903093640-eo18ymi","Type":"NodeParagraph","Properties":{"id":"20240903093640-eo18ymi","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月果实成熟时割取地上部分，晒干，打下果实，扬净。"}]},{"ID":"20240903093640-bqcf2qe","Type":"NodeParagraph","Properties":{"id":"20240903093640-bqcf2qe","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【原形态】天名精多年生草本，高50-100cm。茎直立，上部多分枝，密生短柔毛，下部近无毛。叶互生；下部叶片宽椭圆形或长圆形，长10-15cm，宽5-8cm，先端尖或钝，基部狭成具翅的叶柄，边缘有不规则的锯齿或全缘，上面有贴生短毛，下面有短柔毛和腺点，上部叶片渐小，长圆形，无柄。头关花序多数，沿茎枝腋生，有短梗或近无梗，直径6-8mm，平立或梢下垂；总苞钟状球形，总苞片3层，外层极短，卵形，先端尖，有短柔毛，中层和内层长圆形，先端圆钝，无毛；花黄色，外围的雌花花冠丝状，3-5齿先端有短喙，有腺点，无冠毛。药期6-8月，果期9-10月。"}]},{"ID":"20240903093640-s388ebj","Type":"NodeParagraph","Properties":{"id":"20240903093640-s388ebj","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903093640-8bkcjkn","Type":"NodeParagraph","Properties":{"id":"20240903093640-8bkcjkn","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"性状鉴别呈圆柱状，细小，长3-4mm，直径不及1mm。表面黄褐色或暗褐色，具多数纵棱。一端收缩呈细喙叶，先端扩展成灰白色圆环；另端稍尖，有着生痕迹。果皮薄，纤维性，种皮菲薄透明，子叶2，类白色，稍有油性。气特异，味微苦。"}]},{"ID":"20240903093640-64ah51e","Type":"NodeParagraph","Properties":{"id":"20240903093640-64ah51e","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"显微鉴别（1）果实横切面：外果皮细胞1列，均含草酸钙柱晶。中果皮薄壁细胞数列，棕色，细胞皱缩，界限不清楚，棱线处有纤维束，由数十个纤维组成，纤维壁厚，木化。内果皮细胞1列，深棕色。种皮细胞扁平。内胚乳有残存；胚七壁细胞充满糊粉粒及脂肪油滴，子叶最外层细胞尚含细小草酸钙结晶。"}]},{"ID":"20240903093640-z4a4dgs","Type":"NodeParagraph","Properties":{"id":"20240903093640-z4a4dgs","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"（2）粉末特征：棕黄色。①孔纹导管与纤维共生，纤维壁厚，另有细小螺纹导管。②厚壁细胞类方形，孔沟稀疏。③子叶薄壁细胞内含糊粉粒。"}]},{"ID":"20240903093640-mo483h3","Type":"NodeParagraph","Properties":{"id":"20240903093640-mo483h3","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"④柱晶较大。"}]},{"ID":"20240903093640-r9n8p4t","Type":"NodeParagraph","Properties":{"id":"20240903093640-r9n8p4t","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含鹤虱内酯（carpesialactone）[1]，天名精内酯酮（carabrone）[2]，三十烷（triacontane）[1]，正已酸（n-caproicacid），棕榈酸（palmiticacid），硬脂酸（stearicacid），油酸（oleicacid），亚油酸（linoleicacid），三十一烷（hentriacontane），豆甾醇（stigmasterol）[3]等。种子含二十六烷醇（cerylalcohol）[4]。"}]},{"ID":"20240903093640-l5zys0g","Type":"NodeParagraph","Properties":{"id":"20240903093640-l5zys0g","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903093640-eww9wce","Type":"NodeParagraph","Properties":{"id":"20240903093640-eww9wce","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"1.天名精子有驱虫作用，1%天名精子配5滴加人生理食盐水25ml中，加温37℃再放人大绦虫，结果1-2分钟即死。"}]},{"ID":"20240903093640-hph85md","Type":"NodeParagraph","Properties":{"id":"20240903093640-hph85md","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"2.野胡萝卜种子的醇提取物的水溶性部分，：有两种季铵型生物碱，一种从化学及药理上均确定其为胆碱，故有胆碱样作用；另一种则尚未确定。在动物试验中（离体豚鼠、大鼠小肠、大鼠子宫、猫支气管。离体蛙心等），还显示有罂粟碱样作用。种子还含黄酮类，据云能扩张冠状血管，有用于心绞痛者。种子中的甙性成分，对麻醉大有短暂的降压和抑制呼吸，能松弛大鼠、兔小肠及未孕子宫。也有报告，其提取物（可能为叶）对已孕或未孕的猫、豚鼠子宫有收缩作用。果实的热乙醇提取物有扩张冠伏动脉（离体猫心）的作用，与柯柯碱相似。其变种DaucuscarotaL.Var.sativaDC.的种子中提出的精油，对麻醉大小量可短暂的降低血压而不影响呼吸，大量则能导致持久性的降压并抑制呼吸，此精油对蛙心、在位犬心有直接抑制作用；对大鼠无镇痛作用，但却能抑制其中枢神经系统；它对士的宁及戊四氮引起的惊厥（蛙），有轻度的保护作用；它能松弛离体大鼠及兔小肠、大鼠子宫平滑肌；在离体蛙横纹肌标本上，它能降低乙酞胆碱引起的收缩。东北鹤虱的果实，试管内对蚯蚓、猪蛔虫、水蛙均有杀虫作用；10%鹤虱酒精提取物1ml于试管内对猪蛔头部作用不明显，须加入25ml才能使之挛缩停止。50%及25%浓度的鹤虱液体外实验，20小时后仅有少数的鼠烷虫Aspiculalistetraptcra死亡。"}]},{"ID":"20240903093640-4nezj45","Type":"NodeParagraph","Properties":{"id":"20240903093640-4nezj45","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【毒性】毒性：小鼠腹腔注射的半数致死量为1000mg/kg。"}]},{"ID":"20240903093640-76xkyjv","Type":"NodeParagraph","Properties":{"id":"20240903093640-76xkyjv","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；辛；性平；小毒"}]},{"ID":"20240903093640-qfwake9","Type":"NodeParagraph","Properties":{"id":"20240903093640-qfwake9","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【归经】归脾；胃；大肠经"}]},{"ID":"20240903093640-pp53hzq","Type":"NodeParagraph","Properties":{"id":"20240903093640-pp53hzq","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫消积。主蛔虫病；晓虫病"}]},{"ID":"20240903093640-w1adk6x","Type":"NodeParagraph","Properties":{"id":"20240903093640-w1adk6x","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：多入丸、散；煎汤，5-10g。"}]},{"ID":"20240903093640-79bpi0u","Type":"NodeParagraph","Properties":{"id":"20240903093640-79bpi0u","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【注意】鹤虱有毒；孕妇禁用。"}]},{"ID":"20240903093640-y9iwmqs","Type":"NodeParagraph","Properties":{"id":"20240903093640-y9iwmqs","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【附方】①治小儿疾病多有诸曳，腹中疼痛，发作肿聚，往来上下，痛无休止，亦攻心痛，呕吵涎沫，或吐清水，四肢赢困，面色青黄，饮食虽进，不生肌肤，或寒或热，沉沉嘿嘿：胡粉(炒)、鹤虱(去土)、摈榔、苦株根(去浮皮)各五十两，白矾(枯)十二两半。上为未，以面糊为丸，如麻子大。一岁儿服五丸，温浆水人生麻油一两点，调匀下之，温米饮下亦得。不拘时候。(《局方》化虫丸)②治蛔咬痛：鹤虱十两，捣筛，蜜和丸如梧子。以蜜汤空腹吞四十丸，日增至五十丸。慎酒肉。(《古今录验方》)③冶大肠虫出不断，断之复生，行坐不得：鹤虱未，水调半两服。(《怪证奇方》)④治齿痛：一、鹤虱一枚，擢置齿中。(《纲目》)二、鹤虱煎米醋漱口。(《纲目》)"}]},{"ID":"20240903093640-8g18uct","Type":"NodeParagraph","Properties":{"id":"20240903093640-8g18uct","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903093640-kvmulq6","Type":"NodeParagraph","Properties":{"id":"20240903093640-kvmulq6","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"1．《唐本草》：主蛔、蛲虫，用之为散，以肥肉汁，服方寸匕；亦丸、散中甲。"}]},{"ID":"20240903093640-58ca22v","Type":"NodeParagraph","Properties":{"id":"20240903093640-58ca22v","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"2．《日华子本草》：杀五脏虫，止疟及敷恶疮上。"}]},{"ID":"20240903093640-pqhvb24","Type":"NodeParagraph","Properties":{"id":"20240903093640-pqhvb24","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"3．《开宝本草》：心痛，以淡醋和半匕服。"}]},{"ID":"20240903093640-ua0sz7u","Type":"NodeParagraph","Properties":{"id":"20240903093640-ua0sz7u","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"4．《本经逢原》：善调逆气，治一身痰凝气滞，杀虫。"}]},{"ID":"20240903093640-yv25cn0","Type":"NodeParagraph","Properties":{"id":"20240903093640-yv25cn0","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"5．《岭南采药录》：疗恶府，解蛇毒，均捣敷。"}]},{"ID":"20240903093640-8t88sv9","Type":"NodeParagraph","Properties":{"id":"20240903093640-8t88sv9","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"6．《现代实用中药》：治腹痛，为绦虫、烷虫、蛔虫之驱除剂。"}]},{"ID":"20240903093640-z128muf","Type":"NodeParagraph","Properties":{"id":"20240903093640-z128muf","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"7．《药材资料汇编》：治久痢。"}]},{"ID":"20240903093640-8q7gm6c","Type":"NodeParagraph","Properties":{"id":"20240903093640-8q7gm6c","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗钩虫病。取鹤虱3两，洗净后水煎两次，药液混合浓缩至60ml（每10ml相当原生药5钱），过滤，加少量白糖调味，成人每晚睡前服30ml，连服两晚。小儿及年老体弱者酌减。观察57例，治疗后15天复查大匣，钩虫卵阴性者45例，阳性者12例，阴转率79%。治疗前合并蛔虫感染31例，治疗后复查大便，结果有19例蛔虫卵阴转。说明鹤虱亦有驱蛔作用。少数病例服药后数小时或第二天有轻微头晕、恶心、耳鸣、腹痛等反应，可自行消失。"}]},{"ID":"20240903093640-2tyijpn","Type":"NodeParagraph","Properties":{"id":"20240903093640-2tyijpn","updated":"20240903093704"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903093641-mlvzora","Type":"NodeThematicBreak","Properties":{"id":"20240903093641-mlvzora","updated":"20240903093704"}},{"ID":"20240903093642-njz6ih1","Type":"NodeParagraph","Properties":{"id":"20240903093642-njz6ih1","updated":"20240903093704"}}]}