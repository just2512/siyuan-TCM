"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 792px;","style":"width: 782px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山楂 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山楂 5-20240712150007-mc9t66a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 782px;\" parent-style=\"width: 792px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712150857-i1caukp","Type":"NodeThematicBreak","Properties":{"id":"20240712150857-i1caukp"}},{"ID":"20240830165859-93tjfoc","Type":"NodeParagraph","Properties":{"id":"20240830165859-93tjfoc","updated":"20240830165908"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：山楂"}]},{"ID":"20240830165859-ifw54zl","Type":"NodeParagraph","Properties":{"id":"20240830165859-ifw54zl","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"山楂《中国药典》"}]},{"ID":"20240830165859-nsicafm","Type":"NodeParagraph","Properties":{"id":"20240830165859-nsicafm","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānZhā"}]},{"ID":"20240830165859-fwbnyfv","Type":"NodeParagraph","Properties":{"id":"20240830165859-fwbnyfv","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSCRATAEGI"}]},{"ID":"20240830165859-dqxmkjw","Type":"NodeParagraph","Properties":{"id":"20240830165859-dqxmkjw","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【别名】红果子、棠棣子"}]},{"ID":"20240830165859-zqgvcua","Type":"NodeParagraph","Properties":{"id":"20240830165859-zqgvcua","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【来源】本品为蔷薇科植物山里红CrataeguspinnatifidaBge.var.majorN.E.Br.或山楂CrataeguspinnatifidaBge.的干燥成熟果实。秋季果实成熟时采收，切片，干燥。"}]},{"ID":"20240830165859-rjmk7es","Type":"NodeParagraph","Properties":{"id":"20240830165859-rjmk7es","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性状】本品为圆形片，皱缩不平，直径1～2.5cm，厚0.2～0.4cm。外皮红色，具皱纹，有灰白小斑点。果肉深黄色至浅棕色。中部横切片具5粒浅黄色果核，但核多脱落而中空。有的片上可见短而细的果梗或花萼残迹。气微清香，味酸、微甜。"}]},{"ID":"20240830165859-av60yjr","Type":"NodeParagraph","Properties":{"id":"20240830165859-av60yjr","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末1g，加醋酸乙酯4ml，超声处理15分钟，滤过，滤液作为供试品溶液。另取熊果酸对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各4μl，分别点于同一硅胶G薄层板上，以甲苯-醋酸乙酯-甲酸（20:4:0.5）为展开剂，展开，取出，晾干，喷以硫酸乙醇溶液（3→10），在80℃加热至斑点显色清晰，分别置日光及紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，日光下显紫红色斑点；紫外光灯（365nm）下，显橙黄色荧光斑点。"}]},{"ID":"20240830165859-ilgb8ka","Type":"NodeParagraph","Properties":{"id":"20240830165859-ilgb8ka","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【含量测定】"}]},{"ID":"20240830165859-oki5rln","Type":"NodeParagraph","Properties":{"id":"20240830165859-oki5rln","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"取本品细粉约1g[同时另取本品粉末测定水分（附录ⅨH第一法）]，精密称定，精密加水100ml，室温下浸泡4小时，时时振摇，滤过，精密量取滤液25ml，加水50ml，加酚酞指示液2滴，用氢氧化钠滴定液（0.1mol/L）滴定，即得。每1ml的氢氧化钠滴定液（0.1mol/L）相当于6.404mg的枸橼酸（C6H8O7）。"}]},{"ID":"20240830165859-pnfpvyi","Type":"NodeParagraph","Properties":{"id":"20240830165859-pnfpvyi","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含有机酸以枸橼酸（C6H8O7）计，不得少于5.0％。"}]},{"ID":"20240830165859-eboedy0","Type":"NodeParagraph","Properties":{"id":"20240830165859-eboedy0","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【炮制】净山楂：除去杂质及脱落的核。炒山楂：取净山楂片放锅内，炒至浅棕黄色。本品果肉黄褐色，偶见焦斑。气清香，味酸、微甜。照上述[鉴别]项下试验，应显相同的结果；照上述[含量测定]项下的方法测定，按干燥品计算，含有机酸以枸橼酸（C6H8O7）计，不得少于4.0％。焦山楂：取净山楂片放锅内，炒至表面焦褐色，内部黄褐色。本品表面焦褐色，内部黄褐色。气清香，味酸、微涩。照上述[鉴别]项下试验，应显相同的结果；照上述[含量测定]项下的方法测定，按干燥品计算，含有机酸以枸橼酸（C6H8O7）计，不得少于4.0％。"}]},{"ID":"20240830165859-n9qelq7","Type":"NodeParagraph","Properties":{"id":"20240830165859-n9qelq7","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性味】酸、甘、微温。"}]},{"ID":"20240830165859-4zhuvlo","Type":"NodeParagraph","Properties":{"id":"20240830165859-4zhuvlo","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、肝经。"}]},{"ID":"20240830165859-wvlhv5u","Type":"NodeParagraph","Properties":{"id":"20240830165859-wvlhv5u","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【功能主治】消食健胃，行气散瘀。用于肉食积滞，胃脘胀满，泻痢腹痛，瘀血经闭，产后瘀阻，心腹刺痛，疝气疼痛；高脂血症。焦山楂消食导滞作用增强。用于肉食积滞，泻痢不爽。"}]},{"ID":"20240830165859-b2zqlko","Type":"NodeParagraph","Properties":{"id":"20240830165859-b2zqlko","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～12g。"}]},{"ID":"20240830165859-ovek9rx","Type":"NodeParagraph","Properties":{"id":"20240830165859-ovek9rx","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防蛀。"}]},{"ID":"20240830165859-d0xtcj2","Type":"NodeParagraph","Properties":{"id":"20240830165859-d0xtcj2","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830165859-jcew2cc","Type":"NodeParagraph","Properties":{"id":"20240830165859-jcew2cc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"山楂《*辞典》"}]},{"ID":"20240830165859-god2zpf","Type":"NodeParagraph","Properties":{"id":"20240830165859-god2zpf","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【出处】《本草衍义补遗》"}]},{"ID":"20240830165859-ruxk7fj","Type":"NodeParagraph","Properties":{"id":"20240830165859-ruxk7fj","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānZhā"}]},{"ID":"20240830165859-4r12p3t","Type":"NodeParagraph","Properties":{"id":"20240830165859-4r12p3t","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【别名】朹、粱梅（《尔雅》），朹子（《尔雅》郭璞注），鼠查（《本草经集注》），羊梂（陶弘景），赤爪实（《唐本草》），棠梂子（《本草图经》），赤枣子（《桂海虞衡志》），山里红果、酸枣，鼻涕团、柿楂子（《百一选方》），山里果子（《履巉岩本草》），茅楂（《日用本草》），猴楂（《世医得效方》），映山红果（《救荒本草》），海红（《品汇精要》），酸梅子、山梨（《中国树木分类学》），酸查（《山东中药》）。"}]},{"ID":"20240830165859-wz1wv34","Type":"NodeParagraph","Properties":{"id":"20240830165859-wz1wv34","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷薇科植物山楂或野山楂的果实。秋季果实成熟时采摘。山楂采得后，横切成厚1.5～3毫米的薄片，立即晒干。野山楂采得后，晒干即可，或压成饼状后再晒干。商品山楂片称为\"北山楂\"；野山楂称为\"南山楂\"。"}]},{"ID":"20240830165859-8pygynp","Type":"NodeParagraph","Properties":{"id":"20240830165859-8pygynp","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830165859-vpb6k0d","Type":"NodeParagraph","Properties":{"id":"20240830165859-vpb6k0d","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①山楂"}]},{"ID":"20240830165859-wka1794","Type":"NodeParagraph","Properties":{"id":"20240830165859-wka1794","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"落叶乔木或大灌木，高达8米.树皮暗棕色，多分枝，枝条无刺或具稀刺。单叶互生；具托叶，托叶卵圆形至卵状披针形，边缘具锯齿；叶柄长2～4匣米；叶片阔卵形、三角卵形至菱状卵形，长6～12厘米，宽5～8厘米，先端尖，基部楔形，边缘有5～9羽状裂片，裂片有尖锐和不整齐的锯齿，上面绿色，有光泽，下面色较淡，两面脉上均被短柔毛。花10～12朵成伞房花序；花梗被短柔毛；萼片5，绿色，基部连合成杯状，上部5齿裂；花冠白色或带淡红色，直径8～13毫米，花瓣5，离生，倒宽卵形，长和宽均为6毫米；雄蕊20，不等长；心皮5，子房下位，5室，各室具一胚珠，花柱5，柱头圆形。梨果球形或圆卵形，直径约2.5厘米，深红色，具多数白色斑点，果之顶端有外曲的宿存花萼。种子5枚。花期5月。果期8～10月。"}]},{"ID":"20240830165859-dsmtoro","Type":"NodeParagraph","Properties":{"id":"20240830165859-dsmtoro","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"生于河岸的砂土或干燥多砂石的山坡上.栽培于东北南部、华北以至江苏一带。"}]},{"ID":"20240830165859-kmgsse6","Type":"NodeParagraph","Properties":{"id":"20240830165859-kmgsse6","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②野山楂，又名：小叶山楂、山果子。"}]},{"ID":"20240830165859-rf8rnz3","Type":"NodeParagraph","Properties":{"id":"20240830165859-rf8rnz3","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高达1.5米。枝条具刺，嫩枝被白色绒毛。单叶互生；托叶近卵形；叶柄长约3毫米，有时无柄；叶片倒卵形至倒卵状椭圆形，长1.5～6厘米，宽0.8～2.5厘米，先端尖，不裂或3深裂，边缘有缺刻及不整齐锯齿，基部楔形，渐窄缩。花5～6朵簇生成伞房花序；萼片5，卵状披针形，外侧密生细毛。梨果较小，呈红黄色，近圆形，直径约1～1.5厘米。花期5～6月。果期8～10月。"}]},{"ID":"20240830165859-6bcp6wh","Type":"NodeParagraph","Properties":{"id":"20240830165859-6bcp6wh","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"生于荒山坡、溪边、路边疏林及灌丛中。分布江苏、浙江、安徽、湖南、湖北、河南、四川、贵州、江西、福建、广东、广西、云南、陕西等地。"}]},{"ID":"20240830165859-tg0rspu","Type":"NodeParagraph","Properties":{"id":"20240830165859-tg0rspu","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"以上两种植物的根（山楂根）、木材（山楂木）、茎叶（山楂茎叶）、种子（山楂核）亦供药用，各详专条。"}]},{"ID":"20240830165859-alve6xs","Type":"NodeParagraph","Properties":{"id":"20240830165859-alve6xs","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830165859-xulm66n","Type":"NodeParagraph","Properties":{"id":"20240830165859-xulm66n","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①北山楂"}]},{"ID":"20240830165859-9ygdxc2","Type":"NodeParagraph","Properties":{"id":"20240830165859-9ygdxc2","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"为植物山楂的果实，呈球形或梨形，径约2.5厘米。表面深红色，有光泽，满布灰白色细斑点；顶端有宿存花萼，基部有果柄残痕。商品常为3～5毫米厚的横切片，多卷缩不平，果肉深黄色至浅棕色，切面可见5～6粒淡黄色种子，有的种子已脱落；有的片上可见短果枘或下凹的花萼残迹。气微清香，味酸微甜。以个大、皮红、肉厚者为佳。"}]},{"ID":"20240830165859-508faod","Type":"NodeParagraph","Properties":{"id":"20240830165859-508faod","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"主产山东、河北、河南、辽宁等省。陕西、山西、江苏亦产。"}]},{"ID":"20240830165859-ew1w4gw","Type":"NodeParagraph","Properties":{"id":"20240830165859-ew1w4gw","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②南山楂"}]},{"ID":"20240830165859-he7rqkn","Type":"NodeParagraph","Properties":{"id":"20240830165859-he7rqkn","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"为植物野山楂的果实，呈类圆球形，直径0.8～1.4厘米，间有压扁成饼状.表面灰红色，行细纹及小斑点，顶端有凹窝，其边缘略突出，基部有果柄残痕。质坚硬，核大，果肉薄，棕红色。气微，味酸微涩。以个匀、色红、质坚者为佳。"}]},{"ID":"20240830165859-f0m3rid","Type":"NodeParagraph","Properties":{"id":"20240830165859-f0m3rid","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"主产江苏，浙江、云南、四川等地。"}]},{"ID":"20240830165859-kh2wzox","Type":"NodeParagraph","Properties":{"id":"20240830165859-kh2wzox","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"此外尚有下列同属植物的果实在少数地区亦作山楂入药。"}]},{"ID":"20240830165859-j61vms0","Type":"NodeParagraph","Properties":{"id":"20240830165859-j61vms0","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①山里红"}]},{"ID":"20240830165859-ojn66dn","Type":"NodeParagraph","Properties":{"id":"20240830165859-ojn66dn","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"叶片宽卵形，3～5羽状深裂。果实近球形，直径约1.5厘米，红色。分布东北、华北及陕西、山东、江苏等地。"}]},{"ID":"20240830165859-8u1fy9r","Type":"NodeParagraph","Properties":{"id":"20240830165859-8u1fy9r","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②湖北山楂"}]},{"ID":"20240830165859-hrrtnfm","Type":"NodeParagraph","Properties":{"id":"20240830165859-hrrtnfm","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"叶卵形至矩圆状卵形，中部以上3～5裂；刺长1.5厘米；果实圆球形，直径约1～2.5厘米，黑赤色，有显著的小斑点。分布我国中部及陕西、江苏各地。"}]},{"ID":"20240830165859-3xfoev8","Type":"NodeParagraph","Properties":{"id":"20240830165859-3xfoev8","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③辽山楂"}]},{"ID":"20240830165859-anvfzho","Type":"NodeParagraph","Properties":{"id":"20240830165859-anvfzho","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"叶先端3～5裂，基部楔形，花药淡红色或紫色，果实鲜红色。分布东北及山西、内蒙古、新疆等地。"}]},{"ID":"20240830165859-aw64d0v","Type":"NodeParagraph","Properties":{"id":"20240830165859-aw64d0v","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④云南山楂"}]},{"ID":"20240830165859-ih8xz37","Type":"NodeParagraph","Properties":{"id":"20240830165859-ih8xz37","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"叶片卵状披针形或卵状椭圆形，常不裂，边缘具锯齿；果实近球形，暗红色或黄色带红褐色晕斑。分布西南及广东、广西等地。"}]},{"ID":"20240830165859-jsdalyj","Type":"NodeParagraph","Properties":{"id":"20240830165859-jsdalyj","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【化学成份】含表儿茶精[（-）-epicatechin]、槲皮素（quercetin）、金丝桃甙（hyperin）、绿原酸（chlorogenicacid）、山楂酸（crataegolicacid）、柠檬酸（citricacid）、苦杏仁甙（amygdalin）等。"}]},{"ID":"20240830165859-5pwfgmm","Type":"NodeParagraph","Properties":{"id":"20240830165859-5pwfgmm","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830165859-7y17k4d","Type":"NodeParagraph","Properties":{"id":"20240830165859-7y17k4d","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"山楂：拣净杂质，筛去核。炒山楂：取拣净的山楂，置锅内用文火炒至外面呈淡黄色，取出，放凉。焦山楂：取拣净的山楂，置锅内用武火炒至外面焦褐色，内部黄褐色为度，喷淋清水，取出，晒干。山楂炭：取拣净的山楂，置锅内用武火炒至外面焦黑色，但须存性，喷淋清水，取出，晒干。"}]},{"ID":"20240830165859-1rs86r3","Type":"NodeParagraph","Properties":{"id":"20240830165859-1rs86r3","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"九月霜后取山楂实带熟者，去核，曝干。或蒸熟去皮核，捣作饼子，日干用。\""}]},{"ID":"20240830165859-zbgec0u","Type":"NodeParagraph","Properties":{"id":"20240830165859-zbgec0u","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830165859-21phifs","Type":"NodeParagraph","Properties":{"id":"20240830165859-21phifs","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"酸甘，微温。"}]},{"ID":"20240830165859-x8a3h6o","Type":"NodeParagraph","Properties":{"id":"20240830165859-x8a3h6o","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味酸，冷，无毒。\""}]},{"ID":"20240830165859-dg627g8","Type":"NodeParagraph","Properties":{"id":"20240830165859-dg627g8","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②《日用本草》：\"味甘酸，无毒。\""}]},{"ID":"20240830165859-evra0ir","Type":"NodeParagraph","Properties":{"id":"20240830165859-evra0ir","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③《本草蒙筌》：\"味甘辛，气平，无毒。\""}]},{"ID":"20240830165859-jbbz2ji","Type":"NodeParagraph","Properties":{"id":"20240830165859-jbbz2ji","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"酸甘，微温。\""}]},{"ID":"20240830165859-qvdou4w","Type":"NodeParagraph","Properties":{"id":"20240830165859-qvdou4w","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830165859-820x5m6","Type":"NodeParagraph","Properties":{"id":"20240830165859-820x5m6","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"入脾、胃、肝经。"}]},{"ID":"20240830165859-0jka7xm","Type":"NodeParagraph","Properties":{"id":"20240830165859-0jka7xm","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾经。\""}]},{"ID":"20240830165859-vbt66ev","Type":"NodeParagraph","Properties":{"id":"20240830165859-vbt66ev","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足阳明、太阴经。\""}]},{"ID":"20240830165859-xpl72nc","Type":"NodeParagraph","Properties":{"id":"20240830165859-xpl72nc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入脾、肝二经。\""}]},{"ID":"20240830165859-t0jd6kk","Type":"NodeParagraph","Properties":{"id":"20240830165859-t0jd6kk","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④《本草经解》：\"入手太阴肺经，足厥阴肝经。\""}]},{"ID":"20240830165859-zqrsuyd","Type":"NodeParagraph","Properties":{"id":"20240830165859-zqrsuyd","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830165859-8elxeet","Type":"NodeParagraph","Properties":{"id":"20240830165859-8elxeet","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"消食积，散瘀血，驱绦虫。治肉积，症瘕，痰饮，痞满，吞酸，泻痢，肠风，腰痛，疝气产后儿枕痛，恶露不尽，小儿乳食停滞。消食健胃，行气散瘀。用于肉食积滞、胃烷胀满、泻痢腹痛、瘀血经闭、产后瘀阻、心腹刺痛、疝气疼痛、高血脂症。"}]},{"ID":"20240830165859-ewseq57","Type":"NodeParagraph","Properties":{"id":"20240830165859-ewseq57","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"煮汁洗漆疮。\""}]},{"ID":"20240830165859-dvvh4rs","Type":"NodeParagraph","Properties":{"id":"20240830165859-dvvh4rs","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"汁服主利，洗头及身上疮痒。\""}]},{"ID":"20240830165859-gp7zlvt","Type":"NodeParagraph","Properties":{"id":"20240830165859-gp7zlvt","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"治痢疾及腰疼。\""}]},{"ID":"20240830165859-mi9toj8","Type":"NodeParagraph","Properties":{"id":"20240830165859-mi9toj8","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④《履巉岩本草》：\"能消食。\""}]},{"ID":"20240830165859-slxx42f","Type":"NodeParagraph","Properties":{"id":"20240830165859-slxx42f","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑤《日用本草》：\"化食积，行结气，健胃宽膈，消血痞气块。\""}]},{"ID":"20240830165859-3qwhgaz","Type":"NodeParagraph","Properties":{"id":"20240830165859-3qwhgaz","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"消肉积滞，下气；治吞酸，积块。\""}]},{"ID":"20240830165859-r5voj8y","Type":"NodeParagraph","Properties":{"id":"20240830165859-r5voj8y","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑦《本草蒙筌》：\"行结气，疗颓疝。\""}]},{"ID":"20240830165859-fy47t3o","Type":"NodeParagraph","Properties":{"id":"20240830165859-fy47t3o","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑧宁原《食鉴本草》：\"化血块，气块，活血。\""}]},{"ID":"20240830165859-m31rurs","Type":"NodeParagraph","Properties":{"id":"20240830165859-m31rurs","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑨《纲目》：\"化饮食，消肉积，癥瘕，痰饮痞满吞酸，滞血痛胀。\""}]},{"ID":"20240830165859-wafpms9","Type":"NodeParagraph","Properties":{"id":"20240830165859-wafpms9","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"治脾虚湿热，消食磨积，利大小便。\""}]},{"ID":"20240830165859-2qrbixn","Type":"NodeParagraph","Properties":{"id":"20240830165859-2qrbixn","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑾《本草撮要》：\"冻疮涂之。\""}]},{"ID":"20240830165859-mnswvzi","Type":"NodeParagraph","Properties":{"id":"20240830165859-mnswvzi","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～4钱；或入丸、散。外用：煎水洗或捣敷。"}]},{"ID":"20240830165859-e3m1xqw","Type":"NodeParagraph","Properties":{"id":"20240830165859-e3m1xqw","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830165859-qlwxnph","Type":"NodeParagraph","Properties":{"id":"20240830165859-qlwxnph","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"脾胃虚弱者慎服。"}]},{"ID":"20240830165859-o69t9rv","Type":"NodeParagraph","Properties":{"id":"20240830165859-o69t9rv","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"生食多，令人嘈烦易饥，损齿，齿龋人尤不宜。\""}]},{"ID":"20240830165859-pjs2bqs","Type":"NodeParagraph","Properties":{"id":"20240830165859-pjs2bqs","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"脾胃虚，兼有积滞者，当与补药同施，亦不宜过用。\""}]},{"ID":"20240830165859-wa80yed","Type":"NodeParagraph","Properties":{"id":"20240830165859-wa80yed","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"气虚便溏，脾虚不食，二者禁用。服人参者忌之。\""}]},{"ID":"20240830165859-55xb71p","Type":"NodeParagraph","Properties":{"id":"20240830165859-55xb71p","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④《随息居饮食谱》：\"多食耗气，损齿，易饥，空腹及羸弱人或虚病后忌之。\""}]},{"ID":"20240830165859-ls4hr6n","Type":"NodeParagraph","Properties":{"id":"20240830165859-ls4hr6n","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830165859-iw4fpss","Type":"NodeParagraph","Properties":{"id":"20240830165859-iw4fpss","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①治一切食积：山楂四两，白术四两，神曲二两。上为末，蒸饼丸，梧于大，服七十丸，白汤下。（《丹溪心法》）"}]},{"ID":"20240830165859-f88ac25","Type":"NodeParagraph","Properties":{"id":"20240830165859-f88ac25","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②治食肉不消：山楂肉四两，水煮食之，并饮其汁。（《简便单方》）"}]},{"ID":"20240830165859-zqpawdd","Type":"NodeParagraph","Properties":{"id":"20240830165859-zqpawdd","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③治诸滞腹痛：山楂一味煎汤饮。（《方脉正宗》）"}]},{"ID":"20240830165859-ozhaiv7","Type":"NodeParagraph","Properties":{"id":"20240830165859-ozhaiv7","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"④治痢疾赤白相兼：山楂肉不拘多少，炒研为末，每服一、二钱，红痢蜜拌，白痢红白糖拌，红白相兼，蜜砂糖各半拌匀，白汤调，空心下。（《医钞类编》）"}]},{"ID":"20240830165859-utvdwhb","Type":"NodeParagraph","Properties":{"id":"20240830165859-utvdwhb","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑤治肠风：酸枣并肉核烧灰，米饮调下。（《百一选方》）"}]},{"ID":"20240830165859-qu9ezw5","Type":"NodeParagraph","Properties":{"id":"20240830165859-qu9ezw5","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑥治老人腰痛及腿痛：棠梂子、鹿茸（炙）等分。为末，蜜丸梧子大，每服百丸，日二服。（《纲目》）"}]},{"ID":"20240830165859-h54kdkr","Type":"NodeParagraph","Properties":{"id":"20240830165859-h54kdkr","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑦治寒湿气小腹疼，外肾偏大肿痛：茴香、柿楂子。上等分为细末，每服一钱或二钱，盐、酒调，空心热服。（《百一选方》）"}]},{"ID":"20240830165859-quzq4ko","Type":"NodeParagraph","Properties":{"id":"20240830165859-quzq4ko","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"⑧治产妇恶露不尽，腹中疼痛，或儿枕作痛：山楂百十个，打碎煎汤，入砂糖少许，空心温服。（朱震亨）"}]},{"ID":"20240830165859-3usoynx","Type":"NodeParagraph","Properties":{"id":"20240830165859-3usoynx","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830165859-qqj65hu","Type":"NodeParagraph","Properties":{"id":"20240830165859-qqj65hu","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"①治疗绦虫病"}]},{"ID":"20240830165859-r2wzhqj","Type":"NodeParagraph","Properties":{"id":"20240830165859-r2wzhqj","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"用鲜山楂2斤（干品半斤，小儿酌减），洗净去核，下午3时开始零食，晚10时吃完，晚饭禁食。次晨用槟榔2两加水煎至1茶杯，1次服完，卧床休息。有大便感觉时尽量坚持一段时间再大便，即可排出完整绦虫。冬天应坐在温水便桶上大便，避免虫体遇冷收缩而不能完整排出。观察40例均有效。"}]},{"ID":"20240830165859-qcp9ixt","Type":"NodeParagraph","Properties":{"id":"20240830165859-qcp9ixt","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"②治疗急性细菌性痢疾"}]},{"ID":"20240830165859-zqv0n0q","Type":"NodeParagraph","Properties":{"id":"20240830165859-zqv0n0q","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"用20％山楂煎剂加糖矫味，每服200毫升（小儿酌减），每日3次，7～10天为一疗程。治疗24例，全部有效。又有用山楂2两煎服，治轻型及中型菌痢30例，除3例无效外均治愈或好转。或用生热山楂片各1两，加水500毫升煮开5分钟，分2次服（小儿酌减），4～6天为一疗程，亦有效果。"}]},{"ID":"20240830165859-ex1me77","Type":"NodeParagraph","Properties":{"id":"20240830165859-ex1me77","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"③用于降低血清胆甾醇"}]},{"ID":"20240830165859-enoydr1","Type":"NodeParagraph","Properties":{"id":"20240830165859-enoydr1","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"每日用山楂1两，毛冬青2两，分2次煎服。观察20例，治前血清胆甾醇平均253.2毫克％，治后下降至207毫克％，平均每例下降46.2毫克％，经统计学处理，差异非常显著。20例中有11例血清胆甾醇降至200毫克％以下，平均每例下降62.9毫克％。认为山楂所起的作用是主要的，因为毛冬青降低血清胆甾醇的效果，各地观察结果颇不一致，目前尚难肯定；而本组病例中有4例曾单服山楂而未用毛冬青，亦取得效果，服药前血清胆甾醇平均为259.7毫克％，服药至第6周时复查，下降至214毫克％。"}]},{"ID":"20240830165859-bv4nj81","Type":"NodeParagraph","Properties":{"id":"20240830165859-bv4nj81","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"此外，将山楂的花和叶制成浸剂服用，有降低血压的功效。"}]},{"ID":"20240830165859-kq7jx9x","Type":"NodeParagraph","Properties":{"id":"20240830165859-kq7jx9x","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830165859-kn59rlc","Type":"NodeParagraph","Properties":{"id":"20240830165859-kn59rlc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"山楂《中华本草》"}]},{"ID":"20240830165859-4722ptf","Type":"NodeParagraph","Properties":{"id":"20240830165859-4722ptf","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草衍义补遗》。"}]},{"ID":"20240830165859-so1ehyj","Type":"NodeParagraph","Properties":{"id":"20240830165859-so1ehyj","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānZhā"}]},{"ID":"20240830165859-igu4iup","Type":"NodeParagraph","Properties":{"id":"20240830165859-igu4iup","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【英文名】HawthornFruit,fruitofchineseHawthorn,fruitofLargechineseHawthorn,fruitofNipponHawthorn,FruitofHupehhawthon,FruitofRedhawHawthorn,fruitofYannanhawthorn"}]},{"ID":"20240830165859-hynk6x6","Type":"NodeParagraph","Properties":{"id":"20240830165859-hynk6x6","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【别名】朹、檕梅、朹子、鼠查、羊梂、赤爪实、棠梂子、赤枣子、山里红果、酸枣、鼻涕团、柿樝子、山里果子、茅樝、猴樝、映山红果、海红、酸梅子、山梨、酸查、野山楂又名：小叶山楂、山果子。"}]},{"ID":"20240830165859-0xxf7tt","Type":"NodeParagraph","Properties":{"id":"20240830165859-0xxf7tt","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830165859-a8myxtq","Type":"NodeParagraph","Properties":{"id":"20240830165859-a8myxtq","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物山里红、山楂的成熟果实。"}]},{"ID":"20240830165859-0et6o54","Type":"NodeParagraph","Properties":{"id":"20240830165859-0et6o54","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.CrataeguspinnatifidaBungevar.majorN.E.Br.2.CrataeguspinnatifidaBunge"}]},{"ID":"20240830165859-atyra8f","Type":"NodeParagraph","Properties":{"id":"20240830165859-atyra8f","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月果实成熟后采收。"}]},{"ID":"20240830165859-wbz2ztu","Type":"NodeParagraph","Properties":{"id":"20240830165859-wbz2ztu","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830165859-waeec5f","Type":"NodeParagraph","Properties":{"id":"20240830165859-waeec5f","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"1.山里红落叶乔木，高达6m。枝刺长1-2cm，或无刺。单叶互生；叶柄长2-6cm；叶片阔卵形或三角卵形稀菱状卵形，长6-12cm，宽5-8cm，有2-4对羽状裂片，先端渐尖，基部宽楔形，上面有光泽，下面沿叶脉被短柔毛，边缘有不规则重锯齿。伞房花序，直径约4-6cm；萼筒钟状，5齿裂；花冠白色，直径约1.5cm，花瓣5，倒卵形或近圆形；雄蕊约20，花药粉红色；雌蕊1，子房下位，5室，花柱5。梨果近球形，直径可达2.5cm，深红色，有黄白色小斑点，萼片脱落很迟，先端留下一圆形深洼；小核3-5，向外的一面稍具棱，向内面侧面平滑。花期5-6月。果期8-10月。"}]},{"ID":"20240830165859-mveq5aa","Type":"NodeParagraph","Properties":{"id":"20240830165859-mveq5aa","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.山楂本种与山里红极为相似，仅果形较小，直径1.5cm；叶片亦较小，且分裂较深。"}]},{"ID":"20240830165859-ouam02l","Type":"NodeParagraph","Properties":{"id":"20240830165859-ouam02l","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830165859-poqvvet","Type":"NodeParagraph","Properties":{"id":"20240830165859-poqvvet","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"生态环境：山楂生于海拔100-1500m的溪边、山谷、林缘或灌木丛中。"}]},{"ID":"20240830165859-0lmmpbk","Type":"NodeParagraph","Properties":{"id":"20240830165859-0lmmpbk","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"资源分布：1.山里红分布于华北及山东、江苏、安徽、河南等地。"}]},{"ID":"20240830165859-hiynka3","Type":"NodeParagraph","Properties":{"id":"20240830165859-hiynka3","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.分布于东北及内蒙古、河北、山西、陕西、山东、江苏、浙江、江南等地。"}]},{"ID":"20240830165859-g3uc8q9","Type":"NodeParagraph","Properties":{"id":"20240830165859-g3uc8q9","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830165859-qrmxrvf","Type":"NodeParagraph","Properties":{"id":"20240830165859-qrmxrvf","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"生物学特性耐寒抗风，平地山坡都能栽培。对土壤条件要求以沙性为最好，粘重土则生长较差。"}]},{"ID":"20240830165859-hc4e5qh","Type":"NodeParagraph","Properties":{"id":"20240830165859-hc4e5qh","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、分株、嫁接繁殖。种子繁殖：成熟的种子须经沙藏处理，挖50-100cm深沟，将种子以3-5倍湿沙混匀放入沟内至离沟沿10cm为止，再覆沙至地面，结冻前再盖土至地面30-50cm，第2年6-7月将种子翻倒，秋季取出播种，也可第3年春播。条播行距20cm，开沟4cm深，宽3-5cm，每1m播种200-300粒，播后覆薄土，上再覆1cm厚沙，以防止土壤板结及水分蒸发，每1hm2播种量375-450kg。分株繁殖：挖出根蘖，栽于苗圃进行嫁接。根插法：春季将粗0.5-1cm的根切成12-14cm根段，扎成捆，用0.3×10-6-0.5×1010-6“九二O”浸后以湿沙培放6-7d，斜插于苗圃，灌水使根和土壤密接，15d左右可以萌芽，当年苗高达50-60cm时，可在8月初进行芽接。嫁接繁殖：春、夏、秋季均可进行，用种子繁殖的实生苗或分株苗均可作砧木，采用芽接或枝接，发芽接为主。"}]},{"ID":"20240830165859-3dw26q3","Type":"NodeParagraph","Properties":{"id":"20240830165859-3dw26q3","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"田间管理播种苗高达10cm时间苗，移栽行株距为(50-60)cm×(10-15)cm。结合秋季耕翻施入有机肥，从开花至果实旺盛期可于叶面喷无机肥。定期整形剪枝、耕翻除草、刨去根蘖、培土等。"}]},{"ID":"20240830165859-kbdpr5s","Type":"NodeParagraph","Properties":{"id":"20240830165859-kbdpr5s","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830165859-svynter","Type":"NodeParagraph","Properties":{"id":"20240830165859-svynter","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"性状鉴别1.山里红果实近球形，直径1-2.5cm。表面鲜红色至紫红色，有光泽，满布灰白色的斑点，顶端有宿存花萼，基部有果柄残痕。商品常加工成纵切片或横切片，厚2-8mm，多卷曲皱缩不平。果肉厚，深黄色至浅棕色，切面可见淡黄色种子3-5颗，有的已脱落。质坚硬。气微清香，味酸微甜。以片大、皮红、肉厚者为佳。"}]},{"ID":"20240830165859-gtkq2di","Type":"NodeParagraph","Properties":{"id":"20240830165859-gtkq2di","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.山楂果实类球形，直径1-1.5cm。表面深红色，有小斑点，顶端有宿存花萼，基部有细长果柄。质坚硬。气微清香，味酸微涩。以个匀、色棕红、肉质者为佳。"}]},{"ID":"20240830165859-7hpivdc","Type":"NodeParagraph","Properties":{"id":"20240830165859-7hpivdc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"显微鉴别果实横切面：1.山里红外果皮细胞1列，类方形，外被角质层，胞腔含棕红色色素，排列整齐；中果皮极厚，全为薄壁组织，外侧（外果皮下）有1-2列含有棕色色素的薄壁细胞，其内侧广大中果皮薄壁组织中含多数淀粉粒、少数草酸钙簇晶，并有纵横的维管束散在；淀粉粒极小，类圆形或类三角形，直径4-8μm，脐点多呈“一”字形，单粒或2-3个分粒组成的复粒；草酸钙簇晶直径20-28μm。"}]},{"ID":"20240830165859-7duokma","Type":"NodeParagraph","Properties":{"id":"20240830165859-7duokma","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.山楂中果皮薄壁组织有多数石细胞散在，石细胞类圆形，少数呈不规则形，直径60-100μm，壁厚薄不一，壁孔及孔沟明显；并有草酸钙簇晶散在，草酸钙簇晶直径12-20μm。（图3）粉末特征：山里红深棕色。①石细胞较多，成群或单个散在，近无毛或淡黄色；呈类圆形、长圆形、长条形、类三角形或不规则形，直径18-173μm，长约至185μm，层纹明显，孔沟较粗，有分叉，胞腔小，有的含橙黄色物。较小的石细胞有时排列成行，并与纤维相连。②草酸钙方晶散在，或包埋于薄壁细胞的棕色物中，方晶直径13-52μm，也有仅2-5μm的小方晶。③草酸钙簇晶单个散在或存在于果肉细胞中，直径27-41μm，棱角较钝。④果肉薄壁细胞皱缩，细胞界限不清，胞腔内含棕色物，并有淀粉及草酸钙结晶。⑤纤维成束，无色或淡黄色。纤维较长，直径11-36μm，壁极厚，约至17μm，孔沟不明显或较细密。⑥果皮表皮细胞表面观类多角形、类圆形或长圆形，直径18-47μm，壁稍厚，胞腔内含棕色或橙红色物。⑦淀粉粒单粒圆球形、类圆形或长圆形，有的一端稍尖突，直径4-12μm，脐点隐约可见，呈点状或裂缝状；复粒常由2-4分粒组成。"}]},{"ID":"20240830165859-w0u9oph","Type":"NodeParagraph","Properties":{"id":"20240830165859-w0u9oph","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830165859-n5sg9vc","Type":"NodeParagraph","Properties":{"id":"20240830165859-n5sg9vc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"1.山里红果实含左旋表儿茶精(epicatechin)，槲皮素(quercetin)，金丝桃甙(hyperoside)，绿原酸(chlorogenicacid)，枸橼酸(citricacid)及其单甲酯(citricacidsymmetricalmonomethylester)，二甲酯(citricacidsymmetricaldimethylester)和三甲酯(citricacidtrimethylester)，蔗糖(sucrose)，黄烷聚合物(flavanpolymers)，还含熊果酸(ursolicacid)0.27%。"}]},{"ID":"20240830165859-hfxtgk3","Type":"NodeParagraph","Properties":{"id":"20240830165859-hfxtgk3","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.山楂果实含左旋儿表茶精，槲皮素，金丝桃甙，绿原酸，枸橼酸，枸橼酸单甲酯，枸橼酸二甲酯，枸橼酸三甲酯，黄烷聚合物。果实100g中含花色素类(anthocyanin)11.28-16.04mg，酸类1.27%-2.46%，可溶性糖类9690-9910mg。"}]},{"ID":"20240830165859-yoy66dv","Type":"NodeParagraph","Properties":{"id":"20240830165859-yoy66dv","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"市售商品“北山楂”（包括山楂和山里红）。果实含黄酮约3%，另含熊果酸约0.5%，游离糖约20%。从中检出草酸(oxalicacid)，枸橼酸，苹果酸(malicacid)，琥柏酸(succinicacid)，经测定枸橼酸含量约为5%。另报道，北山楂果实中含枸橼酸1.88%-3.14%，琥珀酸1.04%-1.15%，乙酸(aceticacid)0.54%-0.61%维生素C0.03%-0.1%。果肉中脂肪酸有：亚油酸(linoleicacid)29.01%-38.23%，棕榈酸(palmiticacid)18.10%-23.54%，硬脂酸(stearicacid)2.23%-3.74%，油酸(oleicacid)11.69%-22.13%，亚麻酸(linolenicacid)20.24%-30.69%。"}]},{"ID":"20240830165859-b93sjl2","Type":"NodeParagraph","Properties":{"id":"20240830165859-b93sjl2","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830165859-pgibdnk","Type":"NodeParagraph","Properties":{"id":"20240830165859-pgibdnk","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"1．促进消化作用山值含有脂肪酶，能促进脂肪消化，并能增加胃消化酶的分泌，促进消化。对胃肠功能具有一定调节作用，对活动亢进的免十二指肠平滑肌呈抑制作用，面对松弛的大鼠胃平滑肌有轻度的增强收缩作用。山植酸提取液及水溶液对乙酰胆碱及Ba2引起免、鼠离体胃肠平滑肌收缩具有明显抑制作用，而对大鼠弛张状态下的胃平滑肌具有促收缩作用。"}]},{"ID":"20240830165859-m13wqp2","Type":"NodeParagraph","Properties":{"id":"20240830165859-m13wqp2","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2对心血管系统的作用（1）对心脏的作用山植提取物使在体、离体蟾蜍心收缩力增强，且持续时间长。山植酸对疲劳衰弱的蟾蜍心脏停博有恢复跳动的作用。山楂内所含的三萜酸能改善冠脉循环而使冠状动脉性衰竭得以代偿，达到强心作用。山植制剂对豚鼠的心脏能引起显着持久的扩张冠脉作用，并增强心博能力。北山植提取物4g/kg给豚鼠静脉注射连续6d，对异丙肾上腺素造成的心肌损伤有一定保护作用。山楂可增加冠脉流量，降低心肌耗氧量，对心肌缺血、缺氧有保护作用。山植浸膏以及总黄酮甙给犬静脉注射，冠脉血流量可增加37.5%，心肌耗氧量开始稍有增加，但随后逐渐减少。山植黄酮对免实验性急性心肌梗死模型能缩小心肌梗死的范围，减轻S－T段改变。山植流浸膏对动物垂体后叶素、异丙肾上豚素所致急性心肌缺血有一定保护作用。给狗喂饲山植（含原矢菊甙元低聚物）以后，其左心室血流量增加可达数小时之久，最大增加量可达平时血流量的70%，给猫静脉注射原矢菊甙元低聚物，也可使其心脏血流量呈剂量依赖性地增加，并使动脉血压略有下降。山楂浸膏对垂体后叶索引起的心律不齐有一定的抑制作用，三萜烯酸类能增加冠状动脉血流量，提高心肌对强心甙作用的敏感性，增加心排出量，减弱心肌应激性和传导性，具有抗心室颤动、心房颤动和阵发性心律失常等作用。"}]},{"ID":"20240830165859-qqmsuz1","Type":"NodeParagraph","Properties":{"id":"20240830165859-qqmsuz1","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"（2）降压作用实验证明，山植有较持久的降压作用。山楂乙醇浸出物静脉给药，能使麻醉兔血压缓慢下降，持续3h。山楂总黄酮10mg/kg静注能使猫血压下降40%，维持5-10min，其总提取物对兔、猫亦有较为明显的中枢降压作用。北山楂黄酮、三萜及水解物静注、腹腔注射、十二指肠给药，对麻醉猫的血压均显示不同程度的降压效应。山植水解物20mg/kg腹腔注射，5-25mg/kg静注，血压下降率分别为26%、32.5%-44.5%；山楂黄酮25mg/kg、50mg/kg腹腔注射，12．5mg/kg、25mg/kg静注，十二指肠给药100mg/kg、150mg/kg，降压率分别为45．3%、66．6%、52%、30%、38．1%、39．2%，维持时间分别为240min、130min、100min、81min、540min、540min。山楂三萜酸在20-40mg/kg范围以25mg/kg静注降压作用最强，再加大剂量其降压效应亦不相应增加。山楂黄酮、三萜酸水解物以同等剂量（25mg/kg）静注比较，以三萜酸降压效应最明显；但产生显着降压作用之剂量以黄酮为最低。"}]},{"ID":"20240830165859-ttgysto","Type":"NodeParagraph","Properties":{"id":"20240830165859-ttgysto","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"3．降脂作用山植提取物和醇浸膏0．5mg/kg口服能使动脉粥样硬化兔血中卵磷脂比例提高，胆固醇和脂质在器官上的沉积降低。南山楂粉口服有降低实验性高脂血症兔的血清总胆固醇和β脂蛋白的作用，血清β脂蛋白的降低值亦类似。15%、30%的山楂浸膏对乳幼大白鼠有降脂作用，其中以30%的山楂浸膏为显着。豚鼠服用山楂水煎剂后，对胆固醇含成酶活力有抑制作用，可使其肝细胞微粒体及小肠粘膜的羟甲基戊二酰铺酶A还原酶活力分别下降70%和67%左右。山里红水浸膏能显着降低血清总胆固醇含量，其作用显着大于泛硫乙胺，并能明显增加血清中HDL－C、HDL2－C、HDL3－C浓度，其作用可能是通过提高血清中HDL及其亚组分浓度，增加胆固醇的排泄而实现的。"}]},{"ID":"20240830165859-2c1sfye","Type":"NodeParagraph","Properties":{"id":"20240830165859-2c1sfye","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"4．抗氧化作用山楂水提取液有清除O/2自由基、抑制小鼠肝脏脂质过氧化反应，减低经O/2诱导的透明质酸解聚作用。"}]},{"ID":"20240830165859-lasxyzp","Type":"NodeParagraph","Properties":{"id":"20240830165859-lasxyzp","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"5．对免疫功能的作用山楂的水煎醇沉制成的注射液皮下注射给药连续9d,可使家兔血清溶菌酶活性、血清血凝抗体滴度、心血T淋巴细胞E玫瑰花环形成率及T淋巴细胞转化率均显着增强，提示有免疫增强作用。"}]},{"ID":"20240830165859-cl0wmxj","Type":"NodeParagraph","Properties":{"id":"20240830165859-cl0wmxj","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"6．抗菌作用山楂对志贺痢疾杆菌、福氏痢疾杆菌、宋内痢疾杆菌等有较强的抗菌作用；对金黄色葡萄球菌、乙型链球菌。大肠杆菌、变形杆菌、炭疽杆菌、白喉杆菌、伤寒杆菌、绿脓杆菌等也有抗菌作用；一般对革兰阳性细菌作用强于革兰阴性细菌。"}]},{"ID":"20240830165859-x0ndj1s","Type":"NodeParagraph","Properties":{"id":"20240830165859-x0ndj1s","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"7．防癌作用在胃液的PH条件下，山楂提取液能够消除合成亚硝胺的前体物质，即能阻断合成亚硝胺。山楂提取液对大鼠和小鼠体内合成甲基苄基亚硝胶诱癌有显着的阻断作用。而山楂的丙酮提取液经对致癌剂黄曲霉素B1诱导TA98移码型、TA100碱基置换突变株回复突变抑制作用实验表明：山楂对黄曲霉素BI的致突变作用有显着抑制效果。说明山楂可能对预防肝癌有意义。"}]},{"ID":"20240830165859-gdv5fwc","Type":"NodeParagraph","Properties":{"id":"20240830165859-gdv5fwc","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"8．其他作用山楂2．5g/kg腹腔注射能显着延长小鼠戊巴比妥钠睡眠持续时间。山植有收缩子宫、促进子宫复原、止痛作用。"}]},{"ID":"20240830165859-1htm54y","Type":"NodeParagraph","Properties":{"id":"20240830165859-1htm54y","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"9．毒性山楂的聚合黄烷类成分小鼠腹腔和皮下注射的LD5O外分别为130mg/kg、300mg/kg；10％的山楂浸膏给雄性大鼠及小鼠口服，不久出现镇静作用，30min后死于呼吸衰竭，小鼠的LD50为18．5ml/kg，大鼠的LD50为33．8ml/kg；10%的山楂总皂甙亦不会引起兔的溶血作用。"}]},{"ID":"20240830165859-gzgonyh","Type":"NodeParagraph","Properties":{"id":"20240830165859-gzgonyh","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【毒性】急性毒性试验：100%山楂注射液（水提醇沉品），对小鼠iv的LD50为1.042ml/kg。"}]},{"ID":"20240830165859-q573z81","Type":"NodeParagraph","Properties":{"id":"20240830165859-q573z81","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830165859-j62erba","Type":"NodeParagraph","Properties":{"id":"20240830165859-j62erba","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"（1）取本品粉末1g，加乙醚10ml，振摇混合2min，滤过。滤液蒸干，残留物加冰醋酸1ml，溶解，再加硫酸1-2滴，溶液紫红色，渐在紫色。（检查甙类）（2）取山楂浸膏5g置圆底烧瓶中，加95%乙醇40ml回流3次，每次30min，滤过，合并滤液，浓缩至近干，加10ml蒸馏水溶解后，每次以5ml正丁醇提取至无黄酮反应，减压回收正丁醇至近干，加适量30%乙醇溶解，滤过，移至25ml容量瓶中，加30%乙醇至刻度，摇匀。取乙醇液滴于滤纸上，滴加1%三氯化铝乙醇溶液，干后置紫外灯光(365nm)下观察，可见黄或黄绿色荧光斑点。（检查黄酮类）（3）取（2）项下乙醇液滴于滤纸上，置氨蒸气上熏30s，立即置紫外光灯下观察，可见极明显的黄或黄绿色荧光斑点。"}]},{"ID":"20240830165859-1d8u9cy","Type":"NodeParagraph","Properties":{"id":"20240830165859-1d8u9cy","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"（4）取（2）项下乙醇液1ml置试管中加入盐酸数滴，再加入镁粉适量，水浴上加热，显桃红色泡沫反应。（检查黄铀类）"}]},{"ID":"20240830165859-6ltr4j2","Type":"NodeParagraph","Properties":{"id":"20240830165859-6ltr4j2","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【炮制】山楂：拣净杂质，筛去核。炒山楂：取拣净的山楂，置锅内用文火炒至外面呈淡黄色，取出，放凉。焦山楂：取拣净的山楂，置锅内用武火炒至外面焦褐色，内部黄褐色为度，喷淋清水，取出，晒干。山楂炭：取拣净的山楂，置锅内用武火炒至外面焦黑色，但须存性，喷淋清水，取出，晒干。《纲目》：九月霜后取山楂实带熟者，去核，曝干。或蒸熟去皮核，捣作饼子，日干用。"}]},{"ID":"20240830165859-19zmqf7","Type":"NodeParagraph","Properties":{"id":"20240830165859-19zmqf7","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【性味】酸甘；微温；无毒"}]},{"ID":"20240830165859-kbpaqs0","Type":"NodeParagraph","Properties":{"id":"20240830165859-kbpaqs0","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃；肝；肺经"}]},{"ID":"20240830165859-1r64d8l","Type":"NodeParagraph","Properties":{"id":"20240830165859-1r64d8l","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【功能主治】消食积；化滞瘀。主饮食积滞，脘腹胀痛，泄泻痢疾，血瘀痛经，闭经，产后腹痛；恶露不尽；"}]},{"ID":"20240830165859-5vws9ia","Type":"NodeParagraph","Properties":{"id":"20240830165859-5vws9ia","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；或入丸、散。外用：适量，煎水洗或捣敷。"}]},{"ID":"20240830165859-tsfjwkk","Type":"NodeParagraph","Properties":{"id":"20240830165859-tsfjwkk","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚弱者慎服。1.《纲目》：生食多，令人嘈烦易饥，损齿，齿龋人尤不宜。2.《本草经疏》：脾胃虚，兼有积滞者，当与补药同施，亦不宜过用。3.《得配本草》：气虚便搪，脾虚不食，二者禁用。服人参者忌之。4.《随息居饮食谱》：多食耗气，损齿，易饥，空腹及羸弱人或虚病后忌之。"}]},{"ID":"20240830165859-ejzboex","Type":"NodeParagraph","Properties":{"id":"20240830165859-ejzboex","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【附方】保和丸《丹溪心法》：食积、腹痛、痞满；健脾丸《证治准绳：》脾胃虚弱；疝气方《丹溪心法》：寒疝腹痛；通瘀煎《景岳全书》：血瘀经闭"}]},{"ID":"20240830165859-6eqheln","Type":"NodeParagraph","Properties":{"id":"20240830165859-6eqheln","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830165859-bwkcd1o","Type":"NodeParagraph","Properties":{"id":"20240830165859-bwkcd1o","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"1.山楂，大能克化饮食。若胃中无食积，脾虚不能运化，不思食者，多服之，反克伐脾胃生发之气也。"}]},{"ID":"20240830165859-yaen8nt","Type":"NodeParagraph","Properties":{"id":"20240830165859-yaen8nt","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：山楂，《本经》云味酸气冷，然观其能消食积，行瘀血，则气非冷矣。有积滞则成下痢，产后恶露不尽，蓄于太阴部分则为儿枕痛。山楂能入脾胃消积滞，散宿血，故治水痢及产妇腹中块痛也。大抵其功长于化饮食，健脾胃，行结气，消瘀血，故小儿产妇宜多食之。《本经》误为冷，故有洗疮痒之用。"}]},{"ID":"20240830165859-w2cwi9v","Type":"NodeParagraph","Properties":{"id":"20240830165859-w2cwi9v","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：山楂，味中和，消油垢之积，故幼科用之最宜。若伤寒为重症，仲景于宿滞不化者，但用大、小承气，一百一十三方中并不用山楂，以其性缓不可为肩弘任大之品。核有功力，不可去也。"}]},{"ID":"20240830165859-k6pldzp","Type":"NodeParagraph","Properties":{"id":"20240830165859-k6pldzp","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：山楂，所谓健脾者，因其脾有食积，用此酸咸之味，以为消磨，俾食行而痰消，气破而泄化，谓之为健，止属消导之健矣。至于儿枕作痛，力能以止；痘疮不起，力能以发；犹见通瘀运化之速。有大小二种，小者入药，去皮核，捣作饼子，日干用。出北地，大者良。"}]},{"ID":"20240830165859-tzsxgda","Type":"NodeParagraph","Properties":{"id":"20240830165859-tzsxgda","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：赤爪、棠梂、山楂，一物也。古方罕用，故《唐本草》虽有赤爪，后人不知即此也。自丹溪朱氏始着山楂之功，而后遂为要药。其类有二种，皆生山中：一种小者，山人呼为棠梂子、茅楂、猴楂，可入药用。树高数尺，叶有五尖，桠间有刺。三月开五出小白花，实有赤、黄二色，肥者如小林檎，小者如指头，九月乃熟。其核状如牵牛子，黑色，甚坚；一种大者，山人呼为羊朹子。树高丈余，花叶皆同，但实稍大而黄绿，皮涩肉虚为异尔。初甚酸涩，经霜乃可食，功应相同而采药者不收。按《物类相感志》言，煮老鸡硬肉，入山楂数颗即易烂，则其消肉积之功，盖可推矣。......化饮食，消肉积，症瘕，痰饮痞满吞酸，滞血痛胀。"}]},{"ID":"20240830165859-j7ec9b5","Type":"NodeParagraph","Properties":{"id":"20240830165859-j7ec9b5","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"6.《医学衷中参西录》：山楂，若以甘药佐之，化瘀血而不伤新血，开郁气而不伤正气，其性尤和平也。"}]},{"ID":"20240830165859-xrvcl3x","Type":"NodeParagraph","Properties":{"id":"20240830165859-xrvcl3x","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"7.陶弘景：煮汁洗漆疮。8.《唐本草》：汁服主利，洗头及身上疮痒。9.《本草图经》：治痢疾及腰疼。10.《履巉岩本草》：能消食。11.《日用本草》：化食积，行结气，健胃宽膈，消血痞气块。12.《滇南本草》：消肉积滞，下气；治吞酸，积块。13.《本草蒙筌》：行结气，疗症疝。14.宁原《食鉴本草》：化血块，气块，活血。15.《本草再新》：治脾虚湿热，消食磨积，利大小便。16.《本草撮要》：冻疮涂之。"}]},{"ID":"20240830165859-r8ymp89","Type":"NodeParagraph","Properties":{"id":"20240830165859-r8ymp89","updated":"20240830165908"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830165900-hnzqtm1","Type":"NodeThematicBreak","Properties":{"id":"20240830165900-hnzqtm1","updated":"20240830165908"}},{"ID":"20240830165901-3fcqyec","Type":"NodeParagraph","Properties":{"id":"20240830165901-3fcqyec","updated":"20240830165908"}}]}