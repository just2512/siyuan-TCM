"}]},{"ID":"20240724164915-3vnw5qj","Type":"NodeParagraph","Properties":{"id":"20240724164915-3vnw5qj","updated":"20240724174959"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 2-20240724164915-cnlmjkw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 759px;","style":"width: 749px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 11-20240724173113-oep4q6k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 749px;\" parent-style=\"width: 759px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724183139-jeizdc7","Type":"NodeParagraph","Properties":{"id":"20240724183139-jeizdc7","updated":"20240724183728"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 17-20240724183723-y2k7fxx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 346px;\" parent-style=\"width: 356px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 707px;","style":"width: 697px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 16-20240724183139-8inbtfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 697px;\" parent-style=\"width: 707px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724163228-eps0tzz","Type":"NodeParagraph","Properties":{"id":"20240724163228-eps0tzz","updated":"20240724175224"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 341px;","style":"width: 331px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 12-20240724175112-91ufsb8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 331px;\" parent-style=\"width: 341px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 13-20240724175220-tqzz1hm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724162558-dg61bz0","Type":"NodeParagraph","Properties":{"id":"20240724162558-dg61bz0","updated":"20240724162951"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：莱菔子即白萝卜种子；"}]},{"ID":"20240724165814-j7hcz4h","Type":"NodeParagraph","Properties":{"id":"20240724165814-j7hcz4h","updated":"20240902165948"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：萝卜作为家常食用食物，竟找不到一个清晰的全身图，只能通过以下视频表述；"}]},{"ID":"20240724170449-aactxye","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/白萝卜全株-20240724170449-c7h87go.mp4\" data-src=\"assets/白萝卜全株-20240724170449-c7h87go.mp4\"\u003e\u003c/video\u003e","Properties":{"id":"20240724170449-aactxye","updated":"20240724170449"}},{"ID":"20240724162553-mtymwav","Type":"NodeThematicBreak","Properties":{"id":"20240724162553-mtymwav"}},{"ID":"20240902170050-zo74xhe","Type":"NodeParagraph","Properties":{"id":"20240902170050-zo74xhe","updated":"20240902170057"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：莱菔子"}]},{"ID":"20240902170050-zg0azmq","Type":"NodeParagraph","Properties":{"id":"20240902170050-zg0azmq","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子《中国药典》"}]},{"ID":"20240902170050-v32wj10","Type":"NodeParagraph","Properties":{"id":"20240902170050-v32wj10","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENRAPHANI"}]},{"ID":"20240902170050-0ienmgg","Type":"NodeParagraph","Properties":{"id":"20240902170050-0ienmgg","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【别名】萝卜子"}]},{"ID":"20240902170050-0jm9bi1","Type":"NodeParagraph","Properties":{"id":"20240902170050-0jm9bi1","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【来源】本品为十字花科植物萝卜RaphanussativusL.的干燥成熟种子。夏季果实成熟时采割植株，晒干，搓出种子，除去杂质，再晒干。"}]},{"ID":"20240902170050-isze0l6","Type":"NodeParagraph","Properties":{"id":"20240902170050-isze0l6","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈类卵圆形或椭圆形，稍扁，长2.5～4mm，宽2～3mm。表面黄棕色、红棕色或灰棕色。一端有深棕色圆形种脐，一侧有数条纵沟。种皮薄而脆，子叶2，黄白色，有油性。无臭，味淡、微苦辛。"}]},{"ID":"20240902170050-77u8nv7","Type":"NodeParagraph","Properties":{"id":"20240902170050-77u8nv7","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902170050-q6g3fkh","Type":"NodeParagraph","Properties":{"id":"20240902170050-q6g3fkh","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"（1）取本品粉末少量，置试管内，加氢氧化钠1小粒，置酒精灯上灼热，放冷，加水2ml使溶解，滤过。取滤液1ml,加5％盐酸溶液酸化，即有硫化氢产生，遇新制的醋酸铅试纸，显有光泽的棕黑色。"}]},{"ID":"20240902170050-wy7rm2j","Type":"NodeParagraph","Properties":{"id":"20240902170050-wy7rm2j","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"（2）取亚硝基铁氰化钠1小粒，置白瓷板上，加水1～2滴使溶解，加[鉴别]（1）项下剩余的滤液1～2滴，即显紫红色。"}]},{"ID":"20240902170050-ces360f","Type":"NodeParagraph","Properties":{"id":"20240902170050-ces360f","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醚30ml，加热回流1小时，弃去乙醚液，药渣用乙醚10ml洗涤后挥干，加甲醇20ml，加热回流1小时，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取莱菔子对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5μl，分别点于同一硅胶GF254薄层板上，以醋酸乙酯-甲酸-水（10：2：3）的上层溶液为展开剂，展开，取出，晾干，置紫外光灯（254nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点；喷以1％香草醛的10％硫酸乙醇溶液，加热至斑点显色清晰，供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902170050-qprx00z","Type":"NodeParagraph","Properties":{"id":"20240902170050-qprx00z","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902170050-barrqqo","Type":"NodeParagraph","Properties":{"id":"20240902170050-barrqqo","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子：除去杂质，洗净，干燥。用时捣碎。"}]},{"ID":"20240902170050-9kq15ns","Type":"NodeParagraph","Properties":{"id":"20240902170050-9kq15ns","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"炒莱菔子：取净莱菔子，照清炒法（附录ⅡD）炒至微鼓起。用时捣碎。"}]},{"ID":"20240902170050-sc3sy3o","Type":"NodeParagraph","Properties":{"id":"20240902170050-sc3sy3o","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性味】辛、甘，平。"}]},{"ID":"20240902170050-mx9bfwm","Type":"NodeParagraph","Properties":{"id":"20240902170050-mx9bfwm","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、脾、胃经。"}]},{"ID":"20240902170050-t8k5och","Type":"NodeParagraph","Properties":{"id":"20240902170050-t8k5och","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【功能主治】消食除胀，降气化痰。用于饮食停滞，脘腹胀痛，大便秘结，积滞泻痢，痰壅喘咳。"}]},{"ID":"20240902170050-0er61ws","Type":"NodeParagraph","Properties":{"id":"20240902170050-0er61ws","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。"}]},{"ID":"20240902170050-ketae8p","Type":"NodeParagraph","Properties":{"id":"20240902170050-ketae8p","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防蛀。"}]},{"ID":"20240902170050-uoe2zdp","Type":"NodeParagraph","Properties":{"id":"20240902170050-uoe2zdp","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902170050-1wqkbxk","Type":"NodeParagraph","Properties":{"id":"20240902170050-1wqkbxk","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子《*辞典》"}]},{"ID":"20240902170050-o6xvum2","Type":"NodeParagraph","Properties":{"id":"20240902170050-o6xvum2","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【出处】《本草衍义补遗》"}]},{"ID":"20240902170050-lgzrnen","Type":"NodeParagraph","Properties":{"id":"20240902170050-lgzrnen","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【拼音名】LáiFúZǐ"}]},{"ID":"20240902170050-g1uy35m","Type":"NodeParagraph","Properties":{"id":"20240902170050-g1uy35m","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【别名】萝卜子（《日华子本草》）。"}]},{"ID":"20240902170050-3ndc6uf","Type":"NodeParagraph","Properties":{"id":"20240902170050-3ndc6uf","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【来源】为十字花科植物莱菔的成熟种子。夏、秋间种子成熟时割取全株，晒干，搓出种子，除去杂质，晒干。"}]},{"ID":"20240902170050-eiy8wlx","Type":"NodeParagraph","Properties":{"id":"20240902170050-eiy8wlx","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国各地皆产；主产于河北、河南、浙江、黑龙江等地。"}]},{"ID":"20240902170050-20kdg26","Type":"NodeParagraph","Properties":{"id":"20240902170050-20kdg26","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性状】干燥种子呈椭圆形或近卵圆形而稍扁，长约3毫米，宽2.5毫米。表面红棕色，一侧有数条纵沟，一端有种脐，呈褐色圆点状突起。用放大镜观察，全体均有致密的网纹。质硬，破开后可见黄白色或黄色的种仁；有油性。无臭，味甘，微辛。以粒大、饱满、油性大者为佳。"}]},{"ID":"20240902170050-htk88jq","Type":"NodeParagraph","Properties":{"id":"20240902170050-htk88jq","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含脂肪油、挥发油。挥发油内有甲硫醇等。脂肪油中含多量芥酸、亚油酸、亚麻酸以及芥子酸甘油酯等。尚含有抗菌物质称莱菔素。"}]},{"ID":"20240902170050-ldr8hv6","Type":"NodeParagraph","Properties":{"id":"20240902170050-ldr8hv6","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902170050-qfa04ti","Type":"NodeParagraph","Properties":{"id":"20240902170050-qfa04ti","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①抗菌作用"}]},{"ID":"20240902170050-7ut7gfs","Type":"NodeParagraph","Properties":{"id":"20240902170050-7ut7gfs","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子含抗菌物质，其有效成分为莱菔素，在1毫克/毫升浓度对葡萄球菌秘大肠杆菌即有显着抑制作用，且可影响各种植物种子发芽。后又从莱菔子中分离出一种油，称为\"Sulforaphen\"，1％浓度可对抗链球菌、化脓球菌、肺炎球菌、大肠杆菌等生长。有人认为此两者可能是同一物质"}]},{"ID":"20240902170050-fql5cfb","Type":"NodeParagraph","Properties":{"id":"20240902170050-fql5cfb","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②抗真菌作用"}]},{"ID":"20240902170050-ghrapiy","Type":"NodeParagraph","Properties":{"id":"20240902170050-ghrapiy","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子水浸剂（1：3）在试管内对同心性毛癣菌等六种皮肤真菌有不同程度的抑制作用。"}]},{"ID":"20240902170050-s8dycov","Type":"NodeParagraph","Properties":{"id":"20240902170050-s8dycov","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240902170050-7s37vym","Type":"NodeParagraph","Properties":{"id":"20240902170050-7s37vym","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"变种的提取物，长期饲喂大鼠，能干扰甲状腺素的合成"}]},{"ID":"20240902170050-uecppu5","Type":"NodeParagraph","Properties":{"id":"20240902170050-uecppu5","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【毒性】莱菔素对小鼠和离体蛙心有轻微毒性。"}]},{"ID":"20240902170050-mpi9d7q","Type":"NodeParagraph","Properties":{"id":"20240902170050-mpi9d7q","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【炮制】莱菔子：簸去杂质，漂净泥土，捞出，晒干，用时捣碎。炒莱菔子：取净莱菔子，置锅内用文火炒至微鼓起，并有香气为度，取出，放凉。"}]},{"ID":"20240902170050-1aem8yu","Type":"NodeParagraph","Properties":{"id":"20240902170050-1aem8yu","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902170050-1uxb4zw","Type":"NodeParagraph","Properties":{"id":"20240902170050-1uxb4zw","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"辛甘，平。"}]},{"ID":"20240902170050-w1vf04m","Type":"NodeParagraph","Properties":{"id":"20240902170050-w1vf04m","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性温，味辛。\""}]},{"ID":"20240902170050-iqguifh","Type":"NodeParagraph","Properties":{"id":"20240902170050-iqguifh","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"辛甘，平，无毒。\""}]},{"ID":"20240902170050-vjbbork","Type":"NodeParagraph","Properties":{"id":"20240902170050-vjbbork","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③《玉楸药解》：\"辛，热。\""}]},{"ID":"20240902170050-4cir05m","Type":"NodeParagraph","Properties":{"id":"20240902170050-4cir05m","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"④《医学衷中参西录》：\"生用味微辛，性子；炒用性温。\""}]},{"ID":"20240902170050-rpez3ji","Type":"NodeParagraph","Properties":{"id":"20240902170050-rpez3ji","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902170050-ipoiuxq","Type":"NodeParagraph","Properties":{"id":"20240902170050-ipoiuxq","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"入肺、胃经。"}]},{"ID":"20240902170050-i83q2xu","Type":"NodeParagraph","Properties":{"id":"20240902170050-i83q2xu","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入脾、肺二经。\""}]},{"ID":"20240902170050-lzzwt9f","Type":"NodeParagraph","Properties":{"id":"20240902170050-lzzwt9f","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入脾、胃二经。\""}]},{"ID":"20240902170050-jz7h6zm","Type":"NodeParagraph","Properties":{"id":"20240902170050-jz7h6zm","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、肺二经。\""}]},{"ID":"20240902170050-6mw5y7h","Type":"NodeParagraph","Properties":{"id":"20240902170050-6mw5y7h","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902170050-hexcyvb","Type":"NodeParagraph","Properties":{"id":"20240902170050-hexcyvb","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"下气定喘，消食化痰。治咳嗽痰喘，食积气滞，胸闷腹胀，下痢后重。"}]},{"ID":"20240902170050-5ovuvy5","Type":"NodeParagraph","Properties":{"id":"20240902170050-5ovuvy5","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"水研服，吐风痰：醋研消肿毒。\""}]},{"ID":"20240902170050-kyoaif8","Type":"NodeParagraph","Properties":{"id":"20240902170050-kyoaif8","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②《日用本草》：\"治黄疸及皮肤目黄如金色，小水热赤。\""}]},{"ID":"20240902170050-iwjmfpt","Type":"NodeParagraph","Properties":{"id":"20240902170050-iwjmfpt","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"下气宽中，消膨胀，降痰，定吼喘，攻肠胃积滞，治痞块、单腹疼。\""}]},{"ID":"20240902170050-e113j9n","Type":"NodeParagraph","Properties":{"id":"20240902170050-e113j9n","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"下气定喘，治痰，消食，除胀，利大小便，止气痛，下痢后重，发疮疹。\""}]},{"ID":"20240902170050-q6yrm74","Type":"NodeParagraph","Properties":{"id":"20240902170050-q6yrm74","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"生用，吐风痰，宽胸膈，托疮疹；热用，下气消痰，攻坚积，疗后重。\""}]},{"ID":"20240902170050-t2of5i2","Type":"NodeParagraph","Properties":{"id":"20240902170050-t2of5i2","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"化痰除风，散邪发汗。\""}]},{"ID":"20240902170050-23x6r0g","Type":"NodeParagraph","Properties":{"id":"20240902170050-23x6r0g","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑦《随息居饮食谱》：\"治痰嗽，齁喘，气鼓，头风，溺闭，及误服补剂。\""}]},{"ID":"20240902170050-zqwncjt","Type":"NodeParagraph","Properties":{"id":"20240902170050-zqwncjt","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240902170050-5erqh58","Type":"NodeParagraph","Properties":{"id":"20240902170050-5erqh58","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902170050-n0p2qxj","Type":"NodeParagraph","Properties":{"id":"20240902170050-n0p2qxj","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"气虚者慎服。"}]},{"ID":"20240902170050-2p6aq66","Type":"NodeParagraph","Properties":{"id":"20240902170050-2p6aq66","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"《本草从新》：\"虚弱者服之，气喘难布息。\""}]},{"ID":"20240902170050-mwlrznv","Type":"NodeParagraph","Properties":{"id":"20240902170050-mwlrznv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902170050-tz2zwxq","Type":"NodeParagraph","Properties":{"id":"20240902170050-tz2zwxq","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①治积年上气咳嗽，多痰喘促，唾脓血：莱菔子一合，研，煎汤，食上服之。（《食医心镜》）"}]},{"ID":"20240902170050-u8pvhgz","Type":"NodeParagraph","Properties":{"id":"20240902170050-u8pvhgz","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②治百日咳：白萝卜种子，焙燥，研细粉。白砂糖水送服少许，一日数回。（《江西中医药》（12）：1963）"}]},{"ID":"20240902170050-btt1jcv","Type":"NodeParagraph","Properties":{"id":"20240902170050-btt1jcv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③治齁喘痰促，遇厚味即发者：萝卜子淘净，蒸熟，晒研，姜汁浸蒸饼丸绿豆大。每服三十丸，以口津咽下，日三服。（傅滋《医学集成》清金丸）"}]},{"ID":"20240902170050-s73hd0l","Type":"NodeParagraph","Properties":{"id":"20240902170050-s73hd0l","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"④治高年咳嗽，气逆痰痞：紫苏子、白芥子、萝卜子。上三味各洗净，微炒，击碎，用生绢小袋盛之，煮作汤饮。随甘旨，代茶水啜用，不宜煎熬大过。（《韩氏医通》三子养亲汤）"}]},{"ID":"20240902170050-2att3hh","Type":"NodeParagraph","Properties":{"id":"20240902170050-2att3hh","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑤治一切食积：山查六两，神曲二两，半夏，茯苓各三两，陈皮、连翘、萝卜子各一两。上为末，炊饼丸如梧子大。每服七、八十丸，食远，白汤下。（《丹溪心法》保和丸）"}]},{"ID":"20240902170050-r6oqrwc","Type":"NodeParagraph","Properties":{"id":"20240902170050-r6oqrwc","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑥治气胀气臌：莱菔子，研，以水滤汁，浸缩砂一两，一夜，炒干，又浸又炒，凡七次，为末。每米饮服一钱。（《朱氏集验医方》）"}]},{"ID":"20240902170050-ayztayz","Type":"NodeParagraph","Properties":{"id":"20240902170050-ayztayz","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑦治痢疾有积，后重不通：莱菔子五钱，白芍药三钱，大黄一钱，木香五分。水煎服。（《方脉正宗》）"}]},{"ID":"20240902170050-rlo5sz8","Type":"NodeParagraph","Properties":{"id":"20240902170050-rlo5sz8","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑧治风秘气秘：萝卜子（炒）一合，擂水，和皂荚末二钱服。（《寿域神方》）"}]},{"ID":"20240902170050-su762nx","Type":"NodeParagraph","Properties":{"id":"20240902170050-su762nx","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑨治中风口噤：萝卜子、牙皂荚各二钱。以水煎服，取吐。（朱震亨）"}]},{"ID":"20240902170050-44dtqag","Type":"NodeParagraph","Properties":{"id":"20240902170050-44dtqag","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑩治风头痛及偏头痛：莱菔子半两，生姜汁半合。上相和研极细，绞取汁，入麝香少许，滴鼻中搐入，偏头痛随左右用之。（《普济方》）"}]},{"ID":"20240902170050-emf6vhu","Type":"NodeParagraph","Properties":{"id":"20240902170050-emf6vhu","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑾治小儿盘肠气痛：萝卜子炒黄，研末。乳香汤服半钱。（《仁斋直指访》）"}]},{"ID":"20240902170050-gifphef","Type":"NodeParagraph","Properties":{"id":"20240902170050-gifphef","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑿治牙疼：萝卜子二七粒，去赤皮，细研。以人乳和，左边牙痛，即于右鼻中点少许，如右边牙疼，即于左鼻中点之。（《圣惠方》）"}]},{"ID":"20240902170050-expcfns","Type":"NodeParagraph","Properties":{"id":"20240902170050-expcfns","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⒀治跌打损伤，瘀血胀痛：莱菔子二两，生研烂，热酒调敷。（《方脉正宗》）"}]},{"ID":"20240902170050-qivk12u","Type":"NodeParagraph","Properties":{"id":"20240902170050-qivk12u","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902170050-yqyz6d8","Type":"NodeParagraph","Properties":{"id":"20240902170050-yqyz6d8","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"①朱震亨：\"莱菔子治痰，有推墙倒壁之功。\""}]},{"ID":"20240902170050-hjvr0w7","Type":"NodeParagraph","Properties":{"id":"20240902170050-hjvr0w7","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"莱菔子之功，长于利气。生能升，熟能降，升则吐风痰，散风寒，发疮疹；降则定痰喘咳嗽，调下痢后重，止内痛，皆是利气之效。\""}]},{"ID":"20240902170050-z6k64t6","Type":"NodeParagraph","Properties":{"id":"20240902170050-z6k64t6","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"莱菔子，味辛过于根，以其辛甚，故升降之功亦烈于根也。\""}]},{"ID":"20240902170050-ccv625w","Type":"NodeParagraph","Properties":{"id":"20240902170050-ccv625w","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"④《本草新编》：\"萝卜子，能治喘胀，然古人用于人参之中，反奏功如神。人参原是除喘消胀之药，莱菔子最解人参，何以同用而奏功乎?夫人参之除喘消胀，乃治虚喘虚胀也，虚症反现假实之象，人参遽然投之，直至其喘胀之所，未能骤受，往往服之而愈喘愈胀者有之，虽所增之喘胀乃一时之假象，少顷自然平复，然终非治之之善，少加萝卜子以制人参，则喘胀不敢增，而仅得消喘胀之益，此所谓相制而相成也。或问萝卜子专解人参，一用萝卜子则人参无益矣。此不知萝卜子而并不知人参者也。人参得萝卜子，其功更神，盖人参补气，骤服气必难受，非止喘胀之症为然，得萝卜子以行其补中之利气，则气平而易受，是萝卜子平气之有余，非损气之不足，实制人参以平其气，非制人参以伤其气也。\""}]},{"ID":"20240902170050-2vmqtld","Type":"NodeParagraph","Properties":{"id":"20240902170050-2vmqtld","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"⑤《医学衷中参西录》：\"莱菔子，无论或生或炒，皆能顺气开郁，消胀除满，此乃化气之品，非破气之品。盖凡理气之药，单服久服，未有不伤气者，而莱菔子炒熟为末，每饭后移时服钱许，借以消食顺气，转不伤气，因其能多进饮食，气分自得其养也。若用以除满开郁，而以参、芪、术诸药佐之，虽多服久服，亦何至伤气分乎。\""}]},{"ID":"20240902170050-x57022c","Type":"NodeParagraph","Properties":{"id":"20240902170050-x57022c","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902170050-e4azn31","Type":"NodeParagraph","Properties":{"id":"20240902170050-e4azn31","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"莱菔子《中华本草》"}]},{"ID":"20240902170050-cnk6mf0","Type":"NodeParagraph","Properties":{"id":"20240902170050-cnk6mf0","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草衍义补遗》"}]},{"ID":"20240902170050-bfy200r","Type":"NodeParagraph","Properties":{"id":"20240902170050-bfy200r","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【拼音名】LáiFúZǐ"}]},{"ID":"20240902170050-ityu5ts","Type":"NodeParagraph","Properties":{"id":"20240902170050-ityu5ts","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【英文名】RadishSeed"}]},{"ID":"20240902170050-lrbngcv","Type":"NodeParagraph","Properties":{"id":"20240902170050-lrbngcv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【别名】萝卜子、芦菔子"}]},{"ID":"20240902170050-z7heccc","Type":"NodeParagraph","Properties":{"id":"20240902170050-z7heccc","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902170050-epl031y","Type":"NodeParagraph","Properties":{"id":"20240902170050-epl031y","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"药材基源：为十字花科植物莱菔的成熟种子。"}]},{"ID":"20240902170050-coknr0f","Type":"NodeParagraph","Properties":{"id":"20240902170050-coknr0f","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：RaphanussativusL"}]},{"ID":"20240902170050-tky1p6x","Type":"NodeParagraph","Properties":{"id":"20240902170050-tky1p6x","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"采收和储藏：翌年5-8月，有果充分成熟采收晒干，打下种子，除去杂质，放干燥处贮藏。"}]},{"ID":"20240902170050-mabs2f3","Type":"NodeParagraph","Properties":{"id":"20240902170050-mabs2f3","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【原形态】莱菔，一年生或二年生直立草本，高30-100cm。直根，肉质，长圆形、球形或圆锥形，外皮绿色、白色或红色。茎分枝，无毛，稍具粉霜。基生叶和下部茎生叶大头羽状半裂，长8-30cm，宽3-5cm，顶裂片卵形，侧裂片4-6对，长圆形，有钝齿，疏生粗毛；上部叶长圆形，有锯齿或近全缘。总状花骗子顶生或腋生；萼片长圆形；花瓣4，白色、紫色或粉红色，直径1.5-2cm，倒卵形，长1-1.5mm，具紫纹，下部有长5mm的爪；雄蕊6，4长2短；雌蕊1，子房钻状，柱头柱状。长角果圆柱形，长3-6cm，在种子间处缢缩，形成海绵质横膈，先端有喙长1-1.5mm；种子1-6颗，卵形，微扁，长约3mm，红棕色，并有细网纹。花期4-5月，果期5-6月。"}]},{"ID":"20240902170050-rg2cby6","Type":"NodeParagraph","Properties":{"id":"20240902170050-rg2cby6","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【生境分布】原产我国，全国各地均有栽培，且有大量的栽培品种。"}]},{"ID":"20240902170050-wr4iil2","Type":"NodeParagraph","Properties":{"id":"20240902170050-wr4iil2","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902170050-dg1gize","Type":"NodeParagraph","Properties":{"id":"20240902170050-dg1gize","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"性状鉴定：干燥种子呈椭圆形或近卵圆形而稍扁，长约3mm，宽2.5mm。表面红棕色，一侧有数条纵沟，一端有种脐，呈褐色圆点状突起。用放大镜观察，全体均有致密的网纹。质硬，破开后可见黄白色或黄色的种仁，有油性。无臭，味甘，微辛。以粗大、饱满、油性大者为佳。"}]},{"ID":"20240902170050-oc3we25","Type":"NodeParagraph","Properties":{"id":"20240902170050-oc3we25","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"显微鉴定：粉末：黄棕色。"}]},{"ID":"20240902170050-d79g2mx","Type":"NodeParagraph","Properties":{"id":"20240902170050-d79g2mx","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"1.种皮栅状细胞淡黄色、橙黄色或黄棕色。断面观细胞1列，一般径向10-37μm，切向7-12μm，外壁及侧壁上端薄，侧壁大部及内壁增厚，侧壁中部尤厚；表面观类多角形或长多角形，壁厚2-4μm，胞间层极细。"}]},{"ID":"20240902170050-383wm14","Type":"NodeParagraph","Properties":{"id":"20240902170050-383wm14","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"2.种皮下皮细胞形大，断面观扁长圆形，外壁及侧壁皱缩，细胞界限不清楚，其下与栅状细胞相接。此外，有内胚乳细胞、子叶细胞；种皮表皮细胞民粘液化观察不清。"}]},{"ID":"20240902170050-l4wtwez","Type":"NodeParagraph","Properties":{"id":"20240902170050-l4wtwez","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含芥子碱(sinapine)和脂肪油30%，油中含大量的芥酸(erucicacid)及亚油酸(linoleicacid)，亚麻酸(linolenicacid)，还含菜子甾醇(brassicasterol)和22-去氢菜油甾醇(22-dehydrocampesterol)。另含菜菔素(raphanin)。"}]},{"ID":"20240902170050-z6nrl5g","Type":"NodeParagraph","Properties":{"id":"20240902170050-z6nrl5g","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902170050-i4g4i5x","Type":"NodeParagraph","Properties":{"id":"20240902170050-i4g4i5x","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"1.抗病原微生物的作用：莱菔子水提物对葡萄球菌和大肠杆菌等有显着的抑制作用，水浸剂对同心性毛癣菌、许兰氏黄癣菌、奥杜盎氏小孢子菌、铁锈色小芽孢癣菌、羊毛状小芽孢癣菌及星形奴卡氏菌也有不同程度的抑制作用。莱菔素1mg/ml浓度在体外对多种细菌有明显的抑制作用，对葡萄球菌、痢疾杆菌、伤寒杆菌和大肠杆菌的MIC分别为40、125、125及200mcg/ml。"}]},{"ID":"20240902170050-mi6tbqe","Type":"NodeParagraph","Properties":{"id":"20240902170050-mi6tbqe","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"2.解毒作用：莱菔素于体外与细菌外毒素混合后有明显的解毒作用，稀释为1：200时能中和5个致死量的破伤风毒素，1：500可中和4个致死量的白喉毒素，稀释至1：1600时尚能降低白喉毒素的皮肤坏死作用。"}]},{"ID":"20240902170050-99ayt0e","Type":"NodeParagraph","Properties":{"id":"20240902170050-99ayt0e","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"3.降压作用：莱菔子水提物具有明显的降压作用，对于麻醉兔、猫及犬，静脉注射时均可引起动物血压下降。研究莱菔子对于家兔急性缺氧性肺动脉高压影响的结果表明，莱菔子注射液（1ml相当生药1g）0.3-1.2ml/kg剂量静脉注射，能明显降低实验性肺动脉高压，又明显降低体动脉压。莱菔子降肺、体动脉压强度与酚妥拉明基本相等。增大莱菔子剂量未能使其降肺、体动脉压强度加大，只延长降压时间，比酚妥拉明明显延长。采用持续微量静脉注射能抑制急性缺氧导致的肺动脉高压，同时减少降低体动脉压的副作用。"}]},{"ID":"20240902170050-loojqjf","Type":"NodeParagraph","Properties":{"id":"20240902170050-loojqjf","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"4.对心脏血流动力学的影响：4.1．对动脉压和心率的影响：莱菔子注射剂（1ml相当生药1g）按1.0ml/kg静脉注射麻醉犬，可使体动脉收缩压（SAP）、舒张压（DAP）、体动脉平均压（MAP）分别降低10.9、13.9、15.2mmHg，肺动脉收缩压（SPAP）、肺动脉舒张压（DAPA）、肺动脉平均压（MPAP）分别降低4.6、4.3、3.9mmHg，与用药前自身比较有非常显着性差异（P＜0.01）。心率在给药前后无明显变化。"}]},{"ID":"20240902170050-akvjcr5","Type":"NodeParagraph","Properties":{"id":"20240902170050-akvjcr5","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"4.2．对血管阻力的影响：莱菔子注射液静脉注射后，使体血管阻力（SVR）、肺血管阻力（PVR）明显减低，SVR从4583.5±632.45降至3976.7±339.86dyn.s/cm，PVR从530.5±6.821降至411.8±80.98dyn.s/cm,用药前后自身比较P＜0.05和P＜0.01。"}]},{"ID":"20240902170050-mry7jhv","Type":"NodeParagraph","Properties":{"id":"20240902170050-mry7jhv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"4.3．对心脏血流动力学的影响：6只犬在静脉注射莱菔子注射液1.0mg/kg后，心输出量（CO）、心脏指数（CI）、每搏输出量（SV）、每搏指数（SI）均无明显变化，用药前后自身比较均无统计学意义（P＜0.05）。用药后的左心室搏动指数（LVSWI）和右心室搏动指数（RVSWI）明显降低，LVSWI用药前后分别为40.12±2.83和33.2±3．88；RVSWI为5.34±0.74和4.03±0．52（P＜0.01，R＜0.05）。"}]},{"ID":"20240902170050-bfeu64z","Type":"NodeParagraph","Properties":{"id":"20240902170050-bfeu64z","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【毒性】莱菔素对小鼠和离体蛙心有轻微毒性。水提物对小鼠腹腔注射的半数致死量为127.4（123.8-137.1）g/kg，动物多于给药l小时内惊厥而死亡。大鼠每日灌胃100、200及400g/kg，持续3周，对血象、肝肾功能及主要脏器等均未见明显影响。"}]},{"ID":"20240902170050-780xkcb","Type":"NodeParagraph","Properties":{"id":"20240902170050-780xkcb","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【炮制】莱菔子：簸去杂质，漂净泥土，捞出，晒干，用时捣碎。炒菜菔子：取净莱菔子，置锅内用文火炒至微鼓起，并有香气为度，取出，放凉。"}]},{"ID":"20240902170050-enpi1qe","Type":"NodeParagraph","Properties":{"id":"20240902170050-enpi1qe","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；甘；性平"}]},{"ID":"20240902170050-is0bvuo","Type":"NodeParagraph","Properties":{"id":"20240902170050-is0bvuo","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃；肺；大肠经"}]},{"ID":"20240902170050-5s7ojku","Type":"NodeParagraph","Properties":{"id":"20240902170050-5s7ojku","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【功能主治】消食导滞；降气化痰。主食积气滞；脘腹胀满；腹泻；下痢后重；咳嗽多痰；气逆喘满"}]},{"ID":"20240902170050-i4brh2j","Type":"NodeParagraph","Properties":{"id":"20240902170050-i4brh2j","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-10g；或入丸、散，宜炒用。外用：适量，研末调敷。"}]},{"ID":"20240902170050-5xih5nm","Type":"NodeParagraph","Properties":{"id":"20240902170050-5xih5nm","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【附方】①治积年上气咳嗽，多痰喘促，唾脓血：莱菔子一合，研，煎汤，食上服之。(《食医心镜》)②治百日咳：白萝卜种子，焙燥，研细粉。白砂糖水送服少许，一日数回。〔《江西中医药》(12)：1953〕③治齁喘痰促，遇厚味即发者：萝卜子淘净，蒸熟，晒研，姜汁浸蒸饼丸绿豆大。每服三十丸，以口津咽下，日三服。(傅滋《医学集成》清金丸)④治高年咳嗽，气逆痰痞：紫苏子、白芥子、萝卜子。上三味各洗净，微炒，击碎，用生绢小袋盛之，煮作汤饮。随甘旨，代茶水啜用，不宜煎熬太过。(《韩氏医通》三子养亲汤)⑤治一切食积：山楂六两，神曲二两，半夏、茯苓各三两，陈皮、连翘、萝卜子各一两。上为末，炊饼丸如梧子大。每服七、八十丸，食远，白汤下。(《丹溪心法》保和丸)⑥治气胀气臌：莱菔子，研，以水滤汁，浸缩砂一两，一夜，炒干，又浸又炒，凡七次，为末。每米饮服一钱。(《朱氏集验医方》)⑦治痢疾有积，后重不通：莱菔子五钱，白芍药三钱，大黄一钱，木香五分。水煎服。(《方脉正宗》)⑧治风秘气秘：萝卜子(炒)一合，擂水，和皂荚末二钱服。(《寿域神方》)⑨治中风口噤：萝卜子、牙皂荚各二钱。以水煎服，取吐。(朱震亨)⑩治风头痛及偏头痛；莱菔子半两，生姜汁半合。上相和研极细，绞取汁，入麝香少许，滴鼻中XIU入。偏头痛随左右用之。(《普济方》)11、治小儿盘肠气痛：萝卜子炒黄，研末。乳香汤服半钱。(《仁斋直指方》）12、治牙疼：萝卜子二七粒，去赤皮，细研。以人乳和，左边牙痛，即于右鼻中点少许，如右边牙疼，即于左鼻中点之。(《圣惠方》)13、治跌打损伤，瘀血胀痛：莱菔子二两，生研烂，热酒调敷。(《方脉正宗》)"}]},{"ID":"20240902170050-p0c5rvr","Type":"NodeParagraph","Properties":{"id":"20240902170050-p0c5rvr","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902170050-0wuuxty","Type":"NodeParagraph","Properties":{"id":"20240902170050-0wuuxty","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"1.朱震亨：莱菔子治痰，有推墙倒壁之功。"}]},{"ID":"20240902170050-g46lj9u","Type":"NodeParagraph","Properties":{"id":"20240902170050-g46lj9u","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：莱菔子之功，长于利气。生能升，熟能降，升则吐风痰，散风寒，发疮疹；降则定痰喘咳嗽，调下痢后重，止内痛，皆是利气之效。"}]},{"ID":"20240902170050-hpqb8as","Type":"NodeParagraph","Properties":{"id":"20240902170050-hpqb8as","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：莱菔子，味辛过于根，以其辛甚，故升降之功亦烈于根也。"}]},{"ID":"20240902170050-jjrc2zm","Type":"NodeParagraph","Properties":{"id":"20240902170050-jjrc2zm","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"4.《本草新编》：萝卜子，能治喘胀，然古人用于人参之中，反奏功如神。人参原是除喘消胀之药，莱菔子最解人参，何以同用而奏功乎?夫人参之除喘消胀，乃治虚喘虚胀也，虚症反现假实之象，人参遽然投之，直至其喘胀之所，未能骤受，往往服之而愈喘愈胀者有之，虽所增之喘胀乃一时之假象，少顷自然平复，然终非治之之善，少加萝卜子以制人参，则喘胀不敢增，而仅得消喘胀之益，此所谓相制而相成也。或问萝卜子专解人参，一用萝卜子则人参无益矣。此不知萝卜子而并不知人参者也。人参得萝卜子，其功更神，盖人参补气，骤服气必难受，非止喘胀之症为然，得萝卜子以行其补中之利气，则气平而易受，是萝卜子平气之有余，非损气之不足，实制人参以平其气，非制人参以伤其气也。"}]},{"ID":"20240902170050-o7xskbk","Type":"NodeParagraph","Properties":{"id":"20240902170050-o7xskbk","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"5.《医学衷中参西录》：莱菔子，无论或生或炒，皆能顺气开郁，消胀除满，此乃化气之品，非破气之品。盖凡理气之药，单服久服，未有不伤气者，而莱菔子炒熟为末，每饭后移时服钱许，借以消食顺气，转不伤气，因其能多进饮食，气分自得其养也。若用以除满开郁，而以参、芪、术诸药佐之，虽多服久服，亦何至伤气分乎。"}]},{"ID":"20240902170050-0c1yy3c","Type":"NodeParagraph","Properties":{"id":"20240902170050-0c1yy3c","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：水研服，吐风痰；醋研消肿毒。"}]},{"ID":"20240902170050-1tqfogv","Type":"NodeParagraph","Properties":{"id":"20240902170050-1tqfogv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"7.《日用本草》：治黄疸及皮肤目黄如金色，小水热赤。"}]},{"ID":"20240902170050-7hv3znm","Type":"NodeParagraph","Properties":{"id":"20240902170050-7hv3znm","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"8.《随息居饮食谱》：治痰嗽，齁喘，气鼓，头风，溺闭，及误服补剂。"}]},{"ID":"20240902170050-eifqysv","Type":"NodeParagraph","Properties":{"id":"20240902170050-eifqysv","updated":"20240902170111"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902170052-yqcpxtz","Type":"NodeThematicBreak","Properties":{"id":"20240902170052-yqcpxtz","updated":"20240902170111"}},{"ID":"20240902170053-ga9maw3","Type":"NodeParagraph","Properties":{"id":"20240902170053-ga9maw3","updated":"20240902170111"}}]}