{"ID":"20240205153727-l4jdp5y","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153727-l4jdp5y","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153727-l4jdp5y\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206100857-h3h8re3\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240619185832-xthv8iq\u0026quot;,\u0026quot;scrollTop\u0026quot;:1100,\u0026quot;focusId\u0026quot;:\u0026quot;20240619185832-xthv8iq\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"莱菔子（莱服子、萝卜籽、萝卜子）","type":"doc","updated":"20240902170057"},"Children":[{"ID":"20240206100857-h3h8re3","Type":"NodeParagraph","Properties":{"id":"20240206100857-h3h8re3","updated":"20240206100906"},"Children":[{"Type":"NodeText","Data":"【产地】\t各地均产。\n【性状】\t种子类卵圆形或椭圆形，稍扁，长2.54mm，宽23mm。表面黄棕色、红棕色或灰棕色，一端有深棕色圆形种脐，一侧有数条纵沟。种皮薄而脆，子叶2，黄白色，有油性。味淡、微苦、辛。\n【性味】\t辛、甘，平。\n【功效】\t消食除胀，降气化痰。用于饮食停滞、脘腹胀痛、大便秘结、积滞泻痢、痰壅喘咳。"}]},{"ID":"20240206100858-e153m8s","Type":"NodeParagraph","Properties":{"id":"20240206100858-e153m8s","updated":"20240206100858"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206100858-mkt5q9x.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205162236-d3l4hkp","Type":"NodeParagraph","Properties":{"id":"20240205162236-d3l4hkp","updated":"20240205162236"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 521px;","style":"width: 511px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子-20240205162236-swx0lew.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 511px;\" parent-style=\"width: 521px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724164615-08b2hm8","Type":"NodeParagraph","Properties":{"id":"20240724164615-08b2hm8","updated":"20240724171145"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 522px;","style":"width: 512px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 3-20240724171141-qz8dach.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 512px;\" parent-style=\"width: 522px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724162843-sjzfxo5","Type":"NodeParagraph","Properties":{"id":"20240724162843-sjzfxo5","updated":"20240724171425"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 369px;","style":"width: 359px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子-20240724162933-vipoptl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 359px;\" parent-style=\"width: 369px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724175654-6a0tx4d","Type":"NodeParagraph","Properties":{"id":"20240724175654-6a0tx4d","updated":"20240724175700"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 636px;","style":"width: 626px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莱菔子 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莱菔子 14-20240724175623-3orpz4j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 626p