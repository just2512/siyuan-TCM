2143521-3vfwweg","updated":"20240902143521"},"Children":[{"Type":"NodeText","Data":"炒稻芽偏于消食。用于不饥食少。"}]},{"ID":"20240902143521-054i65m","Type":"NodeParagraph","Properties":{"id":"20240902143521-054i65m","updated":"20240902143521"},"Children":[{"Type":"NodeText","Data":"焦稻芽善化积滞。用于积滞不消。"}]},{"ID":"20240902143532-tlqmfqk","Type":"NodeParagraph","Properties":{"id":"20240902143532-tlqmfqk","updated":"20240902143538"},"Children":[{"Type":"NodeText","Data":"相关配伍："}]},{"ID":"20240902143536-lblzn2p","Type":"NodeParagraph","Properties":{"id":"20240902143536-lblzn2p","updated":"20240902143542"},"Children":[{"Type":"NodeText","Data":"1、小儿消化不良，面黄肌瘦：谷芽9g、甘草3g、砂仁3g、白术6g。水煎服。（《青岛中草药手册》）\n2、小儿腹泻：炒谷芽9g、木香6g、诃子肉5g、葛根5g、通草2g。上药水煎，日分2次服。对症加味：挟热加白芍、黄芩：体虚加沙参、白术：溢奶或吐清水加丁香、柿蒂。（《中国社区医师》）"}]},{"ID":"20240902143543-akq01e4","Type":"NodeThematicBreak","Properties":{"id":"20240902143543-akq01e4"}},{"ID":"20240902143544-v4s0vg2","Type":"NodeParagraph","Properties":{"id":"20240902143544-v4s0vg2"}}]}