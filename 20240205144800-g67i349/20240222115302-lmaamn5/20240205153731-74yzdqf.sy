th: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709112725-am4lkh0","Type":"NodeParagraph","Properties":{"id":"20240709112725-am4lkh0","updated":"20240709113359"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 737px;","style":"width: 727px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌药6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌药6-20240709112725-d55wilq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 727px;\" parent-style=\"width: 737px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 465px;","style":"width: 455px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌药9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌药9-20240709112917-7arye2w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 455px;\" parent-style=\"width: 465px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709113510-sai7j1o","Type":"NodeParagraph","Properties":{"id":"20240709113510-sai7j1o","updated":"20240709113730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 675px;","style":"width: 665px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌药树1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌药树1-20240709113510-h3kt533.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 665px;\" parent-style=\"width: 675px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌药15"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌药15-20240709113730-dfw01ri.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709114015-cqt2yuc","Type":"NodeThematicBreak","Properties":{"id":"20240709114015-cqt2yuc"}},{"ID":"20240830103958-x2bp46n","Type":"NodeParagraph","Properties":{"id":"20240830103958-x2bp46n","updated":"20240830104007"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：乌药"}]},{"ID":"20240830103958-7lquwgn","Type":"NodeParagraph","Properties":{"id":"20240830103958-7lquwgn","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"乌药《中国药典》"}]},{"ID":"20240830103958-vxe1t35","Type":"NodeParagraph","Properties":{"id":"20240830103958-vxe1t35","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【拼音名】WūYào"}]},{"ID":"20240830103958-36ddgzn","Type":"NodeParagraph","Properties":{"id":"20240830103958-36ddgzn","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXLINDERAE"}]},{"ID":"20240830103958-0pva5ta","Type":"NodeParagraph","Properties":{"id":"20240830103958-0pva5ta","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【别名】天台乌、台乌、矮樟、香桂樟、铜钱柴、班皮柴"}]},{"ID":"20240830103958-vl9uvyt","Type":"NodeParagraph","Properties":{"id":"20240830103958-vl9uvyt","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【来源】本品为樟科植物乌药Linderaaggregata（Sims）Kosterm.的干燥块根。全年均可采挖，除去细根，洗净，趁鲜切片，晒干，或直接晒干。"}]},{"ID":"20240830103958-br42cxq","Type":"NodeParagraph","Properties":{"id":"20240830103958-br42cxq","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830103958-pr7mpu4","Type":"NodeParagraph","Properties":{"id":"20240830103958-pr7mpu4","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"本品多呈纺锤状，略弯曲，有的中部收缩成连珠状，长6～15cm，直径1～3cm；表面黄棕色或黄褐色，有纵皱纹及稀疏的细根痕。质坚硬。切片厚0.2～2mm，切面黄白色或淡黄棕色，射线放射状，可见年轮环纹，中心颜色较深。气香，味微苦、辛，有清凉感。"}]},{"ID":"20240830103958-mxn4g1k","Type":"NodeParagraph","Properties":{"id":"20240830103958-mxn4g1k","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"质老、不呈纺锤状的直根，不可供药用。"}]},{"ID":"20240830103958-jdeioyf","Type":"NodeParagraph","Properties":{"id":"20240830103958-jdeioyf","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830103958-d0y0sw8","Type":"NodeParagraph","Properties":{"id":"20240830103958-d0y0sw8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末黄白色。淀粉粒甚多，单粒类球形、长圆形或卵圆形,直径4～39μm，脐点叉状、人字状或裂缝状；复粒由2～4分粒组成。木纤维淡黄色，多成束，直径20～30μm，壁厚约5μm，有单纹孔，胞腔含淀粉粒。韧皮纤维近无色，长梭形，多单个散在，直径15～17μm，壁极厚，孔沟不明显。具缘纹孔导管直径约至68μm，具缘纹孔排列紧密。木射线细胞壁稍增厚，纹孔较密。油细胞长圆形，含棕色分泌物。"}]},{"ID":"20240830103958-7frjlnk","Type":"NodeParagraph","Properties":{"id":"20240830103958-7frjlnk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末3g，加石油醚（30～60℃）30ml，振摇，放置过夜，滤过，滤液挥干，残渣加油醚1ml使溶解，作为供试品溶液。另取乌药对照药材3g，同法制成对照药材溶液。照薄层色谱法（附录ⅥD）试验，吸取上述两种溶液各1μl，分别点于同一硅胶H薄层板上，以石油醚（30～60℃）-醋酸乙酯（4：1）为展开剂，展开，取出，晾干,喷以1％香草醛硫酸溶液。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240830103958-ti2n64d","Type":"NodeParagraph","Properties":{"id":"20240830103958-ti2n64d","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【含量测定】"}]},{"ID":"20240830103958-ywp82tg","Type":"NodeParagraph","Properties":{"id":"20240830103958-ywp82tg","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"照高效液相色谱法（附录ⅥD）测定。"}]},{"ID":"20240830103958-yj0qnaj","Type":"NodeParagraph","Properties":{"id":"20240830103958-yj0qnaj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验用十八烷基硅烷键合硅胶为填充剂；乙腈-水（56:44）为流动相；检测波长为235nm。理论板数按乌药醚内酯峰计算应不低于2000。"}]},{"ID":"20240830103958-cyt1245","Type":"NodeParagraph","Properties":{"id":"20240830103958-cyt1245","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备精密称取乌药醚内酯对照品10mg，置100ml量瓶中，用甲醇溶解并稀释至刻度，摇匀，精密量取10ml，置25ml量瓶中，加甲醇至刻度，摇匀，即得（每1ml中含乌药醚内酯40μg）。"}]},{"ID":"20240830103958-axg1v2d","Type":"NodeParagraph","Properties":{"id":"20240830103958-axg1v2d","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备取本品粗粉约1g〔同时另取本品粗粉测定水分（附录ⅨH第二法）〕,精密称定，置索氏提取器中，加乙醚50ml,提取4小时，提取液挥干，残渣用甲醇分次溶解，转移至50ml量瓶中，加甲醇至刻度，摇匀，滤过，取续滤液，即得。"}]},{"ID":"20240830103958-efxkvp2","Type":"NodeParagraph","Properties":{"id":"20240830103958-efxkvp2","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"测定法分别精密吸取对照品溶液与供试品溶液各10μl，注入液相色谱仪，测定,即得。"}]},{"ID":"20240830103958-0oajnwg","Type":"NodeParagraph","Properties":{"id":"20240830103958-0oajnwg","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含乌药醚内酯（C15H16O4）不得少于0.030％。"}]},{"ID":"20240830103958-wbpk6ch","Type":"NodeParagraph","Properties":{"id":"20240830103958-wbpk6ch","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质；未切片者，除去细根，大小分开，浸透，切薄片，干燥。"}]},{"ID":"20240830103958-yg2ltkb","Type":"NodeParagraph","Properties":{"id":"20240830103958-yg2ltkb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240830103958-xbq7ayb","Type":"NodeParagraph","Properties":{"id":"20240830103958-xbq7ayb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、脾、肾、膀胱经。"}]},{"ID":"20240830103958-9829qfj","Type":"NodeParagraph","Properties":{"id":"20240830103958-9829qfj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【功能主治】顺气止痛，温肾散寒。用于胸腹胀痛，气逆喘急，膀胱虚冷，遗尿尿频，疝气，痛经。"}]},{"ID":"20240830103958-ogjloiq","Type":"NodeParagraph","Properties":{"id":"20240830103958-ogjloiq","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240830103958-ggxqljj","Type":"NodeParagraph","Properties":{"id":"20240830103958-ggxqljj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【注意】质老、不呈纺锤状的直根，不可供药用。"}]},{"ID":"20240830103958-vravw8i","Type":"NodeParagraph","Properties":{"id":"20240830103958-vravw8i","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防蛙。"}]},{"ID":"20240830103958-xq98s1h","Type":"NodeParagraph","Properties":{"id":"20240830103958-xq98s1h","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830103958-i8nv730","Type":"NodeParagraph","Properties":{"id":"20240830103958-i8nv730","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"乌药《*辞典》"}]},{"ID":"20240830103958-5qj1spe","Type":"NodeParagraph","Properties":{"id":"20240830103958-5qj1spe","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【出处】《本草拾遗》"}]},{"ID":"20240830103958-psasxlk","Type":"NodeParagraph","Properties":{"id":"20240830103958-psasxlk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【拼音名】WūYào"}]},{"ID":"20240830103958-knekimd","Type":"NodeParagraph","Properties":{"id":"20240830103958-knekimd","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【来源】为樟科植物乌药的根。冬、春二季采挖；以初夏采者粉性大，质量好。挖取后，除去须根，洗净晒干，商品称为\"乌药个\"。如刮去栓皮，切片，烘干者，称为\"乌药片\"。"}]},{"ID":"20240830103958-by3n2go","Type":"NodeParagraph","Properties":{"id":"20240830103958-by3n2go","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830103958-qc6jk8m","Type":"NodeParagraph","Properties":{"id":"20240830103958-qc6jk8m","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"乌药，又名：旁其（《本草拾遗》），鳑魮、矮樟（《纲目》），香叶子树、白叶柴、吹风散、青竹香、钱蜞柴、钱柴头、盐鱼子柴。"}]},{"ID":"20240830103958-gfjb3n6","Type":"NodeParagraph","Properties":{"id":"20240830103958-gfjb3n6","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"常绿灌木或小乔木，高达4～5米。根木质，膨大粗壮，略成念珠状。树皮灰绿色。小枝幼时密被锈色短柔毛，老时平滑无毛；茎枝坚韧，不易断。叶互生，革质，椭圆形至广倒卵形，长3～8厘米，宽1.5～5厘米，先端渐尖或尾状渐尖，基部圆形或广楔形，全缘，上面绿色，有光泽，除中脉外，均光滑无毛，下面灰白色，被淡褐色长柔毛，后变光滑，叶脉3条，基出，极明显；叶柄短，有短柔毛。伞形花序腋生，几无总梗；小花梗长1.5～3毫米，被毛，簇生多数小花；花单性，雌雄异株，黄绿色；花被6片，大小几相等，广椭圆形，雄花有雄蕊9枚，排成3轮，最内一轮的基部有腺体，花药2室；雌花有退化雄蕊多枚，子房上位，球形，1室，胚珠1枚。核果近球形，初绿色，成熟后变黑色。花期3～4月。果期10～11月。"}]},{"ID":"20240830103958-x9itqq9","Type":"NodeParagraph","Properties":{"id":"20240830103958-x9itqq9","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"本植物的叶（乌药叶）、果实（乌药子）亦供药用，各详专条。"}]},{"ID":"20240830103958-nz0t3ue","Type":"NodeParagraph","Properties":{"id":"20240830103958-nz0t3ue","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于荒山灌木林中或高草丛中阳光充足、土壤肥沃处。分布安徽、江苏、浙江、福建、台湾、广东、广西、江西、湖北、湖南、陕西等地。"}]},{"ID":"20240830103958-nxjxekk","Type":"NodeParagraph","Properties":{"id":"20240830103958-nxjxekk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830103958-3s34k8g","Type":"NodeParagraph","Properties":{"id":"20240830103958-3s34k8g","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①乌药个"}]},{"ID":"20240830103958-tjoc2ys","Type":"NodeParagraph","Properties":{"id":"20240830103958-tjoc2ys","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"呈纺锤形，略弯曲，两头稍尖，中部膨大，或成连珠状，长10～15厘米；膨大部直径1～2厘米。表面黄棕色或黄褐色，有须根残痕，具纵皱及横裂纹，质坚硬，不易折断，横切面类圆形，浅棕色而微红，稍显粉性，中心色较深，外层皮部棕色，甚薄；木质部有放射状纹理及环纹。气微香，味微辛苦.以连珠状、质嫩、粉性大、横断面浅棕色者为佳。"}]},{"ID":"20240830103958-eaztfkk","Type":"NodeParagraph","Properties":{"id":"20240830103958-eaztfkk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②乌药片"}]},{"ID":"20240830103958-8gdvey1","Type":"NodeParagraph","Properties":{"id":"20240830103958-8gdvey1","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"分薄片与厚片，均为类圆形片状，厚片有时斜切成椭圆形，直径1～2厘米，厚约1.5毫米；薄片厚1毫米以下。平整而有弹性。切面黄白色至淡棕色而微红，有放射状纹理及环纹。以平整不卷、色淡、无黑斑、不破碎者为佳。"}]},{"ID":"20240830103958-huw27i8","Type":"NodeParagraph","Properties":{"id":"20240830103958-huw27i8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"主产浙江、湖南、安徽、广东、广西。此外，湖北、江西、陕西、四川、云南、福建等地亦产。习惯以浙江天台所产者品质最佳，故称\"天台乌药\"或\"台乌药\"。"}]},{"ID":"20240830103958-yvgvaqk","Type":"NodeParagraph","Properties":{"id":"20240830103958-yvgvaqk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含多种倍半萜类成分香樟烯、香樟内酯、羟基香樟内酯、乌药醇、乌药醚、异乌药醚、乌药酮。"}]},{"ID":"20240830103958-00jvwhe","Type":"NodeParagraph","Properties":{"id":"20240830103958-00jvwhe","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，分开大小条，用水泡透，根据季节注意换水，防止发臭，及时捞出切片。如已在鲜时切片者，筛去灰屑。"}]},{"ID":"20240830103958-tnnyco9","Type":"NodeParagraph","Properties":{"id":"20240830103958-tnnyco9","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830103958-zdbbzes","Type":"NodeParagraph","Properties":{"id":"20240830103958-zdbbzes","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240830103958-ys1x4dk","Type":"NodeParagraph","Properties":{"id":"20240830103958-ys1x4dk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"味辛，温，无毒。\""}]},{"ID":"20240830103958-v31oac8","Type":"NodeParagraph","Properties":{"id":"20240830103958-v31oac8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"味辛带微苦，性温。\""}]},{"ID":"20240830103958-3wk6wzh","Type":"NodeParagraph","Properties":{"id":"20240830103958-3wk6wzh","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830103958-tnbdhs2","Type":"NodeParagraph","Properties":{"id":"20240830103958-tnbdhs2","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"入脾、肺、肾、膀胱经。"}]},{"ID":"20240830103958-961hrqp","Type":"NodeParagraph","Properties":{"id":"20240830103958-961hrqp","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足阳明、少阴经。\""}]},{"ID":"20240830103958-8okkk0n","Type":"NodeParagraph","Properties":{"id":"20240830103958-8okkk0n","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、脾二经。\""}]},{"ID":"20240830103958-22e65ix","Type":"NodeParagraph","Properties":{"id":"20240830103958-22e65ix","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足厥阴肝经、手太阴肺经。\""}]},{"ID":"20240830103958-rus7nfa","Type":"NodeParagraph","Properties":{"id":"20240830103958-rus7nfa","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"④《本草从新》：\"上入脾、肺，下通膀胱与肾。\""}]},{"ID":"20240830103958-x3e5qm4","Type":"NodeParagraph","Properties":{"id":"20240830103958-x3e5qm4","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830103958-xy35tdl","Type":"NodeParagraph","Properties":{"id":"20240830103958-xy35tdl","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"顺气，开郁，散寒，止痛。治气逆胸腹胀痛，宿食不消，反胃吐食，寒疝，脚气，小便频数。"}]},{"ID":"20240830103958-3m5w1gk","Type":"NodeParagraph","Properties":{"id":"20240830103958-3m5w1gk","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"主中恶心腹痛，宿食不消，天行疫瘴，膀胱肾间冷气攻冲背膂，妇人血气，小儿腹中诸虫。\""}]},{"ID":"20240830103958-5tth3cx","Type":"NodeParagraph","Properties":{"id":"20240830103958-5tth3cx","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治一切气，除一切冷，霍乱及反胃吐食.泻痢，痈疖疥癞，并解冷热。\""}]},{"ID":"20240830103958-2at8qa6","Type":"NodeParagraph","Properties":{"id":"20240830103958-2at8qa6","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"③王好古：\"理元气。\""}]},{"ID":"20240830103958-zpmzxef","Type":"NodeParagraph","Properties":{"id":"20240830103958-zpmzxef","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治中气，脚气，疝气，气厥头痛，肿胀喘息，止小便数及白浊。\""}]},{"ID":"20240830103958-d9fp32s","Type":"NodeParagraph","Properties":{"id":"20240830103958-d9fp32s","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑤《本草通玄》：\"理七情郁结，气血凝停，霍乱吐泻，痰食稽留。\""}]},{"ID":"20240830103958-2z81e76","Type":"NodeParagraph","Properties":{"id":"20240830103958-2z81e76","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑥《玉楸药解》：\"破瘀泄满，止痛消胀。\""}]},{"ID":"20240830103958-hup5tqo","Type":"NodeParagraph","Properties":{"id":"20240830103958-hup5tqo","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；磨汁或入丸、散。"}]},{"ID":"20240830103958-9q9ex8b","Type":"NodeParagraph","Properties":{"id":"20240830103958-9q9ex8b","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830103958-3ix9ump","Type":"NodeParagraph","Properties":{"id":"20240830103958-3ix9ump","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"气虚、内热者忌服。"}]},{"ID":"20240830103958-6gbz914","Type":"NodeParagraph","Properties":{"id":"20240830103958-6gbz914","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①《医学入门》：\"疏散宣通，甚于香附，不可多服。\""}]},{"ID":"20240830103958-bbl0ajt","Type":"NodeParagraph","Properties":{"id":"20240830103958-bbl0ajt","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"病属气虚者忌之。\"\"妇人月事先期，小便短赤，及咳嗽内热，口渴，口干、舌苦，不得眠，一切阴虚内热之病，皆不宜服。\""}]},{"ID":"20240830103958-17mnmmt","Type":"NodeParagraph","Properties":{"id":"20240830103958-17mnmmt","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"③《本经逢源》：\"不可见火。\""}]},{"ID":"20240830103958-fqr73h2","Type":"NodeParagraph","Properties":{"id":"20240830103958-fqr73h2","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防蛀。"}]},{"ID":"20240830103958-52i526j","Type":"NodeParagraph","Properties":{"id":"20240830103958-52i526j","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830103958-um4gefr","Type":"NodeParagraph","Properties":{"id":"20240830103958-um4gefr","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"①治风气攻疰四肢，骨节疼痛，遍身顽麻，头目旋晕；瘫痪，语言蹇涩，筋脉拘挛；脚气步履艰难，脚膝软弱；妇人血风，老人冷气，上攻胸臆，两胁刺痛，心腹膨胀，吐泻肠呜：麻黄（去根、节）、陈皮（去瓤）、乌药（去木）各二两，白僵蚕（去丝、嘴，炒）、川芎、枳壳（麸炒）、甘草（炒）、白芷、桔梗各一两，干姜（炮）半两。上为细末，每服三钱，水一盏，姜三片，枣一枚，煎至七分，温服。（《局方》乌药顺气散）"}]},{"ID":"20240830103958-ripb2r9","Type":"NodeParagraph","Properties":{"id":"20240830103958-ripb2r9","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"②治冷气、血气、肥气、息贲气、伏梁气、奔豚气，抢心切痛，冷汗，喘息欲绝：天台乌药（小者，酒浸一夜，炒）、茴香（炒）、青橘皮（去白，炒）、良姜（炒）。等分为末，温酒、童便调下。（《卫生家宝方》）"}]},{"ID":"20240830103958-z79adw3","Type":"NodeParagraph","Properties":{"id":"20240830103958-z79adw3","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"③治心腹气痛：乌药，水磨浓汁一盏，入橘皮一片，苏一叶，煎服。（《濒湖集简方》）"}]},{"ID":"20240830103958-lgz3all","Type":"NodeParagraph","Properties":{"id":"20240830103958-lgz3all","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"④治胀满痞塞，七情忧思所致：天台乌药、香附、沉香、砂仁、橘红、半夏，为末。每服二钱，灯心汤调。（《亦水玄珠》乌药顺气散）"}]},{"ID":"20240830103958-qaceszj","Type":"NodeParagraph","Properties":{"id":"20240830103958-qaceszj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑤治浑身胀痛，气血凝滞者：香附（盐、酒、便、醋四分制之）、乌药，共细末，酒下四、五分。（《慎斋遗书》香附散）"}]},{"ID":"20240830103958-u6xwtca","Type":"NodeParagraph","Properties":{"id":"20240830103958-u6xwtca","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑥治七情伤感，上气喘息，妨闷不食：人参、槟榔、沉香、天台乌药。上药各浓磨水，和作七分盏，煎三、五沸，放温服。（《济生方》四磨汤）"}]},{"ID":"20240830103958-6sn7cj8","Type":"NodeParagraph","Properties":{"id":"20240830103958-6sn7cj8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑦治气厥头痛，妇人气盛头痛及产后头痛：川芎藭、天台乌药等分，为末。每服二钱，葱、茶调下。（《纲目》）"}]},{"ID":"20240830103958-a43k6zs","Type":"NodeParagraph","Properties":{"id":"20240830103958-a43k6zs","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑧治产后逆气，食滞胀痛：陈皮、藿香、枳壳各钱半，厚朴一钱，泽泻、乌药、香附各二钱，木香七分至一钱，煎服。（《沈氏尊生书》排气饮）"}]},{"ID":"20240830103958-b5j119g","Type":"NodeParagraph","Properties":{"id":"20240830103958-b5j119g","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑨治胎前产后血气不和，腹胀痛：乌药、香附、当归、川芎（俱酒炒）各三钱。水煎服。（《本草切要》）"}]},{"ID":"20240830103958-mhdmtra","Type":"NodeParagraph","Properties":{"id":"20240830103958-mhdmtra","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑩治产后腹痛：天台乌药、杜当归，为末，豆淋酒调下。（《朱氏集验医方》乌药散）"}]},{"ID":"20240830103958-e2fjonc","Type":"NodeParagraph","Properties":{"id":"20240830103958-e2fjonc","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑾治小肠疝气乌药一两，升麻八钱。水二钟，煎一钟，露一宿，空心热服。（《孙天仁集效方》）"}]},{"ID":"20240830103958-xcj2nyw","Type":"NodeParagraph","Properties":{"id":"20240830103958-xcj2nyw","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⑿治干湿脚气乌药一两，莳萝一分（二味炒令黄色）。同为末，温酒下二钱。若是干脚气，用苦楝子一个，柏浆水一升，煎至五合，调下。（《博济方》乌药散）"}]},{"ID":"20240830103958-835qcgl","Type":"NodeParagraph","Properties":{"id":"20240830103958-835qcgl","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒀治脚气掣痛，初发时：土乌药，不犯铁器，布揩去土，瓷瓦刮屑，好酒浸一宿，次早空心温服，溏泄即愈，入麝少许尤佳，痛入腹者，以乌药同鸡子，瓦罐中水煮一日，去鸡子，切片蘸食，以汤送下。（《永类钤力》）"}]},{"ID":"20240830103958-d9o77f8","Type":"NodeParagraph","Properties":{"id":"20240830103958-d9o77f8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒁治肾经虚寒，小便滑数及白浊等疾：天台乌药（细锉）、益智子（大者，去皮，炒）。上等分，为末，别用山药炒黄为末，打糊丸，如梧桐子大，曝干。每服五十丸，嚼茴香数十粒，盐汤或盐酒下。（《魏氏家藏方》固真丹，即《妇人良方》缩泉丸）"}]},{"ID":"20240830103958-i1vmn4z","Type":"NodeParagraph","Properties":{"id":"20240830103958-i1vmn4z","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒂治小儿慢惊，昏沉或搐：乌药磨水灌之。（《济急仙方》）"}]},{"ID":"20240830103958-cwapeou","Type":"NodeParagraph","Properties":{"id":"20240830103958-cwapeou","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒃治小儿疳积：天台乌药、鸡内金、五谷虫各等分，加入青黛％5（例如台乌药净末用一两，青黛用五分）。共研细末，和匀。每晨空腹用温开水送服一至三钱，连服一月。（《浙江中医杂志》乌金散。12：32（560），1958）"}]},{"ID":"20240830103958-jacbgfg","Type":"NodeParagraph","Properties":{"id":"20240830103958-jacbgfg","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒄治泻血，血痢：乌药不以多少，炭火烧存性，捣罗为末，陈粟米饭和丸，如梧桐子大。每服三十丸，米饮下。（《圣济总录》乌金丸）"}]},{"ID":"20240830103958-lsvjax8","Type":"NodeParagraph","Properties":{"id":"20240830103958-lsvjax8","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒅治跌打损伤（背部伤尤宜）：乌药一两，威灵仙五钱。水煎服。（《江西草药》）"}]},{"ID":"20240830103958-aoe0vu5","Type":"NodeParagraph","Properties":{"id":"20240830103958-aoe0vu5","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒆风湿麻痹。用乌药一百两、沈香五十两、人参三两、甘草四两，共研为末。每服半钱，空心服，姜盐汤送下。此方名\"乌沈汤\"。"}]},{"ID":"20240830103958-uelqm0l","Type":"NodeParagraph","Properties":{"id":"20240830103958-uelqm0l","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"⒇一切气痛。用乌药（酒浸一夜后炒）、茴香（炒）、青桔皮（去白，炒）、良姜（炒），等分为末，以温酒加童便调下。"}]},{"ID":"20240830103958-rs7ayqi","Type":"NodeParagraph","Properties":{"id":"20240830103958-rs7ayqi","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（21）几种常见病。用香附、乌药，等分为末，每服一至二钱，饮食不进，姜枣汤送下；疟疾，干姜白盐汤送下；腹中有虫，槟榔汤送下；头风虚肿，茶汤送下；妇女冷气，米汤送下；产后血攻心、脾痛。童便送下；妇女血海痛，男子疝痛，茴香汤送下。"}]},{"ID":"20240830103958-njpq53p","Type":"NodeParagraph","Properties":{"id":"20240830103958-njpq53p","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（22）小肠疝气。用乌药一两、升麻八钱，加水二碗，煎成一碗，露一宿，煨热，空心服。"}]},{"ID":"20240830103958-qeewngr","Type":"NodeParagraph","Properties":{"id":"20240830103958-qeewngr","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（23）脚气扯痛。用乌药刮屑，浸酒中一宿，次早空心温服。溏泄好愈。加麝香少许更好。"}]},{"ID":"20240830103958-8wgt711","Type":"NodeParagraph","Properties":{"id":"20240830103958-8wgt711","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（24）血痢。用乌药烧存性，研为末，加陈米饭做成刃丸子，如梧子大。每服三十丸，米汤送下。"}]},{"ID":"20240830103958-vbyp45p","Type":"NodeParagraph","Properties":{"id":"20240830103958-vbyp45p","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"（25）咽喉闭痛。用生乌药，加酸醋二碗，煎成一碗，先噙后咽，吐出痰涎好愈。"}]},{"ID":"20240830103958-xhbnr6o","Type":"NodeParagraph","Properties":{"id":"20240830103958-xhbnr6o","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【备注】广西地区另有一种乌药，植物为白胶木，形态与本种相似，主要区别：其老叶下面密生金黄色或锈色贴伏柔毛，有光泽。参见\"千打锤\"条。"}]},{"ID":"20240830103958-p18lown","Type":"NodeParagraph","Properties":{"id":"20240830103958-p18lown","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830103958-qhba57r","Type":"NodeParagraph","Properties":{"id":"20240830103958-qhba57r","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"乌药《中华本草》《中药大辞典》"}]},{"ID":"20240830103958-gzdt7yn","Type":"NodeParagraph","Properties":{"id":"20240830103958-gzdt7yn","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830103958-mnrzmqf","Type":"NodeParagraph","Properties":{"id":"20240830103958-mnrzmqf","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目拾遗》：乌药，生岭南邕州、容州及江南。树生似茶，高丈余。一叶三丫，叶青阴白。根状似山芍药及乌樟根，色黑褐，作车毂纹，横生。八月采根，直者不用。"}]},{"ID":"20240830103958-hy00kbf","Type":"NodeParagraph","Properties":{"id":"20240830103958-hy00kbf","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：乌药，木似茶槚，高五、七尺。叶微圆而尖，作三丫，面青背白。四、五月开细花，黄白色，六月结实。（根）如山芍药，而有极粗大者，又似钓樟根，然根有二种，岭南者黑褐色而坚硬，天台者白而虚软，并八月采。根似作车毂形如连珠状者佳，"}]},{"ID":"20240830103958-na363tt","Type":"NodeParagraph","Properties":{"id":"20240830103958-na363tt","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【拼音名】WūYào"}]},{"ID":"20240830103958-8xho98f","Type":"NodeParagraph","Properties":{"id":"20240830103958-8xho98f","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【英文名】CombinedSpicebushRoot,RootofCombinedSpicebush"}]},{"ID":"20240830103958-aajierv","Type":"NodeParagraph","Properties":{"id":"20240830103958-aajierv","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【别名】旁其、天台乌药、鳑魮、矮樟、矮樟根、铜钱柴、土木香、鲫鱼姜、鸡骨香、白叶柴"}]},{"ID":"20240830103958-96wf27i","Type":"NodeParagraph","Properties":{"id":"20240830103958-96wf27i","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830103958-b1y3hmb","Type":"NodeParagraph","Properties":{"id":"20240830103958-b1y3hmb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"药材基源：为樟科植物乌药的根。"}]},{"ID":"20240830103958-whi6taf","Type":"NodeParagraph","Properties":{"id":"20240830103958-whi6taf","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Linderaaggregata(Sims.)Kosterm.[L.strychnifolia(Sieb.etZucc.)F.-Vill.]"}]},{"ID":"20240830103958-7hri5k3","Type":"NodeParagraph","Properties":{"id":"20240830103958-7hri5k3","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬春季采挖根，除去细根，洗净晒干，称“乌药个”。趁鲜刮去棕色外皮，切片干燥，称“乌药片”。"}]},{"ID":"20240830103958-10jtk5x","Type":"NodeParagraph","Properties":{"id":"20240830103958-10jtk5x","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【原形态】乌药，常绿灌木或小乔木，高达4-5m。根木质，膨大粗壮，略成念珠状。树皮灰绿色。小枝幼时密被锈色短柔毛，老时平滑无毛；茎枝坚韧，不易断。叫互生，革质，椭圆形至广倒卵形，长3-8cm，宽1.5-5cm，先端渐尖或尾状渐尖，基部圆形或广楔形，全缘，上面绿色，有光泽，除中脉外，均光滑无毛，下面灰白色，被淡褐色长柔毛，后变光滑，叶脉3条，基出，极明显；叶柄短，有短柔毛。伞形花序腋生，几无总梗；小花梗长1.5-3mm，被毛，簇生多数小花；花单性，雌雄异株，黄绿色；花被6片，大小几相等，广椭圆形，雄花有雄蕊9枚，排成3轮，最内一轮的基部有腺体，花药2室；雌花有退化雄蕊多枚，子房上位，球形，1室，胚珠1枚。核果近球形，初绿色，成熟后变黑色。花期3-4月。果期10-11月。"}]},{"ID":"20240830103958-n2kloud","Type":"NodeParagraph","Properties":{"id":"20240830103958-n2kloud","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830103958-hakzixw","Type":"NodeParagraph","Properties":{"id":"20240830103958-hakzixw","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"生态环境：生于向阳山坡灌木林中或林缘以及山麓、旷野等地。"}]},{"ID":"20240830103958-2n0kmy1","Type":"NodeParagraph","Properties":{"id":"20240830103958-2n0kmy1","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、安徽、浙江、江西、福建、台湾、湖北、湖南、广西、四川等地。"}]},{"ID":"20240830103958-1i2izpi","Type":"NodeParagraph","Properties":{"id":"20240830103958-1i2izpi","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830103958-p8alz8x","Type":"NodeParagraph","Properties":{"id":"20240830103958-p8alz8x","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.生物学特性喜亚热带气候，适应性强。以在阳光充足，土质疏松肥沃的酸性土壤栽培为宜。"}]},{"ID":"20240830103958-nrap076","Type":"NodeParagraph","Properties":{"id":"20240830103958-nrap076","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.栽培技术用种子繁殖。果实9-10月成熟，采摘后沙藏。翌春播种，幼苗生长缓慢，苗高30cm以上移栽。"}]},{"ID":"20240830103958-gzm3gzr","Type":"NodeParagraph","Properties":{"id":"20240830103958-gzm3gzr","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830103958-amrcx9m","Type":"NodeParagraph","Properties":{"id":"20240830103958-amrcx9m","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别乌药个，根纺锤形或圆形，略弯曲，有的中部收缩呈连珠状，习称“乌药珠”，长5-15cm，直径1-3cm。表面黄棕色或灰棕色，有细纵皱纹及稀疏的细根痕。质极坚硬，不易折断，断面黄白色。气芳香，味微苦、辛，有清凉感。"}]},{"ID":"20240830103958-wv7t4a4","Type":"NodeParagraph","Properties":{"id":"20240830103958-wv7t4a4","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"乌药片为横切圆形薄片，厚1-5mm，或更薄，切面黄白色至淡棕黄色而微红，有放射状纹理和年轮。质脆。"}]},{"ID":"20240830103958-wal87os","Type":"NodeParagraph","Properties":{"id":"20240830103958-wal87os","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"以个大、肥壮、质嫩、折断面香气浓郁者为佳；质老、不呈纺锤形的直根，不供药用。"}]},{"ID":"20240830103958-qr5i09y","Type":"NodeParagraph","Properties":{"id":"20240830103958-qr5i09y","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别根（直径1.4cm）横切面：木栓层为5-6列木栓细胞，多破裂。皮层狭窄，散有较多的椭圆形油细胞，内含黄色挥发油滴。韧皮部常有单个纤维及油细胞散在。形成层成环。木质部占根的绝大部分，年轮明显；导管呈径向稀疏排列；木纤维发达，根中央尤甚；木射线宽1列细胞；油细胞少见。本品薄壁细胞含淀粉粒，有的含黄色内含物。"}]},{"ID":"20240830103958-7ecgjlb","Type":"NodeParagraph","Properties":{"id":"20240830103958-7ecgjlb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"3.粉末特征黄白色。①淀粉粒单粒类球形、长圆形或卵圆形，直径4-39μm，脐点叉状、人字状或裂缝状；复粒由2-4个分粒组成。②木纤维淡黄色，直径20-30μm，壁厚约5μm，有单纹孔。③韧皮纤维无色，长梭形，直径15-17μm，壁极厚，孔沟不明显。④具缘纹孔导管直径约至68μm，具缘纹孔排列紧密。⑤油细胞长圆形，含棕色分泌物。⑥射线细胞壁稍增厚，纹孔较密。"}]},{"ID":"20240830103958-x3mnrta","Type":"NodeParagraph","Properties":{"id":"20240830103958-x3mnrta","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【化学成份】根茎含钓樟醇(Linderol，即龙脑Borneol)、倍半萜成分：钓樟环氧内酯(Linderane)、钓樟内酯(Linderalactone)、异钧樟内酯(Isolinderalactone)、新钓樟内酯(Neolinderalactone)。钓樟揣内酯(Lindestrenolide)、去氢钓樟揣内酯、钓樟烯醇(Linderene)、钓樟烯(Lèndenene、钓樟烯酮(Lindenenone)、钓樟揣烯(Lindestrene)、钓樟烯醇乙酸酯(Lindereneacetate)、异氧化钓樟素(Isolinderoxide)、乌药酸(Linderaicacid，C15H18O3)、钓樟薁(Linderazulene)、兰香油奥(Chamazulene)等。尚含新木姜子碱(Laurolitsine)。"}]},{"ID":"20240830103958-49hrr8c","Type":"NodeParagraph","Properties":{"id":"20240830103958-49hrr8c","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830103958-8ofdeeh","Type":"NodeParagraph","Properties":{"id":"20240830103958-8ofdeeh","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.挥发油的兴奋作用：内服时，有兴奋大脑皮质的作用，并有促进呼吸，兴奋心肌，加速血循环，升高血压及发汗的作用。局部外用使局部血管扩张，血循环加速，缓和肌肉痉挛性疼痛。"}]},{"ID":"20240830103958-m7ko083","Type":"NodeParagraph","Properties":{"id":"20240830103958-m7ko083","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.抑菌作用：对金黄色葡萄球菌，甲型溶血性链球菌，伤寒杆菌，变形杆菌，绿脓杆菌，大肠杆菌均有抑制作用。"}]},{"ID":"20240830103958-edkzzkh","Type":"NodeParagraph","Properties":{"id":"20240830103958-edkzzkh","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"3.对消化道的影响：有报导乌药对胃肠平滑肌有双重作用，此外，乌药能增加消化液的分泌。"}]},{"ID":"20240830103958-qc090wu","Type":"NodeParagraph","Properties":{"id":"20240830103958-qc090wu","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"4.止血作用：体外实验证明，乌药干粉能明显缩短家兔血浆再钙化时间，促进血凝及良好的止血作用。"}]},{"ID":"20240830103958-dpy5mi6","Type":"NodeParagraph","Properties":{"id":"20240830103958-dpy5mi6","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"5.其它作用：用乌药长期喂大鼠，可使体重增加，并对小鼠肉瘤-180有抑制作用。其龙脑可发汗、兴奋、镇痉、驱虫等。"}]},{"ID":"20240830103958-g6je04n","Type":"NodeParagraph","Properties":{"id":"20240830103958-g6je04n","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴定：薄层层析：取本品粉末适量，用挥发油测定器提得挥发油。吸取一定量，加少量醋酸乙酯稀释，供点样用，以龙脑、β-蒎烯为对照品，分别点样于同一硅胶Ｇ薄层板上，以己烷-乙酸乙酯（85：15）展开15cm。喷以５%香草醛浓硫酸试液。样品色谱在与对照品色谱的相应位置显相同的色斑。"}]},{"ID":"20240830103958-dt77ox9","Type":"NodeParagraph","Properties":{"id":"20240830103958-dt77ox9","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830103958-x5seq32","Type":"NodeParagraph","Properties":{"id":"20240830103958-x5seq32","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.拣去杂质，分开大小条，用水泡透，根据季节注意换水，防止发臭，及时捞出切片。如已在鲜时切片者，筛去灰屑。"}]},{"ID":"20240830103958-j3gr2mb","Type":"NodeParagraph","Properties":{"id":"20240830103958-j3gr2mb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.炒制：取净乌药片，用文火炒至深黄色取出。"}]},{"ID":"20240830103958-pdmx560","Type":"NodeParagraph","Properties":{"id":"20240830103958-pdmx560","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"3.麸制：取净乌药片，用麦麸炒至微黄，筛去麦麸即得。"}]},{"ID":"20240830103958-me88ury","Type":"NodeParagraph","Properties":{"id":"20240830103958-me88ury","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"4.醋制：取乌药片与醋拌匀，略闷，置锅内用文火炒至微带焦斑为度，取出放凉。每乌药500g，用醋60g。"}]},{"ID":"20240830103958-pcsqpfq","Type":"NodeParagraph","Properties":{"id":"20240830103958-pcsqpfq","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"5.酒制：取乌药片，加黄酒拌匀，闷润至酒尽时，置锅内用文火炒至微干，取出放干，每乌药500g，用黄酒60g。"}]},{"ID":"20240830103958-gyaacfh","Type":"NodeParagraph","Properties":{"id":"20240830103958-gyaacfh","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"6.盐制：取麦麸，炒热，加入经盐水润半小时的乌药片，炒3-4分钟至呈淡黄色，筛去麦麸即可。每乌药16kg，用盐0.4kg，开水2kg，麦麸2kg。"}]},{"ID":"20240830103958-8kz9em4","Type":"NodeParagraph","Properties":{"id":"20240830103958-8kz9em4","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【性味】辛；温"}]},{"ID":"20240830103958-omuq2w2","Type":"NodeParagraph","Properties":{"id":"20240830103958-omuq2w2","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃、肝、肾、膀胱"}]},{"ID":"20240830103958-wxipgzo","Type":"NodeParagraph","Properties":{"id":"20240830103958-wxipgzo","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气止痛；温肾散寒。主胸胁满闷；脘腹胀痛；头痛；寒疝疼痛；痛经及产后腹痛；尿频；遗尿"}]},{"ID":"20240830103958-2bc9osz","Type":"NodeParagraph","Properties":{"id":"20240830103958-2bc9osz","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-10g，或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240830103958-58wbjxm","Type":"NodeParagraph","Properties":{"id":"20240830103958-58wbjxm","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【注意】气虚及内热证患者禁服；孕妇及体虚者慎服。"}]},{"ID":"20240830103958-dsy1jwj","Type":"NodeParagraph","Properties":{"id":"20240830103958-dsy1jwj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【附方】1.天台乌药散(《医学发明》)，行气疏肝，散寒止痛，治寒凝气滞的小肠疝气，少腹引控睾丸而痛，偏坠肿痛，痛经。2.暖肝煎(《景岳全书》)，用于肝肾阴寒，小腹疼痛，疝气等。3.四磨汤(《济生方》)，行气降逆，宽胸散结，治七情所伤，肝气郁结所致胸膈烦闷，上气喘急，心下痞满，不思饮食。4.乌药顺气散(《赤水玄珠》)，行气宽胸，治七情忧思所致的胀满痞塞之证。5.排气饮(《沈氏尊生方》)，行气消滞，治产后逆气，食滞胀痛。6.缩泉丸(《妇人良方》)，温肾祛寒，缩尿止遗，主治下元虚冷，小便频数，小儿遗尿。7.五磨饮子(《医方集解》)，顺气行滞。8.六磨汤(《证治准绳》)，顺气行滞，调理肝脾，通便导滞，治情志失和，肝脾之气郁结导致大便秘结，欲便不得，嗳气频作胸胁痞满，腹中胀痛，纳食减小。9.膈下逐瘀汤(《医林改错》)，祛瘀软坚，兼调脾胃，治气血凝结，脉络阻塞，血瘀日甚所致腹部积块，硬痛不移，面黯消瘦，纳减乏力，时有寒热，月事不行。"}]},{"ID":"20240830103958-j5jl60n","Type":"NodeParagraph","Properties":{"id":"20240830103958-j5jl60n","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830103958-5tn2s31","Type":"NodeParagraph","Properties":{"id":"20240830103958-5tn2s31","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"1.《本草抬遗》：主中恶心腹痛，宿食不消，天行疫瘴，膀胱肾间冷气攻冲背膂，妇人血气，小儿腹中诸虫。"}]},{"ID":"20240830103958-a88l4eb","Type":"NodeParagraph","Properties":{"id":"20240830103958-a88l4eb","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：治一切气，除一切冷，霍乱及反胃吐食，泻痢，痈疖疥癫，并解冷热。"}]},{"ID":"20240830103958-gwf65zv","Type":"NodeParagraph","Properties":{"id":"20240830103958-gwf65zv","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"3.王好古：理元气。"}]},{"ID":"20240830103958-z7unqoj","Type":"NodeParagraph","Properties":{"id":"20240830103958-z7unqoj","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治中气，脚气，疝气，气厥头痛,肿胀喘息，止小便数及白浊。"}]},{"ID":"20240830103958-6wt2jen","Type":"NodeParagraph","Properties":{"id":"20240830103958-6wt2jen","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"5.《本草通玄》：理七情郁结，气血凝停,霍乱吐泻，痰食稽留。"}]},{"ID":"20240830103958-1t4z0hy","Type":"NodeParagraph","Properties":{"id":"20240830103958-1t4z0hy","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"6.《玉楸药解》：破瘀泄满，止痛消胀。"}]},{"ID":"20240830103958-x5jfddc","Type":"NodeParagraph","Properties":{"id":"20240830103958-x5jfddc","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"7.《本草衍义》：乌药，和来气少，走泄多，但不甚刚猛，与沉香同磨作汤，治胸腹冷气，甚稳当。"}]},{"ID":"20240830103958-i73inr9","Type":"NodeParagraph","Properties":{"id":"20240830103958-i73inr9","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"8.《纲目》：乌药，辛温香窜，能散诸气，故《惠民和剂局方》治七情郁结，上气喘急用四磨汤者，降中兼l，滞中带补也，《朱氏集验方》治虚寒小便频数缩泉丸，取其通阳明、少阴经也。"}]},{"ID":"20240830103958-phmve14","Type":"NodeParagraph","Properties":{"id":"20240830103958-phmve14","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"9.《本草经疏》：乌药，辛温散气，病属气虚者忌之。世人多以香附同用，治女人一切气病，不知气有虚有实，有寒有热，冷气、暴气用之固宜，气虚、气热用之，能无贻害耶。"}]},{"ID":"20240830103958-readt9f","Type":"NodeParagraph","Properties":{"id":"20240830103958-readt9f","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"10.《药品化义》：乌药，气雄性温，故快气宣通，疏散凝滞，甚于香附。外解表而理肌，内宽中而顺气。以之散寒气，则客寒冷痛自除；驱邪气则天行疫瘴即却；开郁气，中恶腹痛，胸膈胀满，顿然可减；疏经气，中风四肢不遂，初产血气凝滞，渐次能通，皆藉其气雄之功也。"}]},{"ID":"20240830103958-zybfke4","Type":"NodeParagraph","Properties":{"id":"20240830103958-zybfke4","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"11.《本草述》：按乌药之用，耳食者本于寇氏'走泄多'一语，以为专于辛散而已，如海藏谓其'理元气'，何以忽而不一绎也？如止于辛散，安得宿食能化，血痢能止，便数能节，症结能消，头风虚肿之可除，腹中有虫之可尽，妇人产后血逆及血海作痛之可疗，小儿积聚蛔虫及慢惊昏沉之可安，即《日华子》亦谓其功不能尽述者，是其徒以辛散为功乎？盖不等于补气之剂，亦不同于耗气之味，实有理其气之元，致其气之用者。使止以疏散为能，而不能密理致用，可谓能理气乎？丹溪每于补阴剂内入乌药叶，岂非灼见此味，于达阳之中而有和阴之妙乎？达阳而能和阴，则不等于耗剂矣。香附血中行气，乌药气中和血，离血而行气，是谓之耗，不谓之理，盖气本出于阴中之阳，达于阳中之阴也。"}]},{"ID":"20240830103958-scyfgko","Type":"NodeParagraph","Properties":{"id":"20240830103958-scyfgko","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"12.《本草新编》：乌药，产妇虚而胎气不顺者，切不可用，用则胎立堕。人以为顺气用之，谁知乌药能顺胎气之实，而不顺胎气之虚乎？不独胎气，凡气虚者，俱不能顺，惟血虚而带郁滞者宜之耳。"}]},{"ID":"20240830103958-8k1kqkf","Type":"NodeParagraph","Properties":{"id":"20240830103958-8k1kqkf","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"13.《本草求真》：乌药，功与木香、香附同为一类，但木香苦温，入脾爽滞，用于食积则宜；香附辛苦，入肝、胆二经，开郁散结，每于优郁则妙；此则逆邪横胸，无处不达，故用以为胸腹逆邪要药耳。"}]},{"ID":"20240830103958-47gptbw","Type":"NodeParagraph","Properties":{"id":"20240830103958-47gptbw","updated":"20240830104046"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》《中药大辞典》"}]},{"ID":"20240830103959-mmu8utq","Type":"NodeThematicBreak","Properties":{"id":"20240830103959-mmu8utq","updated":"20240830104046"}},{"ID":"20240830104000-t0047hi","Type":"NodeParagraph","Properties":{"id":"20240830104000-t0047hi","updated":"20240830104046"}}]}