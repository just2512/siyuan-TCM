pe":"NodeLinkText","Data":"柿子树 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柿子树 6-20240715110709-gq20ue6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715110653-cywasnq","Type":"NodeParagraph","Properties":{"id":"20240715110653-cywasnq","updated":"20240715110653"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柿子树 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柿子树 5-20240715110653-zi4bstj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619195944-u78ok12","Type":"NodeThematicBreak","Properties":{"id":"20240619195944-u78ok12"}},{"ID":"20240902091324-lhxa36i","Type":"NodeParagraph","Properties":{"id":"20240902091324-lhxa36i","updated":"20240902091333"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：柿蒂"}]},{"ID":"20240902091324-h4gkrow","Type":"NodeParagraph","Properties":{"id":"20240902091324-h4gkrow","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"柿蒂《中国药典》"}]},{"ID":"20240902091324-3nnvudu","Type":"NodeParagraph","Properties":{"id":"20240902091324-3nnvudu","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShìDì"}]},{"ID":"20240902091324-e6y6n7w","Type":"NodeParagraph","Properties":{"id":"20240902091324-e6y6n7w","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【英文名】CALYXKAKI"}]},{"ID":"20240902091324-logh2lv","Type":"NodeParagraph","Properties":{"id":"20240902091324-logh2lv","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【来源】本品为柿树科植物柿DiospyroskakiThunb.的干燥宿萼。冬季果实成熟时采摘,食用时收集，洗净，晒干。"}]},{"ID":"20240902091324-6lpzo8q","Type":"NodeParagraph","Properties":{"id":"20240902091324-6lpzo8q","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈扁圆形，直径1.5～2.5cm。中央较厚，微隆起，有果实脱落后的圆形疤痕，边缘较薄，4裂，裂片多反卷，易碎；基部有果梗或圆孔状的果梗痕。外表面黄褐色或红棕色，内表面黄棕色，密被细绒毛。质硬而脆。无臭，味涩。"}]},{"ID":"20240902091324-j2hkbjw","Type":"NodeParagraph","Properties":{"id":"20240902091324-j2hkbjw","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粗粉2g，加70％乙醇10ml，温浸2小时，滤过，滤液蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取没食子酸对照品，加甲醇制成每1ml含0.5mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述供试品溶液5μl、对照品溶液2μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以甲苯（用水饱和）－甲酸乙酯－甲酸（5:4:1）为展开剂，展开，取出，晾干，喷以1％三氯化铁乙醇溶液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902091324-e0cjigp","Type":"NodeParagraph","Properties":{"id":"20240902091324-e0cjigp","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，去柄，干燥或打碎。"}]},{"ID":"20240902091324-ud1g9i7","Type":"NodeParagraph","Properties":{"id":"20240902091324-ud1g9i7","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性味】苦、涩，平。"}]},{"ID":"20240902091324-h74ejj0","Type":"NodeParagraph","Properties":{"id":"20240902091324-h74ejj0","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【归经】归胃经。"}]},{"ID":"20240902091324-stdfy92","Type":"NodeParagraph","Properties":{"id":"20240902091324-stdfy92","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【功能主治】降逆下气。用于呃逆。"}]},{"ID":"20240902091324-voii3vl","Type":"NodeParagraph","Properties":{"id":"20240902091324-voii3vl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。"}]},{"ID":"20240902091324-w0r8p7g","Type":"NodeParagraph","Properties":{"id":"20240902091324-w0r8p7g","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防蛀。"}]},{"ID":"20240902091324-qqwiffc","Type":"NodeParagraph","Properties":{"id":"20240902091324-qqwiffc","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902091324-aatm6bi","Type":"NodeParagraph","Properties":{"id":"20240902091324-aatm6bi","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"柿蒂《*辞典》"}]},{"ID":"20240902091324-wq1hb5c","Type":"NodeParagraph","Properties":{"id":"20240902091324-wq1hb5c","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【出处】《本草拾遗》"}]},{"ID":"20240902091324-3ma1fjn","Type":"NodeParagraph","Properties":{"id":"20240902091324-3ma1fjn","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShìDì"}]},{"ID":"20240902091324-t20zicv","Type":"NodeParagraph","Properties":{"id":"20240902091324-t20zicv","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【别名】柿钱（《洁古家珍》），柿丁（《中药志》），柿子把（《中药材手册》），柿萼（《药材学》）。"}]},{"ID":"20240902091324-d1zahxl","Type":"NodeParagraph","Properties":{"id":"20240902091324-d1zahxl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【来源】为柿种植物柿的宿存花萼。冬季收集成热柿子的果蒂，去柄，洗净，晒干。"}]},{"ID":"20240902091324-e5943e4","Type":"NodeParagraph","Properties":{"id":"20240902091324-e5943e4","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902091324-kdils3g","Type":"NodeParagraph","Properties":{"id":"20240902091324-kdils3g","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"柿（《礼记》），又名:镇头迦（《纲目》）。"}]},{"ID":"20240902091324-yiqrc9y","Type":"NodeParagraph","Properties":{"id":"20240902091324-yiqrc9y","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达14米。树皮鳞片状开裂，灰黑色；枝深棕色，具棕色皮孔，微有毛，嫩枝有柔毛。叶互生；叶柄有柔毛；叶片椭圆形至倒卵形，长6～18厘米，先端渐尖，基部阔楔形，全缘，革质，上面深绿色，主脉疏生柔毛，下面淡绿色，有短柔毛，沿叶脉密生淡褐色绒毛。花杂性，雄花成聚伞花序，雌花单生叶腋；花黄白色，花萼下部短筒状，4裂，内面有毛；花冠钟形，4裂；雄蕊在雄花中16枚，在两性花中8～16枚，雌花有8枚退化雄蕊；子房上位，8室，花柱自基部分离。浆果卵圆球形，直径3.5～8厘米，橙黄色或鲜黄色，基部有宿存萼片。花期5月。果期9～10月。"}]},{"ID":"20240902091324-59o51tf","Type":"NodeParagraph","Properties":{"id":"20240902091324-59o51tf","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"本植物的根或根皮（柿根）、树皮（柿木皮）、叶（柿叶）、花（柿花）、果实（柿子）、果实的制成品（柿讲）及其外附白霜（柿霜）、外果皮（柿皮）、未成熟果实液汁的制成品（柿漆）亦供药用，各详专条。"}]},{"ID":"20240902091324-q6qmlp1","Type":"NodeParagraph","Properties":{"id":"20240902091324-q6qmlp1","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【生境分布】多为栽培。分布辽宁、河北、河南、山东、安徽、江苏、浙江、福建、广东、江西、湖南、湖北、山西、陕西、甘肃等地。主产河南、山东，福建、河北、山西等地亦产。"}]},{"ID":"20240902091324-57b4hdl","Type":"NodeParagraph","Properties":{"id":"20240902091324-57b4hdl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性状】干燥宿萼呈盖状，顶端中央有1果柄，或脱落而留下圆孔，萼的中部较厚，边缘4裂，裂片常向上反卷，易碎裂，基部连合呈皿状，直径1.5～2.5厘米，厚1～4毫米。外表面红棕色，仔细观察时，上有稀疏短毛，内表面有细密的黄棕色短绒毛，放射状排列，具光泽，中央有1果实脱落所遗留的圆形凸起的疤痕。质薄而体轻。气无，味涩。以红棕色、质厚、味涩、表面带柿霜者为佳。"}]},{"ID":"20240902091324-uqzfiz6","Type":"NodeParagraph","Properties":{"id":"20240902091324-uqzfiz6","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【化学成份】含羟基三萜酸0.37％，中有齐墩果酸、白桦脂酸和熊果酸。又含葡萄糖、果糖、酸性物质和中性脂肪油。并含鞣质。"}]},{"ID":"20240902091324-va5th68","Type":"NodeParagraph","Properties":{"id":"20240902091324-va5th68","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902091324-c37rv94","Type":"NodeParagraph","Properties":{"id":"20240902091324-c37rv94","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"苦涩，平。"}]},{"ID":"20240902091324-vff0a5b","Type":"NodeParagraph","Properties":{"id":"20240902091324-vff0a5b","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"①《纲目》:\"涩，平，无毒。\""}]},{"ID":"20240902091324-ewns73j","Type":"NodeParagraph","Properties":{"id":"20240902091324-ewns73j","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》:\"味苦涩，气温，无毒。\""}]},{"ID":"20240902091324-5kz4abh","Type":"NodeParagraph","Properties":{"id":"20240902091324-5kz4abh","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902091324-8r1icjl","Type":"NodeParagraph","Properties":{"id":"20240902091324-8r1icjl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》:\"入手太阴肺经。\""}]},{"ID":"20240902091324-cimaj58","Type":"NodeParagraph","Properties":{"id":"20240902091324-cimaj58","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"②《本草求真》:\"入肺、胃。\""}]},{"ID":"20240902091324-a7v204t","Type":"NodeParagraph","Properties":{"id":"20240902091324-a7v204t","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902091324-v9cgp2z","Type":"NodeParagraph","Properties":{"id":"20240902091324-v9cgp2z","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"降逆气。止呃忒、呕哕。"}]},{"ID":"20240902091324-04iy7ds","Type":"NodeParagraph","Properties":{"id":"20240902091324-04iy7ds","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"①孟诜:\"治咳逆、哕气，煮汁服。\""}]},{"ID":"20240902091324-7hpn453","Type":"NodeParagraph","Properties":{"id":"20240902091324-7hpn453","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》:\"治气隔反胃。\""}]},{"ID":"20240902091324-dcybs91","Type":"NodeParagraph","Properties":{"id":"20240902091324-dcybs91","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服:煎汤，2～4钱；或入散剂。"}]},{"ID":"20240902091324-c2dvtnk","Type":"NodeParagraph","Properties":{"id":"20240902091324-c2dvtnk","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902091324-63eiw2j","Type":"NodeParagraph","Properties":{"id":"20240902091324-63eiw2j","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"①治呃逆:柿钱、丁香、人参等分。为细末，水煎，食后服。（《洁古家珍》柿钱散）"}]},{"ID":"20240902091324-35k7zty","Type":"NodeParagraph","Properties":{"id":"20240902091324-35k7zty","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"②治呃逆不止:柿蒂（烧灰存性）为末。黄酒调服，或用姜汁、砂糖等分和匀，炖热徐服。（《村居救急方》）"}]},{"ID":"20240902091324-axpn8py","Type":"NodeParagraph","Properties":{"id":"20240902091324-axpn8py","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"③治伤寒呕哕不止:干柿蒂七枚，白梅三枚。上二味，粗捣筛，只作一服，用水一盏，煎至半盏。去滓温服，不拘时。（《圣济总录》柿蒂汤）"}]},{"ID":"20240902091324-6oaj18q","Type":"NodeParagraph","Properties":{"id":"20240902091324-6oaj18q","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"④治胞满咳逆不止:柿蒂、丁香各一两。上细切，每服四钱，水一盏半，姜五片，煎至七分。去滓热服，不拘时候。（《济生方》柿蒂汤）"}]},{"ID":"20240902091324-jru5e4z","Type":"NodeParagraph","Properties":{"id":"20240902091324-jru5e4z","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"⑤治百日咳:柿蒂四钱（阴干），乌梅核中之白仁十个（细切），加白糖三钱。用水二杯，煎至一杯。一日数回分服，连服数日。（《江西中医药》（3）:20～22，1953）"}]},{"ID":"20240902091324-5v2n0kt","Type":"NodeParagraph","Properties":{"id":"20240902091324-5v2n0kt","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"⑥治血淋:干柿蒂（烧灰存性），为末。每服二钱，空心米饮调服。（《奇效良方》柿蒂散）"}]},{"ID":"20240902091324-jlnrp9b","Type":"NodeParagraph","Properties":{"id":"20240902091324-jlnrp9b","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902091324-zbws31l","Type":"NodeParagraph","Properties":{"id":"20240902091324-zbws31l","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"①朱震亨:\"人之阴气，依胃为养。土伤则木挟相火，直冲清道而上作咳逆，古人以为胃寒，既用丁香、柿蒂，不知其孰为补虚、孰为降火，不能清气利痰，惟有助火而已。\""}]},{"ID":"20240902091324-g2bk0uj","Type":"NodeParagraph","Properties":{"id":"20240902091324-g2bk0uj","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"②《纲目》:\"咳逆者，气自脐下冲脉直上至咽膈，作呃忒、蹇逆之声也。朱肱《南阳书》以哕为咳逆，王履《溯洄集》以咳嗽为咳逆，皆误矣。哕者，干呕有声也。咳逆，有伤寒吐下后，及久病、产后、老人、虚人阴气大亏，阳气暴逆，自下焦逆至上焦，而不能出者；有伤寒失下，及平人痰气抑遏而然者。当视其虚实阴阳，或温或补，或泄热，或降气，或吐或下可也。古方单用柿蒂煮汁饮之，取其苦温能降逆气也。《济生》柿蒂散加以丁香、生姜之辛热，以开痰散郁，盖从治之法，而昔人亦常用之收效矣。至易水张氏，又益以人参，治病后虚人咳逆，亦有功绩。丹溪朱氏但执以寒治热之理，而不及从治之法，矫枉之过矣。若陈氏《三因》，又加以良姜之类，是真以为胃寒而助其邪火者也。\""}]},{"ID":"20240902091324-knb1y72","Type":"NodeParagraph","Properties":{"id":"20240902091324-knb1y72","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》:\"沈则施曰，按丹溪翁谓人之阴气，依胃为养。土伤则木挟相火，直冲清道而作咳逆，宜竹茹黄连柿蒂汤主之，此言热呃也。《济生》论调阳竭于下，孤阴独存，阴气亦将旋脱，故逆上而作呃，宜丁附人参柿蒂汤主之，此言寒呃也。又按《准绳》论呃逆之证，有伤寒吐下后、久病、产后阴血大亏，阳气暴逆，自下逆上而作呃者，非大温中补中之剂不能治。又有平人饮食痰气抑遏，而气自脐下冲脉直上咽膈，而作呃忒蹇逆之声，甩平胃二陈汤，加柿蒂数枚煎服，亦可止也。观于柿蒂之苦涩，但可以散逆气，而因寒、因热、因虚、因滞者，则佐以丁、姜、茹、连、参、术、平胃、二胨辈，当仔细斟酌，毋轻视也。\""}]},{"ID":"20240902091324-bq1uonx","Type":"NodeParagraph","Properties":{"id":"20240902091324-bq1uonx","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"④《本草求真》:\"柿蒂，虽与丁香同为止呃之味，然一辛热而一苦平，合用深得寒热兼济之妙。如系有寒无热，则丁香在所必用，不得固执从治，必当佐以柿蒂。有热无寒，则柿蒂在所必需，不得泥以兼济之必杂以丁香。是以古人用药，有合数味而见效者，有单用一味而见效者，要使药与病对，不致悖谬而枉施耳。\""}]},{"ID":"20240902091324-8bbo0ub","Type":"NodeParagraph","Properties":{"id":"20240902091324-8bbo0ub","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902091324-m9fjvwz","Type":"NodeParagraph","Properties":{"id":"20240902091324-m9fjvwz","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"柿蒂《中华本草》"}]},{"ID":"20240902091324-qdx15qa","Type":"NodeParagraph","Properties":{"id":"20240902091324-qdx15qa","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目拾遗》"}]},{"ID":"20240902091324-2no08zv","Type":"NodeParagraph","Properties":{"id":"20240902091324-2no08zv","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShìDì"}]},{"ID":"20240902091324-9k68nby","Type":"NodeParagraph","Properties":{"id":"20240902091324-9k68nby","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【别名】柿钱、柿丁、柿子把、柿萼"}]},{"ID":"20240902091324-h18kt0k","Type":"NodeParagraph","Properties":{"id":"20240902091324-h18kt0k","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902091324-4g0ktcc","Type":"NodeParagraph","Properties":{"id":"20240902091324-4g0ktcc","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"药材基源：为柿科植物柿的宿存花萼。"}]},{"ID":"20240902091324-h92wag5","Type":"NodeParagraph","Properties":{"id":"20240902091324-h92wag5","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：DiospyroskakiThunb."}]},{"ID":"20240902091324-srync6s","Type":"NodeParagraph","Properties":{"id":"20240902091324-srync6s","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬季收集成熟柿子的果蒂（带宿存花萼），去柄，晒干。"}]},{"ID":"20240902091324-ii9z56x","Type":"NodeParagraph","Properties":{"id":"20240902091324-ii9z56x","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶大乔木，高达14m。树皮深灰色至灰黑色，长方块状开裂；枝开展，有深棕色皮孔，嫩枝有柔毛。单叶互生；叶柄长8-20mm；叶片卵状椭圆形至倒卵形或近圆形，长5-18cm，宽2.8-9cm，先端渐尖或钝，基部阔楔形，全缘，上面深绿色，主脉生柔毛，下面淡绿色，有短柔毛，沿脉密被褐色绒毛。花杂性，雄花成聚伞花序，雌花单生叶腋；总花梗长约5mm，有微小苞片；花萼下部短筒状，4裂，内面有毛；花冠黄白色，钟形，4裂；雄蕊在雄花中16枚，在两性花中8-16枚，雌花有8枚退化雄蕊；子房上位，8室，花柱自基部分离。浆果形状种种，多为卵圆球形，直径3.5-8cm，橙黄色或鲜黄色，基部有宿存萼片。种子褐色，椭圆形。花期5月，果期9-10月。"}]},{"ID":"20240902091324-b0kqqhs","Type":"NodeParagraph","Properties":{"id":"20240902091324-b0kqqhs","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【生境分布】多为栽培种。分布于华东、中南及辽宁、河北、山西、陕西、甘肃、台湾等地。"}]},{"ID":"20240902091324-lpn6opf","Type":"NodeParagraph","Properties":{"id":"20240902091324-lpn6opf","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902091324-63409ai","Type":"NodeParagraph","Properties":{"id":"20240902091324-63409ai","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"性状鉴别宿萼近盘状，先端4裂，裂片宽三角形，多向外反卷或破碎不完整，具纵脉纹，萼筒增厚，平展，近方形，直径1．5-2．5cm，表面红棕色，被稀疏短毛，中央有短果柄或圆形凹陷的果柄痕；内面黄棕色，密被锈色短绒毛，放射状排列，具光泽，中心有果实脱落后圆形隆起的疤痕。裂片质脆，易碎，萼筒坚硬木质。质轻，气微，味涩。"}]},{"ID":"20240902091324-0npmu2c","Type":"NodeParagraph","Properties":{"id":"20240902091324-0npmu2c","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"以个大而厚、质硬、色黄褐者为佳。"}]},{"ID":"20240902091324-jd30z1i","Type":"NodeParagraph","Properties":{"id":"20240902091324-jd30z1i","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：棕色。①非腺毛较多，单细胞，直径20-26μm，一种长150-300μm，壁厚约8μm,含棕色物质；另一种长可至850μm，壁厚约5μm。②石细胞众多，有分枝，一般直径约80μm，少数达180μm，壁厚5-30μm，纹孔细密，孔沟明显。③草酸钙方晶直径6-30μm。④下表皮细胞近方形或多角形；气孔不定式，副卫细胞5-7个。⑤腺毛少见，头部由2-3个细胞组成，直径约30μm，胞腔内充满棕红色物质，柄1-2个细胞。"}]},{"ID":"20240902091324-i220fzl","Type":"NodeParagraph","Properties":{"id":"20240902091324-i220fzl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"理化鉴别薄层色谱：取本品粗粉0．1g，加70％乙醇4ml，浸泡过夜，滤过。滤液在水浴上蒸干，加乙醇0．5ml溶解后供点样。另以没食子酸与槲皮素醇溶液为对照品。分别点样在硅胶G板上，用甲苯-甲酸乙酯-甲酸（5：4：1），展开10cm。取出晾干。以1％三氯化铁醇试剂喷雾显色，没食子酸呈蓝黑色。以2％三氯化铝醇试剂喷后显色，于紫外光灯（254nm）下观察，槲皮素显黄绿色荧光。"}]},{"ID":"20240902091324-jwva5v0","Type":"NodeParagraph","Properties":{"id":"20240902091324-jwva5v0","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【化学成份】含羟基三萜酸（hydroxytriterpenicacid）0．37％，其中有齐墩果酸（oleanolicacid），白桦脂酸（betulinicacid），熊果酸（ursoicacid）[1,2]和19α-羟基熊果酸（19α-hydroxyursolicacid）。其他有机酸有硬脂酸（stearicacid），棕榈酸（palmiticacid），琥珀酸（succinicacid），丁香酸（syringicacid），香草酸（vanillicacid），没食子酸（gallicacid）。此外，还有无羁萜（friedelin），β-谷甾醇，β-谷甾醇葡萄糖甙（β-sitosteryl-β-D-gluco-side），三叶豆甙（trifolin），金丝桃甙（hyperin），山柰酚（kaempfer-ol），槲皮素（quercetin）。又含葡萄糖，果糖，脂肪油等[3]，还含鞣质[4]。"}]},{"ID":"20240902091324-1ttlxfl","Type":"NodeParagraph","Properties":{"id":"20240902091324-1ttlxfl","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902091324-zlx549a","Type":"NodeParagraph","Properties":{"id":"20240902091324-zlx549a","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"1.抗心律失常作用0.5%柿蒂提取物(ST)50mg/kg腹腔注射于小鼠，能显着对抗氯仿诱发的室颤；亦能对抗乌头碱、氯化钡所致大鼠心律失常；ST12.5mg/(kg.天)腹腔注射，连续5天；能对抗哇巴因所致豚鼠室性心律失常。"}]},{"ID":"20240902091324-p42gmvw","Type":"NodeParagraph","Properties":{"id":"20240902091324-p42gmvw","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"2.镇静作用ST100mg/kg小鼠腹腔注射，使自发活动明显减少，增强阈下剂量戊巴比妥钠的催眠作用，延长其睡眠时间，并明显拮抗吗啡引起的小鼠竖尾反应。"}]},{"ID":"20240902091324-dvli6ua","Type":"NodeParagraph","Properties":{"id":"20240902091324-dvli6ua","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"3.抗生育作用在家免抗生育筛选中，初步证实柿蒂有一定的抗生育作用，柿蒂柄优于柿蒂蒂，柿蒂的柄的抗生育率为79.6%。"}]},{"ID":"20240902091324-vtk1tgq","Type":"NodeParagraph","Properties":{"id":"20240902091324-vtk1tgq","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【性味】苦；涩；性平"}]},{"ID":"20240902091324-mkz8qzg","Type":"NodeParagraph","Properties":{"id":"20240902091324-mkz8qzg","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【归经】胃经"}]},{"ID":"20240902091324-2ma4n90","Type":"NodeParagraph","Properties":{"id":"20240902091324-2ma4n90","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【功能主治】降逆下气。主呃逆；噫气；反胃"}]},{"ID":"20240902091324-1p5fmyf","Type":"NodeParagraph","Properties":{"id":"20240902091324-1p5fmyf","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5～10g；或人散剂。外用：适量，研末撤。"}]},{"ID":"20240902091324-uacb5ic","Type":"NodeParagraph","Properties":{"id":"20240902091324-uacb5ic","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【附方】①治呃逆：柿钱、丁香、人参等分。为细末，水煎，食后服。(《洁古家珍》柿钱散)②治呃逆不止：柿蒂(烧灰存性)为末。黄酒调服，或用姜汁、砂糖等分和匀，炖热徐服。(《村居救急方》)③治伤寒呕哕不止：干柿蒂七枚，白梅三枚。上二味，粗捣筛，只作一服，用水一盏，煎至半盏。去滓温服，不拘时。(《圣济总录》柿蒂汤)④治脑满咳逆不止：柿蒂、丁香各一两。上细切，每服四钱，水一盏半，姜五片，煎至七分。去滓热服，不拘时候。(《济生方》柿蒂汤)⑤治百日咳：柿蒂四钱(阴干)，乌梅核中之白仁十个(细切)加白糖三钱。用水二杯，煎至一杯。一日数回分服，连服数日。〔《江西中医药》(3)：20—22，1953]⑥治血淋：于柿蒂(烧灰存性)，为末。每服二钱，空心米钦调服。(《奇效良方》柿蒂散)"}]},{"ID":"20240902091324-1az4xgh","Type":"NodeParagraph","Properties":{"id":"20240902091324-1az4xgh","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902091324-fenk4fe","Type":"NodeParagraph","Properties":{"id":"20240902091324-fenk4fe","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"1.人之阴气，依胃为养。士伤则木挟相火，直冲清道而上作咳逆，古人以为胃寒，既用丁香、柿蒂，不知其孰为补虚、孰为降火，不能清气利痰，惟有助火而已。"}]},{"ID":"20240902091324-13im2zy","Type":"NodeParagraph","Properties":{"id":"20240902091324-13im2zy","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：咳逆者，气自脐下冲脉直上至咽膈，作呃忒、蹇逆之声也。朱肱《南阳书》以哕为咳逆，王履《溯洄集》以咳嗽为咳逆，皆误矣。哕者，干呕有声也。咳逆，有伤寒吐下后，及久病、产后、老人、虚人阴气大亏，阳气暴逆，自下焦逆至上焦，而不能出者；有伤寒失下，及平人痰气抑遏而然者。当钡其虚实阴阳，或温或补，或泄热，或降气，或吐或下可也。古方单用柿蒂煮汁钦之，取其苦温能降逆气也。《济生》柿蒂散加以丁香、生姜之李热，以开痰散郁，盖从治之法，而昔入亦常用之收效矣。至易水张氏，又益以人参，治病后虚人咳逆，亦有功绩。丹溪朱氏但执以寒治热之理，而不及从治之法，矫枉之过矣。若陈氏《三因》，又加以良姜之类，是真以为胃寒而助其邪火者也。"}]},{"ID":"20240902091324-0acciyy","Type":"NodeParagraph","Properties":{"id":"20240902091324-0acciyy","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：沈则施曰，撩丹溪翁谓入之阴气，依胃为养。土伤则木挟相火，直冲渭道而作咳逆，宜竹茹黄连柿蒂汤主之，此言热呃也。《济生》论谓阳竭于下，孤阴独存，阴气亦将旋脱，故逆上面作呃，宜丁附人参柿蒂汤主之，此言寒呃也。又按《准绳》论呃逆之证，有伤寒吐下后、久病、产后阴血大亏，阳气暴逆，自下逆上而作呃者，非大温中补中之剂不能治。又有平人饮食痰气抑遏，而气自脐下冲脉直上咽膈，而作呃忒蹇逆之声，用平胃二陈汤，加柿蒂数枚煎服，亦可止也。观于柿蒂之苦涩，但可以散逆气，而因寒、因热、固虚、因滞者，则佐以丁、黄、茹、连、参、术、平胃、二陈辈，当仔细斟酌，毋轻视也。"}]},{"ID":"20240902091324-9i9iwd3","Type":"NodeParagraph","Properties":{"id":"20240902091324-9i9iwd3","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：柿蒂，虽与丁香同为止呃之味，然一辛热而一营平，合用深得寒热兼济之妙。如系有寒无，则丁香在所必用，不得固执从治，必当佐以柿蒂。有热无寒，则柿蒂在所必需，不得泥以兼济之必杂以丁香。是以古人用药，有合数味而见效者，有单用一味而见效者，要使药与病对，不致悖谬而枉施耳。孟诜：治咳逆、哕气，煮汁服。"}]},{"ID":"20240902091324-s25w1ou","Type":"NodeParagraph","Properties":{"id":"20240902091324-s25w1ou","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：治气隔反胃。"}]},{"ID":"20240902091324-urfbqtz","Type":"NodeParagraph","Properties":{"id":"20240902091324-urfbqtz","updated":"20240902091345"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902091325-djfg1m3","Type":"NodeThematicBreak","Properties":{"id":"20240902091325-djfg1m3","updated":"20240902091345"}},{"ID":"20240902091326-4c4uf3e","Type":"NodeParagraph","Properties":{"id":"20240902091326-4c4uf3e","updated":"20240902091345"}}]}