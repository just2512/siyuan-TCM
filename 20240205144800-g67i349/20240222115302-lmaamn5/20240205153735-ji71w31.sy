eOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荔枝 4-20240724144338-jba2mkp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 799px;\" parent-style=\"width: 809px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724143509-4gxlk8r","Type":"NodeParagraph","Properties":{"id":"20240724143509-4gxlk8r","updated":"20240724144030"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 425px;","style":"width: 415px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荔枝 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荔枝 1-20240724143509-vsw3ocw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 775px;","style":"width: 765px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荔枝 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荔枝 2-20240724144030-1kd8yhy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 765px;\" parent-style=\"width: 775px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619185527-zje00yl","Type":"NodeThematicBreak","Properties":{"id":"20240619185527-zje00yl"}},{"ID":"20240902165135-kkqip8y","Type":"NodeParagraph","Properties":{"id":"20240902165135-kkqip8y","updated":"20240902165141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：荔枝核"}]},{"ID":"20240902165135-jb6ebx8","Type":"NodeParagraph","Properties":{"id":"20240902165135-jb6ebx8","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"荔枝核《中国药典》"}]},{"ID":"20240902165135-v5v3j30","Type":"NodeParagraph","Properties":{"id":"20240902165135-v5v3j30","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【拼音名】LìZhīHé"}]},{"ID":"20240902165135-n9uphov","Type":"NodeParagraph","Properties":{"id":"20240902165135-n9uphov","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENLITCHI"}]},{"ID":"20240902165135-1b56hpf","Type":"NodeParagraph","Properties":{"id":"20240902165135-1b56hpf","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【来源】本品为无患子科植物荔枝LitchichinensisSonn.的干燥成熟种子。夏季采摘成熟果实，除去果皮及肉质假种皮，洗净，晒干。"}]},{"ID":"20240902165135-bptggsl","Type":"NodeParagraph","Properties":{"id":"20240902165135-bptggsl","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈长圆形或卵圆形，略扁，长1.5～2.2cm，直径1～1.5cm。表面棕红色或紫棕色，平滑，有光泽，略有凹陷及细波纹。一端有类圆形黄棕色的种脐，直径约7mm。质硬，子叶2，棕黄色。气微，味微甘、苦、涩。"}]},{"ID":"20240902165135-kexszfp","Type":"NodeParagraph","Properties":{"id":"20240902165135-kexszfp","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末棕黄色，镶嵌层细胞黄棕色，呈长条形，由数个细胞为一组，作不规则方向嵌列。星状细胞淡棕色呈不规则星状分枝，分枝先端平截或稍钝圆，细胞间隙大，壁薄。石细胞成群或单个散在，呈类圆形、类方形、类多角形、长方形或长圆形，多有突起或分枝。子叶细胞呈类圆形或类圆多角形，充满淀粉粒，并可见棕色油细胞。"}]},{"ID":"20240902165135-yhc3gi3","Type":"NodeParagraph","Properties":{"id":"20240902165135-yhc3gi3","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902165135-nzwhndw","Type":"NodeParagraph","Properties":{"id":"20240902165135-nzwhndw","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"荔枝核：除去杂质，洗净，干燥。用时捣碎。"}]},{"ID":"20240902165135-v2oxfa5","Type":"NodeParagraph","Properties":{"id":"20240902165135-v2oxfa5","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"盐荔枝核：取净荔枝核，捣碎后照盐水炙法（附录ⅡD）炒干。"}]},{"ID":"20240902165135-jr3h8x3","Type":"NodeParagraph","Properties":{"id":"20240902165135-jr3h8x3","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微苦，温。"}]},{"ID":"20240902165135-bhslugs","Type":"NodeParagraph","Properties":{"id":"20240902165135-bhslugs","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾经。"}]},{"ID":"20240902165135-uyfwehk","Type":"NodeParagraph","Properties":{"id":"20240902165135-uyfwehk","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气散结，祛寒止痛。用于寒疝腹痛，睾丸肿痛。"}]},{"ID":"20240902165135-2mowbjg","Type":"NodeParagraph","Properties":{"id":"20240902165135-2mowbjg","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。"}]},{"ID":"20240902165135-eofimem","Type":"NodeParagraph","Properties":{"id":"20240902165135-eofimem","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防蛀。"}]},{"ID":"20240902165135-9owqmbh","Type":"NodeParagraph","Properties":{"id":"20240902165135-9owqmbh","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902165135-b29bhfk","Type":"NodeParagraph","Properties":{"id":"20240902165135-b29bhfk","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"荔枝核《*辞典》"}]},{"ID":"20240902165135-mikwf8c","Type":"NodeParagraph","Properties":{"id":"20240902165135-mikwf8c","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【出处】《本草衍义》"}]},{"ID":"20240902165135-kgotci9","Type":"NodeParagraph","Properties":{"id":"20240902165135-kgotci9","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【拼音名】LìZhīHé"}]},{"ID":"20240902165135-ht3qgh5","Type":"NodeParagraph","Properties":{"id":"20240902165135-ht3qgh5","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【别名】荔仁（《广西中药志》），枝核（《四川中药志》），大荔核（《药材学》）。"}]},{"ID":"20240902165135-gekbry9","Type":"NodeParagraph","Properties":{"id":"20240902165135-gekbry9","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【来源】为无患子科植物荔枝的种子。果实成熟时采收，除净皮肉，取种子，洗净晒干。"}]},{"ID":"20240902165135-iq13uis","Type":"NodeParagraph","Properties":{"id":"20240902165135-iq13uis","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产广东、广西。此外台湾、福建、四川亦产。"}]},{"ID":"20240902165135-ctlywdt","Type":"NodeParagraph","Properties":{"id":"20240902165135-ctlywdt","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性状】干燥种子呈长椭圆形，略扁，长2～2.5厘米；直径1～1.7厘米。表面棕红色或紫棕色，有光泽，一端有黄白色的种脐。质坚硬；剖开后有2片肥厚的子叶，灰黄色，质亦坚实。气微，味淡而涩。以干燥，粒大，饱满者为佳。"}]},{"ID":"20240902165135-7rj93py","Type":"NodeParagraph","Properties":{"id":"20240902165135-7rj93py","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含皂甙1.12％，鞣质3.43％。又含α-（亚甲环丙基）甘氨酸。如将此物给饥饿22小时的小鼠皮下注射（60～400毫克/公斤），可使血糖下降，肝糖元含量亦显着降低。"}]},{"ID":"20240902165135-uvw49yb","Type":"NodeParagraph","Properties":{"id":"20240902165135-uvw49yb","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902165135-znmht5d","Type":"NodeParagraph","Properties":{"id":"20240902165135-znmht5d","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"甘涩，温。"}]},{"ID":"20240902165135-qmtz5ih","Type":"NodeParagraph","Properties":{"id":"20240902165135-qmtz5ih","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"①《纲目》:\"甘，温，涩，无毒。\""}]},{"ID":"20240902165135-xplsod3","Type":"NodeParagraph","Properties":{"id":"20240902165135-xplsod3","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》:\"甘涩，温，微咸。\""}]},{"ID":"20240902165135-n7unvb0","Type":"NodeParagraph","Properties":{"id":"20240902165135-n7unvb0","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"③《广西中药志》:\"味甘微苦涩，性平，无毒。\""}]},{"ID":"20240902165135-e52mmyz","Type":"NodeParagraph","Properties":{"id":"20240902165135-e52mmyz","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902165135-5kyixdv","Type":"NodeParagraph","Properties":{"id":"20240902165135-5kyixdv","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"入肝、肾经。"}]},{"ID":"20240902165135-b5ctzz0","Type":"NodeParagraph","Properties":{"id":"20240902165135-b5ctzz0","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"①《纲目》:\"入厥阴。\""}]},{"ID":"20240902165135-mzf72yg","Type":"NodeParagraph","Properties":{"id":"20240902165135-mzf72yg","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》:\"入肝、肾。\""}]},{"ID":"20240902165135-h2l42wk","Type":"NodeParagraph","Properties":{"id":"20240902165135-h2l42wk","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》:\"入足太阴、厥阴经。\""}]},{"ID":"20240902165135-nyehm9f","Type":"NodeParagraph","Properties":{"id":"20240902165135-nyehm9f","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902165135-akqwwwk","Type":"NodeParagraph","Properties":{"id":"20240902165135-akqwwwk","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"温中，理气，止痛。治胃脘痛，疝气痛，妇女血气刺痛。"}]},{"ID":"20240902165135-y2koqjm","Type":"NodeParagraph","Properties":{"id":"20240902165135-y2koqjm","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"①《纲目》:\"行散滞气。治颓疝气痛，妇人血气刺痛。\""}]},{"ID":"20240902165135-wrffj7g","Type":"NodeParagraph","Properties":{"id":"20240902165135-wrffj7g","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"②《本草备要》:\"辟寒邪，治胃脘痛。\""}]},{"ID":"20240902165135-gv6ikti","Type":"NodeParagraph","Properties":{"id":"20240902165135-gv6ikti","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服:煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240902165135-nebzx61","Type":"NodeParagraph","Properties":{"id":"20240902165135-nebzx61","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【注意】《本草从新》:\"无寒湿滞气者勿服。\""}]},{"ID":"20240902165135-fnmbrga","Type":"NodeParagraph","Properties":{"id":"20240902165135-fnmbrga","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902165135-zt1s37a","Type":"NodeParagraph","Properties":{"id":"20240902165135-zt1s37a","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"①治心腹胃脘久痛，屡触屡发者:荔枝核一钱，木香八分。为末。每服一钱，清汤调服。（《景岳全书》荔香散）"}]},{"ID":"20240902165135-jpyjozv","Type":"NodeParagraph","Properties":{"id":"20240902165135-jpyjozv","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"②治心痛及小肠气:荔枝核一枚。煅存性，酒调服。（《本草衍义》）"}]},{"ID":"20240902165135-j279oct","Type":"NodeParagraph","Properties":{"id":"20240902165135-j279oct","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"③治肾大如斗:舶上茴香、青皮（全者）、荔枝核等分。锉散，炒，出火毒，为末。酒下二钱，日三服。（《世医得效方》荔核散）"}]},{"ID":"20240902165135-qsl4s6t","Type":"NodeParagraph","Properties":{"id":"20240902165135-qsl4s6t","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"④治疝气颓肿:荔枝核四十九个，陈皮（连白）九钱，硫黄四钱。为末，盐水打面糊丸绿豆大。遇痛时，空心酒服九丸，良久再服，亦治诸气痛。（《坦仙皆效方》玉环来复丹）"}]},{"ID":"20240902165135-qscghyi","Type":"NodeParagraph","Properties":{"id":"20240902165135-qscghyi","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"⑤治血气刺痛:荔枝核（烧存性）半两，香附子一两。上为末。每服二钱，盐酒送下。（《妇人良方》蠲痛散）"}]},{"ID":"20240902165135-81pgtzo","Type":"NodeParagraph","Properties":{"id":"20240902165135-81pgtzo","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"⑥治肋间神经痛：荔枝核烧炭存性捣碎，取6克，加广木香6克，水煎服。"}]},{"ID":"20240902165135-6ego4ff","Type":"NodeParagraph","Properties":{"id":"20240902165135-6ego4ff","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"⑦治疝气疼痛：㈠荔枝核15克，焙干研末，空腹时用开水送服。㈡炒荔枝核、大茴香各60克，研末，每日早晨用黄酒送服10克，亦治疝气疼痛。"}]},{"ID":"20240902165135-ftztil7","Type":"NodeParagraph","Properties":{"id":"20240902165135-ftztil7","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"⑧治癣：荔枝核研末，调醋搽患处。"}]},{"ID":"20240902165135-rizn81k","Type":"NodeParagraph","Properties":{"id":"20240902165135-rizn81k","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902165135-2w5sbg3","Type":"NodeParagraph","Properties":{"id":"20240902165135-2w5sbg3","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"荔枝核《中华本草》"}]},{"ID":"20240902165135-vi9q520","Type":"NodeParagraph","Properties":{"id":"20240902165135-vi9q520","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草衍义》"}]},{"ID":"20240902165135-d8u8bx7","Type":"NodeParagraph","Properties":{"id":"20240902165135-d8u8bx7","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【拼音名】LìZhīHé"}]},{"ID":"20240902165135-l1ujxtx","Type":"NodeParagraph","Properties":{"id":"20240902165135-l1ujxtx","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【英文名】LycheeSeed"}]},{"ID":"20240902165135-e3cwfmh","Type":"NodeParagraph","Properties":{"id":"20240902165135-e3cwfmh","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【别名】荔仁、枝核、荔核、大荔核。"}]},{"ID":"20240902165135-2j86wx3","Type":"NodeParagraph","Properties":{"id":"20240902165135-2j86wx3","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902165135-q7nnmi1","Type":"NodeParagraph","Properties":{"id":"20240902165135-q7nnmi1","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"药材基源：为无患子科植物荔枝LitchichinensisSonn.的种子。"}]},{"ID":"20240902165135-urw1aj4","Type":"NodeParagraph","Properties":{"id":"20240902165135-urw1aj4","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：LitchichinenesisSonn."}]},{"ID":"20240902165135-2za2qpf","Type":"NodeParagraph","Properties":{"id":"20240902165135-2za2qpf","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-7月果实成熟时采摘，食荔枝肉（假种皮）后收集种子，洗净，晒干。"}]},{"ID":"20240902165135-b44x3zv","Type":"NodeParagraph","Properties":{"id":"20240902165135-b44x3zv","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【原形态】荔枝常绿乔木，高10-15m。偶数羽状复叶，互生，叶连柄长10-25cm，或过之；小叶2或3对，少4对，小叶柄长7-8mm，叶片披针形或卵状披针形，长6-15cm，宽2-4cm，先端骤尖或尾状短渐尖，全缘，无毛，薄革质或革质。圆锥花序顶生，阔大，多分枝；花草性，雌雄同株；萼浅杯状，深5裂，被金黄色短绒毛；花瓣5，基部内侧有阔而生厚毛的鳞片；雄蕊6-7，有时8，花丝长约4mm；子房密被小瘤体和硬毛。果卵圆形至近球形，长2-35cm，成熟时通常暗红色至鲜红色。种子全部被肉质假种皮包裹。花期春季，果期夏季。"}]},{"ID":"20240902165135-5724fao","Type":"NodeParagraph","Properties":{"id":"20240902165135-5724fao","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【生境分布】分布于华南和西南等地，尤以广东和福建南部、台湾、栽培最盛。"}]},{"ID":"20240902165135-y016lzi","Type":"NodeParagraph","Properties":{"id":"20240902165135-y016lzi","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902165135-oj06d1u","Type":"NodeParagraph","Properties":{"id":"20240902165135-oj06d1u","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"性状鉴别种子长圆形或长卵形，稍扁，长1.5-2.5cm。直径0.5-1.5cm。表面棕色至棕红色，稍具光泽，有不规则凹隙和细皱纹；一端平截，有近圆形黄棕色的种脐，直径5-7mm，另一端圆钝。质坚硬，剖开后种皮薄革质而脆；有2片肥厚子叶，橙黄色或棕黄色。气微，味微甘、苦、涩。以粒大、饱满者为佳。"}]},{"ID":"20240902165135-iycezmu","Type":"NodeParagraph","Properties":{"id":"20240902165135-iycezmu","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"显微鉴另粉末特征：淡棕色。①种皮外表皮细胞黄棕色或红棕色。侧面观细胞1列，栅状，长34-59μm，宽10-17μm，壁增厚，非木化，外被角质层；表面观多角形，垂周壁不均匀增厚。②石细胞类圆形、类多角形，多数有突起或分枝，分枝先端平截，细胞直径17-34μm，壁厚3-10μm，纹孔及孔沟较稀疏，层纹不甚明显。③星状细胞为种皮通气组织，呈不规则星状分枝，细胞间隙大，壁薄，无孔沟。④镶嵌层细胞徽黄绿色或淡黄色。呈长条形，长17-46μm，直径3-8μm，壁薄，微木化，由数个细胞为一组，以其长轴作不规则方向嵌列。⑤子叶细胞类圆形或类圆状多角形，直径22-51μm，充满淀粉粒，淀粉粒溶化后留有类圆形痕迹。有的细胞含黄绿色或黄棕色油状物。⑥淀粉粒单粒类球形、卵圆形，少数一端尖或两端尖，直径3.5-18μm，长至23μm，脐点点状、三叉状或裂缝状，层纹不明显；复粒较少，2-4分粒组成；半复粒少，脐点2-3个。"}]},{"ID":"20240902165135-shv9py2","Type":"NodeParagraph","Properties":{"id":"20240902165135-shv9py2","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含皂甙（1.12％），鞣质（3.43％）和a-亚甲基环丙基甘氨酸[a-（methylenecycyclopropyl）glycine]。并分离出微量的挥发油，其中含3-羟基丁酮（3-acetoin），2，3-丁二醇（2，3-butanediol），咕（王巴）烯（copaene），顺-丁香烯（cis-caryophyllene），别香橙烯（allo-aromadendrene），葎草烯（humulene），δ-毕澄茄烯（δ-cadinene），a-姜黄烯（a-curcumene），菖蒲烯（calamenene），喇叭茶醇（ledol），愈创木薁（guaiazulene），黄根醇（xanthorrhizol）和棕榈酸（palmiticacid）等。"}]},{"ID":"20240902165135-on4s1ig","Type":"NodeParagraph","Properties":{"id":"20240902165135-on4s1ig","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【药理作用】将此物给饥饿22小时的小鼠皮下注射（60-400mg/kg），可使血糖下降，肝糖元含量亦显着降低。降血糖：荔枝核干浸膏1.3、2.6mg/kg给四氧嘧啶糖尿病大鼠灌胃，连续30天，每10天测血糖一次，均表明用蕴含组血糖低于对照组。所含-次甲基环丙基甘氨酸给小鼠皮下注射230-400mg/kg，可使血糖从正常的71-103mg/100ml降至35-57mg/100ml。A-亚甲环丙基甘氨酸给小鼠皮下注射230-400mg/kg，可使血糖从正常的71-103mg/100ml降至57-35mg/100ml。还能对抗鼠伤寒沙门氏菌的诱变作用。"}]},{"ID":"20240902165135-u09gfyi","Type":"NodeParagraph","Properties":{"id":"20240902165135-u09gfyi","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【毒性】荔枝核急性毒性甚低，以20g/kg的剂量给小鼠灌胃，服药后3天内无一死亡。"}]},{"ID":"20240902165135-b0sz0vk","Type":"NodeParagraph","Properties":{"id":"20240902165135-b0sz0vk","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粉末0.5g，加水4ml，微热，滤过，取滤液1ml，加三氯化铁试液1滴，呈蓝绿色反应。（检查鞣质）（2）取本品粉末进行泡沫试验及溶血试验，均呈阴性。"}]},{"ID":"20240902165135-2dq0shq","Type":"NodeParagraph","Properties":{"id":"20240902165135-2dq0shq","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【性味】甘；微苦；性温"}]},{"ID":"20240902165135-88t5el1","Type":"NodeParagraph","Properties":{"id":"20240902165135-88t5el1","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾；脾经"}]},{"ID":"20240902165135-q6o6416","Type":"NodeParagraph","Properties":{"id":"20240902165135-q6o6416","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【功能主治】理气止痛；祛寒散滞。主疝气痛；睾丸肿痛；胃脘痛；痛经及产后腹痛"}]},{"ID":"20240902165135-6l0dv5b","Type":"NodeParagraph","Properties":{"id":"20240902165135-6l0dv5b","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-10g；研末，1.5-3g；或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240902165135-pqga17w","Type":"NodeParagraph","Properties":{"id":"20240902165135-pqga17w","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【注意】《本草从新》：无寒湿滞气者勿服。"}]},{"ID":"20240902165135-cd8aass","Type":"NodeParagraph","Properties":{"id":"20240902165135-cd8aass","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【附方】①治心腹胃脘久痛，屡触屡发者：荔枝核一钱，木香八分。为末。每服一钱，清汤调服。(《景岳全书》荔香散)②治心痛及小肠气：荔枝核一枚。煅存性，酒调服，(《本草衍义》)③治肾大如斗：舶上茴香、青皮(全者)、荔枝核等分。锉散，炒，出火毒，为末。酒下二钱，日三服。(《世医得效方》荔核散)④治疝气TUI肿：荔枝核四十九个，陈皮(连白)九钱，硫黄四钱，为末，盐水打面湖丸绿豆大。遇痛时，空心酒服九丸，良久再服，亦治诸气痛。(《坦仙皆效方》玉环来复丹)⑤治血气刺痛：荔枝核(烧存性)半两，香附子一两。上为末。每服二钱，盐酒送下。(《妇人良方》蠲痛散)"}]},{"ID":"20240902165135-3kwamy7","Type":"NodeParagraph","Properties":{"id":"20240902165135-3kwamy7","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902165135-6pwj6pq","Type":"NodeParagraph","Properties":{"id":"20240902165135-6pwj6pq","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：行散滞气。治TUI疝气痛，妇人血气刺痛。"}]},{"ID":"20240902165135-gk5gfzi","Type":"NodeParagraph","Properties":{"id":"20240902165135-gk5gfzi","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"2.《本草备要》：辟寒邪，治胃脘痛。"}]},{"ID":"20240902165135-fozlnys","Type":"NodeParagraph","Properties":{"id":"20240902165135-fozlnys","updated":"20240902165144"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902165136-wm8nsue","Type":"NodeThematicBreak","Properties":{"id":"20240902165136-wm8nsue","updated":"20240902165144"}},{"ID":"20240902165137-4xa9em5","Type":"NodeParagraph","Properties":{"id":"20240902165137-4xa9em5","updated":"20240902165144"}}]}