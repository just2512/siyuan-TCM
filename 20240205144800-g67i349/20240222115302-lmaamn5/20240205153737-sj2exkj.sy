et"},{"Type":"NodeLinkText","Data":"沉香 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 10-20240716082528-14jdujb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 486px;\" parent-style=\"width: 496px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716091646-mbk4y0l","Type":"NodeParagraph","Properties":{"id":"20240716091646-mbk4y0l","updated":"20240716091758"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 618px;","style":"width: 608px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 24-20240716091646-zzbk1vo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 608px;\" parent-style=\"width: 618px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 617px;","style":"width: 607px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 25-20240716091758-mujt1cm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 607px;\" parent-style=\"width: 617px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716082634-la904f3","Type":"NodeParagraph","Properties":{"id":"20240716082634-la904f3","updated":"20240716082732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 11-20240716082634-c96aiea.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 630px;","style":"width: 620px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 12-20240716082732-61b06gf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 620px;\" parent-style=\"width: 630px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240716082847-l2mluce","Type":"NodeParagraph","Properties":{"id":"20240716082847-l2mluce","updated":"20240716092330"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 433px;","style":"width: 423px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 13-20240716082847-lypxwqo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 423px;\" parent-style=\"width: 433px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 856px;","style":"width: 846px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"沉香 (26)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/沉香 26-20240716092135-h54s3yw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 846px;\" parent-style=\"width: 856px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716093042-2vr6si7","Type":"NodeParagraph","Properties":{"id":"20240716093042-2vr6si7","updated":"20240716093042"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：沉香是沉香树结出来的油脂和木质的混合物，详细点来说沉香是沉香树经过动物的啃咬，比如蚂蚁虫蛇侵蚀或者是自然界雷击、风折、虫蛀以后，自我修复过程中分泌出来的一种油脂；还有一种是以上原因开放了伤口受到了真菌的入侵感染，菌体和各种酶类交叉作用，让木薄壁细胞里面的淀粉产生了变化，形成了一层油脂来保护受伤的位置，当累积的树脂达到了一定的浓度，沉香就形成了；天然的沉香一般要十年以上才有比较发达的树脂腺来形成沉香；"}]},{"ID":"20240716084813-cu6z14c","Type":"NodeParagraph","Properties":{"id":"20240716084813-cu6z14c","updated":"20240716093047"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：沉香不是木头，而是有特殊香味某类树的总称，所以有木纹、年轮的沉香都不是真正的沉香；（沉香上黑色的一丝一丝的东西，那是沉香油脂层在断面上表现出来的油脂线）（沉香是沉香树在受伤时，分泌出来树本身的油脂和当地真菌产生作用以后结出的‘香’）（简单说沉香是树受伤后分泌出的汁液，凝结为油脂的那部分）"}]},{"ID":"20240716092522-gupfyda","Type":"NodeParagraph","Properties":{"id":"20240716092522-gupfyda","updated":"20240716094228"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：沉香有一种名为奇楠的极品，奇楠是沉香被蚂蚁或野蜂入侵筑巢，长期汲取了蜜蜂、蚂蚁的蜜乳、蚁酸、甘露以及野蜂的石蜜、蜂浆等物质，与沉香的油脂相互混合，在一种极其特殊的真菌作用下，两种物质两相濡染，历久醇化，最后形成了奇楠；简单来说沉香只要有一定外因，就一定可以结香，但奇楠能够生成，需要一定的造化；"}]},{"ID":"20240716083250-7fcnndu","Type":"NodeThematicBreak","Properties":{"id":"20240716083250-7fcnndu"}},{"ID":"20240902095634-jxh3rth","Type":"NodeParagraph","Properties":{"id":"20240902095634-jxh3rth","updated":"20240902095643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：沉香"}]},{"ID":"20240902095634-1oq0ez1","Type":"NodeParagraph","Properties":{"id":"20240902095634-1oq0ez1","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"沉香《全国中草药汇编》"}]},{"ID":"20240902095634-bjle069","Type":"NodeParagraph","Properties":{"id":"20240902095634-bjle069","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChénXiānɡ"}]},{"ID":"20240902095634-wjd1d4q","Type":"NodeParagraph","Properties":{"id":"20240902095634-wjd1d4q","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【英文名】LIGNUMAQUILARIAERESINATUM"}]},{"ID":"20240902095634-25qbprs","Type":"NodeParagraph","Properties":{"id":"20240902095634-25qbprs","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【别名】土沉香、白木香、芫香、六麻树、女儿香、芽香树"}]},{"ID":"20240902095634-31eo92g","Type":"NodeParagraph","Properties":{"id":"20240902095634-31eo92g","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【来源】本品为瑞香科植物白木香Aquilariasinensis（Lour.）Gilg含有树脂的木材。全年均可采收，割取含树脂的木材，除去不含树脂的部分，阴干。"}]},{"ID":"20240902095634-rosvxe4","Type":"NodeParagraph","Properties":{"id":"20240902095634-rosvxe4","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高可达20米。根和茎有香气。树皮及枝灰褐色，外皮质薄而致密易剥落，小枝被柔毛。单叶互生，具柄；叶片椭圆形或卵形。春末夏初开黄绿色花，数朵排成顶生或腋生伞形花序。"}]},{"ID":"20240902095634-gqyg4w0","Type":"NodeParagraph","Properties":{"id":"20240902095634-gqyg4w0","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则块、片状或盔帽状，有的为小碎块。表面凹凸不平，有刀痕，偶有孔洞，可见黑褐色树脂与黄白色木部相间的斑纹，孔洞及凹窝表面多呈朽木状。质较坚实，断面刺状。气芳香，味苦。"}]},{"ID":"20240902095634-37xfnqf","Type":"NodeParagraph","Properties":{"id":"20240902095634-37xfnqf","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902095634-18ovo5s","Type":"NodeParagraph","Properties":{"id":"20240902095634-18ovo5s","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：射线宽1～2列细胞，充满棕色树脂。导管圆多角形，直径42～128μm，有的含棕色树脂。木纤维多角形，直径20～45μm,壁稍厚，木化。木间韧皮部扁长椭圆状或条带状，常与射线相交，细胞壁薄，非木化，内含棕色树脂；其间散有少数纤维，有的薄壁细胞含草酸钙柱晶。"}]},{"ID":"20240902095634-brj1pjd","Type":"NodeParagraph","Properties":{"id":"20240902095634-brj1pjd","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"（2）取[浸出物]项下醇溶性浸出物，进行微量升华，得黄褐色油状物，香气浓郁；于油状物上加盐酸1滴与香草醛少量，再滴加乙醇1～2滴，渐显樱红色，放置后颜色加深。"}]},{"ID":"20240902095634-yfnvdkn","Type":"NodeParagraph","Properties":{"id":"20240902095634-yfnvdkn","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【炮制】选择树干直径30厘米以上的小树，用刀在树干上顺砍数刀，伤口深3～4厘米，为菌类所感染，数年后，在伤口处如有黑色沉淀物就是中药的“沉香”。取下沉香晒干后，用刀挖去粘附在其上面的白色木片即成。"}]},{"ID":"20240902095634-we8medo","Type":"NodeParagraph","Properties":{"id":"20240902095634-we8medo","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，微温。"}]},{"ID":"20240902095634-7589evt","Type":"NodeParagraph","Properties":{"id":"20240902095634-7589evt","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、肾经。"}]},{"ID":"20240902095634-k53h3l1","Type":"NodeParagraph","Properties":{"id":"20240902095634-k53h3l1","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气止痛，温中止呕，纳气平喘。用于胸腹胀闷疼痛，胃寒呕吐呃逆，肾虚气逆喘急。"}]},{"ID":"20240902095634-ojm3qlw","Type":"NodeParagraph","Properties":{"id":"20240902095634-ojm3qlw","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【用法用量】1.5～4.5g，入煎剂宜后下。"}]},{"ID":"20240902095634-dnl1exb","Type":"NodeParagraph","Properties":{"id":"20240902095634-dnl1exb","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【贮藏】密闭，置阴凉干燥处。"}]},{"ID":"20240902095634-9fgeuo4","Type":"NodeParagraph","Properties":{"id":"20240902095634-9fgeuo4","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902095634-d809o3o","Type":"NodeParagraph","Properties":{"id":"20240902095634-d809o3o","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"沉香《*辞典》"}]},{"ID":"20240902095634-7jkuzn5","Type":"NodeParagraph","Properties":{"id":"20240902095634-7jkuzn5","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902095634-k5gpi4e","Type":"NodeParagraph","Properties":{"id":"20240902095634-k5gpi4e","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChénXiānɡ"}]},{"ID":"20240902095634-pqb4cyt","Type":"NodeParagraph","Properties":{"id":"20240902095634-pqb4cyt","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【别名】蜜香（《南方草木状》），沉水香（《桂海虞衡志》）。"}]},{"ID":"20240902095634-zh9t4s1","Type":"NodeParagraph","Properties":{"id":"20240902095634-zh9t4s1","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【来源】为瑞香科植物沉香或白木香的含有树脂的木材。国产沉香的采集：选择树干直径30厘米以上的大树，在距地面1.5～2米处的树干上，用刀顺砍数刀，深约3～4厘米，待其分泌树脂，经数年后，即可割取沉香。割取时造成的新伤口，仍可继续生成沉香。又法：在距离地面约1米处的树干上，凿成深3～6厘米，直径约3～10厘米的数个小口（俗称\"开香门\"），然后用泥土封好，待伤口附近的木质部分泌树脂，数年后生成沉香，即可割取。又枯死的白木香树，有时亦可觅得沉香，此香因年代较久，含脂量高，品质较好，但产量不多。采得沉香后，再用小刀剔除不含树脂的部分，晒干后即为成品。须贮藏于密闭的容器内，置阴凉干燥处，防止走油、干枯。"}]},{"ID":"20240902095634-7ul13fe","Type":"NodeParagraph","Properties":{"id":"20240902095634-7ul13fe","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902095634-ctegyco","Type":"NodeParagraph","Properties":{"id":"20240902095634-ctegyco","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①沉香"}]},{"ID":"20240902095634-57a3nee","Type":"NodeParagraph","Properties":{"id":"20240902095634-57a3nee","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高达30米。幼枝被绢状毛。叶互生，稍带革质，椭圆披针形、披针形或倒披针形，长5.5～9厘米，先端渐尖，全缘，下面叶脉有时被亚绢状毛；具短柄，长约3毫米。伞形花序；无梗，或有短的总花梗，被绢状毛；花白色，与小花梗等长或较短；花被钟形，5裂，裂片卵形，长0.7～1厘米，喉部密被白色绒毛的鳞片10枚，外被绢状毛，内密被长柔毛，花冠管与花被裂片略等长；雄蕊10，着生于花被管上，其中有5枚较长；子房上位，长卵形，密被柔毛，2室，花柱极短，柱头大，扁球形。蒴果倒卵形，木质，扁压状，长4.6～5.2厘米，密被灰白色绒毛，基部有略为木质的宿存花被。种子通常1枚，卵圆形，基部具有角状附属物，长约为种子的2倍。花期3～4月。果期5～6月。"}]},{"ID":"20240902095634-rp5mwzg","Type":"NodeParagraph","Properties":{"id":"20240902095634-rp5mwzg","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"野生或栽培于热带地区。我国台湾、广东、广西有栽培；国外分布印度、印度尼西亚、越南、马来西亚。"}]},{"ID":"20240902095634-zl4b48z","Type":"NodeParagraph","Properties":{"id":"20240902095634-zl4b48z","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②白木香（《南越笔记》），又名：土沉香（《桂海虞衡志》），女儿香（《纲目拾遗》），牙香树、莞香、六麻树。"}]},{"ID":"20240902095634-ou0xq03","Type":"NodeParagraph","Properties":{"id":"20240902095634-ou0xq03","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"常绿乔木。树皮灰褐色，小枝和花序被柔毛。叶互生，革质，长卵形、倒卵形或椭圆形，长6～12厘米，宽2～4.5厘米，先端渐尖而钝，基部楔形，全缘，两面被疏毛，后渐脱落，光滑而亮；叶柄长约5毫米，被柔毛。伞形花序顶生和腋生；总花梗被灰白色绒毛，小花梗长0.5～1.2厘米，被灰白色绒毛；花黄绿色，被绒毛；花被钟形，5裂，矩圆形，长约7毫米，宽约4毫米，先端钝圆，花被管喉部有鳞片10枚，密被白色绒毛，长约5毫米，基部连合成一环；雄蕊10，花丝粗壮；子房卵形，密被绒毛。蒴果倒卵形，木质，扁压状，长2.5～3厘米，密被灰白色毛，基部具稍带木质的宿存花被。种子棕黑色，卵形，长约1厘米，先端渐尖，种子基部延长为角状附属物，红棕色，长达2厘米，上部扩大。花期3～5月。果期5～6月。"}]},{"ID":"20240902095634-ofpur5a","Type":"NodeParagraph","Properties":{"id":"20240902095634-ofpur5a","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"生于平地、丘陵的疏林或荒山中，有少量栽培。分布广东、广西、台湾。"}]},{"ID":"20240902095634-tung8wj","Type":"NodeParagraph","Properties":{"id":"20240902095634-tung8wj","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902095634-yr8849o","Type":"NodeParagraph","Properties":{"id":"20240902095634-yr8849o","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①进口沉香"}]},{"ID":"20240902095634-b16u4gj","Type":"NodeParagraph","Properties":{"id":"20240902095634-b16u4gj","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"为植物沉香的含有树脂的木材，多呈盔帽形、棒状或片状，外形极不规则，长7～20厘米，直径1.5～6厘米。表面褐色，常有黑色与黄色交错的纹理，平滑光润。质坚实，沉重，难折断，用刀劈开，破开面呈灰褐色。能沉于水或半沉半浮。有特殊香气，味苦。燃烧时有油渗出，香气浓烈。"}]},{"ID":"20240902095634-xpr4byl","Type":"NodeParagraph","Properties":{"id":"20240902095634-xpr4byl","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"主产印度、马来西亚等地。"}]},{"ID":"20240902095634-y76cyto","Type":"NodeParagraph","Properties":{"id":"20240902095634-y76cyto","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②国产沉香"}]},{"ID":"20240902095634-e8vr3gx","Type":"NodeParagraph","Properties":{"id":"20240902095634-e8vr3gx","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"又名：海南沉香。为植物白木香的含有树脂的木材，多呈不规则块状或片状，长3～15厘米，直径3～6厘米。表面凹凸不平，有加工的刀痕。可见黑褐色的含树脂部分与黄色的木部相间，形成斑纹。其孔洞及凹窝的表面呈朽木状。质较轻，折断面刺状，棕色。大多不能沉水。有特殊香气，味苦。燃烧时有油渗出，发浓烟，香气浓烈。"}]},{"ID":"20240902095634-g4dtaiq","Type":"NodeParagraph","Properties":{"id":"20240902095634-g4dtaiq","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"主产海南。广西亦产。"}]},{"ID":"20240902095634-snuv3kd","Type":"NodeParagraph","Properties":{"id":"20240902095634-snuv3kd","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"沉香中油性足、体质重而性糯者，经精选加工后即为伽喃香，参见\"伽喃香\"条。"}]},{"ID":"20240902095634-gk9h836","Type":"NodeParagraph","Properties":{"id":"20240902095634-gk9h836","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【化学成份】沉香的丙酮提取物（40～50％）经皂化后蒸馏，得挥发油13％，中含苄基丙酮、对甲氧基苄基丙酮等，残渣中有氢化桂皮酸、对甲氧基氢化桂皮酸等。霉菌感染的沉香含沉香螺醇、沉香醇、二氢沉香呋喃、4-羟基二氢沉香呋喃、3，4-二羟基二氢沉香呋喃、去甲沉香呋喃酮；未感染的含硫、芹子烷、沉香醇等。"}]},{"ID":"20240902095634-gh3u8jc","Type":"NodeParagraph","Properties":{"id":"20240902095634-gh3u8jc","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【炮制】刷净，劈成小块，用时捣碎或研成细粉。"}]},{"ID":"20240902095634-o7u2t8a","Type":"NodeParagraph","Properties":{"id":"20240902095634-o7u2t8a","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902095634-tfl3kd9","Type":"NodeParagraph","Properties":{"id":"20240902095634-tfl3kd9","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"辛苦，温。"}]},{"ID":"20240902095634-gc0w82s","Type":"NodeParagraph","Properties":{"id":"20240902095634-gc0w82s","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"微温。\""}]},{"ID":"20240902095634-2h6h847","Type":"NodeParagraph","Properties":{"id":"20240902095634-2h6h847","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"味苦，温，无毒。\""}]},{"ID":"20240902095634-fdy4twv","Type":"NodeParagraph","Properties":{"id":"20240902095634-fdy4twv","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"味辛，热，无毒。\""}]},{"ID":"20240902095634-4jxr4ro","Type":"NodeParagraph","Properties":{"id":"20240902095634-4jxr4ro","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"咀嚼香甜者性平，辛辣者性热。\""}]},{"ID":"20240902095634-zhgi1bs","Type":"NodeParagraph","Properties":{"id":"20240902095634-zhgi1bs","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902095634-895llst","Type":"NodeParagraph","Properties":{"id":"20240902095634-895llst","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"入肾、脾、胃经。"}]},{"ID":"20240902095634-7cpfcil","Type":"NodeParagraph","Properties":{"id":"20240902095634-7cpfcil","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"肾、命门二经。\""}]},{"ID":"20240902095634-blex0u7","Type":"NodeParagraph","Properties":{"id":"20240902095634-blex0u7","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足阳明、太阴、少阴，兼入手少阴、足厥阴经。\""}]},{"ID":"20240902095634-raxpi1v","Type":"NodeParagraph","Properties":{"id":"20240902095634-raxpi1v","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入肺、肾二经。\""}]},{"ID":"20240902095634-r81lvs7","Type":"NodeParagraph","Properties":{"id":"20240902095634-r81lvs7","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④《本草经解》：\"足少阳胆经、足厥阴肝经、手太阴肺经。\""}]},{"ID":"20240902095634-vrt9dk5","Type":"NodeParagraph","Properties":{"id":"20240902095634-vrt9dk5","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902095634-f9ms7zn","Type":"NodeParagraph","Properties":{"id":"20240902095634-f9ms7zn","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"降气温中，暖肾纳气。治气逆喘息，呕吐呃逆，脘腹胀痛，腰膝虚冷，大肠虚秘，小便气淋，男子精冷。"}]},{"ID":"20240902095634-1ddyyx9","Type":"NodeParagraph","Properties":{"id":"20240902095634-1ddyyx9","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"疗风水毒肿，去恶气。\""}]},{"ID":"20240902095634-s4jista","Type":"NodeParagraph","Properties":{"id":"20240902095634-s4jista","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"疗恶核毒肿。\""}]},{"ID":"20240902095634-6g1rvm9","Type":"NodeParagraph","Properties":{"id":"20240902095634-6g1rvm9","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③《海药本草》：\"主心腹痛、霍乱、中恶，清神，并宜酒煮服之；诸疮肿宜入膏用。\""}]},{"ID":"20240902095634-cufcwok","Type":"NodeParagraph","Properties":{"id":"20240902095634-cufcwok","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"调中，补五脏，益精壮阳，暖腰膝，去邪气。止转筋、吐泻、冷气，破症癖，（治）冷风麻痹，骨节不任，湿风皮肤痒，心腹痛，气痢。\""}]},{"ID":"20240902095634-n1kp9ho","Type":"NodeParagraph","Properties":{"id":"20240902095634-n1kp9ho","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"补肾，又能去恶气，调中。\""}]},{"ID":"20240902095634-4cy1gbd","Type":"NodeParagraph","Properties":{"id":"20240902095634-4cy1gbd","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治上热下寒，气逆喘息，大肠虚闭，小便气淋，男子精冷。\""}]},{"ID":"20240902095634-rfb1frx","Type":"NodeParagraph","Properties":{"id":"20240902095634-rfb1frx","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"坚肾，补命门，温中、燥脾湿，泻心、降逆气，凡一切不调之气皆能调之。并治噤口毒痢及邪恶冷风寒痹。\""}]},{"ID":"20240902095634-vmif35r","Type":"NodeParagraph","Properties":{"id":"20240902095634-vmif35r","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑧《本草再新》：\"治肝郁，降肝气，和脾胃，消湿气，利水开窍。\""}]},{"ID":"20240902095634-wrk2ele","Type":"NodeParagraph","Properties":{"id":"20240902095634-wrk2ele","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.5～1钱；磨汁或入丸、散。"}]},{"ID":"20240902095634-e1gsjbx","Type":"NodeParagraph","Properties":{"id":"20240902095634-e1gsjbx","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902095634-g62fhus","Type":"NodeParagraph","Properties":{"id":"20240902095634-g62fhus","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"阴亏火旺，气虚下陷者慎服。"}]},{"ID":"20240902095634-gfuryvb","Type":"NodeParagraph","Properties":{"id":"20240902095634-gfuryvb","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"中气虚，气不归元者忌之；心经有实邪者忌之；非命门真火衰者，不宜入下焦药用。\""}]},{"ID":"20240902095634-hfw2roe","Type":"NodeParagraph","Properties":{"id":"20240902095634-hfw2roe","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"阴虚气逆上者切忌。\""}]},{"ID":"20240902095634-7aamwb5","Type":"NodeParagraph","Properties":{"id":"20240902095634-7aamwb5","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"气虚下陷人，不可多服。\""}]},{"ID":"20240902095634-876b3fm","Type":"NodeParagraph","Properties":{"id":"20240902095634-876b3fm","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④《本草从新》：\"阴亏火旺者，切勿沾唇。\""}]},{"ID":"20240902095634-ssybihf","Type":"NodeParagraph","Properties":{"id":"20240902095634-ssybihf","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902095634-2ynl0lz","Type":"NodeParagraph","Properties":{"id":"20240902095634-2ynl0lz","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①治胸膈痞塞，心腹胀满，喘促短气，干哕烦满，脚气上冲：香附（炒，去毛）四百两，沉香十八两半，缩砂仁四十八两，甘草（爁）一百二十两。上为细末。每服一钱，入盐少许，沸汤点服，空心食。（《局方》沉香降气丸）"}]},{"ID":"20240902095634-95rk6di","Type":"NodeParagraph","Properties":{"id":"20240902095634-95rk6di","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②治阴虚肾气不归原：沉香磨汁数分，以麦门冬、怀熟地各三钱，茯苓、山药、山茱萸肉务二钱，牡丹皮、泽泻、广陈皮各一钱。水煎，和沉香汁服。（《本草汇言》）"}]},{"ID":"20240902095634-babjml4","Type":"NodeParagraph","Properties":{"id":"20240902095634-babjml4","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③治脾肾久虚，水饮停积，上乘肺经，咳嗽短气，腹胁胀，小便不利：沉香一钱，乌药三钱，茯苓、陈皮、泽泻、香附子各半两，麝香半钱。上为细末，炼蜜和丸如梧子大。每服二、三十丸，熟水下。（《鸡峰普济方》沉香丸）"}]},{"ID":"20240902095634-kbivn93","Type":"NodeParagraph","Properties":{"id":"20240902095634-kbivn93","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④治七情伤感，上气喘息，妨闷不食：人参、槟梅、沉香、天台乌药，上各浓磨，水和作七分盏，煎三、五沸，放温服。或下养正丹尤佳。（《济生方》四磨汤）"}]},{"ID":"20240902095634-yunlcme","Type":"NodeParagraph","Properties":{"id":"20240902095634-yunlcme","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑤治胸中痰热，积年痰火，无血者：半夏曲八两（用姜汁一小杯、竹沥一大盏制），黄连二两（姜汁炒），木香一两，沉香二两。为细末，甘草汤泛为丸。空心淡姜汤下二钱。（《张氏医通》沉香化痰丸）"}]},{"ID":"20240902095634-tgyv1t7","Type":"NodeParagraph","Properties":{"id":"20240902095634-tgyv1t7","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑥治伤寒虚痞，气逆呕吐：沉香（锉）一两，青橘皮、陈橘皮（并汤浸去白，焙）、胡椒、蘹香子（炒）、楝实（锉，炒）、荜澄茄（炒）各半两。上七味，粗捣筛。每服二钱匕，水半盏，酒半盏，入葱白一握，煎至半盏，去滓热服。（《圣济总录》沉香丸）"}]},{"ID":"20240902095634-p30oa29","Type":"NodeParagraph","Properties":{"id":"20240902095634-p30oa29","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑦治胃冷久呃：沉香、紫苏、白豆蔻各-钱。为末。每服五、七分，柿蒂汤下。（《活人心统》）"}]},{"ID":"20240902095634-0vih3at","Type":"NodeParagraph","Properties":{"id":"20240902095634-0vih3at","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑧治大肠气滞，虚闭不行：沉香磨汁八分，以当归、枳壳、杏仁泥、肉苁蓉各三钱，紫菀一两，水煎，和沉香汁服。（《方脉正宗》）"}]},{"ID":"20240902095634-4qli9ne","Type":"NodeParagraph","Properties":{"id":"20240902095634-4qli9ne","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"⑨治胞转不通，或过忍小便所致，当治其气则愈，非利药可通也：沉香、木香各二钱。为末。白汤空腹服之，以通为度。（《医垒元戎》）"}]},{"ID":"20240902095634-mqyuhdn","Type":"NodeParagraph","Properties":{"id":"20240902095634-mqyuhdn","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902095634-jmlrew4","Type":"NodeParagraph","Properties":{"id":"20240902095634-jmlrew4","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"沉香属阳而性沉，多功于下部，命肾之所由入也。然香剂多燥，未免伤血，必下焦虚寒者宜之。若水脏衰微，相火盛炎者，误用则水益枯而火益烈，祸无极矣。今多以为平和之剂，无损于人，辄用以化气，其不祸人者几希。\""}]},{"ID":"20240902095634-sw3tn6d","Type":"NodeParagraph","Properties":{"id":"20240902095634-sw3tn6d","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"沉香，纯阳而升，体重而沉，味辛走散，气雄横行，故有通天彻地之功，治胸背四肢诸痈及皮肤作痒。且香能温养脏腑，保和卫气。若寒湿滞于下部，以此佐舒经药，善驱逐邪气；若跌扑损伤，以此佐和血药，能散瘀定痛；若怪异诸病，以此佐攻痰药，能降气安神。总之，疏通经络，血随气行，痰随气转，凡属痛痒，无不悉愈。\""}]},{"ID":"20240902095634-f9mg04o","Type":"NodeParagraph","Properties":{"id":"20240902095634-f9mg04o","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"沉香，温肾而又通心，用黄连、肉桂以交心肾者，不若用沉香更为省事，一药而两用之也。但用之以交心肾，须用之一钱为妙，不必水磨，切片为末，调入于心肾补药中同服可也。\""}]},{"ID":"20240902095634-ke66bro","Type":"NodeParagraph","Properties":{"id":"20240902095634-ke66bro","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"沉水香专于化气，诸气郁结不伸者宜之。温而不燥，行而不泄，扶脾达肾，摄火归原。主大肠虚秘，小便气淋，及痰涎血出于脾者，为之要药。凡心腹卒痛、霍乱中恶、气逆喘急者，并宜酒磨服之；补命门精冷，宜入丸剂。同藿香、香附，治诸虚寒热；同丁香、肉桂，治胃虚呃逆；同紫苏、白豆蔻，治胃冷呕吐；同茯苓、人参，治心神不足；同川椒、肉桂，治命门火衰；同广木香、香附，治强忍入房，或过忍尿，以致胞转不通；同苁蓉、麻仁，治大肠虚秘。昔人四磨饮、沉香化气丸、滚痰丸用之，取其降泄也；沉香降气散用之，取其散结导气也；黑锡丸用之，取其纳气归元也。但多降少升，久服每致矢气无度，面黄少食，虚证百出矣。\""}]},{"ID":"20240902095634-ejb3ydg","Type":"NodeParagraph","Properties":{"id":"20240902095634-ejb3ydg","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902095634-gegzlgv","Type":"NodeParagraph","Properties":{"id":"20240902095634-gegzlgv","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"沉香《中华本草》"}]},{"ID":"20240902095634-vv82yhw","Type":"NodeParagraph","Properties":{"id":"20240902095634-vv82yhw","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902095634-em7yzpf","Type":"NodeParagraph","Properties":{"id":"20240902095634-em7yzpf","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"出自《名医别录》。"}]},{"ID":"20240902095634-rsjmswh","Type":"NodeParagraph","Properties":{"id":"20240902095634-rsjmswh","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"1.《南方草木状》：蜜香、沉香、鸡骨香、黄熟香、栈香、青桂香、马蹄香、鸡舌香，案此八物，同出于一树也。交趾有蜜香树，斡似柜柳，其花白而繁，其叶如橘。钦取香，伐之经年，其根斡枝节，各有别色也。木心与节坚黑，沉水者为沉香；与水面平者为鸡骨香；其根为黄熟香；其斡为栈香；细枝紧实未烂者，为青桂香；其根节轻而大者为马蹄香；其花不香，成实乃香，为鸡舌香。珍异之木也。"}]},{"ID":"20240902095634-ju3my3l","Type":"NodeParagraph","Properties":{"id":"20240902095634-ju3my3l","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.《铁围"}]},{"ID":"20240902095634-bf5vb1j","Type":"NodeParagraph","Properties":{"id":"20240902095634-bf5vb1j","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChénXiānɡ"}]},{"ID":"20240902095634-r99rbux","Type":"NodeParagraph","Properties":{"id":"20240902095634-r99rbux","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【英文名】ChineseEaglewood,WoodofChineseEaglewood"}]},{"ID":"20240902095634-z3mltw1","Type":"NodeParagraph","Properties":{"id":"20240902095634-z3mltw1","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【别名】蜜香、栈香、沉水香。"}]},{"ID":"20240902095634-zfhis35","Type":"NodeParagraph","Properties":{"id":"20240902095634-zfhis35","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902095634-hbt4y38","Type":"NodeParagraph","Properties":{"id":"20240902095634-hbt4y38","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"药材基源：为瑞香科植物沉香、白木香含树脂的木材。"}]},{"ID":"20240902095634-a2e81en","Type":"NodeParagraph","Properties":{"id":"20240902095634-a2e81en","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Aquilariaagallocha(Lour.)Roxb.2.Aquilariasinensis(Lour.)Gilg[OphispermumsinenseLour.；A.grandifloraBenth.]"}]},{"ID":"20240902095634-qvuoeq2","Type":"NodeParagraph","Properties":{"id":"20240902095634-qvuoeq2","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年幸免可采收，种植10年以上，树高10m、胸径15cm以上者取香质量较好。结香的方法有：在树干上，凿一至多个宽2cm、长5-10cm、深5-10cm的长方形或圆形洞，用泥土封闭，让其结香；在树干的同一侧，从上到下每隔40-50cm开一宽为1cm、长和深度均为树干径1/2的洞，用特别的菌种塞满小洞后，用塑料薄膜包扎封口。当上下伤口都结香而相连接时，整株砍下采香。将采下的香，用刀剔除无脂及腐烂部分，阴干。"}]},{"ID":"20240902095634-c8fyc6t","Type":"NodeParagraph","Properties":{"id":"20240902095634-c8fyc6t","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902095634-ix1sudx","Type":"NodeParagraph","Properties":{"id":"20240902095634-ix1sudx","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"1.沉香常绿乔木，高达30m。幼枝被绢状毛。叶互生，稍带革质；具短柄，长约3mm；叶片椭圆状披针形、披针形或倒披针形，长5.5-9cm，先端渐尖，全缘，下面叶脉有时被绢状毛。伞形花序，无梗，或有短的总花梗，被绢状毛；花白色，与小花便等长或较短；花被钟形，5裂，裂片卵形，长0.7-1cm，喉部密被白色绒毛的鳞片10枚，外被绢状毛，内密被长柔毛，花冠管与花被裂片略等长；雄蕊10，着生于花被管上，其中有5枚较长；子房上位，长卵形，密被柔毛，2室，花柱极短，柱头扁球形。蒴果倒卵形，木质，扁压状，长4.6-5.2cm，密被灰白色绒毛，基部有略为木质的宿存花被。种子通常1颗，卵圆形，基部具有角状附属物，长约为种子的2倍。花期3-4月，果期5-6月。"}]},{"ID":"20240902095634-prgla49","Type":"NodeParagraph","Properties":{"id":"20240902095634-prgla49","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2．白木香常绿乔木，植株高达15m。树皮灰褐色；小枝叶柄及花序均被柔毛或夹白色绒毛。叶互生；叶柄长约5mm；叶片革质，长卵形、倒卵形或椭圆形，长6-12cm，宽2-4.5cm，先端渐尖，基部楔形，全缘，两面被疏毛，后渐脱落，光滑而亮。伞形花序顶生和腋生；小花梗长0.5-1.2cm；花黄绿色，被绒毛；花被钟形，5裂，矩圆形，长约7mm，宽约4mm，先端钝圆，花被管喉部有鳞片10枚，密被白色绒毛，长约5mm，基部连合成一环；雄蕊10，花丝粗壮；子房卵形，密被绒毛。蒴果倒卵形，木质，扁压状，长2.5-3cm，密被灰白色毛，基部具稍带木质的宿存花被。种子黑棕色，卵形，长约1cm，先端渐尖，种子基部延长为角状附属物，红棕色，长达2cm，上部扩大。花期3-5月，果期5-6月。"}]},{"ID":"20240902095634-u1302gn","Type":"NodeParagraph","Properties":{"id":"20240902095634-u1302gn","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902095634-pztt6f4","Type":"NodeParagraph","Properties":{"id":"20240902095634-pztt6f4","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"生态环境：1.野生或栽培于热带地区。"}]},{"ID":"20240902095634-6uxkluq","Type":"NodeParagraph","Properties":{"id":"20240902095634-6uxkluq","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.生于平地、丘陵的疏林或荒山中，有少量栽培。"}]},{"ID":"20240902095634-remiyue","Type":"NodeParagraph","Properties":{"id":"20240902095634-remiyue","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"资源分布：1.国外分布于印度、印度尼西亚、越南、马来西亚等国。我国热带地区有引种。"}]},{"ID":"20240902095634-n0u5ty9","Type":"NodeParagraph","Properties":{"id":"20240902095634-n0u5ty9","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.分布于福建、台湾、广东、海南、广西。"}]},{"ID":"20240902095634-ouqclln","Type":"NodeParagraph","Properties":{"id":"20240902095634-ouqclln","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902095634-xvzz820","Type":"NodeParagraph","Properties":{"id":"20240902095634-xvzz820","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，耐短期霜冻，耐旱。幼龄树耐阴，成龄树喜光，对土壤的适应性较广，可在红壤或山地黄壤上生长，在富含腐殖质、土层深厚的壤土上生长较快，但结香不多。在瘠薄的土壤上生长缓慢，长势差，但利于结香。"}]},{"ID":"20240902095634-v3f67ui","Type":"NodeParagraph","Properties":{"id":"20240902095634-v3f67ui","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖，育苗移栽法。在秋季果熟期，采摘1hm2用种量75kg。幼苗经培育1年，苗高50-80cm，按行株距2m×1.5m挖穴移栽定植。"}]},{"ID":"20240902095634-u2h01nm","Type":"NodeParagraph","Properties":{"id":"20240902095634-u2h01nm","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"田间管理幼龄树期每年除草松土4-5次，并于2-3月和10-11月各追肥1次，以追施人畜粪水和复合肥为主。成龄树施肥量适当增加。"}]},{"ID":"20240902095634-hhy47ij","Type":"NodeParagraph","Properties":{"id":"20240902095634-hhy47ij","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"病虫害防治虫害有卷叶蛾，每年夏、秋间幼虫吐丝将叶片卷起，在内蛀食叶肉。卷叶前用25％杀虫眯水剂500倍液喷雾。"}]},{"ID":"20240902095634-0w1paw1","Type":"NodeParagraph","Properties":{"id":"20240902095634-0w1paw1","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902095634-fwf2gxh","Type":"NodeParagraph","Properties":{"id":"20240902095634-fwf2gxh","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）沉香本品呈不规则的棒状、片状或盔帽状。表面褐色，常有黑色、黄色交错的纹理，稍具光泽。入水下沉、半沉水或浮水。质坚实，难折断，破开面灰褐色。有特殊香气，味苦。燃烧时有油渗出，香气较白木香浓烈。"}]},{"ID":"20240902095634-llcf76i","Type":"NodeParagraph","Properties":{"id":"20240902095634-llcf76i","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"（2）白木香本品呈不规则块状、片状及小碎块状，有的呈盔帽状，大小不一。表面凹凸不平，淡黄白色，有黑褐色与黄色相间的斑纹，并有加工刀痕，偶见孔洞，孔洞及凹窝表面多呈朽木状。质较坚硬，不易折断，断面呈刺状，棕色，有特殊香气，味苦。燃烧时有油渗出，发浓烟，香气浓烈。以色黑、质重、油足、香气浓者为佳。"}]},{"ID":"20240902095634-t79rjrq","Type":"NodeParagraph","Properties":{"id":"20240902095634-t79rjrq","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"显微鉴别白木香横切面：导管近多角形，有的含棕色树脂。木纤维壁稍厚，木化。木间韧皮部常与射线相交，呈扁长椭圆形或带状，细胞壁薄，非木化，腔内充满棕色树脂，其间散有少数纤维，有的薄壁细胞含草酸钙柱晶。射线宽1-2列细胞，内含树脂。"}]},{"ID":"20240902095634-4it97o8","Type":"NodeParagraph","Properties":{"id":"20240902095634-4it97o8","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902095634-wrwv3gv","Type":"NodeParagraph","Properties":{"id":"20240902095634-wrwv3gv","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"1．沉香含挥发油，其中倍半萜成分有：沉香螺醇（agarospirol），沉香醇（agarol），石梓呋喃（gmelo-furan），a-及β-沉香呋喃（agarofuran），二氢沉香呋喃（dihydroa-garofuran），去甲沉香呋喃酮（nor-ketoagarofuran），4-羟基二氧沉香呋喃（4-hydroxydihydroagarofuran），3，4-二羟基二氧沉香呋喃（3，4-dihydroxydihydroagarofuran），a-愈创木烯（a-guaiene），a-布藜烯（a-bulnesene），枯树醇（kusunol），卡拉酮（karanone），二氢卡拉酮（dihydrokaranone），沉香螺醇醛（oxoagarospirol），1（10），11-愈创木二烯-15-醛[guaia-1（10），11-dien-15-al]，3，11-芹子二烯-9-酮（seline-3，11-dien-9-one），3，11-芹子二烯-9-醇（seline-3，11-dien-9-ol），沉香雅槛蓝醇（jinkoheremol）等。还含其他挥发成分：苄基丙酮（benzylacetone），对甲氧基苄基丙酮（P-methoxybenzylacetone），氢化桂皮酸（hydrocinnamicacid）等；又含沉香木质素（aquillochin），鹅掌揪碱（liriodenine）。另含2-（2-苯乙基）色酮类[2-（2-phenylethyl）chromone]及其二聚体、三聚体，成分：AH1、AH1a、AH2、AH2a、Ah2b、AH3、AH4、AH5、AH6、AH7、AH8、AH9、A10、AH11、AH12、AH13、AH14、AH15、AH16、AH17、AH18、AH19b、AH19b、AH20、AH23。其中AH1又称为沉香四醇（agarotetrol），AH2又称为异沉香四醇（isoagarotetrol）。"}]},{"ID":"20240902095634-gg0s3ut","Type":"NodeParagraph","Properties":{"id":"20240902095634-gg0s3ut","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2．白木香含挥发油，其中倍半萜成分：沉香螺醇，白木香酸（baimuxinicacid），白木香醛（baimuxinal），白木香醇（baimu-xinol），去氢白木香醇（dehydrobaimuxinol），白木香呋喃醛（sinenofuranal），白木香呋喃醇（ainenofuranol），β-沉香呋喃，二氢卡拉酮，异白木香醇（isobaimuxinol）。还含其他挥发成分：苄基丙酮，对甲氧基苄基丙酮，茴香酸（anisicacid）。又含2-（2-苯乙基）色酮类成分：6-羟基-2-（2-苯乙基）色酮[6-hydroxy-2-（2-phenylethyl）chromone]即是AH3，6-甲氧基-2-（2-苯乙基）色酮[6-methoxy-2-（2-phenylethyl）chromone]即是AH4，6，7-二甲氧基-2-（2-苯乙基）色酮[6，7-dimethoxy-2-（2-phenylethyl）chromone]即是AH5，6-甲氧基-2-[2-（3＇-甲氧基苯）乙基]色酮｛6-methoxyl-2-[2-（3’-methoxyphenyl）ethyl]chromone｝即是AHb1，2-（2-苯乙基）色酮[2-（2-phenylethyl）chromone]即是AH8，6-羟基-2-[2-（4＇-甲氧基苯）乙基]色酮｛6-hydroxy-2-[2-（4＇-methoxyphenyl）ethyl]ethyl]chromone｝，5，8-二羟基-2-（2-对甲氧基苯乙基）色酮｛5，8-dihydroxy-2-[2-（p-methoxyphenyl）ethyl]chromone｝，6，7-二甲氧基-2-（2-对甲氧基苯乙基）色酮｛6，7-dimethoxy-2-[2-（p-methoxyphenyl）ethyl]chromone｝，5，8-二羟基-2-（2-苯乙基）色酮[5，8-dihydroxy-2-（2-phenylethyl）chromone]。"}]},{"ID":"20240902095634-hdkkzrb","Type":"NodeParagraph","Properties":{"id":"20240902095634-hdkkzrb","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902095634-l48ubfe","Type":"NodeParagraph","Properties":{"id":"20240902095634-l48ubfe","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"1.国产沉香煎剂对人体型结核杆菌有完全抑制作用；对伤寒杆菌及福氏杆菌，亦有强烈的抗菌效能。"}]},{"ID":"20240902095634-wmfd3jj","Type":"NodeParagraph","Properties":{"id":"20240902095634-wmfd3jj","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.本品挥发油成分有麻醉、止痛、肌松作用。"}]},{"ID":"20240902095634-q6liyaa","Type":"NodeParagraph","Properties":{"id":"20240902095634-q6liyaa","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"3.尚有镇静、止喘作用：沉香的水煮液和水煮醇沉液能抑制离体豚鼠回肠的自主收缩；对抗组胺、乙酰胆碱引起的豚鼠离体回肠痉挛性收缩。小鼠腹腔注射沉香水煮醇沉液0.2ml（2g生药／ml），能使新斯的明（腹腔注射0.1ml相当2.5×10（-8）g／ml）引起的小鼠肠推进运动减慢，呈现肠平滑肌解痉作用；可使麻醉猫注射乙酰胆碱后肠管收缩幅度减少，蠕动减慢，这些作用可能是沉香对平滑肌的直接作用。"}]},{"ID":"20240902095634-cbqgep2","Type":"NodeParagraph","Properties":{"id":"20240902095634-cbqgep2","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品10g，加乙醇回流提取，滤过，浓缩至干，进行微量升华，得黄褐色油状物，香气浓郁；于油状物上加盐酸1滴与香草醛颗粒少量，再滴加乙醇1-2滴，渐显樱红色，放置后颜色加深。（检查挥发油）品质标志《中华人民共和国药典》1995年版规定：本品乙醇浸出物不得少于15.0％。"}]},{"ID":"20240902095634-6bgsyxy","Type":"NodeParagraph","Properties":{"id":"20240902095634-6bgsyxy","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【炮制】刷净，劈成小块，用时捣碎或研成细粉。"}]},{"ID":"20240902095634-h2cbvc9","Type":"NodeParagraph","Properties":{"id":"20240902095634-h2cbvc9","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【性味】辛；苦；温"}]},{"ID":"20240902095634-0g99pm5","Type":"NodeParagraph","Properties":{"id":"20240902095634-0g99pm5","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【归经】肾；脾；胃；命门；肺；胆；肝经"}]},{"ID":"20240902095634-vi6cuo3","Type":"NodeParagraph","Properties":{"id":"20240902095634-vi6cuo3","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气止痛；温中降逆；纳气平喘。主脘腹冷痛；气逆员息；胃寒呕吐呃逆；腰膝虚冷；大肠虚秘；小便气淋"}]},{"ID":"20240902095634-o66o14d","Type":"NodeParagraph","Properties":{"id":"20240902095634-o66o14d","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2-5g，后下；研末，0.5-1g；或磨汁服。"}]},{"ID":"20240902095634-s1il9fm","Type":"NodeParagraph","Properties":{"id":"20240902095634-s1il9fm","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902095634-uodpxa4","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240902095634-uodpxa4","updated":"20240902095705"},"Children":[{"ID":"20240902095634-p2ju85o","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240902095634-p2ju85o","updated":"20240902095634"},"Children":[{"ID":"20240902095634-wma7aru","Type":"NodeParagraph","Properties":{"id":"20240902095634-wma7aru","updated":"20240902095634"}}]}]},{"ID":"20240902095634-hijo9t7","Type":"NodeParagraph","Properties":{"id":"20240902095634-hijo9t7","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：中气虚，气不归元者忌之；心经有实邪者忌之；非命门真火衰者，不宜入下焦药用。"}]},{"ID":"20240902095634-ow7m8f0","Type":"NodeParagraph","Properties":{"id":"20240902095634-ow7m8f0","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：阴虚气逆上者切忌。"}]},{"ID":"20240902095634-ox5nfrr","Type":"NodeParagraph","Properties":{"id":"20240902095634-ox5nfrr","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：气虚下陷人，不可多服。"}]},{"ID":"20240902095634-3wrzm9d","Type":"NodeParagraph","Properties":{"id":"20240902095634-3wrzm9d","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"5.《本草从新》：阴亏火旺者，切勿沾唇。"}]},{"ID":"20240902095634-4jkmh1o","Type":"NodeParagraph","Properties":{"id":"20240902095634-4jkmh1o","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902095634-5e660sq","Type":"NodeParagraph","Properties":{"id":"20240902095634-5e660sq","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"1.李杲：沉香，能养诸气，用为使，最相宜。"}]},{"ID":"20240902095634-61cc67t","Type":"NodeParagraph","Properties":{"id":"20240902095634-61cc67t","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮制药性解》：沉香属阳而性沉，多功于下部，命肾之所由入也。然香剂多燥，未免伤血，必下焦虚寒者宜之。若水脏衰微，相火盛炎者，误用则水益枯而火益烈，祸无极矣，今多以为平和之剂，无损于人，辄用以化气，其不祸人者几希。"}]},{"ID":"20240902095634-gv6jp49","Type":"NodeParagraph","Properties":{"id":"20240902095634-gv6jp49","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：沉香，气芬芳，《本经》疗风水毒肿者，即风毒水肿也。水肿者，脾湿也，脾恶湿而喜燥，辛香入脾而臊湿，则水肿自消。凡邪恶气之中人，必从口鼻而入，口鼻为阳明之窍，阳明虚则恶气易入，得芬芳清阳之气，则恶气除而脾胃安矣。沉香治冷气、逆气，气郁气结，殊为要药。"}]},{"ID":"20240902095634-5dqjwuv","Type":"NodeParagraph","Properties":{"id":"20240902095634-5dqjwuv","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"4.《本草通玄》：沉香，温而不燥，行而不泄，扶脾而运行不倦，达肾而导火归元，有降气之功，无破气之害，洵为良品。"}]},{"ID":"20240902095634-hjh3o6q","Type":"NodeParagraph","Properties":{"id":"20240902095634-hjh3o6q","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"5.《药品化义》：沉香，纯阳而升，体重而沉，味辛走散，气雄横行，故有通天彻地之功，治胸背四肢诸痈及皮肤作痒。且香能温养脏腑，保和卫气。若寒湿滞于下部，以此佐舒经药，善驱逐邪气；若跌扑损伤，以此佐和血药，能散瘀定痛；若怪异诸病，以此佐攻痰药，能降气安神。总之，疏通经络，血随气行，痰随气转，几属痛痒，无不悉愈。"}]},{"ID":"20240902095634-thmry12","Type":"NodeParagraph","Properties":{"id":"20240902095634-thmry12","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"6.《本草述》：按诸香如木香之专调滞气，丁香之专疗寒气，檀香之升理上焦气，皆不得如沉香之功能，言其养诸气，保和卫气，降真气也。木香能疏导滞气，而沉之宜于气郁气结者，则有不同；木香能升降滞气，而沉之能升降真气者，则有不同；丁香能祛寒开胃，而沉之调中止冷者，则有不同；檀香能开发清阳，而沉之升降水火者，则有不同。"}]},{"ID":"20240902095634-1yrjj78","Type":"NodeParagraph","Properties":{"id":"20240902095634-1yrjj78","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"7.《本草新编》：沉香，温肾而又通心，用黄连、肉桂以交心肾者，不若用沉香更为省事，一药而两用之也。但用之以交心肾，须用之一钱为妙，不必水磨，切片为末，调入于心肾补药中同服可也。"}]},{"ID":"20240902095634-qyl7kdl","Type":"NodeParagraph","Properties":{"id":"20240902095634-qyl7kdl","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"8.《本经逢原》：沉水香专于化气，诸气郁结不伸者宜之。温而不燥，行而不泄，扶脾达肾，摄火归原。主大肠虚秘，小便气淋，及痰涎血出于脾者，为之要药。凡心腹卒痛、霍乱中恶、气逆喘急者，并宜酒磨服之；外命门精冷，宜入丸剂。同藿香、香附，治诸虚寒热；同丁香、肉桂，治胃虚呃逆；同紫苏、白豆蔻，治胃冷呕吐；同茯苓、人参，治心神不足；同川椒、肉桂，治命门火衰；同广木香、香附，治强忍入房，或过忍尿，以致胞转不通；同苁蓉、麻仁，治大肠虚秘。昔人四磨饮、沉香化气丸、滚痰丸用之，取其降泄也；沉香降气散用之，取其散结导气也；黑锡丸用之，取其纳气归元也。但多降少升，久服每致矢气无度，面黄少食，虚证百出矣。"}]},{"ID":"20240902095634-hmkifql","Type":"NodeParagraph","Properties":{"id":"20240902095634-hmkifql","updated":"20240902095705"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902095636-h3zajl1","Type":"NodeThematicBreak","Properties":{"id":"20240902095636-h3zajl1","updated":"20240902095705"}},{"ID":"20240902095637-c0ef2hu","Type":"NodeParagraph","Properties":{"id":"20240902095637-c0ef2hu","updated":"20240902095705"}}]}