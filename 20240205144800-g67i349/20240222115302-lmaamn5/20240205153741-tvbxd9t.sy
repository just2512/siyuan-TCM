{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 757px;\" parent-style=\"width: 767px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"丁香树9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/丁香树9-20240709094118-im09bxd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709082429-ofi61yj","Type":"NodeParagraph","Properties":{"id":"20240709082429-ofi61yj","updated":"20240709083329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为丁香的干燥花蕾。品类较多，主要取图四川丁香"}]},{"ID":"20240709082429-yf7386t","Type":"NodeThematicBreak","Properties":{"id":"20240709082429-yf7386t"}},{"ID":"20240830102857-af9hg91","Type":"NodeParagraph","Properties":{"id":"20240830102857-af9hg91","updated":"20240830102908"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：丁香"}]},{"ID":"20240830102857-gf4zn7z","Type":"NodeParagraph","Properties":{"id":"20240830102857-gf4zn7z","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"丁香《中国药典》"}]},{"ID":"20240830102857-twrbg0l","Type":"NodeParagraph","Properties":{"id":"20240830102857-twrbg0l","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【拼音名】DīnɡXiānɡ"}]},{"ID":"20240830102857-wo58y0p","Type":"NodeParagraph","Properties":{"id":"20240830102857-wo58y0p","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSCARYOPHYLLI"}]},{"ID":"20240830102857-uo6tisz","Type":"NodeParagraph","Properties":{"id":"20240830102857-uo6tisz","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【来源】本品为桃金娘科植物丁香EugeniacaryophllataThunb.的干燥花蕾。当花蕾由绿色转红时采摘，晒干。"}]},{"ID":"20240830102857-ul1wog3","Type":"NodeParagraph","Properties":{"id":"20240830102857-ul1wog3","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性状】本品略呈研棒状，长1～2cm。花冠圆球形，直径0.3～0.5cm，花瓣4，复瓦状抱合，棕褐色至褐黄色，花瓣内为雄蕊和花柱，搓碎后可见众多黄色细粒状的花药。萼筒圆柱状，略扁，有的稍弯曲，长0.7～1.4cm，直径0.3～0.6cm，红棕色或棕褐色，上部有4枚三角状的萼片，十字状分开。质坚实，富油性。气芳香浓烈，味辛辣、有麻舌感。"}]},{"ID":"20240830102857-9dsjucy","Type":"NodeParagraph","Properties":{"id":"20240830102857-9dsjucy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830102857-mr2977g","Type":"NodeParagraph","Properties":{"id":"20240830102857-mr2977g","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"（1）本品萼筒中部横切面：表皮细胞1列，有较厚角质层。皮层外侧散有2～3列径向延长的椭圆形油室，长150～200μｍ；其下有20～50个小型双韧维管束，断续排列成环，维管束外围有少数中柱鞘纤维，壁厚，木化。内侧为数列薄壁细胞组成的通气组织，有大形细胞间隙。中心轴柱薄壁组织间散有多数细小维管束，薄壁细胞含众多细小草酸钙簇晶。粉末暗红棕色。纤维梭形，顶端钝圆，壁较厚，花粉粒众多，极面观三角形，赤道表面观双凸镜形，具3副合沟。草酸钙簇晶众多，直径4～26μｍ，存在于较小的薄壁细胞中。油室多破碎，分泌细胞界限不清，含黄色油状物。"}]},{"ID":"20240830102857-z99ba3q","Type":"NodeParagraph","Properties":{"id":"20240830102857-z99ba3q","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.5g，加乙醚5ml，振摇数分钟，滤过，滤液作为供试品溶液。另取丁香酚对照品，加乙醚制成每1ml含16μl的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5μl，分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）－醋酸乙酯（9:1）为展开剂，展开，取出，晾干，喷以5％香草醛硫酸溶液，于105℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240830102857-u4d4qcy","Type":"NodeParagraph","Properties":{"id":"20240830102857-u4d4qcy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，筛去灰屑。用时捣碎。"}]},{"ID":"20240830102857-m7j738b","Type":"NodeParagraph","Properties":{"id":"20240830102857-m7j738b","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240830102857-40ad5lv","Type":"NodeParagraph","Properties":{"id":"20240830102857-40ad5lv","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、肺、肾经。"}]},{"ID":"20240830102857-rkm34zf","Type":"NodeParagraph","Properties":{"id":"20240830102857-rkm34zf","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中降逆，补肾助阳。用于脾胃虚寒，呃逆呕吐，食少吐泻，心腹冷痛，肾虚阳痿。"}]},{"ID":"20240830102857-cv5nw0l","Type":"NodeParagraph","Properties":{"id":"20240830102857-cv5nw0l","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【用法用量】1～3g。"}]},{"ID":"20240830102857-64af75m","Type":"NodeParagraph","Properties":{"id":"20240830102857-64af75m","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【注意】不宜与郁金同用。"}]},{"ID":"20240830102857-0b4alis","Type":"NodeParagraph","Properties":{"id":"20240830102857-0b4alis","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240830102857-jijlusw","Type":"NodeParagraph","Properties":{"id":"20240830102857-jijlusw","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830102857-h60cyrf","Type":"NodeParagraph","Properties":{"id":"20240830102857-h60cyrf","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"丁香《全国中草药汇编》"}]},{"ID":"20240830102857-1j1ur5m","Type":"NodeParagraph","Properties":{"id":"20240830102857-1j1ur5m","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【拼音名】DīnɡXiānɡ"}]},{"ID":"20240830102857-op73yst","Type":"NodeParagraph","Properties":{"id":"20240830102857-op73yst","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【别名】公丁香[花蕾]、母丁香[果实]"}]},{"ID":"20240830102857-w0ug5m5","Type":"NodeParagraph","Properties":{"id":"20240830102857-w0ug5m5","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【来源】为桃金娘科丁子香属植物丁香EugeniacaryophyllataThunb.[E.aromaticaBaill.;Syzygiumaromatica（L）Merr.etPerry]，以花蕾和其果实入药。在花蕾开始呈白色，渐次变绿色，最后呈鲜红色时可采集。将采得的花蕾除去花梗晒干即成。"}]},{"ID":"20240830102857-vjsmcjp","Type":"NodeParagraph","Properties":{"id":"20240830102857-vjsmcjp","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木。高达10米。叶对生，叶柄细长，向上渐短；叶片长方倒卵形或椭圆形，长5～10厘米，宽2.5～5厘米，先端渐尖，基部渐窄下延至柄，全缘。秋季开花，花有浓香，聚伞圆锥花序顶生，花径约6毫米；花萼肥厚，绿色后转紫红色，管状，先端4浅裂，裂片三角形，肥厚；花冠白色稍带淡紫，基部管状，较萼稍长，先端具4裂片；雄蕊多数；子房下位，顶端有粗厚花柱，柱头不明显。浆果红棕色，稍有光泽，长方椭圆形，长1～1.5（～2.5）厘米，直径5～8（～12）毫米，先端有肥厚宿存花萼裂片，有香气。种子数粒，长方形。"}]},{"ID":"20240830102857-ohrsrmc","Type":"NodeParagraph","Properties":{"id":"20240830102857-ohrsrmc","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【生境分布】栽培和野生于热带地区。原产于非洲摩洛哥，现我国广东也有种植。"}]},{"ID":"20240830102857-alffid1","Type":"NodeParagraph","Properties":{"id":"20240830102857-alffid1","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【栽培】丁香是热带性植物，性喜温暖潮湿，要求年雨量1,200～1,700毫米，最低温度不低于10℃，温度低于8℃时叶片就出现冻害现象。适宜在肥沃的鲨壤土或粘壤土地栽培，用播种及空中压条繁殖，但以播种繁殖为主。播种前首先剥去果肉，然后将种子按种距3～5寸播下，盖土3～4分。播后浇水，并搭设荫棚，播后10天可出苗，出苗率95％以上。苗期要注意管理，生长半年后，苗高2～3寸，有4～6对真叶时移栽，行株距6～8寸。丁香幼苗根很细弱，移栽时需带土团。移栽培育1年后，苗高1尺以上时，即可移至大田。"}]},{"ID":"20240830102857-kbmcx6d","Type":"NodeParagraph","Properties":{"id":"20240830102857-kbmcx6d","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【化学成份】花蕾（公丁香）含挥发油（即丁香油）14～20％，油中含丁香酚（eugenol）78～95％、乙酰丁香酚（acetyleugenol）约3％及少量的丁香烯（caryophyllene）、甲基正戊酮、甲基正庚酮、香荚兰醛；此外，尚含齐墩果酸、鞣质、脂肪油及腊。果实（母丁香）含挥发油2～9％。"}]},{"ID":"20240830102857-ndfykkx","Type":"NodeParagraph","Properties":{"id":"20240830102857-ndfykkx","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830102857-71vypu4","Type":"NodeParagraph","Properties":{"id":"20240830102857-71vypu4","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"1.丁香水煎剂和丁香油对于猪、犬的蛔虫均有驱除作用，丁香油的效力更大，对于犬的钩虫病也有一定疗效。在体外，丁香水煎剂、乙醇浸剂和乙醚提取物均有麻痹或杀死猪蛔的作用。"}]},{"ID":"20240830102857-k72xfuc","Type":"NodeParagraph","Properties":{"id":"20240830102857-k72xfuc","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"2.抑菌试验：本品对于葡萄球菌及结核杆菌均有抑制作用。丁香油及丁香酚在试管内对布氏杆菌、鸟型结核杆菌的抑制作用较强，对常见治病性皮肤真菌有显着的抑制作用。又因为丁香油及丁香酚对于皮肤无刺激作用，且吸收良好。"}]},{"ID":"20240830102857-0d4u1g3","Type":"NodeParagraph","Properties":{"id":"20240830102857-0d4u1g3","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240830102857-mpda7iy","Type":"NodeParagraph","Properties":{"id":"20240830102857-mpda7iy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【功能主治】温脾胃，降逆气。主治胃寒呕逆，吐泻，脘腹作痛。"}]},{"ID":"20240830102857-endjvjc","Type":"NodeParagraph","Properties":{"id":"20240830102857-endjvjc","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～1.5钱。"}]},{"ID":"20240830102857-2f5alvv","Type":"NodeParagraph","Properties":{"id":"20240830102857-2f5alvv","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830102857-6595lrj","Type":"NodeParagraph","Properties":{"id":"20240830102857-6595lrj","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"治胃寒呕逆：丁香1钱，柿蒂2钱。水煎服。"}]},{"ID":"20240830102857-9yrcwbc","Type":"NodeParagraph","Properties":{"id":"20240830102857-9yrcwbc","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"治胃痛：丁香2钱，肉桂、木香、乌药各4钱。攻研细末，每服2克，每日3次。"}]},{"ID":"20240830102857-fp3kwqo","Type":"NodeParagraph","Properties":{"id":"20240830102857-fp3kwqo","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【备注】母丁香为丁香的干燥果实。在果实近成熟时采摘。应用与丁香花蕾相似，但药力较弱，功效较差。"}]},{"ID":"20240830102857-69jm58s","Type":"NodeParagraph","Properties":{"id":"20240830102857-69jm58s","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830102857-jy70goj","Type":"NodeParagraph","Properties":{"id":"20240830102857-jy70goj","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"丁香《*辞典》"}]},{"ID":"20240830102857-k3ila8d","Type":"NodeParagraph","Properties":{"id":"20240830102857-k3ila8d","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【出处】《药性论》"}]},{"ID":"20240830102857-qv7gpuq","Type":"NodeParagraph","Properties":{"id":"20240830102857-qv7gpuq","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【拼音名】DīnɡXiānɡ"}]},{"ID":"20240830102857-rf0yz62","Type":"NodeParagraph","Properties":{"id":"20240830102857-rf0yz62","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【别名】丁子香（《齐民要术》），支解香、雄丁香（《本草蒙筌》），公丁香（《本草原始》）。"}]},{"ID":"20240830102857-99fzcpg","Type":"NodeParagraph","Properties":{"id":"20240830102857-99fzcpg","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【来源】为桃金娘科植物丁香的花蕾。通常在9月至次年3月间，花蕾由青转为鲜红色时采收。采下后除去花梗，晒干。"}]},{"ID":"20240830102857-gck0yxy","Type":"NodeParagraph","Properties":{"id":"20240830102857-gck0yxy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高达10米。叶对生；叶柄明显；叶片长方卵形或长方倒卵形，长5～10厘米，宽2.5～5厘米，先端渐尖或急尖，基部狭窄常下展成柄，全缘。花芳香，成顶生聚伞圆锥花序，花径约6毫米；花萼肥厚，绿色后转紫色，长管状，先端4裂，裂片三角形；花冠白色，稍带淡紫，短管状，4裂；雄蕊多数，花药纵裂；子房下位，与萼管合生，花柱粗厚，柱头不明显。浆果红棕色，长方椭圆形，长1～1.6厘米，直径6～8毫米，先端宿存萼片。种子长方形。"}]},{"ID":"20240830102857-ymycv9o","Type":"NodeParagraph","Properties":{"id":"20240830102857-ymycv9o","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【生境分布】分布马来群岛及非洲，我国广东、广西等地有栽培。主产于坦桑尼亚、马来西亚、印度尼西亚等地。我国广东有少数出产。"}]},{"ID":"20240830102857-fqr396z","Type":"NodeParagraph","Properties":{"id":"20240830102857-fqr396z","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的花蕾略呈短棒状，长1.5～2厘米，红棕色至暗棕色。下部为圆柱状略扁的萼管，长1～1.3厘米，宽约5毫米，厚约3毫米，基部渐狭小，表面粗糙，刻之有油渗出，萼管上端有4片三角形肥厚的萼。上部近圆球形；径约6毫米，具花瓣4片，互相抱合。将花蕾剖开，可见多数雄蕊，花丝向中心弯曲，中央有一粗壮直立的花柱。质坚实而重，入水即沉；断面有油性，用指甲划之可见油质渗出。气强烈芳香，味辛。以个大，粗壮、鲜紫棕色、香气强烈、油多者为佳。"}]},{"ID":"20240830102857-zt5fb0p","Type":"NodeParagraph","Properties":{"id":"20240830102857-zt5fb0p","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830102857-kvpjlgj","Type":"NodeParagraph","Properties":{"id":"20240830102857-kvpjlgj","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240830102857-7495aex","Type":"NodeParagraph","Properties":{"id":"20240830102857-7495aex","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"味辛，温，无毒。\""}]},{"ID":"20240830102857-07jouj5","Type":"NodeParagraph","Properties":{"id":"20240830102857-07jouj5","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"辛，热。\""}]},{"ID":"20240830102857-gfbmqm3","Type":"NodeParagraph","Properties":{"id":"20240830102857-gfbmqm3","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830102857-y1eizji","Type":"NodeParagraph","Properties":{"id":"20240830102857-y1eizji","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"入胃、脾、肾经。"}]},{"ID":"20240830102857-vsylmdl","Type":"NodeParagraph","Properties":{"id":"20240830102857-vsylmdl","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴，足阳明、少阴经。\""}]},{"ID":"20240830102857-xaejfav","Type":"NodeParagraph","Properties":{"id":"20240830102857-xaejfav","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、脾、胃、肾四经。\""}]},{"ID":"20240830102857-o92th8l","Type":"NodeParagraph","Properties":{"id":"20240830102857-o92th8l","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830102857-malj5wu","Type":"NodeParagraph","Properties":{"id":"20240830102857-malj5wu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"温中，暖肾，降逆。治呃逆，呕吐，反胃，泻痢，心腹冷痛，痃癖，疝气，癣疾。"}]},{"ID":"20240830102857-oxqpr44","Type":"NodeParagraph","Properties":{"id":"20240830102857-oxqpr44","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"治冷气腹痛。\""}]},{"ID":"20240830102857-2z6zss4","Type":"NodeParagraph","Properties":{"id":"20240830102857-2z6zss4","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"主风疳匿，骨槽劳臭。治气，乌髭发，杀虫，疗五痔，辟恶去邪。治奶头花，止五色毒痢，正气，止心腹痛。\""}]},{"ID":"20240830102857-4n61qvz","Type":"NodeParagraph","Properties":{"id":"20240830102857-4n61qvz","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治口气，反胃，疗肾气，奔豚气，阴痛，壮阳，暖腰膝，杀酒毒，消痃癖，除冷劳。\""}]},{"ID":"20240830102857-mr5o2pn","Type":"NodeParagraph","Properties":{"id":"20240830102857-mr5o2pn","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"④《开宝本草》：\"温脾胃，止霍乱。（治）壅胀，风毒诸肿，齿疳匿。\""}]},{"ID":"20240830102857-babizq4","Type":"NodeParagraph","Properties":{"id":"20240830102857-babizq4","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑤《本草蒙筌》：\"止气忒、气逆。\""}]},{"ID":"20240830102857-kydto3y","Type":"NodeParagraph","Properties":{"id":"20240830102857-kydto3y","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治虚哕，小儿吐泻，痘疮胃虚灰白不发。\""}]},{"ID":"20240830102857-8q0ds79","Type":"NodeParagraph","Properties":{"id":"20240830102857-8q0ds79","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑦《本草正》：\"温中快气。治上焦呃逆，除胃寒泻痢，七情五郁。\""}]},{"ID":"20240830102857-46yxnce","Type":"NodeParagraph","Properties":{"id":"20240830102857-46yxnce","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑧《本草汇》：\"疗胸痹、阴痛，暖阴户。\""}]},{"ID":"20240830102857-x34ztyh","Type":"NodeParagraph","Properties":{"id":"20240830102857-x34ztyh","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑨《医林纂要》：\"补肝、润命门，暖胃、去中寒，泻肺、散风湿。\""}]},{"ID":"20240830102857-82tib9l","Type":"NodeParagraph","Properties":{"id":"20240830102857-82tib9l","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"开九窍，舒郁气，去风，行水。\""}]},{"ID":"20240830102857-w5mb0ej","Type":"NodeParagraph","Properties":{"id":"20240830102857-w5mb0ej","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑾《药材学》：\"治慢性消化不良，胃肠充气及子宫疝痛。\""}]},{"ID":"20240830102857-a96rofu","Type":"NodeParagraph","Properties":{"id":"20240830102857-a96rofu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服，煎汤，0.3～1钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240830102857-ho50zxv","Type":"NodeParagraph","Properties":{"id":"20240830102857-ho50zxv","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830102857-v6r6s7h","Type":"NodeParagraph","Properties":{"id":"20240830102857-v6r6s7h","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"热病及阴虚内热者忌服。"}]},{"ID":"20240830102857-di9lik0","Type":"NodeParagraph","Properties":{"id":"20240830102857-di9lik0","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"不可见火。畏郁金。\""}]},{"ID":"20240830102857-4kxojfa","Type":"NodeParagraph","Properties":{"id":"20240830102857-4kxojfa","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"②李杲：\"气血胜者不可服，丁香益其气也。\""}]},{"ID":"20240830102857-jw4woeu","Type":"NodeParagraph","Properties":{"id":"20240830102857-jw4woeu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"一切有火热证者忌之，非属虚寒，概勿施用。\""}]},{"ID":"20240830102857-uceyl85","Type":"NodeParagraph","Properties":{"id":"20240830102857-uceyl85","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830102857-ewtfdoy","Type":"NodeParagraph","Properties":{"id":"20240830102857-ewtfdoy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"①治伤寒咳噫不止，及哕逆不定：丁香一两，干柿蒂一两。焙干，捣罗为散。每服一钱，煎人参汤下，无时服。（《简要济众方》）"}]},{"ID":"20240830102857-dl18xpk","Type":"NodeParagraph","Properties":{"id":"20240830102857-dl18xpk","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"②治小儿吐逆：丁香、半夏（生用）各一两。同研为细末，姜汁和丸，如绿豆大。姜汤下三、二十丸。（《百一选方》）"}]},{"ID":"20240830102857-ysruwht","Type":"NodeParagraph","Properties":{"id":"20240830102857-ysruwht","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"③治朝食暮吐：丁香十五个研末，甘蔗汁、姜汁和丸莲子大，噙咽之。（《摘元方》）"}]},{"ID":"20240830102857-vca759t","Type":"NodeParagraph","Properties":{"id":"20240830102857-vca759t","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"④治霍乱，止吐：丁香十四枚，以酒五合，煮取二合，顿服之。用水煮之亦佳。（《千金翼方》）"}]},{"ID":"20240830102857-v8gc008","Type":"NodeParagraph","Properties":{"id":"20240830102857-v8gc008","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑤治久心痛不止：丁香半两，桂心一两。捣细，罗为散，每于食前，以热酒调下一钱。（《圣惠方》）"}]},{"ID":"20240830102857-ifvfwv2","Type":"NodeParagraph","Properties":{"id":"20240830102857-ifvfwv2","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑥治痈疽恶肉：丁香末敷之，外用膏药护之。（《怪证奇方》）"}]},{"ID":"20240830102857-spfii14","Type":"NodeParagraph","Properties":{"id":"20240830102857-spfii14","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑦治食蟹致伤：丁香末，姜汤服五分。（《证治要诀》）"}]},{"ID":"20240830102857-yxamku5","Type":"NodeParagraph","Properties":{"id":"20240830102857-yxamku5","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"⑧治鼻中息肉：丁香绵裹纳之。（《圣惠方》）"}]},{"ID":"20240830102857-x10419y","Type":"NodeParagraph","Properties":{"id":"20240830102857-x10419y","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【临床应用】治癣:丁香16克，加入70％酒精至100毫升，浸48小时后去渣。每日外搽患处3次，观察31例病史在2年以上的体癣及足癣患者，一般在治疗1天后症状即见消退，2天后患处开始有皮屑脱落。病史较长或曾经其它癣药治疗而不能控制者，则于治疗后2～3天症状才开始消退，一般经3～5天亦能治愈。但有20％左右治愈后仍反复发作。一法用1：10的丁香煎液外涂，每日1～3次，治疗数种皮肤霉菌病共31例，结果8例临床痊愈，10例显效，8例有效，6例无效。有效病例通常在涂药后3～7日痒感减轻，炎症减退，落屑减少，以后局部症状逐渐好转。治疗期中如中断用药，效果多不明显或无效。疗效与病原苗未见明显关系，曾对6例治愈患者进行短期随访，1例于1个月后复发，6例经2～12月观察未见复发。"}]},{"ID":"20240830102857-ktpgrv1","Type":"NodeParagraph","Properties":{"id":"20240830102857-ktpgrv1","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830102857-42pguux","Type":"NodeParagraph","Properties":{"id":"20240830102857-42pguux","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"丁香《中华本草》"}]},{"ID":"20240830102857-dlqn622","Type":"NodeParagraph","Properties":{"id":"20240830102857-dlqn622","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【出处】出自《开宝本草》。"}]},{"ID":"20240830102857-hw4n745","Type":"NodeParagraph","Properties":{"id":"20240830102857-hw4n745","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【拼音名】DīnɡXiānɡ"}]},{"ID":"20240830102857-g92rxu8","Type":"NodeParagraph","Properties":{"id":"20240830102857-g92rxu8","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【英文名】Clove，FlosCaryophyllata"}]},{"ID":"20240830102857-emqchjb","Type":"NodeParagraph","Properties":{"id":"20240830102857-emqchjb","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【别名】丁子香、支解香、雄丁香、公丁香。"}]},{"ID":"20240830102857-v2y2i8o","Type":"NodeParagraph","Properties":{"id":"20240830102857-v2y2i8o","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830102857-8r7f4ik","Type":"NodeParagraph","Properties":{"id":"20240830102857-8r7f4ik","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"药材基源：为双子叶植物药桃金娘科植物丁香的花蕾。"}]},{"ID":"20240830102857-dt5byz0","Type":"NodeParagraph","Properties":{"id":"20240830102857-dt5byz0","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SyZygiumaromaticum(L.)Merr.EtPer-ry[EugeniaaromaticeaKuntze;E.caryophyllataThunb.]"}]},{"ID":"20240830102857-tp2pvba","Type":"NodeParagraph","Properties":{"id":"20240830102857-tp2pvba","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植后5-6年，花蕾开始呈白色，渐次变绿色，最后呈鲜红色时采集，除去花梗，晒干。"}]},{"ID":"20240830102857-ltrbm9x","Type":"NodeParagraph","Properties":{"id":"20240830102857-ltrbm9x","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【原形态】丁香，常绿乔木，高达10米。叶对生；叶柄明显；叶片长方卵形或长方倒卵形，长5-10cm，宽2.5-5cm，先端渐尖或急尖，基部狭窄常下展成柄，全缘。花芳香，成顶生聚伞圆锥花序，花径约6mm；花萼肥厚，绿色后转紫色，长管状，先端4裂，裂片三角形；花冠白色，稍带淡紫，短管伏，4裂；雄蕊多数，花药纵裂；子房下位，与萼管合生，花柱粗厚，柱头不明显。浆果红棕色，长方椭圆形，长1-1.5cm，直径5-8mm，先端宿存萼片。种子长方形。"}]},{"ID":"20240830102857-dx0qecy","Type":"NodeParagraph","Properties":{"id":"20240830102857-dx0qecy","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【生境分布】分布马来群岛及非洲，我国广东、广西等地有栽培。药材主产于坦桑尼亚、马来西亚、印度尼西亚等地。"}]},{"ID":"20240830102857-6nb7vhl","Type":"NodeParagraph","Properties":{"id":"20240830102857-6nb7vhl","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830102857-bfjczik","Type":"NodeParagraph","Properties":{"id":"20240830102857-bfjczik","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"生物学特性喜热带海岛性气候。幼龄树喜阴不耐烈日暴晒，生长缓慢；成龄树喜光，需充足阳光才能早开花，开花多。怕寒、怕涝，不抗风，宜选土层深厚、肥沃、排水良好，pH5.0-6.0的砂壤土栽培。"}]},{"ID":"20240830102857-j46umfu","Type":"NodeParagraph","Properties":{"id":"20240830102857-j46umfu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。从5-6年生留植株上于5-6月果产为紫红色时，及时采收，具随采随播，若不能及时播各，最好剥掉果肉放入潮湿细沙或湿木糠中贮藏，以免干死。处理后的种子，量佳播种时间为8-9月。开沟点播，行距15cm，粒距约5cm，种子平放或直放，胚根朝下，播种后覆土1cm，鲜果播后35-45d，处理后的种子播后10d左右出苗，苗长至4-5cm，具两片幼叶时，即可移植于苗床或移入营养袋里育苗，苗高6-10cm，有4-6对真叶时移栽实植，移栽时需带土团。"}]},{"ID":"20240830102857-pl2q720","Type":"NodeParagraph","Properties":{"id":"20240830102857-pl2q720","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"田间管理幼树可与木薯、香蕉间作或搭荫棚，并在株间栽种绿肥，干旱及时灌水，雨季开沟排水，适时追肥，培土。剪去主杆50-70cm，下侧枝，分叉主杆。上部枝叶亦可适当修剪。"}]},{"ID":"20240830102857-075h0la","Type":"NodeParagraph","Properties":{"id":"20240830102857-075h0la","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有褐斑病，主要为害叶片，可在发病前或发病初期用1：1：100的波尔多液或50%的可湿性甲基托布津1000倍溶液喷射。另有煤烟病为害。虫害主要为介壳虫。"}]},{"ID":"20240830102857-l2o4a18","Type":"NodeParagraph","Properties":{"id":"20240830102857-l2o4a18","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830102857-0jv2xpu","Type":"NodeParagraph","Properties":{"id":"20240830102857-0jv2xpu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"性状鉴别花蕾略呈研棒状，长1-2cm。花冠圆球形，直径0.3-0.5cm。花瓣4，覆瓦状抱合，棕褐色或黄褐色，花瓣内为雄蕊和花柱，搓碎后可见众多黄色细粒状的花药。萼筒圆柱状。略扁，有的稍弯曲，长0.7-1.4cm，直径0.3=0.6cm，红棕色或棕褐色、上部有4枚三角状的萼片，十字状分开。质坚产，富油性。气芳香浓烈，味辛辣，有麻舌感。"}]},{"ID":"20240830102857-fzl3f8p","Type":"NodeParagraph","Properties":{"id":"20240830102857-fzl3f8p","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"以个大粗壮、鲜紫棕色、香气浓郁、富有油性者为佳。"}]},{"ID":"20240830102857-y82blpi","Type":"NodeParagraph","Properties":{"id":"20240830102857-y82blpi","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"显微鉴别萼筒中部横切面：表皮细胞1列，有较厚角质层。皮外侧散有2-3列径向延长的椭圆形油室，长150-200μ；其下有20-50个小型双韧维管束，断续排列成环，维管束外围有少数中柱鞘纤维，壁厚，木化。内侧为数列薄壁细胞组织的通气组织，有大形细胞间隙。中心轴柱薄壁组织间散有多数细小维管束，薄壁细胞中含众多细小草酸钙簇晶。"}]},{"ID":"20240830102857-2jl7uj9","Type":"NodeParagraph","Properties":{"id":"20240830102857-2jl7uj9","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"粉末特征：暗红棕色。①纤维梭形，顶端钝圆，边缘平整或稍波弯曲，有的显不规则连珠状突起并扭曲，长106-648μm，直径16-68μm，壁厚5-23μm，微木化，胞腔宽窄不一，有的含棕色油状物。②花粉粒众多，极而观三角形，赤道表面观双凸镜形，具3副合沟。③草酸钙簇晶众多，直径4-26μm，多存在于较小的薄壁细胞中。④油室多破碎，分泌细胞界限不清，有的含黄色油状物。"}]},{"ID":"20240830102857-6gmamlf","Type":"NodeParagraph","Properties":{"id":"20240830102857-6gmamlf","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【化学成份】花蕾含挥发油即丁香油。油中主要含有丁香油酚(Eugenol)、乙酰丁香油酚、B-石竹烯(B一Caryophyllene)，以及甲基正戊基酮、水杨酸甲酯、葎草烯(Humuleno)、苯甲醛、苄醇、间甲氧基苯甲醛、乙酸苄酯、胡椒酚(Chavicol)、a一衣兰烯(ａ一Ylangene)等。也有野生品种中不含丁香油酚(平常丁香油中含64-85%)，而含丁香酮(Eugenone)和番樱桃素(Eugenin)。花中还含三萜化合物如齐墩果酸(Oleanolicacid、黄酮和对氧萘酮类鼠李素(Rham-netin)、山奈酚(Kaempferol)、番樱桃素、番樱桃素亭(Eugenitin)、异番樱桃素亭(Isoeugenitin)及其去甲基化合物异番樱桃酚(IsoeugenitoI)。"}]},{"ID":"20240830102857-hru99mj","Type":"NodeParagraph","Properties":{"id":"20240830102857-hru99mj","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830102857-9o3csbr","Type":"NodeParagraph","Properties":{"id":"20240830102857-9o3csbr","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"1.抗菌作用含有1%浓度的丁香的乙醚浸出液，水浸液或含8%浓度的丁香煎剂的沙伯氏培养基，对许兰氏黄癣菌、白色念珠菌等多种致病性真菌均有抑制作用。较高浓度时对新型隐球菌也有抑制作用。醇浸出液与醚浸出液相似，但水浸液较差。丁香油及丁香油酚在1：8000-1:16000时，对致病性真菌即有抑制作用。煎剂1：20-1：640浓度时，对葡萄球菌、链球菌及白喉、变形、绿脓、大肠、痢疾、伤寒等杆菌均有抑制作用，丁香油和丁香油酚在1：2000-1：8000浓度时，对金黄色葡萄球菌及肺炎、痢疾（志贺氏）、大肠、变形、结核等杆菌均有抑菌作用。丁香对流感病毒PR8株也有抑制作用（体外试验）。100%乙醇浸液及1：400丁得油稀释液用平板小杯法对鼠疫杆菌、霍乱弧菌、炭疽杆菌、伤寒杆菌、白喉杆菌、变形杆菌、大肠杆菌、枯草杆菌及金黄色葡萄球菌等抑制作用；丁香油及丁香酚在1:16000-1：64000浓度时对布氏杆菌即有抑制作用，1：8000浓度对鸟型结核杆菌也有抑制作用。"}]},{"ID":"20240830102857-8fg5cu7","Type":"NodeParagraph","Properties":{"id":"20240830102857-8fg5cu7","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用：乙醇浸剂1:100、丁香油及丁香酚1：8000-1:16000对星形奴卡菌、许兰黄癣菌、石膏样小孢子菌及腹股沟表皮癣菌等有抑制作用。"}]},{"ID":"20240830102857-y5lyu5p","Type":"NodeParagraph","Properties":{"id":"20240830102857-y5lyu5p","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"3.驱虫作用：水或醇提取液在体外对猪蛔虫有麻痹或杀死作用，感染蛔虫的狗口服丁香油0.5-1.Og/kg，有驱虫作用，但一次服用并不能将蛔虫全部驱除。丁香油较煎剂为优。50%煎剂及乙醇浸剂在体外对猪蛔虫有杀死作用；丁香油效力更大，其1%的混悬液即有杀死部分蛔虫的作用，0.1-0.5g/kg灌胃对狗蛔虫有驱除作用。"}]},{"ID":"20240830102857-ncfyyty","Type":"NodeParagraph","Properties":{"id":"20240830102857-ncfyyty","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"4.健胃作用：丁香为芳香健胃剂，可缓解腹部气胀、增强消化能力、减轻恶心呕吐。5%丁香油酚乳剂可使胃粘液分泌显着增加，而酸度则不增强；丁香水浸液灌胃，可使巴甫洛夫小胃狗的胃酸排出量和胃蛋白酶活力显着增加。丁香油之作用稍差，连续应用，可使粘液耗竭，而仅分泌非粘液性的渗出物；36小时后方能部分恢复反应（分泌粘液），完全恢复，需数月以后。丁香浸出液对胃液分泌的影响取丁香10g，用150ml蒸馏水浸泡4小时左右，在85-90℃下加热30分钟,煮沸3分钟左右，用双层纱布过滤后用蒸馏水将滤液调至含生药10%的浸出液，为了消除酸度本身对胃液分泌的影响，用NaOH溶液调浸出液至pH=6.8-7.2之间。实验用4只具有三通巴甫洛夫小胃的狗进行，实验在手术后4周开始。狗在实验前禁食16小时以上，但不限饮水。实验时先移去瘘管的管塞，待胃内积存的分泌物流出后将管芯插入直管内。在实验的全过程中主胃和小胃均与外界相通。如果主胃胃液的pH在5以上时，待小胃的胃液流出体外后即开始实验。结果丁香浸出液在20次实验中，12次均有明显升高。在灌注后3小时内，小胃的总酸排出量达0.350±0·044mg当量，与对照比较P＜0.01。在对胃蛋白酶活力影响实验中，灌注丁香浸出液后hl胃蛋白酶的活力开始升高，在灌注后3小时内，每30分钟样品中胃蛋白酶的平均活力达50·5±1.3单位，与对照比较P＜0.05。如在实验前iv硫酸阿托品0.1mg则可使丁香浸出液刺激胃酸分泌的作用受到明显抑制，总酸排出量增多的现象不再出现，可见在丁香浸出液刺激胃酸分泌的机制中有胆碱能机制参与。对4种胃溃疡的影响①对水浸应激性溃疡的影响小鼠，体重22.4±2.3g（X±SD），雌雄各半，随机分每组10只，禁食1夜,ig受试药物后，装入特制的应激盒，浸入20-30℃水中，水位达小鼠颈部，8小时后处死取胃，镜检计算出血点数，计算出溃疡抑制率（%）。结果阳性对照甲氰脒胍200mg/kg；丁香水提物10g/kg和20g/kg均可明显抑制小鼠水浸应激溃疡，②对幽门结扎性溃疡的影响大鼠体重145±16g，雌雄各半，随机分每组10只，禁食24小时后，乙醚麻醉下，按Shay法结扎幽门，ig受试药物，缝合腹壁后19小时，处死大鼠，取胃，镜检前胃部溃疡，分级计算指数及溃疡抑制率（%），结果药物无明显影响。③对消炎痛加乙醇诱发溃疡的影响小鼠体重24.7±1.5g，雌雄各半，随机分每组10只，ig受试药物0.5小时后，ip消炎痛10mg/kg，l小时后ig50%乙醇0.2ml/只，再过l小时处死取胃，镜检条状损害,测量总长度（mm）为溃疡指数，计算溃疡抑制率。结果呋喃唑酮100mg/kg和丁香石油醚提物0.3ml/kg可明显抑制消炎痛加乙醇诱发的溃疡。④对0.6mol/L盐酸所致胃粘膜损伤的影响大鼠体重176±21g。雌雄各半，随机分每组10只，禁食24小时，ig受试药物0.5小时后，ig0.6mol/l盐酸lml/只，再过l小时后处死取胃，镜检条状损害，测量其长度（mm），计算溃疡抑制率（%）。结果甲氰脒胍100mg/kg，丁香水提物及石油醚提物均可明显抑制0.6mol/L盐酸所致胃粘膜损伤。"}]},{"ID":"20240830102857-1u29qe6","Type":"NodeParagraph","Properties":{"id":"20240830102857-1u29qe6","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"5.止痛作用：从小鼠热板试验和抗扭体反应试验结果表明，丁香石油醚提物（0.15ml/kg和0.3ml/kg）和丁香水提物（10g/kg和20g/kg）均可显着延长小鼠痛觉反应潜伏期和显着减少小鼠因冰醋酸0.1ml/10g刺激引起的扭体，反应次数。牙痛丁香油（少量滴入）可消毒龋齿腔，破坏其神经，从而减轻牙痛。"}]},{"ID":"20240830102857-gxm1si6","Type":"NodeParagraph","Properties":{"id":"20240830102857-gxm1si6","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"6.丁香水提物和石油醚提取物对小鼠耐缺氧和受寒等的影响：丁香用石油醚（30-60度）提取2次，每次冷浸3d，回收石油醚得黄褐色油状物，用阿拉伯胶分别配成1.5和8%（v/v）乳状液，药渣中加开水煮沸0.5h，共2次，并浓缩成1ml含生药1g浓度的丁香水提物。耐缺氧：对小鼠常压密闭缺氧耐受力的影响取小鼠30只（雌雄不分），体重22.0±2·5g，分3组，分别ig丁香石油醚提取物和3%阿拉伯胶溶液后l小时，单个放入145ml的广口瓶内，瓶内盛有适量的钠石灰，瓶口用连接测氧仪的橡皮塞密闭，测定瓶内氧含量从21%降至15、10和7%所需的时间（即耗氧速度）、存活时间及死亡时瓶内残存的氧含量。实验数据用t检验统计处理。另取雌性小鼠5O只，体重21.4±2.4g，分为5组，分另ig丁香水提物及自来水后l小时，其中两组分别ip普萘洛尔和生理盐水0.5h后，单个放入容量为120ml的广口瓶内，按上法测定，表明普萘洛尔对3项指标都有明显影响，丁香水提物能延长小鼠存活时间和降低死亡时瓶内氧残存量，说明丁香水提物不是通过减慢耗氧速度，而是通过提高小鼠在低氧条件下的氧利用能力，增强小鼠常压密闭下抗缺氧的能力。"}]},{"ID":"20240830102857-6egrwh1","Type":"NodeParagraph","Properties":{"id":"20240830102857-6egrwh1","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"张口动作：对断头小鼠张口动作持续时间的影响取20g左右小鼠，每组30只，分别ig丁香水提物，石油醚提取物和对照溶液后1小时，自颈部一刀剪下小鼠脑袋，并立即用秒表记录断头小鼠的张口动作持续时间，结果只有丁香水提物10和20g/kg组显着延长张口动作持续时间，10g组P＜0.01，20g组p＜0.05。"}]},{"ID":"20240830102857-zqbikms","Type":"NodeParagraph","Properties":{"id":"20240830102857-zqbikms","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"中毒：对氰化钾中毒和对亚硝酸钠中毒小鼠存活时间的影响取体重20.7±1.7g小鼠，性别不分，每组12-16只，分别ig丁香水或石油醚提取物和对照液后l小时，其中一组ip普萘洛尔20分钟后再iVkCN4mg/kg，并立即记录小鼠存活时间，结果见表3。丁香水提物20g/kg组和普萘洛尔组能延长KCN中毒小鼠的存活时间。又取雄性小鼠，体重22.6±2.0g，每组10只，分另ig丁香水提物，石油醚提取物和对照液后l小时，ipNaNO2800mg/kg，并立即记录存活时间。丁香石油醚提取物0·15和0.30ml/kg组能显着延长NaNO2中毒小鼠存活时间。"}]},{"ID":"20240830102857-jhmv6s6","Type":"NodeParagraph","Properties":{"id":"20240830102857-jhmv6s6","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"耐寒：对受寒小鼠存活时间的影响取雌性小鼠，体重19.7±0.8g，每组12只，禁食禁水24小时，分别ig丁香石油醚提物、水提物和对照液后0.5小时，分装在铁皮小盒内，每盒6只，并将铁皮盒放入-18--20℃冰箱内，每小时开启冰箱，取出死鼠，活鼠合并成每盒6只左右，观察至小鼠全部死亡为止，结果丁香石油醚提物0.30ml/kg组明显缩短受寒小鼠存活时间，可能这一剂量能明显抑制自发活动所致。"}]},{"ID":"20240830102857-nzfs8zd","Type":"NodeParagraph","Properties":{"id":"20240830102857-nzfs8zd","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"7.丁香水提物和石油醚提物对动物胆汁分泌、腹泻和肝损伤的影响7.1对麻醉大鼠胆汁分泌的影响大鼠体重174±17g，雌雄各半，随机分每组8只，乌拉坦麻醉后，按文献方法［药学杂志（日）1987；107（12）：990］行胆管插管术，术后平衡30分钟，十二指肠给药，收集给药前30分钟及给药后4小时内每30分钟的胆汁流量，进行比较，得出流出率（药后流量/药前流量），与对照组相应时相比t检验。结果丁香石油醚提物可明显促进麻醉大鼠胆汁分泌，作用可维持2小时。"}]},{"ID":"20240830102857-p98ytt3","Type":"NodeParagraph","Properties":{"id":"20240830102857-p98ytt3","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"7.2对蓖麻油，番泻叶等药物引起腹泻的影响小鼠体重19.8±1.5g，雌雄各半，随机分每组12只。实验时禁水、食，ig受试药物后0.5，ig蓖麻油0.15ml/只，单个放入底部有直径约15cm垫纸的小桶内，每1小时换垫纸并计算腹泻次数，观察6小时。结果丁香石油醚提物0.3ml/kg，可显着抑制蓖麻油引起的小鼠腹泻。又取小鼠体重20.4±1.7g，雌雄各半，随机分每10只，ig受试药物后0.5小时，ig番泻叶0.4g/只番泻叶（Cassiaangustifolia）20g加水250ml煮沸5分钟，纱布过滤后水浴浓缩成每1ml含1g生药的溶液，以后操作方法同蓖麻油腹泻实验，观察8小时。结果丁香水提物20g/kg可明显抑制番泻叶引起的腹泻。"}]},{"ID":"20240830102857-mg94lfg","Type":"NodeParagraph","Properties":{"id":"20240830102857-mg94lfg","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"7.3对四氯化碳诱发急性肝损伤大鼠SGPT，SGOT的影响大鼠体重221±25g，雌雄各半，随机分为每组9只。受试药物，每日1次，连续5日，末次给药后1小时，igCCl40.3ml/kg,16小时后麻醉状态下颈动脉取血，赖氏法测SGPT，金氏法测SGOT，t测验进行数据处理。结果丁香石油醚提物及水提物对CCl4诱发急性肝炎大鼠的SGPT、SGOT显着升高均未产生明显影响。"}]},{"ID":"20240830102857-wy17l99","Type":"NodeParagraph","Properties":{"id":"20240830102857-wy17l99","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"8.丁香提取物对代谢的影响丁香热水提取物及水溶性组份具有代谢活化的抑制作用及代谢活化Trp-p-2的失活作用的双重作用。醚可溶组份、丁香酚、乙酰丁香酚、异丁香酚可抑制代谢活化，但未见对代谢活化Trp-p-2的失活作用。除去鞣质后的水可溶组份对代谢活化不呈抑制作用，对代谢活化Trp-p-2的失活作用亦小。这些试样不具抗诱变性。根据上述情况提示，丁香热水提取物对诱变的抑制效果可能是由于鞣质、丁香酚等对代谢活化的抑制作用及鞣质对代谢活化Trp-p-2的失活作用所引起。丁香的水、盐水以及乙醇提取物中含有一种含酚和糖醛酸的复杂糖甙，具有抑制脑乙酰胆碱脂酶的作用。"}]},{"ID":"20240830102857-uyl8670","Type":"NodeParagraph","Properties":{"id":"20240830102857-uyl8670","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"9.平喘作用B-丁香烯在丁香挥发油中含量约5.4%，亦是菊科植物艾叶油中的平喘有效成分之一。药理实验，发现它对离体气管平滑肌几乎没有松弛作用，但po疗效与艾叶油相似。药理筛选对豚鼠离体平滑肌有收缩作用。代谢物III为黄色粘稠油状物，是具有活性的代谢物，根据GC-MS、IR、1HMR和半合成实验证实该代谢物为B-丁香烯醇。药理实验表明，B-丁香烯在体内的代谢产物之一B-丁香烯醇，具有较强的豚鼠离体气道平滑肌松弛作用，PD2＝4.36（n=6）；在用于组胺和乙酰胆碱诱发的豚鼠哮喘，以0·2g/kgig能使全部动物（n=8）不发生喘息，其作用持续时间长于6h。B-丁香烯醇，小鼠igLD50\u003e10.8g/kg，表明毒性极小。"}]},{"ID":"20240830102857-xxclr92","Type":"NodeParagraph","Properties":{"id":"20240830102857-xxclr92","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240830102857-hbbiu0w","Type":"NodeParagraph","Properties":{"id":"20240830102857-hbbiu0w","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"毒性小鼠腹腔注射煎剂的半数致死量为1.8g/kg。口服丁香油的花生油溶液为1.6g/kg，煎剂的中毒症状为呼吸抑制及后肢无力。狗口服丁香油的花生油溶液5g/kg，可发生呕吐而死亡。尸检发现胃底及幽门部粘膜红肿并有溃疡及出血点，十二指肠部有浮肿及充血，肺有瘀血点。镜检肝、肾也有瘀血及浊肿，部分肝细胞坏死，心肌水肿。狗如口服2g/kg，仅发生呕吐而不致死亡。大鼠口服丁香油酚，半数致死量为1.93g/kg，中毒症状为后肢麻痹、昏睡、尿失禁并常有血尿，病理解剖发见上消化道呈出血状态，少数有粘膜溃疡，各内脏及腹膜、肠系膜显着充血。对中毒大鼠曾用印防己毒素、可拉明、士的宁、咖啡因及五甲烯四氮唑等解救，但无明显效果。"}]},{"ID":"20240830102857-dtrcprd","Type":"NodeParagraph","Properties":{"id":"20240830102857-dtrcprd","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"丁香油：小鼠igLD501.6g/kg，丁香酚：小鼠igLD503.0g/kg；大鼠igLD502.68g/kg，LD501.93g/kg，LD502.0g/kg。丁香水提物或丁香水提物加咖啡因，用于成年雄性果蝇的生殖细胞减数分裂前或减数分裂后，均未见诱变作用。另外，B-丁香烯家兔ig0.3ml/次，1日2次，连续给药30日，对家兔生长、血色素、白血球总数、尿蛋白、尿镜检、肝功能（B.S.P）、肾功能及心律均有明显影响。丁香石油醚提物小鼠1次ig，观察7日的LD50为1.74±0.24ml/kg。丁香水提物ig小鼠20只120（生药）/kg，观察7日，无死亡。"}]},{"ID":"20240830102857-2emm5sr","Type":"NodeParagraph","Properties":{"id":"20240830102857-2emm5sr","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830102857-u3b1wfz","Type":"NodeParagraph","Properties":{"id":"20240830102857-u3b1wfz","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末1g，置小试管中，加氯仿3ml，浸渍5min，吸取氯仿浸液2-3滴于栽玻片上，速加3%氢氧化钠的氯化钠饱和液1滴，加盖破片，片刻即有簇状细针形丁香酚钠结晶产生。"}]},{"ID":"20240830102857-503qhbu","Type":"NodeParagraph","Properties":{"id":"20240830102857-503qhbu","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"（2）取以上氯仿浸出液，滴加适量50%氢氧化钾溶液与丁香酚作用，形成丁香酚钾的针状结晶。"}]},{"ID":"20240830102857-c8mxx1g","Type":"NodeParagraph","Properties":{"id":"20240830102857-c8mxx1g","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0.5g，加已醚5ml，振摇数分钟，滤过，滤液作为供试品溶液。另取丁香酚为对照品，加已醚制成每1ml含16μl的溶液。吸取上述溶液各5ml，分别点样于同一硅胶G薄层板上，以石油醚（60-90℃）醋酸已酯（9：1）展开，取出，晾干，喷以5%香草醛硫酸溶液，于105℃烘干。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240830102857-mrnzqo3","Type":"NodeParagraph","Properties":{"id":"20240830102857-mrnzqo3","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【炮制】采下后除去花梗，晒干。"}]},{"ID":"20240830102857-twpbapn","Type":"NodeParagraph","Properties":{"id":"20240830102857-twpbapn","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240830102857-3jue23t","Type":"NodeParagraph","Properties":{"id":"20240830102857-3jue23t","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【归经】归脾；胃；肾经"}]},{"ID":"20240830102857-ys359g6","Type":"NodeParagraph","Properties":{"id":"20240830102857-ys359g6","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中降逆；温肾助阳。主呃逆；脘腹冷痛；食少叶泻；肾虚阳痿；腰膝酸冷；阴疽"}]},{"ID":"20240830102857-imq8reg","Type":"NodeParagraph","Properties":{"id":"20240830102857-imq8reg","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服，煎汤，2-5g；或入丸、散。外用：适量，感想末敷贴。"}]},{"ID":"20240830102857-p32wun0","Type":"NodeParagraph","Properties":{"id":"20240830102857-p32wun0","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【注意】热病及阴虚内热者忌服。李杲：气血胜者不可服，丁香益其气也。《本草经疏》：一切有火热证者忌之，非属虚寒，概勿施用。"}]},{"ID":"20240830102857-lcmd5ug","Type":"NodeParagraph","Properties":{"id":"20240830102857-lcmd5ug","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【附方】1.治伤寒咳噫不止，及哕逆不定：丁香一两，干柿蒂一两。焙干，捣罗为散。每服一钱，煎人参汤下，无时服。(《简要济众方》)2.治小儿吐逆：丁香、半夏(生用)各一两。同研为细末，姜汁和丸，如绿豆大。姜汤下三、二十丸。(《百一选方》)3.治朝食暮吐：丁香十五个研末，甘蔗汁、姜汁和丸莲子大，噙咽之。(《摘元方》)4.治霍乱，止吐：丁香十四枚，以酒五合，煮取二合，顿服之。用水煮之亦佳。(《千金翼方》)5.治久心痛不止：丁香半两，桂心一两。捣细，罗为散，每于食前，以热酒调下一钱。(《圣惠方》)3.治痈疽恶肉：丁香末敷之，外用膏药护之。(《怪证奇方》)7.治食蟹致伤：丁香末，姜汤服五分。(《证治要诀》)8.治鼻中息肉：丁香绵裹纳之。(《圣惠方》)"}]},{"ID":"20240830102857-brjx28i","Type":"NodeParagraph","Properties":{"id":"20240830102857-brjx28i","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830102857-sj73i2f","Type":"NodeParagraph","Properties":{"id":"20240830102857-sj73i2f","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使（丁香）。有雌雄，雄颗小，雌颗大，似枣核。方中多使雌，力大，膏煎中用雄。"}]},{"ID":"20240830102857-6eyjg6s","Type":"NodeParagraph","Properties":{"id":"20240830102857-6eyjg6s","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"2．《开宝本草》：丁香，二月、八月采。按广州送丁香图，树高丈余，叶似栎叶，花圆细，黄色，凌冬不雕。医家所用惟用根。子如钉子，长三、四分，紫色，中有粗大如山茱萸者，俗呼为母丁香，可入心腹之药尔。......温脾胃，止霍乱。（治）壅胀，风毒诸肿，齿疳NIW。3.《本草经疏》：丁香，其主温脾胃、止霍乱壅胀者，盖脾胃为仓凛之官，饮食生冷，伤于脾胃，留而不去，则为壅塞胀满，上涌下泄，则为挥霍撩乱，辛温暖脾胃而行滞气，则霍乱止而壅胀消矣。齿疳者，亦阳明湿热上攻也，散阳明之邪，则疳自除。疗风毒诸肿者，辛温散结，而香气又能走窍除秽浊也。4.《本草通玄》：丁香，温中健胃，须于丸剂中同润药用乃佳。独用多用，易于僭上，损肺伤目。5.《本草新编》：丁香，有雌雄之分，其实治病无分彼此。直中阴经之病，最宜用之，但不可用之于传经之伤寒也。6.《得配本草》：丁香，得五味子治奔豚，配甘蔗、姜汁治干呕。肉桂温能发表，丁香温能和胃。7.《药性论》：治冷气腹痛。《海药本草》：主风疳GUI，骨槽劳臭。治气，乌髭发，杀虫，疗五痔，辟恶去邪。治奶头花，止五色毒痢，正气，止心腹痛。8.《日华子本草》：治口气，反胃，疗肾气，奔豚气，阴痛,壮阳，暖腰膝，杀酒毒，消痃癖，除冷劳。9.《本草蒙筌》：止气忒、气逆。10.《纲目》：治虚哕，小儿吐泻，痘疮胃虚灰白不发。11.《本草正》：温中快气。治上焦呃逆，除胃寒泻痢，七情五郁。12.《本草汇》：疗胸痹、阴痛，暖阴户。13.《医林纂要》：补肝、润命门，暖胃、去中寒，泻肺、散风湿。14.《本草再新》：开九窍，舒郁气，去风，行水。15.《药材学》：治慢性消化不良，胃肠充气及子宫疝痛。"}]},{"ID":"20240830102857-4wa6p7s","Type":"NodeParagraph","Properties":{"id":"20240830102857-4wa6p7s","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【临床应用】治癣。丁香15g，加入70%酒精至100ml，浸48小时后去渣。每日外搽患处3次，观察31例病史在2年以上的体癣及足癣患者，一般在治疗1日后症状即见消退，2日后患处开始有皮屑脱落。病史较长或曾经其它癣药治疗而不能控制者，则于治疗后2-3日症状才开始消退，一般经3-5日亦能治愈。但有20%左右治愈后仍反复发作。用1:10的丁香煎液外涂，每日1-3次，治疗数种皮肤霉菌病共31例，结果8例临床痊愈，10例显效，8例有效，5例无效。有效病例通常在涂药后3-7日痒感减轻，炎症减退，落屑减少，以后局部症状逐渐好转。治疗期中如中断用药，效果多不明显或无效。疗效与病原菌末见明显关系，曾对6例治愈患者进行短期随访，1例于1个月后复发，5例经2-12月观察未见复发。"}]},{"ID":"20240830102857-9t1nlpp","Type":"NodeParagraph","Properties":{"id":"20240830102857-9t1nlpp","updated":"20240830102927"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830102859-rhc6an6","Type":"NodeThematicBreak","Properties":{"id":"20240830102859-rhc6an6","updated":"20240830102927"}},{"ID":"20240830102900-1q5i5t5","Type":"NodeParagraph","Properties":{"id":"20240830102900-1q5i5t5","updated":"20240830102927"}}]}