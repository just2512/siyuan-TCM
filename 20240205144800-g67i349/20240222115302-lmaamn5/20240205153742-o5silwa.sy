0724154112-xkf6a0l","Type":"NodeParagraph","Properties":{"id":"20240724154112-xkf6a0l","updated":"20240724154923"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 666px;","style":"width: 656px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240724154112-92jka0x.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 656px;\" parent-style=\"width: 666px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山鸡椒 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山鸡椒 18-20240724154923-fbfg8ud.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724154039-8akh3rq","Type":"NodeParagraph","Properties":{"id":"20240724154039-8akh3rq","updated":"20240902165804"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 664px;","style":"width: 654px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240724154039-v4dt00w.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 654px;\" parent-style=\"width: 664px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 591px;","style":"width: 581px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山鸡椒 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山鸡椒 16-20240724154726-68q8jax.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724154726-uhlbtan","Type":"NodeParagraph","Properties":{"id":"20240724154726-uhlbtan","updated":"20240902165803"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 640px;","style":"width: 630px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山鸡椒 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山鸡椒 11-20240724153740-dm2962q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 630px;\" parent-style=\"width: 640px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724151531-svxkxos","Type":"NodeParagraph","Properties":{"id":"20240724151531-svxkxos","updated":"20240724151542"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：即山鸡椒的成熟果实；"}]},{"ID":"20240724151531-cdllalh","Type":"NodeThematicBreak","Properties":{"id":"20240724151531-cdllalh"}},{"ID":"20240902165821-ye5hkst","Type":"NodeParagraph","Properties":{"id":"20240902165821-ye5hkst","updated":"20240902165828"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：荜澄茄"}]},{"ID":"20240902165821-36tmlnj","Type":"NodeParagraph","Properties":{"id":"20240902165821-36tmlnj","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄《全国中草药汇编》"}]},{"ID":"20240902165821-co907rh","Type":"NodeParagraph","Properties":{"id":"20240902165821-co907rh","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【拼音名】BìChénɡQié"}]},{"ID":"20240902165821-7xr666u","Type":"NodeParagraph","Properties":{"id":"20240902165821-7xr666u","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSLITSEAE"}]},{"ID":"20240902165821-u1uozn5","Type":"NodeParagraph","Properties":{"id":"20240902165821-u1uozn5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【别名】山苍子、山鸡椒、山香椒、山香根、豆豉姜、木姜子[海南]"}]},{"ID":"20240902165821-nsit5ml","Type":"NodeParagraph","Properties":{"id":"20240902165821-nsit5ml","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【来源】本品为樟科木姜子属植物山鸡椒Litseacubeba（Lour.）Pers.[L.citrataBlume]，以果实（荜澄茄）、根及叶。秋季果实成熟时采收，根、叶全年可采，除去杂质，晒干。"}]},{"ID":"20240902165821-poopkuv","Type":"NodeParagraph","Properties":{"id":"20240902165821-poopkuv","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶灌木或小乔木，高可达10米，全体无毛，有强烈姜香。根圆锥形，灰白色。茎皮灰褐色，小枝细长，幼时被短毛。叶互生，叶柄长达1厘米，长圆状披针形或长椭圆形，上面亮绿色，下面灰绿色，幼时被毛，后无毛。春季先叶开淡黄色小花。果球形如黄豆大，香辣，成熟时黑色，基部有6齿状宿存花被。"}]},{"ID":"20240902165821-ez75cyz","Type":"NodeParagraph","Properties":{"id":"20240902165821-ez75cyz","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈类球形，直径4～6mm。表面棕褐色至黑褐色，有网状皱纹。基部偶有宿萼及细果梗。除去外皮可见硬脆的果核，种子1，子叶2，黄棕色，富油性。气芳香，味稍辣而微苦。"}]},{"ID":"20240902165821-6tg1gym","Type":"NodeParagraph","Properties":{"id":"20240902165821-6tg1gym","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902165821-w6ijc5t","Type":"NodeParagraph","Properties":{"id":"20240902165821-w6ijc5t","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、肾、膀胱经。"}]},{"ID":"20240902165821-wldjl1y","Type":"NodeParagraph","Properties":{"id":"20240902165821-wldjl1y","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中散寒，行气止痛。根：用于胃寒呕逆，脘腹冷痛，寒疝腹痛，寒湿郁滞，小便浑浊。叶：外用治痈疖肿痛，乳腺炎，虫蛇咬伤，预防蚊虫叮咬。子：感冒头痛，消化不良，胃痛。"}]},{"ID":"20240902165821-rooxsu8","Type":"NodeParagraph","Properties":{"id":"20240902165821-rooxsu8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【用法用量】1.5～3g；子：1～3钱叶外用适量，鲜叶捣烂敷患处。"}]},{"ID":"20240902165821-osp4iqm","Type":"NodeParagraph","Properties":{"id":"20240902165821-osp4iqm","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902165821-nanwi9l","Type":"NodeParagraph","Properties":{"id":"20240902165821-nanwi9l","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902165821-otc9qyw","Type":"NodeParagraph","Properties":{"id":"20240902165821-otc9qyw","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄《*辞典》"}]},{"ID":"20240902165821-kd32z1e","Type":"NodeParagraph","Properties":{"id":"20240902165821-kd32z1e","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【出处】《开宝本草》"}]},{"ID":"20240902165821-mdf2nsk","Type":"NodeParagraph","Properties":{"id":"20240902165821-mdf2nsk","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【拼音名】BìChénɡQié"}]},{"ID":"20240902165821-h38zn86","Type":"NodeParagraph","Properties":{"id":"20240902165821-h38zn86","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【别名】澄茄（徐表《南州记》），毗陵茄子（《开宝本草》），毕澄茄（《纲目》），毕茄（《本草求真》）。"}]},{"ID":"20240902165821-bc6d1o8","Type":"NodeParagraph","Properties":{"id":"20240902165821-bc6d1o8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902165821-4ntf7s8","Type":"NodeParagraph","Properties":{"id":"20240902165821-4ntf7s8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"为胡椒科植物荜澄茄或樟科植物山鸡椒的果实。"}]},{"ID":"20240902165821-1ns5en7","Type":"NodeParagraph","Properties":{"id":"20240902165821-1ns5en7","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①荜澄茄"}]},{"ID":"20240902165821-o2arul0","Type":"NodeParagraph","Properties":{"id":"20240902165821-o2arul0","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"在果实充分成长而未成熟仍呈青色时采收，连果枝摘下，晒干。干燥后，摘下果实（每粒须连小柄）。"}]},{"ID":"20240902165821-so5yiuh","Type":"NodeParagraph","Properties":{"id":"20240902165821-so5yiuh","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②山鸡椒"}]},{"ID":"20240902165821-6k36yco","Type":"NodeParagraph","Properties":{"id":"20240902165821-6k36yco","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"秋季果实成熟时连枝摘下，除去枝叶，晒干。"}]},{"ID":"20240902165821-jcteia9","Type":"NodeParagraph","Properties":{"id":"20240902165821-jcteia9","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902165821-30tyqwu","Type":"NodeParagraph","Properties":{"id":"20240902165821-30tyqwu","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①荜澄茄"}]},{"ID":"20240902165821-0ba3gi9","Type":"NodeParagraph","Properties":{"id":"20240902165821-0ba3gi9","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"常绿攀援性藤本，茎长约6米。叶互生；叶片椭圆状卵形或长卵形，先端渐尖，基部圆形或斜心脏形，全缘，两面均光滑无毛。花单性，雌雄异株，成单生的穗状花序，长约10厘米；花小，白色，无花被。核果球形，直径约5毫米，黑褐色。果期8～9月。"}]},{"ID":"20240902165821-fs6cx2b","Type":"NodeParagraph","Properties":{"id":"20240902165821-fs6cx2b","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"分布印度尼西亚、马来半岛，印度、西印度群岛等地。"}]},{"ID":"20240902165821-pb9sboq","Type":"NodeParagraph","Properties":{"id":"20240902165821-pb9sboq","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②山鸡椒，又名:山苍树、香叶、山番椒、山姜子、野胡椒、香柴子、香粉树、粉果木、过山香、土澄茄、满山香、木香子、木筑子皮。"}]},{"ID":"20240902165821-e5pr2rj","Type":"NodeParagraph","Properties":{"id":"20240902165821-e5pr2rj","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"落叶灌木或小乔木，高约5米，除嫩枝嫩叶有绢毛外，其它部分无毛。枝叶芳香。叶互生，纸质，披针形或长椭圆状披针形，长5～11厘米，宽1.5～3厘米，先端渐尖，基部楔形，上面绿色，下面粉绿色；叶柄纤细，长10～20毫米。花先叶开放或同时开放，单性，雌雄异株；伞形花序单生或束生，总苞片4，黄白色，有缘毛；每1花序有花4～6朵；雄花直径约3毫米，花被裂片6，倒卵形，雄蕊9，排列成三轮，中央有小椭圆形的退化雌蕊；雌花直径约2毫米，子房卵形，花柱短，柱头头状。浆果状核果，球形，直径4～6毫米，黑色。种子有脊棱。花期2～3月。果期7～8月。"}]},{"ID":"20240902165821-ea3634b","Type":"NodeParagraph","Properties":{"id":"20240902165821-ea3634b","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"生于灌丛、疏林或林中路旁、水边。分布长江流域以南各地。"}]},{"ID":"20240902165821-ug9xdqc","Type":"NodeParagraph","Properties":{"id":"20240902165821-ug9xdqc","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902165821-q0cs7v8","Type":"NodeParagraph","Properties":{"id":"20240902165821-q0cs7v8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①荜澄茄"}]},{"ID":"20240902165821-zw23euh","Type":"NodeParagraph","Properties":{"id":"20240902165821-zw23euh","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"未成熟的干燥核果，上部近圆球形，直径3～6毫米。表面暗棕色至棕黑色，有网状皱纹，顶端有一小突起的柱头遗迹，不甚明显。基部果皮延长，形成细直的假果柄，长3～7毫米，直径1毫米以下，表面有纵皱纹。外果皮和中果皮稍柔软，内果皮薄而坚脆。内含未成熟种子1粒，黄棕色，富油质，有的皱缩干瘪。气强烈芳香，味苦。"}]},{"ID":"20240902165821-971p8yp","Type":"NodeParagraph","Properties":{"id":"20240902165821-971p8yp","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"产印度尼西亚、马来西亚等地。"}]},{"ID":"20240902165821-yde56jz","Type":"NodeParagraph","Properties":{"id":"20240902165821-yde56jz","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②山鸡椒"}]},{"ID":"20240902165821-wbcywi5","Type":"NodeParagraph","Properties":{"id":"20240902165821-wbcywi5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"又名:山胡椒（《滇南本草》），味辣子（《分类草药性》），山苍子、木姜子。成熟的果实，近圆球形，直径3～6毫米。外皮棕黑色或黑褐色，有微细的网状皱纹。果基部常可见残留的小形宿萼，具6齿，下连细长的果柄，均易脱落。外果皮及中果皮柔软多油，内果皮薄而坚脆。内含种子1粒，子叶2片，黄棕色，富油质，旺根细小，朝向果实的顶端。气强烈芳香，略如老姜，味稍辛辣而微苦。以粒圆、气味浓厚、富油质者为佳。"}]},{"ID":"20240902165821-dmzpezd","Type":"NodeParagraph","Properties":{"id":"20240902165821-dmzpezd","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"主产广西、浙江、江苏、安徽。此外。四川、云南、广东、贵州、湖南、湖北、江西、福建等地亦产。目前的商品荜澄茄均用此种。"}]},{"ID":"20240902165821-11z7d4k","Type":"NodeParagraph","Properties":{"id":"20240902165821-11z7d4k","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902165821-83of67c","Type":"NodeParagraph","Properties":{"id":"20240902165821-83of67c","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄果实含挥发油10～18％、荜澄茄素2.5％、树脂3％、荜澄茄酸1.7％、脂肪油1.5％、淀粉1.8％、树胶8％、色素7％。挥发油主成分为d-香桧烯约33％、d-蒈烯及1，4-枝叶素共约12％、d-松油醇11％及l-杜松油烯等。果实中尚含荜澄茄内酯。陈久品中并含荜澄茄脑。"}]},{"ID":"20240902165821-bfsqet1","Type":"NodeParagraph","Properties":{"id":"20240902165821-bfsqet1","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"山鸡椒果实含挥发油约5％，脂肪油约40％。挥发油主为柠檬醛、甲基庚烯酮以及少量柠檬烯和芳樟醇。脂肪油中含不皂化物1.3％，其中谷甾醇占3.5％。"}]},{"ID":"20240902165821-o0lhm0z","Type":"NodeParagraph","Properties":{"id":"20240902165821-o0lhm0z","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"山鸡椒叶含柠檬醛、1，8-桉叶素等。印度尼西亚西部所产山鸡椒，其树叶中的挥发油含柠檬醛5～7％、香茅醛29～40％、1，8-桉叶素10～22％、芳樟醇40～50％。而印尼中部产的树叶，其挥发油中则含柠檬醛与香茅醛3～9％，1，8-桉叶素66％，芳樟醇与松油醇7％，萜13％。"}]},{"ID":"20240902165821-hz3ox75","Type":"NodeParagraph","Properties":{"id":"20240902165821-hz3ox75","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"山鸡椒树皮含生物碱六驳碱、异紫堇定、N-甲基六驳碱、木兰箭毒碱。树皮含柠檬醛，但不含香茅醛。"}]},{"ID":"20240902165821-58a2t3y","Type":"NodeParagraph","Properties":{"id":"20240902165821-58a2t3y","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902165821-kx020a2","Type":"NodeParagraph","Properties":{"id":"20240902165821-kx020a2","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄果实对粘膜有局部刺激作用，并能吸收，对泌尿道及呼吸道粘膜也能发挥此种作用；口服其挥发油，对尿路有某些防腐作用。"}]},{"ID":"20240902165821-dshds5c","Type":"NodeParagraph","Properties":{"id":"20240902165821-dshds5c","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄的作用主要由荜澄茄酸引起。荜澄茄素无重要生理作用。"}]},{"ID":"20240902165821-49pwjlb","Type":"NodeParagraph","Properties":{"id":"20240902165821-49pwjlb","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"家兔口服山鸡椒流浸膏1克/公斤，可使尿量及氯化物排泄量增加，而口服煎剂或流浸膏2克/公斤则无作用。"}]},{"ID":"20240902165821-0gy9mvu","Type":"NodeParagraph","Properties":{"id":"20240902165821-0gy9mvu","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"山鸡椒5％的水浸液，可杀灭淡色库蚊幼虫，其油剂或酊甘油涂擦于皮肤可避蚊。"}]},{"ID":"20240902165821-ukl8eaw","Type":"NodeParagraph","Properties":{"id":"20240902165821-ukl8eaw","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"山鸡椒体外直接观察及培养，对日本血吸虫有抑制作用，但体内试验无效。"}]},{"ID":"20240902165821-3dpvuiv","Type":"NodeParagraph","Properties":{"id":"20240902165821-3dpvuiv","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"六驳碱毒性很大，类似士的宁对脊髓的兴奋作用。"}]},{"ID":"20240902165821-gf7smzy","Type":"NodeParagraph","Properties":{"id":"20240902165821-gf7smzy","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902165821-v20nw93","Type":"NodeParagraph","Properties":{"id":"20240902165821-v20nw93","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"拣去杂质，摘去果柄，洗净，晒干。"}]},{"ID":"20240902165821-4e6xz0l","Type":"NodeParagraph","Properties":{"id":"20240902165821-4e6xz0l","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》:\"凡使荜澄茄，采得后，去柄及皱皮了，用酒浸蒸，从巳至酉出，细杵任用。\""}]},{"ID":"20240902165821-z9o2je1","Type":"NodeParagraph","Properties":{"id":"20240902165821-z9o2je1","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902165821-htq8nnn","Type":"NodeParagraph","Properties":{"id":"20240902165821-htq8nnn","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902165821-selsxno","Type":"NodeParagraph","Properties":{"id":"20240902165821-selsxno","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①《海药本草》:\"味辛苦，微温，无毒。\""}]},{"ID":"20240902165821-g6h193s","Type":"NodeParagraph","Properties":{"id":"20240902165821-g6h193s","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》:\"味辛，温，无毒。\""}]},{"ID":"20240902165821-em3bxij","Type":"NodeParagraph","Properties":{"id":"20240902165821-em3bxij","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》:\"味辛，大热，有毒。\""}]},{"ID":"20240902165821-gc5mhra","Type":"NodeParagraph","Properties":{"id":"20240902165821-gc5mhra","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902165821-yjc6dnj","Type":"NodeParagraph","Properties":{"id":"20240902165821-yjc6dnj","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"入脾、肾经。"}]},{"ID":"20240902165821-3wc5y5e","Type":"NodeParagraph","Properties":{"id":"20240902165821-3wc5y5e","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》:\"入脾、肾二经。\""}]},{"ID":"20240902165821-rhpuzys","Type":"NodeParagraph","Properties":{"id":"20240902165821-rhpuzys","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②《得配本草》:\"入足太阳经气分。\""}]},{"ID":"20240902165821-j6wa9zb","Type":"NodeParagraph","Properties":{"id":"20240902165821-j6wa9zb","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"③《要药分剂》:\"入脾、胃、肾、膀胱四经。\""}]},{"ID":"20240902165821-sdtu2e2","Type":"NodeParagraph","Properties":{"id":"20240902165821-sdtu2e2","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902165821-oplpi55","Type":"NodeParagraph","Properties":{"id":"20240902165821-oplpi55","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"温暖脾肾，健胃消食。治食积气胀，脘腹冷痛，反胃呕吐，肠鸣泄泻，痢疾，痰癖。"}]},{"ID":"20240902165821-azjvbq8","Type":"NodeParagraph","Properties":{"id":"20240902165821-azjvbq8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①《海药本草》:\"主心腹卒痛，霍乱吐泻，痰癖冷气。\""}]},{"ID":"20240902165821-5oieiyo","Type":"NodeParagraph","Properties":{"id":"20240902165821-5oieiyo","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》:\"治一切气，并肾气膀胱冷。\""}]},{"ID":"20240902165821-aha11c1","Type":"NodeParagraph","Properties":{"id":"20240902165821-aha11c1","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》:\"主下气消食，皮肤风，心腹间气胀，令人能食。\""}]},{"ID":"20240902165821-dveweep","Type":"NodeParagraph","Properties":{"id":"20240902165821-dveweep","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》:\"泡酒吃，治面寒疼痛，暖腰膝，壮阳道，治阳痿。\""}]},{"ID":"20240902165821-q8irb4r","Type":"NodeParagraph","Properties":{"id":"20240902165821-q8irb4r","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》:\"暖脾胃，止呕吐哕逆。\""}]},{"ID":"20240902165821-k5ygg7g","Type":"NodeParagraph","Properties":{"id":"20240902165821-k5ygg7g","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑥《本草求原》:\"治反胃吐黑绿水。\""}]},{"ID":"20240902165821-jw31ttq","Type":"NodeParagraph","Properties":{"id":"20240902165821-jw31ttq","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑦《现代实用中药》:\"治淋疾。\""}]},{"ID":"20240902165821-ls908vu","Type":"NodeParagraph","Properties":{"id":"20240902165821-ls908vu","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服:煎汤，0.5～1钱；或入丸、散。外用:研末擦牙或搐鼻。"}]},{"ID":"20240902165821-kqsekmg","Type":"NodeParagraph","Properties":{"id":"20240902165821-kqsekmg","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【注意】《本经逢原》:\"阴虚血分有热，发热咳嗽禁用。\""}]},{"ID":"20240902165821-ig2caz3","Type":"NodeParagraph","Properties":{"id":"20240902165821-ig2caz3","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902165821-w9a1ew0","Type":"NodeParagraph","Properties":{"id":"20240902165821-w9a1ew0","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①治脾胃虚满，寒气上攻于心，心腹刺痛，两胁作胀，头昏，四肢困倦，吐逆，发热，泄泻，饱闷:荜澄茄、高良姜、肉桂、丁香、厚朴（姜汁炒）、桔梗（去芦）、陈皮、三棱（泡醋炒）、甘草各一两五钱，香附（制）三两。为细末。每服四钱，姜三片，水一盏，煎七分，和渣服。（《扁鹊心书》荜澄茄散）"}]},{"ID":"20240902165821-xa7rwk5","Type":"NodeParagraph","Properties":{"id":"20240902165821-xa7rwk5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②治脾胃虚弱，胸膈不快，不进饮食:荜澄茄不拘多少。为细末，姜汁打神曲末煮糊为丸，如桐子大。每饭七十丸，食后淡姜汤下。（《济生方》荜澄茄丸）"}]},{"ID":"20240902165821-23vz4kv","Type":"NodeParagraph","Properties":{"id":"20240902165821-23vz4kv","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"③治中焦痞塞，气逆上攻，心腹疞痛:荜澄茄半两，良姜二两，神曲（炒）、青皮（去白）、官桂（去皮）各一两，阿魏半两（醋、面裹煨熟）。上为末，醋、面糊为丸如桐子大。每服二十丸，生姜汤下，不计时候。（《宣明论方》荜澄茄丸）"}]},{"ID":"20240902165821-uxkui2s","Type":"NodeParagraph","Properties":{"id":"20240902165821-uxkui2s","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"④治伤寒呃噫日夜不定者:荜澄茄三分，高良姜三分。二物捣罗为散。每服二钱，水六分，煎十余沸，入少许醋搅匀，和滓如茶，热呷。（《本草图经》）"}]},{"ID":"20240902165821-o4ircut","Type":"NodeParagraph","Properties":{"id":"20240902165821-o4ircut","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑤治噎食不纳:荜澄茄、白豆蔻等分。为末。干舐之。（《寿域神方》）"}]},{"ID":"20240902165821-nnnz1tp","Type":"NodeParagraph","Properties":{"id":"20240902165821-nnnz1tp","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑥治支气管哮喘:山鸡椒果实、胡颓子叶、地黄根（野生地）各五钱。水煎服。忌食酸、辣。"}]},{"ID":"20240902165821-wtp9u37","Type":"NodeParagraph","Properties":{"id":"20240902165821-wtp9u37","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑦治中暑:山鸡椒果实一至二钱。水煎服。"}]},{"ID":"20240902165821-34qxwz2","Type":"NodeParagraph","Properties":{"id":"20240902165821-34qxwz2","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"⑧治无名肿毒:山鸡椒鲜果实适量。捣烂外敷。（⑥方以下出《浙江民间常用草药》）"}]},{"ID":"20240902165821-91jpvfv","Type":"NodeParagraph","Properties":{"id":"20240902165821-91jpvfv","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902165821-zx98o8e","Type":"NodeParagraph","Properties":{"id":"20240902165821-zx98o8e","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"①《本草述钩元》:\"毕澄茄，疗肾气膀胱冷，少类于蜀椒；治阴逆下气塞，少类于吴萸，以温为补，洵属外伤于寒及内虚为寒之对药。至于温益脾胃，令人能食，其本在暖补肾与膀胱之气也。\""}]},{"ID":"20240902165821-uyauq3e","Type":"NodeParagraph","Properties":{"id":"20240902165821-uyauq3e","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》:\"毕澄茄，功专治膀胱冷气，得白豆蔻治噎食不纳，得高良姜治寒呃，得薄荷、荆芥治鼻塞不通，得毕拨为末擦牙，治齿浮热痛，若蜈蚣咬伤，毕澄茄研末调敷。\""}]},{"ID":"20240902165821-vqyf0jz","Type":"NodeParagraph","Properties":{"id":"20240902165821-vqyf0jz","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗阿米巴痢疾:将荜澄茄子连皮研细，装入胶囊中服。每次1克，隔2小时1次，每日4次，视病情轻重连服3～5日。如服后有胃肠道刺激反应者，可加入等量碳酸镁。治疗60例，其中42例治恬复查大便，结果38例未再发现阿米巴原虫，症状消失；4例无效。未复查大便的18例中，治后16例症状消失，2例无效。"}]},{"ID":"20240902165821-q8b7dj8","Type":"NodeParagraph","Properties":{"id":"20240902165821-q8b7dj8","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902165821-mq0p41a","Type":"NodeParagraph","Properties":{"id":"20240902165821-mq0p41a","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"荜澄茄《中华本草》"}]},{"ID":"20240902165821-g54atx1","Type":"NodeParagraph","Properties":{"id":"20240902165821-g54atx1","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【出处】出自《开宝本草》《海药本草》：谨按《广志》云，（毕澄茄）生诸海，嫩胡椒也。青时就树采摘造之，有柄粗而蒂圆是也。古方偏用染发，不用治病也。"}]},{"ID":"20240902165821-sywkwuu","Type":"NodeParagraph","Properties":{"id":"20240902165821-sywkwuu","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【拼音名】BìChénɡQié"}]},{"ID":"20240902165821-4twbvuk","Type":"NodeParagraph","Properties":{"id":"20240902165821-4twbvuk","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【英文名】MountainSpicyTreeFruit,FruitofMountainSpicyTree"}]},{"ID":"20240902165821-o90uauf","Type":"NodeParagraph","Properties":{"id":"20240902165821-o90uauf","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【别名】澄茄、毗陵茄子、毕茄。"}]},{"ID":"20240902165821-vpgsoss","Type":"NodeParagraph","Properties":{"id":"20240902165821-vpgsoss","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902165821-5qngm08","Type":"NodeParagraph","Properties":{"id":"20240902165821-5qngm08","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"药材基源：为胡椒科植物荜澄茄的果实。"}]},{"ID":"20240902165821-2d4q165","Type":"NodeParagraph","Properties":{"id":"20240902165821-2d4q165","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：PipercubebaL."}]},{"ID":"20240902165821-3c56x5a","Type":"NodeParagraph","Properties":{"id":"20240902165821-3c56x5a","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在果实充分成长而未成熟仍呈青色时采收，连果枝摘下，晒干。干燥后摘下果实（每粒须连小柄）。"}]},{"ID":"20240902165821-k1xdl85","Type":"NodeParagraph","Properties":{"id":"20240902165821-k1xdl85","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【原形态】荜澄茄常绿攀援藤本，长约6m。叶互生，椭圆状卵形或长卵形，先端渐尖，基部圆形或斜心形，全缘，两面均光滑无毛。花单性，雌雄异株，成单生的德状花序，长约10cm；花小，白色，无花被。核果球形，直径约5mm，黑褐色。果期8-9月。"}]},{"ID":"20240902165821-s6u7sih","Type":"NodeParagraph","Properties":{"id":"20240902165821-s6u7sih","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902165821-j712bze","Type":"NodeParagraph","Properties":{"id":"20240902165821-j712bze","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"生态环境：我国广东、海南、广西等地有引种栽培。"}]},{"ID":"20240902165821-k3duacb","Type":"NodeParagraph","Properties":{"id":"20240902165821-k3duacb","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于印度尼西亚、马来半岛、印度、西印度群岛等地。"}]},{"ID":"20240902165821-mmdevpf","Type":"NodeParagraph","Properties":{"id":"20240902165821-mmdevpf","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别果实上部近圆球形，直径3-6mm。表面暗棕色至黑棕色，有网状皱纹，先端有一不甚明显的小突起柱头残迹；基部果皮延长，形成细直的假果柄，长3-7mm，直径约lmm，表面有纵皱纹。外果皮和中果皮稍柔软，内果皮薄而坚脆，内含未成熟种子1粒，黄棕色，富油质，有的皱缩干瘪。气强烈芳香，味苦以粒大、油性足、香气浓者为佳。"}]},{"ID":"20240902165821-2lzmn75","Type":"NodeParagraph","Properties":{"id":"20240902165821-2lzmn75","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【化学成份】荜澄茄果实含挥发油和多种木脂体，已分得：荜澄茄脂素（cubebin），荜澄茄酸（cubebicacid），荜澄茄内酯（cubebinolide），荜澄茄脑（cubebencamPhor），荜澄茄烯（cadinene)，双环倍半水芹烯（bicyclosesquiphellandrene），1-表双环倍半水芹烯（l-epibicyclosesquiphellandrene），左旋的扁柏内酯（hinokinin），左旋的克氏胡椒脂素（clusin），左旋的二氢荜澄茄脂素（dihydrocubebin），左旋的二氯克氏胡椒脂素（eihydro-clusin），左旋的荜澄茄脂素灵（cubebinin），左旋的荜澄茄脂酮（cubebinone），左旋的亚太因（yatein），左旋的异亚太因（isoystein），左旋的欧侧柏内酯三甲醚（di-O-nethylthujaplicatinmethylether），左旋的荜澄茄脂素灵内酯（cubebininolide），2-（3”，4”-亚甲二氧基苄基）-3-（3’，4’一二甲氧基苄基）-丁内酯［（ZR，3R）-2-（3”，4”-methylenedioxybenzyl）-3-（3’，4’-dimethoxybenzyl）-butyrolactone］，柳叶玉兰脂素（magnosalin），高雄细辛脂素(heterotropan)，2，4，5-三甲氧基苯甲醛（2，4，5-trimethoxyben-zaldehyde），a-及β-型的O-乙基荜澄茄脂素（O-ethylcubebin），5”-甲氧基扁柏内酯（5”-methoxyhinokinin），二氢荜澄茄脂素-4-乙酸酯（hemiariensin)，胡椒环己烯酸（piperenol）A及B，长穗巴豆环氧素（crotepoxide），锡兰紫玉盘环己烯醇（zeylenol）。"}]},{"ID":"20240902165821-uxf7tsz","Type":"NodeParagraph","Properties":{"id":"20240902165821-uxf7tsz","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902165821-ooxtnsa","Type":"NodeParagraph","Properties":{"id":"20240902165821-ooxtnsa","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"1.对平滑肌的作用：荜澄茄油能松弛豚鼠离体气管平滑肌，增加豚鼠离体肺灌流量，对豚鼠吸入致痉剂所致药物性哮喘有明显保护作用，对小鼠有祛痰作用，均以含柠檬醛部分比去醛部分作用强。另荜澄茄油中的香叶醇、芳樟醇、香茅醛、樟脑等成分也具有不同程度的平喘作用。"}]},{"ID":"20240902165821-2sa8x81","Type":"NodeParagraph","Properties":{"id":"20240902165821-2sa8x81","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"2.抑菌作用：荜澄茄油对金黄色葡萄球菌、大肠杆菌、伤寒和痢疾杆菌、绿脓杆菌有抑制作用。1984年周勇等报道，荜澄茄挥发油为广谱抗真菌药物，其主要成份为柠檬醛。"}]},{"ID":"20240902165821-un70gjf","Type":"NodeParagraph","Properties":{"id":"20240902165821-un70gjf","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"其抗真菌作用有下列特点：2.1.抗真菌作用强。"}]},{"ID":"20240902165821-c6iqstx","Type":"NodeParagraph","Properties":{"id":"20240902165821-c6iqstx","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"2.2.广谱抗霉剂对9种一般霉菌及3种致病真菌均有抗菌效果。"}]},{"ID":"20240902165821-q632h25","Type":"NodeParagraph","Properties":{"id":"20240902165821-q632h25","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"2.3.为杀真菌作用，而不是抑菌作用。"}]},{"ID":"20240902165821-gtnhnj7","Type":"NodeParagraph","Properties":{"id":"20240902165821-gtnhnj7","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"2.4.毒性低根据荜澄茄挥发油半数致死量为3.25±0.2ml/kg，按生药计算相当65±4g/kg，与抗真菌有效剂量相比其毒性是很低的。1985年涂新义等报道，荜澄茄油及其4种提取物对9种霉菌菌株进行抑霉菌试验，结果表明有一定抑霉菌作用。"}]},{"ID":"20240902165821-cts3838","Type":"NodeParagraph","Properties":{"id":"20240902165821-cts3838","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"3.对皮肤过敏反应的抑制作用：荜澄茄油对大鼠被动皮肤过敏反应（PCA）有抑制作用，能保护豚鼠过敏性休克和抑制豚鼠离体回肠过敏性收缩。"}]},{"ID":"20240902165821-lwi085l","Type":"NodeParagraph","Properties":{"id":"20240902165821-lwi085l","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"4.荜澄茄油及其滴丸的抗缺氧作用：1988年付守廷等报道，荜澄茄油及其滴丸能明显延长常压缺氧条件下的小白鼠的存活时间；荜澄茄油亦能延长腹腔注射异丙肾上腺素的小白鼠的在常压缺氧条件下的生存时间，并对氰化钾和亚硝酸钠中毒有缓解作用。"}]},{"ID":"20240902165821-4vp0kcy","Type":"NodeParagraph","Properties":{"id":"20240902165821-4vp0kcy","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"5.抗心律失常的作用：1985年张风鸾报道，观察了荜澄茄油连续灌胃3天对氯仿与氯化钡引起的实验性心律失常的疗效，结果表明荜澄茄油能降低氯仿所致的小鼠心室颤动的发生率。能使氯化钡所致大鼠的双向性心动过速迅速转为正常窦性心律。荜澄茄油不能明显对抗乌头碱和哇巴因引起的心律失常，提示其作用有一定的选择性。"}]},{"ID":"20240902165821-zp9lq42","Type":"NodeParagraph","Properties":{"id":"20240902165821-zp9lq42","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【毒性】山鸡椒油灌胃对小鼠的半数致死量为3.25±0.22ml/kg。1984年黎士雄等报道，荜澄茄油对大白鼠骨髓细胞染色体有致畸变作用。"}]},{"ID":"20240902165821-sbxuvsh","Type":"NodeParagraph","Properties":{"id":"20240902165821-sbxuvsh","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末少许，滴加浓硫酸数滴，显黄棕色（或黄绿色），约10分钟后显血红色，再隔片刻转深紫红色。"}]},{"ID":"20240902165821-dtoms50","Type":"NodeParagraph","Properties":{"id":"20240902165821-dtoms50","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，摘去果柄，洗净，晒干。《雷公炮炙论》：凡使荜澄茄，采得后，去柄及皱皮了，用酒浸蒸，从已至酉出，细杵任用。"}]},{"ID":"20240902165821-x1nwu4c","Type":"NodeParagraph","Properties":{"id":"20240902165821-x1nwu4c","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【性味】辛；温"}]},{"ID":"20240902165821-3uu4kme","Type":"NodeParagraph","Properties":{"id":"20240902165821-3uu4kme","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肾；胃；膀胱经"}]},{"ID":"20240902165821-n8m7eaz","Type":"NodeParagraph","Properties":{"id":"20240902165821-n8m7eaz","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中散寒；行气止痛；暖肾。主胃寒呕逆；脘腹胀满冷痛；肠鸣泄泻；寒疝腹痛；寒湿小便淋沥浑浊"}]},{"ID":"20240902165821-qm11gjb","Type":"NodeParagraph","Properties":{"id":"20240902165821-qm11gjb","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1-5g，或入丸、散。外用：适量，研末擦牙或搐鼻。"}]},{"ID":"20240902165821-p2992i5","Type":"NodeParagraph","Properties":{"id":"20240902165821-p2992i5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【注意】《本经逢原》：阴虚血分有热，发热咳嗽禁用。"}]},{"ID":"20240902165821-u0olco5","Type":"NodeParagraph","Properties":{"id":"20240902165821-u0olco5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902165821-uwgz01c","Type":"NodeParagraph","Properties":{"id":"20240902165821-uwgz01c","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"1.《本草述钩元》：荜澄茄，疗肾气膀胱冷，少类于蜀椒；治阴逆下气塞，少类于吴萸，以温为补，洵属外伤于寒及内虚为寒之对药。至于温益脾胃，令人能食，其本在暖补肾与膀胱之气也。"}]},{"ID":"20240902165821-21wxjr6","Type":"NodeParagraph","Properties":{"id":"20240902165821-21wxjr6","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"2.《本草撮要》：毕澄前，功专治膀胱冷气，得白豆蔻治噎食不纳，得高良姜治寒呃，得薄荷、荆芥治鼻塞不通，得毕拨为末擦牙，治齿浮热痛，若蜈蚣咬伤，毕澄茄研末调敷。"}]},{"ID":"20240902165821-ztvj9u5","Type":"NodeParagraph","Properties":{"id":"20240902165821-ztvj9u5","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"3.《海药本草》：主心腹卒痛，霍乱吐泻，痰癖冷气。"}]},{"ID":"20240902165821-0419qxt","Type":"NodeParagraph","Properties":{"id":"20240902165821-0419qxt","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治一切气，并肾气膀胱冷。"}]},{"ID":"20240902165821-ld74gke","Type":"NodeParagraph","Properties":{"id":"20240902165821-ld74gke","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"5.《开宝本草》：主下气消食，皮肤风，心腹间气胀，令人能食。"}]},{"ID":"20240902165821-l6lowfg","Type":"NodeParagraph","Properties":{"id":"20240902165821-l6lowfg","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"6.《滇南本草》：泡酒吃，治面寒疼痛，暖腰膝，壮阳道，治阳痿。"}]},{"ID":"20240902165821-rsggykq","Type":"NodeParagraph","Properties":{"id":"20240902165821-rsggykq","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：暖脾胃，止呕吐哕逆。"}]},{"ID":"20240902165821-ltzhs59","Type":"NodeParagraph","Properties":{"id":"20240902165821-ltzhs59","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"8.《本草求原》：治反胃吐黑绿水。"}]},{"ID":"20240902165821-52vk048","Type":"NodeParagraph","Properties":{"id":"20240902165821-52vk048","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"9.《现代实用中药》：治淋疾。"}]},{"ID":"20240902165821-v2qv3xy","Type":"NodeParagraph","Properties":{"id":"20240902165821-v2qv3xy","updated":"20240902165840"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902165822-d1v66mp","Type":"NodeThematicBreak","Properties":{"id":"20240902165822-d1v66mp","updated":"20240902165840"}},{"ID":"20240902165823-xoo7zei","Type":"NodeParagraph","Properties":{"id":"20240902165823-xoo7zei","updated":"20240902165840"}}]}