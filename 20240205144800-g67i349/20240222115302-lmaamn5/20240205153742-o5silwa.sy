{"ID":"20240205153742-o5silwa","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153742-o5silwa","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153742-o5silwa\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240205161514-9elho5y\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205161514-9elho5y\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240205161514-9elho5y\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"荜澄茄（毕澄茄、木姜子、山鸡椒、山苍子）","type":"doc","updated":"20240902165828"},"Children":[{"ID":"20240205161514-9elho5y","Type":"NodeParagraph","Properties":{"id":"20240205161514-9elho5y","updated":"20240205161514"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荜澄茄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荜澄茄-20240205161514-4y3yaqc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724152959-uksbs7d","Type":"NodeParagraph","Properties":{"id":"20240724152959-uksbs7d","updated":"20240724153008"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 697px;","style":"width: 687px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山鸡椒 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山鸡椒 6-20240724152959-ifxlkn8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 687px;\" parent-style=\"width: 697px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 549px;","style":"width: 539px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山鸡椒"},{"Type":"NodeCloseBracket"},{"Type"