eBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 15-20240729165615-mhryzgp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729165743-3ukyjum","Type":"NodeParagraph","Properties":{"id":"20240729165743-3ukyjum","updated":"20240729165748"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 450px;","style":"width: 440px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杠柳 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 16-20240729165734-gi46rj8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 440px;\" parent-style=\"width: 450px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 802px;","style":"width: 792px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杠柳 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 10-20240729164658-i83f6sp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 792px;\" parent-style=\"width: 802px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729164625-t4a5kyb","Type":"NodeParagraph","Properties":{"id":"20240729164625-t4a5kyb","updated":"20240729165749"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 473px;","style":"width: 463px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杠柳 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 9-20240729164625-7xsso2k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 463px;\" parent-style=\"width: 473px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杠柳 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 11-20240729165019-uxw4sbx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729170146-7uuh7if","Type":"NodeParagraph","Properties":{"id":"20240729170146-7uuh7if","updated":"20240729170146"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 985px;","style":"width: 975px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杠柳 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杠柳 17-20240729170146-q0808hx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 975px;\" parent-style=\"width: 985px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729163342-0zeeqv3","Type":"NodeParagraph","Properties":{"id":"20240729163342-0zeeqv3","updated":"20240729170130"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为杠柳植物的根皮；杠柳并不是树，而是灌木，长得不高；"}]},{"ID":"20240729165951-w8404xw","Type":"NodeParagraph","Properties":{"id":"20240729165951-w8404xw","updated":"20240729170014"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：香五加皮带毒性，使用需辩证且适量；"}]},{"ID":"20240729163342-vokklr3","Type":"NodeThematicBreak","Properties":{"id":"20240729163342-vokklr3"}},{"ID":"20240903091703-ndow305","Type":"NodeParagraph","Properties":{"id":"20240903091703-ndow305","updated":"20240903091710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：香加皮"}]},{"ID":"20240903091703-locjf6u","Type":"NodeParagraph","Properties":{"id":"20240903091703-locjf6u","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"香加皮《中国药典》"}]},{"ID":"20240903091703-8is76jx","Type":"NodeParagraph","Properties":{"id":"20240903091703-8is76jx","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡJiāPí"}]},{"ID":"20240903091703-iw0ayxc","Type":"NodeParagraph","Properties":{"id":"20240903091703-iw0ayxc","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【英文名】CORTEXPERIPLOCAE"}]},{"ID":"20240903091703-z49ulwv","Type":"NodeParagraph","Properties":{"id":"20240903091703-z49ulwv","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【别名】北五加皮、羊奶藤、羊桃梢、羊奶子、杠柳皮"}]},{"ID":"20240903091703-uxcys1p","Type":"NodeParagraph","Properties":{"id":"20240903091703-uxcys1p","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【来源】本品为萝藦科植物杠柳PeriplocasepiumBge.的干燥根皮。春、秋二季采挖，剥取根皮，晒干。"}]},{"ID":"20240903091703-5671cvp","Type":"NodeParagraph","Properties":{"id":"20240903091703-5671cvp","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈卷筒状或槽状，少数呈不规则的块片状，长3～10cm,直径1～2cm，厚0.2～0.4cm。外表面灰棕色或黄棕色，栓皮松软常呈鳞片状，易剥落。内表面淡黄色或淡黄棕色，较平滑，有细纵纹。体轻，质脆，易折断，断面不整齐，黄白色。有特异香气，味苦。"}]},{"ID":"20240903091703-990c5uc","Type":"NodeParagraph","Properties":{"id":"20240903091703-990c5uc","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240903091703-gff9u5k","Type":"NodeParagraph","Properties":{"id":"20240903091703-gff9u5k","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末淡棕色。草酸钙方晶少数，直径9～20μm。石细胞长方形或类多角形，直径24～70μm。乳管含无色油滴状颗粒。木栓细胞棕黄色，多角形。淀粉粒甚多，单粒类圆形或长圆形，直径3～11μm；复粒由2～6分粒组成。"}]},{"ID":"20240903091703-3mglv85","Type":"NodeParagraph","Properties":{"id":"20240903091703-3mglv85","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末10g，置250ml烧瓶中，加水150ml，加热蒸馏，馏出液具特异香气，收集馏出液10ml，分置二支试管中，一管中加1％三氯化铁溶液1滴，即显红棕色；另一管中加硫酸肼饱和溶液5ml与醋酸钠结晶少量，稍加热，放冷，生成淡黄绿色沉淀，置紫外光灯（365nm）下观察，显强烈的黄色荧光。"}]},{"ID":"20240903091703-ggm25tj","Type":"NodeParagraph","Properties":{"id":"20240903091703-ggm25tj","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醇10ml，加热回流1小时，滤过，置25ml量瓶中，加乙醇至刻度，摇匀，量取1ml，置20ml量瓶中，加乙醇至刻度，摇匀，照分光光度法（附录ⅤA）测定，在278nm的波长处有最大吸收。"}]},{"ID":"20240903091703-3zav1x2","Type":"NodeParagraph","Properties":{"id":"20240903091703-3zav1x2","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"（4）取本品粉末2g，加甲醇30ml，加热回流1小时，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取4-甲氧基水杨醛对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各2μl，分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）－醋酸乙酯－冰醋酸（20:3:0.5）为展开剂，展开，取出，晾干，喷以二硝基苯肼试液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240903091703-zrgiedk","Type":"NodeParagraph","Properties":{"id":"20240903091703-zrgiedk","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【含量测定】"}]},{"ID":"20240903091703-p0mbx3o","Type":"NodeParagraph","Properties":{"id":"20240903091703-p0mbx3o","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"照高效液相色谱法（附录ⅥD）测定。"}]},{"ID":"20240903091703-51x5kit","Type":"NodeParagraph","Properties":{"id":"20240903091703-51x5kit","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验用十八烷基硅烷键合硅胶为填充剂；甲醇－水－醋酸（70:30:2）为流动相；检测波长为278nm。理论板数按4-甲氧基水杨醛峰计算应不低于1000。"}]},{"ID":"20240903091703-9wwn9j5","Type":"NodeParagraph","Properties":{"id":"20240903091703-9wwn9j5","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"内标溶液的制备精密称取对羟基苯甲酸丁酯适量，加60％甲醇制成每1ml含6mg的溶液，即得。"}]},{"ID":"20240903091703-0ztj1bm","Type":"NodeParagraph","Properties":{"id":"20240903091703-0ztj1bm","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"测定法精密称取4-甲氧基水杨醛对照品适量，置棕色量瓶中，加60％甲醇使溶解并定量稀释制成每1ml含1mg的溶液。精密量取该溶液4ml、内标溶液2ml,置25ml量瓶中，加60％甲醇至刻度，摇匀，吸取20μl注入液相色谱仪，记录色谱图；另取本品粗粉250～500mg，60℃干燥4小时，精密称定，置50ml烧瓶中，加60％甲醇15ml，加热回流1.5小时，滤过，滤液置25ml量瓶中，用60％甲醇洗涤容器，洗液滤入同一量瓶中，精密加入内标溶液2ml，加60％甲醇至刻度，摇匀，用微孔滤膜（0.5μm）滤过，滤液作为供试品溶液。吸取20μl注入液相色谱仪，按内标法以峰面积计算，即得。"}]},{"ID":"20240903091703-4t90dm1","Type":"NodeParagraph","Properties":{"id":"20240903091703-4t90dm1","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"本品于60℃干燥4小时，含4-甲氧基水杨醛（C8H8O3）不得少于0.20％。"}]},{"ID":"20240903091703-b4dj3d9","Type":"NodeParagraph","Properties":{"id":"20240903091703-b4dj3d9","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240903091703-9fwkale","Type":"NodeParagraph","Properties":{"id":"20240903091703-9fwkale","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，温；有毒。"}]},{"ID":"20240903091703-n1b46co","Type":"NodeParagraph","Properties":{"id":"20240903091703-n1b46co","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾、心经。"}]},{"ID":"20240903091703-7tpsujh","Type":"NodeParagraph","Properties":{"id":"20240903091703-7tpsujh","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风湿，强筋骨。用于风寒湿痹，腰膝酸软，心悸气短，下肢浮肿。"}]},{"ID":"20240903091703-dwlrbck","Type":"NodeParagraph","Properties":{"id":"20240903091703-dwlrbck","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～6g。"}]},{"ID":"20240903091703-a8jyjji","Type":"NodeParagraph","Properties":{"id":"20240903091703-a8jyjji","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【注意】本品有毒，服用不宜过量。"}]},{"ID":"20240903091703-a7qncuo","Type":"NodeParagraph","Properties":{"id":"20240903091703-a7qncuo","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240903091703-6iph7g0","Type":"NodeParagraph","Properties":{"id":"20240903091703-6iph7g0","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903091703-di4nxtb","Type":"NodeParagraph","Properties":{"id":"20240903091703-di4nxtb","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"香加皮《*辞典》"}]},{"ID":"20240903091703-1v8q1e3","Type":"NodeParagraph","Properties":{"id":"20240903091703-1v8q1e3","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【出处】《中药志》"}]},{"ID":"20240903091703-l3md314","Type":"NodeParagraph","Properties":{"id":"20240903091703-l3md314","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡJiāPí"}]},{"ID":"20240903091703-jyktl8o","Type":"NodeParagraph","Properties":{"id":"20240903091703-jyktl8o","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【别名】北五加皮、杠柳皮（《科学的民间药草》），臭五加（《山东中药》），山五加皮（《山西中药志》），香五加皮（《四川中药志》）。"}]},{"ID":"20240903091703-7gogcsy","Type":"NodeParagraph","Properties":{"id":"20240903091703-7gogcsy","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【来源】为萝藦科植物杠柳的根皮。春、秋均可采挖。趁新鲜时以木棒敲打，使根皮和木质部分离，抽去木心，将皮阴干或晒干。"}]},{"ID":"20240903091703-k49k692","Type":"NodeParagraph","Properties":{"id":"20240903091703-k49k692","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903091703-w7tsqt4","Type":"NodeParagraph","Properties":{"id":"20240903091703-w7tsqt4","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"杠柳，又名：狭叶萝藦、羊奶条、臭槐、羊角槐，羊交叶。"}]},{"ID":"20240903091703-lv0q22w","Type":"NodeParagraph","Properties":{"id":"20240903091703-lv0q22w","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"落叶缠绕灌木，高达1米以上。主根圆柱状。小枝常对生，黄褐色，有细条纹，枝上有圆点状突起的皮孔。叶对生，叶柄长3～6毫米；叶片披针形或长圆状披针形，长5～10厘米，宽1～3厘米，先端渐尖，全缘，基部楔形或近圆形，上面深绿色，有光泽，下面淡绿色，羽状网脉较细密。聚伞花序腋生或顶生，花一至数朵；苞片对生，小形；花梗细弱，花径约2厘米；萼深5裂，裂片卵形；花冠外面绿黄色，内面带紫红色，深5裂，裂片矩圆形，向外反卷，边缘密生白茸毛；副花冠5枚，线形，具细柔毛；雄蕊5，连合作圆锥状，有毛，包围雌蕊；子房上位，由2分离心皮组成，柱头合生。蓇葖果近圆柱状，长10～15厘米，先端浙尖，两果相对，弯曲而顶端相连，热时沿内侧纵裂。种子狭纺锤形而扁，黑褐色，顶端丛生白色长毛。花期5月。果期9月。"}]},{"ID":"20240903091703-nyrlqy2","Type":"NodeParagraph","Properties":{"id":"20240903091703-nyrlqy2","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于干燥山坡、砂质地、砾石山坡上。分布吉林、辽宁、内蒙古、河北、山西、河南、陕西、甘肃、宁夏、四川、山东、江苏等地。主产山西、河南、河北、山东。此外，四川、甘肃、湖南、辽宁、吉林、江苏等地亦产。"}]},{"ID":"20240903091703-564a8u7","Type":"NodeParagraph","Properties":{"id":"20240903091703-564a8u7","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的皮呈长圆筒状，单卷或双卷，少数呈槽状或碎片状，长可达16厘米，厚2～5毫米。外表面灰棕色或土棕色而带微红，粗糙，有横长的皮孔，栓皮常呈鳞片状剥离，有时露出土棕色的皮部；内表面灰黄色或土棕色。质坚脆，折断面略平坦。有浓郁的特异香气，久嗅令人头晕；味苦。以条粗、皮厚、呈卷筒状、无木心、香气浓浊、味苦者为佳。"}]},{"ID":"20240903091703-0c6xd51","Type":"NodeParagraph","Properties":{"id":"20240903091703-0c6xd51","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【化学成份】茎皮和根皮含十余种甙类化合物，已知其结构的有强心甙杠柳毒甙和皂甙杠柳甙K、H1、E。还含4-甲氧基水杨醛、α-香树脂醇、β-香树脂醇、α-香树脂醇乙酸酯、β-香树脂醇乙酸酯、β-谷甾醇及其葡萄糖甙等。"}]},{"ID":"20240903091703-f0y7q9y","Type":"NodeParagraph","Properties":{"id":"20240903091703-f0y7q9y","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903091703-kxgndek","Type":"NodeParagraph","Properties":{"id":"20240903091703-kxgndek","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"①强心作用"}]},{"ID":"20240903091703-48wcw6k","Type":"NodeParagraph","Properties":{"id":"20240903091703-48wcw6k","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"杠柳皮制剂（用乙醚及乙醇提出之水溶性物质）使在位蛙心停止于收缩期，在位猫心血压上升，心脏收缩力增强，衰竭之猫心（心肺装置）分钟输出量增加。皮的提取物乙（氯仿、乙醇提取）于在位猫心及心电图实验亦证明具有一般强心甙作用。希腊杠柳根皮中提出的萝藦甙、萝藦苦甙，作用迅速，持续时间短，蓄积作用弱。"}]},{"ID":"20240903091703-2n714mt","Type":"NodeParagraph","Properties":{"id":"20240903091703-2n714mt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"②镇静作用"}]},{"ID":"20240903091703-raleq66","Type":"NodeParagraph","Properties":{"id":"20240903091703-raleq66","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"杠柳皮提取物乙对小白鼠无镇静作用，杠柳酊、杠柳溶液均表现中枢兴奋，此作用可能由其挥发性成分而引起。"}]},{"ID":"20240903091703-ttiyrqd","Type":"NodeParagraph","Properties":{"id":"20240903091703-ttiyrqd","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240903091703-0xxzuun","Type":"NodeParagraph","Properties":{"id":"20240903091703-0xxzuun","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"萝藦甙在一定条件下，能增加肺循环。在临床上，强心的同时尚有利屎作用。此外，杠柳皮尚有杀虫作用。"}]},{"ID":"20240903091703-ed3atq5","Type":"NodeParagraph","Properties":{"id":"20240903091703-ed3atq5","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"④生物活性"}]},{"ID":"20240903091703-8huns98","Type":"NodeParagraph","Properties":{"id":"20240903091703-8huns98","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"杠柳皮制剂之猫单位折合生药为0.176克。杠柳提取物乙为1.6毫克／公斤。萝藦甙1克含有5780猫单位，蓄积性低，作用时间较毒毛旋花子甙G更短。"}]},{"ID":"20240903091703-ii8lv5r","Type":"NodeParagraph","Properties":{"id":"20240903091703-ii8lv5r","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【毒性】用杠柳的根皮（北五加康）代替南五加皮（五加科五加属或楤忽木属植物的树皮或根皮）。制五加皮酒时需慎重，因北五加皮强心作用很强，用量过多易中毒。注射于动物，可使其血压上升极高，约3～20分钟即可致死；南五加皮性温和，注射后血压无甚变动。"}]},{"ID":"20240903091703-oh3qr1e","Type":"NodeParagraph","Properties":{"id":"20240903091703-oh3qr1e","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，用水洗净，闷润后切段，晒干。"}]},{"ID":"20240903091703-3aibsvt","Type":"NodeParagraph","Properties":{"id":"20240903091703-3aibsvt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903091703-tdhbsjt","Type":"NodeParagraph","Properties":{"id":"20240903091703-tdhbsjt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"辛苦，微温，有毒。"}]},{"ID":"20240903091703-wfkx73z","Type":"NodeParagraph","Properties":{"id":"20240903091703-wfkx73z","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"①《四川中药志》：\"性微温，味甘，有毒。\""}]},{"ID":"20240903091703-40x0wi2","Type":"NodeParagraph","Properties":{"id":"20240903091703-40x0wi2","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"②《河北中药手册》：\"性温，味辛。\""}]},{"ID":"20240903091703-rzspfay","Type":"NodeParagraph","Properties":{"id":"20240903091703-rzspfay","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"③《陕甘宁青中草药选》：\"味苦辛，性温，有毒。\""}]},{"ID":"20240903091703-75q0gor","Type":"NodeParagraph","Properties":{"id":"20240903091703-75q0gor","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903091703-7axepp5","Type":"NodeParagraph","Properties":{"id":"20240903091703-7axepp5","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"祛风湿，壮筋骨。治风湿性关节炎；小儿筋骨软弱，脚痿行迟；水肿小便不利。"}]},{"ID":"20240903091703-gh2j0bl","Type":"NodeParagraph","Properties":{"id":"20240903091703-gh2j0bl","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"①《四川中药志》：\"镇痛，除风湿。治风寒湿痹，脚膝拘挛，筋骨疼痛。\""}]},{"ID":"20240903091703-mzj71x1","Type":"NodeParagraph","Properties":{"id":"20240903091703-mzj71x1","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"②《陕甘宁青中草药选》：\"祛风湿，壮筋骨，强腰膝。\""}]},{"ID":"20240903091703-ps3n6j8","Type":"NodeParagraph","Properties":{"id":"20240903091703-ps3n6j8","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；浸酒或入丸、散。"}]},{"ID":"20240903091703-75h8qfx","Type":"NodeParagraph","Properties":{"id":"20240903091703-75h8qfx","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【注意】《四川中药志》：\"血热、旰阳上亢者忌用。\""}]},{"ID":"20240903091703-zpz77sp","Type":"NodeParagraph","Properties":{"id":"20240903091703-zpz77sp","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903091703-yxk08gy","Type":"NodeParagraph","Properties":{"id":"20240903091703-yxk08gy","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"①治风湿性关节炎，关节拘挛疼痛：北五加皮、穿山龙、白鲜皮各五钱。用白酒泡24小时。每天服10毫升。"}]},{"ID":"20240903091703-88uga9m","Type":"NodeParagraph","Properties":{"id":"20240903091703-88uga9m","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"②治筋骨软弱，脚痿行迟：北五加皮、木瓜、牛膝等分为末。每服一钱，每日三次。"}]},{"ID":"20240903091703-w870wxq","Type":"NodeParagraph","Properties":{"id":"20240903091703-w870wxq","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"③治水肿，小便不利：北五加皮、陈皮、生姜皮、茯苓皮、大腹皮各三钱，水煎服。（①方以下出《陕甘宁青中草药选》）"}]},{"ID":"20240903091703-8u29m31","Type":"NodeParagraph","Properties":{"id":"20240903091703-8u29m31","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"④治水肿：香加皮一钱五分至三钱。煎服。（《上海常用中草药》）"}]},{"ID":"20240903091703-u98g9zh","Type":"NodeParagraph","Properties":{"id":"20240903091703-u98g9zh","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【备注】本品在各地习惯作五加皮使用，但有毒，性状与五加皮不同，应区别使用。参见\"五加皮\"条。"}]},{"ID":"20240903091703-t651dl9","Type":"NodeParagraph","Properties":{"id":"20240903091703-t651dl9","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903091703-89zaqlo","Type":"NodeParagraph","Properties":{"id":"20240903091703-89zaqlo","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"香加皮《中华本草》"}]},{"ID":"20240903091703-w1aksuq","Type":"NodeParagraph","Properties":{"id":"20240903091703-w1aksuq","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【出处】出自《中药志》"}]},{"ID":"20240903091703-wopav9i","Type":"NodeParagraph","Properties":{"id":"20240903091703-wopav9i","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡJiāPí"}]},{"ID":"20240903091703-x9h8ci8","Type":"NodeParagraph","Properties":{"id":"20240903091703-x9h8ci8","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【英文名】ChineseSilkvineRoot-bark，Root-barkofChineseSilkvine"}]},{"ID":"20240903091703-7ntgxf4","Type":"NodeParagraph","Properties":{"id":"20240903091703-7ntgxf4","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【别名】北五加皮、、五加皮、杠柳皮、臭五加、山五加皮、香五加皮"}]},{"ID":"20240903091703-i7njly8","Type":"NodeParagraph","Properties":{"id":"20240903091703-i7njly8","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903091703-t5gmckz","Type":"NodeParagraph","Properties":{"id":"20240903091703-t5gmckz","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"药材基源：为双子叶植物药萝藦科植物杠柳的根皮"}]},{"ID":"20240903091703-yl52f9o","Type":"NodeParagraph","Properties":{"id":"20240903091703-yl52f9o","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：PeriplocasepiumBunge"}]},{"ID":"20240903091703-32qefs1","Type":"NodeParagraph","Properties":{"id":"20240903091703-32qefs1","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后4-5年采收，但10年以上的产量质量较好，夏、秋、季挖取全根，除去须根，洗净，用木棒轻轻敲打，剥下根皮，晒干或炕干。"}]},{"ID":"20240903091703-e6k1j63","Type":"NodeParagraph","Properties":{"id":"20240903091703-e6k1j63","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶蔓性灌木，高达l.5m。具乳汁，除花外全株无毛。叶对生；叶柄长约3mm；叶片膜质，卵状长圆表，长5-9cm，宽1.5-2.5cm，先端渐尖，基部楔形；侧脉多数，聚伞花序腋生，有花数朵；花萼5深裂，裂片先端钝，花萼内面基部有10个小腺体；花冠紫红色，花张直径1.5-2cm，花冠裂片5，中间加厚呈纺锤形，反折，内面被长柔毛；副化冠环状，10裂，其中5裂片丝状伸长，被柔毛；雄花着生于副花冠内面，花药包围着柱头；心皮离生；花粉颗粒状，藏在直立匙形的载粉器内。蓇葖果双生，圆柱状，长7-12cm，直径约5mm，具纵条纹。种子长圆形，先端具长约3cm的白色绢质种毛。花期5-6月，果期7-9月。"}]},{"ID":"20240903091703-aoq26rt","Type":"NodeParagraph","Properties":{"id":"20240903091703-aoq26rt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903091703-l8crxg7","Type":"NodeParagraph","Properties":{"id":"20240903091703-l8crxg7","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"生态环境：生于平原低山丘的林缘、沟坡、河边沙制裁地或地埂等处。"}]},{"ID":"20240903091703-9qu8vm0","Type":"NodeParagraph","Properties":{"id":"20240903091703-9qu8vm0","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"资源分布：分布吉林、辽宁、内蒙古、河北、山西、河南、陕西、甘肃、宁夏、四川、山东、江苏等地。"}]},{"ID":"20240903091703-0xmzzng","Type":"NodeParagraph","Properties":{"id":"20240903091703-0xmzzng","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240903091703-9mozqjd","Type":"NodeParagraph","Properties":{"id":"20240903091703-9mozqjd","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"生物学特性杠柳对气假选择不严，宜在山坡或河边向阳处栽种。土壤以深厚、肥沃、排水良好的黄色夹沙土较好。"}]},{"ID":"20240903091703-9riwldu","Type":"NodeParagraph","Properties":{"id":"20240903091703-9riwldu","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、分株和根插繁殖，以分株和要插繁殖为主，分株繁殖；在冬季落叶后或早春发芽前，把老标兵旁长出的分蘖苗起，剪去过长须根和部分枝干，按行株距各约1.7开窝，每窝栽苗1株，盖土踩紧。根插繁殖：在冬、春季把老根挖起，切成20cm左右长的插条，开窝插插，每窝2根。"}]},{"ID":"20240903091703-81jowbn","Type":"NodeParagraph","Properties":{"id":"20240903091703-81jowbn","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"田间管理栽后1-2年内，在春、夏、冬季各松窝、除草1次，并追施人畜粪水2次，在春、冬两季松窝后进行。"}]},{"ID":"20240903091703-m0c36h7","Type":"NodeParagraph","Properties":{"id":"20240903091703-m0c36h7","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"病虫害防冶虫害有蚜虫等，可用敌百虫防冶。"}]},{"ID":"20240903091703-xjw85mf","Type":"NodeParagraph","Properties":{"id":"20240903091703-xjw85mf","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903091703-mta7jep","Type":"NodeParagraph","Properties":{"id":"20240903091703-mta7jep","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"性状鉴定：根皮呈卷简状或糟状，少数呈不规则块片状，长3-12cm直径0.7-2cm，厚2-5mm。外表面灰棕色至黄棕色，粗糙，有横向皮孔，栓皮常呈鳞片状肃落，露出灰白色部；内表面淡黄色至灰黄色，稍平滑，有细纵纹。体轻，质脆，易折断，断面黄白色，不整齐。有特异香气，味苦。以条粗、皮厚、呈卷简状、香气浓、味苦者为佳。"}]},{"ID":"20240903091703-hhpiqux","Type":"NodeParagraph","Properties":{"id":"20240903091703-hhpiqux","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：淡棕色。1.石细胞淡黄色或棕色，长方形，类多角形或长条形，直径24-70μm，壁厚至28μm，孔沟短或偶有不明显。2.乳法管直径30-72μm，内含无色油滴状物。3.草酸钙方晶多存在于薄壁细胞中，直径5-20μm，有的一个细胞含数个结晶；含晶细胞纵向连接。结晶排列成行。4.分泌细胞形大，呈椭圆形，直径36-130μm，长约至306μm，壁非木化，胞腔内偶见油滴状分泌物。5.木栓细胞壁薄，平直或微波状弯曲，黄棕色。6.淀粉粒直径3-11μm，脐点点状；复粒由2-7个分粒组居。7.韧皮薄壁细胞长梭形，有的端壁连珠状老前辈了，部表面可见网状微细纹理。"}]},{"ID":"20240903091703-hds24n7","Type":"NodeParagraph","Properties":{"id":"20240903091703-hds24n7","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【化学成份】根皮含甾类糖甙：杠柳毒甙(periplocin)即北五加皮甙(periplocoside)G,北五加皮甙K[1]、H1[2]、H2[3]、A、B、C[4]、D、E、L、M、N[5]、J、K、F、O[6]，杠柳甙(periploside)A、B、C[7]，杠柳加拿大麻糖甙(periplocymarin)[8]，β-谷甾醇-β-D葡萄糖甙(β-sitodteryl-β-D-glucoside)[11]；游离孕烯醇类化合物：5-孕甾烯-3β，20（R）-二醇-3-单乙酸酯[5-pregnene-3β,20,(R-diol-3-monoacetate][5])21-O-甲基-5-孕甾烯-3β，14β,17β,20,21-五醇(21-O-methyl-5-pregnene-3β,14β,17β,20,21-pentol)，21-O-甲基孕甾二烯-3β，17β，20，21-四醇(21-O-methyl-5，14-pregnadi-ene-3β,17β,20,21-tetrol)，21-O-甲基-5-孕甾烯-3β，14β，17β，21-四醇-20-酮(21-O-methyl-5-pregnene-3β,14β,17β,21-tetrol-20-one)A[9]，还含北五加皮寡糖(periplocaeoligosaccharide)C1、C2、F1、F2[10]，4-甲氧基-水杨醛(4-methoxysalicylaldehyde)及β-谷甾醇(β-sitlsterol)[11]"}]},{"ID":"20240903091703-vn3odih","Type":"NodeParagraph","Properties":{"id":"20240903091703-vn3odih","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903091703-edx7bbl","Type":"NodeParagraph","Properties":{"id":"20240903091703-edx7bbl","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"1.强心作用：杠柳皮制剂(用乙醚及乙醇提出之水溶性物质)使在位蛙心停止于收缩期，在位猫心血压上升，心脏收缩力增强，衰竭之猫心(心肺装置)分钟输出量增加。皮的提取物乙(氯仿、乙醇提取)于在位猫心及心电图实验亦证明具有一般强心甙作用。希腊杠柳PeriplocagraecaL．根皮中提出的萝藦甙、萝藦苦甙(Peripolocymarin)，作用迅速，持续时间短，蓄积作用弱。"}]},{"ID":"20240903091703-u0l3e8x","Type":"NodeParagraph","Properties":{"id":"20240903091703-u0l3e8x","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"2.镇静作用：杠柳皮提取物乙对小白鼠无镇静作用，杠柳酊、杠柳溶液均表现中枢兴奋，此作用可能由其挥发性成分而引起。"}]},{"ID":"20240903091703-qjjbgbm","Type":"NodeParagraph","Properties":{"id":"20240903091703-qjjbgbm","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"3.其他作用：萝藦甙在一定条件下，能增加肺循环。在临床上，强心的同时尚有利尿作用。此外，杠柳皮尚有杀虫作用。"}]},{"ID":"20240903091703-pt97cj4","Type":"NodeParagraph","Properties":{"id":"20240903091703-pt97cj4","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"4.生物活性：杠柳皮制剂之猫单位折合生药为0.176g。杠柳提取物乙为1.6mg/kg。萝藦甙lg含有5780猫单位，蓄积性低，作用时间较毒毛旋花子甙G更短。"}]},{"ID":"20240903091703-liffk45","Type":"NodeParagraph","Properties":{"id":"20240903091703-liffk45","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【毒性】用杠柳的根皮(北五加皮)代替南五加皮(五加科五加属或楤木属植物的树皮或根皮)。制五加皮酒时需慎重，因北五加皮强心作用很强，用量过多易中毒。注射于动物，可使其血压上升极高，约3-20分钟即可致死；南五加皮性温和，注射后血压无甚变动。毒性：乙醇制剂对猫肠道给药的致死量为1g/kg。香加皮强心作用很强，用量过多易中毒。注射于动物，可使其血压上升极高，约3-20分钟即可致死。据翁维良报道，北五加皮粗甙家鸽最小致死量为2.62±0.11mg/kg。"}]},{"ID":"20240903091703-mjd3iyq","Type":"NodeParagraph","Properties":{"id":"20240903091703-mjd3iyq","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240903091703-8e42srt","Type":"NodeParagraph","Properties":{"id":"20240903091703-8e42srt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"1.取本品粉末10g，加水150ml，加热蒸馏，馏出液具特异香气，收集馏出液10ml，分置2支试管中，一管中加1%三氯化铁溶液1滴，即显红棕色；另一管中加硫酸肼饱和溶液5ml与醋酸钠结晶少量，稍加热，放冷，生成淡黄绿色沉淀，置紫外灯下(365nm)观察，显强烈的黄色荧光。"}]},{"ID":"20240903091703-c4o12pv","Type":"NodeParagraph","Properties":{"id":"20240903091703-c4o12pv","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"2.取本品粉末1g，加乙醇10ml，加热回流1小时滤过，置25ml容量瓶中，加乙醇稀释至刻度，取1ml，置20ml容量瓶中，加乙醇稀释至刻度，用分光亮度法测定，在278nm处有最大吸收。"}]},{"ID":"20240903091703-kyssgon","Type":"NodeParagraph","Properties":{"id":"20240903091703-kyssgon","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"3.薄层色谱取本吕粉末2g，加甲醇30ml置水浴上回流1h，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取4-甲氧基水杨醛对照品，加甲醇制成每1cm含1mg的溶液，作为对照品溶液。吸取上述两种溶液各2μl,分别点于同一硅胶G薄层板上，以石油醚(60-90℃)-醋酸乙酯-洋醋酸（20：3：0.5）展开，取出晾干，喷以二硝基苯肼试液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240903091703-grqbgim","Type":"NodeParagraph","Properties":{"id":"20240903091703-grqbgim","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"品质标志按《中华人民共和国药典》1995年版本品项下含量测定法，本品于60℃干燥4h，含4-甲氧基水杨醛(C8H8O3)不得少于0.2%."}]},{"ID":"20240903091703-klo3yc4","Type":"NodeParagraph","Properties":{"id":"20240903091703-klo3yc4","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【炮制】取原药材，除去杂质及残留木心，洗净，切厚片，筛去灰悄。"}]},{"ID":"20240903091703-0aya5kt","Type":"NodeParagraph","Properties":{"id":"20240903091703-0aya5kt","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【性味】辛苦；微温；有毒"}]},{"ID":"20240903091703-jkiowxd","Type":"NodeParagraph","Properties":{"id":"20240903091703-jkiowxd","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾；心经"}]},{"ID":"20240903091703-b7hjx9q","Type":"NodeParagraph","Properties":{"id":"20240903091703-b7hjx9q","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风湿；利水消肿；强心。主风湿痹痛；水肿；小便不利；心力衰竭"}]},{"ID":"20240903091703-tzfx2u0","Type":"NodeParagraph","Properties":{"id":"20240903091703-tzfx2u0","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，4.5-9g；或浸酒或入丸、散。外用：适量，煎水外洗。"}]},{"ID":"20240903091703-sxpdkm4","Type":"NodeParagraph","Properties":{"id":"20240903091703-sxpdkm4","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【注意】《四川中药志》：血热、肝阳上亢者忌用。"}]},{"ID":"20240903091703-sztup1u","Type":"NodeParagraph","Properties":{"id":"20240903091703-sztup1u","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【附方】①治风湿性关节炎，关节拘挛疼痛：北五加皮、穿山龙、白鲜皮各五钱。用白酒泡24小时。每天服10毫升。②治筋骨软弱，脚痿行迟：北五加皮、木瓜、牛膝等分为末。每服一钱，每日三次。③治水肿，小便不利：北五加皮、陈皮、生姜皮、茯苓皮、大腹皮各三钱。水煎服。(①--③方出《陕甘宁青中草药选》)④治水肿：香加皮一钱五分至三钱。煎服。(《上海常用中草药》)"}]},{"ID":"20240903091703-isacw8i","Type":"NodeParagraph","Properties":{"id":"20240903091703-isacw8i","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903091703-dimdpmh","Type":"NodeParagraph","Properties":{"id":"20240903091703-dimdpmh","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"1.《四川中药志》：镇痛，除风湿。治风寒湿痹，脚膝拘挛，筋骨疼痛。"}]},{"ID":"20240903091703-c72yz1v","Type":"NodeParagraph","Properties":{"id":"20240903091703-c72yz1v","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"2.《陕甘宁青中草药选》：祛风湿，壮筋骨，强腰膝。"}]},{"ID":"20240903091703-y5byogi","Type":"NodeParagraph","Properties":{"id":"20240903091703-y5byogi","updated":"20240903091710"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903091704-zc7yg36","Type":"NodeThematicBreak","Properties":{"id":"20240903091704-zc7yg36","updated":"20240903091710"}},{"ID":"20240903091705-vj4iie7","Type":"NodeParagraph","Properties":{"id":"20240903091705-vj4iie7","updated":"20240903091710"}}]}