ype":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240727153805-5gddcod.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727170950-ln5djb8","Type":"NodeParagraph","Properties":{"id":"20240727170950-ln5djb8","updated":"20240727171043"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727165400-e6mtczx","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"连钱草（活血丹、透骨消、金钱艾、十八缺）"}]},{"ID":"20240727171005-ejskylp","Type":"NodeParagraph","Properties":{"id":"20240727171005-ejskylp","updated":"20240727171050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727163626-r6qt16y","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"铜钱草（香菇草、水金钱）"}]},{"ID":"20240727171007-uzwhyzq","Type":"NodeParagraph","Properties":{"id":"20240727171007-uzwhyzq","updated":"20240727171056"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727164422-zgnnfe2","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"破铜钱（天胡荽）"}]},{"ID":"20240727171008-e5no6gd","Type":"NodeParagraph","Properties":{"id":"20240727171008-e5no6gd","updated":"20240727171101"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240504170621-38fj7z1","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"198积雪草（雷公根）"}]},{"ID":"20240727161410-rpmwuxi","Type":"NodeParagraph","Properties":{"id":"20240727161410-rpmwuxi","updated":"20240727161436"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：用药尽量用金钱草，广金钱草不确定是否能替代金钱草；"}]},{"ID":"20240727153042-2myt5i3","Type":"NodeThematicBreak","Properties":{"id":"20240727153042-2myt5i3"}},{"ID":"20240902175526-y5work8","Type":"NodeParagraph","Properties":{"id":"20240902175526-y5work8","updated":"20240902175533"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：金钱草"}]},{"ID":"20240902175526-t2dou1w","Type":"NodeParagraph","Properties":{"id":"20240902175526-t2dou1w","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"金钱草《中国药典》"}]},{"ID":"20240902175526-1hho664","Type":"NodeParagraph","Properties":{"id":"20240902175526-1hho664","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiánCǎo"}]},{"ID":"20240902175526-ws6tt1c","Type":"NodeParagraph","Properties":{"id":"20240902175526-ws6tt1c","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【英文名】HERBALYSIMACHIAE"}]},{"ID":"20240902175526-96gc10b","Type":"NodeParagraph","Properties":{"id":"20240902175526-96gc10b","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【别名】大金钱草、对座草、路边黄、遍地黄、铜钱草、一串钱、寸骨七"}]},{"ID":"20240902175526-a8wyxzk","Type":"NodeParagraph","Properties":{"id":"20240902175526-a8wyxzk","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【来源】本品为报春花科植物过路黄LysimachiachristinaeHance的干燥全草。夏、秋二季采收，除去杂质，晒干。"}]},{"ID":"20240902175526-b19kjip","Type":"NodeParagraph","Properties":{"id":"20240902175526-b19kjip","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性状】本品常缠结成团，无毛或被疏柔毛。茎扭曲，表面棕色或暗棕红色，有纵纹，下部茎节上有时具须根，断面实心。叶对生，多皱缩，展平后呈宽卵形或心形，长1～4cm，宽1～5cm，基部微凹，全缘；上表面灰绿色或棕褐色，下表面色较浅，主脉明显突起，用水浸后，对光透视可见黑色或褐色条纹；叶柄长1～4cm。有的带花，花黄色，单生叶腋，具长梗。蒴果球形。气微，味淡。"}]},{"ID":"20240902175526-eyd4vx7","Type":"NodeParagraph","Properties":{"id":"20240902175526-eyd4vx7","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902175526-ul2rkew","Type":"NodeParagraph","Properties":{"id":"20240902175526-ul2rkew","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"本品茎的横切面：表皮细胞外被角质层，有时可见腺毛，头部单细胞，柄1～2细胞。皮层宽广，细胞中有的含红棕色分泌物；分泌道散在，周围分泌细胞5～10个，内含红棕色块状分泌物；内皮层明显。中柱鞘纤维断续排列成环，壁微木化。韧皮"}]},{"ID":"20240902175526-8lefms3","Type":"NodeParagraph","Properties":{"id":"20240902175526-8lefms3","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"部狭窄。形成层不明显。木质部连接成环。髓常成空腔。薄壁细胞含淀粉粒。"}]},{"ID":"20240902175526-v63setp","Type":"NodeParagraph","Properties":{"id":"20240902175526-v63setp","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"叶的表面观：腺毛红棕色，头部单细胞，类圆形，直径约25μｍ，柄单细胞。分泌道散在于叶肉组织内，直径约45μｍ，含红棕色分泌物。被疏毛者茎、叶表面可见非腺毛，1～17细胞，平直或弯曲，有的细胞呈缢缩状，长59～1070μm，基部直径13～53μm，表面可见细条纹，胞腔内含黄棕色物。"}]},{"ID":"20240902175526-p0uwonn","Type":"NodeParagraph","Properties":{"id":"20240902175526-p0uwonn","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，略洗，切段，晒干。"}]},{"ID":"20240902175526-juhp6qm","Type":"NodeParagraph","Properties":{"id":"20240902175526-juhp6qm","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性味】甘、咸，微寒。"}]},{"ID":"20240902175526-0sxpgh6","Type":"NodeParagraph","Properties":{"id":"20240902175526-0sxpgh6","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、胆、肾、膀胱经。"}]},{"ID":"20240902175526-z0kcgqn","Type":"NodeParagraph","Properties":{"id":"20240902175526-z0kcgqn","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【功能主治】清利湿热，通淋，消肿。用于热淋，沙淋，尿涩作痛，黄疸尿赤，痈肿疔疮，毒蛇咬伤；肝胆结石，尿路结石。"}]},{"ID":"20240902175526-tssf9vl","Type":"NodeParagraph","Properties":{"id":"20240902175526-tssf9vl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【用法用量】15～60g；鲜品加倍。"}]},{"ID":"20240902175526-wnm60m8","Type":"NodeParagraph","Properties":{"id":"20240902175526-wnm60m8","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902175526-gd24gir","Type":"NodeParagraph","Properties":{"id":"20240902175526-gd24gir","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用于热淋，尤善治疗石淋病症，可单味浓煎代茶饮服，或与海金沙、鸡内金等同用。用于湿热黄疸，可与茵陈、栀子同用。现代治疗胆石症配伍茵陈、黄芩、木香等同用。用于疔疮肿毒、蛇虫咬伤及烫伤等症，可用鲜金钱草捣汁饮服，以渣外敷局部。"}]},{"ID":"20240902175526-tdixdir","Type":"NodeParagraph","Properties":{"id":"20240902175526-tdixdir","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902175526-2bkc5y9","Type":"NodeParagraph","Properties":{"id":"20240902175526-2bkc5y9","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"金钱草《*辞典》"}]},{"ID":"20240902175526-jg4rrlu","Type":"NodeParagraph","Properties":{"id":"20240902175526-jg4rrlu","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目拾遗》"}]},{"ID":"20240902175526-63gvyfc","Type":"NodeParagraph","Properties":{"id":"20240902175526-63gvyfc","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiánCǎo"}]},{"ID":"20240902175526-uof6n5w","Type":"NodeParagraph","Properties":{"id":"20240902175526-uof6n5w","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【别名】遍地香（《祝穆试效方》），地钱几（《救荒野谱》），钹儿草（《救生苦海》），连钱草（《质问本草》），铜钱草（《慈航活人书》），白耳草、乳香藤、九里香、半池莲、千年冷、遍地金钱（《纲目拾遗》），金钱艾（《本草求取》），马蹄草、透骨消（《植物名实图考》），透骨风，过墙风、巡骨风（《分类草药性》），蛮子草（《天宝本草》），胡薄荷（《现代实用中药》），穿墙草（《经效实验单方》），团经药、风草（《贵州民间方药集》），肺风草、金钱薄荷、十八块草（《福建民间草药》），江苏金钱草（《中药通报》5（1）：27，19"}]},{"ID":"20240902175526-3whxudz","Type":"NodeParagraph","Properties":{"id":"20240902175526-3whxudz","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【来源】为唇形科植物活血丹的全草或带根全草。4～5月采收，晒干。"}]},{"ID":"20240902175526-0ep7586","Type":"NodeParagraph","Properties":{"id":"20240902175526-0ep7586","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902175526-8opwdzl","Type":"NodeParagraph","Properties":{"id":"20240902175526-8opwdzl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"活血丹（《植物名实图考》）"}]},{"ID":"20240902175526-fsud2n3","Type":"NodeParagraph","Properties":{"id":"20240902175526-fsud2n3","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"多年生草本。根茎短。茎细，具四棱，上升或直立，通常单一，基部带紫色，被细毛。叶对生；叶柄较长；叶片肾状心形、圆状心形或心形，长达2.5厘米，宽与长略相等，先端钝或稍尖，边缘具圆齿，被细毛，下面有透明腺点。花腋生，2至数朵；萼筒状，被刺毛，具5齿，先端芒状尖突；花冠淡紫色，筒状漏斗形，长约18～25毫米，花冠管狭长，为萼的2～3倍长，外面被细毛，先端2唇形，喉部膨大，上唇近平坦，下唇3裂；雄蕊4，2强，花丝顶端2歧；子房4裂，柱头2歧。小坚果，长圆形，平滑。花期5月。果期6月。"}]},{"ID":"20240902175526-n79hvhg","Type":"NodeParagraph","Properties":{"id":"20240902175526-n79hvhg","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于阔叶林间、灌丛、河畔、田野、路旁。分布东北、华北、华东等地。主产江苏、广东、四川、广西。此外，浙讧、湖南、福建等地亦产。"}]},{"ID":"20240902175526-r5ltbew","Type":"NodeParagraph","Properties":{"id":"20240902175526-r5ltbew","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性状】干燥全草多皱缩成团，茎细长，方形，常扭曲，具纵棱线，灰绿色或微带紫色，有短毛，断面中空。叶多卷缩，肾形或心形，边缘具圆钝齿，灰绿色，质脆易碎。叶柄长4～44毫米，多扭曲。花、果通常不见。气微香，味辛凉。"}]},{"ID":"20240902175526-ry406kr","Type":"NodeParagraph","Properties":{"id":"20240902175526-ry406kr","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【化学成份】金钱草有芳香型和非芳香型两类。芳香型含多量单萜酮，其主要成分是l-蒎莰酮、l-薄荷酮和l-胡薄荷酮；尚含α-蒎烯、β-蒎烯、柠檬烯、对-聚伞花素、异薄荷酮、异蒎莰酮、芳樟醇、薄荷醇、α-松油醇。除上述挥发油成分外，尚含熊果酸、β-谷甾醇、棕榈酸、琥珀酸、多种氨基酸、鞣质、苦味质、胆碱、硝酸钾等。地下部分含水苏糖。"}]},{"ID":"20240902175526-zqk7tbc","Type":"NodeParagraph","Properties":{"id":"20240902175526-zqk7tbc","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902175526-tn810x3","Type":"NodeParagraph","Properties":{"id":"20240902175526-tn810x3","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"用金钱草煎剂20克（生药）／公斤给大鼠灌胃，有显着的利尿作用，连续应用则利尿作用逐渐降低。在麻醉家兔的急性试验中，以10克（生药）／公斤灌胃，也有明显的利尿作用，这与其所含之灰分或钾盐有关，是否尚有其它有效成分，尚待研究。其酊剂无利尿作用。对猫、大鼠无利胆作用，对肝胆疾患的良好影响，可能与其所含的游离氨基酸有关。"}]},{"ID":"20240902175526-z7ewn3z","Type":"NodeParagraph","Properties":{"id":"20240902175526-z7ewn3z","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"本品毒性很低，煎剂给大鼠灌胃，每天20克／公斤，共享6天，并未死亡，犬1次灌胃100克，对血压无大影响。"}]},{"ID":"20240902175526-6ayosnq","Type":"NodeParagraph","Properties":{"id":"20240902175526-6ayosnq","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902175526-ccjepfs","Type":"NodeParagraph","Properties":{"id":"20240902175526-ccjepfs","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"苦辛，凉。"}]},{"ID":"20240902175526-f63x73p","Type":"NodeParagraph","Properties":{"id":"20240902175526-f63x73p","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"①《纲目拾遗》：\"味微甘，性微寒。\""}]},{"ID":"20240902175526-l48q7kj","Type":"NodeParagraph","Properties":{"id":"20240902175526-l48q7kj","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"②《岭南采药录》：\"味涩，气香，性平。\""}]},{"ID":"20240902175526-pbtaagc","Type":"NodeParagraph","Properties":{"id":"20240902175526-pbtaagc","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"③《现代实用中药》：\"苦，寒。\""}]},{"ID":"20240902175526-9cls7ln","Type":"NodeParagraph","Properties":{"id":"20240902175526-9cls7ln","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902175526-s9zpcmi","Type":"NodeParagraph","Properties":{"id":"20240902175526-s9zpcmi","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"清热，利尿，镇咳，消肿，解毒。治黄疸，水肿，膀胱结石，疟疾，肺痈，咳嗽，吐血，淋浊，带下，风湿痹痛，小儿疳积，惊痫，痈肿，疮癣，湿疹。"}]},{"ID":"20240902175526-6713yvh","Type":"NodeParagraph","Properties":{"id":"20240902175526-6713yvh","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"①《百草镜》：\"治跌打损伤，疟疾，产后惊风，肚痈，便毒，痔漏；擦鹅掌风；汁漱牙疼。\""}]},{"ID":"20240902175526-gtkg50u","Type":"NodeParagraph","Properties":{"id":"20240902175526-gtkg50u","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"②王安卿《采药志》：\"发散头风风邪。治脑漏，白浊热淋，玉茎肿痛，捣汁冲酒吃。\""}]},{"ID":"20240902175526-yn6yvx5","Type":"NodeParagraph","Properties":{"id":"20240902175526-yn6yvx5","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"③《纲目拾遗》：\"去风散毒。煎汤洗一切疮疥。\""}]},{"ID":"20240902175526-ehsvkdw","Type":"NodeParagraph","Properties":{"id":"20240902175526-ehsvkdw","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"祛风湿，止骨痛。浸酒舒筋活络，止跌打闪伤（痛），取汁调酒更效。\""}]},{"ID":"20240902175526-1b8cp7u","Type":"NodeParagraph","Properties":{"id":"20240902175526-1b8cp7u","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑤《植物名实图考》：\"治吐血、下血。\""}]},{"ID":"20240902175526-tpkv5ln","Type":"NodeParagraph","Properties":{"id":"20240902175526-tpkv5ln","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑥《中国植物图鉴》：\"可作强壮剂。治慢性肺炎。\""}]},{"ID":"20240902175526-ckg3v6w","Type":"NodeParagraph","Properties":{"id":"20240902175526-ckg3v6w","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑦《现代实用中药》：\"解热，镇咳，止渴，止血，利尿。治小儿痫热，疳病，瘰疬；研汁点暴赤眼；以盐揉贴肿毒并风癣。\""}]},{"ID":"20240902175526-3jaharn","Type":"NodeParagraph","Properties":{"id":"20240902175526-3jaharn","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑧《安徽药材》：\"治膀胱结石。\""}]},{"ID":"20240902175526-o6lw5y8","Type":"NodeParagraph","Properties":{"id":"20240902175526-o6lw5y8","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑨《民间常用草药汇编》：\"鲜草捣汁外敷撑耳寒（腮腺炎）。\""}]},{"ID":"20240902175526-whixocr","Type":"NodeParagraph","Properties":{"id":"20240902175526-whixocr","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑩《陆川本草》：\"消肿止痛，破积。治妇人小腹痛。\""}]},{"ID":"20240902175526-u2l7bym","Type":"NodeParagraph","Properties":{"id":"20240902175526-u2l7bym","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑾《贵阳民间药草》：\"治红崩带下，肺结核。\""}]},{"ID":"20240902175526-hvkqh2c","Type":"NodeParagraph","Properties":{"id":"20240902175526-hvkqh2c","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑿《浙江民间草药》：\"治高血压。\""}]},{"ID":"20240902175526-c187xyw","Type":"NodeParagraph","Properties":{"id":"20240902175526-c187xyw","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⒀《四川中药志》：\"治风湿麻木，筋骨疼痛，黄疸，肺痈。\""}]},{"ID":"20240902175526-27dmyl1","Type":"NodeParagraph","Properties":{"id":"20240902175526-27dmyl1","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱（鲜者1～2两）；或浸洒，捣汁。外用：捣敷或绞汁涂。"}]},{"ID":"20240902175526-fwq20nw","Type":"NodeParagraph","Properties":{"id":"20240902175526-fwq20nw","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【注意】《福建民间草药》：\"凡阴疽诸毒，脾虚泄泻者，忌捣汁生服。\""}]},{"ID":"20240902175526-9xbil26","Type":"NodeParagraph","Properties":{"id":"20240902175526-9xbil26","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902175526-4p98249","Type":"NodeParagraph","Properties":{"id":"20240902175526-4p98249","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"①治黄疸、臌胀：连钱草七至八钱，白茅根、车前草各四至五钱，荷包草五钱。共煎服。（《浙江民间草药》）"}]},{"ID":"20240902175526-esidn6x","Type":"NodeParagraph","Properties":{"id":"20240902175526-esidn6x","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"②治肾炎水肿：连钱草、萹蓄草各一两，荠菜花五钱。煎服。（《上海常用中草药》）"}]},{"ID":"20240902175526-304wkzl","Type":"NodeParagraph","Properties":{"id":"20240902175526-304wkzl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"③利小便，治膀胱结石：连钱草、龙须草、车前草各五钱。煎服。（《浙江民间草药》）"}]},{"ID":"20240902175526-stypi6p","Type":"NodeParagraph","Properties":{"id":"20240902175526-stypi6p","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"④治疟疾：㈠疟发前用连钱草七叶为丸塞鼻中。（《质问本草》）"}]},{"ID":"20240902175526-i97w497","Type":"NodeParagraph","Properties":{"id":"20240902175526-i97w497","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"㈡连钱草一两五钱至三两。水煎，分两次服，每日一剂，连服三天。（《单方验方调查资料选编》）"}]},{"ID":"20240902175526-auhv246","Type":"NodeParagraph","Properties":{"id":"20240902175526-auhv246","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑤治伤风咳嗽：鲜连钱草五至八钱（干的三至五钱）（洗净），冰糖半两。酌加开水，炖一小时，日服二次。（《福建民间草药》）"}]},{"ID":"20240902175526-c9xbu36","Type":"NodeParagraph","Properties":{"id":"20240902175526-c9xbu36","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑥治胎咳、子肿：团经药、尖惊药、大苋菜、花蝴蝶各三至五钱。炖肉或鸡吃。"}]},{"ID":"20240902175526-qzfkumi","Type":"NodeParagraph","Properties":{"id":"20240902175526-qzfkumi","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑦治白带：团经药五钱，杜仲三钱，木通一钱五分。煎水加白糖服。"}]},{"ID":"20240902175526-vrp3690","Type":"NodeParagraph","Properties":{"id":"20240902175526-vrp3690","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑧治月经不调，小腹作胀：团经药、对叶莲各三钱，大叶艾二钱。泡酒吃。"}]},{"ID":"20240902175526-9o60mvr","Type":"NodeParagraph","Properties":{"id":"20240902175526-9o60mvr","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑨治风湿性关节炎：团经药，捶绒酒炒热，外敷。（⑥方以下出《贵阳民间药草》）"}]},{"ID":"20240902175526-uerzzi5","Type":"NodeParagraph","Properties":{"id":"20240902175526-uerzzi5","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑩治小儿疳积：连钱草三钱，加动物肝脏适量，炖汁服。（《上海常用中草药》）"}]},{"ID":"20240902175526-23lvn39","Type":"NodeParagraph","Properties":{"id":"20240902175526-23lvn39","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑾治疮疖、腮腺炎、皮肤撞伤青肿：鲜连钱草捣烂外敷。（《上海常用中草药》）"}]},{"ID":"20240902175526-z6l75ur","Type":"NodeParagraph","Properties":{"id":"20240902175526-z6l75ur","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⑿治白虎丹：鲜车前草、遍地香。洗净捣烂，少加白酒，绞取汁，鹅毛蘸搽患处。（《祝穆试效方》）"}]},{"ID":"20240902175526-nutra7q","Type":"NodeParagraph","Properties":{"id":"20240902175526-nutra7q","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⒀治湿疹、脓庖疮。稻田皮炎：鲜连钱草、野菊花各半斤。加水煮沸，乘热反复擦洗患处（有脓疱者必须挑破脓疱），再用痱子粉或牙粉撒布溃破处，每天一次。如三次见效不显，可加木槿皮或叶半斤同煎洗。（《江苏省中草药新医疗法展览资料选编》）"}]},{"ID":"20240902175526-hr3vy7g","Type":"NodeParagraph","Properties":{"id":"20240902175526-hr3vy7g","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⒁治疮疥：钹儿草，加盐少许，搓熟频擦，全化，然后洗浴。若用煎冼，反不见效。（《救生苦海》）"}]},{"ID":"20240902175526-l2ro86m","Type":"NodeParagraph","Properties":{"id":"20240902175526-l2ro86m","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"⒂治蛇咬：连钱草生药鲜吃，并捣烂敷伤口。（《浙江民间草药》）"}]},{"ID":"20240902175526-5i29u8k","Type":"NodeParagraph","Properties":{"id":"20240902175526-5i29u8k","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902175526-u57oe6s","Type":"NodeParagraph","Properties":{"id":"20240902175526-u57oe6s","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"①治疗腮腺炎"}]},{"ID":"20240902175526-6t1yxcg","Type":"NodeParagraph","Properties":{"id":"20240902175526-6t1yxcg","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"将连钱草洗净，加少量食盐捣烂，敷于肿处，不论一侧或两侧腮腺肿大，均须两侧同时敷药。治疗50例，全部治愈；腮腺肿大消退及体温下降平均为12小时。"}]},{"ID":"20240902175526-rl2exrc","Type":"NodeParagraph","Properties":{"id":"20240902175526-rl2exrc","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"②治疗烧伤"}]},{"ID":"20240902175526-gtvizkl","Type":"NodeParagraph","Properties":{"id":"20240902175526-gtvizkl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"新鲜连钱草1把，洗净，用较厚的黄草纸包2～3层，水中浸湿后置旺火中烤熟，约20～30分钟取出，去纸，乘热将药草揉烂绞汁，盛于杯中，用消毒鸭毛蘸药汁涂搽伤面，每天搽数次至数十次，以保持伤面湿润为度；伤势严重的，药汁中加入适量冰片或麝香（研成细粉），可加速痊愈（但加麝香每易遗留瘢痕）；如创面感染化脓，须先经清洗消毒处理，然后搽药。治疗Ⅱ、Ⅲ度烧伤30例，烧伤面积1～30％不等，其中已感染化脓者17例，引起全身症状者3例。结果均治愈，且无功能障碍。制药时要注意掌握火候，药草既要充分烤熟，但亦不能烤焦，否则将无法绞汁。治疗时创面要暴露，不能覆盖，也不能和其它药物混合施治；涂药汁时最好用鸭毛，如用棉花，其纤维每易脱落，可能影响创面愈合。在治疗期间，忌食豆荚、丝瓜、鸡蛋、鱼类等食物。"}]},{"ID":"20240902175526-sb49651","Type":"NodeParagraph","Properties":{"id":"20240902175526-sb49651","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240902175526-tolj2kv","Type":"NodeParagraph","Properties":{"id":"20240902175526-tolj2kv","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"各地称\"金钱草\"供药用的植物，除本种外尚有下列几种："}]},{"ID":"20240902175526-w44sipp","Type":"NodeParagraph","Properties":{"id":"20240902175526-w44sipp","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"①报春花科过路黄，详\"大金钱草\"条。"}]},{"ID":"20240902175526-5h48a1k","Type":"NodeParagraph","Properties":{"id":"20240902175526-5h48a1k","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"②旋花科马蹄金，详\"小金钱草\"条。"}]},{"ID":"20240902175526-9j8at1w","Type":"NodeParagraph","Properties":{"id":"20240902175526-9j8at1w","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"③伞形科白毛天胡荽和天胡荽，详\"江西金钱草\"条。"}]},{"ID":"20240902175526-ol9jsoz","Type":"NodeParagraph","Properties":{"id":"20240902175526-ol9jsoz","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"④豆科金钱草，详\"广东金钱草\"条。"}]},{"ID":"20240902175526-wdb4c7j","Type":"NodeParagraph","Properties":{"id":"20240902175526-wdb4c7j","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902175526-rfpulpd","Type":"NodeParagraph","Properties":{"id":"20240902175526-rfpulpd","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"金钱草《中华本草》"}]},{"ID":"20240902175526-3h9qopz","Type":"NodeParagraph","Properties":{"id":"20240902175526-3h9qopz","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【出处】本品首载于《百草镜》，名\"神仙对坐草\"，云：\"此草清明时发苗，高尺许，生山湿阴处。叶似鹅肠草，对节，立夏时开小花，三月采，过时无。\"《纲目拾遗》中亦载有\"神仙对坐草\"曰：\"一名蜈蚣草。山中道旁皆有之，蔓生，两叶相对，青圆似佛耳草，夏开小黄花，每节间有二朵，故名。\"《植物名实图考》所载\"过路黄\"之二，曰：\"过路黄，江西坡膛多有之。铺地拖蔓，叶如豆叶，对生附茎。叶间春开五尖瓣黄花，绿跗尖长，与叶并茁。"}]},{"ID":"20240902175526-nqy52wz","Type":"NodeParagraph","Properties":{"id":"20240902175526-nqy52wz","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiánCǎo"}]},{"ID":"20240902175526-q0274i1","Type":"NodeParagraph","Properties":{"id":"20240902175526-q0274i1","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【别名】神仙对坐草、地蜈蚣、蜈蚣草、铜钱草、野花生、仙人对坐草、四川大金钱草、大金钱草、对坐草、一串钱、临时救、黄疸草、一面锣、金钱肺筋草、藤藤侧耳根、白侧耳根、铜钱花、水侧耳根、大连钱草、遍地黄、黄花过路草、龙鳞片、真金草、走游草、铺地莲莲"}]},{"ID":"20240902175526-gc25ajf","Type":"NodeParagraph","Properties":{"id":"20240902175526-gc25ajf","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175526-hgij60k","Type":"NodeParagraph","Properties":{"id":"20240902175526-hgij60k","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"药材基源：为报春花科植物过路黄的全草。"}]},{"ID":"20240902175526-ev4yj1o","Type":"NodeParagraph","Properties":{"id":"20240902175526-ev4yj1o","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：LysimachiachristinaeHance"}]},{"ID":"20240902175526-y4gefyv","Type":"NodeParagraph","Properties":{"id":"20240902175526-y4gefyv","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种当年9-10月收获。以后每年收获两次，第1次在6月，第2次在9月。用镰刀割取，留茬10cm左右，以利萌发。割下的全株，除去杂草，用水洗净，晒干或烘干即成。"}]},{"ID":"20240902175526-4w1cp2t","Type":"NodeParagraph","Properties":{"id":"20240902175526-4w1cp2t","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生蔓生草本。茎柔弱，平卧延伸，长20-60cm，表面灰绿色或带红紫色，全株无毛或被疏毛，幼嫩部分密被褐色无柄腺体，下部节间较短，常发出不定根，中部节间长1.5-5(-10)cm。叶对生；叶柄长1-3cm，无毛；叶片卵圆形、近圆形以至肾圆形，长(1.5-)2-6(-8)cm，宽1-4(-6)cm，先端锐尖或圆钝以至圆形，基部截形至浅心形，稍肉质，透光可见密布的透明腺条，干时腺条变黑色，两面无毛，有腺毛。花单生于叶腋：花梗长1-5cm，通常不超过叶长，花梗幼嫩时稍有毛，多少具褐色无柄腺体；花萼长(4-)5-7(-10)mm，5深裂，分裂近达基部，裂片披针形，椭圆状披针形以至线形或上部稍扩大而近匙形，先端锐尖或稍钝，无毛，被柔毛或仅边缘具缘毛。花冠黄色，辐状钟形，长7-15mm，5深裂，基部合生部分长2-4mm，裂片狭卵形以至近披针形，先端锐尖或钝，具黑色长腺条；雄蕊5，花丝长6-8mm，下半部合生成筒，花药卵圆形，长1-1.5mm；子房卵球形，花柱长6-8mm。蒴果球形，直径3-5mm，无毛，有稀疏黑色腺条，瓣裂。花期5-7月，果期7-10月。"}]},{"ID":"20240902175526-e6favr1","Type":"NodeParagraph","Properties":{"id":"20240902175526-e6favr1","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902175526-t8d5imy","Type":"NodeParagraph","Properties":{"id":"20240902175526-t8d5imy","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"生态环境：生于土坡路边、沟边及林缘较阴湿处，垂直分布可达海拔2300m处。"}]},{"ID":"20240902175526-dm0tp3l","Type":"NodeParagraph","Properties":{"id":"20240902175526-dm0tp3l","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于中南、西南及山西、陕西、甘肃、江苏、安徽。浙江、江西、福建等地。"}]},{"ID":"20240902175526-yxuvhrt","Type":"NodeParagraph","Properties":{"id":"20240902175526-yxuvhrt","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902175526-wz8vzes","Type":"NodeParagraph","Properties":{"id":"20240902175526-wz8vzes","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖、阴凉、湿润环境，不耐寒。适宜肥沃疏松、腐殖质较多的砂质壤上。"}]},{"ID":"20240902175526-dwtiwfq","Type":"NodeParagraph","Properties":{"id":"20240902175526-dwtiwfq","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"栽培技术用扦插繁殖或种子繁殖。种子繁殖：因种有硬实性，一般硬实率为40%-90%，播种前需用砂磨3-5分钟或在80-90℃热水中浸2-3分钟，可明显提高发芽率。"}]},{"ID":"20240902175526-6p3dgz5","Type":"NodeParagraph","Properties":{"id":"20240902175526-6p3dgz5","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"2．2．扦插繁殖：因种子很小，不易采集，苗期生长缓慢，故生产上一般多采用扦插繁殖。南方在5-6月，北方在7-8月植株生长茂盛时，将匍匐茎剪下，每3-4节剪成一段，作为插条。在整好的畦上，按行株距各约20cm开浅窝，每穴栽插2根，入土2-3节，露出地面1-2节，用上压紧，然后盖拌有人畜粪尿的重土1层，约1.5cm厚。扦插后，如天旱无雨，要浇水保苗，以利成活。"}]},{"ID":"20240902175526-ea43ytw","Type":"NodeParagraph","Properties":{"id":"20240902175526-ea43ytw","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"田间管理在发出新叶时，要施清淡人畜粪水1次，如有缺苗，要及时剪取较长插条补苗，蔓长20cm左右时，中耕除草1次，培土1次，并追肥1次。每1hm(2)每次施清淡人畜粪尿15000kg左右。在秋季收获后，也要中耕除草和追肥1次。以后每年3-4月及每次收获后，都进行中耕除草和追人畜粪尿1次。"}]},{"ID":"20240902175526-mr4s8mp","Type":"NodeParagraph","Properties":{"id":"20240902175526-mr4s8mp","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"病虫害防治虫害有蛞蝓及蜗牛，可在早晨撤生石灰粉防治。"}]},{"ID":"20240902175526-8kfll8b","Type":"NodeParagraph","Properties":{"id":"20240902175526-8kfll8b","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175526-7nwv5fk","Type":"NodeParagraph","Properties":{"id":"20240902175526-7nwv5fk","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"性状鉴别全草多皱缩成团，下部茎节上有时着生纤细须根。茎扭曲，直径约1mm；表面红棕色，具纵直纹理；断面实心，灰白色。叶对生，多皱缩破碎，完整叶宽卵形或心形，全缘，上面暗绿色至棕绿色，下面色较浅，用水浸后，透光可见黑色短条纹；叶柄细长，叶腋有时可见花或果实。气微、味淡。以叶大、色绿者为佳。"}]},{"ID":"20240902175526-izc93uu","Type":"NodeParagraph","Properties":{"id":"20240902175526-izc93uu","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面表皮外被角质层，有时可见腺毛。皮层宽广，薄壁细胞偶含红棕色分泌物；有分泌道散在，周围5-10个分泌细胞，含红棕色分泌物；内皮层明显。中柱鞘纤维微木化，断续成环。韧皮部狭窄，老茎的木质部偶有纤维。髓常成为空腔。本品薄壁细胞含淀粉粒。叶横切面：上表皮为1列切向延长的薄壁细胞、类长方形，具角质层，无气孔。下表皮细胞形状与上表皮相似，有气孔。栅栏组织常1列，稀2列。海绵组织细胞4-6列，偶含红棕色色素块，分泌道散列，直径45um。主脉1条，于下面明显凸出。近表皮细胞处及韧皮部外面有厚角组织，维管束被维管束鞘包围。侧脉小，不发达。叶表面观：表皮细胞垂周壁略呈波状，具角质层，腺毛红棕色，头部单细胞，类圆形，柄为多细胞，脱落后留有圆形基部，周围有放射状角质层纹理；下表皮细胞气孔不等式或不定式；叶肉组织有分泌道散在，含红棕色分泌物。被疏柔毛的茎、叶可见非腺毛，非腺毛有1-17个细胞，长60-1070μm，基部直径15-53μm，平直或弯曲，表面具细条纹，胞腔含黄棕色物质，有的细胞缢缩。"}]},{"ID":"20240902175526-22u7wam","Type":"NodeParagraph","Properties":{"id":"20240902175526-22u7wam","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草含黄酮类成分：槲皮素(quercetin)，异槲皮甙即槲皮素-3-O-葡萄糖甙(isoquercitrin，quercetin-3-O-gluco-side)，山奈酚(kaempferol)，三叶豆甙即山奈酚-3-O-半乳糖甙(trifolin，kaempferol-3-O-galactosids)，3，2\u0026'，4'，6"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"，四羟基-4，3"},{"Type":"NodeText","Data":"​-二甲氧基查尔酮(3，2'，4'，6"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"，tetrahydroxy-4，3'-dimethoxychal-cone)，山奈酚-3-O-珍珠菜三糖甙(kaempferol-3-O-lysi-machiatrioside)，山奈酚-3-O-葡萄糖甙(kaempferol-3-0-glucoside)，鼠李柠檬素-3，4-二葡萄糖(rhamnocitrin-3，4"},{"Type":"NodeText","Data":"​-diglucOside)，山亲酚-3-O-芸香糖甙(kaempferol-3-O-rutinoside)，山奈酚-3-O-鼠李糖甙-7-O-鼠李糖基(1→3)-鼠李糖甙(kaempferol-3-O-rhamnoside-7-O-rhamnosyl(1→3)-rhamnosi-de]。还含对-羟基苯甲酸(p-hydroxybenzoicacid)，尿嘧啶(uridine)，氯化钠；氯化钾，亚硝酸盐，环腺苷酸(cAMP)，环鸟苷酸(cGMP)样物质，多糖和钙、镁、铁、锌、铜、锰、镉、镍、钴等9种元素，钙、镁、铁含量最多，锌、铜、锰、镉、镍、钴含量也很丰富。"}]},{"ID":"20240902175526-t5wkmsg","Type":"NodeParagraph","Properties":{"id":"20240902175526-t5wkmsg","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902175526-u32y6rl","Type":"NodeParagraph","Properties":{"id":"20240902175526-u32y6rl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"1.排石作用金钱草有利胆排石和利尿排石的功效口。用蝌蚪实验性草酸钙肾结石模型试验表明，金钱草煎汁对于预防和治疗蝌蚪实验性肾结石是有效的。麻醉狗半开放式记录系统实验结果表明，金钱草可引起输尿管上段腔内压力增高，输尿管蠕动增强，尿量增加，对输尿管结石有挤压和冲击作用，促使输尿管结石排出。一水草酸钙为尿路结石的主要成分，金钱草的醇不溶物中的多糖成分，对一水草酸钙的结晶生长有抑制作用，且抑制作用随浓度的增加而增加，正常人尿液对一水草酸钙结晶生长的抑制作用与1.94×10(-5)g(生药)／ml所提取的多糖的作用相当。采用导电法，发现精制多糖抑制一水草酸钙结晶生长百分率高于水煎液醇沉部分。"}]},{"ID":"20240902175526-agxdcrl","Type":"NodeParagraph","Properties":{"id":"20240902175526-agxdcrl","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"2.抗炎作用金钱草50g/kg及其总黄酮及酚酸物3.75g/kg腹腔注射，对组胺引起的小鼠血管通透性增加有显着的抑制作用，对巴豆油所致的小鼠耳部炎症具有非常显着的抑制作用，对注射蛋清引起的大鼠踝关节肿胀和大鼠棉球肉芽肿均有显着的抑制作用。"}]},{"ID":"20240902175526-24xrkgj","Type":"NodeParagraph","Properties":{"id":"20240902175526-24xrkgj","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"3.对免疫系统作用金钱草对细胞免疫有抑制作用。玫瑰花试验：金钱草小鼠脾细胞与绵羊红细胞形成玫瑰花的百分率，明显低于对照组，即便在停药后10天仍受抑制，其程度与环磷酰胺相似。金钱草与环磷酰胺合用抑制更明显。皮肤移植排斥反应：金钱草组和环磷酰胺组小鼠皮肤移植排斥反应出现的时间，均比对照组晚，两药并用组尤甚。金钱草对体液兔疫亦有抑制作用。免疫的小鼠，服金钱草组溶血素生成受抑，血清中含量约为对照组的1／2；金钱草组小鼠生成钩端螺旋体凝溶抗体受抑，血清中滴度一般低于对照组；金钱草与环磷酰胺并用，作用尤为显着。金钱草能增强小鼠巨噬细胞的吞噬功能，其吞噬功能百分率为对照组的两倍；给小鼠注射葡萄球菌后不同时间检查嗜中性白细胞的吞噬功能可见金钱草组具有吞噬功能的细胞数均高于对照组，注射后4、6、8小时最明显。"}]},{"ID":"20240902175526-s5bsyw7","Type":"NodeParagraph","Properties":{"id":"20240902175526-s5bsyw7","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"4.对血管平滑肌及人血小板的作用金钱草对血管平滑肌有松弛作用，对试管内ADP及花生四烯酸诱导的人血小板聚集也有一定的抑制作用。"}]},{"ID":"20240902175526-lwy877e","Type":"NodeParagraph","Properties":{"id":"20240902175526-lwy877e","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【毒性】临床报告金钱草能引起接触性皮炎和过敏反应。"}]},{"ID":"20240902175526-arbu6sa","Type":"NodeParagraph","Properties":{"id":"20240902175526-arbu6sa","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【炮制】取原药材，除去杂质，抢水洗净，沥去水，切段，干燥。饮片性状：本品为不规则的小段，根、茎、叶、花混合。根纤细，淡黄色。茎细扭曲，有纵纹，表面棕色或暗棕红色。叶多皱缩，完整叶片宽卵形或心形，叶上表面灰绿色或棕褐色，下表面色较浅。主脉明显突起。花黄色或棕色，蒴果球形。气微、味淡。贮干燥容器内，置通风干燥处。"}]},{"ID":"20240902175526-qd9srqu","Type":"NodeParagraph","Properties":{"id":"20240902175526-qd9srqu","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【性味】甘；微苦；性凉"}]},{"ID":"20240902175526-r9omk9n","Type":"NodeParagraph","Properties":{"id":"20240902175526-r9omk9n","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【归经】肝；胆；肾；膀胱经"}]},{"ID":"20240902175526-stcn2hq","Type":"NodeParagraph","Properties":{"id":"20240902175526-stcn2hq","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【功能主治】利水通淋；清热解毒；散瘀消肿。主肝胆及泌尿系结石；热淋；肾炎水肿；湿热黄疸；疮毒痈肿；毒蛇咬伤；跌打损伤"}]},{"ID":"20240902175526-m1g03ax","Type":"NodeParagraph","Properties":{"id":"20240902175526-m1g03ax","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-60g，鲜品加倍；或捣汁饮。外用：适量，鲜品捣敷。"}]},{"ID":"20240902175526-3m405jp","Type":"NodeParagraph","Properties":{"id":"20240902175526-3m405jp","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【注意】据报道[《四川中医》1983，(3)：40]，外用本品引起接触性皮炎12例，均系风湿性关节炎、肩周炎患者，用鲜品煎水熏洗所致。］］"}]},{"ID":"20240902175526-vwvfsun","Type":"NodeParagraph","Properties":{"id":"20240902175526-vwvfsun","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【附方】本品与唇形科金钱草效用相仿而叶大，故名大金钱草。花、叶均对生，故有“对坐草”之称。喜生路边，茎蔓延，以形状之，称地蜈蚣、蜈蚣草。因花黄，亦称“过路黄”。可治黄疸，而称“黄疸草”。"}]},{"ID":"20240902175526-qki2gel","Type":"NodeParagraph","Properties":{"id":"20240902175526-qki2gel","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.胆宁片金钱草200g，人工牛黄30g，水飞蓟素17.5g，盐酸黄连素12.5g，延胡索125g，大黄125g，蒲公英150g，薄荷油2g。延胡索、大黄照渗漉法，以60%乙醇为溶剂渗漉，漉液70℃以下浓缩；蒲公英、金钱草加水煎煮至味尽，浓缩液与上述相合并再浓缩成稠膏状，干燥，粉碎，再与人工牛黄、水飞蓟素、盐酸黄连素及辅料制粒，喷薄荷油，压制成1000片，每片相当于原生药0.66g，包糖衣。片心呈棕褐色，具薄荷香气。功能利胆排石，抗菌消炎，解痉镇痛。用于急、慢性胆囊炎，也可用于胆道感染和胆结石。口服，每次2-3片，每日3-4次，胆囊炎10d为1个疗程。胆结石30d为1个疗程。(《陕西省药品标准》1985年)2.利肝片金钱草3288g，猪胆汁3125g。取金钱草1／2量粉碎成细粉；剩余水煎2次，分次滤过，合并滤液，浓缩成膏，加猪胆汁浓缩至相对密度1.08(热测)，加入乙醇，使含醇量达60%，沉淀，滤过，回收乙醇，浓缩成膏；将粉末、浓缩膏混合，加适量蔗糖粉和辅料，制粒，干燥，压片，包糖衣。每片重0.2g除去糖衣后呈灰褐色；味甘、苦。功能清肝利胆。用于急、慢性传染性肝炎，胆翼炎及肝脏分泌机能障碍。口服，每次2-4片，每日3次。(《吉林省药品标准》1986年；《江苏省药品标准》1977年)3.排石片金钱草1000g，木通300g，海金沙500g，滑石粉300g，车前草300g，地龙300g。地龙研细粉，过筛，备用；金钱草、海金沙、车前草、木通、滑石粉加水煎煮2次，滤过，滤液合并，浓缩至约260m1，加地龙粉混匀，烘干，研碎过18目筛，加硬脂酸镁，混匀，压制成1000片。功能清热利水，通淋排石。用于尿路结石。口服，每次6-8片，每日3次。(《湖南中草药制剂方剂选编》1976年)"}]},{"ID":"20240902175526-dy7nqjy","Type":"NodeParagraph","Properties":{"id":"20240902175526-dy7nqjy","updated":"20240902175549"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902175527-fa7so99","Type":"NodeThematicBreak","Properties":{"id":"20240902175527-fa7so99","updated":"20240902175549"}},{"ID":"20240902175528-nbork85","Type":"NodeParagraph","Properties":{"id":"20240902175528-nbork85","updated":"20240902175549"}}]}