{"ID":"20240205153750-8471mu2","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153750-8471mu2","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153750-8471mu2\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206085307-hs1aa29\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240619173003-eabdnqf\u0026quot;,\u0026quot;scrollTop\u0026quot;:1497,\u0026quot;focusId\u0026quot;:\u0026quot;20240619173003-eabdnqf\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"虎杖（酸筒杆）","type":"doc","updated":"20240902173609"},"Children":[{"ID":"20240206085307-hs1aa29","Type":"NodeParagraph","Properties":{"id":"20240206085307-hs1aa29","updated":"20240206085310"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产江苏、浙江、广东、安徽等地。\n【性状】\t多为圆柱形短段或不规则厚片，长17cm，直径0.52.5cm。外皮棕褐色，有纵皱纹及须根痕，切面皮部较薄，木部宽广，棕黄色，射线放射状，皮部与木部较易分离。根茎髓中有隔或呈空洞状。质坚硬。气微，味微苦、涩。\n【性味】\t微苦，微寒。\n【功效】\t清热解毒，利胆退黄，祛风利湿，散瘀定痛，止咳化痰。用于关节痹痛，湿热黄疸，经闭，癓瘕，咳嗽痰多，水火烫伤，跌扑损伤，痈肿疮毒。"}]},{"ID":"20240206085302-zdhnufu","Type":"NodeParagraph","Properties":{"id":"20240206085302-zdhnufu","updated":"20240206085302"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206085302-sjwzfp3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205161248-73j7do2","Type":"NodeParagraph","Properties":{"id":"20240205161248-73j7do2","updated":"20240205161248"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"虎杖"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/虎杖-20240205161248-yxcms4n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726082246-xag50qv","Type":"NodeParagraph","Properties":{"id":"20240726082246-xag50qv","updated":"20240726085927"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"虎杖 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/虎杖 10-20240726085921-3fsdq7g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726082202-re839u7","Type":"NodeParagraph","Properties":{"id":"20240726082202-re839u7","updated":"20240726085736"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 405px;","style":"width: 395px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"虎杖 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/虎杖 8-20240726085736-u033aue.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 395px;\" parent-style=\"width: 405px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 847px;","style":"width: 837px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"虎杖 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/虎杖 6-20240726082202-fzk3848.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 837px;\" parent-style=\"width: 847px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726090237-ki7qtdq","Type":"NodeParagraph","Properties":{"id":"20240726090237-ki7qtdq","updated":"20240726090325"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"