ldren":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 8-20240716135635-kauwawd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 682px;\" parent-style=\"width: 692px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 544px;","style":"width: 534px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 9-20240716140134-0q8i05n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 534px;\" parent-style=\"width: 544px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716135000-2rd5dnn","Type":"NodeParagraph","Properties":{"id":"20240716135000-2rd5dnn","updated":"20240716135513"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 6-20240716135154-yjkc9bk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 672px;","style":"width: 662px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 7-20240716135513-3r9qm1x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 662px;\" parent-style=\"width: 672px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716142120-oxo40le","Type":"NodeParagraph","Properties":{"id":"20240716142120-oxo40le","updated":"20240716142609"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 12-20240716142210-vodx2r0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 13-20240716142601-9yb01d6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716125301-xag5b8a","Type":"NodeParagraph","Properties":{"id":"20240716125301-xag5b8a","updated":"20240716125353"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为蕨类植物海金沙孢子里面的‘沙子’；"}]},{"ID":"20240716141217-z7xckkd","Type":"NodeParagraph","Properties":{"id":"20240716141217-z7xckkd","updated":"20240716141356"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：海金沙分有可育叶和不可育叶，只有可育叶也就是有孢子的叶片才能产‘沙’；"}]},{"ID":"20240716142218-ebgkuts","Type":"NodeParagraph","Properties":{"id":"20240716142218-ebgkuts","updated":"20240716142246"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：海金沙不沉于水；"}]},{"ID":"20240716125301-dy8qwjt","Type":"NodeThematicBreak","Properties":{"id":"20240716125301-dy8qwjt"}},{"ID":"20240902101734-hjuubof","Type":"NodeParagraph","Properties":{"id":"20240902101734-hjuubof","updated":"20240902101742"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：海金沙"}]},{"ID":"20240902101734-f2t4af8","Type":"NodeParagraph","Properties":{"id":"20240902101734-f2t4af8","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"海金沙《中国药典》"}]},{"ID":"20240902101734-jlaqvad","Type":"NodeParagraph","Properties":{"id":"20240902101734-jlaqvad","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【拼音名】HǎiJīnShā"}]},{"ID":"20240902101734-7j9gu6x","Type":"NodeParagraph","Properties":{"id":"20240902101734-7j9gu6x","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【英文名】SPORALYGODII"}]},{"ID":"20240902101734-caix1jd","Type":"NodeParagraph","Properties":{"id":"20240902101734-caix1jd","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【别名】金沙藤、左转藤、蛤蟆藤、罗网藤、铁线藤、吐丝草、鼎擦藤、猛古藤"}]},{"ID":"20240902101734-xhj91ou","Type":"NodeParagraph","Properties":{"id":"20240902101734-xhj91ou","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【来源】本品为海金沙科植物海金沙Lygodiumjaponicum（Thunb.）Sw.的干燥成熟孢子。秋季孢子未脱落时采割藤叶，晒干，搓揉或打下孢子，除去藤叶。"}]},{"ID":"20240902101734-36ko63a","Type":"NodeParagraph","Properties":{"id":"20240902101734-36ko63a","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈粉末状，棕黄色或浅棕黄色。体轻，手捻有光滑感，置手中易由指缝滑落。气微，味淡。"}]},{"ID":"20240902101734-on91fbt","Type":"NodeParagraph","Properties":{"id":"20240902101734-on91fbt","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902101734-mowjngq","Type":"NodeParagraph","Properties":{"id":"20240902101734-mowjngq","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"（1）取本品少量，撒于火上，即发出轻微爆鸣及明亮的火焰。"}]},{"ID":"20240902101734-k34yaa6","Type":"NodeParagraph","Properties":{"id":"20240902101734-k34yaa6","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"（2）本品粉末棕黄色或浅棕黄色。孢子为四面体、三角状圆锥形，顶面观三面锥形，可见三叉状裂隙，侧面观类三角形，底面观类圆形，直径60～85μm，外壁有颗粒状雕纹。"}]},{"ID":"20240902101734-h5q3edk","Type":"NodeParagraph","Properties":{"id":"20240902101734-h5q3edk","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性味】甘、咸，寒。"}]},{"ID":"20240902101734-sxrisje","Type":"NodeParagraph","Properties":{"id":"20240902101734-sxrisje","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【归经】归膀胱、小肠经。"}]},{"ID":"20240902101734-ytp2o0o","Type":"NodeParagraph","Properties":{"id":"20240902101734-ytp2o0o","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【功能主治】清利湿热，通淋止痛。用于热淋，砂淋，石淋，血淋，膏淋，尿道涩痛。"}]},{"ID":"20240902101734-dou0wxa","Type":"NodeParagraph","Properties":{"id":"20240902101734-dou0wxa","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【用法用量】6～15g，入煎剂宜包煎。"}]},{"ID":"20240902101734-h3xhmnf","Type":"NodeParagraph","Properties":{"id":"20240902101734-h3xhmnf","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902101734-ty9zol5","Type":"NodeParagraph","Properties":{"id":"20240902101734-ty9zol5","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用于热淋、石淋、膏淋等症，常与金前草、泽泻、滑石、石苇等药配伍应用。"}]},{"ID":"20240902101734-z11ejhg","Type":"NodeParagraph","Properties":{"id":"20240902101734-z11ejhg","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902101734-jyokzdr","Type":"NodeParagraph","Properties":{"id":"20240902101734-jyokzdr","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"海金沙《*辞典》"}]},{"ID":"20240902101734-ypmau96","Type":"NodeParagraph","Properties":{"id":"20240902101734-ypmau96","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【出处】《嘉佑本草》"}]},{"ID":"20240902101734-x1r10wa","Type":"NodeParagraph","Properties":{"id":"20240902101734-x1r10wa","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【拼音名】HǎiJīnShā"}]},{"ID":"20240902101734-gyv5z5h","Type":"NodeParagraph","Properties":{"id":"20240902101734-gyv5z5h","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【别名】左转藤灰（《四川中药志》），海金砂（《江西草药》）。"}]},{"ID":"20240902101734-rbgdkb3","Type":"NodeParagraph","Properties":{"id":"20240902101734-rbgdkb3","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【来源】为海金沙科植物海金沙的成熟孢子。立秋前后孢子成熟时采收，过早过迟均易脱落。选晴天清晨露水未干时，割下茎叶，放在衬有纸或布的筐内，于避风处晒干：然后用手搓揉、抖动，使叶背之孢子脱落，再用细筛筛去茎叶即可。"}]},{"ID":"20240902101734-nru3rfc","Type":"NodeParagraph","Properties":{"id":"20240902101734-nru3rfc","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产广东、浙江；江苏、江西、湖南、湖北、四川、广西、福建、陕西等地亦产。"}]},{"ID":"20240902101734-d6owj2i","Type":"NodeParagraph","Properties":{"id":"20240902101734-d6owj2i","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性状】干燥成熟的孢子，呈粉末状，棕黄色或淡棕色，质极轻，手捻之有光滑感。置手掌中即由指缝滑落；撒在水中则浮于水面，加热后逐渐下沉；易着火燃烧而发爆鸣及闪光，不留灰渣，以干燥、黄棕色、质轻光滑、能浮于水、无泥沙杂质、引燃时爆响者为佳。"}]},{"ID":"20240902101734-q28n200","Type":"NodeParagraph","Properties":{"id":"20240902101734-q28n200","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【化学成份】含脂肪油。另含一种水溶性成分海金沙素。"}]},{"ID":"20240902101734-p0n6khg","Type":"NodeParagraph","Properties":{"id":"20240902101734-p0n6khg","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902101734-k99x5a4","Type":"NodeParagraph","Properties":{"id":"20240902101734-k99x5a4","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"甘淡，寒。"}]},{"ID":"20240902101734-fi200t9","Type":"NodeParagraph","Properties":{"id":"20240902101734-fi200t9","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑦《品汇精要》：\"味淡，性平，无毒。\""}]},{"ID":"20240902101734-97kvlxk","Type":"NodeParagraph","Properties":{"id":"20240902101734-97kvlxk","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"甘，寒，无毒。\""}]},{"ID":"20240902101734-sbgf2nb","Type":"NodeParagraph","Properties":{"id":"20240902101734-sbgf2nb","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902101734-08p08rz","Type":"NodeParagraph","Properties":{"id":"20240902101734-08p08rz","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"入小肠、膀胱经。"}]},{"ID":"20240902101734-fzza3w2","Type":"NodeParagraph","Properties":{"id":"20240902101734-fzza3w2","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"小肠，膀胱血分。\""}]},{"ID":"20240902101734-1xnhadp","Type":"NodeParagraph","Properties":{"id":"20240902101734-1xnhadp","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入足少阴，手、足太阳经。\""}]},{"ID":"20240902101734-ta0wha2","Type":"NodeParagraph","Properties":{"id":"20240902101734-ta0wha2","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肾二经。\""}]},{"ID":"20240902101734-aqxulh7","Type":"NodeParagraph","Properties":{"id":"20240902101734-aqxulh7","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902101734-vzjkzh5","Type":"NodeParagraph","Properties":{"id":"20240902101734-vzjkzh5","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"清热解毒，利水通淋。治尿路感染，尿路结石，白浊，白带，肝炎，肾炎水肿，咽喉肿痛，痄腮，肠炎，痢疾，皮肤湿疹，带状疱疹。"}]},{"ID":"20240902101734-nk9ayia","Type":"NodeParagraph","Properties":{"id":"20240902101734-nk9ayia","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"①《嘉佑本草》：\"主通利小肠。得栀子、马牙消、蓬砂共疗伤寒热狂，或丸或散。\""}]},{"ID":"20240902101734-276xgvc","Type":"NodeParagraph","Properties":{"id":"20240902101734-276xgvc","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"治湿热肿满，小便热淋、膏淋、血淋、石淋，茎痛，解热毒气。\""}]},{"ID":"20240902101734-8b81m0t","Type":"NodeParagraph","Properties":{"id":"20240902101734-8b81m0t","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"利水通淋。治男子淫浊，女子带下。\""}]},{"ID":"20240902101734-p82nt22","Type":"NodeParagraph","Properties":{"id":"20240902101734-p82nt22","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"④《中国植物志》：\"治筋骨疼痛。\""}]},{"ID":"20240902101734-4chbj75","Type":"NodeParagraph","Properties":{"id":"20240902101734-4chbj75","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑤《广西中药志》：\"用于水肿及热病吐血。\""}]},{"ID":"20240902101734-0r37l0i","Type":"NodeParagraph","Properties":{"id":"20240902101734-0r37l0i","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑥《湖南药物志》：\"补脾健胃。治小儿食积。\""}]},{"ID":"20240902101734-daordkh","Type":"NodeParagraph","Properties":{"id":"20240902101734-daordkh","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑦广州部队《常用中草药手册》：\"治尿路感染，尿路结石，肾炎水肿，感冒发热，小便短亦，肠炎，痢疾。\""}]},{"ID":"20240902101734-boxwd65","Type":"NodeParagraph","Properties":{"id":"20240902101734-boxwd65","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑧《江西草药》：\"清热解毒，利尿除湿。治肝炎，肾性水肿，皮肤湿疹，水痘，尿血。痄腮，风火牙痛，喉蛾，白喉，带状疱疹，小儿L疳积。\""}]},{"ID":"20240902101734-ozecn2z","Type":"NodeParagraph","Properties":{"id":"20240902101734-ozecn2z","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～8钱；或研末服。"}]},{"ID":"20240902101734-6w3sjri","Type":"NodeParagraph","Properties":{"id":"20240902101734-6w3sjri","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902101734-4y78oc6","Type":"NodeParagraph","Properties":{"id":"20240902101734-4y78oc6","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"小便不利及诸淋由于肾水真阴不足者勿服。\""}]},{"ID":"20240902101734-xz05cjw","Type":"NodeParagraph","Properties":{"id":"20240902101734-xz05cjw","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"肾脏真阳不足者忌用。\""}]},{"ID":"20240902101734-jvf959c","Type":"NodeParagraph","Properties":{"id":"20240902101734-jvf959c","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902101734-3utr9si","Type":"NodeParagraph","Properties":{"id":"20240902101734-3utr9si","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"①治小便不通，脐下满闷：海金沙一两，腊面茶半两。二味捣研令细。每服三戗，生姜、甘草汤调下。（《本草图经》）"}]},{"ID":"20240902101734-toh4v3h","Type":"NodeParagraph","Properties":{"id":"20240902101734-toh4v3h","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②治热淋急痛：海金沙为末，生甘草汤冲服。（《泉州本草》）"}]},{"ID":"20240902101734-fsxsi9c","Type":"NodeParagraph","Properties":{"id":"20240902101734-fsxsi9c","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"③治膏淋：海金沙、滑石各一两（为末），甘草二钱半（为末）。上研匀。每服二钱，食前，煎麦门冬汤调服，灯心汤亦可。（《世医得效方，海金沙散）"}]},{"ID":"20240902101734-0cq3ixm","Type":"NodeParagraph","Properties":{"id":"20240902101734-0cq3ixm","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"④治尿酸结石症：海金沙、滑石共研为末。以车前子、麦冬、木通煎水调药末，并加蜜少许，温服。（《广西中药志》）"}]},{"ID":"20240902101734-aqsfy2k","Type":"NodeParagraph","Properties":{"id":"20240902101734-aqsfy2k","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑤治小便出血：海金沙为末，以新汲水调下。一方用砂糖水调下。（《普济方》）"}]},{"ID":"20240902101734-tox9hn9","Type":"NodeParagraph","Properties":{"id":"20240902101734-tox9hn9","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑥治肝炎：海金砂五钱，阴行草一两，车前六钱。水煎服，每日一剂。（《江西草药》）"}]},{"ID":"20240902101734-gt3vnj5","Type":"NodeParagraph","Properties":{"id":"20240902101734-gt3vnj5","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑦治脾湿太过通身肿满，喘不得卧，腹胀如鼓：牵牛一两（半生半炒），甘遂、海金沙各半两。上为细末。每服二钱，煎水一盏，食前调下，得利止后服。（《医学发明》海金沙散）"}]},{"ID":"20240902101734-4piarxn","Type":"NodeParagraph","Properties":{"id":"20240902101734-4piarxn","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"⑧治脾湿胀满：海金沙一两，白术二钱，甘草五分，黑丑一钱五分，水煎服。（《泉州本草》）"}]},{"ID":"20240902101734-87zn8vl","Type":"NodeParagraph","Properties":{"id":"20240902101734-87zn8vl","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902101734-v6vpvz5","Type":"NodeParagraph","Properties":{"id":"20240902101734-v6vpvz5","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"海金沙，甘寒淡渗之药，故主通利小肠，得牙硝、栀子，皆咸寒苦寒之极，又得蓬砂之辛，所以能治伤寒热狂大热，当利小便，此釜底抽薪之义也，淡能利窍。故治热淋，血淋、膏淋等病。\""}]},{"ID":"20240902101734-vqf3jdt","Type":"NodeParagraph","Properties":{"id":"20240902101734-vqf3jdt","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"②《本草述》：\"海金沙，方书但知其治血淋、膏淋、石淋等症，讵知其种种所患，皆本于湿土之气不能运化，而又有火以合之，乃结聚于水道有如是耳，岂可徒取责于行水之脏腑乎?试观东垣治脾湿方，更如续随子丸之亦治通身肿满、喘闷不快者，则可以思其功之所主，固不徒在行水之脏腑矣。\""}]},{"ID":"20240902101734-j6dk3ay","Type":"NodeParagraph","Properties":{"id":"20240902101734-j6dk3ay","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902101734-jijmwb2","Type":"NodeParagraph","Properties":{"id":"20240902101734-jijmwb2","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"海金沙《中华本草》《中药大辞典》"}]},{"ID":"20240902101734-9zpihh1","Type":"NodeParagraph","Properties":{"id":"20240902101734-9zpihh1","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【出处】出自《嘉佑本草》"}]},{"ID":"20240902101734-ddxgicc","Type":"NodeParagraph","Properties":{"id":"20240902101734-ddxgicc","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【拼音名】HǎiJīnShā"}]},{"ID":"20240902101734-cdhroqz","Type":"NodeParagraph","Properties":{"id":"20240902101734-cdhroqz","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【英文名】JapaneseClimbingFernSpore"}]},{"ID":"20240902101734-x98aulq","Type":"NodeParagraph","Properties":{"id":"20240902101734-x98aulq","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【别名】左转藤灰、海金砂"}]},{"ID":"20240902101734-ny92ybd","Type":"NodeParagraph","Properties":{"id":"20240902101734-ny92ybd","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902101734-t42osq3","Type":"NodeParagraph","Properties":{"id":"20240902101734-t42osq3","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"药材基源：为海金沙科植物海金沙的孢子。"}]},{"ID":"20240902101734-ke7f4lt","Type":"NodeParagraph","Properties":{"id":"20240902101734-ke7f4lt","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Lygodiumjaponicum(Thunb.)Sw.[OphioglossumjaponicumThunb.]"}]},{"ID":"20240902101734-qowkstc","Type":"NodeParagraph","Properties":{"id":"20240902101734-qowkstc","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"采收和储藏：立秋前后孢子成熟时采收，过早过迟均易脱落。选晴天清晨露水未干时，割下茎叶，放在衬有纸或布的筐内，于避风处晒干。然后用手搓揉、抖动，使叶背之孢子脱落，再用细筛筛去茎叶即可。"}]},{"ID":"20240902101734-fhyj850","Type":"NodeParagraph","Properties":{"id":"20240902101734-fhyj850","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生攀援草本，长1-4m。根茎细而匍匐，被细柔毛。茎细弱、呈干草色，有白色微毛。叶为1-2回羽状复叶，纸质，两面均被细柔毛；能育羽片卵状三角形，长12-20cm，宽10-16cm，小叶卵状披针形，边缘有温齿或不规则分裂，上部小叶无柄，羽状或戟形，下部小叶有柄；不育羽片尖三角形，通常与能育羽片相似，但有时为1回羽状复叶，小叶阔线形，或基部分裂成不规则的小片。孢子囊生于能育羽片的背面，在2回小叶的齿及裂片顶端成穗状排列，穗长2-4mm，孢子囊盖鳞片状，卵形，每盖下生一横卵形的孢子囊，环带侧生，聚集一处。孢子囊多在夏秋季产生。同属植物小叶海金沙Lygodiummicrophyllum(Cav.)R.Br.的全草，在广东、广西民间亦同供药用。与上种的主要区别点：羽片为1回羽状复叶，小叶片基部有关节。"}]},{"ID":"20240902101734-2w5wy5h","Type":"NodeParagraph","Properties":{"id":"20240902101734-2w5wy5h","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902101734-uft2anf","Type":"NodeParagraph","Properties":{"id":"20240902101734-uft2anf","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"生态环境：生于阴湿山坡灌丛中或路边林缘。"}]},{"ID":"20240902101734-lr1uuxa","Type":"NodeParagraph","Properties":{"id":"20240902101734-lr1uuxa","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南地区及陕西、甘肃。"}]},{"ID":"20240902101734-56c9w5z","Type":"NodeParagraph","Properties":{"id":"20240902101734-56c9w5z","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902101734-a6se53a","Type":"NodeParagraph","Properties":{"id":"20240902101734-a6se53a","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别孢子粉状，棕黄色或黄褐色。质轻滑润，撒入水中浮于水面，加热后则逐渐下沉，燃烧时发出爆鸣及闪光，无灰渣残留。气微，味淡。"}]},{"ID":"20240902101734-ep18ida","Type":"NodeParagraph","Properties":{"id":"20240902101734-ep18ida","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"以色棕黄、体轻、手捻光滑者为佳。"}]},{"ID":"20240902101734-prm61zh","Type":"NodeParagraph","Properties":{"id":"20240902101734-prm61zh","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别孢子淡黄色，四面体形，辐射对称。极面观钝三角形，赤道面观超半圆形，极轴长58-72（-97）μm，赤道轴长70-108μm；周壁具瘤状纹饰，有的周壁开裂或脱落，外壁光滑；具3裂缝。"}]},{"ID":"20240902101734-dwj0kgh","Type":"NodeParagraph","Properties":{"id":"20240902101734-dwj0kgh","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【化学成份】含脂肪油。另含一种水溶性成分海金沙素(Lygodin)。从孢子中分得反式-对-香豆酸(trans-p-coumaricacid)。另含脂肪油，经分析有肉豆蔻酸(0.15%)、棕榈酸(10.85%)、十六碳烯酸(0.55%)、硬脂酸(2.46%)、油酸(48.77%)、亚油酸(39.56%)、十八碳三烯酸(0.35%)、廿碳烷酸(0.88%)。"}]},{"ID":"20240902101734-ozf6ywp","Type":"NodeParagraph","Properties":{"id":"20240902101734-ozf6ywp","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902101734-x81l8sn","Type":"NodeParagraph","Properties":{"id":"20240902101734-x81l8sn","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"1.反式-对-香豆酸50mg/kg十二指肠注入，对大鼠具有利胆作用，给药后24小时达到最大效应，可持续4-5小时，胆汁平均增加20%，但不增加胆汁中胆红素和胆固醇的浓度，与脱氧胆酸相比，其利胆作用强度和持续时间基本相同，但起效缓慢。"}]},{"ID":"20240902101734-z4v2a6z","Type":"NodeParagraph","Properties":{"id":"20240902101734-z4v2a6z","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"2.海金沙中的反式对-香豆素有利胆作用:其作用机理是增加胆汁中水分的分泌，但并不增加胆汁中胆固醇和胆红素的分泌。其利胆强度与去氢胆酸相似，但克服了去氢胆酸引起的肝劳损和利胆减退不良反应，毒性也较低。海金沙中的咖啡酸也有利胆保肝作用。但亦有文献报道海金沙并无利尿作用。"}]},{"ID":"20240902101734-tkfpj5l","Type":"NodeParagraph","Properties":{"id":"20240902101734-tkfpj5l","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"3.有文献报道病人一次服海金沙150g（煎服）后不久出现舌麻、恶心、头晕、畏寒、尿频等严重不适症状。"}]},{"ID":"20240902101734-zd4ge9i","Type":"NodeParagraph","Properties":{"id":"20240902101734-zd4ge9i","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【性味】甘；淡；寒；无毒"}]},{"ID":"20240902101734-sqlt6yg","Type":"NodeParagraph","Properties":{"id":"20240902101734-sqlt6yg","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【归经】小肠；脾；膀胱经"}]},{"ID":"20240902101734-y50qx4z","Type":"NodeParagraph","Properties":{"id":"20240902101734-y50qx4z","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；利水通淋。主热淋；血淋；沙淋；白浊；女子带下；水湿肿满；湿热泻痢；湿热黄疸；吐血；衄血；尿血；外伤出血"}]},{"ID":"20240902101734-uibohql","Type":"NodeParagraph","Properties":{"id":"20240902101734-uibohql","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-9g，包煎；或研末，每次2-3g。"}]},{"ID":"20240902101734-jgg3re5","Type":"NodeParagraph","Properties":{"id":"20240902101734-jgg3re5","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【注意】肾阴亏虚者慎服。"}]},{"ID":"20240902101734-259w829","Type":"NodeParagraph","Properties":{"id":"20240902101734-259w829","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【附方】①治小便不通，脐下满闷：海金沙一两，腊面茶半两。二味捣研令细。每服三钱，生姜、甘草汤调下。(《本草图经》)②治热淋急痛：海金沙为末，生甘草汤冲服。(《泉州本草》)③治胃淋：海金沙、滑石各一两(为末)，甘草二钱半(为末)。上研习。每服二钱，食前，煎麦门冬汤调服，灯心汤亦可。(《世医得效方》海金沙散)④治尿酸结石症：海金沙、滑石共研为末。以车前子、麦冬、木通煎水调药末，并加蜜少许，温服。(《陕西中药志》)⑤治小便出血：海金沙为末，以新汲水调下。一方用砂糖水调下。(《普济方》)⑥治肝炎：海金砂五钱，阴行草一两，车前六钱。水煎服，每日一剂。(《江西草药》)⑦治脾湿太过，通身肿满，喘不得卧，腹胀如鼓：牵牛一两(半生半炒)，甘遂、海金沙各半两。上为细末。每服二钱，煎水一盏，食前调下，得利止后服。(《医学发明》海金沙散)⑧治脾湿胀满：海金沙一两，白术二钱，甘草五分，黑丑一钱五分。水煎服。(《泉州本草》)"}]},{"ID":"20240902101734-aljky07","Type":"NodeParagraph","Properties":{"id":"20240902101734-aljky07","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902101734-ueyolbs","Type":"NodeParagraph","Properties":{"id":"20240902101734-ueyolbs","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：海金沙，甘寒淡渗之药，故主通利小肠，得牙硝、栀子，皆咸寒苦寒之极，又得蓬砂之季，所以能治伤寒热狂大热，当利小便，此釜底抽薪之义也。淡能利窍，故治热淋、血淋、膏淋等病。"}]},{"ID":"20240902101734-90xt119","Type":"NodeParagraph","Properties":{"id":"20240902101734-90xt119","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"2.《本草述》：海金沙，方书但知其治血淋、膏淋、石淋等症，讵知其种种所患，皆本于湿土之气不能运化，而又有火以合之，乃结聚于水道有如是耳，岂可徒取责于行水之脏腑乎?试观东垣治脾湿方，更如续随子丸之亦治通身肿满、喘闷不快者，则可以思其功之所主，固不徒在行水之脏腑矣。"}]},{"ID":"20240902101734-zpzuibw","Type":"NodeParagraph","Properties":{"id":"20240902101734-zpzuibw","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"3.《嘉佑本草》：主通利小肠。马牙消、蓬砂共疗伤寒热狂，或丸或散。"}]},{"ID":"20240902101734-3iu2i1n","Type":"NodeParagraph","Properties":{"id":"20240902101734-3iu2i1n","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治湿热肿满，小便热淋、膏淋、血淋、石淋，茎痛，解热毒气。"}]},{"ID":"20240902101734-g0oc7wk","Type":"NodeParagraph","Properties":{"id":"20240902101734-g0oc7wk","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：利水通淋。治男子淫浊，女子带下。"}]},{"ID":"20240902101734-rywwo7h","Type":"NodeParagraph","Properties":{"id":"20240902101734-rywwo7h","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"6.《中国植物志》：治筋骨疼痛。"}]},{"ID":"20240902101734-jbfn4jg","Type":"NodeParagraph","Properties":{"id":"20240902101734-jbfn4jg","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"7.《广西中药志》：用于水肿及热病吐血。"}]},{"ID":"20240902101734-bgft5is","Type":"NodeParagraph","Properties":{"id":"20240902101734-bgft5is","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"8.《湖南药物志》：补脾健胃。治小儿食积。"}]},{"ID":"20240902101734-sfdd31d","Type":"NodeParagraph","Properties":{"id":"20240902101734-sfdd31d","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"9.广州部队《常用中草药手册》：治尿路感染，尿路结石，肾炎水肿，感冒发热，小便短赤，肠炎，痢疾。"}]},{"ID":"20240902101734-zz7rydt","Type":"NodeParagraph","Properties":{"id":"20240902101734-zz7rydt","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"10.《江西草药》：清热解毒，利尿除湿。治肝炎，肾性水肿，皮肤湿疹，水痘，尿血，痄腮，风火牙痛，喉蛾，白喉，带状疱疹，小儿疳积。"}]},{"ID":"20240902101734-3o5acyw","Type":"NodeParagraph","Properties":{"id":"20240902101734-3o5acyw","updated":"20240902101759"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》《中药大辞典》"}]},{"ID":"20240902101735-uk78syf","Type":"NodeThematicBreak","Properties":{"id":"20240902101735-uk78syf","updated":"20240902101759"}},{"ID":"20240902101736-dw08o1f","Type":"NodeParagraph","Properties":{"id":"20240902101736-dw08o1f","updated":"20240902101759"}}]}