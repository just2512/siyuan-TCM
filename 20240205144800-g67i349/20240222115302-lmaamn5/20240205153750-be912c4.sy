{"ID":"20240205153750-be912c4","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205153750-be912c4","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153750-be912c4\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206140635-ezjemk1\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240619184302-qh0to6h\u0026quot;,\u0026quot;scrollTop\u0026quot;:1082,\u0026quot;focusId\u0026quot;:\u0026quot;20240619184302-qh0to6h\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"海金沙（化石草、左转藤）","type":"doc","updated":"20240902101742"},"Children":[{"ID":"20240206140635-ezjemk1","Type":"NodeParagraph","Properties":{"id":"20240206140635-ezjemk1","updated":"20240206140644"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产湖南、湖北、江苏、浙江等地。\n【性状】\t孢子为细小，均匀的颗粒，多则聚成粉末状.棕黄色或淡棕黄色。质轻，用手捻之有光滑感，置手掌中，可由指缝间滑落。在扩大镜下观察为大小均匀，近圆形或钝三角形的四面体，三角锥状的颗粒。顶面观成三角锥形，并可见三叉状裂隙，侧面观成三角形，并可见外壁颗粒状细纹。\n【性味】\t甘，寒。\n【功效】\t清利湿热，通淋止痛。用于热淋、砂淋、血淋、膏淋、尿道涩痛。"}]},{"ID":"20240206140636-q5mj5qj","Type":"NodeParagraph","Properties":{"id":"20240206140636-q5mj5qj","updated":"20240206140636"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206140636-en74lup.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205161242-4a53fek","Type":"NodeParagraph","Properties":{"id":"20240205161242-4a53fek","updated":"20240205161242"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙-20240205161242-wl0wwnv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716141428-lro90rb","Type":"NodeParagraph","Properties":{"id":"20240716141428-lro90rb","updated":"20240716141445"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240716141428-0ogyinj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716141903-44ae9zd","Type":"NodeParagraph","Properties":{"id":"20240716141903-44ae9zd","updated":"20240716142033"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 10-20240716141903-01igb1h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 349px;","style":"width: 339px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 11-20240716142033-0a8vlua.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 339px;\" parent-style=\"width: 349px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716124930-q2cc27o","Type":"NodeParagraph","Properties":{"id":"20240716124930-q2cc27o","updated":"20240716125217"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 620px;","style":"width: 610px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海金沙 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海金沙 3-20240716125213-kqns0lu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"