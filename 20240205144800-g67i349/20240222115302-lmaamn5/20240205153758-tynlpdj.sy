Bang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白豆蔻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白豆蔻 3-20240727112555-keff83d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727112706-1stxadj","Type":"NodeParagraph","Properties":{"id":"20240727112706-1stxadj","updated":"20240727112745"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白豆蔻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白豆蔻 4-20240727112706-44ucapq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 407px;","style":"width: 397px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白豆蔻 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白豆蔻 5-20240727112745-zvfn0h8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 397px;\" parent-style=\"width: 407px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727112840-aj80q62","Type":"NodeParagraph","Properties":{"id":"20240727112840-aj80q62","updated":"20240727120539"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 811px;","style":"width: 801px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白豆蔻 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白豆蔻 6-20240727112840-ov2adga.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 801px;\" parent-style=\"width: 811px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619182614-b3hs7df","Type":"NodeParagraph","Properties":{"id":"20240619182614-b3hs7df"}},{"ID":"20240206095948-aert2zs","Type":"NodeParagraph","Properties":{"id":"20240206095948-aert2zs","updated":"20240730131016"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红豆蔻（红蔻）（高良姜种子）"}]},{"ID":"20240206100001-4nt5jhk","Type":"NodeParagraph","Properties":{"id":"20240206100001-4nt5jhk","updated":"20240206100004"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产海南、广东等地。\n【性状】\t果实长圆形，中部稍收缩，长0.71.5cm，直径0.41cm，表面红棕色或淡红棕色，光滑或皱缩，先端有突出的花被残基，基部有果柄痕；果皮薄；易碎。种子呈三角状多面体，分3室，每室有种子2粒；种子呈不规则状四面体，长46mm，直径36mm，表面暗棕色或褐棕色，微有光泽，具不规则皱纹，外被淡黄色或灰黄色假种皮，背面有凹陷种脐，合点位于腹面，种脊成一浅纵沟。气芳香而浓，味辛、辣。\n【性味】\t辛，温。\n【功效】\t温中燥湿；燥湿散寒，醒脾消食。用于脘腹冷痛、食积胀满、呕吐泄泻、饮酒过多。用于脘腹冷痛；食积腹胀，呕吐泄泻；噎膈反胃 。"}]},{"ID":"20240206095955-xddt5d3","Type":"NodeParagraph","Properties":{"id":"20240206095955-xddt5d3","updated":"20240206095955"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206095955-hko1zfh.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726171213-vak5y1d","Type":"NodeParagraph","Properties":{"id":"20240726171213-vak5y1d","updated":"20240726171249"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240726171213-qhwrady.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902174620-yt8vx89","Type":"NodeParagraph","Properties":{"id":"20240902174620-yt8vx89","updated":"20240902174620"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 4-20240726172909-4ukp4aj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726165752-sqqvcyf","Type":"NodeParagraph","Properties":{"id":"20240726165752-sqqvcyf","updated":"20240726172258"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 1-20240726172210-d9g8226.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 2-20240726172258-g0urr6j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726173249-6a85rnl","Type":"NodeParagraph","Properties":{"id":"20240726173249-6a85rnl","updated":"20240727120554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 487px;","style":"width: 477px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 6-20240726173102-4eywn5f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 477px;\" parent-style=\"width: 487px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 666px;","style":"width: 656px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 7-20240726173142-agaexa9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 656px;\" parent-style=\"width: 666px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730131110-z21cyam","Type":"NodeParagraph","Properties":{"id":"20240730131110-z21cyam","updated":"20240730131944"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 738px;","style":"width: 728px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 5-20240726173008-hcc0wof.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 728px;\" parent-style=\"width: 738px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"高良姜 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/高良姜 15-20240717133516-i03abhb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240726171858-dn2uv9u","Type":"NodeParagraph","Properties":{"id":"20240726171858-dn2uv9u","updated":"20240726172644"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻-20240726171957-oevjroh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 892px;","style":"width: 882px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红豆蔻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红豆蔻 3-20240726172644-jqa8v8j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 882px;\" parent-style=\"width: 892px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727105635-d1ns2qg","Type":"NodeParagraph","Properties":{"id":"20240727105635-d1ns2qg","updated":"20240730130824"}},{"ID":"20240726171359-enprw8y","Type":"NodeParagraph","Properties":{"id":"20240726171359-enprw8y","updated":"20240726171359"}},{"ID":"20240206094458-w9jtif0","Type":"NodeParagraph","Properties":{"id":"20240206094458-w9jtif0","updated":"20240206094501"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉豆蔻"}]},{"ID":"20240206102724-ockrd0e","Type":"NodeParagraph","Properties":{"id":"20240206102724-ockrd0e","updated":"20240206102735"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产马来西亚、印尼、斯里兰卡等地，我国广东、广西、云南亦有栽培。\n【性状】\t该品呈卵圆形或椭圆形，长23cm，直径1.52.5cm。表面灰棕色或灰黄色，有时外被白粉 (石灰粉末) 。全体有浅色纵行沟纹及不规则网状沟纹。种脐位于宽端，呈浅色圆形突起，合点呈暗凹陷。种脊呈纵沟状，连接两端。质坚，断面显棕黄色相杂的大理石花纹，宽端可见干燥皱缩的胚，富油性。气香浓烈，味辛。\n【性味】\t辛、苦，温。\n【功效】\t温中涩肠；行气消食。用于虚泻；冷痢；脘腹胀痛；食少呕吐；宿食不消。\n【注解】\t“槟榔纹”：指药材表面或断面呈深浅色相间的花纹，如同槟榔断面的纹理，也称为“大理石花纹”。"}]},{"ID":"20240206102724-n4fxckd","Type":"NodeParagraph","Properties":{"id":"20240206102724-n4fxckd","updated":"20240206102724"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206102724-v2xydbl.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240206094501-1kx4ajg","Type":"NodeParagraph","Properties":{"id":"20240206094501-1kx4ajg","updated":"20240727124920"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻-20240205165340-26d5ong.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 9-20240727124920-9dfjb2n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727124804-93brv8e","Type":"NodeParagraph","Properties":{"id":"20240727124804-93brv8e","updated":"20240727124805"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1203px;","style":"width: 1193px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 8-20240727124758-t10l050.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1193px;\" parent-style=\"width: 1203px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727123441-mgj49a5","Type":"NodeParagraph","Properties":{"id":"20240727123441-mgj49a5","updated":"20240727124321"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 4-20240727123441-dju11s1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 327px;","style":"width: 317px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240727123539-xa5yngy.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 317px;\" parent-style=\"width: 327px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240727122827-lj9ra0g","Type":"NodeParagraph","Properties":{"id":"20240727122827-lj9ra0g","updated":"20240727123447"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻-20240727121033-813h58f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 2-20240727122958-64nd817.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727123008-26828bw","Type":"NodeParagraph","Properties":{"id":"20240727123008-26828bw","updated":"20240727123447"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 1-20240727122827-pnzltmu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 591px;","style":"width: 581px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 3-20240727123221-9lhwcfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727124427-ewmbdfr","Type":"NodeParagraph","Properties":{"id":"20240727124427-ewmbdfr","updated":"20240727125020"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 7-20240727124427-vm87ipc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 649px;","style":"width: 639px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 10-20240727125020-u3ogxxn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 639px;\" parent-style=\"width: 649px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727124001-b6s53g1","Type":"NodeParagraph","Properties":{"id":"20240727124001-b6s53g1","updated":"20240727124119"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 509px;","style":"width: 499px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 5-20240727124001-csu4n9b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 499px;\" parent-style=\"width: 509px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 479px;","style":"width: 469px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"肉豆蔻 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/肉豆蔻 6-20240727124119-6v4t97m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 469px;\" parent-style=\"width: 479px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727114856-7ciruw7","Type":"NodeParagraph","Properties":{"id":"20240727114856-7ciruw7","updated":"20240727120745"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：豆蔻从植株外形取对比图过于困难，也没找到比较权威的视频，如取图错误烦请指正；"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727114944-uw7k5l9","Type":"NodeParagraph","Properties":{"id":"20240727114944-uw7k5l9","updated":"20240727120750"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：关于姜科植物艳山姜众说纷纭，有称豆蔻、草豆蔻、红豆蔻都有、个人难以查证，故区分开，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"如错误烦请指正"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只知道都能作香料使用；点我跳转艳山姜→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240718160632-j9n6kdo","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"艳山姜"}]},{"ID":"20240727114857-utqmdk8","Type":"NodeThematicBreak","Properties":{"id":"20240727114857-utqmdk8"}},{"ID":"20240902174723-gsv06rs","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240902174723-gsv06rs","updated":"20240902174950"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：草豆蔻"}]},{"ID":"20240902174723-u6gtfhe","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-u6gtfhe","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"草豆蔻《中国药典》"}]},{"ID":"20240902174723-eubfci7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-eubfci7","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【拼音名】CǎoDòuKòu"}]},{"ID":"20240902174723-lbz6fcp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-lbz6fcp","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENALPINIAEKATSUMADAI"}]},{"ID":"20240902174723-gi14noh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-gi14noh","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【别名】草蔻、草蔻仁、假麻树、偶子"}]},{"ID":"20240902174723-d7jiflm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-d7jiflm","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【来源】本品为姜科植物草豆蔻AlpiniakatsumadaiHayata的干燥近成熟种子。夏、秋二季采收，晒至九成干，或用水略烫，晒至半干，除去果皮，取出种子团，晒干。"}]},{"ID":"20240902174723-3zw5bsa","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-3zw5bsa","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性状】本品为类球形的种子团，直径1.5～2.7cm。表面灰褐色，中间有黄白色的隔膜，将种子团分成3瓣，每瓣有种子多数，粘连紧密，种子团略光滑。种子为卵圆状多面体，长3～5mm，直径约3mm，外被淡棕色膜质假种皮，种脊为一条纵沟，一端有种脐；质硬，将种子沿种脊纵剖两瓣，纵断面观呈斜心形，种皮沿种脊向内伸入部分约占整个表面积的1/2；胚乳灰白色。气香，味辛，微苦。"}]},{"ID":"20240902174723-zo4dtb6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-zo4dtb6","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902174723-7a9m9x2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-7a9m9x2","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：假种皮有时残存，为多角形薄壁细胞。种皮表皮细胞类圆形，壁较厚；下皮为1～3列薄壁细胞，略切向延长；色素层为数列棕色细胞，其间散有类圆形油细胞1～2列，直径约50μm；内种皮为1列栅状厚壁细胞，棕红色，内壁与侧壁极厚，胞腔小，内含硅质块。外胚乳细胞含淀粉粒及草酸钙方晶和少数细小簇晶。内胚乳细胞含糊粉粒。"}]},{"ID":"20240902174723-qflanar","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-qflanar","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"粉末黄棕色。种皮表皮细胞表面观呈长条形，直径约至30μm，壁稍厚，常与下皮细胞上下层垂直排列；下皮细胞表面观长多角形或类长方形。色素层细胞皱缩，界限不清楚，含红棕色物，易碎裂成不规则色素块。油细胞散列于色素层细胞间，呈类圆形或长圆形，含黄绿色油状物。内种皮厚壁细胞黄棕色或红棕色，表面观多角形，壁厚，非木化，胞腔内含硅质块；断面观细胞1列，栅状，内壁及侧壁极厚，胞腔偏外侧，内含硅质块。外胚乳细胞充满淀粉粒集结成的淀粉团，有的包埋有细小草酸钙方晶。内胚乳细胞含糊粉粒及脂肪油滴。"}]},{"ID":"20240902174723-vblnd07","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-vblnd07","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加甲醇5ml，置水浴中加热振摇5分钟，滤过，滤液作为供试品溶液。另取山姜素和小豆蔻明对照品，加甲醇制成每1ml各含2mg的混合溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5μl，分别点于同一硅胶Ｇ薄层板上，以苯－醋酸乙酯－甲醇（15:4:1）为展开剂，展开，取出，晾干，于100℃加热至斑点显色清晰，置紫外光灯（365nm）下检视。供试品色谱中，在与山姜素对照品色谱相应的位置上，显相同的浅蓝色荧光斑点；在与小豆蔻明对照品色谱相应的位置上，显相同的棕褐色斑点。再喷以5％三氯化铁乙醇溶液，日光下检视。供试品色谱中，在与小豆蔻明对照品色谱相应的位置上，显相同的褐色斑点。"}]},{"ID":"20240902174723-e6eecey","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-e6eecey","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质。用时捣碎。"}]},{"ID":"20240902174723-4r4kms4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-4r4kms4","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902174723-wsexm8f","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wsexm8f","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃经。"}]},{"ID":"20240902174723-vswe3pd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-vswe3pd","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【功能主治】燥湿健脾，温胃止呕。用于寒湿内阻，脘腹胀满冷痛，嗳气呕逆，不思饮食。"}]},{"ID":"20240902174723-3tq6msl","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-3tq6msl","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～6g。"}]},{"ID":"20240902174723-v624ah8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-v624ah8","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902174723-f6f6flk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-f6f6flk","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用于湿阻脾胃之脘腹胀满，尤以寒湿偏盛者为宜，常与川、仆砂仁、陈皮等配合应用。用治寒湿郁滞呕吐，常与半夏、生姜等配伍应用。若是寒湿脚气兼有呕吐者可配吴茱萸、槟榔等同用。"}]},{"ID":"20240902174723-m0o4f3u","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-m0o4f3u","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902174723-k8evre1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-k8evre1","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"草豆蔻《*辞典》"}]},{"ID":"20240902174723-zduwned","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-zduwned","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【出处】《雷公炮炙论》"}]},{"ID":"20240902174723-we9s9et","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-we9s9et","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【拼音名】CǎoDòuKòu"}]},{"ID":"20240902174723-yzged50","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-yzged50","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【别名】豆蔻（《别录》），漏蔻（《南方异物志》），草果（《通志》），草蔻（《本草从新》），大草蔻（《药材资料汇编》），偶子（《中药志》），草蔻仁、飞雷子、弯子（《广东中药》）。"}]},{"ID":"20240902174723-xhsk2an","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-xhsk2an","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【来源】为婪科植物草豆蔻的种子团。秋季果实略变黄色时采收，采得后晒至八、九成干，剥去果皮，再晒至足干。或将果实用沸水略烫后晒至半干，去其果皮，再晒至足干。宜置阴凉干燥处。"}]},{"ID":"20240902174723-g2ugeq5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-g2ugeq5","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本，高1～2米。根状茎粗壮，棕红色。叶2列，具短柄；叶片狭椭圆形或披针形，长30～55厘米，宽2～9厘米，先端渐尖，基部楔形，全缘，两面被疏毛或光滑；叶鞘膜质，抱茎，叶舌广卵形，长3～6毫米，密被绒毛。总状花序顶生，总花梗长30厘米，密被黄白色长硬毛；花疏生，小苞片宽大，长2.5～3.5厘米，外被粗毛，花后脱落；萼筒状，长约2厘米，外被疏柔毛，一边开裂，顶端3裂；花冠白色，花冠管长约1.2厘米，上部3裂，中间裂片长圆形，两侧裂片椭圆形，唇瓣阔卵形，先端有3个浅圆裂片，边缘具缺刻，白色，内面具淡紫红色斑点；侧生退化雄蕊极短或不存在，发育雄蕊1，花丝扁圆形，粗大，具槽；子房下位，卵田形，密被淡黄色绢毛，花柱细长，紧贴于花丝槽内，从药隔中穿出，基部具2棒状附属物，柱头略膨大，顶端下陷，具缘毛。蒴果圆球形，外被粗毛，萼宿存，熟时黄色。花期4～6月。果期5～8月。"}]},{"ID":"20240902174723-1w15w08","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-1w15w08","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于林缘灌木丛边缘的草丛中或山坡高草丛中。分布广东、广西等地。主产广西、广东等地。"}]},{"ID":"20240902174723-nr3xdo9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-nr3xdo9","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性状】干燥种子团呈圆球形或椭圆形，直径1.5～2.5厘米，表面灰白色或灰棕色。中间有白色隔膜分成3瓣，每瓣有种子多数粘连紧密。种子卵圆状多角形，长3～5毫米，直径约3毫米。表面灰棕色，被一层白色透明的假种皮，背稍隆起，合点约在中央，种脐位于背侧面，种脊为一纵沟，经腹面至合点，破开后里面灰白色。气芳香，味辛辣。以个圆、坚实者为佳。"}]},{"ID":"20240902174723-meocext","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-meocext","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含山姜素、小豆蔻明。"}]},{"ID":"20240902174723-ffwaf39","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ffwaf39","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902174723-xzj44bz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-xzj44bz","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"拣净杂质，去壳取仁，用时捣碎。"}]},{"ID":"20240902174723-bmju8rg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-bmju8rg","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》:\"凡使（草豆蔻），须去蒂，取向里子后皮，用茱萸同于鏊上缓炒，待茱萸微黄黑，即去茱萸，取草豆蔻皮及子，杵用之。\""}]},{"ID":"20240902174723-id6i1ei","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-id6i1ei","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《药类法象》:\"（草豆蔻）面包煨熟，去面用。\""}]},{"ID":"20240902174723-tmsexxd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-tmsexxd","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902174723-patiwk8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-patiwk8","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902174723-ugnnyby","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ugnnyby","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①《别录》:\"味辛，温，无毒。\""}]},{"ID":"20240902174723-53g6htq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-53g6htq","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》:\"味辛，温，涩，无毒。\""}]},{"ID":"20240902174723-qwlpz6l","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-qwlpz6l","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"③《医学启源》:\"气热，味大辛。\""}]},{"ID":"20240902174723-tsj8kvk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-tsj8kvk","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902174723-5mn3080","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-5mn3080","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"入脾、胃经。"}]},{"ID":"20240902174723-da6zt2q","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-da6zt2q","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》:\"入足太阴、阳明经。\""}]},{"ID":"20240902174723-zxlpzqj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-zxlpzqj","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《本草再新》:\"入心、脾、肺三经。\""}]},{"ID":"20240902174723-u3jzc1j","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-u3jzc1j","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902174723-r14dw6h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-r14dw6h","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"温中，祛寒，行气，燥湿。治心腹冷痛，痞满食滞，噎膈反胃，寒湿吐泻，痰饮积聚。"}]},{"ID":"20240902174723-eq3rlt2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-eq3rlt2","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"燥湿健脾，温胃止呕。用于寒湿内阻、脘腹胀满冷痛、嗳气呕逆、不思饮食。"}]},{"ID":"20240902174723-jy7e8o5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-jy7e8o5","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"（1）健脾燥湿：用于脾胃虚弱或寒湿郁滞引起的食欲不振，常配木瓜。"}]},{"ID":"20240902174723-oggqydf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-oggqydf","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"（2）温中止呕：用于寒湿郁滞中焦引起的胃痛呕吐，常配高良姜。"}]},{"ID":"20240902174723-drdtwt7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-drdtwt7","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①《别录》:\"主温中，心腹痛，呕吐，去口臭气。\""}]},{"ID":"20240902174723-d22lloz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-d22lloz","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》:\"下气，止霍乱。\""}]},{"ID":"20240902174723-l3lpcvd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-l3lpcvd","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》:\"益脾胃、去寒，又治客寒心胃痛。\""}]},{"ID":"20240902174723-t9uelby","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-t9uelby","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"④《纲目》:\"治瘴疠寒疟，伤暑吐下泄痢，噎膈反胃，痞满吐酸，痰饮积聚，妇人恶阻带下，除寒燥湿，开郁破气，杀鱼肉毒。\""}]},{"ID":"20240902174723-sbqst8d","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-sbqst8d","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"⑤《本草原始》:\"补脾胃，磨积滞，调散冷气甚逮，虚弱不能饮食者最宜，兼解酒毒。\""}]},{"ID":"20240902174723-u243s6t","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-u243s6t","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服:煎汤，0.8～1.5钱；或入丸、散。"}]},{"ID":"20240902174723-o9mhsjx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-o9mhsjx","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902174723-m51racm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-m51racm","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"阴虚血少，津液不足，无寒湿者忌服。"}]},{"ID":"20240902174723-937992k","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-937992k","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》:\"凡疟不由于瘴气；心痛胃脘痛由于火而不由于寒；湿热瘀滞，暑气外侵而成滞下赤白，里急后重，及泄泻暴注口渴，湿热侵脾，因作胀满，或小水不利，咸属暑气湿热，皆不当用。\""}]},{"ID":"20240902174723-kzpmvbi","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-kzpmvbi","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《本草备要》:\"忌铁。\""}]},{"ID":"20240902174723-sfg6zmw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-sfg6zmw","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》:\"阴虚血燥者忌之。\""}]},{"ID":"20240902174723-5j1zvi4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-5j1zvi4","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902174723-qhz5zhr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-qhz5zhr","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①治脾胃虚弱，不思饮食，呕吐满闷、心腹痛:草豆蔻肉八两，生姜（和皮切作片子）一片，甘草四两（锉碎）。上三味匀和入银器内，用水过药三指许，慢火熬令水尽，取出，焙干，杵为末。每服一钱，沸汤点服。夏月煎之，作冷汤服亦妙。（《博济方》豆蔻汤）"}]},{"ID":"20240902174723-3zdb7os","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-3zdb7os","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②治呕逆不下食，腹中气逆:豆蔻子七枚（碎），生姜五两，人参一两，甘草一两（炙）。上四味切，以水四升，煮取一升五合，去滓。分温二服，相去如人行五，六里。忌海藻、菘菜。（《广济方》豆蔻子汤）"}]},{"ID":"20240902174723-t2ha98b","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-t2ha98b","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"③治冷痰呕逆，胸脯不利:草豆蔻（去皮）、半夏（汤洗去滑，切，焙）各半两，陈橘皮（汤浸去白，焙）三分。上三味，粗捣筛。每服三钱匕，水一盏，入生姜五片，煎至七分，去滓温眼，不拘时侯。（《圣济总录》豆蔻汤）"}]},{"ID":"20240902174723-gpizsc1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-gpizsc1","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"④治胃口冷，吃食无味及脾泄泻不止，兼治酒后数囿如痢，心胸不快，不思饮食:草豆蔻半两（每个面裹煨，候面焦黄，去面用），甘草一两（炙），肉桂（去皮）一两，陈皮（去白）一两，蛮姜一两。上五味，同为细末。每服一钱半，更入陈米末一钱，水一盏，枣二枚，同煎七分，温服，其滓再煎服之。（《博济方》草豆蔻散）"}]},{"ID":"20240902174723-lj0i5ep","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-lj0i5ep","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"⑤治小儿藏寒泄泻不止:草豆蔻一枚，剥开皮，入乳香一块在内，复用白面裹，慢火烧令熟，去面及豆蔻皮不用；上为细末，以粟米饮丸如麻子大。每服五、七丸，米饮下，无时。（《史载之方》豆蔻丸）"}]},{"ID":"20240902174723-auqmsbe","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-auqmsbe","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"⑥治霍乱心烦渴，吐利不下食:草豆蔻（去皮）一分，黄连（去须）一两。上二味，粗捣筛。每胀三钱匕，水一盏，乌豆五十粒，生姜三片，煎至七分，去滓温服，日三。（《圣济总录》草豆蔻汤）"}]},{"ID":"20240902174723-s5ex0eb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-s5ex0eb","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"⑦治老疟久而不瘥，及山岚瘴气，远年不愈，兼治脾寒:草豆蔻、肉豆蔻各二个（并用面裹煨，一生一熟），厚朴方圆二寸（一半姜制，一半生用），甘草中指大（一半生，一半炙），生姜枣大二块（一块用湿纸裹煨，一块生用）。上分为二大剂，于发前临晓，用水一升，煎取八合，放至来早，再温服，留滓再煎二次。（《鸡峰普济方》草豆蔻散）"}]},{"ID":"20240902174723-ybm17nr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ybm17nr","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"⑧香口辟臭:豆蔻、细辛，为末含之。（《肘后方》）"}]},{"ID":"20240902174723-joc6c5o","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-joc6c5o","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902174723-vg7qnsj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-vg7qnsj","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"①朱震亨:\"草豆蔻，性温，能散滞气，消膈上痰。若明知身受寒邪，日食寒物，胃脘作疼，方可温散，用之如鼓应桴。或湿痰郁结成病者，亦效。若热郁者不可用，恐积温成热也，必用栀子之剂。\""}]},{"ID":"20240902174723-c6i3qts","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-c6i3qts","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"②《纲目》:\"豆蔻治病，取其辛热浮散，能入太阴、阳明，除寒燥湿，开郁化食之力而已。南地卑下，山岚烟瘴，饮啖酸咸，脾胃常多寒湿郁滞之病，故食料必用，与之相宜。然过多亦能助脾热，伤肺损目。\""}]},{"ID":"20240902174723-ha9ipap","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ha9ipap","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》:\"豆蔻，辛能破滞，香能入脾，温热能祛寒燥湿，故主温中及寒客中焦、心腹痛、中寒呕吐也。脾开窍于口，脾家有积滞，则瘀而为热，故发口臭，醒脾导滞，则口气不臭矣。辛散温行，故下气。寒客中焦，饮食不消，气因闭滞则霍乱。又散-切冷气、消酒毒者，亦燥湿破滞、行气健脾开胃之功也。产闽之建宁者，气芳烈，类白豆蔻，善散冷气，疗胃脘痛，理中焦。产滇、贵、南粤者，气猛而浊，俗呼草果者是也，善破瘴疠，消谷食，及一切宿食停滞作胀闷及痛。\""}]},{"ID":"20240902174723-8f87zct","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-8f87zct","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"④《本草求真》:\"草豆蔻，辛热香散，功与肉蔻相似，但此辛热燥湿除寒，性兼有涩，不似肉蔻涩性居多，能止大肠滑脱不休也。又功与草果相同，但此止逐风寒客在胃口之上,症见当心疼痛，不似草果辛热浮散，专治瘴疠寒疟也。故凡湿郁成病，而见胃脘作疼，服之最为有效。若使郁热内成，及阴虚血燥者，服之为大忌耳。\""}]},{"ID":"20240902174723-wm5jyob","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wm5jyob","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【备注】《开宝本草》及《本草图经》均谓《别录》所载之豆蔻即草豆蔻，但观其所述形态及《证类本草》\"宜州豆蔻\"附图，似为Amomum属植物，与现用Alpinia属的草豆蔻不同。"}]},{"ID":"20240902174723-no8rcpp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-no8rcpp","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902174723-1vcalh6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-1vcalh6","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"草豆蔻《中华本草》"}]},{"ID":"20240902174723-idu9tmt","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-idu9tmt","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902174723-bqzve7s","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-bqzve7s","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"出自《雷公炮炙论》。"}]},{"ID":"20240902174723-wj7cbjh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wj7cbjh","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：豆蔻，苗似山姜，花黄白，苗根及子亦似杜若。"}]},{"ID":"20240902174723-a1ihn4a","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-a1ihn4a","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"2.《海药本草》：豆蔻，其根似益智，皮壳小厚，核如石榴，辛且香，蒳草树也。叶如芄兰而小，三月采其叶，细破阴干之，味近苦而有甘。"}]},{"ID":"20240902174723-oh90tr5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-oh90tr5","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，豆蔻苗似杜若；春花在穗端，如芙蓉，四房生于茎下，白色，花开即黄；根似高良姜；实若龙眼而无鳞甲，中如石榴子；茎、叶、子皆味辛而香。十月收。"}]},{"ID":"20240902174723-nqokloy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-nqokloy","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【拼音名】CǎoDòuKòu"}]},{"ID":"20240902174723-yajd75y","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-yajd75y","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【英文名】KatsumadeGalangalSeed,SeedofKatsumadaGalangal"}]},{"ID":"20240902174723-64uobat","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-64uobat","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【别名】豆蔻、漏蔻、草果、豆蔻子、草蔻、大草蔻、偶子、草蔻仁、飞雷子、弯子"}]},{"ID":"20240902174723-23rawa2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-23rawa2","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902174723-i8wyyn9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-i8wyyn9","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"药材基源：为姜科植物草豆蔻的种子团。"}]},{"ID":"20240902174723-rqr1gbe","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-rqr1gbe","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：AlpiniakatsumadaiHayat[Languaskatsumadai(Hayata)Merr.]"}]},{"ID":"20240902174723-w9sfd81","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-w9sfd81","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋委果熟时采收，晒至8-9成干，剥除果皮取出种子团晒干。"}]},{"ID":"20240902174723-irchgux","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-irchgux","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【原形态】草豆蔻，多年生草本，株高1.5-3m。叶柄长1.5-2cm；叶片狭椭圆形或线状披针形，长50-65cm，宽6-9cm，先端渐尖，基部渐狭，有缘毛，两面无毛或仅在下面被极疏的粗毛；叶舌卵菜，长5-8mm，外被粗毛。总状花序顶生，直立，长20-30cm，花序轴密被粗毛，小花梗长约3m，小苞片乳白色，阔椭圆形，长约3.5cm，先端钝圆，基部连合；花萼钟状，白色，长1.5-2.5cm，先端有不规则3钝齿，1侧深裂，外被毛；花冠白色，花冠管长约8mm，裂片3，长圆形，上方裂片较大，长约3.5cm，宽约3.0cm，先端2浅裂，边缘具缺刻，前部具红色或红黑色条纹，后部具淡紫红色斑点；侧生退化雄蕊披针形，长4mm或有时不存；雄蕊1，长2.2-2.5cm，花药椭圆形，药隔背面被腺毛，花丝扁平，长约1.5cm；子房卵圆形，下位，密被淡黄色绢毛。蒴果近圆形，直径约3cm，外被粗毛，熟时黄色。花期4-6月，果期6-8月。"}]},{"ID":"20240902174723-mux7ava","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-mux7ava","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902174723-g9fm5wj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-g9fm5wj","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山地、疏林、沟谷、河边及林缘湿处。"}]},{"ID":"20240902174723-ahs17jv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ahs17jv","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于广东、海南、广西等地。"}]},{"ID":"20240902174723-kf9m8th","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-kf9m8th","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902174723-vkgvzmu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-vkgvzmu","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"生物学特性，喜温暖湿润气候和半荫蔽的环境。以先稀林下层深厚、肥沃疏松的壤土地栽培为宜。栽培技术，用种子和分株繁殖。种子繁殖：选有一定荫蔽条件的地块作苗床，6-7月间，按行距20cm开沟条播，覆土2-3cm。出苗后及时除草、追肥。第2年春季，按行株距80cm×80cm定植。分株繁殖：2-3月将母株挖起，先1-2年生健壮而且尚未结果的分蘖株作种移栽。"}]},{"ID":"20240902174723-cdn225r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-cdn225r","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"田间管理，定植后经常注意中耕除草、培土、追肥，干旱时及时灌水，遇雨季及时排水。根据草豆蔻生育期要求的光强调整荫蔽度，荫蔽度过大则砍除过多的荫蔽树枝，荫蔽度过小则补种荫蔽树。"}]},{"ID":"20240902174723-vz8sasf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-vz8sasf","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902174723-e29389z","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-e29389z","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"性状鉴别，种了了团类球形或椭圆形，具较明显的3钝棱及3浅沟，长1.5-3cm，直径1.5-3cm；表面灰棕色或黄棕色；中间有黄白色或淡棕色隔膜分成3室，每室有种子22-90（-110）颗，不易散开。种子叶卵圆状多面体，长3-5mm，直径2.5-3mm，背面稍隆起，较厚一端有圆窝状种脐，合点位于较扁端的中央微凹处，腹面有一纵沟，淡褐色种脊沿着纵沟自种脐直达合点，沿合点再向背面也有一纵沟，沟的末端不达种脐。质硬，断面乳白色。气芳香，味辛、辣。以个大、饱满、质结实、气味浓者为佳。"}]},{"ID":"20240902174723-rsva821","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-rsva821","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"显微鉴别，种子横切面：类梯形或类方形，外周微波状。假种皮细胞多列。种皮表皮细胞1列，多径向延长，排列整齐，外被角质层。下皮细胞2列，不含色素。色素层细胞3-5列，内含红棕色或淡黄色色素。油细胞间断排列于色素层，多径向延长，内含油滴。内种皮厚壁细胞1列，径向延长，圆柱形，长至39μm，直径至29μm，外壁薄，内壁厚，非木化，胸民腔内含硅质块。外胚乳细胞充满由微小淀粉集结成的淀粉团；有的细胞内含细小草酸钙方晶。内胚乳细胞充满糊粉粒。胚细胞含糊粉粒及油滴。"}]},{"ID":"20240902174723-hzvfdkl","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-hzvfdkl","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"粉末特征：灰棕色。①种皮表皮细胞表面长条一菜，末端渐尖，长至400μm，直径9-31μm，非木化。②下皮细胞长角形或类方形，长至150μm，直径14-31μm，1-3列重迭，常与种皮表皮细胞上下层垂直排列，胞腔内不含深色物。③色素层细胞民红棕色，细胞皱缩，含红棕色色素物，易碎成色素块。④油细胞散列于色素层细胞间，内含黄绿色油状物。⑤内种皮厚壁细胞成片，黄棕色或红棕色，表面观多角形，直径14-25μm，壁厚，非木化，胞腔内含硅质块，直径8-15μm；切面观细胞排也栅状，胞腔位于一端，内含硅质块。此外有假种皮细胞、外胚乳细胞、内胚乳细胞及草酸钙方晶、簇晶等。"}]},{"ID":"20240902174723-ibiccmn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ibiccmn","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902174723-8jfwbzp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-8jfwbzp","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"种子含黄酮类化合物：槲皮素(quprcetin)，山柰酚(kaempferol)，鼠李柠檬素(rhamnocitrin)，熊竹素(kumatakenin)，山姜素(alpinetin)，小豆蔻查耳酮(cardamonin)，生松黄烷酮(pinocembrin)；二苯基庚烷类化合物：（5R）-反-1，7-二苯基-5-羟基-Δ6-庚-烯-3-酮[(5R)-trans-1,7-diphenyl-5-hy-droxy-6-hepten-3-one]，（3S，5S）-反-1，7-二苯基-3，5-二羟基-Δ1-庚烯[(3S,5S)-trans-1,7-diphenyl-3,5-dihydroxy-1-heptene]，反-1，7-二苯基-5-羟基-Δ1-庚烯(trans-1,7-diphenyl-5-hydroxy-1-heptene)，反，反-1，7-二苯基-5-羟基-Δ4，6-庚二烯-3-酮(trans,trans-1,7-diphenyl-5-hydroxy-4,6-heptadien-3-one)，(3S,5R)-3,5-二羟基-1，7-二苯基庚烷[(3S,5R)-3，5-dihydroxylheptane]，反，反-1，7-二苯基-Δ4，6-庚二烯-3-酮(trans,trans-1,7-diphenyl-4,6-heptadien-3-one)。肿子的挥发油中含有反-桂皮醛(trans-cinnamaldehyde)，反，反-金合欢醇(trans,trans-farnesol)，桉叶素(1,8-cineole)，α-律草烯(α-humulene)，芳樟醇(linalool)，樟脑(camphor)，4-松油醇(terpineol-4)，莳萝艾菊酮(carvotanacetone)，乙酰龙脑酯(bornylacetate)乙酸牻牛儿酯(geranylacetate)，桂皮酸甲酯(methylcinnamate)，橙花叔醇(netolidol)，樟烯(camphorene)，柠檬烯(limonene)，α-蒎烯(α-pinene),β-蒎烯(β-pinene)，龙脑(borneol)。还含有微量元素(μg/g)：铜(Cu)6.94，铁(Fe)54.7，锰(Mn)144。"}]},{"ID":"20240902174723-4tas4aa","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-4tas4aa","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"根茎中含有二氢-5，6-去氢卡瓦胡椒素(dihydro-5,6-dehydrokawain)和5，6-去氢卡瓦胡椒素(5,6-dehydrokawain)。"}]},{"ID":"20240902174723-1tbedek","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-1tbedek","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902174723-7nueono","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-7nueono","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"1.草豆蔻煎剂对豚鼠离体肠管低浓度兴奋，高于1%浓度及挥发油饱和水溶液则均呈抑制作用。"}]},{"ID":"20240902174723-7q2l4cb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-7q2l4cb","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"2.用巴甫洛夫小胃试验，草豆蔻10%水浸液60-80ml灌入主胃，测小胃分泌情况，结果对胃总酸排出量无影响而显着升高胃蛋白酶的活性。1979年，ItokawaH等报道，草豆蔻种子的乙醇抽提物对小鼠腹水肉瘤180几无拮抗作用。1980年李在琉等报道，通过具有三通巴甫洛夫小胃狗进行慢性药理实验，草豆蔻浸出液对总酸排出量无明显的影响，但使胃蛋白酶活力明显升高。"}]},{"ID":"20240902174723-1zukfzo","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-1zukfzo","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别，取本品粉末1g，加甲醇5ml，置水流水浴中加热振摇5min，滤过，滤液作为供试品溶液。另取山姜素和小豆蔻查耳酮作对照品，加甲醇制成每1ml各含2mg的混合溶液，作为对照品溶液。吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上，以苯-醋酸乙酯-甲醇(15:4:1)为展开剂，取出晾干，在100℃烘约5min，置紫外光灯（365nm）下检视。供试品色谱中在与山姜对照品色谱相应的位置上，显相同的浅蓝色荧光斑点；在与小豆蔻查耳酮对照品色谱相应的位置上，显相同的棕褐色斑点。再喷以5%三氯化铁乙醇溶液，日光下检视。供试品色谱中在与小豆蔻查耳酮对照品色谱相应的位置上，显相同的褐色斑点。"}]},{"ID":"20240902174723-4orcxzh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-4orcxzh","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902174723-dzxzxgm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-dzxzxgm","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"拣净杂质，去壳取仁，用时捣碎。"}]},{"ID":"20240902174723-f1pvfym","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-f1pvfym","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使（草豆蔻），须用蒂，取向里子后取皮，用茱萸同于敖上缓炒，待茱萸微黄黑，即去茱萸，取草豆蔻皮及子，杵用之。"}]},{"ID":"20240902174723-wtc8ugx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wtc8ugx","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"2.《药类法象》：（草豆蔻）面包煨熟，去面用。"}]},{"ID":"20240902174723-h9on9yv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-h9on9yv","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240902174723-uzbi5fg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-uzbi5fg","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃经"}]},{"ID":"20240902174723-fwyzsbk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-fwyzsbk","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中燥湿；行气健脾。主寒湿阴滞脾胃之脘腹冷痛；痞满作胀，呕吐；泄泻；食谷不化；痰馀；脚气；阐疟；口臭"}]},{"ID":"20240902174723-7adonhs","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-7adonhs","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g，宜后下；或入丸、散。"}]},{"ID":"20240902174723-tqygkun","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-tqygkun","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚血少，津液不足者禁服，无寒湿者慎服。"}]},{"ID":"20240902174723-r0yo9ex","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-r0yo9ex","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902174723-q94zdcd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-q94zdcd","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"1.草豆蔻，性温，能散滞气，消膈上痰。若明知身受寒邪，日食寒物，胃脘作疼，方可温散，用之如鼓应桴，或湿痰郁结成病者，亦效。若热郁者不可用，恐积温成热也，必用栀子之剂。"}]},{"ID":"20240902174723-ikc6q67","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-ikc6q67","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：豆蔻治病，取其辛热浮散，能入太阴、阳明，除寒燥湿，开郁化食之力而已。南地卑下，山岚烟瘴，饮啖酸咸，脾胃常多寒湿郁滞之病，故食料必用，与之相宜。然过多亦能助脾热，伤肺损目。"}]},{"ID":"20240902174723-0wczs63","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-0wczs63","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：豆蔻，辛能破滞，香能入脾，温热能祛寒燥湿，故主温中及寒客中焦、心腹痛、中寒呕吐也。脾开窍于口，脾家有积滞，则瘀而为热，故发口臭，醒脾导滞，则口气不臭矣。辛散温行，故下气。寒客中焦，饮食不消，气因闭滞则霍乱。又散一切冷气、消酒毒者，亦燥湿破滞、行气健脾开胃之功也。产闽之建宁者，气芳烈，类白豆蔻，善散冷气，疗胃脘痛，理中焦。产滇、贵、南粤者，气猛而浊，俗呼草果者是也，善破瘴疠，消谷食，及一切宿食停滞作胀闷及痛。"}]},{"ID":"20240902174723-xi8y0go","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-xi8y0go","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：草豆蔻，辛热香散，功与肉蔻相似，但此辛热燥湿除寒，性兼有涩，不似肉蔻涩性居多，能止大肠滑脱不休也。又功与草果相同，但此止逐风寒客在胃口之上，症见当心疼痛，不似草果辛热浮散，专治瘴疠寒疟也。故凡湿郁成病，而见胃脘作疼，服之最为有效。若使郁热内成，及阴虚血燥者，服之为大忌耳。"}]},{"ID":"20240902174723-kyw4a8a","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-kyw4a8a","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"5.《别录》：主温中，心腹痛，呕吐，去口臭气。"}]},{"ID":"20240902174723-wu7hb0y","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wu7hb0y","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"6.《开宝本草》：下气，止霍乱。"}]},{"ID":"20240902174723-5twfqv0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-5twfqv0","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"7.《珍珠囊》：益脾胃、去寒，又治客寒心胃痛。"}]},{"ID":"20240902174723-wxwr05b","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-wxwr05b","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"8.《纲目》：治瘴疠寒疟，伤暑吐下泄痢，噎膈反胃，痞满吐酸，痰饮积聚，妇人恶阻带下，除寒燥湿，开郁破气，杀鱼肉毒。"}]},{"ID":"20240902174723-5l4xekb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-5l4xekb","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"9.《本草原始》：补脾胃，磨积滞，调散冷气甚速，虚弱不能饮食者最宜，兼解酒毒。"}]},{"ID":"20240902174723-j5hy8bc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174723-j5hy8bc","updated":"20240902174731"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902174724-lbje7h7","Type":"NodeThematicBreak","Properties":{"heading-fold":"1","id":"20240902174724-lbje7h7","updated":"20240902174731"}},{"ID":"20240902174744-9e84y8x","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240902174744-9e84y8x","updated":"20240902174950"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白豆蔻"}]},{"ID":"20240902174744-wzencji","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-wzencji","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"白豆蔻《*辞典》"}]},{"ID":"20240902174744-1bhgxh9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1bhgxh9","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【出处】《本草拾遗》"}]},{"ID":"20240902174744-ff251ht","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ff251ht","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiDòuKòu"}]},{"ID":"20240902174744-iiq7w8n","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-iiq7w8n","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【别名】多骨（《本草拾遗》），壳蔻（《本经逢原》），白蔻（《本草经解》）。"}]},{"ID":"20240902174744-ssz7z34","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ssz7z34","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【来源】为姜科植物白豆蔻的果实。10～12月果实呈黄绿色尚未开裂时采收，除去残留的果柄，晒干。"}]},{"ID":"20240902174744-i9ml1ca","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-i9ml1ca","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本。根茎匍匐，粗大有节，近木质。茎直立，圆柱状，高2～3米。叶2列，无叶柄，叶片线状披针形、披针形或倒披针形，长达23厘米，宽7.5厘米，罕达10厘米，先端狭渐尖，基部狭，边缘近波状，两面光滑，叶舌长达7毫米，先端2裂，被长硬毛。穗状花序生于根茎上，花茎连花梗长达8厘米；有卵圆形的鳞片，鳞片先端急尖，基部被短密绢毛；苞片卵圆形，先端急尖，被纤毛，灰色，长达3厘米；小苞片管状，3齿裂，稍被绢毛，长15毫米；花萼管状，3裂，被长柔毛，裂片刷状；花冠透明黄色，管部狭，长2厘米，喉部被小柔毛。裂片钝，长约1厘米，唇瓣倒卵形，长1.6厘米，先端微呈3裂状，中间厚，被微柔毛，黄色或带赤色条纹；侧生退化雄蕊钻状，长3毫米；花丝宽而有沟，长5毫米，花药长3毫米，药隔附属物3裂，3裂片等长，长方形反折；蜜腺2枚，半圆柱状，长2毫米；子房下位，被绢毛，3室，胚珠多数。蒴果扁球形，直径约1.5厘米，灰白色，3爿裂。"}]},{"ID":"20240902174744-a9l8r6o","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-a9l8r6o","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【生境分布】栽培于热带地区。分布泰国、越南、柬埔寨、老挝、斯里兰卡、危地马拉以及南美洲等地。我国广东、广西、云南亦有栽培。"}]},{"ID":"20240902174744-w0ohno8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-w0ohno8","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实，商品即称\"豆蔻\"。略呈圆球形，具不显着的钝三棱，直径约1.2～1.7厘米。外皮黄白色，光滑，具隆起的纵纹25～32条，一端有小突起，一端有果柄痕；两端的棱沟中常有黄色毛茸。果皮轻脆，易纵向裂开，内含种子20～30粒，集结成团，习称\"蔻球\"。蔻球分为3瓣，有白色隔膜，每瓣种子7～10粒，习称\"白蔻仁\"或\"蔻米\"。为不规则的多面体，直径3～4毫米，表面暗棕色或灰棕色，有微细的波纹，一端有圆形小凹点。质坚硬，断面白色，有油性。气芳香，味辛凉。以个人饱满，果皮薄而完整、气味浓厚者为佳。主产越南、泰国等地。"}]},{"ID":"20240902174744-1t6refm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1t6refm","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含挥发油，其中有d-龙脑、d-樟脑、葎草烯及其环氧化物、1，8-桉叶素、α-及δ-拍帕烯、α-及β-蒎烯、石竹烯、月桂烯、桃金娘醛、葛缕酮、松油烯-4-醇、香桧烯等。"}]},{"ID":"20240902174744-2tsmndt","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-2tsmndt","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902174744-86l7k53","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-86l7k53","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"拣净杂质，筛去皮屑，打碎，或剥去果壳，取仁打碎用。"}]},{"ID":"20240902174744-i7to0oq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-i7to0oq","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"白豆蔻入药去皮炒用。\""}]},{"ID":"20240902174744-vuhoyfh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-vuhoyfh","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902174744-50vvnit","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-50vvnit","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902174744-bfz921x","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-bfz921x","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"味辛，大温，无毒。\""}]},{"ID":"20240902174744-7omowt4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-7omowt4","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"气热，味大辛。\""}]},{"ID":"20240902174744-f6hmcex","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-f6hmcex","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902174744-nl1atpx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-nl1atpx","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"入肺、脾经。"}]},{"ID":"20240902174744-8410nuf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-8410nuf","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴经。\""}]},{"ID":"20240902174744-oqzpk1a","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-oqzpk1a","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、脾、胃三经。\""}]},{"ID":"20240902174744-rcrqnd7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-rcrqnd7","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心、肝、脾三经。\""}]},{"ID":"20240902174744-kdy8o6p","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-kdy8o6p","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902174744-pndftgv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-pndftgv","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"行气，暖胃，消食，宽中。治气滞，食滞，胸闷，腹胀，噫气，噎膈，吐逆，反胃，疟疾。"}]},{"ID":"20240902174744-bo029h0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-bo029h0","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"主积冷气，止吐逆，反胃，消谷下气。\""}]},{"ID":"20240902174744-28pa4vz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-28pa4vz","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"主胃冷。\""}]},{"ID":"20240902174744-z1km8p0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-z1km8p0","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"《主治秘要》云，肺金本药，散胸中滞气，感寒腹痛，温暖脾胃，赤眼暴发，白睛红者。\""}]},{"ID":"20240902174744-f7im3lr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-f7im3lr","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"④杨士瀛：\"治脾虚疟疾，呕吐，寒热，能消能磨，流行三焦。\""}]},{"ID":"20240902174744-4tn5rqy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-4tn5rqy","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑤王好古：\"补肺气，益脾胃，理元气，收脱气。\""}]},{"ID":"20240902174744-2opx2yv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-2opx2yv","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治噎膈，除疟疾，寒热，解酒毒。\""}]},{"ID":"20240902174744-063blsx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-063blsx","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑦《本草备要》：\"除寒燥湿，化食宽膨。\""}]},{"ID":"20240902174744-uybwzon","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-uybwzon","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤（不宜久煎），0.5～2钱；或入丸、散。"}]},{"ID":"20240902174744-1aj85vv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1aj85vv","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902174744-0irr4b7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-0irr4b7","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"阴虚血燥而无寒湿者忌服。"}]},{"ID":"20240902174744-6n7kbhf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-6n7kbhf","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"凡火升作呕，因热腹痛，法咸忌之。\""}]},{"ID":"20240902174744-cwkitvb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-cwkitvb","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"凡喘嗽呕吐，不因于寒而因于火者；疟疾不由于瘴邪，而因于阴阳两虚者；目中赤脉白翳，不因于暴病寒风，而因于久眼血虚血热者，皆不可犯。\""}]},{"ID":"20240902174744-xv4lhnw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-xv4lhnw","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"③《本草备要》：\"肺胃火盛及气虚者禁用。\""}]},{"ID":"20240902174744-ax80bsl","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ax80bsl","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"忌见火。\""}]},{"ID":"20240902174744-7n836u7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-7n836u7","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902174744-1v0hpk6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1v0hpk6","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"①治胃口寒作吐及作痛者：白豆蔻仁三钱。为末，酒送下。（《赤水玄珠》白豆蔻散）"}]},{"ID":"20240902174744-c7qg8qb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-c7qg8qb","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"②治胃气冷，吃饭即欲得吐：白豆蔻子三枚，捣，筛，更研细，好酒一盏，微温调之，并饮三、两盏。（《随身备急方》）"}]},{"ID":"20240902174744-5cfih1r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-5cfih1r","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"③治脾胃气不和，止脾泄泻痢：白豆蔻二两（用仁，一半生一半熟），枳壳半斤（去瓤，以浆水煮软，麸炒令香止），肉桂二两（去皮），橘皮二两（去瓤，炒，切细），诃子二两（去核，半生半熟），当归二两（洗）。上六味，杵为末，每服-钱，水一中盏。姜、枣同煎至七分，稍温服。如要丸，用好枣，浆水煮，去皮核，细研，为丸如桐子大。以姜擘破，炒令黑色，入水煎汤，下十五丸。（《博济方》白豆蔻散）"}]},{"ID":"20240902174744-xwpcr94","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-xwpcr94","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"④治气膈脾胃，全不进食：白豆蔻仁、缩砂各二两，陈米一升（淘洗，略燕过，铫内炒），丁香半两（不见火）。上为细末，枣肉为丸，如小赤豆大。每服五、七十丸至百丸，米饮下。（《魏氏家藏方》太仓丸）"}]},{"ID":"20240902174744-txy12g1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-txy12g1","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑤治妊娠呕吐：白豆蔻一钱，竹茹三钱，大枣三枚，鲜姜一钱。将生姜捣碎取汁，前三药煎取一茶杯（约50～60毫升）过滤，冲姜汁服。（《武汉医药卫生》（3）：288，1959）"}]},{"ID":"20240902174744-a41qf6x","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-a41qf6x","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑥治小儿吐乳胃寒者：白豆蔻仁十四个，缩砂仁十四个，生甘草二钱，炙甘草二钱，为末，常掺入儿口中。（《世医得效方》）"}]},{"ID":"20240902174744-9s5onpy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-9s5onpy","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑦治呕吐哕：白蔻、藿香、半夏、陈皮、生姜。水煎服。（《沈氏尊生书》白豆蔻汤）"}]},{"ID":"20240902174744-meecsju","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-meecsju","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"⑧治产后呃逆：白豆蔻、丁香各半两。研细，桃仁汤服一钱，少顷再服。（《乾坤生意》）"}]},{"ID":"20240902174744-u9tnuhy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-u9tnuhy","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【备注】另有一种小豆蔻，系姜科植物小豆蔻的干燥果实，呈长卵形，两端尖，具3钝棱，长1～1.5厘米，径约1厘米，表面乳白色至淡黄棕色。种子团3瓣，每瓣5～9粒，每粒种子长卵形或3～4面形，表面淡橙色至暗红棕色。断面白色。气芳香，味辣、微苦。产越南、斯里兰卡、印度等地。这种豆蔻，市场上亦有作白豆蔻使用者，但品质较差。"}]},{"ID":"20240902174744-sxud3vg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-sxud3vg","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902174744-i3cmx6d","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-i3cmx6d","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"白豆蔻《中华本草》"}]},{"ID":"20240902174744-6t4eaw6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-6t4eaw6","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902174744-rwd3a8k","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-rwd3a8k","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"出自1.《本草拾遗》：白豆蔻，其草形如芭蕉，叶似杜若，长八、九尺而光滑，冬夏不雕；花浅黄色；子作朵如葡萄，初出微青，熟则变白，七月采之。"}]},{"ID":"20240902174744-20197p6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-20197p6","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：白豆蔻，今广州、宜州亦有之。不及番舶者佳。"}]},{"ID":"20240902174744-6a00idn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-6a00idn","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：白豆蔻子圆大如白牵牛子，其壳白厚，其仁如缩砂仁。"}]},{"ID":"20240902174744-8lvvefs","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-8lvvefs","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"4.广西产一种桂白蔻，又称土白蔻，为Alpiniasp.的果实，《证类本草》所图之广州白豆蔻，可能即为此类。桂白蔻形"}]},{"ID":"20240902174744-zvmo90w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-zvmo90w","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiDòuKòu"}]},{"ID":"20240902174744-tycat1y","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-tycat1y","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【英文名】cardamom,cluster,katsumadaiseed，RoundCardamom,FruitJavaAmomum,RoundCardamomFruit,roundcardamonseed,SemenAmomiCardamomi"}]},{"ID":"20240902174744-hjiaxa0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-hjiaxa0","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【别名】多骨、壳蔻、白蔻、圆豆蔻、扣米、豆蔻"}]},{"ID":"20240902174744-gqunpzi","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-gqunpzi","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902174744-48najy5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-48najy5","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"药材基源：为姜科植物白蔻和爪哇白豆蔻的成熟果实。按产地不同分为“原豆蔻”和“印度尼西亚白蔻”。"}]},{"ID":"20240902174744-mlyzfx4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-mlyzfx4","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.AmomunkravanhPierreexGagnep2.AmonumcompactumSoland.exMaton"}]},{"ID":"20240902174744-ehsdv2h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ehsdv2h","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"采收和储藏：当果实成熟时，剪下果穗，晒干或烤干。"}]},{"ID":"20240902174744-338f8gj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-338f8gj","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902174744-ob85bq0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ob85bq0","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"1.白豆蔻，多年生草本，高1.5-3m。根茎粗壮，棕红色。叶近无柄；叶片狭椭圆形或卵状披针形，长约60cm，宽5-12cm，先端尾尖，基部楔形，两面光滑无毛；叶舌圆形，长3-10mm；叶蒜口及叶舌密被长粗毛。穗状花序2-多个，自茎基处抽出，圆柱形或圆锥形，长7-14cm，直径3-5cm，密被枯木逢春瓦关排列的苞片；苞片三角形，长3.5-4cm，麦秆黄色，被柔毛，具明显的方格状网纹；花着生于苞片的腑内；花萼管状，白色微透红，长约1.2cm，先端3齿裂；花冠管与花萼管近等长，裂片3，白色，椭圆形；唇瓣椭圆形，长1.5-2cm，宽约1cm，勺状，白色，中央黄色，基部具瓣柄；雄蕊下弯，长约6mm，花药宽椭圆形，长约3mm，药隔附属体3裂；子房下拉，被柔毛，具二枚棒状附属体。蒴果近球形，白色或淡黄色，略具钝三棱，直径1.5-1.8cm，易开裂。种子团3瓣，每瓣有种子7-10颗。花期2-5月，果期7-8月。"}]},{"ID":"20240902174744-y4yc724","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-y4yc724","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.爪哇白豆蔻，本种与前种的主要区别点为植侏较小，高1-1.5m。叶揉之有松节油气味，叶鞘口无毛，叶舌仅边缘疏被柔毛。苞片小，长2-2.5cm。"}]},{"ID":"20240902174744-5mvt0ah","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-5mvt0ah","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902174744-8xybu2h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-8xybu2h","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于气候温暖、潮湿、富含腐殖质的林下。"}]},{"ID":"20240902174744-zb9mce1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-zb9mce1","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.生于排水及保肥性良好的热带林下。"}]},{"ID":"20240902174744-54hfbxh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-54hfbxh","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"资源分布：1.我国广东、云南有栽培。原产泰国、越南、柬埔寨等国。"}]},{"ID":"20240902174744-dw1ogwp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-dw1ogwp","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.我国海南、云南有栽培。原产印度尼西亚。（爪哇）"}]},{"ID":"20240902174744-wbq5wc4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-wbq5wc4","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902174744-ayhrww8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ayhrww8","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"生物学特征性，喜温暖、凉爽、湿润气候，幼苗遇短时9.5℃低温时，停止生长，叶片干缩，叶尖焦枯。成年植株遇0℃时地上部分死亡。极端高温达41℃，有荫蔽条件下，能正常生长。以选向阳、富含有机质的壤土或砂质壤土栽培，不宜在粘土或砂砾土种植。"}]},{"ID":"20240902174744-d9jf423","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-d9jf423","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子和分株繁殖。种子繁殖：采收成熟果实，剥除果壳．搓洗净果肉，将种子摊于室内阻于，播前在露天湿沙催芽两星期。条播，行距12cm。实生苗长叶2-3片时，间苗移于新的苗畦或营养袋中，畦裁行株距12cm×5cm。经培育1年便可定植于大田。分株繁殖：从大田株丛中，选取茎3-5条相连在一起的壮实幼龄植株，用小刀将与母丛相连的根茎切断后拔出，便可直接定植。种植前先种好荫蔽树。海南省于春季3-4月或秋季8-9月进行；云南省西双版纳地区于5-6月定植，行株距为（2-1.5）m×1m。每1hm2种植4995-6660丛。"}]},{"ID":"20240902174744-q4u8h2q","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-q4u8h2q","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"田间管理定植后新株每年除草4-5次。至开花结果年限，在开花前要清除株丛内的杂草及枯枝落叶，收果后，要剪除枯、病、残株。每年施肥5-6次，以施土杂肥为主。在海南平原地区，因缺少传粉昆虫，必须进行人工辅助授粉，可提高成果率。"}]},{"ID":"20240902174744-6yuqlb3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-6yuqlb3","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有摔倒病、茎枯病、叶枯病，可用多灵菌、托布律或铜氨液喷洒。"}]},{"ID":"20240902174744-qe63m6d","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-qe63m6d","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902174744-e1ryykn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-e1ryykn","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"性状鉴别，（1）白豆蔻，果实类球形，长1.1-1.2cm，直径1.2-1.8cm，具3条钝棱，表面黄白色或淡黄棕色，光滑，有多数纵向脉纹，先端有突起的柱基，基部有凹入的果柄痕，两端均有黄色绒毛；果皮薄，受压易开裂，内表面淡黄色且有光泽，中轴胎座，3室，每室有种子7-10颗，种子集结成团。种子呈不规则多面形，背面略隆起，直径3-4mm，表面暗棕色或灰棕色，有稍规则的颗粒状突起，外被类白色膜状假种皮，较窄端有圆形窝点状种脐，另端有合点，种脊位于腹面，凹陷为一浅纵沟。气味芳香而浓烈，略似樟脑。"}]},{"ID":"20240902174744-txh90gj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-txh90gj","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"（2）爪哇白豆蔻，果实类球形，全3钝棱，直径0.8-1.2cm，果皮无光泽，中轴胎座3室，每室有种子2-4粒。"}]},{"ID":"20240902174744-4ekn930","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-4ekn930","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"均以粒大、果皮薄而色洁白、饱满、气味浓者为佳。"}]},{"ID":"20240902174744-xzhr85w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-xzhr85w","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"显微鉴别，种子横切面：（1）白豆蔻，尖梯形或不规则三角形，外周微波状。假种皮细胞多列，切向延长。种皮表皮细胞径向延长，长圆形或类长方形，长40-90μm，直径10-45μm，外被角质层。下皮细胞1列，切向延长，含红棕色或黄棕色色素。油细胞1列，褐红色或棕红色，径向延长，圆柱形，长至26μm，直径至21μm，胞腔含硅质块，外胚乳细胞含由微小淀粉粒集红成的淀粉团，并有细小草酸钙方晶。骨胚乳细胞含糊粉粒。胚细胞含糊粉粒及油滴。"}]},{"ID":"20240902174744-yeudldn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-yeudldn","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"（2）爪哇白豆蔻种皮表皮细胞较小，长12-40μm，直径8-20μm；油细胞多和径向延长。"}]},{"ID":"20240902174744-td39e0r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-td39e0r","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"粉末特征：白豆蔻淡棕色或红灰色。①种皮表皮细胞表面观长条形，长至662μm，直径18-58μm。②下皮细胞长方形或多角形，长72-146μm，直径16-50μm，常与种皮表皮细胞上下层垂直排列；胞腔内含黄棕色或红棕色色素块。③油细胞切面观类方形。④内种皮厚壁细胞表面观大多呈五角形或六角形，直径7-23μm，壁厚，非木化，胞腔内硅质块，直径5-16μm；切面观细胞排成栅状，外壁较薄，内壁极厚，胞腔位于上端，含硅质块。此外，有假种皮细胞、色素细胞、外胚乳细胞、内胚乳细胞及草酸钙方晶、簇晶等。"}]},{"ID":"20240902174744-iz74mmq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-iz74mmq","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902174744-z6foss5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-z6foss5","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"1.白豆蔻，种子含挥发油，其成分含量遍的为1，8-桉叶素(1,8-cineole)达66.81%，相对较高的有β-蒎烯(β-pinene)10.93%，α-蒎烯(α-pinene)3.71%，丁香烯(caryophellene)3.01%，龙脑乙酸酯(bornylacetate)2.04%，α-松油醇(α-terpineol)2.03%，芳樟醇(linalool)1.39%，此外还含有4-松油烯醇(terpinene-4-ol)，香橙烯(aromadendrene)，γ-广藿香烯(γ-patchoulene)，α-榄香烯(α-elemene)，γ-荜澄茄油烯(γ-cubebene)，水化梨松烯(sabinenehydrate)，橙花步醇(nerolidol)，甜没药烯(bisabolene)，樟烯(camphenen)及葛缕酮(carvone)等。叶含挥发油，其成分含量最高的为1，8-桉叶油素(59.91%)，其次为α-松油醇(10.69%)，此外还有柠檬烯(limonene)，β-蒎烯，樟烯，对-聚伞花素(p-cymene)等。"}]},{"ID":"20240902174744-liuo9da","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-liuo9da","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.爪哇白豆蔻，种子含挥发油，其成分含量最高的为1，8-桉叶油素(68.56%)，相对较高的有葛缕酮(14.67%)，α-蒎烯(1.63%)，芳樟醇(1.41%)，对-聚伞花素(1.11%)，此外还含有香桧烯(sabinene)，月桂烯(myrcene)，月桂烯醇(myrcenol)，1，4-桉叶油素(1,4-cineole)，柠檬烯，3-蒈烯(3-carene)，β-松油醇，樟脑(camphor)，龙脑(borneol)等。叶子所含挥发油，其成分主要为1，8-桉叶油素(80.03%)，另外还有少量的柠檬烯(0.80%)，α-蒎烯(0.56%)，α-松油醇(0.46%)，β-蒎烯(0.33%)，樟烯(0.13%)及对-聚伞花素(\u003c1%)等。"}]},{"ID":"20240902174744-5fx2bvb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-5fx2bvb","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902174744-8407vhi","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-8407vhi","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"1.抑菌作用：本品100%壳煎剂用平板挖沟法，对痢疾杆菌有抑制作用。本品所含的4-松油醇对Bacillcusthuringiensis体外有抑菌作用。"}]},{"ID":"20240902174744-67ysqxl","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-67ysqxl","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.平喘作用：本品所含的α-萜品醇，平喘作用较强，对豚鼠气管平滑肌0.05ml／kg剂量时，作用强于艾叶油。4-松油醇亦有显着的平喘作用。"}]},{"ID":"20240902174744-3gev6ev","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-3gev6ev","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"3.具芳香健胃、驱风作用，豆蔻油很不稳定，即使储藏很好，也常易丧失其特有之香味，一般可作成芳香酊或醑剂。种子应在临用前方可磨碎，有良好的芳香健胃作用，能促进胃液分泌，兴奋肠管蠕动，驱除肠内积气，并抑制肠内异常发酵。"}]},{"ID":"20240902174744-efs2a2r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-efs2a2r","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"4.白豆蔻煎剂对豚鼠离体肠管低浓度兴奋；高于1%及挥发油饱和水溶液均呈抑制作用。"}]},{"ID":"20240902174744-zska9xs","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-zska9xs","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"5.其他作用：其挥发油对豚鼠实验性结核，能增强小剂量链霉素的作用。"}]},{"ID":"20240902174744-yd4n0o4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-yd4n0o4","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【毒性】本品挥发油中所含的α-萜品醇，小鼠口服的LD50为12.08ml/kg。"}]},{"ID":"20240902174744-woqad1n","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-woqad1n","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902174744-lcneugr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-lcneugr","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"理化鉴别，薄层角谱：取白豆蔻或爪哇白豆蔻挥发油作供试品溶液，另取桉油作对照品溶液（必要时可分别加乙醇适量稀释），吸取上述两种溶液各10μl，分别点于同一硅胶G薄层板上，以苯-醋酸乙酯（9：5：0：5）为展开剂，展开，取出，晾干，喷以5%香草醛硫酸溶液，在105℃烘5-10min，立即检视。供试品色谱中在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902174744-btklo3m","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-btklo3m","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"品质标志《中华人民共和国药典》1995年版规定，原豆蔻仁含挥发油不得少于5.0%（ml/g）；印度尼西亚白蔻仁不得少于4.0%（ml/g）。"}]},{"ID":"20240902174744-7665rtx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-7665rtx","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，筛去皮屑，打碎，或剥去果壳，取仁打碎用。"}]},{"ID":"20240902174744-t12w920","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-t12w920","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240902174744-f2n6pdf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-f2n6pdf","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【归经】肺；脾；胃经"}]},{"ID":"20240902174744-g5x6dm2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-g5x6dm2","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【功能主治】化湿行气；温中止呕；开胃消食。主湿阻气滞；脾胃不和；脘腹胀满；不思饮食；湿温初起；胸闷不饥；胃寒呕吐；食积不消"}]},{"ID":"20240902174744-5zptbyo","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-5zptbyo","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6，后下；或入丸、散。"}]},{"ID":"20240902174744-1vhyjen","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1vhyjen","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚血燥者禁服。"}]},{"ID":"20240902174744-o4147ip","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-o4147ip","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【附方】三仁汤《温病条辨》；黄芩滑石汤《温病条辨》；白豆蔻汤《圣济总录》；沉香汤《圣济总录》；补和汤《圣济总录》"}]},{"ID":"20240902174744-uqgcfnf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-uqgcfnf","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902174744-ri0ci71","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-ri0ci71","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：白豆蔻，主积冷气及伤冷吐逆，因寒反胃。暖能消物，故又主消谷；温能通行，故主下气。东垣用以散肺中滞气，宽膈进食，去白睛翳膜，散滞之功也。"}]},{"ID":"20240902174744-tzed3ns","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-tzed3ns","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"2.《本草通玄》：白豆蔻，其功全在芳香之气，一经火炒，便减功力；即入汤液，但当研细，待诸药煎好，乘沸点服尤妙。"}]},{"ID":"20240902174744-fdxri1r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-fdxri1r","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"3.《玉楸药解》：白豆蔻，清降肺胃，最驱膈上郁浊，极疗恶心呕哕.嚼之辛凉，清肃肺腑，郁烦应时开爽。古方谓其大热，甚不然也。"}]},{"ID":"20240902174744-qi3misy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-qi3misy","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"4.《医林纂要》：白豆蔻，辛热，温养命火，达中州而上浮膻中，泻肺散寒润澡。燥，清冷也。……辛润能泻清燥之邪，故主治寒疟，破滞解酒，止吐逆，和膻中，兼能温脾胃，化食，去冷积。"}]},{"ID":"20240902174744-bj8nrek","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-bj8nrek","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：白豆蔻，本与缩砂密一类，气味既同，功亦莫别，然此另有一种清爽妙气，上入肺经气分，而为肺家散气要药；其辛温香窜，流行三焦，温暖脾胃，而使寒湿膨胀、虚疟、吐逆、反胃、腹痛、并翳膜、目眦红筋等症悉除，不似缩砂密辛温香窜兼苦，功专和胃、醒脾、调中，而于肺、肾他部则止兼而及之也。"}]},{"ID":"20240902174744-vtv7un8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-vtv7un8","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"6.《本草求原》：按白豆蔻能和寒热之气，故升阳剂中，降收剂中，与寒热互用之剂，皆可用之。佐入血药又能通润二肠，使气行血自润，不论血寒血热，俱可于寒热方中少佐之，以行其升降。故海藏谓其理脾胃元气，补肺气，收脱气。"}]},{"ID":"20240902174744-1qk1s7i","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174744-1qk1s7i","updated":"20240902174752"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902174745-y9jrte4","Type":"NodeThematicBreak","Properties":{"heading-fold":"1","id":"20240902174745-y9jrte4","updated":"20240902174752"}},{"ID":"20240902174817-emkuiyo","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240902174817-emkuiyo","updated":"20240902174950"},"Children":[{"Type":"NodeText","Data":"中草药：红豆蔻"}]},{"ID":"20240902174817-1vj9wr5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-1vj9wr5","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"红豆蔻《中国药典》"}]},{"ID":"20240902174817-ny7avyi","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ny7avyi","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HónɡDòuKòu"}]},{"ID":"20240902174817-daznglj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-daznglj","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSGALANGAE"}]},{"ID":"20240902174817-cv39t25","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-cv39t25","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【别名】大良姜、山姜"}]},{"ID":"20240902174817-xl6107e","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-xl6107e","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【来源】本品为姜科植物大高良姜AlpiniagalangaWilld.的干燥成熟果实。秋季果实变红时采收，除去杂质，阴干。"}]},{"ID":"20240902174817-f15ahn9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-f15ahn9","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902174817-mc0t3d2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-mc0t3d2","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"本品呈长球形，中部略细，长0.7～1.2cm，直径0.5～0.7cm。表面红棕色或暗红色，略皱缩，顶端有黄白色管状宿萼，基部有果梗痕。果皮薄，易破碎。种子6，扁圆形或三角状多面形，黑棕色或红棕色，外被黄白色膜质假种皮，胚乳灰白"}]},{"ID":"20240902174817-rdh4n92","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-rdh4n92","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"色。气香，味辛辣。"}]},{"ID":"20240902174817-eclq87e","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-eclq87e","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902174817-621h7d7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-621h7d7","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"（1）种子横切面：假种皮细胞4～7列，圆形或切向延长，壁稍厚。种皮的外层为1～5列非木化厚壁纤维，呈圆形或多角形，直径13～45μm，其下为1列扁平的黄棕色或深棕色色素细胞；油细胞1列，方形或长方形，直径16～54μm；色素层细胞3～5列，含红棕色物；内种皮为1列栅状厚壁细胞，长约65μm，宽约30μm，黄棕色或红棕色，内壁及靠内方的侧壁极厚，胞腔偏外侧，内含硅质块。外胚乳细胞充满淀粉粒团，偶见草酸钙小方晶。内胚乳细胞含糊粉粒及脂肪油滴。"}]},{"ID":"20240902174817-kc5uzjh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-kc5uzjh","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"（2）取本品种子粉末1g，加乙醚20ml，超声处理10分钟，滤过，残渣再加乙醚10ml洗涤一次，滤过，合并乙醚液，蒸干，残渣加醋酸乙酯1ml使溶解，作为供试品溶液。另取红豆寇种子对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5～10μl，分别点于同一硅胶ＧＦ254薄层板上，以环己烷－醋酸乙酯（17:3）为展开剂，展开，取出，晾干，置紫外光灯（254nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显三个相同颜色的荧光斑点。喷以5％香草醛硫酸溶液，于105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显三个相同颜色的斑点。"}]},{"ID":"20240902174817-hf0k6zu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-hf0k6zu","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质。用时捣碎。"}]},{"ID":"20240902174817-3h3qgph","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-3h3qgph","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902174817-sxz6zos","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-sxz6zos","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、肺经。"}]},{"ID":"20240902174817-ji20gyk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ji20gyk","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【功能主治】燥湿散寒、醒脾消食。用于脘腹冷痛，食积胀满，呕吐泄泻，饮酒过多。"}]},{"ID":"20240902174817-edm79ae","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-edm79ae","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～6g。"}]},{"ID":"20240902174817-n0t5ko2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-n0t5ko2","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902174817-fydpz9l","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-fydpz9l","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【备注】（1）本品之根状茎称“大良姜”，功能主治近“高良姜”。"}]},{"ID":"20240902174817-lsogoqv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-lsogoqv","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902174817-mgxw1uq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-mgxw1uq","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"红豆蔻《*辞典》"}]},{"ID":"20240902174817-pb7vt3x","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-pb7vt3x","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【出处】《药性论》"}]},{"ID":"20240902174817-hcibr1i","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-hcibr1i","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HónɡDòuKòu"}]},{"ID":"20240902174817-pprv8z8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-pprv8z8","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【别名】红豆（王好古），红蔻（《本草述钩元》），良姜子（《广西中药志》）。"}]},{"ID":"20240902174817-6ip927w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-6ip927w","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【来源】为姜种植物大高良姜的果实。秋季果实变红时采摘，晒干或阴干。"}]},{"ID":"20240902174817-ousz5y2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ousz5y2","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【原形态】干燥果实椭圆球形，长0.8～1.5厘米，直径0.7～1厘米。一端有一小凹点（果柄痕），另一端冠以残留的淡黄色花被，长可达5毫米。外皮红棕色或枣红色，略皱缩，质薄，手捻之即碎。内含6粒种子，呈扁圆四面形或三角状多面形，黑棕色或红棕色，微有光泽，外附一层白色薄膜，破开内为灰白色。有香气，味辛辣。以颗粒饱满、气味辛辣者为佳。"}]},{"ID":"20240902174817-tpu6ayz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-tpu6ayz","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产广东、广西、云南等地。"}]},{"ID":"20240902174817-zqprbd6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-zqprbd6","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，筛去灰屑，用时捣碎。"}]},{"ID":"20240902174817-j2oklok","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-j2oklok","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902174817-b6zywz6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-b6zywz6","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902174817-1iqmikb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-1iqmikb","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味苦辛。\""}]},{"ID":"20240902174817-s8n2dft","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-s8n2dft","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"味辛，温，无毒。\""}]},{"ID":"20240902174817-429no1q","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-429no1q","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"辛，热。\""}]},{"ID":"20240902174817-ihf9ivn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ihf9ivn","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【归经】《纲目》：\"入手、足太阴经。\""}]},{"ID":"20240902174817-xgrvk23","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-xgrvk23","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902174817-5kam6sj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-5kam6sj","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"散寒，燥湿，消食。治脘腹冷痛，呕吐泄泻，噎膈反胃，疟疾，痢疾。"}]},{"ID":"20240902174817-hcbpzpm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-hcbpzpm","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"治冷气腹痛，消瘴雾气毒，去宿食，温腹肠，吐泻，痢疾。\""}]},{"ID":"20240902174817-u5ioxgm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-u5ioxgm","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"治肠虚水泻，心腹绞痛，霍乱，呕吐酸水，解酒毒。\""}]},{"ID":"20240902174817-m2o0gmc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-m2o0gmc","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"治噎膈反胃，虚疟寒胀，燥湿散寒。\""}]},{"ID":"20240902174817-mog9n4e","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-mog9n4e","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"止呕进食，大补命门相火。\""}]},{"ID":"20240902174817-n96kaz5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-n96kaz5","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"温中散寒，醒脾燥湿。\""}]},{"ID":"20240902174817-687vr63","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-687vr63","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"⑥《南宁市药物志》：\"外用治汗斑。\""}]},{"ID":"20240902174817-yf9gt05","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-yf9gt05","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.8～1.5钱。外用：研末搐鼻或调搽。"}]},{"ID":"20240902174817-bbqf34v","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-bbqf34v","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902174817-a6hpq3u","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-a6hpq3u","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"阴虚有热者忌服。"}]},{"ID":"20240902174817-fwdt069","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-fwdt069","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"多食令人舌粗，不思饮食。\""}]},{"ID":"20240902174817-0d4rrfu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-0d4rrfu","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"②《生生编》：\"最能动火伤目，致衄，食料不宜用之。\""}]},{"ID":"20240902174817-wzfnh9b","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-wzfnh9b","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"脾肺素有伏火者禁用。\""}]},{"ID":"20240902174817-6rqr8kx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-6rqr8kx","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902174817-vs8p0tq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-vs8p0tq","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"①治腹痛体冷，呕沫，不欲食：红豆蔻（去皮），荜茇、桂心、白术、当归（研，微炒）、人参（去芦头）各半两，附子一两（炮裂，去皮、脐），白豆蔻三分（去皮），干姜半两（炮裂，锉），陈橘皮三分（汤浸，去白瓤，焙），川椒（去目及闭口者，微炒去汗）三分。上药捣罗为末，炼蜜和捣三、二百杵，丸如梧桐子大。不计时候，以生姜汤下三十丸。（《圣惠方》红豆蔻丸）"}]},{"ID":"20240902174817-k35d6zl","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-k35d6zl","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"②治风寒牙痛：红豆蔻为末，随左右以少许搐鼻中，并掺牙取涎，或加麝香。（《卫生家宝方》）"}]},{"ID":"20240902174817-fepq8qi","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-fepq8qi","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902174817-e3ln8w9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-e3ln8w9","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"红豆蔻《中华本草》"}]},{"ID":"20240902174817-4rr4s7t","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-4rr4s7t","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902174817-7iqie72","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-7iqie72","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"出自《药性论》。"}]},{"ID":"20240902174817-zon1g66","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-zon1g66","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"1.《海药本草》：红豆蔻，择嫩者加入盐，櫐櫐作朵不散落，须以朱槿染令色深。善醒于醉，解酒毒，此外无诸要使也。"}]},{"ID":"20240902174817-ojdyj4l","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ojdyj4l","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"2.《开宝本草》：红豆蔻，云是高良姜子，其苗如芦，叶似姜，花作穗，嫩叶卷而生，微带红色，生南海诸谷。"}]},{"ID":"20240902174817-pho8dnb","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-pho8dnb","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HónɡDòuKòu"}]},{"ID":"20240902174817-euqju16","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-euqju16","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【英文名】GalangaGalangalSeed,GalangaGalangal"}]},{"ID":"20240902174817-dhhwin6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-dhhwin6","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【别名】红豆、良姜子、红扣、"}]},{"ID":"20240902174817-7mged9c","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-7mged9c","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902174817-wsamnpe","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-wsamnpe","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"药材基源：为姜科植物大高良姜的果实。"}]},{"ID":"20240902174817-y4qie3p","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-y4qie3p","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Alpiniagalanga(L.)Willd.[MarantagalangaL.]"}]},{"ID":"20240902174817-gxqkkjv","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-gxqkkjv","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培第3年开花结果，于11-12月果实刚呈红色时采收，将果穗割回，摊放阴凉通风处4-7天，等果实皮变成深红色时脱粒，去掉枝村，扬净，晒干。"}]},{"ID":"20240902174817-2eihziw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-2eihziw","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【原形态】大高良姜，多年生丛生草本，高1.5-2.5m。根茎粗壮，圆形，有节，棕红色并略有辛辣味。叶2列，无叶柄或极短；叶片长圆形或宽披针形，长30-50cm，宽6-140cm，先端急尖，基部楔形，；边缘钝，常棕白色，两面无毛或背面有长柔毛；叶舌长5-10mm，先端钝。圆锥花序顶生，直立，鑫花，长14-32cm，径4-8cm，花序轴上密生柔毛，多分枝；总苞片线形，长约20cm；小苞片披针形或狭长圆形，长1-2cm；花绿白色，清香；花萼管状，顶端不等的3浅裂，有缘毛；花冠管与萼管略等长，裂片3，长圆形，唇瓣倒卵形至长圆形，长2.5-3cm，宽8-12mm，基部成爪状，有红色条纹；雄蕊1，与唇瓣基部；子房下位，无毛，花柱细长，柱头略膨大。，蒴果长圆形，不开裂，长1-1.5cm，宽约7mm，中部稍收缩，熟时橙红色。种子多角形，棕黑色。花期6-7月，果期7-10月。"}]},{"ID":"20240902174817-u4g1rzq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-u4g1rzq","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902174817-oi9yxgq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-oi9yxgq","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡、旷野的草地或灌丛中。"}]},{"ID":"20240902174817-ureinjf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ureinjf","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于广东、海南、广西、云南。"}]},{"ID":"20240902174817-odg6gl9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-odg6gl9","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902174817-ps93hwr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ps93hwr","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"丛生物学特性，喜温暖湿润气候和向阳环境。稍耐旱，怕水渍，能耐短暂0℃低温，在-5℃时全株死亡。以圭层深厚、疏松、肥沃、排水良好的壤土或粘无病呻吟土栽培为宜。"}]},{"ID":"20240902174817-i2w9pho","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-i2w9pho","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"栽培技术，用种子和分株繁殖。种子繁殖：采用育苗移栽法，11-12月采果实脱粒沙藏。第2年4-5月播种，开1.3m宽的高畦。条播，按行距33cm在畦上开横沟，播幅10cm。苗期`经常除草松土，追肥3-4次。第2年晚霜过后，苗高33cm，雨委就可移地栽。分株繁殖：可于每年夏天雨季进行，挖取部分带一段根茎的植株，地上茎可于离地约33cm处剪去以便栽种。移栽可在6月雨季进行，按行距1.3m，株距1m挖穴，每穴栽苗2-3株，每1hm2栽苗6750-7200穴。"}]},{"ID":"20240902174817-p3s7m7f","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-p3s7m7f","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"田间管理，栽种后1-2年要加强管理，每年中耕除草、追肥3次，在6、8、12月进行。中耕后施磷肥、人畜粪水1次，一般到第3年植株封行后，只须每年2-3月剪除枯残茎叶。12月采收后再中耕，并施堆肥和过磷酸钙1次。栽种后1-2年可间种豆科矮杆作物或蔬菜。"}]},{"ID":"20240902174817-h380pft","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-h380pft","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902174817-qlykv9x","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-qlykv9x","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"性状鉴别，果实长圆形，中部稍收缩，长0.7-1.5cm，直径0.4-1cm，表面红棕色或淡红棕色，光滑或皱缩，先端有突出的花被残基，基部有果柄痕；果皮薄；易碎。种子团长圆形或哑铃形，每室有种子2粒；种子呈不规则状四面体，长4-6mm，直径3-6mm，表面暗棕色或褐棕色，微有光泽，具不规则皱纹，外被淡黄色或灰黄色假种皮，背面有凹陷种脐，合点位于腹面，种脊成一浅纵沟。气芳香而浓，味辛、辣。以粒大、饱满、气味浓者为佳。显微鉴别，种子横切面：类圆形或类肾形，外周微波状。假种皮细胞多列，壁稍皱缩弯曲。种皮表皮细胞1列，径向延长，卵圆形或长圆形，排列整齐，外被角质层。下皮细胞1列，内含红棕色色素。油细胞1列，切向延长内含油滴。色素层细胞4-5列，切向延长，内含棕色或棕黄色色素。内种皮厚壁细胞1列，棕色或棕黄色，径向延长，圆柱形，长至74μm，直径34μm，外壁薄，非木化，胞腔内含硅质块。外胚乳细胞内弃满由微小淀粉粒集结成的淀粉团，有的细胞内含细小草酸钙方晶。内胚乳细胞含糊粉粒。胚细胞含糊粉粒及油滴。"}]},{"ID":"20240902174817-40s2h2a","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-40s2h2a","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡红棕色。①种皮表皮细胞表面观长条形，末端锐尖或稍钝圆，长至730μm，直径14-32μm，外具角质层。②下皮细胞长圆形或长方形，长63-108μm，直径27-70μm，常与种皮表皮细胞上下层垂直排列，内含红棕色或黄棕色色素。③油细胞位于下皮与色素层之间，切面观细胞1列，长方形或方形，内含油滴。④内种皮厚壁细胞成片，红棕色或黄棕色，表面观多角形或类方形，大小（10-35）×（14-44）μm，壁厚约2.5μm，非木化，胞腔内含硅质块，大小（6-30）×（11-40）μm；断面观细胞排成栅状，胞腔位于一端，内含硅质块。此外有假种皮细胞，色素细胞、外胚乳细胞、内胚乳细胞及色素块、草酸钙方晶、簇晶等。"}]},{"ID":"20240902174817-sxfg9g5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-sxfg9g5","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902174817-95hedah","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-95hedah","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"红豆蔻果实中含消旋1-乙酰氧基胡椒酚乙酸酯(DL-1-acetoxychavicolacetate)，反式3，4-二甲氧基桂皮醇(trans-3,4-dimethoxycinnamylalcohol)，反式-4-甲氧基桂皮醇(trans-4-methoxycinnamylalcohol)，对-羟基桂皮醇（p-hydroxycinnamaldehyde），1-乙酰氧基丁香油酚乙酸酯(1-acetoxyeugenolacetate)和挥发油，挥发油的主要成分有：Δ3-蒈烯(Δ3-carene)，6-甲基-5-庚烯-2-酮[(E)-6-methylhepta-5-en-2-one]，1，8-桉叶素(1,8-cineole)，芳樟醇氧化物(linalooloxixde)，芳樟醇(linalool)，壬醛(n-nonanal)，正丁酸反式-2-已烯酯(trans-2-hexenyl-n-butyrate)，(E)-6-甲基-3，5-庚二烯-2-酮[(E)-6-methyl-3,5-heptadien-2-one]，辛酸(octanoicacid)，乙酸正辛酯(noctylacetate)，4-松油烯醇(terpinen-4-ol)，α-松油醇(α-terpineol)，2-(2-丙烯基)苯酚[2-(2-propenyl)phenol]，玷(王巴)烯(copaene)，荜澄茄烯(cadinene)，β-榄香烯(β-elemene)，乙酸正癸酯(n-decylacetate)，正十五烷(n-pentadecane)，α-香柑油烯(α-bergamotene)，丁香油酚(eugenol)，α-律草烯(α-humulene)，别香橙烯(aloaromaden-dene)，顺式-丁香烯(cis-caryophyllene)，ν-依兰油烯(ν-muurolene)，β-甜没药烯(β-bisabolene)，乙酸桂皮酯(cinnamylacetate)，菖蒲烯(calamenene)，丁香烯醇(I或II)(caryophyllenolIorII)，橙花叔醇(nerolidol)，荜澄茄烯醇(cadinenol)。"}]},{"ID":"20240902174817-p5nko8r","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-p5nko8r","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"红豆蔻种子含1-乙酰氧基胡椒酚乙酸酯，1-乙酰氧基丁香油酚乙酸酯，丁香烯氧化物(caryophylleneoxide)，丁香烯醇I及II，高良姜萜醛(galanal)A和B，高良姜萜内酯(galanolactone)，8(17)，12-半日花二烯-15，16-二醛[E-8(17),12-albdiene-15,16-dial]和E-8(17)-环氧-12-半日花二烯-15，16-二醛[E-8β(17)-epoxylabd-12-ene-15,16-dial].。"}]},{"ID":"20240902174817-blefjrs","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-blefjrs","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902174817-u9u5eai","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-u9u5eai","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"1.种子煎剂对豚鼠离体肠管有兴奋作用。1-乙酰氧基胡椒酚乙酸酯5、10g/kg腹腔注射，对大鼠结扎幽门引起的胃溃疡有抑制作用。1-乙酰氧基胡椒酚乙酸酯和1-乙酰氧丁香酚乙酸酯有明显的抗Shay氏大鼠胃溃疡作用，分别腹腔注射2-5mg／kg和5-10mg／kg时，抑制率为20-77%和36-100%。"}]},{"ID":"20240902174817-mpgpsv8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-mpgpsv8","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"2.抗真菌和细胞毒性作用：本品含的GalanalA（1）、GalanalB（2）、Galanolactone（3）、（E）-8（17），12-Labddiene-15，16-dial（4）和（E）-8B（17）-Epoxylabd-12-ene-15，16-dial（5）具有抗真菌和细胞毒性作用。"}]},{"ID":"20240902174817-jk5d58h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-jk5d58h","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"2.3抗癌活性：从果实的甲醇提取物中分得多种化合物，又将其中1-乙酰氧基胡椒酚乙酯和1-乙酰氧基丁香酚乙酸酯，给小白鼠腹腔注射l0mg／kg的剂量，连续5天，发现有很强的抗癌活性。后者的毒性比前者低。与其它合成成分比较，1-乙酰氧基对抗癌活性很重要，估计其作用机制与亲核攻击有关。"}]},{"ID":"20240902174817-7ca53ex","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-7ca53ex","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别，薄层色谱：取本品适量粉碎，加水蒸馏，提取的挥发油用无水硫酸钠脱水后点样于硅胶G薄层板上，以樟脑、18-桉油精为对照品，用已烷-乙酸乙酯（85：15）展开，以10%磷钼酸乙醇液显色，样品液色谱在与对照品色谱的相应位置上有相同的斑点。"}]},{"ID":"20240902174817-c6ol507","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-c6ol507","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，筛去灰屑，用时捣碎。"}]},{"ID":"20240902174817-ua6jll0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-ua6jll0","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240902174817-1xok5zt","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-1xok5zt","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肺经"}]},{"ID":"20240902174817-hfitbto","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-hfitbto","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中燥湿；醒脾消食。主脘腹冷痛；食积腹胀，呕吐泄泻；噎膈反胃"}]},{"ID":"20240902174817-xrzg3cj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-xrzg3cj","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g；或研末。外用：知量，研末搐鼻或调搽。"}]},{"ID":"20240902174817-4rbnvmf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-4rbnvmf","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚有热者禁服。"}]},{"ID":"20240902174817-yk7hvil","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-yk7hvil","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902174817-58bhi9k","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-58bhi9k","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"1.《药性论》：治冷气腹痛，消瘴雾气毒，去宿食，温腹肠，吐泻，痢疾。"}]},{"ID":"20240902174817-oj5vjjk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-oj5vjjk","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：治肠虚水泻，心腹绞痛，霍乱，呕吐酸水，解酒毒。"}]},{"ID":"20240902174817-0jyhxsk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-0jyhxsk","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：治噎膈反胃，虚疟寒胀，燥湿散寒。红豆蔻，李东垣脾胃药中常用之，亦取其辛热芳香，能醒脾温肺，散寒燥湿消食之功尔。"}]},{"ID":"20240902174817-iidvukk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-iidvukk","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：止呕进食，大补命门相火。"}]},{"ID":"20240902174817-67hk93q","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-67hk93q","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"5.《医林纂要》：温中散寒，醒脾燥湿。"}]},{"ID":"20240902174817-vd7dsp3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-vd7dsp3","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"6.《南宁市药物志》：外用治汗斑。"}]},{"ID":"20240902174817-1e35xj4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-1e35xj4","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"7.《玉楸药解》：红豆蔻，调理脾胃，温燥湿寒，开通瘀塞，宣导瘀浊，亦与草豆蔻无异，而力量稍健，内瘀极重者宜之。上热易为鼻衄、牙疼之家，尽属中下湿寒，胆火不降，当温燥中下，候上热不作而用之。去壳研用。"}]},{"ID":"20240902174817-5i3n8co","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174817-5i3n8co","updated":"20240902174817"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902174819-xgtbeza","Type":"NodeThematicBreak","Properties":{"heading-fold":"1","id":"20240902174819-xgtbeza","updated":"20240902174817"}},{"ID":"20240902174848-ex1zwwb","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240902174848-ex1zwwb","updated":"20240902174950"},"Children":[{"Type":"NodeText","Data":"中草药：肉豆蔻"}]},{"ID":"20240902174848-eqhapmx","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-eqhapmx","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻《中国药典》"}]},{"ID":"20240902174848-58lmsde","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-58lmsde","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【拼音名】RòuDòuKòu"}]},{"ID":"20240902174848-largtss","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-largtss","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENMYRISTICAE"}]},{"ID":"20240902174848-zre8032","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-zre8032","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【别名】肉果、玉果、顶头肉"}]},{"ID":"20240902174848-kdvb9sp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kdvb9sp","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【来源】本品为肉豆蔻科肉豆蔻属植物肉豆蔻MyristicafragransHoutt.的干燥种仁。"}]},{"ID":"20240902174848-hw9erbt","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hw9erbt","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈卵圆形或椭圆形，长2～3cm，直径1.5～2.5cm。表面灰棕色或灰黄色，有时外被白粉（石灰粉末）。全体有浅色纵行沟纹及不规则网状沟纹。种脐位于宽端，呈浅色圆形突起，合点呈暗凹陷。种脊呈纵沟状，连接两端。质坚，断面显棕黄色相杂的大理石花纹，宽端可见干燥皱缩的胚，富油性。气香浓烈，味辛。"}]},{"ID":"20240902174848-jzdft32","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-jzdft32","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902174848-7fhx8px","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-7fhx8px","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：可见外层外胚乳组织，由10余列扁平皱缩细胞组成，内含棕色物，偶见小方晶，错入组织有小维管束，暗棕色的外胚乳深入于浅黄色的内胚乳中，形成大理石花纹，内含多数油细胞。内胚乳细胞壁薄，类圆形，充满淀粉粒、脂肪油及糊粉粒，内有疏散的浅黄色细胞。淀粉多为单粒，直径10～20μm,少数为2～6分粒组成的复粒，直径25～30μm,脐点明显。以碘液染色，甘油装置立即观察，可见在众多蓝黑色淀粉粒中杂有较大的糊粉粒。以水合氯醛装置观察，可见脂肪油常呈块片状、鳞片状，加热即成油滴状。"}]},{"ID":"20240902174848-wr3mora","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-wr3mora","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"（2）取本品[含量测定]项下的挥发油，加氯仿制成每1ml含0.2ml的溶液，作为供试品溶液。另取肉豆蔻对照药材20g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl,分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）－苯（1:1）为展开剂，展开，取出，晾干，喷以茴香醛试液，105℃加热至斑点显色清晰。"}]},{"ID":"20240902174848-zc3p4og","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-zc3p4og","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902174848-nv9z6pf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-nv9z6pf","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【含量测定】"}]},{"ID":"20240902174848-w0flji5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-w0flji5","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"取本品粗粉约20g,精密称定，照挥发油测定法（附录ⅩD）测定。"}]},{"ID":"20240902174848-yopzz2w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-yopzz2w","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"本品含挥发油不得少于6.0％（ml/g）。"}]},{"ID":"20240902174848-bvdw6pa","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-bvdw6pa","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902174848-v9ro16f","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-v9ro16f","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻：除去杂质，洗净，干燥。"}]},{"ID":"20240902174848-qji1sas","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-qji1sas","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"煨肉豆蔻：取净肉豆蔻用面粉加适量水拌匀，逐个包裹或用清水将肉豆蔻表面湿润后，如水泛丸法裹面粉3～4层，倒入己炒热的滑石粉或沙中，拌炒至面皮呈焦黄色时，取出，过筛，剥去面皮，放凉。每100kg肉豆蔻,用滑石粉50kg。"}]},{"ID":"20240902174848-hczp5vg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hczp5vg","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902174848-kccmk3d","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kccmk3d","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、大肠经。"}]},{"ID":"20240902174848-497528c","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-497528c","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中行气，涩肠止泻。用于脾胃虚寒，久泻不止，脘腹胀痛，食少呕吐。"}]},{"ID":"20240902174848-jkzh5jn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-jkzh5jn","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240902174848-k0jym5u","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-k0jym5u","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防蛀。"}]},{"ID":"20240902174848-laldi4p","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-laldi4p","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【备注】（1）《全国中草药汇编》－－－肉豆蔻花（玉果花）系取自肉豆蔻种子的假种皮干燥而得，功效与肉豆蔻类同。"}]},{"ID":"20240902174848-j8n7f0i","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-j8n7f0i","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902174848-u5vw1y0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-u5vw1y0","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻《*辞典》"}]},{"ID":"20240902174848-we4t92s","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-we4t92s","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【出处】《药性论》"}]},{"ID":"20240902174848-53vnm8t","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-53vnm8t","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【拼音名】RòuDòuKòu"}]},{"ID":"20240902174848-1l4mld8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-1l4mld8","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【别名】迦拘勒（《本草拾遗》），豆蔻（《续传信方》），肉果（《纲目》）。"}]},{"ID":"20240902174848-w5jo0z9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-w5jo0z9","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【来源】为肉豆蔻科植物肉豆蔻的种子。4～6月及11～12月各采一次。早晨摘取成熟果实，剖开果皮，剥去假种皮，再敲脱壳状的种皮，取出种仁用石灰乳浸一天后，缓火焙干。"}]},{"ID":"20240902174848-34odq9h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-34odq9h","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902174848-ryild1g","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ryild1g","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高可达20米。叶互生；椭圆状披针形或长圆状披针形，长5～15厘米，革质，先端尾状，基部急尖，全缘，上面淡黄棕色，下面色较深，并有红棕色的叶脉；叶柄长6～12毫米。花雌雄异株；雄花的总状花序长2.5～5厘米；小苞片鳞片状；花疏生，黄白色，椭圆形或壶形，长6毫米，下垂；花药9～12个，连合成圆柱状有柄的柱。果实梨形或近于圆球形，下垂，长3.5～6厘米，淡红色或黄色，成熟后纵裂成2瓣，显出绯红色假种皮，种子长球形，种皮红褐色，木质。"}]},{"ID":"20240902174848-w7h1mdc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-w7h1mdc","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"本植物的假种皮（肉豆蔻衣）亦供药用，另详专条。"}]},{"ID":"20240902174848-4x0sq8w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-4x0sq8w","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【生境分布】热带地区广为栽培。分布马来西亚、印度尼西亚、巴西等地。主产马来西亚及印度尼西亚。"}]},{"ID":"20240902174848-2kfbdwk","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-2kfbdwk","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性状】干燥种仁卵圆形或椭圆形，长2～3.5厘米，宽1.5～2.5厘米。外表灰棕色至棕色，粗糙，有网状沟纹，一侧有明显的纵沟（种脊部位），宽端有浅色圆形隆起（种脐部位），狭端有暗色凹陷（合点部位）。质坚硬。纵切面可见表层的暗棕色的外胚乳向内伸人类白色的内胚乳，交错而成大理石样纹理。在宽端有凹孔，其中可见干燥皱缩的胚。气芳香而强烈，味辣而微苦。以个大、体重、坚实、香浓者为佳。"}]},{"ID":"20240902174848-7ep60xs","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-7ep60xs","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【化学成份】含挥发油2～9％，包括d-莰烯及α-蒎烯等。其脂肪中，肉豆蔻酸含量达70～80％，并含有毒物质肉豆蔻醚。"}]},{"ID":"20240902174848-0uy5oyn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-0uy5oyn","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902174848-tpkpmsr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-tpkpmsr","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻油除有芳香性外，尚具有显着的麻醉性能。对低等动物可引起瞳孔扩大，步态不稳，随之以睡眠，呼吸变慢，剂量再大则反射消失。对猫引起麻醉之剂量，常同时招致肝脂肪变性而死亡。人服7.5克肉豆蔻粉可引起眩晕乃至谵妄与昏睡，曾有服大量而致死的病例报告；猫服1.9克/公斤可引起半昏睡状态并于24小时内死亡，肝有脂肪变性。肉豆蔻油的毒性成分为肉豆蔻醚，二者中毒症状相似，肉豆蔻醚对猫的致死量为0.5～1.0毫升/公斤（在胃肠道的吸收不完全），如皮下注射0.12毫升即可引起广泛的肝脏变性。肉豆蔻油0.03～0.2毫升可用作芳香剂或驱风剂、肠胃道的局部刺激剂。"}]},{"ID":"20240902174848-lhkmtcu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-lhkmtcu","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻醚、榄香脂素对正常人有致幻作用，而另一芳香性成分洋檫木醚则无此作用，肉豆蔻醚对人的大脑有中度兴奋作用，但与肉豆蔻不完全相同；后者可引起血管状态不稳定、心率变快、体温降低、无唾液、瞳孔缩小、情感易冲动、孤独感、不能进行智力活动等。肉豆蔻及肉豆蔻醚能增强色胺的作用：体内及体外试验均对单胺氧化酶有中度的抑制作用。其萜类成分有抗菌作用。"}]},{"ID":"20240902174848-3pt156m","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-3pt156m","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【炮制】煨肉豆蔻（煨肉果）：洗净，取白面加水揉和包裹。另取蛤粉或滑石粉置锅内加热，将包好的肉豆蔻倒入，拌炒至外面的面呈焦黄色取出，除去面皮，乘热切片。一法将原药用清水略淘捞起，放在箩内润12小时后，用麸皮置锅内加热炒至老黄色为度。取出，筛去麸皮，乘热切片。"}]},{"ID":"20240902174848-r02rujw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-r02rujw","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902174848-lmk13xo","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-lmk13xo","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902174848-1ntv73a","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-1ntv73a","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味苦辛。\""}]},{"ID":"20240902174848-heb64if","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-heb64if","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"味辛，温，无毒。\""}]},{"ID":"20240902174848-29enfdp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-29enfdp","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味苦辛而涩，性温。\""}]},{"ID":"20240902174848-rl0dvcj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-rl0dvcj","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902174848-7fazw98","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-7fazw98","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"入肺、大肠经。"}]},{"ID":"20240902174848-kyk8dpg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kyk8dpg","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手阳明经。\""}]},{"ID":"20240902174848-ocj95c7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ocj95c7","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、胃二经。\""}]},{"ID":"20240902174848-dgifn9m","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-dgifn9m","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足太阴、阳明；手阳明大肠。\""}]},{"ID":"20240902174848-zhf5u9i","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-zhf5u9i","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902174848-7l86cdp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-7l86cdp","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"温中，下气，消食，固肠。治心腹胀痛，虚泻冷痢，呕吐，宿食不消。"}]},{"ID":"20240902174848-9gy7fyj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-9gy7fyj","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"能主小儿吐逆不下乳，腹痛；治宿食不消，痰饮。\""}]},{"ID":"20240902174848-58l1kh8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-58l1kh8","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"②《海药本草》：\"主心腹虫痛，脾胃虚冷气并，冷热虚泄，赤白痢等。凡痢以白粥饮服佳；霍乱气并，以生姜汤服良。\""}]},{"ID":"20240902174848-1a72ktw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-1a72ktw","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"调中，下气，止泻痢，开胃，消食。皮外络，下气，解酒毒，治霍乱。\""}]},{"ID":"20240902174848-4nkuylu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-4nkuylu","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"④《开宝本草》：\"温中，治积冷心腹胀痛，霍乱中恶，呕沫，冷气，消食止泄，小儿乳霍。\""}]},{"ID":"20240902174848-49e2cjd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-49e2cjd","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"暖脾胃，固大肠。\""}]},{"ID":"20240902174848-to3eh68","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-to3eh68","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"⑥《本草经读》：\"治精冷。\""}]},{"ID":"20240902174848-u0yh6fw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-u0yh6fw","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》；\"治肾泄，上盛下虚，诸逆上冲，元阳上浮而头痛。\""}]},{"ID":"20240902174848-ik2pacn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ik2pacn","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.5～2钱；或入丸、散。"}]},{"ID":"20240902174848-0xybwwj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-0xybwwj","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902174848-0k7n818","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-0k7n818","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使，勿令犯铜。\""}]},{"ID":"20240902174848-qru5auo","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-qru5auo","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"大肠素有火热及中暑热泄暴注，肠风下血，胃火齿痛及湿热积滞方盛，滞下初起，皆不宜服。\""}]},{"ID":"20240902174848-f1jjonq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-f1jjonq","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902174848-ptrsstm","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ptrsstm","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"①治水湿胀如鼓，不食者，病可下：肉豆蔻、槟榔、轻粉各一分，黑牵牛一两半（取头末）。上为末，面糊为丸，如绿豆大。每服十丸至二十丸，煎连翘汤下，食后，日三服。（《宣明论方》肉豆蔻丸）"}]},{"ID":"20240902174848-bp521lq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-bp521lq","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"②治脾虚泄泻、肠鸣不食：肉豆蔻一枚，剜小窍子，入乳香三小块在内，以面裹煨，面熟为度，去面，碾为细末。每服一钱，米饮送下，小儿半钱。（《杨氏家藏方》肉豆蔻散）"}]},{"ID":"20240902174848-3qpx2nu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-3qpx2nu","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"③治脾肾虚弱，大便不实，饮食不思：肉豆蔻、补骨脂、五味子、吴茱萸各为末。生姜四两，红枣五十枚。用水一碗，煮姜、枣，去姜，水干，取枣肉丸桐子大。每服五、七十丸，空心食前服。（《内科摘要》四神丸）"}]},{"ID":"20240902174848-55qta72","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-55qta72","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"④治脾泄气痢：豆蔻二颗，米醋调面裹之，置灰中煨令黄焦，和面碾末，更以炒党子末一两，相和。又焦炒陈廪米为末，每用二钱七，煎饮调前二物三钱匕，旦暮各一。（《续传信方》）"}]},{"ID":"20240902174848-j1maxus","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-j1maxus","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"⑤治水泻无度、肠鸣腹痛：肉豆蔻（去壳，为末）一两，生姜汁二合，白面二两。上三味，将姜汁和面作饼子，裹肉豆蔻末煨令黄熟，研为细散。每服二钱匕，空心米饮调下，日午再服。（《圣济总录》肉豆蔻散）"}]},{"ID":"20240902174848-u79c0aw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-u79c0aw","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"⑥治霍乱呕吐不止：肉豆蔻一两（去壳），人参一两（去芦头），厚朴一两（去粗皮，涂生姜汁，炙令香熟）。上药捣，粗罗为散。每服三钱，以水一大盏，入生姜半分，粟米二撮，煎至五分，去滓，不计时候温服。（《圣惠方》）"}]},{"ID":"20240902174848-ndhvs0e","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ndhvs0e","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902174848-ni8m4t9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ni8m4t9","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"肉豆蔻《中华本草》《中药大辞典》"}]},{"ID":"20240902174848-p1zleol","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-p1zleol","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902174848-n27spt3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-n27spt3","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"出自《药性论》（《中药大辞典》）、《名医别录》（《中华药海》）1.《本草图经》：肉豆蔻今惟岭南人家种之。春生苗，花实似豆蔻而圆小，皮紫紧薄，中肉辛辣。六月、七月采。"}]},{"ID":"20240902174848-9auehi3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-9auehi3","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：肉豆蔻，花结实，状虽似草豆蔻，而皮肉之颗则不同类，外有皱纹，而肉有斑缬，纹如槟榔纹，最易生蛀，惟烘干密封，则稍可留。"}]},{"ID":"20240902174848-vvgq2uy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-vvgq2uy","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【拼音名】RòuDòuKòu"}]},{"ID":"20240902174848-uiagz1b","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-uiagz1b","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【英文名】Nutmeg"}]},{"ID":"20240902174848-z7qbo1z","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-z7qbo1z","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【别名】迦拘勒、豆蔻、肉果、顶头肉、玉果、扎地、麻失"}]},{"ID":"20240902174848-143cq71","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-143cq71","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902174848-ssyo13l","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ssyo13l","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"药材基源：为肉豆蔻科植物肉豆蔻的种仁。"}]},{"ID":"20240902174848-pef9aa1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-pef9aa1","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：MyristicafragransHoutt."}]},{"ID":"20240902174848-a1sghoz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-a1sghoz","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植后6-7年开花结果，10年后产量增多，25年达盛果期。结果期为60-70年，盛果期有两次，即5-7月及10-12月。采摘民熟果实，除去果皮，剥去假种皮，将种仁用45℃低温慢慢烤干，经常翻动，当种仁摇之作响时即可。若高于45℃，脂肪溶解，失去香味，质量下降。"}]},{"ID":"20240902174848-vqyt9k6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-vqyt9k6","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【原形态】肉豆蔻，常绿乔木，高可达20m。叶互生；椭圆状披针形或长圆状披针形，长5-15cm，革质，先端尾状，基部急尖，全缘，上面淡黄棕色，下面色较深，并有红棕色的叶脉；叶柄长6-12mm。花雌雄异株；雄花的总状花序长2.5-5cm；小苞片鳞片状；花疏生，黄白色，椭圆形或壶形，长6mm，下垂；花药9-12个，连合成圆柱状有柄的柱。果实梨形或近于圆球形，下垂，长3.5-6cm，淡红色或黄色，成熟后纵裂成2瓣，显出绯红色假种皮，种子长球形，种皮红褐色，木质。"}]},{"ID":"20240902174848-dq389n0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-dq389n0","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902174848-6us40ky","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-6us40ky","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"生态环境：热带地区广为栽培。"}]},{"ID":"20240902174848-kmhkuti","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kmhkuti","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"资源分布：分布马来西亚、印度尼西亚、巴西等地。"}]},{"ID":"20240902174848-04zkmc2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-04zkmc2","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902174848-ivnjjxu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ivnjjxu","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.生物学特性喜热带和亚热带气候。适宜生长的气温为25-30℃，抗寒性弱，在6℃时即受寒害。年降雨量应在1700-2300mm之间，忌积水。幼龄树喜阴，成龄树喜光。以土层深厚、松软、肥沃和排水良好的壤土栽培为宜。"}]},{"ID":"20240902174848-k5lh5dj","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-k5lh5dj","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.栽培技术主要采用种子繁殖，留种应选稳产、高产、粒大、种仁饱满、无病虫害的优良母树上结了的完全成熟自然裂开的果实。随采随播，或用湿沙贮藏。种子失水干燥即丧失发芽力。苗床土壤要松软肥沃，行株距10cm×5cm，穴播，种脐向下，保持荫蔽湿润，约60d发芽，至真叶将展出时蔬苗移栽。幼树要艿蔽，苗高20-30cm时定植。在春季3-4月或秋季8-10月选阴雨天种植，行株距5m×4m，穴深宽各60cm，每穴植苗1株。"}]},{"ID":"20240902174848-6hvhhkw","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-6hvhhkw","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"3.田间管理幼树生长缓慢，需荫蔽，可在行间种植高杆绿肥，并勤浇水。由于冠幅大，根系浅，作纯林种植时要先种植防风林带，在台风频繁地区必须进行防风。每年施肥3-4次，以有机肥为主，配合化肥。幼龄期每株追施有机肥5-10kg或尿素25-50g，冬季施堆肥。以后随树龄增加，逐渐加施肥料。"}]},{"ID":"20240902174848-ie7qwp6","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ie7qwp6","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"4.病虫害防治病害有斑点病、疫病，可用波尔多液1：1：120倍液或敌克松500倍液喷射；锈腐病、菌核病用50%多菌灵或甲基托布津500倍液浇灌病穴。另有位枯病、根腐病等为害。虫害有蛴螬、地老虎、蝼蛄、金针虫等。"}]},{"ID":"20240902174848-73ipy40","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-73ipy40","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902174848-96butsc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-96butsc","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别种仁卵圆形或椭圆形，长2-3.5cm，宽1.5-2.5cm。表面灰棕色至暗棕色，有网状沟纹，常被有白色石灰粉；宽端有浅色圆形隆起（种脐的部位）。狭端有暗色下陷处（合点的部位），两端间有明显的纵沟（种脊的部位）。质坚硬，难破碎，碎断面可见棕黄或暗棕色外胚乳向内伸入，与类白色的内胚乳交错，形成大理石样纹理。纵切时可见宽端有小形腔隙，内藏小型干缩的胚，子叶卷曲。气强烈芳香，味辛辣、微苦。"}]},{"ID":"20240902174848-2bmk00z","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-2bmk00z","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"以个大、体重、坚实、破开后香气浓者为佳。"}]},{"ID":"20240902174848-3rhvxbz","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-3rhvxbz","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别种仁黄切面：外胚乳分内外两层，外层细胞扁平，切向延长，内含黄棕色物质；内层细胞长方形，含红棕色物质，伸入内胚乳形成错入组织，其中常有一个维管束，并有多数油细胞散在，油细胞直径42-140cm，含挥发油滴。内胚乳细胞多角形，含多量脂肪油、淀粉粒及糊粉粒，糊粉粒中有拟晶体。内胚乳有含棕色物质的细胞散在。"}]},{"ID":"20240902174848-7exwkhy","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-7exwkhy","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【化学成份】种仁含脂肪油25%-46%，挥发油8%-15%，内含有毒物：肉豆蔻醚（myristicin）约4%。挥发油主含香桧烯（sabinene），α-及β-蒎烯（pinene），松油-4-烯醇（terpinen-4ol），γ-松油烯（γ-terpinene），柠檬烯（limonene），冰片烯（bornylene），β-水芹烯（β-phellandrene），对聚伞花素（p-cymene），α-异松油烯（α-terpinolene），α-松油醇（α-terpineol），δ-荜澄茄烯（δ-cadinene），肉豆蔻醚，榄香脂素（elemicin），还含樟烯（camphene），月桂烯（myrcene），α-水芹烯（α-phellandrene），3，4-二甲基苏合香烯（3，4-dimethylstyrene），芳樟醇（linalool），顺式辣薄荷醇（cis-pinperitol），反式辣薄荷醇（trans-piperitol），龙脑（borneol），顺式丁香烯（cis-caryophyllene），香茅醇（citronellol），对聚伞花素-α-醇（p-cymen-α-ol），黄樟醚（safrole），橙花醇（nerol），β-澄茄油烯（β-cubebene），乙酸牻牛儿醇酯（geranylacetate），丁香油酚（eugenol），甲基丁香油酚（methyleugenol），异榄香脂素（isoelemicin）。脂肪油中主含三肉豆蔻酸甘油酯（trimyristin）和少量的三油酸甘油酯（triolein）等。种子还含木脂素：1-（3，4-亚甲二氧基苯基）-2-（4-烯丙基-2，6-二甲氧基苯氧基）-1-丙醇〔1-（3，4-methylenedioxyphenyl）-2-（4-allyl-2，6-dimethoxyphenoxy）-propan-1-ol〕，1-（3-甲氧基-4-乙酰氧基苯基）-2-（4烯丙基地，6-二甲氧苯氧基）-1-丙醇乙酸酯〔1-（3-methoxy-4-acetyloxyphenyl）-2-（4-allyl-2，dimethoxyphenoxy）propan-1-olacetate〕，1-（3，4-亚甲二氧苯基）-2-（4-烯丙基-2，6-二甲氧基苯氧基）-1-丙醇乙酸酯〔1-（3，4-methylenedioxyphenyl）-2-（4-allyl-2，6-dimethoxyphenoxy）propan-1-olacetate〕，1-（3，4，5-三甲氧基苯基）-2-（4-烯丙基-2，6-二甲氧基苯氧基）丙烷〔1-（3，4，5-trimethoxyphenyl）-2-（4-allyl-2，6-dimethoxyphenoxy）propane〕，去氢二异丁香油酚（dehydrodiisoeugenol）即利卡灵A（licarinA），5'-甲氧基去氢二异丁香油酚（5'-methoxydehydrodiisoeugenol），2-（3，4-亚甲二氧基苯基）-2，3-二氢-7-甲氧基-3-甲基-5-（丙烯基）苯并呋喃｛2-（3，4-methylenedioxyphenyl）-2，3-dihydro-7-methoxy-3-methyl-5〔1-（E）-propenyl〕benzofuran｝，即利卡灵B（licarinB），2-（3，4-亚甲二氧基-5-甲氧基苯基）-2，3-二氢-7-甲氧基-3-甲基-5-（丙烯基）苯并呋喃｛2-（3，4-methylenedioxy-5-methoxyphenyl）-2，3-dihydro-7-methoxy-3-methyl-5-〔1-（E）-propenyl〕benzofuran｝、1-（3，4-二甲氧基苯基）-2-（4-烯丙基-2，6-二甲氧基苯氧基）-1-丙醇〔1-（3，4-dimethoxyphenyl）-2-(4-allyl-2，6-dimethoxyphenoxy)propan-1-ol〕，1-（3，4-二甲氧基苯基)-2-（4-烯丙基-2，6-二甲氧基苯氧基）-1-丙醇〔1-（3-methoxy-4-hydroxyphenyl）-2-（4-allyl-2，6-dimethoxyphenoxy）propan-1-ol〕等。脱指种仁含肉豆蔻酸（myristicacid）及三萜皂甙，甙元为齐墩果酸（oleanolicacid）。"}]},{"ID":"20240902174848-1c1u5tp","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-1c1u5tp","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902174848-ndsemkf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-ndsemkf","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.镇静催眠作用本品挥发油中所含的甲基异丁香酚有抑制中枢神经作用，兔耳iv50mg/kg后，可见睡眠时翻正反射、痛觉反射和听觉反射均消失，睡眠时间平均20分钟8s，有加强戊巴比妥的安眠作用。"}]},{"ID":"20240902174848-bgxkxq8","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-bgxkxq8","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用甲基异丁香酚对金黄色葡萄球菌和肺炎双球菌，MIC分别为0.4mg/ml和0.6mg/ml。马拉巴酮B对金黄色葡萄球菌、枯草杆菌和坚忍链球菌有较强的抑菌作用，前两者的MIC为1ug/ml，后者为2ug/ml，马拉巴酮C对枯草杆菌的MIC为2ug/ml。"}]},{"ID":"20240902174848-f2vr1ip","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-f2vr1ip","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"3.麻醉作用本品挥发油中的甲基丁香酚和榄香脂素对小鼠、兔、猫和狗，iv给药后有麻醉作用。"}]},{"ID":"20240902174848-6bhc3pn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-6bhc3pn","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"4.其它作用4.1.对胃肠道刺激作用:本品所含挥发油对胃肠道有刺激作用，且具有祛风作用。少量能促进胃液的分泌和刺激胃肠蠕动，大剂量则抑制。"}]},{"ID":"20240902174848-6hkywv9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-6hkywv9","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"4.2.降低谷丙转氨酶作用:另有降低大白鼠血清谷丙转氨酶作用。"}]},{"ID":"20240902174848-z4fypoq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-z4fypoq","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【毒性】肉豆蔻醚对猫的LD为0.5-1.0ml/kg，sc0.12ml可引起广泛的肝脏变性。猫服肉豆蔻粉1.9g/kg可引起半昏睡状态，并于24小时内死亡。肉豆蔻醚和榄香脂素对正常人有致幻作用。"}]},{"ID":"20240902174848-6nj5y9w","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-6nj5y9w","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【鉴别】（1）取本品粉末2g，加乙醚8ml，振摇，冷浸2h，取滤液2ml，置蒸发皿中，待乙醚挥散后，加茴香醛的硫酸试液0.5ml，则显粉红色，渐变紫色。（检查挥发油）（2）薄层色谱取本品粉末1g，加乙醚4ml，冷浸2h，滤过，滤液作为供试品溶液。另取黄樟醚少许，用乙醚溶解后作为对照品溶液。分别吸取供试品及对照品溶液，点样于同一硅胶G（黄岩）薄层板上。以苯-乙酸乙佛（95：5）展开，展距13cm。干后，喷雾5%磷钼酸乙醇溶液，加热，供试品色谱在与对照品色谱相应位置显相同颜色的斑点。"}]},{"ID":"20240902174848-kh32kst","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kh32kst","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902174848-t61z8xd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-t61z8xd","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.煨肉豆蔻（煨肉果）：洗净，取白面加水揉和包裹。另取蛤粉或滑石粉置锅内加热，将包好的肉豆蔻倒入，拌炒至外面的面呈焦黄色取出，除去面皮，乘热切片。一法将原药用清水略淘捞起，放在箩内润12小时后，用麸皮置锅内加热炒至老黄色为度。取出，筛去麸皮，乘热切片。"}]},{"ID":"20240902174848-8i0nui1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-8i0nui1","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.蒸制：取净肉豆蔻浸泡1小时，捞出置笼内，一层麸皮，一层肉豆蔻，层层相间，蒸约2小时，油即润进麸皮内，去净麸皮及时切厚片，干燥，或捣碎用。"}]},{"ID":"20240902174848-gwfpzk2","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-gwfpzk2","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"3.炒制：将小麦面粉倒入锅内，用文火炒热，将肉豆蔻倒入，炒成微黄色时，出锅，筛去面粉，摊开，晾凉，配方时捣碎。每肉豆蔻100kg，用小麦面粉50kg。"}]},{"ID":"20240902174848-kvkle13","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-kvkle13","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"4.土制：取细黄土，置锅内加热到发泡，倒入肉豆蔻，不断翻动，煨至肉豆蔻热透，油质渗出（防止炒黑），取出，筛净黄土，用时捣碎。"}]},{"ID":"20240902174848-whtqtrf","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-whtqtrf","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"5.制霜：取肉豆蔻，研碎如泥。用多层草纸包裹，压榨去油，反复压榨至去尽油为度。"}]},{"ID":"20240902174848-z1wg0io","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-z1wg0io","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【性味】辛；苦；温"}]},{"ID":"20240902174848-3f4r39h","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-3f4r39h","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃；大肠经"}]},{"ID":"20240902174848-o5zhgf7","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-o5zhgf7","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中涩肠；行气消食。主虚泻；冷痢；脘腹胀痛；食少呕吐；宿食不消"}]},{"ID":"20240902174848-3aa70ud","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-3aa70ud","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5-6g；或入丸、散。"}]},{"ID":"20240902174848-xp8om1p","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-xp8om1p","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902174848-4alke47","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-4alke47","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使，勿令犯铜。"}]},{"ID":"20240902174848-8lxhou9","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-8lxhou9","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：大肠素有火热及中暑热泄暴注，肠风下血，胃火齿痛及湿热积滞方盛，滞下初起，皆不宜服。"}]},{"ID":"20240902174848-fnjce4q","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-fnjce4q","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【附方】1.四神丸(《证治准绳》)，主治脾肾虚寒，五更泻泄，不思饮食，或久泻不愈，腹痛腰酸肢冷，神疲乏力等。2.真人养脏汤(《太平惠民和剂局方》)，主治久泻久痢，脾肾虚寒，大便滑脱不禁，腹痛喜按喜温，或下痢赤白，或便脓血，日夜无度，里急后重，脐腹疼痛，倦怠食少。3.肉豆蔻丸(《太平圣惠方》)，治小儿脾胃气逆，呕吐不止。4.肉豆蔻散(《太平圣惠方》)，治霍乱吐泻不止。5.舒肝丸(《全国中药成药处方集》)，主治肝气郁滞，两胁刺痛，饮食无味，消化不良，呕吐酸水，嘈杂，周身窜痛。"}]},{"ID":"20240902174848-0k2v85z","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-0k2v85z","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902174848-d67ds4p","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-d67ds4p","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"1.《药性论》：能主小儿吐逆不下乳，腹痛；治宿食不消，痰饮。"}]},{"ID":"20240902174848-hjpujxq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hjpujxq","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"2.《海药本草》：主心腹虫痛，脾胃虚冷气并，冷热虚泄，赤白痢等。凡痢以白粥饮服佳；霍乱气并，以生姜汤服良。"}]},{"ID":"20240902174848-hr1fkyr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hr1fkyr","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：调中，下气，止泻痢，开胃，消食。皮外络，下气，解酒毒，治霍乱。"}]},{"ID":"20240902174848-8m9vse0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-8m9vse0","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"4.《开宝本草》：温中，治积冷心腹胀痛，霍乱中恶，呕沫，冷气，消食止泄，小儿乳霍。"}]},{"ID":"20240902174848-u578t4d","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-u578t4d","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：暖脾胃，固大肠。"}]},{"ID":"20240902174848-v19ickq","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-v19ickq","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"6.《本草经读》：治精冷。"}]},{"ID":"20240902174848-qxj2n5i","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-qxj2n5i","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"7.《本草求原》：治肾泄，上盛下虚，诸逆上冲，元阳上浮而头痛。"}]},{"ID":"20240902174848-hnzvwu1","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hnzvwu1","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"8.《本草衍义》：肉豆蔻，善下气，多服则泄气，得中则和平其气。"}]},{"ID":"20240902174848-c35rr5v","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-c35rr5v","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"9.《本草衍义补遗》：肉豆蔻，温中补脾，为丸。日华子称其下气，以其脾得补而善运化，气自下也，非若陈皮、香附之駃泄。《衍义》不详其实，谩亦因之，遂以为不可多服。"}]},{"ID":"20240902174848-hp5kwsa","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hp5kwsa","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"10.《药性类明》：肉豆蔻，温中补脾，泄痢久不已则用之，故《本草》言冷热虚泄，久则虽热者其气亦虚，非概用以温中也。"}]},{"ID":"20240902174848-hz5jwcr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-hz5jwcr","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》：肉豆寇，辛味能散能消，温气能和中通畅。其气芬芳，香气先入脾，脾主消化，温和而辛香，故开胃，胃喜暖故也。故为理脾开胃、消宿食、止泄泻之要药。"}]},{"ID":"20240902174848-80cejcg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-80cejcg","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"12.《本草汇言》：肉豆蔻，为和平中正之品，运宿食而不伤，非若枳实、莱服子之有损真气也；下滞气而不峻，非若香附、大腹皮之有泄真气也；止泄泻而不涩，非若诃子、罂粟壳之有兜塞掩伏而内闭邪气也。"}]},{"ID":"20240902174848-u0xe9p4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-u0xe9p4","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"13.《本草正》：肉豆蔻，能固大肠，肠既固则元气不走，脾气自健，故曰理脾胃虚冷，而实非能补虚也。"}]},{"ID":"20240902174848-tvnmpd4","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-tvnmpd4","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"14.《本草正义》：肉豆蔻，除寒燥湿，解结行气，专理脾胃，颇与草果相近，则辛温之功效本同，惟涩味较甚，并能固及大肠之滑脱，四神丸中有之。温脾即以温肾，是为中下两焦之药，与草果之专主中焦者微别。大明谓温中下气，开胃，解酒毒。甄权谓治宿食痰饮，止小儿吐逆不下乳，腹痛。李珣谓主心腹虫痛。皆专就寒湿一边着想者。若湿热郁滞而为此诸症，则必不可一例论治。故李珣又谓主脾胃虚冷虚泄。濒湖谓暖脾胃、固大肠。要言不烦，最为精切。惟珣又谓治亦白痢，则湿热者多，虚寒者少，不当泛泛言之矣。香、砂、蔻仁之类，温煦芳香，足以振动阳气，故醒脾健运，最有近功，则所谓消食下气，已胀泄满者，皆其助消化之力，固不可与克削破气作一例观。"}]},{"ID":"20240902174848-4w3aclo","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174848-4w3aclo","updated":"20240902174848"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》《中药大辞典》"}]},{"ID":"20240902174920-9nht8yh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240902174920-9nht8yh"}},{"ID":"20240902174949-7ao2rhf","Type":"NodeThematicBreak","Properties":{"id":"20240902174949-7ao2rhf"}},{"ID":"20240902174950-mf7xayr","Type":"NodeParagraph","Properties":{"id":"20240902174950-mf7xayr"}}]}