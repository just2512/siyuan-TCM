: 632px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 588px;","style":"width: 578px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸦胆子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸦胆子 13-20240730165522-q1riffw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 578px;\" parent-style=\"width: 588px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240903093356-07hdfz2","Type":"NodeParagraph","Properties":{"id":"20240903093356-07hdfz2","updated":"20240903093356"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸦胆子 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸦胆子 14-20240730165700-u60njgc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 797px;","style":"width: 787px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸦胆子 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸦胆子 8-20240730165155-mmx3w8u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 787px;\" parent-style=\"width: 797px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730165951-bkaidce","Type":"NodeParagraph","Properties":{"id":"20240730165951-bkaidce","updated":"20240730170646"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 363px;","style":"width: 353px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸦胆子 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸦胆子 15-20240730170256-621oaoh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 353px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸦胆子 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸦胆子 18-20240730170646-qb6z8bp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730165528-yw7gefa","Type":"NodeThematicBreak","Properties":{"id":"20240730165528-yw7gefa"}},{"ID":"20240903093442-opj3lfw","Type":"NodeParagraph","Properties":{"id":"20240903093442-opj3lfw","updated":"20240903093450"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：鸦胆子"}]},{"ID":"20240903093442-ixhm6jl","Type":"NodeParagraph","Properties":{"id":"20240903093442-ixhm6jl","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子《中国药典》"}]},{"ID":"20240903093442-z6pcs8c","Type":"NodeParagraph","Properties":{"id":"20240903093442-z6pcs8c","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【拼音名】YāDǎnZi"}]},{"ID":"20240903093442-09pknqp","Type":"NodeParagraph","Properties":{"id":"20240903093442-09pknqp","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSBRUCEAE"}]},{"ID":"20240903093442-of1ouin","Type":"NodeParagraph","Properties":{"id":"20240903093442-of1ouin","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【别名】苦参子、老鸦胆"}]},{"ID":"20240903093442-o6xtbdf","Type":"NodeParagraph","Properties":{"id":"20240903093442-o6xtbdf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【来源】本品为苦木科植物鸦胆子Bruceajavanica（L.）Merr.的干燥成熟果实。秋季果实成熟时采收，除去杂质，晒干。"}]},{"ID":"20240903093442-lmyxozy","Type":"NodeParagraph","Properties":{"id":"20240903093442-lmyxozy","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈卵形，长6～10mm,直径4～7mm。表面黑色或棕色，有隆起的网状皱纹，网眼呈不规则的多角形，两侧有明显的棱线，顶端渐尖，基部有凹陷的果梗痕。果壳质硬而脆，种子卵形，长5～6mm，直径3～5mm，表面类白色或黄白色，具网纹；种皮薄，子叶乳白色，富油性。无臭，味极苦。"}]},{"ID":"20240903093442-xerm1ra","Type":"NodeParagraph","Properties":{"id":"20240903093442-xerm1ra","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品果皮粉末棕褐色。表皮细胞多角形，含棕色物。薄壁细胞多角形，含草酸钙簇晶及方晶，簇晶直径约至30μm。石细胞类圆形或多角形，直径14～38μm。种子粉末黄白色。种皮细胞略呈多角形，稍延长。胚乳和子叶细胞含糊粉粒。"}]},{"ID":"20240903093442-cbzucw9","Type":"NodeParagraph","Properties":{"id":"20240903093442-cbzucw9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【炮制】除去果壳及杂质。"}]},{"ID":"20240903093442-82v5vng","Type":"NodeParagraph","Properties":{"id":"20240903093442-82v5vng","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒；有小毒。"}]},{"ID":"20240903093442-asv4o2x","Type":"NodeParagraph","Properties":{"id":"20240903093442-asv4o2x","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【归经】归大肠、肝经。"}]},{"ID":"20240903093442-gnyzvi4","Type":"NodeParagraph","Properties":{"id":"20240903093442-gnyzvi4","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，截疟，止痢，腐蚀赘疣。用于痢疾，疟疾；外治赘疣，鸡眼。"}]},{"ID":"20240903093442-c1c1zky","Type":"NodeParagraph","Properties":{"id":"20240903093442-c1c1zky","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～2g,用龙眼肉包裹或装入胶囊吞服；外用适量。"}]},{"ID":"20240903093442-kmpy078","Type":"NodeParagraph","Properties":{"id":"20240903093442-kmpy078","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240903093442-maqpypu","Type":"NodeParagraph","Properties":{"id":"20240903093442-maqpypu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903093442-e7zcu2g","Type":"NodeParagraph","Properties":{"id":"20240903093442-e7zcu2g","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子《*辞典》"}]},{"ID":"20240903093442-13tsfts","Type":"NodeParagraph","Properties":{"id":"20240903093442-13tsfts","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目拾遗》"}]},{"ID":"20240903093442-u3zvt90","Type":"NodeParagraph","Properties":{"id":"20240903093442-u3zvt90","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【拼音名】YāDǎnZi"}]},{"ID":"20240903093442-loz2s60","Type":"NodeParagraph","Properties":{"id":"20240903093442-loz2s60","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【别名】老鸦胆（《生草药性备要》），鸦胆、苦棒子（《吉云旅钞》），苦参子（《纲目拾遗》），鸦蛋子（《植物名实图考》），鸭蛋子（《医学衷中参西录》），鸭胆子（《中药志》），解苦楝（《广西中药志》），小苦楝（《广西中草药》）。"}]},{"ID":"20240903093442-et09f8x","Type":"NodeParagraph","Properties":{"id":"20240903093442-et09f8x","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【来源】为苦木科植物鸦胆子的果实。秋季果实成熟时采收。除净枝叶杂质，晒干。"}]},{"ID":"20240903093442-334q1ke","Type":"NodeParagraph","Properties":{"id":"20240903093442-334q1ke","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903093442-gs290e3","Type":"NodeParagraph","Properties":{"id":"20240903093442-gs290e3","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"常绿大灌木或小乔木，高达3米，全株均被黄色柔毛。单数羽状复叶，互生，长10～30厘米，有长柄；小叶5～11枚，对生，长卵状披针形，长5～10厘米，宽2～4厘米，先端渐尖，基部楔形或两侧不对称的斜圆形，边缘有三角形粗齿，上面绿色，下面淡绿色。圆锥聚伞花序腋生，雌雄异株，雄花序长10～30厘米，雌花序长4～18厘米；花极小，红黄色；雄花萼片4，披针形，花瓣4，线状披针形，雄蕊4，着生在花盘下方，花盘4裂；雌花萼片4，三角形，花瓣4，长圆状披针形，子房由4心皮组成，大部离生，下部被花盘包围，花柱下弯，柱头长尖形。核果长卵形，先端略向外弯，成熟时黑色，具突起的网纹。花期3～8月。果期4～9月（海南岛、广西）。"}]},{"ID":"20240903093442-bcflxfx","Type":"NodeParagraph","Properties":{"id":"20240903093442-bcflxfx","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"本植物的根（老鸦胆根）、叶（老鸦胆叶）亦供药用，另详专条。"}]},{"ID":"20240903093442-ib7luir","Type":"NodeParagraph","Properties":{"id":"20240903093442-ib7luir","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长在草地、灌木丛中及路旁向阳处。分布福建、广西、云南、台湾、广东等地。主产广东、广西。福建、台湾亦产。"}]},{"ID":"20240903093442-o6aetnv","Type":"NodeParagraph","Properties":{"id":"20240903093442-o6aetnv","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性状】干燥成熟的果实呈长圆形或卵形，两头稍尖，长6～10毫米，直径3～7毫米。表面灰黑色，有不规则多角形的网纹，底端有凹陷的果柄痕。外壳质硬而脆，破开后内向灰红色或灰黄色，光滑而油润。内有黄白色种仁，呈卵形，长4～7毫米，直径3～5毫米，外包抽皱的薄膜，富有油性。无臭，味极苦。以质坚、仁白、油性足者为佳。"}]},{"ID":"20240903093442-getn1uu","Type":"NodeParagraph","Properties":{"id":"20240903093442-getn1uu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240903093442-qzou6xz","Type":"NodeParagraph","Properties":{"id":"20240903093442-qzou6xz","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子含生物碱（鸦胆子碱和鸦胆宁等）、糖甙（鸦胆灵、鸦胆子甙等）、酚性成分（鸦胆子酚等）和一种羟基羧酸称鸦胆子酸等。"}]},{"ID":"20240903093442-06w762k","Type":"NodeParagraph","Properties":{"id":"20240903093442-06w762k","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子仁含脂肪油（鸦胆子油）56.23％。油中不皂化物占1.36％，内含挥发油少许；皂化物92.47％，内含油酸（占原油的％-下同）81.87％、亚油酸3.37％、硬脂酸2.65％、棕榈酸6.62％等；还有熔点为152℃的绢丝状结晶体4.59％。"}]},{"ID":"20240903093442-y7kxby3","Type":"NodeParagraph","Properties":{"id":"20240903093442-y7kxby3","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"种子中含多种结构上类似苦木素的苦味成分：鸦胆子苦醇、鸦胆子素A、B、C、D、E、F、G、H等。"}]},{"ID":"20240903093442-e4s3ryn","Type":"NodeParagraph","Properties":{"id":"20240903093442-e4s3ryn","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903093442-gqvrp6j","Type":"NodeParagraph","Properties":{"id":"20240903093442-gqvrp6j","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"①抗阿米巴作用"}]},{"ID":"20240903093442-gh4k5cb","Type":"NodeParagraph","Properties":{"id":"20240903093442-gh4k5cb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子仁及其有效成分对痢疾杆菌、伤寒杆菌、霍乱弧菌等没有抑制作用，而对原虫如阿米巴、草履虫乃至疟原虫均有杀灭效力。去油鸦胆子水浸液加入溶组织阿米巴之培养基中，发观1：1000之稀释中性液需与培养基接触48小时后，方能杀灭三种阿米巴中之二种，因此，认为试管内杀灭阿米巴之效力，尚不足以说明临床的疗效。从鸦胆子中提得的粗制结晶配糖体，在试管中有更强的作用，但进一步精制后，效力反而降低，因此其有效成分迄未解决。从鸦胆子中分离出的结晶性成分-甙甲，1：10000的水溶液在玻片上可于4小时内杀灭阿米巴；甙乙则较弱，需1：1000的浓度，方有作用。动物（猫、犬、猴）人工或天然感染的阿米巴痢疾，用鸦胆子及其有效成分治疗，也证明具有抗阿米巴作用，多数或全部可达症状消失，1/3～1/2达到根治，在过去对动物进行实验治疗的文献中，死亡率常较高，因而影响了治疗率。"}]},{"ID":"20240903093442-ozgg8y9","Type":"NodeParagraph","Properties":{"id":"20240903093442-ozgg8y9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"④抗疟作用"}]},{"ID":"20240903093442-6uy8gcg","Type":"NodeParagraph","Properties":{"id":"20240903093442-6uy8gcg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"自1950年发现鸦胆子仁或其水浸液对鸡疟有效以后，进一步证明了它的抗疟作用大于常山而与奎宁相似，但从其中提得的结晶成分，疗效不够满意。鸦胆子温浸剂或醇-水提取液对鸡疟原虫的繁殖确有显著的抑制作用，但剂量必须在接近半数致死量时方有效。经治疗的小鸡，体重显著减轻、甚至死亡，凡接受治疗后未死的鸡，停药后皆复发而死亡。对间日疟患者，鸦胆子水提浸膏虽有一定疗效，但反应（主要是恶心、呕吐）较重。"}]},{"ID":"20240903093442-nk1r7p0","Type":"NodeParagraph","Properties":{"id":"20240903093442-nk1r7p0","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"③驱肠虫作用"}]},{"ID":"20240903093442-3rmlms7","Type":"NodeParagraph","Properties":{"id":"20240903093442-3rmlms7","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"曾发现用鸦胆子治疗阿米巴痢疾时，肠内寄生虫如鞭虫、蛔虫、绦虫等也被驱出，因此，可能鸦胆子对上述寄生虫也有毒性。鸦胆子中的苦味甙性成分在较高浓度时能杀灭肺吸虫成虫，但在犬肺吸虫病的实验治疗中，并无效果。对钩虫似亦无效。"}]},{"ID":"20240903093442-q2pz1gd","Type":"NodeParagraph","Properties":{"id":"20240903093442-q2pz1gd","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"④治疣及乳头瘤"}]},{"ID":"20240903093442-p24p6qw","Type":"NodeParagraph","Properties":{"id":"20240903093442-p24p6qw","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子仁或油对正常皮肤或粘膜面有刺激作用，系一种细胞毒，临床上治疣或乳头状瘤有效。对小鼠的实验性乳头状瘤，用鸦胆子仁或水剂（油剂效果较差）能使瘤组织细胞发生退行性变与坏死；作用于正常皮肤组织与癌组织时，也具有类似的作用。"}]},{"ID":"20240903093442-7l9hxzb","Type":"NodeParagraph","Properties":{"id":"20240903093442-7l9hxzb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑤其他作用"}]},{"ID":"20240903093442-mcuq7sv","Type":"NodeParagraph","Properties":{"id":"20240903093442-mcuq7sv","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"静脉注射小量去油鸦胆子仁粉浸剂和各种粗制有效成分，可使哺乳动物血压暂时下降；切断二侧迷走神经，不影响原有的降压作用。此外还抑制在体和离体心脏的搏动，扩张后肢血管；对蛙的血管相反，呈收缩现象，提纯后的鸦胆子甙则无降压作用；较大剂量亦不影响猴的心电图及肝功能。鸦胆子仁浸剂兴奋离体子宫及离体和在体小肠而增进蠕动；鸦胆子甙则无上述作用，但小量注射，使犬在体小肠发生强烈的收缩运动。从鸦胆子中提出的甙甲对离体兔心有短暂的抑制作用，能引起兔的血压下降，对离体兔耳或蛙下肢血管呈收缩作用，对离体兔子宫无明显作用；甙乙对兔及蛙心也有短暂的抑制；酚性化合物能引起离体兔、蛙心的收缩不全。此外，鸦胆子冷浸液（5～10％）可杀灭蚊幼虫：其茎、叶放入积水缸内亦有效。"}]},{"ID":"20240903093442-e45n558","Type":"NodeParagraph","Properties":{"id":"20240903093442-e45n558","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240903093442-o3nyl8y","Type":"NodeParagraph","Properties":{"id":"20240903093442-o3nyl8y","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子挥发油有刺激性。其有毒成分为溶于水、具苦味的部分。鸦胆子仁或有效成分的大剂量，使动物内脏血管显着扩张，甚至出血；对中枢神经系统呈普遍的抑制现象；白细胞增多，多核细胞比率增加。治疗量在临床上常遇到的症状是恶心、呕吐，有时发生血压降低。去油鸦胆子对猫灌胃的最小致死量为0.1克/公斤。鸦胆子中酚性成分的毒性最强，甙甲、甙乙次之，它们对小鼠皮下注射之半数致死量分别为：0.65、10、74毫克／公斤。死亡前呈全身抑制及四肢麻痹。"}]},{"ID":"20240903093442-3cftcqa","Type":"NodeParagraph","Properties":{"id":"20240903093442-3cftcqa","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"《南方主要有毒植物》：\"鸦胆子，有毒部位：果壳和种子。中毒症状：成年人吃12粒有中毒危险。症状是恶心，呕吐，腹痛，腹泻，头昏，全身无力，呼吸慢或困难，昏睡，最后四肢麻痹。解救方法：洗胃；内服蛋清或牛奶及活性炭；内服或注射维生素B1；静脉滴注葡萄糖盐水及维生素丙。腹剧痛时给止痛剂；昏睡时给兴奋剂等对症治疗。广州草药医师介绍：先用甘草三钱煎水服或嚼烂吞下原汁，后吃红糖和冻白粥。\""}]},{"ID":"20240903093442-wkrxmm7","Type":"NodeParagraph","Properties":{"id":"20240903093442-wkrxmm7","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【炮制】簸净杂质，洗净，晒干，剥去外壳，取整仁。"}]},{"ID":"20240903093442-s94re04","Type":"NodeParagraph","Properties":{"id":"20240903093442-s94re04","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903093442-is1qx68","Type":"NodeParagraph","Properties":{"id":"20240903093442-is1qx68","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"苦，寒，有毒。"}]},{"ID":"20240903093442-a76vxt8","Type":"NodeParagraph","Properties":{"id":"20240903093442-a76vxt8","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"①《医学衷中参西录》：\"味极苦，性凉。\""}]},{"ID":"20240903093442-t3cspwu","Type":"NodeParagraph","Properties":{"id":"20240903093442-t3cspwu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"②《本草正义》：\"大苦，大寒。\""}]},{"ID":"20240903093442-4012kf8","Type":"NodeParagraph","Properties":{"id":"20240903093442-4012kf8","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"③《广西中药志》：\"味极苦，性寒，有毒。\""}]},{"ID":"20240903093442-epr7eqf","Type":"NodeParagraph","Properties":{"id":"20240903093442-epr7eqf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903093442-zgzgmwg","Type":"NodeParagraph","Properties":{"id":"20240903093442-zgzgmwg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"清热，燥湿，杀虫，解毒。治痢疾，久泻，疟疾，痔疮，疔毒，赘疣，鸡眼。"}]},{"ID":"20240903093442-zq8jk7r","Type":"NodeParagraph","Properties":{"id":"20240903093442-zq8jk7r","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"①《生草药性备要》：\"凉血，去脾家疮，理跌打。\""}]},{"ID":"20240903093442-rzxs7wg","Type":"NodeParagraph","Properties":{"id":"20240903093442-rzxs7wg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"②《纲目拾遗》：\"治痢，痔。\""}]},{"ID":"20240903093442-by6qqjs","Type":"NodeParagraph","Properties":{"id":"20240903093442-by6qqjs","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"③《岭南采药录》：\"治冷痢，久泻。又能杀虫。\""}]},{"ID":"20240903093442-9vi5weg","Type":"NodeParagraph","Properties":{"id":"20240903093442-9vi5weg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"④《医学衷中参西录》：\"凉血解毒，善治热性赤痢，二便因热下血。\"\"治梅毒及花柳毒淋。捣烂醋调敷疔毒。善治疣。\""}]},{"ID":"20240903093442-fz3vaw7","Type":"NodeParagraph","Properties":{"id":"20240903093442-fz3vaw7","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑤《科学的民间药草》：\"截疟和治阿米巴痢疾。\"\"制成油质，可治外耳道乳状瘤，乳头瘤，以及尖锐性湿疣。\""}]},{"ID":"20240903093442-8un6xlv","Type":"NodeParagraph","Properties":{"id":"20240903093442-8un6xlv","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑥《广西中药志》：\"治疳匿。外用（油亦可）治皮肤瘤。\""}]},{"ID":"20240903093442-iuxg3gf","Type":"NodeParagraph","Properties":{"id":"20240903093442-iuxg3gf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：用龙眼肉或胶囊包裹，饭后吞服，每次5～20粒，1日3次。外用：捣敷。"}]},{"ID":"20240903093442-rqkizr9","Type":"NodeParagraph","Properties":{"id":"20240903093442-rqkizr9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240903093442-uzzyqob","Type":"NodeParagraph","Properties":{"id":"20240903093442-uzzyqob","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"脾胃虚弱，呕吐者忌服。"}]},{"ID":"20240903093442-7y8zgpm","Type":"NodeParagraph","Properties":{"id":"20240903093442-7y8zgpm","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"《广西中草药》：\"孕妇和小儿慎用。\""}]},{"ID":"20240903093442-lbb50eu","Type":"NodeParagraph","Properties":{"id":"20240903093442-lbb50eu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903093442-z4jqbju","Type":"NodeParagraph","Properties":{"id":"20240903093442-z4jqbju","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"①治里急后重：鸦胆去壳留肉，包龙眼肉，每岁一粒，白滚水下。（《吉云旅钞》）"}]},{"ID":"20240903093442-eqcru8d","Type":"NodeParagraph","Properties":{"id":"20240903093442-eqcru8d","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"②治热性亦痢，及二便因热下血：鸦胆子去皮，每服二十五粒，极多至五十粒，白糖水送下。此物囫囵吞服，去皮时仁有破者，去之勿服，服之恐作呕吐。（《医学衷中参西录》）"}]},{"ID":"20240903093442-dj7oqph","Type":"NodeParagraph","Properties":{"id":"20240903093442-dj7oqph","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"③治疟疾：鸦胆子果仁十粒，入桂圆肉内吞服，日三次，第三日后减半量，连眼五日。（《广西中草药》）"}]},{"ID":"20240903093442-47z0rxu","Type":"NodeParagraph","Properties":{"id":"20240903093442-47z0rxu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"④治早期血吸虫病：鸦胆子果仁十粒，日二次，连服四、五天。（《广西中草药》）"}]},{"ID":"20240903093442-mxhycsx","Type":"NodeParagraph","Properties":{"id":"20240903093442-mxhycsx","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑤治痔：鸦胆子七粒，包圆眼肉，吞下。（《纲目拾遗》）"}]},{"ID":"20240903093442-d8jjb8a","Type":"NodeParagraph","Properties":{"id":"20240903093442-d8jjb8a","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑥治疣：鸦胆子去皮，取白仁之成实者，杵为末，以烧酒和涂少许，小作疮即愈。（《医学衷中参西录》）"}]},{"ID":"20240903093442-2vgnijr","Type":"NodeParagraph","Properties":{"id":"20240903093442-2vgnijr","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑦治脚鸡眼；鸦胆子二十个，砸开取仁，用针尖戳住，放灯头以上少烤，烤至黄色，再放一小块胶布上，用刀将该药按成片，粘于患处（在粘前用开水将患处洗净，用刀将厚皮割去），每日换一次，二十天左右即痊愈。（《新中医药》8（12）：583，1957）"}]},{"ID":"20240903093442-a1wq8yy","Type":"NodeParagraph","Properties":{"id":"20240903093442-a1wq8yy","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"⑧治滴虫性阴道炎：鸦胆子二十个，去皮，水一茶杯半，用砂壶煎至半茶杯，倒入消毒碗内，用消过毒的大注射器将药注入阴道，每次注二十至四十毫升。轻者一次，重者二至三次。（《河北中医药集锦》）"}]},{"ID":"20240903093442-9yjoxch","Type":"NodeParagraph","Properties":{"id":"20240903093442-9yjoxch","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【各家论述】《医学衷中参西录》：\"鸦胆子，性善凉血止血，兼能化瘀生新。凡痢之偏于热者用之皆有捷效，而以治下鲜血之痢，泻血水之痢，则尤效。又善清胃腑之热，胃院有实热充塞，噤口不食者，服之即可进食。审斯，则鸦胆子不但善利下焦，即上焦有虚热者，用之亦妙，此所以治噤口痢而有捷效也。\""}]},{"ID":"20240903093442-j8noxjl","Type":"NodeParagraph","Properties":{"id":"20240903093442-j8noxjl","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903093442-caa03vb","Type":"NodeParagraph","Properties":{"id":"20240903093442-caa03vb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"①治疗阿米巴痢疾"}]},{"ID":"20240903093442-l3gr33q","Type":"NodeParagraph","Properties":{"id":"20240903093442-l3gr33q","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"据50例和65例的观察，近期治愈率分别为72％和94％。其中50例组的复发率为6％。治愈病例大都在2～7天内症状消失，大便镜检多数在3～5天转为阴性。从大便转阴时间的长短看，鸦胆子对滋养体作用似较包囊为佳。或认为鸦胆子对急、慢性病例均有效果。副作用有恶心、呕吐、头晕、腹痛，腹泻等，其中以腹泻较多见，但不影响治疗。用法：大多采取口服法与灌肠法并用，7～10天为一疗程。口服每日3次，成人每次用鸦胆子仁10～20粒，也有少至4粒的；小儿每岁1～2粒。装胶囊吞服。灌肠用鸦胆子仁15～20粒，打碎后浸于1％碳酸氢钠溶液200毫升中2小时，然后行保留灌肠每日1次，或隔日1次。与口服法同时进行，或在口服4天后再单独使用。"}]},{"ID":"20240903093442-pee4idg","Type":"NodeParagraph","Properties":{"id":"20240903093442-pee4idg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"②治疗疟疾"}]},{"ID":"20240903093442-2e9rsl2","Type":"NodeParagraph","Properties":{"id":"20240903093442-2e9rsl2","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"对间日疟、三日疟、恶性疟均有效果，多数病例服药后可控制发作。用法：成人每次用鸦胆子仁10粒装入胶囊吞服，每日3～4次，连服至第4、5天剂量减半，全治程为5天。小儿10岁以下每次6粒，14岁以下每次8粒。副作用较大，主要为消化道反应，如上腹部不适，饱胀，食欲减退，大便次数增加，少数病人发生呕吐。"}]},{"ID":"20240903093442-bhsvm1f","Type":"NodeParagraph","Properties":{"id":"20240903093442-bhsvm1f","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"③治疗滴虫性及阿米巴原虫性阴道炎"}]},{"ID":"20240903093442-x38gjc1","Type":"NodeParagraph","Properties":{"id":"20240903093442-x38gjc1","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"用鸦胆子仁20粒加水100毫升，煎成20毫升，以注射器套导尿管注入阴道内，每日1次。治疗6例滴虫性阴道炎，经2～3次用药即获痊愈，随访年余未见复发。另一报告用鸦胆子仁40粒打碎后加水400毫升，煎成40毫升，行阴道灌洗，每日1次，治疗1例阿米巴原虫性阴道炎，经7天后亦获痊愈。"}]},{"ID":"20240903093442-16qy2wx","Type":"NodeParagraph","Properties":{"id":"20240903093442-16qy2wx","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"④治疗赘瘤"}]},{"ID":"20240903093442-kpnehj4","Type":"NodeParagraph","Properties":{"id":"20240903093442-kpnehj4","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"用鸦胆子油涂搽患部，对于外耳道乳头状瘤、喉乳头状瘤，及寻常疣、扁平疣等均有治疗效果。外耳道乳头状瘤用鸦胆子油滴入，每日1～2次，3～7天即可脱落。单发性的喉乳头状瘤，可先将瘤体摘除，然后用鸦胆子曲在基底部擦拭；多发性的先将易摘除的瘤体摘除，再用鸦胆子油在瘤体表面涂拭。小儿直接喉镜下涂拭，成人在间接喉镜下涂拭，每周1～3次。一般施用5～6次后肿物即可消失，但最多有用至30次的。鸦胆子油对喉部无不良副作用，涂后局部无红肿或溃疡发现，乳头状瘤处形成瘢痕，对正常粘膜无破坏作用。经鸦胆子油治疗的病例未见复发。对于寻常疣、扁平疣等，可先用小刀将疣体表皮轻轻刮破（不宜刮得过深及损伤周围皮肤），将鸦胆子劈开直接在患部摩擦，或蘸少量鸦胆子油滴于疣上，每4～7天1次，10次为一疗程。涂油后5～6小时内切勿用水或毛巾洗擦，以免拭去药油或波及周围皮肤；面部用药须防止进入眼内；再次用药如遇皮损结有痂膜时，须先将痂膜轻轻刮除再涂药油。用上法治疗扁平疣47例，治愈39例，大多在5次以内治愈。多数病人用药后皮损及健康皮肤出现红肿、瘙痒及灼热感等炎症现象，但对治疗无效病例则此现象很少出现。炎症反应出现后，继续涂擦，原来发炎之处逐渐变为棕黑色，数日后痂膜脱落而疣即消失。用鸦胆子油较鸦胆子仁效果迅速，但局部发炎也较剧烈。也可将鸦胆子捣成细末，加水调成糊状，涂于疣上，每日早晚各1次，涂至结痂为止。一般2周左右即可结痂而愈。鸦胆子油对于软而作线状之乳头状瘤较寻常疣、扁平疣作用迅速，其治疗作用可能是由于它的毒性作用使细胞发生退行性变，细胞核固缩，最后坏死而脱落。"}]},{"ID":"20240903093442-qdge3ad","Type":"NodeParagraph","Properties":{"id":"20240903093442-qdge3ad","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"用鸦胆子仁内服，对于肛门裂和内痔等引起的出血，血吸虫病合并乙状结肠肉芽肿，均有一定的治疗效果。此外，鸦胆子外敷曾引致过敏1例。患者于右足中趾上皮角化处敷药后20分钟突发呼吸困难，旋即进入半昏迷状态，经抢救后始恢复。恢复后以鸦胆子仁浸液作皮肤划痕试验，结果涂药后20秒钟局部发生红润，1分钟时出现直径1.2厘米大的丘疹，并觉呼吸有紧迫感，持续12小时之久；同时以健康人用同法作对照，结果阴性。在此以前患者曾两次用鸦胆子仁外敷，亦均在用药后1～2小时左右发生不同程度的过敏症状，如荨麻疹、呼吸迫促、恶心呕吐等。"}]},{"ID":"20240903093442-osx0ezb","Type":"NodeParagraph","Properties":{"id":"20240903093442-osx0ezb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903093442-te0savp","Type":"NodeParagraph","Properties":{"id":"20240903093442-te0savp","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子《中华本草》"}]},{"ID":"20240903093442-sb9m84g","Type":"NodeParagraph","Properties":{"id":"20240903093442-sb9m84g","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903093442-yl0bsva","Type":"NodeParagraph","Properties":{"id":"20240903093442-yl0bsva","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目拾遗》：鸦胆子，出闽、广，药肆中皆有之。形如梧子，其仁多油，生食令人吐，作霜，捶去油，入药佳。"}]},{"ID":"20240903093442-vjn3en4","Type":"NodeParagraph","Properties":{"id":"20240903093442-vjn3en4","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.《岭南采药录》：鸦胆子，治牛患疔毒，捣汁饲之。"}]},{"ID":"20240903093442-pc2a2bq","Type":"NodeParagraph","Properties":{"id":"20240903093442-pc2a2bq","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"3.《南方主要有毒植物》：鸦胆子，有毒部位：果壳和种子。中毒症状：成年人吃12粒有中毒危险。症状是恶心，呕吐，腹痛，腹泻，头昏，全身无力，呼吸慢或困难，昏睡，最后四肢麻痹。解救方法：洗胃；内服蛋清或牛奶及活性炭；内服或注射维生"}]},{"ID":"20240903093442-uuconnb","Type":"NodeParagraph","Properties":{"id":"20240903093442-uuconnb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【拼音名】YāDǎnZi"}]},{"ID":"20240903093442-2i3g6vs","Type":"NodeParagraph","Properties":{"id":"20240903093442-2i3g6vs","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【英文名】JavaBruceaFruit,FruitofJavaBrucea"}]},{"ID":"20240903093442-vixf52g","Type":"NodeParagraph","Properties":{"id":"20240903093442-vixf52g","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【别名】老鸦胆、鸦胆、苦榛子、苦参子、鸦蛋子、鸭蛋子、鸭胆子、解苦楝、小苦楝。"}]},{"ID":"20240903093442-v11z01w","Type":"NodeParagraph","Properties":{"id":"20240903093442-v11z01w","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903093442-yeh01rs","Type":"NodeParagraph","Properties":{"id":"20240903093442-yeh01rs","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"药材基源：为苦木科植物鸦胆子的果实。"}]},{"ID":"20240903093442-fiotva5","Type":"NodeParagraph","Properties":{"id":"20240903093442-fiotva5","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Bruceajavanica(L.)Merr.[RhusjavanicaL.]"}]},{"ID":"20240903093442-ezcu0il","Type":"NodeParagraph","Properties":{"id":"20240903093442-ezcu0il","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬果实成熟，待果皮变黑色时，分批采收，扬净，晒干。"}]},{"ID":"20240903093442-xsusqy9","Type":"NodeParagraph","Properties":{"id":"20240903093442-xsusqy9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【原形态】鸦胆子常绿灌木或小乔木，高1.5-3(-8)m，金株均被黄黄色柔毛。小枝具有黄白色皮孔。奇数羽状复叶互生，长20-40cm；小叶5-11，通常7，对生，卵状披针形，长4-11cm，宽2-4.5cm，先端渐尖，基部宽楔形，偏斜，边缘具三角形粗锯齿，上面疏被、下面密彼伏柔毛，脉上尤密。聚伞状圆锥花序腋生，狭长，可达50cm；雄花序长过于叶，萼片4，卵形，长不及1mm，外面流被淡黄色硬伏毛，边缘疏生腺体，花瓣4，长圆状披针形，外面有硬毛，边缘有腺体，雄蕊4，花盘发达，半球形；雌花序短于叶，萼片、花瓣同雄花，但稍大，雄蕊具不发育的花药，花盘杯状，4浅裂，心皮通常4，卵圆形，无毛，花柱反折，紧贴子房。核果椭圆形，紫红色转黑色，长约8mm，宽5-6mm，干时具凸起的网状皱纹，略偏斜。花期4-6月，果期8-10月。"}]},{"ID":"20240903093442-xu58dzo","Type":"NodeParagraph","Properties":{"id":"20240903093442-xu58dzo","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903093442-j6ytpgd","Type":"NodeParagraph","Properties":{"id":"20240903093442-j6ytpgd","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔950-1000m的石灰山疏林中。"}]},{"ID":"20240903093442-tkzrny3","Type":"NodeParagraph","Properties":{"id":"20240903093442-tkzrny3","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、台湾、广东、海南、广西贵州、云南等地。"}]},{"ID":"20240903093442-ypk7k73","Type":"NodeParagraph","Properties":{"id":"20240903093442-ypk7k73","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240903093442-qqe9kzf","Type":"NodeParagraph","Properties":{"id":"20240903093442-qqe9kzf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，不耐寒，耐干旱、瘠薄。以选向阳、疏松肥沃、富含腐殖质的砂质壤上栽培为宜。幼树可与蔬菜、黄豆、花生、甘薯等作物间作，亦可与槟榔间作，作槟榔幼树的遮荫树。"}]},{"ID":"20240903093442-gg2ifqu","Type":"NodeParagraph","Properties":{"id":"20240903093442-gg2ifqu","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖为主。育苗移栽法：8-9月采收黑色成熟果实，洗去果肉，阴干后及时播种，或用湿沙贮藏，于9-10月播种，行距20-30cm开沟，将种子均匀播人沟内，覆土、盖草、浇水，经常保持湿润，出苗后揭去盖草。平均温度26-29℃左右，约至15d左右出苗。苗高30cm时定植，按行株距1m×1.5开穴，穴径25-30cm，穴深25-30cm，每穴栽2-3株，填上压实，浇足水。"}]},{"ID":"20240903093442-w0n6vns","Type":"NodeParagraph","Properties":{"id":"20240903093442-w0n6vns","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"田间管理栽种1-2年，每年中耕除草2次，追肥2次。"}]},{"ID":"20240903093442-jtc0gg7","Type":"NodeParagraph","Properties":{"id":"20240903093442-jtc0gg7","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"春、夏季施氮肥，秋季施堆肥、过磷酸钙等。幼苗成活后，每穴留雌株1株，田块内适当留雄株，以供授粉用，需要适当摘心，促进分枝，早春或冬季进行修剪。"}]},{"ID":"20240903093442-w1s7ppr","Type":"NodeParagraph","Properties":{"id":"20240903093442-w1s7ppr","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903093442-t9zzxoo","Type":"NodeParagraph","Properties":{"id":"20240903093442-t9zzxoo","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"性状鉴别核果卵形或椭圆形，略扁，长0.6-1cm，直径4-7mm，表面黑色，有隆起网状皱纹，顶端有鸟嘴状短尖的花柱残基，腹背两侧有较明显的棱线，基部钝圆，有凹点状果柄痕，果肉易剥落；果核坚硬，破开后内面灰棕色平滑，内含种子1颗。种子卵形，长4-7mm，直径3-5mm，表面乳白色或黄白色，有稍隆起的网纹，顶端短尖呈鸟嘴状，其下有长圆形种脐，近基部有棕色圆形合点，种脐与合点间有稍隆起的种脊；种皮薄，胚乳和胚富油性。气微特异，味极苦。以粒大、饱满、种仁白色、油性足者为佳。"}]},{"ID":"20240903093442-bpga2dg","Type":"NodeParagraph","Properties":{"id":"20240903093442-bpga2dg","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"显微鉴别果实横切面：外果皮最外1列表皮细胞较小，有气孔；其内为2-3列类方形薄壁细胞，内含红棕色物。中果皮为6-20余列类圆形薄壁细胞，中部有维管束环列，薄壁细胞含草酸钙簇晶，直径12-50μm。内果皮由2条石细胞环带及1条厚壁细胞环带构成，向外形成多个角状突起；外侧环带为-5列大形石细胞，类圆形或方圆形，直径25-75μm，壁较厚，木化，壁孔和孔沟明显；中部环带为1-6列厚壁细胞，壁稍木化，通常壁孔及孔沟不明显，胞腔内含棕黄色物，近内侧的胞腔内有草酸钙方晶，直径8-20（-30）μm；内侧环带最宽，为多列纵横交织的石细胞团，细胞界限多不明显，壁甚厚，有孔沟，木化较强。种皮表皮细胞1列；其内为1至数列营养层薄壁细胞；再内为狭窄的粘液层；胚乳及子叶薄壁细胞充满糊粉粒和脂肪油。"}]},{"ID":"20240903093442-4o5xyij","Type":"NodeParagraph","Properties":{"id":"20240903093442-4o5xyij","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【化学成份】鸦胆子含30余种结构上类似苦木素（quassin）的具抗癌活性的苦味成分：鸦胆子苦素（bruceine）A、B、C、D、E、F、G、H、I，鸦胆子苦醇（brusatol），去氢鸦胆子苦醇（dehydrobrusatol），去氢鸦胆亭醇（dehydrobruceantinol），去氢鸦胆子苦素（dehydrobruceine）A、B，二氢鸦胆子苦素（dihydrobruceine），鸦胆亭（bruceantin），鸦胆亭醇（bruceantinol），鸦胆子酮酸（bruceaketolicacid），鸦胆子苦素E-2-葡萄糖甙（bru-ceineE-2-β-D-glucopyranoside，yadanzigan），鸦胆子苦烯（bruceene），鸦胆子苦内酯（yadanziolide）A、B、C、D，鸦胆子甙（yadanzioside）A、B、C、D、E、F、G、H、I、J、K、L、M、N、O、p，鸦胆子苦甙（bruceoside）A、B，鸦胆子双内酯（javanicin）等。还含黄花菜木脂素A（cleomiseosinA），4-乙氧甲酸基喹诺-2-酮（4-ethoxycarbonyl-2-quinolone），香草酸（vanillicacid），金丝桃成（hyperin），木犀草素-7-O-β-D-葡萄糖甙（luteolin7-O-β-D-glu-coside），胡萝卜甙（daucosterol）。又含油（鸦胆子油），内有具抑癌活性的油酸（oleicacid）和非活性成分：三油酸甘油酯（TCMLIBiolein）等。"}]},{"ID":"20240903093442-cs7d359","Type":"NodeParagraph","Properties":{"id":"20240903093442-cs7d359","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903093442-2gmb100","Type":"NodeParagraph","Properties":{"id":"20240903093442-2gmb100","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.抗寄生虫作用：1.1．鸦胆子的抗变形虫活性和细胞毒作用：体外测定了鸦胆子丁醇粗提物和鸦胆丁、鸦胆子苦素C对痢疾变形虫（Entamoebahistolitica）的活性以及对豚鼠耳角质化细胞（GPK）的细胞毒作用。"}]},{"ID":"20240903093442-f9nallj","Type":"NodeParagraph","Properties":{"id":"20240903093442-f9nallj","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.2．去油鸦胆子水浸液和乙醚浸膏加入阿米巴感染粪便，均能杀灭阿米巴。鸦胆子甙（Yadanoside）在阿米巴培养基中杀阿米巴的效力相当于吐根素的1/5-1/10。"}]},{"ID":"20240903093442-hk8wvdy","Type":"NodeParagraph","Properties":{"id":"20240903093442-hk8wvdy","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.3．抗疟作用：1.3.1.鸦胆子粗提物及有效成分对恶性疟原虫耐药株的体外抗疟作用：采用形态学方法测定鸦胆子四种溶剂粗提物对恶性疟原虫的体外抗疟活性，结果显示氯仿提取物的活性最强。从鸦胆子氯仿提取物中分离纯化得到3个化合物：鸦胆子苦素A、鸦胆子苦素B水合物和鸦胆子苦素C。测定了这3个化学成分对自然分离的恶性疟原虫株的体外抗疟活性，结果鸦胆子苦素A和鸦胆子苦素B水合物的抗疟活性相似（ID50为8.66和8.15ng/ml），而鸦胆子苦素C的抗疟活性较高（ID50为1.95ng/ml），与新抗疟药甲氟喹（ID50为6.26ng/ml）相比有显着差异（P\u003c0.041）。"}]},{"ID":"20240903093442-sftup2v","Type":"NodeParagraph","Properties":{"id":"20240903093442-sftup2v","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.3.2.鸦胆子苦木素类成分对恶性疟原虫抗氯喹株的作用：测定了一系列鸦胆子苦木素类成分在体外对耐氯喹恶性疟原虫株的活性，其中9个成分IC50\u003c0.05μg/ml，两个苦木素类糖甙：YadanziosideF和I和体外抗疟活性大大地小于其配糖基鸦胆子苦素B。又测定了鸦胆子不同溶剂粗提物和某些苦木素类成分对小鼠感染疟原虫的寄生虫血症的抑制作用。结果表明，小鼠口服给药后，氯仿和正丁醇提取物有较高的活性和毒性，鸦胆子苦素A、C、D和鸦胆子苦醇小鼠口服后对疟原虫感染有抗疟活性，但上述4个苦木素类成分和鸦胆子苦素B在小鼠在体试验中均显示一定毒性。"}]},{"ID":"20240903093442-4goc3jv","Type":"NodeParagraph","Properties":{"id":"20240903093442-4goc3jv","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.3.3.测定Buceoside-A和鸦胆子苦醇及Bruceolide对恶性疟原虫耐氯喹株的体外抗疟活性结果显示鸦胆子苦醇有较高的抗疟活性（半数有效量＝7.58ng/ml），BruceosideA没有活性（半数有效量＝581.14ng/ml），Bruceoliole活性极小（半数有效量＝75.20ng/ml）。"}]},{"ID":"20240903093442-jeasokc","Type":"NodeParagraph","Properties":{"id":"20240903093442-jeasokc","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.3.4.抗其它寄生虫作用：鸦胆子粗提物能驱除犬肠道线虫和条虫。对钩虫有极强的驱杀作用。从鸦胆子仁提得的一种苦味配糖体，在体外1：10000浓度时，能在24小时内杀死肺吸虫成虫。对滴虫、草履虫和尿路原虫都有杀灭作用。5-10%冷浸液与蚊幼虫和卵接触18-48小时，可全部杀死之。"}]},{"ID":"20240903093442-4bl03p0","Type":"NodeParagraph","Properties":{"id":"20240903093442-4bl03p0","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.抗肿瘤作用：2.1．10%鸦胆子油静脉乳抗肿瘤作用：2.1.1.小鼠体内抗癌作用：2.1.1.1.对艾氏腹水癌的作用：小鼠体重20±0.5g，每组10只，接种艾氏腹水癌后次日给药。两个给药组分别腹腔注射鸦胆子静脉乳2.5g/（kg.天）×7天、5.0g/（kg．天）×7天，并设对照组，停药后观察动物45天内生存天数，计算生命延长率。结果表明，两个剂量给药组平均生存天数均显着长于对照组（P均\u003c0.001）。"}]},{"ID":"20240903093442-1490fma","Type":"NodeParagraph","Properties":{"id":"20240903093442-1490fma","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.1.1.2.对实体瘤S37、S180的作用：小白鼠体重20±0.5g，右前肢腋部皮下接种癌细胞悬液，每组10只，接种次日起每天于肿瘤局部给药2.5g/（kg.天）×7天，给药后15天处死动物，记录体重，肿瘤重量，计算肿瘤抑制率。结果表明鸦胆子油静脉乳对小鼠实体瘤S37、S180均有一走的抗癌作用。"}]},{"ID":"20240903093442-fxp4dyh","Type":"NodeParagraph","Properties":{"id":"20240903093442-fxp4dyh","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.1.2.体外抗癌作用：用1.25%的鸦胆子静脉乳与艾氏腹水癌细胞体外培养1、3小时，伊红染色法的赤染率都为100%。形态法实验结果鸦胆子静脉乳对癌细胞的损伤为膜变性、膜破裂和核固缩等，表明鸦胆子油静脉乳对艾氏腹水癌细胞肝癌腹水型癌细胞有直接损害作用。经小鼠精原细胞法证明鸦胆子油静脉乳尚有抑制小鼠精原细胞有丝分裂的作用。"}]},{"ID":"20240903093442-24mabi4","Type":"NodeParagraph","Properties":{"id":"20240903093442-24mabi4","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.2．鸦胆子油乳剂对艾氏腹水癌细胞的杀伤动力学效应：采用放射自显影方法观察中10%鸦胆子油乳剂对接种7天的艾氏腹水癌小鼠S期、G2期和Go期细胞的影响。S期杀伤结果表明，给药后8小时，S期及非S期细胞损伤均呈高峰，但S期细胞的损伤百分率较非S期高。标记指数（LI）在2小时后明显下降，24小时时LI下降为5.2%，表明给药时处于S期的细胞大部分被药物破坏。经3H一TdR标记后，再用秋水仙酰胺阻断的实验表明，给药组标记分裂指数（PLM）上升幅度与对照组比较明显下降。由于药物处理时几乎未见损伤的M期细胞，并可见有丝分裂各期的细胞，所以经药物处理后MI无明显上升并非药物直接损伤M期细胞所致，说明鸦胆子油乳剂可以抑制或损伤G2期细胞，从而减少及延长G2期细胞进入M期。用连续标记方法确定Go期细胞为47.8%，给药后5小时，Go期细胞损伤率为17%，说明鸦胆子油乳剂对Go期细胞亦有一定杀伤作用。经放射自显影证实，鸦胆子油乳剂对3H一TdR参入DNA生物合成有明显的抑制作用，给药后0.5小时,LI为11%，24小时LI为33%，表明药物对艾氏腹水癌细胞呈可逆性抑制。"}]},{"ID":"20240903093442-ezjgzx9","Type":"NodeParagraph","Properties":{"id":"20240903093442-ezjgzx9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"3．抗白血病作用：鸦胆子含苦木素类糖甙BrnceosideA、B、YadanziosidesA-H、YadanziosidesF、I、J、L、P显示有抗白血病活性。鸦胆子苦醇对P－388白血病显示有效的抗白血病作用（小鼠腹腔注射0.125mg/kg/天，T/C=158），CleomiscosinA在体外对P-388淋巴性白血病有活性（半数有效量＝0.4μg/ml）。"}]},{"ID":"20240903093442-x0viimd","Type":"NodeParagraph","Properties":{"id":"20240903093442-x0viimd","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"4．抗其它肿瘤作用：甲基胆蒽醋酮诱发的小鼠皮肤癌和乳头状瘤进行试验，证明鸦胆子仁糊剂和水剂局部应用，能使瘤细胞发生退行性变和坏死。但对正常组织亦有类似作用。鸦胆子苦醇在0.5mg/kg时，对小鼠S180瘤株有边缘活性。"}]},{"ID":"20240903093442-cq421c2","Type":"NodeParagraph","Properties":{"id":"20240903093442-cq421c2","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240903093442-lwx804m","Type":"NodeParagraph","Properties":{"id":"20240903093442-lwx804m","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子挥发油有刺激性。其有毒成分为溶于水、具苦味的部分。鸦胆子仁或有效成分的大剂量，使动物内脏血管显着扩张，甚至出血；对中枢神经系统呈普遍的抑制现象；白细胞增多，多核细胞比率增加。治疗量在临床上常遇到的症状是恶心、呕吐，有时发生血压降低。去油鸦胆子对猫灌胃的最小致死量为0.1g/kg。鸦胆子中酚性成分的毒性最强，甙甲、甙乙次之，它们对小鼠皮下注射之半数致死量分别为：0.65、10、74mg/kg。死亡前呈全身抑制及四肢麻痹。"}]},{"ID":"20240903093442-lnm461o","Type":"NodeParagraph","Properties":{"id":"20240903093442-lnm461o","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"毒性：鸦胆子甙给小鼠玻下注射的半数致死量为7-10mg/kg，猫及狗为0.5-1mg/kg，达此剂量可使动物的白细胞增多，心跳加快，呼吸减慢，肠胃等内脏充血，昏迷、惊厥，最后因呼吸衰竭致死；所含酚性化合物毒性最大，小鼠皮下注射的半数致死量为0.65mg/kg。鸦胆子仁的毒性强于鸦胆子油及壳，口服可致呕吐、腹痛、腹泻及尿闭，猫灌胃的最小致死量约为0.1g/kg。鸦胆子静脉乳静脉注射对小鼠的半数致死量为6250mg/kg。"}]},{"ID":"20240903093442-dq7iwqi","Type":"NodeParagraph","Properties":{"id":"20240903093442-dq7iwqi","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子煎剂对雏鸡肌肉注射的半数致死量为0.25g/kg，口服为0.4g/kg。鸦胆子粗提物注射给药时，除恶心、呕吐、腹泻、便血等消化道症状外，还呈现呼吸促迫、体温下降、肌肉无力、昏迷和死亡。"}]},{"ID":"20240903093442-pfkjhlf","Type":"NodeParagraph","Properties":{"id":"20240903093442-pfkjhlf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"鸦胆子油静脉乳毒性小鼠50只（体重20-21g，雌雄兼用），尾静脉注射l0%鸦胆子油静脉乳，采用机率单位法测得半数致死量为6250mg/kg。亚急性毒性实验表明家兔给予鸦胆子油静脉乳10g/kg，其体重、肝功能、肾功能、血象均无明显变化。"}]},{"ID":"20240903093442-okpgk48","Type":"NodeParagraph","Properties":{"id":"20240903093442-okpgk48","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取样品粉末0.5g，用乙醇20ml回流提取10min，滤过。滤液数滴置瓷蒸发皿中，于水浴上蒸干，残渣滴加浓硫酸3-5滴，溶液由黄色变为紫红色。（检查苦味素）（2）薄层色谱脱脂样品粉末4g，于水浴上用水提取2次，合并水提取液并浓缩至10ml，用氯仿萃取2次（10ml，5ml），合并氯仿液，浓缩至1ml供点样用。以鸦胆子苦醇为对照品，点样于同一硅胶-G板上，用氯仿-甲醇（9:1）展开，干后喷5％三氯化铁乙醇液显色，供试品色谱在与对照品色谱的相应位置上，显相同的蓝紫色斑点。"}]},{"ID":"20240903093442-uqq7p76","Type":"NodeParagraph","Properties":{"id":"20240903093442-uqq7p76","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【炮制】簸净杂质，洗净，晒干，剥去外壳，取整仁。"}]},{"ID":"20240903093442-xcyr4a1","Type":"NodeParagraph","Properties":{"id":"20240903093442-xcyr4a1","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；性寒；小毒"}]},{"ID":"20240903093442-9n9ttvy","Type":"NodeParagraph","Properties":{"id":"20240903093442-9n9ttvy","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【归经】大肠；肝经"}]},{"ID":"20240903093442-103vhon","Type":"NodeParagraph","Properties":{"id":"20240903093442-103vhon","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热；解毒；杀虫；截疟；。主热毒血痢；冷痢；休息痢；疟疾；痔疮；痈肿；阴痒；白带；瘊疣；鸡眼"}]},{"ID":"20240903093442-w1ate9s","Type":"NodeParagraph","Properties":{"id":"20240903093442-w1ate9s","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：多去壳取仁，用胶囊或龙眼肉包裹吞服，治疟疾第次10-15粒，治痢疾第次10-30粒。外用：适量，捣敷；或制成鸦胆子油局部涂敷；或煎水洗。"}]},{"ID":"20240903093442-a09zpz3","Type":"NodeParagraph","Properties":{"id":"20240903093442-a09zpz3","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚弱，呕吐者忌服。《广西中草药》：孕妇和小儿慎用。"}]},{"ID":"20240903093442-mfg6fiz","Type":"NodeParagraph","Properties":{"id":"20240903093442-mfg6fiz","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【附方】①治里急后重：鸦胆去壳留肉，包龙眼肉，每岁一粒，白滚水下。(《吉云旅钞》)②治热性赤痢，及二便因热下血：鸦胆子去皮，每服二十五粒，极多至五十粒，白糖水送下。此物囫囵吞服，去皮时仁有破者，去之勿服，服之恐作呕吐。(《医学衷中参西录》)③治疟疾：鸦胆子果仁十粒，入桂圆肉内吞服，日三次，第三日后减半量，连服五日。(《广西中草药》)④治早期血吸虫病：鸦胆子果仁十粒，日二次，连服四、五天。(《广西中草药》)⑤治痔：鸦胆子七粒，包圆眼肉，吞下。(《纲目拾遗》)⑥治疣：鸦胆子去皮，取白仁之成实者，杵为末，以烧酒和涂少许，小作疮即愈。(《医学衷中参西录》)⑦治滴虫性阴道炎：鸦胆子二十个，去皮，水一茶杯半，用砂壶煎至半茶杯，倒入消毒碗内，用消过毒的大注射器将药注入阴道，每次注二十至四十毫升。轻者一次，重者二至三次。(《河北中医药集锦》)"}]},{"ID":"20240903093442-tdysoxj","Type":"NodeParagraph","Properties":{"id":"20240903093442-tdysoxj","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903093442-0s1vxuf","Type":"NodeParagraph","Properties":{"id":"20240903093442-0s1vxuf","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.《医学衷中参西录》：鸦胆子，性善凉血止血，兼能化瘀生新。凡痢之偏于热者用之皆有捷效，而以治下鲜血之痢，泻血水之痢，则尤效。又善清胃腑之热，胃脘有实热充塞，噤口不食者，服之即可进食。审斯，则鸦胆子不但善利下焦，即上焦有虚热者，用之亦妙，此所以治噤口痢而有捷效也。"}]},{"ID":"20240903093442-azpyo0t","Type":"NodeParagraph","Properties":{"id":"20240903093442-azpyo0t","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.《生草药性备要》：凉血，去脾家疮，理跌打。"}]},{"ID":"20240903093442-axko949","Type":"NodeParagraph","Properties":{"id":"20240903093442-axko949","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"3.《纲目拾遣》：治痢，痔。"}]},{"ID":"20240903093442-4cdtqck","Type":"NodeParagraph","Properties":{"id":"20240903093442-4cdtqck","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"4.《岭南采药录》：治冷痢，久泻。又能杀虫。"}]},{"ID":"20240903093442-4z5n1x5","Type":"NodeParagraph","Properties":{"id":"20240903093442-4z5n1x5","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"5.《医学衷中参西录》：凉血解毒，善治热性赤痢，二便因热下血。治梅毒及花柳毒淋。捣烂醋调敷疔毒。善治疣。"}]},{"ID":"20240903093442-4yf518j","Type":"NodeParagraph","Properties":{"id":"20240903093442-4yf518j","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"6.《科学的民间药草》：截疟和治阿米巴痢疾。制成油质，可治外耳道乳状瘤，乳头瘤，以及尖锐性湿疣。"}]},{"ID":"20240903093442-tg4ve3u","Type":"NodeParagraph","Properties":{"id":"20240903093442-tg4ve3u","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"7.《广西中药志》：治疳NI。外用(油亦可)治皮肤瘤。"}]},{"ID":"20240903093442-84fl3ld","Type":"NodeParagraph","Properties":{"id":"20240903093442-84fl3ld","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903093442-63t9mnb","Type":"NodeParagraph","Properties":{"id":"20240903093442-63t9mnb","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"1.治疗阿米巴痢疾：据50例和65例的观察，近期治愈率分别为72%和94%。其中50例组的复发率为6%。治愈病例大都在2-7天内症状消失，大便镜检多数在3-5天转为阴性。从大便转阴时间的长短看，鸦胆子对滋养体作用似较包囊为佳。或认为鸦胆子对急、慢性病例均有效果。副作用有恶心、呕吐、头晕、腹痛、腹泻等，其中以腹泻较多见，但不影响治疗。用法：大多采取口服法与灌肠法并用，7-10天为一疗程。口服每日3次，成人每次用鸦胆子仁10-20粒，也有少至4粒的；小儿每岁l-2粒。装胶囊吞服。灌肠用鸦胆子仁15-20粒，打碎后浸于1%碳酸氢钠溶液200ml中2小时，然后行保留灌肠每日1次，或隔日1次。与口服法同时进行，或在口服4天后再单独使用。"}]},{"ID":"20240903093442-n53bjx9","Type":"NodeParagraph","Properties":{"id":"20240903093442-n53bjx9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"2.治疗疟疾：对间日疟、三日疟、恶性疟均有效果，多数病例服药后可控制发作。用法：成人每次用鸦胆子仁10粒装入胶囊吞服，每日3-4次，连服至第4、5天剂量减半，全治程为5天。小儿10岁以下每次6粒，14岁以下每次8粒。副作用较大，主要为消化道反应，如上腹部不适，饱胀，食欲减退，大便次数增加，少数病人发生呕吐。"}]},{"ID":"20240903093442-ev9hnad","Type":"NodeParagraph","Properties":{"id":"20240903093442-ev9hnad","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"3.治疗滴虫性及阿米巴原虫性阴道炎：用鸦胆子仁20粒加水100ml，煎成20ml，以注射器套导尿管注入阴道内，每日1次。治疗6例滴虫性阴道炎，经2-3次用药即获痊愈，随访年余未见复发。另一报告用鸦胆子仁40粒打碎后加水400ml，煎成40ml，行阴道灌洗，每日1次，治疗l例阿米巴原虫性阴道炎，经7天后亦获痊愈。"}]},{"ID":"20240903093442-vxufxi9","Type":"NodeParagraph","Properties":{"id":"20240903093442-vxufxi9","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"4.治疗赘瘤：用鸦胆子油涂搽患部，对于外耳道乳头状瘤、喉乳头状瘤，及寻常疣、扁平疣等均有治疗效果。外耳道乳头状瘤用鸦胆子油滴入，每日l-2次，3-7天即可脱落。单发性的喉乳头状瘤，可先将瘤体摘除，然后用鸦胆子油在基底部擦拭；多发性的先将易摘除的瘤体摘除，再用鸦胆子油在瘤体表面涂拭。小儿在直接喉镜下涂拭，成人在间接喉镜下涂拭，每周l-3次。一般施用5-6次后肿物即可消失，但最多有用至30次的。鸦胆子油对喉部无不良副作用，涂后局部无红肿或溃疡发现，乳头状瘤处形成瘢痕，对正常粘膜无破坏作用。经鸦胆子油治疗的病例未见复发。对于寻常疣、扁平疣等，可先用小刀将疣体表皮轻轻刮破(不宜刮得过深及损伤周围皮肤)，将鸦胆子劈开直接在患部摩擦，或蘸少量鸦胆子油滴于疣上，每4-7天1次，10次为一疗程。涂油后5-6小时内切勿用水或毛巾洗擦，以免拭去药油或波及周围皮肤；面部用药须防止进入眼内；再次用药如遇皮损结有痂膜时，须先将痂膜轻轻刮除再涂药油。用上法治疗扁平疣47例，治愈39例，大多在5次以内治愈。多数病人用药后皮损及健康皮肤出现红肿、瘙痒及灼热感等炎症现象，但对治疗无效病例则此现象很少出现。炎症反应出现后，继续涂擦，原来发炎之处逐渐变为棕黑色，数日后痂膜脱落而疣即消失。用鸦胆子油较鸦胆子仁效果迅速，但局部发炎也较剧烈。也可将鸦胆子捣成细末，加水调成糊状，涂于疣上，每日早晚各1次，涂至结痂为止。一般2周左右即可结痂而愈。鸦胆子油对于软而作线状之乳头状瘤较寻常疣、扁平疣作用迅速，其治疗作用可能是由于它的毒性作用使细胞发生退行性变，细胞核固缩，最后坏死而脱落。"}]},{"ID":"20240903093442-2go85je","Type":"NodeParagraph","Properties":{"id":"20240903093442-2go85je","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"5.治脚鸡跟：鸦胆子二十个，砸开取仁，用针尖戳住，放灯头以上少烤，烤至黄色，再放一小块胶布上，用刀将该药按成片，粘于患处(在粘前用开水将患处洗净，用刀将厚皮割去)，每日换一次，二十天左右即痊愈。"}]},{"ID":"20240903093442-h5tqusi","Type":"NodeParagraph","Properties":{"id":"20240903093442-h5tqusi","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"6.用鸦胆子仁内服，对于肛门裂和内痔等引起的出血。血吸虫病合并乙状结肠肉芽肿，均有一定的治疗效果。此外，鸦胆子外敷曾引致过敏l例。患者于右足中趾上皮角化处敷药后20分钟突发呼吸困难，旋即进入半昏迷状态，经抢救后始恢复。恢复后以鸦胆子仁浸液作皮肤划痕试验，结果涂药后20秒钟局部发生红润，1分钟时出现直径1.2cm大的丘疹，并觉呼吸有紧迫感，持续12小时之久；同时以健康人用同法作对照，结果阴性。在此以前患者曾两次用鸦胆子仁外敷，亦均在用药后l-2小时左右发生不同程度的过敏症状，如荨麻疹、呼吸迫促、恶心呕吐等。"}]},{"ID":"20240903093442-xkdflru","Type":"NodeParagraph","Properties":{"id":"20240903093442-xkdflru","updated":"20240903093524"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903093443-bqu9416","Type":"NodeThematicBreak","Properties":{"id":"20240903093443-bqu9416","updated":"20240903093524"}},{"ID":"20240903093444-7zrheek","Type":"NodeParagraph","Properties":{"id":"20240903093444-7zrheek","updated":"20240903093524"}}]}