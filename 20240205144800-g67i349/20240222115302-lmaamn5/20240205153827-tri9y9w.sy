;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土茯苓 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土茯苓 11-20240710164250-9v8fsy6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 596px;\" parent-style=\"width: 606px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 646px;","style":"width: 636px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土茯苓 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土茯苓 15-20240710164712-gwxwwr6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 636px;\" parent-style=\"width: 646px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710165406-3yqltfx","Type":"NodeParagraph","Properties":{"id":"20240710165406-3yqltfx","updated":"20240731080658"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 803px;","style":"width: 793px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土茯苓 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土茯苓 17-20240710165406-c93divs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 793px;\" parent-style=\"width: 803px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 457px;","style":"width: 447px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土茯苓 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土茯苓 2-20240731080658-mohzsng.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 447px;\" parent-style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724190438-r74q61n","Type":"NodeParagraph","Properties":{"id":"20240724190438-r74q61n","updated":"20240730175334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：金刚藤跟土茯苓较为相似，区别方法为‘"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"有刺金刚藤，无刺土茯苓"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"’；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205172731-dsj3c87","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"菝葜（金刚藤、铁菱角）"}]},{"ID":"20240730174350-ukh9pqy","Type":"NodeParagraph","Properties":{"id":"20240730174350-ukh9pqy","updated":"20240731081200"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：土茯苓叶子狭长，藤茎光滑无刺且叶面光滑带有白色的斑点（大多数，也有例外），叶子背面白色；"}]},{"ID":"20240710165056-19utv9o","Type":"NodeThematicBreak","Properties":{"id":"20240710165056-19utv9o"}},{"ID":"20240830163047-8pucunx","Type":"NodeParagraph","Properties":{"id":"20240830163047-8pucunx","updated":"20240830163055"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：土茯苓"}]},{"ID":"20240830163047-l1r0kxs","Type":"NodeParagraph","Properties":{"id":"20240830163047-l1r0kxs","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"土茯苓《中国药典》"}]},{"ID":"20240830163047-6gkoyj0","Type":"NodeParagraph","Properties":{"id":"20240830163047-6gkoyj0","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔFúLínɡ"}]},{"ID":"20240830163047-j5a0qwt","Type":"NodeParagraph","Properties":{"id":"20240830163047-j5a0qwt","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMASMILACISGLABRAE"}]},{"ID":"20240830163047-hdil2lf","Type":"NodeParagraph","Properties":{"id":"20240830163047-hdil2lf","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【别名】冷饭团、红土苓、山猪粪、毛尾薯、山遗粮、山奇良"}]},{"ID":"20240830163047-kl8o5m7","Type":"NodeParagraph","Properties":{"id":"20240830163047-kl8o5m7","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【来源】本品为百合科植物光叶菝葜SmilaxglabraRoxb.的干燥根茎。夏、秋二季采挖，除去须根，洗净，干燥；或趁鲜切成薄片，干燥。"}]},{"ID":"20240830163047-r7ddn9r","Type":"NodeParagraph","Properties":{"id":"20240830163047-r7ddn9r","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生攀援灌木，茎无刺。根状茎横生于土中，细长，生多数须根，每隔一段间距生一肥厚的块状结节，质坚实，外皮坚硬，褐色，凹凸不平，内面肉质粉性，黄白色，密布淡红色小点。单叶互生，革质，长圆形至椭圆状披针形，表面绿色，下面有白粉。7～8月间开小白花，花单性，雌雄异株，为腋生伞形花序。浆果球形，熟时紫红色，外被白粉。"}]},{"ID":"20240830163047-qlhmxz9","Type":"NodeParagraph","Properties":{"id":"20240830163047-qlhmxz9","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性状】本品略呈圆柱形，稍扁或呈不规则条块，有结节状隆起，具短分枝，长5～22cm，直径2～5cm。表面黄棕色或灰褐色，凹凸不平，有坚硬的须根残基，分枝顶端有圆形芽痕，有的外皮现不规则裂纹，并有残留的鳞叶。质坚硬。切片呈长圆形或不规则，厚1～5mm，边缘不整齐；切面类白色至淡红棕色，粉性，可见点状维管束及多数小亮点；质略韧，折断时有粉尘飞扬，以水湿润后有黏滑感。无臭，味微甘、涩。"}]},{"ID":"20240830163047-iegjt03","Type":"NodeParagraph","Properties":{"id":"20240830163047-iegjt03","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末淡棕色。淀粉粒甚多，单粒类球形、多角形或类方形，直径8～48μｍ，脐点裂缝状、星状、三叉状或点状，大粒可见层纹；复粒由2～4分粒组成。草酸钙针晶束存在于黏液细胞中或散在，针晶长40～144μｍ，直径约5μｍ。石细胞类椭圆形、类方形或三角形，直径25～128μｍ，孔沟细密；另有深棕色石细胞，长条形，直径约50μｍ，壁三面极厚，一面菲薄。纤维成束或散在，直径22～67μｍ。具缘纹孔导管及管胞多见，具缘纹孔大多延长成梯状。"}]},{"ID":"20240830163047-pxtuw1g","Type":"NodeParagraph","Properties":{"id":"20240830163047-pxtuw1g","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质；未切片者，浸泡，洗净，润透，切薄片，干燥。"}]},{"ID":"20240830163047-4zhu4c6","Type":"NodeParagraph","Properties":{"id":"20240830163047-4zhu4c6","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性味】甘、淡，平。"}]},{"ID":"20240830163047-df9m3kb","Type":"NodeParagraph","Properties":{"id":"20240830163047-df9m3kb","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、胃经。"}]},{"ID":"20240830163047-820o32c","Type":"NodeParagraph","Properties":{"id":"20240830163047-820o32c","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【功能主治】除湿，解毒，通利关节。用于湿热淋浊，带下，痈肿，瘰疬，疥癣，梅毒及汞中毒所致的肢体拘挛，筋骨疼痛。"}]},{"ID":"20240830163047-rjdseyu","Type":"NodeParagraph","Properties":{"id":"20240830163047-rjdseyu","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【用法用量】15～60g。"}]},{"ID":"20240830163047-g2w48xm","Type":"NodeParagraph","Properties":{"id":"20240830163047-g2w48xm","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。"}]},{"ID":"20240830163047-4q1djy6","Type":"NodeParagraph","Properties":{"id":"20240830163047-4q1djy6","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用本品治梅毒，可配合金银花、白藓皮、威灵仙、甘草等同用。现临床上主要用于湿热疮毒，常与白藓皮、地肤子、苦参、苍朮等配伍同用。此外，本品近年来在临床上用治钩端螺旋体病，有一定疗效。"}]},{"ID":"20240830163047-6szv851","Type":"NodeParagraph","Properties":{"id":"20240830163047-6szv851","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830163047-olbc0d5","Type":"NodeParagraph","Properties":{"id":"20240830163047-olbc0d5","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"土茯苓《*辞典》"}]},{"ID":"20240830163047-b37fmp4","Type":"NodeParagraph","Properties":{"id":"20240830163047-b37fmp4","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【出处】《滇南本草》"}]},{"ID":"20240830163047-botwolc","Type":"NodeParagraph","Properties":{"id":"20240830163047-botwolc","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔFúLínɡ"}]},{"ID":"20240830163047-an8fn59","Type":"NodeParagraph","Properties":{"id":"20240830163047-an8fn59","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【别名】禹余粮，白余粮（陶弘景），革禹余粮（《本草拾遗》），刺猪苓（《本草图经》），过山龙、硬饭（《朱氏集验医方》），仙遗粮（《滇南本草》），土萆薢（《本草会编》），冷饭团（《卫生杂兴》），山猪粪、山地栗、过冈龙（《纲目，），山牛（《本经逢原》），冷饭头（《生草药性备要》），山归来（《有用植物图说》），久老薯（《广西中兽医药植》），毛尾薯（《中药材手册》），地胡苓、狗老薯、饭闭根，硬饭头薯（《广西中药志》），土苓（《四川中药志》），山遗粮（广州部队《常用中草药手册》），狗朗头、尖光头（《常用中草药彩色图"}]},{"ID":"20240830163047-osj1ylx","Type":"NodeParagraph","Properties":{"id":"20240830163047-osj1ylx","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【来源】为百合科植物土茯苓的根茎。秋末冬初采挖，除去芦头及须根，洗净泥沙，晒干，或切片晒干。"}]},{"ID":"20240830163047-8p45yy0","Type":"NodeParagraph","Properties":{"id":"20240830163047-8p45yy0","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【原形态】攀援状灌木。根茎块根状，有明显结节，着生多数须根。茎无刺。单叶互生；革质，披针形至椭圆状披针形，长6～20厘米，宽1．2～5厘米，先端渐尖，基部圆形，全缘，下面常被白粉，基出脉3～5条；叶柄长1～2厘米，略呈翅状，近基部具开展的叶鞘，叶鞘先端常变成2条卷须。花单性，雌雄异株；伞形花序腋生，花序梗极短；小花梗纤细，基部有多数宿存的三角形小苞片；花小，白色，直径约4毫米；花被裂片6，2轮；雄花的雄蕊6，花丝较花药短，退化雌蕊缺；雌花的退化雄蕊线形，子房上位，3室，柱头3歧，稍反曲。浆果球形，直径6～8毫米，红色。花期7～8月。果期9～10月。"}]},{"ID":"20240830163047-o2v1y6h","Type":"NodeParagraph","Properties":{"id":"20240830163047-o2v1y6h","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于山坡、荒山及林边的半阴地。分布安徽、江苏、浙江、福建、广东、广西、江西、湖南、湖北、四川、贵州等地。主产广东、湖南、湖北、浙江、四川、安徽等地，此外福建、江西、广西、江苏等地亦产。"}]},{"ID":"20240830163047-1jo806n","Type":"NodeParagraph","Properties":{"id":"20240830163047-1jo806n","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性状】土茯苓，又名：红土苓。干燥根茎为不规则块状，略呈扁圆柱形而弯曲不直，多分歧，有结节状隆起，长约5～15厘米，直径约2～5厘米。表面土棕色或棕色，粗糙，常有刀伤切口及侧根残余部分，上端具茎痕。质坚硬，不易折断，断面粗糙，有粉性，淡棕色。气微，味甘淡。土茯苓片为长形薄片，大小不等，厚约1～3毫米。边缘不整齐，淡棕色或淡黄色；表面光滑（薄片）或稍粗糙（厚片）。中间略具维管束点，仔细观察时可见砂砾样的光亮。纵切片常见花纹。导管不规则，富粉质，微有弹性，用水润湿后，手摸之有光滑感。以淡棕色、粉性足、纤维少者为佳。"}]},{"ID":"20240830163047-g24a7h6","Type":"NodeParagraph","Properties":{"id":"20240830163047-g24a7h6","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸漂，夏季每日换水1次，春、秋每2日换水1次，冬季可3日换水1次，防止发臭，以泡透为度，捞出切片，及时干燥。"}]},{"ID":"20240830163047-nyn6gkt","Type":"NodeParagraph","Properties":{"id":"20240830163047-nyn6gkt","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830163047-3hfd11p","Type":"NodeParagraph","Properties":{"id":"20240830163047-3hfd11p","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"甘淡，平。"}]},{"ID":"20240830163047-me2k9ue","Type":"NodeParagraph","Properties":{"id":"20240830163047-me2k9ue","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①《本草图经》：\"味甘，性凉，无毒。\""}]},{"ID":"20240830163047-ewzpash","Type":"NodeParagraph","Properties":{"id":"20240830163047-ewzpash","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性平，味苦微涩。\""}]},{"ID":"20240830163047-xmp1kat","Type":"NodeParagraph","Properties":{"id":"20240830163047-xmp1kat","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘淡，平，无毒。\""}]},{"ID":"20240830163047-se8ucba","Type":"NodeParagraph","Properties":{"id":"20240830163047-se8ucba","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830163047-zoi1y9v","Type":"NodeParagraph","Properties":{"id":"20240830163047-zoi1y9v","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"入肝、胃经。"}]},{"ID":"20240830163047-bzcqj8z","Type":"NodeParagraph","Properties":{"id":"20240830163047-bzcqj8z","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"为阳明本药。\""}]},{"ID":"20240830163047-4aji3ei","Type":"NodeParagraph","Properties":{"id":"20240830163047-4aji3ei","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"入胃、肝二经。\""}]},{"ID":"20240830163047-uqzvt9o","Type":"NodeParagraph","Properties":{"id":"20240830163047-uqzvt9o","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾二经。\""}]},{"ID":"20240830163047-jzoiiy1","Type":"NodeParagraph","Properties":{"id":"20240830163047-jzoiiy1","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830163047-yadt4rs","Type":"NodeParagraph","Properties":{"id":"20240830163047-yadt4rs","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"解毒，除湿，利关节。治梅毒，淋浊，筋骨挛痛，脚气，疔疮，痈肿，瘰疬。"}]},{"ID":"20240830163047-jmc1ri2","Type":"NodeParagraph","Properties":{"id":"20240830163047-jmc1ri2","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"调中止泄。\""}]},{"ID":"20240830163047-uptabny","Type":"NodeParagraph","Properties":{"id":"20240830163047-uptabny","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"敷疮毒。\""}]},{"ID":"20240830163047-bj7zcz1","Type":"NodeParagraph","Properties":{"id":"20240830163047-bj7zcz1","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"治五淋白浊，兼治杨梅疮毒、丹毒。\""}]},{"ID":"20240830163047-b54u5m0","Type":"NodeParagraph","Properties":{"id":"20240830163047-b54u5m0","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"健脾胃，强筋骨，去风湿，利关节，止泄泻。治拘挛骨痛，恶疮痈肿。解汞粉、银朱毒。\""}]},{"ID":"20240830163047-f025wrn","Type":"NodeParagraph","Properties":{"id":"20240830163047-f025wrn","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"疗痈肿、喉痹，除厨身寒湿、恶疮。\""}]},{"ID":"20240830163047-sjnq5if","Type":"NodeParagraph","Properties":{"id":"20240830163047-sjnq5if","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑥《生草药性备要》：\"消毒疮、疔疮，炙汁涂敷之，煲酒亦可。\""}]},{"ID":"20240830163047-yblahi1","Type":"NodeParagraph","Properties":{"id":"20240830163047-yblahi1","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑦《本草再新》：\"祛湿热，利筋骨。\""}]},{"ID":"20240830163047-wi51uab","Type":"NodeParagraph","Properties":{"id":"20240830163047-wi51uab","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑧《陆川本草》：\"治脚气。\""}]},{"ID":"20240830163047-5kqy64g","Type":"NodeParagraph","Properties":{"id":"20240830163047-5kqy64g","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑨广州部队《常用中草药手册》：\"治心胃气痛，肾炎。\""}]},{"ID":"20240830163047-cqtsynj","Type":"NodeParagraph","Properties":{"id":"20240830163047-cqtsynj","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑩《江西草药》；\"杀虫解毒。治瘰疬，小儿疳积。\""}]},{"ID":"20240830163047-jtwnlm2","Type":"NodeParagraph","Properties":{"id":"20240830163047-jtwnlm2","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑾《常用中草药彩色图谱》：\"治风湿性关节炎，腹痛，消化不良，膀胱炎。\""}]},{"ID":"20240830163047-wu4h3cc","Type":"NodeParagraph","Properties":{"id":"20240830163047-wu4h3cc","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，O．5～1两。外用：研末调敷。"}]},{"ID":"20240830163047-d8a92qs","Type":"NodeParagraph","Properties":{"id":"20240830163047-d8a92qs","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830163047-cz94zjy","Type":"NodeParagraph","Properties":{"id":"20240830163047-cz94zjy","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"肝肾阴亏者慎服。"}]},{"ID":"20240830163047-b1jhw37","Type":"NodeParagraph","Properties":{"id":"20240830163047-b1jhw37","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①《万氏家抄方》：\"不犯铁器。\""}]},{"ID":"20240830163047-9i3rn8x","Type":"NodeParagraph","Properties":{"id":"20240830163047-9i3rn8x","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"服时忌茶。\""}]},{"ID":"20240830163047-58pwmrd","Type":"NodeParagraph","Properties":{"id":"20240830163047-58pwmrd","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"肝肾阴亏者勿服。\""}]},{"ID":"20240830163047-vqspwwt","Type":"NodeParagraph","Properties":{"id":"20240830163047-vqspwwt","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830163047-q88sd54","Type":"NodeParagraph","Properties":{"id":"20240830163047-q88sd54","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①治杨梅疮毒：土茯苓一两或五钱，水酒浓煎服。（《滇南本草》）"}]},{"ID":"20240830163047-bzwqbq8","Type":"NodeParagraph","Properties":{"id":"20240830163047-bzwqbq8","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②治杨梅风十年二十年，筋骨风泡肿痛：土茯苓三斤，川椒二钱，甘草三钱，黑铅一斤，青藤三钱。将药用袋盛，以好酒煮服之妙。（《赤水玄珠》）"}]},{"ID":"20240830163047-u30zbis","Type":"NodeParagraph","Properties":{"id":"20240830163047-u30zbis","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③治血淋：土茯苓、茶根各五钱。水煎服，白糖为引。（《江西草药》）"}]},{"ID":"20240830163047-0k1pqor","Type":"NodeParagraph","Properties":{"id":"20240830163047-0k1pqor","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"④治风湿骨痛，疮疡肿毒：土茯苓一斤，去皮，和猪肉炖烂，分数次连滓服。（《浙江民间常用草药》）"}]},{"ID":"20240830163047-0xi8b5p","Type":"NodeParagraph","Properties":{"id":"20240830163047-0xi8b5p","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑤治风气痛及风毒疮癣：土茯苓（不犯铁器）八两。石臼内捣为细末，糯米一斗，蒸熟，白酒药造成醇酒用，酒与糟俱可食。（《万氏家抄方》土茯苓酒）"}]},{"ID":"20240830163047-btmpe45","Type":"NodeParagraph","Properties":{"id":"20240830163047-btmpe45","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑥治大毒疮红肿，未成即滥：土茯苓，为细末，好醋调敷。（《滇南本草》）"}]},{"ID":"20240830163047-5438hfn","Type":"NodeParagraph","Properties":{"id":"20240830163047-5438hfn","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑦治瘰疬溃烂：冷饭团，切片或为末，水煎服。或入粥内食之，须多食为妙。忌铁器、发物。（《积德堂经验方》）"}]},{"ID":"20240830163047-0vp2ser","Type":"NodeParagraph","Properties":{"id":"20240830163047-0vp2ser","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑧治皮炎：土茯苓二至三两。水煎，当茶饮。（《江西草药》）"}]},{"ID":"20240830163047-1j10yd4","Type":"NodeParagraph","Properties":{"id":"20240830163047-1j10yd4","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑨治妇人红崩、白带：土茯苓，水煨，引用红沙糖治红崩，白沙糖治白带。（《滇南本草》）"}]},{"ID":"20240830163047-zxd0we3","Type":"NodeParagraph","Properties":{"id":"20240830163047-zxd0we3","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑩治小儿疳积面黄肌瘦，肚子大，烦躁爱哭，啼哭无声，不想吃东西，大便失调，皮肤粗糙：土茯苓三钱，野棉花根三钱。研细末，加猪肝二两与水炖服，或米汤冲服。（《草医草药简便验方汇编》）"}]},{"ID":"20240830163047-um6iytj","Type":"NodeParagraph","Properties":{"id":"20240830163047-um6iytj","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"⑾治瘿瘤：土茯苓五钱，金锁银开、黄药子各三钱，白毛藤五钱，乌蔹莓根、蒲公英各四钱，甘草、金银花各二钱，煎服。（《浙江民间中药》）"}]},{"ID":"20240830163047-760lbjq","Type":"NodeParagraph","Properties":{"id":"20240830163047-760lbjq","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830163047-5b9rf5j","Type":"NodeParagraph","Properties":{"id":"20240830163047-5b9rf5j","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①防治钩端螺旋体病"}]},{"ID":"20240830163047-fok0u1x","Type":"NodeParagraph","Properties":{"id":"20240830163047-fok0u1x","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"㈠预防：每日1两，1次或2次煎服，每周连服3日，共服5周。2000余人服药结果表明，服药组与未服药组发病率之比为1：5．58。㈡治疗：土茯苓2两（病情重而体质较好者可用至5两），甘草3钱，水煎每日2次分服。同时可根据病情辨证加减；对高热、重症者给葡萄糖液及维生素丙，个别有出血倾向者加用激素。治疗18例均愈，16例于服药2～3剂、3例于服药4～5剂后症状消失。平均住院时间3．6天。或用土茯苓4两，地榆、青蒿、白茅根各1两煎服。每日1～3剂，热退后每日1剂，4次分服。同时配合对症处理，如镇静、止血、补液等。治疗14例，失败4例。其中血培养阳性者9例，5例治愈，4例失败。治愈病例体温降至正常时间在1～7日内，主要症状随体温下降而逐渐减轻或消失，大部分病人头痛、身痛、球结膜充血、腓肠肌压痛、血痰等均于1～2天内消失。治疗中少数病例出现恶心、呕吐等反应。"}]},{"ID":"20240830163047-uxc865b","Type":"NodeParagraph","Properties":{"id":"20240830163047-uxc865b","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②治疗梅毒"}]},{"ID":"20240830163047-6lsr4rp","Type":"NodeParagraph","Properties":{"id":"20240830163047-6lsr4rp","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"据早年临床观察报告，以土茯苓为主，配合银花、甘草，或配合苍耳子、白藓皮、甘草，或配合忍冬藤、蒲公英、马齿苋、甘草。煎服．治疗现症梅毒及隐性梅毒，其血清阴转率在90％上下。其中晚期现症梅毒的治愈率为50％左右。对晚期麻痹性痴呆，不仅脑脊液康、华氏反应转阴，而且精神症状亦获得不同程度的改善。对于小儿先天性梅毒性口腔炎效果亦佳。用量：成人每日用土茯芩1.5～2两，水煎，2～3次分服，以10～20天为一疗程。但亦有每日量用至2～8两的，疗程有长达2个月的。"}]},{"ID":"20240830163047-oqs24v6","Type":"NodeParagraph","Properties":{"id":"20240830163047-oqs24v6","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③其它"}]},{"ID":"20240830163047-f9yrehj","Type":"NodeParagraph","Properties":{"id":"20240830163047-f9yrehj","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"㈠防治麻疹：预防用100％煎液内服，3岁以下每日30～50毫升，3～6岁50～60毫升，分3次服，连服3日。或制成注射液行肌肉注射。以上剂量亦可作为治疗之用。㈡治疗急性细菌性痢疾：每日用4～8两煎服，或再以煎液作保留灌肠，7天为一疗程。㈢治疗急慢性肾炎：每日3两，水煎，分3次服。退肿作用较好，肚后，小便增加。亦有用于治疗肾盂肾炎、肾结核的报道。㈣治疗须淋巴结核：每日用鲜品1斤，水煎分2次服。"}]},{"ID":"20240830163047-3kxdcfe","Type":"NodeParagraph","Properties":{"id":"20240830163047-3kxdcfe","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240830163047-hes8wjo","Type":"NodeParagraph","Properties":{"id":"20240830163047-hes8wjo","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"下列几种同属植物的根茎在少数地区亦作土茯苓使用："}]},{"ID":"20240830163047-tvmxxlv","Type":"NodeParagraph","Properties":{"id":"20240830163047-tvmxxlv","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"①暗色菝葜，产四川，又称白土苓。"}]},{"ID":"20240830163047-3yr2434","Type":"NodeParagraph","Properties":{"id":"20240830163047-3yr2434","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"②无刺菝葜，其根茎在西藏作土茯苓用，在云南则为红萆薢，参见\"红萆薢\"条。"}]},{"ID":"20240830163047-qpb5v99","Type":"NodeParagraph","Properties":{"id":"20240830163047-qpb5v99","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"③防已叶菝葜，产西藏。"}]},{"ID":"20240830163047-14zv30n","Type":"NodeParagraph","Properties":{"id":"20240830163047-14zv30n","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830163047-kbe4nj1","Type":"NodeParagraph","Properties":{"id":"20240830163047-kbe4nj1","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"土茯苓《中华本草》"}]},{"ID":"20240830163047-rclimqm","Type":"NodeParagraph","Properties":{"id":"20240830163047-rclimqm","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【出处】出自《滇南本草》。陶弘景：南人又呼平泽中有一种藤，叶如菝葜，根作块有节，似菝葜而色赤，根形似薯蓣，谓为禹余粮。言昔禹行山乏食，采此以充粮，而弃其余。此云白余粮也。生池泽。"}]},{"ID":"20240830163047-i0mxcfs","Type":"NodeParagraph","Properties":{"id":"20240830163047-i0mxcfs","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔFúLínɡ"}]},{"ID":"20240830163047-knu0i56","Type":"NodeParagraph","Properties":{"id":"20240830163047-knu0i56","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【英文名】GlabrousGreenbrierRhizome，RhizomeofGlabrousGreenbrier"}]},{"ID":"20240830163047-971izlc","Type":"NodeParagraph","Properties":{"id":"20240830163047-971izlc","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【别名】禹余粮、白余粮、草禹余粮、刺猪苓、过山龙、硬饭、冷饭团、仙遗粮、土萆薢、山猪粪、山地栗、过冈尤、山牛、冷饭头、山归来、久老薯、毛尾薯、地胡苓、狗老薯、饭团根、土苓、狗朗头、尖光头、山硬硬、白葜、连饭、红土苓、山奇良"}]},{"ID":"20240830163047-e3mgr3n","Type":"NodeParagraph","Properties":{"id":"20240830163047-e3mgr3n","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830163047-uq5vplf","Type":"NodeParagraph","Properties":{"id":"20240830163047-uq5vplf","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"药材基源：为百合科植物土茯苓及暗色菝葜的根茎。"}]},{"ID":"20240830163047-3bxh9da","Type":"NodeParagraph","Properties":{"id":"20240830163047-3bxh9da","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.SmilaxglabraRoxb.2.SmilaxlanceaefoliaRoxb.var.opacaA.DC.[S.opaca（A.DC.）Norton]"}]},{"ID":"20240830163047-elu41oz","Type":"NodeParagraph","Properties":{"id":"20240830163047-elu41oz","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采挖，洗净浸漂，切片晒干；或放开水中煮数分钟后，切片晒干。"}]},{"ID":"20240830163047-n2yit04","Type":"NodeParagraph","Properties":{"id":"20240830163047-n2yit04","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【原形态】1.土茯苓攀援灌长，长1-4mm。茎光滑，无刺。根状茎粗厚、块状，常由匍匐茎相连接，粗2-5cm。叶互生；叶柄长5-15（-20）mm，约占全长的3/5-1/4，具狭鞘，常有纤细的卷须2条，脱落点位于近顶端；叶片薄革质，狭椭圆状披针形至狭卵状披针形，长6-12（-15）cm，宽1-4（-7）cm，先端渐尖，基部圆形或钝，下面通常淡绿色。伞形花序单生于叶腋，通常具10余朵花；雄花序总花梗长2-5mm，通常明显短于叶柄，极少与叶柄近等长，在总花梗与叶柄之间有1芽；花序托膨大，连同多数宿存的小苞片多少呈莲座状，宽2-5mm，花绿白色，六棱状球形，直径约3mm；雄花外花被片近扁圆形，宽约2mm，兜状，背面中央具纵槽，内花被片近圆形，宽约1mm，边缘有不规则的齿；雄花靠合，与内花被片近等长，花丝极短；雌花序的总梗长约1cm，雌花外形与雄花相似，但内花被片边缘无齿，具3枚退化雄蕊。浆果直径6-8mm，熟时黑色，具粉霜。花期5-11月，果期11月至次年4月。2.暗色菝葜本种与土茯苓的区别在于：叶片卵状披针形，背面无白粉，干时不呈青灰色，叶脉在上面凸起。雄花序的总花梗通常在5mm以上，雄花蕾圆柱状。"}]},{"ID":"20240830163047-d656y71","Type":"NodeParagraph","Properties":{"id":"20240830163047-d656y71","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830163047-kdctiey","Type":"NodeParagraph","Properties":{"id":"20240830163047-kdctiey","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生长于海拔1800m以下的林下、灌木丛中、河岸或山谷中，也见于林缘与疏林中。2.生长于海拔2000m以下的林下、灌丛或山坡阴处。"}]},{"ID":"20240830163047-7dzk1pv","Type":"NodeParagraph","Properties":{"id":"20240830163047-7dzk1pv","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于甘肃（南部）、长江流域以南以及台湾、海南、云南等地。2.分布于浙江、江西、福建、台湾、湖南、广东、广西、贵州和云南等地。"}]},{"ID":"20240830163047-9cjwk7p","Type":"NodeParagraph","Properties":{"id":"20240830163047-9cjwk7p","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【栽培】生物学特性喜温暖湿润气候，耐干旱和荫蔽。砂质壤土或粘壤土均可栽培。栽培技术用种子繁殖，春季播种。生长期应经常松土除草，苗高30cm左右，应搭架以利藤蔓攀援。"}]},{"ID":"20240830163047-3jgfbkd","Type":"NodeParagraph","Properties":{"id":"20240830163047-3jgfbkd","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别根茎近圆柱形，或不规则条块状，有结节状隆起，具短分枝；长5-22cm，直径2-5cm。表面黄棕色，凹凸不平，突起尖端有坚硬的须根残基，分枝顶端有圆形芽痕，有时外表现不规则裂纹，并有残留鳞叶。质坚硬，难折断。切面类白色至淡红棕色，粉性，中间微见维管束点，并可见沙砾样小亮点（水煮后依然存在）。质略韧，折断时有粉尘散出，以水湿润有粘滑感。气微，味淡、涩。以断面淡棕色、粉性足者为佳。显微鉴别根茎横切面：下皮为3-5列黄棕色细胞，排列紧密，壁较厚，木化，有的具壁孔。皮层散有大形粘液细胞，内含草酸钙针晶束。中柱薄壁细胞径向延长；散列有限外韧型维管束，中心分布较密；木质部常有两个大导管及数个小导管；韧皮部含少量纤维。薄壁细胞含大量淀粉粒。"}]},{"ID":"20240830163047-xi7jml7","Type":"NodeParagraph","Properties":{"id":"20240830163047-xi7jml7","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【化学成份】根茎中含落新妇甙（astilbin），黄杞甙（engeletin），3-O-咖啡酰莽草酸（3-O-caffeoylshikimicacid），莽草酸（shikimicacid），阿魏酸（ferulicacid），β-谷甾醇（β-sitosterol），葡萄糖（glucose）。"}]},{"ID":"20240830163047-a0zyykx","Type":"NodeParagraph","Properties":{"id":"20240830163047-a0zyykx","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830163047-1nv171e","Type":"NodeParagraph","Properties":{"id":"20240830163047-1nv171e","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"1.抗肿瘤作用1.1对大鼠膀胱化学致癌的影响实验动物雌Wistar大鼠，体重70-110g，致癌剂N-J基一N（4-羟丁基）亚硝胺（BBN），实验时以20%乙醇将BBN原液配成36%的溶液。正常对照组：在乙醚浅麻醉下，单纯以溶剂（20%乙醇）0.25ml经导管ig，每周2次，共12wk。病理对照组：36%BBN溶液0.25ml（90mg）ig，每周2次，共12wk、每只鼠BBN总剂量2.16g。土茯苓组：BBN处理同病理对照组，以每lkg含120g土茯苓干粉的饮食饲养。至wk30实验结束，处死动物，取膀胱、输尿管、肾盂，肾、肝和脾作组织学检查。结果表明，土茯苓组对BBN膀胱肿瘤的发生无明显抑制作用，而且发生了较多的鳞状细胞型肿瘤，因此在使用本品防治膀胱肿瘤时，应持慎重态度。"}]},{"ID":"20240830163047-0dag72k","Type":"NodeParagraph","Properties":{"id":"20240830163047-0dag72k","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"1.2对黄曲霉毒素B1致大鼠肝癌作用的影响取性Wistar大鼠，8wk龄，ipAFB1（280ug/kg，6次/wkx2）作肝癌启动动剂。2wk后，施以促癌程序：给含0.015%2-乙酰氨基芴（2AAF）饲料2wk，在wkl末，切除大鼠肝中叶和左外侧叶。10d后，断颈处列大鼠，肝脏取材作r-谷氨酰转肽酶（r一GT）染色。大鼠从注射AFB1前10d起，至停注AFB1后3d止，进食含受试物饲料。结果，大鼠肝癌前病变r一GT染色阳性肝细胞灶，土茯苓组（饲料中含377.7g/kg）的病灶也稍少，且显着小于对照组。提示土茯苓对预防肝癌有一定的实用价值。"}]},{"ID":"20240830163047-qrc0t2y","Type":"NodeParagraph","Properties":{"id":"20240830163047-qrc0t2y","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"2.对棉酚的解毒作用采用土茯苓水煎剂（剂量：每鼠每日相当生药1g和0.5g两种），土茯苓稀醇制剂（剂量：相当生药1g和2g），土茯苓粗黄酮（剂量：50mg和100mg），土茯苓多糖（剂量：0.5ml和1.0ml），硫酸亚铁（剂量8mg），每组用药3d后分别igl次纯棉酚650mg/kg、850mg/kg和100mg/kg，观察解毒作用。结果，土茯苓水煎剂、稀醇制剂和粗黄酮均具有拮抗急性和亚急性棉酚中毒（P＜0.05，P＜0.001和P＜0.001）。一般棉酚中毒时可用硫酸亚铁拮抗，但能影响抑精作用。土茯苓稀醇提取物在拮抗棉酚毒性的同时不影响棉酚对雄性大鼠的抑精作用。"}]},{"ID":"20240830163047-erqtebe","Type":"NodeParagraph","Properties":{"id":"20240830163047-erqtebe","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粉末1g，加水10ml，在60度水浴上加热10min，滤过，滤液作以下试验。①取滤液2ml，置带寒试管中，用力振摇1min，产生多数蜂窝状泡沫，放置10min，泡沫不明显减少。（检查皂甙）②取滤液2ml置试管中蒸干，加醋酐0.5ml，再沿试管壁加浓硫酸，两液面交界呈紫红色环。（检查皂甙）（2）薄层色谱取本品粉末5g，加乙醇50ml，于水浴中回流1h，放冷，滤过。滤液回收乙醇，残渣加稀硫酸20ml，回流水解3h，放冷，用氯仿提取2次，每次20ml。合并氯仿液，用少量水洗去残存的酸，脱水后，蒸去氯仿。残渣加少量已烷溶解，作供试液。以薯蓣皂甙元、替告皂甙元作对照品。分别点样于同一硅胶G-7.5%硝酸银薄板上，以氯仿-乙酸乙酯（9：1）展开。用饱和磷钼酸的乙醇溶液喷雾后，于110度烘5min显色，供试品色谱在与对照品色谱的相应位置上显相同的蓝色斑点。"}]},{"ID":"20240830163047-rz1b9qk","Type":"NodeParagraph","Properties":{"id":"20240830163047-rz1b9qk","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸漂，夏季每日换水1次，春、秋每2日换水1次，冬季可3日换水1次，防止发臭，以泡透为度，捞出切片，及时干燥。"}]},{"ID":"20240830163047-7zf64a9","Type":"NodeParagraph","Properties":{"id":"20240830163047-7zf64a9","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【性味】甘淡；平"}]},{"ID":"20240830163047-rkfc6rw","Type":"NodeParagraph","Properties":{"id":"20240830163047-rkfc6rw","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【归经】肝；胃；脾经"}]},{"ID":"20240830163047-1f4ksfx","Type":"NodeParagraph","Properties":{"id":"20240830163047-1f4ksfx","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热除湿；泄浊解毒；通利关节。主梅毒；淋浊；泄泻；筋骨挛痛；脚气；痈肿；疮癣；瘰疬；瘿瘤及汞中毒"}]},{"ID":"20240830163047-7syx8ad","Type":"NodeParagraph","Properties":{"id":"20240830163047-7syx8ad","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-60g。外用：适量，研末调敷。"}]},{"ID":"20240830163047-r8fcejj","Type":"NodeParagraph","Properties":{"id":"20240830163047-r8fcejj","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【注意】肝肾阴虚者慎服。"}]},{"ID":"20240830163047-jxmnuki","Type":"NodeParagraph","Properties":{"id":"20240830163047-jxmnuki","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830163047-4f8bi0s","Type":"NodeParagraph","Properties":{"id":"20240830163047-4f8bi0s","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"1.《本草汇编》：病杨梅毒疮，药用轻粉，愈而复发，久则肢体拘挛，变为痈漏，延绵岁月，竟致废笃。惟锉土萆薢三两，或加皂甙、牵牛各一钱，水六碗，煎三碗，分三服，不数剂多瘥。盖此疾始由毒气干于阳明而发，加以轻粉燥烈，久而水衰，肝挟相火，来凌脾土，土属湿，主肌肉，湿热郁蓄于肌腠，故发为痈肿，甚则拘挛，《内经》所谓湿气害人皮肉筋骨是也。土萆薢甘淡而平，能去脾湿，湿去则营卫从而筋脉柔，肌肉实而拘挛痈漏愈矣。初病服之不效者，火盛而湿未郁也。此药长于去湿，不能去热，病久则热衰气耗而湿郁为多故也。"}]},{"ID":"20240830163047-o90wdkj","Type":"NodeParagraph","Properties":{"id":"20240830163047-o90wdkj","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：土茯苓，有赤白二种，入药用白者良。按《中山经》云，鼓镫之山有草焉，名曰荣草，其叶如柳，其本如鸡卵，食之已风，恐即此也。......土茯苓能健脾胃，去风湿，脾胃健则营卫从，风湿去则筋骨利。"}]},{"ID":"20240830163047-7cw4cje","Type":"NodeParagraph","Properties":{"id":"20240830163047-7cw4cje","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"3.《本草正义》：土茯苓，利湿去热，能入络，搜剔湿热之蕴毒。其解水银、轻粉毒者，彼以升提收毒上行，而此以渗利下导为务，故专治杨梅毒疮，深入百络，关节疼痛，甚至腐烂，又毒火上行，咽喉痛溃，一切恶症。"}]},{"ID":"20240830163047-j4iyy2f","Type":"NodeParagraph","Properties":{"id":"20240830163047-j4iyy2f","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"4.《本草拾遗》：草禹余粮，根如盏连缀，半在土上，皮如茯苓，肉赤味涩，人取以当谷，不饥。......调中止泄。"}]},{"ID":"20240830163047-a9vybbo","Type":"NodeParagraph","Properties":{"id":"20240830163047-a9vybbo","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：敷疮毒。"}]},{"ID":"20240830163047-wg4ob82","Type":"NodeParagraph","Properties":{"id":"20240830163047-wg4ob82","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"6.《滇南本草》：治五淋白浊，兼治杨梅疮毒、丹毒。"}]},{"ID":"20240830163047-mxzfrv8","Type":"NodeParagraph","Properties":{"id":"20240830163047-mxzfrv8","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：健脾胃，强筋骨，去风湿，利关节，止泄泻。治拘挛骨痛；恶疮痈肿。解汞粉、银朱毒。"}]},{"ID":"20240830163047-m61yhqy","Type":"NodeParagraph","Properties":{"id":"20240830163047-m61yhqy","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"8.《本草正》：疔痈肿、喉痹，除周身寒湿、恶疮。"}]},{"ID":"20240830163047-sd7krrg","Type":"NodeParagraph","Properties":{"id":"20240830163047-sd7krrg","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"9.《生草药性备要》：消毒疮、疔疮，炙汁涂敷之，煲酒亦可。"}]},{"ID":"20240830163047-5hmmv7e","Type":"NodeParagraph","Properties":{"id":"20240830163047-5hmmv7e","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"10.《本草再新》：祛湿热，利筋骨。"}]},{"ID":"20240830163047-gphdkq1","Type":"NodeParagraph","Properties":{"id":"20240830163047-gphdkq1","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"11.《陆川本草》：治脚气。"}]},{"ID":"20240830163047-sj2k80q","Type":"NodeParagraph","Properties":{"id":"20240830163047-sj2k80q","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"12.广州部队《常用中草药手册》：治心胃气痛，肾炎。"}]},{"ID":"20240830163047-asugr1n","Type":"NodeParagraph","Properties":{"id":"20240830163047-asugr1n","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"13.《江西草药》：杀虫解毒。治瘰疬，小儿疳积。"}]},{"ID":"20240830163047-r8w200p","Type":"NodeParagraph","Properties":{"id":"20240830163047-r8w200p","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"14.《常用中草药彩色图谱》：治风湿性关节炎，腹痛，消化不良，膀胱炎。"}]},{"ID":"20240830163047-qpdfxuc","Type":"NodeParagraph","Properties":{"id":"20240830163047-qpdfxuc","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830163047-nfqnrqd","Type":"NodeParagraph","Properties":{"id":"20240830163047-nfqnrqd","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"1.治疗梅毒及隐性梅毒，其血清阴转率在90%上下。其中晚期现症梅毒的治愈率为50%左右。对晚期麻痹性痴呆，不仅脑脊液康、华氏反应转阴，而且精神症状亦获得不同程度的改善。对于小儿先天性梅毒性口腔炎效果亦佳。用量：成人每日用土茯苓1.5-2两，水煎，2-3次分服，以10-20日为1疗程。但亦有每日量用至2-8两的，疗程有长达2个月的。"}]},{"ID":"20240830163047-ingdadg","Type":"NodeParagraph","Properties":{"id":"20240830163047-ingdadg","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"2.预防用100%煎液内服，3岁以下每日30-50ml，3-5岁50-60ml，分3次服，连服3日。或制成注射液行肌肉注射。以上剂量亦可作为治疗之用。"}]},{"ID":"20240830163047-xim3i5u","Type":"NodeParagraph","Properties":{"id":"20240830163047-xim3i5u","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"3.治疗急性细菌性痢疾：每日用4-8两煎服，或再以煎液作保留灌肠，7日为1疗程。"}]},{"ID":"20240830163047-3byadfk","Type":"NodeParagraph","Properties":{"id":"20240830163047-3byadfk","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"4.治疗急慢性肾炎：每日3两，水煎，分3次服。退肿作用较好，服后小便增加。亦有用于治疗肾盂肾炎、肾结核的报道。"}]},{"ID":"20240830163047-rqxatpv","Type":"NodeParagraph","Properties":{"id":"20240830163047-rqxatpv","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"5.治疗颈淋巴结核：每日用鲜品1斤，水煎分2次服。"}]},{"ID":"20240830163047-ym9bkmv","Type":"NodeParagraph","Properties":{"id":"20240830163047-ym9bkmv","updated":"20240830163122"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830163048-nhsy5zp","Type":"NodeThematicBreak","Properties":{"id":"20240830163048-nhsy5zp","updated":"20240830163122"}},{"ID":"20240830163049-md4bm33","Type":"NodeParagraph","Properties":{"id":"20240830163049-md4bm33","updated":"20240830163122"}}]}