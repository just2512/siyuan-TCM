ta":"{: style=\"width: 467px;\" parent-style=\"width: 477px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717195447-zh3zprh","Type":"NodeParagraph","Properties":{"id":"20240717195447-zh3zprh","updated":"20240717195553"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼 2-20240717195549-kgwxikq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼 1-20240717195447-b9ub8ih.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717114411-1gce02n","Type":"NodeParagraph","Properties":{"id":"20240717114411-1gce02n","updated":"20240717195605"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 661px;","style":"width: 651px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"瓜蒌 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/瓜蒌 5-20240717114258-actbrkr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 651px;\" parent-style=\"width: 661px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼根-20240624124018-j363hwo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717114411-ia5grx9","Type":"NodeParagraph","Properties":{"id":"20240717114411-ia5grx9","updated":"20240717114411"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1257px;","style":"width: 1247px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"瓜蒌 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/瓜蒌 6-20240717114347-6wf6vuj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1247px;\" parent-style=\"width: 1257px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717195338-dldh52t","Type":"NodeParagraph","Properties":{"id":"20240717195338-dldh52t","updated":"20240717195338"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼-20240717195322-ckldc94.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717112206-h1d86pj","Type":"NodeThematicBreak","Properties":{"id":"20240717112206-h1d86pj"}},{"ID":"20240902105550-6g4mzm5","Type":"NodeParagraph","Properties":{"id":"20240902105550-6g4mzm5","updated":"20240902105558"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：栝楼"}]},{"ID":"20240902105550-tzc3z62","Type":"NodeParagraph","Properties":{"id":"20240902105550-tzc3z62","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"栝楼《*辞典》"}]},{"ID":"20240902105550-ufjzezc","Type":"NodeParagraph","Properties":{"id":"20240902105550-ufjzezc","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【出处】《本经》"}]},{"ID":"20240902105550-55qj1ou","Type":"NodeParagraph","Properties":{"id":"20240902105550-55qj1ou","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【拼音名】GuāLóu"}]},{"ID":"20240902105550-vrmu9u8","Type":"NodeParagraph","Properties":{"id":"20240902105550-vrmu9u8","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【别名】果裸（《诗经》），王菩（《吕氏春秋》），地楼（《本经》），泽巨、泽冶（《吴普本草》），王白（《广雅》），天瓜（《尔雅》郭璞注），萯（《穆天子传》郭璞注），瓜葵（《针灸甲乙经》），泽姑、黄瓜（《别录》），天圆子（《东医宝鉴》），柿瓜（《医林纂要》），野苦瓜（《贵州民间方药集》），杜瓜、大肚瓜（《浙江中药手册》），药瓜（《四川中药志》），鸭屎瓜（《广东中药》）。"}]},{"ID":"20240902105550-lpnmw7v","Type":"NodeParagraph","Properties":{"id":"20240902105550-lpnmw7v","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【来源】为葫芦科植物栝楼的果实。霜降至立冬果实成熟，果皮表面开始有白粉并为淡黄色时，即可采收。连果柄剪下，将果柄编结成串，先堆积屋内2～3天，再挂于阴凉通风处晾干（2个月左右）；然后剪去果柄，用软纸逐个包裹，以保持色泽。防止撞伤破裂，否则易生虫发霉。"}]},{"ID":"20240902105550-b2re86p","Type":"NodeParagraph","Properties":{"id":"20240902105550-b2re86p","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草质藤本，长达10米。块根肥厚。茎攀援，多分枝，表面有浅纵沟，光滑无毛；卷须腋生，细长，先端2歧。叶互生；叶片近圆形或近心形，长宽各8～20厘米，常为5～7浅裂或中裂，少为3裂，裂片倒卵形、矩圆形、椭圆形至矩圆状披针形，先端急尖或短渐尖，边缘有疏齿或再作浅裂，幼时两面疏生柔毛，老时下面有粗糙斑点。花单性，雌雄异株；雄花3～8，排列成总状花序，有时单生；萼筒状，长2.5～4厘米，萼片5，线形，稍反卷，长1～1.5厘米；花冠白色，裂片5，倒卵形，先端细裂成流苏状；雄蕊3，花丝长4～6毫米；雌花单生，萼、瓣与雄花略同；子房下位，长卵形，花柱长，柱头3深裂，呈丝状。瓤果卵圆形至广椭圆形，熟时橙黄色，光滑。种子多数，扁平，长方卵形或圆卵形，边缘有线纹状形成窄边，熟时黄棕色。花期7～8月。果期9～10月。"}]},{"ID":"20240902105550-3ld821u","Type":"NodeParagraph","Properties":{"id":"20240902105550-3ld821u","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于山坡草丛、林边、阴湿山谷中。亦有栽培。我国大部分地区均有分布。全国大部分地区有产。主产山东、安徽、河南等地。"}]},{"ID":"20240902105550-rcuaopn","Type":"NodeParagraph","Properties":{"id":"20240902105550-rcuaopn","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实呈长椭圆形或卵圆形，长约9厘米，直径约6厘米。果皮橙黄色或土黄色，微有光泽，皱缩，顶端有圆形的花柱残存，基部略尖，有果柄的残余，果柄部周围的果皮上有放射状纵沟。质重，剖开后内表面黄白色，并有纤维，肉质胎座多巳缩成粘丝状，种子集结成团。气如焦糖，味略甜。以个大、不破、色澄黄、糖味浓者为佳。"}]},{"ID":"20240902105550-fz6jq0p","Type":"NodeParagraph","Properties":{"id":"20240902105550-fz6jq0p","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含三萜皂甙、有机酸、树脂、糖类和色素。种子含脂肪油。果实所含的蛋白质与其块根\"天花粉\"所含的蛋白质不同，参见\"天花粉\"条。"}]},{"ID":"20240902105550-a7siyo0","Type":"NodeParagraph","Properties":{"id":"20240902105550-a7siyo0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902105550-js5njkf","Type":"NodeParagraph","Properties":{"id":"20240902105550-js5njkf","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"抗菌、抗癌作用。栝楼在体外对大肠杆菌、宋内氏痢疾杆菌、变形杆菌等有某些抑制作用。水浸液（1：2）在体外对某些皮肤真菌也有不同程度的抑制作用。在体外试验中，全栝楼煎剂（20％煎剂）对腹水癌细胞有致死作用。并有人认为栝楼皮、栝楼仁均有效，但前者的作用较好。种壳与脂肪油则无效。醇，醚提取物亦有效。60％醇提取物体外作用最好。但动物试验，其作用不太显着，也不稳定；在体内，对肉瘤的作用比对腹水癌细胞的作用强一些。"}]},{"ID":"20240902105550-4y3qcie","Type":"NodeParagraph","Properties":{"id":"20240902105550-4y3qcie","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"栝楼中尚含强烈的致泻物质。"}]},{"ID":"20240902105550-1herwdq","Type":"NodeParagraph","Properties":{"id":"20240902105550-1herwdq","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【炮制】去柄，洗净，置蒸笼内蒸至稍软，压扁，切成块。"}]},{"ID":"20240902105550-lgtuhqc","Type":"NodeParagraph","Properties":{"id":"20240902105550-lgtuhqc","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902105550-zqlgnhp","Type":"NodeParagraph","Properties":{"id":"20240902105550-zqlgnhp","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"甘苦，寒。"}]},{"ID":"20240902105550-zmdhmm1","Type":"NodeParagraph","Properties":{"id":"20240902105550-zmdhmm1","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①成无己：\"味苦，寒。\""}]},{"ID":"20240902105550-xkjm2om","Type":"NodeParagraph","Properties":{"id":"20240902105550-xkjm2om","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②《日用本草》：\"味苦，平凉，无毒。\""}]},{"ID":"20240902105550-or8z9lr","Type":"NodeParagraph","Properties":{"id":"20240902105550-or8z9lr","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"③《本草衍义补遗》：\"甘，润。\""}]},{"ID":"20240902105550-luyxeb1","Type":"NodeParagraph","Properties":{"id":"20240902105550-luyxeb1","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902105550-sncsyb6","Type":"NodeParagraph","Properties":{"id":"20240902105550-sncsyb6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"入肺、胃、大肠经。"}]},{"ID":"20240902105550-kqjzu7t","Type":"NodeParagraph","Properties":{"id":"20240902105550-kqjzu7t","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"入手少阴、太阴经。\""}]},{"ID":"20240902105550-ecmkb0m","Type":"NodeParagraph","Properties":{"id":"20240902105550-ecmkb0m","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入肺、胃二经。\""}]},{"ID":"20240902105550-3dkukvq","Type":"NodeParagraph","Properties":{"id":"20240902105550-3dkukvq","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902105550-b23qdbe","Type":"NodeParagraph","Properties":{"id":"20240902105550-b23qdbe","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"润肺，化痰，散结，滑肠。治痰热咳嗽，胸痹，结胸，肺痿咳血，消渴，黄疸，便秘，痈肿初起。"}]},{"ID":"20240902105550-g3rtzo1","Type":"NodeParagraph","Properties":{"id":"20240902105550-g3rtzo1","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主胸痹。\""}]},{"ID":"20240902105550-6ebxbfa","Type":"NodeParagraph","Properties":{"id":"20240902105550-6ebxbfa","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"主消渴。\""}]},{"ID":"20240902105550-sdj95v3","Type":"NodeParagraph","Properties":{"id":"20240902105550-sdj95v3","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"③成无已：\"通胸中郁热。\""}]},{"ID":"20240902105550-fb6k5z1","Type":"NodeParagraph","Properties":{"id":"20240902105550-fb6k5z1","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"④《伤寒类要》：\"治脾瘅溺赤出少，惕惕若恐。\""}]},{"ID":"20240902105550-yt24i4j","Type":"NodeParagraph","Properties":{"id":"20240902105550-yt24i4j","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑤《品汇精要》：\"消结痰，散痈毒。\""}]},{"ID":"20240902105550-xzhinzf","Type":"NodeParagraph","Properties":{"id":"20240902105550-xzhinzf","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"润肺燥，降火。治咳嗽，涤痰结，利咽喉，消痈肿疮毒。\""}]},{"ID":"20240902105550-6yk9lqi","Type":"NodeParagraph","Properties":{"id":"20240902105550-6yk9lqi","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑦《江苏植药志》：\"治水肿。\""}]},{"ID":"20240902105550-8vtd23u","Type":"NodeParagraph","Properties":{"id":"20240902105550-8vtd23u","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑧《山西中药志》：\"瓜瓤洗手，治冻裂。\""}]},{"ID":"20240902105550-4bbbxdz","Type":"NodeParagraph","Properties":{"id":"20240902105550-4bbbxdz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～4钱；捣汁或入丸、散。外用：捣敷。"}]},{"ID":"20240902105550-h7tpiwo","Type":"NodeParagraph","Properties":{"id":"20240902105550-h7tpiwo","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902105550-2djh0en","Type":"NodeParagraph","Properties":{"id":"20240902105550-2djh0en","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"脾胃虚寒，大便不实，有寒痰、湿痰者不宜。"}]},{"ID":"20240902105550-n8tzcja","Type":"NodeParagraph","Properties":{"id":"20240902105550-n8tzcja","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"枸杞为之使。恶干姜。畏牛膝、干漆。反乌头。\""}]},{"ID":"20240902105550-fe4lcph","Type":"NodeParagraph","Properties":{"id":"20240902105550-fe4lcph","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"脾胃虚及呕吐自利者不可用。\""}]},{"ID":"20240902105550-wiko7hs","Type":"NodeParagraph","Properties":{"id":"20240902105550-wiko7hs","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"③《本草便读》：\"冷滑大肠，脾虚无火、大便不实者不可用。\""}]},{"ID":"20240902105550-af6lglw","Type":"NodeParagraph","Properties":{"id":"20240902105550-af6lglw","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902105550-miv2dou","Type":"NodeParagraph","Properties":{"id":"20240902105550-miv2dou","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①治小儿膈热咳嗽痰喘甚久不瘥：瓜蒌实一枚。去子，为末，以面和作饼子，炙黄为末。每服一钱，温水化乳糖下，日三服，效乃止。（《宣明论方》润肺散）"}]},{"ID":"20240902105550-06kza53","Type":"NodeParagraph","Properties":{"id":"20240902105550-06kza53","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②治痰嗽：黄热瓜蒌一个。取出子若干枚，照还去皮杏仁于内，火烧存性，醋糊为丸，如梧子大。每服二十丸，临卧时，白萝卜汤送下。（《鲁府禁方》）"}]},{"ID":"20240902105550-iwo0pta","Type":"NodeParagraph","Properties":{"id":"20240902105550-iwo0pta","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"③治喘：栝蒌二个，明矾一块，如枣子大，入栝蒌内，烧煅存性，为末。将萝卜煮烂，蘸药末服之，汁过口。（《普济方》栝蒌散）"}]},{"ID":"20240902105550-eyotz9r","Type":"NodeParagraph","Properties":{"id":"20240902105550-eyotz9r","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"④治小结胸病，正在心下，按之则痛，脉浮滑者：黄连一两，半夏（洗）半升，栝蒌实大者一枚。上三味，以水六升，先煮栝蒌，取三升，去滓，内诸药，煮取二升，去滓，分温三服。（《伤寒论》小陷胸汤）"}]},{"ID":"20240902105550-dt7w0vk","Type":"NodeParagraph","Properties":{"id":"20240902105550-dt7w0vk","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑤治胸痹，喘息咳唾，胸背痛，短气，寸口脉沉而迟，关上小紧数：栝蒌实一枚（捣），薤白半斤，白酒七升。上三味，同煮取二升，分温再服。（《金匮要赂》栝蒌薤白白酒汤）"}]},{"ID":"20240902105550-b83cosw","Type":"NodeParagraph","Properties":{"id":"20240902105550-b83cosw","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑥治胸痹不得卧，心痛彻背者：栝蒌实一枚（捣），薤白三两，半夏半斤，白酒一斗。上四味，同煮取四升，温服一升，日三服。（《金匮要略》栝蒌薤白半夏汤）"}]},{"ID":"20240902105550-3806daz","Type":"NodeParagraph","Properties":{"id":"20240902105550-3806daz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑦治肺痿咳血不止：栝蒌五十个（连瓤，瓦焙），乌梅肉五十个（焙），杏仁（去皮、尖，炒）二十一个。为末。每用一捻，以猪肺一片切薄，掺末入内，炙热，冷嚼咽之，日二服。（《圣济总录》）"}]},{"ID":"20240902105550-2kn89fb","Type":"NodeParagraph","Properties":{"id":"20240902105550-2kn89fb","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑧治吐血：栝楼取端正者，纸筋和泥通裹，于顶间留一眼子，煅存性，地坑内合一宿，去泥捣罗为散。每服三钱匕，糯米饮调下。（《圣济总录》黑神散）"}]},{"ID":"20240902105550-6kcscj3","Type":"NodeParagraph","Properties":{"id":"20240902105550-6kcscj3","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑨治消渴热或心神烦乱：黄肥栝蒌一颗，以酒一中盏洗，取瓤，去皮、子，煎成膏，入白矾末一两，和丸如梧桐子大。每服不计时候，以粥饮下十丸。（《圣惠方》）"}]},{"ID":"20240902105550-x9my5f5","Type":"NodeParagraph","Properties":{"id":"20240902105550-x9my5f5","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑩治时疾发黄，心狂烦热闷不认人者：大瓜蒌实一枚黄者，以新汲水九合，浸淘取汁，下蜜半大合，朴硝八分，合搅令消尽，分再服。（《海上集验方》）"}]},{"ID":"20240902105550-kkogjka","Type":"NodeParagraph","Properties":{"id":"20240902105550-kkogjka","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑾治小儿黄疸，脾热眼黄，并治酒黄：瓜蒌青者焙为末。每服一钱，水一盏，煎七分，去滓，临卧服，五更泻下黄物立可。（《普济方》逐黄散）"}]},{"ID":"20240902105550-69rwnax","Type":"NodeParagraph","Properties":{"id":"20240902105550-69rwnax","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑿治肺燥热渴，大肠秘：九月、十月间熟栝楼取瓤，以干葛粉拌，焙干，慢火炒熟，为末。食后、夜卧，以沸汤点三钱服。（《本草衍义》）"}]},{"ID":"20240902105550-rlkuun3","Type":"NodeParagraph","Properties":{"id":"20240902105550-rlkuun3","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒀治乳肿痛：栝蒌（黄色老大者）一枚熟捣，以白酒一斗，煮取四升，去滓，温一升，日三服。（《子母秘录》）"}]},{"ID":"20240902105550-ehr6q8g","Type":"NodeParagraph","Properties":{"id":"20240902105550-ehr6q8g","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒁治乳痈及一切痈疽初起，肿痛即消，脓成即溃，脓出即愈：瓜蒌一个（研烂），生粉草、当归（酒洗）各半两，乳香、没药各一钱。上用酒煎服，良久再服。（《妇人良方》神效瓜蒌散）"}]},{"ID":"20240902105550-jm6ccup","Type":"NodeParagraph","Properties":{"id":"20240902105550-jm6ccup","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒂治酒癖，痰吐不止，两胁胀痛，气喘上奔，不下食饮：栝蒌瓤一两，神曲末半两（微炒）。上药捣细罗为散。每服，以葱白酒调下二钱。（《圣惠方》）"}]},{"ID":"20240902105550-ca72jgl","Type":"NodeParagraph","Properties":{"id":"20240902105550-ca72jgl","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒃治肠风下血：栝楼（烧为灰）、赤小豆各半两。上二味，杵罗为末。空心酒调下一钱匕。（《圣济总录》）"}]},{"ID":"20240902105550-gmin0vk","Type":"NodeParagraph","Properties":{"id":"20240902105550-gmin0vk","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒄治热游丹赤肿：栝楼末二大两，酽醋调敷之。（《产乳集验方》）"}]},{"ID":"20240902105550-1d72ob6","Type":"NodeParagraph","Properties":{"id":"20240902105550-1d72ob6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒅治便毒初发：黄瓜蒌一个，黄连五钱。水煎连服。（《永类钤方》）"}]},{"ID":"20240902105550-6td7ap9","Type":"NodeParagraph","Properties":{"id":"20240902105550-6td7ap9","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒆痰咳不止。用栝楼仁一两、文蛤七分，共研为末，以浓姜汁调成丸子，如弹子大，噙口中咽汁。又方：熟栝楼十个、明矾二两，共捣成饼，阴干，研为末，加糊做成丸子，如梧子大。每服五十至七十丸，姜汤送下。"}]},{"ID":"20240902105550-2w7jby9","Type":"NodeParagraph","Properties":{"id":"20240902105550-2w7jby9","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⒇干咳。用熟栝楼捣烂，加蜜等分，再加白矾一钱，共熬成膏，随时口含回汁。"}]},{"ID":"20240902105550-9bom401","Type":"NodeParagraph","Properties":{"id":"20240902105550-9bom401","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（21）痰喘气急。用栝楼二个、明矾如枣大一块，同烧存性，研细，以熟萝卜蘸食。药尽病除。"}]},{"ID":"20240902105550-5xs3s20","Type":"NodeParagraph","Properties":{"id":"20240902105550-5xs3s20","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（22）肺痿咳血。用栝楼五十个（连瓤瓦焙）、乌梅肉五十个（焙过）、杏仁（去皮尖，炒）二十一个，共研为末；另将猪肺一片切薄，掺末一小撮入内，炙熟，冷嚼回下。一天二次。"}]},{"ID":"20240902105550-oten4en","Type":"NodeParagraph","Properties":{"id":"20240902105550-oten4en","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（23）妇女夜热（痰嗽，月经不调，形瘦）。用栝楼仁一两，青黛、香附（童便浸，晒）各一两五钱，共研为末，加蜜调匀，口中噙化。"}]},{"ID":"20240902105550-05wkxbp","Type":"NodeParagraph","Properties":{"id":"20240902105550-05wkxbp","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（24）黄疸。用青栝楼焙过，研为末。每取一钱，加水半碗，煎至七成，临睡时服，五更有黄物泻下，即为见效。此方名为\"逐黄散\"。"}]},{"ID":"20240902105550-yzspqf4","Type":"NodeParagraph","Properties":{"id":"20240902105550-yzspqf4","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（25）小便不通，腹胀。用栝楼焙过，研为末。每服二钱，热酒送下。服至病愈为止。"}]},{"ID":"20240902105550-8jlvcx6","Type":"NodeParagraph","Properties":{"id":"20240902105550-8jlvcx6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（26）久痢。用在熟栝楼一个，煅存性，出火毒后三工业区末。一次服完，温酒送下。"}]},{"ID":"20240902105550-8w6yuk0","Type":"NodeParagraph","Properties":{"id":"20240902105550-8w6yuk0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（27）吐血。泥封栝楼，煅存性，研为末。每服三钱，糯米汤送下。一天服二次。"}]},{"ID":"20240902105550-91c63du","Type":"NodeParagraph","Properties":{"id":"20240902105550-91c63du","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（28）屙血。用栝楼一个，烧灰，加赤小豆半两，共为末。每服一钱，空心服，酒送下。"}]},{"ID":"20240902105550-rtf30wh","Type":"NodeParagraph","Properties":{"id":"20240902105550-rtf30wh","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（29）咽喉肿痛，不能发声。用栝楼皮、白僵蚕（炒）、甘草（炒）各二钱半，共研为末。每服三钱半，姜汤送下。一天服二次。或以棉裹半钱含咽亦可。此方名\"发声散\"。"}]},{"ID":"20240902105550-e439mz5","Type":"NodeParagraph","Properties":{"id":"20240902105550-e439mz5","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（30）诸痈发背。用栝楼捣为末，每服一匙，水送下。"}]},{"ID":"20240902105550-grtfbng","Type":"NodeParagraph","Properties":{"id":"20240902105550-grtfbng","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（31）风疮疥癣。用生栝楼一、二个，打碎、酒泡一日夜，取酒热饮。"}]},{"ID":"20240902105550-w3ptrc6","Type":"NodeParagraph","Properties":{"id":"20240902105550-w3ptrc6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（32）消渴。取大栝楼根（天花粉），去皮，切细，水泡五天，每天换水。五天后取出捣碎，过滤，澄粉，晒干。每服一匙，水化下。一天服三次。亦可将药加入粥中及乳酪中吃下。又方：用栝楼根切薄，炙过，取五两加水五升煮至四升，随意饮服。"}]},{"ID":"20240902105550-agf2id5","Type":"NodeParagraph","Properties":{"id":"20240902105550-agf2id5","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（33）小儿热病。用栝楼根末半钱，乳汁调服半钱。"}]},{"ID":"20240902105550-bsjziq9","Type":"NodeParagraph","Properties":{"id":"20240902105550-bsjziq9","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（34）天泡湿疮。用天花粉、滑石，等分为末，水调搽涂。"}]},{"ID":"20240902105550-7pu7ne2","Type":"NodeParagraph","Properties":{"id":"20240902105550-7pu7ne2","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（35）折伤肿痛。用栝楼根捣烂涂患处，厚布包住，热除，痛即止。"}]},{"ID":"20240902105550-px2licn","Type":"NodeParagraph","Properties":{"id":"20240902105550-px2licn","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902105550-ipyx2ek","Type":"NodeParagraph","Properties":{"id":"20240902105550-ipyx2ek","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"①《本草衍义补遗》：\"栝楼实，《本草》言治胸痹，以味甘性润，甘能补肺，润能降气。胸有痰者，以肺受火逼，失降下之令，今得甘缓润下之助，则痰自降，宜其为治嗽之要药也。又洗涤胸膈中垢腻，治消渴之神药也。\""}]},{"ID":"20240902105550-g0s2msl","Type":"NodeParagraph","Properties":{"id":"20240902105550-g0s2msl","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"张仲景治胸痹痛引心背，咳唾喘息，及结胸满痛，皆用栝楼实，乃取其甘寒不犯胃气，能降上焦之火，使痰气下降也。成无己不知此意，乃云苦寒以泻热，盖不尝其味原不苦，而随文附会尔。\""}]},{"ID":"20240902105550-j238rop","Type":"NodeParagraph","Properties":{"id":"20240902105550-j238rop","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"③《本草述》：\"栝楼实，阴厚而脂润，故于热燥之痰为对待的剂，若用之于寒痰、湿痰、气虚所结之痰，饮食积聚之痰，皆无益而有害者也。\""}]},{"ID":"20240902105550-zk6bbvz","Type":"NodeParagraph","Properties":{"id":"20240902105550-zk6bbvz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"栝楼实，其性较栝楼根稍平，而无寒郁之患。\""}]},{"ID":"20240902105550-v1sj85s","Type":"NodeParagraph","Properties":{"id":"20240902105550-v1sj85s","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑤《重庆堂随笔》：\"栝楼实，润燥开结，荡热涤痰，夫人知之；而不知其舒肝郁，润肝燥，平肝逆，缓肝急之功有独擅也，（魏）玉璜先生言之最详。\""}]},{"ID":"20240902105550-jmo5l5h","Type":"NodeParagraph","Properties":{"id":"20240902105550-jmo5l5h","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑥《本草便读》：\"瓜蒌，性味与花粉相同，惟润降之功过之。故凡上焦郁热，垢腻痰火咳嗽等证，皆可用之。一切肺痈、肠痈、乳痈之属火者，尤为相宜。\""}]},{"ID":"20240902105550-6o83njg","Type":"NodeParagraph","Properties":{"id":"20240902105550-6o83njg","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑦《本草思辨录》：\"栝楼实之长，在导痰浊下行，故结胸胸痹，非此不治。然能导之使行，不能逐之使去，盖其性柔，非济之以刚，则下行不力。是故小陷胸汤则有连、夏，栝楼薤白等汤则有薤、酒、桂、朴，皆伍以苦辛迅利之品，用其所长，又补其所短也。\""}]},{"ID":"20240902105550-7qde0b6","Type":"NodeParagraph","Properties":{"id":"20240902105550-7qde0b6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑧《医学衷中参西录》：\"栝楼，能开胸间及胃口热痰，故仲景治结胸有小陷胸汤，栝楼与连、夏并用；治胸痹有栝楼薤白等方，栝楼与薤、酒、桂、朴诸药并用。若与山甲同用，善治乳痈；若与赭石同用，善止吐衄；若但用其皮，最能清肺、敛肺、宁嗽、定喘；若但用其瓤，最善滋阴、润燥、滑痰、生津；若但用其仁，其开胸降胃之力较大，且善通小便。\""}]},{"ID":"20240902105550-dfi4cho","Type":"NodeParagraph","Properties":{"id":"20240902105550-dfi4cho","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"⑨《本草正义》：\"蒌实入药，古人本无皮及子仁分用之例，仲景书以枚计，不以分量计，是其确证。盖蒌实能通胸膈之痹塞，而子善涤痰垢粘腻，一举两得。自《日华子本草》，有其子炒用一说，而景岳之《本草正》，只用其仁，张石顽之《逢原》，亦云去壳纸包压去油，则皆不用其壳，大失古人专治胸痹之义。且诸疡阳症，消肿散结，又皆以皮子并用为捷。观濒湖《纲目》附方极多，全用者十之九，古人衣钵，最不可忽。惟近今市肆，以蒌实老时，皮肉不粘，剖之不能成块，凡用全萎者，皆乘其未老之时，摘取曝干而剖为数块，方能皮肉粘合，以取美观，然力量甚薄，却无功效。所以颐欲用其全者，宁以蒌皮、蒌仁，列为二物，乃能得其老者，始有实验，若但书全瓜蒌三字，则用如不用，此亦治医者不可不知药物之真性情也。即使但用其皮，亦是老而力足，疏通中满，确有奇能。\""}]},{"ID":"20240902105550-vpjmz7j","Type":"NodeParagraph","Properties":{"id":"20240902105550-vpjmz7j","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗冠心病:每日用瓜蒌5钱，薤白4钱，制成片剂，三次分服。治疗25例，观察2～8周，22例有不同程度症状改善。16例心电图复查，14例示V5T波改善，2例恶化；12例服药前示S-T段压低者，10例改善，1例不变，1例恶化；服药前平均V5T波振幅为0.96毫米，服药后平均T波振幅增至2.7毫米；服药前平均S-T段下降0.84毫米，服药后S-T段平均下降0.27毫米。改变最明显1例在服药前二月发现有陈旧性前壁心肌梗死，心电图V2-V4QS波，T波倒置，服药后11月病员症状明显改善，V2-V4Q波消失，V5T波向上；另1例原有心绞痛及窦性静止，V5T波平坦，服药四月后T波回至正常，窦性静止消失。服药后少数病例感胃部不适，经服氢氧化铝后好转。观察中曾将瓜蒌与薤白分开服用，结果病人均反应瓜蒌片疗效较薤白片为佳。此片对冠状动脉供血作用，可能与通过放松动脉紧张度，减少心脏负荷有关。"}]},{"ID":"20240902105550-ceu16bx","Type":"NodeParagraph","Properties":{"id":"20240902105550-ceu16bx","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【备注】同属植物圆子栝楼、长萼栝楼的果实，在少数地区亦作栝楼入药。"}]},{"ID":"20240902105550-hdh4n2s","Type":"NodeParagraph","Properties":{"id":"20240902105550-hdh4n2s","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902105550-z2suyfq","Type":"NodeParagraph","Properties":{"id":"20240902105550-z2suyfq","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"栝楼《中华本草》"}]},{"ID":"20240902105550-aat61f6","Type":"NodeParagraph","Properties":{"id":"20240902105550-aat61f6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902105550-3zyb8wf","Type":"NodeParagraph","Properties":{"id":"20240902105550-3zyb8wf","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"出自《神农本草经》。"}]},{"ID":"20240902105550-350vtej","Type":"NodeParagraph","Properties":{"id":"20240902105550-350vtej","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：栝楼，今所在有之。皮黄肉白，三、四月内生苗，引藤蔓，叶如甜瓜叶，作叉，有细毛。七月开花，似葫芦花，浅黄色。实在花下，大如拳，生青，至九月熟，赤黄色。其实有正圆者，有锐而长者，功用皆同。"}]},{"ID":"20240902105550-rtukba8","Type":"NodeParagraph","Properties":{"id":"20240902105550-rtukba8","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：栝楼，其根直下生，年久者长数尺，秋后掘者结实有粉，夏月掘者有筋无粉，不堪用。其实圆长，青时如瓜，黄时如熟柿，山家小儿亦食之。内有扁子，大如丝瓜子，壳"}]},{"ID":"20240902105550-165p8o0","Type":"NodeParagraph","Properties":{"id":"20240902105550-165p8o0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【拼音名】GuāLóu"}]},{"ID":"20240902105550-wo0t4xn","Type":"NodeParagraph","Properties":{"id":"20240902105550-wo0t4xn","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【英文名】SnakegourdFruit,SmakegourdSeed"}]},{"ID":"20240902105550-0nc3t0a","Type":"NodeParagraph","Properties":{"id":"20240902105550-0nc3t0a","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【别名】果裸、王菩、地楼、泽巨、泽冶、王白、天瓜、瓜蒌、泽姑、黄瓜、天圆子、柿瓜、狗苦瓜、野苦瓜、杜瓜、大肚瓜、药瓜、鸭屎瓜、山金匏、大圆瓜、吊瓜。"}]},{"ID":"20240902105550-e3o8js4","Type":"NodeParagraph","Properties":{"id":"20240902105550-e3o8js4","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902105550-pii1hfr","Type":"NodeParagraph","Properties":{"id":"20240902105550-pii1hfr","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"药材基源：为葫芦科植物栝楼的果实。"}]},{"ID":"20240902105550-eawtw9d","Type":"NodeParagraph","Properties":{"id":"20240902105550-eawtw9d","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.TrichosantheskirilowiiMaxim.2.TrichosanthesrosthorniiHarms"}]},{"ID":"20240902105550-38qu989","Type":"NodeParagraph","Properties":{"id":"20240902105550-38qu989","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"采收和储藏：按成熟情况，成熟一批采摘一批。采时，用剪刀在距果实15cm处，连茎剪下，悬挂通风干燥和晾干，即成全瓜蒌。"}]},{"ID":"20240902105550-pffmod6","Type":"NodeParagraph","Properties":{"id":"20240902105550-pffmod6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【原形态】攀援藤本，长可达10m。块根圆柱状，肥厚，富含淀粉。茎较粗，多分枝，具纵棱及槽，被白色伸展柔毛。叶互生；叶柄长3-10cm，具纵条纹，被条柔毛；卷须3-7分歧，被柔毛；叶片低质，轮廓近圆形或近心形，长宽均约5-20cm，常3-5（-7）浅裂至中裂，稀深裂或不分裂而仅有不等大粗齿，裂片菱状倒卵形、长圆形，先端钝，急尖，边缘常再浅裂，基部心形，弯缺深3-4cm，表面深绿色，粗糙，背面淡绿色，两面沿脉被长柔毛状硬毛，基出掌状脉5条，细脉网状。雌雄异株；雄总状花序单生或与一单花并生，或在枝条上部者单生，总太花序长10-20cm，粗壮，具纵棱及槽，被微柔毛，顶端有5-8花，单花花梗长约15cm，小花梗长约3mm，小苞片倒卵形或阔卵形，长1.5-2.5(-3)cm，宽1-2cm，中上部具粗齿，基部具柄，被短柔毛；花萼筒筒状，长2-4cm，先端扩大，径约10mm，中、下部径约5mm，被短柔毛，裂片披针形，长10-15cm，宽3-5mm，全缘；花冠白色，裂片倒卵形，长约20mm，宽约18mm，先端中央具1绿色尖头，两侧具丝状流苏，被柔毛；花药靠合，长约2mm，径约4mm，花丝分离，粗壮，被长柔毛；雌花单生，花梗长7.5cm，被柔毛；花萼筒圆形，长2.5cm，径1.2cm，裂片和花冠同雄花；子房椭圆形，绿色，长2cm，花柱长2cm，柱头3。果实椭圆形，压扁，长11-16mm，宽7-12mm，淡黄褐色，近边缘处具棱线。花期5-8月，果期8-10月。"}]},{"ID":"20240902105550-ot2kmjk","Type":"NodeParagraph","Properties":{"id":"20240902105550-ot2kmjk","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902105550-rrasd1h","Type":"NodeParagraph","Properties":{"id":"20240902105550-rrasd1h","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"生态环境：常生长于海拔200-1800m的山坡林下、灌丛中、草地和村旁田边、或在自然分布区骨，广为栽培。"}]},{"ID":"20240902105550-1nlhhjf","Type":"NodeParagraph","Properties":{"id":"20240902105550-1nlhhjf","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华北、中南、华东及辽宁、陕西、甘肃、四川、贵州、云南。"}]},{"ID":"20240902105550-iceqpr4","Type":"NodeParagraph","Properties":{"id":"20240902105550-iceqpr4","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902105550-m15qrc1","Type":"NodeParagraph","Properties":{"id":"20240902105550-m15qrc1","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"生物学特性培温暖潮湿气候。较耐寒，不耐干旱。选择向阳、土层深厚、疏松肥沃的砂质壤土地块栽培为好。不宜在低洼地及盐碱地栽培。"}]},{"ID":"20240902105550-xox7uwo","Type":"NodeParagraph","Properties":{"id":"20240902105550-xox7uwo","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、分根及压条繁殖，生产上以分根繁殖为主。种子直播：9-10月选橙黄色短柄的成熟果实。翌春于3-4月间，将种子用40-50℃温水浸泡1昼夜，取出晾干，并经用湿砂催芽，按穴距2m下种，上覆土3-4cm。播后15-20d出苗。分根繁殖：北方在3-4月份，南方在10-12月份，将块根和芦头全部挖出，选择无病虫，新鲜的作用种，分成7-10cm的小段。注意雌、雄株的根要适当搭配，以利授粉。按行株距2m×0.3m挖穴播种，1个月左右即可出苗。压条繁殖：在夏、秋季，将健壮茎蔓拉于地面，在叶的基部压土，待根长出，剪断茎部，长出新茎，成为新株。翌年可移栽。"}]},{"ID":"20240902105550-9rkld6e","Type":"NodeParagraph","Properties":{"id":"20240902105550-9rkld6e","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"田间管理栽种后，每年春、冬季各中耕除草1次。每次中耕除草后，均结合施肥。当茎蔓生长至30cm以上时，需搭棚架引蔓上架。茎蔓上架后，注意修枝打杈，去掉弱蔓、徒长茎蔓，过多腋芽分枝，促使养分集中，以利结果。开花结果期应进行人工授粉，重施基肥。"}]},{"ID":"20240902105550-nto6l48","Type":"NodeParagraph","Properties":{"id":"20240902105550-nto6l48","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"病虫害防治虫害有黄守瓜，成虫5月开始咬食叶片，幼虫蛀食根部。幼期可用30倍烟碱水灌根。瓜蒌透翅蛾，月开始蛀食茎蔓，引起整枝枯死。瓜蚜，为害幼嫩心叶。还有黑足黑守瓜等为害。"}]},{"ID":"20240902105550-tivlogz","Type":"NodeParagraph","Properties":{"id":"20240902105550-tivlogz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902105550-nofvnuz","Type":"NodeParagraph","Properties":{"id":"20240902105550-nofvnuz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"性状鉴别果实类球形或宽椭圆形，长7-10cm，直径6-8cm。表面橙黄色，皱缩或较光滑，顶端有圆形的花柱残基，基部略尖，具残存果梗。质脆，易破开，内表面共白色，有红黄色丝络，果瓤橙黄色，粘稠，与多数种子粘结成团。具焦糖气，味微酸甜。"}]},{"ID":"20240902105550-kxy32kz","Type":"NodeParagraph","Properties":{"id":"20240902105550-kxy32kz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"以个整齐、皮厚柔韧、皱缩、色杏黄或红黄、糖性足、不破者为佳。"}]},{"ID":"20240902105550-ssod9nt","Type":"NodeParagraph","Properties":{"id":"20240902105550-ssod9nt","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902105550-oscs4x6","Type":"NodeParagraph","Properties":{"id":"20240902105550-oscs4x6","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"1.栝楼仁含皂甙、有机酸及其盐、树脂、脂肪油及色素。脂肪油仿量为26%，其中饱和脂肪酸占30%，不饱和脂肪酸占66.5%，以栝楼酸(trichosanicacid)为主。此外，种子油中尚含有安石榴酸，可能为栝楼属种子油中的特片成分。油中还含有4个△5-萜类，6个△7-萜类，被鉴定为菜油甾醇、7，24-胆甾双烯醇、7，25-胆甾双烯醇，7，22，25-胆甾三烯醇。并分到豆甾完醇。"}]},{"ID":"20240902105550-ywensy4","Type":"NodeParagraph","Properties":{"id":"20240902105550-ywensy4","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"2.中华栝楼种子成分与栝楼种子大致相同，分得△7-豆甾烯醇葡萄糖甙和α-菠菜甾醇葡萄糖的混合物，及三个酚类化合物。"}]},{"ID":"20240902105550-u0939ik","Type":"NodeParagraph","Properties":{"id":"20240902105550-u0939ik","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"3.果实含三萜皂甙、有机酸、树脂、糖类和色素。种子含脂肪油。果实所含的蛋白质与其块根天花粉所含的蛋白质不同，参见天花粉条。栝楼果实含皂甙、有机酸及其盐类、树脂、脂肪油、色素、糖类，还含有精氨酸、赖氨酸、丙氨盐、缬氨酸、异亮氨酸、亮氨酸、甘氨酸及类生物碱物质，后者含有多个单体。果皮含棕榈酸、木蜡酸、蜡酸、蒙坦尼酸、蜂蜜酸、L-(一)-α-棕榈酸甘油酯、△7-豆甾烯醇、△7-豆甾烯酮-3和△7-豆甾烯醇-3-β-D-吡喃葡萄糖。并含钾、钠、钙、镁、铜、锌、铁、钼、铬等金属元素。"}]},{"ID":"20240902105550-oa1wcfq","Type":"NodeParagraph","Properties":{"id":"20240902105550-oa1wcfq","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902105550-qrwxcle","Type":"NodeParagraph","Properties":{"id":"20240902105550-qrwxcle","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"1.祛痰作用：动物实验表明，从瓜萎皮中分得的总氨基酸有良好的祛痰效果。"}]},{"ID":"20240902105550-qky8za0","Type":"NodeParagraph","Properties":{"id":"20240902105550-qky8za0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"2.泻下作用：瓜篓含致泻物质，有泻下作用。瓜蒌皮作用较弱；仁作用强；瓜蒌霜则作为缓和。"}]},{"ID":"20240902105550-vl1t8gu","Type":"NodeParagraph","Properties":{"id":"20240902105550-vl1t8gu","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用：瓜篓皮（35%）子（65%）水煎醇沉浓缩剂，以及瓜蒌皮浸膏经阳离子树脂交换所得的部分制成的注射液（简称瓜蒌注射液），均对豚鼠离体心脏有扩张冠脉的作用，而以后者更为显着。每1ml灌注液中含生药量为2.5或50mｇ时，可使冠脉流量分别增加55%或71%。在离体免心试验中亦有类似结果。瓜蒌注射液对垂体后时素引起的大鼠急性心肌缺血有明显的保护作用；且能明显提高小鼠对常压、低压缺氧的耐受力；对预先皮下注射给予异丙肾上腺素的小鼠，在低压缺氧情况下也能提高存活率，但并不延长司可巴比妥钠对小鼠的睡眠时间，提示其提高耐缺氧能力的作用与中枢神经系统无关。瓜蒌不同部位的扩冠作用强度为：瓜蒌皮＞瓜蒌霜＞瓜蒌子＞瓜蒌仁＞瓜蒌子壳。"}]},{"ID":"20240902105550-04robsv","Type":"NodeParagraph","Properties":{"id":"20240902105550-04robsv","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"4.抗菌作用：1：5-1：1瓜蒌煎剂或浸剂，在体外对大肠杆菌等革兰氏阴性肠内致病菌有抑制作用；并对葡萄球菌、肺炎双球菌、甲型溶血性链球菌、流感杆菌、奥杜盎氏小芽胞癣菌及星形奴卡氏菌等也有一定抑制作用。"}]},{"ID":"20240902105550-63x61bj","Type":"NodeParagraph","Properties":{"id":"20240902105550-63x61bj","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"5.抗癌作用：1：5瓜篓煎剂在体外（玻片法）能杀死小鼠腹水癌细胞。瓜蒌皮的体外抗癌效果比瓜蒌仁好，且以60%乙醇提取物作用最强。自瓜蒌皮的醚浸出液中得到的类白色非晶体粉末也有体外抗癌作用，动物试验表明，瓜蒌对肉瘤有一定的抑制作用。对腹水癌的作用不明显。亦有报道，瓜蒌制剂对小鼠移植性U-14、S-180等无效。"}]},{"ID":"20240902105550-gykztpl","Type":"NodeParagraph","Properties":{"id":"20240902105550-gykztpl","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"6.抗溃疡作用：括楼果实经50%乙醇在90℃提取三次后，真空干燥得一黑褐色粉末（TKE）。在幽门结扎的大鼠实验中，TKE500和1000mg/kg明显降低大鼠胃酸分泌及胃酸的浓度，100mg/lgTKE则使上述指标有所上升。100，500，1000mg/kgTKE对结扎幽门引赶快起的溃疡均有抑制作用，抑制率分别为44.4%、68.2%、84.1%。同剂量的TKE使水浸压法诱发的大鼠胃损伤分别减轻16.5%、51%和66.9%。对组胺引起的胃粘膜损伤虽然有所减轻，但差异无显着意义。TKE在500mg/kg、1000mg/kg时能保护5-羟色胺诱发的胃粘膜损伤，抑制率分别为59.1%和63.6%。用预防给药的方法，TKE（500，1000mg/kg）对盐酸乙醇诱发的胃粘膜损伤的抑制率分别为80.9%和94.8%，一些致坏死剂如1ml0.6molHCI和0.2molNaOH或35%NaCl可导致胃粘膜严重损伤，预先给予TKE可使损伤减轻。另外,TKE还能治愈乙酸所造成的胃溃疡。体外实验中，2.5×10（-3）g/kg和1.0×10（-2）g/kgTKE对乙酰胆碱引起的小鼠回肠收缩有明显的松弛作用。表明较高剂量的TKE具有抑制胃酸分泌及抗溃疡作用，TKE能减轻乙酸引起的溃疡，说明TKE可能具有治疗慢性溃疡的作用。"}]},{"ID":"20240902105550-w50dsmt","Type":"NodeParagraph","Properties":{"id":"20240902105550-w50dsmt","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"7.延缓衰老作用：2．5%瓜蒌酸醇提成分，观察具对果蝇生殖力的影响，在10-15天子代果蝇数目对照组为65.8±13.0只，而瓜蒌组为130.2±12.6（与对照组高峰期比较p＜0.01)；40-45天时，对照组的子代果蝇数目为4.9±1.6只，而瓜蒌组为25.5±1.8只（与对照组相应时间比较p＜0.01）。说明瓜蒌可明显增强果蝇生殖力，延缓其随龄退化。"}]},{"ID":"20240902105550-p11h6u7","Type":"NodeParagraph","Properties":{"id":"20240902105550-p11h6u7","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【毒性】瓜篓注射液小鼠1次腹腔注射或静脉注射的半数致死量分别为363±33g/kg和306±22g/kg。麻醉犬1次静滴100g/kg（相当临床用量的100倍），除在给药时血压有一过性的下降外，未见其它明显毒性反应。犬亚急性毒性试验，每日30g/kg，静脉注射21天，除个别犬在给药第周3胃纳较差和部分犬给药毕后出现肝细胞局部度浊肺外，也未见其它明显毒性反应。"}]},{"ID":"20240902105550-ns885sj","Type":"NodeParagraph","Properties":{"id":"20240902105550-ns885sj","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902105550-e54wqvh","Type":"NodeParagraph","Properties":{"id":"20240902105550-e54wqvh","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"显微鉴别种子横切面：（1）栝楼种皮表皮细胞1列，长方形，长36-55μm，直径10-22μm，壁具条状增厚纹理，在棱线处表皮细胞延长呈栅状；外被角质层。厚壁细胞6-15列，壁木化；外侧细胞较小，向内细胞大小不一，排列不规则；最内1-2列为石细胞，石细胞类方形或多角形，壁厚10-15μm。排列昆密。腔隙薄壁组织为4-6列星状细胞，壁微木化。色素层细胞挤压皱缩，界线不清楚。种脊维管束位于腔隙薄壁组织的两端。外胚乳外层细胞的外侧壁角质化，其余细胞皱缩，内胚乳细胞1列，类长方形，内含脂肪油滴及糊粉粒。子叶细胞充满糊粉粒及脂肪油滴。"}]},{"ID":"20240902105550-0bvpi6m","Type":"NodeParagraph","Properties":{"id":"20240902105550-0bvpi6m","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（2）中华栝楼种皮表皮细胞长34-72μm，直径12-48μm，外缘具齿状突起。厚壁细胞9-19列，阳内3-4列为石细胞，石细胞类方形或不规则我角形，壁厚10-12μm，镶嵌排列。"}]},{"ID":"20240902105550-1f9ia48","Type":"NodeParagraph","Properties":{"id":"20240902105550-1f9ia48","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：1、栝楼外果皮细胞1列，为近方形角质化厚壁细胞，外壁及侧壁均增厚，内为数层色素细胞，其下为石继胞环带，环的内侧国宽广的薄壁组织，其中有多数双韧型维管束，木质部多向外弯曲。本品薄壁细胞含少量草酸钙结晶。"}]},{"ID":"20240902105550-yqea8hj","Type":"NodeParagraph","Properties":{"id":"20240902105550-yqea8hj","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"（2）中华栝楼石细胞环内侧有散生石细胞群。木质部半圆形，不外弯。"}]},{"ID":"20240902105550-y55uaij","Type":"NodeParagraph","Properties":{"id":"20240902105550-y55uaij","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【炮制】去柄，洗净，置蒸笼内蒸至稍软，压扁，切成块。"}]},{"ID":"20240902105550-ov052sm","Type":"NodeParagraph","Properties":{"id":"20240902105550-ov052sm","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；微苦；性寒"}]},{"ID":"20240902105550-u908vhf","Type":"NodeParagraph","Properties":{"id":"20240902105550-u908vhf","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；胃；大肠经"}]},{"ID":"20240902105550-2kj9tqe","Type":"NodeParagraph","Properties":{"id":"20240902105550-2kj9tqe","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热化痰；宽胞散结；润燥滑肠。主肺热咳嗽；胸痹；消渴；便秘；痈肿疮毒"}]},{"ID":"20240902105550-u2rovx0","Type":"NodeParagraph","Properties":{"id":"20240902105550-u2rovx0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-20g；或入丸、散。外用：适量，捣敷。"}]},{"ID":"20240902105550-gl7xtgj","Type":"NodeParagraph","Properties":{"id":"20240902105550-gl7xtgj","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902105550-26e7s6h","Type":"NodeParagraph","Properties":{"id":"20240902105550-26e7s6h","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"脾胃虚寒，大便不实，有寒痰、湿痰者不宜。"}]},{"ID":"20240902105550-twm4x6d","Type":"NodeParagraph","Properties":{"id":"20240902105550-twm4x6d","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"1.《本草便读》：冷滑大肠，脾虚无火、大便不实者不可用。"}]},{"ID":"20240902105550-ku4bdp0","Type":"NodeParagraph","Properties":{"id":"20240902105550-ku4bdp0","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：脾胃虚及呕吐自利者不可用。"}]},{"ID":"20240902105550-0f00ixt","Type":"NodeParagraph","Properties":{"id":"20240902105550-0f00ixt","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【附方】①治小儿膈热咳嗽痰喘甚久不瘥：瓜蒌实一枚。去子，为末，以面和作饼子，炙黄为末。每服一钱，温水化乳糖下，日三服，效乃止。(《宣阴论方》润肺散)②治痰嗽：黄熟瓜蒌一个。取出子若干枚，照还去皮杏仁于内，火烧存性，醋糊为丸，如梧子大。每服二十丸，临卧时，白萝卜汤送下。(《鲁府禁方》)③治喘：栝蒌二个，明矾一块，如枣子大，入栝蒌内，烧煅存性，为末。将萝卜煮烂，蘸药末服之，汁过口。(《普济方》栝蒌散)④治小结胸病，正在心下，按之则痛，脉浮滑者：黄连一两，半夏(洗)半升，栝蒌实大者一枚。上三味，以水六升，先煮栝蒌，职三升，去滓，内诸药，煮取二升，去滓，分温三服。(《伤寒论》小陷胸汤)⑤治胸痹，喘息咳唾，胸背痛，短气，寸口脉沉而迟，关上小紧数：栝蒌实一枚(捣)，薤白半斤，白酒七升。上三味，同煮取二升，分温再服。(《金匮要略》栝蒌薤白白酒汤)⑥治胸痹不得卧，心痛彻背者：栝蒌实一枚(捣)，薤白三两，半夏半斤，白酒一斗。上四味，同煮取四升，温服一升，日三服。(《金医要略》栝萎薤白半夏汤)⑦治肺痿咳血不止：栝蒌五十个(连瓤，瓦焙)，乌梅肉五十个(焙)，杏仁(去皮、尖，炒)二十一个。为末。每用一捻，以猪肺一片切薄，掺末入内，炙熟，冷嚼咽之，日二服。(《圣济总录》)⑧治吐血：栝楼取端正者，纸筋和泥通裹，于预间留一眼子，煅存性，地坑内合一宿，去泥捣罗为散。每服三钱匕，糯米饮调下。(《圣济总录》黑神散)⑨治消渴热或心神烦乱：黄肥栝蒌一颗，以酒一中盏洗，取瓤，去皮、子，煎成膏，入白矾末一两，和丸如梧桐子大。每服不计时候，以粥饮下十丸。(《圣惠方》)⑩治时疾发黄，心狂烦热闷不认人者：大瓜蒌实一枚黄者，以新汲水九合，浸淘取汁，下蜜半大合，朴硝八分，合搅令消尽，分再服。(《海上集验方》)11.治小儿黄疸，脾热眼黄，并治酒黄：瓜蒌青者焙为末。每服一钱，水一盏，煎七分，去滓，临卧服，五更泻下黄物立可。(《普济方》逐黄散)12.治肺燥热渴，大肠秘：九月、十月间熟栝楼取瓤，以干葛粉拌，焙干，慢火炒熟，为末。食后、夜卧，以沸汤点三钱服。(《本草衍义》)13.治乳肿痛：栝蒌(黄色老大者)一枚熟捣，以白酒一斗，煮取四升，去滓，温一升，日三服。(《子母秘录》)14.治乳痈及一切痈疽初起，肿痛即消，脓成即溃，脓出即愈：瓜蒌一个(研烂)，生粉草、当归(酒洗)各半两，乳香、没药各一钱。上用酒煎服，良久再服。(《妇人良方》神效瓜蒌散)15.治酒癖，痰吐不止，两胁胀痛，气喘上奔，不下食饮：栝蒌瓤一两，神曲末半两(微炒)。上药捣细罗为散。每服，以葱白酒调下二钱。(《圣惠方》)16.治肠风下血：栝楼(烧为灰)、赤小豆各半两。上二味，杵罗为末。空心酒调下一钱匕。(《圣济总录》)17.治热游丹赤肿：栝楼末二大两，酽醋调敷之。(《产乳集验方》)18.治便毒初发：黄瓜蒌一个，黄连五钱。水煎连服。(《永类钤方》)"}]},{"ID":"20240902105550-lqijttw","Type":"NodeParagraph","Properties":{"id":"20240902105550-lqijttw","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902105550-ouss8kx","Type":"NodeParagraph","Properties":{"id":"20240902105550-ouss8kx","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"1.《本草衍义补遗》：栝楼实，《本草》言治胸痹，以味甘性润，甘能补肺，润能降气。胸有痰者，以肺受火逼，失降下之令，今得甘缓润下之助，则痰自降，宜其为治嗽之要药也。又洗涤胸膈中垢腻，治消渴之神药也。"}]},{"ID":"20240902105550-zfb3sqr","Type":"NodeParagraph","Properties":{"id":"20240902105550-zfb3sqr","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：张仲景治胸痹痛引心背，咳唾喘息，及结胸满痛，皆用栝楼实，乃取其甘寒不犯胃气，能降上焦之火，使痰气下降也。成无已不知此意，乃云苦寒以泻热，盖不尝其味原不苦，而随文附会尔。"}]},{"ID":"20240902105550-6qkrzy7","Type":"NodeParagraph","Properties":{"id":"20240902105550-6qkrzy7","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"3.《本草述》：栝楼实，阴厚而脂润，故于热燥之痰为对待的剂，若用之于寒痰、湿痰、气虚所结之痰，饮食积聚之痰，皆无益而有害者也。"}]},{"ID":"20240902105550-zazso8k","Type":"NodeParagraph","Properties":{"id":"20240902105550-zazso8k","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：栝楼实，其性较栝楼根稍平，而无寒郁之患。"}]},{"ID":"20240902105550-h2x3upa","Type":"NodeParagraph","Properties":{"id":"20240902105550-h2x3upa","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"5.《重庆堂随笔》：栝楼实，润燥开结，荡热涤痰，夫人知之；而不知其舒肝郁，润肝燥，平肝逆，缓肝急之功有独擅也，(魏)玉璜先生言之最详。"}]},{"ID":"20240902105550-n01ad6v","Type":"NodeParagraph","Properties":{"id":"20240902105550-n01ad6v","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"6.《本草便读》：瓜蒌，性味与花粉相同，惟润降之功过之。故凡上焦郁热，垢腻痰火咳嗽等证，皆可用之。一切肺痈、肠痈、乳痈之属火者，尤为相宜。"}]},{"ID":"20240902105550-hmiccgb","Type":"NodeParagraph","Properties":{"id":"20240902105550-hmiccgb","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"7.《本草思辨录》：栝楼实之长，在导痰浊下行，故结胸胸痹，非此不治。然能导之使行，不能逐之使去，盖其性柔，非济之以刚，则下行不力。是故小陷胸汤则有连、夏，栝楼薤白等汤则有薤、酒、桂、朴，皆伍以苦辛迅利之品，用其所长，又补其所短也。"}]},{"ID":"20240902105550-bbttvbz","Type":"NodeParagraph","Properties":{"id":"20240902105550-bbttvbz","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"8.《医学衷中参西录》：栝楼，能开胸间及胃口热痰，故仲景治结胸有小陷胸汤，栝楼与连、夏并用；治胸痹有栝楼薤白等方，栝楼与薤、酒、桂、朴诸药并用。若与山甲同用，善治乳痈；若与赭石同用，善止吐衄；若但用其皮，最能清肺、敛肺、宁嗽、定喘；若但用其瓤，最善滋阴、润燥、滑痰、生律；若但用其仁，其开胸降胃之力较大，且善通小便。"}]},{"ID":"20240902105550-riagg0a","Type":"NodeParagraph","Properties":{"id":"20240902105550-riagg0a","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"9.《本草正义》：蒌实入药，古人本无皮及子仁分用之例，仲景书以枚计，不以分量计，是其确证。盖蒌实能通胸膈之痹塞，而子善涤痰垢粘腻，一举两得。自《日华子本草》，有其子炒用一说，而景岳之《本草正》，只用其仁，张石顽之《逢原》，亦云去壳纸包压去油，则皆不用其壳，大失古人专治胸痹之义。且诸疡阳症，消肿散结，又皆以皮子并用为捷。观濒湖《纲目》附方极多，全用者十之九，古人衣钵，最不可忽。惟近今市肆，以蒌实老时，皮肉不粘，剖之不能成块，凡用全蒌者，皆乘其未老之时，摘取曝干而剖为数块，方能皮肉粘合，以取美观，然力量甚薄，却无功效。所以颐欲用其全者，宁以蒌皮、蒌仁，列为二物，乃能得其老者，始有实验，若但书全瓜蒌三字，则用如不用，此亦治医者不可不知药物之真性情也。即使但用其皮，亦是老而力足，疏通中满，确有奇能。"}]},{"ID":"20240902105550-6omlh85","Type":"NodeParagraph","Properties":{"id":"20240902105550-6omlh85","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗冠心病。每日用瓜蒌5钱，薤白4钱，制成片剂，三次分服。治疗25例，观察2-8周，22例有不同程度症状改善。16例心电图复查，14例示VsT波改善，2例恶化；12例服药前示S-T段压低者，10例改善，l例不变，l例恶化；服药前平均V5T波振幅为0.96mm，服药后平均T波振幅增至2.7mm；良药前平均S-T段下降O.84mm，服药后S-T段平均下降0.27mm。改变最明显l例在服药前二月发现有陈旧性前壁心肌梗死，心电图V2-V4QS波，T波倒置，服药后l女月病员症状明显改善，V2-V4Q波消失，V5T彼向上；另l例原有心绞痛及窦性静止，V5T波平坦，服药四月后T波回至正常，窦性静止消失。服药后少数病例感胃部不适，经服氢氧化铝后好转。观察中曾将瓜娄与薤白分开服用，结果病人均反应瓜蒌片疗效较薤白片为佳。此片对冠状动脉供血作用，可能与通过放松动脉紧张度，减少心脏负荷有关。"}]},{"ID":"20240902105550-rn5zjl3","Type":"NodeParagraph","Properties":{"id":"20240902105550-rn5zjl3","updated":"20240902105557"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902105552-l6qswkv","Type":"NodeThematicBreak","Properties":{"id":"20240902105552-l6qswkv","updated":"20240902105557"}},{"ID":"20240902105553-gfde8go","Type":"NodeParagraph","Properties":{"id":"20240902105553-gfde8go","updated":"20240902105557"}}]}