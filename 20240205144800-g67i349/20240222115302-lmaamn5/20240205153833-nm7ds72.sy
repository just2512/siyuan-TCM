Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：小山豆根"}]},{"ID":"20240830170131-i2nooc0","Type":"NodeParagraph","Properties":{"id":"20240830170131-i2nooc0","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"小山豆根《全国中草药汇编》"}]},{"ID":"20240830170131-obdvpqm","Type":"NodeParagraph","Properties":{"id":"20240830170131-obdvpqm","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【别名】山豆根[四川]"}]},{"ID":"20240830170131-mljr81w","Type":"NodeParagraph","Properties":{"id":"20240830170131-mljr81w","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【来源】防己科小山豆根StephaniaelegansHook.f.etThoms.，以根入药。"}]},{"ID":"20240830170131-fzukwc8","Type":"NodeParagraph","Properties":{"id":"20240830170131-fzukwc8","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【生境分布】四川。"}]},{"ID":"20240830170131-0rregk8","Type":"NodeParagraph","Properties":{"id":"20240830170131-0rregk8","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒。"}]},{"ID":"20240830170131-9a8aol7","Type":"NodeParagraph","Properties":{"id":"20240830170131-9a8aol7","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，止痛杀虫。主治咽喉肿痛，牙痛，痔肿，腹痛下痢，咳嗽气喘，驱蛲虫，蛇咬伤，蜘蛛伤。"}]},{"ID":"20240830170131-m5rqk5f","Type":"NodeParagraph","Properties":{"id":"20240830170131-m5rqk5f","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【用法用量】1～3钱，水煎服。"}]},{"ID":"20240830170131-5slentm","Type":"NodeParagraph","Properties":{"id":"20240830170131-5slentm","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830170131-bkqz76p","Type":"NodeParagraph","Properties":{"id":"20240830170131-bkqz76p","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"小山豆根《中华本草》"}]},{"ID":"20240830170131-jej1ecc","Type":"NodeParagraph","Properties":{"id":"20240830170131-jej1ecc","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiǎoShānDòuGēn"}]},{"ID":"20240830170131-g3zvguf","Type":"NodeParagraph","Properties":{"id":"20240830170131-g3zvguf","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【别名】山豆根"}]},{"ID":"20240830170131-9358u0g","Type":"NodeParagraph","Properties":{"id":"20240830170131-9358u0g","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830170131-e6chq77","Type":"NodeParagraph","Properties":{"id":"20240830170131-e6chq77","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"药材基源：为防己科植物四川千金藤的根。"}]},{"ID":"20240830170131-tx37yl2","Type":"NodeParagraph","Properties":{"id":"20240830170131-tx37yl2","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：StephaniasutchuenensisH.S.Lo"}]},{"ID":"20240830170131-90cwmpn","Type":"NodeParagraph","Properties":{"id":"20240830170131-90cwmpn","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋季采挖，洗净，晒干。"}]},{"ID":"20240830170131-w7tmz2q","Type":"NodeParagraph","Properties":{"id":"20240830170131-w7tmz2q","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【原形态】四川千金藤多年生草质藤本，主根条状。茎枝纤细，有直纹，质稍硬。叶互生；叶柄着生在距叶片基部约1cm处，长4-7cm，盾状着生；叶片三角形，长6-10cm，宽5.5-9.5cm，先端有时钝，基部近平截，全缘，两面绿色，下面无毛；掌状脉向上3条，向下4-5条，在叶下面明显突起，网脉稍明显，薄革质。花小，单性，雌雄异株；雄株和雌株均为单伞形聚伞花序，腋生；雄花序总花序梗与叶柄近等长，细而直，顶端无小苞片，小聚伞花序4-8，簇生于花序梗末端，每个小聚伞花序有3-7朵花，具花梗；雄花：萼片6，绿色，排成2轮，卵圆形或卵形，先端尾状渐尖，长1.7-2mm，其中尾状部分长0.6-0.9mm；花瓣3，淡黄色，贝壳状，长0.6-0.7mm，宽1-1.2mm，稍肉质；聚药雄蕊与花瓣近等长；雌花：果序腋生，序梗长8-9cm。核果倒卵形，内果皮长约7mm，背部有2行小横肋雕纹，每行7-8条，胎座迹穿孔。"}]},{"ID":"20240830170131-4i4lcwn","Type":"NodeParagraph","Properties":{"id":"20240830170131-4i4lcwn","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830170131-o5c0atz","Type":"NodeParagraph","Properties":{"id":"20240830170131-o5c0atz","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山地。"}]},{"ID":"20240830170131-efqxzis","Type":"NodeParagraph","Properties":{"id":"20240830170131-efqxzis","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于四川。"}]},{"ID":"20240830170131-rcgd0ri","Type":"NodeParagraph","Properties":{"id":"20240830170131-rcgd0ri","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【性味】苦；寒"}]},{"ID":"20240830170131-4jgqfxr","Type":"NodeParagraph","Properties":{"id":"20240830170131-4jgqfxr","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【归经】肺；心；大肠经"}]},{"ID":"20240830170131-07yg97l","Type":"NodeParagraph","Properties":{"id":"20240830170131-07yg97l","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；止痛；杀虫。主咽喉肿痛；牙痛；腹痛；痔疮肿痛；蛇虫咬伤；蛲虫病"}]},{"ID":"20240830170131-s0r96gd","Type":"NodeParagraph","Properties":{"id":"20240830170131-s0r96gd","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g。"}]},{"ID":"20240830170131-j8db9s5","Type":"NodeParagraph","Properties":{"id":"20240830170131-j8db9s5","updated":"20240830170137"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830170132-mnh7qo5","Type":"NodeThematicBreak","Properties":{"id":"20240830170132-mnh7qo5","updated":"20240830170137"}},{"ID":"20240830170133-zwkxi4e","Type":"NodeParagraph","Properties":{"id":"20240830170133-zwkxi4e","updated":"20240830170137"}}]}