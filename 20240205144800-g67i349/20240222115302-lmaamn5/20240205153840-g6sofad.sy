assets/马勃 3-20240730094235-xot22f3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 723px;\" parent-style=\"width: 733px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730094209-fb22tay","Type":"NodeParagraph","Properties":{"id":"20240730094209-fb22tay","updated":"20240730095631"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 2-20240730094209-cfxozer.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 860px;","style":"width: 850px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 5-20240730095631-bp4xaou.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 850px;\" parent-style=\"width: 860px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730093943-m4sy9eg","Type":"NodeParagraph","Properties":{"id":"20240730093943-m4sy9eg","updated":"20240730100930"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 923px;","style":"width: 913px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 6-20240730095949-nnfj86a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 913px;\" parent-style=\"width: 923px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 349px;","style":"width: 339px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 7-20240730100930-rpm41uc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 339px;\" parent-style=\"width: 349px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730101602-9bjnaob","Type":"NodeParagraph","Properties":{"id":"20240730101602-9bjnaob","updated":"20240730101606"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云南硬皮马勃"}]},{"ID":"20240730101648-72f9vvj","Type":"NodeParagraph","Properties":{"id":"20240730101648-72f9vvj","updated":"20240730102337"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 653px;","style":"width: 643px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 12-20240730101844-btr3k3w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 14-20240730102337-35fpwo7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730101846-5jim3l8","Type":"NodeParagraph","Properties":{"id":"20240730101846-5jim3l8","updated":"20240730102409"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 750px;","style":"width: 740px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 15-20240730102409-5nsosnj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 740px;\" parent-style=\"width: 750px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 495px;","style":"width: 485px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马勃 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马勃 13-20240730101933-ox1knky.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 485px;\" parent-style=\"width: 495px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730100807-jsllt2l","Type":"NodeParagraph","Properties":{"id":"20240730100807-jsllt2l","updated":"20240730101503"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：大马勃嫩的时候可食，老了晒干可入药（云南硬皮马勃吃了容易拉肚子）；"}]},{"ID":"20240730094218-0zcs7v0","Type":"NodeThematicBreak","Properties":{"id":"20240730094218-0zcs7v0"}},{"ID":"20240903091925-dmox7x6","Type":"NodeParagraph","Properties":{"id":"20240903091925-dmox7x6","updated":"20240903091933"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：马勃"}]},{"ID":"20240903091925-b0rvjeg","Type":"NodeParagraph","Properties":{"id":"20240903091925-b0rvjeg","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"马勃《全国中草药汇编》"}]},{"ID":"20240903091925-372rnwy","Type":"NodeParagraph","Properties":{"id":"20240903091925-372rnwy","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎBó"}]},{"ID":"20240903091925-a80iojn","Type":"NodeParagraph","Properties":{"id":"20240903091925-a80iojn","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【英文名】LASIOSPHAERASEUCALVATIA"}]},{"ID":"20240903091925-su64m95","Type":"NodeParagraph","Properties":{"id":"20240903091925-su64m95","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【别名】灰包、马粪包"}]},{"ID":"20240903091925-oe3xurv","Type":"NodeParagraph","Properties":{"id":"20240903091925-oe3xurv","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【来源】本品为灰包科真菌脱皮马勃LasiosphaerafenzliiReich.、大马勃Calvatiagigantea（BatschexPers。）Lloyd.或紫色马勃Calvatialilacina（Mont.etBerk.）Lloyd的干燥子实体。夏、秋二季子实体成熟时及时采收，除去泥沙，干燥。"}]},{"ID":"20240903091925-nsgiwy2","Type":"NodeParagraph","Properties":{"id":"20240903091925-nsgiwy2","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903091925-qkomn4x","Type":"NodeParagraph","Properties":{"id":"20240903091925-qkomn4x","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"脱皮马勃：呈扁球形或类球形，无不孕基部，直径15～20cm。包被灰棕色至黄褐色，纸质，常破碎呈块片状，或已全部脱落。孢体灰褐色或浅褐色，紧密，有弹性，用手撕之，内有灰褐色棉絮状的丝状物。触之则孢子呈尘土样飞扬，手捻有细腻感。臭似尘土，无味。"}]},{"ID":"20240903091925-u47zufn","Type":"NodeParagraph","Properties":{"id":"20240903091925-u47zufn","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"大马勃：不孕基部小或无。残留的包被由黄棕色的膜状外包被和较厚的灰黄色的内包被所组成，光滑，质硬而脆，成块脱落。孢体浅青褐色，手捻有润滑感。"}]},{"ID":"20240903091925-fih3871","Type":"NodeParagraph","Properties":{"id":"20240903091925-fih3871","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"紫色马勃：呈陀螺形，或已压扁呈扁圆形，直径5～12cm，不孕基部发达。包被薄，两层，紫褐色，粗皱，有圆形凹陷，外翻，上部常裂成小块或已部分脱落。孢体紫色。"}]},{"ID":"20240903091925-v04qzs4","Type":"NodeParagraph","Properties":{"id":"20240903091925-v04qzs4","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240903091925-dv0jrx0","Type":"NodeParagraph","Properties":{"id":"20240903091925-dv0jrx0","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"（1）取本品置火焰上，轻轻抖动，即可见微细的火星飞扬，熄灭后，发生大量白色浓烟。"}]},{"ID":"20240903091925-yq9zzql","Type":"NodeParagraph","Properties":{"id":"20240903091925-yq9zzql","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"（2）脱皮马勃粉末灰褐色。孢丝长，淡褐色，有分枝，相互交织，直径2～4。5μm，壁厚。孢子褐色，球形，直径4。5～5μｍ，有小刺，长1。5～3μｍ。"}]},{"ID":"20240903091925-vec02ko","Type":"NodeParagraph","Properties":{"id":"20240903091925-vec02ko","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"大马勃粉末淡青褐色。孢丝稍分枝，有稀少横隔，直径2。5～6μm。孢子淡青黄色，光滑或有时具微细疣点，直径3。5～5μｍ。"}]},{"ID":"20240903091925-afqsud8","Type":"NodeParagraph","Properties":{"id":"20240903091925-afqsud8","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"紫色马勃粉末灰紫色。孢丝分枝，有横隔，直径2～5μｍ，壁厚。孢子紫色，直径4～5。5μｍ，有小刺。"}]},{"ID":"20240903091925-mmcu6vs","Type":"NodeParagraph","Properties":{"id":"20240903091925-mmcu6vs","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"（3）取本品碎块1g，加乙醇与0。1mol/L氢氧化钠溶液各8ml浸湿，低温烘干，缓缓炽灼，于700℃使完全灰化，放冷，残渣加水10ml使溶解，滤过，滤液显磷酸盐（附录Ⅳ）的鉴别反应。"}]},{"ID":"20240903091925-f4r8qh1","Type":"NodeParagraph","Properties":{"id":"20240903091925-f4r8qh1","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，剪成小块。"}]},{"ID":"20240903091925-nz8ycjr","Type":"NodeParagraph","Properties":{"id":"20240903091925-nz8ycjr","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性味】辛，平。"}]},{"ID":"20240903091925-xiwu4q0","Type":"NodeParagraph","Properties":{"id":"20240903091925-xiwu4q0","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【归经】归肺经。"}]},{"ID":"20240903091925-9ndeo07","Type":"NodeParagraph","Properties":{"id":"20240903091925-9ndeo07","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【功能主治】清肺利咽，止血。用于风热郁肺咽痛，咳嗽，音哑；外治鼻衄，创伤出血。"}]},{"ID":"20240903091925-olnjtrt","Type":"NodeParagraph","Properties":{"id":"20240903091925-olnjtrt","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【用法用量】1。5～6g。外用适量，敷患处。"}]},{"ID":"20240903091925-4j833uw","Type":"NodeParagraph","Properties":{"id":"20240903091925-4j833uw","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防尘。"}]},{"ID":"20240903091925-l2s9xsd","Type":"NodeParagraph","Properties":{"id":"20240903091925-l2s9xsd","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240903091925-6wib9lr","Type":"NodeParagraph","Properties":{"id":"20240903091925-6wib9lr","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"（1）作马勃入药尚有下列数种：（1）灰包科脱皮马勃属植物大口静灰球BovistellasinensisLloyd。分布于吉林、河北、陕西、山西、甘肃、江苏、广东、贵州等省；（2）长根静灰球Bovistellatadicata（Mont.）Pat.分布于吉林、甘肃、四川等省；（3）硬皮马勃科硬皮马勃属植物光硬皮马勃SclerodermacepaPers.又名硬马勃、小圆子马勃，分布于河南、江苏、浙江、湖北、湖南、四川、云南等省；（4）粗硬皮马勃SclerodermageasterFr.分部于湖北、湖南、四川等省；（5）硬皮马勃科豆包属植物豆包菌Pisolithustinctorius（Pers.）CokererCouch，分布于江苏、安徽、福建、浙江、江西、广东、广西、四川、云南等省；（6）灰包科灰包属植物多形灰包LycoperdonpolymorphumVitt，分布于河北、新疆、青海、江苏、浙江、江西等省，在云南作马勃用；（7）灰包科栓皮马勃属植物栓皮马勃Mycenastrumcorium（Guers.）Desv.分布于内蒙、河北、新疆、青海等省。此外，灰包科马勃属植物龟裂马勃Calvatiacaelata（Bull.exDC.）Morg.和灰包菇科灰包菇属植物灰包菇Secotiumagaricoides（Czern.）Hollos等的子实体在内蒙古个别地区也作马勃用。"}]},{"ID":"20240903091925-kke311w","Type":"NodeParagraph","Properties":{"id":"20240903091925-kke311w","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"（2）治咳嗽失音、咽喉肿痛，常与银花、山栀、薄荷、牛蒡子、玄参等同用。"}]},{"ID":"20240903091925-1ntlhdt","Type":"NodeParagraph","Properties":{"id":"20240903091925-1ntlhdt","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240903091925-wz8l6ea","Type":"NodeParagraph","Properties":{"id":"20240903091925-wz8l6ea","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"马勃《*辞典》"}]},{"ID":"20240903091925-d615kc5","Type":"NodeParagraph","Properties":{"id":"20240903091925-d615kc5","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240903091925-kepud21","Type":"NodeParagraph","Properties":{"id":"20240903091925-kepud21","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎBó"}]},{"ID":"20240903091925-zhvugfs","Type":"NodeParagraph","Properties":{"id":"20240903091925-zhvugfs","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【别名】马疕（《别录》），马屁勃（陶弘景），马疕苗（《蜀本草》），灰菇（《经验良力》），马屁包（《袖珍方》），牛屎菇（《纲目》），灰包菌（（中药形性经验鉴别法》），药苞（《河北药材》），人头菌、牛屎菌、大气菌、灰菌（《南宁市药物志》），鸡肾菌、地烟（《广西中药志》）。"}]},{"ID":"20240903091925-yfr6228","Type":"NodeParagraph","Properties":{"id":"20240903091925-yfr6228","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【来源】为马勃科植物脱皮马勃、大颓马勃、紫颓马勃的干燥子实体。7～9月，当子实体刚成热时采收，拔起后，去净泥沙，晒干。本品在霉雨季节生长很快，4～5日即成熟，应注意适时收采，过早过迟均影响质量。"}]},{"ID":"20240903091925-t6yrrf9","Type":"NodeParagraph","Properties":{"id":"20240903091925-t6yrrf9","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903091925-46hi262","Type":"NodeParagraph","Properties":{"id":"20240903091925-46hi262","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①脱皮马勃"}]},{"ID":"20240903091925-17u110y","Type":"NodeParagraph","Properties":{"id":"20240903091925-17u110y","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"子实体近球形至长圆形，直径15～20厘米。包被薄，易消失，外包被成块地与内包被脱离，内包被纸状，浅烟色，成熟后全部消失，遗留成团的孢体随风滚动。孢体紧密。有弹性，灰褐色，渐退成浅烟色，由孢丝及孢子组成；孢丝长，分枝，相互交织，浅褐色，粗2～4.5微米；孢子褐色，球形，有小刺。直径4.5～5微米."}]},{"ID":"20240903091925-ilwis0v","Type":"NodeParagraph","Properties":{"id":"20240903091925-ilwis0v","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"生于草地上。分布内蒙古、河北、陕西、甘肃、新疆、江苏、安徽、湖北、湖南、贵州等地。"}]},{"ID":"20240903091925-67wwtyi","Type":"NodeParagraph","Properties":{"id":"20240903091925-67wwtyi","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②大颓马勃"}]},{"ID":"20240903091925-oy2gfxo","Type":"NodeParagraph","Properties":{"id":"20240903091925-oy2gfxo","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"孑实体球形或近球形，直径15～20厘米，或更大，不孕基部无或很小；包被白色，后变浅黄或淡青黄色，由膜状外被和较厚的内被所组成，初微具绒毛，渐变光滑，质脆，成熟后开裂成块而脱落，露出浅青褐色的孢体；孢子粉状，球形，光滑或有时具细微小疣，淡青黄色，直径3.5～5微米；孢丝长，与孢子同色，稍分枝，有稀少横隔，粗2.5～6微米。"}]},{"ID":"20240903091925-co9r6pe","Type":"NodeParagraph","Properties":{"id":"20240903091925-co9r6pe","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"生于旷野草地上。分布辽宁、内蒙古、河北、山西、甘肃、新疆、青海、江苏等地。"}]},{"ID":"20240903091925-3amdnpi","Type":"NodeParagraph","Properties":{"id":"20240903091925-3amdnpi","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"③紫颓马勃"}]},{"ID":"20240903091925-ti9mpys","Type":"NodeParagraph","Properties":{"id":"20240903091925-ti9mpys","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"子实体陀螺形，直径5～12厘米，不孕基部发达；包被薄，两层，上部常裂成小块，逐渐脱落，内部紫色，当孢子及孢丝散失后遗留的不孕基部呈杯状；孢子粉状，球形，直径4～5.5微米，上有小刺；孢丝很长，分枝，有横隔，互相交织，色淡，粗2～5微米，"}]},{"ID":"20240903091925-b79dvlo","Type":"NodeParagraph","Properties":{"id":"20240903091925-b79dvlo","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"生旷野草地上。分布河北、新疆、青海、四川、湖北、安徽、江苏、广西、福建、海南等地。"}]},{"ID":"20240903091925-qwh3v31","Type":"NodeParagraph","Properties":{"id":"20240903091925-qwh3v31","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903091925-br11870","Type":"NodeParagraph","Properties":{"id":"20240903091925-br11870","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①脱皮马勃的子实体呈扁球形或类球形，直径15～18厘米或更大。外皮灰棕色至黄褐色，纸质，常破碎呈块片状，或已全部脱落。除去外皮的马勃呈黄棕色或棕褐色棉絮状。体轻泡、柔软，有弹性，内藏大量孢子，轻微捻动即有粉尘状孢子飞出。用手捻之有细腻柔软感。气味微弱。以个大、饱满、松泡有弹性者为佳。"}]},{"ID":"20240903091925-uwhsu3r","Type":"NodeParagraph","Properties":{"id":"20240903091925-uwhsu3r","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"产内蒙古、河北、甘肃、陕西、江苏、湖北等地。"}]},{"ID":"20240903091925-y13ipf4","Type":"NodeParagraph","Properties":{"id":"20240903091925-y13ipf4","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②大颓马勃的子实体已压扁呈不规则的块状。外包被较厚硬而脆，黄棕色。内包被灰黄色，纸质，里面为孢体，淡青褐色，絮状，轻轻捻动即有尘状孢子飞出。气微弱，味微苦涩。"}]},{"ID":"20240903091925-zgvfdju","Type":"NodeParagraph","Properties":{"id":"20240903091925-zgvfdju","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"主产于青海。"}]},{"ID":"20240903091925-4cbvds5","Type":"NodeParagraph","Properties":{"id":"20240903091925-4cbvds5","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"③紫颓马勃的子实体呈扁圆形或杯形，直径5～12厘米。基部有小柄，包被紫褐色，粗皱，有圆形凹陷，包被薄，外翻。上部包被已脱落，露出紫色絮状孢体。体轻泡有弹性，用手捻之有大量孢子飞扬。气味微弱。"}]},{"ID":"20240903091925-lkghf91","Type":"NodeParagraph","Properties":{"id":"20240903091925-lkghf91","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"主产江苏、湖北、广西等地。"}]},{"ID":"20240903091925-f3y2n78","Type":"NodeParagraph","Properties":{"id":"20240903091925-f3y2n78","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【化学成份】含马勃素（emmatein）、麦角甾醇磷酸铂及亮氨酸、酪氨酸等氨基酸。"}]},{"ID":"20240903091925-bptby28","Type":"NodeParagraph","Properties":{"id":"20240903091925-bptby28","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903091925-129a01z","Type":"NodeParagraph","Properties":{"id":"20240903091925-129a01z","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"除去硬皮，切成方块。"}]},{"ID":"20240903091925-sy4x0jc","Type":"NodeParagraph","Properties":{"id":"20240903091925-sy4x0jc","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"凡用，以生布张开，将马勃于上磨擦，下以盘承取末用。\""}]},{"ID":"20240903091925-5v1wby2","Type":"NodeParagraph","Properties":{"id":"20240903091925-5v1wby2","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903091925-p1ek3eo","Type":"NodeParagraph","Properties":{"id":"20240903091925-p1ek3eo","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"辛，平。"}]},{"ID":"20240903091925-c6uf33l","Type":"NodeParagraph","Properties":{"id":"20240903091925-c6uf33l","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味辛，平，无毒。\""}]},{"ID":"20240903091925-e4zgdx4","Type":"NodeParagraph","Properties":{"id":"20240903091925-e4zgdx4","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"辛咸，平。\""}]},{"ID":"20240903091925-pj2jx3u","Type":"NodeParagraph","Properties":{"id":"20240903091925-pj2jx3u","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【归经】《纲目》：\"肺经。\""}]},{"ID":"20240903091925-6esycnd","Type":"NodeParagraph","Properties":{"id":"20240903091925-6esycnd","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903091925-9zcr7x6","Type":"NodeParagraph","Properties":{"id":"20240903091925-9zcr7x6","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"清肺利咽，解毒，止血。治喉痹咽痛，咳嗽失音，吐血，衄血，外伤出血。"}]},{"ID":"20240903091925-ilz1g4f","Type":"NodeParagraph","Properties":{"id":"20240903091925-ilz1g4f","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主恶疮、马疥。\""}]},{"ID":"20240903091925-6yxpsqu","Type":"NodeParagraph","Properties":{"id":"20240903091925-6yxpsqu","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"敷诸疮。\""}]},{"ID":"20240903091925-td5emhj","Type":"NodeParagraph","Properties":{"id":"20240903091925-td5emhj","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"③《本草衍义》：\"去膜，以蜜揉拌，少以水调呷，治喉闭咽痛。\""}]},{"ID":"20240903091925-ql0btgq","Type":"NodeParagraph","Properties":{"id":"20240903091925-ql0btgq","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"清肺，散血热，解毒。\"\"能清肺热咳嗽，喉痹，衄血，失音诸病。\""}]},{"ID":"20240903091925-y198mgv","Type":"NodeParagraph","Properties":{"id":"20240903091925-y198mgv","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑤《玉楸药解》：\"治骨鲠吐血。\""}]},{"ID":"20240903091925-mgu3d8e","Type":"NodeParagraph","Properties":{"id":"20240903091925-mgu3d8e","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.5～1钱；或入丸、散。外用：研末撒、调敷、或作吹药。"}]},{"ID":"20240903091925-12ptbkb","Type":"NodeParagraph","Properties":{"id":"20240903091925-12ptbkb","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【注意】《饮片新参》：\"风寒劳咳失音者忌用。\""}]},{"ID":"20240903091925-a5q9uwi","Type":"NodeParagraph","Properties":{"id":"20240903091925-a5q9uwi","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903091925-e2o0ne6","Type":"NodeParagraph","Properties":{"id":"20240903091925-e2o0ne6","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①治咽喉肿痛，咽物不得：蛇脱皮一条（烧令烟尽），马勃一分。上药细研为散，以绵裹一钱，含咽津。（《圣惠方》）"}]},{"ID":"20240903091925-0nuns0t","Type":"NodeParagraph","Properties":{"id":"20240903091925-0nuns0t","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②治急喉闭：马屁勃、焰硝各一两。上为末，每用一字许，吹入喉内，吐涎血出，愈。（《经验良方》）"}]},{"ID":"20240903091925-hhvjcay","Type":"NodeParagraph","Properties":{"id":"20240903091925-hhvjcay","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"③治久嗽：马屁勃不以多少，细末，炼蜜为丸，如梧桐子大，每服二十丸，汤送下。（《普济方》马屁勃丸）"}]},{"ID":"20240903091925-t616ylu","Type":"NodeParagraph","Properties":{"id":"20240903091925-t616ylu","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"④治声失不出：马屁勃、马牙消等分，研末，沙糖和丸芡子大，噙之。（《摘元方》）"}]},{"ID":"20240903091925-97u2oyr","Type":"NodeParagraph","Properties":{"id":"20240903091925-97u2oyr","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑤治吐血：马屁包，为末，砂糖丸如弹子大，每服半丸，冷水下。（《袖珍方》）"}]},{"ID":"20240903091925-8agfyfc","Type":"NodeParagraph","Properties":{"id":"20240903091925-8agfyfc","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑥治妊娠吐衄不止：马勃末，浓米饮服半钱。（《圣惠方》）"}]},{"ID":"20240903091925-9b07f0f","Type":"NodeParagraph","Properties":{"id":"20240903091925-9b07f0f","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑦治大头天行，初觉憎寒体重，次传头面肿盛，口不能开，上喘，咽喉不利，口渴舌燥：黄芩（酒炒）、黄连（酒炒）各五钱，陈皮（去白）、生甘草、元参、柴胡、桔梗各二钱，连翘、板蓝根、马勃、鼠粘子、薄荷各一钱，僵蚕、升麻各七分。为末，汤调，时时服之。或蜜拌为丸，噙化。（李杲·普济消毒饮）"}]},{"ID":"20240903091925-7wshnzu","Type":"NodeParagraph","Properties":{"id":"20240903091925-7wshnzu","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑧治臁疮不敛：葱盐汤洗净，拭干，以马屁勃末敷之。（《稗史》）"}]},{"ID":"20240903091925-h99w1f3","Type":"NodeParagraph","Properties":{"id":"20240903091925-h99w1f3","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑨治痈疽：马勃擦粉，米醋调敷即消；并入连翘少许，煎服亦可。（《外科良方》）"}]},{"ID":"20240903091925-b2l5cwy","Type":"NodeParagraph","Properties":{"id":"20240903091925-b2l5cwy","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903091925-41qb1sh","Type":"NodeParagraph","Properties":{"id":"20240903091925-41qb1sh","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"脱皮马勃外用止血"}]},{"ID":"20240903091925-e0jigs4","Type":"NodeParagraph","Properties":{"id":"20240903091925-e0jigs4","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"其剂型有：㈠马勃粉（马勃孢子）：将马勃剥去顶部包被，挖出内容物，筛出孢子，或置锥形瓶内摇动，使孢于落下，收集孢子，高压消毒即成。㈡马勃菌丝海绵（马勃絮垫）：将马勃除去包被，切成不同厚薄、不同大小的块状，高压消毒。㈢马勃绷带及马勃纱布：用45％酒精加入适量马勃粉，使之成为4％马勃混悬液，随将绷带或纱布浸入，浸透后取出挤去液体，干热消毒。"}]},{"ID":"20240903091925-yxf55u9","Type":"NodeParagraph","Properties":{"id":"20240903091925-yxf55u9","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"①用于外科手术止血"}]},{"ID":"20240903091925-aajwgtg","Type":"NodeParagraph","Properties":{"id":"20240903091925-aajwgtg","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"观察前列腺摘除术25例、肝脾破裂出血各2例、肾部分切除术1例、肝叶切除3例，阻塞性黄疸手术中止血1例，均达止血效果，无并发症及不良反应。马勃菌丝海绵的用法基本与其他动植物止血海绵相同，使用前不用水浸泡，直接贴于创面，稍加压迫即可。应用马勃粉时先用纱布保护周围脏器，在创面撒布马勃粉后，稍加压迫即可。马勃粉用量较少，粘着性强，撒于实质脏器出血创面很薄一层，不用任何敷盖物即可止血。实质脏器部分切除之出血创面，或外伤破裂之创面，用马勃止血，可避免大块缝扎组织及由此而引起的组织坏死、继发感染、再出血等。用于前列腺摘除的止血，因马勃粉末极细不致阻塞尿路；且压迫前列腺囊壁也较均匀；肉眼血尿消失时间最长为3天，较其他方法3～7天血尿消失有明显缩短；又因其具有抑菌作用，可防止感染；异物反应也较小。一部分泌尿道手术采用马勃止血后，有废弃历来在膀胱、尿道内留置导尿管等的可能。初步认为马勃的止血原理属于物理机械性作用。"}]},{"ID":"20240903091925-3647xvt","Type":"NodeParagraph","Properties":{"id":"20240903091925-3647xvt","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"②用于口腔科止血"}]},{"ID":"20240903091925-64x2led","Type":"NodeParagraph","Properties":{"id":"20240903091925-64x2led","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"拔牙时牙槽窝出血，放置马勃絮垫填压即能止血；口腔粘膜因外伤而呈粉碎性撕裂所致出血、缝合困难者，或牙龈渗血、创伤面暴露者，以马勃粉撒布，用纱布压迫亦能止血。由于马勃絮垫不能完全被组织所吸收，故不能作组织内埋藏止血或死腔填塞之用。"}]},{"ID":"20240903091925-bndlc5u","Type":"NodeParagraph","Properties":{"id":"20240903091925-bndlc5u","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"③用于鼻出血"}]},{"ID":"20240903091925-zjtfakt","Type":"NodeParagraph","Properties":{"id":"20240903091925-zjtfakt","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"取马勃絮垫放于出血点上，轻轻加压。据113例观察，109例皆获良效。"}]},{"ID":"20240903091925-l94r0wv","Type":"NodeParagraph","Properties":{"id":"20240903091925-l94r0wv","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"④用于外伤出血"}]},{"ID":"20240903091925-wlr8dde","Type":"NodeParagraph","Properties":{"id":"20240903091925-wlr8dde","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"对于切伤、挫伤、刺伤等出血，可用马勃粉撒布或马勃絮垫、马勃绷带、马勃纱布包扎。据467例观察，有效率占97.8％。"}]},{"ID":"20240903091925-u7bqk9e","Type":"NodeParagraph","Properties":{"id":"20240903091925-u7bqk9e","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"⑤其他"}]},{"ID":"20240903091925-9biflv6","Type":"NodeParagraph","Properties":{"id":"20240903091925-9biflv6","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"马勃还可以制成丸剂、含片，治疗上呼吸道感染；或制成软膏治疗冻疮。疖肿等，均有一定疗效。"}]},{"ID":"20240903091925-9jnxoie","Type":"NodeParagraph","Properties":{"id":"20240903091925-9jnxoie","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240903091925-imi7t1d","Type":"NodeParagraph","Properties":{"id":"20240903091925-imi7t1d","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"除上述品种外，尚有同科植物埃蕈（又名：有柄马勃）的干燥子实体，亦同等入药。形似马勃而小，直径通常只2～4厘米，上部扁圆，下有短柄；皮较硬脆，内部不呈海绵状。"}]},{"ID":"20240903091925-i5dw7d6","Type":"NodeParagraph","Properties":{"id":"20240903091925-i5dw7d6","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"产四川、湖北、云南、江西、广东、浙江、湖南等地。"}]},{"ID":"20240903091925-ioe2o8n","Type":"NodeParagraph","Properties":{"id":"20240903091925-ioe2o8n","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903091925-zewjwkw","Type":"NodeParagraph","Properties":{"id":"20240903091925-zewjwkw","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"马勃《中华本草》"}]},{"ID":"20240903091925-8hcrhyf","Type":"NodeParagraph","Properties":{"id":"20240903091925-8hcrhyf","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【出处】出自《名医别录》"}]},{"ID":"20240903091925-n935rp2","Type":"NodeParagraph","Properties":{"id":"20240903091925-n935rp2","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【拼音名】MǎBó"}]},{"ID":"20240903091925-d8rv3ok","Type":"NodeParagraph","Properties":{"id":"20240903091925-d8rv3ok","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【别名】马疕、马庀菌、灰菇、马屁包、香末菇、乌龙菌、牛屎菇、灰包菌、药包、人头菌、牛屎菌、大气菌、灰菌、鸡肾菌、地烟"}]},{"ID":"20240903091925-4wipi1s","Type":"NodeParagraph","Properties":{"id":"20240903091925-4wipi1s","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903091925-pag47tc","Type":"NodeParagraph","Properties":{"id":"20240903091925-pag47tc","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"药材基源：为灰包科真菌紫色秃马勃、脱皮马勃、大秃马勃等的子实体。"}]},{"ID":"20240903091925-6on54sz","Type":"NodeParagraph","Properties":{"id":"20240903091925-6on54sz","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.紫色秃马勃Calvatialilacina(Mont.etBerk.)Lloyd2.3.大秃马勃Calvatiagigantea(BatschexPers.)Lloyd"}]},{"ID":"20240903091925-v3y5gio","Type":"NodeParagraph","Properties":{"id":"20240903091925-v3y5gio","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋两季子实体成熟时及时采收，除去泥沙，干燥。"}]},{"ID":"20240903091925-740vst2","Type":"NodeParagraph","Properties":{"id":"20240903091925-740vst2","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903091925-hllakmq","Type":"NodeParagraph","Properties":{"id":"20240903091925-hllakmq","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"1.紫色秃马勃子实体近扁球形，直径1.5-12cm，基部缢缩，有根束与基质相连。外表淡紫堇色至污褐色，成熟后表面有网状裂纹。内部的造孢层初呈白色，后转黄色至浓紫色。基部为营养菌丝所交织，海绵质，乳白色兼带淡紫褐色，孢子淡紫色，球形，一端具短柄，壁具刺突，大小为（5-5.5）μm×（6-6.5）μm。孢丝长而多分枝，有隔膜，菌丝粗5-6μm。"}]},{"ID":"20240903091925-4eqr5lj","Type":"NodeParagraph","Properties":{"id":"20240903091925-4eqr5lj","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"2.包被两层，薄而易于消失，外包被成熟后易与内包被分离。外包被初乳白色，后转灰褐色、污灰色；内包被纸质，浅烟色，成熟后与外包被逐渐剥落，仅余一团孢体，孢体灰褐色至烟褐色。孢子呈球形，壁具小刺突，褐色，直径4.5-5.5μm。孢丝长，分枝，相互交织，菌丝直径2-4.5μm,浅褐色。"}]},{"ID":"20240903091925-zrr3tnk","Type":"NodeParagraph","Properties":{"id":"20240903091925-zrr3tnk","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"3.大秃马勃子实体近圆球形，直径15-25cm不孕基部不明显。包被白色，渐转成淡青黄色，外包被膜质，早期外表有绒毛质地，后脱落而光滑；内包被较厚，由疏松的菌线组成。成熟后包被裂开，成残片状剥落。造孢组织初白色，后青褐色。孢子球形，壁光滑，淡青黄色，直径3.8-4.7μm。孢丝长，稍有分枝及稀少的横隔，直径2.5-μm。"}]},{"ID":"20240903091925-w51p1wc","Type":"NodeParagraph","Properties":{"id":"20240903091925-w51p1wc","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903091925-injq1ti","Type":"NodeParagraph","Properties":{"id":"20240903091925-injq1ti","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"生态环境：1.紫色秃马勃夏、秋季多生于草地开阔地。"}]},{"ID":"20240903091925-tdekba2","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240903091925-tdekba2","updated":"20240903092005"},"Children":[{"ID":"20240903091925-zj9csa6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240903091925-zj9csa6","updated":"20240903091925"},"Children":[{"ID":"20240903091925-u9q6n5h","Type":"NodeParagraph","Properties":{"id":"20240903091925-u9q6n5h","updated":"20240903091925"}}]}]},{"ID":"20240903091925-fro4flq","Type":"NodeParagraph","Properties":{"id":"20240903091925-fro4flq","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"3.大秃马勃晚夏及深秋生旷野草地或山坡砂质土草坡草中丛中。"}]},{"ID":"20240903091925-sm551iw","Type":"NodeParagraph","Properties":{"id":"20240903091925-sm551iw","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"资源分布：1.紫色秃马勃分布于吉林、辽宁、河北、山西、青海、新疆、山东、江苏、安徽、福建、河南、湖北、广东、广西、四川等地。"}]},{"ID":"20240903091925-x9ttl9i","Type":"NodeParagraph","Properties":{"id":"20240903091925-x9ttl9i","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"2.3.大秃马勃分分布于辽宁、内蒙古、山西、宁夏、甘苏、青海、新疆、四川、西藏等地。"}]},{"ID":"20240903091925-sko616p","Type":"NodeParagraph","Properties":{"id":"20240903091925-sko616p","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903091925-828az3l","Type":"NodeParagraph","Properties":{"id":"20240903091925-828az3l","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别(1)紫色秃马勃完整子实体呈扁圆形，不完整子实体呈杯形，直径5-12cm，不孕基部发达，基部有柄。包被薄，紫褐色，粗皱，有圆形凹陷，上部包被脱落后，露出紫色孢体。全轻泡，有弹性，用手捻后有大量孢子飞扬。气味微弱。"}]},{"ID":"20240903091925-m742436","Type":"NodeParagraph","Properties":{"id":"20240903091925-m742436","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"(2)脱皮马勃子实体呈扁球形或类形，直径15-18cm或更大，无不孕基部，包被灰棕色或褐黄色，纸质，菲薄，大部分已脱落，留下少部分包皮；孢体黄棕或棕褐色。体轻泡，柔软，有弹性，呈棉絮状，轻轻捻动即有孢子飞扬，手捻有细腻感。气味微弱。"}]},{"ID":"20240903091925-olked67","Type":"NodeParagraph","Properties":{"id":"20240903091925-olked67","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"(3)大秃马勃子实体呈扁球形，或压扁的不规则块状物直径15-20cm或更大，不孕基部小或无，外包被灰黄色，纸质，常脱落，内包被厚硬而脆，成块裂开，黄棕色；孢体淡青褐色，絮状而轻，松散，轻轻捻动即有孢子飞扬。气微臭，昧微苦涩。"}]},{"ID":"20240903091925-7modjml","Type":"NodeParagraph","Properties":{"id":"20240903091925-7modjml","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别(1)紫色秃马勃孢子球形，直径4.5-5.5μm，有小刺；孢丝长，分枝状，互相交织，粗2-5μm。"}]},{"ID":"20240903091925-q2cxjx3","Type":"NodeParagraph","Properties":{"id":"20240903091925-q2cxjx3","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"(2)脱皮马勃孢子褐色，球形，有小刺；孢丝长，有分枝，互相交织，浅褐色，粗2-5μm。"}]},{"ID":"20240903091925-bcsrvb1","Type":"NodeParagraph","Properties":{"id":"20240903091925-bcsrvb1","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"(3)大秃马勃孢子淡青黄色，球形，光滑或有时具细小疣；孢丝长，稍分枝，有稀少横隔，粗2.5-6μm。"}]},{"ID":"20240903091925-2fwrl55","Type":"NodeParagraph","Properties":{"id":"20240903091925-2fwrl55","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【化学成份】紫色秃马勃子实体马勃菌酸（calvaticacid）。大秃马勃子实体含α-淀粉酶（α-amylase）及多种氢基酸（aminoacid）。头状秃马勃子实体含马勃菌酸。网纹马勃子实体含网纹马勃酸（lycoperdicacid）,蛋白质（protein）31.7%,黑色素（melanin）,类脂（lipid）,脂肪酸（fattyacid）,芳香酸（aromaticacid）.梨形马勃子实体含马勃菌酸，马勃菌酸甲酯（methylcalva-tate）,苯甲酸（benfzoicacid）."}]},{"ID":"20240903091925-ijc980u","Type":"NodeParagraph","Properties":{"id":"20240903091925-ijc980u","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903091925-nxbxmj5","Type":"NodeParagraph","Properties":{"id":"20240903091925-nxbxmj5","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"1.止血作用脱皮马勃对口腔出血性疾患有明显的止血效能，不亚于淀粉海绵或明胶海绵，对鼻出血亦有效。原理未明。"}]},{"ID":"20240903091925-tsw96br","Type":"NodeParagraph","Properties":{"id":"20240903091925-tsw96br","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用体外试验，脱皮马勃煎剂对金黄色葡萄球菌、绿脓杆菌、变形杆菌及肺炎双球菌有一定的抑制作用，对少数致病真菌也有抑制作用。煎剂中含大量色素，经用活性炭脱色后，抗菌作用大减。埃蕈新鲜子实体的压榨汁，给动物注射，可毒害毛细血管，引起内脏出血。"}]},{"ID":"20240903091925-dawa10j","Type":"NodeParagraph","Properties":{"id":"20240903091925-dawa10j","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【炮制】除去硬皮，切成方块。《纲目》：凡用，以生布张开，将马勃于上磨擦，下以盘承取末用。"}]},{"ID":"20240903091925-rqyj4mo","Type":"NodeParagraph","Properties":{"id":"20240903091925-rqyj4mo","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【性味】辛；性平。"}]},{"ID":"20240903091925-k7165pw","Type":"NodeParagraph","Properties":{"id":"20240903091925-k7165pw","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【归经】肺经"}]},{"ID":"20240903091925-o45nmdn","Type":"NodeParagraph","Properties":{"id":"20240903091925-o45nmdn","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【功能主治】清肺利咽，解毒止血。。主咽喉肿痛，咳嗽失音，吐血衄血，诸疮不敛。"}]},{"ID":"20240903091925-uzrujqr","Type":"NodeParagraph","Properties":{"id":"20240903091925-uzrujqr","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：1.5-6g，或入丸、散，外用：研末撒；或调敷、或作吹药。"}]},{"ID":"20240903091925-9u37zs8","Type":"NodeParagraph","Properties":{"id":"20240903091925-9u37zs8","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【注意】《饮片新参》：风寒劳咳失音者忌用。"}]},{"ID":"20240903091925-hco7wjw","Type":"NodeParagraph","Properties":{"id":"20240903091925-hco7wjw","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903091925-quxk02z","Type":"NodeParagraph","Properties":{"id":"20240903091925-quxk02z","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"1.《本草从新》：每见用寒凉药敷疮者，虽愈而热毒内攻，变生他病，为害不小，惟马勃辛平而散，甚为稳妥。张寿颐：马勃，《别录》虽止治恶疮马疥，盖既能散毒，又能燥湿，以疗湿疮，固得其宜，故弘景亦谓敷诸疮甚良。今人用以为金疮止血亦效。寇宗奭治喉痹咽疼，盖既散郁热，亦清肺胃，确是喉症良药。东垣普济消毒饮用之，亦是此意。内服外敷，均有捷验，诚不可以微贱之品而忽之。"}]},{"ID":"20240903091925-5ox6o2e","Type":"NodeParagraph","Properties":{"id":"20240903091925-5ox6o2e","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主恶疮、马疥。陶弘景：敷诸疮。"}]},{"ID":"20240903091925-cwu8zxu","Type":"NodeParagraph","Properties":{"id":"20240903091925-cwu8zxu","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：膜，以蜜揉拌，少以水调呷，治喉闭咽痛。"}]},{"ID":"20240903091925-0kz9wue","Type":"NodeParagraph","Properties":{"id":"20240903091925-0kz9wue","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：清肺，散血热，解毒。能清肺热咳嗽，喉痹，衄血，失音诸病。"}]},{"ID":"20240903091925-aiwqsap","Type":"NodeParagraph","Properties":{"id":"20240903091925-aiwqsap","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"5.《玉楸药解》：治骨鲠吐血。"}]},{"ID":"20240903091925-tg95ivc","Type":"NodeParagraph","Properties":{"id":"20240903091925-tg95ivc","updated":"20240903092005"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903091927-nbpfmvc","Type":"NodeThematicBreak","Properties":{"id":"20240903091927-nbpfmvc","updated":"20240903092005"}},{"ID":"20240903091928-k6jjg2m","Type":"NodeParagraph","Properties":{"id":"20240903091928-k6jjg2m","updated":"20240903092005"}}]}