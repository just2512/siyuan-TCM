ta":"{: style=\"width: 390px;\" parent-style=\"width: 400px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 824px;","style":"width: 814px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 12-20240717164808-cpi5oro.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 814px;\" parent-style=\"width: 824px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717165110-fxtzrt9","Type":"NodeParagraph","Properties":{"id":"20240717165110-fxtzrt9","updated":"20240717165751"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 797px;","style":"width: 787px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 13-20240717165110-34zfa8h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 787px;\" parent-style=\"width: 797px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 327px;","style":"width: 317px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 15-20240717165720-cu4er9o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 317px;\" parent-style=\"width: 327px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717165122-19mlwgv","Type":"NodeParagraph","Properties":{"id":"20240717165122-19mlwgv","updated":"20240717165122"}},{"ID":"20240717164020-vuro4ei","Type":"NodeParagraph","Properties":{"id":"20240717164020-vuro4ei","updated":"20240717165126"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白花蛇舌草与伞房花蛇舌草对比"}]},{"ID":"20240717164134-zr9eeq3","Type":"NodeParagraph","Properties":{"id":"20240717164134-zr9eeq3","updated":"20240717164142"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为白花蛇舌草"}]},{"ID":"20240717164310-9khb2oz","Type":"NodeParagraph","Properties":{"id":"20240717164310-9khb2oz","updated":"20240717164359"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 438px;","style":"width: 428px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 8-20240717164310-082ah7r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 428px;\" parent-style=\"width: 438px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 771px;","style":"width: 761px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 9-20240717164359-8dg8ggt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 761px;\" parent-style=\"width: 771px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717164143-jyucz9q","Type":"NodeParagraph","Properties":{"id":"20240717164143-jyucz9q","updated":"20240717164151"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为伞房花蛇舌草"}]},{"ID":"20240717164457-myozdii","Type":"NodeParagraph","Properties":{"id":"20240717164457-myozdii","updated":"20240717164537"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 10-20240717164457-sfeodsw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白花蛇舌草 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白花蛇舌草 11-20240717164537-hw9a123.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717164636-atkrf1n","Type":"NodeParagraph","Properties":{"id":"20240717164636-atkrf1n","updated":"20240902112157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：白花蛇舌草与伞房花蛇舌草较为相似（花的数量不一样）。"}]},{"ID":"20240717164943-lmyncxd","Type":"NodeParagraph","Properties":{"id":"20240717164943-lmyncxd","updated":"20240717165351"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：白花蛇舌草植株高度比较低。"}]},{"ID":"20240717163757-wyh4079","Type":"NodeThematicBreak","Properties":{"id":"20240717163757-wyh4079"}},{"ID":"20240902112219-ujuko01","Type":"NodeParagraph","Properties":{"id":"20240902112219-ujuko01","updated":"20240902112227"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白花蛇舌草"}]},{"ID":"20240902112219-q7iha4v","Type":"NodeParagraph","Properties":{"id":"20240902112219-q7iha4v","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"白花蛇舌草《中国药典》"}]},{"ID":"20240902112219-2r7jm09","Type":"NodeParagraph","Properties":{"id":"20240902112219-2r7jm09","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiHuāShéShéCǎo"}]},{"ID":"20240902112219-p07034o","Type":"NodeParagraph","Properties":{"id":"20240902112219-p07034o","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【别名】蛇舌草、蛇舌癀、蛇针草、蛇总管、二叶葎、白花十字草、尖刀草、甲猛草、龙舌草、蛇脷草、鹤舌草"}]},{"ID":"20240902112219-zedwbnt","Type":"NodeParagraph","Properties":{"id":"20240902112219-zedwbnt","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902112219-3k7laoe","Type":"NodeParagraph","Properties":{"id":"20240902112219-3k7laoe","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"本品为茜草科耳草属植物白花蛇舌草HedyotisdiffusaWilld.[Oldenlandiadiffusa（Willd.）Roxb.]的全草。夏秋采集，洗净，鲜用或晒干。"}]},{"ID":"20240902112219-2u2iaxm","Type":"NodeParagraph","Properties":{"id":"20240902112219-2u2iaxm","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"注：同属植物水线草（伞房花耳草）Hedyotiscorymbosa（L.）Lamk.[OldenlandiacorymbosaL.]形态近前种，也做白花蛇舌草入药，功效类似。"}]},{"ID":"20240902112219-q9avycy","Type":"NodeParagraph","Properties":{"id":"20240902112219-q9avycy","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【性味】甘、淡，凉。"}]},{"ID":"20240902112219-j9hrpl2","Type":"NodeParagraph","Properties":{"id":"20240902112219-j9hrpl2","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【归经】入胃、大肠、小肠经。"}]},{"ID":"20240902112219-lkjn7ea","Type":"NodeParagraph","Properties":{"id":"20240902112219-lkjn7ea","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，利尿消肿，活血止痛。用于肠痈（阑尾炎），疮疖肿毒，湿热黄疸，小便不利等症；外用治疮疖痈肿，毒蛇咬伤。"}]},{"ID":"20240902112219-jlslzgu","Type":"NodeParagraph","Properties":{"id":"20240902112219-jlslzgu","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～2两，煎服。外用适量，捣烂敷患处。"}]},{"ID":"20240902112219-nj4g1e2","Type":"NodeParagraph","Properties":{"id":"20240902112219-nj4g1e2","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【备注】（1）与红藤、败酱草等同用，可用治肠痈；与银花、连翘等同用，可治疗疮疖肿毒等症。与山栀、黄柏、茵陈等同用，治湿热黄疸；与白茅根、车前子、茯苓等同用，可治小便不利等症。"}]},{"ID":"20240902112219-08bfyr0","Type":"NodeParagraph","Properties":{"id":"20240902112219-08bfyr0","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902112219-lvuisn9","Type":"NodeParagraph","Properties":{"id":"20240902112219-lvuisn9","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"白花蛇舌草《*辞典》"}]},{"ID":"20240902112219-khdmvlt","Type":"NodeParagraph","Properties":{"id":"20240902112219-khdmvlt","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【出处】《广西中药志》"}]},{"ID":"20240902112219-571qtni","Type":"NodeParagraph","Properties":{"id":"20240902112219-571qtni","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiHuāShéShéCǎo"}]},{"ID":"20240902112219-qte7hm4","Type":"NodeParagraph","Properties":{"id":"20240902112219-qte7hm4","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【别名】蛇舌草、矮脚白花蛇利草（《广西中药志》），蛇舌癀（《闽南民间草药》），目目生珠草，节节结蕊草（《泉州本草》），鹩哥利、千打捶、羊须草（《广东中药》Ⅱ），蛇总管、鹤舌草、细叶柳子（《福建中草药》）。"}]},{"ID":"20240902112219-g323z77","Type":"NodeParagraph","Properties":{"id":"20240902112219-g323z77","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【来源】为茜草种植物白花蛇舌草的带根全草。夏、秋采收，晒干或鲜用。"}]},{"ID":"20240902112219-7yy3ovt","Type":"NodeParagraph","Properties":{"id":"20240902112219-7yy3ovt","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【原形态】白花蛇舌草，又名：二叶葎。一年生草本，高15～50厘米。茎纤弱，略带方形或圆柱形，秃净无毛。叶对生，具短柄或无柄；叶片线形至线状披针形，长1～3.5厘米，宽1～3毫米，革质；托叶膜质，基部合生成鞘状，长1～2毫米，顶端有细齿。花单生或2朵生于叶腋，无柄或近于无柄；花萼筒状，4裂，裂片边缘具短刺毛；花冠漏斗形，长约3毫米。纯白色，先端4深裂.秃净；雄蕊4；子房2室，柱头2浅裂呈半球状。蒴果，扁球形，直径2～3毫米，室背开裂，花萼宿存。种子棕黄色，极细小。花期7～9月。果期8～10月。"}]},{"ID":"20240902112219-ea1bn2j","Type":"NodeParagraph","Properties":{"id":"20240902112219-ea1bn2j","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡、路边、溪畔草丛中。分布云南、广东、广西、福建、浙江、江苏、安徽等地。"}]},{"ID":"20240902112219-dmo9kfc","Type":"NodeParagraph","Properties":{"id":"20240902112219-dmo9kfc","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【性状】干燥全草，扭缠成团状，灰绿色至灰棕色.有主根一条，粗约2～4毫米，须根纤细，淡灰棕色；茎细而卷曲，质脆易折断，中央有白色髓部。叶多破碎，极皱缩，易脱落；有托叶，长1～2毫米。花腋生。气微，味淡。主产福建、广东、广西等地。"}]},{"ID":"20240902112219-nsip9k2","Type":"NodeParagraph","Properties":{"id":"20240902112219-nsip9k2","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草中分出卅一烷、豆甾醇、熊果酸、齐墩果酸，β-谷甾醇、β-谷甾醇-D-葡萄糖甙、对香豆酸等。"}]},{"ID":"20240902112219-rr2los2","Type":"NodeParagraph","Properties":{"id":"20240902112219-rr2los2","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902112219-3jkenzi","Type":"NodeParagraph","Properties":{"id":"20240902112219-3jkenzi","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"①抗肿瘤作用"}]},{"ID":"20240902112219-nx53qso","Type":"NodeParagraph","Properties":{"id":"20240902112219-nx53qso","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"在体外（相当生药6克/毫升）对急性淋巴细胞型、粒细胞型、单核细胞型以及慢性粒细胞型的肿瘤细胞有较强抑制作用（美蓝试管法）；用瓦氏呼吸器测定，对前二者的抑制作用亦较强。曾用浸膏于小鼠S-180和艾氏腹水癌，以及大鼠吉田肉瘤的实验性治疗，皆无明显抗癌作用；0.5～1克生药／毫升在体外对吉田肉瘤和艾氏腹水癌有抑制（美蓝试管法），但作者认为此属非特殊性的。"}]},{"ID":"20240902112219-iys3fxs","Type":"NodeParagraph","Properties":{"id":"20240902112219-iys3fxs","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"②抗菌、消炎作用"}]},{"ID":"20240902112219-5m7gxjh","Type":"NodeParagraph","Properties":{"id":"20240902112219-5m7gxjh","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"体外抗菌作用并不显着，只对金黄色葡萄球菌和痢疾杆菌有微弱作用。观察煎液对正常和人工阑尾炎兔的网状内皮系统吞噬功能和白细胞在体内外吞噬活力的影响，认为其抗炎作用，是刺激网状内皮系统增生和增强吞噬细胞活力等因素所致。"}]},{"ID":"20240902112219-apjayef","Type":"NodeParagraph","Properties":{"id":"20240902112219-apjayef","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902112219-4c33rx5","Type":"NodeParagraph","Properties":{"id":"20240902112219-4c33rx5","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"苦甘，寒。"}]},{"ID":"20240902112219-t1mu7ln","Type":"NodeParagraph","Properties":{"id":"20240902112219-t1mu7ln","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"①《\"西中药志》：\"味苦甘，性温，无毒。\""}]},{"ID":"20240902112219-2hslaqa","Type":"NodeParagraph","Properties":{"id":"20240902112219-2hslaqa","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"②《闽南民间草药》：\"苦，平，无毒。\""}]},{"ID":"20240902112219-vsa8doo","Type":"NodeParagraph","Properties":{"id":"20240902112219-vsa8doo","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"③《泉州本草》：\"甘微酸，性寒。\""}]},{"ID":"20240902112219-8yiz31b","Type":"NodeParagraph","Properties":{"id":"20240902112219-8yiz31b","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"④《广东中药》Ⅱ：\"辛涩，寒，无毒。\""}]},{"ID":"20240902112219-t709f6q","Type":"NodeParagraph","Properties":{"id":"20240902112219-t709f6q","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【归经】《广西中药志》：\"入心、肝、脾三经。\""}]},{"ID":"20240902112219-6q8b3y8","Type":"NodeParagraph","Properties":{"id":"20240902112219-6q8b3y8","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902112219-jaryzp1","Type":"NodeParagraph","Properties":{"id":"20240902112219-jaryzp1","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"清热，利湿，解毒。治肺热喘咳，扁桃体炎。咽喉炎，阑尾炎，痢疾，尿路感染，黄疸，肝炎，盆腔炎，附件炎，痈肿疔疮，毒蛇咬伤，肿瘤。亦可用于消化道癌症。"}]},{"ID":"20240902112219-ttgua67","Type":"NodeParagraph","Properties":{"id":"20240902112219-ttgua67","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"①《潮州志·物产志》：\"茎叶榨汁饮服，治盲肠炎，又可治一切肠病。\""}]},{"ID":"20240902112219-ibo9p76","Type":"NodeParagraph","Properties":{"id":"20240902112219-ibo9p76","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"②《广西中药志》：\"治小儿疳积，毒蛇咬伤，癌肿。外治白泡疮，蛇癞疮。\""}]},{"ID":"20240902112219-el80mie","Type":"NodeParagraph","Properties":{"id":"20240902112219-el80mie","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"③《闽南民间草药》：\"清热解毒，消炎止痛。\""}]},{"ID":"20240902112219-f4s7mnd","Type":"NodeParagraph","Properties":{"id":"20240902112219-f4s7mnd","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"④《泉州本草》：\"清热散瘀，消痈解毒。治痈疽疮疡，瘰疬。又能清肺火，泻肺热。治肺热喘促、嗽逆胸闷。\""}]},{"ID":"20240902112219-45rjt97","Type":"NodeParagraph","Properties":{"id":"20240902112219-45rjt97","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"⑤《广西中草药》：\"清热解毒，活血利尿。治扁桃体炎，咽喉炎，阑尾炎，肝炎，痢疾，尿路感染，小儿疳积。\""}]},{"ID":"20240902112219-8kuu2qw","Type":"NodeParagraph","Properties":{"id":"20240902112219-8kuu2qw","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2两；或捣汁。外用：捣敷。"}]},{"ID":"20240902112219-i9tka27","Type":"NodeParagraph","Properties":{"id":"20240902112219-i9tka27","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【注意】《广西中药志》：\"孕妇慎用。\""}]},{"ID":"20240902112219-y5rpbf8","Type":"NodeParagraph","Properties":{"id":"20240902112219-y5rpbf8","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902112219-326gczg","Type":"NodeParagraph","Properties":{"id":"20240902112219-326gczg","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"①治痢疾、尿道炎：白花蛇舌草一两。水煎服。（《福建中草药》）"}]},{"ID":"20240902112219-5cax4xe","Type":"NodeParagraph","Properties":{"id":"20240902112219-5cax4xe","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"②治黄疸：白花蛇舌草一至二两。取汁和蜂蜜服。（厦门）"}]},{"ID":"20240902112219-p5vtqe4","Type":"NodeParagraph","Properties":{"id":"20240902112219-p5vtqe4","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"③治急性阑尾炎：白花蛇舌草二至四两，羊蹄草一至二两，两面针根三钱。水煎服。（广东《中草药处方选编》）"}]},{"ID":"20240902112219-dq1at78","Type":"NodeParagraph","Properties":{"id":"20240902112219-dq1at78","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"④治小儿惊热，不能入睡：鲜蛇舌癀打汁一汤匙服。（《闽南民间草药》）"}]},{"ID":"20240902112219-ox6zycx","Type":"NodeParagraph","Properties":{"id":"20240902112219-ox6zycx","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"⑤治疮肿热痛：鲜蛇舌癀洗净，捣烂敷之，干即更换。（《闽南民间草药》）"}]},{"ID":"20240902112219-th8mgj7","Type":"NodeParagraph","Properties":{"id":"20240902112219-th8mgj7","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"⑥治毒蛇咬伤：鲜白花蛇舌草一至二两。捣烂绞汁或水煎服，渣敷伤口。（《福建中草药》）"}]},{"ID":"20240902112219-uukkwyj","Type":"NodeParagraph","Properties":{"id":"20240902112219-uukkwyj","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902112219-88ontr3","Type":"NodeParagraph","Properties":{"id":"20240902112219-88ontr3","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"①治疗小儿肺炎"}]},{"ID":"20240902112219-7g9w07t","Type":"NodeParagraph","Properties":{"id":"20240902112219-7g9w07t","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"用白花蛇舌草注射剂，每次肌肉注射2毫升（含4克生药的有效成分），婴儿减半，每日2次，疗程5～7日。治疗112例，痊愈52例，近愈25例，好转17例，无效12例，死亡6例，平均住院7.98天"}]},{"ID":"20240902112219-175t12y","Type":"NodeParagraph","Properties":{"id":"20240902112219-175t12y","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"②治疗阑尾炎"}]},{"ID":"20240902112219-jo2sjao","Type":"NodeParagraph","Properties":{"id":"20240902112219-jo2sjao","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"取鲜白花蛇舌草1两（干品5钱），水煎服，每日2次。小儿酌减。症状较重者可增至2～3两。个别腹胀严重者加用水针或新针治疗，中毒症状较重者兼用补液并禁食。治疗19例均愈，其中急性阑尾炎12例和阑尾脓肿3例，服药8～9天，平均于1.9天和3.3天退热。3.2天和6天症状体征消失。1例治愈4个月后复发，仍以同样方法治愈。有报告用鲜全草4两（干品1～2两），每日1～2剂煎服；或制成100％的针剂行肌肉注射，每次2毫升，每日2次，重症6小时1次。治疗各种类型阑尾炎（包括急性、亚急性及阑尾穿孔并发腹膜炎）50余例，一般服药2～3天临床症状消失，1周痊愈出院。其中以急性阑尾炎的疗效最好。煎剂疗效优于针剂。又有报告以煎剂内服治疗急慢性阑尾炎30例，对单纯性、症状较轻、发病1～2天入院的单用白花蛇舌草；对症状较重，有明显全身和局部症状者，配用海金砂、野菊花全草或桉叶。除2例慢性阑尾炎重新入院行手术治疗外，均获痊愈。平均住院4.2天。"}]},{"ID":"20240902112219-ylu3vwn","Type":"NodeParagraph","Properties":{"id":"20240902112219-ylu3vwn","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"③治疗输精管结扎术后副睾郁积症"}]},{"ID":"20240902112219-5m6fpd4","Type":"NodeParagraph","Properties":{"id":"20240902112219-5m6fpd4","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"在常用的精索封闭及中西药物治疗的基础上，加用白花蛇舌草（每日1两煎服，一般3～4周为一疗程，最长者服10周以上），可提高疗效；特别对单纯性副睾郁积症效果更为明显。初步观察19例，均曾经多种治疗，如精索封闭、理疗、糜蛋白酶肌注、止痛剂、新针、中药及抗菌素、激素等，其中6例曾做过输精管吻合术，1例曾作一侧副睾切除，2例曾作过痛性结节切除，效果都不理想。经加用白花蛇舌草后，10例单纯性郁积症中有3例主要症状基本消失，副睾变软，触痛减轻或消失；7例症状好转，副睾触痛减轻；9例合并有精索、副睾炎症者，其中6例好转，3例无效。认为白花蛇舌草有抑制生精作用，能减轻副睾郁积，又能消除炎症，故能收到治疗效果。但对精索粘连及副睾有肉芽肿形成等病例，则疗效不佳。"}]},{"ID":"20240902112219-wxhws90","Type":"NodeParagraph","Properties":{"id":"20240902112219-wxhws90","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"④治疗毒蛇咬伤"}]},{"ID":"20240902112219-468wufm","Type":"NodeParagraph","Properties":{"id":"20240902112219-468wufm","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"取本品5钱，以白酒半斤煮沸3～5分钟，去渣，以2／3口服（1日分2～3次服完），1／3外敷伤口。敷药时先吸出伤口毒血，清洗消毒后用消毒棉垫覆盖包扎，然后将药酒浇湿敷料（以保持湿润为度）。若不能饮酒者，可用清水煎煮，沸后再加入适量白酒，但一般仍以白酒煮为佳。对水肿顽固不退，病情严重及伤口感染者，适当加用其它中草药及抗菌素；对于轻型戒中型病例，单用本法治疗即可。据19例观察，一般用药3～6剂即获痊愈。"}]},{"ID":"20240902112219-9euenox","Type":"NodeParagraph","Properties":{"id":"20240902112219-9euenox","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"⑤治疗盆腔炎、附件炎"}]},{"ID":"20240902112219-g7oj8u3","Type":"NodeParagraph","Properties":{"id":"20240902112219-g7oj8u3","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"用白花蛇舌草1.5两，配以入地金牛（两面针）3钱，或再加穿破石（苌芝）3钱，水煎服，每日1剂。77例患者治疗后，4例无效，余均痊愈。"}]},{"ID":"20240902112219-2pjtcg3","Type":"NodeParagraph","Properties":{"id":"20240902112219-2pjtcg3","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"此外，曾试用100％白花蛇舌草针剂肌肉注射，每次2毫升，每日3次，治疗子宫颈癌，胃癌、肝癌各1例，症情均有不同程度的改善。曾用白花蛇舌草、茵陈、金钱草各1两制成\"利胆合剂\"，治疗胆石症等胆道疾患共10例，其中9例腹痛、黄疸、发热等症状平均2.2天获得缓解；3例胆总管造瘘术后的患者，服药后胆汁量成倍增加，胆汁沉渣排出很多，黄疸指数逐渐下降，提示\"利胆合剂\"具有明显的利胆与排石作用。"}]},{"ID":"20240902112219-v2sprzw","Type":"NodeParagraph","Properties":{"id":"20240902112219-v2sprzw","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240902112219-06k1w9p","Type":"NodeParagraph","Properties":{"id":"20240902112219-06k1w9p","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"在福建、广西地区，尚有以同属植物水线草（参见\"水线草\"条），纤花耳草（参见\"虾子草\"条）及松叶耳草（参见\"鹩哥舌\"条）等作白花蛇舌草使用者。"}]},{"ID":"20240902112219-qpfj7xw","Type":"NodeParagraph","Properties":{"id":"20240902112219-qpfj7xw","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"同属植物伞房花耳草H.corymbosa（L.）Lam、纤花耳草H.tenellifloraB1.亦作白花蛇舌草用。"}]},{"ID":"20240902112219-1j9gvch","Type":"NodeParagraph","Properties":{"id":"20240902112219-1j9gvch","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902112219-yyufuxm","Type":"NodeParagraph","Properties":{"id":"20240902112219-yyufuxm","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"白花蛇舌草《中华本草》"}]},{"ID":"20240902112219-tv2r4si","Type":"NodeParagraph","Properties":{"id":"20240902112219-tv2r4si","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【出处】出自《广西中药志》"}]},{"ID":"20240902112219-ikwe1nc","Type":"NodeParagraph","Properties":{"id":"20240902112219-ikwe1nc","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiHuāShéShéCǎo"}]},{"ID":"20240902112219-e6fqyej","Type":"NodeParagraph","Properties":{"id":"20240902112219-e6fqyej","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【英文名】SpreadingHedyotisHerb，HerbofSpreadingHedyotis"}]},{"ID":"20240902112219-nguziu1","Type":"NodeParagraph","Properties":{"id":"20240902112219-nguziu1","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【别名】蛇舌草、矮脚白花蛇利草、蛇舌癀、目目生珠草、节节结蕊草、鹩哥利、千打捶、羊须草、蛇总管、鹤舌草、细叶柳子、甲猛草、蛇针草、白花十字草、尖刀草、珠仔草、定经草、小叶锅巴草、南地珠、散草、竹叶草、奶沙尔、铁沙尔"}]},{"ID":"20240902112219-s6wgdys","Type":"NodeParagraph","Properties":{"id":"20240902112219-s6wgdys","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902112219-ydeydh0","Type":"NodeParagraph","Properties":{"id":"20240902112219-ydeydh0","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"药材基源：为双子叶植物药茜草科植物白花蛇舌草的带根全草。"}]},{"ID":"20240902112219-3grl1ml","Type":"NodeParagraph","Properties":{"id":"20240902112219-3grl1ml","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：HedyotisdiffusaWilld.[Olden-landiadiffusa(Willd.)Roxb.]"}]},{"ID":"20240902112219-8hm2vhp","Type":"NodeParagraph","Properties":{"id":"20240902112219-8hm2vhp","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋采收，晒干或鲜用。"}]},{"ID":"20240902112219-pzzhkar","Type":"NodeParagraph","Properties":{"id":"20240902112219-pzzhkar","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【原形态】一生生披散草本，高15-50cm。根细长，分枝，白以。茎略带方形或扁圆柱形，光滑无毛，从基部发出多分枝。叶对生；无柄；叶片线形至线状披针形，长1-3.5cm，宽1-3mm，先端急尖，上面光滑，下面有时稍粗糙，侧脉不明显；托叶膜质，基部合生成鞘状，长1-2mm，先端芒尖。花单生或成对生于叶腋，常具短而咯粗的花梗，稀无梗；萼简球形，4裂，裂片长圆状披针形，长1.5-2mm，边缘具睫毛；花冠白色，漏斗形，长3.5-4mm，先端4深裂，裂片卵状长圆形，长约2mm，秃净；雄蕊4，着生于冠简喉部，与花冠裂片互生，花丝扁，花药卵形，背着，2室，纵裂；子房下位，2室。柱头2浅裂呈半球形。蒴果扁球形，直径2-2.5mm，室背开裂，花萼宿存。种子棕黄色，细小，且3个棱角。花期7-9月，果期8-10月。"}]},{"ID":"20240902112219-pfm2is0","Type":"NodeParagraph","Properties":{"id":"20240902112219-pfm2is0","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902112219-p8vctd3","Type":"NodeParagraph","Properties":{"id":"20240902112219-p8vctd3","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"生态环境：生于潮湿的田边、沟边、路旁和草地。"}]},{"ID":"20240902112219-6bpqs1r","Type":"NodeParagraph","Properties":{"id":"20240902112219-6bpqs1r","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于我国东南至西南部各地。"}]},{"ID":"20240902112219-e03r706","Type":"NodeParagraph","Properties":{"id":"20240902112219-e03r706","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902112219-re00r5m","Type":"NodeParagraph","Properties":{"id":"20240902112219-re00r5m","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润环境，不耐干旱和积水，对土壤要求不严，但以肥沃的砂质壤土或腐殖质壤土生长较好。"}]},{"ID":"20240902112219-z10bh9j","Type":"NodeParagraph","Properties":{"id":"20240902112219-z10bh9j","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。南方3-4月，北方5月播种，撒播或宽扰条播播幅10-12cm，浅盖土，保持土壤湿润。"}]},{"ID":"20240902112219-tr98y9a","Type":"NodeParagraph","Properties":{"id":"20240902112219-tr98y9a","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"田间管理出苗后松土、除草、间苗、施追肥1-2次。"}]},{"ID":"20240902112219-bb7ognz","Type":"NodeParagraph","Properties":{"id":"20240902112219-bb7ognz","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902112219-460jk1r","Type":"NodeParagraph","Properties":{"id":"20240902112219-460jk1r","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"性状鉴别全体扭缠成团状，灰绿色至灰棕色。主根细长，粗约2mm，须根纤细，淡灰棕色。茎细，卷曲，质脆，易折断，中心髓部白色。叶多皱缩，破碎，易脱落；托叶长1-2mm。花、果单生或成对生于叶腋，花常具短而略粗的花梗。葫果扁球形，直径2-2.5mm，室背开裂，宿萼顶端4裂，边缘具短刺毛。气微，味淡。"}]},{"ID":"20240902112219-a8osskx","Type":"NodeParagraph","Properties":{"id":"20240902112219-a8osskx","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面：表皮细胞1列，类方形或卵圆形，常有单个细胞向外突起，形成非腺毛，外被角质层。皮层窄，细胞呈类圆形；内皮层细胞1列。韧皮部较窄。木质部导管2-7个相连成单个径向排列成行；木纤维壁较厚，木化化；射线窄，常1-2列细胞，壁薄，木化。髓部宽广，细胞较大，内含淀粉粒，髓部通常中空。皮层及髓部薄壁细胞中偶见草酸钙针晶。"}]},{"ID":"20240902112219-dfn417x","Type":"NodeParagraph","Properties":{"id":"20240902112219-dfn417x","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"粉末特征：灰黄色。①叶表皮细胞多角形，垂周壁平直；气孔千轴式，长圆形。②茎表皮细胞长条形，有气孔。③导管主为环纹或螺纹，直径15-30μm。④草酸钙簇晶存在于叶肉组织中，直径1y-15μm。⑤草酸钙针晶多见，成束或散在，长75-135μm。③淀粉粒众多，单粒类圆形，复粒由2-3分粒组成。"}]},{"ID":"20240902112219-o8k5p9u","Type":"NodeParagraph","Properties":{"id":"20240902112219-o8k5p9u","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草含车叶草甙（asperuloside），车叶草甙酸（asperulosidicacid），去乙酸基车叶草甙酸（deacetylasperulosidicacid），都桷子甙酸（genipoSidicacid），鸡屎藤次甙(scandoside)，鸡屎藤次甙甲酯（scandodidemethylester），6-O-对-羟基桂皮酰鸡屎藤次甙甲酯（6-O-p－hydroxycinnamoylscandosidemethylester），6-O-对-甲氧基桂皮酰鸡屎藤次甙甲酯（6-O-P-methO-xycinnamlylscandosidemethylester）,6-O-阿魏酰鸡屎藤次甙甲酯（6-O-feruloylscandosidemethylester），2-甲基-3-羟基蒽醌（2-methyL-3-hvdroxyanthraquinone）,2-甲基-3-甲氧基蒽醌（2－methyl-3-methoxyanthraquinone），2-甲基-3-羟基-4-甲氧基蒽醌（2-methyl-3-hvdroxy-4-methoxyanthraquinone）等[1-3]，以及熊果酸（ursolicacid），β-谷甾醇（β-sitosterol）[4]，三十一烷（hentriacon-tane），豆甾醇（stigmasterol），齐墩果酸（oleanolicacid），β-谷甾醇-β-葡萄糖甙（β-sitosterol-β-D-glucoside），对-香豆酸（p－coumaricacid）等[5，6]。"}]},{"ID":"20240902112219-1p8gis4","Type":"NodeParagraph","Properties":{"id":"20240902112219-1p8gis4","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902112219-83xqbup","Type":"NodeParagraph","Properties":{"id":"20240902112219-83xqbup","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"1.抗肿瘤作用:在体外(相当生药6g/ml)对急性淋巴细胞型、粒细胞型、单核细胞型以及慢性粒细胞型的肿瘤细胞有较强抑制作用(美蓝试管法);用瓦氏呼吸器测定，对前二者的抑制作用亦较强。曾用浸膏于小鼠S一180和艾氏腹水癌，以及大鼠吉田肉瘤的实验性治疗，皆无明显抗癌作用;0.5-1g生药/ml在体外对吉田肉瘤和艾氏腹水癌有抑制(美蓝试管法)，但作者认为此属非特殊性的。"}]},{"ID":"20240902112219-6zyy7x7","Type":"NodeParagraph","Properties":{"id":"20240902112219-6zyy7x7","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"2.抗菌消炎作用:体外抗菌作用并不显着，只对金黄色葡萄球菌和痢疾杆菌有微弱作用。观察煎液对正常和人工阐尾炎兔的网状内皮系统吞噬功能和白细胞在体内外吞噬后力的影响，认为其抗炎作用，是刺激网状内皮系统增生和增强吞噬细胞活力等因素所致。"}]},{"ID":"20240902112219-riqa0h3","Type":"NodeParagraph","Properties":{"id":"20240902112219-riqa0h3","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"2.1.抗菌：煎剂用试管稀释法，1:4对金黄色葡萄球菌、福氏痢疾杆菌，1:2对伤寒杆菌、绿脓杆菌等具抑制作用。"}]},{"ID":"20240902112219-fylnmvj","Type":"NodeParagraph","Properties":{"id":"20240902112219-fylnmvj","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"2.2.抗炎免疫：煎剂4g/kg1日内灌服4次，对正常兔及人工狭窄阑尾所致的实验性阑尾炎兔均有刺激网状内皮糸统增生，增加吞噬细胞的吞噬能力，并使嗜银物质倾向致密化，增强机体的防御能力而达到抗炎的作用。煎剂300mg/只灌胃对初次免疫小鼠脾脏抗原结合细胞有抑制增生作用。水提物2mg/只腹腔注射，对小鼠可增强异型小鼠脾细胞诱导的迟发型超敏反应；100mg/kg腹腔注射，可增加小鼠脾抗体分泌细胞数(PFC)；30-240μg/ml可增强小鼠脾细胞对丝裂原ConA及LPS对小鼠脾细胞的增殖反应；30μg/ml可增强细胞毒性T淋巴细胞对MX-87靶细胞的杀伤率。"}]},{"ID":"20240902112219-bw2ww7n","Type":"NodeParagraph","Properties":{"id":"20240902112219-bw2ww7n","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【毒性】浸膏半数致死量，小鼠腹腔注射为104g生药/kg。"}]},{"ID":"20240902112219-fmjm0mn","Type":"NodeParagraph","Properties":{"id":"20240902112219-fmjm0mn","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别薄层色谱：取本品粉末1g，已加乙醇10ml，加热回流30min，趁热滤过，滤液蒸干，残渣加乙醇1ml溶解作为供试品溶液。另取齐墩果酸对照品，加乙醇制成每1ml含1mg的溶液，作为对照溶液。吸取上述两种溶液各5ml，点于同一硅胶G薄层板上，以石油醚-苯-醋酸乙酯-冰醋酸（20：41：14：1）为展开剂，展开，取出，晾干，置碘缸中显色。供试品色谱在与对照品色相应位置上，显相同颜色的斑点。"}]},{"ID":"20240902112219-dklqx5f","Type":"NodeParagraph","Properties":{"id":"20240902112219-dklqx5f","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【性味】苦甘；寒；无毒"}]},{"ID":"20240902112219-6ae0sjr","Type":"NodeParagraph","Properties":{"id":"20240902112219-6ae0sjr","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【归经】心；肝；脾；大肠经"}]},{"ID":"20240902112219-2yd2e8w","Type":"NodeParagraph","Properties":{"id":"20240902112219-2yd2e8w","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；利湿。主肺热喘咳；咽喉肿痛；肠痈；疖肿疮疡；毒蛇咬伤；热淋涩痛；水肿；痢疾；肠炎；湿热黄疸；癌肿"}]},{"ID":"20240902112219-k1liwvw","Type":"NodeParagraph","Properties":{"id":"20240902112219-k1liwvw","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g，大剂量可用至60g；或捣汁。外用：捣敷。"}]},{"ID":"20240902112219-hsthyl4","Type":"NodeParagraph","Properties":{"id":"20240902112219-hsthyl4","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【注意】《广西中药志》：孕妇慎用。"}]},{"ID":"20240902112219-3x2ms6a","Type":"NodeParagraph","Properties":{"id":"20240902112219-3x2ms6a","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902112219-fee0abu","Type":"NodeParagraph","Properties":{"id":"20240902112219-fee0abu","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"1.《潮州志·物产志》：茎叶榨汁次服，治盲肠炎，又可治一切肠病。"}]},{"ID":"20240902112219-83kv5q9","Type":"NodeParagraph","Properties":{"id":"20240902112219-83kv5q9","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"2.《广西中药志》：治小儿疳积，毒蛇咬伤，癌肿。外治白泡疮，蛇癞疮。"}]},{"ID":"20240902112219-vmmv13q","Type":"NodeParagraph","Properties":{"id":"20240902112219-vmmv13q","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"3.《闽南民间草药》：清热解毒，消炎止痛。"}]},{"ID":"20240902112219-9dee9qm","Type":"NodeParagraph","Properties":{"id":"20240902112219-9dee9qm","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"4.《泉州本草》：清热散瘀，消痈解毒。治痈疽疮疡，瘰疬。又能清肺火，泻肺热。治肺热喘促、嗽逆胸闷。"}]},{"ID":"20240902112219-3s8gein","Type":"NodeParagraph","Properties":{"id":"20240902112219-3s8gein","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"5.《广西中草药》：清热解毒，活血利尿。治扁桃体炎，咽喉炎，阑尾炎，肝炎，痢疾，尿路感染，小儿疳积。"}]},{"ID":"20240902112219-lcv0ucb","Type":"NodeParagraph","Properties":{"id":"20240902112219-lcv0ucb","updated":"20240902112234"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902112220-qtmbrqi","Type":"NodeThematicBreak","Properties":{"id":"20240902112220-qtmbrqi","updated":"20240902112234"}},{"ID":"20240902112221-1smuv1m","Type":"NodeParagraph","Properties":{"id":"20240902112221-1smuv1m","updated":"20240902112234"}}]}