n"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 511px;\" parent-style=\"width: 521px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 369px;","style":"width: 359px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独活 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独活 23-20240723115409-t4cq886.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 359px;\" parent-style=\"width: 369px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723125042-aj5d7db","Type":"NodeParagraph","Properties":{"id":"20240723125042-aj5d7db","updated":"20240723125042"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独活 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独活 24-20240723115504-jd0lgjk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723124920-j9qfgzo","Type":"NodeParagraph","Properties":{"id":"20240723124920-j9qfgzo","updated":"20240723125251"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图为独活，本草纲目认为羌地的独活，为羌活；"}]},{"ID":"20240723124918-djp5hyr","Type":"NodeThematicBreak","Properties":{"id":"20240723124918-djp5hyr"}},{"ID":"20240902145817-5eiwegj","Type":"NodeParagraph","Properties":{"id":"20240902145817-5eiwegj","updated":"20240902145826"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：羌活"}]},{"ID":"20240902145817-icvhtyv","Type":"NodeParagraph","Properties":{"id":"20240902145817-icvhtyv","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"羌活《中国药典》"}]},{"ID":"20240902145817-rzno2bi","Type":"NodeParagraph","Properties":{"id":"20240902145817-rzno2bi","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiānɡHuó"}]},{"ID":"20240902145817-vv8v2e0","Type":"NodeParagraph","Properties":{"id":"20240902145817-vv8v2e0","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMAETRADIXNOTOPTERYGII"}]},{"ID":"20240902145817-ypo1rls","Type":"NodeParagraph","Properties":{"id":"20240902145817-ypo1rls","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【别名】蚕羌、竹节羌、大头羌、狗引子花、曲药"}]},{"ID":"20240902145817-ckkbyo7","Type":"NodeParagraph","Properties":{"id":"20240902145817-ckkbyo7","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【来源】本品为伞形科植物羌活（背翅芹）NotopterygiumincisumTingexH.T.Chang或宽叶羌活NotopterygiumforbesiiBoiss.的干燥根茎及根。春、秋二季采挖，除去须根及泥沙，晒干。"}]},{"ID":"20240902145817-w1bl7dp","Type":"NodeParagraph","Properties":{"id":"20240902145817-w1bl7dp","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902145817-o3pzzsp","Type":"NodeParagraph","Properties":{"id":"20240902145817-o3pzzsp","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"羌活：为圆柱状略弯曲的根茎，长4～13cm,直径0.6～2.5cm。顶端具茎痕。表面棕褐色至黑褐色，外皮脱落处呈黄色。节间缩短，呈紧密隆起的环状，形似蚕习称“蚕羌”；节间延长，形如竹节状，习称“竹节羌”。节上有多数点状或瘤状突起的根痕及棕色破碎鳞片。体轻，质脆，易折断。断面不平整，有多数裂隙，皮部黄棕色至暗棕色，油润，有棕色油点，木部黄白色，射线明显，髓部黄色至黄棕色。气香，味微苦而辛。"}]},{"ID":"20240902145817-kfzueho","Type":"NodeParagraph","Properties":{"id":"20240902145817-kfzueho","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"宽叶羌活：为根茎及根。根茎类圆柱形，顶端具茎及叶鞘残基，根类圆锥形，有纵皱纹及皮孔；表面棕褐色，近根茎处有较密的环纹，长8～15cm,直径1～3cm，习称“条羌”。有的根茎粗大，不规则结节状，顶部具数个茎基，根较细，习称“大头羌”。质松脆，易折断。断面略平坦，皮部浅棕色，木部黄白色。气味较淡。"}]},{"ID":"20240902145817-h7jom0l","Type":"NodeParagraph","Properties":{"id":"20240902145817-h7jom0l","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【含量测定】照挥发油测定法（附录ⅩD）测定。本品含挥发油不得少于2.8％（ml/g）。"}]},{"ID":"20240902145817-4esm4io","Type":"NodeParagraph","Properties":{"id":"20240902145817-4esm4io","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240902145817-6wsgpzc","Type":"NodeParagraph","Properties":{"id":"20240902145817-6wsgpzc","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，温。"}]},{"ID":"20240902145817-n40b4kc","Type":"NodeParagraph","Properties":{"id":"20240902145817-n40b4kc","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【归经】归膀胱、肾经。"}]},{"ID":"20240902145817-fnbanb7","Type":"NodeParagraph","Properties":{"id":"20240902145817-fnbanb7","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【功能主治】散寒，祛风，除湿，止痛。用于风寒感冒头痛，风湿痹痛，肩背酸痛。"}]},{"ID":"20240902145817-3lc9erf","Type":"NodeParagraph","Properties":{"id":"20240902145817-3lc9erf","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240902145817-cy2yuli","Type":"NodeParagraph","Properties":{"id":"20240902145817-cy2yuli","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防蛀。"}]},{"ID":"20240902145817-8honcjf","Type":"NodeParagraph","Properties":{"id":"20240902145817-8honcjf","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240902145817-mc7n71w","Type":"NodeParagraph","Properties":{"id":"20240902145817-mc7n71w","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"（1）西北地区尚有以同科牛尾独活属（Heraeleum）多种植物的根作羌活用。"}]},{"ID":"20240902145817-4f4xjxe","Type":"NodeParagraph","Properties":{"id":"20240902145817-4f4xjxe","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"（2）羌活功能发散风寒，祛风止痛，用于感冒风寒，兼有头痛、身痛为主，常配防风、白芷等药同用。羌活祛风湿的作用也甚为显着，为祛风胜湿常用之品，但一般认为本品以风湿痹痛在身半以上者为宜，如周身痹痛，可配防风、独活等同用。对于头痛病症，多配合川芎、细辛等应用。"}]},{"ID":"20240902145817-xwbx7yt","Type":"NodeParagraph","Properties":{"id":"20240902145817-xwbx7yt","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"（3）作为发汗解表药时，应将它的祛风止痛功效密切结合起来，即在临床上用于风寒表症时，必须兼有头痛或骨节疼痛等症，才考虑使用。至于用治风湿痹痛，不论有无表症，都可应用。根据近年来临床实践体会，本品退热的功效很好，可配合清热药如蒲公英、板蓝根等品治风热表症，而且一般在热退之后无再度发热现象。但本品气味浓烈，用量过多，易致呕吐，故在使用时必须注意患者的胃那情况，掌握适当剂量。"}]},{"ID":"20240902145817-cu65dow","Type":"NodeParagraph","Properties":{"id":"20240902145817-cu65dow","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902145817-b3n3zx1","Type":"NodeParagraph","Properties":{"id":"20240902145817-b3n3zx1","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"羌活《*辞典》"}]},{"ID":"20240902145817-itkjt0b","Type":"NodeParagraph","Properties":{"id":"20240902145817-itkjt0b","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【出处】《本经》"}]},{"ID":"20240902145817-1qgttwu","Type":"NodeParagraph","Properties":{"id":"20240902145817-1qgttwu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiānɡHuó"}]},{"ID":"20240902145817-ikjwx98","Type":"NodeParagraph","Properties":{"id":"20240902145817-ikjwx98","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【别名】羌青、护羌使者（《本经》），胡王使者（《吴普本草》），羌滑（《本草蒙筌》），退风使者（《国药的药理学》），黑药（《青海药材》）。"}]},{"ID":"20240902145817-veql1po","Type":"NodeParagraph","Properties":{"id":"20240902145817-veql1po","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【来源】为伞形科植物羌活、宽叶羌活或川羌活的根及根茎。春、秋挖取根及根茎，去净茎叶细根、泥土，晒干或烘干。"}]},{"ID":"20240902145817-ojzl1ga","Type":"NodeParagraph","Properties":{"id":"20240902145817-ojzl1ga","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902145817-aar6tmq","Type":"NodeParagraph","Properties":{"id":"20240902145817-aar6tmq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①羌活"}]},{"ID":"20240902145817-gpug1i3","Type":"NodeParagraph","Properties":{"id":"20240902145817-gpug1i3","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"多年生草本，高达1米以上。根茎块状或长圆柱状。茎直立，表面淡紫色，有纵沟纹，中空，无毛。叶互生，茎下部的叶为2～3回单数羽状复叶；叶柄长10～20厘米，基部抱茎，两侧成鞘状；小叶3～4对，卵状披针形，小叶片2回羽状分裂，最后裂片具不等的钝锯齿，最下一对小叶具柄，最上一对个叶近无柄；茎上部叶近无柄。基部扩大呈长卵形的鞘而抱茎；叶片薄，上面深绿色，下面淡绿色，无毛。复伞形花序顶生或腋生，总伞梗10～15枚，长短不等，表面粗糙；无总苞。小伞形花序约有花20～30朵；萼片5枚，裂片三角形；花瓣白色，5枚，倒卵形，先端尖，向内折卷；雄蕊5个；花丝细，弯曲，花药椭圆形，2室；花柱2枚，短而反折，花柱基扁压状圆锥形，子房卵圆形，下位，2室。双悬果卵圆形，平滑无毛，背棱及中棱有翅，侧棱无翅，棱槽间通常有油管3～4个，合生面有油管5～6个，果实成熟时裂开成2分果，悬挂在两果柱的顶端。花期8～9月。果期9～10月。"}]},{"ID":"20240902145817-vnse7js","Type":"NodeParagraph","Properties":{"id":"20240902145817-vnse7js","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"生于高山灌木林或草丛中。分布青海、四川、云南、甘肃。"}]},{"ID":"20240902145817-3pw4rks","Type":"NodeParagraph","Properties":{"id":"20240902145817-3pw4rks","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②宽叶羌活，又名：鄂羌活。"}]},{"ID":"20240902145817-8flisyo","Type":"NodeParagraph","Properties":{"id":"20240902145817-8flisyo","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"多年生草本，高80～100厘米。有根茎。茎基部紫红色，表面有纵沟纹，无毛。中空，茎下部叶大，2回或近于3回的羽状复叶，叶柄长7～9厘米，基部成鞘状，抱茎；小叶的最后裂片卵状披针形，长2～4厘米，宽1～2厘米，先端渐尖，边缘又作不规则的羽状深裂；茎上部的叶片逐渐简化而成广阔膨大的紫色叶鞘；两面无毛，仅下面叶脉上稍有毛。复伞形花序上密生多数花，小伞梗长1厘米，小总苞片多数，线形，与小伞梗等长或稍短；花萼5片，狭三角形；花瓣5片，黄色，卵状披针形，长2毫米，宽0.6毫米，先喘渐尖，向内折卷；雄蕊5枚，与花瓣互生，花药椭圆形，花丝柔软向内弯曲；子房下位，2室，花柱2，甚短。双悬果具6翅，其分生果的背枝和中校有翅，而侧枝无翅。接合面向内凹。花果期7～8月。"}]},{"ID":"20240902145817-7fl9za0","Type":"NodeParagraph","Properties":{"id":"20240902145817-7fl9za0","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"野生在高山向阳山坡草丛及灌木丛中。分布四川、青海、陕西、河南等地。"}]},{"ID":"20240902145817-8bo6lyp","Type":"NodeParagraph","Properties":{"id":"20240902145817-8bo6lyp","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③川羌活"}]},{"ID":"20240902145817-1ngi5pe","Type":"NodeParagraph","Properties":{"id":"20240902145817-1ngi5pe","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～100厘米。根茎粗大，节间极短。茎基部常呈紫色，表面有纵沟纹。茎下部叶为3出2回羽状复叶，长约30厘米，有时可达60厘米；叶柄约为全长之半，有细棱，基部鞘状；小叶羽裂，下部第一对小叶有柄，其余常无柄，裂片披针形或卵形，边缘有尖或钝的粗齿，两面无毛。复伞形花序顶生或腋生，总伞梗15～20枚，有枝，平滑，无总苞；小总苞线形；萼齿5；花瓣5，黄绿色，倒卵形，先端狭尖而内卷；雄蕊5；花柱基凸出，柱头2。双悬果阔卵形，背棱和中棱均发达，有翅，侧棱无翅，棱槽问有袖管3～4个。花期7～8月。"}]},{"ID":"20240902145817-gayycer","Type":"NodeParagraph","Properties":{"id":"20240902145817-gayycer","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"分布四川、湖北、陕西、甘肃等地。"}]},{"ID":"20240902145817-6dizbm9","Type":"NodeParagraph","Properties":{"id":"20240902145817-6dizbm9","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902145817-xru1a74","Type":"NodeParagraph","Properties":{"id":"20240902145817-xru1a74","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"羌活药材因药用部分和形态不同而有蚕羌、竹节羌、大头羌、条羌等数种。"}]},{"ID":"20240902145817-u5t9ddv","Type":"NodeParagraph","Properties":{"id":"20240902145817-u5t9ddv","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①蚕羌：又名：螺丝羌。为干燥的根茎部，形态似蚕。呈圆柱状或略弯曲，长约4～10厘米，直径约1～2厘米。顶端有茎叶残基。表面棕褐色，有多数紧密而隆起的环节。节上密生疣状突起的须根痕。质轻松易折断，断面不齐，有明显的菊花纹和多数裂隙，皮部棕红色；木质部淡黄色，中央有黄白色髓，均有朱砂点（油管）。具特殊香气，味微苦而麻。"}]},{"ID":"20240902145817-u88lf91","Type":"NodeParagraph","Properties":{"id":"20240902145817-u88lf91","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②竹节羌：根茎的环节较稀，如竹节状，似蚕羌而略大。"}]},{"ID":"20240902145817-ugh193b","Type":"NodeParagraph","Properties":{"id":"20240902145817-ugh193b","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③大头羌：根茎的环节特别膨大，呈不规则团块状，大小不等，顶端具多数残留茎基，余皆与蚕羌相同。"}]},{"ID":"20240902145817-24917z6","Type":"NodeParagraph","Properties":{"id":"20240902145817-24917z6","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"④条羌：为干燥的根及支根。呈圆柱形或分枝，长3～17厘米，直径约0.7～1.7厘米，顶端偶可见有根茎，表面棕褐色，有纵纹及疣状突起的须根痕，上端较粗大，有稀疏隆起的环节，质疏松而脆、易折断，断面不平坦，皮部浅棕色，木部黄白色，有菊花纹，朱砂点不明显，中央无髓。气味较淡薄。"}]},{"ID":"20240902145817-37lkiqu","Type":"NodeParagraph","Properties":{"id":"20240902145817-37lkiqu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"以上均以条粗壮、有隆起曲折环纹、断面质紧密、朱砂点多、香气浓郁者为佳。一般认为蚕羌的品质最优，竹节羌次之，大头羌最次。"}]},{"ID":"20240902145817-s40v7y5","Type":"NodeParagraph","Properties":{"id":"20240902145817-s40v7y5","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"主产于四川（称川羌活）、甘肃、青海（称西羌活）。此外，陕西、云南、新疆、西藏等地亦产。"}]},{"ID":"20240902145817-8o1szlp","Type":"NodeParagraph","Properties":{"id":"20240902145817-8o1szlp","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【化学成份】宽叶羌活含挥发油等。"}]},{"ID":"20240902145817-uwd12ad","Type":"NodeParagraph","Properties":{"id":"20240902145817-uwd12ad","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，洗净。润透，切片，晾干。"}]},{"ID":"20240902145817-ooi4kkk","Type":"NodeParagraph","Properties":{"id":"20240902145817-ooi4kkk","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902145817-qg55bhv","Type":"NodeParagraph","Properties":{"id":"20240902145817-qg55bhv","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"辛苦，温。"}]},{"ID":"20240902145817-1qaiimb","Type":"NodeParagraph","Properties":{"id":"20240902145817-1qaiimb","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味苦辛，无毒。\""}]},{"ID":"20240902145817-1cravy8","Type":"NodeParagraph","Properties":{"id":"20240902145817-1cravy8","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"《主治秘要》云：性温，味辛。\""}]},{"ID":"20240902145817-jj93sar","Type":"NodeParagraph","Properties":{"id":"20240902145817-jj93sar","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"气微温，味苦甘，平。\""}]},{"ID":"20240902145817-tfiok43","Type":"NodeParagraph","Properties":{"id":"20240902145817-tfiok43","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902145817-7c272rv","Type":"NodeParagraph","Properties":{"id":"20240902145817-7c272rv","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"入膀胱、肾经。"}]},{"ID":"20240902145817-kh4zup0","Type":"NodeParagraph","Properties":{"id":"20240902145817-kh4zup0","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"足太阳膀胱经。\"\"手太阳小肠。\""}]},{"ID":"20240902145817-tdgshs3","Type":"NodeParagraph","Properties":{"id":"20240902145817-tdgshs3","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》：\"足太阳、厥阴经。\""}]},{"ID":"20240902145817-7767sfc","Type":"NodeParagraph","Properties":{"id":"20240902145817-7767sfc","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③《本草蒙筌》：\"手、足太阳，足少阴、厥阴经。\""}]},{"ID":"20240902145817-j0jy70r","Type":"NodeParagraph","Properties":{"id":"20240902145817-j0jy70r","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902145817-iydp6ll","Type":"NodeParagraph","Properties":{"id":"20240902145817-iydp6ll","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"散表寒，祛风湿，利关节。治感冒风寒，头痛无汗，风寒湿痹，项强筋急，骨节酸疼，风水浮肿，痈疽疮毒。"}]},{"ID":"20240902145817-8f1xqvd","Type":"NodeParagraph","Properties":{"id":"20240902145817-8f1xqvd","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"用于阳痿遗精，遗尿尿频，腰膝冷痛，肾虚作喘，五更泄泻；外用治白癜风，斑秃。解表散寒，祛风胜湿，止痛。"}]},{"ID":"20240902145817-k232dbi","Type":"NodeParagraph","Properties":{"id":"20240902145817-k232dbi","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1、用于外感风寒，恶寒发热，头痛身痛等证。本品有较强的发散风寒和止痛效果。常与防风、白芷、细辛等同用，如九味羌活汤。"}]},{"ID":"20240902145817-znj7dna","Type":"NodeParagraph","Properties":{"id":"20240902145817-znj7dna","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"2、用于风寒湿邪侵袭所致的肢节疼痛、肩背酸痛，尤以上半身疼痛更为适用。本品能祛风胜温，散寒止痛。常与防风、同用，如蠲痹汤。"}]},{"ID":"20240902145817-46gwaxq","Type":"NodeParagraph","Properties":{"id":"20240902145817-46gwaxq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"治贼风、失音不语，多痒血癞，手足不遂，口面歪邪，遍身顽痹。\""}]},{"ID":"20240902145817-paqm8es","Type":"NodeParagraph","Properties":{"id":"20240902145817-paqm8es","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治一切风并气，筋骨拳挛，四肢羸劣，头旋眼目赤疼及伏梁水气，五劳七伤，虚损冷气，骨节酸疼，通利五脏。\""}]},{"ID":"20240902145817-5i8o3zu","Type":"NodeParagraph","Properties":{"id":"20240902145817-5i8o3zu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》：\"太阳经头痛，去诸骨节疼痛，亦能温胆。\""}]},{"ID":"20240902145817-l2fk5gu","Type":"NodeParagraph","Properties":{"id":"20240902145817-l2fk5gu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"④《品汇精要》：\"主遍身百节疼痛，肌表八风贼邪，除新旧风湿，排腐肉疽疮.\""}]},{"ID":"20240902145817-q10kjg7","Type":"NodeParagraph","Properties":{"id":"20240902145817-q10kjg7","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑤《本草备要》：\"泻肝气，搜肝风，治风湿相搏，本经（太阳）头痛，督脉为病，脊强而厥，刚痉柔痉，中风不语，头旋目赤。\""}]},{"ID":"20240902145817-qwov7tj","Type":"NodeParagraph","Properties":{"id":"20240902145817-qwov7tj","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑥《会约医镜》：\"治邪闭憎寒，壮热无汗。\""}]},{"ID":"20240902145817-jfwx084","Type":"NodeParagraph","Properties":{"id":"20240902145817-jfwx084","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～5钱；或入丸、散。"}]},{"ID":"20240902145817-d8bi672","Type":"NodeParagraph","Properties":{"id":"20240902145817-d8bi672","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902145817-22lfauv","Type":"NodeParagraph","Properties":{"id":"20240902145817-22lfauv","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"血虚痹痛忌服。"}]},{"ID":"20240902145817-jt94apk","Type":"NodeParagraph","Properties":{"id":"20240902145817-jt94apk","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：\"血虚头痛及遍身疼痛骨痛因而带寒热者，此属内证，误用反致作剧。\""}]},{"ID":"20240902145817-n07hlkw","Type":"NodeParagraph","Properties":{"id":"20240902145817-n07hlkw","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902145817-h2i48li","Type":"NodeParagraph","Properties":{"id":"20240902145817-h2i48li","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902145817-bs60947","Type":"NodeParagraph","Properties":{"id":"20240902145817-bs60947","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①治感冒发热，扁桃体炎：羌活四至五钱，板蓝根、蒲公英各一两。水煎，每日一剂，分二次服。（上海中医学院附属龙华医院）"}]},{"ID":"20240902145817-8jb8s2j","Type":"NodeParagraph","Properties":{"id":"20240902145817-8jb8s2j","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②治太阳伤寒无汗：羌活、独活、荆芥、防风、广皮、甘草。煎服。（《医级》羌活汤）"}]},{"ID":"20240902145817-lhb8qh3","Type":"NodeParagraph","Properties":{"id":"20240902145817-lhb8qh3","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③解牙临寒：羌活、防风、苍术、细辛、川芎、白芷、生地、黄芩、甘草。水煎服，若急汗热服，以羹粥投之，若缓汗温服，而不用汤投之。（张元素九味羌活汤）"}]},{"ID":"20240902145817-k1gmpxq","Type":"NodeParagraph","Properties":{"id":"20240902145817-k1gmpxq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"④治太阳经头痛：防风二分，羌活三分，红豆二个。为末，鼻内搐之。（《玉机微义》）"}]},{"ID":"20240902145817-f51rury","Type":"NodeParagraph","Properties":{"id":"20240902145817-f51rury","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑤治客寒犯脑，脑痛连齿，手足厥冷，口鼻气冷之证：羌活一钱，附子、干姜各五分，炙甘草八分。水煎服。（《医学心悟》羌活附子汤）"}]},{"ID":"20240902145817-nju6hmd","Type":"NodeParagraph","Properties":{"id":"20240902145817-nju6hmd","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑥治风湿相搏，身体疼烦，掣痛不可屈伸，或身微肿不仁：羌活（去芦），附子（炮，去皮脐），白术，甘草（炙）等分。每服四钱，水一盏半、生姜五片，煎至七分，去滓，温服不拘时候。（《济生方》羌附汤）"}]},{"ID":"20240902145817-sbrab5k","Type":"NodeParagraph","Properties":{"id":"20240902145817-sbrab5k","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑦治肩背痛不可回顾，脊痛项强，腰似折，项似拔者：羌活、独活各一钱，藁本：防风、甘草（炙）、川芎各五分，蔓荆子三分。都作一服，水二盏，煎至一盏，去渣，大温服，空心食前。（《内外伤辨》羌活胜湿汤）"}]},{"ID":"20240902145817-7adsqfi","Type":"NodeParagraph","Properties":{"id":"20240902145817-7adsqfi","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902145817-6gt9ala","Type":"NodeParagraph","Properties":{"id":"20240902145817-6gt9ala","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"疗风宜用独活，兼水宜用羌活。\""}]},{"ID":"20240902145817-m1bh6k9","Type":"NodeParagraph","Properties":{"id":"20240902145817-m1bh6k9","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"羌活，治肢节疼痛，手足太阳本经风药也。加川芎治足太阳、少阴头痛、透关利节，又治风湿。《主治秘诀》云：其用有五：手足太阳引经，一也；风湿相兼，二也；去肢节痛，三也；除痈疽败血，四也；治风湿头痛，五也。\""}]},{"ID":"20240902145817-cfrozw6","Type":"NodeParagraph","Properties":{"id":"20240902145817-cfrozw6","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"羌活功能条达肢体，通畅血脉，攻彻邪气，发散风寒风湿。故疡证以之能排脓托毒，发溃生肌；目证以之治羞明隐涩，肿痛难开；风证以主治痿、痉、癫痫，麻痹厥逆。盖其体轻而不重，气清而不浊，味辛而能散，性行而不止，故上行于头，下行于足，遍达肢体，以清气分之邪也。\""}]},{"ID":"20240902145817-h7exx2l","Type":"NodeParagraph","Properties":{"id":"20240902145817-h7exx2l","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"羌活乃却乱反正之主帅，……风能胜湿，故羌活能治水湿，与芎藭同用，治太阳、厥阴头痛，发汗散表，透关利节，非时感冒之仙药也。昔人治劳力感寒，于补中益气汤中用之，深得补中寓泻之意。\""}]},{"ID":"20240902145817-jwg8a8p","Type":"NodeParagraph","Properties":{"id":"20240902145817-jwg8a8p","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"羌、独二活，古皆不分，《本经》且谓独活一名羌活，所以《本经》、《别录》，止有独活而无羌活。李氏《纲目》尚沿其旧。然二者形色既异，气味亦有浓淡之殊，虽皆以气胜，以疏导血气为用。通利机关，宣行脉络，其功若一。而羌活之气尤胜，则能直上顶巅，横行支臂，以尽其搜风通痹之职，而独活止能通行胸腹腰膝耳。颐之师门，恒以羌活专主上部之风寒湿邪，显与独活之专主身半以下者截然分用，其功尤捷，而外疡之一切风湿寒邪，着于肌肉筋骨者亦分别身半以上，身半以下，而以羌、独各为主治。若在腰脊背膂之部，或肢节牵挛，手足上下交痛，则竟合而用之，宣通络脉，更能神应，固不仅内科着痹，应手辄效，而外科之风寒湿邪，亦莫不投剂立验。又按羌活本含辛温之质，其治疗宜于风寒风湿，而独不宜于湿热，以湿邪化热，即为温病，似无再用辛温之理，然此惟内科证治为然，若外疡之属于湿热者，苟肿势延蔓，引及骨节筋肉伸缩不利，非以羌、独之善走宣通为治，则效力必缓，故虽热病，亦不避用，但仅以为向导而任佐使之职，则分量甚轻，其主任之君药，固犹是理湿清热之正剂，此亦发表不远热之大旨，非抱薪救火者所得以为借口也。\""}]},{"ID":"20240902145817-n2wgbtf","Type":"NodeParagraph","Properties":{"id":"20240902145817-n2wgbtf","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902145817-9dfpsau","Type":"NodeParagraph","Properties":{"id":"20240902145817-9dfpsau","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"羌活《中华本草》"}]},{"ID":"20240902145817-2zbewfe","Type":"NodeParagraph","Properties":{"id":"20240902145817-2zbewfe","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【出处】出自《神农本草经》。"}]},{"ID":"20240902145817-dy251cc","Type":"NodeParagraph","Properties":{"id":"20240902145817-dy251cc","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【拼音名】QiānɡHuó"}]},{"ID":"20240902145817-70asr8j","Type":"NodeParagraph","Properties":{"id":"20240902145817-70asr8j","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【英文名】IncisedNotopterygium,IncisedNotopterygiumRhizomeForbesNotopterygiumRizome,RhizomeorrootofIncisedNotopterygium,RhizomeorrootofForbesNotopterygium"}]},{"ID":"20240902145817-mj0y0u6","Type":"NodeParagraph","Properties":{"id":"20240902145817-mj0y0u6","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【别名】羌青、护羌使者、胡王使者、羌滑、退风使者、黑药"}]},{"ID":"20240902145817-aztess8","Type":"NodeParagraph","Properties":{"id":"20240902145817-aztess8","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902145817-a5tvcmw","Type":"NodeParagraph","Properties":{"id":"20240902145817-a5tvcmw","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"药材基源：为伞形科植物羌活或宽叶羌活的根茎和根。"}]},{"ID":"20240902145817-3wcpn5h","Type":"NodeParagraph","Properties":{"id":"20240902145817-3wcpn5h","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.NotopterygiumincisumTingexH.T.Chang2.NotopterygiumforbesiideBoiss.(N.fran-chetiideBoiss)"}]},{"ID":"20240902145817-pln618p","Type":"NodeParagraph","Properties":{"id":"20240902145817-pln618p","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培3-4年秋季倒苗后至早春萌芽前割除地上部分，挖取根茎，抖净泥沙，砍去芦头，除须根，切成10-13cm长的短节，晒干或烘干。"}]},{"ID":"20240902145817-8spghwq","Type":"NodeParagraph","Properties":{"id":"20240902145817-8spghwq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902145817-q7vmkrf","Type":"NodeParagraph","Properties":{"id":"20240902145817-q7vmkrf","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1、多年生草本，高60-150cm。根茎粗壮，圆柱形或不规则块状，暗棕色至棕红色，顶端有枯萎叶鞘，有特殊香气。茎直立，圆柱形，中空，表面淡紫色，有纵直细条纹。基生叶及茎下部叶有长柄，叶柄由基部向两侧扩展成膜质叶鞘，抱茎；叶片为三出三回羽状复叶，小叶3-4对，末回裂片卵状披针形至长圆卵形，长2-5cm，宽0.5-2cm，边缘缺刻状浅裂至羽深裂；茎上部叶简化成鞘状，近无柄，先端有羽状分裂的小叶片。复伞形花序顶生或腋生，直径3-13cm，侧生者常不育，总苞片3-6，线形，早落；伞辐7-18（-39），长2-10cm；小伞形花序直径1-2cm，小总苞片6=10，线形，长3-5mm；花多数，萼齿卵状三角形；花瓣5，白色，倒卵形，先端钝而内凹；雄蕊的花丝内弯，黄色；花柱2，很短，花柱基平压，稍隆起。分果长圆形，长4-6mm，宽约3mm，主棱均扩展为宽约1mm的翅，油管明显，每棱槽内3-4，合生面5-6，胚乳腹面内凹成沟槽状。花期7-9月，果期8-10月。"}]},{"ID":"20240902145817-38zrf4t","Type":"NodeParagraph","Properties":{"id":"20240902145817-38zrf4t","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"2、本种与羌活的区别点在于：植株高80-180cm。叶片大，三出二至三回羽状复叶，末回裂片长圆状卵形至卵状披针形，长3-8cm，宽1-3cm，先端钝或渐尖，基部略带楔形，边缘有粗锯齿，脉上及叶缘有微毛；茎上部叶少数，叶片简化，仅有3小叶。复伞形花序有伞辐10-17（-23），花瓣淡黄色。分生果近圆形，长约5mm，宽4mm，每棱槽内有油管3-4，合生面有油管4。花期7-8月，果期8-9月。"}]},{"ID":"20240902145817-5puiw9o","Type":"NodeParagraph","Properties":{"id":"20240902145817-5puiw9o","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902145817-m6ux762","Type":"NodeParagraph","Properties":{"id":"20240902145817-m6ux762","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔2000-4200m的林缘、灌丛下、沟谷草丛中。生于海拔1700-4500m的林缘及灌丛内。"}]},{"ID":"20240902145817-r9bkdww","Type":"NodeParagraph","Properties":{"id":"20240902145817-r9bkdww","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、甘肃、青海、四川、西藏等地。分布于内蒙古、山西、陕西、宁夏、甘肃、青海、湖北、四川等地。"}]},{"ID":"20240902145817-x7tfcyh","Type":"NodeParagraph","Properties":{"id":"20240902145817-x7tfcyh","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902145817-gwxtr9w","Type":"NodeParagraph","Properties":{"id":"20240902145817-gwxtr9w","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"生物学特性喜凉爽湿润气候，耐寒，稍耐荫。适宜在土层深厚、疏松、排水良好、富含腐殖质的砂壤土栽培，不宜在低湿地区栽种。"}]},{"ID":"20240902145817-4exc6ad","Type":"NodeParagraph","Properties":{"id":"20240902145817-4exc6ad","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子或根茎繁殖。种子繁殖：秋季采收成熟种子，晒干，于春季角冻后进行直播，按行距33cm，穴距23-27cm开穴，深5-7cm，每穴播种子10多粒，盖堆肥或腐殖质土约1-2cm，浇水。每1hm2用种子15kg左右。根茎繁殖：于秋季或春季收时进行，选具有芽的根茎，切成小段，繁段有1-2芽。条栽，按行距33cm开沟，沟深15-17cm，宽15cm，把根茎横放沟内，每隔8-10cm放1段，盖土杂肥或细土14-16cm，浇水。"}]},{"ID":"20240902145817-1jdzbgl","Type":"NodeParagraph","Properties":{"id":"20240902145817-1jdzbgl","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"田间管理种子直播的苗高8-10cm时匀苗、补苗，每穴留苗2-3株。生长期中每年中耕除草3次，结合追肥。冬季培土越冬，施腐离厩肥、堆肥、土杂肥、过磷酸钙等。用根茎繁殖的，除无匀苗工作外，其余管理与直播相同。"}]},{"ID":"20240902145817-kia1ka5","Type":"NodeParagraph","Properties":{"id":"20240902145817-kia1ka5","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"病虫害防治蚜虫，春、夏季发生，可用1：1：10烟草石灰水防治。"}]},{"ID":"20240902145817-p3uxtpc","Type":"NodeParagraph","Properties":{"id":"20240902145817-p3uxtpc","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902145817-fwa213e","Type":"NodeParagraph","Properties":{"id":"20240902145817-fwa213e","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）羌活为圆柱形略弯曲的根茎，长4-13cm，直径0.6-2.5cm。顶端具茎痕。表面棕褐色至黑褐色，外皮脱落处呈黄色。节间缩短，呈紧密隆起的环状，形似蚕（习称蚕羌）；或节是延长，形如竹节状（习称竹节羌）。节上有多数点状或瘤状突起的根良及色破碎鳞片。体轻，质脆，易折断。断面不平整，有多数裂隙，皮部黄棕色至暗棕色，油润，有棕色油点，木部黄白色，射线明显，髓部黄色至黄棕色。气香，味微苦而辛。"}]},{"ID":"20240902145817-t2tvrwg","Type":"NodeParagraph","Properties":{"id":"20240902145817-t2tvrwg","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"（2）宽叶羌活根茎类圆柱形，顶端具茎及叶鞘残基，根类圆锥形，有纵皱纹及皮孔；表面棕褐色，近根茎处有较密的环纹，长8-15cm，直径1-3cm（习称条羌）。有的根茎粗大，不规则结节状，顶部具数个茎基，根较细（习称大头羌）。质松脆，易折断。断面较平坦，皮部浅棕色，木部黄白色。气味较淡。"}]},{"ID":"20240902145817-uz7kl8n","Type":"NodeParagraph","Properties":{"id":"20240902145817-uz7kl8n","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"以根茎粗壮、有横节如蚕形，表面棕色，断面质紧密，朱砂点多，香气浓郁者为佳。"}]},{"ID":"20240902145817-6553662","Type":"NodeParagraph","Properties":{"id":"20240902145817-6553662","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"显微鉴别根茎横切面，（1）蚕羌木栓层为10余列细胞。皮层菲胞。皮层菲薄、韧皮部多裂隙。形成层成环。木质部导管较多。韧皮部、髓和射线中均有多数分泌道，圆形或不规则长圆形，直径至200μm，内含黄棕以油状物。"}]},{"ID":"20240902145817-74ygnyg","Type":"NodeParagraph","Properties":{"id":"20240902145817-74ygnyg","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"（2）宽叶羌活与羌活类同，但导管少，导管束中有成片的木纤维群。髓部宽大。分泌道直径至180μm粉末特征：棕黄色。①分泌道纵断面分泌细胞多狭长，壁薄或稍厚，内有淡黄色分泌物及淀粉粒溶化后的痕迹；并有金黄色状分泌物。②薄壁细胞纵长条形，常含淡黄色分泌物或油滴。③网纹、具缘纹也导管直径13-15μm。④木栓细胞内充满黄棕以或棕色物。"}]},{"ID":"20240902145817-yujf8jj","Type":"NodeParagraph","Properties":{"id":"20240902145817-yujf8jj","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【化学成份】1.羌活根茎含香豆精类化合物：异欧前胡内酯（isoimperatorin0.38%），8-甲氧基异欧前胡内酯（cnidilin0.，5-羟基香柑素（notopterol1.2%)，香柑内酯（bergapten0.009%)，8-（3，3-二甲基烯丙基）-5去甲基香柑内酯（demethylfuroinnarin)即5-羟基-8-（3，3-二甲基烯基）-补骨脂内酯[5-hydroxy-8(3，3-dimethylally)-psoralen，0.012%]，5-去甲基香柑醇（bergaptol0.088%），紫花前胡甙元（nodakenetin0.04%)，紫花前胡甙（nodakenin痕量），香柑醇-O-β-D-吡喃葡萄糖（bergaptol-O-β-D-glucopyranoside0.075%)，6-O-反-阿魏酰紫花前胡甙（6-O-trans-feruloylnodakenin0.022%)[1]，二氢山芹醇（colrmbianetin)、二氢山芹醇甙（columbiananine)、欧前胡内酯（imperatorin)、印度榅桲素（marmesin)[2]；酚性化合物：对-羟基苯乙基茴香酸酯（p-hydroxyphenethylanisate0.005%）、阿魏酸（ferulicacid0.89%)；甾醇类化合物：β-谷甾醇葡萄糖甙（β-sitosterolglucoside)[1]，β-谷甾醇（β-sitosterol)[2]；挥发油（约2.7%），其成分有α-侧柏烯（α-thujene)、α及β-蒎烯（α、β-pinene)、β罗勒烯（β-ocimene)，γ-松油烯（γ-terpinene)，柠檬烯（limonene)，4-松油烯醇（4-terpinenol)，乙酸龙脑酯（bornylacetate)，α-（王古）（王巴）烯（αcopaene)，反式-β-金合欢烯（β-farnesene)，欧芹脑（apiol)，愈创奥醇（guaiol)及苯甲酸苄酯（benzylbenzoate)等[3]；脂肪酸类：十四碳酸甲酯（methyltetradecanoate)，12-甲基十四碳酸甲酯（12-methyltetradecanoicacidmethylester)，十六碳酸甲酯（methylhex-adecanoate)，4，8，12-三甲基十三碳酸甲酯（4，8，12-trimethyl-tridecanoicacidmethylester)，14-甲基十六碳酸甲酯（14-methyl-hexadecanoicacidmethylester)，油酸甲酯（methyl-9-octadecenoate)，硬脂酸甲酯（methyloctadecanoate)，二十碳酸甲酯（methyleicosanoate)，11-二十碳烯酸甲酯（methyl-11-eicosenoate)等14种；氨基酸类：天冬氨酸（asparticacid)，谷氨酸（glutamicacid)，粗氨醇（arginine)，亮氨酸（leucine)，异亮氨酸（isoleucine)，缬氨酸（valine)，苏氨酸（threonine)，苯丙氨酸（phenylalanine)及蛋氨酸（methyionine)等19种；糖类，鼠李糖（rhamnose)，果糖（fructose)，葡萄糖（glucose)及蔗糖（sucrose)[4]。羌活还含苯乙基阿魏酸酯（phenethylferulate)[5].2.宽叶羌活地下部分含香豆精类化合物：香柑素（berg-amottin,bergaptin),异欧前胡内酯（0.62%，8-甲氧基异欧前胡内酯（0.024%），5-闳基香棋素（0.083%），香柑内酯（0.008%），8-（3，，3-二甲基烯丙基-5-去甲氧基香柑内酯（0.03%），香柑醇（0.026%），紫花前胡甙元（0.053）%，紫花前胡甙（1.2）%，6-O-反-阿魏酰紫花前胡甙（0.73)%[1],二氢山芹醇[5]；酚性化合物；对-羟基苯甲基茴香酸（0.07%），阿魏酸（0.83%)。还含β-谷甾醇葡萄糖甙[1]及挥发油，挥发油主要成分为α-蒎烯（36。30%），β-蒎烯（21.04%)，柠檬烯（14.42%)，此外，还有已醛（hexanal)，庚醛（heptanal)，辛醛（octanal)，香桧烯（sabinene)，樟烯（camphene)，月桂烯（myrcene)，α-水芹烯（α-phellandrene)，3-蒈烯（3-carene)，2-蒈烯（2-carene)，对-聚伞花素（p-cymene)，α、γ-松油烯，4-松油烯醇，乙酸龙脑酯及β-芹子烯（β-selinene)等20种[6]。"}]},{"ID":"20240902145817-itbknoi","Type":"NodeParagraph","Properties":{"id":"20240902145817-itbknoi","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902145817-lnoaiz3","Type":"NodeParagraph","Properties":{"id":"20240902145817-lnoaiz3","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.解热、抗炎作用：。"}]},{"ID":"20240902145817-eqy0sku","Type":"NodeParagraph","Properties":{"id":"20240902145817-eqy0sku","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.1.对酵母致热性大鼠体温的影响：大鼠皮下注射l5%酵母混悬液10ml/kg致热后2.5h，然后分别以羌活挥发油1.328ml／kg灌胃和0.133ml/kg灌胃给药，给药后不同时间测大鼠体温。结果与对照比较两种不同途径和不同剂量的挥发油均能使大鼠体温明显降低，具有显着的解热作用。"}]},{"ID":"20240902145817-qtrg0kz","Type":"NodeParagraph","Properties":{"id":"20240902145817-qtrg0kz","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.2.对小鼠二甲苯耳水肿的影响：小鼠分别灌胃羌活挥发油1.328、0.664、0.332、0.221ml／kg，给药后右耳滴二甲苯0.03ml／只，计算左右耳片重量差（mg）。结果与对照组（12.5±6.01）比较，分别为：6.6±4.40、7.2±3.16、7.0±4.21、15.9±5.28。前3个剂量组与对照组比较P＜0.05。表明能显着抑制二甲苯耳水肿。"}]},{"ID":"20240902145817-30pyqip","Type":"NodeParagraph","Properties":{"id":"20240902145817-30pyqip","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.3.对角叉菜胶足肿胀的影响:大鼠口服1.328、0.664ml／kg或腹腔注射0.133、0.066ml／kg对大鼠角叉菜（1%0.1ml）足肿胀有抑制作用。与对照组比较口服1.328ml／kg组在注射角叉菜胶后3或4小时P＜0.05，口服0.664ml／kg组24小时时P＜0.001，腹腔注射0.133ml／kg组24小时，P＜0.05。"}]},{"ID":"20240902145817-ipi8gej","Type":"NodeParagraph","Properties":{"id":"20240902145817-ipi8gej","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.4.对大鼠右旋糖酐足肿胀的影响：大鼠口服羌活挥发油1.328、0.664、0.332ml/kg，给药后30分钟于大鼠后足跖腱膜下注射1.2%右旋糖酐0.1ml／只。结果与对照组比较，仅1.328ml／kg组，在3、5、6小时时的抑制作用有显着差异P＜0.05。"}]},{"ID":"20240902145817-kcly6so","Type":"NodeParagraph","Properties":{"id":"20240902145817-kcly6so","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"2.镇痛作用：小鼠口服l.328ml／kg或腹腔注射0.133mi／kg羌活挥发油连续3天，对腹腔注射0.5%醋酸溶液0.2ml/kgl0分钟的扭体次数有明显的减少。与对照组比较有极显着作用，P值均为＜0.001。对小鼠热刺激痛阈值亦能明显延长，表明有显着的镇痛作用。"}]},{"ID":"20240902145817-t9mxaq9","Type":"NodeParagraph","Properties":{"id":"20240902145817-t9mxaq9","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"3.对2，4硝基氯苯（DNCB）所致小鼠迟发超敏反应的影响：小鼠灌胃羌活挥发油1.328ml／kg或腹腔注射0.133ml／kg，连续10天，对DNCB所致迟发型超敏反应有一定的抑制作用，与对照组比较肿胀度分别为：2.3±1.96、1.2±0.76、1.1±0.85。"}]},{"ID":"20240902145817-g3ttx9p","Type":"NodeParagraph","Properties":{"id":"20240902145817-g3ttx9p","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"4.抗心律失常作用：羌活水溶部分给予雄性小鼠分别以1.5、3、6、10、12g/kg，对尾静脉注射乌头碱0.06mg／kg所致的心律失常有显着的对抗作用，与对照组比较3和6g／kg组的P值为＜0.01，10g／kg组P＜0.001；剂量加至12g／kg时，其作用反而有所下降P＜0.05。大鼠口服10g／kg羌活水溶部分，对静脉注射0.04mg／kg的乌头碱诱发的心律失常出现时间的推迟有极显着作用，与对照组比较P＜0.001，心律失常持续时间也有极显着的缩短，P＜0.001。家兔口服羌活水溶部分5g/kg可显着缩短氯仿-肾上腺素引起的家兔心律失常的持续时间。羌活于粉灰化后给予小鼠，对乌头碱诱发的心律失常的出现时间和持续时间均无明显作用。宽叶羌活水提物给予小鼠口服l0g／kg，不能延长心律失常的潜伏期和缩短持续时间。口服20g／kg剂量时，只能缩短小鼠心律失常的持续时间P＜0.01。羌活水提物20g／kg口服给予大鼠，可显着延长由氯化钙诱发的室颤发生时间，P＜0.01。"}]},{"ID":"20240902145817-pcfax52","Type":"NodeParagraph","Properties":{"id":"20240902145817-pcfax52","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"5.对急性心肌缺血和心肌营养性血流量的影响：羌活挥发油口服给于大鼠，然后以尾静脉注射给予脑垂体后叶素0.75u／kg引起急性心肌缺血。结果：6%羌活挥发油0.6g／kg组和3%羌活挥发油0.3g／kg组均有对抗心肌缺血作用，与对照组比较P值分别为＜0.01和＜0.05。用心肌对86Rb的摄取率，观察羌活挥发油对心肌营养性血流量的影响。结果：2.5%羌活挥发油0.75g／kg剂量可显着增加心肌对86Rb的摄取率，与对照组比较增加率为21.1%，P＜0.01。"}]},{"ID":"20240902145817-kowmk9k","Type":"NodeParagraph","Properties":{"id":"20240902145817-kowmk9k","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【毒性】羌活挥发油灌胃对小鼠的LD50为2.83g/kg及6.64±0.8726ml/kg。小鼠以不同剂量的羌活挥发油灌胃，观察7天，其LD50为6.64±0.8726ml／kg。羌活水溶部分以最大浓度和最大允许体积灌胃给予小鼠12g／kg，观察72小时，小鼠活动正常，无死亡。羌活挥发油乳剂以0.75g／kg灌胃给予小鼠，观察24小时，活动正常，无任何异常反应。小鼠灌胃给药的LD50为2.83g／kg。"}]},{"ID":"20240902145817-mhzjddu","Type":"NodeParagraph","Properties":{"id":"20240902145817-mhzjddu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取粉末0.5g，加入乙醚适量，冷浸1h，滤过，滤液浓缩至1ml，加7%盐酸羟胺甲醇液2-3滴、20%氢氧化钾乙醇液3滴，在水浴上微热，冷热，冷却后，加稀盐酸调节pH至3-4，再加1%三氯化铁乙醇溶液1-2滴，于醚层界面处显紫红色。（检查香豆素和内酯类）"}]},{"ID":"20240902145817-840pzu0","Type":"NodeParagraph","Properties":{"id":"20240902145817-840pzu0","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，洗净，润透，切片，晾干。"}]},{"ID":"20240902145817-arr8d79","Type":"NodeParagraph","Properties":{"id":"20240902145817-arr8d79","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；苦；性温"}]},{"ID":"20240902145817-c5gux6q","Type":"NodeParagraph","Properties":{"id":"20240902145817-c5gux6q","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【归经】归膀胱；肾经"}]},{"ID":"20240902145817-jbyprqu","Type":"NodeParagraph","Properties":{"id":"20240902145817-jbyprqu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【功能主治】散表寒；祛风湿；利关节；止痛。主外感风寒；头痛无汗；油印寒湿痹；风水浮肿；疮疡肿毒"}]},{"ID":"20240902145817-t5enwtk","Type":"NodeParagraph","Properties":{"id":"20240902145817-t5enwtk","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；或入丸、散。"}]},{"ID":"20240902145817-2yy57cu","Type":"NodeParagraph","Properties":{"id":"20240902145817-2yy57cu","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902145817-ud2cghq","Type":"NodeParagraph","Properties":{"id":"20240902145817-ud2cghq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.血虚痹痛忌服。"}]},{"ID":"20240902145817-r6n0xl4","Type":"NodeParagraph","Properties":{"id":"20240902145817-r6n0xl4","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：血虚头痛及遍身疼痛骨痛因而带寒热者，此属内证，误用反致作剧。"}]},{"ID":"20240902145817-kxpd30l","Type":"NodeParagraph","Properties":{"id":"20240902145817-kxpd30l","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902145817-o1eszn8","Type":"NodeParagraph","Properties":{"id":"20240902145817-o1eszn8","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：疗风宜用独活，兼水宜用羌活。"}]},{"ID":"20240902145817-n7hajhp","Type":"NodeParagraph","Properties":{"id":"20240902145817-n7hajhp","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"2.《医学启源》：羌活，治肢节疼痛，手足太阳本经风药也。加川芎治足太阳、少阴头痛、透关利节，又治风湿。《主治秘诀》云：其用有五：手足太阳引经，一也；风湿相兼，二也；去肢节痛，三也；除痈疽败血，四也；治风湿头痛，五也。"}]},{"ID":"20240902145817-3ih8dny","Type":"NodeParagraph","Properties":{"id":"20240902145817-3ih8dny","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：羌后、独活，皆能逐风胜湿，透关利节，但气有刚劣不同尔。"}]},{"ID":"20240902145817-d34s6m6","Type":"NodeParagraph","Properties":{"id":"20240902145817-d34s6m6","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"4.《雷公炮制药性解》：羌活气清属阳，善行气分，舒而不敛，升而能沉，雄而善散，可发表邪，故入手太阳小肠。足太阳膀胱以理游风，其功用与独活虽若不同，实互相表里。"}]},{"ID":"20240902145817-vk2ftgq","Type":"NodeParagraph","Properties":{"id":"20240902145817-vk2ftgq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"5.《本草汇言》：羌活功能条达肢体，通畅血脉，攻彻邪气，发散风寒风湿。故疡证以之能排脓托毒，发溃生肌；目证以之治羞明隐涩，肿痛难开；风证以之治痿、痉。癫痫，麻痹厥逆。盖其体轻而不重，气清而不浊，味辛而能散，性行而不止，故上行于头，下行于足，遍达肢体，以清气分之邪也。"}]},{"ID":"20240902145817-mewzjfg","Type":"NodeParagraph","Properties":{"id":"20240902145817-mewzjfg","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"6.《本经逢原》：羌活乃却乱反正之主帅，风能胜湿，故羌活能治水湿，与芎穷同用，治太阳、厥阴头痛，发汗散表，透关利节，非时感冒之仙药也。昔人治劳力感寒，于补中益气汤中用之，深得补中寓泻之意。"}]},{"ID":"20240902145817-j5gdlce","Type":"NodeParagraph","Properties":{"id":"20240902145817-j5gdlce","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"7.《本草正义》：羌、独二活，古皆不分，《本经》且谓独活一名羌活，所以《本经》、《别录》，止有独活而无羌活。李氏《纲目》尚沿其旧。然二者形色既异，气味亦有浓淡之殊，虽皆以气胜，以疏导血气为用。通利机关，宣行脉络，其功若一。而羌活上气尤胜，则能直上顶巅，横行支臂，以尽其搜风通痹之职，而独活止能通行胸腹腰膝耳。颐之师门，恒以羌活专主上部之风寒湿邪，显与独活之专主身半以下者截然分用，其功尤捷，而外疡之一切风湿寒邪，着于肌肉筋骨者亦分别身半以上，身半以下，而以羌、独各为主治。若在腰脊背膂之部，或肢节牵挛，手足上下交痛，则竟合而用之，宣通络脉，更能神应，固不仅内科着痹，应手辄效，而外科之风寒湿邪，亦莫不投剂立验。又按羌活本含辛温之质，其治疗宜于风寒风湿，而独不宜于湿热，以湿邪化热，即为温病，似无再用辛温之理，然此惟内科证治为然，若外疡之属于湿热者，苟肿势延蔓，引及骨节筋肉伸缩不利，非以羌、独之善走宣通为治，则效力必缓，故虽热病，亦不避用，但仅以为向导而任佐使之职，则分量甚轻，其主任之君药，固犹是理湿清热之正剂，此亦发表不远热之大旨，非抱薪救火者所得以为借口也。"}]},{"ID":"20240902145817-ctwytyn","Type":"NodeParagraph","Properties":{"id":"20240902145817-ctwytyn","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：治贼风、失音不语，多痒血癞，手足不遂，口面歪邪，遍身顽痹。"}]},{"ID":"20240902145817-djb23zh","Type":"NodeParagraph","Properties":{"id":"20240902145817-djb23zh","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"9.《日华子本草》：治一切风并气，筋骨拳挛，四肢赢劣，头旋眼目赤疼及伏梁水气，五劳七伤，虚损冷气，骨节酸疼，通利五脏。"}]},{"ID":"20240902145817-4eqbnu7","Type":"NodeParagraph","Properties":{"id":"20240902145817-4eqbnu7","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"10.《珍珠囊》：太阳经头痛，去诸骨节疼痛，亦能温胆。"}]},{"ID":"20240902145817-sm6341x","Type":"NodeParagraph","Properties":{"id":"20240902145817-sm6341x","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"11.《品汇精要》：主遍身百节疼痛，肌表八风贼邪，除新旧风湿，排腐肉疽疮。"}]},{"ID":"20240902145817-zvyehuq","Type":"NodeParagraph","Properties":{"id":"20240902145817-zvyehuq","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"12.《本草备要》：泻肝气，搜胖风，治风湿相搏，本经（太阳）头痛，督脉为病，脊强而厥，刚痉柔痉，中风不语，头旋目亦。"}]},{"ID":"20240902145817-5tuw2da","Type":"NodeParagraph","Properties":{"id":"20240902145817-5tuw2da","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"13.《会约医镜》：治邪闭憎寒，壮热无汗。"}]},{"ID":"20240902145817-059yobh","Type":"NodeParagraph","Properties":{"id":"20240902145817-059yobh","updated":"20240902145855"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902145818-1u1hrbd","Type":"NodeThematicBreak","Properties":{"id":"20240902145818-1u1hrbd","updated":"20240902145855"}},{"ID":"20240902145819-kx9v1jk","Type":"NodeParagraph","Properties":{"id":"20240902145819-kx9v1jk","updated":"20240902145855"}}]}