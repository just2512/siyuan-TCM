:"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 14-20240717081224-iywj4v5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717080803-mrf6m82","Type":"NodeParagraph","Properties":{"id":"20240717080803-mrf6m82","updated":"20240717080813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 779px;","style":"width: 769px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛蒡子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 10-20240717080735-d6e9jod.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 769px;\" parent-style=\"width: 779px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 369px;","style":"width: 359px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛蒡子 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 11-20240717080813-bysmdc0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 359px;\" parent-style=\"width: 369px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717085930-lm41vbx","Type":"NodeParagraph","Properties":{"id":"20240717085930-lm41vbx","updated":"20240717094522"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1126px;","style":"width: 1116px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛蒡子 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 19-20240717094458-g9s3qla.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1116px;\" parent-style=\"width: 1126px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717094559-it446m0","Type":"NodeParagraph","Properties":{"id":"20240717094559-it446m0","updated":"20240717094602"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛蒡子 (21)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 21-20240717094559-clleemk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛蒡子 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛蒡子 20-20240717094602-azkxxbh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902102537-r627sdp","Type":"NodeParagraph","Properties":{"id":"20240902102537-r627sdp","updated":"20240902102543"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为牛蒡的种子；"}]},{"ID":"20240717081302-je8y20o","Type":"NodeParagraph","Properties":{"id":"20240717081302-je8y20o","updated":"20240902102534"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：牛蒡根形似山药，性比人参，所以也叫白肌人参。"}]},{"ID":"20240717081629-s3s155h","Type":"NodeParagraph","Properties":{"id":"20240717081629-s3s155h","updated":"20240902102536"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：牛蒡原产我国，光大于国外。日本从我国引入，经过培育后成了日本人从小吃到大的一种营养价值极高的蔬菜，并凭借它独特的香气走遍东南亚，被誉为东洋参。牛蒡根价值也很高，可以做牛蒡茶，在众多牛蒡茶当中，深受好评的就是来自有中国牛蒡之乡的山东庄坞。"}]},{"ID":"20240717080410-pdnmbdw","Type":"NodeThematicBreak","Properties":{"id":"20240717080410-pdnmbdw"}},{"ID":"20240717080543-aovyakv","Type":"NodeParagraph","Properties":{"id":"20240717080543-aovyakv","updated":"20240902102626"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛蒡子"}]},{"ID":"20240902102626-7rr95tm","Type":"NodeParagraph","Properties":{"id":"20240902102626-7rr95tm","updated":"20240902102634"},"Children":[{"Type":"NodeText","Data":"性味：辛、苦，寒。"}]},{"ID":"20240902102635-xgv2chj","Type":"NodeParagraph","Properties":{"id":"20240902102635-xgv2chj","updated":"20240902102641"},"Children":[{"Type":"NodeText","Data":"归经：归肺、胃经。"}]},{"ID":"20240902102642-vkhlkwr","Type":"NodeParagraph","Properties":{"id":"20240902102642-vkhlkwr","updated":"20240902102647"},"Children":[{"Type":"NodeText","Data":"功能：疏散风热，宣肺利咽，解毒透疹，消肿疗疮。"}]},{"ID":"20240902102650-89dn5mt","Type":"NodeParagraph","Properties":{"id":"20240902102650-89dn5mt","updated":"20240902102657"},"Children":[{"Type":"NodeText","Data":"主治：风热感冒，温病初起，麻疹不透，痈肿疮毒。"}]},{"ID":"20240902102658-lacem0s","Type":"NodeParagraph","Properties":{"id":"20240902102658-lacem0s","updated":"20240902102712"},"Children":[{"Type":"NodeText","Data":"使用注意：牛蒡子性寒，滑肠通便，气虚便溏者慎用。"}]},{"ID":"20240902102713-5lc7k5r","Type":"NodeParagraph","Properties":{"id":"20240902102713-5lc7k5r","updated":"20240902102725"},"Children":[{"Type":"NodeText","Data":"相关论述："}]},{"ID":"20240902102726-zr3n8nf","Type":"NodeParagraph","Properties":{"id":"20240902102726-zr3n8nf","updated":"20240902102732"},"Children":[{"Type":"NodeText","Data":"1《本草经疏》：“恶实，为散风除热解毒之要药。辛能散结，苦能泄热，热结散则脏气清明，故明目而补中。风之所伤，卫气必壅，壅则发热，辛凉解散则表气和，风无所留矣。藏器主风毒肿诸痿；元素主润肺、散结气、利咽膈、去皮肤风、通十二经络者，悉此意耳。故用以治瘾疹、痘疮，尤获奇验。”\n2《药性论》：“除诸风，去丹毒，主明目，利腰脚，又散诸结节、筋骨烦热毒。”\n3《本草拾遗》：“主风毒肿，诸痿。”\n4《本草求真》：“牛蒡子，今人止言解毒，凡遇疮疡痈肿、痘疹等症，无不用此投治，然犹未绎其义。凡人毒气之结，多缘外感风寒，营气不从，逆于肉里，故生痈毒。牛蒡味辛且苦，既能降气下行，复能散风除热，是以感受风邪热毒而见面目浮肿，咳嗽痰壅，咽间肿痛，疮疡斑疹，及一切臭毒、痧闭、痘疮紫黑、便闭等症，无不借此表解里清。但性冷滑利，多服则中气有损，且更令表益虚矣。至于脾虚泄泻为尤忌焉。”\n5《本草乘雅半偈》：“此秉风大动摇之用，故抽水土之力独胜。味辛气平，为风木乃制为用矣。则凡病从风生，或因风寒薄郁乃成痤者，取之捷如影响，设属形层之外与上部者，功力尤胜。此以承制之品，宣助肝木，便无太过之失，厥受和平之益矣。”"}]},{"ID":"20240902102622-mxgt694","Type":"NodeThematicBreak","Properties":{"id":"20240902102622-mxgt694"}},{"ID":"20240902102623-od29in0","Type":"NodeParagraph","Properties":{"id":"20240902102623-od29in0"}}]}