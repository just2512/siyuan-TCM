panIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240903094006-pz3kcqz","Type":"NodeParagraph","Properties":{"id":"20240903094006-pz3kcqz","updated":"20240903094006"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麻黄 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麻黄 11-20240813152518-mkdkmhe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 574px;","style":"width: 564px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麻黄 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麻黄 12-20240813152604-bi6brja.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 564px;\" parent-style=\"width: 574px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205165311-dxnsn7j","Type":"NodeThematicBreak","Properties":{"id":"20240205165311-dxnsn7j"}},{"ID":"20240903094201-tkhnw50","Type":"NodeParagraph","Properties":{"id":"20240903094201-tkhnw50","updated":"20240903094208"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：麻黄根"}]},{"ID":"20240903094201-37omncs","Type":"NodeParagraph","Properties":{"id":"20240903094201-37omncs","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"麻黄根《中国药典》"}]},{"ID":"20240903094201-25lidbx","Type":"NodeParagraph","Properties":{"id":"20240903094201-25lidbx","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【拼音名】MáHuánɡGēn"}]},{"ID":"20240903094201-6q82sjc","Type":"NodeParagraph","Properties":{"id":"20240903094201-6q82sjc","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXEPHEDRAE"}]},{"ID":"20240903094201-pit8bs9","Type":"NodeParagraph","Properties":{"id":"20240903094201-pit8bs9","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【来源】本品为麻黄科植物草麻黄EphedrasinicaStapf或中麻黄EphedraintermediaSchrenketC.A.Mey.的干燥根及根茎。秋末采挖，除去残茎、须根及泥沙，干燥。"}]},{"ID":"20240903094201-ecia3gv","Type":"NodeParagraph","Properties":{"id":"20240903094201-ecia3gv","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈圆柱形，略弯曲，长8～25cm,直径0.5～1.5cm。表面红棕色或灰棕色，有纵皱纹及支根痕。外皮粗糙，易成片状剥落。根茎具节，节间长0.7～2cm，表面有横长突起的皮孔。体轻，质硬而脆，断面皮部黄白色，木部淡黄色或黄色，射线放射状，中心有髓。无臭，味微苦。"}]},{"ID":"20240903094201-mefmwgo","Type":"NodeParagraph","Properties":{"id":"20240903094201-mefmwgo","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品根的横切面：木栓细胞10余列，其外有落皮层。皮层为数列薄壁细胞，含草酸钙砂晶。中柱鞘由纤维及石细胞组成。韧皮部窄。形成层成环。木质部发达，由导管、管胞及木纤维组成；射线宽广，含草酸钙砂晶。有的髓部有纤维；薄壁细胞具纹孔。根茎的射线较窄。粉末棕红色或棕黄色。木栓细胞呈长方形，棕色，含草酸钙砂晶。纤维多单个散在，直径20～25μm,壁厚，木化，斜纹孔明显。螺纹、网纹导管直径30～50μm,导管分子穿孔板上具多数圆形孔。有的可见石细胞，呈长圆形，类纤维状或有分枝，直径20～50μm,壁厚。髓部薄壁细胞类方形、类长方形或类圆形，壁稍厚，具纹孔。薄壁细胞含草酸钙砂晶。"}]},{"ID":"20240903094201-avmhdu8","Type":"NodeParagraph","Properties":{"id":"20240903094201-avmhdu8","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240903094201-utbfleo","Type":"NodeParagraph","Properties":{"id":"20240903094201-utbfleo","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性味】甘，平。"}]},{"ID":"20240903094201-8b1ij2m","Type":"NodeParagraph","Properties":{"id":"20240903094201-8b1ij2m","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【归经】归心、肺经。"}]},{"ID":"20240903094201-87xa3yp","Type":"NodeParagraph","Properties":{"id":"20240903094201-87xa3yp","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【功能主治】止汗。用于自汗，盗汗。"}]},{"ID":"20240903094201-qhy6of9","Type":"NodeParagraph","Properties":{"id":"20240903094201-qhy6of9","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。外用适量研粉撒扑。"}]},{"ID":"20240903094201-5dmp1tb","Type":"NodeParagraph","Properties":{"id":"20240903094201-5dmp1tb","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240903094201-ywhmflo","Type":"NodeParagraph","Properties":{"id":"20240903094201-ywhmflo","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903094201-4om12n7","Type":"NodeParagraph","Properties":{"id":"20240903094201-4om12n7","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"麻黄根《*辞典》"}]},{"ID":"20240903094201-lygzt3i","Type":"NodeParagraph","Properties":{"id":"20240903094201-lygzt3i","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【出处】《本草经集注》"}]},{"ID":"20240903094201-pleddu1","Type":"NodeParagraph","Properties":{"id":"20240903094201-pleddu1","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【拼音名】MáHuánɡGēn"}]},{"ID":"20240903094201-zpvwyvq","Type":"NodeParagraph","Properties":{"id":"20240903094201-zpvwyvq","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【别名】苦椿菜（《大同府志》）"}]},{"ID":"20240903094201-9zvwuyv","Type":"NodeParagraph","Properties":{"id":"20240903094201-9zvwuyv","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【来源】为麻黄科植物草麻黄或木贼麻黄或中麻黄的根及根茎。立秋后采挖，去净须根及茎苗，晒干。"}]},{"ID":"20240903094201-7oal75y","Type":"NodeParagraph","Properties":{"id":"20240903094201-7oal75y","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产内蒙古、辽宁、江西、河北、陕西、甘肃等地。"}]},{"ID":"20240903094201-85x6zd3","Type":"NodeParagraph","Properties":{"id":"20240903094201-85x6zd3","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性状】干燥根弯曲不整，长约20厘米，粗约2厘米，表面红棕色，有明显的纵沟，根茎有突起的节。质坚硬，纵劈之，内部有众多之纵行纤维；横断面木质部有很多空隙，从中心向外放射，色淡黄。"}]},{"ID":"20240903094201-ce7e0mj","Type":"NodeParagraph","Properties":{"id":"20240903094201-ce7e0mj","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，除去残茎，用水浸泡，捞出，润透后切片，晒干。"}]},{"ID":"20240903094201-az9g43e","Type":"NodeParagraph","Properties":{"id":"20240903094201-az9g43e","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903094201-cvuyo0t","Type":"NodeParagraph","Properties":{"id":"20240903094201-cvuyo0t","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"甘，平，无毒。\""}]},{"ID":"20240903094201-cn30urw","Type":"NodeParagraph","Properties":{"id":"20240903094201-cn30urw","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"②《本草正》：\"味甘微苦、微涩，乎。\""}]},{"ID":"20240903094201-0ookaej","Type":"NodeParagraph","Properties":{"id":"20240903094201-0ookaej","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903094201-1y5583v","Type":"NodeParagraph","Properties":{"id":"20240903094201-1y5583v","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"治体虚自汗、盗汗。"}]},{"ID":"20240903094201-dx69vne","Type":"NodeParagraph","Properties":{"id":"20240903094201-dx69vne","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"止汗，夏月杂粉用之。\""}]},{"ID":"20240903094201-402tvga","Type":"NodeParagraph","Properties":{"id":"20240903094201-402tvga","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"止汗，实表气，固虚，消肺气、梅核气。\""}]},{"ID":"20240903094201-syf8m6z","Type":"NodeParagraph","Properties":{"id":"20240903094201-syf8m6z","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"敛汗固表。治阳虚自汗，阴虚盗汗。\""}]},{"ID":"20240903094201-78slf6j","Type":"NodeParagraph","Properties":{"id":"20240903094201-78slf6j","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；或入丸、散。外用：研细作扑粉。"}]},{"ID":"20240903094201-0xk91ws","Type":"NodeParagraph","Properties":{"id":"20240903094201-0xk91ws","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【注意】有表邪者忌服。"}]},{"ID":"20240903094201-vu07zzs","Type":"NodeParagraph","Properties":{"id":"20240903094201-vu07zzs","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903094201-jq5kmue","Type":"NodeParagraph","Properties":{"id":"20240903094201-jq5kmue","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"①治诸虚不足，及新病暴虚，津液不固，体常自汗，夜卧即甚，久而不止，羸瘠枯瘦，心忪惊惕，短气烦倦：黄芪（去苗、土）、麻黄根（洗）、牡蛎（米泔浸，刷去土，火烧通赤）各一两。上三味，为粗散。每服三钱，水一盏半，小麦百余粒，同煎至八分，去滓热服，日二服，不拘时候。（《局方》牡蛎散）"}]},{"ID":"20240903094201-z83bfzz","Type":"NodeParagraph","Properties":{"id":"20240903094201-z83bfzz","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"②治虚汗无度：麻黄根、黄芪等分。为末，飞面糊，作丸梧子大。每用浮麦汤下百丸，以止为度。（《谈野翁试验方》）"}]},{"ID":"20240903094201-a678jli","Type":"NodeParagraph","Properties":{"id":"20240903094201-a678jli","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"③治产后虚汗不止：㈠当归一两（锉，微妙），麻黄根二两，黄芪一两（锉）。上药，捣粗罗为散。每服四钱，以水一中盏，煎至六分，去滓，不计时候温服。（《圣惠方》麻黄根散）㈡牡蛎粉三分，麻黄根二两。捣细罗为散，用扑身上。（《圣惠方》麻黄根散）"}]},{"ID":"20240903094201-8yt84ds","Type":"NodeParagraph","Properties":{"id":"20240903094201-8yt84ds","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"④治肾劳热，阴囊生疮：麻黄根、石硫黄各三两，米粉五合。上三味治下筛，安絮如常用粉法搭疮上，粉湿，更搭之。（《千金方》麻黄根粉）"}]},{"ID":"20240903094201-zekddsv","Type":"NodeParagraph","Properties":{"id":"20240903094201-zekddsv","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903094201-dy73exk","Type":"NodeParagraph","Properties":{"id":"20240903094201-dy73exk","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"麻黄发汗之气，驶不能御，而根节止汗，效如影响。自汗有风湿、伤风、风温、气虚、血虚、脾虚、阴虚、胃热、痰饮、中暑、亡阳、柔痉诸症，皆可随证加而用之。当归六黄汤加麻黄根治盗汗尤捷，盖其性能行周身肌表。故能引诸药外至卫分而固腠理也。《本草》但知扑之之法，而不知服饵之功尤良也。\""}]},{"ID":"20240903094201-ukofo8p","Type":"NodeParagraph","Properties":{"id":"20240903094201-ukofo8p","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"②《本草经读》：\"麻黄根节，古云止汗，是引止汗之药，以达于表而速效，非麻黄根节自能止汗，旧解多误。\""}]},{"ID":"20240903094201-s8qvrm6","Type":"NodeParagraph","Properties":{"id":"20240903094201-s8qvrm6","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"麻黄发汗，而其根专于止汗，昔人每谓为物理之奇异。不知麻黄轻扬，故表而发汗，其根则深入土中，自不能同其升发之性。况苗则轻扬，根则重坠，一升一降，理有固然。然正惟其同是一本，则轻扬走表之性犹在，所以能从表分而收其散越，敛其轻浮，以还归于里。是固根荄收束之本性，则不特不能发汗，而并能使外发之汗敛而不出，此则麻黄根所以有止汗之功力，投之辄效者也。凡止汗如糯稻根、桃干、小麦、枣仁之类，皆取其坚凝定静之意，以收散失之气，其旨皆同，夫岂麻黄与根同出一本，而其性顾乃背道相驰耶?防风发汗，其根止汗，亦是此义。\""}]},{"ID":"20240903094201-5hxscss","Type":"NodeParagraph","Properties":{"id":"20240903094201-5hxscss","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903094201-23ksymy","Type":"NodeParagraph","Properties":{"id":"20240903094201-23ksymy","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"麻黄根《中华本草》"}]},{"ID":"20240903094201-wp02swa","Type":"NodeParagraph","Properties":{"id":"20240903094201-wp02swa","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草经集注》"}]},{"ID":"20240903094201-e1fkpb0","Type":"NodeParagraph","Properties":{"id":"20240903094201-e1fkpb0","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【拼音名】MáHuánɡGēn"}]},{"ID":"20240903094201-atd9hc9","Type":"NodeParagraph","Properties":{"id":"20240903094201-atd9hc9","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903094201-y7827jy","Type":"NodeParagraph","Properties":{"id":"20240903094201-y7827jy","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"药材基源：为麻黄科植物草麻黄或中麻黄的根和根茎。"}]},{"ID":"20240903094201-eo47do9","Type":"NodeParagraph","Properties":{"id":"20240903094201-eo47do9","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.EphedrasinicaStapf2.EphedraequisetinaBge.3.EphedraintermediaSchrenkexC.A.Mey."}]},{"ID":"20240903094201-dcidbdx","Type":"NodeParagraph","Properties":{"id":"20240903094201-dcidbdx","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"采收和储藏：立秋后采挖,去尽须根及茎苗,晒千。"}]},{"ID":"20240903094201-xku0ezt","Type":"NodeParagraph","Properties":{"id":"20240903094201-xku0ezt","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903094201-fxhsfgg","Type":"NodeParagraph","Properties":{"id":"20240903094201-fxhsfgg","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"1.草本状灌木，高20-40cm。木质茎匍匐卧土中；小枝直伸或微曲，绿色，长圆柱形，细纵槽纹常不明显，节明显，节间长2.5-5.5cm，径1.5-2mm。鳞叶膜质鞘状，长3-4mm，下部约1/2合生，上部2裂，裂片锐三角形，先端急尖，常向外反曲。花成鳞球花序，通常雌雄异株；雄球花多成复穗状，常具总梗；雌球花单生，有梗，成熟时苞片增大，肉质，红色，成浆果状。种子2，包子苞片内，不露出，黑红色或灰褐色，三角状卵圆形或宽卵圆形，长4.5-6mm，直径约4mm，表面有细皱纹。花期5-6月，种子成熟期7-8月。"}]},{"ID":"20240903094201-eiajdan","Type":"NodeParagraph","Properties":{"id":"20240903094201-eiajdan","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"2.直立小灌木，高70-100cm。木质茎粗长，直立，基径1-1.5cm；小枝细圆柱形，对生或轮生的分枝较多，节间较短，通常长1.5-2.5cm，直径1-1.5mm，纵槽纹细浅不明显，被白粉，呈蓝绿色或灰绿色。鳞叶膜质鞘状，下部约2/3合生，常呈棕色，上部2裂，裂片钝三角形，长1.5-2mm。雄球花单生或3-4个集生于节上，无梗或有短梗；雌雄花单生，常在节上成对，无柄。雌球花成熟时苞片肉质，红色，成浆果状，长卵多或卵圆形。种子通常1，窄长卵形，长5-7mm，直径2-3mm，多有明显的纵纹。花期6-7月；种子成熟期8-9月。"}]},{"ID":"20240903094201-pw2ns4f","Type":"NodeParagraph","Properties":{"id":"20240903094201-pw2ns4f","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"3.灌木，高20-100cm。木质茎直立或匍匐斜上，较粗壮，基部多分枝，圆柱形，常被白粉呈灰绿色，有对生或轮生的分枝，节间长3-6cm，直径1-3mm，有细浅纵槽纹。鳞叶膜质鞘状，下部约1/3合生，裂片通常3裂，稀2裂，裂片钝，裂片钝三角形或窄三角状披针形。雄球花通常无梗，数个密集于节上呈团状，稀2-3个对生或轮生于节上；雌球花2-3，成簇，对生或轮生于节上，无梗或有短梗。雌球花成熟时苞片肉质，红色，成浆果状，长卵形或卵圆形，有长约1mm的短柄。种子包于肉质红色苞片内，不外露，种子通常3粒，稀2粒，卵圆形或长卵圆形，长5-6mm，直径约3mm。花期5-6月，种子成熟期7-8月。"}]},{"ID":"20240903094201-8haac4v","Type":"NodeParagraph","Properties":{"id":"20240903094201-8haac4v","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903094201-p2ik6ut","Type":"NodeParagraph","Properties":{"id":"20240903094201-p2ik6ut","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于干山坡、平原、干燥荒地、河床、干草原、河滩附近及固定沙丘，常成片丛生。"}]},{"ID":"20240903094201-n1mqju0","Type":"NodeParagraph","Properties":{"id":"20240903094201-n1mqju0","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"2.生于干旱荒漠、多砂石的山脊、山顶或草地。"}]},{"ID":"20240903094201-szqofcd","Type":"NodeParagraph","Properties":{"id":"20240903094201-szqofcd","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"3.生于海拔数百米至2000m的干旱荒漠、沙漠、戈壁、干旱山坡或草地上。"}]},{"ID":"20240903094201-xbkbezy","Type":"NodeParagraph","Properties":{"id":"20240903094201-xbkbezy","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏南部、江苏南部、浙江、福建北部、安徽南部及大别山区、江西北部、西至湖南西南部及贵州松桃等地的涤拔1400m以下的山地；浙江西天目山海拔1000m以下地带有野生大树。"}]},{"ID":"20240903094201-7djzacq","Type":"NodeParagraph","Properties":{"id":"20240903094201-7djzacq","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903094201-xsle1ne","Type":"NodeParagraph","Properties":{"id":"20240903094201-xsle1ne","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"性状鉴别根多呈圆柱形，略弯曲，长8-25cm，直径0.5-1.5cm。表面均呈红棕色或灰综色，有纵皱及支根痕，外皮业糙，易成片状剥落；上端较粗，偶有膨大的根头，下部较细，常扭曲。根茎粗细均匀，具突起的节，节间长0.7-2cm。体轻，质硬脆，易折断，断面皮部黄白色，木部淡黄色或黄色，射线放射状排列，根茎中部有髓。无臭，味微苦。以质硬、外皮色红棕色、断面色黄白者为佳。"}]},{"ID":"20240903094201-51hyy40","Type":"NodeParagraph","Properties":{"id":"20240903094201-51hyy40","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"显微鉴别根及根芭横切面：根的最外面有落皮层，基间散有纤维群及石细胞；木栓层为10余列细胞。皮层狭窄，有纤维和纤维束散在。木质部发达，所轮明显，由导管、管胞及木纤维组成，射线宽广，无髓。根茎射线较窄，髓部明显，散有纤维，薄壁细胞有纹孔。皮层及射线薄壁细胞含草酸钙砂晶。"}]},{"ID":"20240903094201-wa0xx5k","Type":"NodeParagraph","Properties":{"id":"20240903094201-wa0xx5k","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"粉末特征：棕红色或棕黄色。木栓细胞长方形，棕色，含草酸钙砂晶。纤维多单个散在，直径20-25μm,壁厚，木化，斜纹孔明显。螺纹、网纹导管直径30-50μm，导管分子穿孔板上具多数圆形穿孔。有时可见石细胞，呈长圆形、类纤维状或有分枝，直径20-50μm,壁厚。髓部薄壁细胞类方形、类长方形或类圆形，壁稍厚，具纹孔。薄壁细胞含草酸钙砂晶。"}]},{"ID":"20240903094201-0fyek3v","Type":"NodeParagraph","Properties":{"id":"20240903094201-0fyek3v","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"理化鉴别取本品纵剖面置紫外光下观察，皮部显蓝白色荧光，木部显黄色荧光，有的中心显金黄色荧光。"}]},{"ID":"20240903094201-bk6lo6m","Type":"NodeParagraph","Properties":{"id":"20240903094201-bk6lo6m","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【化学成份】含麻黄碱（ephedradine）A、B、C、D，阿魏酰组胺（feruloylhistamine），麻黄根素（ephedrannin）A，麻黄双酮（mahuannin）A、B、C、D升血压作用的酪氨酸甜菜碱（maokonice）。"}]},{"ID":"20240903094201-qer0mln","Type":"NodeParagraph","Properties":{"id":"20240903094201-qer0mln","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【药理作用】麻黄根甲醇提取物2g／kg(相当于生药)能使大鼠血压明显下降,但首先分离的麻根素对大鼠却显示弱的升压作用,进一步分离获得了多种降压成分,麻黄根碱A、B、C、D3mg／kg对大鼠有降压和减低心率作用,其中麻黄根碱B的作用最强,0.1-3mg／kg对大鼠和自发性高血压大鼠减低血压和心率的作用与剂量相关。麻黄根碱A和B对狗有相似的降压和减低心率活性,B微弱地加强去甲肾上腺素和明显地减少二甲基苯基哌哔嗪的加压作用,其降压活性被阿托品和苯海拉明所抑制,B还能抑制豚鼠由电刺激节前神经和乙酰胆碱用于神经节所诱导的输精管收缩,但对血管紧张素Ⅱ引起的血压升高没有影响,据此推测B的降压活性不经由血管紧张素受体的阻断,而主要由神经节的传导阻滞所致。阿魏酰组胺盐酸盐5mg／kg可使大鼠产生有意义的降压。几种双黄酮麻黄酚和麻黄宁A、B、C、D都具有降压作用,麻黄酚10mg／kg可使大鼠明显降压,其作用相似于麻黄根碱。"}]},{"ID":"20240903094201-qhecxxd","Type":"NodeParagraph","Properties":{"id":"20240903094201-qhecxxd","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质,除去残茎,用水浸泡,捞出,润透后切片,晒干。"}]},{"ID":"20240903094201-27b492u","Type":"NodeParagraph","Properties":{"id":"20240903094201-27b492u","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【性味】甘；微苦；性平"}]},{"ID":"20240903094201-jzjh5p5","Type":"NodeParagraph","Properties":{"id":"20240903094201-jzjh5p5","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【归经】肺经"}]},{"ID":"20240903094201-4ctiafw","Type":"NodeParagraph","Properties":{"id":"20240903094201-4ctiafw","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【功能主治】止汗。主自汗；盗汗"}]},{"ID":"20240903094201-d64g0b9","Type":"NodeParagraph","Properties":{"id":"20240903094201-d64g0b9","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤,3-10g；或入丸、散。外用：研粉扑。"}]},{"ID":"20240903094201-3k065sc","Type":"NodeParagraph","Properties":{"id":"20240903094201-3k065sc","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【注意】有表邪者忌服。"}]},{"ID":"20240903094201-5z3izom","Type":"NodeParagraph","Properties":{"id":"20240903094201-5z3izom","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【附方】①治诸虚不足,及新病暴虚,津液不固,体常自汗,夜卧即甚,久而不止,羸瘠枯瘦,心松惊惕,短气烦倦：黄蔑(去苗、土)。麻黄根(洗)、牡蛎(米泔浸,刷去土,火烧通赤)各一两。上三味,为粗散。每服三钱,水一盏半,小麦百余粒,同煎至八分,去滓热服,日二服,不拘时候。(《局方》牡蛎散)②治虚汗无度：麻黄根、黄芪等分。为末,飞面糊,作丸梧子大。每用浮麦汤下百丸,以上为度。(《谈野翁试验方》)③治产后虚汗不止：一、当归一两(锉,微炒),麻黄恨二两,黄芪一两(锉)。上药,捣粗罗为散。每服四钱,以水一中盏,煎至六分,去滓,不计时候温服。(《圣惠方》麻黄恨散)二、牡蜗粉三分,麻黄根二两。捣细罗力散,用扑身上(《圣惠方》麻黄根散)④治肾劳热,阴囊生疮：麻黄根、石硫黄各三两,米粉五合。上三味治下筛,安絮如常用粉法搭疮上,粉湿,更搭之。(《千金方》麻黄根粉)"}]},{"ID":"20240903094201-vi89ovs","Type":"NodeParagraph","Properties":{"id":"20240903094201-vi89ovs","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903094201-rvnbnrp","Type":"NodeParagraph","Properties":{"id":"20240903094201-rvnbnrp","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：麻黄发汗之气,驶不能御,而根节止汗,效如影响。自汗有风湿、伤风、风温、气虚、血虚、脾虚、阴虚、胃热、痰饮、中暑、亡阳、柔痉诸症,皆可随证加而用之。当归六黄汤加麻黄根洽盗汗尤捷,盖其性能行周身肌表,故能引诸药外至卫分而固腠理也。《本草》但知扑之之法,而不知服饵之功尤良也。"}]},{"ID":"20240903094201-l5m59ne","Type":"NodeParagraph","Properties":{"id":"20240903094201-l5m59ne","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"2.《本草经读》：麻黄根节,古云止汗,是引止汗之药,以达于表而速效,非麻黄根节自能止汗,旧解多误。"}]},{"ID":"20240903094201-d1rk1hp","Type":"NodeParagraph","Properties":{"id":"20240903094201-d1rk1hp","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"3.《本草正义》：麻黄发汗,而其根专于止汗,昔人每谓为物理之奇异。不知麻黄轻扬,故表而发汗,其根则深人士中,自不能同其升发之性。况苗则轻扬,根则重坠,一升一降,理有固然。然正惟其同是一本,则轻扬走表之性犹在,所以能从表分而收其散越、敛其轻浮,以还归于里。是固根收束之本性,则不特不能发汗,而并能使外发之汗敛而不出,此则麻黄根所以有止汗之功力,投之辄效者也。凡止汗如糯稻根、桃干、小麦、枣仁之类,皆取其坚凝定静之意,以收散失之气,其旨皆同,夫岂麻黄与根同出一本,而其性顾乃背道相驰那防风发汗,其根止汗,亦是此义。"}]},{"ID":"20240903094201-h24rs28","Type":"NodeParagraph","Properties":{"id":"20240903094201-h24rs28","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"4.陶弘景：止汗,夏月杂粉用之。"}]},{"ID":"20240903094201-zdu8bq3","Type":"NodeParagraph","Properties":{"id":"20240903094201-zdu8bq3","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：止汗,实表气,固虚,消肺气、梅核气。"}]},{"ID":"20240903094201-o6g5eur","Type":"NodeParagraph","Properties":{"id":"20240903094201-o6g5eur","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"6.《四川中药志》：敛汗固表。治阳虚自汗,阴虚盗汗。"}]},{"ID":"20240903094201-6bahy2b","Type":"NodeParagraph","Properties":{"id":"20240903094201-6bahy2b","updated":"20240903094226"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903094202-np8ubaw","Type":"NodeThematicBreak","Properties":{"id":"20240903094202-np8ubaw","updated":"20240903094226"}},{"ID":"20240903094203-aej4ve9","Type":"NodeParagraph","Properties":{"id":"20240903094203-aej4ve9","updated":"20240903094226"}}]}