ren":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"薄荷 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/薄荷 18-20240725125957-u560zwl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 368px;\" parent-style=\"width: 378px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 892px;","style":"width: 882px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"薄荷 (27)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/薄荷 27-20240725132521-ztijw25.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 882px;\" parent-style=\"width: 892px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240725125211-xrff3cw","Type":"NodeParagraph","Properties":{"id":"20240725125211-xrff3cw","updated":"20240725125211"}},{"ID":"20240725114643-pwpuv9e","Type":"NodeParagraph","Properties":{"id":"20240725114643-pwpuv9e","updated":"20240725115136"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薄荷和皱叶留兰香对比"}]},{"ID":"20240725114706-bgvohb1","Type":"NodeParagraph","Properties":{"id":"20240725114706-bgvohb1","updated":"20240725115746"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 334px;","style":"width: 324px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"真假薄荷对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/真假薄荷对比-20240725114816-uvngqvc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 324px;\" parent-style=\"width: 334px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 811px;","style":"width: 801px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"真假薄荷对比 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/真假薄荷对比 1-20240725115746-xvsywjx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 801px;\" parent-style=\"width: 811px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240725122226-rfxpza8","Type":"NodeParagraph","Properties":{"id":"20240725122226-rfxpza8","updated":"20240725122226"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"薄荷 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/薄荷 8-20240725122226-tlog4nw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240725115952-muaj05q","Type":"NodeParagraph","Properties":{"id":"20240725115952-muaj05q","updated":"20240725122106"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（上图中间叶片较光滑的植物为薄荷，其两侧为皱叶留兰香）"}]},{"ID":"20240725114457-7ic3380","Type":"NodeParagraph","Properties":{"id":"20240725114457-7ic3380","updated":"20240725131629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"皱叶留兰香常被误认为薄荷"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，薄荷的气味更清凉刺激，且叶面更平整，褶皱较少；留兰香为入侵物种，主要分布于欧洲、西亚、非洲，在中国仅新疆有野生，其他省区都是栽培；"}]},{"ID":"20240725114045-m18m2oh","Type":"NodeThematicBreak","Properties":{"id":"20240725114045-m18m2oh"}},{"ID":"20240902173111-v84m7xw","Type":"NodeParagraph","Properties":{"id":"20240902173111-v84m7xw","updated":"20240902173121"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：薄荷"}]},{"ID":"20240902173111-gmcrndb","Type":"NodeParagraph","Properties":{"id":"20240902173111-gmcrndb","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"薄荷《中国药典》"}]},{"ID":"20240902173111-8s4niom","Type":"NodeParagraph","Properties":{"id":"20240902173111-8s4niom","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【拼音名】BòHe"}]},{"ID":"20240902173111-qktsexq","Type":"NodeParagraph","Properties":{"id":"20240902173111-qktsexq","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【英文名】HERBAMENTHAE"}]},{"ID":"20240902173111-imf5e4v","Type":"NodeParagraph","Properties":{"id":"20240902173111-imf5e4v","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【来源】本品为唇形科薄荷属植物薄荷MenthahaplocalyxBriq.的干燥地上部分。夏、秋二季茎叶茂盛或花开至三轮时，选晴天，分次采割，晒干或阴干。"}]},{"ID":"20240902173111-yhu91ld","Type":"NodeParagraph","Properties":{"id":"20240902173111-yhu91ld","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性状】本品茎呈方柱形，有对生分枝，长15～40cm，直径0.2～0.4cm；表面紫棕色或淡绿色，棱角处具茸毛，节间长2～5cm；质脆，断面白色，髓部中空。叶对生，有短柄；叶片皱缩卷曲，完整者展平后呈宽披针形、长椭圆形或卵形，长2～7cm，宽1～3cm;上表面深绿色，下表面灰绿色，稀被茸毛，有凹点状腺鳞。轮伞花序腋生，花萼钟状，先端5齿裂，花冠淡紫色。揉搓后有特殊清凉香气，味辛凉。"}]},{"ID":"20240902173111-sj5nul3","Type":"NodeParagraph","Properties":{"id":"20240902173111-sj5nul3","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902173111-ht44uzd","Type":"NodeParagraph","Properties":{"id":"20240902173111-ht44uzd","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"（1）本品叶的表面观：腺鳞头部8细胞，直径约至90μm,柄单细胞；小腺毛头部及柄部均为单细胞。非腺毛1～8细胞，常弯曲，壁厚，微具疣状突起。下表皮气孔多见，直轴式。"}]},{"ID":"20240902173111-o5yqblm","Type":"NodeParagraph","Properties":{"id":"20240902173111-o5yqblm","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"（2）取本品叶的粉末少量，经微量升华得油状物，加硫酸2滴及香草醛结晶少量，初显黄色至橙黄色，再加水1滴，即变紫红色。"}]},{"ID":"20240902173111-buenz29","Type":"NodeParagraph","Properties":{"id":"20240902173111-buenz29","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0.5g，加石油醚（60～90℃）5ml,密塞，振摇数分钟，放置30分钟，滤过，滤液作为供试品溶液。另取薄荷脑对照品，加石油醚制成每1ml含2mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述供试品溶液10～20μl、对照品溶液10μl，分别点于同一硅胶Ｇ薄层板上，以苯－醋酸乙酯（19:1）为展开剂，展开，取出，晾干，喷以香草醛硫酸试液－乙醇（2:8）的混合溶液，在100℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902173111-3gcwaxa","Type":"NodeParagraph","Properties":{"id":"20240902173111-3gcwaxa","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【炮制】除去老茎及杂质，略喷清水，稍润，切短段，及时低温干燥。本品多为5～8mm的短段，墨绿色、紫棕色或灰褐色。照上述[含量测定]项下的方法测定，含挥发油不得少于0.40％（ml/g）。"}]},{"ID":"20240902173111-m060gai","Type":"NodeParagraph","Properties":{"id":"20240902173111-m060gai","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性味】辛，凉。"}]},{"ID":"20240902173111-yf2y8kr","Type":"NodeParagraph","Properties":{"id":"20240902173111-yf2y8kr","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、肝经。"}]},{"ID":"20240902173111-wcn3q35","Type":"NodeParagraph","Properties":{"id":"20240902173111-wcn3q35","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【功能主治】宣散风热。清头目，透疹。用于风热感冒，风温初起，头痛，目赤，喉痹，口疮，风疹，麻疹，胸胁胀闷。"}]},{"ID":"20240902173111-609x2jg","Type":"NodeParagraph","Properties":{"id":"20240902173111-609x2jg","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～6g，入煎剂宜后下。"}]},{"ID":"20240902173111-yf2lhq0","Type":"NodeParagraph","Properties":{"id":"20240902173111-yf2lhq0","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902173111-jx45ub5","Type":"NodeParagraph","Properties":{"id":"20240902173111-jx45ub5","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用于风热表症、身不出汗、头痛目赤等症，常与荆芥、桑叶、菊花、牛蒡子等配合应用；如果风寒感冒、身不出汗，也可配合紫苏、羌活等同用。薄荷清利咽喉作用显着，主要用于风热咽痛，兼有疏散风热作用，常配合牛蒡子、马勃、甘草等应用。也可研末吹喉，治咽喉红肿热痛病症。薄荷有透发作用，能助麻疹透发，可配合荆芥、牛蒡子、蝉衣等同用。"}]},{"ID":"20240902173111-hcwne9f","Type":"NodeParagraph","Properties":{"id":"20240902173111-hcwne9f","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902173111-96ffbso","Type":"NodeParagraph","Properties":{"id":"20240902173111-96ffbso","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"薄荷《*辞典》"}]},{"ID":"20240902173111-byi795e","Type":"NodeParagraph","Properties":{"id":"20240902173111-byi795e","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【出处】《雷公炮炙论》"}]},{"ID":"20240902173111-r1nu0hb","Type":"NodeParagraph","Properties":{"id":"20240902173111-r1nu0hb","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【拼音名】BòHe"}]},{"ID":"20240902173111-hpupz7m","Type":"NodeParagraph","Properties":{"id":"20240902173111-hpupz7m","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【别名】蕃荷菜（《千金·食治》），菝蔺、吴菝蔺（《食性本草》），南薄荷（《本草衍义》），猫儿薄苛（《履巉岩本草》），升阳菜（《滇南本草》），薄苛（《品汇精要》），蔢荷（《本草蒙筌》），夜息花（《植物名汇》）。"}]},{"ID":"20240902173111-extvcjf","Type":"NodeParagraph","Properties":{"id":"20240902173111-extvcjf","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【来源】为唇形科植物薄荷或家薄荷的全草或叶。大部分产区每年收割2次，第1次（头刀）在小暑至大暑间。第2次（二刀）于寒露至霜降间，割取全草，晒干。广东，广西温暖地区1年可收割3次。"}]},{"ID":"20240902173111-1h3v8uj","Type":"NodeParagraph","Properties":{"id":"20240902173111-1h3v8uj","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902173111-cisaect","Type":"NodeParagraph","Properties":{"id":"20240902173111-cisaect","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①薄荷"}]},{"ID":"20240902173111-q3a0t63","Type":"NodeParagraph","Properties":{"id":"20240902173111-q3a0t63","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"多年生草本，高10～80厘米。茎方形，被逆生的长柔毛及腺点。单叶对生；叶柄长2～15毫米，密被白色短柔毛；叶片长卵形至椭圆状披针形，长3～7厘米，先端锐尖，基部阔楔形，边缘具细尖锯齿，密生缘毛，上面被白色短柔毛，下面被柔毛及腺点。轮伞花序腋生；苞片1，线状披针形，边缘具细锯齿及微柔毛；花萼钟状，5裂，裂片近三角形，具明显的5条纵脉，外面密生白色柔毛及腺点；花冠二唇形，紫色或淡红色，有时为白色，长3～5毫米，上唇1片，长圆形，先端微凹，下唇3裂片，较小，全缘，花冠外面光滑或上面裂片被毛，内侧喉部被一圈细柔毛；雄蕊4，花药黄色，花丝丝状，着生于花冠筒中部，伸出花冠筒外；子房4深裂，花柱伸出花冠筒外，柱头2歧。小坚果长1毫米，藏于宿萼内。花期8～10月。果期9～11月。"}]},{"ID":"20240902173111-6fwngov","Type":"NodeParagraph","Properties":{"id":"20240902173111-6fwngov","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"生于小溪沟边、路旁及山野湿地，或为栽培。分布华北、华东、华南、华中及西南各地。"}]},{"ID":"20240902173111-4fahhpa","Type":"NodeParagraph","Properties":{"id":"20240902173111-4fahhpa","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②家薄荷"}]},{"ID":"20240902173111-133p6i7","Type":"NodeParagraph","Properties":{"id":"20240902173111-133p6i7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"与上种相似。叶卵形至长圆形，长2～5厘米，两面均有腺点。萼裂片窄三角形，有缘毛。花冠淡紫色或白色。小坚果长0.7毫米。"}]},{"ID":"20240902173111-3vz7agd","Type":"NodeParagraph","Properties":{"id":"20240902173111-3vz7agd","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"全国各地多有栽培。"}]},{"ID":"20240902173111-dcqz28p","Type":"NodeParagraph","Properties":{"id":"20240902173111-dcqz28p","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"此外，兴安薄荷（东北），以及江苏（苏州、太仓）栽培的龙脑薄荷（《本草衍义》）等，亦同供药用。"}]},{"ID":"20240902173111-nfnjn96","Type":"NodeParagraph","Properties":{"id":"20240902173111-nfnjn96","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国大部分地区均产，主产江苏、浙江、江西。"}]},{"ID":"20240902173111-tscsezv","Type":"NodeParagraph","Properties":{"id":"20240902173111-tscsezv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性状】干燥全草，茎方柱形，长15～35厘米，直径2～4毫米，黄褐色带紫，或绿色，有节，节间长3～7厘米，上部有对生分枝，表面被白色绒毛，角棱处较密，质脆，易折断，断面类白色，中空。叶对生，叶片卷曲面皱缩，多破碎。上面深绿色，下面浅绿色。具有白色绒毛；质脆。枝顶常有轮伞花序，黄棕色，花冠多数存在。气香，味辛凉。以身干、无根、叶多、色绿、气味浓者为佳。"}]},{"ID":"20240902173111-67rq8q7","Type":"NodeParagraph","Properties":{"id":"20240902173111-67rq8q7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【化学成份】新鲜叶含挥发油0.8～1％，干茎叶含1.3～2％。油中主成分为薄荷醇，含量约77～78％，其次为薄荷酮，含量为8～12％,，还含乙酸薄荷酯、莰烯、柠檬烯、异薄荷酮、蒎烯、薄荷烯酮、树脂及少量鞣质、迷迭香酸。"}]},{"ID":"20240902173111-1zs3eu8","Type":"NodeParagraph","Properties":{"id":"20240902173111-1zs3eu8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902173111-v4kfg9y","Type":"NodeParagraph","Properties":{"id":"20240902173111-v4kfg9y","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"薄荷醇局部应用可治头痛、神经痛、瘙痒等。应用于皮肤，首先有凉感，以后有轻微刺灼感。此种凉感并非皮肤温度降低，而系刺激神经末梢之冷觉感受器所引起。"}]},{"ID":"20240902173111-dtds0wx","Type":"NodeParagraph","Properties":{"id":"20240902173111-dtds0wx","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"薄荷醇、薄荷酮对离体兔肠有抑制作用，后者的作用较强。用小鼠作试验，对离体小肠，薄荷精油有解痉（抗乙酰胆碱）作用；但对整体小鼠的小肠内容物之推进速度并无显着影响，甚至有抑制倾向，故推测其健胃作用可能是由于其嗅、味感觉续发性引起的。薄荷醇的酒精溶液有防腐作用。它对呼吸道炎症有某些治疗作用，可能是由于其促进了分泌而去除了附着于粘膜上的粘液所致。薄荷酮之刺激性强于薄荷醇。"}]},{"ID":"20240902173111-41rhd1p","Type":"NodeParagraph","Properties":{"id":"20240902173111-41rhd1p","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"同属植物欧薄荷中的总黄酮类具有利胆作用。"}]},{"ID":"20240902173111-9j3qrxd","Type":"NodeParagraph","Properties":{"id":"20240902173111-9j3qrxd","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去残根，先将叶抖下另放，然后将茎喷洒清水，润透后切段，晒干，再与叶和匀。"}]},{"ID":"20240902173111-si35j2r","Type":"NodeParagraph","Properties":{"id":"20240902173111-si35j2r","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902173111-ufhvbm7","Type":"NodeParagraph","Properties":{"id":"20240902173111-ufhvbm7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"辛，凉。"}]},{"ID":"20240902173111-p0e1sq8","Type":"NodeParagraph","Properties":{"id":"20240902173111-p0e1sq8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①《医学启源》：\"《主治秘要》云，性凉，辛。\""}]},{"ID":"20240902173111-c6k53v6","Type":"NodeParagraph","Properties":{"id":"20240902173111-c6k53v6","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"辛，寒。\""}]},{"ID":"20240902173111-38sr7tl","Type":"NodeParagraph","Properties":{"id":"20240902173111-38sr7tl","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902173111-vtf2mgg","Type":"NodeParagraph","Properties":{"id":"20240902173111-vtf2mgg","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"入肺、肝经。"}]},{"ID":"20240902173111-fh3ax08","Type":"NodeParagraph","Properties":{"id":"20240902173111-fh3ax08","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"手大阴、厥阴经药。\""}]},{"ID":"20240902173111-454l78o","Type":"NodeParagraph","Properties":{"id":"20240902173111-454l78o","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"入手少、太阴，足厥阴。\""}]},{"ID":"20240902173111-t53l5ib","Type":"NodeParagraph","Properties":{"id":"20240902173111-t53l5ib","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入肺与包络二经，亦能入肝、胆。\""}]},{"ID":"20240902173111-iask34r","Type":"NodeParagraph","Properties":{"id":"20240902173111-iask34r","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902173111-rrhyajx","Type":"NodeParagraph","Properties":{"id":"20240902173111-rrhyajx","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"疏风，散热，辟秽，解毒。治外感风热，头痛，目赤，咽喉肿痛，食滞气胀，口疮，牙痛，疮疥，瘾疹。"}]},{"ID":"20240902173111-i6mzv3p","Type":"NodeParagraph","Properties":{"id":"20240902173111-i6mzv3p","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"去愤气，发毒汗，破血止痢，通利关节。\""}]},{"ID":"20240902173111-x6k6tt9","Type":"NodeParagraph","Properties":{"id":"20240902173111-x6k6tt9","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"却肾气，令人口气香洁。主辟邪毒，除劳弊。\""}]},{"ID":"20240902173111-ib5g5tf","Type":"NodeParagraph","Properties":{"id":"20240902173111-ib5g5tf","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"③孙思邀：\"煎汤洗漆疮。\""}]},{"ID":"20240902173111-27h0cdh","Type":"NodeParagraph","Properties":{"id":"20240902173111-27h0cdh","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"主贼风，发汗。（治）恶气腹胀满。霍乱。宿食不消，下气。\""}]},{"ID":"20240902173111-8dr6mr3","Type":"NodeParagraph","Properties":{"id":"20240902173111-8dr6mr3","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"杵汁服，去心脏风热。\""}]},{"ID":"20240902173111-vdgzsk7","Type":"NodeParagraph","Properties":{"id":"20240902173111-vdgzsk7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑥《食性本草》：\"能引诸药入营卫。疗阴阳毒、伤寒头痛。\""}]},{"ID":"20240902173111-g8c13h6","Type":"NodeParagraph","Properties":{"id":"20240902173111-g8c13h6","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑦《日华子本草》：\"治中风失音，吐痰。除贼风。疗心腹胀。下气、消宿食及头风等。\""}]},{"ID":"20240902173111-mowlbiq","Type":"NodeParagraph","Properties":{"id":"20240902173111-mowlbiq","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑧《本草图经》：\"治伤风、头脑风，通关格，小儿风涎。\""}]},{"ID":"20240902173111-gtfqi02","Type":"NodeParagraph","Properties":{"id":"20240902173111-gtfqi02","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑨《本草衍义》：\"小儿惊风，壮热，须此引药；治骨蒸劳热，用其汁与众药为膏。\""}]},{"ID":"20240902173111-hskp2k9","Type":"NodeParagraph","Properties":{"id":"20240902173111-hskp2k9","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑩李杲：\"主清利头目。\""}]},{"ID":"20240902173111-irnk4ud","Type":"NodeParagraph","Properties":{"id":"20240902173111-irnk4ud","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑾王好古：\"能搜肝气。又主肺盛有余，肩背痛及风寒汗出。\""}]},{"ID":"20240902173111-9utu36b","Type":"NodeParagraph","Properties":{"id":"20240902173111-9utu36b","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑿《滇南本草》：\"治一切伤寒头疼，霍乱吐泻，痈、疽、疥、癫诸疮。\"又：\"野薄荷上清头目诸风，止头痛、眩晕、发热，去风痰，治伤风咳嗽、脑漏鼻流臭涕，退虚痨发热。\""}]},{"ID":"20240902173111-5i0o0uy","Type":"NodeParagraph","Properties":{"id":"20240902173111-5i0o0uy","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⒀《纲目》：\"利咽喉、口齿诸病。治瘰疬，疮疥，风瘙瘾疹。\""}]},{"ID":"20240902173111-7rksph0","Type":"NodeParagraph","Properties":{"id":"20240902173111-7rksph0","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⒁《本草述》：\"治中风，癫痫，伤燥热郁。\""}]},{"ID":"20240902173111-nylfr3y","Type":"NodeParagraph","Properties":{"id":"20240902173111-nylfr3y","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⒂《医林纂要》：\"愈牙痛，已热嗽，解郁暑，止烦渴，止血痢，通小便。\""}]},{"ID":"20240902173111-gevck94","Type":"NodeParagraph","Properties":{"id":"20240902173111-gevck94","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⒃《本草再新》：\"消目翳。\""}]},{"ID":"20240902173111-9bqrobs","Type":"NodeParagraph","Properties":{"id":"20240902173111-9bqrobs","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤（不宜久煎），0.8～2钱；或入丸、散。外用：捣汁或煎汁涂。"}]},{"ID":"20240902173111-feiezu0","Type":"NodeParagraph","Properties":{"id":"20240902173111-feiezu0","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902173111-sg0rwwi","Type":"NodeParagraph","Properties":{"id":"20240902173111-sg0rwwi","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"阴虚血燥，肝阳偏亢，表虚汗多者忌服。"}]},{"ID":"20240902173111-mfqrrhe","Type":"NodeParagraph","Properties":{"id":"20240902173111-mfqrrhe","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"新病瘥人勿食，令人虚汗不止。\""}]},{"ID":"20240902173111-ypceqfz","Type":"NodeParagraph","Properties":{"id":"20240902173111-ypceqfz","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"动消渴病。\""}]},{"ID":"20240902173111-yjtjhdz","Type":"NodeParagraph","Properties":{"id":"20240902173111-yjtjhdz","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"多服久服，令人虚冷；阴虚发热，咳嗽自汗者勿施。\""}]},{"ID":"20240902173111-inbpq3h","Type":"NodeParagraph","Properties":{"id":"20240902173111-inbpq3h","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"④《本草从新》：\"辛香伐气，多服损肺伤心，虚者远之。\""}]},{"ID":"20240902173111-0mywzq9","Type":"NodeParagraph","Properties":{"id":"20240902173111-0mywzq9","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902173111-zsf65u8","Type":"NodeParagraph","Properties":{"id":"20240902173111-zsf65u8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①清上化痰，利咽膈，治风热：薄荷末炼蜜丸，如芡子大，每噙一丸。白沙糖和之亦可。（《简便单方》）"}]},{"ID":"20240902173111-iva8gqt","Type":"NodeParagraph","Properties":{"id":"20240902173111-iva8gqt","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"②治眼弦赤烂：薄荷，以生姜汁浸一宿，晒干为末，每用一钱，沸汤泡洗。（《明目经验方》）"}]},{"ID":"20240902173111-d5r5mhu","Type":"NodeParagraph","Properties":{"id":"20240902173111-d5r5mhu","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"③治瘰疬结成颗块，疼痛，穿溃，脓水不绝，不计远近：薄荷一束如碗大（阴干），皂荚十挺（长一尺二寸不蛀者，去黑皮，涂醋，炙令焦黄）。捣碎，以酒一斛，浸经三宿，取出曝干，更浸三宿，如此取酒尽为度，焙干，捣罗为散，以烧饭和丸，如梧桐子大。每于食前，以黄芪汤下二十丸，小儿减半服之。（《圣惠方》薄荷丸）"}]},{"ID":"20240902173111-c2plvsc","Type":"NodeParagraph","Properties":{"id":"20240902173111-c2plvsc","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"④治风气瘙痒：大薄荷、蝉蜕等分为末，每温酒调服一钱。（《永类钤方》）"}]},{"ID":"20240902173111-b7tkcr2","Type":"NodeParagraph","Properties":{"id":"20240902173111-b7tkcr2","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑤治血痢：薄荷叶煎汤单服。（《普济方》）"}]},{"ID":"20240902173111-fcgmcln","Type":"NodeParagraph","Properties":{"id":"20240902173111-fcgmcln","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑥治衄血不止：薄荷汁滴之。或以干者水煮，绵裹塞鼻。（《本事方》）"}]},{"ID":"20240902173111-8g07y8z","Type":"NodeParagraph","Properties":{"id":"20240902173111-8g07y8z","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑦治蜂虿螫伤：薄荷按贴之。（孟诜《必效方》）"}]},{"ID":"20240902173111-s6zv6k6","Type":"NodeParagraph","Properties":{"id":"20240902173111-s6zv6k6","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑧治火寄生疮如灸，火毒气入内，两股生疮，汁水淋漓者：薄荷煎汁频涂。（《医说》）"}]},{"ID":"20240902173111-v4y8ymr","Type":"NodeParagraph","Properties":{"id":"20240902173111-v4y8ymr","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑨治耳痛：鲜薄荷绞汁滴入。（《闽东本草》）"}]},{"ID":"20240902173111-vmv2g40","Type":"NodeParagraph","Properties":{"id":"20240902173111-vmv2g40","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902173111-drbefbh","Type":"NodeParagraph","Properties":{"id":"20240902173111-drbefbh","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"薄荷，辛能发散，凉能清利，专于消风散热。故头痛，头风，眼目、咽喉、口齿诸病，小儿惊热，及瘰疬、疮疥为要药。\""}]},{"ID":"20240902173111-9lnseul","Type":"NodeParagraph","Properties":{"id":"20240902173111-9lnseul","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑦《本草经疏》：\"薄荷，辛多于苦而无毒。辛合肺，肺合皮毛，苦合心而从火化，主血脉，主热，皆阳脏也。贼风伤寒，其邪在表，故发汗则解。风药性升，又兼辛温，故能散邪辟恶。辛香通窍，故治腹胀满、霍乱。《食疗》引为能去心家热，故为小儿惊风、风热家引经要药。辛香走散，以通关节，故逐贼风、发汗者，风从汗解也。本非脾胃家药，安能主宿食不消？上升之性，亦难主下气；劳乏属虚，非散可解，三疗俱非，明者当子别之。\"又：\"病人新瘥勿服，以其发汗虚表气也。咳嗽若因肺虚寒客之而无热症者勿服，以其当补而愈。阴虚人发热勿服，以出汗则愈竭其津液也。脚气类伤寒勿服，以其病主下而属脾故也。血虚头痛，非同诸补血药不可用。小儿身热由于伤食者不可用，小儿身热因于疳积者不可用。小儿痘疮诊得气虚者，虽身热初起，亦不可用。\""}]},{"ID":"20240902173111-0jr8mjp","Type":"NodeParagraph","Properties":{"id":"20240902173111-0jr8mjp","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"薄荷，味辛能散，性凉而清，通利六阳之会首，祛除诸热之风邪。取其性锐而轻清，善行头面，用治失音，疗口齿，清咽喉。同川芎达巅顶，以导壅滞之热。取其气香而利窍，善走肌表，用消浮肿，散肌热，除背痛，引表药入营卫以疏结滞之气。\""}]},{"ID":"20240902173111-dnp75r3","Type":"NodeParagraph","Properties":{"id":"20240902173111-dnp75r3","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"④《本草新编》：\"薄荷，不特善解风邪?尤善解忧郁，用香附以解郁，不若用薄荷解郁之更神。薄荷入肝胆之经，善解半表半里之邪，较柴胡更为轻清。\""}]},{"ID":"20240902173111-toahriv","Type":"NodeParagraph","Properties":{"id":"20240902173111-toahriv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑤《本草求真》：\"薄荷，气味辛凉，功专入肝与肺。故书载辛能发散，而于头痛、头风、发热恶寒则宜，辛能通气，而于心腹恶气、痰结则治：凉能清热，而于咽喉、口齿、眼、耳、瘾疹、疮疥、惊热，骨蒸、衄血则妙。是以古方逍遥，用此以为开郁散气之具；小儿惊痫，用此以为宣风向导之能；肠风血痢，用此以为疏气清利之法，然亦不敢多用，所用不过二、三分为止，恐其有泄真元耳。\""}]},{"ID":"20240902173111-dkue8z0","Type":"NodeParagraph","Properties":{"id":"20240902173111-dkue8z0","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑥《本经续疏》：\"吐下则胀满应减，下气则宿食应行，即不减不行，亦宜以宽中理气消导顺降为治，何取于薄荷?不知薄荷之凉，大有似乎豆蔻辈，原能宽中理气，消导顾降者也。特其芳烈外发，不似豆蔻辈内藏，所以重在散发，而治内不专耳。设使恶气宿食既已内扰，仍复托根于表，则非薄荷之内解其结，外剧其根，何以使表里尽除耶。\""}]},{"ID":"20240902173111-w54upi1","Type":"NodeParagraph","Properties":{"id":"20240902173111-w54upi1","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑦《医学衷中参西录》：\"薄荷味辛，气清郁香窜，性平。其力能内透筋骨，外达肌表，宣通脏腑，贯串经络，服之能透发凉汗，为温病宜汗解者之要药。若少用之，亦善调和内伤，治肝气胆火郁结作痛，或肝风内动，忽然痫痉瘈疭，头疼、目疼，鼻渊、鼻塞，出疼、咽喉肿疼，肢体拘挛作疼，一切风火郁热之疾，皆能治之。痢疾初起挟有外感者，亦宜用之，散外感之邪即以清肠中之热，则其痢易愈。又善消毒菌，逐除恶气，一切霍乱痧证，亦为要药。为其味辛而凉，又善表瘾疹，愈皮肤瘙痒，为儿科常用之品。温病发汗用薄荷，犹伤寒发汗用麻黄也，按薄荷古原名苛，以之作蔬，不以之作药。《本经》、《别录》皆未载之，至唐时始列于药品，是以《伤寒论》诸方未有用薄荷者。然细审《伤寒论》之方，确有方中当用薄荷，因当时犹未列入药品，即当用薄荷之方，不得不转用他药者。试取《伤寒》之方论之，如麻杏甘石汤中之麻黄，宜用薄荷代之。盖麻杏甘石汤，原治汗出而喘无大热，既云无大热，其仍有热可知，有热而犹用麻黄者，取其泻肺定喘也；然麻黄能泻肺定喘，薄荷亦能泻肺定喘（薄荷之辛能抑肺气之盛，又善搜肺风），用麻黄以热治热，何如用薄荷以凉治热乎?又如凡有葛根诸汤中之葛根，亦可以薄荷代之；盖葛根原所以发表阳明在经之热，葛根之凉不如薄荷，而其发表之力又远不如薄荷，则用葛根又何如薄荷乎?斯非背古训也，古人当药物未备之时，所制之方原有不能尽善尽美之处，无他，时势限之也。\""}]},{"ID":"20240902173111-n6aari2","Type":"NodeParagraph","Properties":{"id":"20240902173111-n6aari2","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"⑧《本草正义》：\"孙星衍辑刻《本草经》，径谓薄荷苏类，确乎可信。《唐本草》谓为辛温，亦以苏类例之。然冷冽之气能散风热，决非温药，故洁古直谓之辛凉。其主治则《唐本》谓贼风伤寒、恶气、心腹胀满、霍乱、宿食不消、下气，又皆与紫苏大略相近，惟辛而凉降，微与温散者不同耳。按外治风热生疮：煮汁和入消肿末药敷之，凉入肌肤，立能止痛。\""}]},{"ID":"20240902173111-378svb6","Type":"NodeParagraph","Properties":{"id":"20240902173111-378svb6","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902173111-jqshvzm","Type":"NodeParagraph","Properties":{"id":"20240902173111-jqshvzm","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"薄荷《中华本草》"}]},{"ID":"20240902173111-p8g4wyj","Type":"NodeParagraph","Properties":{"id":"20240902173111-p8g4wyj","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902173111-4ptdvjq","Type":"NodeParagraph","Properties":{"id":"20240902173111-4ptdvjq","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"出自《雷公炮炙论》。"}]},{"ID":"20240902173111-rh1tarx","Type":"NodeParagraph","Properties":{"id":"20240902173111-rh1tarx","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：薄荷茎方，叶似荏而尖长，根经冬不死。又有蔓生者，功用相似。"}]},{"ID":"20240902173111-ygwtzct","Type":"NodeParagraph","Properties":{"id":"20240902173111-ygwtzct","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：薄荷，旧不着所出州土，而今处处皆有之。夏、秋采茎叶暴干。古方稀用，或与薤作蘼食，近世医小儿疳积。"}]},{"ID":"20240902173111-ez76a8f","Type":"NodeParagraph","Properties":{"id":"20240902173111-ez76a8f","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【拼音名】BòHe"}]},{"ID":"20240902173111-bv1v2gg","Type":"NodeParagraph","Properties":{"id":"20240902173111-bv1v2gg","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【英文名】WildMint,HerbofWildMint,Peppermint"}]},{"ID":"20240902173111-mna3fj2","Type":"NodeParagraph","Properties":{"id":"20240902173111-mna3fj2","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【别名】蕃荷菜、菝蕑、吴菝蕑、南薄荷、猫儿薄苛、野薄荷、升阳菜薄苛、蔢荷、夜息药、仁丹草、见肿消、水益母、接骨草、土薄荷、鱼香草、香薷草"}]},{"ID":"20240902173111-klsxmj3","Type":"NodeParagraph","Properties":{"id":"20240902173111-klsxmj3","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902173111-g38og7n","Type":"NodeParagraph","Properties":{"id":"20240902173111-g38og7n","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"药材基源：为唇形科植物薄荷的全草或叶。"}]},{"ID":"20240902173111-h96g2a0","Type":"NodeParagraph","Properties":{"id":"20240902173111-h96g2a0","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：MenthacanadaensisL.[M.haplocalyxBriq.;M.aruensisL.var.haplocalyxBriq.;M.aruensisauct.nonL.]"}]},{"ID":"20240902173111-j7zs590","Type":"NodeParagraph","Properties":{"id":"20240902173111-j7zs590","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在江浙每年可收2次，夏、秋两季茎叶茂盛或花开至3轮时选晴天分次采割。华北采收1-2次，四川可收2-4次。一般头刀收割在7月，二刀在10月，选晴天采割，摊晒2d，稍干后扎成小把，再晒干或阴干。薄荷茎叶晒至半干，即可蒸馏，得薄荷油。"}]},{"ID":"20240902173111-eg8pith","Type":"NodeParagraph","Properties":{"id":"20240902173111-eg8pith","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生芳香草本，茎直立，高30-80cm。具匍匐的根茎，深入土壤可至13cm，质脆，容易折断。茎锐四棱形，多分枝，四侧无毛或略具倒生的柔毛，角隅及近节处毛较显着。单叶对生；叶柄长2-15mm；叶形变化较大，披针形、卵状披针形、长圆状披针形至椭圆形，长2-7cm，宽1-3cm，先端锐尖或渐尖，基部楔形至近圆形，长级在基部以上疏生粗大的牙齿状锯齿，侧脉5-6对，上面深绿色，下面淡绿色，两面具柔毛及黄色腺鳞，以下面分布较密。轮伞花序腋生，轮廓球形，花时径约18mm，愈向茎顶，则节间、叶及花序递渐变小；总梗上有小苞片数枚，线状披针形，长在2mm以下，具缘毛；花柄纤细，长2.5mm，略被柔毛或近无毛；花萼管状钟形，长2-3mm，外被柔毛及腺镤，具10脉，萼齿5，铗三角状钻形，长约0.7mm，缘有纤毛；花冠淡紫色至白色，冠檐4裂，上裂片先端2裂，较大，其余3片近等大，花冠喉内部被微柔毛；雄蕊4，前对较长，常伸出花冠外或包于花冠筒内，花丝丝状，无毛，花药卵圆形，2室，药室平行；花柱略超出雄蕊，先端近相等2浅裂，裂片钻形。小是对果长卵球形，长0.9mm，宽0.6mm，黄褐色或淡褐色，具小腺窝。花期7-9月，果期10-11月。"}]},{"ID":"20240902173111-obyajr8","Type":"NodeParagraph","Properties":{"id":"20240902173111-obyajr8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902173111-61rze3e","Type":"NodeParagraph","Properties":{"id":"20240902173111-61rze3e","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海沟旁，路边及山野湿地，海拔可高达3500m。"}]},{"ID":"20240902173111-6af541h","Type":"NodeParagraph","Properties":{"id":"20240902173111-6af541h","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华北、华东、华中、华南及西南各地。"}]},{"ID":"20240902173111-xrfobn7","Type":"NodeParagraph","Properties":{"id":"20240902173111-xrfobn7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902173111-sl7jrv7","Type":"NodeParagraph","Properties":{"id":"20240902173111-sl7jrv7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"生物学特性薄荷对环境的适应性较强，在海拔2100m以下地区都可以生长，而以低海拔栽培，其精油和薄荷脑含量较高。喜温暖、湿润气候。根茎在5-6℃可萌发出薄荷脑含量较高。喜温暖、湿润气候。根茎在5-6℃可萌发出苗，植株生长适宜温度为20-30℃，根茎具有较强的耐寒力，如土壤保持一定湿度，冬季在-30--20℃的地区仍可越冬。喜阳光，不宜在荫蔽处栽培，薄荷对土壤要求不严，但以疏松、肥沃、湿润的夹沙土或油沙土较好。土壤pH5.5-6.5为宜，微碱性的土壤也能栽培。"}]},{"ID":"20240902173111-g3f890a","Type":"NodeParagraph","Properties":{"id":"20240902173111-g3f890a","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、扦插、分枝和根茎繁殖。在生产上，一一般采用根茎每殖法。在秋季收获后，使根茎留在土里，栽种前挖出，选节间短、色白、粗壮、无病虫害的根芭，切成6-10cm长的小段作为繁殖材料，栽种期自11-3月初均可，因地而异。栽种地应多施底肥深翻，整平后，按行距25cm开沟，沟深6-8cm，将种用根茎撒入沟内，随覆土，耙平压实，每1hm2约需用根茎1125-1500kg。"}]},{"ID":"20240902173111-1sh993f","Type":"NodeParagraph","Properties":{"id":"20240902173111-1sh993f","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"田间管理生长期中除进行中耕除草、疏通沟道、防止雨后积水、及时灌溉外，最重要的是追肥，一般为4次，即4月齐苗后；5-6月生长盛期；7月头刀薄菏收割后和8月下旬二刀薄荷苗高15cm左右时。所施肥料以氮肥为主，同时辅以磷钾肥。薄荷易退化，要注意选种留种。"}]},{"ID":"20240902173111-ml2kq5u","Type":"NodeParagraph","Properties":{"id":"20240902173111-ml2kq5u","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有锈病，庆及时排除田间积水，发病初期喷25%粉锈宁1000倍液，或1：1：200波尔多液交替喷治，在收获状20d停止喷药。虫害有地老虎、造桥虫、蚜虫和红蜘蛛为害。"}]},{"ID":"20240902173111-iiinwxn","Type":"NodeParagraph","Properties":{"id":"20240902173111-iiinwxn","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902173111-n1ndjaw","Type":"NodeParagraph","Properties":{"id":"20240902173111-n1ndjaw","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"性状鉴别茎方柱形，有对生分枝，长15-40cm，直径0.2-0.4cm；表面紫棕色或淡绿色，棱角处具茸毛，节间长2-5cm；质脆，断面白色，髓部中空。叶对生，有短柄；叶片皱缩卷曲，完整叶片展平后呈披针形、卵状披针形、长圆状披针形至椭圆形，长2-7cm，宽1-3cm，边缘在基部以上疏生粗大的牙齿状锯齿，侧脉5-6对；上表面深绿色，下表面灰绿色，两面均有柔毛，下表面在扩大镜下可见凹点状腺鳞。茎上部常有腋生的轮伞花序，花萼钟状，先端5齿裂，萼齿狭三角状钻形，微被柔毛；花冠多数存在，淡紫色。揉搓后有特残香气，味辛、凉。"}]},{"ID":"20240902173111-2gq8zwv","Type":"NodeParagraph","Properties":{"id":"20240902173111-2gq8zwv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"以叶多、色绿、气味浓者为佳。"}]},{"ID":"20240902173111-7wmj7l8","Type":"NodeParagraph","Properties":{"id":"20240902173111-7wmj7l8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面；表皮细胞1列，外被角质层齿疣，有时具毛。四角有明显的棱脊，向有十数列厚角细胞，内缘为数列薄壁细胞，细胞间隙大。内皮层细胞1列，恺氏点清晰可见。维管束于四角处较发达，于相邻两角间具数个小维管束。韧皮部狭窄。形成层成环。木质部于四角处较发达，由导管、木薄壁细胞及木纤维等组成。髓部由薄壁细胞组成，中内常有空洞。茎的各部细胞内有时含有针簇状或扇形橙皮甙结晶。"}]},{"ID":"20240902173111-s1tm84m","Type":"NodeParagraph","Properties":{"id":"20240902173111-s1tm84m","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡黄绿色。㈠腺鳞头部顶面观呈圆形，侧面观呈扁球形，8细胞，直径61-99μm，常皱缩，内含淡黄以分泌物；柄单细胞，极短，基部四周表皮细胞10余个，放射状排列。②小腺毛头部椭圆形，单细胞，直径15-26μm，内含淡黄色分泌物；柄部1-2细胞。③非腺毛多碎断，完整者1-8细胞，稍弯曲，壁厚2-7μm，疣状突起较细密。④检皮甙结晶存在于茎、叶表皮细胞及薄壁细胞中，淡黄色，略呈扇形或不规则形。⑤叶片上表皮细胞表面观不规则形，壁略弯曲；下表皮细胞壁弯曲，细胞含淡黄色橙皮甙结晶。气孔较多，为直轴式。"}]},{"ID":"20240902173111-bf4dk5d","Type":"NodeParagraph","Properties":{"id":"20240902173111-bf4dk5d","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【化学成份】薄荷鲜叶含渍1%-1.46%，油中主成分为左旋薄荷醇（menthol)，含量62.3%-87.2%，还含左旋薄荷酮（menthone)异薄荷酮（isomenthone)，胡薄荷酮（pulegone)，乙酸癸酯（decylacetate)，乙酸薄荷酯（menthylacetate)苯甲酸甲酯（methylbenzoate)，α-及β-蒎烯（pinene)，β-侧柏烯（β-thu-jene)，3-戊醇（3-pentol)，2-已醇（2-hexanol)，3-辛醇（3-octanol)，右旋月桂烯（myrcene)，柠檬烯(limonene)及桉叶素（cineole)，α-松油醇（α-terpineol)等[1]。又含黄酮类成分：异瑞福灵（iso-raifolin(，木犀草素-7-葡萄糖甙（luteolin-7-glucoside)，薄荷异黄酮甙（methoside);有机酸成分：迷迭香酸（lusmarinicacid)，咖啡酸（caffeicacid)[2]；氯基酸成分：天冬氨酸（asparticacid)，谷氨酸（glutamicacid)，丝氨酸（alanine)，天冬酰胺（asparagine)，缬氨酸（valine)，亮氨酸（leuine)和异亮氨酸（isoleucine)，苯丙氨酸（phenylalanine)，蛋氨酸（methionine)赖氨酸（lysine)[3]。最近，又从叶中分阶段得具抗炎作用的以二羟基-1，2-二氢萘二羟酸为母核的多种成分：①1-（3，4-二羟基苯基）-6，7-二羟基-1，2-二氢萘-2，3二羟酸[1-（3，4-dihydroxyphenyl)-6，7-dihydroxy-1,2-dihy-dronaphthalene-2，3-dicarboxylicacid]，②1-（3，4-二羟基苯基-1，2-二氢萘-2-羟酸"}]},{"ID":"20240902173111-93drkrw","Type":"NodeParagraph","Properties":{"id":"20240902173111-93drkrw","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902173111-ue2sw7m","Type":"NodeParagraph","Properties":{"id":"20240902173111-ue2sw7m","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"1．抗病毒作用：薄荷水煎剂1：20浓度，对病毒ECHO11株有抑制作用。"}]},{"ID":"20240902173111-mr1hk8z","Type":"NodeParagraph","Properties":{"id":"20240902173111-mr1hk8z","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"2．镇痛、止痒作用：薄荷脑主要作外用止痒、微弱的局麻及对抗刺激剂，涂于局部由于刺激神经而引起凉感，并抑制痛觉神经。"}]},{"ID":"20240902173111-ga11369","Type":"NodeParagraph","Properties":{"id":"20240902173111-ga11369","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"3．抗刺激、止咳作用：薄荷脑的抗刺激作用导致气管产生新的分泌，而使稠厚的粘液易于排出，故有祛痰作用，亦有报道薄荷脑对豚鼠及人均有良好的止咳作用。"}]},{"ID":"20240902173111-6srjtub","Type":"NodeParagraph","Properties":{"id":"20240902173111-6srjtub","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"4．杀菌作用：薄荷脑有很强的杀菌作用，d-薄荷脑比1-薄荷脑的抑菌作用强。"}]},{"ID":"20240902173111-9gow6iy","Type":"NodeParagraph","Properties":{"id":"20240902173111-9gow6iy","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"5．抗着床、抗早孕作用：薄荷油对小白鼠具有一定的抗着床与抗早孕作用，作用强度随剂量增加，腹腔注射0.035ml/只，抗着床率达100%。终止妊娠的原因可能是子宫收缩加强，也不能排除蜕膜组织等的直接损伤。宫内给药，薄荷油不仅可使原孕第6天所见的胚珠坏死，而且可使之排出体外，与橄榄油组相比，差别显着。"}]},{"ID":"20240902173111-6yfg2sp","Type":"NodeParagraph","Properties":{"id":"20240902173111-6yfg2sp","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"6．利胆作用：薄荷的丙酮干浸膏和50%甲醇干浸膏均具有利胆作用，与对照组相比，胆汁分泌量均有明显的增加。含有挥发油多的丙酮干浸膏组的利胆效果比50%甲醇干浸膏组强。实验证明，除挥发油中主要成分薄荷醇具有很强的利胆作用外，薄荷油中还含有其他利胆作用成分。此外，把薄荷醇的醇羟基乙酰化后，其利胆作用也减弱了，说明醇羟基在利胆作用的产生上起着重要的作用。"}]},{"ID":"20240902173111-gqstpxl","Type":"NodeParagraph","Properties":{"id":"20240902173111-gqstpxl","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【毒性】毒性：薄荷脑大鼠皮下注射的致死量为2.0g/kg。薄荷脑对大鼠皮下注射的致死量为2.0g/kg。同属植物圆叶薄荷和欧薄荷的稍油的半数致死量分别为641.1±2.4mg/kg和437.4±18.3mg/kg。"}]},{"ID":"20240902173111-xbdb61d","Type":"NodeParagraph","Properties":{"id":"20240902173111-xbdb61d","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取叶粉末少量进行微量升华，所得油状升华物加硫酸2滴及香草醛结晶少量，初显黄色至橙黄色，再加水1滴，即变紫红色。（检查薄荷脑）（2）薄层色谱取全草粉末0.5g，加石油醚（60-90℃）5ml，密塞，振摇数分钟，施置30min，滤过，滤液作为供试品溶液。另取薄荷脑对照品配成每1ml含2mg的石油醚溶液，作为对照品溶液。吸取上述供试品溶液10-20μl，对照品溶液10μl，分别点于同一硅胶G薄板上，以苯-醋酸乙醇（19：1）展开约15cm，取出，晾干后，喷以2%香草西藏硫酸溶液-乙醇（2：8）的混合溶液，于100℃烘约5-10min。供试品色谱在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902173111-n1ev2bg","Type":"NodeParagraph","Properties":{"id":"20240902173111-n1ev2bg","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去残根，先将叶抖下另放，然后将茎喷洒清水，润透后切段，晒干，再与叶和匀。"}]},{"ID":"20240902173111-l48aijm","Type":"NodeParagraph","Properties":{"id":"20240902173111-l48aijm","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性凉"}]},{"ID":"20240902173111-ogky2ht","Type":"NodeParagraph","Properties":{"id":"20240902173111-ogky2ht","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；肝经"}]},{"ID":"20240902173111-d7f7uai","Type":"NodeParagraph","Properties":{"id":"20240902173111-d7f7uai","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【功能主治】散风热；清头目；利咽喉；透疹；解郁。主风热表证；头痛目赤；咽喉肿痛；麻疹不透；陷疹瘙痒；肝郁胁痛"}]},{"ID":"20240902173111-0zt3rxf","Type":"NodeParagraph","Properties":{"id":"20240902173111-0zt3rxf","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g，不可久煎，宜作后下；或入丸、散。外用：适量，煎水先或捣汁涂敷。"}]},{"ID":"20240902173111-yg52wrr","Type":"NodeParagraph","Properties":{"id":"20240902173111-yg52wrr","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902173111-9ru479u","Type":"NodeParagraph","Properties":{"id":"20240902173111-9ru479u","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"阴虚血燥，肝阳偏亢，表虚汗多者忌服。"}]},{"ID":"20240902173111-5kd32l6","Type":"NodeParagraph","Properties":{"id":"20240902173111-5kd32l6","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"1.《药性论》：新病瘥人勿食，令人虚汗不止。"}]},{"ID":"20240902173111-6pszqcs","Type":"NodeParagraph","Properties":{"id":"20240902173111-6pszqcs","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"2.《千金·食治》：动消渴病。"}]},{"ID":"20240902173111-1s0uh5x","Type":"NodeParagraph","Properties":{"id":"20240902173111-1s0uh5x","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：多服久服，令人虚冷；阴虚发热，咳嗽自汗者勿施。"}]},{"ID":"20240902173111-y9lnkbz","Type":"NodeParagraph","Properties":{"id":"20240902173111-y9lnkbz","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"4.《本草从新》：辛香伐气，多服损肺伤心，虚者远之。"}]},{"ID":"20240902173111-rcahuxm","Type":"NodeParagraph","Properties":{"id":"20240902173111-rcahuxm","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【附方】①清上化痰，利咽膈，治风热：薄荷末炼蜜丸，如芡子大，每噙一丸。白沙糖和之亦可。(《简便单方》)②治眼弦赤烂：薄荷，以生姜汁浸一宿，晒干为末，每用一钱，沸汤泡洗。(《明目经验方》)③治瘰疬结成颗块，疼痛，穿溃，脓水不绝，不计远近：薄荷一束如碗大(阴干)，皂荚十挺(长一尺二寸不蛀者，去黑皮，涂醋，炙令焦黄)。捣碎，以酒一斛，浸经三宿，取出曝干，更浸三宿，如此取酒尽为度，焙干，捣罗为散，以烧饭和丸，如梧桐子大。每于食前，以黄芪汤下二十丸，小儿减半服之。(《圣惠方》薄荷丸)④治风气瘙痒：大薄荷、蟑蜕等分为末，每温酒调服一钱。(《永类钤方》)⑤治血痢：薄荷叶煎汤单服。(《普济方》)⑥治衄血不止：薄荷汁滴之。或以干者水煮，绵裹塞鼻。(《本事方》)⑦治蜂虿螫伤：薄荷贴之。(孟诜《必效方》)⑧治火毒生疮如灸，火毒气入内，两股生疮，汁水淋漓者：薄荷煎法频涂。(《医说》)⑨治耳痛：鲜薄荷绞汁滴入。(《闽东本草》)"}]},{"ID":"20240902173111-df06as7","Type":"NodeParagraph","Properties":{"id":"20240902173111-df06as7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902173111-4epqgxf","Type":"NodeParagraph","Properties":{"id":"20240902173111-4epqgxf","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：薄荷，辛能发散，凉能清利，专于消风散热。故头痛、头风、眼目、咽喉、口齿诸病，小儿惊热，及瘰疬、疮疥为要药。"}]},{"ID":"20240902173111-2z8z1lv","Type":"NodeParagraph","Properties":{"id":"20240902173111-2z8z1lv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：薄荷，辛多于苦而无毒。辛合肺，肺合皮毛，苦合心、而从火化，主血脉，主热，皆阳脏也。贼风伤寒，其邪在表，故发汗则解。风药性升，又兼辛温，故能散邪辟恶。辛香通窍，故治腹胀满、霍乱。《食疗》以为能去心家热，故为小儿惊风、风热家引经要药。辛香走散，以通关节，故逐贼风。发汗者，风从汗解也。本非脾胃家药，安能主宿食不消？上升之性，亦难主下气；劳乏属虚，非散可解，三疗俱非，明者当自别之。又：病人新瘥勿服，以其发汗虚表气也。咳嗽若因肺虚寒客之而无热症者勿服，以其当补而愈。阴虚人发热勿服，以出汗则愈竭其津液也。脚气类伤寒勿服，以其病在下而属脾故也。血虚头痛，非同诸补血药不可用。小儿身热由于伤食者不可用。小儿身热因于疳积者不可用。小儿痘疮诊得气虚者，虽身热初起，亦不可用。"}]},{"ID":"20240902173111-h79yzzg","Type":"NodeParagraph","Properties":{"id":"20240902173111-h79yzzg","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：薄荷，味辛能散，性凉而清，通利六阳之会首，祛除诸热之风邪。取其性锐而轻清，善行头面，用治失音，疗口齿，清咽喉。同川芎达巅顶，以导壅滞之热。取其气香而得窍，善走肌表，用消浮肿，散肌热，除背痛，引表药入营卫以疏结滞之气。"}]},{"ID":"20240902173111-98n0cz7","Type":"NodeParagraph","Properties":{"id":"20240902173111-98n0cz7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"4.《本草新编》：薄荷，不特善解风邪，尤善解忧郁。用香附以解郁，不若用薄荷解郁之更神。薄荷入肝胆之经，善解半表半里之邪，较柴胡更为轻清。"}]},{"ID":"20240902173111-xwz9esv","Type":"NodeParagraph","Properties":{"id":"20240902173111-xwz9esv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：薄荷，气味辛凉，功专入肝与肺，故书载辛能发散，而于头痛、头风、发热恶寒则宜，辛能通气，而于心腹恶气、痰结则治；凉能清热，而于咽喉、口齿、眼、耳、瘾疹、疮疥、惊热，骨蒸、衄血则妙。是以古方逍遥，用此以为开郁散气之具；小儿惊痫，用此以为宣风向导之能；肠风血痢，用此以为疏气清利之法，然亦不敢多用，所用不过二、三分为止，恐其有泄真元耳。"}]},{"ID":"20240902173111-0lq5n12","Type":"NodeParagraph","Properties":{"id":"20240902173111-0lq5n12","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"6.《本经续疏》：吐下则胀满应减，下气则宿食应行，即不减不行，亦宜以宽中理气消导顺降为治，何取于薄荷？不知薄荷之凉，大有似乎豆蔻辈，原能宽中理气，消导顺降者也。特其芳烈外发，不似豆蔻辈内藏，所以重在散发，而治内不专耳。设使恶气宿食既已内扰，仍复托根于表，则非薄荷之内解其结，外其根，何以使表里尽除耶。"}]},{"ID":"20240902173111-hro0cjv","Type":"NodeParagraph","Properties":{"id":"20240902173111-hro0cjv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"7.《医学衷中参西录》：薄荷味辛，气清郁香窜，性平。其力能内透筋骨，外达肌表，宣通脏腑，贯串经络，服之能透发凉汗，为温病宜汗解者之要药。若少用之，亦善调和内伤，治肝气胆火郁结作痛，或肝风内动，忽然痫痉，头疼、目疼，鼻渊、鼻塞，齿疼、咽喉肿疼，肢体拘挛作疼，一切风火郁热之疾，皆能治之。痢疾初起挟有外感者，亦宜用之，散外感之邪即以清肠中之热，则其痢易愈。又善消毒菌，逐除恶气，一切霍乱痧证，亦为要药。为其味辛而凉，又善表瘾疹，愈皮肤瘙痒，为儿科常用之品。温病发法用薄荷，犹伤寒发汗用麻黄也。按薄荷古原名苛，以之作蔬，不以之作药。《本经》、《别录》皆未载之，至唐时始列于药品，是以《伤寒论》诸方未有用薄荷者。然细审《伤寒论》之方，确有方中当用薄荷，因当时犹未列入药品，即当用薄荷之方，不得不转用他药者。试取《伤寒》之方论之，如麻杏甘石汤中之麻黄，宜用薄荷代之。盖麻杏甘石汤，原治汗出而喘无大热，既云无大热，其仍有热可知，有热而犹用麻黄者，取其泻肺定喘也；然麻黄能泻肺定喘，薄荷亦能泻肺定喘（薄荷之辛能抑肺气之盛，又善搜肺风），用麻黄以热治热，何如用薄荷以凉治热乎？又如凡有葛根诸汤中之葛根，亦可以薄荷代之；盖葛根原所以发表阳明在经之热，葛根之凉不如薄荷代之；盖葛根原所以发表阳明在经之热，葛根又何如薄荷乎？斯非背古训也，古人当药物未备这时，所制之方原有不能尽善尽美之处，无他，时热限之也。"}]},{"ID":"20240902173111-izx4v95","Type":"NodeParagraph","Properties":{"id":"20240902173111-izx4v95","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"8.《本草正义》：孙星衍辑刻《本草经》，径谓薄荷苏类，确乎可信。《唐本草》谓为辛温，亦以苏类例之。然冷冽之气能散风热，决非温药，故洁古直谓之辛凉。其主治则《唐本》谓贼风伤寒、恶气、心腹胀满、霍乱、宿食不消、下气，又皆与紫苏大略相近，惟辛而凉降，微与温散者不同耳。按外治风热生疮，煮汁和入消肿末药敷之，凉入肌肤，立能止痛。"}]},{"ID":"20240902173111-r2vvgef","Type":"NodeParagraph","Properties":{"id":"20240902173111-r2vvgef","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：去愤气，发毒汗，破血止痢，通利关节。"}]},{"ID":"20240902173111-tyfix90","Type":"NodeParagraph","Properties":{"id":"20240902173111-tyfix90","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"10.《千金．食治》：却肾气，令人口气香洁。主辟邪毒，除劳弊。"}]},{"ID":"20240902173111-74cz14v","Type":"NodeParagraph","Properties":{"id":"20240902173111-74cz14v","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"11.孙思邈：煎汤洗漆疮。"}]},{"ID":"20240902173111-egd5f37","Type":"NodeParagraph","Properties":{"id":"20240902173111-egd5f37","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"12.《唐本草》：主贼风，发汗。（治）恶气腹胀满。霍乱。宿食不消，下气。"}]},{"ID":"20240902173111-b5tdqti","Type":"NodeParagraph","Properties":{"id":"20240902173111-b5tdqti","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"13.《食疗本草》：杵汁服，去心脏风热。"}]},{"ID":"20240902173111-tysu88g","Type":"NodeParagraph","Properties":{"id":"20240902173111-tysu88g","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"14.《食性本草》：能引诸药入营卫。疗阴阳毒、伤寒关痛。"}]},{"ID":"20240902173111-nujqrqn","Type":"NodeParagraph","Properties":{"id":"20240902173111-nujqrqn","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"15.《日华子本草》：治中风失音，吐痰。除贼风。疗心腹胀，下气、消宿食及头风等。"}]},{"ID":"20240902173111-b6a8dsb","Type":"NodeParagraph","Properties":{"id":"20240902173111-b6a8dsb","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"16.《本草图经》：治伤风。头脑风，通关格。小儿风涎。"}]},{"ID":"20240902173111-a4sgpdq","Type":"NodeParagraph","Properties":{"id":"20240902173111-a4sgpdq","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"17.《本草衍义》：小儿惊风、壮热，须此引药；治骨蒸劳热，用其汁与众药为膏。"}]},{"ID":"20240902173111-bya0rio","Type":"NodeParagraph","Properties":{"id":"20240902173111-bya0rio","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"18.李杲：主清利头目。"}]},{"ID":"20240902173111-ih89cdk","Type":"NodeParagraph","Properties":{"id":"20240902173111-ih89cdk","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"19.王好古：能搜肝气。又主肺盛有余，肩背痛及风寒汗出。"}]},{"ID":"20240902173111-8nd1zhl","Type":"NodeParagraph","Properties":{"id":"20240902173111-8nd1zhl","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"20.《滇南本草》：治一切伤寒头疼、霍乱吐泻、痈、疽、疥、癞诸疮。又：野薄荷上清头目诸风，止头痛、眩晕、发热。去风痰，治伤风咳嗽、脑漏鼻流臭涕。退虚痨发热。"}]},{"ID":"20240902173111-hoox2qk","Type":"NodeParagraph","Properties":{"id":"20240902173111-hoox2qk","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"21.《纲目》：利咽喉、口齿诸病。治瘰疬，疮疥，风瘙瘾。"}]},{"ID":"20240902173111-o3j7twk","Type":"NodeParagraph","Properties":{"id":"20240902173111-o3j7twk","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"22.《本草述》：治中风，癫痫，伤燥热郁。"}]},{"ID":"20240902173111-os9u8zv","Type":"NodeParagraph","Properties":{"id":"20240902173111-os9u8zv","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"23.《医要纂要》：愈牙痛，已热嗽，解郁暑，止烦渴，止血痢，通小便。"}]},{"ID":"20240902173111-69xevx7","Type":"NodeParagraph","Properties":{"id":"20240902173111-69xevx7","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"24.《本草再新》：消目翳。"}]},{"ID":"20240902173111-m2ulic8","Type":"NodeParagraph","Properties":{"id":"20240902173111-m2ulic8","updated":"20240902173120"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902173112-fp6dn3x","Type":"NodeThematicBreak","Properties":{"id":"20240902173112-fp6dn3x","updated":"20240902173120"}},{"ID":"20240902173113-tkyq113","Type":"NodeParagraph","Properties":{"id":"20240902173113-tkyq113","updated":"20240902173120"}}]}