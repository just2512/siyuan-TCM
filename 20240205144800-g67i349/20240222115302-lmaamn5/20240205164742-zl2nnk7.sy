":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 401px;","style":"width: 391px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 8-20240717155519-w67f0h9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 391px;\" parent-style=\"width: 401px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 427px;","style":"width: 417px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 9-20240717155617-gmfc5lp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 417px;\" parent-style=\"width: 427px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717155706-k1oqy9v","Type":"NodeParagraph","Properties":{"id":"20240717155706-k1oqy9v","updated":"20240717155744"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 753px;","style":"width: 743px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 10-20240717155706-q6cq7m8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 743px;\" parent-style=\"width: 753px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 519px;","style":"width: 509px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 11-20240717155744-w346zz4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 509px;\" parent-style=\"width: 519px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717155927-rootds2","Type":"NodeParagraph","Properties":{"id":"20240717155927-rootds2","updated":"20240717160219"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 759px;","style":"width: 749px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 14-20240717155926-oq5nv4h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 749px;\" parent-style=\"width: 759px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 16-20240717160219-rp1svgu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717160200-9014tp3","Type":"NodeParagraph","Properties":{"id":"20240717160200-9014tp3","updated":"20240717160424"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 817px;","style":"width: 807px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 15-20240717160200-d315vni.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 807px;\" parent-style=\"width: 817px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白扁豆 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白扁豆 17-20240717160424-2yevqd8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717154905-9wre74y","Type":"NodeParagraph","Properties":{"id":"20240717154905-9wre74y","updated":"20240717154932"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：扁豆花有红白两种，豆荚有绿白、浅绿、粉红或紫红等色。嫩荚作蔬食，白花和白色种子入药，有利于暑湿邪气的祛除，健脾止泻之效，同时扁豆还有显著的消退肿瘤的作用。\n扁豆花有益心脏、美容养颜、抑癌抗瘤。"}]},{"ID":"20240717154905-7ry6xyy","Type":"NodeThematicBreak","Properties":{"id":"20240717154905-7ry6xyy"}},{"ID":"20240902111534-8kjwchf","Type":"NodeParagraph","Properties":{"id":"20240902111534-8kjwchf","updated":"20240902111541"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白扁豆"}]},{"ID":"20240902111534-89wbgj2","Type":"NodeParagraph","Properties":{"id":"20240902111534-89wbgj2","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"白扁豆《中国药典》"}]},{"ID":"20240902111534-gxr0vtu","Type":"NodeParagraph","Properties":{"id":"20240902111534-gxr0vtu","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiBiǎnDòu"}]},{"ID":"20240902111534-rxe7542","Type":"NodeParagraph","Properties":{"id":"20240902111534-rxe7542","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENLABLABALBUM"}]},{"ID":"20240902111534-0kckh9t","Type":"NodeParagraph","Properties":{"id":"20240902111534-0kckh9t","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【别名】火镰扁豆、峨眉豆，扁豆子、茶豆"}]},{"ID":"20240902111534-8e04v38","Type":"NodeParagraph","Properties":{"id":"20240902111534-8e04v38","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【来源】本品为豆科扁豆属植物扁豆DolichoslablabL.的干燥成熟种子。秋、冬二季采收成熟果实，晒干，取出种子，再晒干。"}]},{"ID":"20240902111534-50lb2bb","Type":"NodeParagraph","Properties":{"id":"20240902111534-50lb2bb","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈扁椭圆形或扁卵圆形，长8～13mm,宽6～9mm，厚约7mm。表面淡黄白色或淡黄色，平滑，略有光泽，一侧边缘有隆起的白色眉状种阜。质坚硬。种皮薄而脆，子叶2,肥厚，黄白色。气微，味淡，嚼之有豆腥气。"}]},{"ID":"20240902111534-utw90xp","Type":"NodeParagraph","Properties":{"id":"20240902111534-utw90xp","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品横切面：表皮为1列栅状细胞，种脐处2列，光辉带明显。支柱细胞1列，呈哑铃状，种脐部位为3～5列。其下为10列薄壁细胞，内侧细胞呈颓废状。子叶细胞含众多淀粉粒。种脐部位栅状细胞的外侧有种阜，内侧有管胞岛，椭圆形，细胞壁网状增厚，其两侧为星状组织，细胞星芒状，有大形的细胞间隙，有的胞腔含棕色物。"}]},{"ID":"20240902111534-cst9j0l","Type":"NodeParagraph","Properties":{"id":"20240902111534-cst9j0l","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902111534-1vkbyy8","Type":"NodeParagraph","Properties":{"id":"20240902111534-1vkbyy8","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"白扁豆：除去杂质。用时捣碎。"}]},{"ID":"20240902111534-cky5n36","Type":"NodeParagraph","Properties":{"id":"20240902111534-cky5n36","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"炒白扁豆：取净白扁豆，炒至微黄色，用时捣碎。"}]},{"ID":"20240902111534-h60aw3h","Type":"NodeParagraph","Properties":{"id":"20240902111534-h60aw3h","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"扁豆仁：取净白扁豆，置沸水中煮至皮微鼓起和松软，捞出，倒入凉水，搓去皮，晒干，捣碎用；或炒黄用。（皮晒干即为扁豆皮）"}]},{"ID":"20240902111534-mxb0kl1","Type":"NodeParagraph","Properties":{"id":"20240902111534-mxb0kl1","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【性味】甘，微温。"}]},{"ID":"20240902111534-j0lp5r5","Type":"NodeParagraph","Properties":{"id":"20240902111534-j0lp5r5","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃经。"}]},{"ID":"20240902111534-zlxnhmx","Type":"NodeParagraph","Properties":{"id":"20240902111534-zlxnhmx","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902111534-04d4htc","Type":"NodeParagraph","Properties":{"id":"20240902111534-04d4htc","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"健脾化湿，和中消暑。用于脾胃虚弱，食欲不振，大便溏泻，白带过多，暑湿吐泻，胸闷腹胀。"}]},{"ID":"20240902111534-zjj3z6b","Type":"NodeParagraph","Properties":{"id":"20240902111534-zjj3z6b","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"炒扁豆：健脾化湿。用于脾虚泄泻，白带过多。"}]},{"ID":"20240902111534-0wn4a16","Type":"NodeParagraph","Properties":{"id":"20240902111534-0wn4a16","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240902111534-0ff0ddb","Type":"NodeParagraph","Properties":{"id":"20240902111534-0ff0ddb","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902111534-jkawas7","Type":"NodeParagraph","Properties":{"id":"20240902111534-jkawas7","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"白扁豆《中华本草》"}]},{"ID":"20240902111534-av0oqev","Type":"NodeParagraph","Properties":{"id":"20240902111534-av0oqev","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiBiǎnDòu"}]},{"ID":"20240902111534-5cytm6l","Type":"NodeParagraph","Properties":{"id":"20240902111534-5cytm6l","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【别名】藊豆、白藊豆、南扁豆、沿篱豆、蛾眉豆、羊眼豆、凉衍豆、白藊豆子、膨皮豆、茶豆、小刀豆、树豆、藤豆、火镰扁豆、眉豆"}]},{"ID":"20240902111534-kf1y2y5","Type":"NodeParagraph","Properties":{"id":"20240902111534-kf1y2y5","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902111534-z561xoc","Type":"NodeParagraph","Properties":{"id":"20240902111534-z561xoc","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物扁豆的白色成熟种子。"}]},{"ID":"20240902111534-mpjibd1","Type":"NodeParagraph","Properties":{"id":"20240902111534-mpjibd1","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：DolichoslablabL."}]},{"ID":"20240902111534-k4n1z2o","Type":"NodeParagraph","Properties":{"id":"20240902111534-k4n1z2o","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季种子成熟时，摘取荚果，剥出种子，晒干，拣净杂质。"}]},{"ID":"20240902111534-xf5wx9x","Type":"NodeParagraph","Properties":{"id":"20240902111534-xf5wx9x","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【原形态】扁豆一年生缠绕草质藤本，长达6m。茎常呈淡紫色或淡绿色，无毛或疏被柔毛。三出复叶；叶柄长4-14cm；托叶披针形或三角状卵形，被白色柔毛；顶生小叶柄长1.5-3.5cm，两侧小叶柄较短，长2-3mm，均被白色柔毛；顶生小叶宽三角状卵形，长5-10cm，宽约与长相等，先端尖，基部广楔形或截形，全线，两面均被短柔毛，沿叶脉处较多，基出3主脉，侧卧羽状；侧生小叶斜卵形，两边不均等。总状花序腋生，长15-25cm，直立，花序轴较粗壮；2-4花或多花丛生于花序轴的节上，小苞片舌状，2枚，早落；花萼宽钟状，先端5齿，上部2齿几乎完全合生，其余3齿近相等，边缘密被白色柔毛；花冠蝶形，白色或淡紫色，长约2cm，旗瓣广椭圆形，先端向内微凹，翼瓣斜椭圆形，近基部处一侧有耳状突起，龙骨瓣舟状，弯曲几成直角；雄蕊10，1枚单生，其余9枚的花丝部分连合成管状，将雌蕊包被；子房线形，有绢毛，基部有腺体，花柱近先端有白色髯毛，柱头头状。荚果镰形或倒卵状长椭圆形，扁平，长5-8cm，宽1-3cm，先端较宽，顶上具一向下弯曲的喙，边缘粗糙。种子2-5颗，扁椭圆形，白色、红褐色或近黑色，长8-13mm，宽6-9mm，厚4-7mm，种脐与种脊长而隆起，一侧边缘有隆起的白色半月形种阜。花期6-8月，果期9月。"}]},{"ID":"20240902111534-6t932gd","Type":"NodeParagraph","Properties":{"id":"20240902111534-6t932gd","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国各地均有栽培。主要分布于辽宁、河北、山西、陕西、山东、江苏、安徽、浙江、江西、福建、台湾、河南、湖北、湖南、广东、海南、广西、四川、贵州、云南等地。"}]},{"ID":"20240902111534-qroan62","Type":"NodeParagraph","Properties":{"id":"20240902111534-qroan62","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902111534-qaolafh","Type":"NodeParagraph","Properties":{"id":"20240902111534-qaolafh","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，怕寒霜，受霜害后，轻者影响生长，重者死亡。苗期需潮湿，应注意浇水。花期要求干旱，空气和土壤湿度大，容易落花。喜欢肥沃、排水良好的砂质壤上种植。种子发芽率90%以上。温度在16-20℃，有足够的湿度，播种后10-14d出苗。"}]},{"ID":"20240902111534-8dhu6vm","Type":"NodeParagraph","Properties":{"id":"20240902111534-8dhu6vm","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。春播，由于种子顶土能力弱，故播种前应先浇水，待可耕时立即下种，穴播，每穴放种子2-3粒，覆土0.6-1cm，略镇压。行株距（3-60）cm×45cm。"}]},{"ID":"20240902111534-agk7pnr","Type":"NodeParagraph","Properties":{"id":"20240902111534-agk7pnr","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"田间管理出苗后不久即应培土。生长初期，应注意浇水，保持土壤潮湿。苗高50-60cm，应设支架。花期不宜浇水，以免落花。应追肥，以磷、钾肥为主。"}]},{"ID":"20240902111534-zhmeom1","Type":"NodeParagraph","Properties":{"id":"20240902111534-zhmeom1","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有锈病，春天发生，防治可用可湿性硫黄粉500g加100kg水喷射。虫害有蚜虫、红蜘蛛，用2.5%敌杀死防治。豆荚螟可在初孵幼虫期喷洒触杀剂防治。"}]},{"ID":"20240902111534-g7vs1zb","Type":"NodeParagraph","Properties":{"id":"20240902111534-g7vs1zb","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902111534-wg2gw6n","Type":"NodeParagraph","Properties":{"id":"20240902111534-wg2gw6n","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"性状鉴别种子扁椭圆形或扁卵圆形，长0.8-1.3cm，宽6-9mm，厚约7mm。表面淡黄白色或淡黄色，平滑，稍有光泽，有的可见棕褐色斑点，一侧边缘有隆起的白色半月形种阜。长7-10mm，剥去后可见凹陷的种脐，紧接种阜的一端有珠孔，另端有种脊。质坚硬，种皮薄而脆，子叶2片，肥厚，黄白色。气微，味淡，嚼之有豆腥气。"}]},{"ID":"20240902111534-5x5rle0","Type":"NodeParagraph","Properties":{"id":"20240902111534-5x5rle0","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"以粒大、饱满、色白者为佳。"}]},{"ID":"20240902111534-uqzlf5i","Type":"NodeParagraph","Properties":{"id":"20240902111534-uqzlf5i","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"显微鉴别种子横切面；种皮为1列栅状细胞，种脐部位为2列，长26-213μm，宽526μm，壁自内向外渐增厚，近外方有光辉带；支柱细胞l列，种脐部位3-5列，哑铃状，长12-109μm，宽34-54μm，缢缩部宽10-25μm，其下为10数列薄壁细胞，多切向延长。最内1列种皮细胞小，类方形。于叶细胞内含淀粉粒。种脐部位栅状细胞的外侧有种阜，细胞类圆形或不规则长圆形，内含淀粉粒，内侧有管胞岛，椭圆形细胞壁网状增厚，其二侧有星状组织，细胞星芒状，有大型的细胞间隙，有的胞腔含棕色物。"}]},{"ID":"20240902111534-w5klm8g","Type":"NodeParagraph","Properties":{"id":"20240902111534-w5klm8g","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含油0.62%，内有棕榈酸（palmiticacid）占8.33%，亚油酸（linoleicacid）占57.95%，反油酸（elaidicacid）占15.05%，油酸（oleicacid）占5.65%，硬脂酸（stearicacid）占11.26%，花生酸（arachidicacid）占0.58%，山萮酸(behenicacid)占10.40%。又含葫芦巴碱（trigonelline），蛋氨酸（methionone），亮氨酸（leucine)，苏氨酸（threonine），维生素（vitamin)B1及C，胡萝卜素(carotene），蔗糖（sucrose），葡萄糖（glucose），水苏糖（stachyose），麦芽糖（maltose），棉子糖（raffinose），L-2-哌啶酸(L-pipecolicacid）和具有毒性的植物凝集素（phytoagglutinin)。另含甾体。"}]},{"ID":"20240902111534-yd6irl7","Type":"NodeParagraph","Properties":{"id":"20240902111534-yd6irl7","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902111534-jqo9319","Type":"NodeParagraph","Properties":{"id":"20240902111534-jqo9319","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"1.抗菌、抗病毒作用100%白扁豆煎剂用平板纸片法，对痢疾杆菌和有抑制作用；对食物中毒引起的呕吐、急性胃肠炎等有解毒作用。白扁豆水提物对小鼠ColumbiaSK病毒有抑制作用。"}]},{"ID":"20240902111534-hhlq30q","Type":"NodeParagraph","Properties":{"id":"20240902111534-hhlq30q","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"2.对免疫功能的影响20%白扁豆冷盐浸液0.3ml，对活性E-玫瑰花结的形成有促进作用，即增强T淋巴细胞的活性，提高细胞的免疫功能。"}]},{"ID":"20240902111534-jatjwsr","Type":"NodeParagraph","Properties":{"id":"20240902111534-jatjwsr","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"3.毒性白扁豆中含对人的红细胞非特异性植物凝集素(phytoagglutinin)。不溶于水的凝集素，有抗胰蛋白酶活性，可抑制实验动物生长，故属毒性成分。另含一种酶，有非竞争性抑制胰蛋白酶的活性，加热亦降低其活性，于10mg/kg浓度时，由于抑制了凝血酶(thrombin)，可使枸橼酸血浆的凝固时间由20s延长至60s。"}]},{"ID":"20240902111534-ro4s6t5","Type":"NodeParagraph","Properties":{"id":"20240902111534-ro4s6t5","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"用白扁豆提取的凝集素可区分人和羊、牛的红细胞，因为此凝集素仅凝集人的红细胞，法医可用此探测人血。"}]},{"ID":"20240902111534-lig4w19","Type":"NodeParagraph","Properties":{"id":"20240902111534-lig4w19","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品粉末1g，加70%乙醇10ml回流提取，滤过，取滤液蒸干，滴加醋酥2-3滴和硫酸1-2滴，显黄色，变为红色、紫红色、污绿色。（检查甾类）"}]},{"ID":"20240902111534-xn83rgg","Type":"NodeParagraph","Properties":{"id":"20240902111534-xn83rgg","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【炮制】白扁豆除去杂质。用时捣碎。炒白扁豆取净白扁豆，照清炒法（药典附录ⅡＤ）炒至微黄色具焦斑。用时捣碎。"}]},{"ID":"20240902111534-lpx77iz","Type":"NodeParagraph","Properties":{"id":"20240902111534-lpx77iz","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【性味】甘淡；微温；平"}]},{"ID":"20240902111534-ozvf1zl","Type":"NodeParagraph","Properties":{"id":"20240902111534-ozvf1zl","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃经"}]},{"ID":"20240902111534-03d9bfp","Type":"NodeParagraph","Properties":{"id":"20240902111534-03d9bfp","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【功能主治】健脾，化湿，消暑。主脾虚生湿，食少便溏，白带过多，暑湿吐泻，烦渴胸闷"}]},{"ID":"20240902111534-y07g30k","Type":"NodeParagraph","Properties":{"id":"20240902111534-y07g30k","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-15g；或生品捣研水绞汁；或入丸、散。外用：适量，捣敷。"}]},{"ID":"20240902111534-hbf9z8q","Type":"NodeParagraph","Properties":{"id":"20240902111534-hbf9z8q","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于脾胃虚弱，食欲不振，大便糖泻，白带过多，暑湿吐泻．胸闷腹胀。炒扁豆健脾化湿。用于脾虚泄泻，白带过多。"}]},{"ID":"20240902111534-sffil21","Type":"NodeParagraph","Properties":{"id":"20240902111534-sffil21","updated":"20240902111540"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902111536-m14hvwh","Type":"NodeThematicBreak","Properties":{"id":"20240902111536-m14hvwh","updated":"20240902111540"}},{"ID":"20240902111537-o13m1bm","Type":"NodeParagraph","Properties":{"id":"20240902111537-o13m1bm","updated":"20240902111540"}}]}