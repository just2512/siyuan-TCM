:"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 4-20240718102310-4gma7lb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 420px;","style":"width: 410px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 5-20240718102416-0d1bwg8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 420px;","style":"width: 410px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 3-20240718102212-f9itntv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​​​​​​"}]},{"ID":"20240718102756-wurvjmb","Type":"NodeParagraph","Properties":{"id":"20240718102756-wurvjmb","updated":"20240718104149"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 423px;","style":"width: 413px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 6-20240718102533-0pgjs3l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 413px;\" parent-style=\"width: 423px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 839px;","style":"width: 829px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 9-20240718102756-tokpcjp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 829px;\" parent-style=\"width: 839px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718102836-y6nx0ij","Type":"NodeParagraph","Properties":{"id":"20240718102836-y6nx0ij","updated":"20240718102937"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 638px;","style":"width: 628px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 10-20240718102935-18j6meu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 628px;\" parent-style=\"width: 638px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718103917-hq8niuy","Type":"NodeParagraph","Properties":{"id":"20240718103917-hq8niuy","updated":"20240718104243"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：益智花开花的时候会有个‘小帽子’罩着，开花的时候帽子会脱落。"}]},{"ID":"20240718102842-nc9aaq5","Type":"NodeThematicBreak","Properties":{"id":"20240718102842-nc9aaq5"}},{"ID":"20240902133758-dq2ls2d","Type":"NodeParagraph","Properties":{"id":"20240902133758-dq2ls2d","updated":"20240902133807"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：益智仁"}]},{"ID":"20240902133758-1jayp0r","Type":"NodeParagraph","Properties":{"id":"20240902133758-1jayp0r","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"益智仁《*辞典》"}]},{"ID":"20240902133758-nf8rznu","Type":"NodeParagraph","Properties":{"id":"20240902133758-nf8rznu","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【出处】《得配本草》"}]},{"ID":"20240902133758-4b52acb","Type":"NodeParagraph","Properties":{"id":"20240902133758-4b52acb","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【拼音名】YìZhìRén"}]},{"ID":"20240902133758-rjd3zqo","Type":"NodeParagraph","Properties":{"id":"20240902133758-rjd3zqo","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【别名】益智子（《开宝本草》），摘艼子（《中药材手册》）。"}]},{"ID":"20240902133758-iw94nhd","Type":"NodeParagraph","Properties":{"id":"20240902133758-iw94nhd","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【来源】为姜科植物益智的果实。5～6月间果实呈褐色、果皮茸毛减少时采摘，除去果柄，晒干。"}]},{"ID":"20240902133758-d6bvjic","Type":"NodeParagraph","Properties":{"id":"20240902133758-d6bvjic","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902133758-rwwd2jl","Type":"NodeParagraph","Properties":{"id":"20240902133758-rwwd2jl","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"益智（《广志》）"}]},{"ID":"20240902133758-588n2p9","Type":"NodeParagraph","Properties":{"id":"20240902133758-588n2p9","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"多年生草本，高1～3米。根茎延长。茎直立，丛生。叶2列，具短柄；叶片披针形，长20～35厘米，宽3～6厘米，先端尾尖，基部阔楔形，边缘具脱落性小刚毛，其残留的痕迹呈细锯齿状，上面深绿色，下面淡绿色，两面均无毛；叶舌膜质，长1～1.5厘米，被淡棕色疏柔毛。总状花序顶生，花序轴棕色，长10～15厘米，被短毛，下端具一环形苞片，包围花轴，小花梗长1～2毫米；小苞片极短，膜质，棕色；花萼筒状，长1.2厘米，一侧开裂至中部，先端3齿裂，外被短毛；花冠管长约1厘米，裂片3，长圆形，长约1.8厘米，上面一片稍大，先端略呈兜状，外被疏短毛，唇瓣倒卵形，长约2厘米，粉白色，具红色条纹，先端钝3裂；退化雄蕊锥状，长约2毫米，发育雄蕊1枚，花丝长约1厘米，花药线形，长约7毫米；子房下位，卵圆形，密被绒毛，3室，每室具胚珠8～9枚，花柱线形，柱头头状，上位腺体2枚，棒状。蒴果椭圆形至纺锤形，长1.5～2厘米，被疏毛，表面有纤维束线条，果柄短。花期3～5月。果期5～6月。"}]},{"ID":"20240902133758-ejk51di","Type":"NodeParagraph","Properties":{"id":"20240902133758-ejk51di","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于阴湿林下。分布海南及广东南部。主产广东。"}]},{"ID":"20240902133758-z6itvoz","Type":"NodeParagraph","Properties":{"id":"20240902133758-z6itvoz","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实呈纺锤形或椭圆形，长1.5～2厘米，直径1～12厘米。外皮红棕色至灰棒色，有纵向断续状的隆起线13～18条。皮薄而稍韧，与种子紧贴。种子集结成团，分3瓣，中有薄膜相隔，每瓣有种子6～11粒。种子呈不规则扁圆形，略有钝棱，直径约3毫米，厚约1.5毫米，表面灰褐色或灰黄色；种脐位于腹面的中央，微凹陷，自种脐至背面的合点处，有一条沟状种脊；破开后里面为白色，粉性，臭特殊，味辛微苦。"}]},{"ID":"20240902133758-zhccxun","Type":"NodeParagraph","Properties":{"id":"20240902133758-zhccxun","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902133758-5wj1inh","Type":"NodeParagraph","Properties":{"id":"20240902133758-5wj1inh","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"益智仁：取益智仁置锅内，炒至外壳焦黑，取出冷透，除去果壳，取仁捣碎用。"}]},{"ID":"20240902133758-murogfi","Type":"NodeParagraph","Properties":{"id":"20240902133758-murogfi","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"盐益智仁：取益智仁用盐水拌匀，微炒，取出放凉。（每益智仁100斤，用食盐2斤8两，加适量开水化开澄清）"}]},{"ID":"20240902133758-flnimfr","Type":"NodeParagraph","Properties":{"id":"20240902133758-flnimfr","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902133758-7lf5196","Type":"NodeParagraph","Properties":{"id":"20240902133758-7lf5196","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902133758-bqepkd7","Type":"NodeParagraph","Properties":{"id":"20240902133758-bqepkd7","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①《南方草木状》：\"味辛。\""}]},{"ID":"20240902133758-9ef7vm5","Type":"NodeParagraph","Properties":{"id":"20240902133758-9ef7vm5","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"热。\""}]},{"ID":"20240902133758-p5sha69","Type":"NodeParagraph","Properties":{"id":"20240902133758-p5sha69","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"味辛，温，无毒。\""}]},{"ID":"20240902133758-gqi7i74","Type":"NodeParagraph","Properties":{"id":"20240902133758-gqi7i74","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"④《本草便读》：\"味辛苦，性热。\""}]},{"ID":"20240902133758-f51d59t","Type":"NodeParagraph","Properties":{"id":"20240902133758-f51d59t","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902133758-fusyf8u","Type":"NodeParagraph","Properties":{"id":"20240902133758-fusyf8u","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"入脾，肾经。"}]},{"ID":"20240902133758-3ppvk6h","Type":"NodeParagraph","Properties":{"id":"20240902133758-3ppvk6h","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"手、足太阴经，足少阴经。\""}]},{"ID":"20240902133758-5l6qjd5","Type":"NodeParagraph","Properties":{"id":"20240902133758-5l6qjd5","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入脾、胃、肾三经。\""}]},{"ID":"20240902133758-cq29nhn","Type":"NodeParagraph","Properties":{"id":"20240902133758-cq29nhn","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足厥阴肝经，手太阴肺经。\""}]},{"ID":"20240902133758-r6320im","Type":"NodeParagraph","Properties":{"id":"20240902133758-r6320im","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902133758-y0rf58g","Type":"NodeParagraph","Properties":{"id":"20240902133758-y0rf58g","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"温脾，暖肾，固气，涩精。治冷气腹痛，中寒吐泻，多唾，遗精，小便余沥，夜多小便。"}]},{"ID":"20240902133758-lhyrncm","Type":"NodeParagraph","Properties":{"id":"20240902133758-lhyrncm","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①《广志》：\"含之摄涎秽。\""}]},{"ID":"20240902133758-rwyb13f","Type":"NodeParagraph","Properties":{"id":"20240902133758-rwyb13f","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"止呕哕。\"\"治遗精虚漏，小便余沥，益气安神，补不足，利三焦，调诸气，夜多小便者，取二十四枚碎，入盐同煎服。\""}]},{"ID":"20240902133758-de5uimi","Type":"NodeParagraph","Properties":{"id":"20240902133758-de5uimi","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③刘完素：\"开发郁结，使气宣通。\""}]},{"ID":"20240902133758-jd1lfjy","Type":"NodeParagraph","Properties":{"id":"20240902133758-jd1lfjy","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"治脾胃中寒邪，和中益气。治人多唾，当于补中药内兼用之。\""}]},{"ID":"20240902133758-si1c9za","Type":"NodeParagraph","Properties":{"id":"20240902133758-si1c9za","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑤王好古：\"益脾胃，理元气，补肾虚，滑沥。\""}]},{"ID":"20240902133758-r0lfbtn","Type":"NodeParagraph","Properties":{"id":"20240902133758-r0lfbtn","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治冷气腹痛，及心气不足，梦泄，赤浊，热伤心系，吐血、血崩。\""}]},{"ID":"20240902133758-6tri7q2","Type":"NodeParagraph","Properties":{"id":"20240902133758-6tri7q2","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；或入丸、散。"}]},{"ID":"20240902133758-azyzjs1","Type":"NodeParagraph","Properties":{"id":"20240902133758-azyzjs1","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902133758-msit8dh","Type":"NodeParagraph","Properties":{"id":"20240902133758-msit8dh","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"阴虚火旺或因热而患遗滑崩带者忌服。"}]},{"ID":"20240902133758-85u8rf7","Type":"NodeParagraph","Properties":{"id":"20240902133758-85u8rf7","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"凡呕吐由于热而不因于寒；气逆由于怒而不因于虚；小便余沥由于水涸精亏内热，而不由于肾气虚寒；泄泻由于湿火暴注，而不由于气虚肠滑，法并禁之。\""}]},{"ID":"20240902133758-aoz7vni","Type":"NodeParagraph","Properties":{"id":"20240902133758-aoz7vni","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②《本草备要》：\"因热而崩、浊者禁用。’"}]},{"ID":"20240902133758-b625td6","Type":"NodeParagraph","Properties":{"id":"20240902133758-b625td6","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"血燥有火、不可误用。\""}]},{"ID":"20240902133758-ffj9umy","Type":"NodeParagraph","Properties":{"id":"20240902133758-ffj9umy","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902133758-6bwaxj9","Type":"NodeParagraph","Properties":{"id":"20240902133758-6bwaxj9","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①治伤寒阴盛，心腹痞满，呕吐泄利，手足厥冷，及一切冷气奔冲，心胁脐腹胀满绞痛：川乌（炮，去皮、脐）四两，益智（去皮）二两，干姜（炮）半两，青皮（去白）三两。上件为散。每服三钱，水二盏，入盐一捻，生姜五片，枣二个，擘破，同煎至八分，去滓，温服，食前。（《局方》益智散）"}]},{"ID":"20240902133758-hcypupa","Type":"NodeParagraph","Properties":{"id":"20240902133758-hcypupa","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②治腹胀忽泻，日夜不止，诸药不效，此气脱也：益智子仁二两。浓煎饮之。（《世医得效方》）"}]},{"ID":"20240902133758-2gk2pwe","Type":"NodeParagraph","Properties":{"id":"20240902133758-2gk2pwe","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③治梦泄：益智仁二两（用盐二两炒，去盐），乌药二两，上为末，用山药一两为糊，和丸如梧桐子大，每服五十丸，空心临卧盐汤下，以朱砂为衣。（《世医得效方》三仙丸）"}]},{"ID":"20240902133758-z45jv6c","Type":"NodeParagraph","Properties":{"id":"20240902133758-z45jv6c","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"④治脬气虚寒，小便频数，或遗尿不止，小儿尤效：乌药、益智仁等分。上为末，酒煮山药末为栅，丸桐子大。每服七十丸，盐酒或米饮下。（《妇人良方》缩泉丸，即《魏氏家藏方》固真丹）"}]},{"ID":"20240902133758-q5t7vpp","Type":"NodeParagraph","Properties":{"id":"20240902133758-q5t7vpp","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑤治小儿遗尿，亦治白浊：益智仁、白茯苓各等分，上为末。每服一钱，空心米汤调下。（《补要袖珍小儿方论》益智仁散）"}]},{"ID":"20240902133758-o74o8sd","Type":"NodeParagraph","Properties":{"id":"20240902133758-o74o8sd","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑥治妇人崩中：益智子，炒研细，米饮入盐服一钱。（《经效产宝》）"}]},{"ID":"20240902133758-1pba7ka","Type":"NodeParagraph","Properties":{"id":"20240902133758-1pba7ka","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑦治漏胎下血：益智仁半两，缩砂仁一两。为末。每服三钱，空心白汤下，日二服。（胡氏《济阴方》）"}]},{"ID":"20240902133758-41zdizz","Type":"NodeParagraph","Properties":{"id":"20240902133758-41zdizz","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑧治疝痛，连小腹挛搐，叫呼不已：益智仁、干姜（炮）、甘草（炙）、茴香（炒）各三钱，乌头（炮，去皮）、生姜各半两，青皮（去白）二钱。上细切。每服四钱，水二盏，入盐少许，煎至七分，去滓，空心食前温服。（《济生方》益智仁汤）"}]},{"ID":"20240902133758-hq6cjap","Type":"NodeParagraph","Properties":{"id":"20240902133758-hq6cjap","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑨治白浊腹满，不拘男妇：益智仁（盐水浸炒）、厚朴（姜汁炒）等分。姜三片，枣一枚，水煎服。（《永类钤方》）"}]},{"ID":"20240902133758-u8ptfgt","Type":"NodeParagraph","Properties":{"id":"20240902133758-u8ptfgt","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑩治小便赤浊：益智仁、茯神各二两，远志、甘草（水煮）各半斤。为末，酒糊丸，梧子大。空心姜汤下五十丸。（《纲目》）"}]},{"ID":"20240902133758-g30quns","Type":"NodeParagraph","Properties":{"id":"20240902133758-g30quns","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902133758-ijkliss","Type":"NodeParagraph","Properties":{"id":"20240902133758-ijkliss","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"益智，行阳退阴之药也。三焦、命门气弱者宜之。按杨士瀛《直指方》云：心者脾之母，进食，不止于和脾，火能生土，当使心药入脾胃药中，庶几相得。故古人进食药中，多用益智，土中益火也。\""}]},{"ID":"20240902133758-yhdu0x6","Type":"NodeParagraph","Properties":{"id":"20240902133758-yhdu0x6","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"益智子仁，以其敛摄，故治遗精虚漏，及小便余沥，此皆肾气不固之证也。肾主纳气，虚则不能纳矣。又主五液，涎乃脾之所统，脾肾气虚，二脏失职，是肾不能纳，脾不能摄，故主气逆上浮，涎秽泛滥而上溢也，敛摄脾肾之气，则逆气归元，涎秽下行。\""}]},{"ID":"20240902133758-wsxp73e","Type":"NodeParagraph","Properties":{"id":"20240902133758-wsxp73e","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"③《本草求实》：\"益智，气味辛热，功专燥脾温胃，及敛脾肾气逆，藏纳归源，故又号为补心补命之剂。是以胃冷而见涎唾，则用此以收摄，脾虚而见不食，则用此温理，肾气不温，而见小便不缩，则用此入缩泉丸以投。与夫心肾不足，而见梦遗崩带，则用此以为秘精固气。若因热成气虚，而见崩浊、梦遗等症者，则非所宜。此虽类于缩砂密，同为温胃，但缩砂密多有快滞之功，此则止有逐冷之力，不可不分别而审用耳。\""}]},{"ID":"20240902133758-v5daw49","Type":"NodeParagraph","Properties":{"id":"20240902133758-v5daw49","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"④《会约医镜》：\"益智仁，其性行多补少，须兼补剂用之，若独用则散气。\""}]},{"ID":"20240902133758-gaxy6py","Type":"NodeParagraph","Properties":{"id":"20240902133758-gaxy6py","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"益智，始见于藏器《本草拾遗》，谓之辛温，不言其涩，但诸家所述主治，无，非温涩功用。杨仁斋《直指方》云，古人进食药中，多用益智，土中益火也。案此为脾虚馁而不思食者立法，脾土喜温而恶寒，喜燥而恶湿。寒湿困之，则健运力乏而不思纳谷，且食亦无味，此惟温煦以助阳和而斡旋大气，则能进食。益智醒脾益胃，固亦与砂仁、豆蔻等一以贯之。仁斋说到益火生土上去，附会心经之药，尚是舍近求远，故意深言之，亦殊不必。濒湖又谓治心气不足，梦泄，赤浊，则以肾阳无权，滑泄不禁者立论，故可用此温涩一法，然遗浊之虚寒症绝少，石顽谓因于热者，色黄干结，不可误用，极是。濒湖又谓治热伤心系，吐血血崩诸证，则既是热伤，而反用此大辛大热之药，何其背谬一至于此。\""}]},{"ID":"20240902133758-0iw8chn","Type":"NodeParagraph","Properties":{"id":"20240902133758-0iw8chn","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902133758-qq8b1gv","Type":"NodeParagraph","Properties":{"id":"20240902133758-qq8b1gv","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"益智仁《中华本草》"}]},{"ID":"20240902133758-l1athd2","Type":"NodeParagraph","Properties":{"id":"20240902133758-l1athd2","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【出处】出自《得配本草》"}]},{"ID":"20240902133758-j7mkcac","Type":"NodeParagraph","Properties":{"id":"20240902133758-j7mkcac","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【拼音名】YìZhìRén"}]},{"ID":"20240902133758-yq3snp7","Type":"NodeParagraph","Properties":{"id":"20240902133758-yq3snp7","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【英文名】SharpleafGalangalFruit"}]},{"ID":"20240902133758-a7nrq8c","Type":"NodeParagraph","Properties":{"id":"20240902133758-a7nrq8c","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【别名】益智子、摘艼子"}]},{"ID":"20240902133758-bfplo47","Type":"NodeParagraph","Properties":{"id":"20240902133758-bfplo47","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902133758-tyyk6hk","Type":"NodeParagraph","Properties":{"id":"20240902133758-tyyk6hk","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"药材基源：为姜科植物益智的果实。"}]},{"ID":"20240902133758-71myhtg","Type":"NodeParagraph","Properties":{"id":"20240902133758-71myhtg","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：AlpiniaoxyphyllaMiq."}]},{"ID":"20240902133758-h46szf0","Type":"NodeParagraph","Properties":{"id":"20240902133758-h46szf0","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植后2-3年，于6-7月，当果实呈浅褐色、果皮茸毛脱落、果肉带甜、种子辛辣时，选晴天将果穗剪下，除去果柄，晒干或烘干。5-6月间果实呈褐色、果皮茸毛减少时采摘，除去果柄，晒干。"}]},{"ID":"20240902133758-jeaz15p","Type":"NodeParagraph","Properties":{"id":"20240902133758-jeaz15p","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【原形态】益智，多年生草本，高1-3m。叶柄短；叶片披针形，长20-35cm，宽3-6cm，先端尾状渐尖，基部宽楔形，边缘具脱落性小刚毛，基残痕呈细齿状，两面无毛；叶舌膜质，二裂，长1-2cm，少数达3cm，被淡棕色柔毛。总状花序顶生，长8-15cm，在花蕾时包藏于鞘状的总状苞片内；花序轴被极短的柔毛；小花梗长1-2mm；苞片膜质，棕色；花萼管状，长约1.2cm，先端3浅齿裂，一侧深裂，外被短柔毛；花冠管与萼管几等长，裂片3，长圆形，长约1.8cm，上方1片稍大，先端略呈兜状，白色，外被短柔毛；唇瓣倒卵形，长约2cm，粉红色，并有红色条纹，先端边缘皱波状；侧生退化雄蕊锥状，长约2mm；雄蕊1，花丝扁平，线形，长约1.2cm，花药长6-7mm，药隔先端具圆形鸡冠状附属物；子房下位，密被绒毛。蒴果球形或椭圆形，干时纺锤形，果皮上有明显的纵向维管束条纹，长1.2-cm，直径约1cm，不开裂，果熟时黄绿色或乳黄色。种子多数，不规则扁圆形，被淡黄色假种皮。花期2-4月，果期5-8月。"}]},{"ID":"20240902133758-utq3otl","Type":"NodeParagraph","Properties":{"id":"20240902133758-utq3otl","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902133758-gmn8qai","Type":"NodeParagraph","Properties":{"id":"20240902133758-gmn8qai","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"生态环境：生于林下阴湿处。"}]},{"ID":"20240902133758-n9z599h","Type":"NodeParagraph","Properties":{"id":"20240902133758-n9z599h","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于广东和海南，福建、广西、云南亦有栽培。"}]},{"ID":"20240902133758-x2q7fli","Type":"NodeParagraph","Properties":{"id":"20240902133758-x2q7fli","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902133758-fitc79q","Type":"NodeParagraph","Properties":{"id":"20240902133758-fitc79q","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"1.气候土壤：窖温暖、湿润的气候。土壤以疏松、肥沃，排水良好的砂质壤土为佳。"}]},{"ID":"20240902133758-1tynjuf","Type":"NodeParagraph","Properties":{"id":"20240902133758-1tynjuf","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"2.整地：栽植前2-3月进行整地，开好排水沟，按株、行距1×1m，挖直径33cm，深33cm的穴。"}]},{"ID":"20240902133758-4s94psp","Type":"NodeParagraph","Properties":{"id":"20240902133758-4s94psp","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"3．种植：一般多采用分株繁殖。6-8月间，在阴天或清晨、傍晚，选1-2年生的壮健无病、未开花结果的分蒙株移植(或用野生植株移植)，勿伤根茎，适当剪去部分叶片。栽前，穴中酌施基肥，每穴栽4-5株，不可过深，覆土深约7cm，压实，10天内每天均宜浇水1次。"}]},{"ID":"20240902133758-6fsto2h","Type":"NodeParagraph","Properties":{"id":"20240902133758-6fsto2h","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"4．每年6月采收果实后及11-12月开花前各中耕除草1次，同时施以人粪尿或硫酸按，并割除已结过果实的分蘖株。"}]},{"ID":"20240902133758-m7rokg0","Type":"NodeParagraph","Properties":{"id":"20240902133758-m7rokg0","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902133758-i4hu400","Type":"NodeParagraph","Properties":{"id":"20240902133758-i4hu400","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"性状鉴定：干燥果实呈纺锤形或椭圆形，长1.5-2cm，直径1-1.2cm。外皮红棕色至灰棕色，有纵向断续状的隆起线13-18条。皮薄而稍韧，与种子紧贴。种子集结成团，分3瓣，中有薄膜相隔，每瓣有种子6-11粒。种子呈不规则扁圆形，略有钝棱，直径约3mm，厚约1.5mm，表面灰褐色或灰黄色；种脐位于腹面的中央，微凹陷，自种脐至背面的合点处，有一条沟状种脊；破开后里面为白色，粉性。臭特殊，味辛微苦。"}]},{"ID":"20240902133758-33dxup4","Type":"NodeParagraph","Properties":{"id":"20240902133758-33dxup4","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"显微鉴定：果皮横切面：外果皮为1列薄壁细胞，外被角质层。中果皮宽厚；油细胞散列；外韧型维管束环列于中部，其外有纤维束；有的细胞含草酸钙方晶或棒晶。内果皮为1弄薄壁细胞。种子横节面：假种皮细胞列。种皮表皮细胞排列不整齐，外被薄角质层。下皮细胞2列，外列细胞切向延长，内含红棕色、黄棕色或黄色物；内列细胞径向或切向延长，不含色素。色素层细胞4-6列，内含棕红色、黄棕色或黄色物；油细胞间断排列于色素层，略成1环。内种皮厚壁细胞褐红色、红棕色或黄棕色，内壁极厚，上端胞腔内硅质块直径10-15μm。外胚乳细胞内充满由微小淀粉粒集结而成的淀粉团，有的尚含细小草酸钙方晶或簇晶。内胚乳及胚细胞含糊粉粒，后者并含脂肪油滴。"}]},{"ID":"20240902133758-ruxjkkb","Type":"NodeParagraph","Properties":{"id":"20240902133758-ruxjkkb","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【化学成份】含挥发油1%-2%,油中含桉油精55%以及姜烯(zingiberene)、姜醇(zinginerol)。果皮的刺激性成分有1-(4'-hydroxy-3'-methoxyphenyl)-7-phenyl-3-heptanone,yakuchinone-B,trans-1-(4'-hydroxy-3'-methoxyphenyl)-7-phenylheqt-1-en-3one。并含丰富的B族维生素及维生素C，以及微量元素锰、锌、钾、钠、钙、镁、磷、铁、铜等。"}]},{"ID":"20240902133758-r0tsjj8","Type":"NodeParagraph","Properties":{"id":"20240902133758-r0tsjj8","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902133758-kjjw17r","Type":"NodeParagraph","Properties":{"id":"20240902133758-kjjw17r","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"1.Nootkatol具有拮抗钙活性的作用。"}]},{"ID":"20240902133758-3qitrz4","Type":"NodeParagraph","Properties":{"id":"20240902133758-3qitrz4","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"2．YakuchinionA具有强心作用。"}]},{"ID":"20240902133758-x6a7eqp","Type":"NodeParagraph","Properties":{"id":"20240902133758-x6a7eqp","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"3．具有抗癌、控制回肠收缩等作用。"}]},{"ID":"20240902133758-g4wb69y","Type":"NodeParagraph","Properties":{"id":"20240902133758-g4wb69y","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"4．益智果实醇提物有抑制前列腺素作用。"}]},{"ID":"20240902133758-n0b389v","Type":"NodeParagraph","Properties":{"id":"20240902133758-n0b389v","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"5．Nootkatone20mg/kg对大白鼠的胃溃疡有明显的抑制作用。"}]},{"ID":"20240902133758-tiygjs2","Type":"NodeParagraph","Properties":{"id":"20240902133758-tiygjs2","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"6．益智可升高小白鼠外周血液白细胞。"}]},{"ID":"20240902133758-lbxopig","Type":"NodeParagraph","Properties":{"id":"20240902133758-lbxopig","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【鉴别】薄层层析：取本品适量，粉碎后加水蒸馏，提取的挥发油加无水硫酸钠脱水后点样于硅胶G薄层板上，以樟脑、1,8-桉油精为对照品，石油醚-醋酸乙酯(85：15)展开，10%磷钼酸乙醇液显色，样品液色谱在与对照品色谱的相应位置上有相同斑点。本品以个大、饱满、气味浓者为佳。"}]},{"ID":"20240902133758-9h44n1z","Type":"NodeParagraph","Properties":{"id":"20240902133758-9h44n1z","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【炮制】益智仁：取益智仁置锅内，炒至外壳焦黑，取出冷透，除去果壳，取仁捣碎用。盐益智仁：取益智仁用盐水拌匀，微炒，取出放凉。(每益智仁100斤，用食盐2斤8两力口适量开水化开澄清)"}]},{"ID":"20240902133758-ux5zd9z","Type":"NodeParagraph","Properties":{"id":"20240902133758-ux5zd9z","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240902133758-vk54eyt","Type":"NodeParagraph","Properties":{"id":"20240902133758-vk54eyt","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肾经"}]},{"ID":"20240902133758-ec0nka1","Type":"NodeParagraph","Properties":{"id":"20240902133758-ec0nka1","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【功能主治】温脾止泻摄涎；暖肾缩尿固精。主脾胃虚寒；呕吐；泄泻；腹中冷育；口多唾涎；肾虚遗尿；尿频；遗精；白浊"}]},{"ID":"20240902133758-ir3af5t","Type":"NodeParagraph","Properties":{"id":"20240902133758-ir3af5t","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；或入丸、散。"}]},{"ID":"20240902133758-wmaxb7b","Type":"NodeParagraph","Properties":{"id":"20240902133758-wmaxb7b","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【附方】①治伤寒阴盛，心腹痞满，呕吐泄利，手足膝冷，及一切冷气奔冲，心胁脐腹胀满绞痛：川乌(炮，去皮、脐)四两，益智(去皮)二两，干姜(炮)半两，青皮(去白)三两。上件为散。每服三钱，水二盏，入盐一捻，生姜五片，枣二个，肇破，同煎至八分，去滓，温服，食前。(《局方》益智散)②治腹胀忽泻，日夜不止，诸药不效，此气脱也：益智子仁二两。浓煎钦之。(《世医得效方》)③治梦泄：益智仁二两(用盐二两炒，去盐)，乌药二两。上为末，用山药一两为糊，和丸如梧桐子大。每服五十九，空心临卧盐汤下，以朱砂为衣。(《世医得效方》三仙丸)④治脾气虚寒，小便频数，或遗尿不止，小儿尤效：乌药、益智仁等分。上为末，酒煮山药末为糊，丸桐子大。每服七十九，盐酒或米钦下。(《妇人良方》缩泉丸，即《魏氏家藏方》固真丹)⑤治小儿遗尿，亦治自浊：益智仁、白获苍各等分。上为末。每服一钱，空心米汤调下。(《补要袖珍小儿方论》益留仁散)⑥治妇人崩中：益智子，炒研细，米钦入盐服一钱。(《经效产宝》)⑦治漏胎下血：益智仁半两，缩砂仁一两。为末。每服三钱，空心白汤下，日二服。(胡氏《济阴方》)⑧治涵痛，连小腹挛搐，叫呼不已：益智亿、干姜(炮)、甘草(炙)、菌香(炒)各三钱，乌头(炮，去皮)、生姜备半两，青皮(去白)二钱。上细切。每服四钱，水二盏，入盐少许，煎至七分，去滓，空心食前温服。(《济生方》益智仁汤)⑨治白浊腹满，不拘男妇：益智仁(盐水浸炒)、厚朴(姜汁炒)等分。姜三片，枣一枚，水煎服。(《永类铃方》)⑩治小便赤浊：益智仁、获神各二两，远志、甘草(水煮)各半斤。为末，酒糊丸，梧子大。空心姜汤下五十丸。(《纲目》)。①《广志》：台之摄涎秽。②《本草拾遗》：止呕秽。治遗精虚漏)4、便余沥，益气安神，补不足，利三焦，调诸气，夜多小便者，取二十四枚碎，人盐同煎服。③刘完素：开发郁结，使气宣通。④《医学启源》治脾胃中寒邪，和中益气。治人多唾，当于补中药内兼用之。⑤王好古：益脾胃，理元气，补肾虚，滑沥。⑥《纲目》：治冷气腹痛，及心气不足，梦泄，赤浊，热伤心系，吐血、血崩。"}]},{"ID":"20240902133758-wr3yelw","Type":"NodeParagraph","Properties":{"id":"20240902133758-wr3yelw","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902133758-3e58xkd","Type":"NodeParagraph","Properties":{"id":"20240902133758-3e58xkd","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：益智，行阳退阴之药也。三焦、命门气弱者宜之。接杨士源《直指方》云：心看脾之母，进食，不止于和脾，火能生士，当使心药入脾胃药中，庶几相得。故古人进食药中，多用益智，土中益火也。"}]},{"ID":"20240902133758-fbonr1w","Type":"NodeParagraph","Properties":{"id":"20240902133758-fbonr1w","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：益智子仁，以其敛摄，故治遗精虚漏，及小便余沥，此皆肾气不固之证也。肾主纳气，虚则不能纳矣。又主五液，涎乃脾之所统，脾肾气虚，二脏失职，是肾不能纳，脾不能摄，故主气逆上浮，涎秽泛滥而上溢也，敛摄脾肾之气，则逆气归元，涎秽下行。"}]},{"ID":"20240902133758-120fp67","Type":"NodeParagraph","Properties":{"id":"20240902133758-120fp67","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"3.《本草求真》：益智，气味宰热，功专燥脾温胃，及敛脾肾气逆，藏纳归源，故又号为补心补命之剂。是以胃冷而见涎唾，则用此以收摄，脾虚而见不食，则用此温理，胃气不温，而见小便不缩，则用此入缩泉丸以投。与夫心肾不足，而见梦遗崩带，则用此以为秘精固气。若因热成气虚，而见崩浊、梦遗等症者，则非所宜。此虽类于缩砂密，同为温胃，但缩砂密多有快滞之功，此则止有逐玲之力，不可不分别而审用耳。"}]},{"ID":"20240902133758-a0con29","Type":"NodeParagraph","Properties":{"id":"20240902133758-a0con29","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"4.《会约医镜》：益智仁，其性行多补少，须兼补剂用之，若独用则散气。"}]},{"ID":"20240902133758-m9alq6f","Type":"NodeParagraph","Properties":{"id":"20240902133758-m9alq6f","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：益智，始见于藏器《本草拾邀》，谓之辛温，不言其涩，但诺家所述主治，无一非温涩功用。杨仁斋《直指方》云，古人进食药中，多用益智，士中益火也。案此为脾虚馁而不思食者立法，脾土喜温而恶寒，喜燥而恶湿，寒湿困之，则健运力乏而不思纳谷，且食亦无味，此准温照以助阳和而斡旋大气，则能进食。益智醒脾益胃，固亦与砂仁、豆惹等一以摄之。仁斋说到益火生土上去，附会心经之药，尚是舍近求远，故意深言之，亦殊不必。濒湖又谓治心气不足，梦泄，赤浊，则以肾阳无极，滑泄不禁者立论，故可用此温涩一法，然遗浊之虚寒症绝少，石顽谓因于热者，色黄干结，不可误用，极是。濒湖又谓治热伤心系，吐血血崩诸证，则既是热伤，而反用此大李大热之药，何其背留一至于此。"}]},{"ID":"20240902133758-8irma28","Type":"NodeParagraph","Properties":{"id":"20240902133758-8irma28","updated":"20240902133806"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902133759-kjreoyh","Type":"NodeThematicBreak","Properties":{"id":"20240902133759-kjreoyh","updated":"20240902133806"}},{"ID":"20240902133800-2y0d91t","Type":"NodeParagraph","Properties":{"id":"20240902133800-2y0d91t","updated":"20240902133806"}}]}