{"ID":"20240205165623-x9jgei6","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205165623-x9jgei6","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165623-x9jgei6\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206103729-cd9c1qr\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205170129-d11vc5m\u0026quot;,\u0026quot;scrollTop\u0026quot;:600,\u0026quot;focusId\u0026quot;:\u0026quot;20240206103729-cd9c1qr\u0026quot;,\u0026quot;focusStart\u0026quot;:206,\u0026quot;focusEnd\u0026quot;:206\u0026#125;","title":"益智仁","type":"doc","updated":"20240902133807"},"Children":[{"ID":"20240206103729-cd9c1qr","Type":"NodeParagraph","Properties":{"id":"20240206103729-cd9c1qr","updated":"20240206103740"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于辽宁、河北、内蒙古等地。\n【性状】\t本品呈椭圆形，两端略尖，长1.22cm，直径11.3cm。表面棕色或灰棕色，有纵向凹凸不平的突起棱线1320条，顶端有花被残基，基部常残存果梗。果皮薄而稍韧，与种子紧贴，种子集结成团，中有隔膜将种子团分为3瓣，每瓣有种子611粒。种子呈不规则的扁圆形，略有钝棱，直径约3mm，表面灰褐色或灰黄色，外被淡棕色膜质的假种皮；质硬，胚乳白色。有特异香气，味辛，微苦。\n【性味】\t辛，温。\n【功效】\t温脾止泻，摄唾涎，暖肾，固精缩尿。用于脾寒泄泻，腹中冷痛，口多唾涎，肾虚遗尿，小便频数，遗精白浊。"}]},{"ID":"20240206103730-7n982xl","Type":"NodeParagraph","Properties":{"id":"20240206103730-7n982xl","updated":"20240206103730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206103730-mt9se1c.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205170129-d11vc5m","Type":"NodeParagraph","Properties":{"id":"20240205170129-d11vc5m","updated":"20240205170129"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智仁"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智仁-20240205170129-y2y0l9o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718101800-y3m39nd","Type":"NodeParagraph","Properties":{"id":"20240718101800-y3m39nd","updated":"20240718103157"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 366px;","style":"width: 356px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 11-20240718103149-ilnr64l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 356px;\" parent-style=\"width: 366px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 417px;","style":"width: 407px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智-20240718101914-ji3eux6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 407px;\" parent-style=\"width: 417px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718102004-46mvrev","Type":"NodeParagraph","Properties":{"id":"20240718102004-46mvrev","updated":"20240718103411"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 792px;","style":"width: 782px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益智 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益智 1-20240718102004-2cgr3ju.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 782px;\" parent-style=\"width: 792px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"