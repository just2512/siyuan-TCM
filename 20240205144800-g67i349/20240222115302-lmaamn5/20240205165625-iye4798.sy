{"ID":"20240205165625-iye4798","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205165625-iye4798","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165625-iye4798\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206092305-n6ao0ro\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205170037-762av3a\u0026quot;,\u0026quot;scrollTop\u0026quot;:16,\u0026quot;focusId\u0026quot;:\u0026quot;20240206092305-n6ao0ro\u0026quot;,\u0026quot;focusStart\u0026quot;:139,\u0026quot;focusEnd\u0026quot;:139\u0026#125;","title":"太子参（孩儿参）","type":"doc","updated":"20240830164531"},"Children":[{"ID":"20240206092305-n6ao0ro","Type":"NodeParagraph","Properties":{"id":"20240206092305-n6ao0ro","updated":"20240206092312"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产山东、江苏、安徽等地。\n【性状】\t干燥块根呈细长条形或长纺锤形，长约26cm，直径约36mm左右，表面黄白色，半透明，有纵皱纹及凹下的须根痕，根头钝圆，其上常有残存的茎痕，下端渐细如鼠尾。质脆易折断，断面黄白色或类白色，直接晒干的断面为白色，有粉性，气微，味微甘。\n【性味】\t甘，微苦，微温。\n【功效】\t补益脾肺，益气生津。治肺虚咳嗽，脾虚食少，心悸，怔忡，水肿，消渴，精神疲乏。"}]},{"ID":"20240206092304-a55epwg","Type":"NodeParagraph","Properties":{"id":"20240206092304-a55epwg","updated":"20240206092304"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206092304-r5r5gmh.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205170037-762av3a","Type":"NodeParagraph","Properties":{"id":"20240205170037-762av3a","updated":"20240205170037"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参-20240205170037-6v8sdjj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712095458-2ndi8cl","Type":"NodeParagraph","Properties":{"id":"20240712095458-2ndi8cl","updated":"20240712095458"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 638px;","style":"width: 628px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 2-20240712095458-ockgzdb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 628px;\" parent-style=\"width: 638px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240712100350-02k31c0","Type":"NodeParagraph","Properties":{"id":"20240712100350-02k31c0","updated":"20240712101008"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 402px;","style":"width: 392px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 10-20240712100350-vl9wtps.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 392px;\" parent-style=\"width: 402px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 727px;","style":"width: 717px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 13-20240712101007-10w1hvi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 717px;\" parent-style=\"width: 727px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712100415-3s7a2w6","Type":"NodeParagraph","Properties":{"id":"20240712100415-3s7a2w6","updated":"20240712100420"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-