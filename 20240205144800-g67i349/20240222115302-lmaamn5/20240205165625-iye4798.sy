px;\" parent-style=\"width: 677px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712095317-m9q7zh7","Type":"NodeParagraph","Properties":{"id":"20240712095317-m9q7zh7","updated":"20240712100530"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 5-20240712095803-3ujlexg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 6-20240712095857-n096kba.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712095154-zsn8159","Type":"NodeParagraph","Properties":{"id":"20240712095154-zsn8159","updated":"20240712100133"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 667px;","style":"width: 657px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参-20240712095154-5bw6bkn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 657px;\" parent-style=\"width: 667px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 575px;","style":"width: 565px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 1-20240712095228-vhd4mc3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 565px;\" parent-style=\"width: 575px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240712100227-sa1i0k0","Type":"NodeParagraph","Properties":{"id":"20240712100227-sa1i0k0","updated":"20240712100709"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 8-20240712100054-bwb7uxn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 7-20240712095954-l3g9y9q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240712100105-pc43asj","Type":"NodeParagraph","Properties":{"id":"20240712100105-pc43asj","updated":"20240712100731"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"太子参 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/太子参 9-20240712100227-nrjn9i2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830082732-qvyy9tl","Type":"NodeThematicBreak","Properties":{"id":"20240830082732-qvyy9tl"}},{"ID":"20240830164524-bb6exls","Type":"NodeParagraph","Properties":{"id":"20240830164524-bb6exls","updated":"20240830164531"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：太子参"}]},{"ID":"20240830164524-awn9h6f","Type":"NodeParagraph","Properties":{"id":"20240830164524-awn9h6f","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"太子参《中国药典》"}]},{"ID":"20240830164524-pzjdv3z","Type":"NodeParagraph","Properties":{"id":"20240830164524-pzjdv3z","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【拼音名】TàiZǐShēn"}]},{"ID":"20240830164524-007zpel","Type":"NodeParagraph","Properties":{"id":"20240830164524-007zpel","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXPSEUDOSTELLARIAE"}]},{"ID":"20240830164524-8qslliu","Type":"NodeParagraph","Properties":{"id":"20240830164524-8qslliu","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【别名】孩儿参、双批七、异叶假繁缕"}]},{"ID":"20240830164524-zgkjgov","Type":"NodeParagraph","Properties":{"id":"20240830164524-zgkjgov","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【来源】本品为石竹科植物孩儿参Pseudostellariaheterophylla（Miq.）PaxexPaxetHoffm.的干燥块根。夏季茎叶大部分枯萎时采挖，洗净，除去须根，置沸水中略烫后晒干或直接晒干。"}]},{"ID":"20240830164524-es8ppzc","Type":"NodeParagraph","Properties":{"id":"20240830164524-es8ppzc","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈细长纺锤形或细长条形，稍弯曲，长3～10cm,直径0.2～0.6cm。表面黄白色，较光滑，微有纵皱纹，凹陷处有须根痕。顶端有茎痕。质硬而脆，断面平坦，淡黄白色，角质样；或类白色，有粉性。气微，味微甘。"}]},{"ID":"20240830164524-597x72g","Type":"NodeParagraph","Properties":{"id":"20240830164524-597x72g","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830164524-pokfmln","Type":"NodeParagraph","Properties":{"id":"20240830164524-pokfmln","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：木栓层为2～4列类方形木栓细胞。皮层薄，仅数列薄壁细胞，切向延长。韧皮部窄，射线宽广。形成层成环。木质部占根的大部分，导管稀疏排列成放射状，初生木质部3～4原型。薄壁细胞充满淀粉粒和草酸钙簇晶。"}]},{"ID":"20240830164524-3quoun5","Type":"NodeParagraph","Properties":{"id":"20240830164524-3quoun5","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加甲醇10ml，温浸，振摇30分钟，滤过，滤液浓缩至1ml,作为供试品溶液。另取太子参对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各1μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以正丁醇－冰醋酸－水（4:1:1）为展开剂，置用展开剂预饱和15分钟的展开缸内，展开，取出，晾干，喷以0.2％茚三酮乙醇溶液，在105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240830164524-hesdk6s","Type":"NodeParagraph","Properties":{"id":"20240830164524-hesdk6s","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微苦，平。"}]},{"ID":"20240830164524-zsaso33","Type":"NodeParagraph","Properties":{"id":"20240830164524-zsaso33","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、肺经。"}]},{"ID":"20240830164524-s6tdrc4","Type":"NodeParagraph","Properties":{"id":"20240830164524-s6tdrc4","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【功能主治】益气健脾，生津润肺。用于脾虚体倦，食欲不振，病后虚弱，气阴不足，自汗口渴，肺燥干咳。"}]},{"ID":"20240830164524-hl8sm17","Type":"NodeParagraph","Properties":{"id":"20240830164524-hl8sm17","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～30g。"}]},{"ID":"20240830164524-ydckvhq","Type":"NodeParagraph","Properties":{"id":"20240830164524-ydckvhq","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防潮，防蛀。"}]},{"ID":"20240830164524-batzezx","Type":"NodeParagraph","Properties":{"id":"20240830164524-batzezx","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830164524-5x0cxn6","Type":"NodeParagraph","Properties":{"id":"20240830164524-5x0cxn6","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"太子参《*辞典》"}]},{"ID":"20240830164524-luh5vzi","Type":"NodeParagraph","Properties":{"id":"20240830164524-luh5vzi","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【出处】《本草从新》"}]},{"ID":"20240830164524-2m53jbq","Type":"NodeParagraph","Properties":{"id":"20240830164524-2m53jbq","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【拼音名】TàiZǐShēn"}]},{"ID":"20240830164524-ax1m2ou","Type":"NodeParagraph","Properties":{"id":"20240830164524-ax1m2ou","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【别名】孩儿参（《饮片新参》），童参（《上海常用中草药》）。"}]},{"ID":"20240830164524-1for51t","Type":"NodeParagraph","Properties":{"id":"20240830164524-1for51t","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【来源】为石竹科植物异叶假繁缕的块根。大暑前后采挖。洗净泥土，入沸水中浸烫，约3～5分钟后取出曝晒，当须根干时，即将须根擦光，然后晒至全干。也可不经浸烫，摘除须根后直接晒干。"}]},{"ID":"20240830164524-my4k5e7","Type":"NodeParagraph","Properties":{"id":"20240830164524-my4k5e7","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本，高15～20厘米。块根长纺锤形。茎下部紫色，近四方形，上部近圆形，绿色，有2列细毛，节略膨大。叶对生，略带内质，下部叶匙形或倒披针形。先端尖，基部渐狭，上部叶卵状披针形至长卵形，茎端的叶常4枚相集较大，成十字形排列，边缘略呈波状。花腋生，二型：闭锁花生茎下部叶腋，小形，花梗细，被柔毛；萼片4；无花瓣。普通花1～3朵顶生，白色；花梗长1～4）厘米，紫色；萼片5，披针形，背面有毛；花瓣5，倒卵形，顶端2齿裂；雄蕊10，花药紫色；雌蕊1，花柱3，柱头头状。蒴果近球形，熟时5瓣裂。种子扁圆形，有疣状突起。花期4～5月。果期5～6月。"}]},{"ID":"20240830164524-kea9l5d","Type":"NodeParagraph","Properties":{"id":"20240830164524-kea9l5d","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于林下富腐殖质的深厚土壤中。分布华东、华中、华北、东北和西北等地。主产于江苏、山东。此外，安徽等地亦产。"}]},{"ID":"20240830164524-4qemqm3","Type":"NodeParagraph","Properties":{"id":"20240830164524-4qemqm3","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性状】干燥块根呈细长条形或长纺锤形，长约2～6厘米；直径约3～6毫米左右。表面黄白色，半透明，有细皱纹及凹下的须根痕，根头钝圆，其上常有残存的茎痕，下端渐细如鼠尾。质脆易折断，断面黄白色而亮，直接晒干的断面为白色，有粉性。气微，味微甘。以肥润、黄白色、无须根者为佳。"}]},{"ID":"20240830164524-fka1e96","Type":"NodeParagraph","Properties":{"id":"20240830164524-fka1e96","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含果糖、淀粉、皂甙。"}]},{"ID":"20240830164524-2rug2st","Type":"NodeParagraph","Properties":{"id":"20240830164524-2rug2st","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830164524-a7mnpb9","Type":"NodeParagraph","Properties":{"id":"20240830164524-a7mnpb9","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"甘苦，微温。"}]},{"ID":"20240830164524-qfikfk1","Type":"NodeParagraph","Properties":{"id":"20240830164524-qfikfk1","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"①《本草再新》：\"味甘，性温，无毒。\""}]},{"ID":"20240830164524-jwtya0o","Type":"NodeParagraph","Properties":{"id":"20240830164524-jwtya0o","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"②《饮片新参》：\"甘润，微苦平。\""}]},{"ID":"20240830164524-yp8tz5j","Type":"NodeParagraph","Properties":{"id":"20240830164524-yp8tz5j","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"③《中药志》：\"甘苦，微寒。\""}]},{"ID":"20240830164524-lxhemxy","Type":"NodeParagraph","Properties":{"id":"20240830164524-lxhemxy","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【归经】《本草再新》：\"入心、脾、肺三经。\""}]},{"ID":"20240830164524-4bfnoru","Type":"NodeParagraph","Properties":{"id":"20240830164524-4bfnoru","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830164524-16zatqw","Type":"NodeParagraph","Properties":{"id":"20240830164524-16zatqw","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"补肺，健牌。治肺虚咳嗽，脾虚食少，心悸自汗，精神疲乏。"}]},{"ID":"20240830164524-te3lh50","Type":"NodeParagraph","Properties":{"id":"20240830164524-te3lh50","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"益气健脾，生津润肺。用于脾虚体弱、病后虚弱、气阴不足、自汗口渴、肺噪干咳。"}]},{"ID":"20240830164524-syo33hg","Type":"NodeParagraph","Properties":{"id":"20240830164524-syo33hg","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"①《本草从新》：\"大补元气。\""}]},{"ID":"20240830164524-x74bbm9","Type":"NodeParagraph","Properties":{"id":"20240830164524-x74bbm9","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"治气虚肺燥，补脾土，消水肿，化痰止渴。\""}]},{"ID":"20240830164524-ztt5ing","Type":"NodeParagraph","Properties":{"id":"20240830164524-ztt5ing","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"③《饮片新参》：\"补脾肺元气，止汗生津，定虚悸。\""}]},{"ID":"20240830164524-thzn6ch","Type":"NodeParagraph","Properties":{"id":"20240830164524-thzn6ch","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"④《江苏植药志》：\"治胃弱消化不良，神经衰弱。\""}]},{"ID":"20240830164524-tm0fvsa","Type":"NodeParagraph","Properties":{"id":"20240830164524-tm0fvsa","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"⑤《中药志》：\"治肺虚咳嗽，脾虚泄泻。\""}]},{"ID":"20240830164524-gbhh9kx","Type":"NodeParagraph","Properties":{"id":"20240830164524-gbhh9kx","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"⑥《陕西中草药》：\"补气益血，健脾生津。治病后体虚，肺虚咳嗽，脾虚腹泻，小儿虚汗，心悸，口干，不思饮食。\""}]},{"ID":"20240830164524-ppdmm8p","Type":"NodeParagraph","Properties":{"id":"20240830164524-ppdmm8p","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～4钱。"}]},{"ID":"20240830164524-dlwb64z","Type":"NodeParagraph","Properties":{"id":"20240830164524-dlwb64z","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【附方】治自汗：太子参三钱，浮小麦五钱，水煎服。（《陕西中草药》）"}]},{"ID":"20240830164524-shhcq7e","Type":"NodeParagraph","Properties":{"id":"20240830164524-shhcq7e","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【备注】同属植物假繁缕（又名：棒棒草）的根在少数地区与本品同等使用。"}]},{"ID":"20240830164524-hwnf0pp","Type":"NodeParagraph","Properties":{"id":"20240830164524-hwnf0pp","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830164524-ghwi9sb","Type":"NodeParagraph","Properties":{"id":"20240830164524-ghwi9sb","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"太子参《中华本草》"}]},{"ID":"20240830164524-yl22kbj","Type":"NodeParagraph","Properties":{"id":"20240830164524-yl22kbj","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草从新》：太子参，虽甚细如参条，短紧结实，而有芦纹，其力不下大参。据《本草从新》、《纲目拾遗》、《饮片新参》等书，太子参原指五加科植物人参之小者。现在商品则普遍用石竹科植物异叶假繁缕的块根，虽有滋补功用，但其力较薄。"}]},{"ID":"20240830164524-dqtescx","Type":"NodeParagraph","Properties":{"id":"20240830164524-dqtescx","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【拼音名】TàiZǐShēn"}]},{"ID":"20240830164524-sfk7zye","Type":"NodeParagraph","Properties":{"id":"20240830164524-sfk7zye","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【别名】孩儿参、童参、双批七、四叶参、米参"}]},{"ID":"20240830164524-ic03vvg","Type":"NodeParagraph","Properties":{"id":"20240830164524-ic03vvg","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830164524-uqh0ec1","Type":"NodeParagraph","Properties":{"id":"20240830164524-uqh0ec1","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"药材基源：为石竹科植物孩儿参的块根。"}]},{"ID":"20240830164524-vc7ktb7","Type":"NodeParagraph","Properties":{"id":"20240830164524-vc7ktb7","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Pseudostellariaheterophylla（Miq．）PaxexPaxetHoffm．［P．Rhaphanorhyza（Hemsl．）Pax］"}]},{"ID":"20240830164524-51o3o1w","Type":"NodeParagraph","Properties":{"id":"20240830164524-51o3o1w","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6～7月茎叶大部枯萎时收获，挖掘根部（以根呈黄色为宜，过早未成熟，过晚浆汁易渗出，遇暴雨易造成腐烂），洗净，放100℃开水锅中焯烨1～3min，捞起，摊晒至干足。或不经开水焯，直接晒至7～8成干，搓去须根，使参根光滑无毛，再晒至干足。"}]},{"ID":"20240830164524-gsbf919","Type":"NodeParagraph","Properties":{"id":"20240830164524-gsbf919","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830164524-1qaf5ox","Type":"NodeParagraph","Properties":{"id":"20240830164524-1qaf5ox","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15-20cm。地下有肉质直生纺锤形块根，四周疏生须根。茎单一，不分枝，下部带紫色，近方形，上部绿色，圆柱形，有明显膨大的节，光滑无毛。单叶对生；茎下部的叶最小，倒披针形，先端尖，基部渐窄成柄，全缘，向上渐大，在茎顶的叶最大，通常两对密接成4叶轮生状，长卵形或卵状披针形，长4-9cm，宽2-4.5cm，先端渐尖，基部狭窄成柄，叶背脉上有疏毛，边缘略呈波状。花二型：近地面的花小，为闭锁花.花梗紫色有短柔毛，萼片4，背面紫色，边缘白色而呈薄膜质，无花瓣；茎顶上的花较大而开放，花梗细，长1-2（-4）cm，有短柔毛，花时直立，花后下垂，萼片5，披针形，绿色，背面及边缘有长毛；花瓣5，白色，先端呈浅齿状2裂或钝；雄蕊10；子房卵形，花柱3。"}]},{"ID":"20240830164524-rqc69hq","Type":"NodeParagraph","Properties":{"id":"20240830164524-rqc69hq","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"蒴果近球形。有少数种子，种子褐色，扁圆形或长圆状肾形，有疣状突起。花期4月，果期5-6月。"}]},{"ID":"20240830164524-hyc90cf","Type":"NodeParagraph","Properties":{"id":"20240830164524-hyc90cf","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830164524-vmxc8g8","Type":"NodeParagraph","Properties":{"id":"20240830164524-vmxc8g8","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡林下和岩石缝中。"}]},{"ID":"20240830164524-0nhmhqs","Type":"NodeParagraph","Properties":{"id":"20240830164524-0nhmhqs","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、西北、华东及湖北、湖南等地。"}]},{"ID":"20240830164524-ryq167s","Type":"NodeParagraph","Properties":{"id":"20240830164524-ryq167s","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830164524-igr37p0","Type":"NodeParagraph","Properties":{"id":"20240830164524-igr37p0","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，抗寒力较强，怕高温，忌强光，怕涝。具有低温发芽、发根和越冬的特性。气温在15℃，地温在10℃时缓慢发芽、发根，高达30℃以上停止生长，忌连作。选阴湿山地、土层深厚、疏松肥沃、富含腐殖质的砂质土壤为宜，低洼积水、盐碱地、过分粘重或过分贫瘠土壤中不宜栽种。前作以甘薯、蔬菜为好，可与玉米间作。"}]},{"ID":"20240830164524-l5p48mz","Type":"NodeParagraph","Properties":{"id":"20240830164524-l5p48mz","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"栽培技术用块根繁殖。6～7月挖掘块根，用湿沙贮藏。"}]},{"ID":"20240830164524-ku6k6vk","Type":"NodeParagraph","Properties":{"id":"20240830164524-ku6k6vk","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"或用原地保种法，在5月上旬太子参地里套种早熟黄豆，待黄豆收获后再挖太子参。栽种期10月。选芽头完整，参体肥大整齐，无伤疤的块根。栽种方法有平栽和斜栽两种。平栽按行距15～20cm开沟，深6～9cm，将块根平放于沟内，头尾相接，覆土。斜栽，将块根斜放于沟内，头向上，尾向下，齐头不齐尾，离地面2cm，覆土。每1hm2用种量1125kg。亦可用自然落地的种子，进行原地育苗。"}]},{"ID":"20240830164524-73b7eem","Type":"NodeParagraph","Properties":{"id":"20240830164524-73b7eem","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"田间管理2月出苗后应培土1．5～2cm；除草1～2次，封行后停止拔草。4月块根膨大，施稀腐熟人粪尿。雨季需排除积水，以免发生根腐病。5月多风易旱季节，注意浇水，保持土壤湿润，并防止人畜踩踏。"}]},{"ID":"20240830164524-f7rpe38","Type":"NodeParagraph","Properties":{"id":"20240830164524-f7rpe38","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有叶斑病、根腐病，可用波尔多液1：1：100液喷射；亦可用代森锌65％可湿性粉剂500-600倍喷射。"}]},{"ID":"20240830164524-6qcsb7u","Type":"NodeParagraph","Properties":{"id":"20240830164524-6qcsb7u","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"病毒病，可利用种子消．控制氮肥．增施磷、钾肥，防治蚜虫的传染源等综合防治方法。虫害有济粮、蛴螬、地老虎、金针虫为害根部。"}]},{"ID":"20240830164524-nm9vm1m","Type":"NodeParagraph","Properties":{"id":"20240830164524-nm9vm1m","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830164524-huj63ze","Type":"NodeParagraph","Properties":{"id":"20240830164524-huj63ze","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"性状鉴别块根细长纺锤形或细长条形，稍弯曲，长2-8cm，少数可达12cm,直径2-6mm，顶端残留极短的茎基或芽痕，下部渐细呈尾状。表面黄白色至土黄色，较光滑，略具不规则的细纵皱纹及横向凹陷，其间有须根痕。质硬脆，易折断，断面平坦，类白色或黄白色，角质样；晒干者类白色，有粉性。气微，味微甘。（图2）以条粗、色黄白者为佳。"}]},{"ID":"20240830164524-3vkmqc8","Type":"NodeParagraph","Properties":{"id":"20240830164524-3vkmqc8","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"显微鉴别块根横切面：木栓层为4-6列方形木栓细胞。皮层薄壁细胞数列，多切向延长。韧皮部窄，射线甚宽。形成层明显。木质部占根的绝大部分，射线宽广，导管稀疏排列成放射状；初生木质部3-4原型。薄壁细胞中充满淀粉粒，并有少数草酸钙簇晶，直径12-60μm，于木质部较易察见。"}]},{"ID":"20240830164524-8u3bmch","Type":"NodeParagraph","Properties":{"id":"20240830164524-8u3bmch","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡黄白色。①淀粉粒极多，多为单粒，类圆形，直径4-24μm，脐点星状、三叉状及裂隙状等，小粒的脐点不明显复粒由2-3分粒组成。②导管主为网纹导管，直径12-24μm。③草酸钙簇晶直径12-60μm。④木柱细胞淡黄色，表面观长多角形，壁薄，部分略波状弯曲。"}]},{"ID":"20240830164524-e3s4cib","Type":"NodeParagraph","Properties":{"id":"20240830164524-e3s4cib","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【化学成份】太子参块根脂类中含有棕榈酸（Palmiticacid），亚油酸（linoleicacid），1-亚油酸甘油酯（glycerol1-monoli-nolate)，吡咯-2-羧酸-3′-呋喃甲醇酯（3′-furfurylpyrrole-2-car-boxylate）[1]，山（艹俞）酸（behenicacid），2-吡咯甲酸（2－minaline），β-谷甾醇（β-sitoserol）[2]，另含糖，氨基酸[3]，微量元素[锰（13.4μg/g）等〕[4]和太子参环肽（heterophyllin）A及B[5，6]。"}]},{"ID":"20240830164524-fwktya6","Type":"NodeParagraph","Properties":{"id":"20240830164524-fwktya6","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【药理作用】对机体具有适应原样作用，即能增强机体对各种有害刺激的防御能力。还可增强人体内的物质代谢。"}]},{"ID":"20240830164524-ha3vjmk","Type":"NodeParagraph","Properties":{"id":"20240830164524-ha3vjmk","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【性味】甘;微苦；性微寒"}]},{"ID":"20240830164524-z65yjtp","Type":"NodeParagraph","Properties":{"id":"20240830164524-z65yjtp","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【归经】脾、肺经"}]},{"ID":"20240830164524-bv4gpqy","Type":"NodeParagraph","Properties":{"id":"20240830164524-bv4gpqy","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【功能主治】补益脾肺；益气生津。主脾胃虚弱；食欲不振；倦怠无力；气阴两伤；干咳痰少；自汗气短；以及温病后期气虚津伤；内热口渴；或神经衰弱，心悸失眠，头昏健忘，小儿夏季热"}]},{"ID":"20240830164524-mo5b17t","Type":"NodeParagraph","Properties":{"id":"20240830164524-mo5b17t","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10～15g."}]},{"ID":"20240830164524-cjcxq0q","Type":"NodeParagraph","Properties":{"id":"20240830164524-cjcxq0q","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【注意】表实邪盛者不宜用。"}]},{"ID":"20240830164524-qq7poh8","Type":"NodeParagraph","Properties":{"id":"20240830164524-qq7poh8","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【附方】治自汗方(《陕西中草药》)：太子参三钱，浮小麦五钱，水煎服。"}]},{"ID":"20240830164524-4fy5gww","Type":"NodeParagraph","Properties":{"id":"20240830164524-4fy5gww","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830164524-0elmu17","Type":"NodeParagraph","Properties":{"id":"20240830164524-0elmu17","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"1.《本草从新》：大补元气。"}]},{"ID":"20240830164524-46gw39l","Type":"NodeParagraph","Properties":{"id":"20240830164524-46gw39l","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"2.《本草再新》：治气虚肺燥，补脾土，消水肿，化痰止渴。"}]},{"ID":"20240830164524-la5uzo7","Type":"NodeParagraph","Properties":{"id":"20240830164524-la5uzo7","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"3.《饮片新参》：补脾肺元气，止汗生津，定虚悸。"}]},{"ID":"20240830164524-yfbnukd","Type":"NodeParagraph","Properties":{"id":"20240830164524-yfbnukd","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"4.《江苏植药志》：治胃弱消化不良，神经衰弱。"}]},{"ID":"20240830164524-cbo663o","Type":"NodeParagraph","Properties":{"id":"20240830164524-cbo663o","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"5.《中药志》：治肺虚咳嗽，脾虚泄泻。"}]},{"ID":"20240830164524-sb956rb","Type":"NodeParagraph","Properties":{"id":"20240830164524-sb956rb","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"6.《陕西中草药》：补气益血，健脾生津。治病后体虚，肺虚咳嗽，脾虚腹泻，小儿虚汗，心悸，口干，不思饮食。"}]},{"ID":"20240830164524-5nn72j3","Type":"NodeParagraph","Properties":{"id":"20240830164524-5nn72j3","updated":"20240830164530"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830164525-cuujrns","Type":"NodeThematicBreak","Properties":{"id":"20240830164525-cuujrns","updated":"20240830164530"}},{"ID":"20240830164527-a2rurvf","Type":"NodeParagraph","Properties":{"id":"20240830164527-a2rurvf","updated":"20240830164530"}}]}