rq8oobd","Type":"NodeParagraph","Properties":{"id":"20240716094628-rq8oobd","updated":"20240716094656"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：沙苑子颜色带青绿色，形状是扁平的肾形；"}]},{"ID":"20240902100207-au4klo7","Type":"NodeParagraph","Properties":{"id":"20240902100207-au4klo7","updated":"20240902100256"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：未找到扁茎黄芪与黄芪的植株对比视频；"}]},{"ID":"20240716094431-of71mpa","Type":"NodeThematicBreak","Properties":{"id":"20240716094431-of71mpa"}},{"ID":"20240716094431-53mt8u5","Type":"NodeParagraph","Properties":{"id":"20240716094431-53mt8u5","updated":"20240902100313"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"沙苑子"}]},{"ID":"20240902100313-55gqxlb","Type":"NodeParagraph","Properties":{"id":"20240902100313-55gqxlb","updated":"20240902100321"},"Children":[{"Type":"NodeText","Data":"性味：味甘；性温。"}]},{"ID":"20240902100322-k08k9kz","Type":"NodeParagraph","Properties":{"id":"20240902100322-k08k9kz","updated":"20240902100330"},"Children":[{"Type":"NodeText","Data":"归经：归肝、肾经。"}]},{"ID":"20240902100331-m4ppwkx","Type":"NodeParagraph","Properties":{"id":"20240902100331-m4ppwkx","updated":"20240902100339"},"Children":[{"Type":"NodeText","Data":"功效：补肾助阳，固精缩尿，养肝明目。"}]},{"ID":"20240902100340-x2ek23x","Type":"NodeParagraph","Properties":{"id":"20240902100340-x2ek23x","updated":"20240902100346"},"Children":[{"Type":"NodeText","Data":"主治：用于肾虚腰痛，遗精早泄，遗尿尿频，白浊带下，眩晕，目暗昏花。"}]},{"ID":"20240902100347-jmyfls2","Type":"NodeParagraph","Properties":{"id":"20240902100347-jmyfls2","updated":"20240902100401"},"Children":[{"Type":"NodeText","Data":"相关配伍：治肾虚精关不固，遗精滑泄，腰酸耳鸣，四肢乏力，舌淡苔白，脉细弱：沙苑蒺藜（炒）、芡实（蒸）、莲须各二两，龙骨（酥炙）、牡蛎（盐水煮一日一夜，煅粉）各一两。共为末，莲子粉糊为丸，盐汤下。（《医方集解》金锁固精丸）"}]},{"ID":"20240902100428-l6k8ic7","Type":"NodeParagraph","Properties":{"id":"20240902100428-l6k8ic7","updated":"20240902100435"},"Children":[{"Type":"NodeText","Data":"性状：略呈肾形而稍扁，长2～2"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"."}]},{"Type":"NodeText","Data":"5mm，宽1"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"."}]},{"Type":"NodeText","Data":"5～2mm，厚约1mm。表面光滑，褐绿色或灰褐色．边缘一侧微凹处具圆形种脐。质坚硬，不易破碎。子叶2，淡黄色，胚根弯曲，长约1mm。气微，味淡，嚼之有豆腥味。"}]},{"ID":"20240902100313-4belexs","Type":"NodeThematicBreak","Properties":{"id":"20240902100313-4belexs"}},{"ID":"20240902100314-pksdqju","Type":"NodeParagraph","Properties":{"id":"20240902100314-pksdqju"}}]}