th: 707px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710195034-e2uod91","Type":"NodeParagraph","Properties":{"id":"20240710195034-e2uod91","updated":"20240710195034"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 647px;","style":"width: 637px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 9-20240710195034-0cbmzk1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 637px;\" parent-style=\"width: 647px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 8-20240710194935-tduhzrs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710195133-h1f60cr","Type":"NodeParagraph","Properties":{"id":"20240710195133-h1f60cr","updated":"20240830163319"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 10-20240710195133-ubky56m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 402px;","style":"width: 392px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710193810-q6hyerj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 392px;\" parent-style=\"width: 402px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710194542-c4gigwt","Type":"NodeParagraph","Properties":{"id":"20240710194542-c4gigwt","updated":"20240830163452"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 380px;","style":"width: 370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 6-20240710194542-semg48l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 370px;\" parent-style=\"width: 380px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 7-20240710194627-m3qznr7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 501px;","style":"width: 491px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 1-20240830163452-79tg86m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 491px;\" parent-style=\"width: 501px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830163316-w0j3pnu","Type":"NodeParagraph","Properties":{"id":"20240830163316-w0j3pnu","updated":"20240830163316"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 842px;","style":"width: 832px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲-20240830163316-8bnicyx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 832px;\" parent-style=\"width: 842px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240710193812-bhjftso","Type":"NodeParagraph","Properties":{"id":"20240710193812-bhjftso","updated":"20240710193832"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：墨旱莲掰开茎杆会流墨汁。"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240710193812-81rabhd","Type":"NodeThematicBreak","Properties":{"id":"20240710193812-81rabhd"}},{"ID":"20240830163527-2t42dyd","Type":"NodeParagraph","Properties":{"id":"20240830163527-2t42dyd","updated":"20240830163535"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：墨旱莲"}]},{"ID":"20240830163527-01cr5qz","Type":"NodeParagraph","Properties":{"id":"20240830163527-01cr5qz","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"墨旱莲《中国药典》"}]},{"ID":"20240830163527-oz2epv6","Type":"NodeParagraph","Properties":{"id":"20240830163527-oz2epv6","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【拼音名】MòHànLián"}]},{"ID":"20240830163527-kkur768","Type":"NodeParagraph","Properties":{"id":"20240830163527-kkur768","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【英文名】HERBAECLIPTAE"}]},{"ID":"20240830163527-u33aa9i","Type":"NodeParagraph","Properties":{"id":"20240830163527-u33aa9i","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【别名】旱莲草、水旱莲、莲子草、白花蟛蜞草、墨斗草、野向日葵、墨菜、黑墨草、墨汁草、墨水草、乌心草"}]},{"ID":"20240830163527-hxufwut","Type":"NodeParagraph","Properties":{"id":"20240830163527-hxufwut","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【来源】本品为菊科植物鳢肠EcliptaprostrataL.的干燥地上部分。花开时采割，晒干。"}]},{"ID":"20240830163527-exdrpbg","Type":"NodeParagraph","Properties":{"id":"20240830163527-exdrpbg","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性状】本品全体被白色茸毛。茎呈圆柱形，有纵棱，直径2～5mm；表面绿褐色或墨绿色。叶对生，近无柄，叶片皱缩卷曲或破碎，完整者展平后呈长披针形，全缘或具浅齿，墨绿色。头状花序直径2～6mm。瘦果椭圆形而扁，长2～3mm，棕色或浅褐色。气微，味微咸。"}]},{"ID":"20240830163527-3c49h0y","Type":"NodeParagraph","Properties":{"id":"20240830163527-3c49h0y","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830163527-8mijl8i","Type":"NodeParagraph","Properties":{"id":"20240830163527-8mijl8i","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"（1）取本品，浸水后，搓其茎叶，显墨绿色。"}]},{"ID":"20240830163527-lpszykj","Type":"NodeParagraph","Properties":{"id":"20240830163527-lpszykj","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"（2）本品叶的表面观：非腺毛多为3细胞，长260～700μm,基部细胞稍膨大，中部细胞较长，壁增厚，有明显疣状突起，顶端细胞急尖而短，近三角形。气孔不定式，副卫细胞3～4个。"}]},{"ID":"20240830163527-pc92ndy","Type":"NodeParagraph","Properties":{"id":"20240830163527-pc92ndy","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醇20ml，浸泡2小时，超声处理30分钟，滤过，滤液挥干，残渣加无水乙醇1ml使溶解，作为供试品溶液。另取墨旱莲对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各4μl，分别点于同一硅胶G薄层板上，以正己烷-醋酸乙酯（9：1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同的荧光斑点。"}]},{"ID":"20240830163527-hn7ef8v","Type":"NodeParagraph","Properties":{"id":"20240830163527-hn7ef8v","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，略洗，切段，晒干。"}]},{"ID":"20240830163527-4z5ne1b","Type":"NodeParagraph","Properties":{"id":"20240830163527-4z5ne1b","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性味】甘、酸，寒。"}]},{"ID":"20240830163527-ajx2xdt","Type":"NodeParagraph","Properties":{"id":"20240830163527-ajx2xdt","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【归经】归肾、肝经。"}]},{"ID":"20240830163527-iacsubc","Type":"NodeParagraph","Properties":{"id":"20240830163527-iacsubc","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【功能主治】滋补肝肾，凉血止血。用于牙齿松动，须发早白，眩晕耳鸣，腰膝酸软，阴虚血热、吐血、衄血、尿血，血痢，崩漏下血，外伤出血。"}]},{"ID":"20240830163527-qc5wlta","Type":"NodeParagraph","Properties":{"id":"20240830163527-qc5wlta","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【用法用量】6～12g。外用鲜品适量。"}]},{"ID":"20240830163527-fvxql9h","Type":"NodeParagraph","Properties":{"id":"20240830163527-fvxql9h","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。"}]},{"ID":"20240830163527-lpdmdri","Type":"NodeParagraph","Properties":{"id":"20240830163527-lpdmdri","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【备注】（1）中药旱莲草有墨旱莲与红旱莲之别，红旱莲为金丝桃科金丝桃属植物湖南连翘HypericumascyronL.的全草。"}]},{"ID":"20240830163527-3krnenc","Type":"NodeParagraph","Properties":{"id":"20240830163527-3krnenc","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830163527-o67odk8","Type":"NodeParagraph","Properties":{"id":"20240830163527-o67odk8","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"墨旱莲《*辞典》"}]},{"ID":"20240830163527-0o5mcs9","Type":"NodeParagraph","Properties":{"id":"20240830163527-0o5mcs9","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【出处】《饮片新参》"}]},{"ID":"20240830163527-u45dud1","Type":"NodeParagraph","Properties":{"id":"20240830163527-u45dud1","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【拼音名】MòHànLián"}]},{"ID":"20240830163527-jv4toai","Type":"NodeParagraph","Properties":{"id":"20240830163527-jv4toai","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【别名】金陵草（《千金月令》），莲子草（《唐本草》），旱莲草、旱莲子（《本草图经》），白旱莲（《履巉岩本草》），猢孙头（《居家必用事类全集》），莲草（《滇南本草》），墨斗草（《医学正传》），墨烟草、墨菜、猪牙草（《纲目》），白花草、白花蟛蜞菊（《岭南采药录》），墨记菜（《现代实用中药》），野水凤仙（《药材资料汇编》），摘头乌、滴落乌（《浙江中药手册》），水风仙草（《江苏植药志》），黑墨草（《广西药植图志》），黑头草、古城墨（《广西中药志》），水旱蓬、冰冻草（《湖南药物志》），节节乌、跳鱼草、假日头花仔、"}]},{"ID":"20240830163527-0n3sbvn","Type":"NodeParagraph","Properties":{"id":"20240830163527-0n3sbvn","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【来源】为菊科植物鳢肠的全草。夏、秋季割取全草，除净泥沙，晒干或阴干。"}]},{"ID":"20240830163527-cen6ed0","Type":"NodeParagraph","Properties":{"id":"20240830163527-cen6ed0","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830163527-arxk63q","Type":"NodeParagraph","Properties":{"id":"20240830163527-arxk63q","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"鳢肠（《唐本草》）"}]},{"ID":"20240830163527-9rg8dcq","Type":"NodeParagraph","Properties":{"id":"20240830163527-9rg8dcq","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"一年生草本。茎柔弱，直立或匍匐，高达30～60厘米，被毛。叶对生，近无柄，线状矩圆形至披针形，长4～10厘米，宽0.8～2厘米，基部楔形，先端短尖或钝，全缘或稍具齿，叶两面密被白色租毛。头状花序，腋生或顶生，具花梗；总苞绿色，卵形至阔钟形，苞片少数，2列，被小粗毛；花托扁平，有线状鳞片，托上着生少数舌状花及多数管状花；舌状花雌性，约2列，狭线形，发育或不发育，白色，全缘或为2齿裂，子房椭圆形而扁，管状花两性，全发育；花冠4浅裂，裂片卵形，外被疏毛，雄蕊4，药围绕花柱四周；子房椭圆形而扁，花柱柱状，柱头2裂。瘦果黄黑色，长椭圆形而扁，长约3毫米，顶端秃净。揉搓其茎叶有黑色汁液流出。花期夏季。果期9～10月。"}]},{"ID":"20240830163527-xg8vm5l","Type":"NodeParagraph","Properties":{"id":"20240830163527-xg8vm5l","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于田野、路边、溪边及阴湿地上。分布辽宁、河北、山东、江苏、浙江、安徽、福建、广东、广西、江西、湖南、湖北、四川、贵州、云南等地。主产江苏、江西、浙江、广东等地。"}]},{"ID":"20240830163527-dhquaku","Type":"NodeParagraph","Properties":{"id":"20240830163527-dhquaku","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性状】干燥全草全体被白色茸毛。茎圆柱形，长约30厘米，直径约3毫米：绿褐色或带紫红色，有纵棱。叶片卷曲，皱缩或破碎，绿褐色。茎顶带有头状花序，多已结实，果实很多，呈黑色颗粒状。浸水后搓其茎叶，则呈黑色。气微香，味淡微咸。以色绿、无杂质者为佳。"}]},{"ID":"20240830163527-k8lsrk4","Type":"NodeParagraph","Properties":{"id":"20240830163527-k8lsrk4","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草含皂甙1.32％，烟碱约0.08％，鞣质，维生素A，鳢肠素，多种噻吩化合物如α-三联噻吩基甲醇及其乙酸酯，2-（丁二炔基）-5-（乙烯乙炔基）噻吩，2-（丁-二炔基）-5-（4-氯-3-羟丁炔-1-基）噻吩，2-（4-氯-3-羟丁炔-1-基）-5-（戊二炔-1，3-基）噻吩，乙酸（丁烯-3-炔-1-基）二联噻吩基甲醇酯等。叶含蟚蜞菊内酯、去甲基蟚蜞菊内酯、去甲基蟚蜞菊内酯-7-葡萄糖甙。"}]},{"ID":"20240830163527-c9pjwgt","Type":"NodeParagraph","Properties":{"id":"20240830163527-c9pjwgt","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去残根，洗净闷透，切段晒干。"}]},{"ID":"20240830163527-a3oizl3","Type":"NodeParagraph","Properties":{"id":"20240830163527-a3oizl3","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830163527-gvgcc42","Type":"NodeParagraph","Properties":{"id":"20240830163527-gvgcc42","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"甘酸，凉。"}]},{"ID":"20240830163527-e202h64","Type":"NodeParagraph","Properties":{"id":"20240830163527-e202h64","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味甘酸，平，无毒。\""}]},{"ID":"20240830163527-o7kxrcx","Type":"NodeParagraph","Properties":{"id":"20240830163527-o7kxrcx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性寒，味咸。\""}]},{"ID":"20240830163527-648ws01","Type":"NodeParagraph","Properties":{"id":"20240830163527-648ws01","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830163527-pwpyxuu","Type":"NodeParagraph","Properties":{"id":"20240830163527-pwpyxuu","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"入肝、肾经，"}]},{"ID":"20240830163527-n4fwr4p","Type":"NodeParagraph","Properties":{"id":"20240830163527-n4fwr4p","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"入肾、肝、胃、大小肠。\""}]},{"ID":"20240830163527-2d0fi8o","Type":"NodeParagraph","Properties":{"id":"20240830163527-2d0fi8o","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"入足少阴经血分。\""}]},{"ID":"20240830163527-f3h71d9","Type":"NodeParagraph","Properties":{"id":"20240830163527-f3h71d9","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830163527-aiyms85","Type":"NodeParagraph","Properties":{"id":"20240830163527-aiyms85","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"凉血，止血，补肾，益阴。治吐血，咳血，衄血，尿血，便血，血痢，刀伤出血，须发早白，白喉，淋浊，带下，阴部湿痒。"}]},{"ID":"20240830163527-s6aqqey","Type":"NodeParagraph","Properties":{"id":"20240830163527-s6aqqey","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"主血痢。针灸疮发，洪血不可止者敷之；汁涂发眉，生速而繁。\""}]},{"ID":"20240830163527-e2zid0u","Type":"NodeParagraph","Properties":{"id":"20240830163527-e2zid0u","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"排脓，止血，通小肠，敷一切疮并蚕瘑。\""}]},{"ID":"20240830163527-at3hruh","Type":"NodeParagraph","Properties":{"id":"20240830163527-at3hruh","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"固齿，乌须，洗九种痔疮。\""}]},{"ID":"20240830163527-zmksekw","Type":"NodeParagraph","Properties":{"id":"20240830163527-zmksekw","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"乌须发，益肾阴。\""}]},{"ID":"20240830163527-spd0ez0","Type":"NodeParagraph","Properties":{"id":"20240830163527-spd0ez0","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑤《本草述》：\"疗溺血及肾虚变为劳淋。\""}]},{"ID":"20240830163527-g68t4xy","Type":"NodeParagraph","Properties":{"id":"20240830163527-g68t4xy","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑥《生草药性备要》：\"治跌打伤，理酒顶，化痰，杀螆，止痒，干水。\""}]},{"ID":"20240830163527-1rztwk5","Type":"NodeParagraph","Properties":{"id":"20240830163527-1rztwk5","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑦《分类草药性》：\"止血，补肾，退火，消肿。治淋、崩。\""}]},{"ID":"20240830163527-ieqcds6","Type":"NodeParagraph","Properties":{"id":"20240830163527-ieqcds6","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑧《南宁市药物志》：\"治目疾、翳膜。\""}]},{"ID":"20240830163527-vyk9y5l","Type":"NodeParagraph","Properties":{"id":"20240830163527-vyk9y5l","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.3～1两；熬膏、捣汁或入丸、散。外用：捣敷、研末撒或捣绒塞鼻。"}]},{"ID":"20240830163527-0601j9m","Type":"NodeParagraph","Properties":{"id":"20240830163527-0601j9m","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830163527-z7bjx5m","Type":"NodeParagraph","Properties":{"id":"20240830163527-z7bjx5m","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"脾肾虚寒者忌服。"}]},{"ID":"20240830163527-oxnjnvx","Type":"NodeParagraph","Properties":{"id":"20240830163527-oxnjnvx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"《得配本草》：\"胃弱便溏、肾气虚寒者禁用。\""}]},{"ID":"20240830163527-1p3z40j","Type":"NodeParagraph","Properties":{"id":"20240830163527-1p3z40j","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830163527-1agw19m","Type":"NodeParagraph","Properties":{"id":"20240830163527-1agw19m","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①治吐血成盆：旱莲草和童便、徽墨春汁，藕节汤开服。（《生草药性备要》）"}]},{"ID":"20240830163527-70hfq2e","Type":"NodeParagraph","Properties":{"id":"20240830163527-70hfq2e","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②治吐血：鲜早莲草四两。捣烂冲童便服；或加生柏叶共同用尤效。（《岭南采药录》）"}]},{"ID":"20240830163527-asew5rx","Type":"NodeParagraph","Properties":{"id":"20240830163527-asew5rx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"③治咳嗽咯血：鲜旱莲草二两。捣绞汁，开水冲服。（《江西民间草药验方》）"}]},{"ID":"20240830163527-pbh1nej","Type":"NodeParagraph","Properties":{"id":"20240830163527-pbh1nej","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"④治鼻衄：鲜旱莲草一握。洗净后捣烂绞汁，每次取五酒杯炖热，饭后温服，日服两次。（《福建民间草药》）"}]},{"ID":"20240830163527-9n7tdca","Type":"NodeParagraph","Properties":{"id":"20240830163527-9n7tdca","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑤治小便溺血：车前草叶、金陵草叶。上二味，捣取自然汁一盏，空腹饮之。（《医学正传》）"}]},{"ID":"20240830163527-dcy6zya","Type":"NodeParagraph","Properties":{"id":"20240830163527-dcy6zya","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑥治肠风脏毒，下血不止：旱莲草子，瓦上焙，研末。每服二钱，米饮下。（《家藏经验方》）"}]},{"ID":"20240830163527-lxn6w4p","Type":"NodeParagraph","Properties":{"id":"20240830163527-lxn6w4p","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑦治热痢：旱莲草一两。水煎服。（《湖南药物志》）"}]},{"ID":"20240830163527-up9sl1d","Type":"NodeParagraph","Properties":{"id":"20240830163527-up9sl1d","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑧治刀伤出血：鲜旱莲草捣烂，敷伤处；干者研末，撒伤处。（《湖南药物志》）"}]},{"ID":"20240830163527-42hz8x2","Type":"NodeParagraph","Properties":{"id":"20240830163527-42hz8x2","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑨补腰膝，壮筋骨，强肾阴，乌髭发：冬青子（即女贞实，冬至日采）不拘多少，阴干，蜜、酒拌蒸，过一夜，粗袋擦去皮，晒干为末，瓦瓶收贮，旱莲草（夏至日采）不拘多少，捣汁熬膏，和前药为丸。临卧洒服。（《医方集解》二至丸）"}]},{"ID":"20240830163527-fqc2ppg","Type":"NodeParagraph","Properties":{"id":"20240830163527-fqc2ppg","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑩治正偏头痛：鳢肠汁滴鼻中。（《圣济总录》）"}]},{"ID":"20240830163527-18rqyqe","Type":"NodeParagraph","Properties":{"id":"20240830163527-18rqyqe","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑾治赤白带下：旱莲草一两。同鸡汤或肉汤煎服。（《江西民间草药验方》）"}]},{"ID":"20240830163527-3qxd8x9","Type":"NodeParagraph","Properties":{"id":"20240830163527-3qxd8x9","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⑿治白浊：旱莲草五钱，车前子三钱，银花五钱，土茯苓五钱。水煎服。（《陆川本草》）"}]},{"ID":"20240830163527-90j6wl8","Type":"NodeParagraph","Properties":{"id":"20240830163527-90j6wl8","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⒀治妇女阴道痒：墨斗草四两。煎水服；或另加钩藤根少许，并煎汁，加白矾少许外洗。（《重庆草药》）"}]},{"ID":"20240830163527-dhxsvqr","Type":"NodeParagraph","Properties":{"id":"20240830163527-dhxsvqr","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⒁治肾虚齿疼：旱莲草，焙，为末，搽齿龈上。（《滇南本草》）"}]},{"ID":"20240830163527-wzwzi8z","Type":"NodeParagraph","Properties":{"id":"20240830163527-wzwzi8z","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⒂治血淋：旱莲、芭蕉根（细锉）各二两。上二味，粗捣筛。每服五钱匕。水一盏半，煎至八分，去滓，温服，日二服。（《圣济总录》旱莲子汤）"}]},{"ID":"20240830163527-kx5cp9p","Type":"NodeParagraph","Properties":{"id":"20240830163527-kx5cp9p","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"⒃治白喉：旱莲草二至三两，捣烂，加盐少许，冲开水去渣服。服后吐出涎沫。（《岭南草药志》）"}]},{"ID":"20240830163527-r095xoc","Type":"NodeParagraph","Properties":{"id":"20240830163527-r095xoc","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830163527-10m7o1y","Type":"NodeParagraph","Properties":{"id":"20240830163527-10m7o1y","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"鳢肠善凉血。须发白者，血热也，齿不固者，肾虚有热也；凉血益血，则须发变黑，而齿亦因之而固矣。故古今变白之草，当以兹为胜。《本经》主血痢及针灸疮发、洪血不可止者，敷之立已，涂眉发生速而繁。萧炳又谓能止血排脓，通小肠，敷一切疮者，盖以血痢由于血分为湿热所伤，针灸疮发，洪血不止，亦缘病人素有血热，及加艾火则益炽矣，血凉则不出；营血热壅则生脓，凉血则自散；小肠属丙火，有热则不通，营血热解，则一切疮自愈。之数者，何非凉血益血之功也。\"\"鳢肠性冷，阴寒之质，虽善凉血，不益脾胃。病人虽有血热，一见脾胃虚败，饮食难消，及易溏薄作泄者，勿轻与服。孙真人方用姜汁和剂，盖防其冷而不利于肠胃故也。不用姜汁、椒红相兼修事，服之者必腹痛作泄，宜详审之。\""}]},{"ID":"20240830163527-mzkh09j","Type":"NodeParagraph","Properties":{"id":"20240830163527-mzkh09j","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②《本草正义》：\"鳢肠，入肾补阴而生长毛发，又能入血，为凉血止血之品，又消热病痈肿。但纯阴用事，非阳盛之体，不应多用，脾虚泄泻尤忌。凡劳怯诸症，阴虚火旺者，不可以此等阴药专治其标，须与补中健脾之剂，相辅成功，乃为万全无弊之策。\""}]},{"ID":"20240830163527-igjdmik","Type":"NodeParagraph","Properties":{"id":"20240830163527-igjdmik","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830163527-i7w8qu7","Type":"NodeParagraph","Properties":{"id":"20240830163527-i7w8qu7","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"①治疗白喉"}]},{"ID":"20240830163527-htziy10","Type":"NodeParagraph","Properties":{"id":"20240830163527-htziy10","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"取新鲜旱莲草的根、茎、叶，用凉开水洗净，捣碎绞汁，加等量蜂蜜；儿童每日100毫升，分4次口服。同时根据全身情况，对症处理。如并发支气管肺炎者，加用青、链霉索；并发心肌损害者，应绝对卧床休息，静脉注射高渗葡萄糖溶液、维生素C及激素（或采用能量合剂）；阻塞严重而有窒息症状者，应及时行气管切开等。最初观察轻型白喉92例，治愈84例，死亡8例；继之又观察37例，治愈35例，死亡2例。治愈病例中约近半数于24小时体温降至正常，其余部分于48～72小时降至正常。除18例行气管切开术外，其余多在2～3天内呼气通畅。鼻咽假膜及扁桃体充血一般于3～5天内消失。涂片检查多数在2～6天内转阴。白细胞计数亦随体温下降而转为正常。旱莲草宜新鲜配置，久贮常变质失效。"}]},{"ID":"20240830163527-yus6xyo","Type":"NodeParagraph","Properties":{"id":"20240830163527-yus6xyo","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"②治疗肺结核咯血"}]},{"ID":"20240830163527-rma7b55","Type":"NodeParagraph","Properties":{"id":"20240830163527-rma7b55","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"取旱莲草全草、白茅根茎制成注射液，每毫升含早莲草0.5克，白茅根0.5克。每天肌注2～3次，每次4毫升；对大咯血患者，可用注射液4毫升加入50％葡萄糖20毫升中静注，每天2～3次。用药时间一般为4～5天或稍长些。副作用偶有寒战、高烧，待出汗后即消失，多为制剂不纯所致。"}]},{"ID":"20240830163527-cwxbgir","Type":"NodeParagraph","Properties":{"id":"20240830163527-cwxbgir","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"③治疗痢疾"}]},{"ID":"20240830163527-cy3qdns","Type":"NodeParagraph","Properties":{"id":"20240830163527-cy3qdns","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"取旱莲草4两，糖1两，水煎温服。通常服1剂后开始见效，继服3～4剂多可全愈，无副作用。"}]},{"ID":"20240830163527-rv0k412","Type":"NodeParagraph","Properties":{"id":"20240830163527-rv0k412","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"④防治水田皮炎"}]},{"ID":"20240830163527-iu0im6h","Type":"NodeParagraph","Properties":{"id":"20240830163527-iu0im6h","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"取墨旱莲搓烂涂擦手脚下水部位，擦至皮肤稍发黑色，略干后，即可下水田劳动。每天上工前后各擦1次，可预防手脚糜烂。对已经糜烂的也可使用。据2000余例的试用，有一定效果。"}]},{"ID":"20240830163527-50lvb89","Type":"NodeParagraph","Properties":{"id":"20240830163527-50lvb89","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830163527-1gsb33o","Type":"NodeParagraph","Properties":{"id":"20240830163527-1gsb33o","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"墨旱莲《中华本草》"}]},{"ID":"20240830163527-1psuqqn","Type":"NodeParagraph","Properties":{"id":"20240830163527-1psuqqn","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【出处】出自《饮片新参》"}]},{"ID":"20240830163527-24tbe3d","Type":"NodeParagraph","Properties":{"id":"20240830163527-24tbe3d","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【拼音名】MòHànLián"}]},{"ID":"20240830163527-favqed4","Type":"NodeParagraph","Properties":{"id":"20240830163527-favqed4","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【英文名】YerbadetajoHerb"}]},{"ID":"20240830163527-t7a1xzd","Type":"NodeParagraph","Properties":{"id":"20240830163527-t7a1xzd","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【别名】金陵草、莲子草、旱莲草、旱莲子、白旱莲、猪牙草、旱莲蓬、猢孙头、莲草、墨斗草、墨烟草、墨菜、白花草、白花蟛蜞菊、墨记菜、野水凤仙、黑墨草、黑头草、古城墨、水旱莲、冰冻草、墨汁草、节节乌、白田乌草、墨草、摘落乌、水葵花"}]},{"ID":"20240830163527-xgwq3zr","Type":"NodeParagraph","Properties":{"id":"20240830163527-xgwq3zr","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830163527-tqw2gjx","Type":"NodeParagraph","Properties":{"id":"20240830163527-tqw2gjx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"药材基源：菊科植物鳢肠的全草。"}]},{"ID":"20240830163527-jo9gb5g","Type":"NodeParagraph","Properties":{"id":"20240830163527-jo9gb5g","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：EcliptaprosTCMLIBata(L.)L.[Verbesinapros-TCMLIBataL.;Ecliptaalba(L.)Haask.]"}]},{"ID":"20240830163527-xd4ic20","Type":"NodeParagraph","Properties":{"id":"20240830163527-xd4ic20","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季割取全草，洗净泥上，去除杂质，阴干或晒干。鲜用或随采随用。"}]},{"ID":"20240830163527-mv6zoln","Type":"NodeParagraph","Properties":{"id":"20240830163527-mv6zoln","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【原形态】鳢肠一年生草本，高10-60cm。全株被白色粗毛，折断后流出的澎液数分钟后即呈蓝黑色。茎直立或基部倾伏，着地生根，绿色或红褐色。叶对生；叶片线状椭圆形至披针形，长3-10cm，宽0.5-2.5cm，全缘或稍有细齿，两面均被白色粗毛。头状花序腋生或顶生，总苞钟状，总苞片5-6片，花托扁平，托上着生少数舌状花及多数管状花；舌状花雌性；花冠白色，发育或不发育；管状花两性，共绿色，全发育。瘦果黄黑色，长约3mm，无冠毛。花期7-9月，果期9-10月。"}]},{"ID":"20240830163527-4rwx82o","Type":"NodeParagraph","Properties":{"id":"20240830163527-4rwx82o","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830163527-hg46f17","Type":"NodeParagraph","Properties":{"id":"20240830163527-hg46f17","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"生态环境：生于路边、湿地、沟边或田间。"}]},{"ID":"20240830163527-j2qvd3t","Type":"NodeParagraph","Properties":{"id":"20240830163527-j2qvd3t","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地。"}]},{"ID":"20240830163527-nhmbdt2","Type":"NodeParagraph","Properties":{"id":"20240830163527-nhmbdt2","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830163527-pw0chko","Type":"NodeParagraph","Properties":{"id":"20240830163527-pw0chko","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"生物学特性喜湿润气候，耐阴湿。以潮湿、疏松肥沃，富含腐殖质的砂质坟土或壤土栽培为宜。"}]},{"ID":"20240830163527-agjk090","Type":"NodeParagraph","Properties":{"id":"20240830163527-agjk090","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。春季4月按行距30cm，开条沟、深2-3，将种子均匀播入，薄覆细土，以不见种子为度，稍加镇压，浇水。约经15d左右出苗。"}]},{"ID":"20240830163527-hqredle","Type":"NodeParagraph","Properties":{"id":"20240830163527-hqredle","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"田间管理苗高3-5cm间苗，按株距8-10cm定苗。应注意松土除草，勤浇水，保持土壤湿润。追施稀人粪尿。5-6月再施1次人畜粪肥，生长旺盛期增施过磷酸钙。"}]},{"ID":"20240830163527-xhwclpt","Type":"NodeParagraph","Properties":{"id":"20240830163527-xhwclpt","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830163527-6k20be5","Type":"NodeParagraph","Properties":{"id":"20240830163527-6k20be5","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"性状鉴别带根或不带根全草，全体被白色粗毛。根须状，长5-10cm。茎圆柱形，多分枝，直径2-7mm，表面灰绿色或稍带紫，有纵棱，质脆，易折断，断面黄白色，中央为白色疏松的髓部，有时中空。叶对生，多卷缩或破碎，墨绿色，完整叶片展平后呈披针形，长3-10cm，宽0.5-2.5cm。全缘或稍有细锯齿，近无柄。头状花序单生于枝端，直径6-11mm，总花梗细长，总苞片5-6，黄绿色或棕褐色，花冠多脱落。瘦果扁椭圆形，棕色，表面有小瘤状突起。气微香，味淡、微咸涩。"}]},{"ID":"20240830163527-qt4mquh","Type":"NodeParagraph","Properties":{"id":"20240830163527-qt4mquh","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"以色黑绿、叶多者为佳。"}]},{"ID":"20240830163527-opi6529","Type":"NodeParagraph","Properties":{"id":"20240830163527-opi6529","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面：表皮细胞1列，下有厚角细胞2-4列，皮层薄壁细胞排列疏松，细胞间隙大。维和束外韧型，环列，形成层断续成环，贿部大。"}]},{"ID":"20240830163527-m21uhqk","Type":"NodeParagraph","Properties":{"id":"20240830163527-m21uhqk","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"叶片表面观：上下表皮细胞壁波状弯曲；气孔不定式，副卫细胞3-4个；非腺毛3细胞，长274-800μm，基部细胞稍膨大，中部细胞较长，顶端细胞短而尖，壁稍厚，具疣关突起；腺毛棒状，4-6细胞，长75-113μm，壁薄，内含黄棕色分泌物。"}]},{"ID":"20240830163527-qdojeg4","Type":"NodeParagraph","Properties":{"id":"20240830163527-qdojeg4","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830163527-bb1itx5","Type":"NodeParagraph","Properties":{"id":"20240830163527-bb1itx5","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"1.全草含皂甙1.32%，烟碱约0.08%，鞣质，维生素A，鳢肠素(Ecliptine)，多种噻吩化合物如a-三联噻吩基甲醇(a-Terthienylmethanol)及其乙酸酯，2-(丁二炔基)-5-(乙烯乙炔基)噻吩[2-Buta-1，3-diynyl]-5-(but-3-en-l-ynyl)thiophene]，2-(丁二炔基)-5-(4-氯-3-羟丁炔-1-基)噻吩[2-(Buta-1，3-diynyl)-5-(4-chloro-3-hydroxybut-1-ynyl)thiophene]，2-(4-氯-3-羟丁炔-1-基)-5-(戊二炔-1，3-基)噻吩，乙酸(丁烯-3-炔-1-基)二联噻吩基甲醇酯［5-(3-Buten-1-ynyl)-2，2'-bithiennyl-5'-methylacetate］等。"}]},{"ID":"20240830163527-8bziis9","Type":"NodeParagraph","Properties":{"id":"20240830163527-8bziis9","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"叶含蟛蜞菊内酯(Wedelolac-tone)、去甲基蟛蜞菊内酯。去甲基蟛蜞菊内酯-7-葡萄糖甙。含菸碱(nicotine)约0.08%，另含三噻嗯甲醇(α－terthienylmethanol)、三噻嗯甲醛(α－formyl－α－terthienel)；此外，尚含皂甙约1.3%，鞣质、苦味质及异黄酮甙类。"}]},{"ID":"20240830163527-fhqgwja","Type":"NodeParagraph","Properties":{"id":"20240830163527-fhqgwja","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"叶含膨蜞菊内酯(wedelolactone),去甲蟛蜞菊内酯(demethylwedelolactone)及去甲蟛蜞菊内酯葡萄糖甙(demethylwedelolactoneglucoside)。"}]},{"ID":"20240830163527-20355vp","Type":"NodeParagraph","Properties":{"id":"20240830163527-20355vp","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"地上部分石油醚提取部分含豆甾醇、植物甾醇A(phytos-terolA)及β－香树脂(β－amyrin)；乙醇提取物中尚含木犀草素－7－O－葡萄糖甙(luteolin-7-O-glucoside),植物甾醇A葡萄糖甙和一种三萜酸葡萄糖甙。"}]},{"ID":"20240830163527-ajnsi3j","Type":"NodeParagraph","Properties":{"id":"20240830163527-ajnsi3j","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830163527-fw4lr91","Type":"NodeParagraph","Properties":{"id":"20240830163527-fw4lr91","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"1.止血作用：将狗的股动脉半切断，用墨旱莲叶粉敷出血处，并稍加压迫，有良好的止血效果。水提物亦有显着止血作用。"}]},{"ID":"20240830163527-l7wm3x1","Type":"NodeParagraph","Properties":{"id":"20240830163527-l7wm3x1","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的作用：应用豚鼠离体心脏观察到旱莲草有增加冠脉流量作用，并使心电图T波改变得到改善。亦有试验表明，小白鼠在常压缺氧情况下注射旱莲草能明显延长生命，在减压缺氧耐力的情况下，同样可提高小鼠的存活率：给药组的存活率为76.5%，对照组为23.5%，P\u003c0.05；两组差异显着。作用快，维持时间长，且毒性小，po给药LD50为163.4±21.4g/kg，安全系数为700-750倍。"}]},{"ID":"20240830163527-56zb7ie","Type":"NodeParagraph","Properties":{"id":"20240830163527-56zb7ie","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"3.对中枢神经系统的作用：旱莲草对小白鼠的镇静及镇痛作用非常显着，总黄酮作用不如总成分。"}]},{"ID":"20240830163527-vese9lo","Type":"NodeParagraph","Properties":{"id":"20240830163527-vese9lo","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"4.配剂具有抗菌作用。"}]},{"ID":"20240830163527-ue8gy93","Type":"NodeParagraph","Properties":{"id":"20240830163527-ue8gy93","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粉末约0.1g，加50%乙醇3ml，水浴温浸10min，滤过。取滤液1ml，加0.2%茚三酮试剂，水浴加热片刻，溶液显红紫色。（检查氨基酸）2.取本品粉末约0.5g，加乙醇10ml，水浴温浸15min，滤过。滤液蒸干，加醋酐硫酸1滴，显蓝色，放置后显绿色。（检查皂甙）"}]},{"ID":"20240830163527-25shlol","Type":"NodeParagraph","Properties":{"id":"20240830163527-25shlol","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去残根，洗净闷透，切段晒千。"}]},{"ID":"20240830163527-smkhzyl","Type":"NodeParagraph","Properties":{"id":"20240830163527-smkhzyl","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；酸；性凉"}]},{"ID":"20240830163527-q79i6tt","Type":"NodeParagraph","Properties":{"id":"20240830163527-q79i6tt","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【归经】归肝；肾经"}]},{"ID":"20240830163527-yyjfcmv","Type":"NodeParagraph","Properties":{"id":"20240830163527-yyjfcmv","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【功能主治】补益肝肾；凉血止血。主肝肾不足；头晕目眩；须发早白；吐血；咯血；衄血；便血；血痢；崩；漏；外伤出血"}]},{"ID":"20240830163527-omouh1e","Type":"NodeParagraph","Properties":{"id":"20240830163527-omouh1e","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-30g；或熬膏；或捣汁；或入丸、散。外用：适量，捣敷；或捣绒塞鼻；或研末敷。"}]},{"ID":"20240830163527-v33yyl3","Type":"NodeParagraph","Properties":{"id":"20240830163527-v33yyl3","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【注意】脾肾虚寒者忌服。《得配本草》：胃弱便溏。肾气虚寒者禁用。"}]},{"ID":"20240830163527-z3bhvja","Type":"NodeParagraph","Properties":{"id":"20240830163527-z3bhvja","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【附方】①治吐血成盆：旱莲草和童便、徽墨春汁，藕节汤开服。(《生草药性备要》)②治吐血：鲜旱莲草四两。捣烂冲童便服；或加生柏叶共同用尤效。(《岭南采药录》)③洽咳嗽咯血：鲜旱莲草二两。捣绞汁，开水冲服。(《江西民间草药验方》)④治鼻衄：鲜旱莲草一握，洗净后捣烂绞汁。何次取五酒杯炖热，饭后温服，日服两次。(《福建民间草药》)⑤治小便溺血：车前草叶、金陵草叶。上二味，捣取自然汁一盏，空腹饮之。《医学正传》)⑥治肠风脏毒，下血不止：旱莲草子，瓦上焙，研末。每二钱，米饮下。(《家藏经验方》)⑦治热痢：旱莲草一两。水煎服。(《湖南药物志》)⑧治刀伤出血：鲜旱莲草捣烂，敷伤处；干者研末，撒伤处。(《湖南药物志》)⑨补腰膝，壮筋骨，强肾阴，乌髭发：冬青子(即女贞实，冬至日采)不拘多少，阴干，蜜、酒拦蒸，过一夜，粗袋擦去皮，晒干为未，瓦瓶收贮，旱莲草(夏至日采)不拘多少，捣汁熬膏，和前药为丸。临卧酒服。(《医方集解》二至丸)⑩治正偏头痛：鳢肠汁滴鼻中。(《圣济总录》)11.治赤白带下：旱莲单一两。同鸡汤或肉汤煎服。(《江西民间单药验方》)12.治白浊：旱莲草五钱，车前子三钱，银花五钱，土茯苓五钱。水煎服。(《陆川本草单》)13.治妇女阴道痒：墨斗草四两。煎水服；或另加钩作恨少许，井煎汁，加白矾少许外洗。(《重庆草药》)14.治肾虚齿疼：旱莲草，焙，为未，搽齿龈上。(《滇南本草》)。15.治血淋：旱莲、芭蕉根(细挫)各二两。上二味，粗捣筛。每服五钱匕，水一盏半，煎至八分，去滓，温服，日二服(怪济总录》旱莲子汤)16.治白喉：旱莲草二至三两。捣烂，加盐少许，冲开水去渣服。服后吐出涎沫。(《岭南草药志》)"}]},{"ID":"20240830163527-xufvq4x","Type":"NodeParagraph","Properties":{"id":"20240830163527-xufvq4x","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830163527-o6q6ubx","Type":"NodeParagraph","Properties":{"id":"20240830163527-o6q6ubx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：主血痢。针灸疮发，洪血不可止者敷之；汁涂发眉，生速而繁。"}]},{"ID":"20240830163527-5fkp8ye","Type":"NodeParagraph","Properties":{"id":"20240830163527-5fkp8ye","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：排脓，止血，通小肠，敷一切疮。"}]},{"ID":"20240830163527-1k2kc0l","Type":"NodeParagraph","Properties":{"id":"20240830163527-1k2kc0l","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"3.《滇南本草》：固齿，鸟须，洗九种痔疮。"}]},{"ID":"20240830163527-28e5yxo","Type":"NodeParagraph","Properties":{"id":"20240830163527-28e5yxo","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：乌须发，益肾阴。"}]},{"ID":"20240830163527-9nc7k35","Type":"NodeParagraph","Properties":{"id":"20240830163527-9nc7k35","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"5.《本草述》：疗溺血及肾虚变为劳淋。"}]},{"ID":"20240830163527-9dtmc6z","Type":"NodeParagraph","Properties":{"id":"20240830163527-9dtmc6z","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"6.《生草药性备要》：治跌打伤，理酒顶，化痰，止痒，消水。"}]},{"ID":"20240830163527-7lli07d","Type":"NodeParagraph","Properties":{"id":"20240830163527-7lli07d","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"7.《分类草药性》：止血，补肾，退火，消肿。治淋、崩。"}]},{"ID":"20240830163527-webpr32","Type":"NodeParagraph","Properties":{"id":"20240830163527-webpr32","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"8.《南宁市药物志》：治目疾、翳膜。"}]},{"ID":"20240830163527-8yh3epl","Type":"NodeParagraph","Properties":{"id":"20240830163527-8yh3epl","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830163527-wfzuk8p","Type":"NodeParagraph","Properties":{"id":"20240830163527-wfzuk8p","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"1.治疗白喉：取新鲜旱莲草的根、茎、叶，用凉开水洗净，捣碎绞汁，加等量蜂蜜；儿童每日100ml分4次口服。同时根据全身情况，对症处理。如并发支气管肺炎者，加用青、链霉素；并发心肌损害者，应绝对卧床休息，静脉注射高渗葡萄枪溶液、维生素C及激素（或采用能量合剂）；阻塞严重而有窒息症状者，应及时行气管切开等最初观察轻型白喉92例，治愈84例，死亡8例；继之又观察37例，治愈35例，死亡2例。治愈病例中约近半数于24小时体温降至正常，其余部分于48-72小时降至正常。除18例行气营切开术外，其余多在2-3天内呼气通畅，鼻咽假膜及扁桃体充血一般于3-5天内消失，涂片检查多数在2-6天内转阴。白细胞计数亦随体温下降而转为正常。旱莲草宜新鲜配置，久贮常变质失效。"}]},{"ID":"20240830163527-8lslosx","Type":"NodeParagraph","Properties":{"id":"20240830163527-8lslosx","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"2.治疗肺结核：咯血取旱莲草全草、白茅根茎制成注射液，每ml含旱莲草0.5g，白茅根0.5g。每天肌注2-3次，每次4ml；对大咯血患者，可用注射液4ml加入50%葡萄糖20ml中静注，每天2-3次，用药时间一，般为4-5天或稍长些。副作用偶有寒战、高烧，待出汗后即消失，多为制剂不纯所致。"}]},{"ID":"20240830163527-405u9fq","Type":"NodeParagraph","Properties":{"id":"20240830163527-405u9fq","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"3.治疗痢疾：取旱莲草4两，糖1两，水煎温服，通常服1剂后开始见效，继服3-4剂多可全愈，无副作用。④防治水田皮炎取墨旱莲搓烂涂擦手脚下水部位，擦至皮肤稍发黑色，略干后，即可下水田劳动。每天上工前后各擦1次，可预防手脚糜烂。对已经糜烂的也可使用。"}]},{"ID":"20240830163527-gcpo9r0","Type":"NodeParagraph","Properties":{"id":"20240830163527-gcpo9r0","updated":"20240830163604"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830163528-4qbdfh6","Type":"NodeThematicBreak","Properties":{"id":"20240830163528-4qbdfh6","updated":"20240830163604"}},{"ID":"20240830163529-2el5v12","Type":"NodeParagraph","Properties":{"id":"20240830163529-2el5v12","updated":"20240830163604"}}]}