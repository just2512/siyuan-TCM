{"ID":"20240205165629-bxh1k4n","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240205165629-bxh1k4n","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165629-bxh1k4n\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240205165858-gmrtdng\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240619172859-otjpt9m\u0026quot;,\u0026quot;scrollTop\u0026quot;:600,\u0026quot;focusId\u0026quot;:\u0026quot;20240619172859-otjpt9m\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"墨旱莲（旱莲草、鳢肠）","type":"doc","updated":"20240830163535"},"Children":[{"ID":"20240205165858-gmrtdng","Type":"NodeParagraph","Properties":{"id":"20240205165858-gmrtdng","updated":"20240619172856"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲-20240205165858-jfmqzon.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710193402-1cgx7y6","Type":"NodeParagraph","Properties":{"id":"20240710193402-1cgx7y6","updated":"20240710193402"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 433px;","style":"width: 423px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"墨旱莲 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/墨旱莲 3-20240710193402-a6yf42m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 423px;\" parent-style=\"width: 433px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710193259-9jt9vd2","Type":"NodeParagraph","Properties":{"id":"20240710193259-9jt9vd2","updated":"20240710193331"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 