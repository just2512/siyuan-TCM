"id":"20240731105758-a46jakd","updated":"20240731133025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（多花）黄精、玉竹对比（较多说法）"}]},{"ID":"20240731110544-pm6k6ej","Type":"NodeParagraph","Properties":{"id":"20240731110544-pm6k6ej","updated":"20240731110544"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240731110544-untbt5s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240731110914-8soma6z","Type":"NodeParagraph","Properties":{"id":"20240731110914-8soma6z","updated":"20240731110918"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（玉竹叶子与梗成近四十五度角，黄精九十度。）"}]},{"ID":"20240731132541-m8wiqkm","Type":"NodeParagraph","Properties":{"id":"20240731132541-m8wiqkm","updated":"20240731132541"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄精玉竹对比 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄精玉竹对比 2-20240731132454-g8l3t3m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731132541-l48hxae","Type":"NodeParagraph","Properties":{"id":"20240731132541-l48hxae","updated":"20240731132541"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（玉竹叶片偏宽圆，黄精叶片偏窄尖；1为玉竹，2位黄精）"}]},{"ID":"20240731113536-z4tod54","Type":"NodeParagraph","Properties":{"id":"20240731113536-z4tod54","updated":"20240731113536"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240731113521-yku1wjz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731113539-etsfl6z","Type":"NodeParagraph","Properties":{"id":"20240731113539-etsfl6z","updated":"20240731113548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（玉竹花少，黄精花多）"}]},{"ID":"20240731113619-fnprrkm","Type":"NodeParagraph","Properties":{"id":"20240731113619-fnprrkm","updated":"20240731114306"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240731114301-w5paoq3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731113621-ij6t3vv","Type":"NodeParagraph","Properties":{"id":"20240731113621-ij6t3vv","updated":"20240731133108"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（玉竹像竹瘦长，黄精像姜圆大；玉竹较白，黄精较黄；）"}]},{"ID":"20240731105941-w648qde","Type":"NodeParagraph","Properties":{"id":"20240731105941-w648qde","updated":"20240731132617"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"其他辨别方法：黄精花腋生花梗较短，玉竹花梗较长；黄精茎直立生长比较粗，玉竹茎细小偏硬；黄精叶子狭长而尖，玉竹叶子较宽而圆；黄精较高，能长到2-3米，玉竹较矮，能长到60-70cm；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240731114022-xub7dn4","Type":"NodeParagraph","Properties":{"id":"20240731114022-xub7dn4","updated":"20240731114022"}},{"ID":"20240731105214-zw5oyma","Type":"NodeParagraph","Properties":{"id":"20240731105214-zw5oyma","updated":"20240731124651"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：多花黄精跟玉竹相似，注意甄别；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205165622-azgxsiu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"029女萎（玉竹、葳蕤、萎蕤）"}]},{"ID":"20240731133125-01usxht","Type":"NodeParagraph","Properties":{"id":"20240731133125-01usxht","updated":"20240731133137"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：黄精跟玉竹一样，根部都是一年长一节；"}]},{"ID":"20240221193336-1i4ywvs","Type":"NodeThematicBreak","Properties":{"id":"20240221193336-1i4ywvs"}},{"ID":"20240903094737-fos86rf","Type":"NodeParagraph","Properties":{"id":"20240903094737-fos86rf","updated":"20240903094745"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：黄精"}]},{"ID":"20240903094737-9e1qakd","Type":"NodeParagraph","Properties":{"id":"20240903094737-9e1qakd","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精《中国药典》"}]},{"ID":"20240903094737-wqxobrj","Type":"NodeParagraph","Properties":{"id":"20240903094737-wqxobrj","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuánɡJīnɡ"}]},{"ID":"20240903094737-vbv5oi4","Type":"NodeParagraph","Properties":{"id":"20240903094737-vbv5oi4","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【别名】老虎姜"}]},{"ID":"20240903094737-l05tgq3","Type":"NodeParagraph","Properties":{"id":"20240903094737-l05tgq3","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【来源】本品为百合科植物滇黄精PolygonatumkingianumColl.etHemsl.、黄精PolygonatumsibiricumRed.或多花黄精PolygonatumcyrtonemaHua的干燥根茎。按形状不同，习称“大黄精”、“鸡头黄精”“姜形黄精”。春、秋二季采挖，除去须根，洗净，置沸水中略烫或蒸至透心，干燥。"}]},{"ID":"20240903094737-fybnh4f","Type":"NodeParagraph","Properties":{"id":"20240903094737-fybnh4f","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903094737-m43iwh3","Type":"NodeParagraph","Properties":{"id":"20240903094737-m43iwh3","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"大黄精：呈肥厚肉质的结节块状，结节长可达10cm以上，宽3～6cm，厚2～3cm。表面淡黄色至黄棕色，具环节，有皱纹及须根痕，结节上侧茎痕呈圆盘状，圆周凹入，中部突出。质硬而韧，不易折断，断面角质，淡黄色至黄棕色。气微，味甜，嚼之有黏性。"}]},{"ID":"20240903094737-37v6bpw","Type":"NodeParagraph","Properties":{"id":"20240903094737-37v6bpw","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"鸡头黄精：呈结节状弯柱形，长3～10cm,直径0.5～1.5cm。结节长2～4cm，略呈圆锥形，常有分枝；表面黄白色或灰黄色，半透明，有纵皱纹，茎痕圆形，直径5～8mm。"}]},{"ID":"20240903094737-h3cytl4","Type":"NodeParagraph","Properties":{"id":"20240903094737-h3cytl4","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"姜形黄精：呈长条结节块状，长短不等，常数个块状结节相连。表面灰黄色或黄褐色，粗糙，结节上侧有突出的圆盘状茎痕，直径0.8～1.5cm。"}]},{"ID":"20240903094737-vcyyohd","Type":"NodeParagraph","Properties":{"id":"20240903094737-vcyyohd","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"味苦者不可药用。"}]},{"ID":"20240903094737-p431dpi","Type":"NodeParagraph","Properties":{"id":"20240903094737-p431dpi","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240903094737-nr1emw1","Type":"NodeParagraph","Properties":{"id":"20240903094737-nr1emw1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"本品横切面：大黄精表皮细胞外壁较厚。薄壁组织间散有多数大的黏液细胞，内含草酸钙针晶束。维管束散列，大多为周木型。"}]},{"ID":"20240903094737-0bh4czc","Type":"NodeParagraph","Properties":{"id":"20240903094737-0bh4czc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"鸡头黄精、姜形黄精维管束多为外韧型。"}]},{"ID":"20240903094737-bh1edn3","Type":"NodeParagraph","Properties":{"id":"20240903094737-bh1edn3","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903094737-q3qrl7r","Type":"NodeParagraph","Properties":{"id":"20240903094737-q3qrl7r","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精：除去杂质，洗净，略润，切厚片，干燥。"}]},{"ID":"20240903094737-y7lsax7","Type":"NodeParagraph","Properties":{"id":"20240903094737-y7lsax7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"酒黄精：取净黄精，照酒炖法或酒蒸法（附录ⅡD）炖透或蒸透，稍晾，切厚片，干燥。每100kg黄精，用黄酒20kg。"}]},{"ID":"20240903094737-taiqrl7","Type":"NodeParagraph","Properties":{"id":"20240903094737-taiqrl7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性味】甘，平。"}]},{"ID":"20240903094737-n1ybcqc","Type":"NodeParagraph","Properties":{"id":"20240903094737-n1ybcqc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、肺、肾经。"}]},{"ID":"20240903094737-y2mhxxz","Type":"NodeParagraph","Properties":{"id":"20240903094737-y2mhxxz","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【功能主治】补气养阴，健脾，润肺，益肾。用于脾胃虚弱，体倦乏力，口干食少，肺虚燥咳，精血不足，内热消渴。"}]},{"ID":"20240903094737-zbaacdp","Type":"NodeParagraph","Properties":{"id":"20240903094737-zbaacdp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240903094737-3ea38y5","Type":"NodeParagraph","Properties":{"id":"20240903094737-3ea38y5","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防霉，防蛀。"}]},{"ID":"20240903094737-fjsxjy9","Type":"NodeParagraph","Properties":{"id":"20240903094737-fjsxjy9","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903094737-up0d1fb","Type":"NodeParagraph","Properties":{"id":"20240903094737-up0d1fb","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精《*辞典》"}]},{"ID":"20240903094737-vu48ux5","Type":"NodeParagraph","Properties":{"id":"20240903094737-vu48ux5","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【出处】《雷公炮炙论》"}]},{"ID":"20240903094737-wjja1q1","Type":"NodeParagraph","Properties":{"id":"20240903094737-wjja1q1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuánɡJīnɡ"}]},{"ID":"20240903094737-4gpzz8u","Type":"NodeParagraph","Properties":{"id":"20240903094737-4gpzz8u","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【别名】龙衔（《广雅》），太阳草（张华《博物志》），白及、兔竹、垂珠、鸡格（《抱朴子》），鹿竹、重楼（《别录》），萎蕤、苟格、马箭、笔菜（《本草图经》），黄芝（《灵芝瑞草经》），笔管菜（《救荒本草》），生姜（《滇南本草》），野生姜（《本草蒙筌》），野仙姜（《广西通志》），山生姜（《本草备要》），玉竹黄精、白芨黄精（《本草从新》），阳雀蕻（《辰溪志》），土灵芝、老虎姜（《草木便方》），山捣臼（《岭南采药录》），鸡头参（《山西中药志》），黄鸡菜（《中药志》），山姜（《湖南农村常用中草药手册》）。"}]},{"ID":"20240903094737-trrbe7f","Type":"NodeParagraph","Properties":{"id":"20240903094737-trrbe7f","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【来源】为百合科植物黄精、囊丝黄精、热河黄精、滇黄精、卷叶黄精等的根茎。春、秋采收，以秋采者质佳。挖取根茎，除去地上部分及须根，洗去泥土，置蒸笼内蒸至呈现油润时，取出晒干或烘干。或置水中煮沸后，捞出晒干或烘干。"}]},{"ID":"20240903094737-xl8liad","Type":"NodeParagraph","Properties":{"id":"20240903094737-xl8liad","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903094737-t1t8d0q","Type":"NodeParagraph","Properties":{"id":"20240903094737-t1t8d0q","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①黄精"}]},{"ID":"20240903094737-x4hfm8g","Type":"NodeParagraph","Properties":{"id":"20240903094737-x4hfm8g","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"多年生草本。根茎横走，肥大肉质，黄白色，略呈扁圆柱形。有数个茎痕，茎痕处较粗大，最粗处直径可达2.5厘米，生少数须根。茎直立，圆柱形，单一，高50～80厘米，光滑无毛。叶无柄；通常4～5枚轮生；叶片线状披针形至线形，长7～11厘米，宽5～12毫米，先端渐尖并卷曲，上面绿色，下面淡绿色。花腋生，下垂，花梗长1.5～2厘米，先端2歧，着生花2朵；苞片小，远较花梗短；花被筒状，长8～13毫米，白色，先端6齿裂，带绿白色；雄蕊6，着生于花被管的中部，花丝光滑；雌蕊1，与雄蕊等长，子房上位，柱头上有白色毛。浆果球形，直径7～10毫米，成熟时黑色。花期5～6月。果期6～7月。"}]},{"ID":"20240903094737-nk9so76","Type":"NodeParagraph","Properties":{"id":"20240903094737-nk9so76","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"生于荒山坡及山地杂木林或灌木丛的边缘。分布黑龙江、吉林、辽宁、河北、山东、江苏、河南、山西、陕西、内蒙古等地。"}]},{"ID":"20240903094737-41d51pd","Type":"NodeParagraph","Properties":{"id":"20240903094737-41d51pd","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②囊丝黄精"}]},{"ID":"20240903094737-mne69ri","Type":"NodeParagraph","Properties":{"id":"20240903094737-mne69ri","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"多年生草本。根茎横生，肥大肉质，近圆柱形，节处较膨大，直径钓1.5厘米。茎圆柱形，高40～80厘米，光滑无毛，有时散生锈褐色斑点。叶无柄，互生；叶片革质，椭圆形，有时为长圆状或卵状椭圆形，长8～14厘米，宽3～6厘米，先端钝尖，两面均光滑无毛，叶脉5～7条。花腋生，总花梗下垂，长约2厘米，通常着花3～5朵或更多，略呈伞形；小花梗长约1厘米；花被绿白色，筒状，长约2厘米，先端6齿裂；雄蕊6，花丝上有柔毛或小乳突；雌蕊1，与雄蕊等长。浆果球形，成熟时暗紫色，直径1～1.5厘米。种子圆球形。花期4～5月。果期6～9月。"}]},{"ID":"20240903094737-c137nga","Type":"NodeParagraph","Properties":{"id":"20240903094737-c137nga","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"生山地。分布山东、江苏、安徽、浙江、湖北、江西、湖南、广东、广西、河南等地。"}]},{"ID":"20240903094737-otyveh4","Type":"NodeParagraph","Properties":{"id":"20240903094737-otyveh4","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③热河黄精，又名：多花玉竹。"}]},{"ID":"20240903094737-ylhppv1","Type":"NodeParagraph","Properties":{"id":"20240903094737-ylhppv1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～70厘米。根茎横生，圆柱形，有节。茎直立，单一。叶互生，生于茎中部以上的无柄或有极短的柄；叶片广椭圆形或长卵形，长3～8厘米，宽1～3厘米，先端钝，基部圆形，全缘，下面具灰粉状物。花腋生，总花梗长3～6厘米，着生4～10花，成聚伞花序。花被筒状，乳白色，先端6裂，裂片钝三角形；雄蕊6，着生在花被筒的中央；子房卵圆形，具细长白色花柱。浆果球形，熟时黑色。花期5月。果期6～7月。"}]},{"ID":"20240903094737-i6vgqq7","Type":"NodeParagraph","Properties":{"id":"20240903094737-i6vgqq7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"生于林下、山坡草地。分布东北及河北、山东等地。"}]},{"ID":"20240903094737-ooew845","Type":"NodeParagraph","Properties":{"id":"20240903094737-ooew845","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"④滇黄精"}]},{"ID":"20240903094737-edhk3dw","Type":"NodeParagraph","Properties":{"id":"20240903094737-edhk3dw","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"多年生草本，高可达1米。根茎横生，有节。茎直立，单一。叶4～6片轮生，线形，长8～13厘米，宽1.5～2厘米，先端渐尖而卷曲，基部渐狭；无柄。花1～3朵腋生；花被筒状，淡绿色，6裂。浆果球形，熟时橙红色。花期4～5月。"}]},{"ID":"20240903094737-l6wsst1","Type":"NodeParagraph","Properties":{"id":"20240903094737-l6wsst1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"多生于阴湿的山坡林下或灌木丛中。分布云南等地。"}]},{"ID":"20240903094737-gggluag","Type":"NodeParagraph","Properties":{"id":"20240903094737-gggluag","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑤卷叶黄精，参见\"老虎姜\"条。"}]},{"ID":"20240903094737-wimluxm","Type":"NodeParagraph","Properties":{"id":"20240903094737-wimluxm","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"同属植物玫瑰红黄精（新疆）、甘肃黄精（西北，以上两种参见\"羊角参\"条）、弯花柱黄精（宁夏）、红果黄精（青海、甘肃）、长梗黄精（浙江、福建）、深山黄精（浙江、江西）等在少数地区亦作黄精使用。"}]},{"ID":"20240903094737-egtcje5","Type":"NodeParagraph","Properties":{"id":"20240903094737-egtcje5","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产贵州、湖南、浙江、广西、河北、内蒙古、辽宁、山西。"}]},{"ID":"20240903094737-yr2e1pa","Type":"NodeParagraph","Properties":{"id":"20240903094737-yr2e1pa","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性状】干燥根茎，呈不规则的圆锥状，形似鸡头（习称\"鸡头黄精\"），或呈结节块状似姜形（习称\"姜形黄精\"）。分枝少而短粗，长3～10厘米，直径1～3厘米。表面黄白色至黄棕色，半透明，全体有细皱纹及稍隆起呈波状的环节，地上茎痕呈圆盘状，中心常凹陷，根痕多呈点状突起，分布全体或多集生于膨大部分。干燥者质硬，易折断，未完全干燥者质柔韧；断面淡棕色，呈半透明角质样或蜡质状，并有多数黄白色小点。无臭，味微甜而有粘性。以块大、色黄、断面透明、质润泽、习称\"冰糖渣\"者为佳。"}]},{"ID":"20240903094737-4e01spf","Type":"NodeParagraph","Properties":{"id":"20240903094737-4e01spf","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240903094737-3mm13ek","Type":"NodeParagraph","Properties":{"id":"20240903094737-3mm13ek","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精的根茎含粘液质、淀粉及糖分。"}]},{"ID":"20240903094737-wpu5xha","Type":"NodeParagraph","Properties":{"id":"20240903094737-wpu5xha","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"囊丝黄精的根茎含吖丁啶羧酸、天门冬氨酸、高丝氨酸、二氨基丁酸、毛地黄糖甙以及多种慧醌类化合物。叶含牡荆素木糖甙和5，4′-二羟基黄酮的糖甙。"}]},{"ID":"20240903094737-fxvyhps","Type":"NodeParagraph","Properties":{"id":"20240903094737-fxvyhps","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903094737-0d4tkbm","Type":"NodeParagraph","Properties":{"id":"20240903094737-0d4tkbm","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①抗菌作用"}]},{"ID":"20240903094737-qprlyol","Type":"NodeParagraph","Properties":{"id":"20240903094737-qprlyol","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精在试管内对抗酸菌有抑制作用，其煎剂对实验性结核病的豚鼠，在感染结核菌同时给药与感染后淋巴肿大再给药，均有显着的抑菌效果，且能改善健康状况，其疗效与异烟肼接近。对伤寒杆菌仅有微弱的抑制作用（抗菌最低浓度为500～1000毫克％），对金黄色葡萄球菌无抑制作用（抗苗最低浓度）1000毫克％）。但也有报道黄精粗制剂及水抽出液，对上述两种细菌均有抑制作用。其1：10浓度对腺2病毒有延缓作用，对疱疹病毒有抑制作用。"}]},{"ID":"20240903094737-auheil8","Type":"NodeParagraph","Properties":{"id":"20240903094737-auheil8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②抗真菌作用"}]},{"ID":"20240903094737-84ot17h","Type":"NodeParagraph","Properties":{"id":"20240903094737-84ot17h","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精醇提水溶液2％以上浓度便开始对多种真菌有抑制作用，如堇色毛癣菌、红色表皮癣菌等，其水抽出物对石膏样毛癣菌及考夫曼-沃尔夫氏表皮癣菌有抑制作用，但有报道其10％煎剂仪对羊毛样小孢子菌有轻度的抑制作用，而对其他多种真菌无效。"}]},{"ID":"20240903094737-fhyyymp","Type":"NodeParagraph","Properties":{"id":"20240903094737-fhyyymp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③降压作用"}]},{"ID":"20240903094737-mb1z2fc","Type":"NodeParagraph","Properties":{"id":"20240903094737-mb1z2fc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精的水浸出液，乙醇-水浸出液和30％乙醇浸出液均有降低麻醉动物血压的作用。"}]},{"ID":"20240903094737-ry0in1r","Type":"NodeParagraph","Properties":{"id":"20240903094737-ry0in1r","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【炮制】黄精：洗净泥土，略润，切片，晒干。酒黄精：取拣净的黄精，洗净，用酒拌匀，装入容器内，密闭，坐水锅中，隔水炖到酒吸尽，取出，切段，晾干。（每黄精100斤，用黄酒50斤）"}]},{"ID":"20240903094737-59ufhrc","Type":"NodeParagraph","Properties":{"id":"20240903094737-59ufhrc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903094737-zp0fope","Type":"NodeParagraph","Properties":{"id":"20240903094737-zp0fope","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"甘，平。"}]},{"ID":"20240903094737-a5vf34z","Type":"NodeParagraph","Properties":{"id":"20240903094737-a5vf34z","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味甘，平，无毒。\""}]},{"ID":"20240903094737-foql8xc","Type":"NodeParagraph","Properties":{"id":"20240903094737-foql8xc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②《四声本草》：\"寒。\""}]},{"ID":"20240903094737-m45fsoz","Type":"NodeParagraph","Properties":{"id":"20240903094737-m45fsoz","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240903094737-voemyf1","Type":"NodeParagraph","Properties":{"id":"20240903094737-voemyf1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"入脾、肺、肾经。"}]},{"ID":"20240903094737-8hbjcx7","Type":"NodeParagraph","Properties":{"id":"20240903094737-8hbjcx7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾、肺二经。\""}]},{"ID":"20240903094737-uwqlvxa","Type":"NodeParagraph","Properties":{"id":"20240903094737-uwqlvxa","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②《玉楸药解》：\"入足太阴脾、足阳明胃。\""}]},{"ID":"20240903094737-u4hbq32","Type":"NodeParagraph","Properties":{"id":"20240903094737-u4hbq32","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心，脾、肺、肾。\""}]},{"ID":"20240903094737-f7wjzdh","Type":"NodeParagraph","Properties":{"id":"20240903094737-f7wjzdh","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903094737-2cmhj33","Type":"NodeParagraph","Properties":{"id":"20240903094737-2cmhj33","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"补中益气，润心肺，强筋骨。治虚损寒热，肺痨咳血，病后体虚食少，筋骨软弱，风湿疼痛，风癞癣疾。"}]},{"ID":"20240903094737-trgoi9z","Type":"NodeParagraph","Properties":{"id":"20240903094737-trgoi9z","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主补中益气，除风湿，安五脏。\""}]},{"ID":"20240903094737-ygvvj63","Type":"NodeParagraph","Properties":{"id":"20240903094737-ygvvj63","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"补五劳七伤，助筋骨，止饥，耐寒暑，益脾胃，润心肺。\""}]},{"ID":"20240903094737-3xjyq2m","Type":"NodeParagraph","Properties":{"id":"20240903094737-3xjyq2m","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"补虚添精。\""}]},{"ID":"20240903094737-ar91fru","Type":"NodeParagraph","Properties":{"id":"20240903094737-ar91fru","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"补诸虚，止寒热，填精髓，下三尸虫。\""}]},{"ID":"20240903094737-jqidafx","Type":"NodeParagraph","Properties":{"id":"20240903094737-jqidafx","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑤《本草从新》：\"平补气血而润。\""}]},{"ID":"20240903094737-2ufl0ri","Type":"NodeParagraph","Properties":{"id":"20240903094737-2ufl0ri","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"用于间歇热、痛风、骨膜炎、蛔虫、高血压。\""}]},{"ID":"20240903094737-rwjdhdf","Type":"NodeParagraph","Properties":{"id":"20240903094737-rwjdhdf","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑦《四川中药志》：\"补肾润肺，益气滋阴。治脾虚面黄，肺虚咳嗽，筋骨酸痹无力，及产后气血衰弱。\""}]},{"ID":"20240903094737-w3nw4q3","Type":"NodeParagraph","Properties":{"id":"20240903094737-w3nw4q3","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑧《湖南农村常用中草药手册》：\"补肾健脾，强筋壮骨，润肺生津。\""}]},{"ID":"20240903094737-pxhi4ow","Type":"NodeParagraph","Properties":{"id":"20240903094737-pxhi4ow","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱（鲜者1～2两）；熬膏或入丸、散。外用：煎水洗。"}]},{"ID":"20240903094737-m6zfzhg","Type":"NodeParagraph","Properties":{"id":"20240903094737-m6zfzhg","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240903094737-syg75ec","Type":"NodeParagraph","Properties":{"id":"20240903094737-syg75ec","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"中寒泄泻，痰湿痞满气滞者忌服。"}]},{"ID":"20240903094737-664b4ni","Type":"NodeParagraph","Properties":{"id":"20240903094737-664b4ni","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"忌梅实，花、叶、子并同。\""}]},{"ID":"20240903094737-nvuohpk","Type":"NodeParagraph","Properties":{"id":"20240903094737-nvuohpk","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"阳衰阴盛人服之，每致泄泻痞满。\""}]},{"ID":"20240903094737-42pu5rr","Type":"NodeParagraph","Properties":{"id":"20240903094737-42pu5rr","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"气滞者禁用。\""}]},{"ID":"20240903094737-tl5dfem","Type":"NodeParagraph","Properties":{"id":"20240903094737-tl5dfem","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"④《本草正义》：\"有湿痰者弗服。胃纳不旺者，亦必避之。\""}]},{"ID":"20240903094737-xs8vt3h","Type":"NodeParagraph","Properties":{"id":"20240903094737-xs8vt3h","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903094737-f41ppzb","Type":"NodeParagraph","Properties":{"id":"20240903094737-f41ppzb","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①壮筋骨，益精髓，变白发：黄精、苍术各四斤，枸杞根、柏叶各五斤，天门冬三斤。煮汁一石，同曲十斤，糯米一石，如常酿酒饮。（《纲目》）"}]},{"ID":"20240903094737-sp6rho2","Type":"NodeParagraph","Properties":{"id":"20240903094737-sp6rho2","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②补精气：枸杞子（冬采者佳），黄精等分。为细末，二味相和，捣成块，捏作饼子，干复捣为末，炼蜜为丸，如梧桐子大。每服五十丸，空心温水送下。（《奇效良方》枸杞丸）"}]},{"ID":"20240903094737-zfveykp","Type":"NodeParagraph","Properties":{"id":"20240903094737-zfveykp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"③治脾胃虚弱，体倦无力：黄精、党参、淮山药各一两，蒸鸡食。（《湖南农村常用中草药手册》）"}]},{"ID":"20240903094737-1l2ssi6","Type":"NodeParagraph","Properties":{"id":"20240903094737-1l2ssi6","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"④治肺劳咳血，赤白带：鲜黄精根头二两，冰糖一两，开水炖服。（《闽东本草》）"}]},{"ID":"20240903094737-tf5ejvm","Type":"NodeParagraph","Properties":{"id":"20240903094737-tf5ejvm","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑤治肺结核，病后体虚：黄精五钱至一两。水煎服或炖猪肉食。（《湖南农村常用中草药手册》）"}]},{"ID":"20240903094737-irhbpbr","Type":"NodeParagraph","Properties":{"id":"20240903094737-irhbpbr","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑥治小儿下肢痿软：黄精一两，冬蜜一两。开水炖服。（《闽东本草》）"}]},{"ID":"20240903094737-i6rw2bh","Type":"NodeParagraph","Properties":{"id":"20240903094737-i6rw2bh","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑦治胃热口渴：黄精六钱，熟地、山药各五钱，天花粉，麦门冬各四钱。水煎服。（《山东中草药手册》）"}]},{"ID":"20240903094737-ypjb8mq","Type":"NodeParagraph","Properties":{"id":"20240903094737-ypjb8mq","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑧治眼，补肝气，明目：蔓菁子一斤（以水淘净），黄精二斤（和蔓菁子水蒸九次，曝干）。上药，捣细罗为散。每服，空心以粥饮调下二钱，日午晚食后。以温水再调服。（《圣惠方》蔓菁子散）"}]},{"ID":"20240903094737-tf32bio","Type":"NodeParagraph","Properties":{"id":"20240903094737-tf32bio","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑨治荣气不清，久风入脉，因而成癞，鼻坏色败，皮肤痒溃：黄精根（去皮洗净）二斤。日中曝令软，纳粟米饭甑中同蒸之，二斗米熟为度，不拘时服。（《圣济总录》）"}]},{"ID":"20240903094737-r05u8re","Type":"NodeParagraph","Properties":{"id":"20240903094737-r05u8re","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"⑩治蛲虫病：黄精八钱，加冰糖二两，炖服。（《福建中医药》（6）：44，1965）"}]},{"ID":"20240903094737-348tnrm","Type":"NodeParagraph","Properties":{"id":"20240903094737-348tnrm","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903094737-kmnqgvo","Type":"NodeParagraph","Properties":{"id":"20240903094737-kmnqgvo","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"黄精，宽中益气，使五藏调和，肌肉充盛，骨髓强坚，皆是补阴之功。\""}]},{"ID":"20240903094737-q5cu3yl","Type":"NodeParagraph","Properties":{"id":"20240903094737-q5cu3yl","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②《本草便读》）：\"黄精，为滋腻之品，久服令人不饥，若脾虚有湿者，不宜服之，恐其腻膈也。此药味甘如饴，性平质润，为补养牌阴之正品。\""}]},{"ID":"20240903094737-1uj7yag","Type":"NodeParagraph","Properties":{"id":"20240903094737-1uj7yag","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903094737-eap2n0u","Type":"NodeParagraph","Properties":{"id":"20240903094737-eap2n0u","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"①治疗肺结核"}]},{"ID":"20240903094737-ofuhxaa","Type":"NodeParagraph","Properties":{"id":"20240903094737-ofuhxaa","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"取黄精经蒸晒干燥，洗净，切碎，加水5倍，用文火煎熬24小时，滤去渣，再将滤液用文火煎熬，不断搅拌，待熬成浸膏状，冷却，装瓶备用。一般5斤黄精可制黄精浸膏1斤，每毫升相当于黄精5克。剂量：每日4次，每次10毫升。临床观察19例，均属浸润型肺结核。其中浸润期9例，浸润溶解期2例，溶解播散期及吸收好转期各1例，静止期6例。两侧病变者11例，有空洞者6例，经单独内服黄精浸膏2个月后，病灶完全吸收者4例，吸收好转者12例，无改变者3例。6例空洞，2例闭合，4例有不同程度的缩小。痰集菌检查多数转阴；血沉绝大部分病例均恢复正常值。体重及临床症状也有所改善。"}]},{"ID":"20240903094737-eoy2jfh","Type":"NodeParagraph","Properties":{"id":"20240903094737-eoy2jfh","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"②治疗癣菌病"}]},{"ID":"20240903094737-3zxshw8","Type":"NodeParagraph","Properties":{"id":"20240903094737-3zxshw8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"取黄精捣碎，以95％酒精浸1～2天，蒸馏去大部分酒精，使浓缩，加3倍水，沉淀，取其滤液，蒸去其余酒精，浓缩至稀糊状，即成为黄精粗制液。使用时直接搽涂患处，每日2次。一般对足痹、腰癣都有一定疗效，尤以对足癣的水疱型及糜烂型疗效最佳。对足癣的角化型疗效较差，可能是因霉菌处在角化型较厚的表皮内，而黄精无剥脱或渗透表皮能力之故。黄精粗制液搽用时无痛苦，亦未见变坏的不良反应，缺点是容易污染衣服。"}]},{"ID":"20240903094737-z2fx6e0","Type":"NodeParagraph","Properties":{"id":"20240903094737-z2fx6e0","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903094737-qe1ytm8","Type":"NodeParagraph","Properties":{"id":"20240903094737-qe1ytm8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"黄精《中华本草》"}]},{"ID":"20240903094737-mmhyom2","Type":"NodeParagraph","Properties":{"id":"20240903094737-mmhyom2","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903094737-4oebcr8","Type":"NodeParagraph","Properties":{"id":"20240903094737-4oebcr8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"出自《雷公炮炙论》。"}]},{"ID":"20240903094737-rdpx1rw","Type":"NodeParagraph","Properties":{"id":"20240903094737-rdpx1rw","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"1．《雷公炮炙论》：凡使黄精，勿用钩吻，真相似，只是叶有毛钩子二个是别认处，若误服，害人。黄精叶似竹叶。"}]},{"ID":"20240903094737-5yjc8z0","Type":"NodeParagraph","Properties":{"id":"20240903094737-5yjc8z0","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"2．《别录》：黄精生山谷，二月采根，阴干。"}]},{"ID":"20240903094737-fhdez0n","Type":"NodeParagraph","Properties":{"id":"20240903094737-fhdez0n","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"3．陶弘景：黄精今处处有。二月始生，一枝多叶，叶状似竹而短，根似萎蕤。萎蕤根如荻根及草蒲，节而平直；黄精根如鬼臼、黄连，大节而不平，虽燥，并柔软有脂润。根叶花实皆可饵服，酒散随宜。黄精叶乃与钩吻相似，惟茎不紫，"}]},{"ID":"20240903094737-4rh217w","Type":"NodeParagraph","Properties":{"id":"20240903094737-4rh217w","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【拼音名】HuánɡJīnɡ"}]},{"ID":"20240903094737-suzqfcp","Type":"NodeParagraph","Properties":{"id":"20240903094737-suzqfcp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【英文名】ManyflowerSolomonsealRhizome，SiberianSolomonsealRhizome，KingSolomonsealRhizome"}]},{"ID":"20240903094737-9aajs1x","Type":"NodeParagraph","Properties":{"id":"20240903094737-9aajs1x","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【别名】龙衔、白及、兔竹、垂珠、鸡格、米脯、菟竹、鹿竹、重楼、救穷、戊已芝、萎蕤、苟格、马箭、仙人余粮、气精、生姜、野生姜、米餔、野仙姜、山生姜、玉竹黄精、白及黄精、阳誉蕻、土灵芝、老虎姜、山捣臼、鸡头参、赖姜。"}]},{"ID":"20240903094737-ctg9vu7","Type":"NodeParagraph","Properties":{"id":"20240903094737-ctg9vu7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903094737-hxr98o1","Type":"NodeParagraph","Properties":{"id":"20240903094737-hxr98o1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"药材基源：为百合科植物黄精、多花黄精和滇黄精的根茎。"}]},{"ID":"20240903094737-s8tuop0","Type":"NodeParagraph","Properties":{"id":"20240903094737-s8tuop0","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.PolygonatumsibiricumDelar.exRedoute[P.chinenseKunth]2.PolygonatumcyrtonemaHua[P.multiflorumbrachynemaHand.-Mazz.]3.PolygonatumkingianumColl.etHemsl.[P.agglutinatumHua]"}]},{"ID":"20240903094737-mf2gqc8","Type":"NodeParagraph","Properties":{"id":"20240903094737-mf2gqc8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后3年收获。9-10月挖起根茎，去掉茎杆，洗净泥沙，除去须根和烂疤，蒸到透心后，晒或烘干。"}]},{"ID":"20240903094737-ly8fjgn","Type":"NodeParagraph","Properties":{"id":"20240903094737-ly8fjgn","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【原形态】1.黄精，多年生草本，高50-90cm，偶达1m以上。根茎横走，圆柱状，结节膨大。叶轮生，无柄，每轮4-6片；叶片条状披针形，长8-15cm，宽4-16mm，先端渐尖并拳卷。花腋生，下垂，2-4朵成伞形花丛，总花梗长1-2cm，花梗长4-10mm，基部有膜质小苞片，钻形或条状披针形，具1脉；花被筒状，白色至淡黄色，全长9-13mm，裂片6，披针形，长约4mm；雄蕊着生在花被筒的1/2以上处，花丝短，长0.5-1mm；子房长3mm，花柱长5-7mm。浆果球形，直径7-10mm，成熟时紫黑色。花期5-6月，果期7-9月。2.多花黄精本种与黄精的区别在于：植株高大粗壮。根茎通常稍带结节状或连珠状。叶互生。花序通常有花3-7朵，总花梗长1-4cm。"}]},{"ID":"20240903094737-rcke1i7","Type":"NodeParagraph","Properties":{"id":"20240903094737-rcke1i7","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903094737-urwarh8","Type":"NodeParagraph","Properties":{"id":"20240903094737-urwarh8","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"生态环境：1.黄精生于山地林下、灌丛或山坡的半阴处。2.多花黄精生于山林、灌丛、沟谷旁的阴湿肥沃土壤中，或人工栽培。"}]},{"ID":"20240903094737-nt8lejb","Type":"NodeParagraph","Properties":{"id":"20240903094737-nt8lejb","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"资源分布：1.黄精分布于东北、化北、及陕西、宁夏、甘肃、河南、山东、江苏、安徽、浙江等地。2.多花黄精分布于中南及江苏、安徽、浙江、江西、福建、四川、贵州等地。"}]},{"ID":"20240903094737-7dx9pkk","Type":"NodeParagraph","Properties":{"id":"20240903094737-7dx9pkk","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【栽培】生物学物性喜温暖湿润气候和阴湿的环境。耐寒，对气候适应性较强。可选择半高山或平地栽培，以土层深厚、肥沃、疏松、湿润的土壤栽培为宜。栽培技术用根茎繁殖为主。9-10月边收获边分栽，选择有芽的根茎，用刀切成数段，每段有节两个，按行株距30cm×20cm，开穴栽种，每穴栽1段根茎，栽后施入腐肥熟厩肥或土杂肥，最后覆盖一层细土。田间管理出苗后经常松土除草，松土要浅，避免伤根。结合中耕除草，在春、夏各追肥1次，肥料以人畜粪水为主。植株枯萎后，撒施土杂肥。病虫害防治病害有叶斑病，可用65%代森锌可湿性粉剂500倍液防治。虫害有蛴螬，为害根茎，可用50%辛硫磷兑水1000倍浇灌根部，也可用苦楝叶水淋根。"}]},{"ID":"20240903094737-yykbnhu","Type":"NodeParagraph","Properties":{"id":"20240903094737-yykbnhu","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903094737-rpl2ux0","Type":"NodeParagraph","Properties":{"id":"20240903094737-rpl2ux0","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）黄精根茎结节状。一端粗，类圆盘状，一端渐细，圆柱状，全角略似鸡头，长2．5-11cm，粗端直径1-2cm，常有短分枝，上面茎痕明显，圆形，微凹，直径2-3mm，周围隐约可见环节；细端长2．5-4cm，直径5-10mm，环节明显，节间距离5-15mm，有较多须根或须根痕，直径约1mm。表面黄棕色，有的半透明，具皱纹；圆柱形处有纵行纹理。质硬脆或稍柔韧，易折断，断面黄白色，颗粒状，有企多黄棕色给管束小点。气微，味微甜。"}]},{"ID":"20240903094737-jp5djon","Type":"NodeParagraph","Properties":{"id":"20240903094737-jp5djon","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"（2）多花黄精根茎连珠状或块状，稍带圆柱形，直径2-3cm。每一结节上茎痕明显，圆盘状，直径约1cm。圆柱形处环节明显，有众多须根痕，直径约1mm。表面黄棕色，有细皱纹。质坚实，稍带柔韧，折断面颗粒状，有众多黄棕色维管束小点散列。气微，味微甜。"}]},{"ID":"20240903094737-zl1s9cz","Type":"NodeParagraph","Properties":{"id":"20240903094737-zl1s9cz","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"（3）滇黄精根茎肥厚，姜快状或连珠状，直往2-4cm或以上，每一结节有明显茎痕，圆盘状，稍凹陷，宜往5-8mm；须根痕多，常突出，宜径约2mm。表面黄白色至黄棕色，有明显环节及不规则纵皱。质实，较柔韧，不易折断，断面黄白色，平坦，颗粒状，有众多深色维管束小点。气微，味甜，有粘性。"}]},{"ID":"20240903094737-1lbabfk","Type":"NodeParagraph","Properties":{"id":"20240903094737-1lbabfk","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"正微鉴别根茎横切面：（1）黄精表皮细胞1列，外被角质层；有的部位可见4-5列木栓化细胞。皮层较窄，内皮层不明显。中柱维管束散列，近内皮层处维管束较小，略排列成环状，向内则渐大，多外韧型，偶有周木型。薄壁组织中分布有较多的粘液细胞，长径37-11μm，短径20-50μm，内含草酸钙针晶束。（2）多花黄精表皮细胞1列，外被角质层；局部可有木栓组织。皮层明显。维管束多散列，外韧型，偶见周木型。粘液细胞大形，长径50-140μm，短径25-50μm，内含草酸钙针晶束。"}]},{"ID":"20240903094737-6o02omp","Type":"NodeParagraph","Properties":{"id":"20240903094737-6o02omp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"（3）滇黄精表皮细胞1列，外被角质层，有时局部有4-5列木栓细胞。维管束散列，周木型，少见外韧型。有粘液细胞，长径36-110μm，短径20-66μm，内含草酸钙针晶束。"}]},{"ID":"20240903094737-hpyx6mj","Type":"NodeParagraph","Properties":{"id":"20240903094737-hpyx6mj","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【化学成份】黄精的根状茎含甾体皂甙，已分离出2个呋甾烯醇型皂甙和2个螺甾烯醇型皂甙。属于前者的是：26-O-β-D-吡喃葡萄糖基-22-O-甲基-（25）S-呋甾-5-烯-3β，26-二醇3-O-β-石蒜四糖甙[26-O-β-D-glucopyranosyl-22-O-methyl-25（S）-furost-5-ene-3β，26-diol3-O-β-lycotetraoside]即西伯利亚蓼甙A（sibiricoside-A）和26-O-β-D-吡喃葡萄糖基-22-O-甲基-25（S）-呋甾-5-烯-3β，14α，26-三醇3-O-β-石蒜四糖甙[26-O-β-D-glucopyranosyl-22-O-methyl-25（S）-fruost-5-ene-3β，14α，26-triol3-O-β-lycotetraoside]即14α-羟基西伯利亚蓼甙A（14α-hydroxysibiricosideA）；属于后者的是：[（23S，25R）螺甾-5-烯-3β，14α，23-三醇3-O-β-lycotetraoside]即西伯利亚蓼甙B（sibiricosideB）和新巴拉次薯蓣皂甙元-A3-O-β-石蒜四糖甙（neoprazerigeninA3-O-β-lycotetraoside）。另含黄精多糖A、B、C，三者的相对分子质量均大于20万，均由葡萄糖（glucose）、甘露糖（mannose）和半乳糖醛酸（galacturonicacid）按照摩尔比6：26：1缩合而成；又含黄精低聚糖A、B、C，相对分子质量分别为1630、862和472，系由果糖（fructose）与葡萄糖按摩尔比8：1、4：1和2：1缩合而成。"}]},{"ID":"20240903094737-5q0uhye","Type":"NodeParagraph","Properties":{"id":"20240903094737-5q0uhye","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903094737-oycw8ep","Type":"NodeParagraph","Properties":{"id":"20240903094737-oycw8ep","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"1.抗病原微生物作用：体外试验表明、黄精水提出液（1：320）对伤寒杆菌、金黄色葡萄球菌、抗酸杆菌有抑制作用，2%黄精在沙氏培养基内对常见致病真菌有不同程度的抑制作用。"}]},{"ID":"20240903094737-bgjz0qc","Type":"NodeParagraph","Properties":{"id":"20240903094737-bgjz0qc","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"2.对血糖的影响：兔灌胃黄精浸膏，其血糖含量渐次增高，然后降低。黄精浸膏对肾上腺素引起的血糖过高呈显着抑制作用。"}]},{"ID":"20240903094737-dysmn7l","Type":"NodeParagraph","Properties":{"id":"20240903094737-dysmn7l","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"3.抗疲劳作用：黄精煎剂17.67%浓度0.3ml/只腹腔注射，可延长小鼠游泳时间。"}]},{"ID":"20240903094737-jlcao1y","Type":"NodeParagraph","Properties":{"id":"20240903094737-jlcao1y","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"4.抗氧化作用：黄精煎液20%浓度，13ml/只喂饮，连续27天，使小鼠肝脏超氧化物歧化酶（SOD）活性升高，心肌脂褐质含量降低。"}]},{"ID":"20240903094737-ac6ptkf","Type":"NodeParagraph","Properties":{"id":"20240903094737-ac6ptkf","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"5.延缓衰老作用：黄精煎剂，20%浓度浸泡桑叶喂养家蚕，有延长家蚕幼虫期的作用。"}]},{"ID":"20240903094737-xexa7ik","Type":"NodeParagraph","Properties":{"id":"20240903094737-xexa7ik","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"6.止血作用：黄精甲醇提取物40mg/只，正丁醇部分20mg/只，水层部分20mg/只，腹腔注射，对干冰－甲醇冷冻小鼠尾部1分钟，切尾法实验表明有止血作用，使小鼠出血量减少。"}]},{"ID":"20240903094737-r1fi43p","Type":"NodeParagraph","Properties":{"id":"20240903094737-r1fi43p","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"7.对心血管作用：黄精水浸膏0.16-0.26g/kg静脉注射，明显增加麻醉犬冠脉流量；1.5g/kg静脉注射，对垂体后叶素引起的兔心肌缺血有对抗作用，对抗垂体后叶素引起的T波增高，促进T波异常提前恢复；12g/kg腹腔注射，可增强小鼠对缺氧的耐受力。"}]},{"ID":"20240903094737-ni7nhgj","Type":"NodeParagraph","Properties":{"id":"20240903094737-ni7nhgj","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"8.抗病毒作用：黄精多糖0.2%眼液滴眼，6次/天，或加服黄精多糖10mg/kg，2次/天，对兔实验性单纯疱疹病毒性角膜炎均有治疗作用。"}]},{"ID":"20240903094737-9tg40hp","Type":"NodeParagraph","Properties":{"id":"20240903094737-9tg40hp","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"9.其它作用：黄精煎剂6g/kg灌胃，连续10天，可提高小鼠红细胞膜Na+，K+-ATP酶活性。40%黄精醇提液0.3ml/只腹腔注射，能提高小鼠心肌、肝、脾组织细胞DNA对3H-TdR的掺入率。黄精煎剂0.5g/只灌胃使小鼠血浆cAMP，cGMP含量均下降，而以cGMP下降更多，因此cAMP/cGMP比值大于对照组，对脾组织cAMP，cGMP含量均上升，但cAMP/cGMP比值无明显变化。"}]},{"ID":"20240903094737-6rzv8ra","Type":"NodeParagraph","Properties":{"id":"20240903094737-6rzv8ra","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取精粉1g，加水20ml，水浴温热30min，滤过，滤液行下列试验。①取滤液2ml置试管中，加a-萘酚试剂2-3滴，摇匀，沿管壁加硫酸1ml，两液面交界处有红色环。（糖类反应）②取流液2ml，加混合的Fehling试剂3ml，摇匀后置水浴中加热片刻，有砖红色沉淀产生。（糖类反应）（2）纸色谱取粉末3g，加甲醇50ml，回流4b，弃去甲醇，药渣加水适量煎2h，滤过，得滤液约20ml，加乙醇使成含醇量65%的溶液，得白色絮状沉淀，冷藏过夜，滤过。沉淀加1mol/L硫酸1ml，置沸水浴中加热2b，成透明溶液，加水少量，用碳酸钡凋至PH6-7，滤过，滤液中加氢型强酸型离子交换树脂1小勺，放置过夜，滤去树脂，滤液缩作供试液。另以半乳糖醛酸、甘露糖、葡萄糖为对照品。分别点样于同一WhatmanNO：l滤纸上，用萘酚一水一浓氨水（40g：10ml：5滴）下行展开，以邻苯二甲酸一苯胺（1．66g：0．93ml溶于水炮和的正丁醇）喷零，105度烤20min。供试品色谱在与对照品色谱的相应位置上显相同的色斑。"}]},{"ID":"20240903094737-1t7uydr","Type":"NodeParagraph","Properties":{"id":"20240903094737-1t7uydr","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【炮制】黄精：洗净泥士，略润，切片，晒干。酒黄精：取拣净的黄精，洗净，用酒拌匀，装入容器内，密闭，坐水锅中，隔水炖到酒吸尽，取出，切段，晾干。(每黄精100斤，用黄酒50斤)"}]},{"ID":"20240903094737-xi4po2w","Type":"NodeParagraph","Properties":{"id":"20240903094737-xi4po2w","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【性味】甘；平"}]},{"ID":"20240903094737-4q3917h","Type":"NodeParagraph","Properties":{"id":"20240903094737-4q3917h","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肺；肾经"}]},{"ID":"20240903094737-hka3v3c","Type":"NodeParagraph","Properties":{"id":"20240903094737-hka3v3c","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【功能主治】养阴润肺；补脾益气，滋肾填精。主阴虚劳嗽；肺燥咳嗽；脾虚乏力；食少口干；消渴；肾亏腰膝酸软；阳痿遗精；耳鸣目暗；须发早白；体虚赢瘦；风癞癣疾"}]},{"ID":"20240903094737-dvb6mi2","Type":"NodeParagraph","Properties":{"id":"20240903094737-dvb6mi2","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-15g，鲜品30-60g；或入丸、散熬膏。外用：适量，煎汤洗；熬膏涂；或浸酒搽。"}]},{"ID":"20240903094737-oalseg4","Type":"NodeParagraph","Properties":{"id":"20240903094737-oalseg4","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【注意】中寒泄泻，痰湿痞满气滞者忌服。"}]},{"ID":"20240903094737-hjjd677","Type":"NodeParagraph","Properties":{"id":"20240903094737-hjjd677","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【附方】①壮筋骨，益精髓，变白发：黄精、苍术各四斤，枸杞根、柏叶各五斤，天门冬三斤。煮汁一石，同曲十斤，糯米一石，如常酿酒钦。(《纲目》)②补精气：枸杞子(冬采者佳)、黄精等分。为细末，二味招和，捣成块，捏作饼子，干复捣为末，炼蜜为丸，如梧桐子大。每服五十丸，空心温水送下。(《奇效良方》枸杞丸)③治脾胃虚弱，体倦无力：黄精、党参、淮山药各一两，蒸鸡食。(《湖南农村常用中草药手册》)④治肺劳咳血，赤白带：鲜黄精根头二两，冰糖一两。开水炖服。(《闽东本草》)⑤治肺结核，病后体虚：黄精五钱至一两。水煎服或炖猪肉食。(《湖南农村常用中草药手册》)⑥治小儿下肢痿软：黄精一两，冬蜜一两。开水炖服。(《闽东本草》)⑦治胃热口渴：黄精六钱，熟地、山药各五钱，天花粉、麦门冬各四钱。水煎服。(《山东中草药手册》)⑧治眼，补肝气，明目：蔓菁子一斤(以水淘净)，黄精二斤(和蔓菁子水蒸九次，曝干)。上药，捣细罗为散。每服，空心以粥饮调下二钱，日午晚食后，以温水再调服。(《圣惠方》蔓菁子散)⑨治荣气不清，久风入脉，因而成癞，鼻坏色败，皮肤痒溃：黄精根(去皮洗净)二斤。日中曝令软，纳粟米饭甑中同蒸之，二斗米熟为度，不拘时服。(《圣济总录》)⑩治蛲虫病：黄精八钱，加冰糖一两，炖服。〔《福建中医药》(6)：44，1965)"}]},{"ID":"20240903094737-74tnxku","Type":"NodeParagraph","Properties":{"id":"20240903094737-74tnxku","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903094737-bschhci","Type":"NodeParagraph","Properties":{"id":"20240903094737-bschhci","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"1.《本经逢原》：黄精，宽中益气，使五藏调和，肌肉充盛，骨髓强坚，皆是补阴之功。"}]},{"ID":"20240903094737-gcfh78a","Type":"NodeParagraph","Properties":{"id":"20240903094737-gcfh78a","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"2.《本草便读》：黄精，为滋腻之品，久服令人不饥，若脾虚有湿者，不宜服之，恐其腻膈也。此药味甘如饴，性平质润，为补养脾阴之正品。"}]},{"ID":"20240903094737-wn3bmqx","Type":"NodeParagraph","Properties":{"id":"20240903094737-wn3bmqx","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903094737-akdmp1k","Type":"NodeParagraph","Properties":{"id":"20240903094737-akdmp1k","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"1.治疗肺结核：取黄精经蒸晒干燥，洗净，切碎，加水5倍，用文火煎熬24小时，滤去渣，再将滤液用文火煎熬，不断搅拌，待熬成浸膏状，冷却，装瓶备用。一般5斤黄精可制黄精浸膏1斤，每毫升相当于黄精5g。剂量：每日4次，每次10ml。临床观察19例，均属浸润型肺结核，其中浸润期9例，浸润溶解期2例，溶解播散期及吸收好转期各1例，静止期6例。两侧病变者11例，有空洞者6例，经单独内服黄精浸膏2个月后，病灶完全吸收者4例，吸收好转者12例，无改变者3例。6例空洞，2例闭合，4例有不同程度的缩小。痰集菌检查多数转阴；血沉绝大部分病例均恢复正常值。体重及临床症状也有所改善。"}]},{"ID":"20240903094737-tk2cce1","Type":"NodeParagraph","Properties":{"id":"20240903094737-tk2cce1","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"2.治疗癣菌病：取黄精捣碎，以95%酒精浸1-2天，蒸馏去大部分酒精，使浓缩，加3倍水，沉淀，取其滤液，蒸去其余酒精，浓缩至稀糊状，即成为黄精粗制液。使用时直接搽涂患处，每日2次。一般对足癣、腰癣都有一定疗效，尤以对足癣的水疱型及糜烂型疗效最佳。对足癣的角化型疗效较差，可能是因霉菌处在角化型较厚的表皮内，而黄精无剥脱或渗透表皮能力之故。黄精粗制液搽用时无痛苦，亦未见变坏的不良反应，缺点是容易污染衣服。"}]},{"ID":"20240903094737-5y82guf","Type":"NodeParagraph","Properties":{"id":"20240903094737-5y82guf","updated":"20240903094817"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903094739-icegmcf","Type":"NodeThematicBreak","Properties":{"id":"20240903094739-icegmcf","updated":"20240903094817"}},{"ID":"20240903094740-u1gilr6","Type":"NodeParagraph","Properties":{"id":"20240903094740-u1gilr6","updated":"20240903094817"}}]}