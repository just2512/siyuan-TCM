e"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240709173233-e29bmsj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 521px;\" parent-style=\"width: 531px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 376px;","style":"width: 366px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"党参 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/党参 13-20240709172441-p8n6olb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 366px;\" parent-style=\"width: 376px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709172032-n7ho9it","Type":"NodeParagraph","Properties":{"id":"20240709172032-n7ho9it","updated":"20240709172531"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240709172032-h30irvm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 687px;","style":"width: 677px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"党参 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/党参 14-20240709172531-gpugvls.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 677px;\" parent-style=\"width: 687px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709173111-44h5cht","Type":"NodeParagraph","Properties":{"id":"20240709173111-44h5cht","updated":"20240709173259"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 355px;","style":"width: 345px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"党参 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/党参 15-20240709173111-8lwn85r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 345px;\" parent-style=\"width: 355px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 836px;","style":"width: 826px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"党参 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/党参 16-20240709173259-vs6xudm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 826px;\" parent-style=\"width: 836px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709172317-6ktz0wp","Type":"NodeParagraph","Properties":{"id":"20240709172317-6ktz0wp","updated":"20240709172331"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：野党参学名‘金钱豹’。"}]},{"ID":"20240709170152-2ipvs8p","Type":"NodeThematicBreak","Properties":{"id":"20240709170152-2ipvs8p"}},{"ID":"20240830141708-tffuj10","Type":"NodeParagraph","Properties":{"id":"20240830141708-tffuj10","updated":"20240830141716"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：党参"}]},{"ID":"20240830141708-obk9uyy","Type":"NodeParagraph","Properties":{"id":"20240830141708-obk9uyy","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参《中国药典》"}]},{"ID":"20240830141708-824hbly","Type":"NodeParagraph","Properties":{"id":"20240830141708-824hbly","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【拼音名】DǎnɡShēn"}]},{"ID":"20240830141708-44os0g6","Type":"NodeParagraph","Properties":{"id":"20240830141708-44os0g6","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXCODONOPSIS"}]},{"ID":"20240830141708-6mx93p9","Type":"NodeParagraph","Properties":{"id":"20240830141708-6mx93p9","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【别名】东党、台党、潞党、口党"}]},{"ID":"20240830141708-cy9cmd1","Type":"NodeParagraph","Properties":{"id":"20240830141708-cy9cmd1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【来源】本品为桔梗科植物党参Codonopsispilosula（Franch.）Nannf.、素花党参（西党参）CodonopsispilosulaNannf.var.modesta（Nannf.）L.T.Shen或川党参CodonopsistangshenOliv.的干燥根。秋季采挖，洗净，晒干。"}]},{"ID":"20240830141708-q2bk7ww","Type":"NodeParagraph","Properties":{"id":"20240830141708-q2bk7ww","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830141708-ua95d7q","Type":"NodeParagraph","Properties":{"id":"20240830141708-ua95d7q","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参：呈长圆柱形，稍弯曲，长10～35cm，直径0.4～2cm。表面黄棕色至灰棕色，根头部有多数疣状突起的茎痕及芽，每个茎痕的顶端呈凹下的圆点状；根头下有致密的环状横纹，向下渐稀疏，有的达全长的一半，栽培品环状横纹少或无；全体有纵皱纹及散在的横长皮孔，支根断落处常有黑褐色胶状物。质稍硬或略带韧性，断面稍平坦，有裂隙或放射状纹理，皮部淡黄白色至淡棕色，木部淡黄色。有特殊香气，味微甜。"}]},{"ID":"20240830141708-445781e","Type":"NodeParagraph","Properties":{"id":"20240830141708-445781e","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"素花党参（西党参）：长10～35cm，直径0.5～2.5cm。表面黄白色至灰黄色，根头下致密的的环状横纹常达全长的一半以上。断面裂隙较多，皮部灰白色至淡棕色，木部淡黄色。"}]},{"ID":"20240830141708-8t64qo2","Type":"NodeParagraph","Properties":{"id":"20240830141708-8t64qo2","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"川党参：长10～45cm，直径0.5～2cm。表面灰黄色至黄棕色，有明显不规则的纵沟。质较软而结实，断面裂隙较少，皮部黄白色，木部淡黄色。"}]},{"ID":"20240830141708-mtz0tjm","Type":"NodeParagraph","Properties":{"id":"20240830141708-mtz0tjm","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品横切面：木栓细胞数列至10数列，外侧有石细胞，单个或成群。皮层窄。韧皮部宽广，外侧常现裂隙，散有淡黄色乳管群，并常与筛管群交互排列。形成层成环。木质部导管单个散在或数个相聚，呈放射状排列。薄壁细胞含菊糖。"}]},{"ID":"20240830141708-t50vy1j","Type":"NodeParagraph","Properties":{"id":"20240830141708-t50vy1j","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240830141708-6pj0e1m","Type":"NodeParagraph","Properties":{"id":"20240830141708-6pj0e1m","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性味】甘，平。"}]},{"ID":"20240830141708-sd95s1q","Type":"NodeParagraph","Properties":{"id":"20240830141708-sd95s1q","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、肺经。"}]},{"ID":"20240830141708-nvjjj6n","Type":"NodeParagraph","Properties":{"id":"20240830141708-nvjjj6n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【功能主治】补中益气，健脾益肺。用于脾肺虚弱，气短心悸，食少便溏，虚喘咳嗽，内热消渴。"}]},{"ID":"20240830141708-2w42tpq","Type":"NodeParagraph","Properties":{"id":"20240830141708-2w42tpq","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～30g。"}]},{"ID":"20240830141708-asq3ygv","Type":"NodeParagraph","Properties":{"id":"20240830141708-asq3ygv","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【注意】不宜与藜芦同用。"}]},{"ID":"20240830141708-l9oi25u","Type":"NodeParagraph","Properties":{"id":"20240830141708-l9oi25u","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。防蛀。"}]},{"ID":"20240830141708-7lqv54l","Type":"NodeParagraph","Properties":{"id":"20240830141708-7lqv54l","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830141708-ub5pjan","Type":"NodeParagraph","Properties":{"id":"20240830141708-ub5pjan","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参《*辞典》"}]},{"ID":"20240830141708-1ti0sxx","Type":"NodeParagraph","Properties":{"id":"20240830141708-1ti0sxx","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【出处】《本草从新》"}]},{"ID":"20240830141708-xtwprph","Type":"NodeParagraph","Properties":{"id":"20240830141708-xtwprph","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【拼音名】DǎnɡShēn"}]},{"ID":"20240830141708-iiz8odw","Type":"NodeParagraph","Properties":{"id":"20240830141708-iiz8odw","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【别名】上党人参（《本经逢原》），黄参（《百草镜》），狮头参（《翁有良辨误》），中灵草（《青海药材》）。"}]},{"ID":"20240830141708-qs4n8io","Type":"NodeParagraph","Properties":{"id":"20240830141708-qs4n8io","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【来源】为桔梗科植物党参的根。秋季采挖，除去地上部分，洗净泥土，晒至半干，用手或木板搓揉，使皮部与木质部贴紧，饱满柔软，然后再晒再搓，反复3～4次，最后晒干即成。"}]},{"ID":"20240830141708-i3itrul","Type":"NodeParagraph","Properties":{"id":"20240830141708-i3itrul","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830141708-95mc4v3","Type":"NodeParagraph","Properties":{"id":"20240830141708-95mc4v3","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参，又名：辽参、三叶菜、叶子草。"}]},{"ID":"20240830141708-73m0en6","Type":"NodeParagraph","Properties":{"id":"20240830141708-73m0en6","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"多年生草本。根长圆柱形，直径1～1.7厘米，顶端有一膨大的根头，具多数瘤状的茎痕，外皮乳黄色至淡灰棕色，有纵横皱纹。茎缠绕，长而多分歧，下部疏生白色粗糙硬毛，上部光滑或近于光滑。叶对生、互生或假轮生：具柄，叶柄长0.5～4厘米，被疏柔毛：叶片卵形或广卵形，长1～7厘米，宽0.8～5.5厘米，先端钝或尖，基部截形或浅心形，全缘或微波状，上面绿色，被粗伏毛，下面粉绿色，密被疏柔毛。花单生，具细花梗；花萼绿色，具5裂片，裂片长圆状披针形，先端钝，光滑或稍被茸毛；花冠广钟形，直径2～2.5厘米，淡黄绿色，且有淡紫堇色斑点，先端5裂，裂片三角形至广三角形，直立；雄蕊5，花丝中部以下扩大；子房上位，3室，胚珠多数，花柱短，柱头3，极阔，呈漏斗状。蒴果圆锥形，3室，有宿存花萼。种子小，褐色有光泽。花期8～9月。果期9～10月。"}]},{"ID":"20240830141708-m7l7b38","Type":"NodeParagraph","Properties":{"id":"20240830141708-m7l7b38","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山地灌木丛中及林缘，分布东北及河北、河南、山西、陕西、甘肃、内蒙古、青海等地。"}]},{"ID":"20240830141708-wpg069i","Type":"NodeParagraph","Properties":{"id":"20240830141708-wpg069i","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830141708-4g71ebv","Type":"NodeParagraph","Properties":{"id":"20240830141708-4g71ebv","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参药材由于产地不同，有西党、东党、潞党等三种。"}]},{"ID":"20240830141708-quu6k91","Type":"NodeParagraph","Properties":{"id":"20240830141708-quu6k91","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①西党"}]},{"ID":"20240830141708-rs86lwb","Type":"NodeParagraph","Properties":{"id":"20240830141708-rs86lwb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"根部类圆柱形，末端较细，长8～20厘米，直径约5～13毫米。根头部有许多疣状突起的茎痕，俗称\"狮子盘头\"，每个茎痕呈凹下点状。表面灰黄色或浅棕黄色，有明显纵沟，近根头处有紧密的环状皱纹，逐渐稀疏约占全体之半。皮孔横长、明显，略突出，长约0.3～0.8厘米。支根脱落处常见黑褐色胶状物，系内部乳汁溢出干燥所成。质稍坚脆，易折断。断面皮部白色，有裂隙，木部淡黄色。气特殊，味微甜。以根条肥大、粗实、皮紧、横纹多、味甜者为佳。"}]},{"ID":"20240830141708-y9ruwe1","Type":"NodeParagraph","Properties":{"id":"20240830141708-y9ruwe1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"主产陕西、甘肃。"}]},{"ID":"20240830141708-vpl3hbe","Type":"NodeParagraph","Properties":{"id":"20240830141708-vpl3hbe","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②东党"}]},{"ID":"20240830141708-38b1ktc","Type":"NodeParagraph","Properties":{"id":"20240830141708-38b1ktc","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"根类圆柱形，常分歧。长12～25厘米，直径约5～22毫米。根头大而明显，根外皮黄色及灰黄色，粗糙，有明显纵皱。皮孔短而突出，呈点状突起。质疏松，易折断。断面皮部黄色，木部黄白色，皮部占本部之1/3，皮部有横向裂隙，木部射线亦成裂隙。以根条肥大、外皮黄色、皮紧肉实、皱纹多者为佳。"}]},{"ID":"20240830141708-9m1ryc3","Type":"NodeParagraph","Properties":{"id":"20240830141708-9m1ryc3","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"主产东北等地。"}]},{"ID":"20240830141708-k6uf4yx","Type":"NodeParagraph","Properties":{"id":"20240830141708-k6uf4yx","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"③潞党"}]},{"ID":"20240830141708-rriiih4","Type":"NodeParagraph","Properties":{"id":"20240830141708-rriiih4","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"根类扁圆柱形，单一，长约8～22厘米，直径约7～10毫米，亦有较长大者。根头部无明显\"狮子盘头\"。根表面浅灰棕色，有深而不规则的纵皱沟，近根头处有较稀横纹。质较轻，易折断，断面不规则。气微，无香气，味甜。以独支不分叉、色白、肥壮粗长者为佳。"}]},{"ID":"20240830141708-1fohb3o","Type":"NodeParagraph","Properties":{"id":"20240830141708-1fohb3o","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"主产山西，多为栽培品。野生于山西五台山等地者称\"台党\"。"}]},{"ID":"20240830141708-enpr6tb","Type":"NodeParagraph","Properties":{"id":"20240830141708-enpr6tb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830141708-rh5tys3","Type":"NodeParagraph","Properties":{"id":"20240830141708-rh5tys3","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参根含皂甙、微量生物碱、蔗糖、葡萄糖、菊糖、淀粉、粘液及树脂等。"}]},{"ID":"20240830141708-is3ndiv","Type":"NodeParagraph","Properties":{"id":"20240830141708-is3ndiv","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"川党参根含挥发油、黄芩素萄萄糖甙、微量生物碱、多糖、菊糖、皂甙。"}]},{"ID":"20240830141708-6aa3cq6","Type":"NodeParagraph","Properties":{"id":"20240830141708-6aa3cq6","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830141708-vlnlvpr","Type":"NodeParagraph","Properties":{"id":"20240830141708-vlnlvpr","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①对血细胞的影响"}]},{"ID":"20240830141708-cv250t3","Type":"NodeParagraph","Properties":{"id":"20240830141708-cv250t3","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参根的醇、水浸膏口服或皮下注射，可使正常兔的红细胞及血红蛋白略有增加；摘除脾脏后，作用显着减弱，故推测其\"补血\"作用，可能与脾脏有关。此时白细胞则有减少倾向。北党参据云无此作用。党参浸液1：40在试管内无溶血现象，但与红细胞作用后，可变色，发生浑浊、沉淀。"}]},{"ID":"20240830141708-u9cnkza","Type":"NodeParagraph","Properties":{"id":"20240830141708-u9cnkza","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②对血糖的影响"}]},{"ID":"20240830141708-qrj3w54","Type":"NodeParagraph","Properties":{"id":"20240830141708-qrj3w54","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"对兔腹部皮下注射党参浸膏，可使血糖升高；但如注射发酵后的浸膏或灌胃给药，则无比作用，故认为其升高血糖乃因根中含多量糖分所致；它也不能抑制因注射利尿素而发生的神经性高血糖。据初步试验，北党参灌胃，能升高血糖。"}]},{"ID":"20240830141708-70m29cv","Type":"NodeParagraph","Properties":{"id":"20240830141708-70m29cv","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"③降压作用"}]},{"ID":"20240830141708-d0qo5wo","Type":"NodeParagraph","Properties":{"id":"20240830141708-d0qo5wo","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"醇、水浸膏静脉或腹腔注射，能降低麻醉犬的血压，据初步分析，认为是属于末梢性的；并有某些抗肾上腺素作用；其水浸液或醇、水浸出液也有降低麻醉动物血压的作用，并能抑制离体蟾蜍心脏。对慢性高血压犬，每日灌服水浸液4克（生药）/公斤，未见有降压作用。"}]},{"ID":"20240830141708-0d02uhq","Type":"NodeParagraph","Properties":{"id":"20240830141708-0d02uhq","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"同属植物的根的提取物或总甙，长期（40天）喂兔，可增加红细胞敷（17.5％），增加体重（23％）；对松节油引起的白细胞增多症有预防及治疗功效；长期口服，内脏器官未发现有何病理改变。总甙予小鼠口服，小量可增强呼吸，大量可降低水合氯醛之麻醉：对士的宁反似有某些拮抗作用。"}]},{"ID":"20240830141708-nssiyr8","Type":"NodeParagraph","Properties":{"id":"20240830141708-nssiyr8","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【炮制】党参：洗净泥沙后润透去芦，切片或切段，晒干。炒党参：将麸皮置于加热之锅内，至锅上起烟时，加入党参片，拌炒至深黄色，取出筛去麸皮，放凉。（每党参100斤，用麸皮20斤）"}]},{"ID":"20240830141708-l40mifq","Type":"NodeParagraph","Properties":{"id":"20240830141708-l40mifq","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830141708-r4t3vva","Type":"NodeParagraph","Properties":{"id":"20240830141708-r4t3vva","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"甘，平。"}]},{"ID":"20240830141708-sftu0su","Type":"NodeParagraph","Properties":{"id":"20240830141708-sftu0su","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"甘，平。\""}]},{"ID":"20240830141708-0hoxswd","Type":"NodeParagraph","Properties":{"id":"20240830141708-0hoxswd","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"甘，平，无毒。\""}]},{"ID":"20240830141708-9n83xez","Type":"NodeParagraph","Properties":{"id":"20240830141708-9n83xez","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【归经】《得配本草》：\"入手、足太阴经气分。\""}]},{"ID":"20240830141708-u05in8z","Type":"NodeParagraph","Properties":{"id":"20240830141708-u05in8z","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830141708-z73ms50","Type":"NodeParagraph","Properties":{"id":"20240830141708-z73ms50","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"补中，益气，生津。治脾胃虚弱，气血两亏，体倦无力，食少，口渴，久泻，脱肛。"}]},{"ID":"20240830141708-eyfpmlb","Type":"NodeParagraph","Properties":{"id":"20240830141708-eyfpmlb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"清肺。\""}]},{"ID":"20240830141708-3ku6utc","Type":"NodeParagraph","Properties":{"id":"20240830141708-3ku6utc","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"补中益气，和脾胃，除烦渴。\""}]},{"ID":"20240830141708-57cv8fu","Type":"NodeParagraph","Properties":{"id":"20240830141708-57cv8fu","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"③《纲目拾遗》：\"治肺虚，益肺气。\""}]},{"ID":"20240830141708-k4s6vdi","Type":"NodeParagraph","Properties":{"id":"20240830141708-k4s6vdi","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"④《科学的民间药草》：\"补血剂。适用于慢性贫血，萎黄病，白血病，腺病，佝偻病。\""}]},{"ID":"20240830141708-8gdctco","Type":"NodeParagraph","Properties":{"id":"20240830141708-8gdctco","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"⑤《中药材手册》：\"治虚劳内伤，肠胃中冷，滑泻久痢，气喘烦渴，发热自汗，妇女血崩、胎产诸病。\""}]},{"ID":"20240830141708-0dzm16k","Type":"NodeParagraph","Properties":{"id":"20240830141708-0dzm16k","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱，大剂1～2两；熬膏或入丸、散。"}]},{"ID":"20240830141708-1qzoojo","Type":"NodeParagraph","Properties":{"id":"20240830141708-1qzoojo","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830141708-mmy3o0n","Type":"NodeParagraph","Properties":{"id":"20240830141708-mmy3o0n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"有实邪者忌服。"}]},{"ID":"20240830141708-dlmnsv4","Type":"NodeParagraph","Properties":{"id":"20240830141708-dlmnsv4","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"《得配本草》：\"气滞、怒火盛者禁用。\""}]},{"ID":"20240830141708-z4h4n7f","Type":"NodeParagraph","Properties":{"id":"20240830141708-z4h4n7f","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830141708-3jq529w","Type":"NodeParagraph","Properties":{"id":"20240830141708-3jq529w","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①清肺金，补元气，开声音，助筋力：党参一斤（软甜者，切片），沙参半斤（切片），桂圆肉四两。水煎浓汁，滴水成珠，用磁器盛贮.每用一酒杯，空心滚水冲服，冲入煎药亦可。（《得配本草》上党参膏）"}]},{"ID":"20240830141708-yshojc0","Type":"NodeParagraph","Properties":{"id":"20240830141708-yshojc0","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②治泻痢与产育气虚脱肛：党参（去芦，米炒）二钱，炙耆、白术（净炒）、肉蔻霜、茯苓各一钱五分，怀山药（炒）二钱，升麻（蜜炙）六分，炙甘草七分。加生姜二片煎，或加制附子五分。（《不知医必要》参耆白术汤）"}]},{"ID":"20240830141708-us8z0rf","Type":"NodeParagraph","Properties":{"id":"20240830141708-us8z0rf","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"③治服寒潦竣剂，以致损伤脾胃，口舌生疮；党参（焙）、黄芪（炙）各二钱，茯苓一钱，甘草（生）五分，白芍七分。白水煎，温服。（《喉科紫珍集》参耆安胃散）"}]},{"ID":"20240830141708-a0k292m","Type":"NodeParagraph","Properties":{"id":"20240830141708-a0k292m","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"④治小儿口疮：党参一两，黄柏五钱。共为细末，吹撒患处。（《青海省中医验方汇编》）"}]},{"ID":"20240830141708-fq1hatb","Type":"NodeParagraph","Properties":{"id":"20240830141708-fq1hatb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"⑤抑制或杀灭麻风杆菌：党参、重楼（蚤休）、刺包头根皮（楤木根皮）各等量。将党参、重楼研成细粉；再将刺包头根皮加水适量煎煮三次，将三次煎液浓缩成一定量（能浸湿党参、重楼细粉）的药液，加蜂蜜适量.再将重楼、党参细粉倒入捣匀作丸，每丸三钱重；亦可作成膏剂。日服三次，每次一丸，开水送服。（北京中医学院《新医疗法资料汇编》）"}]},{"ID":"20240830141708-7glyghp","Type":"NodeParagraph","Properties":{"id":"20240830141708-7glyghp","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830141708-hdiujl8","Type":"NodeParagraph","Properties":{"id":"20240830141708-hdiujl8","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"上党人参，虽无甘温峻补之功，却有甘平清肺之力，亦不似沙参之性寒专泄肺气也。\""}]},{"ID":"20240830141708-rm0vx5c","Type":"NodeParagraph","Properties":{"id":"20240830141708-rm0vx5c","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"上党参，得黄耆实卫，配石莲止痢，君当归活血，佐枣仁补心。补肺蜜拌蒸熟；补脾恐其气滞，加桑皮效分，或加广皮亦可。\""}]},{"ID":"20240830141708-474g2dt","Type":"NodeParagraph","Properties":{"id":"20240830141708-474g2dt","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"党参力能补脾养胃，润肺生津，健运中气，本与人参不甚相远。其尤可贵者，则健脾运而不燥，滋胃阴而不湿，润肺而不犯寒凉，养血而不偏滋腻，鼓舞清阳，振动中气而无刚燥之弊。且较诸辽参之力量厚重，而少偏于阴柔，高丽参之气味雄壮，而微嫌于刚烈者，尤为得中和之正，宜乎五脏交受其养，而无往不宜也。特力量较为薄弱，不能持久，凡病后元虚，每服二、三钱，止足振动其一日之神气，则信乎和平中正之规模，亦有不耐悠久者。然补助中州而润泽四隅，故凡古今成方之所用人参，无不可以潞党参当之，即凡百证治之应用人参者，亦无不可以潞党参投之"}]},{"ID":"20240830141708-h99hch0","Type":"NodeParagraph","Properties":{"id":"20240830141708-h99hch0","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240830141708-35qxsz1","Type":"NodeParagraph","Properties":{"id":"20240830141708-35qxsz1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"同属植物川党参的根，亦同等使用，商品称\"川党\"。根类圆柱形，末端稍细，很少有分歧，长约15～35厘米，直径约5～25毫米。根头部呈\"狮子盘头\"状。表面灰黄色，有明显纵皱沟，遍体或只顶端有较稀的横纹。支根脱落处有溢出乳汁而凝成的黑褐色类胶状物。质较坚实，易折断，断面裂隙少，木部黄色，其外围有一圈浅棕色环。皮部淡黄色。气香味甜。"}]},{"ID":"20240830141708-3c3o7ge","Type":"NodeParagraph","Properties":{"id":"20240830141708-3c3o7ge","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"产四川、湖北等地。"}]},{"ID":"20240830141708-ooig1eb","Type":"NodeParagraph","Properties":{"id":"20240830141708-ooig1eb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"此外，同属植物中供党参药用的尚有：管花党参（又名甜党、叙党，产四川、贵州）；绿花党参（产四川）；秦岭党参（又名大头党参，产陕西、甘肃）；新疆党参（产新疆）；柴党（产四川、甘肃）等。"}]},{"ID":"20240830141708-lht4fl0","Type":"NodeParagraph","Properties":{"id":"20240830141708-lht4fl0","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830141708-7t84y60","Type":"NodeParagraph","Properties":{"id":"20240830141708-7t84y60","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"党参《中华本草》"}]},{"ID":"20240830141708-2fm1yvr","Type":"NodeParagraph","Properties":{"id":"20240830141708-2fm1yvr","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草从新》"}]},{"ID":"20240830141708-l9cylvm","Type":"NodeParagraph","Properties":{"id":"20240830141708-l9cylvm","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【拼音名】DǎnɡShēn"}]},{"ID":"20240830141708-a02i033","Type":"NodeParagraph","Properties":{"id":"20240830141708-a02i033","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【英文名】RootofPiloseAsiabell,PiloseAsiabellRootModerateAsiabellRootSzechwonTangshenRoot"}]},{"ID":"20240830141708-bb99dbg","Type":"NodeParagraph","Properties":{"id":"20240830141708-bb99dbg","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【别名】上党人参、防风党参、黄参、防党参、上党参、狮头参、中灵草"}]},{"ID":"20240830141708-y1fwbq5","Type":"NodeParagraph","Properties":{"id":"20240830141708-y1fwbq5","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830141708-qd17ygz","Type":"NodeParagraph","Properties":{"id":"20240830141708-qd17ygz","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"药材基源：为桔梗科植物常参、素花党参、川党参、管花党参、球花党参、灰毛党参的根。"}]},{"ID":"20240830141708-ig9anmi","Type":"NodeParagraph","Properties":{"id":"20240830141708-ig9anmi","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Codonopsispilosula(Franch.)Nannf.[CampanumoeapilosulaFranch.]2.Codonopsispilosula(Frach.)Nannf.Var.modesta(Nannf.)L.T.Shen3.CodonopsistangshenOliv.4.CodonopsistubulosaKom.5.CodonopsissubglobosaW.W.Smith6.CodonopsiscanescensNannf."}]},{"ID":"20240830141708-gnr9er2","Type":"NodeParagraph","Properties":{"id":"20240830141708-gnr9er2","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"采收和储藏：移栽后第2或第3年9-10月，将根挖出，洗净，晒4-6h，然后用绳捆起，揉搓使根充实，经反复3-4次处理后，即可扎成小捆，贮藏或进行加工。贮藏期间宜放于凉爽干澡处，避免虫蛀。每1hm2产干货3750-6000kg。"}]},{"ID":"20240830141708-e43zvey","Type":"NodeParagraph","Properties":{"id":"20240830141708-e43zvey","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830141708-rx5y89n","Type":"NodeParagraph","Properties":{"id":"20240830141708-rx5y89n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.党参多年生草。根长圆柱形，直径1-1.7cm，顶羰有一膨大的根头，具多数瘤状的茎痕，外皮乳黄色至淡灰棕色，有纵横皱纹。茎缠绕，长而多分枝，下部疏被白以粗糙硬毛；上部光滑或近光滑。叶对生、互生或假轮生；叶柄长0.5-2.5cm；叶片卵形广卵形，长1-7cm，宽0.8-5.5cm，先端钝或尖，基部截形或浅心形，全缘或微波状，上面绿色，被粗伏毛，下面粉绿色，被疏柔毛。花单生，花梗细；花萼绿色，裂片5，长圆状披针形，长1-2cm，先端钝，光滑或稍被茸毛；花冠阔钟形，直径2-2.5cm，淡黄绿，有淡紫堇色斑点，先端5裂，裂片三角形至广三角形，直立；雄蕊5，花丝中部以下扩大；子房下位，3室，花柱短，柱头3，极阔，呈漏斗状。蒴果圆锥形，有宿存萼。种子小，卵形，褐色有光泽。花期8-9月，果期9-10月。"}]},{"ID":"20240830141708-2smjege","Type":"NodeParagraph","Properties":{"id":"20240830141708-2smjege","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.素药党参本变种与党参的主要区别生于：全体近于光滑无毛；花萼裂片较小，长约10mm。"}]},{"ID":"20240830141708-9zc0tou","Type":"NodeParagraph","Properties":{"id":"20240830141708-9zc0tou","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.川党参本种与前两种的区别在于；茎下部的叶基部楔形或较圆钝，仅偶尔呈心脏形；花萼仅紧贴生于子房最下部，子房对花萼而方几乎为全上位。花、果期7-10月。"}]},{"ID":"20240830141708-6ejqs6i","Type":"NodeParagraph","Properties":{"id":"20240830141708-6ejqs6i","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"4.管花党参本种与前三种的区别在于：茎不缠绕，多攀援或蔓生状。叶柄较短，长5mm以下。花萼贴生于子房中部，裂片阔卵形，长1.2mm，宽约8mm，长不及花冠的一半；花冠管状；花丝被毛，花药龙骨状。花、果期7-10月。"}]},{"ID":"20240830141708-vijhliz","Type":"NodeParagraph","Properties":{"id":"20240830141708-vijhliz","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.球花党参本种与前四种的区别在于：叶片较小，长宽均在3cm，以下。花萼贴生至子房端，有刺毛，裂片卵圆形或菱状卵圆形，裂片间弯缺宽钝，有锯齿及刺毛；花冠球状钟形，黄色，而先端带深红紫色。花、果期7-10月。"}]},{"ID":"20240830141708-kofzz4n","Type":"NodeParagraph","Properties":{"id":"20240830141708-kofzz4n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"6.灰毛党参本种与前五种的区别在于：茎长25-85cm。分枝多，近木质。植株密被白毛，使杆株呈灰色。叶在主茎上互生，在侧枝上近于对生，叶片较小，长宽可达1.5cm×1cm以下。花萼外面密被白色长硬毛；花冠长一般不超过2cm。花、果期7-10月。"}]},{"ID":"20240830141708-96jd3p7","Type":"NodeParagraph","Properties":{"id":"20240830141708-96jd3p7","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830141708-fdxnled","Type":"NodeParagraph","Properties":{"id":"20240830141708-fdxnled","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于山地灌木丛中及林缘。"}]},{"ID":"20240830141708-k0ber6j","Type":"NodeParagraph","Properties":{"id":"20240830141708-k0ber6j","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.生于海拔1500-3200m间的山地林下、林边及灌丛中。"}]},{"ID":"20240830141708-yq3omla","Type":"NodeParagraph","Properties":{"id":"20240830141708-yq3omla","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.生于海拔900-2300m的山地林边灌丛中，现大量栽培。"}]},{"ID":"20240830141708-bmi2hn2","Type":"NodeParagraph","Properties":{"id":"20240830141708-bmi2hn2","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.生于海拔2500-3500m的山地草坡多石砾处或沟边灌丛中。"}]},{"ID":"20240830141708-yj3vabn","Type":"NodeParagraph","Properties":{"id":"20240830141708-yj3vabn","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"6.生于海拔3000-3400间的山地草坡、河滩多石或向阳干旱处。"}]},{"ID":"20240830141708-0vrf9ef","Type":"NodeParagraph","Properties":{"id":"20240830141708-0vrf9ef","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北及陕西、宁夏、甘肃、青海、河南、四川、云南、西藏等地。"}]},{"ID":"20240830141708-t6yijw6","Type":"NodeParagraph","Properties":{"id":"20240830141708-t6yijw6","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.分布于山西中部、陕西南部、甘肃、青海、四川西北部。"}]},{"ID":"20240830141708-az64hye","Type":"NodeParagraph","Properties":{"id":"20240830141708-az64hye","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.分布于陕西、湖北、湖南、四川、贵州等地。"}]},{"ID":"20240830141708-bqotqxg","Type":"NodeParagraph","Properties":{"id":"20240830141708-bqotqxg","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"4.分布于四川、贵州、云南。"}]},{"ID":"20240830141708-k8y371o","Type":"NodeParagraph","Properties":{"id":"20240830141708-k8y371o","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.分布于四川西部、云南西北部。"}]},{"ID":"20240830141708-k7nj37x","Type":"NodeParagraph","Properties":{"id":"20240830141708-k7nj37x","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"6.分布于青海、四川、西藏等地。"}]},{"ID":"20240830141708-5ujb3aw","Type":"NodeParagraph","Properties":{"id":"20240830141708-5ujb3aw","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830141708-oqyi2s7","Type":"NodeParagraph","Properties":{"id":"20240830141708-oqyi2s7","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"生物学特性党参喜冷凉气候，忌高温。幼苗期喜阴，成株喜阳光。以土层深厚，排水良好，富含腐殖质的砂质壤土栽培为宜。不宜粘土、低洼地、盐碱土和连作地上种植。"}]},{"ID":"20240830141708-kzv0puj","Type":"NodeParagraph","Properties":{"id":"20240830141708-kzv0puj","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。种子发芽率80%以下，贮放超过1年的种子，发芽率则显着降低，故宜用当年或上一年采收的种子。常采用育苗移栽法，少用直播。播种期从早春解冻后至冬初封冻前均可进行，撒播或条播，条播行距10-15cm，播种深度0.5-1cm。每1hm2播种量7.5-15kg。播后参畦用玉米杆、谷草或松杉枝等覆盖保温，气温在18-20℃左右，播后10d左右出苗。苗高约5cm，时，逐渐除去遮盖物，并及时注意除草浇水。移栽，参苗培育1年，于秋季或春季幼苗萌芽前移栽。按行株距20-30cm，开沟，将种根按株距6-10cm斜栽于沟内，覆土。"}]},{"ID":"20240830141708-94mogym","Type":"NodeParagraph","Properties":{"id":"20240830141708-94mogym","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"田间管理除草是保证常参产量的主要措施之一，因此必须勤除杂草。当苗高15cm时，施人粪尿，每1hm2-15000-22500kg，施后培土。赤可施过磷酸钙22.5kg。苗高30cm时搭，架，使茎蔓攀援生长。雨季注意排水，以免烂根。"}]},{"ID":"20240830141708-2k14b7r","Type":"NodeParagraph","Properties":{"id":"20240830141708-2k14b7r","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"病虫防治病害有犭病，一般东北、化工北地区秋季发生较重，发病期间喷50%二硝散200倍液或25%粉锈宁1000倍液，每隔7-10d1次，连续喷2-3次。根腐病，低洼地和多雨季节溶易发生。防治方法，忌连作，筑高畦，开深沟，有利排水。发病期可用50%托布津800倍液浇灌。霜霉病，可喷40%霜疫灵300倍液或70%百菌清1000倍液。虫害有小地老越、非洲蝼蛄等为害。"}]},{"ID":"20240830141708-bdhvanf","Type":"NodeParagraph","Properties":{"id":"20240830141708-bdhvanf","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830141708-u0uyed1","Type":"NodeParagraph","Properties":{"id":"20240830141708-u0uyed1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）党参根略呈圆柱形、纺锤状圆柱形或长圆锥形，少分枝或中部以下面分枝，长15-45cm，直径0.45-2.5cm。表面灰黄色、灰棕色或红棕色，有不规则纵沟及皱缩，疏生横长皮孔，上部多环状皱纹，近根头处尤密；根头有多数突起的茎痕及芽痕，集成球状，习称“狮子盘头”；根破碎处有时可见黑褐色胶状物，系乳汁溢出凝成（俗稀油点）。质柔润或坚硬，断面较平整，有的呈角质样，皮部较厚，黄白色、淡棕色或棕褐色，常有裂隙，与木部交接处有一深棕色环，木部约占根直径的1/3-1/2，淡黄色。气微香，味甜，嚼之无渣。"}]},{"ID":"20240830141708-o20wkxz","Type":"NodeParagraph","Properties":{"id":"20240830141708-o20wkxz","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（2）素花常参根稍短，长不超过30cm，少分枝。表面灰棕色，栓皮粗糙，多缢或扭曲，上部环纹密集；油点多。质坚韧，断面不甚平整。嚼之有渣。"}]},{"ID":"20240830141708-i9frpkd","Type":"NodeParagraph","Properties":{"id":"20240830141708-i9frpkd","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（3）川党参根下部很少分枝。表面灰棕色，栓皮常局部脱落，上部环纹较稀。断面皮部肥厚，裂隙较少。味微甜、酸。"}]},{"ID":"20240830141708-6o509z7","Type":"NodeParagraph","Properties":{"id":"20240830141708-6o509z7","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（4）管花党参根一分枝或下部略有分枝。表面落皱缩成纵沟，疏生横长皮孔，上部环纹稀疏；根头有球状狮子盘头，破碎处有棕黑色胶状物溢出。断面粉质或糖样角质。气微香，味微甜。（5）球花常参根肥大，长20-43cm，直径1-3cm。表面有皱缩的纵沟，常扭曲，上部有密环纹，并自中部向上至根头部渐细，习稀“蛇蚓头”；根茎具多数细小的茎痕或芽痕。的1/2，具辐射状排列的细小裂隙。具特异臭气。"}]},{"ID":"20240830141708-db06kuz","Type":"NodeParagraph","Properties":{"id":"20240830141708-db06kuz","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（6）灰毛常参根下部有的分仅。断面略显粉性，可见针晶样亮点。具特异气味。"}]},{"ID":"20240830141708-o1in16t","Type":"NodeParagraph","Properties":{"id":"20240830141708-o1in16t","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"以根条肥大粗壮、肉质柔阔、香气浓、甜味重，嚼之无潭者为佳。"}]},{"ID":"20240830141708-uca4sl4","Type":"NodeParagraph","Properties":{"id":"20240830141708-uca4sl4","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"显微鉴别根横切面：（1）党参木栓细胞5-8列，径向壁具纵条纹；木栓石细胞单个散在或数个成群，位于木栓层外侧或嵌于木栓细胞间。皮层狭窄，细胞多不规则或破碎，挤压成颓废组织；有乳管群分布。韧皮部宽广，乳汁管群与筛管群相伴，作径向排列，切微略呈多个断续的同心环，乳汁管含淡黄色粒状分泌物：韧皮射线5-9列细胞，外侧常现裂隙，形成层成环。木质部约占根半径的1/2-4/7；导管单个或5-10个相聚，径向排列成1（-2）列；木射线宽广，常破碎而形成较大的裂隙；木向排列成1（-2）；木射线宽广，常破碎而形成较大的裂隙；木薄壁细胞排列紧密；初生木质部三原型。本品薄壁细胞充满菊糖及少数淀粉粒。"}]},{"ID":"20240830141708-mvnm8s4","Type":"NodeParagraph","Properties":{"id":"20240830141708-mvnm8s4","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（2）素花党参木栓层外有较厚的木栓石细胞环带，有的局部脱落；韧皮部约占根半径的2/3；木质部小，导管大小不一，常径同相间排列似年轮状。本品薄壁细胞含淀粉粒及少量菊糖。"}]},{"ID":"20240830141708-z8q5ub8","Type":"NodeParagraph","Properties":{"id":"20240830141708-z8q5ub8","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（3）川党参木栓细胞的稍增厚，具纹孔；木栓石细胞数列排成断续的环带，有的嵌于木栓细胞间；韧皮部约占根半径的2/3；木质部较小，木薄壁细胞有的增厚。本品薄壁细胞含淀粉粒，多为复粒；菊糖存在于裂隙处及导管中。（4）管花常参木栓细胞3-7列；韧皮部薄壁细胞间有明显的细胞隙；木质部占根半径的1/3-1/4，导管多单个散在；本品薄壁细胞充满淀粉粒。韧皮部的淀粉粒直径13-16μm，多为复粒，木质部的淀粉粒直径4-7μm，多为单粒；菊糖主要分布于木质部，含菊糖细胞常与导管伴生。"}]},{"ID":"20240830141708-5jbi7fu","Type":"NodeParagraph","Properties":{"id":"20240830141708-5jbi7fu","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（5）球花党参木栓细胞5-10列；韧皮部占根半径的5/8；射线宽5-7列细胞；木质部约占根半径的3-8，木薄壁细胞稍增厚；本品薄壁细胞含大量菊糖，存在于导管周围薄壁胞中的团导体较小。"}]},{"ID":"20240830141708-eycfdod","Type":"NodeParagraph","Properties":{"id":"20240830141708-eycfdod","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（6）灰毛党参木栓细胞切向延长，达164μm；韧皮部与木质部近等径；木射线宽广，韧皮射线狭窄，仅2-4列细胞。"}]},{"ID":"20240830141708-lx5p85x","Type":"NodeParagraph","Properties":{"id":"20240830141708-lx5p85x","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"粉末特征：（1）党参黄白色。①菊糖多，用冷水合氯醛液装置，菊糖团块略呈扇形。类圆形或半圆形，表面具放射状线纹。②石细胞较多，单个散在或数个成群，有的与木栓细胞相嵌；石细胞多角形，类方形，长方形或不规则形，直径24-51μm，纹孔稀疏。③具缘纹孔、网纹、风状具缘纹也导管及梯纹导管，直径21-80μm导管分子长80-88μm。④乳汁管为有节联结乳汁管，直径12-15μm，管中及周围细胞中充满油滴状物及细颗粒。⑤木栓细胞棕黄色，表面观长方形、斜方形或类多角形，垂周壁微波状弯曲，木化，有纵条纹。此外，可见少数淀粉粒。"}]},{"ID":"20240830141708-ctcjoyj","Type":"NodeParagraph","Properties":{"id":"20240830141708-ctcjoyj","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（2）素花党参淡黄色。①石细胞极多，直径19-60μm，长35-107（-256）μm，壁厚薄不等，纹孔稀疏，孔沟明显，有的孔沟密集并纵横交错成网状、蜂窝状。②木薄壁细胞梭状，次生壁网状及梯状增厚。③色素块黄色或棕红色，有的充塞于导管中。④淀粉粒单粒，圆球形或卵圆形。"}]},{"ID":"20240830141708-gx96rdt","Type":"NodeParagraph","Properties":{"id":"20240830141708-gx96rdt","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（3）川党参类白色。①石细胞较少，直径25-36μk，长60-76μm，壁厚3-5（-8）μm，有的中部壁较厚，使胞腔呈哑铃状，孔沟明显，嗽叭状或漏斗状。②木薄壁细胞梭形，有的平周壁上具网状纹理，有的垂周壁呈连珠状。有的纹孔、孔沟明显。③淀粉粒较多，单粒圆球形、类圆形，直径6-20μm，脐点点状或不明为；复粒由2-7分粒组成。"}]},{"ID":"20240830141708-8wpushk","Type":"NodeParagraph","Properties":{"id":"20240830141708-8wpushk","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（4）管花党参白色。①淀粉粒极多，单粒圆球形或椭圆形，直径6-30μm，脐点裂缝状、点状、星状，大粒层纹明显；半复粒有2-3个脐点；复粒由2分粒线成，大小悬殊。②木栓细胞方形或长方形，长宽可达80-100μm，壁木化。③木薄壁细胞长方形，次生壁呈梯状、网状或螺状增厚。"}]},{"ID":"20240830141708-kswx1tm","Type":"NodeParagraph","Properties":{"id":"20240830141708-kswx1tm","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（5）球花党参淡黄白色。①木栓细胞表面观长方形或斜方形，有的垂周壁连珠状增厚，孔沟明显。②木薄壁细胞长形或短梭形，次生壁梯状或网状增厚，侧壁呈连球状。③射线细胞排列规则，径向面观细胞长方形，上、下端径向壁有的分离，或连珠状增厚。④厚壁细胞石细胞状，纹孔、孔沟明显，壁非木化。⑤色素块易风，棕风色或鲜黄色。"}]},{"ID":"20240830141708-llcovdb","Type":"NodeParagraph","Properties":{"id":"20240830141708-llcovdb","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"（6）灰毛党参淡黄色。①木栓细胞表面观类长方形、狭长方形或类方形垂周壁可见条纹。②木薄壁细胞细梭形，次生壁呈梯状或网状增厚，侧壁呈连球状。③无色素块。④余与球花党参相似。"}]},{"ID":"20240830141708-ysfv4m0","Type":"NodeParagraph","Properties":{"id":"20240830141708-ysfv4m0","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830141708-y6j8dqp","Type":"NodeParagraph","Properties":{"id":"20240830141708-y6j8dqp","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.3.49：1：0.53：0.48组成，相对分子质量10500；CP、是由葡萄糖、半乳糖、果糖、阿拉伯糖、甘露糖、核糖（ribose）、木糖按摩糖、半乳糖、果糖、阿拉伯糖、甘露糖、核糖（rbioes）、木糖按摩尔比1.77：1：0.43：0.26：0.12：0.023：0.013组成，相对分子质量12000；CP3是由葡萄糖、果糖、甘露糖、半乳糖、阿拉伯糖、核糖、木糖按摩尔比5.94：4.43：1.07：1.072：0.20：0.13组成，相对分子质量是14000；CP4是由葡萄糖、半乳糖、阿拉伯糖、鼠李糖（rhamnose）、果糖、甘露糖、木糖按摩尔比1.5：1：0.6：0.46：0.29：0.13：0.06组成，相对分子质量79000[4]。根还含甙类成分：丁香甙（syringin），正已基-β-D-吡喃葡萄糖甙（n-hexylβ-D-glucopyranoside），乙基-α-D-呋喃果糖甙（ethylα-D-fructofura-noside）[5]，党参甙（tangshenoside）Ⅰ生物碱和含氮成分：胆碱（choline）[7]，黑麦草碱（perlolyrine）[8]，脲基甲酸正丁酯（n-butylallophanate）[9]，焦谷氨酸N-果糖甙（pyro-glutamicacidN-furcto-side）[10]，烟酸（nicotinicacid），5-羟基-2-吡啶甲醇（5-hydroxy-2-pyridinemethanol）[5]以及赖氨酸（lysine），苏氨酸（threonien），缬氨酸（valine），蛋氨酸（methionine），异亮氨酸（sioleucine），亮氨酸（leucine），苯丙氨酸（phenylalanine），天冬气酸（asparticacid），组氨酸（histidine），丝氨酸（serine）、谷氨酸（glucamicacid），甘氨酸（glycine）、丙氨酸（alanine），胱氨酸（cystine），酷氨酸（tyrosine），粗氨酸（arginine），脯氨酸（proline）等17种氨基酸[1]；甾醇及三萜成分：蒲公英赛醇（taraxerol），乙酸蒲公英甾醇酯（taraxerlac-etate），无羁（frideelin）[9.11]，（α-spinasterol），α-菠菜甾醇β-D-葡萄糖甙（α-spinasteryl-β-D-glucoside），7-豆甾烯醇（stigmast-7-en-3β-ol），7-豆甾烯醇-β-D-葡萄糖甙（△7-sitgmas-tenyl-β-D-glucoside），豆甾醇（stigmasterol），豆甾醇-β-D-葡萄糖甙（stigmasetyl-β-D-glucoside）α-菠菜甾酮（stigmasta-7,22-dien-3-one），5，22-豆甾二烯-3-酮（stigmasta-5,22-dien-3-one）[12，13]；其他成分：丁香醛（sy-ringaldehyde），香草酸（vanillicacid），2-呋羟酸（2-furancar-boxylicacid），苍术内酯（atractylenolide）Ⅱ及Ⅲ[3]，5-羟甲基糠醛（5-hydroxymethl-2-furaldehyde）[7，14]，5-甲氧基甲基糠醛（5-metyoxymethy-2-furaldehyde）[14]，桂冠榈酸甲酯（methylpalmitate）[12]等以及铁、铜、钴、锰、锌、镍、锶、铝、钒、氟等无机元素[1，15]。根另含挥发油，一种报道称：油中主成分为棕榈酸甲酯，占总油量的28.04%，还含α蒎烯（α-pinene），2，4-壬二烯醛（nona-2,4-dienal），龙脑（borenol），ξ-愈创木烯（ξ-guaiene），α-姜黄烯（α-curcumene）等32种成分[16]；另一报道称；油中含66个成分，主成分是：棕榈酸（palmiticacid），占总油量的38%，11，14-二十碳二烯酸甲酯（methyl11,14-eicosadenoate）占9.89%，邻-（邻甲氧基苯氧基）苯酚[O-（O-methoxyphenoxy）phenol]占5.74%[17]。"}]},{"ID":"20240830141708-rdejfoj","Type":"NodeParagraph","Properties":{"id":"20240830141708-rdejfoj","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.素花党参根含苏氨酸、缬氨酸、蛋氨酸、异亮氨酸、亮氨酸、苯丙氨酸、组氨酸、门冬氨酸、丝氨酸、甘氨酸、谷氨酸、丙氨酸、胱氨酸、酪氨酸、赖氨酸、粗氨酸、脯氨酸等17种氨基酸[18]。"}]},{"ID":"20240830141708-rxgnvy5","Type":"NodeParagraph","Properties":{"id":"20240830141708-rxgnvy5","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.川党参根含多糖[2]，蒲公英赛醇，乙酸蒲公英甾醇酯，无羁萜，豆甾醇[9]，丁香甙[20]，党参甙Ⅰ、Ⅱ[20]、Ⅲ、Ⅳ[21]，（E）-2-已烯基-β-槐糖甙[（E）-2-hexenyl-β-sophoroside]，（E）-2-已烯基-α-L-喃阿拉伯糖基（1→6）-β-D-吡喃葡萄糖甙[（E）-2-hexenyl-α-L-arabinopyranosyl（1→6）-β-D-glucopyranoside]，已基-β-龙胆二糖甙（hexyl-β-gentiobioside），已基-β-槐糖甙（hexyl-β-soporoside），（6R，7R）-E，E-十四碳-4，12-二烯-8，10-块-1，6，7-三醇-6-O-β-D-吡喃葡萄糖甙[（6R，7R）-E，E-tetradeca-4,12-dien-8,10-diyne-1，6，7-triol-6-O-β-D-glucopyranoside][21]，常参内酯（codonolac-tone）即是苍术内酯Ⅲ，党参酸（codopiloicacid）[22]以及天冬氨酸、苏氨酸、丝氨酸、甘氨酸、谷氨酸、丙氨酸、胱氨酸、缬氨酸、蛋氨酸、异亮氨酸、亮氨酸、酪氨酸、苯丙氨酸、赖氨酸、组氨酸、粗氨酸、脯氨酸等氨基[18]和铁、铜、钴、锰锌、镍、砷、矾、钼、氟、等无机元素[15]。"}]},{"ID":"20240830141708-7u8vhh2","Type":"NodeParagraph","Properties":{"id":"20240830141708-7u8vhh2","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"4.管花党参根含铁、铜钴、锰、锌镍、砷、钒、钼、氟等无机元素[15]、多糖[2]。"}]},{"ID":"20240830141708-l658hw8","Type":"NodeParagraph","Properties":{"id":"20240830141708-l658hw8","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.球花党参根含莆公英赛醇、乙醇蒲公英赛醇酯、无羁萜、豆甾醇[19]、多糖[2]、苍术内酯Ⅲ[23]和天冬氨酸、苏氨酸、丝氨酸、甘氨酸、谷氨酸、丙氨酸、胱氨酸、缬氨酸、蛋氨酸、异亮氨酸、亮氨酸、酪氨酸、苯丙氨酸、赖氨酸、组氨酸、精氨酸、脯氨酸等氨基酸[18]。"}]},{"ID":"20240830141708-jadzrpo","Type":"NodeParagraph","Properties":{"id":"20240830141708-jadzrpo","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"6.灰毛党参根含多糖[2]、苍术内酯Ⅲ[23]。"}]},{"ID":"20240830141708-hr977cy","Type":"NodeParagraph","Properties":{"id":"20240830141708-hr977cy","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830141708-p9go02v","Type":"NodeParagraph","Properties":{"id":"20240830141708-p9go02v","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.对中枢神经系统的影响：1.1．对动物学习记忆的影响：用小鼠跳台法和大鼠操作式条件反应-固定比率操作观察了党参20%乙醇提取物对学习记忆的影响，结果表明党参可拮抗东莨菪碱造成的小鼠记忆获得不良，改善亚硝酸钠造成的小鼠记忆巩固障碍及40%乙醇造成的小鼠记忆再现缺损，部分对抗东莨菪碱对大鼠固定比率操作的抑制。党参进一步分离的正丁醇部分可以重现上述作用。党参正丁醇部分对M胆碱能受体无亲和力，但可使中枢M胆碱受体密度显着增高。但它既不能对抗东莨菪碱所致小鼠大脑皮层及海马Ach含量的降低。其本身也不能提高皮层和海马的Ach含量。这些结果提示党参对学习记忆确有改善作用，胆碱能通路可能是其发生作用的一个重要方面。党参煎剂，用Y水迷路法亦能增进和改善小鼠学习记忆过程，并能改善樟柳碱引起的记忆获得障碍的影响。"}]},{"ID":"20240830141708-wc6zfvu","Type":"NodeParagraph","Properties":{"id":"20240830141708-wc6zfvu","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.2．对自发活动的影响：用MK一ANIEX活动记录仪，同时记录2只小鼠在4分钟内的自发活动数。党参煎剂组：各组小鼠（n=22）分别用0.15、0.6g/10g及自来水灌胃，测定2小时后的自发活动数。结果党参对小鼠自发活动有抑制作用。"}]},{"ID":"20240830141708-wkldf3t","Type":"NodeParagraph","Properties":{"id":"20240830141708-wkldf3t","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.3．党参提取物对小鼠有协同小剂量氯丙嗪的镇静作用，但拮抗大剂量氯丙嗪的中枢抑制作用。党参水提物能延长低剂量（30mg/kg）戊巴比妥钠的小鼠睡眠时间，而醇提物则无此作用。但党参水提物和醇提物，均能使给予大剂量戊巴比妥纳小鼠的睡眠时间缩短。另外党参提取物对印防己毒素和戊四氮有一定的拮抗作用，使小鼠的惊厥和死亡发生时间延长。但对士的宁无明显的对抗作用。有报道党参对中枢神经系统抑制作用主要是其中所含的党参多糖。"}]},{"ID":"20240830141708-mygdaga","Type":"NodeParagraph","Properties":{"id":"20240830141708-mygdaga","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.4．党参提取物对家兔脑电图的影响：在带有埋藏电极的清醒家兔上，观察党参各部位提取物对皮层及皮层下脑电图的影响。结果党参各部位提取物对清醒家兔脑电图并不都有作用。脑室给药、部位Ⅱ、Ⅲ及水溶皂甙有作用。而静脉给药时，只有部位Ⅲ使清醒家兔脑电图出现高幅慢波。该部位Ⅲ中所含的皂甙是脂溶性的。党参部位提取物Ⅱ、Ⅲ及水溶性皂甙对下丘脑与海马的影响似大于皮层。部位Ⅲ及人参皂甙能显着地延长小鼠环己巴比妥的睡眠时间。"}]},{"ID":"20240830141708-wfjvi85","Type":"NodeParagraph","Properties":{"id":"20240830141708-wfjvi85","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的作用：2.1．对血液流变学的作用：取健康家兔，分别给与党参（水煎醇提制成1：1注射液）1ml/kg，对照用等量生理盐水，30分钟后测定血液流变学的各项指标。结果：党参组对体外血栓形成，用药前后比较有明显的抑制血栓形成（P＜0.005-0.001）。对血沉用药前后无明显改变，但红细胞压积用药前后分别为38.01±3.98和34.21±4.87（p＜0.005）。红细胞电泳、血浆比粘度等党参组用药前后均有显着差异（p＜0．001）。"}]},{"ID":"20240830141708-w28s8st","Type":"NodeParagraph","Properties":{"id":"20240830141708-w28s8st","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.2．抗缺氧作用：用水提醇沉法制得的党参注射液（每1ml相当生药1g），对小白鼠用药组腹腔注射0.2ml/10g常压耐缺氧有明显的对抗作用与腹腔注射生理盐水0.2ml/10g比较，p＜0.001。对异丙肾上腺素耗氧量亦有明显对抗作用，与盐水对照组比较p＜0.05。对氰化物或亚硝酸钠中毒，均有明显延长小鼠存活时间p＜0.001。对结扎小鼠两侧颈总动脉存活时间，党参组亦有十分显着延长存活时间p＜0.001。"}]},{"ID":"20240830141708-m9do7rj","Type":"NodeParagraph","Properties":{"id":"20240830141708-m9do7rj","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.3．对家兔和大鼠实验性急性心肌缺血影响：采用预防性给药和治疗性给药，观察心电图Ⅱ导联T波和S-T段的位移和心率的变化。结果表明，100%党参注射液对垂体所致的急性心肌缺血有一定的保护作用。"}]},{"ID":"20240830141708-3k82rm4","Type":"NodeParagraph","Properties":{"id":"20240830141708-3k82rm4","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.4．对动物微循环障碍的影响：取健康家兔20只，用羊水导致球结膜微循环障碍后，再分别用党参和盐水对照观察微循环的恢复情况（每组各10只家兔）。结果用党参后80%家兔在15分钟时，微循环已恢复正常，且管径比生理状态下扩大，30分钟后全部恢复正常，微循环开放数目比生理状态下显着增多，管径明显扩大。盐水组在生理状态下微循环与党参组无明显差异，羊水致微循环障碍后，再用生理盐水，15分钟时无一恢复，30分钟时只有少部分较大血管模糊可见。"}]},{"ID":"20240830141708-owitigf","Type":"NodeParagraph","Properties":{"id":"20240830141708-owitigf","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.对消化系统的影响：3.1．党参抗溃疡作用：3.1.1.对大鼠应激型溃疡的影响：党参多糖给于大鼠口服50mg/kg或250mg/kg，对应激型胃溃疡有非常明显的抑制作用（p＜0.001）。党参煎剂20g/kg对枸束水浸应激造成的大鼠溃疡亦有非常明显的抑制作用。采用大鼠束缚水浸应激型溃疡模型，胃中埋植胃电极和半导体应变规法，观察到应激状态下，大鼠胃电基本节律紊乱，胃运动加强，胃排空明显加快，灌胃党参水煎醇沉液40g/kg后对应激型胃溃疡有保护作用，同时能抑制上述胃电和胃运动的变化。"}]},{"ID":"20240830141708-djpus0n","Type":"NodeParagraph","Properties":{"id":"20240830141708-djpus0n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.1.2.对幽门结扎大鼠溃疡模型的保护作用：大鼠口服党参多糖500、250mg/kg对幽门结扎型实验性胃溃疡均有一定的保护作用。党参煎液（20g/kg）和党参正丁醇中性提取物（5.0g/kg）对大鼠幽门结扎型胃溃疡均有明显的预防保护作用（p＜0.01）。"}]},{"ID":"20240830141708-ptaq37w","Type":"NodeParagraph","Properties":{"id":"20240830141708-ptaq37w","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.1.3.对无水乙醇损伤大鼠胃粘膜的保护作用：党参煎剂可明显降低无水乙醇对胃粘膜的损伤，与对照比较损伤发生率为40%（对照100%），损伤指数，对照为147.8±59.38，而党参组为8.95±15.59（p＜0.01）,抑制率达93.94%。"}]},{"ID":"20240830141708-yegua1x","Type":"NodeParagraph","Properties":{"id":"20240830141708-yegua1x","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.1.4.对消炎痛、阿斯匹林所致大鼠胃溃疡的影响：党参多糖500mg/kg和党参正丁醇中性提取物均有明显的抑制作用（p＜0.01）。后者消炎痛和阿斯匹林引起的大鼠腺胃部粘膜PGE2和氨基己糖含量下降有明显的对抗作用；对大鼠基础胃酸分泌有明显的抑制作用，并可对抗阿斯匹林引起的胃液中H+浓度下降、Na+浓度升高，使［H+］/［Na+］比值明显升高;在试管内1×10（-2）g/ml的党参正丁醇中性提取物对猪肺微粒体内花生四烯酸（AA）代谢系统有激活作用。"}]},{"ID":"20240830141708-fyjq5d1","Type":"NodeParagraph","Properties":{"id":"20240830141708-fyjq5d1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.2．党参及其有效成分抗胃粘膜损伤的作用机制：党参部位提取物Ⅶ-Ⅱ口服能明显提高正常大鼠胃壁结合粘液含量，十二指肠给药能明显提高幽门结扎大鼠胃壁结合粘液含量；口服3小时后能明显减低无水乙醇所致的大鼠胃粘膜损伤和胃粘膜电位差下降，使溃疡指数降低和损伤后胃粘膜电位差降低百分率下降。在10-40g/kg体重剂量下均有明显的量效依赖关系。另外10、20g生药/kg体重口服可使幽门结扎大鼠胃粘膜中性红清除率有所下降，可能与药物对胃液分泌的抑制作用有关；小鼠口服对甲基橙胃排空运动无明显影响，但对家兔离体十二指肠自发活动呈现轻度抑制，并能明显拮抗乙酰胆碱所致的家兔离体肠管的强直性收缩。"}]},{"ID":"20240830141708-y7vtwh5","Type":"NodeParagraph","Properties":{"id":"20240830141708-y7vtwh5","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"4.对免疫机能的影响：党参及其多糖可使巨噬细胞的数量增加，细胞体积增大，伪足多，吞噬能力增强；细胞内的DNA、RNA、糖类、ACP酶、ATP酶、酸性酯酶和琥珀脱氢酶活性均显着增强，经显微分光光度计测定，服药后，巨噬细胞内各种化学成分含量明显增加，与对照组呈显着性差异。党参还能明显促进ConA活化的淋巴细胞DNA和蛋白质的生物合成，促进DNA合成的最适浓度为100μg/ml。DNA合成的高峰在48小时，对白介素-2（IL-2）产生也有明显的增强作用。"}]},{"ID":"20240830141708-rwneg1z","Type":"NodeParagraph","Properties":{"id":"20240830141708-rwneg1z","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.其它作用：党参能使红血球及血色素增加。给小鼠皮下注射l00%党参水提液0.2ml，可明显提高小鼠抗高温能力。党参浓度为4mg/ml浓度时对体外培养人淋巴细胞有丝分裂有促进作用，比较大的剂量反而抑制有丝分裂。党参还能使小鼠血浆皮质酮含量增加。血气分析提示，党参不仅可降低机体的氧耗量，还可增加供氧的作用，这种作用可能与药物兴奋中枢等有关。另党参对垂体肾上腺皮质系统有兴奋和调节作用。这可能是对辐射损伤有保护作用的机理。"}]},{"ID":"20240830141708-vgqfqhy","Type":"NodeParagraph","Properties":{"id":"20240830141708-vgqfqhy","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【毒性】党参水提乙醇沉淀注射液，小鼠腹腔注射的半数致死量为79.21±3.6g/kg。小鼠1次口服党参多糖10g/kg，观察72小时无死亡，外观也无明显变化。"}]},{"ID":"20240830141708-hel8u1k","Type":"NodeParagraph","Properties":{"id":"20240830141708-hel8u1k","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品乙醚浸出物加醋酐溶解，沿管壁加入浓硫酸，两液界面呈棕色五，上层由蓝色即变为绿色。（检查植物甾醇）（2）薄层色谱①本品粉末以适量氯仿回流提取，提取液蒸干，以适量氯仿液作为对照品液。各取上述供试液及对照液适量，点于同一硅胶GF254板上，以环已烷-乙酸乙酯（7：3）展形。喷以亚硝酸钠硫酸试液，110℃加热5min后，在紫外灯（245nm）下检测。党参及互花党参样品液色谱在与对照品色谱相应位置上，显示相同的淡绿色荧光斑点。②本品甲醇提取物经大孔树酯处理，去掉糖类和脂肪，作为供试液。以丁香甙（syrigin）甲醇液作为对照液。各取供试液及对照液适量点于同--GF254板上，以氯仿-甲醇-水（7：3：0：5）展形。置紫外灯（254nm）下观察荧光，供试液色谱在与对照液色谱相应位置上显示相同的斑点。"}]},{"ID":"20240830141708-hhkt154","Type":"NodeParagraph","Properties":{"id":"20240830141708-hhkt154","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830141708-5ygp1sl","Type":"NodeParagraph","Properties":{"id":"20240830141708-5ygp1sl","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1．党参：洗净泥沙后润透去芦，切片或切段，晒干。"}]},{"ID":"20240830141708-z54bxdw","Type":"NodeParagraph","Properties":{"id":"20240830141708-z54bxdw","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2．炒党参：将麸皮置于加热之锅内，至锅上起烟时，加入党参片，拌炒至深黄色，取出筛去麸皮，放凉。(每党参100斤，用麸皮20斤)"}]},{"ID":"20240830141708-ixkf72h","Type":"NodeParagraph","Properties":{"id":"20240830141708-ixkf72h","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；性平"}]},{"ID":"20240830141708-dhqyrnh","Type":"NodeParagraph","Properties":{"id":"20240830141708-dhqyrnh","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【归经】归脾；肺经"}]},{"ID":"20240830141708-avj9ty8","Type":"NodeParagraph","Properties":{"id":"20240830141708-avj9ty8","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【功能主治】健脾补肺、益气生津。主脾胃虚弱、食少便溏、四肢乏力、肺虚喘咳、气短自汗、气微两亏诸证"}]},{"ID":"20240830141708-56uqypq","Type":"NodeParagraph","Properties":{"id":"20240830141708-56uqypq","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-15g；或熬膏、入丸、散。生津、养血宜生用；补脾益肺宜炙用。"}]},{"ID":"20240830141708-vlalkxg","Type":"NodeParagraph","Properties":{"id":"20240830141708-vlalkxg","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【注意】实证、热证禁服；正虚邪实证，不宜单独应用。"}]},{"ID":"20240830141708-fsjcskc","Type":"NodeParagraph","Properties":{"id":"20240830141708-fsjcskc","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【附方】①清肺金，补元气，开声音，助筋力：党参一斤(软甜者，切片)，沙参半斤(切片)，桂圆肉四两。水煎浓汁，滴水成珠，用磁器盛贮。每用一酒杯，空心滚水冲服，冲入煎药亦可。(《得配本草》上党参膏)②治泻痢与产育气虚脱肛：党参(去芦，米炒)二钱，炙耆、白术(净炒)、肉蔻霜、茯苓各一钱五分，怀山药(炒)二钱，升麻(蜜炙)六分，炙甘草七分。加生姜二片煎。或加制附子五分。(《不知医必要》参耆白术汤)③治服寒凉峻剂，以致损伤脾胃，口舌生疮：党参(焙)、黄芪(炙)各二钱，茯苓一钱，甘草(生)五分，白芍七分。白水煎，温服。(《喉科紫珍集》参耆安胃散)④治小儿口疮：党参一两，黄柏五钱。共为细末，吹撒患处(《青海省中医验方汇编》)⑤抑制或杀灭麻风杆菌：党参、重楼(蚤休)、刺包头根皮(楤木根皮)各等量。将党参、重楼研成细粉；再将刺包头根皮加水适量煎煮三次，将三次煎液浓缩成一定量(能浸湿党参、重楼细粉)的药液，加蜂蜜适量，再将重楼、党参细粉倒入捣匀作丸，每丸三钱重；亦可作成膏剂。日服三次，每次一丸，开水送服。(北京中医学院《新医疗法资料汇编》)"}]},{"ID":"20240830141708-0g4n6ar","Type":"NodeParagraph","Properties":{"id":"20240830141708-0g4n6ar","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830141708-grexirt","Type":"NodeParagraph","Properties":{"id":"20240830141708-grexirt","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"1.《本经逢原》：清肺。上党人参，虽无甘温峻补之功，却有甘平清肺之力，亦不似沙参之性寒专泄肺气也。"}]},{"ID":"20240830141708-7qeqj95","Type":"NodeParagraph","Properties":{"id":"20240830141708-7qeqj95","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"2.《本草从新》：补中益气，和脾胃除烦渴。"}]},{"ID":"20240830141708-wklyzl1","Type":"NodeParagraph","Properties":{"id":"20240830141708-wklyzl1","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"3.《纲目拾遗》：治肺虚，益肺气。"}]},{"ID":"20240830141708-4aoa8ui","Type":"NodeParagraph","Properties":{"id":"20240830141708-4aoa8ui","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"4.《科学的民间药草》：补血剂。适用于慢性贫血，萎黄病，白血病，腺病，佝偻病。"}]},{"ID":"20240830141708-rg55x32","Type":"NodeParagraph","Properties":{"id":"20240830141708-rg55x32","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"5.《中药材手册》：治虚劳内伤，肠胃中冷，滑泻久痢，气喘烦渴，发热自汗，妇女血崩、胎产诸病。"}]},{"ID":"20240830141708-dm2a0fh","Type":"NodeParagraph","Properties":{"id":"20240830141708-dm2a0fh","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"6.《得配本草》：上党参，得黄耆实卫，配石莲止痢，君当归活血，佐枣仁补心。补肺蜜拌蒸熟；补脾恐其气滞，加桑皮数分，或加广皮亦可。"}]},{"ID":"20240830141708-xfg0r5n","Type":"NodeParagraph","Properties":{"id":"20240830141708-xfg0r5n","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"7.《本草正义》：党参力能补脾养胃，润肺生津，腱运中气，本与人参不甚相远。其尤可贵者，则健脾运而不燥，滋胃阴而不湿，润肺而不犯寒凉，养血而不偏滋腻，鼓舞清阳，振动中气，而无刚燥之弊。且较诸辽参之力量厚重，而少偏于阴柔，高丽参之气味雄壮，而微嫌于刚烈者，尤为得中和之正，宜乎五脏交受其养，而无往不宜也。特力量较为薄弱，不能持久，凡病后元虚，每服二、三钱，止足振动其一日之神气，则信乎和平中正之规模，亦有不耐悠久者。然补助中州而润泽四隅，故凡古今成方之所用人参，无不可以潞党参当之，即凡百证治之应用人参者，亦无不可以潞党参投之。"}]},{"ID":"20240830141708-ia49l6b","Type":"NodeParagraph","Properties":{"id":"20240830141708-ia49l6b","updated":"20240830141734"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830141709-uycl0ks","Type":"NodeThematicBreak","Properties":{"id":"20240830141709-uycl0ks","updated":"20240830141734"}},{"ID":"20240830141710-qealngg","Type":"NodeParagraph","Properties":{"id":"20240830141710-qealngg","updated":"20240830141734"}}]}