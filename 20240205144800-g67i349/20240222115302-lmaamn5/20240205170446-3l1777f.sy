​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 389px;","style":"width: 379px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土荆皮 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土荆皮 6-20240710170916-88ekbla.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 379px;\" parent-style=\"width: 389px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 868px;","style":"width: 858px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"dbb44aed2e738bd4b31c454c97dc90d6277f9e2f530c"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/dbb44aed2e738bd4b31c454c97dc90d6277f9e2f530c-20240710171451-qjblu52.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 858px;\" parent-style=\"width: 868px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710171442-8h7urok","Type":"NodeParagraph","Properties":{"id":"20240710171442-8h7urok","updated":"20240710171442"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 586px;","style":"width: 576px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土荆皮 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土荆皮 7-20240710171154-of5ekhf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 576px;\" parent-style=\"width: 586px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 693px;","style":"width: 683px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土荆皮 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土荆皮 8-20240710171359-7v2ty39.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 683px;\" parent-style=\"width: 693px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710170436-2xk3a61","Type":"NodeParagraph","Properties":{"id":"20240710170436-2xk3a61","updated":"20240710170551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：土荆皮，中药名。为松科植物金钱松的干燥根皮或近根树皮。"}]},{"ID":"20240710170540-ug54fho","Type":"NodeThematicBreak","Properties":{"id":"20240710170540-ug54fho"}},{"ID":"20240830163134-f2qw64x","Type":"NodeParagraph","Properties":{"id":"20240830163134-f2qw64x","updated":"20240830163140"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：土荆皮"}]},{"ID":"20240830163134-h2rj0fb","Type":"NodeParagraph","Properties":{"id":"20240830163134-h2rj0fb","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆皮《中国药典》"}]},{"ID":"20240830163134-r4gkflt","Type":"NodeParagraph","Properties":{"id":"20240830163134-r4gkflt","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔJīnɡPí"}]},{"ID":"20240830163134-4bdi191","Type":"NodeParagraph","Properties":{"id":"20240830163134-4bdi191","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【来源】本品为松科植物金钱松PseudolarixkaempferiGord.的干燥根皮或近根树皮。夏季剥取，晒干。"}]},{"ID":"20240830163134-qosxcv9","Type":"NodeParagraph","Properties":{"id":"20240830163134-qosxcv9","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830163134-qah0ii1","Type":"NodeParagraph","Properties":{"id":"20240830163134-qah0ii1","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"本品根皮呈不规则的长条状，扭曲而稍卷，大小不一，厚2～5mm。外表面灰黄色，粗糙，有皱纹及灰白色横向皮孔，粗皮常呈鳞片状剥落，剥落处红棕色。内表面黄棕色至红棕色，平坦，有细致的纵向纹理。质韧，折断面呈裂片状，可层层剥"}]},{"ID":"20240830163134-fgf3yzu","Type":"NodeParagraph","Properties":{"id":"20240830163134-fgf3yzu","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"离。气微，味苦而涩。树皮呈板片状，厚约至8mm，粗皮较厚，外表面龟裂状，内表面较粗糙。"}]},{"ID":"20240830163134-fccsgmk","Type":"NodeParagraph","Properties":{"id":"20240830163134-fccsgmk","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末淡棕色或棕红色。石细胞多，类长方形、类圆形或不规则分枝状，直径30～96μｍ，含黄棕色块状物。筛胞大多成束，直径20～40μｍ，侧壁上有多数椭圆形筛域。黏液细胞类圆形，直径100～300μｍ。树脂细胞纵向连接成管状，含红棕色至黄棕色树脂状物，有的埋有草酸钙方晶。木栓细胞壁稍厚，有的木化，并有纹孔。"}]},{"ID":"20240830163134-pn0k58h","Type":"NodeParagraph","Properties":{"id":"20240830163134-pn0k58h","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【炮制】洗净，略润，切丝，晒干。"}]},{"ID":"20240830163134-p1llw7m","Type":"NodeParagraph","Properties":{"id":"20240830163134-p1llw7m","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温；有毒。"}]},{"ID":"20240830163134-g41fnyl","Type":"NodeParagraph","Properties":{"id":"20240830163134-g41fnyl","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、脾经。"}]},{"ID":"20240830163134-fdwksfo","Type":"NodeParagraph","Properties":{"id":"20240830163134-fdwksfo","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫，止痒。用于疥癣瘙痒。"}]},{"ID":"20240830163134-d5bsuwz","Type":"NodeParagraph","Properties":{"id":"20240830163134-d5bsuwz","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【用法用量】外用适量，醋或酒浸涂擦，或研末调涂患处。"}]},{"ID":"20240830163134-w3yh7oj","Type":"NodeParagraph","Properties":{"id":"20240830163134-w3yh7oj","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830163134-b2c8vhf","Type":"NodeParagraph","Properties":{"id":"20240830163134-b2c8vhf","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830163134-frbgyl7","Type":"NodeParagraph","Properties":{"id":"20240830163134-frbgyl7","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆皮《*辞典》"}]},{"ID":"20240830163134-jlm9jvl","Type":"NodeParagraph","Properties":{"id":"20240830163134-jlm9jvl","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【出处】《药材资料汇编》"}]},{"ID":"20240830163134-gz4ibjc","Type":"NodeParagraph","Properties":{"id":"20240830163134-gz4ibjc","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔJīnɡPí"}]},{"ID":"20240830163134-kzuh7hf","Type":"NodeParagraph","Properties":{"id":"20240830163134-kzuh7hf","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【别名】土槿皮（《中药通报》3（4）：156，1957），荆树皮（《中国药植志》），金钱松皮（《药材学》）。"}]},{"ID":"20240830163134-m0j47ll","Type":"NodeParagraph","Properties":{"id":"20240830163134-m0j47ll","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【来源】为松科植物金钱松的树皮或根皮。秋末剥取树皮或根皮、晒干。"}]},{"ID":"20240830163134-2j9y8c5","Type":"NodeParagraph","Properties":{"id":"20240830163134-2j9y8c5","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830163134-0qhyhit","Type":"NodeParagraph","Properties":{"id":"20240830163134-0qhyhit","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"金钱松，又名：金松、水树、金叶松。"}]},{"ID":"20240830163134-gzkcry5","Type":"NodeParagraph","Properties":{"id":"20240830163134-gzkcry5","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高20～40米。茎干直立，枝轮生平展；长枝有纵纹细裂，叶散生其上，短枝有轮纹密生，叶簇生其上，作辐射状．叶线形，长约3～7厘米，宽1～2毫米，先端尖，基部渐狭，至秋后叶变金黄色。花单性，雌雄同株；雄花为荣荑状，下垂，黄色，数个或数十个聚生在小枝顶端，基部包有无数倒卵状楔形之膜质鳞片；雌花单生于有叶之短枝顶端，由多数螺旋状排列的鳞片组成。球果卵形，直立，长约5～7.5厘米，径约3～6厘米，鳞片木质，广卵形至卵状披针形，先端微凹或钝头，基部心脏形，成热后脱落，苞片披针形，长6～7毫米，先端长尖，中部突起。种子每鳞2个，长8毫米，富油脂，有膜质长翅，与鳞片等长或梢短。花期4～5月。果期10～11月。"}]},{"ID":"20240830163134-hk6bid6","Type":"NodeParagraph","Properties":{"id":"20240830163134-hk6bid6","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【生境分布】喜生于多阳光处。江苏、浙江、安徽、江西、湖南、广东等地多有栽培。产浙江、安徽、江苏等地。"}]},{"ID":"20240830163134-xa96h1g","Type":"NodeParagraph","Properties":{"id":"20240830163134-xa96h1g","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830163134-bk7oxfj","Type":"NodeParagraph","Properties":{"id":"20240830163134-bk7oxfj","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"①根皮呈不规则的长条块片状，长短大小不一，扭曲而稍卷，厚约3～6毫米。外表面粗糙有皱纹及横向灰白色皮孔。木栓灰黄色，常呈鳞片状剥落，显出红棕色皮部。内表面红棕色或黄白色，较平坦，有纵向纹理。质脆，易断，断面红褐色，外皮颗粒性，内皮纤维性。气微弱，味苦而涩。"}]},{"ID":"20240830163134-29n8enk","Type":"NodeParagraph","Properties":{"id":"20240830163134-29n8enk","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"②树皮大多呈条状或片状，厚约1厘米，外表暗棕色，作龟裂状，外皮甚厚；内表面较根皮为祖糙。以形大、黄褐色、有纤维质而无栓皮者为佳。"}]},{"ID":"20240830163134-xmvv72s","Type":"NodeParagraph","Properties":{"id":"20240830163134-xmvv72s","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【化学成份】含土槿皮酸、酚性成分、鞣质及色素。"}]},{"ID":"20240830163134-qyxhqjl","Type":"NodeParagraph","Properties":{"id":"20240830163134-qyxhqjl","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【性味】《药材资料汇编》：\"辛，温，有毒。\""}]},{"ID":"20240830163134-hz54tdv","Type":"NodeParagraph","Properties":{"id":"20240830163134-hz54tdv","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【功能主治】杀虫，止痒。用于疥癣瘙痒。《药材资料汇编》：\"治癣疥。\""}]},{"ID":"20240830163134-2rbjlst","Type":"NodeParagraph","Properties":{"id":"20240830163134-2rbjlst","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【用法用量】外用：浸酒涂擦或研末调敷。"}]},{"ID":"20240830163134-ri7un8q","Type":"NodeParagraph","Properties":{"id":"20240830163134-ri7un8q","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【附方】治疗局限性神经性皮炎：土荆皮一两，蛇床子一两，百部根一两，五倍子八钱，密陀僧六钱，轻粉二钱。共研细末备用。先以皂角煎水洗患处，再以元醋调药粉呈糊状，涂敷患部，上盖一层油纸，以保持药物潮润，每日换一次，直至痊愈。对病程短病情不太严重或散漫的患者，可用纱布包药糊，日擦数次，取得同样效果。（《中华皮肤科杂志》11（6）：374，1965）"}]},{"ID":"20240830163134-lfjcje6","Type":"NodeParagraph","Properties":{"id":"20240830163134-lfjcje6","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830163134-edq3d88","Type":"NodeParagraph","Properties":{"id":"20240830163134-edq3d88","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆皮《中华本草》"}]},{"ID":"20240830163134-lujput3","Type":"NodeParagraph","Properties":{"id":"20240830163134-lujput3","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【出处】出自《药材资料汇编》"}]},{"ID":"20240830163134-vmemgf6","Type":"NodeParagraph","Properties":{"id":"20240830163134-vmemgf6","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【拼音名】TǔJīnɡPí"}]},{"ID":"20240830163134-zwsb9zm","Type":"NodeParagraph","Properties":{"id":"20240830163134-zwsb9zm","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【别名】罗汉松皮、土槿皮、荆树皮、金钱松皮。"}]},{"ID":"20240830163134-vt4g8lb","Type":"NodeParagraph","Properties":{"id":"20240830163134-vt4g8lb","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830163134-mf6xuq8","Type":"NodeParagraph","Properties":{"id":"20240830163134-mf6xuq8","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"药材基源：为松科植物金钱松的根皮及近根树皮。"}]},{"ID":"20240830163134-zuy3kff","Type":"NodeParagraph","Properties":{"id":"20240830163134-zuy3kff","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Pseudolarixamailis(Nelson)Rehd.[LarixamabilisNelson;Pseudolarixkaempferi(Lindl.)Gord.]"}]},{"ID":"20240830163134-w3gpd5w","Type":"NodeParagraph","Properties":{"id":"20240830163134-w3gpd5w","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋两季采挖，剥取根皮，除支外粗皮，洗净，晒干。"}]},{"ID":"20240830163134-zht0etq","Type":"NodeParagraph","Properties":{"id":"20240830163134-zht0etq","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【原形态】乔木，高达40m胸围达1.5m.树干直，树皮灰褐色，粗糙，不规则鳞片状开裂。一年生枝淡红褐色或淡红黄色，有光泽，老枝及短枝呈灰色或暗灰色。叶线形，柔软，扁平，长2-5.5cm，宽1.5-4mm，先端锐尖或尖，上面绿色，中脉稍明显，下面蓝绿色，中脉明显，每边有5-14条气孔线，长枝上叶辐射伸展，短枝上叶簇生。雄球花黄色，圆柱状，下垂；雌球花紫红色，直立，椭圆形，长约1.3cm，有短梗。球果卵圆形或倒卵圆形，长6-7.5cm，径4-5cm，熟时淡红褐色；中部种鳞卵状披针形，长2.8-3.5cm，两侧耳状，先端钝有凹缺，脊上密生短柔毛；苞鳞长约种鳞的1/4-1/3，卵状披针形，边缘有细齿。种子卵圆形，白色，种翅三角状披针形，淡黄色或淡褐黄色，有光泽。花期4-5月，果熟期10-11月上旬。"}]},{"ID":"20240830163134-27c9vg3","Type":"NodeParagraph","Properties":{"id":"20240830163134-27c9vg3","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830163134-can06hl","Type":"NodeParagraph","Properties":{"id":"20240830163134-can06hl","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔100-1500m的山地针、阔叶树混交林中。"}]},{"ID":"20240830163134-5axjyia","Type":"NodeParagraph","Properties":{"id":"20240830163134-5axjyia","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏、安徽、浙江、江西、福建、湖北、湖南、四川等地。多为栽培。"}]},{"ID":"20240830163134-o0z475e","Type":"NodeParagraph","Properties":{"id":"20240830163134-o0z475e","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830163134-vi4pvny","Type":"NodeParagraph","Properties":{"id":"20240830163134-vi4pvny","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别根皮呈不规则的长条状或稍扭曲而卷成槽状，长短及宽度不一，厚2-5mm，外表面粗糙，深灰棕色，具纵横皱纹，并有横向灰白色皮孔，栓皮常呈鳞片状剥落。内表面黄棕色至红棕色，平坦，有细致的纵向纹理。质坚韧，折断面裂片状。树皮呈板片状，栓皮较厚，外表面龟裂状，内表面较粗糙。气微，味苦涩。以片大而整齐、黄褐色者为佳。"}]},{"ID":"20240830163134-qgtm3j4","Type":"NodeParagraph","Properties":{"id":"20240830163134-qgtm3j4","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别根皮横切面：木栓细胞常脱落。栓内层约3列细胞，含棕色物。皮层和韧皮部散在石细胞、树脂细胞及多数粘液细胞。韧皮部荆皮部筛胞成群散在，外侧筛胞颓废；射线细胞1列，常弯曲。本品薄壁细胞含淀粉粒。"}]},{"ID":"20240830163134-kye23xe","Type":"NodeParagraph","Properties":{"id":"20240830163134-kye23xe","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"3.粉末特征：检棕红色。①石细胞大多成群，类方形、类长方形或不规则分枝状，直径30-100μm，壁厚达34μm，层纹微波状，孔沟极细密，大多含黄棕色块状物。②筛胞直径16-40μm，侧壁有多数椭圆形筛域，排列成网状。粘液细胞类圆形，直径100-300μm。长达360μm。③树脂细胞纵向连接成管状，含红棕色至黄棕色树脂状物，有的埋有草酸钙方晶。④木栓细胞棕色，壁稍厚，有的木化，并可见细小圆纹孔。"}]},{"ID":"20240830163134-ms9hw16","Type":"NodeParagraph","Properties":{"id":"20240830163134-ms9hw16","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【化学成份】根皮含土荆皮酸（pseudolaricacid）A、B、C、D、E，土荆皮酸C2即是去甲基土荆皮酸（demethylpseudolaricacid）B,土荆皮酸A-β-D-葡葡糖甙（pseudolaricacidA-β-D-glu-coside），土荆皮酸B-β-D-葡萄糖甙（pseudolaricacidB-β-D-gluco-side），金钱松呋喃酸（pseudolarifuroic），白桦脂酸（betulinicacid）,β-谷甾醇（β-sitosterol），β-谷甾醇-β-D-葡萄糖甙（β-sitosterol-β-D-glucoside）。种子含土荆皮内酯（pseudolarolide）E、H，以及土荆皮内酯A、B、C、D、I。树轮中含铅、铁、钙、锰、锌五种无素。"}]},{"ID":"20240830163134-6njoybu","Type":"NodeParagraph","Properties":{"id":"20240830163134-6njoybu","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830163134-8xjs6h0","Type":"NodeParagraph","Properties":{"id":"20240830163134-8xjs6h0","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"本品的有机酸、乙醇浸膏及苯浸膏，对我国常见的10种致病真菌均有一定的抗菌作用。其用量0.1-1mg/ml，对许兰黄癣菌、絮状表皮癣菌、铁锈色小芽孢癣菌、石膏样小孢子菌和白色念珠菌即有杀菌作用。抗菌作用以有机酸最强，乙醇浸膏次之，苯浸膏再次。电镜观察可见石膏样癣菌细胞结构变性，线粒体等细胞器消失，细胞膜明显皱缩，呈憩室样反折入胞浆内。"}]},{"ID":"20240830163134-9tmqn06","Type":"NodeParagraph","Properties":{"id":"20240830163134-9tmqn06","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"1.抗真菌作用取0.2cm的石膏样癣菌菌落移种于Sabourand氏葡萄糖琼脂培养基上，3wk后切直径\u003c0.2cm的菌落接种于40%土荆皮药液培养基及对照培养基中，各接种3管，25℃培育2h，然后按常规处理制成超薄切片，用电镜观察，土荆皮有很强的抗真菌作用，细胞损伤程度在药物浓度与刘量相同情况下与药物作用时间长短有关，若真菌充分暴露，药物浓度足够时，有100%杀灭细胞作用。土荆皮与二性霉素B等抗真菌剂对白色含珠菌的作用相比较，其相同点为细胞浆内均有电子薄区，细胞膜完整，并反折入胞浆内。不同点在于土荆皮作用的真菌细胞结构变性，细胞器消失，细胞膜明显皱缩，并呈憩室样反折入胞头，线粒体结构亦变性乃至消失。土荆皮中抗真菌的主要成分为土荆甲酸、土荆乙酸、土荆丙酸。"}]},{"ID":"20240830163134-75nlu10","Type":"NodeParagraph","Properties":{"id":"20240830163134-75nlu10","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"2.土荆乙酸甙对培养人体肝癌细胞的作用以人体肝癌细胞株SMMC-7721培养于含30%小牛血清的RPMI-1640培养液，将生长茂密的单层细胞制成县液，以相等的细胞数接种于培养瓶，于37℃培养2d供实验用，以人体两倍体细胞2BS作对照观察。土荆乙酸甙用3.5%吐温80制成针剂(20mg/ml)，实验时用上述培养液配成土荆乙酸甙浓度为10ug、5ug和265ug/ml3组，分别加入准备好细胞的培养瓶中继续培养。观察加药后24h；培养6d;加药后48h等，计数各组总细胞数和死细胞数，求出药物对细胞的杀伤率。结果表明，瘤细胞形态与对照组比较，土荆乙酸甙10和5ug/ml的两组，大部分细胞变圆，胞膜变厚皱缩，且均脱落呈悬浮状，仅见少数细胞贴壁生长；10、5、2.5ug/ml3组对肝癌细胞生长有不同程度抑制作用，10ug/ml作用d6起，对细胞增殖有较明显的抑制作用，其抑制率分别为56.7%、55.1%和56.2%，10ug/ml组d6时增殖抑制率达96.9%；各组细胞冻融液的蛋白质含量随土荆乙酸甙浓度递增而蛋白质含量的抑制率增高，当土荆乙酸甙剂量为10ug/ml时，其抑制率达64.54%；土荆乙酸甙浓度为10、5和2.5ug/ml时，对细胞杀伤率分别为42.9%、39.3%和29.4%，对照组仅8.3%细胞死亡。"}]},{"ID":"20240830163134-dahxcpr","Type":"NodeParagraph","Properties":{"id":"20240830163134-dahxcpr","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"3.抗生育作用3.1抗早孕作用成年雌大鼠，体重200±SD22g，成年大鼠，体重330±40g，自由饮水和进食，光照7：00am一7：00pm，雌雄按2：1合笼，每日8：00阴道涂片，以查到精子为妊娠dl，孕鼠每组10只，于妊娠d7，8，9ig给药，药后d6解剖，凡有一个或一个以上正常胎仔作为妊娠动物。对于妊娠仓鼠，土荆甲酸60mg/kg与对照组相比较有非常明显的抗早孕作用(P＜0.01＝，而土荆乙酸20-40mg/kg有明显的抗早孕作用(P＜0.05或P＜0.01＝。土荆乙酸30-40mg/kgqdx3d给兔sc和iv溶液，抗早孕效果较ig混悬液40mg/kgqdx3d为好。土荆乙酸给孕狗，于妊娠14d内ig混悬液，停药后d6剖检胎仔，1mg/kqqdx3d，4只狗中有2只早孕终止，宫腔内胎仔全部死亡，另2只狗各有4个活胎，剂量5mg/kgqdx3d，4只狗的早孕全部终止，胎仔死亡。给2只狗单次ig混悬液20-30mg/kg，胎仔亦全部死亡。土荆乙酸的抗早孕作用可能首先损伤母体的蜕膜部分，且蜕膜坏死不是由于孕酮下降的缘故，实验表明外源性孕酮不能对抗其抗早孕作用。"}]},{"ID":"20240830163134-z2yqsgv","Type":"NodeParagraph","Properties":{"id":"20240830163134-z2yqsgv","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"3.2土荆乙酸对妊娠大鼠无明显的抗着床作用，对妊娠dl0-12，ig给于大鼠土荆乙酸10mg/kgqdx3d可终止中期妊娠(P＜0.01)。"}]},{"ID":"20240830163134-7dvczwr","Type":"NodeParagraph","Properties":{"id":"20240830163134-7dvczwr","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240830163134-8dvlhui","Type":"NodeParagraph","Properties":{"id":"20240830163134-8dvlhui","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆甲酸和乙酸对小鼠1次iv的LD50及95%置信限分别为486(430-548)mg/kg和423(404-442)mg/kg，对小鼠ip的LD50为397(347-453)mg/kg和316(285-351)mg/kg，小鼠iv后出现痉挛，头颈部强直，5分钟左右痉挛缓解，呈无力弛缓状态，张口呼吸等中毒症状，3小时后逐渐恢复，死亡多在24小时内。"}]},{"ID":"20240830163134-gey18yg","Type":"NodeParagraph","Properties":{"id":"20240830163134-gey18yg","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆甲酸和乙酸对大鼠一次ig的LD50和治疗指数，安全指数：取体重234±31g的雌性大鼠110只，分成11组，每组10只，土荆甲酸和乙酸各为5和6组，剂量按等比级数给药，1次ig，观察1wk内大鼠的死亡数，按上法统计LD50。又取妊娠7d大鼠100只，分成10组，各组于妊娠d71次ig不同剂量的土荆甲酸和乙酸，给药后d6解剖，纪录未孕大鼠数，按上法计算抗早孕LD50和ED50、治疗指数和安全指数。"}]},{"ID":"20240830163134-c38lydr","Type":"NodeParagraph","Properties":{"id":"20240830163134-c38lydr","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"土荆甲酸与乙酸母核相同，差别主要是七元环的C-7部位，前者连-甲基，若将甲基改为季羰甲基，则对大鼠、仓鼠的抗早孕作用和对大鼠的毒性都明显大于土荆甲酸。土荆乙酸无论对大鼠ig或对小鼠的iv、ip的毒性，皆明显大于土荆甲酸，毒性与抗早孕作用亦相应。"}]},{"ID":"20240830163134-8dhg1wk","Type":"NodeParagraph","Properties":{"id":"20240830163134-8dhg1wk","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿；杀虫止痒。主疥癣；湿疹；神经性皮炎"}]},{"ID":"20240830163134-52vwmd5","Type":"NodeParagraph","Properties":{"id":"20240830163134-52vwmd5","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【用法用量】外用：适量，浸酒涂擦或研末调敷。"}]},{"ID":"20240830163134-jlsj3ry","Type":"NodeParagraph","Properties":{"id":"20240830163134-jlsj3ry","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【各家论述】《药材资料汇编》：治癣疥。"}]},{"ID":"20240830163134-e53caw7","Type":"NodeParagraph","Properties":{"id":"20240830163134-e53caw7","updated":"20240830163152"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830163135-halq3s1","Type":"NodeThematicBreak","Properties":{"id":"20240830163135-halq3s1","updated":"20240830163152"}},{"ID":"20240830163136-4lfgssb","Type":"NodeParagraph","Properties":{"id":"20240830163136-4lfgssb","updated":"20240830163152"}}]}