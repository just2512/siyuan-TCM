NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金刚藤"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金刚藤-20240902172653-mixro4z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724192013-t6jqtxk","Type":"NodeParagraph","Properties":{"id":"20240724192013-t6jqtxk","updated":"20240724192013"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菝葜 (21)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菝葜 21-20240724192013-hr92vtq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724184318-l5ewlv5","Type":"NodeParagraph","Properties":{"id":"20240724184318-l5ewlv5","updated":"20240730175349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：金刚藤跟土茯苓较为相似，区别方法为‘"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"有刺金刚藤，无刺土茯苓"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"’；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205153827-tri9y9w","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"土茯苓"}]},{"ID":"20240724184319-7ahyi5y","Type":"NodeThematicBreak","Properties":{"id":"20240724184319-7ahyi5y"}},{"ID":"20240902172704-ko36om8","Type":"NodeParagraph","Properties":{"id":"20240902172704-ko36om8","updated":"20240902172722"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：菝葜"}]},{"ID":"20240902172704-isz247r","Type":"NodeParagraph","Properties":{"id":"20240902172704-isz247r","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"菝葜《全国中草药汇编》"}]},{"ID":"20240902172704-zy2v18i","Type":"NodeParagraph","Properties":{"id":"20240902172704-zy2v18i","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáQiā"}]},{"ID":"20240902172704-ilv7qlz","Type":"NodeParagraph","Properties":{"id":"20240902172704-ilv7qlz","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【别名】金刚藤、铁菱角、马加勒、筋骨柱子、红灯果"}]},{"ID":"20240902172704-5yb3p2o","Type":"NodeParagraph","Properties":{"id":"20240902172704-5yb3p2o","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【来源】百合科菝葜属植物菝葜SmilaxchinaL.的根状茎。其叶也入药。全年可采，洗净，切片晒干，或用盐水浸泡数小时后蒸熟，晒干。夏季采叶，晒干。"}]},{"ID":"20240902172704-6ei5yxo","Type":"NodeParagraph","Properties":{"id":"20240902172704-6ei5yxo","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【性味】甘、酸，平。"}]},{"ID":"20240902172704-o9jzcjy","Type":"NodeParagraph","Properties":{"id":"20240902172704-o9jzcjy","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风利湿，解毒消肿。根状茎：治风湿关节痛，跌打损伤，胃肠炎，痢疾，消化不良，糖尿病，乳糜尿，白带，癌症；叶：外用治痈疖疔疮，烫伤。"}]},{"ID":"20240902172704-5cwms73","Type":"NodeParagraph","Properties":{"id":"20240902172704-5cwms73","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【用法用量】根状茎1～2两；外用叶适量，研末调油外敷。"}]},{"ID":"20240902172704-qqmg30w","Type":"NodeParagraph","Properties":{"id":"20240902172704-qqmg30w","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902172704-yvihse4","Type":"NodeParagraph","Properties":{"id":"20240902172704-yvihse4","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"菝葜《*辞典》"}]},{"ID":"20240902172704-yd6ftnp","Type":"NodeParagraph","Properties":{"id":"20240902172704-yd6ftnp","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902172704-jtxa7qk","Type":"NodeParagraph","Properties":{"id":"20240902172704-jtxa7qk","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáQiā"}]},{"ID":"20240902172704-liji90h","Type":"NodeParagraph","Properties":{"id":"20240902172704-liji90h","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【别名】金刚根、王瓜草（《日华子本草》），金刚骨（《儒门事亲》），金刚藤（《履巉岩本草》），山梨儿、金刚树、铁刷子（《救荒本草》），铁菱角（《纲目》），金刚刺（《医林纂要》），金刚头、假萆薢、山菱角、霸王引（《岭南采药录》），沟谷刺、金巴斗、豺狗刺、鲎壳藤（《中国树木分类学》），马甲、硬饭头、冷饭头（《广州植物志》），龙爪菜（《贵州民间方药集》），普贴（《福建民间草药》），鸡肝根、路边刷（《广西中兽医药植》），鲎壳刺（《闽南民间草药》），铁刺苓（《浙江民间草药》），饭巴铎、冷饭巴（《四川中药志》），金刚"}]},{"ID":"20240902172704-1xbsscg","Type":"NodeParagraph","Properties":{"id":"20240902172704-1xbsscg","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【来源】为百合科植物菝葜的根茎。2月或8月采挖根茎，除去泥土及须根，晒干。"}]},{"ID":"20240902172704-m8h7bgc","Type":"NodeParagraph","Properties":{"id":"20240902172704-m8h7bgc","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【原形态】攀缘状灌木。根茎横走，呈不规则的弯曲，肥厚质硬，疏生须根。茎硬，高0.7～2米以上，有倒生或平出的疏刺。叶互生，革质，圆形乃至广椭圆形，长5～7厘米，宽2.5～5厘米，先端突尖或浑圆，基部浑圆或阔楔形，有时近心形，全缘，3～5脉，下面绿色；叶柄长4～5毫米，沿叶柄下部两侧有卷须2条。花单性，雌雄异株；伞形花序，腋生；苞片卵状披针形；花被裂片6，2轮，矩圆形，黄绿色；雄花直径约6毫米，雄蕊6，花丝短，长约4毫米，药黄色；雌花较小；直径约3毫米，退化雄蕊成丝状，子房上位，长卵形，3室，柱头3裂，稍反曲。浆果球形，红色。花期4～5月。"}]},{"ID":"20240902172704-994fqe6","Type":"NodeParagraph","Properties":{"id":"20240902172704-994fqe6","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于山坡、灌木丛林缘。分布我国长江以南各地。"}]},{"ID":"20240902172704-un658gg","Type":"NodeParagraph","Properties":{"id":"20240902172704-un658gg","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【性状】干燥根茎略呈圆柱形，微弯，结节状，有不规则的凹陷。长约8～15厘米，直径约2～4厘米。外表褐紫色，微有光泽，结节膨大处常有坚硬的须根残基及芽痕，或留有坚硬弯曲的细根。质坚硬，难折断，断面黄棕色，平坦。产于江苏的较细而长，俗称\"金刚鞭\"；产于浙江的较粗壮，俗称\"铁菱角\"。"}]},{"ID":"20240902172704-jzzw2wu","Type":"NodeParagraph","Properties":{"id":"20240902172704-jzzw2wu","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【化学成份】根茎含薯蓣皂甙元和多种由薯蓣皂甙元构成的皂甙。又含生物碱、酚类、氨基酸、有机酸、糖类。种子油含粗脂肪11.2％，其脂肪酸中含油酸48.4％，亚油酸39.1％。"}]},{"ID":"20240902172704-gxt0jg8","Type":"NodeParagraph","Properties":{"id":"20240902172704-gxt0jg8","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902172704-r1u7rjq","Type":"NodeParagraph","Properties":{"id":"20240902172704-r1u7rjq","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"①利尿、解毒作用"}]},{"ID":"20240902172704-lgfzjjd","Type":"NodeParagraph","Properties":{"id":"20240902172704-lgfzjjd","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"煎剂对犬急性利尿实验，不能使尿量增加，对急性汞中毒大白鼠亦无利尿作用，但能使尿中排汞量略增加，对正常家兔及急性汞中毒家兔网状内皮系统功能均无明显影响。"}]},{"ID":"20240902172704-ayyuse8","Type":"NodeParagraph","Properties":{"id":"20240902172704-ayyuse8","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"②抗锥虫作用"}]},{"ID":"20240902172704-aa0hee5","Type":"NodeParagraph","Properties":{"id":"20240902172704-aa0hee5","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"25％与50％的煎剂，不论灌胃或腹腔注射，均能暂时抑制马疫锥虫的繁殖，延缓小白鼠的死亡时间，但不能清除血中锥虫使小白鼠得以治愈。不论灌胃或注射均使小白鼠出现鼓肠。前者与马齿苋合用疗效增加，副作用减少，在试管内对金黄色葡萄球菌、绿脓杆菌、大肠杆菌有抑菌作用。"}]},{"ID":"20240902172704-1ewugz8","Type":"NodeParagraph","Properties":{"id":"20240902172704-1ewugz8","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【炮制】将原药用清水漫洗，润透，切成薄片，晒干。"}]},{"ID":"20240902172704-j6es2i1","Type":"NodeParagraph","Properties":{"id":"20240902172704-j6es2i1","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902172704-zbdq4dm","Type":"NodeParagraph","Properties":{"id":"20240902172704-zbdq4dm","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"甘，温。"}]},{"ID":"20240902172704-8e3l54h","Type":"NodeParagraph","Properties":{"id":"20240902172704-8e3l54h","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味甘，平温，无毒。\""}]},{"ID":"20240902172704-tfe5lmr","Type":"NodeParagraph","Properties":{"id":"20240902172704-tfe5lmr","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"②《救荒本草》：\"味甘酸。\""}]},{"ID":"20240902172704-b4su26z","Type":"NodeParagraph","Properties":{"id":"20240902172704-b4su26z","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"甘苦，平。\""}]},{"ID":"20240902172704-mmuc9w0","Type":"NodeParagraph","Properties":{"id":"20240902172704-mmuc9w0","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【归经】《纲目》：\"足厥阴、少阴。\""}]},{"ID":"20240902172704-c8an6tp","Type":"NodeParagraph","Properties":{"id":"20240902172704-c8an6tp","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902172704-z76x3tg","Type":"NodeParagraph","Properties":{"id":"20240902172704-z76x3tg","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"祛风湿，利小便，消肿毒。治关节疼痛，肌肉麻木，泄泻，痢疾，水肿，淋病，疔疮，肿毒，瘰疬，痔疮。"}]},{"ID":"20240902172704-0enzw9h","Type":"NodeParagraph","Properties":{"id":"20240902172704-0enzw9h","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主腰背寒痛，风痹，益血气，止小便利。\""}]},{"ID":"20240902172704-l0li32r","Type":"NodeParagraph","Properties":{"id":"20240902172704-l0li32r","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治时疾瘟瘴。\""}]},{"ID":"20240902172704-9cqi5nz","Type":"NodeParagraph","Properties":{"id":"20240902172704-9cqi5nz","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"散肿毒。\""}]},{"ID":"20240902172704-x56x6iy","Type":"NodeParagraph","Properties":{"id":"20240902172704-x56x6iy","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治消渴，血崩，下利。\""}]},{"ID":"20240902172704-0d2krab","Type":"NodeParagraph","Properties":{"id":"20240902172704-0d2krab","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑤《本草原始》：\"利小便。\""}]},{"ID":"20240902172704-s94pnhq","Type":"NodeParagraph","Properties":{"id":"20240902172704-s94pnhq","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑥《医林纂要》：\"缓肝坚肾，清小肠火，化膀胱水。治恶疮，毒疮，虫毒。\""}]},{"ID":"20240902172704-aoyvvu3","Type":"NodeParagraph","Properties":{"id":"20240902172704-aoyvvu3","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑦《南京民间药草》：\"化痰止咳。浸酒服，可治筋骨麻木。\""}]},{"ID":"20240902172704-ahwhcsx","Type":"NodeParagraph","Properties":{"id":"20240902172704-ahwhcsx","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑧《福建民间草药》：\"治疝气。\""}]},{"ID":"20240902172704-e1w9w9x","Type":"NodeParagraph","Properties":{"id":"20240902172704-e1w9w9x","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑨《江苏植药志》：\"泡酒服治心头痛。\""}]},{"ID":"20240902172704-apfz261","Type":"NodeParagraph","Properties":{"id":"20240902172704-apfz261","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑩《浙江民间草药》：\"治流火。\""}]},{"ID":"20240902172704-xlmzssi","Type":"NodeParagraph","Properties":{"id":"20240902172704-xlmzssi","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑾《四川中药志》：\"清热，除风毒。治崩、带，血淋，瘰疬，跌打损伤。\""}]},{"ID":"20240902172704-s0sr9j6","Type":"NodeParagraph","Properties":{"id":"20240902172704-s0sr9j6","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑿广州部队《常用中草药手册》：\"祛风除湿。治腰腿疼痛，风湿性关节炎，肠炎腹泻。\""}]},{"ID":"20240902172704-b57dz20","Type":"NodeParagraph","Properties":{"id":"20240902172704-b57dz20","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⒀江西《中草药学》：\"解毒祛风，为疮痈要药。治历节痛风（类风湿性关节炎），肌肉麻痹，食道癌，牛皮癣。\""}]},{"ID":"20240902172704-13sdkm2","Type":"NodeParagraph","Properties":{"id":"20240902172704-13sdkm2","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱，大剂1～3两；浸酒或入丸、散。外用：煎水熏洗。"}]},{"ID":"20240902172704-mdm9zk6","Type":"NodeParagraph","Properties":{"id":"20240902172704-mdm9zk6","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902172704-339k88v","Type":"NodeParagraph","Properties":{"id":"20240902172704-339k88v","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"①治关节风湿痛：铁刺苓、活血龙、山楂根各三钱至五钱。煎服。（《浙江民间草药》）"}]},{"ID":"20240902172704-wyvzt4n","Type":"NodeParagraph","Properties":{"id":"20240902172704-wyvzt4n","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"②治患脚，积年不能行，腰脊挛痹及腹屈内紧急者：菝葜净洗，锉之，一斛，以水三斛，煮取九斗，以渍曲及煮去滓，取一斛渍饭，酿之如酒法，熟即取饮，多少任意。（《补缺肘后方》）"}]},{"ID":"20240902172704-dh77t7j","Type":"NodeParagraph","Properties":{"id":"20240902172704-dh77t7j","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"③治筋骨麻木：菝葜浸酒服。（《南京民间药草》）"}]},{"ID":"20240902172704-2de2oe9","Type":"NodeParagraph","Properties":{"id":"20240902172704-2de2oe9","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"④治消渴，饮水无休：菝葜（锉，炒），汤瓶内碱各一两，乌梅二个（并核捶碎，焙干）。上粗捣筛。每服二钱，水一盏，瓦器煎七分，去滓，稍热细呷。（《普济方》菝葜饮）"}]},{"ID":"20240902172704-3rmcptp","Type":"NodeParagraph","Properties":{"id":"20240902172704-3rmcptp","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑤治小便多，滑数不禁：金刚骨为末，以好酒调三钱，服之。（《儒门事亲》）"}]},{"ID":"20240902172704-4yqajz9","Type":"NodeParagraph","Properties":{"id":"20240902172704-4yqajz9","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑥治下痢赤白：金刚根和好腊茶等分，为末，白梅肉丸如鸡头大。每服五丸至七丸，小儿三丸。赤痢甘草汤下，白痢乌梅汤下，赤白痢乌梅甘草汤下。（《履巉岩本草》）"}]},{"ID":"20240902172704-ul8c6mz","Type":"NodeParagraph","Properties":{"id":"20240902172704-ul8c6mz","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑦治沙石淋：菝葜二两。捣罗为细散。每服一钱匕，米饮调下。服毕用地椒煎汤浴，连腰浸。（《圣济总录》菝葜散）"}]},{"ID":"20240902172704-57t382s","Type":"NodeParagraph","Properties":{"id":"20240902172704-57t382s","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑧治乳糜尿：楤木（鸟不宿）根、菝葜根茎各一两。水煎，分早晚二次服。（《全展选编·传染病》）"}]},{"ID":"20240902172704-nai94p6","Type":"NodeParagraph","Properties":{"id":"20240902172704-nai94p6","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑨治食道癌：鲜菝葜一斤。用冷水三斤，浓缩成一斤时，去渣，加肥猪肉二两，待肥肉熟后即可。此系一日量，分三次服完。（《中草药治肿瘤资料选编》）"}]},{"ID":"20240902172704-64at1ha","Type":"NodeParagraph","Properties":{"id":"20240902172704-64at1ha","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑩治赤白带下：菝葜半斤，捣碎煎汤，加糖二两。每日服。（《江苏药材志》）"}]},{"ID":"20240902172704-3rvidov","Type":"NodeParagraph","Properties":{"id":"20240902172704-3rvidov","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"⑾治流火：铁刺苓煎汁与猪脚煮食，或配土牛膝二钱煎服。（《浙江民间草药》）"}]},{"ID":"20240902172704-1coptg1","Type":"NodeParagraph","Properties":{"id":"20240902172704-1coptg1","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【各家论述】《纲目》：\"菝葜，气温味酸，性涩而收，与萆薢仿佛。\""}]},{"ID":"20240902172704-jk692xu","Type":"NodeParagraph","Properties":{"id":"20240902172704-jk692xu","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902172704-7nal62e","Type":"NodeParagraph","Properties":{"id":"20240902172704-7nal62e","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"①治疗外科急性感染"}]},{"ID":"20240902172704-fi3s0an","Type":"NodeParagraph","Properties":{"id":"20240902172704-fi3s0an","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"菝葜根1斤切碎，甘草25克，水煎两次，滤液合并文火浓缩至1000毫升左右，菝葜根浓度相当于50％。每次50毫升，日服2次。门诊治疗疖痈67例，随访27例均获显效；蜂窝织炎、淋巴结炎、乳腺炎63例，随访48例，显效43例，效果不明显5例；腹部炎性包块、阑尾脓肿8例，随访7例，显效6例，效果不明显1例。"}]},{"ID":"20240902172704-16wyegd","Type":"NodeParagraph","Properties":{"id":"20240902172704-16wyegd","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"②治疗风湿性关节炎"}]},{"ID":"20240902172704-l12ev8k","Type":"NodeParagraph","Properties":{"id":"20240902172704-l12ev8k","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"取鲜菝葜根2斤，用乙醇提取法制成300毫升注射液，每安瓿2毫升。每次肌注2毫升，每日1次。治疗52例，痊愈15例，显效10例，好转23例，无效4例。"}]},{"ID":"20240902172704-4u817eh","Type":"NodeParagraph","Properties":{"id":"20240902172704-4u817eh","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"③治疗牛皮癣"}]},{"ID":"20240902172704-j3lt7w5","Type":"NodeParagraph","Properties":{"id":"20240902172704-j3lt7w5","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"取菝葜根20～40克，用温开水1500毫升浸泡10小时，煮沸40～80分钟，每日分2～3次饭后服。治疗107例，痊愈（症状消失，皮损消失，或尚留几小块损害）13例，显效（症状基本消失，皮损消退约60～80％）26例，有效（症状明显减轻，皮损消失约30～60％，或皮损普遍变平、缩小，红色减退，鳞屑减少）46例，无效23例。痊愈病例停药后，部分有复发，但一般较轻，再服菝葜仍然有效。"}]},{"ID":"20240902172704-0r91p5r","Type":"NodeParagraph","Properties":{"id":"20240902172704-0r91p5r","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"④治疗癌肿"}]},{"ID":"20240902172704-nxxqzt8","Type":"NodeParagraph","Properties":{"id":"20240902172704-nxxqzt8","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"取菝葜根块洗净、切片、晾干，每日用干品0.5～1斤浸入6～7斤水中，1小时后用文火煎煮3小时去渣，加入肥肉1～2两再煎1小时，约得煎液500毫升，于1日内多次饮服。适用于胃癌、食管癌、直肠癌、乳腺癌、宫颈癌、鼻咽癌，其中以胃癌和食管癌效果较好。具有增进食欲、减少呕吐、疏通狭窄食管，以及利尿消肿、增强体力、提高红细胞及血红蛋白，和一定的止痛安眠作用。据200例（病情轻重不一）的观察，约45％的患者可获得近期疗效，症状缓解；个别病例可获得根治；有的控制1年多，没有症状；少数病例肿瘤缩小，但多数未见变化。本品对脾胃虚寒体质者较为适宜；此类病人服药后，感到胃肠舒适，胀气减轻，食量增加，食道癌患者粘液涎沫明显减少。反之阴亏偏热体质者，服后常易引起口干、烦躁、便秘、尿赤、口粘膜破溃，或便血、胃肠道出血。故对应用放射治疗后引起的一系列热性反应不宜应用。实践中观察到，本药对消化道致病菌有抑制作用，对肠道粘膜发炎的充血、水肿有收敛作用。因此，应用于宫颈癌放射治疗后的直肠结肠反应，出现粘液血便者，有良好效果。由于本品含有皂素及鞣酸等杂质，对胃肠道粘膜有一定的刺激性，所以加用猪肉同煎以中和皂素及杂质，以免刺激胃肠引起恶心、呕吐。"}]},{"ID":"20240902172704-iolvsda","Type":"NodeParagraph","Properties":{"id":"20240902172704-iolvsda","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【备注】本植物的叶（菝葜叶）亦供药用，另详专条。"}]},{"ID":"20240902172704-9j5r3ce","Type":"NodeParagraph","Properties":{"id":"20240902172704-9j5r3ce","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902172704-j9uyh9c","Type":"NodeParagraph","Properties":{"id":"20240902172704-j9uyh9c","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"菝葜《中华本草》"}]},{"ID":"20240902172704-wy3t8nk","Type":"NodeParagraph","Properties":{"id":"20240902172704-wy3t8nk","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902172704-ai80b6t","Type":"NodeParagraph","Properties":{"id":"20240902172704-ai80b6t","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：菝葜，生山野，二月，八月采根，暴干。"}]},{"ID":"20240902172704-5s23cqo","Type":"NodeParagraph","Properties":{"id":"20240902172704-5s23cqo","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：此有三种，大略根苗并相类，菝葜茎紫短小，多细刺，小减萆XIE而色深，人用作饮。"}]},{"ID":"20240902172704-b3jybpc","Type":"NodeParagraph","Properties":{"id":"20240902172704-b3jybpc","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：陶云三种相类，非也。萆XIE有刺者，叶粗相类，根不相类，萆XIE细长而白，菝葜根作块结，黄赤色，殊非狗脊之流也。"}]},{"ID":"20240902172704-u51bwiq","Type":"NodeParagraph","Properties":{"id":"20240902172704-u51bwiq","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：菝葜，近京及江，浙州郡多有之。苗茎成蔓，长二，三尺，有刺。其叶如冬青，乌药叶，又似菱"}]},{"ID":"20240902172704-ytcw45l","Type":"NodeParagraph","Properties":{"id":"20240902172704-ytcw45l","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáQiā"}]},{"ID":"20240902172704-f9mpy3y","Type":"NodeParagraph","Properties":{"id":"20240902172704-f9mpy3y","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【英文名】ChinarootGreenbierRhizome"}]},{"ID":"20240902172704-6o2clo9","Type":"NodeParagraph","Properties":{"id":"20240902172704-6o2clo9","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【别名】金刚根、金刚骨、金刚藤、山梨儿、铁刷子、铁菱角、金刚刺、金刚头、假萆薢、山菱角、霸王力、沟谷刺、金巴斗、豺狗刺、马甲、硬饭头、冷饭头、龙爪菜、普贴、鸡肝根、路边刷、鲎壳刺、铁刺苓、饭巴铎、冷饭巴、金刚鞭、马鞍宫、马加刺兜、马加勒"}]},{"ID":"20240902172704-1hk4ey5","Type":"NodeParagraph","Properties":{"id":"20240902172704-1hk4ey5","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902172704-qdvotkp","Type":"NodeParagraph","Properties":{"id":"20240902172704-qdvotkp","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"药材基源：为百合科植物菝葜的根茎。"}]},{"ID":"20240902172704-cx5nktz","Type":"NodeParagraph","Properties":{"id":"20240902172704-cx5nktz","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SmilaxchinaL."}]},{"ID":"20240902172704-2hbltvz","Type":"NodeParagraph","Properties":{"id":"20240902172704-2hbltvz","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"采收和储藏：2月或8月采挖根茎，除去泥土及须根，晒干。"}]},{"ID":"20240902172704-6gbqvsl","Type":"NodeParagraph","Properties":{"id":"20240902172704-6gbqvsl","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【原形态】菝葜，攀缘状灌木。高1-3m。疏生刺。根茎粗厚，坚硬，为不规则的块根，粗2-3cm。叶互生；叶柄长5-15mm，约占全长的1/3-1/2，具宽0.5-1mm的狭鞘，几科都有卷须，少有例外，脱落点位于靠近卷须处；叶片薄革质或坚纸质，卵圆形或圆形、椭圆形，长3-10cm，宽1.5-5（-10）cm，基部宽楔形至心形，下面淡绿色，较少苍白色，有时具粉霜。花单性，雌雄异株；伞形花序生于叶尚幼嫩的小枝上，具十几朵或更多的花，常呈球形；总花梗长1-2cm，花序托稍膨大，近球形，较少稍延长，具小苞片；花绿黄色，外轮花被片3，长圆形，长3.5-4.5mm，宽1.5-2mm，内轮花被片，稍狭。雄蕊长约为花被片的2/3，花药比花丝稍宽，常弯曲；雌花与雄花大小相似，有6枚退化雄蕊。浆果直径6-15mm，熟时红色，有粉霜。花期2-5月，果期9-11月。"}]},{"ID":"20240902172704-p96qnca","Type":"NodeParagraph","Properties":{"id":"20240902172704-p96qnca","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902172704-5rogfup","Type":"NodeParagraph","Properties":{"id":"20240902172704-5rogfup","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔2000m以下的林下灌木丛中、路旁、河谷或山坡上。"}]},{"ID":"20240902172704-riutiiq","Type":"NodeParagraph","Properties":{"id":"20240902172704-riutiiq","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于化东、中南、西南、及台湾等地。"}]},{"ID":"20240902172704-quqcss5","Type":"NodeParagraph","Properties":{"id":"20240902172704-quqcss5","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别根茎扁柱形，略弯曲，或不规则形，长10-20cm，直径2-4cm。表面黄棕色或紫棕色，结节膨大处有圆锥状突起的茎痕、芽痕及细根断痕，或留有坚硬折断的细根，呈刺状，节上有鳞叶；有时先端残留地上茎。质坚硬，断面棕黄色或红棕色，粗纤维性。气微味，味微苦。以根茎粗壮、断面色红者为佳。显微鉴别粉末特征：浅棕红色。①淀粉粒类圆形或半圆球形，直径5-30μm，脐点点状、裂缝状或飞鸟状；复粒较少，2-4分粒组成。②石细胞单个散在或数个成群，淡黄色或红棕色，类圆形、长椭圆形、类方形或不规则形，直径40-195μm，壁厚8-45μm，木化，孔沟明显，胞腔较小，有的含红棕色物。③短纤维易见，淡黄色长方形或短梭状，壁微木化。④草酸钙针晶长75-140μm，偶有成束存在于粘液细胞中。"}]},{"ID":"20240902172704-3aikbwn","Type":"NodeParagraph","Properties":{"id":"20240902172704-3aikbwn","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含菝葜素（smilaxin），异内杞甙（isoengeletin），齐墩果酸（oleanolicacid），山柰素（kaempferide），二氢山柰素（dihydrokaempferide），β-谷甾醇（β-sitosterol），β-谷甾醇葡萄糖甙（β-sitosteroylglucoside），薯蓣皂甙的原皂甙元A（prosapogeninAofdioscin），薯蓣皂甙（dioscin），纤细薯蓣皂甙（gracillin），甲基原纤细薯蓣皂甙（methylprotogracillin），甲基原薯蓣皂甙（methylprotodioscin）等。新替告皂甙元-3-O-α-L-吡喃鼠李糖-（1→6）-β-D-吡喃葡萄糖甙（neotigogenin-3-O-α-L-rhamnopyranosyl-（1→6）-β-D-glucopyranoside），新替告皂甙元-3-O-β-D-吡喃葡萄糖-（1→4）-O-[α-L-吡喃鼠李糖-（1→6）]-β-D-吡喃葡萄糖甙"}]},{"ID":"20240902172704-bf51wn0","Type":"NodeParagraph","Properties":{"id":"20240902172704-bf51wn0","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902172704-o4i3e5e","Type":"NodeParagraph","Properties":{"id":"20240902172704-o4i3e5e","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"1.利尿，解毒作用：煎剂对犬急性利尿实验，不能使尿量增加，对急性汞中毒大白鼠亦无利尿作用，但能使尿中排汞量略增加，对正常家兔及急性汞中毒家兔网状内皮系统功能均无明显影响。"}]},{"ID":"20240902172704-ms5ject","Type":"NodeParagraph","Properties":{"id":"20240902172704-ms5ject","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"2.抗锥虫作用：25%与50%的煎剂，不论灌胃或腹腔注射，均能暂时抑制马疫锥虫的繁殖，延缓小白鼠的死亡时间，但不能清除血中锥虫使小白鼠得以治愈。不论灌胃或注射均使小白鼠出现鼓肠。前者与马齿苋合用疗效增加，副作用减少，在试管内对金黄色葡萄球菌，绿脓杆菌，大肠杆菌有抑菌作用。菝葜水煎液6%浓度，醇浸液3%浓度，平板法试验对炭疽杆菌有抑菌作用。"}]},{"ID":"20240902172704-iwd001z","Type":"NodeParagraph","Properties":{"id":"20240902172704-iwd001z","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【炮制】将原药用清水浸洗，润透，切成薄片，晒干。"}]},{"ID":"20240902172704-vwbsxyb","Type":"NodeParagraph","Properties":{"id":"20240902172704-vwbsxyb","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【性味】甘；酸；性平"}]},{"ID":"20240902172704-amgnx53","Type":"NodeParagraph","Properties":{"id":"20240902172704-amgnx53","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾经"}]},{"ID":"20240902172704-iak0n6v","Type":"NodeParagraph","Properties":{"id":"20240902172704-iak0n6v","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风利湿；解毒消痈。主风湿痹痛；淋浊；带下；泄泻；痢疾；痈肿疮毒；顽癣；烧烫伤"}]},{"ID":"20240902172704-sfen8df","Type":"NodeParagraph","Properties":{"id":"20240902172704-sfen8df","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎肠，10-30g；或浸酒；或入丸、散。"}]},{"ID":"20240902172704-yhoio51","Type":"NodeParagraph","Properties":{"id":"20240902172704-yhoio51","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：“忌茗、醋。”"}]},{"ID":"20240902172704-61kps9j","Type":"NodeParagraph","Properties":{"id":"20240902172704-61kps9j","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902172704-gbqsd9i","Type":"NodeParagraph","Properties":{"id":"20240902172704-gbqsd9i","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"1.《别录》：主腰背寒痛，风痹，益血气，止小便利。"}]},{"ID":"20240902172704-wg1u7m1","Type":"NodeParagraph","Properties":{"id":"20240902172704-wg1u7m1","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：治时疾瘟瘴。"}]},{"ID":"20240902172704-okdkhft","Type":"NodeParagraph","Properties":{"id":"20240902172704-okdkhft","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"3.《品汇精要》：散肿毒。"}]},{"ID":"20240902172704-wmzi8ty","Type":"NodeParagraph","Properties":{"id":"20240902172704-wmzi8ty","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治消渴，血崩，下利。"}]},{"ID":"20240902172704-1pm7t36","Type":"NodeParagraph","Properties":{"id":"20240902172704-1pm7t36","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"5.《本草原始》：利小便。"}]},{"ID":"20240902172704-9qtws28","Type":"NodeParagraph","Properties":{"id":"20240902172704-9qtws28","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"6.《医林纂要》：缓肝坚肾，清小肠火，化膀胱水。治恶疮，毒疮，虫毒。"}]},{"ID":"20240902172704-0xy7o3i","Type":"NodeParagraph","Properties":{"id":"20240902172704-0xy7o3i","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"7.《南京民间药草》：化痰止咳。浸酒服，可治筋骨麻木。"}]},{"ID":"20240902172704-8befgkv","Type":"NodeParagraph","Properties":{"id":"20240902172704-8befgkv","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"8.《福建民间草药》：治疝气。"}]},{"ID":"20240902172704-neukbdy","Type":"NodeParagraph","Properties":{"id":"20240902172704-neukbdy","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"9.《江苏植药志》：泡酒服治心头痛。"}]},{"ID":"20240902172704-d3oc1cv","Type":"NodeParagraph","Properties":{"id":"20240902172704-d3oc1cv","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"10.《浙江民间草药》：治流火。"}]},{"ID":"20240902172704-9xy2tgh","Type":"NodeParagraph","Properties":{"id":"20240902172704-9xy2tgh","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"11.《四川中药志》：清热，除风毒。治崩，带，血淋，瘰疬，跌打损伤。"}]},{"ID":"20240902172704-jj9zmdh","Type":"NodeParagraph","Properties":{"id":"20240902172704-jj9zmdh","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"12.广州部队《常用中草药手册》：祛风除湿。治腰腿疼痛，风湿性关节炎，肠炎腹泻。"}]},{"ID":"20240902172704-v0hojca","Type":"NodeParagraph","Properties":{"id":"20240902172704-v0hojca","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"13.江西《中草药学》：解毒祛风，为疮痈要药。治历节痛风，肌肉麻痹，食道癌，牛皮癣。"}]},{"ID":"20240902172704-pod64p9","Type":"NodeParagraph","Properties":{"id":"20240902172704-pod64p9","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"14.《纲目》：菝葜，气温味酸，性涩而收，与萆XIE仿佛。"}]},{"ID":"20240902172704-4ff9iox","Type":"NodeParagraph","Properties":{"id":"20240902172704-4ff9iox","updated":"20240902172721"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902172705-mrxrpkf","Type":"NodeThematicBreak","Properties":{"id":"20240902172705-mrxrpkf","updated":"20240902172721"}},{"ID":"20240902172706-ex0mlj9","Type":"NodeParagraph","Properties":{"id":"20240902172706-ex0mlj9","updated":"20240902172721"}}]}