dth: 508px;","style":"width: 498px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"北豆根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/北豆根 5-20240710124221-1fp5v5f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 498px;\" parent-style=\"width: 508px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830154423-82xyevh","Type":"NodeParagraph","Properties":{"id":"20240830154423-82xyevh","updated":"20240830154435"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：北豆根就是蝙蝠葛的根；"}]},{"ID":"20240710130237-ojtr3md","Type":"NodeThematicBreak","Properties":{"id":"20240710130237-ojtr3md"}},{"ID":"20240830155111-8v1ft6f","Type":"NodeParagraph","Properties":{"id":"20240830155111-8v1ft6f","updated":"20240830155119"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：北豆根"}]},{"ID":"20240830155111-sfqyfrm","Type":"NodeParagraph","Properties":{"id":"20240830155111-sfqyfrm","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"北豆根《中国药典》"}]},{"ID":"20240830155111-b9m75p2","Type":"NodeParagraph","Properties":{"id":"20240830155111-b9m75p2","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【拼音名】BěiDòuGēn"}]},{"ID":"20240830155111-ep5xf8d","Type":"NodeParagraph","Properties":{"id":"20240830155111-ep5xf8d","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMAMENISPERMI"}]},{"ID":"20240830155111-q4ux4x2","Type":"NodeParagraph","Properties":{"id":"20240830155111-q4ux4x2","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【别名】黄条香、黄根、汉防己、防己藤、山地瓜秧"}]},{"ID":"20240830155111-471co49","Type":"NodeParagraph","Properties":{"id":"20240830155111-471co49","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【来源】本品为防己科植物蝙蝠葛MenispermumdauricumDC.的干燥根茎。春、秋二季采挖，除去须根及泥沙，干燥。"}]},{"ID":"20240830155111-1wt3fz5","Type":"NodeParagraph","Properties":{"id":"20240830155111-1wt3fz5","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈细长圆柱形，弯曲，有分枝，长可达50cm，直径0.3～0.8cm。表面黄棕色至暗棕色，多有弯曲的细根，并可见突起的根痕及纵皱纹，外皮易剥落。质韧，不易折断，断面不整齐，纤维细，木部淡黄色，呈放射状排列，中心有髓。气微，味苦。"}]},{"ID":"20240830155111-rvytv6c","Type":"NodeParagraph","Properties":{"id":"20240830155111-rvytv6c","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品呈细长圆柱形，弯曲，有分枝，长可达50cm，直径0.3～0.8cm。表面黄棕色至暗棕色，多有弯曲的细根，并可见突起的根痕及纵皱纹，外皮易剥落。质韧，不易折断，断面不整齐，纤维细，木部淡黄色，呈放射状排列，中心有髓。气微，味苦。"}]},{"ID":"20240830155111-znlrb5z","Type":"NodeParagraph","Properties":{"id":"20240830155111-znlrb5z","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240830155111-9lgfr5d","Type":"NodeParagraph","Properties":{"id":"20240830155111-9lgfr5d","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒；有小毒。"}]},{"ID":"20240830155111-4snai2q","Type":"NodeParagraph","Properties":{"id":"20240830155111-4snai2q","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、胃、大肠经。"}]},{"ID":"20240830155111-xj4o8pd","Type":"NodeParagraph","Properties":{"id":"20240830155111-xj4o8pd","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，祛风止痛。用于咽喉肿痛，肠炎痢疾，风湿痹痛。"}]},{"ID":"20240830155111-35th6h1","Type":"NodeParagraph","Properties":{"id":"20240830155111-35th6h1","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240830155111-57un7i8","Type":"NodeParagraph","Properties":{"id":"20240830155111-57un7i8","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830155111-ybfddpx","Type":"NodeParagraph","Properties":{"id":"20240830155111-ybfddpx","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830155111-0dzzr9d","Type":"NodeParagraph","Properties":{"id":"20240830155111-0dzzr9d","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"北豆根《中华本草》"}]},{"ID":"20240830155111-wekpvwd","Type":"NodeParagraph","Properties":{"id":"20240830155111-wekpvwd","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【拼音名】BěiDòuGēn"}]},{"ID":"20240830155111-hycqj8i","Type":"NodeParagraph","Properties":{"id":"20240830155111-hycqj8i","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【别名】蝙蝠葛根、北山豆根、马串铃、狗骨头、野豆根、山豆根、黄根、黄条香苦豆根、山豆秧根（内蒙）。"}]},{"ID":"20240830155111-zvi1s6l","Type":"NodeParagraph","Properties":{"id":"20240830155111-zvi1s6l","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830155111-pue9la1","Type":"NodeParagraph","Properties":{"id":"20240830155111-pue9la1","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"药材基源：为防已科植物蝙蝠葛的根茎。"}]},{"ID":"20240830155111-modbwt6","Type":"NodeParagraph","Properties":{"id":"20240830155111-modbwt6","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：MenispermumdauricumDC."}]},{"ID":"20240830155111-ygpo22v","Type":"NodeParagraph","Properties":{"id":"20240830155111-ygpo22v","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋采挖，除去须泥土，洗净，晒干。"}]},{"ID":"20240830155111-p3aldwg","Type":"NodeParagraph","Properties":{"id":"20240830155111-p3aldwg","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【原形态】蝙蝠葛多年生缠绕藤本，长达10m以上。根茎细长、横走，黄棕色或黑褐色，有分枝。小枝绿色，有细纵纹。叶互生；圆肾形或卵圆形，边缘3-7浅裂片近三角形，长、宽各5-15cm，先端尖，基部心形或截形，上面绿色，下面苍白色，掌状脉5-7条；叶柄盾状着生，长6-15cm。腋生短圆锥花序，总花梗长3-7cm；花小，黄绿色，有小苞片；雄蕊10-20；雌花心皮3，分离。核果扁球形，直径8-10mm，熟时黑紫色，内果皮坚硬，肾状扁圆形，有环状突起的雕纹。花期5-6月，果期7-9月。"}]},{"ID":"20240830155111-0bri9ah","Type":"NodeParagraph","Properties":{"id":"20240830155111-0bri9ah","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830155111-1nggbj7","Type":"NodeParagraph","Properties":{"id":"20240830155111-1nggbj7","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡林缘、灌丛中、田边、路旁及石砾滩地，或攀援于岩石上。"}]},{"ID":"20240830155111-phzra9n","Type":"NodeParagraph","Properties":{"id":"20240830155111-phzra9n","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东及陕西、宁夏、甘肃、山东等地。"}]},{"ID":"20240830155111-qa6jidv","Type":"NodeParagraph","Properties":{"id":"20240830155111-qa6jidv","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830155111-d6zfqww","Type":"NodeParagraph","Properties":{"id":"20240830155111-d6zfqww","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"性状鉴定根茎细圆柱形，略弯曲，有分枝，长30-50cm，直径3-8mm。表面黄棕色至褐棕色，有纵皱纹、细长须根或突起的须根痕，外皮极易脱落。质韧，不易折断，折断面不整齐，纤维性，木部淡黄色，中心有髓。气微，味苦。以条粗、外皮黄棕色、断面浅黄色者为佳。"}]},{"ID":"20240830155111-iv72nc3","Type":"NodeParagraph","Properties":{"id":"20240830155111-iv72nc3","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"显微鉴别根茎横切面；表皮细胞不连成环。木栓层断续存在。皮层有少数不规则形石细胞。中柱鞘纤维呈新月形，两侧有石细胞群。外韧型维管束之高阁环列。束间形成层不明显。射线较宽，有石细胞散在。髓细胞具纹孔。本品薄壁细胞含细小淀粉粒和草酸钙方晶、针晶和棒晶。粉末特征：灰棕色。①石细胞单个散在，多呈不规则分技状，直径43-147μm，少数长至370μm，壁厚12-34μm，孔沟明显，胸腔较大，有的具1-3个横隔，分成2-4小腔，内含棕色物或细小草酸钙砂晶；另有少数石细胞呈类图形、类长方形或类三角形，壁稍厚，有的可见层纹。②韧皮纤维成束或散离，呈长梭形，边缘平整或有凸凹，直径17-46μm，壁厚5-12μm，纹孔斜裂缝状、人字形或十字形，孔沟明显，胞腔有时具分隔，内含草酸钙砂晶。③皮层细胞及射线细胞含有较多草酸钙砂晶，少数草酸钙方晶。此外，有木纤维，具缘纹乱及网纹导管。"}]},{"ID":"20240830155111-mu7j6at","Type":"NodeParagraph","Properties":{"id":"20240830155111-mu7j6at","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【化学成份】蝙蝠葛根茎含山豆根碱（dauricine），6-去甲山豆根碱（daurinoline），6’-去甲山豆根碱（dauricinoline），木兰花碱（magnoflorine），青藤碱（sinomenine），蝙蝠葛任碱（meni-sperine)，6,6＇二去甲山豆根碱（dauricoline），尖防已碱（acutu-mine），N-去申尖防己碱（N-acuturnidine），蝙蝠葛辛（bianfugcine），蝙蝠葛定（bianfugedine），蝙蝠葛宁（bianfugenine），碎叶紫堇碱（cheilanthifoline），光千金藤碱（stepharine），光千金藤定碱（stepholi-dine），蝙蝠葛波芬碱（menisporphine），7’-去甲山豆根碱（dau-risoline)，7，7＇-二去申山豆很碱（dauriciline)，山豆根波芬诺灵碱（dauriporphinoline）。叶含去羟尖防已碱（acutuminine)。"}]},{"ID":"20240830155111-rfha2eu","Type":"NodeParagraph","Properties":{"id":"20240830155111-rfha2eu","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粉末约5g，加氨试液5ml润湿，放置20min，加氯仿50ml，振摇，放置罡1h,滤过。滤液置分液漏斗中，加10％盐酸溶液5ml，振摇提取。分取酸液层，置2支试管中，一管加碘化铋钾试液，产生橙红色沉淀。另一管加碘试液，产生棕色沉淀。（检查生物碱）（2）薄层色谱取本品粗粉2g，加氨试液1.5ml及苯15ml,浸泡过夜，滤过。滤液用0.5％硫酸16ml分4次提取。酸液合并，用浓氨水碱化，再以氯仿20ml分4次提取。氯仿液合并，加无水硫酸钠少许脱水，放置lh，滤过，浓缩至约0.8ml，作供试品溶液，另取山豆根碱加氯仿制成对照品溶液，分别吸取两溶液点于同一硅胶H-CMC薄层板上，用氯仿-甲醇（80：20）（每10ml混合液中加6滴氨水）展开后，喷改良碘化铋钾试剂显色。供试品色谱中在与对照品色谱相应位置显相同颜色斑点。"}]},{"ID":"20240830155111-ks7s7q7","Type":"NodeParagraph","Properties":{"id":"20240830155111-ks7s7q7","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240830155111-4n5rhbz","Type":"NodeParagraph","Properties":{"id":"20240830155111-4n5rhbz","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【性味】苦；寒；有小毒"}]},{"ID":"20240830155111-bjaf63b","Type":"NodeParagraph","Properties":{"id":"20240830155111-bjaf63b","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、胃、大肠经"}]},{"ID":"20240830155111-y8t0dh1","Type":"NodeParagraph","Properties":{"id":"20240830155111-y8t0dh1","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；消肿止痛；利湿。主咽喉肿痛；肺热咳嗽；痄腮；泻痢；黄疸；风湿痹痛；痔疮肿痛；蛇虫咬伤"}]},{"ID":"20240830155111-pom9ks7","Type":"NodeParagraph","Properties":{"id":"20240830155111-pom9ks7","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎服，3-9g。治咽喉肿痛宜含于口中缓缓咽下。外用：适量，研未调敷或煎水泡洗。"}]},{"ID":"20240830155111-mukdmmc","Type":"NodeParagraph","Properties":{"id":"20240830155111-mukdmmc","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【制剂】北豆根片。"}]},{"ID":"20240830155111-sl6b6j7","Type":"NodeParagraph","Properties":{"id":"20240830155111-sl6b6j7","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于咽喉肿痛，肠炎痢疾，风湿痹痛。"}]},{"ID":"20240830155111-e87kcta","Type":"NodeParagraph","Properties":{"id":"20240830155111-e87kcta","updated":"20240830155119"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830155113-zopklyk","Type":"NodeThematicBreak","Properties":{"id":"20240830155113-zopklyk","updated":"20240830155119"}},{"ID":"20240830155114-ysjg315","Type":"NodeParagraph","Properties":{"id":"20240830155114-ysjg315","updated":"20240830155119"}}]}