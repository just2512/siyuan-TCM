4130107"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草乌 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草乌 25-20240724130100-p5okoiy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 608px;","style":"width: 598px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草乌 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草乌 20-20240724124520-4pvumty.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724114255-pb2p8ur","Type":"NodeParagraph","Properties":{"id":"20240724114255-pb2p8ur","updated":"20240724114311"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：草乌有剧毒，请在专业人士指导下使用；"}]},{"ID":"20240724124017-1oqhbwj","Type":"NodeParagraph","Properties":{"id":"20240724124017-1oqhbwj","updated":"20240724124804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：川乌和草乌相比，川乌是直立的多年生草本，而草乌则是藤蔓植物（"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"草乌是先直立，后爬蔓；大概在长到50公分之前，它是直立的，杆比较硬，随着周围植物长高，他就变成爬蔓缠绕其它植物生长"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"）"}]},{"ID":"20240724125619-w28gmba","Type":"NodeParagraph","Properties":{"id":"20240724125619-w28gmba","updated":"20240724133320"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：川乌和草乌都有剧毒，川乌一定处理后可内用，而草乌多为外用，如内服需制过；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205153741-4hu2q84","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"265乌头（川乌头）"}]},{"ID":"20240724114039-7f8dm4i","Type":"NodeThematicBreak","Properties":{"id":"20240724114039-7f8dm4i"}},{"ID":"20240902164826-oy6dq5i","Type":"NodeParagraph","Properties":{"id":"20240902164826-oy6dq5i","updated":"20240902164834"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：草乌头"}]},{"ID":"20240902164826-cx1ojdh","Type":"NodeParagraph","Properties":{"id":"20240902164826-cx1ojdh","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"草乌头《*辞典》"}]},{"ID":"20240902164826-dh532j1","Type":"NodeParagraph","Properties":{"id":"20240902164826-dh532j1","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【出处】侯宁极《药谱》"}]},{"ID":"20240902164826-6jufjrl","Type":"NodeParagraph","Properties":{"id":"20240902164826-6jufjrl","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【拼音名】CǎoWūTóu"}]},{"ID":"20240902164826-uagpm73","Type":"NodeParagraph","Properties":{"id":"20240902164826-uagpm73","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【别名】堇（《庄子》），芨（《尔雅》），乌头、乌喙、奚毒（《本经》），鸡毒（《淮南子》），茛、千秋、毒公、果负、耿子、帝秋（《吴普本草》），独白草（《续汉书》），土附子（《日华子本草》），草乌（《圣济总录》），竹节乌头、金鸦（《纲目》），断肠草（《新疆药材》）。"}]},{"ID":"20240902164826-yzgzc19","Type":"NodeParagraph","Properties":{"id":"20240902164826-yzgzc19","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【来源】为毛茛科植物乌头（野生种）、北乌头或其他多种同属植物的块根。秋季茎叶枯萎时采挖，除去残茎及泥土，晒干或烘干。"}]},{"ID":"20240902164826-8sguyua","Type":"NodeParagraph","Properties":{"id":"20240902164826-8sguyua","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902164826-nzsiiir","Type":"NodeParagraph","Properties":{"id":"20240902164826-nzsiiir","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①乌头，详\"川乌头\"条。"}]},{"ID":"20240902164826-ho3brbm","Type":"NodeParagraph","Properties":{"id":"20240902164826-ho3brbm","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②北乌头，又名:五毒根、小叶芦、鞿鞡花、蓝乌拉花、蓝花草、百步草。"}]},{"ID":"20240902164826-iwu2fjv","Type":"NodeParagraph","Properties":{"id":"20240902164826-iwu2fjv","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"多年生草本，高70～150厘米。块根常2～5块连生，倒圆锥形，长2.5～5厘米，外皮黑褐色。茎直立，光滑。叶互生，有柄；叶片近于革质，全角为卵圆形，长6～14厘米，宽8～9厘米，3全裂，裂片菱形，再作深浅不等的羽状缺刻状分裂，最终裂片线状披针形或披针形，先端尖，二面均光滑，或有时微被毛。总状花序，或有时为紧缩的圆锥花序；花萼5，紫蓝色，上萼片盔形，长1.5～2厘米，侧萼片长1.4～1.7厘米；花瓣2，无毛，有长爪，距长1～4毫米；雄蕊多数，无毛；子房5个，稀有3～4个，无毛，花柱与子房等长。蓇葖果长1～2厘米。种子有膜质翅。花期7～8月。果期8～9月。"}]},{"ID":"20240902164826-wiou3od","Type":"NodeParagraph","Properties":{"id":"20240902164826-wiou3od","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"生于草甸子、灌木丛间、山坡及林缘。分布黑龙江、吉林、辽宁、内蒙古、河北、山西等地。"}]},{"ID":"20240902164826-jzvro86","Type":"NodeParagraph","Properties":{"id":"20240902164826-jzvro86","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国大部分地区均产。主产于浙江、湖北、湖南、江苏、安徽、辽宁等地。"}]},{"ID":"20240902164826-ms4z6zm","Type":"NodeParagraph","Properties":{"id":"20240902164826-ms4z6zm","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的块根，一般呈圆锥形而梢弯曲，形如乌鸦头，长约3～7厘米，直径约1～3厘米。顶端平圆，中央常残留茎基或茎基的残痕，表面暗棕色或灰褐色，外皮皱缩不平，有时具短而尖的支根，习称\"钉角\"。质坚，难折断，断面灰白色，粉性，有曲折的环纹及筋脉小点。无臭，味辛辣而麻舌。口尝须特别谨慎，切勿咽下。以个大、肥壮、质坚实、粉性足、残茎及须根少者为佳。"}]},{"ID":"20240902164826-wqceiqs","Type":"NodeParagraph","Properties":{"id":"20240902164826-wqceiqs","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902164826-dk50yqj","Type":"NodeParagraph","Properties":{"id":"20240902164826-dk50yqj","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"乌头各部分含生物碱，其中主为乌头碱。乌头碱水解后生成乌头原碱、醋酸及苯甲酸。叶中还含肌醇及鞣质。"}]},{"ID":"20240902164826-s4dho29","Type":"NodeParagraph","Properties":{"id":"20240902164826-s4dho29","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"多根乌头含有乌头碱，准噶尔乌头碱，准噶尔乌头胺，多根乌头碱，多根乌头定碱，乌头芬碱。"}]},{"ID":"20240902164826-uiq4sp9","Type":"NodeParagraph","Properties":{"id":"20240902164826-uiq4sp9","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"准噶尔乌头根含总生物碱量1.5％，主要为乌头碱，准噶尔乌头碱。地上部分含总生物碱量0.7％，主要为准噶尔乌头碱。"}]},{"ID":"20240902164826-2wxg3zr","Type":"NodeParagraph","Properties":{"id":"20240902164826-2wxg3zr","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"亚东乌头含有生物碱为伪乌头碱。"}]},{"ID":"20240902164826-7krv08m","Type":"NodeParagraph","Properties":{"id":"20240902164826-7krv08m","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"紫草乌地上部分（叶和梗）含生物碱0.58％，其中分出结晶生物碱称紫草乌碱0.43％。"}]},{"ID":"20240902164826-fi6aij2","Type":"NodeParagraph","Properties":{"id":"20240902164826-fi6aij2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"据报道，日本产乌头除含乌头碱和新乌头碱外，还有次乌头碱、惰碱。"}]},{"ID":"20240902164826-1ynxkng","Type":"NodeParagraph","Properties":{"id":"20240902164826-1ynxkng","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902164826-dabh3le","Type":"NodeParagraph","Properties":{"id":"20240902164826-dabh3le","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"草乌头（品种未鉴定）用小白鼠热板法实验，具有较强的镇痛作用，如与秦艽配伍，其镇痛效力可互相增强。草乌经甘草、黑豆法炮制后，毒性降低而不影响其镇痛效力。甘草、蜂蜜对草乌有解毒作用。草乌与川乌作用基本相同，前者生物碱含量0.425％，后者0.5991％。"}]},{"ID":"20240902164826-ebim4jq","Type":"NodeParagraph","Properties":{"id":"20240902164826-ebim4jq","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"多根乌头中提出的总碱，10～20毫克/公斤注射于麻醉犬及兔，从心电图上可见心跳兴奋性及传导发生紊乱。"}]},{"ID":"20240902164826-xk99q6i","Type":"NodeParagraph","Properties":{"id":"20240902164826-xk99q6i","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"自准噶尔乌头根中提出的生物碱超过30种以上，准噶尔乌头碱属于Atisine一类，将其400毫克/公斤皮下注射，可使小白鼠自发活动降低，有时后肢强直性收缩；对兔有弱的镇静作用，并能延长小鼠用催眠药引起的麻醉时间；用于兔有降温作用；静脉注射可降压，大剂量能阻断神经节，有弱的解M-胆碱样作用。酊剂外用可作为止痛剂，以治疗神经痛、偏头痛等，其止痛作用主要来自乌头碱，毒性极大。"}]},{"ID":"20240902164826-2qzhq79","Type":"NodeParagraph","Properties":{"id":"20240902164826-2qzhq79","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"紫草乌"}]},{"ID":"20240902164826-1mvuwdp","Type":"NodeParagraph","Properties":{"id":"20240902164826-1mvuwdp","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"㈠局部麻醉作用:从紫草乌的叶和茎中分离得紫草乌碱，其1％溶液具有局部麻醉作用，效力相当于可卡因的2倍，将紫草乌碱注射于大白鼠大腿后侧坐骨神经周周，能产生传导阻滞；对人舌头有麻木和针刺感。将紫草乌碱溶液加热或放置于室温2～3个月之久，均不失效。异乌头碱0.02％溶液对家兔角膜有较弱的局部麻醉作用，将其注射于小白鼠大腿后侧坐骨神经周围，能使之产生传导阻滞.但局部刺激明显，且易吸收中毒，故不理想。㈡镇痛作用:用小白鼠热板法作实验，紫草乌碱小且不能提高痛阈，大量始有效，其镇痛指数很低。"}]},{"ID":"20240902164826-ce88s61","Type":"NodeParagraph","Properties":{"id":"20240902164826-ce88s61","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"林地乌头"}]},{"ID":"20240902164826-815v8hr","Type":"NodeParagraph","Properties":{"id":"20240902164826-815v8hr","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"对离体蛙心有兴奋作用，使心收缩加强，频率加快；灌流于离体蛙肝使血管扩张，小量升压，大量则抑制心血管；对饥饿动物能使其体重很快恢复，正常犬、兔口服后体重增加更快。"}]},{"ID":"20240902164826-kh68oqb","Type":"NodeParagraph","Properties":{"id":"20240902164826-kh68oqb","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"日本产A.lusidusculumNakai的成分Lucidusculin能抑制嘌呤类利尿作用，但对盐类利尿剂无影响，与乌头碱有本质的差别。A.gIgasL.etV.极毒，能使放牧的牛死亡；其中所含生物碱主要抑制运动神经末梢，有类似箭毒样作用。A.spicatumStapf的根，对注射酵母引起发热的大鼠有解热作用，对小鼠扭体反应及机械引起的疼痛有镇痛作用，镇痛治疗指数高，说明较安全。A.heterophyllumWall.的成分Atisine口服或肌肉注射，对发热的家兔无解热作用，静脉注射能轻度降压。"}]},{"ID":"20240902164826-ehoos58","Type":"NodeParagraph","Properties":{"id":"20240902164826-ehoos58","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【炮制】制草乌:取净草乌，用凉水浸漂，每日换水2～3次，至口尝仅稍留麻辣感时取出，同甘草、黑豆加水共煮，以草乌熟透；内无白心为度，然后除去甘草及黑豆，晒至六成干，闷润后切片，晒干。（每草乌100斤，用甘草5斤，黑豆10斤）"}]},{"ID":"20240902164826-njui6f2","Type":"NodeParagraph","Properties":{"id":"20240902164826-njui6f2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902164826-lyodmf8","Type":"NodeParagraph","Properties":{"id":"20240902164826-lyodmf8","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"辛，热，有毒。"}]},{"ID":"20240902164826-5yn7cx7","Type":"NodeParagraph","Properties":{"id":"20240902164826-5yn7cx7","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"味辛，温。\""}]},{"ID":"20240902164826-k7s4ehf","Type":"NodeParagraph","Properties":{"id":"20240902164826-k7s4ehf","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"乌头:甘，大热，有大毒。\"\"乌喙:味辛，微温，有大毒。\""}]},{"ID":"20240902164826-4xqu5sz","Type":"NodeParagraph","Properties":{"id":"20240902164826-4xqu5sz","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③《药性论》:\"味苦辛，大热，有大毒。\""}]},{"ID":"20240902164826-jbklviq","Type":"NodeParagraph","Properties":{"id":"20240902164826-jbklviq","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902164826-qsddklg","Type":"NodeParagraph","Properties":{"id":"20240902164826-qsddklg","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"入肝、脾、肺经。"}]},{"ID":"20240902164826-jj3g4fz","Type":"NodeParagraph","Properties":{"id":"20240902164826-jj3g4fz","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①《本草求真》:\"入肝，兼入脾。\""}]},{"ID":"20240902164826-sm06q7g","Type":"NodeParagraph","Properties":{"id":"20240902164826-sm06q7g","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②《本草再新》:\"入肝、脾、肺三经。\""}]},{"ID":"20240902164826-w192q49","Type":"NodeParagraph","Properties":{"id":"20240902164826-w192q49","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》:\"入手厥阴、少阳经。\""}]},{"ID":"20240902164826-zpb1qbg","Type":"NodeParagraph","Properties":{"id":"20240902164826-zpb1qbg","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902164826-32fm3xt","Type":"NodeParagraph","Properties":{"id":"20240902164826-32fm3xt","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"搜风胜湿，散寒止痛，开痰，消肿。治风寒湿痹，中风瘫痪，破伤风，头风，脘腹冷痛，痰癖，气块，冷痢，喉痹，痈疽，疔疮，瘰疬。"}]},{"ID":"20240902164826-nhzp5pa","Type":"NodeParagraph","Properties":{"id":"20240902164826-nhzp5pa","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主中风，恶风，洗洗出汗，除寒湿痹，咳逆上气，破积聚寒热。\""}]},{"ID":"20240902164826-lmg4tzt","Type":"NodeParagraph","Properties":{"id":"20240902164826-lmg4tzt","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"消胸上痰，冷食不下，心腹冷疾，脐间痛，肩胛痛不可俛仰，目中痛不可久视，又堕胎。\"\"主风湿，丈夫肾湿阴囊痒，寒热历节掣引腰痛，不能行步，痈肿脓结。\""}]},{"ID":"20240902164826-0ay5a3b","Type":"NodeParagraph","Properties":{"id":"20240902164826-0ay5a3b","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③《药性论》:\"能治恶风，憎寒，冷痰包心，肠腹疞痛，痃癖气块，益阳事，治齿痛，主强志。\"\"治男子肾衰弱，阴汗，主疗风温湿邪痛。\""}]},{"ID":"20240902164826-ziviujo","Type":"NodeParagraph","Properties":{"id":"20240902164826-ziviujo","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"④《药类法象》:\"治风痹血痹，半身不遂，行经药也。\""}]},{"ID":"20240902164826-wlo0met","Type":"NodeParagraph","Properties":{"id":"20240902164826-wlo0met","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》:\"治头风喉痹，痈肿疔毒。\"\"主大风顽痹。\""}]},{"ID":"20240902164826-4s0k1rd","Type":"NodeParagraph","Properties":{"id":"20240902164826-4s0k1rd","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑥《东医宝鉴》:\"治风湿麻痹疼痛，发破伤风汗。\""}]},{"ID":"20240902164826-e17xlxn","Type":"NodeParagraph","Properties":{"id":"20240902164826-e17xlxn","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑦《纲目拾遗》:\"追风活血，取根入药酒。\""}]},{"ID":"20240902164826-z1ci8ps","Type":"NodeParagraph","Properties":{"id":"20240902164826-z1ci8ps","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑧《贵州民间方药集》:\"治麻痹症。又为伤科要药。\""}]},{"ID":"20240902164826-ud732ee","Type":"NodeParagraph","Properties":{"id":"20240902164826-ud732ee","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服:煎汤，0.5～2钱；或入丸、散。外用:生用，研末调敷或醋、酒磨涂。"}]},{"ID":"20240902164826-be2eblo","Type":"NodeParagraph","Properties":{"id":"20240902164826-be2eblo","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902164826-3t9fmkf","Type":"NodeParagraph","Properties":{"id":"20240902164826-3t9fmkf","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"凡虚人、孕妇、阴虚火旺及热证疼痛者忌服。生者慎服。"}]},{"ID":"20240902164826-3zlnzkj","Type":"NodeParagraph","Properties":{"id":"20240902164826-3zlnzkj","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》:\"莽草为之使。反栝楼、贝母、白敛、白及（一本有半夏）。恶藜芦。\""}]},{"ID":"20240902164826-okss1of","Type":"NodeParagraph","Properties":{"id":"20240902164826-okss1of","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②《药性论》。\"远志为之使。忌豉汁。\""}]},{"ID":"20240902164826-vmkssq5","Type":"NodeParagraph","Properties":{"id":"20240902164826-vmkssq5","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③《纲目》:\"畏饴糖、黑豆。冷水能解其毒。\""}]},{"ID":"20240902164826-pi2x9qo","Type":"NodeParagraph","Properties":{"id":"20240902164826-pi2x9qo","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》:\"平素禀赋衰薄，或向有阴虚内热吐血之疾，并老人、虚人、新产人，切宜禁用。\""}]},{"ID":"20240902164826-5civrmv","Type":"NodeParagraph","Properties":{"id":"20240902164826-5civrmv","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902164826-wj8xa3y","Type":"NodeParagraph","Properties":{"id":"20240902164826-wj8xa3y","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①治一切瘫痪风:草乌头（生，不去皮）、五灵脂各等分。为末，滴水为丸，如弹子大。四十岁以下一丸，分六服，病甚一丸分二服，薄荷酒磨下，觉微麻为度。（《本事方》黑神丸）"}]},{"ID":"20240902164826-8wdb8hl","Type":"NodeParagraph","Properties":{"id":"20240902164826-8wdb8hl","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②治破伤风:草乌头（生用，去皮尖）、白芷（生用），二味等分为末。每服半钱，冷酒一盏，入葱白少许，同煎服之，如人行十里，以葱白热粥投之。（《儒门事亲》）"}]},{"ID":"20240902164826-g0i2nvo","Type":"NodeParagraph","Properties":{"id":"20240902164826-g0i2nvo","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③治久患头风:草乌头尖（生用）一分，赤小豆三十五粒，麝香一字，为末。每服半钱，薄荷汤冷服。更随左右搐鼻。（《指南方》）"}]},{"ID":"20240902164826-9qr5uj1","Type":"NodeParagraph","Properties":{"id":"20240902164826-9qr5uj1","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"④治偏正头痛:草乌头四两，川芎藭四两，苍术半斤，生姜四两，连须生葱一把。捣烂，同入瓷瓶，封固，埋土中，春五夏三、秋五冬七日，取出晒干，拣去葱、姜，为末，醋、面糊和丸梧子大。每服九丸。临卧温酒下。（《戴古渝经验方》）"}]},{"ID":"20240902164826-v67q2ba","Type":"NodeParagraph","Properties":{"id":"20240902164826-v67q2ba","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑤治阳虚上攻，头项俱痛，不可忍者:细辛、新茶芽（炒）。草乌头（大者，去皮尖，炮裂切如麻豆大，碎盐炒）各等分。上为粗末。每服二钱，入麝香末半钱，水一盏半，煎至八分，去滓，温服。（《本事方》乌香散）"}]},{"ID":"20240902164826-s94pds3","Type":"NodeParagraph","Properties":{"id":"20240902164826-s94pds3","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑥治脾胃虚弱及久积冷气，饮食减少:草乌头（净洗）一斤，苍术二斤，陈橘皮（去白）半斤，甘草（生，椎碎）四两，黑豆三升。上五味，用水一石，煮干为度，去却橘皮、黑豆、甘草，只取草乌头、苍术二味，曝干，粗捣筛焙干，捣罗为末，酒煮面糊为丸，如梧桐子大，焙干，收瓷器中。每日空心、晚食前，盐汤咸温酒下三十丸。（《圣济总录》）"}]},{"ID":"20240902164826-3yx2l1n","Type":"NodeParagraph","Properties":{"id":"20240902164826-3yx2l1n","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑦治清浊不分，泄泻注下，或赤或白，脐腹疞痛，里急后重:草乌头三枚（去皮尖，一生、一炮，一烧作灰）。为细末，醋糊丸。如萝卜子大。大人五，七丸。小儿三丸；水泻倒流水下，赤痢甘草汤、白痢干姜汤下。（《局方》三神丸）"}]},{"ID":"20240902164826-jen3fy4","Type":"NodeParagraph","Properties":{"id":"20240902164826-jen3fy4","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑧治一切痈肿毒:草乌、贝母、天花粉、南星、芙蓉叶等分。为末，用醋调搽四围，中留头出毒，如干用醋润之。（《景岳全书》草乌揭毒散）"}]},{"ID":"20240902164826-yu9hvxk","Type":"NodeParagraph","Properties":{"id":"20240902164826-yu9hvxk","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑨治肿毒痈疽，未溃令内消，已溃令速愈:草乌头末，水调，鸡羽扫肿上，有疮者先以膏药贴定，无令药着入。初涂病人觉冷如水，府乃不痛。（《圣济总录》草乌头散）"}]},{"ID":"20240902164826-aupvaw7","Type":"NodeParagraph","Properties":{"id":"20240902164826-aupvaw7","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑩治发背、蜂窝、疔疮、便毒:草乌头一个，川乌头一个，瓦一块，新汲水一桶。将二乌并瓦浸于水桶内，候瓦湿透，即将川乌、草乌于瓦上磨成膏，用磨药手挑药贴于疮口四周；如未有疮口，一漫涂药如三、四重纸厚，上用纸条透孔贴盖，如药干，用鸡翎蘸水扫湿，如此不过三度。（《瑞竹堂经验方》二乌散）"}]},{"ID":"20240902164826-gddys8e","Type":"NodeParagraph","Properties":{"id":"20240902164826-gddys8e","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑾治一切诸疮未破者:草乌头为末，入轻粉少许，腊猪油和搽。（《普济方》）"}]},{"ID":"20240902164826-m14nwaa","Type":"NodeParagraph","Properties":{"id":"20240902164826-m14nwaa","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑿治淋巴结炎、淋巴结结核:草乌头一个，用烧酒适量磨汁，外搽局部，每日一次。（《单方验方调查资料选编》）"}]},{"ID":"20240902164826-tlfb1g8","Type":"NodeParagraph","Properties":{"id":"20240902164826-tlfb1g8","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒀治瘰疬初作未破，作寒热:草乌头半两，木鳖子二个。以米醋磨细，入捣烂葱头、蚯蚓粪少许。调匀敷上，以纸条贴令通气孔。（《医林正宗》）"}]},{"ID":"20240902164826-eqmjcwq","Type":"NodeParagraph","Properties":{"id":"20240902164826-eqmjcwq","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒁治一切风齿疼痛，饮食艰难:草乌头三枚（炮），胆矾（研）、细辛（去苗叶）各一钱。捣研为细散。每用一字，以指头揩擦，有涎吐之。（《圣济总录》草乌头散）"}]},{"ID":"20240902164826-xhz7ci3","Type":"NodeParagraph","Properties":{"id":"20240902164826-xhz7ci3","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒂治脑泄臭秽:草乌（去皮）半两，苍术一两，川芎二两。并生研末，面糊丸，绿豆大，每服十丸，茶下。忌一切热物。（《圣济总录》）"}]},{"ID":"20240902164826-kcfs6wf","Type":"NodeParagraph","Properties":{"id":"20240902164826-kcfs6wf","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒃治喉痹、口噤不开:草乌头、皂荚等分。为末，入麝香少许，擦牙，并搐鼻内，牙关自开也。（《纲目》）"}]},{"ID":"20240902164826-1qlqy4i","Type":"NodeParagraph","Properties":{"id":"20240902164826-1qlqy4i","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902164826-1zus0qb","Type":"NodeParagraph","Properties":{"id":"20240902164826-1zus0qb","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①《药性论》:\"乌喙，其气锋锐，通经络，利关节，寻蹊达径而直抵病所。\""}]},{"ID":"20240902164826-2quhb9v","Type":"NodeParagraph","Properties":{"id":"20240902164826-2quhb9v","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②杨清叟:\"凡风寒湿痹，骨内冷痛，及损伤入骨，年久发痛，或一切阴疽肿毒，并宜草乌头、南星等分，少加肉桂为末，姜汁热酒调涂，未破者能内消，久溃者能去黑烂。二药性味辛烈，能破恶块，逐寒热，遇冷即消，遇热即溃。\""}]},{"ID":"20240902164826-4lm6ks9","Type":"NodeParagraph","Properties":{"id":"20240902164826-4lm6ks9","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③《纲目》:\"草乌头、射罔。乃至毒之药，非若川乌头、附子人所栽种，加以酿制、杀其毒性之比，自非风顽急疾，不可轻投。甄权《药性论》言其益阳事，治男子肾气衰弱者，未可遽然也。此类止能搜风胜湿，开顽痰，治顽疮，以毒攻毒而已，岂有川乌头、附子补右肾命门之功哉?\""}]},{"ID":"20240902164826-o8db5ft","Type":"NodeParagraph","Properties":{"id":"20240902164826-o8db5ft","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"④《本草述》:\"草乌头类，洵为至毒之药，第先圣用毒药以去病，益期于得当也。如草乌辈之用，固沉寒痼冷，足以相当，或寒湿合并，结聚癖块，阻塞真阳，一线未绝，非是不足以相当而战必克。如瘫痪证，先哲多用之，盖为其寒湿之所结聚，顽痰死血，非是不可以开道路，令流气破积之药得以奏绩耳。\""}]},{"ID":"20240902164826-fdawaa2","Type":"NodeParagraph","Properties":{"id":"20240902164826-fdawaa2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑤《本草求真》:\"草乌头，《本经》治恶风洗洗汗出，但能去风而不能回阳散寒可知。乌附五种，主治攸分:附子大壮元阳，虽偏下焦，而周身内外无所不至；天雄峻温不减于附，而无顷刻回阳之功；川乌专搜风湿痛痹，却少温经之力；侧子善行四末，不入脏腑；草乌悍烈，仅堪外治。此乌、附之同类异性者。至于乌喙，禀气不纯，服食远之可也。\""}]},{"ID":"20240902164826-ahuooed","Type":"NodeParagraph","Properties":{"id":"20240902164826-ahuooed","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑥张寿颐:\"草乌头（本经）谓主中风恶风洗洗，盖仍以外感寒风而盲，洗洗读作洒洒，仍是洒浙恶风之候，而后世乃谓可治恶风，以恶字作如字读，岂古人之真旨?要知毒风厉风等症，皆是血热成毒，似此太热大毒之物，胡可妄投，此盖误读古书之谬。惟果是寒湿寒痰。涸阴沍寒，坚凝结聚之症，始可用为佐使，引到病所，以开坚积耳。\""}]},{"ID":"20240902164826-r9hj4nb","Type":"NodeParagraph","Properties":{"id":"20240902164826-r9hj4nb","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902164826-fe9cfrw","Type":"NodeParagraph","Properties":{"id":"20240902164826-fe9cfrw","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①治疗风湿性关节炎等"}]},{"ID":"20240902164826-3ncexcl","Type":"NodeParagraph","Properties":{"id":"20240902164826-3ncexcl","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"将草乌制成注射液，肌肉注射，成人每次2毫升（含总生物碱2毫克），每日1次；或穴位注射，每穴0.5毫升，每次2～3穴（每日1次）或1～2穴（每日2次），10天为一疗程，停药2～3日后可继续用药。孕妇忌用，心脏病慎用。治疗风湿性关节炎、腰腿窟、神经痛等共64例，总有效率为95.8％以上，大多治疗6～10日疼痛即见减轻，对重症风湿性关节炎止痛效果尤为明显。此外又用于感冒发热10例，除2例无效外，均于用药1～3次后收到退热效果。"}]},{"ID":"20240902164826-rpz4vo3","Type":"NodeParagraph","Properties":{"id":"20240902164826-rpz4vo3","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②用作麻醉、止痛剂生草乌外用可麻醉末梢神经，作为局部麻醉、镇痛之用；与洋金花合用作为全身麻醉剂，似有相互抵销副作用及增强麻醉效果的作用。"}]},{"ID":"20240902164826-f3rkqum","Type":"NodeParagraph","Properties":{"id":"20240902164826-f3rkqum","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【中毒】草乌亦含乌头碱，用之不当，极易引起中毒。其表现与川乌基本相同，如舌、四肢或全身发麻，恶心、呕吐，烦躁不安，甚或昏迷，皮肤苍白，心慌气短，心率缓慢，心律紊乱，少数呈心率增速，血压下降，瞳孔散大，心电图呈室上性与室性期外收缩、心动过速、房室性传导阻滞、束枝传导阻滞、低电压、S-T改变等。多数患者经及时抢救可获恢复，但亦有少数由于中毒过重或抢救不及时，终因心脏麻痹而死亡。临床应用务宜谨慎。"}]},{"ID":"20240902164826-tvqjom2","Type":"NodeParagraph","Properties":{"id":"20240902164826-tvqjom2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【备注】"}]},{"ID":"20240902164826-r5o8a0a","Type":"NodeParagraph","Properties":{"id":"20240902164826-r5o8a0a","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"此外，尚有下列几种乌头属植物，亦作草乌使用。"}]},{"ID":"20240902164826-6v12g8z","Type":"NodeParagraph","Properties":{"id":"20240902164826-6v12g8z","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"①乌头的黄山变种（黄山乌头）（分布安徽、浙江）、展毛变种（分布江苏、浙江）和密毛变种（大乌头）（分布甘肃、陕西）。"}]},{"ID":"20240902164826-5mgc9an","Type":"NodeParagraph","Properties":{"id":"20240902164826-5mgc9an","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"②昆明乌头（黄草乌），详\"昆明堵喇\"条。"}]},{"ID":"20240902164826-czsv25o","Type":"NodeParagraph","Properties":{"id":"20240902164826-czsv25o","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"③圆锥序乌头（分布辽宁、吉林）。"}]},{"ID":"20240902164826-a8lcg95","Type":"NodeParagraph","Properties":{"id":"20240902164826-a8lcg95","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"④蒿叶乌头（分布辽宁、吉林）。"}]},{"ID":"20240902164826-a43vfii","Type":"NodeParagraph","Properties":{"id":"20240902164826-a43vfii","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑤太白乌头，详\"金牛七\"条。"}]},{"ID":"20240902164826-v5wt22l","Type":"NodeParagraph","Properties":{"id":"20240902164826-v5wt22l","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑥显柱乌头（分布云南）。"}]},{"ID":"20240902164826-ua91adj","Type":"NodeParagraph","Properties":{"id":"20240902164826-ua91adj","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑦多根乌头（分布新疆）。"}]},{"ID":"20240902164826-j0ke1ea","Type":"NodeParagraph","Properties":{"id":"20240902164826-j0ke1ea","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑧准噶尔乌头（分布新疆）。"}]},{"ID":"20240902164826-qln4to3","Type":"NodeParagraph","Properties":{"id":"20240902164826-qln4to3","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑨瓜叶乌头，详\"藤乌头\"条。"}]},{"ID":"20240902164826-q4hrtdn","Type":"NodeParagraph","Properties":{"id":"20240902164826-q4hrtdn","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑩紫草乌（分布云南）。"}]},{"ID":"20240902164826-ttraltj","Type":"NodeParagraph","Properties":{"id":"20240902164826-ttraltj","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑾松潘乌头，详\"火焰子\"条。"}]},{"ID":"20240902164826-b6e8gik","Type":"NodeParagraph","Properties":{"id":"20240902164826-b6e8gik","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⑿亚东乌头（分布西藏）。"}]},{"ID":"20240902164826-cb0ltmb","Type":"NodeParagraph","Properties":{"id":"20240902164826-cb0ltmb","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒀细叶草乌（分布西藏）。"}]},{"ID":"20240902164826-7xcmca4","Type":"NodeParagraph","Properties":{"id":"20240902164826-7xcmca4","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"⒁直缘乌头（大草乌、小黑牛）（分布云南）。"}]},{"ID":"20240902164826-vhjxsdr","Type":"NodeParagraph","Properties":{"id":"20240902164826-vhjxsdr","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902164826-zswx0ta","Type":"NodeParagraph","Properties":{"id":"20240902164826-zswx0ta","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"草乌头《中华本草》《中药大辞典》"}]},{"ID":"20240902164826-60g8wcf","Type":"NodeParagraph","Properties":{"id":"20240902164826-60g8wcf","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902164826-ffzwo38","Type":"NodeParagraph","Properties":{"id":"20240902164826-ffzwo38","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"出自《药谱》。"}]},{"ID":"20240902164826-naxl23c","Type":"NodeParagraph","Properties":{"id":"20240902164826-naxl23c","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.《吴普本草》：乌头，正月始生，叶厚，茎方中空，叶四四相当，与蒿相似。乌喙，十月采，形如乌头，有两枝相合，如乌之喙也；所畏、恶、使与乌头同。"}]},{"ID":"20240902164826-90nszbe","Type":"NodeParagraph","Properties":{"id":"20240902164826-90nszbe","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》：乌头少有茎苗，长身乌黑，少有傍尖。乌喙皮上苍，有大豆许者孕八、九个，周围底陷，黑如乌铁。"}]},{"ID":"20240902164826-4pyz0fr","Type":"NodeParagraph","Properties":{"id":"20240902164826-4pyz0fr","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：今采用四月乌头，与附子同根，春时茎初生有脑，形如乌乌之头，故谓之乌头。有两歧共蒂，状如牛角，名乌喙"}]},{"ID":"20240902164826-hxaki4z","Type":"NodeParagraph","Properties":{"id":"20240902164826-hxaki4z","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【拼音名】CǎoWūTóu"}]},{"ID":"20240902164826-eqifl4n","Type":"NodeParagraph","Properties":{"id":"20240902164826-eqifl4n","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【英文名】KusnezoffMonkshoodRoot,CommonMonkshood"}]},{"ID":"20240902164826-25w5saw","Type":"NodeParagraph","Properties":{"id":"20240902164826-25w5saw","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【别名】堇、芨、乌头、乌喙、奚毒、即子、鸡毒、毒公、耿子、土附子、草乌、竹节乌头、金鸦、五毒根、耗子头"}]},{"ID":"20240902164826-5xivlz0","Type":"NodeParagraph","Properties":{"id":"20240902164826-5xivlz0","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902164826-g53mp3p","Type":"NodeParagraph","Properties":{"id":"20240902164826-g53mp3p","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"药材基源：为毛茛科植物乌头（野生种）、北乌头等的块根。"}]},{"ID":"20240902164826-x0tzy1i","Type":"NodeParagraph","Properties":{"id":"20240902164826-x0tzy1i","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.AconitumcarmichaeliDebx.2.AconitumkusnezoffiiReichb."}]},{"ID":"20240902164826-zpoxcu2","Type":"NodeParagraph","Properties":{"id":"20240902164826-zpoxcu2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"采收和储藏：当年晚秋或次年早春采收，将地下部分挖出，剪去根头部洗净，晒干。"}]},{"ID":"20240902164826-z0k2ilz","Type":"NodeParagraph","Properties":{"id":"20240902164826-z0k2ilz","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902164826-9g9gxrh","Type":"NodeParagraph","Properties":{"id":"20240902164826-9g9gxrh","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.乌头，多年生草本，高60-120cm。块根通常2个连生，纺锤形至倒卵形，外皮黑褐色；栽培品的侧根（子根）甚肥大，直径达5cm。茎直立或稍倾斜，下部光滑无毛，上部散生贴伏柔毛。叶互生，革质，有柄；叶片卵圆形，宽5-12cm，3裂几达基部，两侧裂片再2裂，中央裂片菱状楔形，先端再3浅裂，裂片边缘有粗齿或缺刻。总状圆锥花序，花序轴有贴伏的柔毛；萼片5，蓝紫色，外被微柔毛，上萼片盔形，长15-18mm，宽约20mm，侧萼片近圆形；花瓣2，无毛；雄蕊多数，花丝下半部扩张成宽线形的翅；心皮3-5个，离生，密被灰黄色的短绒毛。蓇葖果长圆形，具横脉，花柱宿存，芒尖状。花期6-7月。果期7-8月。"}]},{"ID":"20240902164826-ax32pmr","Type":"NodeParagraph","Properties":{"id":"20240902164826-ax32pmr","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.北乌头，多年生草本，高70-150cm。块根常2-5块连生，倒圆锥形，长2.5-5cm，外皮黑褐色。茎直立，光滑。叶互生，有柄；叶片近于革质，全形为卵圆形，长6-14cm，宽8-9cm，3全裂，裂片菱形，再作深浅不等的羽状缺刻状分裂，最终裂片线状披针形或披针形，先端尖，二面均光滑，或有时微被毛。总状花序，或有时为紧缩的圆锥花序；花萼5，紫蓝色，上萼片盔形，长1.5-2cm，、侧萼片长1.4-1.7cm；花瓣2，无毛，有长爪，距长1-4mm；雄蕊多数，无毛；子房5个，稀有3-4个，无毛，花柱与子房等长。蓇葖果长1-2cm。种子有膜质翅。花期7-8月。果期8-9月。"}]},{"ID":"20240902164826-4edrl4b","Type":"NodeParagraph","Properties":{"id":"20240902164826-4edrl4b","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902164826-93m7pyy","Type":"NodeParagraph","Properties":{"id":"20240902164826-93m7pyy","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于山地草坡和灌木丛中。"}]},{"ID":"20240902164826-ve5b5hd","Type":"NodeParagraph","Properties":{"id":"20240902164826-ve5b5hd","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.生于山地、丘陵、草坡或疏林、草甸上。"}]},{"ID":"20240902164826-dyy2usk","Type":"NodeParagraph","Properties":{"id":"20240902164826-dyy2usk","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于辽宁南部、陕西、甘肃、山东、江苏、安徽、浙江、江西、河南、湖北、湖南、广东北部、广西、四川、贵州、云南。主要栽培于四川。陕西、湖北、湖南、云南等地也有栽培。"}]},{"ID":"20240902164826-v8pwhyt","Type":"NodeParagraph","Properties":{"id":"20240902164826-v8pwhyt","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北。"}]},{"ID":"20240902164826-9a1pvdz","Type":"NodeParagraph","Properties":{"id":"20240902164826-9a1pvdz","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902164826-ksnhu89","Type":"NodeParagraph","Properties":{"id":"20240902164826-ksnhu89","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.北乌头生物学特性喜凉爽湿润环境，耐寒，冬季地下根部可耐-30℃左右的严寒。天气干旱或土壤缺水时，植株生长迟缓，叶缘干枯，叶片脱落，但雨季要注意防涝，防止在高温、高湿季节根部腐烂。土壤以肥沃疏松的砂质壤土为最好，粘土或低洼易积水地区则不宜栽培。"}]},{"ID":"20240902164826-rx43965","Type":"NodeParagraph","Properties":{"id":"20240902164826-rx43965","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.栽培技术分根或种子繁殖，以分根繁殖为主。分根繁殖：每年秋季或早春，挖取老根旁所生的子根栽种。开浅沟，行株距（30-45）cm×（9-15）cm，将子根均匀排在沟内，栽后覆土压实。春种约20d左右出苗，晚秋栽种者，待到第2年春萌芽。种子繁殖：须选用当年或上一年的种子，秋播或春播，条播行距30-45cm开沟播种，或穴播。温度在18-23℃，有足够温度，播种后约15d出苗。苗高9-15cm时，间苗1次。"}]},{"ID":"20240902164826-omi3228","Type":"NodeParagraph","Properties":{"id":"20240902164826-omi3228","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"3.田间管理生长前期，应及时浇水和锄草，7、8月雨季要排水。为了增加根的产量，6-8月间可分别追肥1次，以氮、磷肥为主。"}]},{"ID":"20240902164826-bz9g93a","Type":"NodeParagraph","Properties":{"id":"20240902164826-bz9g93a","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"4.虫害防治红蜘蛛，主要在春、秋干旱时发生。"}]},{"ID":"20240902164826-he4b3h1","Type":"NodeParagraph","Properties":{"id":"20240902164826-he4b3h1","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902164826-g3liz0m","Type":"NodeParagraph","Properties":{"id":"20240902164826-g3liz0m","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别（1）乌头母根纺锤形至倒卵形，长2-5cm，直径1-2.5cm。表面灰褐色，有纵皱纹及突起的点状须根痕，顶端有残留茎基。子根较光滑，稍有细纵纹，具数个瘤状突起的侧根，顶端无残茎而具芽痕。质坚硬，不易折断，断面灰白色，有不规则的环纹。气微，味辛辣、麻舌。"}]},{"ID":"20240902164826-fg44xoq","Type":"NodeParagraph","Properties":{"id":"20240902164826-fg44xoq","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"（2）北乌头母根不规则长圆锥形，略弯曲，长2-7cm，直径0.6-1.8cm。顶端常有残茎和少数不定根残基；有的顶端有一枯萎的芽，一侧有一圆形或扁圆形不定根残基。表面灰褐色或黑棕褐色，有纵皱缩纹、点状须根痕和数个瘤突状侧根。子根与母根形相似，表面较光滑。质硬，难折断，断面灰白色或暗灰色，有裂隙，形成层环纹多角形或类圆形，髓部较大或中空。气无，味辛辣、麻舌。"}]},{"ID":"20240902164826-gtg2g4x","Type":"NodeParagraph","Properties":{"id":"20240902164826-gtg2g4x","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"以个大、质坚实、断面灰白色者为佳。"}]},{"ID":"20240902164826-p1llani","Type":"NodeParagraph","Properties":{"id":"20240902164826-p1llani","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别块根横切面：（1）乌头后生皮层为1-2列金黄色细胞；皮层细胞7-8列，呈长条形，切向延长，其间有少数石细胞散列；内皮层细胞较小。形成层环状，母根上段类圆形，中段类四角形，下段类圆形；子根上段、中段均为多角形，下段不规则形。韧皮部可见异型维管束。木质部导管1-2列，径向排列。中央为髓部。"}]},{"ID":"20240902164826-pbrw5j2","Type":"NodeParagraph","Properties":{"id":"20240902164826-pbrw5j2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"（2）北乌头后生皮层为7-8列棕黄色木栓化细胞；皮层为6-8列细胞；皮层内侧有单个散在或2-5个成群的石细胞；内皮层明显。韧皮部宽广，常有不规则裂隙，筛管群随年可见；母根近形成层处的筛管群外围有韧皮纤维群，并有少数石细胞，近内皮层处变有少数石细胞，形状与皮层石细胞同；子根则无纤维及石细胞。形成层环呈不规则多角形或类圆形，上、中、下三段相似。木质部导管1-4列或数个相聚，位于形成层角隅的内侧，有的内含棕黄色物。髓部较大。薄壁细胞充满淀粉粒。"}]},{"ID":"20240902164826-4of86ub","Type":"NodeParagraph","Properties":{"id":"20240902164826-4of86ub","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"3.粉末特征：（1）乌头①石细胞近无色或淡黄绿色，类长方形、类方形、多角形或一边斜尖，直径49-117μm，长113-280μm，壁厚4-13μm，壁厚者层纹明显，纹孔较稀疏。②淀粉粒单粒球形、长圆形或肾形，直径3-22μm；复粒由2-15分粒组成。③导管淡黄色，主为具缘纹孔导管，直径29-70μm，末端平截或短尖，穿孔位于端壁或侧壁，有的导管分子纵横连接或粗短扭曲。此外，有后生皮层细胞、纤维等。"}]},{"ID":"20240902164826-8sgnbe6","Type":"NodeParagraph","Properties":{"id":"20240902164826-8sgnbe6","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"（2）北乌头①石细胞无色，与后生皮层相连结的显棕色，类方形、类长方形、类圆形、梭形或长条形，直径20-234μm，长至465μm，壁厚薄不一，厚者层纹明显，纹孔细，有的含棕色物。②淀粉粒单粒类圆形，直径2-23μm；复粒由2-16分粒组成。③后生皮层细胞棕色，表面观类方形或长多角形，壁不均匀增厚，有呈瘤状突入细胞腔。"}]},{"ID":"20240902164826-q3zepbn","Type":"NodeParagraph","Properties":{"id":"20240902164826-q3zepbn","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902164826-kavkuc4","Type":"NodeParagraph","Properties":{"id":"20240902164826-kavkuc4","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.乌头块根（母根）含乌头碱（aconitine），次乌头碱（hypaconitine），中乌头碱（mesaconitine），塔拉胺（talatisamine），消旋去甲基衡州乌药碱（demethylcoclaurine），异塔拉定（isotalatizidine），新乌宁碱（neoline），准噶尔乌头碱（songorine），附子宁碱（fuziline），去甲猪毛菜碱（salsolinol），异飞燕草碱（isodelphinine），苯甲酰中乌头碱（benzoylmesaconitine），多根乌头碱（karakoline），森布星（senbusine）A，森布星（senbusine）B，14-乙酰塔拉胺（14-acetyltalatisamine），脂乌头碱（lipoaconitine），脂次乌头碱（lipohypaconitine），脂去氧乌头碱（lipodeoxyaconitine），脂中乌头碱（lipomesaconitine），北草乌碱（beiwutine），川附宁（chuanfunine），3-去氧乌头碱（3-deoxyaconitine），惰碱（ignavine），荷克布星（hokbusine）A及B，尿嘧啶（uracil），乌头多糖（aconitan）A、B、C、D。"}]},{"ID":"20240902164826-bwdwzg1","Type":"NodeParagraph","Properties":{"id":"20240902164826-bwdwzg1","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.北乌头根含中乌头碱（mesaconitine），次乌头碱（hypaconitine），乌头碱（aconitine），3-去氧乌头碱（3-deoxyaconitine），北草乌碱（beiwutine），和乌胺（higenamine），地上部分含雷波乌头碱（beiwutine），和乌胺（higenamine），地上部分含雷波乌头碱（lepenine），无毛翠雀亭（denudatine）。"}]},{"ID":"20240902164826-iq1x2ov","Type":"NodeParagraph","Properties":{"id":"20240902164826-iq1x2ov","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"3.多根乌头块根含乌头碱，3-去氧乌头碱，新乌宁碱（neoline），准噶尔乌头碱（polyschistine）A、AK-4、AK-22、AK-22a，多根乌头奥宁碱（karaonine），多根乌头柯明碱（karakomine），苯甲酰乌头原碱（benzoylaconine），乌头芬碱（aconifine），欧乌头碱（napelline），异波尔定碱（isoboldine），多根乌头碱（karakoline,karacoline），10-羟在多根乌头碱（karakolidine），乙酰基欧乌头碱（acetylnapelline），苯基-β-萘胺（phenyl-β-naphthylamine）。"}]},{"ID":"20240902164826-tfabeek","Type":"NodeParagraph","Properties":{"id":"20240902164826-tfabeek","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"4.直缘乌头根含滇乌碱（yunaconitine）粗茎乌头碱甲（crassicaulineA），展花乌头宁碱（chasmaconine）."}]},{"ID":"20240902164826-qbftwpz","Type":"NodeParagraph","Properties":{"id":"20240902164826-qbftwpz","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902164826-f3vor8x","Type":"NodeParagraph","Properties":{"id":"20240902164826-f3vor8x","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.镇痛作用：用电刺激鼠尾法实验，小鼠腹腔注射草乌70%乙醇浸剂，有明显的镇痛作用，其0.19、0.095、0.048g/kg的镇痛效力均分别超过吗啡12、6、3mg/kg的镇痛效力。但上述剂量有毒性反应，且草乌的治疗指数（3.91）远比吗啡（48.58）为小。小鼠热板法实验表明，北草乌碱、次乌头碱亦有镇痛作用。"}]},{"ID":"20240902164826-4gxoapi","Type":"NodeParagraph","Properties":{"id":"20240902164826-4gxoapi","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.局部麻醉作用：北草乌碱在动物身上有局部麻醉作用。"}]},{"ID":"20240902164826-lede71e","Type":"NodeParagraph","Properties":{"id":"20240902164826-lede71e","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"3.5种草乌生物碱诱发心律失常作用的比较：大鼠体重201±25g，共48只，雌雄兼用，每个剂量组为8只，腹腔注射戊巴比妥钠40-45mg/kg麻醉后，记录呼吸频率心电图Ⅱ导程。从股静脉内给药，每药各用小鼠半数致死量的1/14。至发生心律失常前这一段时间称为潜伏时间，诱发心律失常起至恢复窦性心律止，称为维持时间。AC组（乌头碱组），静脉注射l9mg/kg，诱发大鼠心律失常呈室性早搏，室上性或室性心动过速。呼吸频率受到明显的抑制，呈不规则腹式呼吸，待心律转为窦性时，而呼吸仍未完全恢复。MA组（中乌头碱组），静脉注射l6mg/kg，发生心律失常的类型与AC组相似。诱发心律失常的潜伏时间显着缩短，维持时间较AC组显着延长。对呼吸呈现严重抑制状态。剂量减为10和5mg/kg，则诱发心律失常潜伏时间分别为0.6±0.1和2.1±1.1分钟，维持时间分别为33±9和11±2分钟。BA组（北草乌头碱组），静脉注射剂量为30mg/kg，诱发心律失常的潜伏时间较AC组显着缩短，维持时间较AC组和MA组明显延长，出现心律失常的类型与AC组相似。HA（次乌头碱）和DA（去氧乌头碱）组，HA组诱发心律失常虽较AC组为快，但维持时间显着较AC减少。DA组，8只鼠中有7只观察15分钟不出现心律失常，只有1只出现。综合实验结果，小鼠的急性毒性MA＞AC＞BA＞HA＞DA，而诱发大鼠心律失常作用强度（维持时间），其顺序为BA＞MA＞AC＞HA＞DA。其中以BA诱发心律失常作用最强，而对呼吸抑制较弱。北草乌头碱还能诱发小鼠心律失常，作用亦较AC为强，P\u003c0.01。又可诱发清醒免的心律失常，静脉注射BA10mg/kg。结果使6兔均诱发心律失常，潜伏时间为1.3±0.4分钟，维持时间为16±5分钟。流涎和呼吸暂时性抑制，5-10分钟消失。BA还能使大鼠血压过性下降，但很快就回升。"}]},{"ID":"20240902164826-d22zqyl","Type":"NodeParagraph","Properties":{"id":"20240902164826-d22zqyl","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"4.草乌总生物碱和乌头碱对几种药物引起心电图变化的影响：总碱和乌头碱有增强肾上腺素对兔心肌的作用，一种是由原来只产生窦性心律减慢增强为产生室性自动性异位节律的程度，总碱组在6只动物中出现3只，乌头碱组的6只动物中出现4只。两组其它4只动物，合并用药后，则产生室性自博心律或结性心律，它们同属被动性异位心律，是对肾上腺素增强作用的另一种表现。"}]},{"ID":"20240902164826-cyrluen","Type":"NodeParagraph","Properties":{"id":"20240902164826-cyrluen","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"总碱和乌头碱均可对抗氯化钙引起的T波倒置，给总碱后氯化钙的用量增加3.5倍，给乌头碱后氯化钙的用量增加到4.3倍，P\u003c0.05。总碱和乌头碱能增强毒毛旋花子甙6对豚鼠心脏的毒性。经显着性测验，总碱用药组与对照组之间最小致死量的差别是显着的。乌头碱和总碱在同一剂量下都有程度不同的增强毒甙6对心脏的毒性作用。总碱和乌头碱还能对抗垂体后叶制剂对兔引起的ST段位移，经显着性测验，除总碱组在给药后10s的以外都有显着性差别（P\u003c0.05）。总碱还有抗组胺作用。"}]},{"ID":"20240902164826-zsv9p5v","Type":"NodeParagraph","Properties":{"id":"20240902164826-zsv9p5v","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"炮制品的药理作用药典规定草乌的炮制方法用清水制，实验比较了用高压蒸制法代替清水制法。经半数致死量测定和高体蛙心试验证明，二种炮制方法和生草乌比均能降低毒性。从镇痛试验和维生素C含量测定表明，二种炮制方法和生草乌比较均能保持疗效。二种不同炮制方法不论在毒性或疗效方面差别不大，且用薄层层析比较，二者化学成分是相同的。但高压法较药典法优点有总生物碱含量高，原药材损失少，方法简便，周期缩短。"}]},{"ID":"20240902164826-smrx1m2","Type":"NodeParagraph","Properties":{"id":"20240902164826-smrx1m2","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【毒性】草乌70%酒精浸剂小鼠腹腔注射的半数致死量为0.38g/kg。草乌经6小时水煎后，小鼠腹腔注射的半数致死量为41.59±2.118g/kg。中乌头碱小鼠腹腔注射的半数致死量。为0.22mg/kg，乌头碱小鼠腹腔注射半数致死量。为0.27mg/kg，北草乌头碱小鼠腹腔注射的半数致死量。为0.42mg/kg，次乌头碱小鼠腹腔注射的半数致死量为1.01mg/kg，脱氧乌头碱小鼠半数致死量为1.90mg/kg。"}]},{"ID":"20240902164826-xkfn2j0","Type":"NodeParagraph","Properties":{"id":"20240902164826-xkfn2j0","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902164826-95a3zo4","Type":"NodeParagraph","Properties":{"id":"20240902164826-95a3zo4","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末0.5g，加乙醚10ml与氨试液0.5ml，振摇10min，滤过。滤液置分液漏斗中，加硫酸液（0.25mol/L）20ml，振摇提取，分取酸液适量，用水稀释后用分光亮度计测定，在231nm与275nm的波长处有最大吸收。"}]},{"ID":"20240902164826-9yor08q","Type":"NodeParagraph","Properties":{"id":"20240902164826-9yor08q","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"（2）取本品粗粉1g，加乙醚15ml与氨试液1ml，浸渍1h，时时振摇，滤过。取滤液5ml，蒸干，残渣加7%盐酸羟胺甲醇溶液5滴与0.1%麝香草酚酞甲醇溶液1滴，滴加氢氧化钾饱和的甲醇溶液至显蓝色后，再多加2滴，置60℃水浴上加热1-2min，用冷水冷却，滴加稀盐酸调节Ph至2-3，加三氯化铁试液和氯仿各1滴，振摇，下层认显紫色。"}]},{"ID":"20240902164826-xov3o2i","Type":"NodeParagraph","Properties":{"id":"20240902164826-xov3o2i","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"（3）薄层色谱取本品粉末1g，加10%氨溶液1ml后，用乙醚10ml冷浸24h，滤过。滤液挥干，残渣用二氯甲烷洗入1ml容量瓶中定容，作为样品溶液。另以乌头碱、中乌头碱、次乌头碱，用二氯甲烷配制成1mg/1ml的对照品溶液。在高效硅胶GF254板上点样品及对照品溶液各4μl，以环已烷-乙酸乙酯-二乙胺（8：1：1）展开，挥去溶剂，以碘蒸气熏后，供试品色谱中与对照品色谱相应位置处，各斑点均现紫污色。"}]},{"ID":"20240902164826-uqpzqg5","Type":"NodeParagraph","Properties":{"id":"20240902164826-uqpzqg5","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【炮制】制草乌：取净草乌，用凉水浸漂，每日换水2-3次，至口尝仅稍留麻辣感时取出，同甘草、黑豆加水共煮，以草乌熟透、内无白心为度，然后除去甘草及黑豆，晒至六成干，闷润后切片，晒干。（每草乌100斤，用甘草5斤，黑豆10斤）"}]},{"ID":"20240902164826-io3g3e7","Type":"NodeParagraph","Properties":{"id":"20240902164826-io3g3e7","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【性味】辛；苦；热；大毒"}]},{"ID":"20240902164826-juvhdqs","Type":"NodeParagraph","Properties":{"id":"20240902164826-juvhdqs","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【归经】心；肝；脾经"}]},{"ID":"20240902164826-gevp3r8","Type":"NodeParagraph","Properties":{"id":"20240902164826-gevp3r8","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿；温经散寒；消肿止痛；。主风寒湿痹；关节疼痛；头风头痛；中风不遂；心腹冷痛；寒疝作痛；跌打损伤；瘀血肿痛；阴疽肿毒；麻醉止痛"}]},{"ID":"20240902164826-wogdi7y","Type":"NodeParagraph","Properties":{"id":"20240902164826-wogdi7y","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g；或入丸、散。外用：适量，研末调敷；或醋、酒磨涂。"}]},{"ID":"20240902164826-fh4gz8h","Type":"NodeParagraph","Properties":{"id":"20240902164826-fh4gz8h","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚火旺、各种热证患者及孕妇禁服。"}]},{"ID":"20240902164826-hdhxa9a","Type":"NodeParagraph","Properties":{"id":"20240902164826-hdhxa9a","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902164826-4v2x2kq","Type":"NodeParagraph","Properties":{"id":"20240902164826-4v2x2kq","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"1.《药性论》：乌喙，其气锋锐，通经络，利失节，寻蹊达径而直抵病所。"}]},{"ID":"20240902164826-wqwdir9","Type":"NodeParagraph","Properties":{"id":"20240902164826-wqwdir9","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：草乌头、射罔，乃至毒之药，非若川乌头、附子人所栽种，加以酿制、杀其毒性之比，自非风顽急疾，不可轻投，甄权《药性论》言其益阳事，治男子肾气衰弱者，未可遽然也。此类止能搜风胜湿，开顽痰，治顽疮，以毒攻毒而已，岂有川乌头、附子补右肾命门之功哉？3.《本草述》：草乌头类，洵为至毒之药，第先圣用毒药以去病，盖期于得当也。如草乌辈之用，固沉寒痼冷，足以相当，或寒湿合并，结聚癖块，阻塞真阳，一线未绝，非是不足以相当而战必克。如瘫痪证，先哲多用之，盖为其寒湿之所结聚，顽痰死血，非是不可以开道路，令流气破积之药得以奏绩耳。"}]},{"ID":"20240902164826-ai35goa","Type":"NodeParagraph","Properties":{"id":"20240902164826-ai35goa","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：草乌头，《本经》治恶风洗洗汗出，但能去风而不能回阳散寒可知。乌附五种，主治攸分：附子大壮元阳，虽偏下焦，而周身内外无所不至；天雄峻温不减于附，而无顷刻回阳之功；川乌专搜风湿痛痹，却少温经之力；侧子善行四末，不入脏腑；草乌悍烈，仅堪外治。此乌、附之同类异性者。至于乌喙，禀气不纯，服食远之可也。"}]},{"ID":"20240902164826-cpxfam7","Type":"NodeParagraph","Properties":{"id":"20240902164826-cpxfam7","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"5.张寿颐：草乌头《本经》谓主中风恶风洗洗，盖仍以外感寒风而言，洗洗读作洒洒，仍是洒浙恶风之候，而后世乃谓可治恶风，以恶字作如字读，岂古人之真旨？要知毒风厉风等症，皆是血热成毒，似此大热大毒之物，胡可妄投，此盖误读古书之谬。惟果是寒湿寒痰，涸阴冱寒，坚凝结聚之症，始可用为佐使，引到病所，以开坚积耳。"}]},{"ID":"20240902164826-uefpsrp","Type":"NodeParagraph","Properties":{"id":"20240902164826-uefpsrp","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主中风，恶风，洗洗出汗，除寒湿痹，咳逆上气，破积聚寒热。"}]},{"ID":"20240902164826-5pzkvjf","Type":"NodeParagraph","Properties":{"id":"20240902164826-5pzkvjf","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"7.《别录》：消胸上痰，冷食不下，心腹冷疾，脐间痛，肩胛痛不可俯仰，目中痛不可久视，又堕胎。主风湿，丈夫肾湿阴囊痒，寒热历节掣引腰痛，不能行步，痈肿脓结。"}]},{"ID":"20240902164826-ct31d19","Type":"NodeParagraph","Properties":{"id":"20240902164826-ct31d19","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：能治恶风，憎寒，冷痰包心，肠腹XIU痛，痃癖气块，益阳事，治齿痛，主强志。治男子肾衰弱，阴汗，主疗风温湿邪痛。"}]},{"ID":"20240902164826-44e5kmm","Type":"NodeParagraph","Properties":{"id":"20240902164826-44e5kmm","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"9.《药类法象》：治风痹血痹，半身不遂，行经药也。"}]},{"ID":"20240902164826-wmrg2tg","Type":"NodeParagraph","Properties":{"id":"20240902164826-wmrg2tg","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：治头风喉痹，痈肿疔毒。主大风顽痹。"}]},{"ID":"20240902164826-x0s6p6l","Type":"NodeParagraph","Properties":{"id":"20240902164826-x0s6p6l","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"11.《东医宝鉴》：治风湿麻痹疼痛，发破伤风汗。"}]},{"ID":"20240902164826-m4hxpa7","Type":"NodeParagraph","Properties":{"id":"20240902164826-m4hxpa7","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"12.《纲目拾遗》：追风活血，取根入药酒。"}]},{"ID":"20240902164826-6bi62n4","Type":"NodeParagraph","Properties":{"id":"20240902164826-6bi62n4","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"13.《贵州民间方药集》：治麻痹症。又为伤科要药。"}]},{"ID":"20240902164826-m058dhd","Type":"NodeParagraph","Properties":{"id":"20240902164826-m058dhd","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"14．杨清叟：凡风寒湿痹，骨内冷痛，及损伤入骨，年久发痛，或一切阴疽肿毒，并宜草乌头、南星等分，少加肉桂为末，姜汁热酒调涂，未破者能内消，久溃者能去黑烂。二药性味辛烈，能破恶块，逐寒热，遇冷即消，遇热即溃。"}]},{"ID":"20240902164826-jnffm6w","Type":"NodeParagraph","Properties":{"id":"20240902164826-jnffm6w","updated":"20240902164843"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》《中药大辞典》"}]},{"ID":"20240902164828-q5c3eed","Type":"NodeThematicBreak","Properties":{"id":"20240902164828-q5c3eed","updated":"20240902164843"}},{"ID":"20240902164829-yzjqjjf","Type":"NodeParagraph","Properties":{"id":"20240902164829-yzjqjjf","updated":"20240902164843"}}]}