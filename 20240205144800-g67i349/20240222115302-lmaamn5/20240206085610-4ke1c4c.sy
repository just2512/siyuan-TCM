ren":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 18-20240727145701-ihx0e2s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 651px;\" parent-style=\"width: 661px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 563px;","style":"width: 553px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 17-20240727145549-9o0h4g2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 553px;\" parent-style=\"width: 563px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727145339-pti2q8g","Type":"NodeParagraph","Properties":{"id":"20240727145339-pti2q8g","updated":"20240727145339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 694px;","style":"width: 684px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 15-20240727145339-yg0sjjr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 684px;\" parent-style=\"width: 694px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 19-20240727145820-etql099.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727143056-hgvagjh","Type":"NodeParagraph","Properties":{"id":"20240727143056-hgvagjh","updated":"20240727144418"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 315px;","style":"width: 305px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 8-20240727143056-stds3lo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 305px;\" parent-style=\"width: 315px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 975px;","style":"width: 965px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 13-20240727144418-wshmf36.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 965px;\" parent-style=\"width: 975px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727143856-y6dwk18","Type":"NodeParagraph","Properties":{"id":"20240727143856-y6dwk18","updated":"20240727144156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：金荞麦的叶子和开的花都跟荞麦一样，只是根茎是金黄色的，所以叫金荞麦；"}]},{"ID":"20240727142732-ymzysnf","Type":"NodeThematicBreak","Properties":{"id":"20240727142732-ymzysnf"}},{"ID":"20240902175436-mu0v5q0","Type":"NodeParagraph","Properties":{"id":"20240902175436-mu0v5q0","updated":"20240902175442"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：金荞麦"}]},{"ID":"20240902175436-tlvoj6w","Type":"NodeParagraph","Properties":{"id":"20240902175436-tlvoj6w","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"金荞麦《中国药典》"}]},{"ID":"20240902175436-wlywmvu","Type":"NodeParagraph","Properties":{"id":"20240902175436-wlywmvu","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiáoMài"}]},{"ID":"20240902175436-b8u7gmj","Type":"NodeParagraph","Properties":{"id":"20240902175436-b8u7gmj","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【英文名】RHIZOMAFAGOPYRIDIBOTRYIS"}]},{"ID":"20240902175436-5js7m4f","Type":"NodeParagraph","Properties":{"id":"20240902175436-5js7m4f","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【来源】本品为蓼科植物金荞麦Fagopyrumdibotrys（D.Don）Hara的干燥根茎。冬季采挖，除去茎及须根，洗净，晒干。"}]},{"ID":"20240902175436-tv332ji","Type":"NodeParagraph","Properties":{"id":"20240902175436-tv332ji","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则团块或圆柱状，常有瘤状分枝，顶端有的有茎残基，长3～15cm，直径1～4cm。表面棕褐色，有横向环节及纵皱纹，密布点状皮孔，并有凹陷的圆形根痕及残存须根。质坚硬，不易折断，断面淡黄白色或淡棕红色，有放射状纹理，中央髓部色较深。气微，味微涩。"}]},{"ID":"20240902175436-oimes1f","Type":"NodeParagraph","Properties":{"id":"20240902175436-oimes1f","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902175436-q526q2r","Type":"NodeParagraph","Properties":{"id":"20240902175436-q526q2r","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末淡棕色。淀粉粒甚多，单粒类球形、椭圆形或卵圆形，直径5～48μm，脐点点状、星状、裂缝状或飞鸟状，位于中央或偏于一端，大粒可见层纹；复粒由2～4分粒组成；半复粒可见。木纤维成束，直径10～38μm，纹孔呈单斜纹孔或十字形纹孔。草酸钙簇晶直径10～62μm。木薄壁细胞类方形、椭圆形，直径28～37μm，长约至100μm，壁厚约5μm,胞腔可见稀疏的纹孔。具缘纹孔及网纹导管直径21～83μm。"}]},{"ID":"20240902175436-tvu1cr3","Type":"NodeParagraph","Properties":{"id":"20240902175436-tvu1cr3","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加氯仿10ml，浸渍30分钟，时时振摇，滤过，滤液蒸干，残渣加氯仿1ml使溶解，作为供试品溶液。另取金荞麦对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各2～3μl，分别点于同一硅胶G薄层板上，以氯仿-甲醇（19:1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902175436-iruxg1v","Type":"NodeParagraph","Properties":{"id":"20240902175436-iruxg1v","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240902175436-gi0tdwn","Type":"NodeParagraph","Properties":{"id":"20240902175436-gi0tdwn","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【性味】微辛、涩，凉。"}]},{"ID":"20240902175436-cq6vmbo","Type":"NodeParagraph","Properties":{"id":"20240902175436-cq6vmbo","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【归经】归肺经。"}]},{"ID":"20240902175436-s0gagci","Type":"NodeParagraph","Properties":{"id":"20240902175436-s0gagci","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，排脓祛瘀。用于肺脓疡，麻疹肺炎，扁桃体周围脓肿。"}]},{"ID":"20240902175436-9ciji0h","Type":"NodeParagraph","Properties":{"id":"20240902175436-9ciji0h","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【用法用量】15～45g，用水或黄酒隔水密闭炖服。"}]},{"ID":"20240902175436-swwt52y","Type":"NodeParagraph","Properties":{"id":"20240902175436-swwt52y","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防霉，防蛀。"}]},{"ID":"20240902175436-soj5b31","Type":"NodeParagraph","Properties":{"id":"20240902175436-soj5b31","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902175436-lb9gg8v","Type":"NodeParagraph","Properties":{"id":"20240902175436-lb9gg8v","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"金荞麦《*辞典》"}]},{"ID":"20240902175436-mvzl18b","Type":"NodeParagraph","Properties":{"id":"20240902175436-mvzl18b","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiáoMài"}]},{"ID":"20240902175436-5w4vilc","Type":"NodeParagraph","Properties":{"id":"20240902175436-5w4vilc","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【英文名】RhizomaFagopyriCymosi"}]},{"ID":"20240902175436-seosv5s","Type":"NodeParagraph","Properties":{"id":"20240902175436-seosv5s","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【别名】野荞麦、荞麦三七、金锁银开"}]},{"ID":"20240902175436-xde4yc7","Type":"NodeParagraph","Properties":{"id":"20240902175436-xde4yc7","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【来源】为蓼科植物野荞麦Fagopyrumcymosum（Trev.）Meisn.的根茎。夏、秋季采挖根茎，洗净，晒干。"}]},{"ID":"20240902175436-da3euyr","Type":"NodeParagraph","Properties":{"id":"20240902175436-da3euyr","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本，高0.5~1.5m。根茎粗大，呈结节状，横走，红棕色，茎直立，有棱槽，绿色或红褐色。叶互生，戟新诗三角形，长宽几相等，先端突尖，基部心状戟形，边缘波状；托叶鞘近筒状斜形，膜质。花小，集成顶生或腋生的聚伞花序；花被子片5，白色；雄蕊8；子房上位，花柱3。瘦果卵形，具3棱，红棕色。花期7~9月，果期10~11月。"}]},{"ID":"20240902175436-q4wjtl9","Type":"NodeParagraph","Properties":{"id":"20240902175436-q4wjtl9","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡、旷野、路边及溪沟较阴湿处。主产江苏、浙江。"}]},{"ID":"20240902175436-sxak4w5","Type":"NodeParagraph","Properties":{"id":"20240902175436-sxak4w5","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【性状】根茎不规则团块状。常具瘤状分枝，长短不一，直径1~4cm。表面深灰褐色，有环节及纵皱纹，并密面点状皮刀。质坚硬，不易笔断，断面淡黄白色至黄棕色，有放射状纹理，中央有髓。气微。味微涩。"}]},{"ID":"20240902175436-cacjnd3","Type":"NodeParagraph","Properties":{"id":"20240902175436-cacjnd3","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【化学成份】含野荞麦甙（shakuchirin）。此甙碱水解后生成对香豆酸、阿魏酸及葡萄糖；另含有双聚原矢车菊甙元（dimericprocyanidin），是主要有效成分。"}]},{"ID":"20240902175436-rv1ghey","Type":"NodeParagraph","Properties":{"id":"20240902175436-rv1ghey","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【性味】性凉，味涩、微辛。"}]},{"ID":"20240902175436-31w9w7m","Type":"NodeParagraph","Properties":{"id":"20240902175436-31w9w7m","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒。清肺排痰，排脓消肿，祛风化湿。用于肺脓疡、咽喉肿痛、痢疾、无名肿毒、跌打损伤、风湿关节痛。"}]},{"ID":"20240902175436-i8chy7w","Type":"NodeParagraph","Properties":{"id":"20240902175436-i8chy7w","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902175436-g2smzmh","Type":"NodeParagraph","Properties":{"id":"20240902175436-g2smzmh","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"金荞麦《中华本草》"}]},{"ID":"20240902175436-ch9zdhv","Type":"NodeParagraph","Properties":{"id":"20240902175436-ch9zdhv","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīnQiáoMài"}]},{"ID":"20240902175436-m5iiz28","Type":"NodeParagraph","Properties":{"id":"20240902175436-m5iiz28","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【别名】赤地利、赤薛荔、金锁银开、天荞麦根、开金锁、贼骨头、透骨消、苦荞头、铁石子、野荞子、蓝养头、荞麦三七、野荞麦根、苦养麦根、荞当归、铁拳头"}]},{"ID":"20240902175436-lq68n3v","Type":"NodeParagraph","Properties":{"id":"20240902175436-lq68n3v","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175436-2dde8a0","Type":"NodeParagraph","Properties":{"id":"20240902175436-2dde8a0","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"药材基源：为蓼科植物金荞麦的根茎。"}]},{"ID":"20240902175436-mew8att","Type":"NodeParagraph","Properties":{"id":"20240902175436-mew8att","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Fagopyrumdibotrys(D.Don)Hara[Fagopyrumcymosum(Trev.)Meisn.]"}]},{"ID":"20240902175436-wpiiv3z","Type":"NodeParagraph","Properties":{"id":"20240902175436-wpiiv3z","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在秋季地上部分枯萎后采收，先割去茎叶，将根刨出，去净泥土，选出作种用根茎后，晒干或阴干，或50℃内炕干也可。"}]},{"ID":"20240902175436-jdeokm3","Type":"NodeParagraph","Properties":{"id":"20240902175436-jdeokm3","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生宿根草本，高0.5-1.5m。主根粗大，呈结节状，横走，红棕色。茎直立，多分枝，具棱槽，淡绿微带红色，全株微被白色柔毛。单叶互生，具柄，柄上有白色短柔毛；叶片为戟状三角形，长宽约相等，但顶部叶长大于宽，一般长4-10cm，宽4-9cm，先端长渐尖或尾尖状，基部心状戟形，顶端叶狭窄，无柄抱茎，全线成微波状，下面脉上有白色细柔毛；托叶鞘抱茎。秋季开白色小花，为顶生或腋生、稍有分枝的聚伞花序；花被片5，雄蕊8，2轮；雌蕊1，花柱3。瘦果呈卵状三棱形，红棕色。花期7-8月，果期10月。"}]},{"ID":"20240902175436-yvp9rji","Type":"NodeParagraph","Properties":{"id":"20240902175436-yvp9rji","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902175436-eev3g6c","Type":"NodeParagraph","Properties":{"id":"20240902175436-eev3g6c","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"生态环境：生于路边、沟旁较阴湿地。"}]},{"ID":"20240902175436-3d25oix","Type":"NodeParagraph","Properties":{"id":"20240902175436-3d25oix","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南和陕西、甘肃等地。"}]},{"ID":"20240902175436-p5r9puh","Type":"NodeParagraph","Properties":{"id":"20240902175436-p5r9puh","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902175436-cgzxrt4","Type":"NodeParagraph","Properties":{"id":"20240902175436-cgzxrt4","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"生物学特性适应性较强，喜温暖气候，适宜生长的温度为15～30℃，在-10℃左右地区栽培可以安全越冬。土壤以肥沃疏松的砂质壤上生长较好，粘土及排水不良的低洼地不宜种植。栽培技术用种子、根茎和扦插繁殖。种子繁殖：春播或秋播均可，春播4月，秋播10月。根茎繁殖：在春季将根茎挖出，选取健康根茎切成小段，以根茎幼嫩部分及根茎芽胞作繁殖材料。扦插繁殖：在夏季剪取组织充实的枝条，长15～20cm，具节2～3个、插条深2/3,行距12cm×9cm。田间管理在苗期要勤除杂草，松土2～3次，追肥可在苗高50-60cm左右或开花前施1次化肥，每1hm2225-300kg。雨季注意排水，干旱时应适当浇水。"}]},{"ID":"20240902175436-1mze1ei","Type":"NodeParagraph","Properties":{"id":"20240902175436-1mze1ei","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"病虫害防治桃蚜在发生期喷药液，冬季清园，将枯枝和落叶深理或烧毁。病毒病可选无病株留种，注意防治虫害。"}]},{"ID":"20240902175436-c3shtik","Type":"NodeParagraph","Properties":{"id":"20240902175436-c3shtik","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175436-bjh6dbg","Type":"NodeParagraph","Properties":{"id":"20240902175436-bjh6dbg","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"性状鉴别根茎呈不规则团块状，常具瘤状分枝，长短、大小不一，直径1-4cm。表面棕褐色至灰褐色，有紧密的环节及不规则的纵皱纹，以及众多的须根或须根痕；顶端有茎的残基。质坚硬，不易折断，切断面淡黄白色至黄棕色，有放射状纹理，中央有髓。气微，味微涩。"}]},{"ID":"20240902175436-lfadi30","Type":"NodeParagraph","Properties":{"id":"20240902175436-lfadi30","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"以个大、质坚硬者为佳。"}]},{"ID":"20240902175436-h048dsz","Type":"NodeParagraph","Properties":{"id":"20240902175436-h048dsz","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"显微鉴别根茎横切面：木栓层为4-5列木栓细胞，均含棕色物。皮层较窄，薄壁细胞含草酸钙簇晶。韧皮部有少数纤维散在。木质部呈内外两层，形似年轮；外层较宽，木薄壁细胞壁较薄，导管形大而稀少，木射线细胞狭长方形；内层较窄，木薄壁细胞较厚，导管形小，单列径向排列。髓部细胞圆形，壁较厚。粉末特征：淡红色。①淀粉粒类圆形，直径4-30μm，脐点点状。②草酸钙簇晶直径20-50μm.③具缘纹孔导管多见。"}]},{"ID":"20240902175436-8g92zjz","Type":"NodeParagraph","Properties":{"id":"20240902175436-8g92zjz","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"④韧皮纤维较为少见。"}]},{"ID":"20240902175436-4jcdfle","Type":"NodeParagraph","Properties":{"id":"20240902175436-4jcdfle","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粗粉1g，加乙醇50ml回流提取2h，取乙醇提取液l-2滴，置试管中，加花色素试剂（正丁醇60ml与40％盐酸40ml混合，再加入FeSO4.7H2O77mg溶解2ml，在沸水浴上加热5min，溶液呈樱红色。（检查还原花色甙元二聚物）（2）电泳：取醇提液点在新华1号滤纸条上（5cm×30cm），用硼酸-硼砂缓冲液（pH8．8），电压200V，电流0．3mA，电泳7h，晾干，观察荧光后，喷对甲苯磺酸试剂（20%乙醇液），100℃烤5min，约在离原点17cm处有红棕色斑点。"}]},{"ID":"20240902175436-15yrnzf","Type":"NodeParagraph","Properties":{"id":"20240902175436-15yrnzf","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【化学成份】根茎含双聚原矢车菊素（dimericProcyani－din）[1]，海柯皂甙元（hecogenin），β-谷甾醇（β-sitosterol），鞣质（tannin）及一种水解后可得对-香豆酸（p－coumaricacid）、阿魏酸（ferulicacid）和葡萄糖（glucose）的甙。还含有左旋表儿茶精（epicatechin），3-没食子酰表儿茶精（3－galloylepicatechin），原矢车菊素（procyanidin）B-2、B-4和原矢车菊素B－2的3，3′-双没食子酸酯（3，3′-digalloylprocyanidin)[2]。"}]},{"ID":"20240902175436-hkral9j","Type":"NodeParagraph","Properties":{"id":"20240902175436-hkral9j","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902175436-euqlfkr","Type":"NodeParagraph","Properties":{"id":"20240902175436-euqlfkr","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"1．抗癌作用金荞麦根水煎剂20g（生药）／（kg·d)和13．3g（生药）／（kg.d）灌胃，连续10d，对小鼠Lewis肺癌和宫颈癌U14均有显着的抑制作用，雌性小鼠的疗效较雄性小鼠为好[1]。利用小鼠肾囊膜下移植法（SRCA），比较肺癌组织移植前后体积改变以预测和评价金荞麦提取物金E和CD1的抗癌作用。SRCA后第1～5d,小鼠连续5次口服金E或CD1，剂量均为每次100mg／kg，试验结果显示金E和CD1的有效比为4／0和2／l0，肺鳞癌对金E治疗的敏感性高于其他组织类型的肺癌[2]。金荞麦根素（FagopyrumCymosumRootin,FCR）是从金荞麦根中提出的一类综合性单宁混合物，每1ml浓度为125μg时，对肺腺癌（GLC）、宫颈鳞癌HeLa）、鼻咽鳞癌（KB）细胞生长的抑制率分别为84．5％、78．9％、100％，使癌细胞的膜、RNA、DNA代谢、核分裂受损伤[3]。还发现FCR有显着抑制GLC、Hela、KB及胃腺癌细胞SGC）人癌细胞克隆形成的作用，抑制率与浓度成正比，在低浓度12．5μg／ml时抑制率分别为：GLC89.7%、HeLa53.8%、SGC65.4%、K接杀伤细胞法、集落培养抑制法及DNA前体物质掺入法研究金荞麦根对体外培养的多种人癌细胞的抗癌作用。结果，此药在lg／L时对多种人癌细胞的杀伤率均超过一个对数杀灭,浓度降低至0．125g/L的杀伤率仍接近一个对数杀灭达74．3％-92．1％。金荞麦根中的提取物具有明显的抗癌作用，其浓度为0.1g／L、0．05g／L对多种癌细胞的集落抑制率达100％。浓度为0．0125g／L时抑制率达75．1％～89．2％。再用3H－TdR标记法观察发现，金荞麦根的有效化学提取物能明显抑制癌细胞内的核酸代谢，其抑制作用与同浓度的阳性对照氟尿嘧啶近似[5，6]。"}]},{"ID":"20240902175436-a0b228v","Type":"NodeParagraph","Properties":{"id":"20240902175436-a0b228v","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"2．抑菌作用金荞麦对金黄色葡萄球菌、肺炎链球菌、大肠杆菌、绿脓杆菌均有抑制作用，醉剂作用大于水剂[7]。另有报道，金荞麦及其各分离部分无体外抗菌作用，于感染前的不同时期腹腔注射金荞麦浸膏83mg/kg，对腹腔感染金黄色葡萄球菌小鼠有明显的保护作用，但在感染同时或感染后用药则无保护作用[8]。"}]},{"ID":"20240902175436-a0kgxuz","Type":"NodeParagraph","Properties":{"id":"20240902175436-a0kgxuz","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"3．其他作用金荞麦浸膏83mg／kg腹腔注射，能增强小鼠腹腔巨噬细胞的吞噬功能，但巨噬细胞总数未见增多。三联菌苗致热家兔口服金荞麦浸膏有解热作用，给小鼠口服金荞麦浸膏有轻微的镇咳作用[8]。"}]},{"ID":"20240902175436-gvxd5ba","Type":"NodeParagraph","Properties":{"id":"20240902175436-gvxd5ba","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"4．毒性金荞麦提取物金E组小鼠100mg／kg，连续5d口服给药后，动物体重及脾脏重量较对照组明显减轻，剂量如加大到500mg/kg,脾重减轻则更明显[2]。"}]},{"ID":"20240902175436-75uc3hl","Type":"NodeParagraph","Properties":{"id":"20240902175436-75uc3hl","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末1g，加氯仿10ml，浸渍30分钟，时时振摇，滤过，滤液蒸干，残渣加氯仿lml使溶解，作为供试品溶液。另取金荞麦对照药材1g，同法制成对照药材溶液。照薄层色谱法(药典附录ⅥB)试验，吸取上述两种溶液各2-3μl，分别点于同一硅胶G薄层板上，以氯仿-甲醇(19：1)为展开剂，展开，取出，晾干，喷以10%硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902175436-5qvhjlz","Type":"NodeParagraph","Properties":{"id":"20240902175436-5qvhjlz","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240902175436-0aymgh2","Type":"NodeParagraph","Properties":{"id":"20240902175436-0aymgh2","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；活血消痈；祛风除湿疮毒；蛇虫咬伤。主肺痈；肺热咳喘；咽喉肿痛；痢疾；风湿痹证；跌打损伤；痈肿癌"}]},{"ID":"20240902175436-ikoe1qj","Type":"NodeParagraph","Properties":{"id":"20240902175436-ikoe1qj","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g；或研末。外用：适量，捣汁或磨汁涂敷。"}]},{"ID":"20240902175436-qopg2um","Type":"NodeParagraph","Properties":{"id":"20240902175436-qopg2um","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于肺脓疡，麻疹肺炎，扁桃体周围脓肿。"}]},{"ID":"20240902175436-9ue48o5","Type":"NodeParagraph","Properties":{"id":"20240902175436-9ue48o5","updated":"20240902175446"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902175437-0x6mw36","Type":"NodeThematicBreak","Properties":{"id":"20240902175437-0x6mw36","updated":"20240902175446"}},{"ID":"20240902175438-86h51y8","Type":"NodeParagraph","Properties":{"id":"20240902175438-86h51y8","updated":"20240902175446"}}]}