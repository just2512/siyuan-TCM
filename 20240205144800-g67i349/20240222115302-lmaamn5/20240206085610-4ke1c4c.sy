{"ID":"20240206085610-4ke1c4c","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240206085610-4ke1c4c","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206085610-4ke1c4c\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206085619-y2iaex9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240206085613-a0z71b6\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206085619-y2iaex9\u0026quot;,\u0026quot;focusStart\u0026quot;:139,\u0026quot;focusEnd\u0026quot;:139\u0026#125;","title":"金荞麦（野荞麦、苦荞头）","type":"doc","updated":"20240902175442"},"Children":[{"ID":"20240206085619-y2iaex9","Type":"NodeParagraph","Properties":{"id":"20240206085619-y2iaex9","updated":"20240206085622"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产浙江、江苏等地。\n【性状】\t根茎呈不规则团块状，常具瘤状分枝，长短、大小不一，直径1-4cm。表面棕褐色至灰褐色，有紧密的环节及不规则的纵皱纹，以及众多的须根或须根痕；顶端有茎的残基。质坚硬，不易折断，切断面淡黄白色至黄棕色，有放射状纹理，中央有髓。气微，味微涩。\n【性味】\t微辛、涩，凉。\n【功效】\t清热解毒；活血消痈；祛风除湿疮毒；蛇虫咬伤。主肺痈；肺热咳喘；咽喉肿痛；痢疾；风湿痹证；跌打损伤；痈肿癌。"}]},{"ID":"20240206085613-a0z71b6","Type":"NodeParagraph","Properties":{"id":"20240206085613-a0z71b6","updated":"20240206085613"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206085613-ot4ckoa.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727144600-gxgdtd0","Type":"NodeParagraph","Properties":{"id":"20240727144600-gxgdtd0","updated":"20240727144600"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 650px;","style":"width: 640px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 14-20240727144600-zxheeau.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 640px;\" parent-style=\"width: 650px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727135935-l4nzwax","Type":"NodeParagraph","Properties":{"id":"20240727135935-l4nzwax","updated":"20240727141920"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦-20240727141918-9kt7l3x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727142047-k0er80z","Type":"NodeParagraph","Properties":{"id":"20240727142047-k0er80z","updated":"20240727142639"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 596px;","style":"width: 586px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 1-20240727142038-clxvuk8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 586px;\" parent-style=\"width: 596px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 593px;","style":"width: 583px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金荞麦 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金荞麦 5-20240727142517-kyrb1p1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 583px;\" parent-style=\"width: 593px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727142244-62lxgxj","Type":"NodeParagraph","Properties":{"id":"20240727142244-62lxgxj","updated":"20240727143318"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properti