Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 636px;","style":"width: 626px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独蒜兰 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独蒜兰 5-20240712125737-xa7en06.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 626px;\" parent-style=\"width: 636px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712125118-3xwqe5d","Type":"NodeParagraph","Properties":{"id":"20240712125118-3xwqe5d","updated":"20240712125253"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 735px;","style":"width: 725px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独蒜兰 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独蒜兰 3-20240712125253-ha4ppxj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 725px;\" parent-style=\"width: 735px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 506px;","style":"width: 496px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独蒜兰 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独蒜兰 2-20240712125118-pzlszqf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 496px;\" parent-style=\"width: 506px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240712130434-65h97ut","Type":"NodeParagraph","Properties":{"id":"20240712130434-65h97ut","updated":"20240712130442"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独蒜兰 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独蒜兰 6-20240712130424-gpu3ta7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 780px;","style":"width: 770px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"独蒜兰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/独蒜兰-20240712124955-c2nauys.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 770px;\" parent-style=\"width: 780px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712123315-w7c6tr3","Type":"NodeParagraph","Properties":{"id":"20240712123315-w7c6tr3","updated":"20240902085436"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：现今较普遍的说法是山慈菇并不是来源于一种植物，而是两种，即杜鹃兰和独蒜兰；"}]},{"ID":"20240712123316-1ixvkvw","Type":"NodeThematicBreak","Properties":{"id":"20240712123316-1ixvkvw"}},{"ID":"20240830165207-277bojp","Type":"NodeParagraph","Properties":{"id":"20240830165207-277bojp","updated":"20240830165213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：山慈菇"}]},{"ID":"20240830165207-c11f4lw","Type":"NodeParagraph","Properties":{"id":"20240830165207-c11f4lw","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"山慈菇《中国药典》"}]},{"ID":"20240830165207-i91qw8y","Type":"NodeParagraph","Properties":{"id":"20240830165207-i91qw8y","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānCíGu"}]},{"ID":"20240830165207-5a0gied","Type":"NodeParagraph","Properties":{"id":"20240830165207-5a0gied","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【来源】本品为兰科植物杜鹃兰Cremastraappendiculata（D.Don）Makino、独蒜兰Pleionebulbocodioides（Franch.）Rolfe或云南独蒜兰PleioneyunnanensisRolfe的干燥假鳞茎。前者习称“毛慈菇”，后二者习称“冰球子”。夏、秋二季采挖，除去地上部分及泥沙，分开大小置沸水锅中蒸煮至透心，干燥。"}]},{"ID":"20240830165207-5qzx8gf","Type":"NodeParagraph","Properties":{"id":"20240830165207-5qzx8gf","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830165207-4zhz86c","Type":"NodeParagraph","Properties":{"id":"20240830165207-4zhz86c","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"毛慈菇：呈不规则扁球形或圆锥形，顶端渐突起，基部有须根痕。长1.8～3cm，膨大部直径1～2cm。表面黄棕色或棕褐色，有纵皱纹或纵沟，中部有2～3条微突起的环节，节上有鳞片叶干枯腐烂后留下的丝状纤维。质坚硬，难折断，断面灰白色或黄白色，略呈角质。气微，味淡，带黏性。"}]},{"ID":"20240830165207-bsdet4w","Type":"NodeParagraph","Properties":{"id":"20240830165207-bsdet4w","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"冰球子：呈圆锥形，瓶颈状或不规则团块，直径1～2cm，高1.5～2.5cm。顶端渐尖，尖端断头处呈盘状，基部膨大且圆平，中央凹入，有1～2条环节，多偏向一侧。撞击外皮者表面黄白色，带表皮者浅棕色，光滑，有不规则皱纹。断面浅黄色，角质半透明。"}]},{"ID":"20240830165207-69viay3","Type":"NodeParagraph","Properties":{"id":"20240830165207-69viay3","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830165207-qwxrj7h","Type":"NodeParagraph","Properties":{"id":"20240830165207-qwxrj7h","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"本品横切面；毛慈菇最外层为一层扁平的表皮细胞，其内有2～3列厚壁细胞，浅黄色，再向内为大的类圆形薄壁细胞，含黏液质，并含有淀粉粒。近表皮处的薄壁细胞中含有草酸钙针晶束，长70～150μｍ。维管束散在，外韧型。"}]},{"ID":"20240830165207-yrne4o7","Type":"NodeParagraph","Properties":{"id":"20240830165207-yrne4o7","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"冰球子表皮细胞切向延长，淀粉粒存在于较小的薄壁细胞中，维管束鞘纤维半月形，偶有两半月形。"}]},{"ID":"20240830165207-zhi4jvu","Type":"NodeParagraph","Properties":{"id":"20240830165207-zhi4jvu","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，水浸约1小时，润透，切薄片，干燥或冼净干燥，用时捣碎。"}]},{"ID":"20240830165207-kyre12m","Type":"NodeParagraph","Properties":{"id":"20240830165207-kyre12m","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微辛，凉。"}]},{"ID":"20240830165207-7ud6k3y","Type":"NodeParagraph","Properties":{"id":"20240830165207-7ud6k3y","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾经。"}]},{"ID":"20240830165207-lwllneg","Type":"NodeParagraph","Properties":{"id":"20240830165207-lwllneg","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，化痰散结。用于痈肿疔毒，瘰疬痰核，淋巴结结核，蛇虫咬伤。"}]},{"ID":"20240830165207-sdfplku","Type":"NodeParagraph","Properties":{"id":"20240830165207-sdfplku","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。外用适量。"}]},{"ID":"20240830165207-1cm4ld3","Type":"NodeParagraph","Properties":{"id":"20240830165207-1cm4ld3","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830165207-fiwdyjz","Type":"NodeParagraph","Properties":{"id":"20240830165207-fiwdyjz","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830165207-a778qv3","Type":"NodeParagraph","Properties":{"id":"20240830165207-a778qv3","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"山慈菇《全国中草药汇编》"}]},{"ID":"20240830165207-lue52oi","Type":"NodeParagraph","Properties":{"id":"20240830165207-lue52oi","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānCíGu"}]},{"ID":"20240830165207-9rblhzo","Type":"NodeParagraph","Properties":{"id":"20240830165207-9rblhzo","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【别名】毛慈菇、茅慈菇、冰球子、泥宾子"}]},{"ID":"20240830165207-7p4udei","Type":"NodeParagraph","Properties":{"id":"20240830165207-7p4udei","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【来源】兰科独蒜兰属植物瓶状独蒜兰Pleionebulbocodioides（Franch.）Rolfe和滇独蒜兰P.yunnanensisRolfe[P.chiwuanaTangetWang]，以假球茎入药。"}]},{"ID":"20240830165207-379ickw","Type":"NodeParagraph","Properties":{"id":"20240830165207-379ickw","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微辛，寒。有小毒。"}]},{"ID":"20240830165207-ik7w0pe","Type":"NodeParagraph","Properties":{"id":"20240830165207-ik7w0pe","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，消肿散结。用于痈肿疔毒，淋巴结结核，蛇咬伤。"}]},{"ID":"20240830165207-p8c1nnl","Type":"NodeParagraph","Properties":{"id":"20240830165207-p8c1nnl","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.8～1.5钱；外用适量，捣烂或醋磨涂患处。"}]},{"ID":"20240830165207-bom47ei","Type":"NodeParagraph","Properties":{"id":"20240830165207-bom47ei","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830165207-d01r57p","Type":"NodeParagraph","Properties":{"id":"20240830165207-d01r57p","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"对痈肿疔毒、瘰历结核，内服、外敷，均可应用。"}]},{"ID":"20240830165207-zwo98ow","Type":"NodeParagraph","Properties":{"id":"20240830165207-zwo98ow","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"用于食道癌，常与急性子、制半夏、地鳖虫、石见穿等配合应用。"}]},{"ID":"20240830165207-a6lazbz","Type":"NodeParagraph","Properties":{"id":"20240830165207-a6lazbz","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"用于淋巴肿瘤，常与昆布、海藻、夏枯草、象贝等配合应用。"}]},{"ID":"20240830165207-wlhkjjb","Type":"NodeParagraph","Properties":{"id":"20240830165207-wlhkjjb","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830165207-kcd9g1q","Type":"NodeParagraph","Properties":{"id":"20240830165207-kcd9g1q","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"山慈菇《中华本草》"}]},{"ID":"20240830165207-4ydabx2","Type":"NodeParagraph","Properties":{"id":"20240830165207-4ydabx2","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目拾遗》"}]},{"ID":"20240830165207-dy2lew0","Type":"NodeParagraph","Properties":{"id":"20240830165207-dy2lew0","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānCíGu"}]},{"ID":"20240830165207-s0widc4","Type":"NodeParagraph","Properties":{"id":"20240830165207-s0widc4","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【英文名】PseudobulbofAppendiculateCremastra"}]},{"ID":"20240830165207-3ruqzzs","Type":"NodeParagraph","Properties":{"id":"20240830165207-3ruqzzs","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【别名】金灯花、鹿蹄草、山茨菇、慈姑、山慈姑、毛慈姑、泥冰子、算盘七、人头七、太白及、水球子、泥宾子、采配兰"}]},{"ID":"20240830165207-3odc91c","Type":"NodeParagraph","Properties":{"id":"20240830165207-3odc91c","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830165207-hk0if9n","Type":"NodeParagraph","Properties":{"id":"20240830165207-hk0if9n","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"药材基源：为兰科植物杜鹃兰、独蒜兰的假鳞茎。"}]},{"ID":"20240830165207-ujjd4md","Type":"NodeParagraph","Properties":{"id":"20240830165207-ujjd4md","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cremastraappendiculata(D.Don)Makino[CymbidiumappendiculataD.DON;CremastrawallichianaLindl.exWall.]"}]},{"ID":"20240830165207-xzw15gf","Type":"NodeParagraph","Properties":{"id":"20240830165207-xzw15gf","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏秋季采挖，除去茎叶、须根、洗净，蒸后，晾至半干，再晒干。"}]},{"ID":"20240830165207-tdjqm5x","Type":"NodeParagraph","Properties":{"id":"20240830165207-tdjqm5x","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830165207-jt4jzl2","Type":"NodeParagraph","Properties":{"id":"20240830165207-jt4jzl2","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"1.杜鹃兰，陆生植物。假鳞茎聚生，近球形，粗1-3cm。顶生1叶，很少具2叶；叶片椭圆形，长达45cm,宽4-8cm，先端急尖，基部收窄为柄。花葶侧生于假鳞茎顶端，直立，粗壮，通常高出叶外，疏生2枚筒状鞘；总状花序疏生多数花；花偏向一侧，紫红色；花苞片狭披针形，等长于或短于花梗(连子房)；花被片呈筒状，先端略开展；萼片和花瓣近相等，倒披针形，长3.5cm左右，中上部宽约4mm，先端急尖；唇瓣近匙形，与萼片近等长，基部浅囊状，两侧边缘略向上反折，前端扩大并为3裂，侧裂片狭小，中裂片长圆形，基部具1个紧贴或多少分离的附属物；合蕊柱纤细，略短于萼片。花期6-8月。"}]},{"ID":"20240830165207-wg9wvek","Type":"NodeParagraph","Properties":{"id":"20240830165207-wg9wvek","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"2.独蒜蒜兰，陆生植物，高15-25cm。假鳞茎狭卵形或长颈瓶状，长1-2cm，顶生1枚叶，叶落后1杯状齿环。叶和花同时出现，椭圆状披针形，长10-25cm，芝2-5cm，先端稍钝或渐尖，基部收狭成柄抱花葶。花葶顶生1朵花。花苞片长圆形，近急尖，等于或长于子房；花淡紫色或粉红色；萼片直立，狭披针形，长达4cm，宽5-7mm，先端急尖；唇瓣基部楔形，先端凹缺或几乎不凹缺，边缘具不整齐的锯齿，内面有3-5条波状或近直立的褶片。花期4-5月，果期7月。"}]},{"ID":"20240830165207-lg380k8","Type":"NodeParagraph","Properties":{"id":"20240830165207-lg380k8","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830165207-bbiqv2g","Type":"NodeParagraph","Properties":{"id":"20240830165207-bbiqv2g","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于山坡及林下阴湿处。"}]},{"ID":"20240830165207-5qlm6kn","Type":"NodeParagraph","Properties":{"id":"20240830165207-5qlm6kn","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"2.生于海m的林下或沟谷旁有泥土的石壁上。"}]},{"ID":"20240830165207-4p1p7ks","Type":"NodeParagraph","Properties":{"id":"20240830165207-4p1p7ks","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于长江流域以南地区及山西、陕西、甘肃等地。"}]},{"ID":"20240830165207-m690agk","Type":"NodeParagraph","Properties":{"id":"20240830165207-m690agk","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"2.分布于华东、中南、西南及陕西、甘肃等地。"}]},{"ID":"20240830165207-ygp3vz6","Type":"NodeParagraph","Properties":{"id":"20240830165207-ygp3vz6","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830165207-ad3f1un","Type":"NodeParagraph","Properties":{"id":"20240830165207-ad3f1un","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"1.杜鹃兰的干燥假球茎呈圆球状尖圆形或稍扁平，直径1-2cm，外表棕褐色或灰棕色，有细小皱折。顶端有一圆形的蒂迹；底部凹陷处有须根，须根长约1-3cm，粗1-2mm；腰部有下凹或突起的环节，俗称腰带。假球茎周围被有或疏或密的金黄色丝状毛须及黑色细须。或已将须根及外皮均除去。质坚实，内心黄白色或乌黑色，粗糙。味淡，微香，遇水有粘性。以个大、饱满、断面黄白色、质坚实者为佳。"}]},{"ID":"20240830165207-w6s7wam","Type":"NodeParagraph","Properties":{"id":"20240830165207-w6s7wam","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"2.独蒜兰的干燥假球茎呈圆球形或不规则块状，直径1-1.5cm，顶端渐突起，基部脐状，有须根或须根痕。腰带往往在凹入部，故不甚明显，撞去表皮者表面呈黄白色、浅黄色或灰黄色，带有表皮者呈浅棕色或棕色，光滑，或有皱纹及深沟。质坚硬，难折断，断面角质半透明。气微弱，味淡微苦，稍粘。除上述品种外，尚有独蒜兰属植物云南独蒜兰Pleioneyunnanensis（Rolfe）Rolfe（参见独叶白芨条）及山兰属植物冰球子Oreorchispatens（Lindl.）Lindl.（四川）、O.FoliosaLindl.（西藏）等的假球茎，亦作山慈姑入药。"}]},{"ID":"20240830165207-1d82u51","Type":"NodeParagraph","Properties":{"id":"20240830165207-1d82u51","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【化学成份】杜鹃兰根茎含粘液及葡配甘露聚糖（Gluco-mannan，甘露糖：葡萄糖（2:1）。"}]},{"ID":"20240830165207-lfrnf3o","Type":"NodeParagraph","Properties":{"id":"20240830165207-lfrnf3o","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【药理作用】杜鹃兰素Ⅱ（15ug/kg）iv可使大鼠血压从14.2kPa（10＞mmHg）下降到9.07kPa（168mmHg），降压作用持续＞30min。"}]},{"ID":"20240830165207-1jg9i35","Type":"NodeParagraph","Properties":{"id":"20240830165207-1jg9i35","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【炮制】除尽须根，洗净，清水浸泡2-4小时，取出润透，切片，晒干。捣碎用亦可。"}]},{"ID":"20240830165207-10swkzi","Type":"NodeParagraph","Properties":{"id":"20240830165207-10swkzi","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；微辛；性寒；小毒"}]},{"ID":"20240830165207-q9g0v3n","Type":"NodeParagraph","Properties":{"id":"20240830165207-q9g0v3n","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【归经】肝；胃；肺经"}]},{"ID":"20240830165207-1jhby43","Type":"NodeParagraph","Properties":{"id":"20240830165207-1jhby43","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；消肿散结。主痈疽恶疮；瘰疬结核；咽痛喉痹；蛇、虫咬伤"}]},{"ID":"20240830165207-0ieiphe","Type":"NodeParagraph","Properties":{"id":"20240830165207-0ieiphe","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g；或磨汁；或入丸、散。外用：适量，磨汁涂；或研末调敷。"}]},{"ID":"20240830165207-cf86qvj","Type":"NodeParagraph","Properties":{"id":"20240830165207-cf86qvj","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【各家论述】1.《本草新编》：山慈姑，玉枢丹中为君，可治怪病。大约怪病多起于痰，山慈姑正消痰之药，治痰而怪病自除也。或疑山慈姑非消痰之药，乃散毒之药也。不知毒之未成者为痰，而痰之已结者为毒，是痰与毒，正未可二视也。2.《本草正义》：山慈姑之名，始见于《嘉佑本草》，然陈藏器《拾遗》已有之，则名金灯，即其花也。能散坚消结，化痰解毒，其力颇峻，故诸家以为有小毒，并不以为内服之药。至王谬《百一选方》，乃有太乙紫金丹，亦名玉枢丹，即今通行之紫金锭也，外证可敷，内证可服，其效最捷。则以合大戟、千金子霜、麝香，皆通利迅疾之品，所以行驶极速，取效眉睫。而病重者连服之，则必利下，是以攻逐恶物为专职，药力之猛烈可知。此皆用以荡涤肠胃，驱除积垢，以减邪毒凭陵之势，亦非能通行百脉，消除皮里膜外之坚积也。且气味俱淡，以质为用，所以古来未入煎剂，近人有用入煎方，以为消积攻坚之法，如瘰疬痞积之类皆喜用之，而不能取效者，则以此物止能直下，而不能旁行，其力虽峻，而无宣络通经之性，何能行于肢体脉络。肠胃之病，如食积气滞，胸脘不舒，服玉枢丹少许，则顷刻即效。此中微义，亦可深长思矣。3.《本草拾遗》：主痈肿疮瘘，瘰疬结核等，醋磨敷之，亦除皯。4.《滇南本草》：消阴分之痰，止咳嗽，治喉痹，止咽喉痛。治毒疮，攻痈疽，敷诸疮肿毒，有脓者溃，无脓者消。5.《纲目》：主疔肿，攻毒破皮。解诸毒，蛇虫、狂犬伤。6.《本草再新》：治烦热痰火，疮疔痧痘，瘰疬结核。杀诸虫毒。7.《国药的药理学》：为粘滑药。用于呕吐下痢等。"}]},{"ID":"20240830165207-6ed752h","Type":"NodeParagraph","Properties":{"id":"20240830165207-6ed752h","updated":"20240830165213"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830165208-z5nmamx","Type":"NodeThematicBreak","Properties":{"id":"20240830165208-z5nmamx","updated":"20240830165213"}},{"ID":"20240830165209-kaz7m9w","Type":"NodeParagraph","Properties":{"id":"20240830165209-kaz7m9w","updated":"20240830165213"}}]}