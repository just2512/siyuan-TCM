"},{"Type":"NodeLinkText","Data":"天葵子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天葵子-20240829171206-yn8gc48.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 291px;\" parent-style=\"width: 301px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 938px;","style":"width: 928px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天葵子8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天葵子8-20240708101459-q06uavl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 928px;\" parent-style=\"width: 938px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829171459-78a1fs1","Type":"NodeParagraph","Properties":{"id":"20240829171459-78a1fs1","updated":"20240829171459"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天葵子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天葵子 2-20240829171459-jgi05np.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240708101502-rnvb0eb","Type":"NodeThematicBreak","Properties":{"id":"20240708101502-rnvb0eb"}},{"ID":"20240830095316-m53vlkt","Type":"NodeParagraph","Properties":{"id":"20240830095316-m53vlkt","updated":"20240830095318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天葵子"}]},{"ID":"20240830101512-ho9bgg4","Type":"NodeParagraph","Properties":{"id":"20240830101512-ho9bgg4","updated":"20240830101517"},"Children":[{"Type":"NodeText","Data":"【别名】紫背天葵、天葵、天葵草、千年老鼠屎、金耗子屎、夏无踪、散血球"}]},{"ID":"20240830101557-12b4nrh","Type":"NodeParagraph","Properties":{"id":"20240830101557-12b4nrh","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"天葵子《中国药典》"}]},{"ID":"20240830101557-id4s0pb","Type":"NodeParagraph","Properties":{"id":"20240830101557-id4s0pb","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【拼音名】TiānKuíZǐ"}]},{"ID":"20240830101557-04kx02o","Type":"NodeParagraph","Properties":{"id":"20240830101557-04kx02o","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【英文名】RADIXSEMIAQUILEGIAE"}]},{"ID":"20240830101557-fy1gel3","Type":"NodeParagraph","Properties":{"id":"20240830101557-fy1gel3","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【别名】紫背天葵、天葵、天葵草、千年老鼠屎、金耗子屎、夏无踪、散血球"}]},{"ID":"20240830101557-ko9pvli","Type":"NodeParagraph","Properties":{"id":"20240830101557-ko9pvli","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【来源】本品为毛茛科植物天葵Semiaquilegiaadoxoides（DC.）Makino的干燥块根。夏初采挖，洗净，干燥，除去须根。"}]},{"ID":"20240830101557-f1l5cuu","Type":"NodeParagraph","Properties":{"id":"20240830101557-f1l5cuu","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则短柱状、纺锤状或块状，略弯曲，长1～3cm，直径0。5～1cm。表面暗褐色至灰黑色，具不规则的皱纹及须根或须根痕。顶端常有茎叶残基，外被数层黄褐色鞘状鳞片。质较软，易折断，断面皮部类白色，木部黄白色或黄棕色，略呈放射状。气微，味甘、微苦辛。"}]},{"ID":"20240830101557-z4jl7vk","Type":"NodeParagraph","Properties":{"id":"20240830101557-z4jl7vk","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830101557-8axpd5z","Type":"NodeParagraph","Properties":{"id":"20240830101557-8axpd5z","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：木栓层为多列细胞，含棕色物。皮层较窄。韧皮部宽广。形成层成环。木质部射线宽至20余列细胞，导管放射状排列。有的可见细小髓部。"}]},{"ID":"20240830101557-m88bx7q","Type":"NodeParagraph","Properties":{"id":"20240830101557-m88bx7q","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"（2）本品断面置紫外光灯（365nm）下观察，显黄白色荧光，加酸或加碱后荧光减退。"}]},{"ID":"20240830101557-08xn1ow","Type":"NodeParagraph","Properties":{"id":"20240830101557-08xn1ow","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加70％乙醇10ml，加热回流30分钟，滤过，滤液蒸干，残渣加盐酸溶液（1→100）5ml使溶解，滤过，滤液分置两支试管中，一管中加碘化铋钾试液1～2滴，生成橘红色沉淀；另一管中加硅钨酸试液1～2滴，生成黄色沉淀。"}]},{"ID":"20240830101557-qj6b0g7","Type":"NodeParagraph","Properties":{"id":"20240830101557-qj6b0g7","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性味】甘、苦，寒。"}]},{"ID":"20240830101557-dsm7sw7","Type":"NodeParagraph","Properties":{"id":"20240830101557-dsm7sw7","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、胃经。"}]},{"ID":"20240830101557-jn5hc8k","Type":"NodeParagraph","Properties":{"id":"20240830101557-jn5hc8k","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，消肿散结。用于痈肿疔疮，乳痈，瘰疠，毒蛇咬伤。"}]},{"ID":"20240830101557-pzkhbjt","Type":"NodeParagraph","Properties":{"id":"20240830101557-pzkhbjt","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240830101557-ojwlelv","Type":"NodeParagraph","Properties":{"id":"20240830101557-ojwlelv","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处，防蛀。"}]},{"ID":"20240830101557-0xmcxj8","Type":"NodeParagraph","Properties":{"id":"20240830101557-0xmcxj8","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【备注】常与象贝、牡蛎、夏枯草、玄参等配伍治疗瘰历；与蒲公英、鹿角霜等配伍治疗乳痈；与银花、连翘、地丁草等配伍治疗疮痈等症。用于肝癌、乳癌、淋巴肿瘤等疾病，常与七叶一枝花、八月礼等配合应用。"}]},{"ID":"20240830101557-opk4n2e","Type":"NodeParagraph","Properties":{"id":"20240830101557-opk4n2e","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830101557-zilcw9z","Type":"NodeParagraph","Properties":{"id":"20240830101557-zilcw9z","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"天葵子《*辞典》"}]},{"ID":"20240830101557-or1y3xz","Type":"NodeParagraph","Properties":{"id":"20240830101557-or1y3xz","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【出处】《分类草药性》"}]},{"ID":"20240830101557-wd8hrf6","Type":"NodeParagraph","Properties":{"id":"20240830101557-wd8hrf6","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【拼音名】TiānKuíZǐ"}]},{"ID":"20240830101557-p49lv6d","Type":"NodeParagraph","Properties":{"id":"20240830101557-p49lv6d","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【别名】紫背天葵子（《医宗汇编》），千年老鼠屎（《纲目抬遗》），金耗子屎（《贵州民间方药集》），千年耗子屎、地丁子（《贵阳民间药草》），天去子、野乌头子、鸡腿、散血珠（《湖南药物志》），天葵根（《江西草药》）。"}]},{"ID":"20240830101557-gjt88ea","Type":"NodeParagraph","Properties":{"id":"20240830101557-gjt88ea","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【来源】为毛茛科植物天葵的块根。5～6月间挖取块根，除去须根，晒干。"}]},{"ID":"20240830101557-ewzi4g0","Type":"NodeParagraph","Properties":{"id":"20240830101557-ewzi4g0","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【原形态】植物形态详\"天葵\"条。"}]},{"ID":"20240830101557-7bgxon6","Type":"NodeParagraph","Properties":{"id":"20240830101557-7bgxon6","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产江苏、湖南、湖北。此外，安徽、广西、贵州、云南、江西、浙江等地亦产。"}]},{"ID":"20240830101557-e2vfisz","Type":"NodeParagraph","Properties":{"id":"20240830101557-e2vfisz","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性状】干燥块根多数为椭圆形、纺锤形，或呈圆柱形而扭曲，长1～3厘米，宽0.5～1厘米，外面暗褐色，表面粗糙，具不规则纵槽纹及横向线纹；块根顶端常有叶柄残基，外被数层黄褐色鞘状鳞片，有须根或须根痕。质较脆，断面较平坦，皮部类白色，木部黄色。气微弱，味先甘而后涩。以干燥、形大、外黑内白、无须根杂质者为佳。"}]},{"ID":"20240830101557-t2vqk5r","Type":"NodeParagraph","Properties":{"id":"20240830101557-t2vqk5r","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【炮制】清水洗净，切片，晒干。"}]},{"ID":"20240830101557-45wbo9o","Type":"NodeParagraph","Properties":{"id":"20240830101557-45wbo9o","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830101557-6hszzoc","Type":"NodeParagraph","Properties":{"id":"20240830101557-6hszzoc","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"甘苦，寒。"}]},{"ID":"20240830101557-icm81z5","Type":"NodeParagraph","Properties":{"id":"20240830101557-icm81z5","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性寒，味苦辛。\""}]},{"ID":"20240830101557-xgs8t9s","Type":"NodeParagraph","Properties":{"id":"20240830101557-xgs8t9s","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"②《本草求原》：\"甘淡，平。\""}]},{"ID":"20240830101557-39lm6qi","Type":"NodeParagraph","Properties":{"id":"20240830101557-39lm6qi","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"③《浙江民间草药》：\"性寒，味酸，有毒。\""}]},{"ID":"20240830101557-2lwmsue","Type":"NodeParagraph","Properties":{"id":"20240830101557-2lwmsue","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【归经】《四川中药志》：\"入脾，小肠、膀胱三经。\""}]},{"ID":"20240830101557-jtv7x9k","Type":"NodeParagraph","Properties":{"id":"20240830101557-jtv7x9k","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830101557-u01qfmb","Type":"NodeParagraph","Properties":{"id":"20240830101557-u01qfmb","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"清热，解毒，消肿，散结，利尿。治痈肿，瘰疬，疔疮，淋浊，带下，肺虚咳嗽，疝气，癫痫，小儿惊风，痔疮，跌打损伤。毒蛇咬伤。"}]},{"ID":"20240830101557-aznjqum","Type":"NodeParagraph","Properties":{"id":"20240830101557-aznjqum","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"散诸疮肿，攻痈疽，排脓定痛，治瘰疬，消散结核，治妇人奶结，乳汁不通，红肿疼痛，乳痈，乳岩坚硬如石，服之或散或溃。\""}]},{"ID":"20240830101557-laeblcm","Type":"NodeParagraph","Properties":{"id":"20240830101557-laeblcm","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"②《百草镜》：\"清热，治痈疽肿毒，疔疮，跌扑，疯犬伤，疝气，痔疮，劳伤。\""}]},{"ID":"20240830101557-wt4jzg6","Type":"NodeParagraph","Properties":{"id":"20240830101557-wt4jzg6","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"③《本草求原》：\"主内伤痰火，消瘰疬恶疮，浸酒佳。\""}]},{"ID":"20240830101557-noe3h8i","Type":"NodeParagraph","Properties":{"id":"20240830101557-noe3h8i","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"④《贵州民间方药集》：\"消炎，明目，去眼翳；又可驱风，表寒，治小儿惊风及母猪疯。\""}]},{"ID":"20240830101557-hosk6om","Type":"NodeParagraph","Properties":{"id":"20240830101557-hosk6om","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑤《贵阳民间药草》：\"清热解毒。治癫痫、蛇咬伤。\""}]},{"ID":"20240830101557-yybdxq2","Type":"NodeParagraph","Properties":{"id":"20240830101557-yybdxq2","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑥《四川中药志》：\"利水通淋，解毒。治尿酸结石，小便淋沥不清。\""}]},{"ID":"20240830101557-qg8wp7m","Type":"NodeParagraph","Properties":{"id":"20240830101557-qg8wp7m","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑦《贵州草药》：\"定惊，镇痛，平喘，解毒。\""}]},{"ID":"20240830101557-kltcq54","Type":"NodeParagraph","Properties":{"id":"20240830101557-kltcq54","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑧《陕西中草药》：\"治蛇、虫咬伤，跌打损伤，尿路结石，皮肤干燥。\""}]},{"ID":"20240830101557-wcmli13","Type":"NodeParagraph","Properties":{"id":"20240830101557-wcmli13","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；研末或浸酒。外用：捣敷或捣汁点眼。"}]},{"ID":"20240830101557-gjc7j4f","Type":"NodeParagraph","Properties":{"id":"20240830101557-gjc7j4f","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【注意】《四川中药志》：\"脾虚便溏和小便清利者忌用。\""}]},{"ID":"20240830101557-yd0r5fs","Type":"NodeParagraph","Properties":{"id":"20240830101557-yd0r5fs","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830101557-m51you0","Type":"NodeParagraph","Properties":{"id":"20240830101557-m51you0","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"①治痈疽肿毒：鲜天葵根适量，捣烂外敷。（《江西草药》）"}]},{"ID":"20240830101557-btaqla4","Type":"NodeParagraph","Properties":{"id":"20240830101557-btaqla4","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"②治疬瘁：紫背天葵子，每岁用一粒，同鲫鱼捣烂敷。（《医宗汇编》）"}]},{"ID":"20240830101557-nwboiyg","Type":"NodeParagraph","Properties":{"id":"20240830101557-nwboiyg","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"③治瘰疬、乳癌：天葵根五分，象贝二至三钱，煅牡蛎三至四钱，甘草一钱。同煎服数次。（《浙江民间草药》）"}]},{"ID":"20240830101557-n77bkky","Type":"NodeParagraph","Properties":{"id":"20240830101557-n77bkky","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"④治蛇咬伤：千年耗子屎二钱。捣烂敷，一日一换。"}]},{"ID":"20240830101557-hsyhbvl","Type":"NodeParagraph","Properties":{"id":"20240830101557-hsyhbvl","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑤治肺痨：千年耗子屎四两。放在一只大猪肚子内，煮烂去渣吃，连吃三只。"}]},{"ID":"20240830101557-82xmr4i","Type":"NodeParagraph","Properties":{"id":"20240830101557-82xmr4i","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑥治虚咳，化痰：千年耗子屎三钱。炖肉吃。"}]},{"ID":"20240830101557-4qgeppz","Type":"NodeParagraph","Properties":{"id":"20240830101557-4qgeppz","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑦治胃热气痛：千年耗子屎二钱。捣烂，开水吞服。"}]},{"ID":"20240830101557-wr3lxce","Type":"NodeParagraph","Properties":{"id":"20240830101557-wr3lxce","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑧治母猪疯、羊痫疯：千年耗子屎五至七颗（约一钱）。研成细末，发病前用烧酒吞服，连用三至五剂。（④方以下出（《贵阳民间药草》）"}]},{"ID":"20240830101557-0g0w0ew","Type":"NodeParagraph","Properties":{"id":"20240830101557-0g0w0ew","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑨治小儿盐吼（哮喘）：千年耗子屎一两，用盐水浸泡一夜，研末。每次服五分，姜开水吞服。"}]},{"ID":"20240830101557-kni4wlx","Type":"NodeParagraph","Properties":{"id":"20240830101557-kni4wlx","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑩治小儿惊风：千年耗子屎五分研末，开水吞服。"}]},{"ID":"20240830101557-52j8ziy","Type":"NodeParagraph","Properties":{"id":"20240830101557-52j8ziy","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑾治外痔：千年耗子屎适量，磨桐油搽患处。如有漏管，用五钱捣绒，外敷患处。"}]},{"ID":"20240830101557-ih12ga5","Type":"NodeParagraph","Properties":{"id":"20240830101557-ih12ga5","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⑿治骨折：千年耗子屎、桑白皮、水冬瓜皮、玉枇杷各一两，捣绒，正骨后包患处；再用本品一两，泡酒一斤，每次服药酒五钱。（⑨方以下出《贵州草药》）"}]},{"ID":"20240830101557-joftddq","Type":"NodeParagraph","Properties":{"id":"20240830101557-joftddq","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"⒀治眼翳：千年耗子屎根五个。捣取汁，合人乳点眼。（《贵阳民间药草》）。"}]},{"ID":"20240830101557-ltjdnoo","Type":"NodeParagraph","Properties":{"id":"20240830101557-ltjdnoo","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830101557-hrixpcm","Type":"NodeParagraph","Properties":{"id":"20240830101557-hrixpcm","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"①治疗小儿上呼吸道感染"}]},{"ID":"20240830101557-p7wfdi7","Type":"NodeParagraph","Properties":{"id":"20240830101557-p7wfdi7","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"用100％天葵子注射液2～4毫升肌注，每日1～2次。体温在39.5℃以上者，适当加用其它退热药物。治疗96例，痊愈84例，好转5例，无效7例。"}]},{"ID":"20240830101557-h9vdvwa","Type":"NodeParagraph","Properties":{"id":"20240830101557-h9vdvwa","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"②治疗痈肿"}]},{"ID":"20240830101557-8pyysmz","Type":"NodeParagraph","Properties":{"id":"20240830101557-8pyysmz","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"取天葵子适量，洗净捣碎，加入适量蜂蜜调成糊膏（宜现配现用）。先用温盐水冲洗患处，拭干后再敷上药膏。敷药范围应较炎症范围稍大，厚约1～2厘米。每日敷药2～3次，严重者夜间亦须敷药。一般经2～3次后局部疼痛大减，炎症局限化；2～3天后患者全身症状大减或消失。治疗5例痈肿，病灶范围约直径4～8匣米，经敷药14～34次，5～13天治愈。"}]},{"ID":"20240830101557-egprz0g","Type":"NodeParagraph","Properties":{"id":"20240830101557-egprz0g","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830101557-bxot26t","Type":"NodeParagraph","Properties":{"id":"20240830101557-bxot26t","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"天葵子《中华本草》"}]},{"ID":"20240830101557-twuawnu","Type":"NodeParagraph","Properties":{"id":"20240830101557-twuawnu","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【出处】出自《滇南本草》：紫背天葵草，形似蒲公荚，绿叶紫背。若服之汗出不止，不知人事，速用甘草解之。"}]},{"ID":"20240830101557-3wt2uij","Type":"NodeParagraph","Properties":{"id":"20240830101557-3wt2uij","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【拼音名】TiānKuíZǐ"}]},{"ID":"20240830101557-2ftqa71","Type":"NodeParagraph","Properties":{"id":"20240830101557-2ftqa71","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【英文名】rootofNakedcauleGroundsel"}]},{"ID":"20240830101557-hm25jn6","Type":"NodeParagraph","Properties":{"id":"20240830101557-hm25jn6","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【别名】紫背天葵草根"}]},{"ID":"20240830101557-rn3ar24","Type":"NodeParagraph","Properties":{"id":"20240830101557-rn3ar24","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830101557-ehk46nx","Type":"NodeParagraph","Properties":{"id":"20240830101557-ehk46nx","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"药材基源：为毛茛科植物天葵的块根。"}]},{"ID":"20240830101557-pjuemzq","Type":"NodeParagraph","Properties":{"id":"20240830101557-pjuemzq","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Semiaquilegiaadoxoides(DC.)Makino"}]},{"ID":"20240830101557-0rowk1j","Type":"NodeParagraph","Properties":{"id":"20240830101557-0rowk1j","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"采收和储藏：移栽后的第3年5月植株未完全枯萎前采挖，较小的块根留作种用，较大的去尽残叶，晒干，加以揉搓，去掉须根，抖净泥土。"}]},{"ID":"20240830101557-trel8lq","Type":"NodeParagraph","Properties":{"id":"20240830101557-trel8lq","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【原形态】天葵，多年生小草本，高10-30cm。块根长1-2cm，粗3-6mm，外皮棕黑色。茎直立，1-3条，上部有分枝，被稀疏白色柔毛。基生叶为三出复叶；叶柄长3-12cm，基部扩大呈鞘状；叶片轮廓卵圆形或肾形，长1.2-3cm；小叶扇状菱形或倒卵状菱形，长0.6-2.5cm，宽1-2.8cm，3深裂，深裂片又作2-3圆齿状缺刻裂，两面无毛，下面常带紫色；茎生叶较小，互生，叶柄较短。单歧或二岐聚伞花序，花梗长1-2.5cm，被白色细柔毛；苞片、小苞片状，3裂或不裂；花两性，小，直径4-6；萼片5，花瓣状，狭椭圆形，长4-6mm，宽1.2-2.5mm，白色，常带淡紫色，先端圆钝；花瓣5，匙形，长2.5-3.5mm，先端近截形，基部凸起呈囊状；雄蕊8-14，花丝下部变宽，花药宽椭圆形，黄色；退化雄蕊2，线状披针形，位于雄蕊内侧，白色膜质，与花丝近等长；心皮3-4，花柱短，先端向外反卷，无毛。蓇葖果3-4，长6-7mm，宽2mm，表面具横向脉纹，先端有小细喙。种子多数，卵状椭圆形，长约1mm，黑褐色，表面有小瘤状突起。花期3-4月，果期4-5月。"}]},{"ID":"20240830101557-61o8oek","Type":"NodeParagraph","Properties":{"id":"20240830101557-61o8oek","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830101557-upi9sr5","Type":"NodeParagraph","Properties":{"id":"20240830101557-upi9sr5","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"生态环境：生于疏林下、草丛、沟边路旁或山谷地较阴处。"}]},{"ID":"20240830101557-itwpqf0","Type":"NodeParagraph","Properties":{"id":"20240830101557-itwpqf0","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、江苏、安徽、浙江、江西、福建、湖北、湖南、广西、四川、贵州。"}]},{"ID":"20240830101557-xd5495j","Type":"NodeParagraph","Properties":{"id":"20240830101557-xd5495j","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830101557-gkdtlir","Type":"NodeParagraph","Properties":{"id":"20240830101557-gkdtlir","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"性状鉴别，埠根呈不规则短柱状、纺锤状或块状，略弯曲，有的有2-3短分叉，长1-3cm，直径0.5-1cm。表同暗褐色至灰黑色，具不规则的皱纹及须根或须根痕；顶端常有茎叶残基，外被数层黄褐色鞘状鳞片；中部通常较膨大。质较软，易折断，断面皮部类白色，木部黄白色或黄棕色，略显放射状纹理。气微，吵甘、微苦辛。"}]},{"ID":"20240830101557-ancfs9x","Type":"NodeParagraph","Properties":{"id":"20240830101557-ancfs9x","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"以个大，断面皮部色白者为佳。"}]},{"ID":"20240830101557-909ufl4","Type":"NodeParagraph","Properties":{"id":"20240830101557-909ufl4","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"显微临别，块根横切面：木栓层为多列细胞，含棕色物。皮层较窄。韧皮部较宽广，射线宽，筛管群明显。形成层成环。木质部射线宽至20余列细胞，导管束呈放射状排列，导管直径约至40μm，中央部位导管稀疏散在。有的中央为薄壁细胞。"}]},{"ID":"20240830101557-ykubyv0","Type":"NodeParagraph","Properties":{"id":"20240830101557-ykubyv0","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830101557-0si4d74","Type":"NodeParagraph","Properties":{"id":"20240830101557-0si4d74","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）本品断面置紫外光灯下(365nm)观察，显黄白色荧光，加酸或加碱后荧光不明显。"}]},{"ID":"20240830101557-ymvcxib","Type":"NodeParagraph","Properties":{"id":"20240830101557-ymvcxib","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，以70%乙醇10ml加热回流30min，滤过。滤液蒸干，残渣加盐酸溶液(1-10)5ml使溶液，滤过。滤液分置两支试管中一管中加碘化铋钾试液1-2滴，生成橘红色沉淀；另一管中加硅鸟酸试液1-2滴，生成黄色沉淀。"}]},{"ID":"20240830101557-9huyl2o","Type":"NodeParagraph","Properties":{"id":"20240830101557-9huyl2o","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；微苦；微辛；性寒；小毒"}]},{"ID":"20240830101557-fjw5bhx","Type":"NodeParagraph","Properties":{"id":"20240830101557-fjw5bhx","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾；膀胱经"}]},{"ID":"20240830101557-p7ol57k","Type":"NodeParagraph","Properties":{"id":"20240830101557-p7ol57k","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；消肿散结；利水通淋。主小儿热惊；癫痫；痈肿；疔疮；乳痈；瘰疬；皮肤痒疮；目赤肿痛；咽痛；蛇虫咬伤；热淋；砂淋"}]},{"ID":"20240830101557-yqy6mbt","Type":"NodeParagraph","Properties":{"id":"20240830101557-yqy6mbt","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；或研末，1.5-3g；或浸酒。外用：适量，捣敷或捣汁点眼。"}]},{"ID":"20240830101557-rfo9509","Type":"NodeParagraph","Properties":{"id":"20240830101557-rfo9509","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830101557-zp1ekex","Type":"NodeParagraph","Properties":{"id":"20240830101557-zp1ekex","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"1.《滇南本草》：敷大恶疮。"}]},{"ID":"20240830101557-3lhpdb7","Type":"NodeParagraph","Properties":{"id":"20240830101557-3lhpdb7","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"2.《云南中草药》：止血散瘀，生肌止痛。治内外伤出血，刀枪伤，烫伤。"}]},{"ID":"20240830101557-8mm6xh9","Type":"NodeParagraph","Properties":{"id":"20240830101557-8mm6xh9","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"3.《贵州药植目录》：发汗，止咳。"}]},{"ID":"20240830101557-qrdhbdx","Type":"NodeParagraph","Properties":{"id":"20240830101557-qrdhbdx","updated":"20240830101557"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830101523-vvgzdvd","Type":"NodeParagraph","Properties":{"id":"20240830101523-vvgzdvd","updated":"20240830101523"},"Children":[{"Type":"NodeText","Data":"【性味】甘、苦，寒。"}]},{"ID":"20240830101523-7w7422w","Type":"NodeParagraph","Properties":{"id":"20240830101523-7w7422w","updated":"20240830101523"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、胃经。"}]},{"ID":"20240830101523-r4zrm5o","Type":"NodeParagraph","Properties":{"id":"20240830101523-r4zrm5o","updated":"20240830101523"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，消肿散结。用于痈肿疔疮，乳痈，瘰疠，毒蛇咬伤。"}]},{"ID":"20240830094133-uf0lhfn","Type":"NodeThematicBreak","Properties":{"id":"20240830094133-uf0lhfn"}},{"ID":"20240830094134-8lit8xm","Type":"NodeParagraph","Properties":{"id":"20240830094134-8lit8xm"}}]}