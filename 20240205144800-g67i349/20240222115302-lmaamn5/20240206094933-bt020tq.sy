jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 680px;\" parent-style=\"width: 690px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715093706-7o1grd9","Type":"NodeParagraph","Properties":{"id":"20240715093706-7o1grd9","updated":"20240715093706"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雄树"}]},{"ID":"20240715093706-787enad","Type":"NodeParagraph","Properties":{"id":"20240715093706-787enad","updated":"20240715093706"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 856px;","style":"width: 846px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 7-20240715092002-f7pyvcr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 846px;\" parent-style=\"width: 856px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 326px;","style":"width: 316px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 10-20240715092843-p2jr20l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 316px;\" parent-style=\"width: 326px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715093706-bzdwv93","Type":"NodeParagraph","Properties":{"id":"20240715093706-bzdwv93","updated":"20240715093706"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 620px;","style":"width: 610px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 11-20240715092945-lsxwfsu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 610px;\" parent-style=\"width: 620px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 552px;","style":"width: 542px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 8-20240715092711-4hjqfa8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 542px;\" parent-style=\"width: 552px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715093706-pr1foj5","Type":"NodeParagraph","Properties":{"id":"20240715093706-pr1foj5","updated":"20240715093706"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雌树（只有雌性构树才会结果实）"}]},{"ID":"20240715093706-xpa7cfc","Type":"NodeParagraph","Properties":{"id":"20240715093706-xpa7cfc","updated":"20240715093706"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 586px;","style":"width: 576px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 1-20240715091036-p5z9ma9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 576px;\" parent-style=\"width: 586px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 603px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 9-20240715092751-d1pky2j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715093706-ia4lv4e","Type":"NodeParagraph","Properties":{"id":"20240715093706-ia4lv4e","updated":"20240715093706"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 12-20240715093137-vxi17wl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 580px;","style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 13-20240715093211-b4apxg8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\" parent-style=\"width: 580px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240715093735-rx50yrs","Type":"NodeParagraph","Properties":{"id":"20240715093735-rx50yrs","updated":"20240719171526"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为构树的果实；"}]},{"ID":"20240715093706-n5nidpp","Type":"NodeParagraph","Properties":{"id":"20240715093706-n5nidpp","updated":"20240715093706"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：构树分雌雄异株；雄树的花为柔荑花序，长至3-8cm，可作为一种难得的野菜食用，雌树的花为球形头状，顶端被毛，聚花果直径1.5-3cm，成熟时橙红色，肉质，有些人小时候常摘来吃，中药名叫禇实子；"}]},{"ID":"20240715093809-wlkc74f","Type":"NodeParagraph","Properties":{"id":"20240715093809-wlkc74f","updated":"20240715093814"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：同一株钩树的叶子有多种形态；"}]},{"ID":"20240715091703-vgt44rd","Type":"NodeThematicBreak","Properties":{"id":"20240715091703-vgt44rd"}},{"ID":"20240902142820-7cmncko","Type":"NodeParagraph","Properties":{"id":"20240902142820-7cmncko","updated":"20240902142826"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：楮实"}]},{"ID":"20240902142820-z807bc2","Type":"NodeParagraph","Properties":{"id":"20240902142820-z807bc2","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"楮实《*辞典》"}]},{"ID":"20240902142820-0cr3e7z","Type":"NodeParagraph","Properties":{"id":"20240902142820-0cr3e7z","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902142820-rtvhlyc","Type":"NodeParagraph","Properties":{"id":"20240902142820-rtvhlyc","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChǔShí"}]},{"ID":"20240902142820-cj4dyg4","Type":"NodeParagraph","Properties":{"id":"20240902142820-cj4dyg4","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【别名】谷实、谷子（《千金方》），楮实子（《素问病机保命集》），楮桃（《濒湖集简方》），角树子、野杨梅子（《江苏植药志》），构泡（《重庆草药》），谷木子、谷树子、谷树卵子（《上海常用中草药》）。"}]},{"ID":"20240902142820-fms3vms","Type":"NodeParagraph","Properties":{"id":"20240902142820-fms3vms","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【来源】为桑科植物构树的果实。8～10月间当果实成熟呈红色时打下，晒干，除去杂质。"}]},{"ID":"20240902142820-a1eocyw","Type":"NodeParagraph","Properties":{"id":"20240902142820-a1eocyw","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902142820-jb98621","Type":"NodeParagraph","Properties":{"id":"20240902142820-jb98621","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"构树，又名；谷（《诗经》），楮（《说文》），谷桑，楮桑（陆玑《诗疏》），构（《酉阳杂用力），斑谷（《本草图经》），楮桃树（《救荒本草》）。酱黄木（《岭南采药录》），谷浆树、奶树、当当树、柯树、谷沙树、沙纸木、造纸树、纱纸树、壳树。"}]},{"ID":"20240902142820-ez562k1","Type":"NodeParagraph","Properties":{"id":"20240902142820-ez562k1","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达10米。茎、叶具乳液；嫩枝被柔毛，后脱落，叶互生；叶片卵形，长8～18厘米，宽6～12厘米，不分裂或3～5深裂，先端尖，基部圆形或心脏形，有时不对称，边缘锯齿状，上面暗绿色，具粗糙伏毛，下面灰绿色，密生柔毛；叶柄长3～10厘米，具长柔毛；托叶膜质，早落。花单性，雌雄异株；雄花为腋生葇荑花序，下垂，长约5厘米，萼4裂，雄蕊4；雌花为球形头状花序，有多数棒状苞片，先端圆锥形，有毛，雌蕊散生于苞片间，花柱细长，丝状，紫色，子房筒状，为花萼所包被，呈扁圆形。聚花果肉质，成球形，直径约2厘米，橙红色。花期5月。果期9月。"}]},{"ID":"20240902142820-bmmkaxp","Type":"NodeParagraph","Properties":{"id":"20240902142820-bmmkaxp","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【生境分布】野生或栽培。全国大部分地区有分布。主产河南、湖北、湖南、山西、甘肃。此外，浙江、福建、安徽、四川、山东、江苏、江西、陕西、广西等地亦产。"}]},{"ID":"20240902142820-bu8kg6g","Type":"NodeParagraph","Properties":{"id":"20240902142820-bu8kg6g","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实呈卵圆形至宽卵形，顶端渐尖，长2～2.5毫米，直径1.5～2毫米。外表面黄红色至黄棕色，粗糙，具细皱纹。一侧具凹下的沟纹，另一侧显着隆起，呈脊纹状，基部具残留的果柄，剥落果皮后可见白色充满油脂的胚体。气弱，味淡而有油腻感，以色红、子老、无杂质者为佳。"}]},{"ID":"20240902142820-rirdt4h","Type":"NodeParagraph","Properties":{"id":"20240902142820-rirdt4h","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含皂甙（0.51％）、维生素B及油脂。种子含油31.7％，油中含非皂化物2.67％，饱和脂肪酸9.0％，油酸15.0％，亚油酸76.0％。"}]},{"ID":"20240902142820-3sp5yrs","Type":"NodeParagraph","Properties":{"id":"20240902142820-3sp5yrs","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【炮制】《雷公炮炙论》：\"凡使（楮实），采得后用水浸三日，将物搅旋，投水浮者去之，然后晒干，却用酒浸一伏时了，便蒸，从巳至亥，出，焙令干用。\""}]},{"ID":"20240902142820-t2utj7r","Type":"NodeParagraph","Properties":{"id":"20240902142820-t2utj7r","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902142820-rqb2cw0","Type":"NodeParagraph","Properties":{"id":"20240902142820-rqb2cw0","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"甘，寒。"}]},{"ID":"20240902142820-978vqxa","Type":"NodeParagraph","Properties":{"id":"20240902142820-978vqxa","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味甘，寒，无毒。\""}]},{"ID":"20240902142820-2afc8yh","Type":"NodeParagraph","Properties":{"id":"20240902142820-2afc8yh","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"甘，平。\""}]},{"ID":"20240902142820-6gz75s2","Type":"NodeParagraph","Properties":{"id":"20240902142820-6gz75s2","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902142820-t92yiv1","Type":"NodeParagraph","Properties":{"id":"20240902142820-t92yiv1","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"入肝，脾、肾经。"}]},{"ID":"20240902142820-6xbfjfr","Type":"NodeParagraph","Properties":{"id":"20240902142820-6xbfjfr","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肾经。\""}]},{"ID":"20240902142820-nyn7yd1","Type":"NodeParagraph","Properties":{"id":"20240902142820-nyn7yd1","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足太阴经。\""}]},{"ID":"20240902142820-r18gwuj","Type":"NodeParagraph","Properties":{"id":"20240902142820-r18gwuj","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入肾、肝二经。\""}]},{"ID":"20240902142820-0aaqgyx","Type":"NodeParagraph","Properties":{"id":"20240902142820-0aaqgyx","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902142820-0bkssfb","Type":"NodeParagraph","Properties":{"id":"20240902142820-0bkssfb","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"滋肾，清肝，明目。治虚劳，目昏，目翳，水气浮肿。"}]},{"ID":"20240902142820-040zo83","Type":"NodeParagraph","Properties":{"id":"20240902142820-040zo83","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主阴痿水肿，益气，充肌肤，明目。\""}]},{"ID":"20240902142820-wyxx7k9","Type":"NodeParagraph","Properties":{"id":"20240902142820-wyxx7k9","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"壮筋骨，助阳气，补虚劳，助腰膝，益颜色。\""}]},{"ID":"20240902142820-k93h0df","Type":"NodeParagraph","Properties":{"id":"20240902142820-k93h0df","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"健脾养肾，补虚劳，明目。\""}]},{"ID":"20240902142820-9aykeid","Type":"NodeParagraph","Properties":{"id":"20240902142820-9aykeid","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～3钱；或入丸、散。外用：捣敷。"}]},{"ID":"20240902142820-eeqcg0z","Type":"NodeParagraph","Properties":{"id":"20240902142820-eeqcg0z","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：\"脾胃虚寒者不宜。\""}]},{"ID":"20240902142820-h19ky0v","Type":"NodeParagraph","Properties":{"id":"20240902142820-h19ky0v","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902142820-6w2qnpd","Type":"NodeParagraph","Properties":{"id":"20240902142820-6w2qnpd","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"①治脾、肾、肝三脏阴虚，吐血咳血，骨蒸夜汗，口苦烦渴，梦中遗精；或大便虚燥，小便淋涩；或眼目昏花，风泪不止：楮实（赤者）一斗。取黑豆一斗，煮汁，去豆取汁，浸楮实子一日，晒干，再浸再晒，以豆汁渗尽为度，再晒燥。配枸杞子三升，俱炒微焦，研为细末，每早用白汤调服五钱。（《本草汇言》）"}]},{"ID":"20240902142820-ub0f5t2","Type":"NodeParagraph","Properties":{"id":"20240902142820-ub0f5t2","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"②治肝热生翳，气翳细点，亦治小儿翳眼：楮实子细研，蜜汤调下，食后服。（《仁斋直指方》楮实散）"}]},{"ID":"20240902142820-9rzot3i","Type":"NodeParagraph","Properties":{"id":"20240902142820-9rzot3i","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"③治水气臌胀，洁净府：楮实子一斗（水二斗熬成膏子），另白丁香一两半，茯苓三两（去皮），为细末，用楮实膏为丸，如桐子大。不计丸数，从少至多，服至小便清利及腹胀减为度。（《素问病机保命集》楮实子丸）"}]},{"ID":"20240902142820-42x1kzx","Type":"NodeParagraph","Properties":{"id":"20240902142820-42x1kzx","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"④治喉痹喉风：楮桃阴干，每用一个为末，井华水服之，重者两个。（《濒湖集简方》）"}]},{"ID":"20240902142820-hlao9ue","Type":"NodeParagraph","Properties":{"id":"20240902142820-hlao9ue","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"⑤治石疽，状如座疖而皮厚：捣穀子敷之。亦治金疮。（《千金方》）"}]},{"ID":"20240902142820-na0mte6","Type":"NodeParagraph","Properties":{"id":"20240902142820-na0mte6","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"⑥治目昏：荆芥穗、地骨皮、楮实各等分。上为细末，炼蜜为丸，桐子大。每服二十丸，米汤下。（《儒门事亲》）"}]},{"ID":"20240902142820-jd8d10z","Type":"NodeParagraph","Properties":{"id":"20240902142820-jd8d10z","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"⑦治耳鸣，眼雾：桑泡、薅秧泡、构泡，大乌泡、三月泡，泡酒服。（《重庆草药》五泡酒）"}]},{"ID":"20240902142820-qw4tagc","Type":"NodeParagraph","Properties":{"id":"20240902142820-qw4tagc","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902142820-crk4zkt","Type":"NodeParagraph","Properties":{"id":"20240902142820-crk4zkt","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"《别录》载楮实功用大补益，而《修真秘旨书》言，久服令人成骨软之痿，《济生秘览》治骨哽，用楮实煎汤服之，岂非软骨之征乎?\""}]},{"ID":"20240902142820-m86tw2a","Type":"NodeParagraph","Properties":{"id":"20240902142820-m86tw2a","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"②《药性通考》：\"楮实子，阴痿能强，水肿可退，充肌肤，助腰膝，益气力，补虚劳，悦颜色，壮筋骨，明目。久服滑肠。补阴妙品，益髓神膏。世人弃而不用者，因久服滑肠之语也，楮实滑肠者，因其润泽之故，非嫌其下行之速也，防其滑而以茯苓、薏仁、山药同施，何惧其滑乎?\""}]},{"ID":"20240902142820-m19widy","Type":"NodeParagraph","Properties":{"id":"20240902142820-m19widy","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"楮实，陶隐居、苏颂、抱朴子，皆甚言其功，而方书用之为补者，除杨氏还少丹而外，不多见。其他如《外台秘要》，用以敷治身面石疽，《机要》用以治水气臌胀，《集简》用以治喉风喉痹，《直指》用以治肝热生翳，无非凉泻软坚之义。则古本诸说，未可信也。\""}]},{"ID":"20240902142820-ettgvwa","Type":"NodeParagraph","Properties":{"id":"20240902142820-ettgvwa","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"楮实，书言味甘气寒，虽于诸脏阴血有补。得此颜色润，筋骨壮，腰膝健，肌肉充，水肿消，以致阴痿起，阳气助，是明指其阳旺阴弱，得此阴血有补，故能使阳不胜而助，非云阳痿由于阳衰，得此可以助阳也。若以纯阴之品可以补阳，则于理甚不合矣。配书又云，骨哽可用楮实煎汤以服，及纸烧灰存性调服，以治血崩血晕，脾胃虚人禁用，久服令人骨痿，岂非性属阴寒，虚则受其益，过则增其害之意乎。\""}]},{"ID":"20240902142820-y4c12pd","Type":"NodeParagraph","Properties":{"id":"20240902142820-y4c12pd","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902142820-m6tp418","Type":"NodeParagraph","Properties":{"id":"20240902142820-m6tp418","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"楮实《中华本草》"}]},{"ID":"20240902142820-yh6hhyu","Type":"NodeParagraph","Properties":{"id":"20240902142820-yh6hhyu","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【出处】出自《名医别录》"}]},{"ID":"20240902142820-ulbipv9","Type":"NodeParagraph","Properties":{"id":"20240902142820-ulbipv9","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChǔShí"}]},{"ID":"20240902142820-3uq4kg8","Type":"NodeParagraph","Properties":{"id":"20240902142820-3uq4kg8","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【别名】楮实子、角树子、野杨梅子、构泡"}]},{"ID":"20240902142820-udb4oxk","Type":"NodeParagraph","Properties":{"id":"20240902142820-udb4oxk","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902142820-7z9cr7k","Type":"NodeParagraph","Properties":{"id":"20240902142820-7z9cr7k","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"药材基源：为桑科植物构树的果实。"}]},{"ID":"20240902142820-65by531","Type":"NodeParagraph","Properties":{"id":"20240902142820-65by531","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Broussonetiapapyrifera(L.)Vent[MaruspapyriferaL.]"}]},{"ID":"20240902142820-89rzw84","Type":"NodeParagraph","Properties":{"id":"20240902142820-89rzw84","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"采收和储藏：移栽4-5年，9月果实变戏时采摘，除去灰白色膜状宿萼及杂质，晒干。"}]},{"ID":"20240902142820-e87te6x","Type":"NodeParagraph","Properties":{"id":"20240902142820-e87te6x","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶乔木，高达14-16m。有乳汁。小枝粗壮，密生绒毛。单叶互生；叶柄长1.5-10cm，密被柔毛；叶片膜质或纸质，阔卵形至长圆状卵形，长5.5-15（-20）cm，宽4-10（-15）cm，不分裂或3-5裂，尤以幼枝或小树叶较明显，先端渐尖，基部圆形或浅心形，略偏斜，边缘有细锯齿或粗锯齿，上面深绿色，被粗伏毛，下面灰绿色，密被柔毛。花单性，雌雄异株；雄花序为葇荑花序，直径l-1.5cm，总花梗长l-1.5cm；雄花具短柄，有2-3小苞片，花被4裂，基部合生，雄蕊4；雌花苞片棒状，被毛，花被管状，雌蕊散生于苞片间，花柱细长，线形，被短毛，具粘性。聚花果肉质，呈球形，直径约2cm，成熟时橙红色。花期4-7月，果期7-9月。"}]},{"ID":"20240902142820-rnaqv1x","Type":"NodeParagraph","Properties":{"id":"20240902142820-rnaqv1x","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902142820-cerr66y","Type":"NodeParagraph","Properties":{"id":"20240902142820-cerr66y","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡林缘或村寨道旁。"}]},{"ID":"20240902142820-oo9gxn6","Type":"NodeParagraph","Properties":{"id":"20240902142820-oo9gxn6","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、华南、西南及河北、山西、陕西、甘肃、湖北、湖南等地。"}]},{"ID":"20240902142820-04waywn","Type":"NodeParagraph","Properties":{"id":"20240902142820-04waywn","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902142820-v0k8pgq","Type":"NodeParagraph","Properties":{"id":"20240902142820-v0k8pgq","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，适应性较强，耐干旱，耐湿热。对土壤的选择不严，以向阳、土层深厚、疏松肥沃的土壤栽培大宜。"}]},{"ID":"20240902142820-orsbzhh","Type":"NodeParagraph","Properties":{"id":"20240902142820-orsbzhh","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"栽培技术用分根繁殖，亦可用分蘖、压条繁殖。分根繁殖：一般在冬季落叶后，选结果母枝，在其四周．挖掘根部，剪取15-20cm长的根段栽种。培育1～2年后移栽。苗高60-100cm时，选早春萌芽或冬季落叶后，按行株距5m×5m。开穴，穴底要平，施腐熟厩肥，再覆土一层，每穴栽l株，填土压实，浇水。因雌雄异株，以栽培雌株为主，适当栽植雄株、以便授粉幼苗期4月、7月进行松土除草，施追肥。"}]},{"ID":"20240902142820-v3t62wd","Type":"NodeParagraph","Properties":{"id":"20240902142820-v3t62wd","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902142820-tjh34wg","Type":"NodeParagraph","Properties":{"id":"20240902142820-tjh34wg","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"性状鉴别果实呈扁圆形或卵圆形，长1．5-3mm，直径约1．5mm厚至lmm。表面红棕色，有网状皱纹或疣状突起。一侧有棱．一侧略平或有凹槽，有的具于房柄。果皮坚脆，易压碎，膜质种皮紧贴于果皮内面，胚乳类白色，富油性。气微，味淡。"}]},{"ID":"20240902142820-monwngq","Type":"NodeParagraph","Properties":{"id":"20240902142820-monwngq","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"以色红、饱满者为佳。"}]},{"ID":"20240902142820-kgb88my","Type":"NodeParagraph","Properties":{"id":"20240902142820-kgb88my","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：红棕色。①果皮栅状细胞多数个相连，壁粘液化，常与含晶厚壁细胞相连。断在观呈圆柱形，长（径向）40-132μm，宽（切向）12-26μm，细胞壁有纵向细条纹增厚增厚部分的边缘呈细齿状。底面观呈多角形，条纹状增厚壁的基部呈圆点状。②内果皮厚壁细胞黄棕色或淡黄色。断面观细胞极扁薄，上、下多层重叠，界线不清楚；表面观细胞扁平，多角形，直径24-74pm，有不规则波状分枝，壁极厚，木化，具点状纹孔，胞腔不明显。③种皮表皮细胞近无色，表面观呈多角形，直径11-18μm，垂周壁厚约2μm，呈念珠状，或孔沟细密，非木化，胞腔内含黄棕色物质。④含晶厚壁细胞棕黄色，成片或数个相连。断面观呈类长方形，直径10-25pm，壁厚，木化，胞腔内含矩圆形草酸钙簇晶；表面观呈多角形，壁厚。⑤小形厚壁细胞类圆形或多角形，直径8-21μm，壁厚4-8μm，孔沟稀少。⑥草酸钙簇晶呈椭圆形、矩圆形或类圆形，直径7-26μm,长至35μm,先端平钝，棱角小，存在于厚壁细胞中或散在。"}]},{"ID":"20240902142820-ul8jm0v","Type":"NodeParagraph","Properties":{"id":"20240902142820-ul8jm0v","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含皂甙(0.51%)、维生素B及油脂。种子含油31.7%，油中含非皂化物2.67%，饱和脂肪酸9.0%，油酸15.0%，亚油酸76.0%。"}]},{"ID":"20240902142820-vxnsi9j","Type":"NodeParagraph","Properties":{"id":"20240902142820-vxnsi9j","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【炮制】《雷公炮炙论》：凡使(楮实)，采得后用水浸三日，将物搅旋，投水浮者去，然后晒干，却用酒浸一伏时了，便蒸，从巳至亥，出，焙令干用。"}]},{"ID":"20240902142820-a71c3nq","Type":"NodeParagraph","Properties":{"id":"20240902142820-a71c3nq","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【性味】甘；性寒"}]},{"ID":"20240902142820-r8i6lpj","Type":"NodeParagraph","Properties":{"id":"20240902142820-r8i6lpj","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾；脾经"}]},{"ID":"20240902142820-r8kucnj","Type":"NodeParagraph","Properties":{"id":"20240902142820-r8kucnj","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【功能主治】滋肾；清肝明目；健脾利水。主肾；虚腰膝酸软；阳痿；止昏；目翳；水肿；尿水"}]},{"ID":"20240902142820-pjor3zi","Type":"NodeParagraph","Properties":{"id":"20240902142820-pjor3zi","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-10g；或入丸、散。外用：适量，捣敷。"}]},{"ID":"20240902142820-jsq99fj","Type":"NodeParagraph","Properties":{"id":"20240902142820-jsq99fj","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：脾胃虚寒者不宜。"}]},{"ID":"20240902142820-64zrti1","Type":"NodeParagraph","Properties":{"id":"20240902142820-64zrti1","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【附方】①治脾、肾、肝三服阴虚，吐血咳血，骨蒸夜汗，口苦烦渴，梦中遗精；或大便虚燥，小便淋涩；或眼目昏花，风泪不止：楮实(赤者)一斗。取黑豆一斗，煮汁，去豆取汁，浸楮实子一日，晒干，再浸再晒，以豆汁渗尽为度，再晒燥。配枸杞子三升，俱炒微焦，研为细末，每早用白汤调服五钱。(《本草汇言》)②治肝热生翳，气翳细点，亦治小儿翳眼：楮实子细研，蜜汤调下，食后服。(《仁斋直指方》楮实散)③治水气膨胀，洁净府：楮实子一斗(水二斗熬成膏子)，另白丁香一两半，茯苓三两(去皮)，为细末，用楮实膏为丸，如桐子大。不计丸数，从少至多，服至小便清利及腹胀减为度。(《素问病机保命集》楮实子丸)④治喉痹喉风：楮桃阴干，每用一个为末，井华水服之，重者两个。(《濒湖集简方》)⑤治石疽，状如座疖而皮厚：捣彀子敷之。亦治金疮。(《干金方》)⑥治目昏：荆芥穗、地骨皮、楮实各等分。上为细末，炼蜜为丸，桐子大。每服二十丸，米汤下。(《儒门事亲》)⑦治耳鸣，眼雾：桑泡、薅秧泡、构泡、大乌泡、三月泡，泡酒服。(《重庆草药》五泡酒)"}]},{"ID":"20240902142820-i6x4hqb","Type":"NodeParagraph","Properties":{"id":"20240902142820-i6x4hqb","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902142820-r9lx1fn","Type":"NodeParagraph","Properties":{"id":"20240902142820-r9lx1fn","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：《别录》载楮实功用大补益，而《修真秘旨书》言，久服令人成骨软之痿，《济生秘览》治骨哽，用楮实煎汤服之，岂非软骨之征乎?2.《药性通考》：楮实子，阴痿能强，水肿可退，充肌肤，助腰膝；益气力，补虚劳，悦颜色，壮筋骨，明目。久服滑肠。补阴妙品，益髓神膏。世人弃而不用者，因久服滑肠之语也，楮实滑肠者，因其润泽之故，非嫌其下行之速也，防其滑而以茯苓、薏仁、山药同施，何惧其滑乎?3.《本草从新》：楮实，陶隐居、苏颂、抱朴子，皆甚言其功，而方书用之为补者，除杨氏还少丹而外，不多见。其他如《外台秘要》，用以敷治身面石疽，《机要》用以治水气臌胀，《集简》用以治喉风喉痹，《直指》用以治肝热生翳，无非凉泻软坚之义。则古本诸说，未可信也。"}]},{"ID":"20240902142820-ehgwyk4","Type":"NodeParagraph","Properties":{"id":"20240902142820-ehgwyk4","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：楮实，书言味甘气寒，虽于诸脏阴血有补，得此颜色润，筋骨壮，腰膝健，肌肉充，水肿消，以致阴痿起，阳气助，是阴指其阳旺阴弱，得此阴血有补，故能使阳不胜而助，非云阳痿由于阳衰，得此可以助阳也。若以纯阴之品可以补阳，则于理甚不合矣。况书又云，骨哽可用楮实煎汤以服，及纸烧灰存性调服，以治血崩血晕，脾胃虚人禁用，久服令人骨痿，岂非性届阴寒，虚则受其益，过则增其害之意乎。"}]},{"ID":"20240902142820-2ws9csy","Type":"NodeParagraph","Properties":{"id":"20240902142820-2ws9csy","updated":"20240902142826"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902142821-zty8md3","Type":"NodeThematicBreak","Properties":{"id":"20240902142821-zty8md3","updated":"20240902142826"}},{"ID":"20240902142822-164zz39","Type":"NodeParagraph","Properties":{"id":"20240902142822-164zz39","updated":"20240902142826"}}]}