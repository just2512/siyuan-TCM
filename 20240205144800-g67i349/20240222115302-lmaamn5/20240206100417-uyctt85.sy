3145511-wqzv8ul.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 638px;\" parent-style=\"width: 648px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 580px;","style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦巴 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦巴 7-20240723143620-dlxguct.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\" parent-style=\"width: 580px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723143620-4nq6o3g","Type":"NodeParagraph","Properties":{"id":"20240723143620-4nq6o3g","updated":"20240723145200"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦巴 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦巴 8-20240723144842-w8s5njg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦巴 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦巴 9-20240723145200-w1dvqk3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240723143617-135nxqv","Type":"NodeThematicBreak","Properties":{"id":"20240723143617-135nxqv"}},{"ID":"20240723143618-lxlj9pn","Type":"NodeParagraph","Properties":{"id":"20240723143618-lxlj9pn","updated":"20240902155628"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葫芦巴"}]},{"ID":"20240902155628-m410k5u","Type":"NodeParagraph","Properties":{"id":"20240902155628-m410k5u","updated":"20240902155655"},"Children":[{"Type":"NodeText","Data":"性味：味苦，性温。"}]},{"ID":"20240902155643-f1gzp16","Type":"NodeParagraph","Properties":{"id":"20240902155643-f1gzp16","updated":"20240902155649"},"Children":[{"Type":"NodeText","Data":"归经：归肾经。"}]},{"ID":"20240902155657-k4i8p1n","Type":"NodeParagraph","Properties":{"id":"20240902155657-k4i8p1n","updated":"20240902155703"},"Children":[{"Type":"NodeText","Data":"功效：温肾助阳，祛寒止痛。"}]},{"ID":"20240902155704-pi4j8jy","Type":"NodeParagraph","Properties":{"id":"20240902155704-pi4j8jy","updated":"20240902155712"},"Children":[{"Type":"NodeText","Data":"主治：用于肾阳不足，下元虚冷，小腹冷痛，寒疝腹痛，寒湿脚气。"}]},{"ID":"20240902155716-ztwqvam","Type":"NodeParagraph","Properties":{"id":"20240902155716-ztwqvam","updated":"20240902155719"},"Children":[{"Type":"NodeText","Data":"相关配伍："}]},{"ID":"20240902155720-caeuwtj","Type":"NodeParagraph","Properties":{"id":"20240902155720-caeuwtj","updated":"20240902155726"},"Children":[{"Type":"NodeText","Data":"1、治小肠气攻刺：葫芦巴（炒）一两。为末，每服二钱，茴香炒紫，用热酒沃，盖定，取酒调下。(《仁斋直指方》葫芦巴散)\n2、膀胱气：葫芦巴、茴香子、桃仁（麸炒）各等分。半以酒糊丸，半为散。每服五、七十丸，空心食前盐酒下；散以热米饮谓下，与丸于相间，空心服，日各一、二服。（《本草衍义》）\n3、大人小儿小肠气，蟠肠气，奔豚气，疝气，偏坠阴肿，小腹有形如卵，上下来去痛不可忍，或绞结绕脐攻刺，呕恶闷乱，并皆治之：葫芦巴（炒）一斤，吴茱萸（汤洗十次，炒）一斤，川楝子（炒）十二两，大巴戟（去心，炒）、川乌（炮，去皮、脐）各一两，茴香（淘去土，炒）十二两。上为细末，酒煮面糊为丸，如梧桐子大。每服十五丸，空心温酒吞下；小儿五丸，茴香汤下。（《太平惠民和剂局方》葫芦巴丸）\n4、肾脏虚冷腹胁，胀满：葫芦巴二两，附子（炮裂，去皮、脐）、硫黄（研）各三分。上三味，捣研为末，酒煮面糊为丸如梧桐子大。每服二十至三十丸，盐汤下。（《圣济总录》葫芦巴丸）\n5、一切寒湿脚气，腿膝疼痛，步行无力：葫芦巴四两（浸一宿），破故纸四两（炒香）。上为细末，用大木瓜一枚，切顶去穰，填药在内，以满为度，复用顶盖之，用竹签签定，蒸熟取出，烂研，用前件填不尽药末，搜和为丸，如梧桐子大。每服五十丸，温酒送下，空心食前。（《杨氏家藏方》葫芦巴丸）"}]},{"ID":"20240902155629-qeg6rod","Type":"NodeThematicBreak","Properties":{"id":"20240902155629-qeg6rod"}},{"ID":"20240902155629-ir2wj52","Type":"NodeParagraph","Properties":{"id":"20240902155629-ir2wj52"}}]}