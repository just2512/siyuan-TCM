{"ID":"20240206100417-uyctt85","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240206100417-uyctt85","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206100417-uyctt85\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206100428-7eugpjr\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240206100421-jfsk5l1\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206100428-7eugpjr\u0026quot;,\u0026quot;focusStart\u0026quot;:99,\u0026quot;focusEnd\u0026quot;:99\u0026#125;","title":"胡芦巴（胡卢巴、葫芦巴）","type":"doc","updated":"20240902155726"},"Children":[{"ID":"20240206100428-7eugpjr","Type":"NodeParagraph","Properties":{"id":"20240206100428-7eugpjr","updated":"20240206100434"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产四川、安徽、河南等地。\n【性状】\t种子略呈斜方形或菱形，长35mm，宽23mm，厚约2mm。表面黄棕色或红棕色，微有灰色短毛，两侧各有一深斜沟，两沟相接处为种脐。质坚硬。气香，味微苦。\n【性味】\t苦，温。\n【功效】\t补肾阳，祛寒湿。治寒疝，腹胁胀满，寒湿脚气，肾虚腰酸，阳痿"}]},{"ID":"20240206100421-jfsk5l1","Type":"NodeParagraph","Properties":{"id":"20240206100421-jfsk5l1","updated":"20240206100421"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206100420-b845whd.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723143400-k6p8gng","Type":"NodeParagraph","Properties":{"id":"20240723143400-k6p8gng","updated":"20240723143539"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 650px;","style":"width: 640px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦巴 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦巴 6-20240723143400-xk29a3v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style