e":"NodeText","Data":"​"}]},{"ID":"20240727130156-2hyow1z","Type":"NodeParagraph","Properties":{"id":"20240727130156-2hyow1z","updated":"20240727130156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 643px;","style":"width: 633px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"路路通"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/路路通-20240727130033-ssn346t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 578px;","style":"width: 568px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"路路通 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/路路通 1-20240727130125-hg6om8t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 568px;\" parent-style=\"width: 578px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727130156-2tn97u8","Type":"NodeParagraph","Properties":{"id":"20240727130156-2tn97u8","updated":"20240727130156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香树 1-20240715101621-fbkghk0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 595px;","style":"width: 585px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香树 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香树 2-20240715101701-clfbpiq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727130158-fm05yos","Type":"NodeParagraph","Properties":{"id":"20240727130158-fm05yos","updated":"20240727130300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为枫香树的干燥成熟果序（很多果实聚合在一起称之为果序）；"}]},{"ID":"20240727130158-gfwvwtm","Type":"NodeThematicBreak","Properties":{"id":"20240727130158-gfwvwtm"}},{"ID":"20240902175053-pt381bm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20240902175053-pt381bm","updated":"20240902175101"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：路路通"}]},{"ID":"20240902175053-awxr8ar","Type":"NodeParagraph","Properties":{"id":"20240902175053-awxr8ar","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"路路通《中国药典》"}]},{"ID":"20240902175053-l290das","Type":"NodeParagraph","Properties":{"id":"20240902175053-l290das","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【拼音名】LùLùTōnɡ"}]},{"ID":"20240902175053-wykgl82","Type":"NodeParagraph","Properties":{"id":"20240902175053-wykgl82","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSLIQUIDAMBARIS"}]},{"ID":"20240902175053-if0k23e","Type":"NodeParagraph","Properties":{"id":"20240902175053-if0k23e","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【别名】九孔子"}]},{"ID":"20240902175053-s6517ta","Type":"NodeParagraph","Properties":{"id":"20240902175053-s6517ta","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【来源】本品为金缕梅科植物枫香树LiquidambarformosanaHance的干燥成熟果序。冬季果实成熟后采收，除去杂质，干燥。"}]},{"ID":"20240902175053-c9bjh1b","Type":"NodeParagraph","Properties":{"id":"20240902175053-c9bjh1b","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性状】本品为聚花果，由多数小蒴果集合而成，呈球形，直径2～3cm。基部有总果梗。表面灰棕色或棕褐色，有多数尖刺及喙状小钝刺，长0.5～1mm，常折断，小蒴果顶部开裂，呈蜂窝状小孔。体轻，质硬，不易破开。气微，味淡。"}]},{"ID":"20240902175053-a17w2zm","Type":"NodeParagraph","Properties":{"id":"20240902175053-a17w2zm","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性味】苦，平。"}]},{"ID":"20240902175053-9umrzzj","Type":"NodeParagraph","Properties":{"id":"20240902175053-9umrzzj","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾经。"}]},{"ID":"20240902175053-nq171w7","Type":"NodeParagraph","Properties":{"id":"20240902175053-nq171w7","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风活络，利水通经。用于关节痹痛，麻木拘挛，水肿胀满，乳少经闭。"}]},{"ID":"20240902175053-qix8sei","Type":"NodeParagraph","Properties":{"id":"20240902175053-qix8sei","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【用法用量】5～9g。"}]},{"ID":"20240902175053-bb8xayn","Type":"NodeParagraph","Properties":{"id":"20240902175053-bb8xayn","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902175053-vwgzi5o","Type":"NodeParagraph","Properties":{"id":"20240902175053-vwgzi5o","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902175053-tihmqc3","Type":"NodeParagraph","Properties":{"id":"20240902175053-tihmqc3","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"路路通《*辞典》"}]},{"ID":"20240902175053-0wzm3jp","Type":"NodeParagraph","Properties":{"id":"20240902175053-0wzm3jp","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目拾遗》"}]},{"ID":"20240902175053-odzhgdx","Type":"NodeParagraph","Properties":{"id":"20240902175053-odzhgdx","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【拼音名】LùLùTōnɡ"}]},{"ID":"20240902175053-opslndo","Type":"NodeParagraph","Properties":{"id":"20240902175053-opslndo","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【别名】枫实（《南方草木状》），枫木上球（《德胜堂经验方》），枫香果（《槐西杂志》），枫果、聂子（《纲目拾遗》），狼目（《药材资料汇编》），枫球子（《中药志》），狼眼（《中药材手册》），枫树球（《药材学》），九空子（《江苏植药志》）。"}]},{"ID":"20240902175053-f2ky979","Type":"NodeParagraph","Properties":{"id":"20240902175053-f2ky979","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【来源】为金缕梅科植物枫香的果实。冬季采摘，除去杂质，洗净晒干。"}]},{"ID":"20240902175053-bv4yo9b","Type":"NodeParagraph","Properties":{"id":"20240902175053-bv4yo9b","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902175053-mrj2mjw","Type":"NodeParagraph","Properties":{"id":"20240902175053-mrj2mjw","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"枫香（《本草经集注》），又名：聂聂（《尔雅》），枫木（《说文》），枫树（《尔雅》郭虞注），香枫，枫宸（《纲目》），枫仔树（《植物名汇》），三角枫，三角尖（《岭南采药录》），鸡枫树、鸡爪枫、大叶枫、槟树、槟臭。"}]},{"ID":"20240902175053-sap8g82","Type":"NodeParagraph","Properties":{"id":"20240902175053-sap8g82","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高20～40米；树皮幼时灰白，平滑。老时褐色、粗糙。叶互生；叶柄长3～7厘米；托叶线形，早落；叶片心形，常3裂，幼时及萌发枝上的叶多为掌状5裂，长6～12厘米，宽8～15厘米，裂片卵状三角形或卵形，先端长渐尖，基部心形或截形，边缘有细锯齿。花单性，雌雄同株，无花被；雄花淡黄绿色，成总状花序，有锈色细长毛，雄蕊多数，密生成球形；雌花成圆球形的头状花序，被毛，有少数退化雄蕊，子房半下位，多数愈合；四周有许多钻形小苞片围绕，2室，花柱2，柱头弯曲。复果圆球形，下垂，直径2.5～3厘米，表面有刺，蒴果多数，密集复果之内，长椭圆形，成熟时顶孔开裂。种子多数，细小，扁平，棱上有时略有翅。花期3～4月。果期9～10月。"}]},{"ID":"20240902175053-h6hqc0c","Type":"NodeParagraph","Properties":{"id":"20240902175053-h6hqc0c","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于湿润及土壤肥沃的地方。分布陕西、河南、湖北、安徽、江苏、浙江、福建、台湾、广西、广东、江西、湖南、四川、云南、贵州、青海、西藏等地。主产江苏、浙江、江西、福建、广东等地。此外，湖北、河南、贵州等地亦产。"}]},{"ID":"20240902175053-bi0ota2","Type":"NodeParagraph","Properties":{"id":"20240902175053-bi0ota2","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性状】干燥复果呈圆球形，直径2～3厘米。表面灰棕色或暗棕色，上有多数鸟嘴状针刺，长约5～8毫米，常折断；苞片卷成筒状，有时裂开，内藏多数小蒴果。复果基部残留果柄，有时折断。蒴果细小，直径1～2毫米，顶端有一裂孔，内有种子2枚。种子淡褐色，有光泽。气特异，味淡。以色黄、个大者为佳。"}]},{"ID":"20240902175053-lrzn0rp","Type":"NodeParagraph","Properties":{"id":"20240902175053-lrzn0rp","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【药理作用】实验证明，枫香酒精溶剂（60％）外用，能防止钩蚴侵入小鼠皮肤。其防护效力与溶剂浓度成正比。"}]},{"ID":"20240902175053-nyhlra3","Type":"NodeParagraph","Properties":{"id":"20240902175053-nyhlra3","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902175053-xvqgltx","Type":"NodeParagraph","Properties":{"id":"20240902175053-xvqgltx","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"苦，平。"}]},{"ID":"20240902175053-77zh044","Type":"NodeParagraph","Properties":{"id":"20240902175053-77zh044","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"①《现代实用中药》：\"味苦涩，性平，无毒。\""}]},{"ID":"20240902175053-5bisxd7","Type":"NodeParagraph","Properties":{"id":"20240902175053-5bisxd7","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"②《浙江民间草药》：\"性平，味淡，无毒。\""}]},{"ID":"20240902175053-gzpwdfk","Type":"NodeParagraph","Properties":{"id":"20240902175053-gzpwdfk","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"③《泉州本草》：\"辛苦，性平，无毒。\""}]},{"ID":"20240902175053-dixnjij","Type":"NodeParagraph","Properties":{"id":"20240902175053-dixnjij","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【归经】《纲目拾遗》：\"通行十二经。\""}]},{"ID":"20240902175053-hau1f7k","Type":"NodeParagraph","Properties":{"id":"20240902175053-hau1f7k","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902175053-3qok725","Type":"NodeParagraph","Properties":{"id":"20240902175053-3qok725","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"祛风通络，利水除湿。治肢体痹痛，手足拘挛，胃痛，水肿，胀满，经闭，乳少，痈疽，痔漏，疥癣，湿疹。"}]},{"ID":"20240902175053-kk0wxby","Type":"NodeParagraph","Properties":{"id":"20240902175053-kk0wxby","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"①《纲目拾遗》：\"辟瘴却瘟，明目，除湿，舒筋络拘挛，周身痹痛，手脚及腰痛，焚之嗅其烟气皆愈。\""}]},{"ID":"20240902175053-4i7wzlh","Type":"NodeParagraph","Properties":{"id":"20240902175053-4i7wzlh","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"②《岭南采药录》：\"治风湿流注疼痛及痈疽肿毒。\""}]},{"ID":"20240902175053-xr5b3ou","Type":"NodeParagraph","Properties":{"id":"20240902175053-xr5b3ou","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"③《现代实用中药》：\"烧灰外用于皮肤湿癣、痔漏等，有收敛、消炎、消毒作用。\""}]},{"ID":"20240902175053-c1ousfd","Type":"NodeParagraph","Properties":{"id":"20240902175053-c1ousfd","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"④《中药志》：\"通经利水，除湿热痹痛。治月经不调，周身痹痛，小便不利，水肿胀满等证。\""}]},{"ID":"20240902175053-poqaze4","Type":"NodeParagraph","Properties":{"id":"20240902175053-poqaze4","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"⑤广州部队《常用中草药手册》：\"祛风除湿，行气活血。治风湿性腰痛，心胃气痛，少乳，湿疹，皮炎。\""}]},{"ID":"20240902175053-wd9u65x","Type":"NodeParagraph","Properties":{"id":"20240902175053-wd9u65x","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；或煅存性研末。外用：煅存性研末调敷或烧烟闻嗅。"}]},{"ID":"20240902175053-9dy9g30","Type":"NodeParagraph","Properties":{"id":"20240902175053-9dy9g30","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902175053-2scbr3s","Type":"NodeParagraph","Properties":{"id":"20240902175053-2scbr3s","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"孕妇忌服。"}]},{"ID":"20240902175053-tj2av55","Type":"NodeParagraph","Properties":{"id":"20240902175053-tj2av55","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"①《中药志》：\"阴虚内热者不宜。\""}]},{"ID":"20240902175053-pwxqw1f","Type":"NodeParagraph","Properties":{"id":"20240902175053-pwxqw1f","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"②《广西中药志》：\"虚寒血崩者勿服。\""}]},{"ID":"20240902175053-nuc1qqv","Type":"NodeParagraph","Properties":{"id":"20240902175053-nuc1qqv","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"凡经水过多及孕妇忌用。\""}]},{"ID":"20240902175053-5m056cs","Type":"NodeParagraph","Properties":{"id":"20240902175053-5m056cs","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902175053-4rfxiu5","Type":"NodeParagraph","Properties":{"id":"20240902175053-4rfxiu5","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"①治风湿肢节痛：路路通、秦艽、桑枝、海风藤、橘络、苡仁。水煎服。（《四川中药志》）"}]},{"ID":"20240902175053-jg0tx4q","Type":"NodeParagraph","Properties":{"id":"20240902175053-jg0tx4q","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"②治脏毒：路路通一个。煅存性，研末酒煎服。（《古今良方》）"}]},{"ID":"20240902175053-6kgb2uq","Type":"NodeParagraph","Properties":{"id":"20240902175053-6kgb2uq","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"③治癣：枫木上球十个（烧存性），白砒五厘。共末，香油搽。（《德胜堂经验方》）"}]},{"ID":"20240902175053-39pldto","Type":"NodeParagraph","Properties":{"id":"20240902175053-39pldto","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"④治荨麻疹：枫球一斤。煎浓汁，每天三次，每次六钱，空心服。（《湖南药物志》）"}]},{"ID":"20240902175053-wwpgxr7","Type":"NodeParagraph","Properties":{"id":"20240902175053-wwpgxr7","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"⑤治耳内流黄水：路路通五钱。煎服。（《浙江民间草药》）"}]},{"ID":"20240902175053-vqfp4ea","Type":"NodeParagraph","Properties":{"id":"20240902175053-vqfp4ea","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【各家论述】《纲目拾遗》：\"枫果去外刺皮，内圆如蜂窝，即路路通。其性大能通行十二经穴，故《救生苦海》治水肿胀用之，以其能搜逐伏水也。\""}]},{"ID":"20240902175053-rhjvgi7","Type":"NodeParagraph","Properties":{"id":"20240902175053-rhjvgi7","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902175053-vzwsssp","Type":"NodeParagraph","Properties":{"id":"20240902175053-vzwsssp","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"路路通《中华本草》"}]},{"ID":"20240902175053-f8rti9r","Type":"NodeParagraph","Properties":{"id":"20240902175053-f8rti9r","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902175053-ztrcfpc","Type":"NodeParagraph","Properties":{"id":"20240902175053-ztrcfpc","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"出自1.《南方草木状》：枫香，树似白杨，叶圆而歧分；有脂而香，其大如鸭卵；二月花发，乃着实，八、九月熟，曝干可烧。惟九真郡有之。"}]},{"ID":"20240902175053-gy5ufew","Type":"NodeParagraph","Properties":{"id":"20240902175053-gy5ufew","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"2.《唐本草〉：枫香，所在大山皆有。树高大，叶三角。五月树为坎，十一月采脂。"}]},{"ID":"20240902175053-86fiwpj","Type":"NodeParagraph","Properties":{"id":"20240902175053-86fiwpj","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【拼音名】LùLùTōnɡ"}]},{"ID":"20240902175053-3d8pers","Type":"NodeParagraph","Properties":{"id":"20240902175053-3d8pers","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【英文名】BeartifulSweetgumFruit,TaiwanSweetgum"}]},{"ID":"20240902175053-18854r4","Type":"NodeParagraph","Properties":{"id":"20240902175053-18854r4","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【别名】枫实、枫果、枫木上球、枫香果、狼目、狼眼、九空子、枫木球。"}]},{"ID":"20240902175053-vi28dw2","Type":"NodeParagraph","Properties":{"id":"20240902175053-vi28dw2","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175053-spjy0fn","Type":"NodeParagraph","Properties":{"id":"20240902175053-spjy0fn","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"药材基源：为金缕梅科植物枫香树LiquidambarformosanaHance的果序。"}]},{"ID":"20240902175053-vv7cz7k","Type":"NodeParagraph","Properties":{"id":"20240902175053-vv7cz7k","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：LiquidambarformosanaHance"}]},{"ID":"20240902175053-ulz0hij","Type":"NodeParagraph","Properties":{"id":"20240902175053-ulz0hij","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬季采摘，除去杂质，洗净，晒干。"}]},{"ID":"20240902175053-rkygzmq","Type":"NodeParagraph","Properties":{"id":"20240902175053-rkygzmq","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【原形态】枫香树落叶乔木，高20-40m。树皮灰褐色，方块状剥落。叶互生；叶柄长3-7cm；托叶线形，早落；叶片心形，常3裂，幼时及萌发枝上的叶多为掌状5裂，长6-12cm，宽8-15cm，裂片卵状三角形或卵形，先端尾状渐尖，基部心形，边缘有细锯齿，齿尖有腺状突。花单性，雌雄同株，无花被；雄花淡黄绿色，成葇荑花序再排成总状，生于枝顶；雄蕊多数，花丝不等长；雌花排成圆球形的头状花序；萼齿5，钻形；子房半下位，2室，花柱2，柱头弯曲。头状果序圆球形，直径2.5-4.5cm，表面有刺，蒴果有宿存花萼和花柱，两瓣裂开，每瓣2浅裂。种子多数，细小，扁平。花期3-4月，果期9-10月。"}]},{"ID":"20240902175053-unnj0tx","Type":"NodeParagraph","Properties":{"id":"20240902175053-unnj0tx","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902175053-b4zzls0","Type":"NodeParagraph","Properties":{"id":"20240902175053-b4zzls0","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山地常绿阔叶林中。"}]},{"ID":"20240902175053-fqx206i","Type":"NodeParagraph","Properties":{"id":"20240902175053-fqx206i","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于秦岭及淮河以南各地。"}]},{"ID":"20240902175053-uatg6ro","Type":"NodeParagraph","Properties":{"id":"20240902175053-uatg6ro","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175053-y0wny0h","Type":"NodeParagraph","Properties":{"id":"20240902175053-y0wny0h","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"性状鉴别果序圆球形，直径2-3cm。表面灰棕色至棕褐色，有多数尖刺状宿存萼齿及鸟嘴状花柱，常折断或弯曲，除去后则现多数蜂窝小孔；基部有圆柱形果柄，长3-4.5cm，常折断或仅具果柄痕。小蒴果顶部开裂形成空洞状，可见种子多数，发育不完全者细小，多角形，直径约1mm，黄棕色亚棕褐色，发育完全者少数，扁平长圆形，具翅，褐色。体轻，质硬，不易破开。气微香,味谈。以个人、色黄、无泥、无果柄者为佳。"}]},{"ID":"20240902175053-hwh8fph","Type":"NodeParagraph","Properties":{"id":"20240902175053-hwh8fph","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：棕褐色。①纤维（果序轴）多断碎，长短不一，直径13-45um，末端稍钝或钝圆，壁多波状弯曲，木化，孔沟有时明显，胞腔内常合棕黄色物。②果皮石细胞类方形、梭形、不规则形或分枝状，直径53-398μm，壁极厚，孔沟分枝状。③宿萼表皮细胞表面观多角形，壁厚，具孔沟，腔小，内含棕黄色物。①单细胞毛（宿萼）常弯曲，长42-126μm，宽约14μm，亦含棕黄色物。"}]},{"ID":"20240902175053-f1q3m39","Type":"NodeParagraph","Properties":{"id":"20240902175053-f1q3m39","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【化学成份】枫香树果含28-去甲齐墩果酮酸（28－noroleanonicacid），苏合香素（styracin，即桂皮酸桂皮醇酯cin－namylcinnamate），左旋肉桂酸龙脑酯（bornylcinnamate），环氧苏合香素（styracinepoxide），异环氧苏合香素（isostyracinepoxide），氧化丁香烯（caryophylleneoxide），白桦脂酮酸（betulonicacid，即路路通酮酸liquidambronicacid，又称路路通酸liq-uidambaricacid），24-乙基胆甾-5-烯醇（24-ethyl-△5-cholestene-3β-ol）。"}]},{"ID":"20240902175053-axew5yi","Type":"NodeParagraph","Properties":{"id":"20240902175053-axew5yi","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902175053-70q0fek","Type":"NodeParagraph","Properties":{"id":"20240902175053-70q0fek","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"1.外用：实验证明，枫香酒精溶剂(60%)外用，能防止钩蚴侵入小鼠皮肤。其防护效力与溶剂浓度成正比。"}]},{"ID":"20240902175053-ekl6b5f","Type":"NodeParagraph","Properties":{"id":"20240902175053-ekl6b5f","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"2.保肝作用：桦木酮酸具有明显的抗肝细胞毒活性，即在体外试验中，对由四氯化碳及氨基半乳糖诱导的初次培养的大鼠肝细胞的细胞毒性有明显的保护作用。该生药在台湾作保肝药。"}]},{"ID":"20240902175053-4d3u5mx","Type":"NodeParagraph","Properties":{"id":"20240902175053-4d3u5mx","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（l）取本品1g，加水5ml，水浴加热20min，滤过，取滤波2ml，加碱性酒石酸铜试液2ml，在沸水浴中加热10min，产生红色氧化亚铜沉淀。（检查糖类）（2）取本品1g加95％乙醇10ml，水浴加热15min，放冷，滤过。滤液供下述试验：①取滤液2ml，蒸十，加浓硫酸一醋酐试剂2滴，显红紫色，渐变为紫棕色，最后显污绿色。（检查甾类）②取滤液2ml，加锌粉少许，滴加浓盐酸3-4滴，水浴加热15-20min，显橙色。（检查黄酮类）"}]},{"ID":"20240902175053-a5ynl9r","Type":"NodeParagraph","Properties":{"id":"20240902175053-a5ynl9r","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【性味】苦；平"}]},{"ID":"20240902175053-zhmkuw2","Type":"NodeParagraph","Properties":{"id":"20240902175053-zhmkuw2","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【归经】十二经"}]},{"ID":"20240902175053-gka7e9m","Type":"NodeParagraph","Properties":{"id":"20240902175053-gka7e9m","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿；疏肝活络；利水。主风湿痹痛；肢体麻木；手足拘挛；脘腹疼痛；经闭；乳汁不通；水肿胀满；湿疹"}]},{"ID":"20240902175053-966wuf8","Type":"NodeParagraph","Properties":{"id":"20240902175053-966wuf8","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤；3-10g；或煅存性研末服。外用：适量，研末敷；或烧烟闻嗅。"}]},{"ID":"20240902175053-7mi7j3y","Type":"NodeParagraph","Properties":{"id":"20240902175053-7mi7j3y","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902175053-si1xp4o","Type":"NodeParagraph","Properties":{"id":"20240902175053-si1xp4o","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"1.孕妇忌服。"}]},{"ID":"20240902175053-tda5da2","Type":"NodeParagraph","Properties":{"id":"20240902175053-tda5da2","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"2.《中药志》：阴虚内热者不宜。"}]},{"ID":"20240902175053-mk0zo7s","Type":"NodeParagraph","Properties":{"id":"20240902175053-mk0zo7s","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"3.《广西中药志》：虚寒血崩者勿服。"}]},{"ID":"20240902175053-jz5g10o","Type":"NodeParagraph","Properties":{"id":"20240902175053-jz5g10o","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"4.《四川中药志》：凡经水过多及孕妇忌用。"}]},{"ID":"20240902175053-a8vus5n","Type":"NodeParagraph","Properties":{"id":"20240902175053-a8vus5n","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【附方】①治风湿肢节痛：路路通、秦艽、桑枝、海风藤、橘络、苡仁。水煎服。(四川中药志)②治脏毒：路路通一个。煅存性，研末酒煎服。(《古今良方》)③治癣：枫木上球十个(烧存性)，白砒五厘。共末，香油搽。(《德胜堂经验方》)④治荨麻疹：枫球一斤。煎浓汁，每天三次，每次六钱，空心服。(湖南药物志》)⑤治耳内流黄水：路路通五钱。煎服。(《浙江民间草药》)"}]},{"ID":"20240902175053-1u9bk39","Type":"NodeParagraph","Properties":{"id":"20240902175053-1u9bk39","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902175053-1mhb3wk","Type":"NodeParagraph","Properties":{"id":"20240902175053-1mhb3wk","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"1.《纲目拾遗》：枫果，树似白杨，内圆如蜂窝，即路路通。其性大能通行十二经穴，故《救生苦海》治水肿胀用之，以其能搜逐伏水也。"}]},{"ID":"20240902175053-hohni9o","Type":"NodeParagraph","Properties":{"id":"20240902175053-hohni9o","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"2.《纲百拾遗》：辟瘴却瘟，明目，除湿，舒筋络拘挛，周身痹痛，手脚及腰痛，焚之嗅其烟气皆愈。"}]},{"ID":"20240902175053-qvgh98a","Type":"NodeParagraph","Properties":{"id":"20240902175053-qvgh98a","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"3.《岭南采药录》：治风湿流注疼痛及痈疽肿毒。"}]},{"ID":"20240902175053-z8upm5i","Type":"NodeParagraph","Properties":{"id":"20240902175053-z8upm5i","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"4.《现代实用中药》：烧灰外用于皮肤湿癣、痔漏等，有收敛、消炎、消毒作用。"}]},{"ID":"20240902175053-q72be4w","Type":"NodeParagraph","Properties":{"id":"20240902175053-q72be4w","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"5.《中药志》：通经利水，除湿热痹痛。治月经不调，周身痹痛、小便不利，水肿胀满等证。6.广州部队《常用中草药手册》：祛风除湿，行气活血。治风湿性腰痛、心胃气痛，少乳，湿疹，皮炎。"}]},{"ID":"20240902175053-l68711v","Type":"NodeParagraph","Properties":{"id":"20240902175053-l68711v","updated":"20240902175101"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902175054-ebh4m8w","Type":"NodeThematicBreak","Properties":{"id":"20240902175054-ebh4m8w","updated":"20240902175101"}},{"ID":"20240902175055-egtp669","Type":"NodeParagraph","Properties":{"id":"20240902175055-egtp669","updated":"20240902175101"}}]}