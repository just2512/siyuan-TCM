{"ID":"20240206101138-31ifpsc","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240206101138-31ifpsc","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206101138-31ifpsc\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206101145-ib2c7jp\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240206101141-pjswque\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206101145-ib2c7jp\u0026quot;,\u0026quot;focusStart\u0026quot;:130,\u0026quot;focusEnd\u0026quot;:130\u0026#125;","title":"路路通","type":"doc","updated":"20240902175101"},"Children":[{"ID":"20240206101145-ib2c7jp","Type":"NodeParagraph","Properties":{"id":"20240206101145-ib2c7jp","updated":"20240206101149"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产江苏、安徽、浙江、福建等地。\n【性状】\t本品为聚花果，由多数小蒴果集合而成，呈球形，直径23cm。基部有总果梗 。表面灰棕色或棕褐色，有多数尖刺及喙状小钝刺，长0.51mm，常折断，小蒴果顶部开裂，呈蜂窝状小孔。体轻，质硬，不易破开。气微，味淡。\n【性味】\t苦，平。\n【功效】\t祛风活络，利水通经。用于关节痹痛，麻木拘挛，水肿胀满，乳少经闭。"}]},{"ID":"20240206101141-pjswque","Type":"NodeParagraph","Properties":{"id":"20240206101141-pjswque","updated":"20240206101141"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206101141-mepigwr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727130156-ykvkdhe","Type":"NodeParagraph","Properties":{"id":"20240727130156-ykvkdhe","updated":"20240727130156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 640px;","style":"width: 630px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香树-20240715095703-ox2pap9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 630px;\" parent-style=\"width: 640px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 571px;","style":"width: 561px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香-20240715095707-atihbbf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 561px;\" parent-style=\"width: 571px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727130156-v5l9f3u","Type":"NodeParagraph","Properties":{"id":"20240727130156-v5l9f3u","updated":"20240727130156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香树 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香树 5-20240715102110-9llwls6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 563px;","style":"width: 553px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枫香树 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枫香树 6-20240715102309-al4utha.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 553px;\" parent-style=\"width: 563px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727130156-plvq9ic","Type":"NodeParagraph","Properties":{"id":"20240727130156-plvq9ic","updated":"20240727130156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 544px;","style":"width: 53