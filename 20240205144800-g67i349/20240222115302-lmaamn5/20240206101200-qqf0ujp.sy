 403px;\" parent-style=\"width: 413px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902145537-5bna5po","Type":"NodeParagraph","Properties":{"id":"20240902145537-5bna5po","updated":"20240902145537"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 16-20240723102434-cynaowz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 645px;","style":"width: 635px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 10-20240723101445-eg8tnal.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 635px;\" parent-style=\"width: 645px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723100240-29qyiec","Type":"NodeParagraph","Properties":{"id":"20240723100240-29qyiec","updated":"20240723100302"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 3-20240723100240-38gwnth.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"width: 621px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 4-20240723100302-2me8czy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 621px;\" parent-style=\"width: 631px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902145615-iad20st","Type":"NodeParagraph","Properties":{"id":"20240902145615-iad20st","updated":"20240902145648"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 366px;","style":"width: 356px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果-20240902145615-vdab4ux.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 356px;\" parent-style=\"width: 366px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 805px;","style":"width: 795px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 1-20240902145648-022psbk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 795px;\" parent-style=\"width: 805px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723101751-c3zdmod","Type":"NodeParagraph","Properties":{"id":"20240723101751-c3zdmod","updated":"20240723101751"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 773px;","style":"width: 763px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"罗汉果 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/罗汉果 11-20240723101751-hhzze87.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 763px;\" parent-style=\"width: 773px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240723100731-imrissd","Type":"NodeThematicBreak","Properties":{"id":"20240723100731-imrissd"}},{"ID":"20240902145729-y7fx33z","Type":"NodeParagraph","Properties":{"id":"20240902145729-y7fx33z","updated":"20240902145737"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：罗汉果"}]},{"ID":"20240902145729-bufm0dw","Type":"NodeParagraph","Properties":{"id":"20240902145729-bufm0dw","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"罗汉果《中国药典》"}]},{"ID":"20240902145729-bg6qiwx","Type":"NodeParagraph","Properties":{"id":"20240902145729-bg6qiwx","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【拼音名】LuóHànGuǒ"}]},{"ID":"20240902145729-s1wj7lr","Type":"NodeParagraph","Properties":{"id":"20240902145729-s1wj7lr","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSMOMORDICAE"}]},{"ID":"20240902145729-dbxogix","Type":"NodeParagraph","Properties":{"id":"20240902145729-dbxogix","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【来源】本品为葫芦科植物罗汉果MomordicagrosvenoriSwingle的干燥果实。秋季果实由嫩绿变深绿色时采收，晾数天后，低温干燥。"}]},{"ID":"20240902145729-13wzfrb","Type":"NodeParagraph","Properties":{"id":"20240902145729-13wzfrb","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈卵形、椭圆形或球形，长4.5～8.5cm，直径3.5～6cm。表面褐色、黄褐色或绿褐色，有深色斑块及黄色柔毛，有的有6～11条纵纹。顶端有花柱残痕，基部有果梗痕。体轻，质脆，果皮薄，易破。果瓤（中、内果皮）海绵状，浅棕色。种子扁圆形，多数，长约1.5cm，宽约1.2cm；浅红色至棕红色，两面中间微凹陷，四周有放射状沟纹，边缘有槽。气微，味甜。"}]},{"ID":"20240902145729-pb4v5h7","Type":"NodeParagraph","Properties":{"id":"20240902145729-pb4v5h7","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902145729-utqn740","Type":"NodeParagraph","Properties":{"id":"20240902145729-utqn740","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末棕褐色。果皮石细胞大多成群，黄色、方形或卵圆形，直径7～38μm，壁厚，孔沟明显。种皮石细胞类长方形或不规则形，壁薄，具纹孔。纤维长梭形，直径16～42μm,胞腔较大，壁孔明显。可见梯纹和螺纹导管。薄壁细胞不规则形，具纹孔。"}]},{"ID":"20240902145729-zty7woq","Type":"NodeParagraph","Properties":{"id":"20240902145729-zty7woq","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加稀乙醇20ml，加热回流30分钟，滤过，滤液蒸至约5ml,用正丁醇提取2次（10ml、5ml）,合并正丁醇液，蒸干，残渣加甲醇0.5ml使溶解，作为供试品溶液。另取罗汉果对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl,分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以氯仿－甲醇－水（60:10:1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902145729-bke7eht","Type":"NodeParagraph","Properties":{"id":"20240902145729-bke7eht","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性味】甘，凉。"}]},{"ID":"20240902145729-oeiuwxu","Type":"NodeParagraph","Properties":{"id":"20240902145729-oeiuwxu","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、大肠经。"}]},{"ID":"20240902145729-wkc8z8t","Type":"NodeParagraph","Properties":{"id":"20240902145729-wkc8z8t","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热润肺，滑肠通便。用于肺火燥咳，咽痛失音，肠燥便秘。"}]},{"ID":"20240902145729-f5igdp2","Type":"NodeParagraph","Properties":{"id":"20240902145729-f5igdp2","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240902145729-d7w0wfv","Type":"NodeParagraph","Properties":{"id":"20240902145729-d7w0wfv","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防霉，防蛀。"}]},{"ID":"20240902145729-2tfxwnx","Type":"NodeParagraph","Properties":{"id":"20240902145729-2tfxwnx","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902145729-awar3c1","Type":"NodeParagraph","Properties":{"id":"20240902145729-awar3c1","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"罗汉果《*辞典》"}]},{"ID":"20240902145729-bzsu8ll","Type":"NodeParagraph","Properties":{"id":"20240902145729-bzsu8ll","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【出处】《岭南采药录》"}]},{"ID":"20240902145729-48zf2np","Type":"NodeParagraph","Properties":{"id":"20240902145729-48zf2np","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【拼音名】LuóHànGuǒ"}]},{"ID":"20240902145729-jzo5e6g","Type":"NodeParagraph","Properties":{"id":"20240902145729-jzo5e6g","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【别名】拉汗果、假苦瓜（《广西药植名录》）。"}]},{"ID":"20240902145729-lfv3ywo","Type":"NodeParagraph","Properties":{"id":"20240902145729-lfv3ywo","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【来源】为葫芦科植物罗汉果的果实。9～10月间果熟时采摘，置地板上，使其后熟，约8～10天果皮由青绿转黄，用火烘炕，经5～6天，成为叩之有声的干燥果实，然后刷毛，纸包，装箱。"}]},{"ID":"20240902145729-9rxpw8v","Type":"NodeParagraph","Properties":{"id":"20240902145729-9rxpw8v","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902145729-8rj4p8r","Type":"NodeParagraph","Properties":{"id":"20240902145729-8rj4p8r","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"多年生攀援藤本。嫩茎被白色柔毛和红色腺毛，茎暗紫色，具纵棱。叶互生，卵形或长卵形，长11～16厘米，宽10～13厘米，先端急尖或渐尖，基部心形，全缘，上面绿色，被短柔毛，沿叶脉分布较密，下面暗绿色；嫩叶呈暗棕红色，密布红色腺毛，沿叶脉密被短柔毛；叶柄长4～5厘米，卷须侧生，先端二又。花单性，雌雄异株；花序柄、花柄、萼片、花瓣均被柔毛及腺毛；雄花腋生，5～7朵排列成总状；苞片1，矩圆形；萼5浅裂，裂片具线状尖尾；花瓣5，淡黄色，微带红色，卵形，长约2厘米，先端具尖尾；雄蕊3，花药分离。1枚1室，其余2枚2室；雌花单生于叶腋，萼管先端5裂；花瓣5，倒卵形，先端短尖，子房下位，与萼管合生，花柱3，柱头2歧，有退化雄蕊3。瓠果圆形、长圆形或倒卵形，幼时深棕红色，成熟时青色，被茸毛。花期6～8月。果期8～10月。"}]},{"ID":"20240902145729-9hcsqj7","Type":"NodeParagraph","Properties":{"id":"20240902145729-9hcsqj7","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"本品随着果形不同，有茶山子、长单果、拉江子、红毛果等园艺品种。"}]},{"ID":"20240902145729-d3psa06","Type":"NodeParagraph","Properties":{"id":"20240902145729-d3psa06","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【生境分布】多为栽培品，广西有大量栽培。主产广西。"}]},{"ID":"20240902145729-6472imh","Type":"NodeParagraph","Properties":{"id":"20240902145729-6472imh","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性状】干燥果实，圆形至长圆形，径5～8厘米，外表黄褐色至深棕色，较光泽，微具残留毛茸，少数有较深色的纵条纹。顶端膨大，中央有一圆形的花柱基痕，基部略狭，有果柄痕。质脆易碎，破碎后内表面黄白色，疏松似海绵状。除去中果皮，可见明显的纵脊纹10条。种子扁平，矩圆形或类圆形，棕色，边缘较厚，中央微凹，内有子叶2枚。味甜。以形圆、个大、坚实、摇之不响、色黄褐者为佳。"}]},{"ID":"20240902145729-5yjfihq","Type":"NodeParagraph","Properties":{"id":"20240902145729-5yjfihq","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【化学成份】含多量葡萄糖等。"}]},{"ID":"20240902145729-orjszmw","Type":"NodeParagraph","Properties":{"id":"20240902145729-orjszmw","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902145729-vt17oq0","Type":"NodeParagraph","Properties":{"id":"20240902145729-vt17oq0","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"①《岭南采药录》：\"味甘。\""}]},{"ID":"20240902145729-u43zr34","Type":"NodeParagraph","Properties":{"id":"20240902145729-u43zr34","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"②《广西中药志》：\"味甘，性凉，无毒。\""}]},{"ID":"20240902145729-sulhmxm","Type":"NodeParagraph","Properties":{"id":"20240902145729-sulhmxm","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【归经】《广西中药志》：\"入肺、脾二经。\""}]},{"ID":"20240902145729-nkg0y40","Type":"NodeParagraph","Properties":{"id":"20240902145729-nkg0y40","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902145729-2twen64","Type":"NodeParagraph","Properties":{"id":"20240902145729-2twen64","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"清肺润肠。治百日咳、痰火咳嗽，血燥便秘。"}]},{"ID":"20240902145729-976qvam","Type":"NodeParagraph","Properties":{"id":"20240902145729-976qvam","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"①《岭南采药录》：\"理痰火咳嗽，和猪精肉煎汤服之。\""}]},{"ID":"20240902145729-3cjzall","Type":"NodeParagraph","Properties":{"id":"20240902145729-3cjzall","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"②《广西中药志》：\"止咳清热，凉血润肠。治咳嗽，血燥胃热便秘等。\""}]},{"ID":"20240902145729-vsnj6qk","Type":"NodeParagraph","Properties":{"id":"20240902145729-vsnj6qk","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱。"}]},{"ID":"20240902145729-buzcrrr","Type":"NodeParagraph","Properties":{"id":"20240902145729-buzcrrr","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【附方】治百日咳：罗汉果一个，柿饼五钱。水煎服。（福建）"}]},{"ID":"20240902145729-339eot8","Type":"NodeParagraph","Properties":{"id":"20240902145729-339eot8","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902145729-bfmulpr","Type":"NodeParagraph","Properties":{"id":"20240902145729-bfmulpr","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"罗汉果《中华本草》"}]},{"ID":"20240902145729-k1tgg82","Type":"NodeParagraph","Properties":{"id":"20240902145729-k1tgg82","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【出处】出自《岭南采药录》。"}]},{"ID":"20240902145729-6bb1cht","Type":"NodeParagraph","Properties":{"id":"20240902145729-6bb1cht","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【拼音名】LuóHànGuǒ"}]},{"ID":"20240902145729-tg1jx98","Type":"NodeParagraph","Properties":{"id":"20240902145729-tg1jx98","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【英文名】GrosvenerSiraitia,FruitofGrosvenorMomordica,GrosvenorMomordica"}]},{"ID":"20240902145729-luhhzlg","Type":"NodeParagraph","Properties":{"id":"20240902145729-luhhzlg","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【别名】拉汗果、假苦瓜、光果木鳖、金不换、罗汉表、裸龟巴。"}]},{"ID":"20240902145729-h3873qh","Type":"NodeParagraph","Properties":{"id":"20240902145729-h3873qh","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902145729-sozv2hp","Type":"NodeParagraph","Properties":{"id":"20240902145729-sozv2hp","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"药材基源：为葫芦科植物罗汉的果实。"}]},{"ID":"20240902145729-0fs3nh2","Type":"NodeParagraph","Properties":{"id":"20240902145729-0fs3nh2","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Siraitiagrosuenorii(Swingle)C.JeffreyexLuetZ.Y.Zhang[MonordicagrosuenoriiSwingle]"}]},{"ID":"20240902145729-chx3hcy","Type":"NodeParagraph","Properties":{"id":"20240902145729-chx3hcy","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月间果熟时采摘，团龄地板上，使其后熟，约8-10d果皮由表绿转黄，用火烘炕，经5-6d，叩之有声时，即成干燥果实，然后刷毛，纸包，装箱，存放干燥处。"}]},{"ID":"20240902145729-d6cohjf","Type":"NodeParagraph","Properties":{"id":"20240902145729-d6cohjf","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生攀援草本。具肥大的块根，纺锤形或近球形。茎稍粗壮，有棱沟，初被黄褐色柔毛和黑色疣状腺鳞，后毛渐脱攻或变的无毛。叶柄长3-10cm，被同枝条一样的毛被和腺鳞；叶片膜质，卵状心形、三角状卵或阔卵状心形，长12-23cm，，宽5-17cm，先端渐尖或长渐尖，边缘微波状，由于小脉伸出而具小齿，有缘毛，一面绿色，被稀疏柔毛和黑色疣状腺鳞，老后逐渐脱落变近无毛，下面淡绿色，被短毛和混生黑色疣状腺鳞，老后渐脱落。郑须稍粗壮，初时被短柔毛，后渐变无毛，2歧，在分叉点上下面时旋卷。雌雄异株；雄花序总状，6-10朵花生于花序轴上部，也具有短柔毛和黑色疣状腺鳞，花梗细，花萼筒钏状，喉部常具有3枚长圆形的膜质鳞片，花萼裂片5，三角形，先端钻状尾尖，具3脉，脉稍隆起，花冠黄色，被黑色腺点，裂片5，长圆形，常具5脉，雄蕊5，插生于筒下近基部；两基部靠合，而1枚分离，花丝基部膨大；雌花单生或2-5朵集生在6-8cm的总花梗顶端，花萼、花梗均比雄花天，退化雄蕊5，子房长圆形，长10-12mm，密生黄褐色茸毛，花柱粗短，柱头3，膨大，镰形，2裂。果实球形或长圆形，长6-11cm，径4-8cm，初密被黄褐色的茸毛，果皮较薄，干后易脆。种子多数，淡黄色，近圆形或阔卵形，扁压状，长15-18mm，宽10-12mm，基部钝圆，先端稍稍变狭，两面中内稍凹陷，周围有放射状的沟纹，边缘微波状，幼时深红棕色，成熟时表色。花期2-5月，果期7-9月。"}]},{"ID":"20240902145729-qnek0am","Type":"NodeParagraph","Properties":{"id":"20240902145729-qnek0am","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902145729-9r3h3hc","Type":"NodeParagraph","Properties":{"id":"20240902145729-9r3h3hc","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"生态环境：常生长于海拔400-1400m以上的山坡林下及河边湿地、薄丛。"}]},{"ID":"20240902145729-h4ldchi","Type":"NodeParagraph","Properties":{"id":"20240902145729-h4ldchi","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江西、湖南、广东、广西、贵州等地，广西部分地区已作为重要的经济作物栽培。"}]},{"ID":"20240902145729-8e6gs90","Type":"NodeParagraph","Properties":{"id":"20240902145729-8e6gs90","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902145729-24ik4f4","Type":"NodeParagraph","Properties":{"id":"20240902145729-24ik4f4","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"性状鉴别果产圆球形或长圆形，长6-8cm，直径4-6.5cm。表面棕绿色或黄褐色，有时可见深棕色斑纹和木栓斑点，全体被白色毛茸，以果实两端较密，并陷约可见8-10条纵纹。果实顶端有圆点状柱基，基部有果柄痕。体轻，果皮薄，质脆易碎，果瓢干缩，淡黄色至淡棕色，质松如海绵。具圆形，中内有一长形凹陷，边缘呈不规则缺刻状，长1.5-2cm，宽0.7-1.5cm，厚0.3-0.4cm，表面黄色，先端一小突尖微凹，为珠孔所在，种仁位于中内，长卵形，质坚硬，周围具放射状沟纹。质松脆，味甜。"}]},{"ID":"20240902145729-znroxlh","Type":"NodeParagraph","Properties":{"id":"20240902145729-znroxlh","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"以个大、完整，摇之不响，色黄褐者为佳。"}]},{"ID":"20240902145729-upkmifn","Type":"NodeParagraph","Properties":{"id":"20240902145729-upkmifn","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：外果皮为1列扁小表皮细胞，外被角质层，厚4-12μm，气孔微向外突；有时可见多细胞非腺毛或基殖基。中果皮外侧为4-6列圆形或切向延长的薄壁细胞；向内为6-9列石细胞层，细胞呈圆形、长圆形、类方形或不规则多角形。紧贴石细胞层内侧，为数列大形不规则的多角形细胞，壁略厚、具壁孔。其内数列薄壁细胞常皱缩或颓废；维管束多韧型常两个内外相连稀疏散布。内果皮为1列扁小的薄壁细胞。"}]},{"ID":"20240902145729-fxr85fq","Type":"NodeParagraph","Properties":{"id":"20240902145729-fxr85fq","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"种子横切面：表皮在种子扁平向的上下部位，为1列栅状细胞，长205-280μm，宽12-30μm，左右两侧表皮细胞粘液化，其内为数层切向延长的薄壁组织。在栅状细胞下层为数层厚壁纤维和大型石细胞层，近种仁处排列成环。内表皮为1列扁小细胞。胚乳细胞1-2列。子叶细胞含脂肪油滴。"}]},{"ID":"20240902145729-1e7yw7g","Type":"NodeParagraph","Properties":{"id":"20240902145729-1e7yw7g","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄褐色或棕黑色、味极甜。①石细胞众多，方形或不规则多角形，长20-53μm，宽13-16μm。壁孔、孔沟及层纹均明显。②纤维梭形，长短不一，长76-305μm，直径16-42μm，胞腔较大。③非腺毛6-10细胞，长148-480μm，直径30-43μm，胞腔内有时含有棕色物质。④栅状细胞长达300μm，外被薄层角质层，侧壁呈不规则弯曲。⑤薄壁细胞大，圆形或不规则多角形，具单纹孔。⑥导管螺纹及梯纹。"}]},{"ID":"20240902145729-h0yx5ve","Type":"NodeParagraph","Properties":{"id":"20240902145729-h0yx5ve","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902145729-2m72qf7","Type":"NodeParagraph","Properties":{"id":"20240902145729-2m72qf7","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"干燥果实，圆形至长圆形，径5-8cm，外表黄褐色至深棕色，较光泽，微具残留毛茸，少数有较深色的纵条纹。顶端膨大，中央有一圆形的花柱基痕，基部略狭，有果柄痕。质脆易碎，破碎后内表面黄白色，疏松似海绵状。除去中果皮，可见明显的纵脊纹10条。种子扁平，矩圆形或类圆形，棕色，边缘较厚，中央微凹，内有子叶2枚。味甜。以形圆、个大、坚实、摇之不响、色黄褐者为佳。本品以个大、完整、色黄褐、摇之不响者为佳。"}]},{"ID":"20240902145729-uw7d67t","Type":"NodeParagraph","Properties":{"id":"20240902145729-uw7d67t","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面；外果皮为1列扁小表皮细胞，外果皮为1列扁小表皮细胞，外被角质层，厚4-12μm，气孔微向外突；有时可见多细胞非腺毛或基残基。中果皮外侧为4-6列圆形或切向延长的确良薄壁细胞；向内为6-9列石细胞层，细胞呈圆形、长圆形、类方形或不规则多角形。紧贴石细胞层内侧，为数列大形不规则的多角形细胞，壁略厚、具壁孔。其内数列七壁细胞常皱缩或颓废；维管束双韧型，常两个内外相连稀疏散布。内果皮为1列扁小的落地壁细胞。"}]},{"ID":"20240902145729-0ebim1b","Type":"NodeParagraph","Properties":{"id":"20240902145729-0ebim1b","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"种子横切面：表皮在种子扁平向的上下部位，为1列棚状细胞，长205-280μm，宽12-30μm，左右两侧表皮细胞粘液化，其内为数层切向延长的薄壁组织。在栅状细胞下层为数层厚壁纤维和大型石细胞层，近种仁处排列成环。内表皮为1列扁小细胞。胚乳细胞1-2列。子叶细胞含脂肪油滴。"}]},{"ID":"20240902145729-m1eq1l4","Type":"NodeParagraph","Properties":{"id":"20240902145729-m1eq1l4","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄褐或棕黑色、味甜。①石细胞众多，方形或不规则多角形，长20-53μm，宽13-16μm。壁孔、孔沟及层纹均明显。②纤维梭形，长短不一，长76-305μm，直径16-42μm，胞腔内有时含有棕色物质。④栅状细胞长达300μm，外被薄层角质层，侧壁呈不规则弯曲。⑤薄壁细胞大，圆形或不规则多角形，具单纹孔。⑥导管螺纹及梯纹。"}]},{"ID":"20240902145729-2kitqfw","Type":"NodeParagraph","Properties":{"id":"20240902145729-2kitqfw","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【化学成份】果中含非糖甜味的成分，主要是三萜甙类：罗汉果甙（mogroside)Ⅴ及Ⅳ[1-3]，甙Ⅴ的甜度是蔗糖（srcrose)的256-344倍，甙Ⅳ的甜度为蔗糖的126倍，不有甙Ⅳ则不呈甜味[4]；次要的是D-甘露醇（D-mannitol)，其甜度为蔗糖的0.55-0.65倍[5]。还含大量葡萄糖（glucose)[6],果糖（fructose)占14%[4]。又含锰、铁、镍、硒、锡、碘、钼等26种无机无素[7]、蛋白质、维生素C（vitaminC)等。种仁含油脂41.07%，基中脂肪酸有：亚油酸（linoleicacid)，油酸（oleicacid)，棕榈酸（palmiticacid)，硬脂酸（stearicacid)，棕榈油酸（palmitoliecacid)，肉豆蔻酸（myristicacid)，月桂酸（lauricacid)，癸酸（decanoicacid)[7]。"}]},{"ID":"20240902145729-6w7ltpq","Type":"NodeParagraph","Properties":{"id":"20240902145729-6w7ltpq","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902145729-8mkax8c","Type":"NodeParagraph","Properties":{"id":"20240902145729-8mkax8c","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"1.止咳作用：D-甘露醇有止咳作用。又可用于脑水肿，能提高血液渗透压，降低颅内压，脱水作用强于尿素，且持续时间长。还可用于大面积烧伤和烫伤的水肿，防治急性肾功能衰竭病和降低眼球内压，治疗急性青光眼以及代替糖作糖尿病患者的甜味食品或调味剂。"}]},{"ID":"20240902145729-rsuamob","Type":"NodeParagraph","Properties":{"id":"20240902145729-rsuamob","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"2.对肠管作用：罗汉果健身茶（含罗汉果77.5%，含茶叶15%，含7.5%罗汉果制剂）对小白鼠离休小肠自发活动无明显影响，但可加强家兔和狗离体小肠自发活动。对乙酰胆碱或氯化钡引起的肠管强直性收缩均有拮抗作用，使肠管松弛而解痉；对肾上腺素引起的肠管松弛也有拮抗作用，使肠管恢复自发性活动。表明罗汉果健身茶对肠管运动机能有双向调节作用。"}]},{"ID":"20240902145729-oz995pf","Type":"NodeParagraph","Properties":{"id":"20240902145729-oz995pf","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"3.其它作用：罗汉果健身茶对正常家兔胃生物电无影响，即不影响正常的消化道运动机能。罗汉果健身茶给麻醉狗灌胃，血压和心电图均无明显影响。"}]},{"ID":"20240902145729-fkhfo6i","Type":"NodeParagraph","Properties":{"id":"20240902145729-fkhfo6i","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【毒性】罗汉果健身茶急性毒性试验表明其毒性较小。"}]},{"ID":"20240902145729-cfll9ew","Type":"NodeParagraph","Properties":{"id":"20240902145729-cfll9ew","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【炮制】果实烘干、备用。"}]},{"ID":"20240902145729-7pgh718","Type":"NodeParagraph","Properties":{"id":"20240902145729-7pgh718","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；性凉"}]},{"ID":"20240902145729-5cv6h27","Type":"NodeParagraph","Properties":{"id":"20240902145729-5cv6h27","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；脾经"}]},{"ID":"20240902145729-r8kttwl","Type":"NodeParagraph","Properties":{"id":"20240902145729-r8kttwl","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【功能主治】清肺利咽；化痰止咳；润肠通便。主肺热痰炎咳嗽；咽喉炎；扁挑体炎；急性胃炎；便秘"}]},{"ID":"20240902145729-wpe64el","Type":"NodeParagraph","Properties":{"id":"20240902145729-wpe64el","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g，或炖肉；或开水泡。"}]},{"ID":"20240902145729-4zjwov7","Type":"NodeParagraph","Properties":{"id":"20240902145729-4zjwov7","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者忌服。"}]},{"ID":"20240902145729-xgwaeg1","Type":"NodeParagraph","Properties":{"id":"20240902145729-xgwaeg1","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902145729-72d7lc6","Type":"NodeParagraph","Properties":{"id":"20240902145729-72d7lc6","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"1.《岭南采药录》：理痰火咳嗽，和猪精肉煎汤服之。"}]},{"ID":"20240902145729-7ldwf4m","Type":"NodeParagraph","Properties":{"id":"20240902145729-7ldwf4m","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"2.《广西中药志》：止咳清热，凉血润肠。治咳嗽，血燥胃热便秘等。"}]},{"ID":"20240902145729-uxs040h","Type":"NodeParagraph","Properties":{"id":"20240902145729-uxs040h","updated":"20240902145749"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902145730-pp2me72","Type":"NodeThematicBreak","Properties":{"id":"20240902145730-pp2me72","updated":"20240902145749"}},{"ID":"20240902145732-3q993r2","Type":"NodeParagraph","Properties":{"id":"20240902145732-3q993r2","updated":"20240902145749"}}]}