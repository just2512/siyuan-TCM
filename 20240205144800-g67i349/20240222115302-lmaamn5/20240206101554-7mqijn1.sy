"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木鳖子 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木鳖子 7-20240715082731-fsi4rxo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715083210-sa84dat","Type":"NodeParagraph","Properties":{"id":"20240715083210-sa84dat","updated":"20240715083626"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木鳖子 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木鳖子 6-20240715082300-iba84y5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 668px;","style":"width: 658px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木鳖子 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木鳖子 15-20240715083626-wspilpk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 658px;\" parent-style=\"width: 668px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715083536-uq26769","Type":"NodeParagraph","Properties":{"id":"20240715083536-uq26769","updated":"20240715083735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 625px;","style":"width: 615px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木鳖子 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木鳖子 17-20240715083735-cyntxhi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 615px;\" parent-style=\"width: 625px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木鳖子 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木鳖子 16-20240715083705-4s48xxa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715083423-dpyoxvh","Type":"NodeThematicBreak","Properties":{"id":"20240715083423-dpyoxvh"}},{"ID":"20240830172509-87lzpdm","Type":"NodeParagraph","Properties":{"id":"20240830172509-87lzpdm","updated":"20240830172517"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：木鳖子"}]},{"ID":"20240830172509-u6kp1iu","Type":"NodeParagraph","Properties":{"id":"20240830172509-u6kp1iu","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子《中国药典》"}]},{"ID":"20240830172509-5xvlg0l","Type":"NodeParagraph","Properties":{"id":"20240830172509-5xvlg0l","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【拼音名】MùBiēZǐ"}]},{"ID":"20240830172509-9shizcl","Type":"NodeParagraph","Properties":{"id":"20240830172509-9shizcl","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【来源】本品为葫芦科植物木鳖Momordicacochinchinensis（Lour.）Spreng.的干燥成熟种子。冬季采收成熟果实，剖开，晒至半干，除去果肉，取出种子，干燥。"}]},{"ID":"20240830172509-vodvi9u","Type":"NodeParagraph","Properties":{"id":"20240830172509-vodvi9u","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈扁平圆板状，中间稍隆起或微凹陷，直径2～4cm，厚约0.5cm。表面灰棕色至黑褐色，有网状花纹，在边缘较大的一个齿状突起上有浅黄色种脐。外种皮质硬而脆，内种皮灰绿色，绒毛样。子叶2，黄白色，富油性。有特殊的油腻气，味苦。"}]},{"ID":"20240830172509-sris7pd","Type":"NodeParagraph","Properties":{"id":"20240830172509-sris7pd","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830172509-ddef3uz","Type":"NodeParagraph","Properties":{"id":"20240830172509-ddef3uz","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末黄灰色。厚壁细胞椭圆形或类圆形，边缘波状，直径51～117μm，壁厚，木化，胞腔明显，有的狭窄。子叶薄壁细胞多角形，内含脂肪油块及糊粉粒；脂肪油块类圆形，直径27～73μｍ，表面可见网状纹理。"}]},{"ID":"20240830172509-zoes5gc","Type":"NodeParagraph","Properties":{"id":"20240830172509-zoes5gc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"（2）取本品粗粉2g，加乙醚20ml，温浸30分钟，滤过。取醚液2ml,置玻璃皿中，挥尽乙醚，残渣加无水硫酸钠少量，直接加热，产生气泡及具刺激性的浓白色气体。"}]},{"ID":"20240830172509-bve8ojy","Type":"NodeParagraph","Properties":{"id":"20240830172509-bve8ojy","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"（3）取本品粗粉2g，加水20ml，置水浴中加热30分钟，滤过，取滤液2ml,置具塞试管中，塞紧，用力振摇1分钟，发生大量泡沫，10分钟内不消失。"}]},{"ID":"20240830172509-6v5of7p","Type":"NodeParagraph","Properties":{"id":"20240830172509-6v5of7p","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830172509-rgd6nhw","Type":"NodeParagraph","Properties":{"id":"20240830172509-rgd6nhw","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子：去壳取仁，捣碎。"}]},{"ID":"20240830172509-om7wchy","Type":"NodeParagraph","Properties":{"id":"20240830172509-om7wchy","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子霜：取净木鳖子仁，炒热，研末，用纸包裹，加压去油。本品为白色或灰白色的松散粉末。"}]},{"ID":"20240830172509-m7kjhk7","Type":"NodeParagraph","Properties":{"id":"20240830172509-m7kjhk7","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性味】苦、微甘，凉；有毒。"}]},{"ID":"20240830172509-4elw0i5","Type":"NodeParagraph","Properties":{"id":"20240830172509-4elw0i5","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾、胃经。"}]},{"ID":"20240830172509-lquhamv","Type":"NodeParagraph","Properties":{"id":"20240830172509-lquhamv","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【功能主治】散结消肿，攻毒疗疮。用于疮疡肿毒，乳痈，瘰疠，痔漏，干癣，秃疮。"}]},{"ID":"20240830172509-4kcftc9","Type":"NodeParagraph","Properties":{"id":"20240830172509-4kcftc9","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.9～1.2g；外用适量，研末，用油或醋调涂患处。"}]},{"ID":"20240830172509-gauraby","Type":"NodeParagraph","Properties":{"id":"20240830172509-gauraby","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇慎用。"}]},{"ID":"20240830172509-j0q8kvi","Type":"NodeParagraph","Properties":{"id":"20240830172509-j0q8kvi","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830172509-ajvp4pe","Type":"NodeParagraph","Properties":{"id":"20240830172509-ajvp4pe","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830172509-y1v4urv","Type":"NodeParagraph","Properties":{"id":"20240830172509-y1v4urv","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子《全国中草药汇编》"}]},{"ID":"20240830172509-7miq09e","Type":"NodeParagraph","Properties":{"id":"20240830172509-7miq09e","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【拼音名】MùBiēZǐ"}]},{"ID":"20240830172509-xp6zg98","Type":"NodeParagraph","Properties":{"id":"20240830172509-xp6zg98","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【别名】藤桐、木别子、漏苓子"}]},{"ID":"20240830172509-kxchj46","Type":"NodeParagraph","Properties":{"id":"20240830172509-kxchj46","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【来源】葫芦科植物木鳖Momordicacochinchinensis（Lour.）Spreng.以种子、根和叶入药。根、叶夏季采集，多鲜用。冬初采集果实，沤栏果肉，洗净种子，晒干。"}]},{"ID":"20240830172509-87djhmx","Type":"NodeParagraph","Properties":{"id":"20240830172509-87djhmx","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【药理作用】水浸出液或醇浸出液对麻醉动物有降压作用，但毒性大。"}]},{"ID":"20240830172509-anm5kf1","Type":"NodeParagraph","Properties":{"id":"20240830172509-anm5kf1","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性味】苦、微甘，温。有毒。"}]},{"ID":"20240830172509-5zhgweg","Type":"NodeParagraph","Properties":{"id":"20240830172509-5zhgweg","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【功能主治】解毒，消肿止痛。用于化脓性炎症，乳腺炎，淋巴结炎，头癣，痔疮。"}]},{"ID":"20240830172509-j7o0un3","Type":"NodeParagraph","Properties":{"id":"20240830172509-j7o0un3","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～5分；外用适量。研末醋调涂患处。"}]},{"ID":"20240830172509-107j0c6","Type":"NodeParagraph","Properties":{"id":"20240830172509-107j0c6","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【注意】外用为主，内服宜慎。"}]},{"ID":"20240830172509-9b7vtyx","Type":"NodeParagraph","Properties":{"id":"20240830172509-9b7vtyx","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830172509-n22ehre","Type":"NodeParagraph","Properties":{"id":"20240830172509-n22ehre","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子《*辞典》"}]},{"ID":"20240830172509-age4a15","Type":"NodeParagraph","Properties":{"id":"20240830172509-age4a15","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【出处】《开宝本草》"}]},{"ID":"20240830172509-ps3oycs","Type":"NodeParagraph","Properties":{"id":"20240830172509-ps3oycs","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【拼音名】MùBiēZǐ"}]},{"ID":"20240830172509-aaa2izk","Type":"NodeParagraph","Properties":{"id":"20240830172509-aaa2izk","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【别名】木蟹（《开宝本草》），土木鳖（《医宗金鉴》），壳木鳖（《药材资料汇编》），漏苓子（《中药志》），地桐子、藤桐子（《中药材手册》），鸭屎瓜子（《药材学》），木鳖瓜（广州空军《常用中草药手册》）。"}]},{"ID":"20240830172509-naacllo","Type":"NodeParagraph","Properties":{"id":"20240830172509-naacllo","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【来源】为葫芦科植物木鳖子的成熟种子。9～11月果实成熟时采摘，剖开果实，晒至半干，剥取种子；或装入盆钵内，待果皮近于腐败时将果皮弄烂，用清水淘洗，除去瓤肉及外膜，取出种子，晒干或烘干。"}]},{"ID":"20240830172509-hsbs8vj","Type":"NodeParagraph","Properties":{"id":"20240830172509-hsbs8vj","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830172509-j1ufjq3","Type":"NodeParagraph","Properties":{"id":"20240830172509-j1ufjq3","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子，又名：木鳖藤。"}]},{"ID":"20240830172509-h9b7aya","Type":"NodeParagraph","Properties":{"id":"20240830172509-h9b7aya","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"多年生草质藤本，具膨大的块状根。茎有纵棱；卷须粗壮，与叶对生，单一，不分枝。叶互生，圆形至阔卵形，长7～14厘米，通常3浅裂或深裂，裂片略呈卵形或长卵形，全缘或具微齿，基部近心形，先端急尖，上面光滑，下面密生小乳突，3出掌状网脉；叶柄长5～10厘米，具纵棱，在中部或近叶片处具2～5腺体。花单性，雌雄同株，单生叶腋，花梗细长，每花具1片大型苞片，黄绿色；雄花：萼片5，革质，粗糙，卵状披针形，基部连合，花瓣5，浅黄色，基部连合，雄蕊5，愈合成3体；雌花：萼片线状披针形，花冠与雄花相似，子房下位。瓠果椭圆形，成熟后红色，肉质，外被软质刺灾，种子略呈扁圆形或近椭圆形，边缘四周具不规则的突起，呈龟板状，灰棕色。花期6～8月。果期9～11月。"}]},{"ID":"20240830172509-y5xhuue","Type":"NodeParagraph","Properties":{"id":"20240830172509-y5xhuue","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于山坡、林缘，土层较深厚的地方。也有栽培。分布广西、四川、湖北、河南、安徽、浙江、福建、广东、贵州、云南等地。主产广西、四川、湖北。此外，湖南、贵州、云南、广东、安徽亦产。"}]},{"ID":"20240830172509-guf4h4a","Type":"NodeParagraph","Properties":{"id":"20240830172509-guf4h4a","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性状】种子略呈扁平圆板状，中间稍隆起，直径约2～3厘米，厚约5毫米。表面灰褐色或灰黑色，粗糙，有凹陷的网状花纹，周边两侧均有十数个相对的锯齿状突起。外种皮质坚而脆，内种皮薄膜状，表面灰绿色，绒毛样，其内为二片大形肥厚子叶，黄白色，富油质，有特殊的油腻气，味苦。以籽粒饱满、不破裂、体重、内仁黄白色、不泛油者为佳。"}]},{"ID":"20240830172509-fi7ek9k","Type":"NodeParagraph","Properties":{"id":"20240830172509-fi7ek9k","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【化学成份】含木鳖子酸（momordicacid）、丝石竹皂甙元（gypsogenin）、齐墩果酸（oleanolicacid）、α-桐酸（α-elaeostearicacid）、气基酸、甾醇。"}]},{"ID":"20240830172509-gxlmlwx","Type":"NodeParagraph","Properties":{"id":"20240830172509-gxlmlwx","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，晒干，用时连壳打碎，或去壳取仁。"}]},{"ID":"20240830172509-4sbak32","Type":"NodeParagraph","Properties":{"id":"20240830172509-4sbak32","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830172509-l6686u9","Type":"NodeParagraph","Properties":{"id":"20240830172509-l6686u9","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"苦微甘，温，有毒。"}]},{"ID":"20240830172509-tsc36lc","Type":"NodeParagraph","Properties":{"id":"20240830172509-tsc36lc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"甘，温，无毒。\""}]},{"ID":"20240830172509-r2pmnok","Type":"NodeParagraph","Properties":{"id":"20240830172509-r2pmnok","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"苦微甘，有小毒。\""}]},{"ID":"20240830172509-jec81ne","Type":"NodeParagraph","Properties":{"id":"20240830172509-jec81ne","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830172509-btaofl2","Type":"NodeParagraph","Properties":{"id":"20240830172509-btaofl2","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"入肝、脾、胃经。"}]},{"ID":"20240830172509-i3niw15","Type":"NodeParagraph","Properties":{"id":"20240830172509-i3niw15","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入手阳明经。\""}]},{"ID":"20240830172509-evo52qd","Type":"NodeParagraph","Properties":{"id":"20240830172509-evo52qd","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入脾、肾二经。\""}]},{"ID":"20240830172509-i7nnkg2","Type":"NodeParagraph","Properties":{"id":"20240830172509-i7nnkg2","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》：\"入足厥阴经。\""}]},{"ID":"20240830172509-nyxj9fe","Type":"NodeParagraph","Properties":{"id":"20240830172509-nyxj9fe","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830172509-rvragjk","Type":"NodeParagraph","Properties":{"id":"20240830172509-rvragjk","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"消肿散结，祛毒。治痈肿、疔疮、瘰疬、痔疮、无名肿毒、癣疮，风湿痹痛，筋脉拘挛。"}]},{"ID":"20240830172509-qig2iyw","Type":"NodeParagraph","Properties":{"id":"20240830172509-qig2iyw","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"醋摩消肿毒。\""}]},{"ID":"20240830172509-bclpgw0","Type":"NodeParagraph","Properties":{"id":"20240830172509-bclpgw0","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"主折伤，消结肿恶疮，生肌，止腰痛，除粉刺酐蹭，好人乳痈，肛门肿痛。\""}]},{"ID":"20240830172509-vuz78ta","Type":"NodeParagraph","Properties":{"id":"20240830172509-vuz78ta","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"治疳积痞块，利大肠泻痢，痔瘤瘰疬。\""}]},{"ID":"20240830172509-l119sdo","Type":"NodeParagraph","Properties":{"id":"20240830172509-l119sdo","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"④《本草备要》：\"泻热，外用治疮。利大肠，治泻痢疳积，瘰疬疮痔，乳痈，蚌毒。消肿追毒，生肌除酐。\""}]},{"ID":"20240830172509-px040xu","Type":"NodeParagraph","Properties":{"id":"20240830172509-px040xu","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑤《本草求原》：\"治一切寒湿郁热而为痛风瘫痪、行痹、瘙厥、脚气、挛症、鹤膝。\""}]},{"ID":"20240830172509-pjdwzdu","Type":"NodeParagraph","Properties":{"id":"20240830172509-pjdwzdu","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【用法用量】外用：研末调敷、磨汁涂或煎水熏洗。内服：多入丸、散；煎汤，2～4分。"}]},{"ID":"20240830172509-m9h95ts","Type":"NodeParagraph","Properties":{"id":"20240830172509-m9h95ts","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830172509-goxne0f","Type":"NodeParagraph","Properties":{"id":"20240830172509-goxne0f","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"孕妇及体虚者忌服。"}]},{"ID":"20240830172509-3i03bps","Type":"NodeParagraph","Properties":{"id":"20240830172509-3i03bps","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"胃虚、大肠不实、元真亏损者，不可概投。\""}]},{"ID":"20240830172509-nmycdwz","Type":"NodeParagraph","Properties":{"id":"20240830172509-nmycdwz","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"忌猪肉。\""}]},{"ID":"20240830172509-j8hb6xs","Type":"NodeParagraph","Properties":{"id":"20240830172509-j8hb6xs","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830172509-rg1e7a2","Type":"NodeParagraph","Properties":{"id":"20240830172509-rg1e7a2","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"①治一切诸毒，红肿赤晕不消者：木鳖子（去壳）二两，草乌半两，小粉四两，半夏二两。上四味于铁铫内，慢火炒焦，黑色为度，研细，以新汲水调敷，一日一次，自外向里涂之，须留疮顶，令出毒气。（《医宗金鉴》乌龙膏）"}]},{"ID":"20240830172509-t9uyfif","Type":"NodeParagraph","Properties":{"id":"20240830172509-t9uyfif","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"②治疮疡、疔毒初起，瘰疬，臁疮，小儿蟺拱头：土木鳖（去壳）五个，白嫩松香（拣净）四两，铜绿研细一钱，乳香、没药各二钱，蓖麻子（去壳）七钱，巴豆肉五粒，杏仁（去皮）一钱。上八味合一处，石臼内捣三千余下，即成膏；取起，浸凉水中。用时随疮大小，用手搓成薄片，贴疮上，用绢盖之。（《医宗金鉴》神效千捶膏）"}]},{"ID":"20240830172509-kg6p1rn","Type":"NodeParagraph","Properties":{"id":"20240830172509-kg6p1rn","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"③治两耳卒肿热痛：木鳖子仁一两（研如膏），赤小豆末半两，川大黄末半两。上药同研令匀，水，生油旋调涂之。（《圣惠方》）"}]},{"ID":"20240830172509-dbmeo7f","Type":"NodeParagraph","Properties":{"id":"20240830172509-dbmeo7f","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"④治瘰疬发歇无已，脓血淋漓：木鳖仁二个，厚纸拭去油，研碎，以乌鸡子调和，磁盏盛之，甑内蒸热。每日食后服一次，服半月。（《仁斋直指方》木鳖膏）"}]},{"ID":"20240830172509-wstbafc","Type":"NodeParagraph","Properties":{"id":"20240830172509-wstbafc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑤治痔疮：荆芥、木鳖子、朴硝各等分。上煎汤，入于瓶内，熏后，汤温洗之。（《普济方》）"}]},{"ID":"20240830172509-tgvrh20","Type":"NodeParagraph","Properties":{"id":"20240830172509-tgvrh20","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑥治小儿丹瘤：木鳖子新者去壳，研如泥，淡醋调敷之，一日三、五次。（《外科精义》）"}]},{"ID":"20240830172509-bkijtig","Type":"NodeParagraph","Properties":{"id":"20240830172509-bkijtig","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑦治倒睫拳毛，风痒，亦烂：木鳖子仁捶烂，以丝帛包作条，左患塞右鼻，右患塞左鼻；次服蝉蜕药为妙。（《孙天仁集效方》）"}]},{"ID":"20240830172509-n9knsbp","Type":"NodeParagraph","Properties":{"id":"20240830172509-n9knsbp","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑧治阴疝偏坠痛甚：木鳖子一个磨醋，调黄檗、芙蓉末敷之。（《寿域神方》）"}]},{"ID":"20240830172509-0i1q5qw","Type":"NodeParagraph","Properties":{"id":"20240830172509-0i1q5qw","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑨治脚气肿痛，肾脏风气，攻注下部疮痒：甘遂半两，木鳖子仁四个。为末，猪腰子一个，去皮膜，切片，同药四钱，掺在内，湿纸包煨熟，空心食之，米次下。服后便伸两足，大便行后，吃白粥二、三日。（《本事方》）"}]},{"ID":"20240830172509-5fh6osu","Type":"NodeParagraph","Properties":{"id":"20240830172509-5fh6osu","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑩治脚气肿痛：木鳖子仁，每个作两边麸炒过，切片再炒，去油尽为度，每两入厚桂半两，为末，热酒服二钱，令醉得汗。（《永类钤方》）"}]},{"ID":"20240830172509-w5cw9tf","Type":"NodeParagraph","Properties":{"id":"20240830172509-w5cw9tf","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑾治痞癣：木鳖多用（去壳），独蒜半钱，雄黄半钱。上杵为膏，入醋少许，蜡纸贴患处。（《昔济方》木鳖膏）"}]},{"ID":"20240830172509-ppf4c02","Type":"NodeParagraph","Properties":{"id":"20240830172509-ppf4c02","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⑿治疟母：木鳖子、穿山甲（炮）等分。为末，每服三钱，空心温酒下。（《医方摘要》）"}]},{"ID":"20240830172509-89xfouv","Type":"NodeParagraph","Properties":{"id":"20240830172509-89xfouv","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⒀治经络受风寒邪气，筋脉牵连，皮肤疼痛，结聚成核，拘挛麻痹：木鳖子一两（去皮，锉如小豆大，用清油二两，浸一宿，然后慢火熬及一半以来，取出木鳖子，下黄醋一钱，相搅匀，等醋化为度，绢滤去滓），乳香一钱（别研细，等木鳖子油与腊相次欲凝，急投在油内，不住手搅匀）。上以磁器收，每用少许，擦肌肉皮肤疼痛聚硬处，不住手，以极热为度。（《百一选方》木鳖子膏）"}]},{"ID":"20240830172509-ff49sfd","Type":"NodeParagraph","Properties":{"id":"20240830172509-ff49sfd","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⒁治打扑损伤，瘀血不散疼痛：木鳖子（去壳研）半两，桂（去粗皮）三分，芸台子（酒浸研）二合，丁香五十粒。上四味，将丁香、桂为末，与研者二味和匀，次用生姜汁煮米粥摊纸上，将药末量多少掺入粥内，看冷热裹之，一日一换。（《圣济总录》木鳖裹方）"}]},{"ID":"20240830172509-0lbm68s","Type":"NodeParagraph","Properties":{"id":"20240830172509-0lbm68s","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⒂治小儿疳疾：木鳖子仁、使君子仁等分。捣泥，米饮丸芥子大，每服五分，米饮下，一日二服。（《孙天仁集效方》）"}]},{"ID":"20240830172509-znqmx08","Type":"NodeParagraph","Properties":{"id":"20240830172509-znqmx08","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⒃治疳病目蒙不见物：木鳖子仁二钱，胡黄连一钱。为末，米糊丸龙眼大，入鸡子内蒸熟，连鸡子食之。（《孙天仁集效方》）"}]},{"ID":"20240830172509-fmznhog","Type":"NodeParagraph","Properties":{"id":"20240830172509-fmznhog","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"⒄治小儿久痢，肠滑脱肛：沉香二钱，枳壳半两（麸炒去瓤），五灵脂半两（微炒），木鳖子（连壳秤）半两（去壳用）。上件前三味为细末，次入木鳖于同研细，醋煮面糊为丸，如黍米大。三岁儿每服三十丸，醋调茶清送下，乳食前。（《杨氏家藏方》木鳖子丸）"}]},{"ID":"20240830172509-fy2cksr","Type":"NodeParagraph","Properties":{"id":"20240830172509-fy2cksr","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【临床应用】外用治疗牛皮癣、干癣、秃疮等有一定效果：用法：将木鳖子去外壳，蘸醋在粗瓷器上（如碗底）磨取药汁，临睡前用棉花或毛笔蘸涂患处，每日或隔日1次。涂药前患处先用盐水洗净；癣病蔓及周身者可分期分片治疗。一般1钱木鳖子仁约需10毫升醋研磨，其药汁可涂3x2厘米癣面5～7处。"}]},{"ID":"20240830172509-xmgz7vm","Type":"NodeParagraph","Properties":{"id":"20240830172509-xmgz7vm","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830172509-tfmgz78","Type":"NodeParagraph","Properties":{"id":"20240830172509-tfmgz78","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子《中华本草》"}]},{"ID":"20240830172509-pi6iu1y","Type":"NodeParagraph","Properties":{"id":"20240830172509-pi6iu1y","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【出处】出自《开宝本草》"}]},{"ID":"20240830172509-sxh8lg6","Type":"NodeParagraph","Properties":{"id":"20240830172509-sxh8lg6","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【拼音名】MùBiēZǐ"}]},{"ID":"20240830172509-922n059","Type":"NodeParagraph","Properties":{"id":"20240830172509-922n059","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【英文名】CochinchinaMomordica,CochinchinaMomordicaSeed,SeedofCochinchinaMomordica"}]},{"ID":"20240830172509-2xyg2zj","Type":"NodeParagraph","Properties":{"id":"20240830172509-2xyg2zj","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【别名】木蟹、土木鳖、壳木鳖、漏苓子、地桐子。藤桐子、鸭屎瓜子、木鳖瓜。"}]},{"ID":"20240830172509-51j8va9","Type":"NodeParagraph","Properties":{"id":"20240830172509-51j8va9","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830172509-s3ec4bp","Type":"NodeParagraph","Properties":{"id":"20240830172509-s3ec4bp","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"药材基源：为葫芦科植物木鳖子的种子。"}]},{"ID":"20240830172509-99490vw","Type":"NodeParagraph","Properties":{"id":"20240830172509-99490vw","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Momordicacochinchinensis(Lour.)Sp-reng."}]},{"ID":"20240830172509-zkxs8ke","Type":"NodeParagraph","Properties":{"id":"20240830172509-zkxs8ke","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬初采集果实，沤烂果肉，洗净种子，晒干备用。"}]},{"ID":"20240830172509-93ph2hu","Type":"NodeParagraph","Properties":{"id":"20240830172509-93ph2hu","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生粗壮大藤本，长达15m。具板状根。全株近无毛和稍被短柔毛。卷须较粗壮，光滑无毛，不分歧。叶柄粗壮，长5-10cm，初时被黄褐色柔毛，后近无毛，在基部和中部有2-4个腺体；叶生卵状心形或宽卵状圆形，质较硬，长宽均为10-20cm，3-5中裂至深裂或不分裂，叶脉掌状。雌雄异株；雄花单生于叶腑或有时3-4朵着生丰极短的总状花序梗轴上，花梗粗壮，近无毛，单生时，花梗长6-12cm，顶端有1大苞片，苞片无梗，兜状，圆肾形，两面被短柔毛，花萼筒漏斗状，裂片宽披针形或长圆形，花冠黄色，裂片卵状长圆形，密被长柔毛，基部有齿状黄色腺体，外面2枚稍大，内面3枚较小，基部有墨斑，雄蕊3，2枚2室，1枚1室；雌花单生于叶腋，花梗长5-10cm，近中部生1苞片，苞片兜状，长宽均为2mm，花冠花萼同雄花，子房卵状长圆形，长约1cm，密生刺状毛。果实卵球形，先端有1短喙，基部近圆形，长达12-15cm，成熟时红色，肉质，密生3-4mm的刺状突起。种子多数，卵形或方形，干后黑褐色，长26-35mm，宽20-38mm，厚5-6mm，边缘有齿，两面稍共起，具雕纹。花期6-8月，果期8-10月。"}]},{"ID":"20240830172509-zuy5j04","Type":"NodeParagraph","Properties":{"id":"20240830172509-zuy5j04","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830172509-f097yzp","Type":"NodeParagraph","Properties":{"id":"20240830172509-f097yzp","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"生态环境：常生于海拔450-1100m的山沟、木缘和路旁。"}]},{"ID":"20240830172509-5jcwafq","Type":"NodeParagraph","Properties":{"id":"20240830172509-5jcwafq","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于安徽、浙江、江西、福建、台湾、广东、广西、湖南、四川、贵州、云南和西藏。"}]},{"ID":"20240830172509-tvuepug","Type":"NodeParagraph","Properties":{"id":"20240830172509-tvuepug","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830172509-0di9va1","Type":"NodeParagraph","Properties":{"id":"20240830172509-0di9va1","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖潮湿的气候和向阳的环境。对土壤条件要求不严，宜选择排水良好、肥沃深厚的砂质壤土栽培。"}]},{"ID":"20240830172509-p6vwso4","Type":"NodeParagraph","Properties":{"id":"20240830172509-p6vwso4","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子和根头繁殖法。种子繁殖直播法：3月播种，按行株距2m×1.5m开穴下种，每穴播各3-5粒，覆土2-3cm，播后浇水保湿。根头繁殖法：11月至翌年2月，将雌株根头挖起，按根上的芽数，切成若干块，每块必带有芽1-2个，作种根，按上法穴栽，每穴种1-2块。"}]},{"ID":"20240830172509-tqfbjtc","Type":"NodeParagraph","Properties":{"id":"20240830172509-tqfbjtc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"田间管理苗期松土、除草、追肥各1-2次。苗高60-80cm时，及时搭棚架，插竹枝引蔓上棚。用种子繁殖的植株，于开花时将大部分雄株拔除，仅保留少数雄株，以供授粉。每年萌芽前、开花期、藤蔓枯萎时，各种耕除草、追肥1次，追肥以厩肥、人畜类和复合肥为主。"}]},{"ID":"20240830172509-ernt8kx","Type":"NodeParagraph","Properties":{"id":"20240830172509-ernt8kx","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830172509-yop088g","Type":"NodeParagraph","Properties":{"id":"20240830172509-yop088g","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"性状鉴定：种子略呈扁平圆板状，中间稍隆起，直径约2-3cm,厚约5mm。表面灰褐色或灰黑色,粗糙，有凹陷的网状花纹，周边两侧均有十数个相对的锯齿状突起。外种皮质坚而脆，内种皮薄膜状，表面灰绿色，绒毛样,其内为二片大形肥厚子叶，黄白色，富油质，有特殊的油腻气，味苦。以籽粒饱满、不破裂、体重、内仁黄白色、不泛油者为佳。"}]},{"ID":"20240830172509-kvx3s7i","Type":"NodeParagraph","Properties":{"id":"20240830172509-kvx3s7i","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"显微鉴定：粉末：灰棕色。"}]},{"ID":"20240830172509-t10h7w2","Type":"NodeParagraph","Properties":{"id":"20240830172509-t10h7w2","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"1.外种皮表皮细胞断面观略呈栅状，外被角质层，细胞长短不一，侧壁微弯曲或波状弯曲；表面观多角形或类方形，垂周壁较平直或稍弯曲。"}]},{"ID":"20240830172509-e7vz3sl","Type":"NodeParagraph","Properties":{"id":"20240830172509-e7vz3sl","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"2.种皮下皮细胞较小，壁厚，胞腔内含灰棕色物。"}]},{"ID":"20240830172509-hewrprc","Type":"NodeParagraph","Properties":{"id":"20240830172509-hewrprc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.星状厚壁细胞不规则分枝状，相互连结成团，界限不甚分明，分枝端较平截，壁稍厚，木化，胞腔不规则，有孔沟。"}]},{"ID":"20240830172509-y6gtsw6","Type":"NodeParagraph","Properties":{"id":"20240830172509-y6gtsw6","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"4.外种皮内表皮石细胞形大，形状不规则，多延长，界限不甚分明，壁波状弯曲，层纹清晰，孔沟不明显。"}]},{"ID":"20240830172509-ynutbsp","Type":"NodeParagraph","Properties":{"id":"20240830172509-ynutbsp","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"5.内种皮星状薄壁细胞不规则分枝，壁薄或稍厚，微木化，孔沟不明显，有的具类方形纹孔。此外，子叶细胞含糊粉粒及脂肪油滴。本品以饱满、外壳无破裂、种仁色黄白者为佳。"}]},{"ID":"20240830172509-hd27lpw","Type":"NodeParagraph","Properties":{"id":"20240830172509-hd27lpw","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"显微鉴别种子横切面：种皮的表皮细胞1层，近长方形，常径向延长，壁薄；表皮下为3-4层薄壁细胞，近方形或短圆形，较小，排列整齐，内侧为十数层近圆形或形状不规则的厚壁细胞，大而壁极厚，边缘波状，层纹较明显；其内为3-4层长方形或长圆形薄壁细胞，壁常呈波状，种子两侧的细胞壁渐增厚，至两端处细胞壁增厚成纵向延长的石细胞，横切面呈圆形。胚乳薄壁细胞2至多层，其中有的部分已颓废，子叶薄壁组织中充满糊粉粒。"}]},{"ID":"20240830172509-8q4zr8k","Type":"NodeParagraph","Properties":{"id":"20240830172509-8q4zr8k","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"粉末特征：灰黄色或浅棕黄色。①厚壁细胞有两种：一种棕黄色，不规则椭圆形或矩圆形，边缘多深波状，长50-338μm，宽45-143μm，壁厚9-50μm，木化，有层纹，胞腔狭窄或几无胞腔。另一种呈条状或棒状，长100-270μm，直径约25μm壁厚约10μm，边缘深波状。②子叶薄壁细胞五角形或六角形，充满糊粉料和脂肪油块，脂肪油块类圆形，表面可见网状纹理。"}]},{"ID":"20240830172509-5wtxop2","Type":"NodeParagraph","Properties":{"id":"20240830172509-5wtxop2","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【化学成份】种子含木鳖子皂甙（momordicasaponin)Ⅰ及Ⅱ，它们分别是棉根皂甙元（gypsogenin)和皂皮酸（quillaicacid)的3-O-β-D-吡喃半乳糖基（1→2）-β-D-吡喃葡萄糖基（1→3）-[β-D-吡喃木糖基（1→4）]-α-L-吡喃鼠李糖基（1→2）-β-D-吡喃岩藻糖甙"}]},{"ID":"20240830172509-js8i87a","Type":"NodeParagraph","Properties":{"id":"20240830172509-js8i87a","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830172509-yarcf3k","Type":"NodeParagraph","Properties":{"id":"20240830172509-yarcf3k","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"水浸液.乙醇-水浸出液和乙醇浸出液，试验于狗、猫及兔等麻醉动物，有降压作用。但毒性较大，无论静脉或肌肉注射，动物均于数日内死亡。大鼠静脉注射木鳖子皂甙，血压暂时下降，呼吸短暂兴奋，心搏加快。注射于狗股动脉可暂时增加下肢血流量，其作用强度约为罂粟碱的1/8。对离体蛙心和离体兔十二指肠均为抑制作用，而对豚鼠回肠则能加强乙酰胆碱的作用、拮抗罂粟碱的作用,高浓度时且引起不可逆性收缩。大鼠口服或皮下注射木鳖子皂甙，能显着抑制角叉菜胶引起的足臊浮肿。对兔红细胞有溶血作用。"}]},{"ID":"20240830172509-4be0vic","Type":"NodeParagraph","Properties":{"id":"20240830172509-4be0vic","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"种子的皂甙：6.6mg/kg给大鼠静脉注射可致短暂的呼吸兴奋和血压下降，并能增加狗后肢末梢血管的血流，对离体蛙心有抑制作用；2×10（-4）g/ml浓度能增加乙酰胆碱对豚鼠回肠的兴奋作用；灌胃或皮下注射对角叉菜胶引起的大鼠足部肿胀炎症有抑制作用；有溶血作用；对小鼠的半数致死量静脉注射为32.35mg/kg，腹腔注射为37.34mg/kg。"}]},{"ID":"20240830172509-4vgx5rs","Type":"NodeParagraph","Properties":{"id":"20240830172509-4vgx5rs","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"木鳖子提取物对麻醉狗，猫及兔等有降压作用，大鼠静脉注射木鳖子皂甙，可使血压暂时下降，心搏加快，呼吸短暂兴奋。注射于狗股动脉可暂时增加下肢血流量，其作用强度约为罂粟碱的1/8。另外具有抗炎及溶血作用。"}]},{"ID":"20240830172509-6iohkuc","Type":"NodeParagraph","Properties":{"id":"20240830172509-6iohkuc","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【毒性】小鼠静脉注射木鳖子皂甙半数致死量为32.35mg/kg，腹腔注射则为37.34mg/kg。木鳖子毒性较大，无论动脉或静脉给药。动物均于数天内死亡，小鼠静脉注射的半数致死量为32.35mg/kg，腹腔注射则为37.34mg/kg。"}]},{"ID":"20240830172509-dhnyw8l","Type":"NodeParagraph","Properties":{"id":"20240830172509-dhnyw8l","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别（1）取本品粗粉2g，加已醚20ml，温浸30min，滤过。取醚液2ml，置玻璃皿中，按去已醚，残渣加无水硫酸钠少量，直接加热，发生所泡及具刺激性的浓白色气体。（检查油脂）（2）取本品粗粉2g，加水20ml，置水浴中热30min，滤过。取带塞试管2支，各加滤液1ml，一管加5%氢氧化钠溶液2ml。另管加5%盐酸深液2ml，密塞，用力振摇1min，两管产生高度相近的大量蜂窝状泡沫。（检查三匝萜皂甙）"}]},{"ID":"20240830172509-s5z3a8z","Type":"NodeParagraph","Properties":{"id":"20240830172509-s5z3a8z","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830172509-kirdsg6","Type":"NodeParagraph","Properties":{"id":"20240830172509-kirdsg6","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"1.净制：除去杂质，洗净，晒干，用时连壳打碎，或去壳取仁。"}]},{"ID":"20240830172509-pgnqfpg","Type":"NodeParagraph","Properties":{"id":"20240830172509-pgnqfpg","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"2.切制：取仁捣碎。"}]},{"ID":"20240830172509-fqr2b6r","Type":"NodeParagraph","Properties":{"id":"20240830172509-fqr2b6r","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.炮炙：3.1.取净仁，炒热，研末，用纸包裹加压去油。"}]},{"ID":"20240830172509-ypsbl3k","Type":"NodeParagraph","Properties":{"id":"20240830172509-ypsbl3k","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.2.炒制：取木鳖子，除去外壳，取净仁，用清炒法炒焦，以青烟尽，白烟初起为度，取出，放冷，用时研碎。"}]},{"ID":"20240830172509-uy12ogf","Type":"NodeParagraph","Properties":{"id":"20240830172509-uy12ogf","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.3.煨制：将净木鳖子放入炒热的净木材炭中，用慢火（100-150度）炒至外壳干裂有响声，外皮呈焦黄色时，去净硬壳，取出晾凉，捣碎。"}]},{"ID":"20240830172509-q4fen8x","Type":"NodeParagraph","Properties":{"id":"20240830172509-q4fen8x","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.4.烫制：取净仁与制油砂拌炒，用文火炒至老黄色，取出，去砂，研细。"}]},{"ID":"20240830172509-9aydl52","Type":"NodeParagraph","Properties":{"id":"20240830172509-9aydl52","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；温；无毒"}]},{"ID":"20240830172509-d9mn4ra","Type":"NodeParagraph","Properties":{"id":"20240830172509-d9mn4ra","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【归经】归肝；脾；胃经"}]},{"ID":"20240830172509-o7lq3lr","Type":"NodeParagraph","Properties":{"id":"20240830172509-o7lq3lr","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【功能主治】消肿散结；解毒；追风止痛。主痈肿；疔疮；无名肿毒；痔疮；癣疮；粉刺；默黑；乳腺炎；淋巴结结核；痢疾；风湿痹痛；筋脉拘挛；牙龈肿痛"}]},{"ID":"20240830172509-j5t86xd","Type":"NodeParagraph","Properties":{"id":"20240830172509-j5t86xd","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.6-1.2g多入丸、散。久用：适量，研末调醋敷、磨汁涂或水熏洗。"}]},{"ID":"20240830172509-4g6y86n","Type":"NodeParagraph","Properties":{"id":"20240830172509-4g6y86n","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240830172509-aqei9m8","Type":"NodeParagraph","Properties":{"id":"20240830172509-aqei9m8","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"孕妇及体虚者忌服。"}]},{"ID":"20240830172509-vi9dn4x","Type":"NodeParagraph","Properties":{"id":"20240830172509-vi9dn4x","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"1.《本草汇言》：胃虚、大肠不实、元真亏损者，不可概投。"}]},{"ID":"20240830172509-cd19lym","Type":"NodeParagraph","Properties":{"id":"20240830172509-cd19lym","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"2.《医林纂要》：忌猪肉。"}]},{"ID":"20240830172509-fmsz9po","Type":"NodeParagraph","Properties":{"id":"20240830172509-fmsz9po","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【附方】1.乌龙膏(《医宗金鉴》)：木鳖子(去壳)二两，草乌半两，小粉四两，半夏二两。上四味于铁铫内，慢火烧焦，黑色为度，研细，以新汲水调敷，一日一次，自外向里涂之，须留疮顶，令出毒气，用治一切诸毒，红肿赤晕不消者。2.神效千捶膏(《医宗金鉴》)：土木鳖(去壳)五上，白嫩松香(拣净)四两，铜绿研细一钱，乳香，没药各二钱，蓖麻子去壳)七钱，巴豆肉五粒，杏仁(去皮)一钱，上八味合一处，石臼内捣三千余下，即成膏，即起；浸凉水中。用时随疮大小，用手搓成薄片，贴疮上，用绢盖之。用治疮疡，疔毒初起，瘰疬，臁疮，小儿蟺拱头。3.治耳肿痛方(《圣惠方》)：木鳖子仁一两(研如膏)，赤小豆末半两，川大黄末半两。上药同研令匀，水、生油旋调涂之。用治两耳卒肿热痛。4.木鳖膏(《仁斋直指方》)：木鳖仁二个(厚纸拭去油，研碎)以乌鸡子调和，磁盏盛之，甑内蒸熟。每日食后服一次，服半月。用治瘰疬发歇无已。5.治痔疮方(《普济方》)：荆芥，木鳖子，朴硝各等分。上煎汤入于瓶内，熏后，汤温洗之。用治痔疮。6.治丹瘤方(《外科精义》)：木鳖子新者去壳，研如泥，淡醋调敷之，一日三，五次。用治小儿丹瘤。7.治阴疝方(《寿域神方》)：木鳖子一个磨醋，调黄柏，鞭蓉末敷之。用治阴疝偏坠痛甚。8.治脚气方(《本事方》)甘遂半两，木鳖子仁四个。为末，猪腰子一个，去皮膜，切片，同药四钱，掺在内，湿纸包煨熟，空心食之，米饮下。服后便伸两足，大便行后，吃白粥二、三日。用治脚气肿痛，肾脏风气，攻注下部疮痒。9.治脚气方(《永类钤方》)：木鳖子仁，每个作两边麸炒过，切片再炒，去油尽为度，每两入厚桂半两，为末，热酒服二钱。令醉得汗。治脚气肿痛。10.木鳖膏(《普济方》)木鳖多用(去壳)，独蒜半钱，雄黄半钱，上杵为膏，入醋少许，蜡纸贴患处。用治痞癖。11.治疟母方(《医方摘要》)：木鳖子、穿山甲(炮)等为末，每服三钱，空心温酒下。治疟母。12.木鳖子膏(《百一选方》)：木鳖子一两(去皮，锉如小豆大，用清油二两，浸一宿，然后慢火熬及一半以来，取出木鳖子，下黄醋一钱，相搅匀，等醋化为度，绢滤去滓)，乳香一钱(别研细，等木鳖子油与腊相次欲凝，急投在油内，不住手搅匀)。上以磁器收，每用少许，擦肌肉皮肤疼痛聚硬处，不住手，以极热为度，。用治经络受风寒邪气，筋脉牵连，皮肤疼痛，结聚成核，铁路挛麻痹。13.木鳖裹方(《圣济总录》)：木鳖子(去壳)半两，桂(去粗皮)三分，芸苔子(酒浸研)二合，丁香五十粒。上四味，将6∠悖鹞胙姓叨逗驮龋斡蒙竺字嗵缴希┠┝慷嗌俨羧胫嗄冢蠢淙裙蝗找换弧Ｓ弥蔚怂鹕耍鲅簧⑻弁础?4.治疳疾方(《孙天仁集效方》)：木鳖子仁，使君子仁等分。捣泥，米饮丸，芥子大，每服五分，米饮下，一日二服。用治小儿疳疾。15.治疳病目蒙不视物方(《孙天仁集效方》)：木鳖子仁二钱，胡黄连一钱，为末，米糊丸龙眼大，入鸡子内蒸熟，连鸡子食之。用治疳病目蒙不视物。16.木鳖子丸(《杨氏家藏方》)沉香二钱，枳壳半两(麸炒去瓤)，五灵脂半两(微炒)，木鳖子(连壳秤)半两(去壳用)，上件前三味为细末，次入木鳖子同研细，醋煮面糊为丸，如黍米大。三岁儿每服三十丸，醋调茶清送下，乳食前。治小儿久痢，肠滑脱肛。"}]},{"ID":"20240830172509-iegl21p","Type":"NodeParagraph","Properties":{"id":"20240830172509-iegl21p","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830172509-6ei734j","Type":"NodeParagraph","Properties":{"id":"20240830172509-6ei734j","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"1.《日华子本草》：醋摩消肿毒。"}]},{"ID":"20240830172509-nkxl0fh","Type":"NodeParagraph","Properties":{"id":"20240830172509-nkxl0fh","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"2.《开宝本草》：主折伤，消结肿恶疮，生肌，止腰痛，除粉刺野黯，妇人乳痈，肛门肿痛。"}]},{"ID":"20240830172509-v9rpzjz","Type":"NodeParagraph","Properties":{"id":"20240830172509-v9rpzjz","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：治疳积痞块，利大肠泻痢，痔瘤瘰疬。"}]},{"ID":"20240830172509-jz6jk28","Type":"NodeParagraph","Properties":{"id":"20240830172509-jz6jk28","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"4.《本草备要》：泻热，外用治疮，利大肠，治泻痢疳积。瘰疬疮痔，乳痈，蚌毒。消肿追毒，生肌除GAN。"}]},{"ID":"20240830172509-hzfgnae","Type":"NodeParagraph","Properties":{"id":"20240830172509-hzfgnae","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"5.《本草求原》：治一切寒湿郁热而为痛风瘫痪。行痹、痿厥、脚气、挛症、鹤膝。"}]},{"ID":"20240830172509-crajzgl","Type":"NodeParagraph","Properties":{"id":"20240830172509-crajzgl","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"6.《本草经疏》：木鳖子，为散血热、除痈毒之要药。夫结肿恶疮，粉刺GAN黯，肛门肿痛，妇人乳痈等证，皆血热所致。折伤则血亦瘀而发热。甘温能通行经络，则血热散，血热散则诸证无不瘳矣。其止腰痛者，盖指湿热客于下部所致，而非肾虚为病之比也，用者详之。味虽甘而气则大温，《本经》虽云无毒，然亦未免有毒，但宜外用，匆宜内服。"}]},{"ID":"20240830172509-lhdpb9i","Type":"NodeParagraph","Properties":{"id":"20240830172509-lhdpb9i","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"7.《本草正》：木鳖子，有大毒，《本草》言其甘温无毒，谬也，今见毒狗者，能毙之于顷刻，使非大毒而有如是乎？人若食之，则中寒发噤，不可解救，若其功用，则惟以醋磨，用敷肿毒乳痈，痔漏肿痛及喉痹肿痛，因此醋漱于喉间，引痰吐出，以解热毒，不可咽下。或同朱砂、艾叶卷筒熏疥，杀虫最效，或用熬麻油，擦癣亦佳。"}]},{"ID":"20240830172509-bb3qz93","Type":"NodeParagraph","Properties":{"id":"20240830172509-bb3qz93","updated":"20240830172607"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830172510-sw4f5nv","Type":"NodeThematicBreak","Properties":{"id":"20240830172510-sw4f5nv","updated":"20240830172607"}},{"ID":"20240830172511-7w8i6p9","Type":"NodeParagraph","Properties":{"id":"20240830172511-7w8i6p9","updated":"20240830172607"}}]}