{"ID":"20240206101701-cb8xcsi","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240206101701-cb8xcsi","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206101701-cb8xcsi\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206101715-p4509h0\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240206101710-i18m2qz\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206101715-p4509h0\u0026quot;,\u0026quot;focusStart\u0026quot;:165,\u0026quot;focusEnd\u0026quot;:165\u0026#125;","title":"南鹤虱（野胡萝卜）","type":"doc","updated":"20240830162940"},"Children":[{"ID":"20240206101715-p4509h0","Type":"NodeParagraph","Properties":{"id":"20240206101715-p4509h0","updated":"20240206101718"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于江苏、河南、湖北、浙江等地区。\n【性状】\t本品为双悬果，呈椭圆形，多裂为分果。表面淡绿棕色或棕黄色，顶端有花柱残基，基部钝圆，背面隆起，具4条窄翅状次棱。翅上密生1列黄自色钩刺，次棱间的四下处有不明显的主棱，其上散生短柔毛，接合面平坦。有3条脉纹，上具柔毛。种仁类自色，有油性。体轻。搓碎时有特异香气，味微辛、苦。\n【性味】\t苦、辛，平。\n【功效】\t杀虫消积。用于蛔虫、蛲虫 、绦虫病，虫积腹痛、小儿疳积。"}]},{"ID":"20240206101710-i18m2qz","Type":"NodeParagraph","Properties":{"id":"20240206101710-i18m2qz","updated":"20240206101722"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206101710-6ik4wfb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710153632-2zh8iip","Type":"NodeParagraph","Properties":{"id":"20240710153632-2zh8iip","updated":"20240710153724"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 506px;","style":"width: 496px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南鹤虱"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南鹤虱-20240710153632-flq2gty.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 496px;\" parent-style=\"width: 506px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 668px;","style":"width: 658px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南鹤虱 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南鹤虱 1-20240710153724-czxa4jw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 658px;\" parent-style=\"width: 668px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710161603-5jc3h27","Type":"NodeParagraph","Properties":{"id":"20240710161603-5jc3h27","updated":"20240710161636"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 380px;","style":"width: 370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南鹤虱 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南鹤虱 12-20240710161603-wdpldl1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 370px;\" parent-style=\"width: 380px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 422px;","style":"width: 412px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南鹤虱 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南鹤虱 13-20240710161636-aj1w9s0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 412px;\" parent-style=\"width: 422px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710154507-2h43xyx","Type":"NodeParagraph","Properties":{"id":"20240710154507-2h43xyx","updated":"20240807170841"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImag