e":"width: 596px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子5-20240619163729-ootvfmx.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 596px;\" parent-style=\"width: 606px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710153647-xn31lm0","Type":"NodeParagraph","Properties":{"id":"20240710153647-xn31lm0","updated":"20240710155444"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 736px;","style":"width: 726px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南鹤虱 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南鹤虱 7-20240710154908-k63oa43.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 726px;\" parent-style=\"width: 736px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710155444-ckfk36w.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807170849-bhneul4","Type":"NodeParagraph","Properties":{"id":"20240807170849-bhneul4","updated":"20240807170849"}},{"ID":"20240710155500-2z6emdx","Type":"NodeParagraph","Properties":{"id":"20240710155500-2z6emdx","updated":"20240710155517"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野胡萝卜与蛇床对比"}]},{"ID":"20240710155558-ewntly1","Type":"NodeParagraph","Properties":{"id":"20240710155558-ewntly1","updated":"20240710155619"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710155558-9zp0bt3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710155619-6oahd52.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710155112-3dr1l54","Type":"NodeParagraph","Properties":{"id":"20240710155112-3dr1l54","updated":"20240807170905"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：南鹤虱与蛇床子较为相似，两者区别在于——南鹤虱茎上有粗硬毛，蛇床茎上没有毛；南鹤虱结果以后边缘花序轴向内卷曲，而蛇床没有卷曲；野胡萝卜果实上有刺，蛇床果实上没有刺。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205170447-7pc6ibu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"074蛇床子"}]},{"ID":"20240710155112-av85gls","Type":"NodeThematicBreak","Properties":{"id":"20240710155112-av85gls"}},{"ID":"20240830162932-rh4wiig","Type":"NodeParagraph","Properties":{"id":"20240830162932-rh4wiig","updated":"20240830162940"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：野胡萝卜根"}]},{"ID":"20240830162932-c4sumn1","Type":"NodeParagraph","Properties":{"id":"20240830162932-c4sumn1","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"野胡萝卜根"}]},{"ID":"20240830162932-cnuveyq","Type":"NodeParagraph","Properties":{"id":"20240830162932-cnuveyq","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【拼音名】YěHúLuóBoGēn"}]},{"ID":"20240830162932-9fkgq1r","Type":"NodeParagraph","Properties":{"id":"20240830162932-9fkgq1r","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【英文名】DaucuscarotaL."}]},{"ID":"20240830162932-cy82x24","Type":"NodeParagraph","Properties":{"id":"20240830162932-cy82x24","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【别名】鹤虱风根"}]},{"ID":"20240830162932-1mndkbw","Type":"NodeParagraph","Properties":{"id":"20240830162932-1mndkbw","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830162932-b7b26n5","Type":"NodeParagraph","Properties":{"id":"20240830162932-b7b26n5","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"药材基源：为伞形科植物野胡萝卜的根。"}]},{"ID":"20240830162932-xfqdnk4","Type":"NodeParagraph","Properties":{"id":"20240830162932-xfqdnk4","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：DaucuscarotaL."}]},{"ID":"20240830162932-fpd9f3s","Type":"NodeParagraph","Properties":{"id":"20240830162932-fpd9f3s","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春季未开花前采挖，去其茎叶，洗净，晒干或鲜用。"}]},{"ID":"20240830162932-hq9kjc9","Type":"NodeParagraph","Properties":{"id":"20240830162932-hq9kjc9","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【原形态】二年生草本，高20-120cm。全株被白色粗硬毛。根细圆锥形，肉质，黄白色。基生叶薄膜质，长圆形，二至三回羽状全裂，末回裂片线形或披针形，长2-15mm，宽0.5-4mm，先端尖，有小尖头，光滑或有糙硬毛；叶柄长3-12cm；茎生叶近无柄，有叶鞘，末回裂片小而细长。复伞形花序顶生，花序梗长10-55cm，有糙硬毛；总苞片多数，叶状，羽状分裂，裂片线形，长3-30mm；伞辐多数，结果时外缘的伞辐向内弯曲；小总苞片5-7，线形，不分裂或2-3裂，边缘膜质，具纤毛；花通常白色，有时带淡红色。双悬果长卵形，长3-4mm，宽2mm，具棱，棱上有翅，棱上有短钩刺或白色刺毛。花期5-7月，果期6-8月。"}]},{"ID":"20240830162932-l9damq5","Type":"NodeParagraph","Properties":{"id":"20240830162932-l9damq5","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【化学成份】根富含胡萝卜素(carotene)，并含挥发油。挥发油中主成分为蒎烯(pinene)，柠檬烯(limonene)，胡萝卜醇(daucol)，胡萝卜次醇(carotol)，细辛醚(asarone)，细辛醇(asary-laldehyde)等。此外，根中还含胡萝卜酸(daucicacid)。"}]},{"ID":"20240830162932-7amw8is","Type":"NodeParagraph","Properties":{"id":"20240830162932-7amw8is","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【药理作用】本品所含胡萝卜素即维生素原元等，有营养价值，食入过多含胡萝卜素的植物，可发生所谓胡萝卜素血症（carotinemia），即皮肤发黄，但对人体无害。"}]},{"ID":"20240830162932-2awdfcp","Type":"NodeParagraph","Properties":{"id":"20240830162932-2awdfcp","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；微辛；性凉"}]},{"ID":"20240830162932-4e82iwo","Type":"NodeParagraph","Properties":{"id":"20240830162932-4e82iwo","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【归经】归脾；胃；肝经"}]},{"ID":"20240830162932-7o24cem","Type":"NodeParagraph","Properties":{"id":"20240830162932-7o24cem","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【功能主治】健脾化滞；凉肝止血；清热解毒。主脾虚食少；腹泻；惊风；逆血；血淋；咽喉肿痛"}]},{"ID":"20240830162932-h8w3kdu","Type":"NodeParagraph","Properties":{"id":"20240830162932-h8w3kdu","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g。外用：适量，捣汁涂。"}]},{"ID":"20240830162932-62q8ecv","Type":"NodeParagraph","Properties":{"id":"20240830162932-62q8ecv","updated":"20240830162939"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830162932-la9lkei","Type":"NodeThematicBreak","Properties":{"id":"20240830162932-la9lkei","updated":"20240830162939"}},{"ID":"20240830162933-587smpm","Type":"NodeParagraph","Properties":{"id":"20240830162933-587smpm","updated":"20240830162939"}}]}