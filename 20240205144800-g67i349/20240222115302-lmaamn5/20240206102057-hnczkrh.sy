tyle":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橄榄 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橄榄 5-20240729142208-zc7qu1i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729152801-f93wxnd","Type":"NodeParagraph","Properties":{"id":"20240729152801-f93wxnd","updated":"20240729152801"}},{"ID":"20240729152801-x0phntp","Type":"NodeParagraph","Properties":{"id":"20240729152801-x0phntp","updated":"20240903090949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橄榄、油橄榄对比"}]},{"ID":"20240729153300-pocg6vq","Type":"NodeParagraph","Properties":{"id":"20240729153300-pocg6vq","updated":"20240729153303"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为橄榄"}]},{"ID":"20240729152805-j34e39q","Type":"NodeParagraph","Properties":{"id":"20240729152805-j34e39q","updated":"20240729153530"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 822px;","style":"width: 812px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橄榄 (26)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橄榄 26-20240729152805-p2v87jb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 812px;\" parent-style=\"width: 822px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 469px;","style":"width: 459px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橄榄 (27)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橄榄 27-20240729153530-hn3yyxt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 459px;\" parent-style=\"width: 469px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729152809-ukcd1wd","Type":"NodeParagraph","Properties":{"id":"20240729152809-ukcd1wd","updated":"20240729153310"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为油橄榄"}]},{"ID":"20240729153050-74cqnvz","Type":"NodeParagraph","Properties":{"id":"20240729153050-74cqnvz","updated":"20240729153250"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"油橄榄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/油橄榄-20240729153050-37g72te.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 670px;","style":"width: 660px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"油橄榄 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/油橄榄 1-20240729153250-bckkktp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 660px;\" parent-style=\"width: 670px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729153054-nipe4lp","Type":"NodeParagraph","Properties":{"id":"20240729153054-nipe4lp","updated":"20240903091011"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：橄榄油并不是橄榄榨的，而是‘油橄榄’榨的，橄榄和油橄榄是两种东西（相比橄榄，油橄榄的叶子更狭细些）；"}]},{"ID":"20240729141554-xbesz5l","Type":"NodeThematicBreak","Properties":{"id":"20240729141554-xbesz5l"}},{"ID":"20240903091034-isuuzab","Type":"NodeParagraph","Properties":{"id":"20240903091034-isuuzab","updated":"20240903091041"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：橄榄"}]},{"ID":"20240903091034-zm6k4i9","Type":"NodeParagraph","Properties":{"id":"20240903091034-zm6k4i9","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"橄榄《*辞典》"}]},{"ID":"20240903091034-rrb2r49","Type":"NodeParagraph","Properties":{"id":"20240903091034-rrb2r49","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【出处】《日华子本草》"}]},{"ID":"20240903091034-0x78jbc","Type":"NodeParagraph","Properties":{"id":"20240903091034-0x78jbc","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【拼音名】GǎnLǎn"}]},{"ID":"20240903091034-3zf3cmh","Type":"NodeParagraph","Properties":{"id":"20240903091034-3zf3cmh","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【别名】橄榄子（《南州异物志》），橄棪（孟诜），忠果（《记事珠》），青果（《宛陵集》），青子（《东坡诗集》），谏果（《齐东野语》），青橄榄（《海槎余录》），白榄（《广东新语》），黄榄、甘榄（《陆川本草》）。"}]},{"ID":"20240903091034-rwg9hsb","Type":"NodeParagraph","Properties":{"id":"20240903091034-rwg9hsb","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【来源】为橄榄科植物橄榄的果实。果实成熟后采摘，晒干或阴干，或用盐水浸渍后晒干。"}]},{"ID":"20240903091034-zl5aena","Type":"NodeParagraph","Properties":{"id":"20240903091034-zl5aena","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高10米以上。树皮淡灰色，平滑；幼芽、新生枝、叶柄及叶轴均被极短的柔毛，有皮孔。单数羽状复叶互生，长15～30厘米；小叶11～15片，对生，矩圆状披针形，长6～15厘米，宽2.5～5厘米，先端渐尖，基部偏斜，全缘，秃净，网脉两面均明显，下面网脉上有小窝点，略粗糙。圆锥花序顶生或腋生，与叶等长或略短；萼杯状，通常3裂，很少5裂；花瓣3～5枚，白色，芳香，长约为萼之2倍；雄蕊6枚；雌蕊1枚，子房上位。核果卵形，长约3厘米，初时黄绿色，后变黄白色，有皱纹。硬核内有种子1～3颗。花期5～7月。果期8～10月。"}]},{"ID":"20240903091034-7svfl0c","Type":"NodeParagraph","Properties":{"id":"20240903091034-7svfl0c","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【生境分布】分布广东、广西、福建、四川、云南、台湾等地。产广东、广西、福建、四川等地。"}]},{"ID":"20240903091034-vk7lhi2","Type":"NodeParagraph","Properties":{"id":"20240903091034-vk7lhi2","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【性状】鲜橄榄：呈梭形，两端钝圆，或渐尖，长可达3～4厘米，粗约1.5～2厘米。外表碧绿或黄绿色，时日较久者呈乌黄色，平滑，微带光泽。顶端有细小黑色的突起，基部有果柄痕迹。果肉颇厚实，内面黄白而多汁液。果核呈梭形，棕褐色，具6条棱线；质坚硬不易碎。核的横切面可见3个孔洞，其中各有一粒细长梭形的种子；种皮红棕色，种仁白色，油润，有香气，无臭，味涩微酸，嚼之有回甜。以个大、肉厚、色青绿者为佳。干橄榄：外形同上，外表棕褐色或紫棕色，皱缩，有多数凹凸不平的皱纹。果肉较薄，棕褐色或灰棕色，质坚韧，可与果核分离，内核性状与鲜者无异。味甜，酸涩味较差。以个大、肉厚；色灰绿、无乌黑斑者为佳。"}]},{"ID":"20240903091034-8n24t50","Type":"NodeParagraph","Properties":{"id":"20240903091034-8n24t50","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含蛋白质1.2％，脂肪1.09％，碳水化物12％，钙0.204％，磷0.046％，铁0.0014％，抗坏血酸0.02％。种子含挥发油7～8％，以及香树脂醇等。"}]},{"ID":"20240903091034-5x90w67","Type":"NodeParagraph","Properties":{"id":"20240903091034-5x90w67","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903091034-ms9b9l4","Type":"NodeParagraph","Properties":{"id":"20240903091034-ms9b9l4","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"甘涩酸，平。"}]},{"ID":"20240903091034-2czxdbi","Type":"NodeParagraph","Properties":{"id":"20240903091034-2czxdbi","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"①《本草衍义》：\"味涩，久食则甘。\""}]},{"ID":"20240903091034-w4dyapi","Type":"NodeParagraph","Properties":{"id":"20240903091034-w4dyapi","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"味甘酸，性平。\""}]},{"ID":"20240903091034-c91sh7p","Type":"NodeParagraph","Properties":{"id":"20240903091034-c91sh7p","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"味甘涩，性寒。\""}]},{"ID":"20240903091034-29s421b","Type":"NodeParagraph","Properties":{"id":"20240903091034-29s421b","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240903091034-purlxjn","Type":"NodeParagraph","Properties":{"id":"20240903091034-purlxjn","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"入肺、胃经。"}]},{"ID":"20240903091034-81hvc78","Type":"NodeParagraph","Properties":{"id":"20240903091034-81hvc78","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾、胃二经。\""}]},{"ID":"20240903091034-qdkl8ni","Type":"NodeParagraph","Properties":{"id":"20240903091034-qdkl8ni","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手太阴、足阳明经。\""}]},{"ID":"20240903091034-vxsbuln","Type":"NodeParagraph","Properties":{"id":"20240903091034-vxsbuln","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾、肺三经。\""}]},{"ID":"20240903091034-c1ugcxu","Type":"NodeParagraph","Properties":{"id":"20240903091034-c1ugcxu","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903091034-0j9lwn8","Type":"NodeParagraph","Properties":{"id":"20240903091034-0j9lwn8","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"清肺，利咽，生津，解毒。治咽喉肿痛，烦渴，咳嗽吐血，菌痢，癫痫，解河豚毒及酒毒。"}]},{"ID":"20240903091034-9j6ycpc","Type":"NodeParagraph","Properties":{"id":"20240903091034-9j6ycpc","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"①孟诜：\"主河豚毒，汁服之。\""}]},{"ID":"20240903091034-zouhp3k","Type":"NodeParagraph","Properties":{"id":"20240903091034-zouhp3k","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"开胃，下气，止泻。\""}]},{"ID":"20240903091034-clzk6dc","Type":"NodeParagraph","Properties":{"id":"20240903091034-clzk6dc","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"主消酒。\""}]},{"ID":"20240903091034-7ql0qwv","Type":"NodeParagraph","Properties":{"id":"20240903091034-7ql0qwv","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"④《本草衍义》：\"嚼汁咽治鱼鲠。\""}]},{"ID":"20240903091034-c0f71g3","Type":"NodeParagraph","Properties":{"id":"20240903091034-c0f71g3","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"治一切喉火上炎，大头瘟症。能解湿热、春温，生津止渴，利痰，解鱼毒、酒、积滞。\""}]},{"ID":"20240903091034-rjf15ra","Type":"NodeParagraph","Properties":{"id":"20240903091034-rjf15ra","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治咽喉痛，咀嚼咽汁，能解一切鱼鳖毒。\""}]},{"ID":"20240903091034-ji6pfal","Type":"NodeParagraph","Properties":{"id":"20240903091034-ji6pfal","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑦《本草通玄》：\"固精。\""}]},{"ID":"20240903091034-iy98ck9","Type":"NodeParagraph","Properties":{"id":"20240903091034-iy98ck9","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑧《本经逢原》：\"令痘起发。\""}]},{"ID":"20240903091034-16yvmku","Type":"NodeParagraph","Properties":{"id":"20240903091034-16yvmku","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑨《本草再新》：\"平肝开胃，润肺滋阴，消痰理气，止咳嗽，治吐血。\""}]},{"ID":"20240903091034-d6n5dow","Type":"NodeParagraph","Properties":{"id":"20240903091034-d6n5dow","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑩《随息居饮食谱》：\"凉胆息惊。\""}]},{"ID":"20240903091034-wwr2g4s","Type":"NodeParagraph","Properties":{"id":"20240903091034-wwr2g4s","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑾《现代实用中药》：\"治神经病癫痫，配合明矾煮成流膏用。\""}]},{"ID":"20240903091034-u5br5g2","Type":"NodeParagraph","Properties":{"id":"20240903091034-u5br5g2","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；烧存性研末、捣汁或熬膏，外用：烧存性研末调敷。"}]},{"ID":"20240903091034-nxk7coh","Type":"NodeParagraph","Properties":{"id":"20240903091034-nxk7coh","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903091034-z0km16a","Type":"NodeParagraph","Properties":{"id":"20240903091034-z0km16a","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"①治时行风火喉痛，喉间红肿：鲜青果、鲜莱菔，水煎服。（《王氏医案》青龙白虎汤）"}]},{"ID":"20240903091034-0a7x8f4","Type":"NodeParagraph","Properties":{"id":"20240903091034-0a7x8f4","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"②治酒伤昏闷：橄榄肉十个，煎汤饮。（《本草汇言》）"}]},{"ID":"20240903091034-fs7tdqw","Type":"NodeParagraph","Properties":{"id":"20240903091034-fs7tdqw","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"③治心痛、胃脘痛：盐腌咸（橄）榄去核，以鲜明人中黄人满，用纸及泥包好煅透，滚水调下。（《本草求原》）"}]},{"ID":"20240903091034-eowoklr","Type":"NodeParagraph","Properties":{"id":"20240903091034-eowoklr","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"④治肠风下血：橄榄烧灰（存性）研末，每服二钱，米饮调下。（《本草求真》）"}]},{"ID":"20240903091034-9xpm21a","Type":"NodeParagraph","Properties":{"id":"20240903091034-9xpm21a","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑤治河豚鱼鳖诸毒，诸鱼骨哽：橄榄捣汁或煎浓汤饮。无橄榄以核研末或磨汁服。（《随息居饮食谱》）"}]},{"ID":"20240903091034-jrx7g3v","Type":"NodeParagraph","Properties":{"id":"20240903091034-jrx7g3v","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑥治唇裂生疮：橄榄炒研，猪脂和涂之。（《纲目》）"}]},{"ID":"20240903091034-92qwh36","Type":"NodeParagraph","Properties":{"id":"20240903091034-92qwh36","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑦治牙齿风疳：用橄榄烧研，入麝香少许贴之。（《圣惠方》）"}]},{"ID":"20240903091034-1meh3er","Type":"NodeParagraph","Properties":{"id":"20240903091034-1meh3er","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"⑧治下部疳疮：橄榄，烧存性研末，油调敷之，或加儿茶等分。（《乾坤生意》）"}]},{"ID":"20240903091034-f2mprjk","Type":"NodeParagraph","Properties":{"id":"20240903091034-f2mprjk","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【各家论述】《本草经疏》：\"橄榄，《本经》味酸甘，今尝之先涩而后甘，肺胃家果也。能生津液，酒后嚼之不渴，故主消酒，甘能解毒，故疗鯸鲐毒。鯸鲐即河豚也。\""}]},{"ID":"20240903091034-nwlv3n1","Type":"NodeParagraph","Properties":{"id":"20240903091034-nwlv3n1","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903091034-wcfqkew","Type":"NodeParagraph","Properties":{"id":"20240903091034-wcfqkew","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"①治疗急性细菌性痢疾"}]},{"ID":"20240903091034-617glwd","Type":"NodeParagraph","Properties":{"id":"20240903091034-617glwd","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"取鲜橄榄连核100克，加水200毫升，放入砂锅内用文火煎2～3小时。使成100毫升，过滤。成人日服3～4次，每次2S～30毫升，连续服至大便性状恢复正常，大便次数每日1～2次后停药。一般疗程为5天。如大便性状未见改善，培养阳性者，则取煎液50毫升，加水50毫升行保留灌肠，每日1～2次，连续3天。临床治疗急性菌痢49例，服药后平均12小时退热，大便次数恢复正常为2.8天，大便性状改善为3.8天，大便培养阴性时间为4.1天。"}]},{"ID":"20240903091034-fry5rdw","Type":"NodeParagraph","Properties":{"id":"20240903091034-fry5rdw","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"②治疗皮肤病"}]},{"ID":"20240903091034-ubq5o3y","Type":"NodeParagraph","Properties":{"id":"20240903091034-ubq5o3y","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"用橄榄煎液湿敷治疗急性炎症性皮肤病，有收敛、消炎及减少渗出的作用。据观察，阴囊溃疡、女阴溃疡及重型多型渗出性红斑，用药后溃疡面即迅速停止渗液，黄色分泌物减少，伤口疼痛减轻，肉芽生长，伤口很快愈合；对湿疹皮炎亦有停止渗液的作用，制剂及用法：取生橄榄2斤捣烂，加水1000毫升，用文火煎成药液1000毫升，静置半小时，去渣。用纱布浸荡液湿敷，每日3次。对溃疡早期以冷敷较好，至炎症稳定后可以改用热敷（溶液温度约40～50℃）；湿敷后创面盖以凡士林纱布。对湿疹皮炎，同时配合抗过敏药、维生素C及外用锌氧油等。"}]},{"ID":"20240903091034-cjaa6jy","Type":"NodeParagraph","Properties":{"id":"20240903091034-cjaa6jy","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903091034-ugwi4if","Type":"NodeParagraph","Properties":{"id":"20240903091034-ugwi4if","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"橄榄《中华本草》"}]},{"ID":"20240903091034-14ydpvr","Type":"NodeParagraph","Properties":{"id":"20240903091034-14ydpvr","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903091034-c7dv2pe","Type":"NodeParagraph","Properties":{"id":"20240903091034-c7dv2pe","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"出自《日华子本草》；1.《岭表录异》：橄榄树，有野生者，子繁树竣.不可梯缘，但刻其根下方寸许，纳盐于其中，一夕，子皆自落。树枝节上，生脂膏如桃胶，油人采之，和其皮叶煎之，调如黑饧，谓之橄榄糖。用泥船损，干后坚于胶漆，着水益干耳。"}]},{"ID":"20240903091034-8thxwa4","Type":"NodeParagraph","Properties":{"id":"20240903091034-8thxwa4","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"2.《开宝本草》：橄榄，其树似木梭子树而高，端直，其形似生诃子无棱瓣。生岭南，八月、九月采。又有-种名波斯橄榄，色类亦相似，其形核作二瓣，可以蜜债食之，生邑州。"}]},{"ID":"20240903091034-b91pqtk","Type":"NodeParagraph","Properties":{"id":"20240903091034-b91pqtk","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【拼音名】GǎnLǎn"}]},{"ID":"20240903091034-j6gfb1q","Type":"NodeParagraph","Properties":{"id":"20240903091034-j6gfb1q","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【英文名】ChineseWhiteOlive,fruitofWhitecanarium"}]},{"ID":"20240903091034-y5ugqz6","Type":"NodeParagraph","Properties":{"id":"20240903091034-y5ugqz6","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【别名】橄榄子、余甘子、橄棪、忠果、青果、青子、谏果、青橄榄、白榄、黄榄、甘榄。"}]},{"ID":"20240903091034-sobdtoo","Type":"NodeParagraph","Properties":{"id":"20240903091034-sobdtoo","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903091034-ihusxye","Type":"NodeParagraph","Properties":{"id":"20240903091034-ihusxye","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"药材基源：为橄榄科植物橄榄的果实。"}]},{"ID":"20240903091034-g1frwyf","Type":"NodeParagraph","Properties":{"id":"20240903091034-g1frwyf","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Canariumalbum(Lour.)Raeusch.[PimelaalbaLour.]"}]},{"ID":"20240903091034-f5shrfk","Type":"NodeParagraph","Properties":{"id":"20240903091034-f5shrfk","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"采收和储藏：培育6-7年结果，8-9月待果实外皮呈绿色带微黄时采摘，洗净，鲜用或用微火烘干。"}]},{"ID":"20240903091034-nxnukuj","Type":"NodeParagraph","Properties":{"id":"20240903091034-nxnukuj","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【原形态】橄榄常绿乔木，高10-20m。有胶粘性芳香的树脂。树皮淡灰色，平滑；幼枝、叶柄及叶轮均被极短的柔毛，有皮孔。奇数羽状复叶互生，长15-30cm；小叶11-15，长圆状披针形，长6-15cm，宽2.5-5cm，先端渐尖，基部偏斜，全缘，秃净，网脉两面均明显，下面网脉上有小窝点，略粗糙。圆锥花序顶生或腋生，与叶等长或略短；萼杯状，3浅裂，稀5裂；花瓣3-5白色，芳香，长约为萼之2倍；雄蕊6，插生于环状花盘外侧；雌蕊1，子房上位。核果卵形，长约3cm，初时黄绿色，后变黄白色，两端锐尖。花期5-7月，果期8-10月。"}]},{"ID":"20240903091034-vcs1jff","Type":"NodeParagraph","Properties":{"id":"20240903091034-vcs1jff","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903091034-425kdn4","Type":"NodeParagraph","Properties":{"id":"20240903091034-425kdn4","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"生态环境：生于低海拔的杂木林中，有栽培。"}]},{"ID":"20240903091034-h1436d9","Type":"NodeParagraph","Properties":{"id":"20240903091034-h1436d9","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、台湾、广东、海南、广西、四川、贵州、云南等地。"}]},{"ID":"20240903091034-7c8ujdb","Type":"NodeParagraph","Properties":{"id":"20240903091034-7c8ujdb","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240903091034-prgi4ns","Type":"NodeParagraph","Properties":{"id":"20240903091034-prgi4ns","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"生物学特性喜高温多湿气候，平均温度20-22℃生长最为适宜。不耐寒，霜冻较严重地区易受冻害。以土层深厚、疏松肥沃、富含腐殖质的砂质壤上为好。幼树期可与豆类作物套作。"}]},{"ID":"20240903091034-cloakax","Type":"NodeParagraph","Properties":{"id":"20240903091034-cloakax","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、嫁接繁殖。种子繁殖，育苗移栽法：秋后来收成熟果实，用开水浸泡3-5min，使果肉与果核分离，取出果核，用温沙层积处理始能发芽。2-3月播种，按行距30cm开沟，株距12-15cm播种1颗，覆土，盖草，浇水。1颗种子可出苗3-4株。出苗后揭去盖草，除弱留壮，勤除杂草，春、夏、秋季追施人畜粪肥。培育2年移栽或作嫁接的砧木用。嫁接繁殖，切接法：4-5月实生苗作砧木，再从优良品种的母株上选取2年生枝条作接穗，进行嫁接。芽接在定植后2-3年进行。嫁接苗成活后培育1年，春季移栽，按行株距10m×8m开穴，穴底先施土杂肥，幼苗栽种时要剪去部分叶片，削平大根伤口，并用火将伤口烧焦，以免流胶腐烂。每穴栽1株，填土压实，土稍高于地面，浇水。"}]},{"ID":"20240903091034-z80twwf","Type":"NodeParagraph","Properties":{"id":"20240903091034-z80twwf","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"田间管理幼苗期要勤除草松土、施肥。结果后追肥2次，可在萌芽时和采果后进行，追施人畜粪肥、厩肥、河泥等。株高2m左右，需整枝修剪，仅留3-4个主枝及3-4个侧枝，侧技过多时，要从基部剪除，测枝过强，则要摘心。经常要培土，保护根部。寒冷地区，冬季包草防冻。"}]},{"ID":"20240903091034-ojpg2ol","Type":"NodeParagraph","Properties":{"id":"20240903091034-ojpg2ol","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"病虫害防治有星天牛幼虫、小金龟子等为害。"}]},{"ID":"20240903091034-gq3vvfn","Type":"NodeParagraph","Properties":{"id":"20240903091034-gq3vvfn","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903091034-n5m3y9o","Type":"NodeParagraph","Properties":{"id":"20240903091034-n5m3y9o","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"性状鉴别果实纺锤形，两端钝尖，长2.5-4cm，直径1-1.5cm。表面棕黄色或黑褐色，有不规则深皱纹。果肉厚，灰棕色或棕褐色。果核（内果皮）梭形，暗红棕色，表面具纵棱3条，其间各有2条弧形弯曲的沟；质坚硬，破开后其内多分3室，各有种子1颗。外种皮黄色，常紧贴于内果皮上，内种皮红棕色，膜质，胚乳极薄，子叶2片。气无，果肉味涩，久嚼微甜。以个大、坚实、肉厚、味先涩后甜者为佳。"}]},{"ID":"20240903091034-x8r1p81","Type":"NodeParagraph","Properties":{"id":"20240903091034-x8r1p81","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：外果皮表皮细胞1列，细胞呈类长方形，切向排列，内含黄棕色物，外被角质层。中果皮为数10列薄壁细胞，有维管束和色素物分布，亦有横向导管散在。草酸钙簇晶甚多，直径4-45μm，草酸钙方晶边长2.5-7.5μm。颓废细胞数列，径向或切向排列。内果皮坚硬，由石细胞组成。"}]},{"ID":"20240903091034-qxxcpl9","Type":"NodeParagraph","Properties":{"id":"20240903091034-qxxcpl9","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含蛋白质1.2％，脂肪1.09％，碳水化合物12％，钙0.204％，磷0.046％，铁0.0014％，抗坏血酸0.02％。种子含挥发油及香树脂醇等，种子油中含多种脂肪酸：已酸（hexanoicacid），辛酸（octanoicacid），癸酸（decanoicacid），月桂酸（lauricacid），肉豆寇酸（myristicacid），硬脂酸（stearicacid），棕榈酸（palmiticacid），油酸（oleicacid），亚麻酸（linolenicacid）等。茎叶中含短叶老鹳草素（brevifolin），金丝桃甙（hyperin），并没食子酸（ellagicacid），a-香树脂醇（a-amyrin），β-香树脂醇（β-amyrin），3-表-a-香树脂醇（3-epi-a-amyrin），3-表-β-香树脂醇（3-ePi-β-amyrin），乌苏-12-烯-3a，16β-二醇（urs-12-ene-3a，16β-diol），乌苏-12-烯-3β，16β-二醇（urs-12-ene-3β，16β-diol），齐墩果-12-烯-3a，16β二醇（olean-12-ene-3a，16β-diol）等成分。"}]},{"ID":"20240903091034-q8rb8dv","Type":"NodeParagraph","Properties":{"id":"20240903091034-q8rb8dv","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【药理作用】保肝作用：熊果－12－烯－3a，16B-二醇和齐墩果－12－烯－3a，16B－二醇对由半乳糖胺引起的鼠肝细胞中毒有保肝作用。短叶苏木酚、并没食子酸和3，3'－二甲氧基并没食子酸能减少，四氯化碳对鼠肝脏损害作用。"}]},{"ID":"20240903091034-j67g0dq","Type":"NodeParagraph","Properties":{"id":"20240903091034-j67g0dq","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品乙醇浸出液，滴于滤纸上，再滴加溴甲酚绿试液，在绿色背景上显黄色。（示有机酸）"}]},{"ID":"20240903091034-2lkrtqq","Type":"NodeParagraph","Properties":{"id":"20240903091034-2lkrtqq","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903091034-mfshi54","Type":"NodeParagraph","Properties":{"id":"20240903091034-mfshi54","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"1.净制：除去杂质，洗净，晒干。"}]},{"ID":"20240903091034-3lvzgub","Type":"NodeParagraph","Properties":{"id":"20240903091034-3lvzgub","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"2.切制：甩时打碎。"}]},{"ID":"20240903091034-8jh5hio","Type":"NodeParagraph","Properties":{"id":"20240903091034-8jh5hio","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"3.取青果用火煅存性，研细。"}]},{"ID":"20240903091034-47lmtvl","Type":"NodeParagraph","Properties":{"id":"20240903091034-47lmtvl","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【性味】甘；酸；涩；性平"}]},{"ID":"20240903091034-sq98bjr","Type":"NodeParagraph","Properties":{"id":"20240903091034-sq98bjr","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【归经】肺；胃；脾；肝经"}]},{"ID":"20240903091034-yqsbgvh","Type":"NodeParagraph","Properties":{"id":"20240903091034-yqsbgvh","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【功能主治】清肺利咽；生津止渴；解毒。主咳嗽痰血；咽喉肿痛；暑热烦渴；醉酒；鱼蟹中毒"}]},{"ID":"20240903091034-je7qvib","Type":"NodeParagraph","Properties":{"id":"20240903091034-je7qvib","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-12g；或熬膏；或入丸剂。外用：适量，研末撒或油调敷。"}]},{"ID":"20240903091034-22bf9h6","Type":"NodeParagraph","Properties":{"id":"20240903091034-22bf9h6","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【注意】本品味甘、性涩，表证初起者慎用"}]},{"ID":"20240903091034-0ttqgxs","Type":"NodeParagraph","Properties":{"id":"20240903091034-0ttqgxs","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【附方】①治时行风火喉病，喉间红肿：鲜青果、鲜莱菔，水煎服。(《王氏医案》青龙白虎汤)②治酒伤昏闷：橄榄肉十个，煎汤饮。(《本草汇言》)③治心病、胃脘痛：盐腌咸(橄)榄去核，以鲜明人中黄入满，用纸及泥包好缎透，滚水调下。(《本草求原》)④治肠风下血：橄榄烧灰(存性)研末，短服二钱，米饮调下。(《本草求真》)⑤治河源鱼鳖诸毒，诸鱼骨哽：橄榄捣汁或煎浓汤饮。无橄榄以核研末或磨汁服。(《随息居饮食谱》)⑥治唇裂生疮：橄榄炒研，猪脂和涂之。(《纲目》)⑦治牙齿风瘤：用橄榄烧研，入康香少许贴之。(《圣惠方》)⑧下部疳疮：橄榄，烧存性研末，油调敷之，或加儿茶等分。(《乾坤生意》)"}]},{"ID":"20240903091034-5o2ckme","Type":"NodeParagraph","Properties":{"id":"20240903091034-5o2ckme","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903091034-vbgl69r","Type":"NodeParagraph","Properties":{"id":"20240903091034-vbgl69r","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"1.孟说：主溯鱼(即河膘)毒，汁服之。"}]},{"ID":"20240903091034-9tkzmgv","Type":"NodeParagraph","Properties":{"id":"20240903091034-9tkzmgv","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：开胃，下气，止泻。"}]},{"ID":"20240903091034-b8ut38j","Type":"NodeParagraph","Properties":{"id":"20240903091034-b8ut38j","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"3.《开宝本草》：主消酒。"}]},{"ID":"20240903091034-yi7u84h","Type":"NodeParagraph","Properties":{"id":"20240903091034-yi7u84h","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：嚼汁咽治鱼梗。"}]},{"ID":"20240903091034-x1w7a71","Type":"NodeParagraph","Properties":{"id":"20240903091034-x1w7a71","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：治一切喉火上炎，大头瘟症。能解湿热、春温，生津止渴，利痰，解鱼毒、酒、积滞。"}]},{"ID":"20240903091034-e84vy0g","Type":"NodeParagraph","Properties":{"id":"20240903091034-e84vy0g","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：治咽喉痛，咀嚼咽汁，能解一切鱼鳖毒。"}]},{"ID":"20240903091034-nam37r2","Type":"NodeParagraph","Properties":{"id":"20240903091034-nam37r2","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"7.《本草通玄》：固精。"}]},{"ID":"20240903091034-kbs5dng","Type":"NodeParagraph","Properties":{"id":"20240903091034-kbs5dng","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"8.《本经逢原》：令痘起发。"}]},{"ID":"20240903091034-bgh4zdk","Type":"NodeParagraph","Properties":{"id":"20240903091034-bgh4zdk","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"9.《本草再新》：平肝开胃，润肺滋阴，消痰理气，止咳嗽，治吐血。"}]},{"ID":"20240903091034-1zu8zkr","Type":"NodeParagraph","Properties":{"id":"20240903091034-1zu8zkr","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"10.《随息居饮食谱》：凉胆息惊。"}]},{"ID":"20240903091034-y8g5vrd","Type":"NodeParagraph","Properties":{"id":"20240903091034-y8g5vrd","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"11.《现代实用中药》：治神经病癫痫，配合阴矾煮成流膏用。"}]},{"ID":"20240903091034-g2ejqrx","Type":"NodeParagraph","Properties":{"id":"20240903091034-g2ejqrx","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903091034-5scjz2v","Type":"NodeParagraph","Properties":{"id":"20240903091034-5scjz2v","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"1.治疗急性细菌性痢疾：取鲜橄榄连核100g加水200ml，放入砂锅内用文火煎2-3小时，使成100ml，过滤。成人日服3-4次，每次25-30ml，连续服至大便性状恢复正常，大便次数每日l一2次后停药。一般疗程为5天。如大便性状末见改善，培养阳性者，则取煎液50ml，加水50ml行保留灌肠，每日1-2次，连续3天。临床治疗急性菌痢49例，服药后平均12小时退热，大便次数恢复正常为2.8天，大便性状改善为3.8天，大便培养阴性时间为4.1天。"}]},{"ID":"20240903091034-724q8di","Type":"NodeParagraph","Properties":{"id":"20240903091034-724q8di","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"2.治疗皮肤病：用橄榄煎液湿敷治疗急性炎症性皮肤病，有收敛、消炎及减少渗出的作用。据观察，阴囊溃疡、女阴溃疡及重型多型渗出性红斑，用药后溃疡面即迅速停小渗液，黄色分泌物减少，伤口疼痛减轻，肉芽生长，伤口很快愈合；对湿疹皮炎亦有停止渗液的作用。制剂及用法：取生橄榄2斤捣烂；加水1000ml，用文火煎成药液1000ml，静置半小时，去渣。用纱中浸药液湿敷，曰三次，对溃疡早期以冷敷较好，至炎症稳定后可以改用热敷（溶液温度约40-50度)；湿敷后创面盖以凡士林纱布。对温疹皮炎，同时配合抗过敏药、维生素C及外用锌氧油等。"}]},{"ID":"20240903091034-3uzffov","Type":"NodeParagraph","Properties":{"id":"20240903091034-3uzffov","updated":"20240903091046"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903091035-qk9nhbe","Type":"NodeThematicBreak","Properties":{"id":"20240903091035-qk9nhbe","updated":"20240903091046"}},{"ID":"20240903091036-ppes13q","Type":"NodeParagraph","Properties":{"id":"20240903091036-ppes13q","updated":"20240903091046"}}]}