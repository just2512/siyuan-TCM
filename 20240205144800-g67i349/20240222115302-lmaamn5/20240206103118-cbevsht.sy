110400"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"丝瓜6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/丝瓜6-20240709110247-sskh8le.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 678px;","style":"width: 668px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"丝瓜7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/丝瓜7-20240709110400-hj9n7ys.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 668px;\" parent-style=\"width: 678px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709105907-fhk3rlz","Type":"NodeThematicBreak","Properties":{"id":"20240709105907-fhk3rlz"}},{"ID":"20240830103435-y5cns7n","Type":"NodeParagraph","Properties":{"id":"20240830103435-y5cns7n","updated":"20240830103441"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：丝瓜络"}]},{"ID":"20240830103435-st9j7no","Type":"NodeParagraph","Properties":{"id":"20240830103435-st9j7no","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"丝瓜络《中国药典》"}]},{"ID":"20240830103435-jccdgvz","Type":"NodeParagraph","Properties":{"id":"20240830103435-jccdgvz","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【拼音名】SīGuāLuò"}]},{"ID":"20240830103435-w1yrebz","Type":"NodeParagraph","Properties":{"id":"20240830103435-w1yrebz","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【英文名】RETINERVUSLUFFAEFRUCTUS"}]},{"ID":"20240830103435-6e638fo","Type":"NodeParagraph","Properties":{"id":"20240830103435-6e638fo","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【来源】本品为葫芦科植物丝瓜Luffacylindrica（L.）Roem.的干燥成熟果实的维管束。夏、秋二季果实成熟、果皮变黄、内部干枯时采摘，除去外皮及果肉，洗净，晒干，除去种子。"}]},{"ID":"20240830103435-63zey79","Type":"NodeParagraph","Properties":{"id":"20240830103435-63zey79","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性状】本品为丝状维管束交织而成，多呈长棱形或长圆筒形，略弯曲，长30～70cm，直径7～10cm。表面淡黄白色。体轻，质韧，有弹性，不能折断。横切面可见子房3室，呈空洞状。气微，味淡。"}]},{"ID":"20240830103435-hdulfpw","Type":"NodeParagraph","Properties":{"id":"20240830103435-hdulfpw","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【炮制】除去残留种子及外皮，切段。"}]},{"ID":"20240830103435-33v0u7r","Type":"NodeParagraph","Properties":{"id":"20240830103435-33v0u7r","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性味】甘，平。"}]},{"ID":"20240830103435-bvvl5ys","Type":"NodeParagraph","Properties":{"id":"20240830103435-bvvl5ys","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、胃、肝经。"}]},{"ID":"20240830103435-vgoyufq","Type":"NodeParagraph","Properties":{"id":"20240830103435-vgoyufq","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【功能主治】通络，活血，祛风。用于痹痛拘挛，胸胁胀痛，乳汁不通。"}]},{"ID":"20240830103435-u1saag5","Type":"NodeParagraph","Properties":{"id":"20240830103435-u1saag5","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【用法用量】4.5～9g。"}]},{"ID":"20240830103435-zwi0bf1","Type":"NodeParagraph","Properties":{"id":"20240830103435-zwi0bf1","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830103435-4140ulk","Type":"NodeParagraph","Properties":{"id":"20240830103435-4140ulk","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830103435-315z9aj","Type":"NodeParagraph","Properties":{"id":"20240830103435-315z9aj","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"丝瓜络《*辞典》"}]},{"ID":"20240830103435-d2ax7rj","Type":"NodeParagraph","Properties":{"id":"20240830103435-d2ax7rj","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【出处】《本草再新》"}]},{"ID":"20240830103435-jh3qpsx","Type":"NodeParagraph","Properties":{"id":"20240830103435-jh3qpsx","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【拼音名】SīGuāLuò"}]},{"ID":"20240830103435-t1knoq0","Type":"NodeParagraph","Properties":{"id":"20240830103435-t1knoq0","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【别名】丝瓜网（《医林纂要》），丝瓜壳（《分类草药性》），瓜络、絮瓜瓤（《广州植物志》），天罗线（《药材资料汇编》），丝瓜筋（《江苏植药志》），丝瓜瓤（《河北药材》），千层楼（《湖南药物志》）。"}]},{"ID":"20240830103435-2l3hqxy","Type":"NodeParagraph","Properties":{"id":"20240830103435-2l3hqxy","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【来源】为葫芦科植物丝瓜老热果实的网状纤维或粤丝瓜的枯老果实。秋季采取枯老的果实，搓去外皮及果肉，或用水浸泡至果皮和果肉腐烂，取出洗净。除去种子，晒干，称\"丝瓜络\"。广东粤丝瓜采取后不去皮、子，称为\"丝瓜布\"。"}]},{"ID":"20240830103435-5swqpcp","Type":"NodeParagraph","Properties":{"id":"20240830103435-5swqpcp","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【原形态】植物形态详\"丝瓜\"条。"}]},{"ID":"20240830103435-5e2mhv5","Type":"NodeParagraph","Properties":{"id":"20240830103435-5e2mhv5","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830103435-d35pvx2","Type":"NodeParagraph","Properties":{"id":"20240830103435-d35pvx2","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"①丝瓜络"}]},{"ID":"20240830103435-sbfhplh","Type":"NodeParagraph","Properties":{"id":"20240830103435-sbfhplh","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"呈长圆筒形或长棱形，略弯曲，两端较细。长约25～60厘米，中间直径约6～8厘米。表面白色或黄白色，全体系由多层丝状纤维交织而成的网状物。体轻，质坚韧，不能折断。横切面可见子房3室，形成3个大空洞，内有少数残留的黑色种子。气无，味淡，以筋细、质韧。洁白、无皮者为佳。"}]},{"ID":"20240830103435-sldahef","Type":"NodeParagraph","Properties":{"id":"20240830103435-sldahef","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"全国各地均产，以浙江、江苏所产者质量为好。"}]},{"ID":"20240830103435-kwxhc5e","Type":"NodeParagraph","Properties":{"id":"20240830103435-kwxhc5e","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"②丝瓜布"}]},{"ID":"20240830103435-oncetom","Type":"NodeParagraph","Properties":{"id":"20240830103435-oncetom","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"外形呈长圆筒形，一端具坚韧的果柄，果皮灰黄色，上有10条纵向棱线，果皮质脆。其余均与丝瓜络相似。"}]},{"ID":"20240830103435-nyphsxg","Type":"NodeParagraph","Properties":{"id":"20240830103435-nyphsxg","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"主产广东。"}]},{"ID":"20240830103435-yt5f2eh","Type":"NodeParagraph","Properties":{"id":"20240830103435-yt5f2eh","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【化学成份】丝瓜络含木聚糖及纤维素，可能还含甘露聚糖、半乳聚糖及木质素等。"}]},{"ID":"20240830103435-2et2mht","Type":"NodeParagraph","Properties":{"id":"20240830103435-2et2mht","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【炮制】丝瓜络：洗净晒干，切段。炒丝瓜络：取切成小段的丝瓜络，用缺皮拌炒至黄色为度，取出，筛去麸皮。丝瓜络炭：取切成小段的丝瓜络，盛锅内（装满为度），上覆同样大小的锅一只，两锅结合处以黄泥封严，然后用微火烧煅约4～5小时停火（一般用白纸贴在上面锅底上，纸呈焦黄色时为煅透），侯冷取出。"}]},{"ID":"20240830103435-za44mw9","Type":"NodeParagraph","Properties":{"id":"20240830103435-za44mw9","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830103435-82ih1ej","Type":"NodeParagraph","Properties":{"id":"20240830103435-82ih1ej","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"甘，平。"}]},{"ID":"20240830103435-wecp9h0","Type":"NodeParagraph","Properties":{"id":"20240830103435-wecp9h0","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"①《本草便读》：\"味甘，性寒。\""}]},{"ID":"20240830103435-eyqebvj","Type":"NodeParagraph","Properties":{"id":"20240830103435-eyqebvj","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"②《南宁市药物志》：\"甘，平，无毒。\""}]},{"ID":"20240830103435-7v3n3dy","Type":"NodeParagraph","Properties":{"id":"20240830103435-7v3n3dy","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830103435-rewmv0b","Type":"NodeParagraph","Properties":{"id":"20240830103435-rewmv0b","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"通经活络，清热化痰。治胸胁疼痛，腹痛，腰痛，睾丸肿痛，肺热痰咳，妇女经闭，乳汁不通，痈肿，痔漏。炭：能止血。治便血、血崩。"}]},{"ID":"20240830103435-abca1mg","Type":"NodeParagraph","Properties":{"id":"20240830103435-abca1mg","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"①《医林纂要》：\"凉血渗血，通经络，托痘毒。\""}]},{"ID":"20240830103435-vid4pzr","Type":"NodeParagraph","Properties":{"id":"20240830103435-vid4pzr","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"通经络，和血脉，化痰顺气。\""}]},{"ID":"20240830103435-cfh3rxc","Type":"NodeParagraph","Properties":{"id":"20240830103435-cfh3rxc","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"③《分类草药性》：\"治乳肿疼痛，火煅存性冲酒服。研末调香油涂汤火伤。\""}]},{"ID":"20240830103435-0qii4us","Type":"NodeParagraph","Properties":{"id":"20240830103435-0qii4us","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"④《现代实用中药》：\"通乳汁，发痘疮。治痈疽不敛。作黑烧内服，治肠出血，赤痢，子宫出血，睾丸炎肿，痔疮流血等。\""}]},{"ID":"20240830103435-gyfjn07","Type":"NodeParagraph","Properties":{"id":"20240830103435-gyfjn07","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"⑤《陆川本草》：\"凉血解毒，利水去湿。治肺热痪咳，热病谵妄，心热烦躁，手足抽搐。\""}]},{"ID":"20240830103435-zruw3yb","Type":"NodeParagraph","Properties":{"id":"20240830103435-zruw3yb","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或烧存性研末。外用：煅存性研末调敷。"}]},{"ID":"20240830103435-byt4wup","Type":"NodeParagraph","Properties":{"id":"20240830103435-byt4wup","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830103435-5gibznm","Type":"NodeParagraph","Properties":{"id":"20240830103435-5gibznm","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"丝瓜络《中华本草》"}]},{"ID":"20240830103435-3vh3d6g","Type":"NodeParagraph","Properties":{"id":"20240830103435-3vh3d6g","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草再新》"}]},{"ID":"20240830103435-z2daa2u","Type":"NodeParagraph","Properties":{"id":"20240830103435-z2daa2u","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【拼音名】SīGuāLuò"}]},{"ID":"20240830103435-p03cqll","Type":"NodeParagraph","Properties":{"id":"20240830103435-p03cqll","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【英文名】TowelGourdVegetableSponge,VegetableSpongeofLuffa"}]},{"ID":"20240830103435-s8zlo0u","Type":"NodeParagraph","Properties":{"id":"20240830103435-s8zlo0u","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【别名】天萝筋、丝瓜网、丝瓜壳、瓜络、絮瓜瓤、天罗线、丝瓜筋、丝瓜瓤、千层楼、丝瓜布。"}]},{"ID":"20240830103435-uk8jb3l","Type":"NodeParagraph","Properties":{"id":"20240830103435-uk8jb3l","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830103435-0pckjxb","Type":"NodeParagraph","Properties":{"id":"20240830103435-0pckjxb","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"药材基源：为葫芦科植物丝瓜或奥丝瓜成熟果实的维管束。"}]},{"ID":"20240830103435-79mxbgx","Type":"NodeParagraph","Properties":{"id":"20240830103435-79mxbgx","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Luffacylindrica(L.)Roem.,L.AcutangulaRoxb."}]},{"ID":"20240830103435-xnkeja4","Type":"NodeParagraph","Properties":{"id":"20240830103435-xnkeja4","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季果产成熟，果皮变黄，内部干枯时采摘，搓去外皮及果肉；或用水浸泡至果皮和果肉腐烂，取出洗净，除去种子，晒干。"}]},{"ID":"20240830103435-re6tnas","Type":"NodeParagraph","Properties":{"id":"20240830103435-re6tnas","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【原形态】一年生攀援草本。茎枝粗糙，有棱沟，有微柔毛。茎须粗壮，通常2-4枝。叶互生；叶柄粗糙，长10-12cm，近无毛；叶片三角形或近圆形，长宽均为10-12cm，通常掌状5-7裂，裂片三角形，中间较长，长8-12cm，洗端尖，边缘有锯齿，基部深心形，上面深绿色，有疣点，下面浅绿以，有短柔毛，脉掌状，具白色长柔毛。花单性，雌雄同株；雄花通常10-20朵生于总状花序的顶端，花序梗粗壮，长12-14cm，花梗长2cm；花萼筒钟形，被短柔毛；花冠黄色，幅状，开后直径5-9cm，裂片5，长圆形，长0.8-1.3cm，宽0.4-0.7cm，里面被黄白色长柔毛，外面具3-5条突起的脉，雄蕊5，稀3，花丝6-8mm，花初开放时稍靠合，最后完全分离；雌花单生，花梗长2-10cm；花被与雄花同，退化雄蕊3，子房长圆柱状，有柔毛，柱头3，膨大。果实圆柱状，直或稍弯，长15-30cm，直径5-8cm，表面平滑，通常有深色纵条纹，未成熟时肉质，成熟后干燥，里面有网状纤维，由先端盖裂。种子多数，黑色，卵形，扁，平滑，边毋狭翼状。花、果期夏秋季。"}]},{"ID":"20240830103435-tu81rzz","Type":"NodeParagraph","Properties":{"id":"20240830103435-tu81rzz","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【生境分布】丝瓜络全国各地均产，以浙江、江苏所产者质量为好。丝瓜布主产广东。"}]},{"ID":"20240830103435-3rmllk0","Type":"NodeParagraph","Properties":{"id":"20240830103435-3rmllk0","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830103435-9hhz9t2","Type":"NodeParagraph","Properties":{"id":"20240830103435-9hhz9t2","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"性状鉴别全体由维管束纵横交错而成。多呈长圆形状，略弯，两端稍细，长短不一，长可达70cm，直径5-10cm。表面黄白色，粗糙，有数条浅纵沟，有时可见残存的果皮和膜质状果内。体轻，质韧，富弹性；横断面可邮3个空腔，偶见残留黑色种子。气微，味淡。"}]},{"ID":"20240830103435-vqh1809","Type":"NodeParagraph","Properties":{"id":"20240830103435-vqh1809","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"以个大、完整、筋络清晰、质韧、色淡黄白以、无种子者为佳。"}]},{"ID":"20240830103435-04njc8t","Type":"NodeParagraph","Properties":{"id":"20240830103435-04njc8t","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【化学成份】丝瓜络含木聚糖(Xy-lan)及纤维素，可能还含甘露聚糖、半乳聚糖及木质素等。丝瓜络含木聚糖(xylan)、甘露聚糖(mannan)、半乳聚糖(galactan)等[1]。"}]},{"ID":"20240830103435-3yqymmy","Type":"NodeParagraph","Properties":{"id":"20240830103435-3yqymmy","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830103435-sjipbj9","Type":"NodeParagraph","Properties":{"id":"20240830103435-sjipbj9","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"1.对肝脏作用：所含齐墩果时酸对大鼠肝脏由四氯化碳引起的急性损伤有治疗作用，能减轻肝细胞浆空心变性、疏松变性、肝细胞坏死及小叶变性反应。"}]},{"ID":"20240830103435-3pgczxi","Type":"NodeParagraph","Properties":{"id":"20240830103435-3pgczxi","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"2.其它作用：齐墩果叶酸有强心利尿作用以及抑制S一180瘤株的生长。"}]},{"ID":"20240830103435-x0je2t6","Type":"NodeParagraph","Properties":{"id":"20240830103435-x0je2t6","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【毒性】齐墩果叶酸po120mg/kg未见明显的毒性及副的反应。动物ig临床剂量的100倍，连服10天，镜检，脑、心、肝等11种器官未见明显损害，表明毒性低，使用安全。"}]},{"ID":"20240830103435-cxbyk3q","Type":"NodeParagraph","Properties":{"id":"20240830103435-cxbyk3q","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240830103435-vw8cqez","Type":"NodeParagraph","Properties":{"id":"20240830103435-vw8cqez","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"1.丝瓜络：洗净晒干，切段。"}]},{"ID":"20240830103435-63f8uow","Type":"NodeParagraph","Properties":{"id":"20240830103435-63f8uow","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"2.炒丝瓜络：取切成小段的丝瓜络，用麸皮拌炒至黄色为度，取出，筛去麸皮。"}]},{"ID":"20240830103435-6tdmytv","Type":"NodeParagraph","Properties":{"id":"20240830103435-6tdmytv","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"3.丝瓜络炭：取切成小段的丝瓜络，盛锅内（装满为度），上覆同样大小的锅一只，两锅结合处以黄泥封严，然后用微火烧煅约4-5小时停火（一般用白纸贴在上面锅底上，纸呈焦黄色时为煅透），候冷取出。"}]},{"ID":"20240830103435-nuthsao","Type":"NodeParagraph","Properties":{"id":"20240830103435-nuthsao","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；性凉；"}]},{"ID":"20240830103435-28vrnl4","Type":"NodeParagraph","Properties":{"id":"20240830103435-28vrnl4","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；肝；胃经"}]},{"ID":"20240830103435-e6ezbn5","Type":"NodeParagraph","Properties":{"id":"20240830103435-e6ezbn5","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【功能主治】通经活络；解毒消肿。主胸胁疼痛；风湿痹痛，经脉拘挛，乳汁不通，肺势咳嗽，痈前程疮毒，他痈。"}]},{"ID":"20240830103435-w9h3nlu","Type":"NodeParagraph","Properties":{"id":"20240830103435-w9h3nlu","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-15g；或烧存性研末，每次1.5-3g。外用：适量，煅存性研末调敷。"}]},{"ID":"20240830103435-a8gkqqs","Type":"NodeParagraph","Properties":{"id":"20240830103435-a8gkqqs","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830103435-6mmnz4u","Type":"NodeParagraph","Properties":{"id":"20240830103435-6mmnz4u","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"]1.《本草便读》：丝瓜络，入经络，解邪热。热除则风去，络中津液不致结合而为痰，变成肿毒诸症，故云解毒耳。"}]},{"ID":"20240830103435-zmv7xha","Type":"NodeParagraph","Properties":{"id":"20240830103435-zmv7xha","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"2.《医林纂要》：凉血渗血，通经络，托痘毒。"}]},{"ID":"20240830103435-k0dlrci","Type":"NodeParagraph","Properties":{"id":"20240830103435-k0dlrci","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"3.《本草再新》：通经络，和血脉，化痰顺气。"}]},{"ID":"20240830103435-p4u9xgi","Type":"NodeParagraph","Properties":{"id":"20240830103435-p4u9xgi","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"4.《分类草药性》：治乳肿疼痛，火煅存性冲酒服。研末调香油涂汤火伤。"}]},{"ID":"20240830103435-5uf48rm","Type":"NodeParagraph","Properties":{"id":"20240830103435-5uf48rm","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"5.《现代实用中药》：通乳汁，发痘疮。治痈疽不敛。作黑烧内服，治肠出血，赤痢，子宫出血，睾丸炎肿，痔疮流血等。"}]},{"ID":"20240830103435-lxzi3it","Type":"NodeParagraph","Properties":{"id":"20240830103435-lxzi3it","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"6.《陆川本草》：凉血解毒，利水去湿。治肺热痰咳，热病谵妄，心热烦躁，手足抽搐。"}]},{"ID":"20240830103435-eah8xlf","Type":"NodeParagraph","Properties":{"id":"20240830103435-eah8xlf","updated":"20240830103500"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830103436-qyntrz3","Type":"NodeThematicBreak","Properties":{"id":"20240830103436-qyntrz3","updated":"20240830103500"}},{"ID":"20240830103437-6ac1cnq","Type":"NodeParagraph","Properties":{"id":"20240830103437-6ac1cnq","updated":"20240830103500"}}]}