30px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 429px;","style":"width: 419px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼6-20240709080538-3dxuwjl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 419px;\" parent-style=\"width: 429px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240708175801-8935f96","Type":"NodeParagraph","Properties":{"id":"20240708175801-8935f96","updated":"20240709080155"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼-20240708175801-y1kveqn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 759px;","style":"width: 749px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼4-20240709080155-61bveia.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 749px;\" parent-style=\"width: 759px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240830102717-mijb3n8","Type":"NodeParagraph","Properties":{"id":"20240830102717-mijb3n8","updated":"20240830102729"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 827px;","style":"width: 817px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼5-20240709080430-gokoje8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 817px;\" parent-style=\"width: 827px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 418px;","style":"width: 408px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼3-20240708175911-5m4fis8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 408px;\" parent-style=\"width: 418px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709082037-yf264ho","Type":"NodeParagraph","Properties":{"id":"20240709082037-yf264ho","updated":"20240709082119"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 635px;","style":"width: 625px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼树1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼树1-20240709082037-o2t5ah6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 625px;\" parent-style=\"width: 635px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 358px;","style":"width: 348px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼2-20240708175844-qn19ez2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 348px;\" parent-style=\"width: 358px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240830102719-134qbgq","Type":"NodeThematicBreak","Properties":{"id":"20240830102719-134qbgq"}},{"ID":"20240830102811-wq2zf61","Type":"NodeParagraph","Properties":{"id":"20240830102811-wq2zf61","updated":"20240830102818"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：香橼"}]},{"ID":"20240830102811-wiips8v","Type":"NodeParagraph","Properties":{"id":"20240830102811-wiips8v","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"香橼《中国药典》"}]},{"ID":"20240830102811-bwt6d5y","Type":"NodeParagraph","Properties":{"id":"20240830102811-bwt6d5y","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡYuán"}]},{"ID":"20240830102811-kfrvs5b","Type":"NodeParagraph","Properties":{"id":"20240830102811-kfrvs5b","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSCITRI"}]},{"ID":"20240830102811-j1pkkt7","Type":"NodeParagraph","Properties":{"id":"20240830102811-j1pkkt7","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【来源】本品为芸香科植物枸橼CitrusmedicaL.或香圆（西南香圆）CitruswilsoniiTanaka的干燥成熟果实。秋季果实成熟时采收，趁鲜切片，晒干或低温干燥。香圆亦可整个或对剖两半后，晒干或低温干燥。"}]},{"ID":"20240830102811-23o094i","Type":"NodeParagraph","Properties":{"id":"20240830102811-23o094i","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830102811-nclqml4","Type":"NodeParagraph","Properties":{"id":"20240830102811-nclqml4","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"枸橼：为圆形或长圆形片，直径4～10cm，厚0.2～0.5cm。横切片外果皮黄色或黄绿色，边缘呈波状，散有凹入的油点；中果皮厚1～3cm，黄白色，有不规则的网状突起的维管束；瓤囊10～17室。纵切片中心柱较粗壮。质柔韧。气清香，味微甜而苦辛。"}]},{"ID":"20240830102811-ptzsfv7","Type":"NodeParagraph","Properties":{"id":"20240830102811-ptzsfv7","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"香圆：为类球形，半球形或圆片，直径4～7cm。表面黑绿色或黄棕色，密被凹陷的小油点及网状隆起的粗皱纹，顶端有花柱残痕及隆起的环圈，基部有果梗残基。质坚硬。剖面或横切薄片，边缘油点明显；中果皮厚约0.5cm，瓤囊9～11室，棕色或淡红棕色，间或有黄白色种子。气香，味酸而苦。"}]},{"ID":"20240830102811-ow86bje","Type":"NodeParagraph","Properties":{"id":"20240830102811-ow86bje","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末2g，加石油醚（60～90℃）30ml，浸泡1小时，超声处理20分钟，滤过，滤液挥干，残渣加石油醚（60～90℃）1ml使溶解，作为供试品溶液。另取香橼对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5～10μl，分别点于同一硅胶G薄层板上,以环已烷-醋酸乙酯（5：1）为展开剂，展开，取出，晾干，喷以3％香草醛硫酸溶液，加热至斑点显色清晰。供试品色谱中,在与对照药材色谱相应的位置上，显相同颜色的主斑点。"}]},{"ID":"20240830102811-tofn2c1","Type":"NodeParagraph","Properties":{"id":"20240830102811-tofn2c1","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【炮制】未切片者，打成小块；切片者润透，切丝，晾干。"}]},{"ID":"20240830102811-vhy30sn","Type":"NodeParagraph","Properties":{"id":"20240830102811-vhy30sn","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦、酸，温。"}]},{"ID":"20240830102811-lgequk2","Type":"NodeParagraph","Properties":{"id":"20240830102811-lgequk2","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾、肺经。"}]},{"ID":"20240830102811-larzwh8","Type":"NodeParagraph","Properties":{"id":"20240830102811-larzwh8","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【功能主治】舒肝理气，宽中，化痰。用于肝胃气滞，胸胁胀痛，脘腹痞满，呕吐噫气，痰多咳嗽。"}]},{"ID":"20240830102811-9cw3t0l","Type":"NodeParagraph","Properties":{"id":"20240830102811-9cw3t0l","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240830102811-6yt6kxk","Type":"NodeParagraph","Properties":{"id":"20240830102811-6yt6kxk","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防霉，防蛀。"}]},{"ID":"20240830102811-n1s6gke","Type":"NodeParagraph","Properties":{"id":"20240830102811-n1s6gke","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830102811-mifpu2p","Type":"NodeParagraph","Properties":{"id":"20240830102811-mifpu2p","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"香橼《*辞典》"}]},{"ID":"20240830102811-byr6c8m","Type":"NodeParagraph","Properties":{"id":"20240830102811-byr6c8m","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【出处】《本草图经》"}]},{"ID":"20240830102811-u1zlflc","Type":"NodeParagraph","Properties":{"id":"20240830102811-u1zlflc","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡYuán"}]},{"ID":"20240830102811-qnp21f8","Type":"NodeParagraph","Properties":{"id":"20240830102811-qnp21f8","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【来源】为芸香科植物枸橼或香圆的成熟果实。9～10月采摘，晒干；或放2～3天，待果实表面略干时，切成厚片，晒干；亦有用绳穿起风干或低温烘干。"}]},{"ID":"20240830102811-ywtf36v","Type":"NodeParagraph","Properties":{"id":"20240830102811-ywtf36v","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830102811-ounvy48","Type":"NodeParagraph","Properties":{"id":"20240830102811-ounvy48","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①枸橼（杨孚《异物志》），又名：钩缘子（《南方草木状》），香泡树、香橼柑。"}]},{"ID":"20240830102811-s5qj056","Type":"NodeParagraph","Properties":{"id":"20240830102811-s5qj056","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"常绿小乔木，高2米左右。枝具短而硬的刺，嫩枝幼时紫红色，叶大，互生，革质；叶片长圆形或长椭圆形，长8～15厘米，宽3.5～6.5厘米，先端钝或钝短尖，基部阔楔形，边缘有锯齿；叶柄短而无翼，无节或节不明显。短总状花序，顶生及腋生，花3～10朵丛生，有两性花及雄花之分，萼片5，合生如浅杯状，上端5浅裂；花瓣5，肉质，白色，外面淡紫色；雄蕊约30；雌蕊1，子房上部渐狭，花柱有时宿存。柑果长椭圆形或卵圆形，果顶有乳状突起，长径10～25厘米，横径5～10厘米，熟时柠檬黄色，果皮粗厚而芳香，瓤囊细小，12～16瓣，果汁黄色，味极酸而苦；种子10枚左右，卵圆形，子叶白色。花期4月。果期8～9月。"}]},{"ID":"20240830102811-h2ae545","Type":"NodeParagraph","Properties":{"id":"20240830102811-h2ae545","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"长江流域及其以南地区均有分布。广东、广西栽培较多。"}]},{"ID":"20240830102811-kjme112","Type":"NodeParagraph","Properties":{"id":"20240830102811-kjme112","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"本植物的根（香橼根）、叶（香橼叶）亦供药用，各详专条。"}]},{"ID":"20240830102811-k638ijg","Type":"NodeParagraph","Properties":{"id":"20240830102811-k638ijg","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②香圆（苏轼《物类相感志》）"}]},{"ID":"20240830102811-z3k2vw3","Type":"NodeParagraph","Properties":{"id":"20240830102811-z3k2vw3","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高4～6米。茎枝光滑无毛，无短刺。叶互生，革质，具腺点，叶片长椭圆形，长6～12厘米，宽2～4.5厘米，两端渐尖，全缘或有波状锯齿，上面深绿色，下面淡绿色；叶柄具阔翼，长0.8～2.5厘米，宽0.5～1.5厘米。花单生或簇生，有时成总状花序，芳香；花萼盆状，5裂，裂片三角形；花瓣5，白色，矩圆状倒卵形，表面有阴显的脉纹；雄蕊在25以上，着生于花盘的四周，花丝结合；子房上位，扁圆形，10～12室，每室有胚珠数枚，花柱圆柱形，柱头头状。柑果圆形，成熟时橙黄色，表面特别粗糙，果汁无色，味酸苦。花期4～5月。果期10～11月。"}]},{"ID":"20240830102811-hgr7l8f","Type":"NodeParagraph","Properties":{"id":"20240830102811-hgr7l8f","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"分布江苏、浙江、江西、安徽、湖北、四川等地。"}]},{"ID":"20240830102811-iyo7eva","Type":"NodeParagraph","Properties":{"id":"20240830102811-iyo7eva","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"本植物的种子（香圆子）亦供药用，另详专条。"}]},{"ID":"20240830102811-k13r2an","Type":"NodeParagraph","Properties":{"id":"20240830102811-k13r2an","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830102811-gnjok83","Type":"NodeParagraph","Properties":{"id":"20240830102811-gnjok83","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①枸橼"}]},{"ID":"20240830102811-tgrfv5k","Type":"NodeParagraph","Properties":{"id":"20240830102811-tgrfv5k","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"完整的果实，呈长椭圆形或卵圆形，顶端有乳状突起，表面黄色或绿黄色。商品多已横切成片，切片厚2～3毫米，直径5～10厘米。切开面淡黄色，表面粗糙，有皱缩不规则的网纹凸起，果皮部分较宽，约有2～3.5厘米，占果片横断面的1/2；中央瓤囊12～16室，宽3～5厘米，每室成三角形，室内有时残阳种子飞～2枚；果实中心柱坚实，直径0.8～2厘米；外侧边缘的果皮黄色或绿黄色，表面不规则皱缩，散有多数凹入的油点。质柔软，气芳香，味初甜而后酸苦。"}]},{"ID":"20240830102811-8rovsbu","Type":"NodeParagraph","Properties":{"id":"20240830102811-8rovsbu","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"主产云南、四川等地。"}]},{"ID":"20240830102811-tgfv3b9","Type":"NodeParagraph","Properties":{"id":"20240830102811-tgfv3b9","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②香圆"}]},{"ID":"20240830102811-ub36d1y","Type":"NodeParagraph","Properties":{"id":"20240830102811-ub36d1y","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"干燥果实，呈球形或矩圆形，直径5～6.5厘米。表面黄棕色或黄绿色，常具有大小不规则的黄白色斑块，并密布多数油点及网状隆起的粗皱纹，顶端凹入，基部呈环状，有果柄痕。横断面果皮为淡黄白色，厚3～8毫米；中央有瓤囊10～12室，每瓤囊内有种子数枚。商品有时纵切成大小不等的瓣状，或横切为二半，除去瓤肉，或偶有瓤肉残留。气香，味酸而苦。"}]},{"ID":"20240830102811-z5c6o2a","Type":"NodeParagraph","Properties":{"id":"20240830102811-z5c6o2a","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"主产浙江、江苏等地。"}]},{"ID":"20240830102811-eycqokv","Type":"NodeParagraph","Properties":{"id":"20240830102811-eycqokv","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"古代《本草》所载的香橼多指枸橼而言，有时包括佛手在内。但目前商品香橼的来源，有枸橼与香圆二种，且产量以后者为大，使用亦较广。其幼果及近成熟果实，在少数地区亦作枳实、枫壳入药。"}]},{"ID":"20240830102811-la61fdg","Type":"NodeParagraph","Properties":{"id":"20240830102811-la61fdg","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【化学成份】枸橼成熟果实含橙皮甙、柠檬酸、苹果酸、粟胶、鞣质、维生素C及挥发油等。果实含油0.3～0.7％，果皮含袖6.5～9％，其成分为d-柠檬烯、柠檬醛、水芹烯和柠檬油素。幼果中含琥珀酸。种子含黄柏酮和黄柏内酯。"}]},{"ID":"20240830102811-pgxd3e4","Type":"NodeParagraph","Properties":{"id":"20240830102811-pgxd3e4","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830102811-kieap74","Type":"NodeParagraph","Properties":{"id":"20240830102811-kieap74","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"辛苦酸，温。"}]},{"ID":"20240830102811-3yki60l","Type":"NodeParagraph","Properties":{"id":"20240830102811-3yki60l","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"温。\""}]},{"ID":"20240830102811-u6bnhs7","Type":"NodeParagraph","Properties":{"id":"20240830102811-u6bnhs7","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"味辛酸，性温。\""}]},{"ID":"20240830102811-9vmy22u","Type":"NodeParagraph","Properties":{"id":"20240830102811-9vmy22u","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"③《饮膳正要》：\"味酸甘，平，无毒。\""}]},{"ID":"20240830102811-0alazze","Type":"NodeParagraph","Properties":{"id":"20240830102811-0alazze","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"④《本草通玄》：\"苦酸辛，温。\""}]},{"ID":"20240830102811-5zxtv9f","Type":"NodeParagraph","Properties":{"id":"20240830102811-5zxtv9f","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830102811-2tsun8r","Type":"NodeParagraph","Properties":{"id":"20240830102811-2tsun8r","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"入肝、肺、脾经。"}]},{"ID":"20240830102811-j6sldto","Type":"NodeParagraph","Properties":{"id":"20240830102811-j6sldto","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①《玉楸药解》：\"入手太阴肺经。\""}]},{"ID":"20240830102811-dipl8pm","Type":"NodeParagraph","Properties":{"id":"20240830102811-dipl8pm","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"入肺、脾二经。\""}]},{"ID":"20240830102811-d6264am","Type":"NodeParagraph","Properties":{"id":"20240830102811-d6264am","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾、肺三经。\""}]},{"ID":"20240830102811-tad18zv","Type":"NodeParagraph","Properties":{"id":"20240830102811-tad18zv","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830102811-wi9sy65","Type":"NodeParagraph","Properties":{"id":"20240830102811-wi9sy65","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"理气，舒郁，消痰，利膈。治胃痛胀满，痰饮咳嗽气塑，呕哕少食。"}]},{"ID":"20240830102811-4f1oun1","Type":"NodeParagraph","Properties":{"id":"20240830102811-4f1oun1","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"去气，除心头痰水。\""}]},{"ID":"20240830102811-9wgvtlm","Type":"NodeParagraph","Properties":{"id":"20240830102811-9wgvtlm","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②《饮膳正要》：\"下气，开胸膈。\""}]},{"ID":"20240830102811-kedeewz","Type":"NodeParagraph","Properties":{"id":"20240830102811-kedeewz","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"理上焦之气，止呕逆，进食，健脾。\""}]},{"ID":"20240830102811-140x5b3","Type":"NodeParagraph","Properties":{"id":"20240830102811-140x5b3","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"治咳嗽气壅。\""}]},{"ID":"20240830102811-fdq8ik7","Type":"NodeParagraph","Properties":{"id":"20240830102811-fdq8ik7","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"治胃脘痛，宽中顾气，开郁。\""}]},{"ID":"20240830102811-8iczs8b","Type":"NodeParagraph","Properties":{"id":"20240830102811-8iczs8b","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"平肝舒郁，理肺气，通经利水，治腰脚气。\""}]},{"ID":"20240830102811-sqjuuj0","Type":"NodeParagraph","Properties":{"id":"20240830102811-sqjuuj0","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"除久哮。\""}]},{"ID":"20240830102811-byg33h6","Type":"NodeParagraph","Properties":{"id":"20240830102811-byg33h6","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；或入丸、散。"}]},{"ID":"20240830102811-za1d5sh","Type":"NodeParagraph","Properties":{"id":"20240830102811-za1d5sh","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚血燥及孕妇气虚者慎服。"}]},{"ID":"20240830102811-gl06rbs","Type":"NodeParagraph","Properties":{"id":"20240830102811-gl06rbs","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830102811-sjhcc63","Type":"NodeParagraph","Properties":{"id":"20240830102811-sjhcc63","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①治鼓胀：陈香橼一枚（连瓤），大核桃肉二枚（连皮），缩砂仁二钱（去膜）。各煅存性为散，砂糖拌调。空心顿服。（《本经逢原》）"}]},{"ID":"20240830102811-6ou7mwu","Type":"NodeParagraph","Properties":{"id":"20240830102811-6ou7mwu","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②治嗽：香橼（去核）薄切作细片，以时酒同入砂瓶内，煮令熟烂，自昏至五更为度，用蜜拌匀。当睡中唤起，用匙挑服。（《养疴漫笔》）"}]},{"ID":"20240830102811-8ipn2xu","Type":"NodeParagraph","Properties":{"id":"20240830102811-8ipn2xu","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"③治气逆不进饮食或呕哕：陈极香橼二个，真川贝三两（去心），当归一两五钱（炒黑），白通草（烘燥）一两，陈西瓜皮一两，甜桔梗三钱。共研细末，用白檀香劈碎煎浓汁泛为丸，如桐子大，每服三钱，开水送下。大虚者酌用。（《梅氏验方新编》香橼丸）"}]},{"ID":"20240830102811-c6v35rq","Type":"NodeParagraph","Properties":{"id":"20240830102811-c6v35rq","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"④鲜香橼一两个，切碎放在有盖的碗中，加入等量的麦芽糖，隔水蒸数小时，以香橼稀烂为度，每服一匙，早晚各一次，有化痰、行气、止咳、平喘之效。"}]},{"ID":"20240830102811-aqapc89","Type":"NodeParagraph","Properties":{"id":"20240830102811-aqapc89","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑤盐渍香橼：香缘切片，于通风处晾干，用适量食盐腌渍放入玻璃瓶或瓷罐中备用。每用10～20克，用开水冲至咸淡适宜为度时服用。有行气，止痛，健胃，化食作用。适用于胃痛，腹痛，气痛，食滞胃胀痛等症。"}]},{"ID":"20240830102811-gvw8mux","Type":"NodeParagraph","Properties":{"id":"20240830102811-gvw8mux","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑥鲜香缘12～15克（干品6克），开水冲泡代茶饮，可治肝痛，胃气痛。"}]},{"ID":"20240830102811-8s7qe1m","Type":"NodeParagraph","Properties":{"id":"20240830102811-8s7qe1m","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"⑦陈香缘30克（焙干），花椒、小茴香各12克，共研细末，每次服3克，每日两次，温开水送服，治胃痛胸闷，消化不良。"}]},{"ID":"20240830102811-1dwlyc8","Type":"NodeParagraph","Properties":{"id":"20240830102811-1dwlyc8","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830102811-yvkkbxv","Type":"NodeParagraph","Properties":{"id":"20240830102811-yvkkbxv","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"①《本草通玄》：\"香圆性中和，单用多用亦损正气，与参、术同行则无弊也。\""}]},{"ID":"20240830102811-t2n0f1j","Type":"NodeParagraph","Properties":{"id":"20240830102811-t2n0f1j","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"柑橼乃佛手、香橼两种，性味相类，故《纲目》混论不分。盖柑者佛手也，橼者香橼也，兼破痰水，近世治咳嗽气壅，亦取陈者。除去瓤核用之，庶无酸收之患。\""}]},{"ID":"20240830102811-ho53rej","Type":"NodeParagraph","Properties":{"id":"20240830102811-ho53rej","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"③《本草便读》：\"香圆皮，下气消痰，宽中快膈。虽无橘皮之温，而究属香燥之晶，阴虚血燥之人仍当禁用耳。\""}]},{"ID":"20240830102811-eabk8gy","Type":"NodeParagraph","Properties":{"id":"20240830102811-eabk8gy","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830102811-opchytt","Type":"NodeParagraph","Properties":{"id":"20240830102811-opchytt","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"香橼《中华本草》"}]},{"ID":"20240830102811-ybl2mjw","Type":"NodeParagraph","Properties":{"id":"20240830102811-ybl2mjw","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草图经》：枸橼，如小瓜状，皮若橙，而光泽可爱，肉甚厚，切如萝卜，虽味短而香氛，大胜柑橘之类。陶隐居云性温宜人，今闽、广、江西皆有，彼人但谓之香橼子，或将至都下，亦贵之。《纲目》：枸橼，产闽、广间。木似朱栾而叶尖长，枝间有刺，植之近水乃生，其实状如人手，有指，俗呼为佛手柑；有长一尺四、五寸者，皮如橙、柚而厚，皱而光泽，其色如瓜，生绿熟黄，其核细，其味不甚佳而清香袭人。"}]},{"ID":"20240830102811-va0itlw","Type":"NodeParagraph","Properties":{"id":"20240830102811-va0itlw","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【拼音名】XiānɡYuán"}]},{"ID":"20240830102811-l165slv","Type":"NodeParagraph","Properties":{"id":"20240830102811-l165slv","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【英文名】CitronFruit"}]},{"ID":"20240830102811-mvv64c2","Type":"NodeParagraph","Properties":{"id":"20240830102811-mvv64c2","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【别名】枸橼、钩缘干、香泡树、香橼柑枸橼、香圆。"}]},{"ID":"20240830102811-sgqli1q","Type":"NodeParagraph","Properties":{"id":"20240830102811-sgqli1q","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830102811-c9rfmp8","Type":"NodeParagraph","Properties":{"id":"20240830102811-c9rfmp8","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"药材基源：为芸香科植物枸橼或香圆的成熟果实"}]},{"ID":"20240830102811-4wcasnn","Type":"NodeParagraph","Properties":{"id":"20240830102811-4wcasnn","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CitrusmedicaL."}]},{"ID":"20240830102811-zl5aqmu","Type":"NodeParagraph","Properties":{"id":"20240830102811-zl5aqmu","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植后4-5年结果，9-10月果实变黄成熟时采摘，用糠壳堆1星期，待皮变金黄色后，切成1cm厚，摊开曝晒；遇雨天可烘干。"}]},{"ID":"20240830102811-jgo77zt","Type":"NodeParagraph","Properties":{"id":"20240830102811-jgo77zt","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830102811-o69lkla","Type":"NodeParagraph","Properties":{"id":"20240830102811-o69lkla","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"1.枸橼常绿小乔木或灌木。枝有短硬棘刺，嫩枝光滑，带紫红色。叶互生；具短柄，无叶翼或略有痕迹，与叶片间无明显关节；叶片长圆形或倒卵状长圆形，长8-15cm，宽3.5-6.5cm，先端钝或短锐尖，基部宽楔形，边缘有锯齿，具半透明的油腺点。总状花序，3-10朵花生于叶腋；两性花或因雌蕊退化成雄花，具短柄；花萼浅杯状，上端5浅裂；花瓣5，内面白色，外面淡紫色；雄蕊30-60；雌蕊1，子房10-13室，每室有胚珠多数，花柱肥大，宿存，柱头头状。柑果长圆形、卵形或近球形，长10-25cm，先端有乳头状突起，果皮粗糙或平滑，熟时柠檬黄色，芳香、瓤囊小；种子卵圆形，表面平滑。花期4月，果熟期10-11月。"}]},{"ID":"20240830102811-go27lb0","Type":"NodeParagraph","Properties":{"id":"20240830102811-go27lb0","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"2．香圆常绿乔木，高9-11m。全株无毛，有短刺。叶互生；叶柄有倒心形宽翅，长约为叶片的1/3-l/4；叶片革质，椭圆形或长圆形，长5-12cm，宽2-5cm，先端短而钝或渐尖，微凹头，基部钝圆，全缘或有波状锯齿，两面无毛，有半透明油腺点。花单生或簇生，也有成总状花序，花白花；雄蕊25-36；子房10-11室。柑果长圆形、圆形或扁圆形，横径5-9cm，先端有乳头状突起，果皮通常粗糙而有皱纹或平滑，成熟时橙黄色，有香气；种子多数。花期4-5月，果熟期10-11月。"}]},{"ID":"20240830102811-3mf0lrz","Type":"NodeParagraph","Properties":{"id":"20240830102811-3mf0lrz","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830102811-3hlzvr3","Type":"NodeParagraph","Properties":{"id":"20240830102811-3hlzvr3","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"1.江苏、浙江、福建、台湾、湖北、湖南、广东、广西、四川、云南等地皆有栽培。"}]},{"ID":"20240830102811-6woiwca","Type":"NodeParagraph","Properties":{"id":"20240830102811-6woiwca","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"2.陕西、江苏、安徽、浙江、江西、湖北、四川等地有栽培。"}]},{"ID":"20240830102811-1qcgagy","Type":"NodeParagraph","Properties":{"id":"20240830102811-1qcgagy","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830102811-vvdn2ga","Type":"NodeParagraph","Properties":{"id":"20240830102811-vvdn2ga","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，怕严霜，不耐严寒。以土层深厚、疏松肥沃、富含腐殖质、排水良好的砂质壤上栽培为宜。"}]},{"ID":"20240830102811-l10zwct","Type":"NodeParagraph","Properties":{"id":"20240830102811-l10zwct","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子、扦插繁殖。种子繁殖：10月选成熟果实，切开取出种子，洗净，晾干，随即播种；或将种子用湿沙层积贮藏，春季播种。按行距30cm开条沟，将种子均匀播人，覆土，浇水。培育2-3年定植。扦插繁殖：选2-3年生枝条，除去棘刺，剪成18cm左右的小段，在春季高温高湿季节扦插。按行距30cm开条沟，株距12cm，斜插，将插穗露出地面1/3，覆土，压紧，浇水。培育1-2年定植。如在室内扦插，室温在25℃，并保持一定的湿度。移栽，春季按行株距3m×3m开穴，每穴栽苗1株，覆土压紧，浇水。"}]},{"ID":"20240830102811-4m7eref","Type":"NodeParagraph","Properties":{"id":"20240830102811-4m7eref","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"田间管理每年中耕除草、施肥2-3次。5-9月施人畜粪为主，亦可追施稀液饼肥；冬季增施过磷酸钙，可行开沟环施；修剪要剪去徒长枝、过密枝。结果期要插设支柱。"}]},{"ID":"20240830102811-ykt9n9i","Type":"NodeParagraph","Properties":{"id":"20240830102811-ykt9n9i","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有煤烟病为害叶、枝消、果实。虫害有吹棉介壳虫，可用天敌大红瓢虫防治；亦可喷松脂合剂，冬季稀释8-10倍，夏季稀释20倍液。此外，还有天牛、红蜘蛛、蚜虫。"}]},{"ID":"20240830102811-tls9z6m","Type":"NodeParagraph","Properties":{"id":"20240830102811-tls9z6m","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830102811-4bvagz9","Type":"NodeParagraph","Properties":{"id":"20240830102811-4bvagz9","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）拘橼为圆形或长圆形片，直径3-10cm，厚约2-5mm。横切面边缘略呈波状，外果皮黄绿色或浅橙黄色，散有凹入的油点；中果皮厚1.5-3.5cm，黄白色，较粗糙，有不规则的网状突起（维管束）。瓤囊11-16瓣，有时可见棕红色皱缩的汁胞残留；种子1-2颗。中轴明显，宽至1.2cm。质柔韧。气清香，味微甜而苦辛。以片包黄白、香气浓者为佳。"}]},{"ID":"20240830102811-mft8crq","Type":"NodeParagraph","Properties":{"id":"20240830102811-mft8crq","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"（2）香圆为类球形或圆形片状，直径4-7cm。表面灰绿色或黄棕色，较粗糙，密布凹陷小油点，顶端有花柱残痕及圆圈状环纹，习称“金钱环”，基部有果柄痕。质坚硬，横切面边缘油点明显，中果皮厚约0.5cm，瓤囊9-12瓣，棕色或淡棕色，间有黄白色种子。气香，味酸而苦。以个大、皮粗、色黑绿、香气浓者为佳。"}]},{"ID":"20240830102811-dksd2ln","Type":"NodeParagraph","Properties":{"id":"20240830102811-dksd2ln","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：枸橼表皮为1列细胞，外被角质层，有气孔。中果皮细胞类圆形，排列疏松，外侧有大型油室排成1-2列，油室长圆形，径向长450-1060μm，切向长130-650μm。维管束纵横散布。草酸钙方晶长至17μm。"}]},{"ID":"20240830102811-0862w8c","Type":"NodeParagraph","Properties":{"id":"20240830102811-0862w8c","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"粉末特征：（1）枸橼浅绿色①表皮细胞类方形或多角形，气孔类圆形，直径约22μm，副卫细胞5-6-9，排成放射状。②中果皮细胞类圆形厚6-18μm（不加热测量）③瓤囊表皮细胞长方形，壁稍厚。④草酸钙方晶易见，8-17μm。⑤螺纹或网纹导管直径8-20μm。⑥油室碎片可见。"}]},{"ID":"20240830102811-3r14d3x","Type":"NodeParagraph","Properties":{"id":"20240830102811-3r14d3x","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"（2）香圆淡棕黄色。①表皮细胞多角形或不规则长方形，长6-16μm，壁薄。气孔直径20-27μm，副卫细胞5-8个。③中果皮细胞壁厚3-10μm。③草酸钙方晶长6-28μm。④导管主为螺纹或孔纹。⑤油室大小悬殊，径向长360-1170μm，切向长195-520μm。"}]},{"ID":"20240830102811-ea2tqba","Type":"NodeParagraph","Properties":{"id":"20240830102811-ea2tqba","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830102811-fcgj4j8","Type":"NodeParagraph","Properties":{"id":"20240830102811-fcgj4j8","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"1．枸橼成熟果实含橙皮甙（hesperidin），枸橼酸（citricacid），苹果酸（malicacid），果胶，鞣质及维生素C等。果实含油0.3％-0.7％，果皮含油6.5％-9％，油中含有乙酸牻牛儿醉酯（geranylacetate），乙酸芳樟醇酯（linalylacetate），右旋柠檬烯（limonene），柠檬醛（citral），水芹烯（phellandrene），柠檬油素（citropten）等。幼果中含琥珀酸（succinicacid）。种子含黄柏酮（obacunone），黄柏内酯（obaculac-tone）。果实中还含β-谷甾醇（β-sitosterol），胡萝卜甙（daucosterol）和三萜苦味素：枸橼苦素（citrusin）。"}]},{"ID":"20240830102811-qkkbcqm","Type":"NodeParagraph","Properties":{"id":"20240830102811-qkkbcqm","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"2．香圆果皮中含胡萝卜素类成分：堇黄质（violaxanthin），叶黄素环氧化物（luteinepoxide），轻基-a-胡萝卜素（hy-droxy-a-carotene），新黄质（neoxanthin），β-阿扑-8-胡萝卜醛（β-apo-8-carotenal），β-胡萝卜素氧化物（mutatochrome），η-胡萝卜素（η-carotene），异堇黄质（auroxanthin），黄体呋喃素（luteoxan-thin），玉米黄质（mutatoxanthin），隐黄素（cryptoflavin），六氢番茄烃（phytofluene）以及多量的维生素A活性物质。幼果含生物碱：辛弗林（syephine），N-甲基酪胺（N-methyltyramine）。叶含挥发油43％，其中主成分为γ-松油烯（γ-terpiene），对-聚伞花素（p-cymene），柠檬烯（limonene）和橙花醛（neral），还含a-及β-获烯（pinene），月桂烯（myrcene），a-水芹烯（a-phellandrene），罗勒烯（ocimene），异松油烯（terpinolene），香茅醛（citronellal），香茅酸（citronellol），癸醛（decanal），芳樟醇（linalool），4-松油醇（4-terpineol），壬酸（nonanol），a-松油醇（a-ter-pieol），牻牛儿醛（geranial），橙花醇（nerol），乙酸牻牛儿醇酯（geranylacetate），牻牛儿醇（geraniol），衣兰烯（ylangene），丁香。烯（caryophyllene）以及樟烯（camphene），3-蒈烯（△3-carene），辛醛（octanal），庚醛（heptanal）。"}]},{"ID":"20240830102811-recx6a3","Type":"NodeParagraph","Properties":{"id":"20240830102811-recx6a3","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830102811-ylfb1te","Type":"NodeParagraph","Properties":{"id":"20240830102811-ylfb1te","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"所含挥发油对胃肠道有温和刺激作用，能促进肠胃里蠕动和消化液分泌，排除肠内积气，并有祛痰作用。"}]},{"ID":"20240830102811-s3cn4sg","Type":"NodeParagraph","Properties":{"id":"20240830102811-s3cn4sg","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"1.抗炎作用：本品所含的橙皮甙对豚鼠因缺乏维生素C而致的眼睛球结膜血管内细胞凝聚及毛细血管抵抗力降低有改善作用，能降低马血细胞之凝聚。与栓塞（Thrombogenic）饲料或与致粥样硬化饲料共同喂养大鼠，均可延长大鼠存活时间。能刺激缺乏维生素C的豚鼠的生长速度，增加豚鼠肾上腺、脾及白细胞中维生素C的含量。"}]},{"ID":"20240830102811-5ni0par","Type":"NodeParagraph","Properties":{"id":"20240830102811-5ni0par","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"2.抗病毒作用：橙皮甙加入小泡性口炎病毒前，将小鼠纤维细胞放于200μg/ml的橙皮甙中预先孵化处理，能保护细胞不受病毒侵害约24小时。预先处理Hela细胞能预防流感病毒的感染。但其抗病毒的活性可被透明质酸酶所消除。"}]},{"ID":"20240830102811-olfcd59","Type":"NodeParagraph","Properties":{"id":"20240830102811-olfcd59","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"3.其它作用：橙皮甙有预防冻伤和抑制大鼠晶状体的醛还原酶作用。黄柏酮有增强离体兔肠张力和振幅的作用。"}]},{"ID":"20240830102811-li5h06s","Type":"NodeParagraph","Properties":{"id":"20240830102811-li5h06s","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【鉴别】见橘红。"}]},{"ID":"20240830102811-rhofpwr","Type":"NodeParagraph","Properties":{"id":"20240830102811-rhofpwr","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【性味】辛；苦；酸；温"}]},{"ID":"20240830102811-9suwrps","Type":"NodeParagraph","Properties":{"id":"20240830102811-9suwrps","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肺；脾经"}]},{"ID":"20240830102811-x9hem5s","Type":"NodeParagraph","Properties":{"id":"20240830102811-x9hem5s","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【功能主治】理气降逆；宽胸化痰。主胸腹满闷；胁肋胀痛；咳嗽痰多"}]},{"ID":"20240830102811-7vjb0qu","Type":"NodeParagraph","Properties":{"id":"20240830102811-7vjb0qu","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g；或入丸、散。"}]},{"ID":"20240830102811-xn0r5jn","Type":"NodeParagraph","Properties":{"id":"20240830102811-xn0r5jn","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚血燥及孕妇气虚者慎服。"}]},{"ID":"20240830102811-ojmpgrj","Type":"NodeParagraph","Properties":{"id":"20240830102811-ojmpgrj","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【附方】①治鼓胀：陈香橼一枚(连瓤)，大核桃肉二枚(连皮)，缩砂仁二钱(去膜)。各煅存性为散，砂糖拌调。空心顿服。(《本经逢原》)②治嗽：香橼(去核)薄切作细片，以时酒同入砂瓶内，煮令熟烂，自昏至五更为度，用蜜拌匀。当睡中唤起，用匙挑服。(《养病漫笔》)③治气逆不进饮食或呕哕：陈极香橼二个，真川贝三两(去心)，当归一两五钱(炒黑)，白通草(烘燥)一两，陈西瓜皮一两，甜桔梗三钱。共研细末，用白檀香劈碎煎浓汁泛为丸，如桐子大。每服三钱，开水送下。大虚者酌用。(《梅氏验方新编》香橼丸)"}]},{"ID":"20240830102811-dnsgyu0","Type":"NodeParagraph","Properties":{"id":"20240830102811-dnsgyu0","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830102811-zya6tc2","Type":"NodeParagraph","Properties":{"id":"20240830102811-zya6tc2","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：去气，除心头痰水。"}]},{"ID":"20240830102811-fd37hif","Type":"NodeParagraph","Properties":{"id":"20240830102811-fd37hif","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"2.《饮膳正要》：下气，开胸膈。"}]},{"ID":"20240830102811-2vhjc0d","Type":"NodeParagraph","Properties":{"id":"20240830102811-2vhjc0d","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：理上焦之气，止呕逆，进食，健脾。"}]},{"ID":"20240830102811-9fsad4q","Type":"NodeParagraph","Properties":{"id":"20240830102811-9fsad4q","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：治咳嗽气壅。"}]},{"ID":"20240830102811-ixursm9","Type":"NodeParagraph","Properties":{"id":"20240830102811-ixursm9","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"5.《医林纂要》：治胃脘痛，宽中顺气，开郁。"}]},{"ID":"20240830102811-l6zb6nb","Type":"NodeParagraph","Properties":{"id":"20240830102811-l6zb6nb","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"6.《本草再新》：平肝舒郁，理肺气，通经利水，治腰脚气。"}]},{"ID":"20240830102811-ttszcp4","Type":"NodeParagraph","Properties":{"id":"20240830102811-ttszcp4","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"7.《本草求原》：除久哮。"}]},{"ID":"20240830102811-7j4d0py","Type":"NodeParagraph","Properties":{"id":"20240830102811-7j4d0py","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"8.《本草通玄》：香圆性中和，单用多用亦损正气，与参、术同行则无弊也。"}]},{"ID":"20240830102811-z4hi6ng","Type":"NodeParagraph","Properties":{"id":"20240830102811-z4hi6ng","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"9.《本经逢原》：柑橼乃佛手、香橼两种，性味相类，故《纲目》混论不分。盖柑者佛手也，橼者香橼也，兼破痰水，近世治咳嗽气壅，亦取陈者。除去瓤核用之，庶无酸收之患。"}]},{"ID":"20240830102811-fu1jr75","Type":"NodeParagraph","Properties":{"id":"20240830102811-fu1jr75","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"10.《本草便读》：香圆皮，下气消痰，宽中快膈。虽无橘皮之温，而究属香燥之品，阴虚血燥之人仍当禁用耳。"}]},{"ID":"20240830102811-q0u3q1r","Type":"NodeParagraph","Properties":{"id":"20240830102811-q0u3q1r","updated":"20240830102838"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830102812-3takyar","Type":"NodeThematicBreak","Properties":{"id":"20240830102812-3takyar","updated":"20240830102838"}},{"ID":"20240830102813-ahjlrg8","Type":"NodeParagraph","Properties":{"id":"20240830102813-ahjlrg8","updated":"20240830102838"}}]}