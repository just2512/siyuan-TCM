{"ID":"20240206103528-1v778q7","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240206103528-1v778q7","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206103528-1v778q7\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206103537-006wfeq\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240206103531-6eb1blh\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206103537-006wfeq\u0026quot;,\u0026quot;focusStart\u0026quot;:138,\u0026quot;focusEnd\u0026quot;:138\u0026#125;","title":" 香橼","type":"doc","updated":"20240830102818"},"Children":[{"ID":"20240206103537-006wfeq","Type":"NodeParagraph","Properties":{"id":"20240206103537-006wfeq","updated":"20240206103540"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产四川、福建、云南等地。\n【性状】\t果为圆形或长圆形片，直径410cm，厚0.20.5cm。横切片外果皮黄色或黄绿色，边缘呈波状，散有凹人的油点；中果皮厚13cm，黄白色，有不规则的网状突起的维管束；瓤囊1017室。纵切片中心柱较粗壮。质柔韧。气清香味微甜而苦辛。\n【性味】\t辛、苦、酸，温。\n【功效】\t疏肝理气，宽中化痰。用于胸腹满闷；胁肋胀痛；咳嗽痰多。\n【注解】\t“瓤囊”：指柑橘类果实内果皮和着生在内果皮上的囊状毛。"}]},{"ID":"20240206103531-6eb1blh","Type":"NodeParagraph","Properties":{"id":"20240206103531-6eb1blh","updated":"20240206103531"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206103531-ajp2m36.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709080629-gymwdk7","Type":"NodeParagraph","Properties":{"id":"20240709080629-gymwdk7","updated":"20240709080629"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 420px;","style":"width: 410px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼7-20240709080629-95fz7pm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830102651-ha4lb8x","Type":"NodeParagraph","Properties":{"id":"20240830102651-ha4lb8x","updated":"20240830102651"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼花-20240709080847-4obo6sl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼花3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼花3-20240709080952-70yj0n3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"香橼花2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/香橼花2-20240709080917-1jctqo8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830102659-co9hmp7","Type":"NodeParagraph","Properties":{"id":"20240830102659-co9hmp7","updated":"20240830102659"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style