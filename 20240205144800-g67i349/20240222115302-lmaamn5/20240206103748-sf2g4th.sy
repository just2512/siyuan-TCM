g"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"油柑子 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/油柑子 9-20240709145015-z1tl7gc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 412px;\" parent-style=\"width: 422px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 833px;","style":"width: 823px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"油柑子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/油柑子 10-20240709145107-0up95d5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 823px;\" parent-style=\"width: 833px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709145111-uamq1yj","Type":"NodeThematicBreak","Properties":{"id":"20240709145111-uamq1yj"}},{"ID":"20240830115900-2531iqv","Type":"NodeParagraph","Properties":{"id":"20240830115900-2531iqv","updated":"20240830115908"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：余甘子"}]},{"ID":"20240830115900-ov52hlp","Type":"NodeParagraph","Properties":{"id":"20240830115900-ov52hlp","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"余甘子《中国药典》"}]},{"ID":"20240830115900-iz16kzl","Type":"NodeParagraph","Properties":{"id":"20240830115900-iz16kzl","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【拼音名】YúGānZǐ"}]},{"ID":"20240830115900-mznkol9","Type":"NodeParagraph","Properties":{"id":"20240830115900-mznkol9","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【来源】本品系藏族习用药材。为大戟科油柑属植物余甘子PhyllanthusemblicaL.的干燥成熟果实。冬季至次春果实成熟时采收，除去杂质，干燥。"}]},{"ID":"20240830115900-t4dxeqt","Type":"NodeParagraph","Properties":{"id":"20240830115900-t4dxeqt","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈球形或扁球形，直径1.2～2cm。表面棕褐色至墨绿色，有浅黄色颗粒状突起，具皱纹及不明显的6棱，果梗约1mm。外果皮厚1～4mm，质硬而脆。内果皮黄白色，硬核样，表面略具6棱，背缝线的偏上部有数条筋脉纹，干后可裂成6瓣。种子6，近三棱形，棕色。气微，味酸涩，回甜。"}]},{"ID":"20240830115900-160lyqf","Type":"NodeParagraph","Properties":{"id":"20240830115900-160lyqf","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性味】甘、酸、涩、凉。"}]},{"ID":"20240830115900-m27rkpz","Type":"NodeParagraph","Properties":{"id":"20240830115900-m27rkpz","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、胃经。"}]},{"ID":"20240830115900-238tqfq","Type":"NodeParagraph","Properties":{"id":"20240830115900-238tqfq","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热凉血，消食健胃，生津止咳。用于血热血瘀，消化不良，腹胀，咳嗽，喉痛，口干。"}]},{"ID":"20240830115900-t8ur8k8","Type":"NodeParagraph","Properties":{"id":"20240830115900-t8ur8k8","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g，多入丸散服。"}]},{"ID":"20240830115900-sry2ahk","Type":"NodeParagraph","Properties":{"id":"20240830115900-sry2ahk","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240830115900-f0e3x7n","Type":"NodeParagraph","Properties":{"id":"20240830115900-f0e3x7n","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830115900-jc87a5z","Type":"NodeParagraph","Properties":{"id":"20240830115900-jc87a5z","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"余甘子《全国中草药汇编》"}]},{"ID":"20240830115900-1q8duds","Type":"NodeParagraph","Properties":{"id":"20240830115900-1q8duds","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【拼音名】YúGānZǐ"}]},{"ID":"20240830115900-rnmlmne","Type":"NodeParagraph","Properties":{"id":"20240830115900-rnmlmne","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【别名】滇橄榄、橄榄[云南.四川]、庵摩勒、油柑子"}]},{"ID":"20240830115900-uhegdcj","Type":"NodeParagraph","Properties":{"id":"20240830115900-uhegdcj","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【来源】为大戟科油柑属植物余甘子PhyllanthusemblicaL.，根、叶、树皮等亦可入药。根、树皮全年可采，鲜用或晒干；叶春夏采，鲜用或浸渍用。"}]},{"ID":"20240830115900-u0cl8pq","Type":"NodeParagraph","Properties":{"id":"20240830115900-u0cl8pq","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830115900-zj2fjut","Type":"NodeParagraph","Properties":{"id":"20240830115900-zj2fjut","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"果：甘、微涩、凉。"}]},{"ID":"20240830115900-17mwwso","Type":"NodeParagraph","Properties":{"id":"20240830115900-17mwwso","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"根：淡，平。"}]},{"ID":"20240830115900-sha54wd","Type":"NodeParagraph","Properties":{"id":"20240830115900-sha54wd","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"叶：辛，平。"}]},{"ID":"20240830115900-8huujll","Type":"NodeParagraph","Properties":{"id":"20240830115900-8huujll","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830115900-80kvqwl","Type":"NodeParagraph","Properties":{"id":"20240830115900-80kvqwl","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"果：感冒发热，咽喉痛，咳嗽，口干烦渴，牙痛，维生素丙缺乏症。"}]},{"ID":"20240830115900-mdld206","Type":"NodeParagraph","Properties":{"id":"20240830115900-mdld206","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"根：用于高血压病胃痛，肠炎，淋巴结结核。"}]},{"ID":"20240830115900-8k0eygk","Type":"NodeParagraph","Properties":{"id":"20240830115900-8k0eygk","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"叶：祛湿利尿。用于水肿，皮肤湿疹。"}]},{"ID":"20240830115900-ul046sk","Type":"NodeParagraph","Properties":{"id":"20240830115900-ul046sk","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【用法用量】果：10～30个，根：0.5～1两，叶3～6钱；外用适量，煎水洗患处。"}]},{"ID":"20240830115900-um2j030","Type":"NodeParagraph","Properties":{"id":"20240830115900-um2j030","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830115900-z5se687","Type":"NodeParagraph","Properties":{"id":"20240830115900-z5se687","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"余甘子《*辞典》"}]},{"ID":"20240830115900-2rxlbo3","Type":"NodeParagraph","Properties":{"id":"20240830115900-2rxlbo3","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【拼音名】YúGānZǐ"}]},{"ID":"20240830115900-7hs7dly","Type":"NodeParagraph","Properties":{"id":"20240830115900-7hs7dly","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSPHYLLANTHI"}]},{"ID":"20240830115900-mapwokq","Type":"NodeParagraph","Properties":{"id":"20240830115900-mapwokq","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【来源】本品系藏族习用药材，为大戟科植物余甘子PhyllanthusemblicaL.的干燥成熟果实。冬季至次春果实成熟时采收，除去杂质，干燥。"}]},{"ID":"20240830115900-gre9s6z","Type":"NodeParagraph","Properties":{"id":"20240830115900-gre9s6z","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈球形或扁球形，直径1.2～2cm。表面棕褐色至墨绿色，有浅黄色颗粒状突起，具皱纹及不明显的6棱，果梗约1mm。中果皮厚1～4mm，质硬而脆。内果皮黄白色，硬核样，表面略具6棱，背缝线偏上部有数条维管束，干后可裂成6瓣。种子6，近三棱形，棕色。气微，味酸涩，回甜。"}]},{"ID":"20240830115900-izcpof6","Type":"NodeParagraph","Properties":{"id":"20240830115900-izcpof6","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性味】甘、酸、涩、凉。"}]},{"ID":"20240830115900-itdznpa","Type":"NodeParagraph","Properties":{"id":"20240830115900-itdznpa","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热凉血，消食健胃，生津止咳。用于血热血瘀，肝胆病，消化不良，腹痛，咳嗽，喉痛，口干。"}]},{"ID":"20240830115900-5na44tx","Type":"NodeParagraph","Properties":{"id":"20240830115900-5na44tx","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g，多入丸散服。"}]},{"ID":"20240830115900-gcfu4qm","Type":"NodeParagraph","Properties":{"id":"20240830115900-gcfu4qm","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240830115900-r2dieow","Type":"NodeParagraph","Properties":{"id":"20240830115900-r2dieow","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830115900-mxbdpjk","Type":"NodeParagraph","Properties":{"id":"20240830115900-mxbdpjk","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"余甘子《中华本草》"}]},{"ID":"20240830115900-tvc33bz","Type":"NodeParagraph","Properties":{"id":"20240830115900-tvc33bz","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830115900-tj80kul","Type":"NodeParagraph","Properties":{"id":"20240830115900-tj80kul","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"出自《唐本草》。"}]},{"ID":"20240830115900-nslzl9a","Type":"NodeParagraph","Properties":{"id":"20240830115900-nslzl9a","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：庵摩勒生岭南。树叶细似合昏，花黄，实似李柰，青黄色，核圆，六、七棱。中仁亦入药。"}]},{"ID":"20240830115900-287lm41","Type":"NodeParagraph","Properties":{"id":"20240830115900-287lm41","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：庵摩勒，个二广诸郡及西川山谷中皆有之。木高一、二丈，枝条甚软，叶青细密，朝开暮敛，如合欢夜合而叶微小，春生冬雕，三月有花，着条而生如粟粒，微黄，随即结实作关，每条三两子，至冬而熟，如李子状，胄白色，连核作五、六瓣，干即并核皆裂。"}]},{"ID":"20240830115900-rptchne","Type":"NodeParagraph","Properties":{"id":"20240830115900-rptchne","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【拼音名】YúGānZǐ"}]},{"ID":"20240830115900-nilj1j1","Type":"NodeParagraph","Properties":{"id":"20240830115900-nilj1j1","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【英文名】emblicleafflowerfruit,FruitofEmblicLeafflower"}]},{"ID":"20240830115900-5la2kr9","Type":"NodeParagraph","Properties":{"id":"20240830115900-5la2kr9","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【别名】余甘、庵摩勒、庵摩落迦果、土橄榄、望果、油甘子、牛甘子、橄揽子、喉甘子、鱼木果、滇橄榄、橄榄。"}]},{"ID":"20240830115900-3iycm96","Type":"NodeParagraph","Properties":{"id":"20240830115900-3iycm96","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830115900-od676qv","Type":"NodeParagraph","Properties":{"id":"20240830115900-od676qv","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"药材基源：为大戟科植物余甘子的果实。"}]},{"ID":"20240830115900-pik7c59","Type":"NodeParagraph","Properties":{"id":"20240830115900-pik7c59","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：PhyllanthusemblicaL."}]},{"ID":"20240830115900-u36tohy","Type":"NodeParagraph","Properties":{"id":"20240830115900-u36tohy","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月果实时采收，开水烫透或用盐水浸后，晒干。"}]},{"ID":"20240830115900-0l3junh","Type":"NodeParagraph","Properties":{"id":"20240830115900-0l3junh","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【原形态】余甘子落叶小乔木或灌木，高3-8m。树皮灰白色，薄而易脱落，露出大块赤红色内皮。叶互生于细弱的小枝上，2列，密生，极似羽状复叶；近无柄；落叶时整个小枝脱落；托叶线状披针形；叶片长方线形或线状长圆形，长1-2cm，宽3-5mm。花簇生于叶腋，花小，黄色；单性，雌雄同株，具短柄；每花簇有1朵雌花，每花有花萼5-6片，无瓣；雄花花盘成6个极小的腺体，雄蕊3，合生成柱；雌花花盘杯状，边缘撕裂状，子房半藏其中。果实肉质，径约1.5cm，圆而略带6棱，初为黄绿色，成熟后呈赤红色，味先酸涩而后回甜。花期4-5月，果期9-11月。"}]},{"ID":"20240830115900-0kjk2iy","Type":"NodeParagraph","Properties":{"id":"20240830115900-0kjk2iy","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830115900-38ehzvj","Type":"NodeParagraph","Properties":{"id":"20240830115900-38ehzvj","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔300-1200m的疏林下或山坡向阳处。"}]},{"ID":"20240830115900-ak1ykn3","Type":"NodeParagraph","Properties":{"id":"20240830115900-ak1ykn3","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、台湾、广东、海南、广西、四川、贵州、云南等地。"}]},{"ID":"20240830115900-pv1ii7i","Type":"NodeParagraph","Properties":{"id":"20240830115900-pv1ii7i","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830115900-xqx4t66","Type":"NodeParagraph","Properties":{"id":"20240830115900-xqx4t66","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，怕寒冷，遇霜容易落叶、落花，甚至冻坏嫩枝条。对土壤要求不严，南方各类山地均可种植。以向阳山坡、梯田和园地栽培为宜。"}]},{"ID":"20240830115900-z7ihvtp","Type":"NodeParagraph","Properties":{"id":"20240830115900-z7ihvtp","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子和嫁接繁殖。种子繁殖：春季播种育苗待苗木生长到70-100cm，可和优良品种进行嫁接。嫁接繁殖：选取2-4年野生余甘子为砧木，取2年生的优良品种枝条为接穗，于2-5月间嫁接。成活后按行株距4m×3m或4m×4m移栽，1hm2种植600-825株。"}]},{"ID":"20240830115900-ll0pmid","Type":"NodeParagraph","Properties":{"id":"20240830115900-ll0pmid","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"田间管理每年春、夏和秋季各施一次肥，有条件地区应施复合肥或套种绿肥，以改良土壤肥力。平时要勤除杂草、松土和培土。"}]},{"ID":"20240830115900-hod093p","Type":"NodeParagraph","Properties":{"id":"20240830115900-hod093p","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"病虫害防治虫害有木毒蛾、介壳虫、蚜虫等，可用0.l％-0.8％的甲胺磷等喷射。"}]},{"ID":"20240830115900-geuf7ui","Type":"NodeParagraph","Properties":{"id":"20240830115900-geuf7ui","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830115900-9z8uvvc","Type":"NodeParagraph","Properties":{"id":"20240830115900-9z8uvvc","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"性状鉴别果实球形或扁球形，直径1.2-2cm。表面棕褐色至墨绿色，有淡黄色颗粒状突起，具皱纹及不明显的6棱，果梗长约lmm，果肉（中果皮）厚1-4mm，质硬而脆。内果皮黄白色，硬核样，表面略具6棱，背缝线的偏上部有数条维管束，干后裂成6瓣。种子6颗，近三棱形，棕色。气微，味酸涩，回甜。以个大、肉厚、回甜味浓者为佳。"}]},{"ID":"20240830115900-a3zctrk","Type":"NodeParagraph","Properties":{"id":"20240830115900-a3zctrk","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：外果皮由胞壁增厚的多角形细胞2-7列组成，细胞直径8-20μm。中果皮较广厚，为薄壁细胞组成，有维管束通过，薄壁细胞直径32-65μm，细胞内常有草酸钙柱晶和方晶等。内果皮为多列较小的石细胞组成，胞腔明显，层纹不甚清楚。"}]},{"ID":"20240830115900-oveljx1","Type":"NodeParagraph","Properties":{"id":"20240830115900-oveljx1","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含鞣质，其中有葡萄糖没食子鞣甙（glucogallin），没食子酸（gallicacid），并没食子酸（ellagicacid），鞣料云实精（corilagin），原诃子酸（terchebin），诃黎勒酸（chebulagicacid），诃子酸（chebulinicacid），诃子次酸（chebulicacid），3，6-二没食子酰葡萄糖（3，6-digalloylglucose），干果含粘酸（mucicacid）4％-9％。果皮含没食子酸，油柑酸（phyllemblicacid），余甘子酚（emblicol）。种子含固定油约26％，油中含亚麻酸（linolenicacid）8.8％，亚油酸（linoleicacid）44％，油酸（oleicacid）28.4％，硬脂酸（stearicacid）2.2％，棕榈酸（palmiticacid）3.0％，肉豆蔻酸（myristicacid）1％等。"}]},{"ID":"20240830115900-x8wyqje","Type":"NodeParagraph","Properties":{"id":"20240830115900-x8wyqje","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830115900-tc2zsqa","Type":"NodeParagraph","Properties":{"id":"20240830115900-tc2zsqa","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"1.对心血管系统的作用：本品醇提物（1g／kg口服连续2天），可对抗由异丙肾上腺素（85mg／kg腹腔注射2天）引起的大鼠心肌坏死；并能增加心肌糖原水平，对血清脂及酸也产生明显的变化。本品lg／kg给予饲以高胆固醇家兔，与对照组相比较可明显降低血清胆固醇含量（P＜0.001）、冠状动脉胆固醇含量（P＜0.001）和肝胆固醇含量（P＜0.001），但不影响优球蛋白凝集溶解时间，血小板粘性或血清三酸甘油酯的水平，推测其作用不仅仅是含有维生素C的缘故，还有其他成分在起作用。"}]},{"ID":"20240830115900-jt8e56n","Type":"NodeParagraph","Properties":{"id":"20240830115900-jt8e56n","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"2．其他作用：本品提取物可对抗环境化学因子对哺乳类细胞的诱变作用，且强于同等剂量的维生素C。本品提取物1-10%浓度对810Rx线照射所致的染色体畸变有保护作用。照射前后用药均有效，其保护作用可能是所含的具抗氧作用的维生素C、没食子酸、还原糖、鞣质等。"}]},{"ID":"20240830115900-m5vqmk4","Type":"NodeParagraph","Properties":{"id":"20240830115900-m5vqmk4","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；甘；酸；性凉"}]},{"ID":"20240830115900-2g6dap3","Type":"NodeParagraph","Properties":{"id":"20240830115900-2g6dap3","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃经"}]},{"ID":"20240830115900-x1v4swy","Type":"NodeParagraph","Properties":{"id":"20240830115900-x1v4swy","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热利咽；润肺化痰；生津止渴。主感冒发热；咳嗽；咽痛；白喉；烦热口渴；高血压"}]},{"ID":"20240830115900-ad4qvj5","Type":"NodeParagraph","Properties":{"id":"20240830115900-ad4qvj5","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g；或鲜品取汁。"}]},{"ID":"20240830115900-t5z7bao","Type":"NodeParagraph","Properties":{"id":"20240830115900-t5z7bao","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者慎服"}]},{"ID":"20240830115900-pu1jmi0","Type":"NodeParagraph","Properties":{"id":"20240830115900-pu1jmi0","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【附方】①治感冒发热，咳嗽，咽喉痛，曰干烦渴，维生素C缺乏症：鲜余甘子果十至三十个。水煎服，(广州部队《常用中草药手册》)②治白喉：滇橄榄一斤，玄参、甘卓各一两。冷开水泡至起霜花，取霜用棉纸铺开晒干后，加马尾龙胆粉二钱，冰片五分，炒白果仁粉五钱，吹喉用。③治哮喘：滇橄榄二十一个，先煮猪心肺，夫浮沫再加橄榄煮熟连汤吃。④治河豚鱼中毒：滇橄榄生吃吞汁，并可治鱼骨梗喉。(②方以下出《昆明民间常用草药》)"}]},{"ID":"20240830115900-fo13h07","Type":"NodeParagraph","Properties":{"id":"20240830115900-fo13h07","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830115900-b7q7w6j","Type":"NodeParagraph","Properties":{"id":"20240830115900-b7q7w6j","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：主风虚热气。"}]},{"ID":"20240830115900-0bex2yo","Type":"NodeParagraph","Properties":{"id":"20240830115900-0bex2yo","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：主补益，强气力。取子压取汁和油涂头生发，去风痒，初涂发脱，后生如漆。"}]},{"ID":"20240830115900-dc29syf","Type":"NodeParagraph","Properties":{"id":"20240830115900-dc29syf","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"3.《海药本草》：主上气咳嗽。"}]},{"ID":"20240830115900-p5k6k72","Type":"NodeParagraph","Properties":{"id":"20240830115900-p5k6k72","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"4.《南宁市药物志》：清凉解毒，治喉痹。"}]},{"ID":"20240830115900-3ln3obo","Type":"NodeParagraph","Properties":{"id":"20240830115900-3ln3obo","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"5.广州部队《常用中草药手册》：润肺化痰，生津止渴。"}]},{"ID":"20240830115900-4taudct","Type":"NodeParagraph","Properties":{"id":"20240830115900-4taudct","updated":"20240830115925"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830115901-ey1b471","Type":"NodeThematicBreak","Properties":{"id":"20240830115901-ey1b471","updated":"20240830115925"}},{"ID":"20240830115902-zdes7qx","Type":"NodeParagraph","Properties":{"id":"20240830115902-zdes7qx","updated":"20240830115925"}}]}