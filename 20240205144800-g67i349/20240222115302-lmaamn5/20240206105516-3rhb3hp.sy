{"ID":"20240206105516-3rhb3hp","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240206105516-3rhb3hp","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206105516-3rhb3hp\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206105526-1ekx1ma\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240619182335-nr2bowf\u0026quot;,\u0026quot;scrollTop\u0026quot;:1192,\u0026quot;focusId\u0026quot;:\u0026quot;20240619182335-nr2bowf\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"伸筋草","type":"doc","updated":"20240830115324"},"Children":[{"ID":"20240206105526-1ekx1ma","Type":"NodeParagraph","Properties":{"id":"20240206105526-1ekx1ma","updated":"20240206105529"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于江苏、浙江、湖北等地。\n【性状】\t干燥根茎略弯曲，呈结节状，上面具茎痕，下面具多数细长的根，长1232cm，直径13mm，表面黄白色或黄棕色，有细皱纹。质韧，不易折断，断面不平坦，白色，有黄白色木心。气无，味微苦，带粘性。\n【性味】\t苦、辛，温。\n【功效】\t祛风散寒，除湿消肿，舒筋活络。用于风寒湿痹，筋脉拘挛疼痈。外用治跌打扭伤肿痛。"}]},{"ID":"20240206105520-hx4skrl","Type":"NodeParagraph","Properties":{"id":"20240206105520-hx4skrl","updated":"20240206105520"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206105520-2uatxzm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709133916-vbbxzor","Type":"NodeParagraph","Properties":{"id":"20240709133916-vbbxzor","updated":"20240709133916"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 652px;","style":"width: 642px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 2-20240709133916-ndtlvjt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 642px;\" parent-style=\"width: 652px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709134139-51gkpr4","Type":"NodeParagraph","Properties":{"id":"20240709134139-51gkpr4","updated":"20240709134211"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 399px;","style":"width: 389px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 5-20240709134210-10qoj99.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 389px;\" parent-style=\"width: 399px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 573px;","style":"width: 563px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 4-20240709134139-6rrfo64.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 563px;\" parent-style=\"width: 573px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709133724-tn0e9vx","Type":"NodeParagraph","Properties":{"id":"20240709133724-tn0e9vx","updated":"20240709133801"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 706px;","style":"width: 696px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草-20240709133721-3c5y8da.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 696px;\" parent-style=\"width: 706px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 473px;","style":"wid