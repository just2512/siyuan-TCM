ta":"assets/伸筋草 3-20240709134005-mb1n73i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 698px;\" parent-style=\"width: 708px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 11-20240709141327-u5n677s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709134433-6xcq996","Type":"NodeParagraph","Properties":{"id":"20240709134433-6xcq996","updated":"20240709140821"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 570px;","style":"width: 560px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 6-20240709134433-zj4kflk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 560px;\" parent-style=\"width: 570px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 417px;","style":"width: 407px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 7-20240709135040-le4a2iu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 407px;\" parent-style=\"width: 417px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619182335-nr2bowf","Type":"NodeParagraph","Properties":{"id":"20240619182335-nr2bowf","updated":"20240830115236"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 408px;","style":"width: 398px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"伸筋草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/伸筋草 9-20240709140909-7xaca61.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 398px;\" parent-style=\"width: 408px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240709141029-148ik6o","Type":"NodeThematicBreak","Properties":{"id":"20240709141029-148ik6o"}},{"ID":"20240830115313-vrlic3x","Type":"NodeParagraph","Properties":{"id":"20240830115313-vrlic3x","updated":"20240830115324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：伸筋草"}]},{"ID":"20240830115313-h2lf9st","Type":"NodeParagraph","Properties":{"id":"20240830115313-h2lf9st","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"伸筋草《中国药典》"}]},{"ID":"20240830115313-n0ffzmx","Type":"NodeParagraph","Properties":{"id":"20240830115313-n0ffzmx","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShēnJīnCǎo"}]},{"ID":"20240830115313-awdymsy","Type":"NodeParagraph","Properties":{"id":"20240830115313-awdymsy","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【英文名】HERBALYCOPODII"}]},{"ID":"20240830115313-ghqk8kd","Type":"NodeParagraph","Properties":{"id":"20240830115313-ghqk8kd","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【别名】石松、狮子尾、狮子草、绿毛伸筋、小伸筋、舒筋草"}]},{"ID":"20240830115313-mmhzsx0","Type":"NodeParagraph","Properties":{"id":"20240830115313-mmhzsx0","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【来源】本品为石松科植物石松LycopodiumjaponicumThunb.的干燥全草。夏、秋二季茎叶茂盛时采收，除去杂质，晒干。"}]},{"ID":"20240830115313-sxlvqbf","Type":"NodeParagraph","Properties":{"id":"20240830115313-sxlvqbf","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性状】本品匍匐茎呈细圆柱形，略弯曲，长可达2m，直径1～3mm，其下有黄白色细根。直立茎作二叉状分枝。叶密生茎上，螺旋状排列，皱缩弯曲，线形或针形，长3～5mm，黄绿色至淡黄棕色，无毛，先端芒状，全缘，易碎断。质柔软，断面皮部浅黄色，木部类白色。无臭，味淡。"}]},{"ID":"20240830115313-fmatkb6","Type":"NodeParagraph","Properties":{"id":"20240830115313-fmatkb6","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830115313-4bxzgrl","Type":"NodeParagraph","Properties":{"id":"20240830115313-4bxzgrl","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（1）本品茎横切面：表皮细胞1列。皮层宽广，有叶迹维管束散在，表皮下方和中柱外侧各有10～20余列厚壁细胞，其间有3～5列细胞壁略增厚；内皮层不明显。中柱鞘为数列薄壁细胞编织中柱，木质部束呈不规则的带状或分枝状，韧皮部束交错其间，有的细胞含黄棕色物。"}]},{"ID":"20240830115313-e3tivkv","Type":"NodeParagraph","Properties":{"id":"20240830115313-e3tivkv","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加乙醚15ml，浸泡过夜，滤过，滤液挥干，残渣加无水乙醇1ml使溶解，作为供试品溶液。另取伸筋草对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上,以氯仿-甲醇（40：1）为展开剂，展开，取出，晾干，喷以5％硫酸乙醇溶液，在105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240830115313-wdetque","Type":"NodeParagraph","Properties":{"id":"20240830115313-wdetque","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，切段，干燥。"}]},{"ID":"20240830115313-eb4ecxo","Type":"NodeParagraph","Properties":{"id":"20240830115313-eb4ecxo","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性味】微苦、辛，温。"}]},{"ID":"20240830115313-ipd3jrb","Type":"NodeParagraph","Properties":{"id":"20240830115313-ipd3jrb","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾、肾经。"}]},{"ID":"20240830115313-ko0cpbm","Type":"NodeParagraph","Properties":{"id":"20240830115313-ko0cpbm","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿，舒筋活络。用于关节酸痛，屈伸不利。"}]},{"ID":"20240830115313-bumxms5","Type":"NodeParagraph","Properties":{"id":"20240830115313-bumxms5","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～12g。"}]},{"ID":"20240830115313-ag55fr7","Type":"NodeParagraph","Properties":{"id":"20240830115313-ag55fr7","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830115313-0j8ch1h","Type":"NodeParagraph","Properties":{"id":"20240830115313-0j8ch1h","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【备注】（1）同属植物铺地蜈蚣（垂穗石松、马鹿角）LycopodiumcernuumL.功能主治类似，江西等地作伸筋草入药；玉柏LycopodiumobscurumL.在甘肃作伸筋草壅，功效相似。"}]},{"ID":"20240830115313-33jnf1u","Type":"NodeParagraph","Properties":{"id":"20240830115313-33jnf1u","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830115313-g8lkxis","Type":"NodeParagraph","Properties":{"id":"20240830115313-g8lkxis","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"伸筋草《*辞典》"}]},{"ID":"20240830115313-9l1dnsx","Type":"NodeParagraph","Properties":{"id":"20240830115313-9l1dnsx","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【出处】《分类草药性》"}]},{"ID":"20240830115313-6zd25df","Type":"NodeParagraph","Properties":{"id":"20240830115313-6zd25df","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShēnJīnCǎo"}]},{"ID":"20240830115313-4i6f8mg","Type":"NodeParagraph","Properties":{"id":"20240830115313-4i6f8mg","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【别名】石松（《本草拾遗》），过山龙（《滇南本草》），宽筋藤（《生草药性备要》），火炭葛（《本草求原》），金毛狮子草、金腰带、狮子草（《中药志》），狮子毛草（《中药材手册》），立筋草、舒筋草（《四川中药志》），铺筋草、抽筋草、分筋草、过筋草、地棚窝草（《重庆草药》），筋骨草（《陕西中药志》），绿毛伸筋、小伸筋、凤尾伸筋（《湖南药物志》），蜈蚣藤、大地毛公、缠身龙、猫藤草、通伸草、山猫儿、老虎垫坐、盘龙草、烂腰蛇、宽筋草、穿山龙（《浙江民间常用草药》）。"}]},{"ID":"20240830115313-vph20sq","Type":"NodeParagraph","Properties":{"id":"20240830115313-vph20sq","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【来源】为石松科植物石松的带根全草。夏季采收，连根拔起，去净泥土、杂质，晒干。"}]},{"ID":"20240830115313-ke1f5jx","Type":"NodeParagraph","Properties":{"id":"20240830115313-ke1f5jx","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830115313-z8mhjyv","Type":"NodeParagraph","Properties":{"id":"20240830115313-z8mhjyv","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"多年生草本。匍匐茎蔓生，分枝有叶疏生。直立茎高15～30厘米，分枝；营养枝多回分叉，密生叶，叶针形，长3～4毫米，先端有易脱落的芒状长尾；孢子枝从第二、第三年营养枝上长出，远高出营养枝，叶疏生；孢子囊穗长2.5～5厘米，有柄，通常2～6个生于孢子枝的上部；孢子叶卵状三角形，先端急尖而具尖尾，边缘有不规则的锯齿，孢子囊肾形，淡黄褐色，孢子同形。7、8月间孢子成熟。"}]},{"ID":"20240830115313-qcodk4o","Type":"NodeParagraph","Properties":{"id":"20240830115313-qcodk4o","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"本植物的孢子（石松子）亦供药用，另详专条。"}]},{"ID":"20240830115313-1u5rx4s","Type":"NodeParagraph","Properties":{"id":"20240830115313-1u5rx4s","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于疏林下荫蔽处。分布东北、华东、华南、西南及内蒙古、河南等地。主产浙江、湖北、江苏等地，湖南、四川亦产。"}]},{"ID":"20240830115313-g4fkrpj","Type":"NodeParagraph","Properties":{"id":"20240830115313-g4fkrpj","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性状】干燥匍匐茎细长而弯曲，黄色或黄绿色，长30～120厘米，径粗1～3毫米。质柔韧，不易折断，折断面近白色，内有黄白色木心，常可见近直角生出的黄白色细根，外皮常脱落。直立茎2歧式分枝。鳞叶常皱而弯曲，密生于茎上，线形或线状钻形，黄绿色或黄色，无毛，略有光泽。叶端渐尖呈芒状，全缘，叶脉不明显。质薄，易碎。气无，味淡。以茎长、黄绿色者为佳。"}]},{"ID":"20240830115313-recumi4","Type":"NodeParagraph","Properties":{"id":"20240830115313-recumi4","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草含石松碱、棒石松碱、棒石松洛宁碱、法氏石松碱、石松灵碱等生物碱，香荚兰酸、阿魏酸、壬二酸等酸性物质（占干品0.08％），芒柄花醇、伸筋草醇石松醇、石松宁、16-氧山芝烯二醇等三萜化合物。"}]},{"ID":"20240830115313-opvhv61","Type":"NodeParagraph","Properties":{"id":"20240830115313-opvhv61","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【药理作用】石松水浸剂对由皮下注射枯草浸剂引起发热之家兔有降温作用；其有效成分为石松碱及棒石松碱、棒石松毒，后二者之毒性较石松碱为弱。石松碱适当剂量能升高麻醉猫血压，也有报告30毫克／公斤静脉注射可使麻醉猫、兔血压骤降；此时对呼吸皆无影响，中毒量可增加动物呼吸振幅而减少频率。对蛙心收缩力有增强作用，对兔心1：50000～400000则减弱收缩力，收缩频率及心电图皆无改变。1：12500～50000对离体大鼠、啄鼠小肠有兴奋作用，兔离体小肠之蠕动亦被增强。对兔、大鼠及豚鼠子宫有兴奋作用。对兔静脉注射30～50毫克/公斤有降温作用。对兔血糖、瞳孔、末梢红细胞数皆无影响。无抗菌及抗疟作用。对小鼠静脉注射之半数致死量为27.58±1.16毫克／公斤，腹腔注射为78毫克／公斤，中毒症状有过度活动，强直性、阵挛性痉挛，麻痹，窒息等；兔之中毒症状相似。给蛙淋巴囊注射50～200毫克／公斤可引起肌肉运动不胁调、麻痹等。棒石松碱之毒性剂量：猫为0.05克／公斤、兔及大鼠为0.1～0.2克／公斤。有人报告石松有利尿、增进尿酸排泄之作用，还能解除小儿之痉挛性尿潴留及便秘等。"}]},{"ID":"20240830115313-ym2y261","Type":"NodeParagraph","Properties":{"id":"20240830115313-ym2y261","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【炮制】筛去灰屑，拣净杂质，切成小段。"}]},{"ID":"20240830115313-j85s75r","Type":"NodeParagraph","Properties":{"id":"20240830115313-j85s75r","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830115313-0gpprp1","Type":"NodeParagraph","Properties":{"id":"20240830115313-0gpprp1","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"苦辛，温。"}]},{"ID":"20240830115313-fa4cdkp","Type":"NodeParagraph","Properties":{"id":"20240830115313-fa4cdkp","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"味苦辛，温，无毒。\""}]},{"ID":"20240830115313-wfnb4vv","Type":"NodeParagraph","Properties":{"id":"20240830115313-wfnb4vv","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"②《本草求原）：\"甘涩，平。\""}]},{"ID":"20240830115313-53xb8p8","Type":"NodeParagraph","Properties":{"id":"20240830115313-53xb8p8","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【归经】《四川中药志》：\"入肝、脾、肾三经。\""}]},{"ID":"20240830115313-y38zom7","Type":"NodeParagraph","Properties":{"id":"20240830115313-y38zom7","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830115313-abv1eqw","Type":"NodeParagraph","Properties":{"id":"20240830115313-abv1eqw","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"祛风散寒，除湿消肿，舒筋活血。治风寒湿痹，关节酸痛，皮肤麻木，四肢软弱，水肿，跌打损伤。"}]},{"ID":"20240830115313-utj7sdc","Type":"NodeParagraph","Properties":{"id":"20240830115313-utj7sdc","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"主久患风痹，脚膝疼冷，皮肤不仁，气力衰弱。\""}]},{"ID":"20240830115313-vfikojo","Type":"NodeParagraph","Properties":{"id":"20240830115313-vfikojo","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"下气，消胸中痞满横格之气，推胃中隔宿之食，去年久腹中之坚积，消水肿。\""}]},{"ID":"20240830115313-l2w70ti","Type":"NodeParagraph","Properties":{"id":"20240830115313-l2w70ti","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"③《生草药性备要》：\"消肿，除风湿。浸酒饮，舒筋活络。其根治气结疼痛，损伤，金疮内伤，去痰止咳。\""}]},{"ID":"20240830115313-7i1ieg4","Type":"NodeParagraph","Properties":{"id":"20240830115313-7i1ieg4","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"④《浙江民间常用草药》：\"舒筋，消炎。治关节酸痛，带状疱疹。\""}]},{"ID":"20240830115313-b4mbhgb","Type":"NodeParagraph","Properties":{"id":"20240830115313-b4mbhgb","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"⑤《东北常用中草药手册》：\"舒筋活血，祛风散寒，止痛。治腰腿酸痛，风湿性关节肿痛，月经不调。\""}]},{"ID":"20240830115313-ybaxo2q","Type":"NodeParagraph","Properties":{"id":"20240830115313-ybaxo2q","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；或浸酒。外用：捣敷。"}]},{"ID":"20240830115313-uv57bbs","Type":"NodeParagraph","Properties":{"id":"20240830115313-uv57bbs","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【注意】《四川中药志》：\"孕妇及出血过多者忌服。\""}]},{"ID":"20240830115313-5g13sat","Type":"NodeParagraph","Properties":{"id":"20240830115313-5g13sat","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830115313-eihbfsq","Type":"NodeParagraph","Properties":{"id":"20240830115313-eihbfsq","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"①治风痹筋骨不舒：宽筋藤，每用三钱至一两，煎服。（《岭南采药录》）"}]},{"ID":"20240830115313-as3hac2","Type":"NodeParagraph","Properties":{"id":"20240830115313-as3hac2","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"②治关节酸痛：石松三钱，虎杖根五钱，大血藤三钱。水煎服。（《浙江民间常用草药》）"}]},{"ID":"20240830115313-9phw34i","Type":"NodeParagraph","Properties":{"id":"20240830115313-9phw34i","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"③治关节酸痛，手足麻痹：凤尾伸筋草一两，丝瓜络五钱，爬山虎五钱，大活血三钱。水、酒各半煎服。（江西《中草药学》）"}]},{"ID":"20240830115313-2p4ozzm","Type":"NodeParagraph","Properties":{"id":"20240830115313-2p4ozzm","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"④治小儿麻痹后遗症：凤尾伸筋、南蛇藤根、松节、寻骨风各五钱，威灵仙三钱，茜草二钱，杜蘅五分。煎服。（江西《中草药学》）"}]},{"ID":"20240830115313-yb865si","Type":"NodeParagraph","Properties":{"id":"20240830115313-yb865si","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"⑤消水肿：过山龙五分（研细末），糠瓢一钱五分（火煅存性），槟榔一钱。槟榔、糠瓢煨汤吃过山龙末，以泻为度。气实者用，虚者忌。（《滇南本草》）"}]},{"ID":"20240830115313-v8x7sda","Type":"NodeParagraph","Properties":{"id":"20240830115313-v8x7sda","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"⑥治带状疱疹：石松（焙）研粉，青油或麻油调成糊状，涂患处，一日数次。（《浙江民间常用草药》）"}]},{"ID":"20240830115313-3hvfx98","Type":"NodeParagraph","Properties":{"id":"20240830115313-3hvfx98","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【备注】同属植物玉柏和垂穗石松的全草在浙江、四川等地均称伸筋草，并同等使用。参见\"玉柏\"、\"铺地蜈蚣\"条。"}]},{"ID":"20240830115313-vn2o5wa","Type":"NodeParagraph","Properties":{"id":"20240830115313-vn2o5wa","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830115313-7lfjnnw","Type":"NodeParagraph","Properties":{"id":"20240830115313-7lfjnnw","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"伸筋草《中华本草》《中药大辞典》"}]},{"ID":"20240830115313-sv2cd7j","Type":"NodeParagraph","Properties":{"id":"20240830115313-sv2cd7j","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830115313-xnrp6w9","Type":"NodeParagraph","Properties":{"id":"20240830115313-xnrp6w9","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"出自《分类草药性》。"}]},{"ID":"20240830115313-p9gssq1","Type":"NodeParagraph","Properties":{"id":"20240830115313-p9gssq1","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：石松，生天台山石上。如松，高一、二尺也。"}]},{"ID":"20240830115313-22etwja","Type":"NodeParagraph","Properties":{"id":"20240830115313-22etwja","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：石松，即玉柏之长者也，名山皆有之。"}]},{"ID":"20240830115313-egplygi","Type":"NodeParagraph","Properties":{"id":"20240830115313-egplygi","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShēnJīnCǎo"}]},{"ID":"20240830115313-lakwgy3","Type":"NodeParagraph","Properties":{"id":"20240830115313-lakwgy3","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【英文名】CommonClubmossHerb，HerbofCommonClubmoss，HerbofStaghornClubmoss，HerbofWolf'sClawClubmoss"}]},{"ID":"20240830115313-eqlxe0o","Type":"NodeParagraph","Properties":{"id":"20240830115313-eqlxe0o","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【别名】石松、过山龙、宽筋藤、火炭葛、金毛狮子草、金腰带、狮子草、狮子毛草、立筋草、舒筋草、铺筋草、抽筋草、分筋草、过筋草、地棚窝草、筋骨草、绿毛伸筋、小伸筋、凤尾伸筋、蜈蚣藤、大地毛公、缠身龙、猫藤草、通伸草、山猫儿、老虎垫坐、盘龙草、烂腰蛇、宽筋草、穿山龙、"}]},{"ID":"20240830115313-b32j6uz","Type":"NodeParagraph","Properties":{"id":"20240830115313-b32j6uz","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830115313-vf45dtt","Type":"NodeParagraph","Properties":{"id":"20240830115313-vf45dtt","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"药材基源：为石松科植物石松、华中石松及灯笼草的全草。"}]},{"ID":"20240830115313-hkvnaz3","Type":"NodeParagraph","Properties":{"id":"20240830115313-hkvnaz3","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.LycopodiumjaponicumThunb.[L.clavatumauct.nonL.]2.Lycopodiumcentro-chinenseChing3.Palhinhaeacernua（L.）FrancoetVasc.[LycopodiumcernuumL.]"}]},{"ID":"20240830115313-bi3r1im","Type":"NodeParagraph","Properties":{"id":"20240830115313-bi3r1im","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季采收，连根拔起，去净泥土、杂质，晒干。"}]},{"ID":"20240830115313-w0uq635","Type":"NodeParagraph","Properties":{"id":"20240830115313-w0uq635","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【原形态】石松，多年生草本。匍匐茎蔓生，分枝有叶疏生。直立茎高15-30cm，分枝；营养枝多回分叉，密生叶，叶针形，长3-4mm，先端有易脱落的芒状长尾；孢子枝从第二、第三年营养枝上长出，远高出营养枝，叶疏生；孢子囊穗长2.5-5cm，有柄，通常2-6个生于孢子枝的上部；孢子叶卵状三角形，先端急尖而具尖尾，边缘有不规则的锯齿，孢子囊肾形，淡黄褐色，孢子同形。7、8月间孢子成熟。"}]},{"ID":"20240830115313-vs0tli7","Type":"NodeParagraph","Properties":{"id":"20240830115313-vs0tli7","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830115313-2ypq64l","Type":"NodeParagraph","Properties":{"id":"20240830115313-2ypq64l","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"生态环境：生于低山的酸性土草地、阔叶林边及马尾松林中。"}]},{"ID":"20240830115313-00xlv7a","Type":"NodeParagraph","Properties":{"id":"20240830115313-00xlv7a","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于长江以南各地。"}]},{"ID":"20240830115313-1w8ae1q","Type":"NodeParagraph","Properties":{"id":"20240830115313-1w8ae1q","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【栽培】野生。"}]},{"ID":"20240830115313-ai7bitj","Type":"NodeParagraph","Properties":{"id":"20240830115313-ai7bitj","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830115313-jgwvdsg","Type":"NodeParagraph","Properties":{"id":"20240830115313-jgwvdsg","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"1.性状鉴别（1）石松匍匐茎圆柱形，细长弯曲，长可达2m，多断裂，直径3-5mm，表面黄色或淡棕色，侧枝叶密生，直径约6mm，表面淡棕黄色。匍匐茎下有多数黄白色不定根，二歧分叉。叶密生，线状披针形，常皱缩弯曲，长3-5mm，宽0.3-0.8mm，黄绿色或灰绿色，先端芒状，全缘或有微锯齿，叶脉不明显。枝端有时可见孢子囊穗，直立棒状，多断裂，长2-5cm，直径约5mm。质韧，不易折断，断面浅黄色，有白色木心。气微，味淡。"}]},{"ID":"20240830115313-il1kha6","Type":"NodeParagraph","Properties":{"id":"20240830115313-il1kha6","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（2）华中石松类似石松，但茎呈二叉分枝成锐角展开，侧枝叶较疏，小枝叶密生，叶具膜质长芒。"}]},{"ID":"20240830115313-vnf6w7v","Type":"NodeParagraph","Properties":{"id":"20240830115313-vnf6w7v","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（3）灯笼草上部多分枝，长30-50cm，或已折成短段，直径1-2mm，表面黄色或黄绿色。叶密生，线状钻形，长2-3mm，黄绿色或浅绿色，全缘，常向上弯曲，质薄，易碎。枝顶常有孢子囊穗，矩圆形或圆柱形，长5-15mm，无柄，常下垂。气微，味淡。均以色黄绿，无杂质者为佳。"}]},{"ID":"20240830115313-rolkwn8","Type":"NodeParagraph","Properties":{"id":"20240830115313-rolkwn8","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别（1）石松茎横切面：表皮细胞1列，具气孔。皮层宽，表皮下和内皮层外侧各有10余列纤维群，其间为5-6列薄壁细胞，少数破碎成空隙，叶迹维束菜布于皮层中，内皮层明显。中柱内木质部外始式，分成几条在致平等的不规则带，与韧皮部间隔排列，韧皮部细胞多角形，近木质部处细胞较小。小枝的中柱作不规则辐射状。"}]},{"ID":"20240830115313-n4d3f4i","Type":"NodeParagraph","Properties":{"id":"20240830115313-n4d3f4i","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"叶表面观：表皮细胞狭长形，垂周壁念珠状增厚。上、下表皮均有不定式气孔，副卫细胞4-7个。"}]},{"ID":"20240830115313-fqfckxh","Type":"NodeParagraph","Properties":{"id":"20240830115313-fqfckxh","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（2）华中石松茎横切面：皮层近内皮层处，有一圈纤维束，外侧有数10列薄壁细胞，似海绵组织样；中柱内木质部与韧皮部排列整齐对称；韧皮部细胞靠近木质部的较大。"}]},{"ID":"20240830115313-pl6b5vl","Type":"NodeParagraph","Properties":{"id":"20240830115313-pl6b5vl","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"（3）灯笼草茎横切面：皮层宽阔，靠表皮下有3-4列薄壁细胞，向内有3-6列纤维群，再向内为10余列薄壁细胞。中柱内木质部分成多数细条与韧皮部无规则地交错排列。"}]},{"ID":"20240830115313-yxl67hv","Type":"NodeParagraph","Properties":{"id":"20240830115313-yxl67hv","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"叶表面观：表皮细胞垂周壁念珠状增厚不明显。"}]},{"ID":"20240830115313-5qo82d0","Type":"NodeParagraph","Properties":{"id":"20240830115313-5qo82d0","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【化学成份】石松含生物碱：石松碱（lycopodine），棒石松宁碱（clavolonine），棒石松毒（clavatoxin）及烟碱（nicotine）等；萜类化合物：α-芒柄花醇（α-onocerin），石松三醇（lycoclavanol），石松四醇酮（lycoclavanin），千层塔烯二醇（serratendiol），二表千层塔烯二醇（diepiserratenediol），21-表千层塔烯二醇（21-episerratenediol），16-氧代二表千层塔烯二醇（16-oxodiepiserratenediol），16-氧代-21-表千层塔烯二醇（16-oxo-21-episerratenediol），16-氧代千层塔烯二醇（16-oxoserratenediol），棒石松醇（clavatol），石松四醇（lyclaninol），二表石松稳四醇（diepilycocryptol），16-氧代石松三醇（16-oxolycoclavanol）及16-氧代石松五醇（16-oxolyclanitin）等；植物甾醇：β-谷甾醇（β-sitosterol）的，豆甾醇（stigmasterol）的和菜油甾醇（campesterol）的β-D-葡萄糖甙（β-D-glucoside），还含香草酸（vanillicacid），阿魏酸（ferulicacid），壬二酸（杜鹃花酸ajelaicacid）和大黄素-甲醚（physcion）。灯笼草含生物碱：垂石松碱（cernuine），羟基垂石松碱（lycocernuine），去氧垂石松碱（deoxocernuine），烟碱等；萜类化合物：21-表千层塔烯二醇，千层塔烯二醇，21-表千层塔烯三醇（21-episerratriol），16-氧代石松三醇，二表千层塔烯二醇，α-芒柄花醇，16-氧代-21-表千层塔烯三醇（16-oxo-21-episerratriol），千层塔三醇（tohogenol），垂石松酸（lycernuicacid）A及B；植物甾醇：β-谷甾醇，豆甾醇，菜油甾醇，还含垂石松黄酮甙（cernoside）。"}]},{"ID":"20240830115313-tnt3nqm","Type":"NodeParagraph","Properties":{"id":"20240830115313-tnt3nqm","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【药理作用】石松水浸剂对由皮下注射枯草浸剂引起发热之家兔有降温作用；其有效成分为石松碱及棒石松碱、棒石松毒（Clavatoxine），后二者之毒性较石松碱为弱。石松碱适当剂量能升高麻醉猫血压，也有报告30mg／kg静脉注射可使麻醉猫、兔血压骤降；此时对呼吸皆无影响，中毒量可增加动物呼吸振幅而减少频率。对蛙心收缩力有增强作用，对兔心1：50000-400000则减弱收缩力，收缩频率及心电图皆无改变。1：12500-50000对离体大鼠、豚鼠小肠有兴奋作用，兔离体小肠之蠕动亦被增强。对兔、大鼠及豚鼠子宫有兴奋作用。对兔静脉注射30-50mg/kg有降温作用。对兔血糖、瞳孔、末梢红细胞数皆无影响。无抗菌及抗疟作用。对小鼠静脉注射之半数致死量为27.58±1.16mg／kg，腹腔注射为78mg/kg，中毒症状有过度活动，强直性、阵挛性痉挛，麻痹，窒息等；兔之中毒症状相似。给蛙淋巴囊注射50-200mg／kg可引起肌肉运动不协调、麻痹等。棒石松碱之毒性剂量：猫为0.05g／kg、兔及大鼠为0.1-0.2g、kg。有人报告石松有利尿、增进尿酸排泄之作用，还能解除小儿之痉挛性尿潴留及便秘等。对中枢神经的作用：伸筋草用渗漉法提取液，100%浓度0.5ml/只灌胃，对小鼠热板法试验、醋酸扭体法试验均表明有镇痛作用。伸筋草剂量同上，对小鼠可延长戊巴比妥钠的睡眠时间，对士的宁引起的惊厥死亡无显着影响；对可卡因反增强其毒性作用。"}]},{"ID":"20240830115313-1kbkuz1","Type":"NodeParagraph","Properties":{"id":"20240830115313-1kbkuz1","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【鉴别】（1）取本品粉末2g，加1%硫酸10-15ml，水浴温热15-30min，滤过。滤液加碘化铋钾试剂，生成棕黄色沉淀。（检查生物碱）（2）薄层色谱取本品粉末2g，加乙醇10ml水浴湿浸30min，滤过。滤液蒸干，加1ml甲醇溶解，点样于中性氧化铝板上，同时点对照品溶液，以氯仿-丙酮（4：1）展开，取出晾干，喷改良碘化铋钾试剂，样品色谱中应有与对照品相对应的黄色斑点。"}]},{"ID":"20240830115313-isvth4y","Type":"NodeParagraph","Properties":{"id":"20240830115313-isvth4y","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【炮制】取原药材，除去杂质，洗净，稍润，切段，干燥。"}]},{"ID":"20240830115313-yal13wn","Type":"NodeParagraph","Properties":{"id":"20240830115313-yal13wn","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【性味】苦；辛；温；无毒；平"}]},{"ID":"20240830115313-kv2y0zz","Type":"NodeParagraph","Properties":{"id":"20240830115313-kv2y0zz","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾；肾经"}]},{"ID":"20240830115313-h88lgdz","Type":"NodeParagraph","Properties":{"id":"20240830115313-h88lgdz","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风散寒；除湿消肿；舒筋活血；止咳；解毒。主风寒湿痹；关节酸痛；皮肤麻木；四肢软弱；水肿；跌打损伤；黄疸；咳嗽；疮疡；疱疹；烫伤"}]},{"ID":"20240830115313-0yk57cr","Type":"NodeParagraph","Properties":{"id":"20240830115313-0yk57cr","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g；或浸酒。外用：适量，捣敷。"}]},{"ID":"20240830115313-evjmzts","Type":"NodeParagraph","Properties":{"id":"20240830115313-evjmzts","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【注意】《四川中药志》：孕妇及出血过多者忌服。"}]},{"ID":"20240830115313-jgdy89k","Type":"NodeParagraph","Properties":{"id":"20240830115313-jgdy89k","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830115313-fdaqxkx","Type":"NodeParagraph","Properties":{"id":"20240830115313-fdaqxkx","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"1.《滇南本草》：石松，其性走而不守，其用沉而不浮，得槟榔良。下气，消胸中痞满横格之气，推胃中隔宿之食，去年久腹中之坚积，消水肿。"}]},{"ID":"20240830115313-z7960ll","Type":"NodeParagraph","Properties":{"id":"20240830115313-z7960ll","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：主久患风痹，脚膝疼冷，皮肤不仁，气力衰弱。"}]},{"ID":"20240830115313-3t0cvuy","Type":"NodeParagraph","Properties":{"id":"20240830115313-3t0cvuy","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"3.《生草药性备要》：消肿，除风湿。浸酒饮，舒筋活络。其根治气结疼痛，损伤，金疮内伤，去痰止咳。"}]},{"ID":"20240830115313-yncks9o","Type":"NodeParagraph","Properties":{"id":"20240830115313-yncks9o","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"4.《浙江民间常用草药》：舒筋，消炎。治关节酸痛，带状疱疹。"}]},{"ID":"20240830115313-9ecua1k","Type":"NodeParagraph","Properties":{"id":"20240830115313-9ecua1k","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"5.《东北常用中草药手册》：舒筋活血，祛风散寒，止痛。治腰腿酸痛，风湿性关节肿痛，月经不调。"}]},{"ID":"20240830115313-ldemyhi","Type":"NodeParagraph","Properties":{"id":"20240830115313-ldemyhi","updated":"20240830115331"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》《中药大辞典》"}]},{"ID":"20240830115315-39pa8yc","Type":"NodeThematicBreak","Properties":{"id":"20240830115315-39pa8yc","updated":"20240830115331"}},{"ID":"20240830115316-sehp7wb","Type":"NodeParagraph","Properties":{"id":"20240830115316-sehp7wb","updated":"20240830115331"}}]}