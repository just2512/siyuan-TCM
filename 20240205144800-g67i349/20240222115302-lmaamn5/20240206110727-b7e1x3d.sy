Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/刺海马 1-20240716152442-yoe9a6p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 343px;\" parent-style=\"width: 353px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716152452-5oz7i7d","Type":"NodeParagraph","Properties":{"id":"20240716152452-5oz7i7d","updated":"20240716152455"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三斑海马"}]},{"ID":"20240716152621-3v0t5ku","Type":"NodeParagraph","Properties":{"id":"20240716152621-3v0t5ku","updated":"20240716152715"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 915px;","style":"width: 905px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"三斑海马 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/三斑海马 1-20240716152621-9ro9je7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 905px;\" parent-style=\"width: 915px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 349px;","style":"width: 339px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"三斑海马 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/三斑海马 2-20240716152715-dlhj0j5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 339px;\" parent-style=\"width: 349px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716152556-84xra0n","Type":"NodeParagraph","Properties":{"id":"20240716152556-84xra0n","updated":"20240716152556"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"三斑海马"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/三斑海马-20240716152556-nhu28cb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716152723-1m0r5hm","Type":"NodeParagraph","Properties":{"id":"20240716152723-1m0r5hm","updated":"20240716152733"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小海马"}]},{"ID":"20240716153143-k18d85h","Type":"NodeParagraph","Properties":{"id":"20240716153143-k18d85h","updated":"20240716153415"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小海马"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小海马-20240716153332-g8fvqt3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 676px;","style":"width: 666px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小海马 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小海马 1-20240716153415-l0v6cuy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 666px;\" parent-style=\"width: 676px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716153502-ujt3xu5","Type":"NodeParagraph","Properties":{"id":"20240716153502-ujt3xu5","updated":"20240716153541"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小海马 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小海马 2-20240716153502-ev6pkrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小海马 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小海马 3-20240716153541-yu57cwf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716153212-59wsw5n","Type":"NodeThematicBreak","Properties":{"id":"20240716153212-59wsw5n"}},{"ID":"20240902101756-o79h1zq","Type":"NodeParagraph","Properties":{"id":"20240902101756-o79h1zq","updated":"20240902101806"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：海马"}]},{"ID":"20240902101756-npvreyw","Type":"NodeParagraph","Properties":{"id":"20240902101756-npvreyw","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"海马《中国药典》"}]},{"ID":"20240902101756-eqqkl6b","Type":"NodeParagraph","Properties":{"id":"20240902101756-eqqkl6b","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【拼音名】HáiMǎ"}]},{"ID":"20240902101756-lnfn5zf","Type":"NodeParagraph","Properties":{"id":"20240902101756-lnfn5zf","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【英文名】HIPPOCAMPUS"}]},{"ID":"20240902101756-0tq70vd","Type":"NodeParagraph","Properties":{"id":"20240902101756-0tq70vd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【别名】水马、对海马、海蛆[幼小海马]"}]},{"ID":"20240902101756-y2zr8ro","Type":"NodeParagraph","Properties":{"id":"20240902101756-y2zr8ro","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【来源】本品为海龙科动物线纹海马HippocampuskelloggiJordanetSnyder、刺海马HippocampushistrixKaup、大海马HippocampuskudaBleeker、三斑海马HippocampustrimaculatusLeach或小海马（海蛆）HippocampusjaponicusKaup的干燥体。夏、秋二季捕捞，洗净，晒干；或除去皮膜及内脏，晒干。"}]},{"ID":"20240902101756-tbb0v95","Type":"NodeParagraph","Properties":{"id":"20240902101756-tbb0v95","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902101756-ypyjaeq","Type":"NodeParagraph","Properties":{"id":"20240902101756-ypyjaeq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"线纹海马：呈扁长形而弯曲，体长约30cm。表面黄白色。头略似马头,有冠状突起，具管状长吻，口小，无牙，两眼深陷。躯干部七棱形，尾部四棱形，渐细卷曲，体上有瓦楞形的节纹并具短棘。体轻，骨质，坚硬。气微腥，味微咸。"}]},{"ID":"20240902101756-ng93wip","Type":"NodeParagraph","Properties":{"id":"20240902101756-ng93wip","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"刺海马：体长15～20cm。头部及体上环节间的棘细而尖。"}]},{"ID":"20240902101756-4vr53nf","Type":"NodeParagraph","Properties":{"id":"20240902101756-4vr53nf","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"大海马：体长20～30cm。黑褐色。"}]},{"ID":"20240902101756-325m3pt","Type":"NodeParagraph","Properties":{"id":"20240902101756-325m3pt","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"三斑海马：体侧背部第1、4、7节的短棘基部各有1黑斑。"}]},{"ID":"20240902101756-clohgmj","Type":"NodeParagraph","Properties":{"id":"20240902101756-clohgmj","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"小海马（海蛆）：体形小，长7～10cm。黑褐色。节纹及短棘均较细小。"}]},{"ID":"20240902101756-9yvy3ct","Type":"NodeParagraph","Properties":{"id":"20240902101756-9yvy3ct","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【炮制】除去灰屑。用时捣碎或碾粉。"}]},{"ID":"20240902101756-jr4ct9v","Type":"NodeParagraph","Properties":{"id":"20240902101756-jr4ct9v","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性味】甘，温。"}]},{"ID":"20240902101756-6787tt6","Type":"NodeParagraph","Properties":{"id":"20240902101756-6787tt6","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾经。"}]},{"ID":"20240902101756-zqt8e8c","Type":"NodeParagraph","Properties":{"id":"20240902101756-zqt8e8c","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【功能主治】温肾壮阳，散结消肿。用于阳痿，遗尿，肾虚作喘，症瘕积聚，跌扑损伤；外治痈肿疔疮。"}]},{"ID":"20240902101756-c7e1bns","Type":"NodeParagraph","Properties":{"id":"20240902101756-c7e1bns","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。外用适量，研末敷患处。"}]},{"ID":"20240902101756-b1m6jyj","Type":"NodeParagraph","Properties":{"id":"20240902101756-b1m6jyj","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防蛀。"}]},{"ID":"20240902101756-jpj4b0u","Type":"NodeParagraph","Properties":{"id":"20240902101756-jpj4b0u","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902101756-qmiaqki","Type":"NodeParagraph","Properties":{"id":"20240902101756-qmiaqki","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"海马《*辞典》"}]},{"ID":"20240902101756-3l750bl","Type":"NodeParagraph","Properties":{"id":"20240902101756-3l750bl","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【出处】《本草拾遗》"}]},{"ID":"20240902101756-1tfcppx","Type":"NodeParagraph","Properties":{"id":"20240902101756-1tfcppx","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【拼音名】HáiMǎ"}]},{"ID":"20240902101756-gse5wdg","Type":"NodeParagraph","Properties":{"id":"20240902101756-gse5wdg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【别名】水马（《抱朴子》），虾姑（《海南介语》），龙落子、马头鱼（《动物学大辞典》）。"}]},{"ID":"20240902101756-ob9hhrl","Type":"NodeParagraph","Properties":{"id":"20240902101756-ob9hhrl","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【来源】为海龙科动物克氏海马、刺海马、大海马、斑海马或日本海马除去内脏的全体。全年均可捕获，但以8～9月产量最大。搞得后，将内脏除去，晒干；或除去外部灰、黑色皮膜和内脏后，将尾盘卷，晒干，选择大小相似者，用红线缠扎成对。商品分为海马、刺海马两类。另有一种为幼体的干燥品，称为海蛆。"}]},{"ID":"20240902101756-exj21g1","Type":"NodeParagraph","Properties":{"id":"20240902101756-exj21g1","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902101756-74godlq","Type":"NodeParagraph","Properties":{"id":"20240902101756-74godlq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①克氏海马"}]},{"ID":"20240902101756-vyytutq","Type":"NodeParagraph","Properties":{"id":"20240902101756-vyytutq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"体形侧扁，腹部稍凸出，躯干部呈七棱形，尾部四棱形，为海马中最大的一种。体长30～33厘米。头冠短小，尖端有5个短小的棘，略向后方弯曲。吻长，呈管状。眼较大，侧位而高。眼间隔小于眼径，微隆起。鼻孔很小，每侧2个，相距甚近，紧位于眼的前方。口小，端位，无牙。鳃盖凸出，无放射状纹。鳃孔小，位近于侧背方。肛门位于躯干第11节的腹侧下方。体无鳞，完全为骨质环所包，骨质环体部11，尾部39～40；体上各环棱棘短钝呈瘤状。背鳍长，18～19，较发达，位于躯干最后2体环及尾部最前2体环的背方。臀鳍4，短小，胸鳍18，短宽，略呈扇形。无腹鳍及尾鳍。各鳍无棘，鳍条均不分枝。尾端卷曲。全体淡黄色，体侧具白色线状斑点。"}]},{"ID":"20240902101756-a0fe6lh","Type":"NodeParagraph","Properties":{"id":"20240902101756-a0fe6lh","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"多栖于深海藻类繁茂处。栖止时，常以尾端缠附于海藻的茎枝上。食物主要为小型的甲壳动物。分布广东沿海一带；福建、台湾沿海亦有。"}]},{"ID":"20240902101756-khqhoqf","Type":"NodeParagraph","Properties":{"id":"20240902101756-khqhoqf","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②刺海马"}]},{"ID":"20240902101756-qc95fif","Type":"NodeParagraph","Properties":{"id":"20240902101756-qc95fif","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"体长20～24厘米，头冠不高，尖端具4～5细而尖锐的小棘。吻细长，呈管状。吻长大于或等于眶后之头长。骨质环体部11，尾部35～36；体上各骨环接结处及头部的小棘特别发达，这是刺海马有别于其他种类的特征。背鳍长，18。臀鳍4，很小，胸鳍18，短而宽。体为淡黄褐色，背鳍近尖端具一纵列斑点，臀、胸鳍淡色，体上小棘尖端呈黑色。"}]},{"ID":"20240902101756-4506obg","Type":"NodeParagraph","Properties":{"id":"20240902101756-4506obg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"分布广东及福建沿海。"}]},{"ID":"20240902101756-lza8qqq","Type":"NodeParagraph","Properties":{"id":"20240902101756-lza8qqq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"③大海马"}]},{"ID":"20240902101756-gkrfcfd","Type":"NodeParagraph","Properties":{"id":"20240902101756-gkrfcfd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"体长20～24厘米。头冠较低，顶端具5个短钝粗棘。吻长恰等于眶后头长。骨质环体部11，尾部35～36；头部及体环与尾环上的小棘均不甚明显。背鳍17，臀鳍4，胸鳍16。体呈黑褐色，头部及体侧有细小暗黑色斑点，且有弥散细小的银白色斑点，背鳍有黑色纵列斑纹，臀、胸鳍淡色。"}]},{"ID":"20240902101756-94q3f4o","Type":"NodeParagraph","Properties":{"id":"20240902101756-94q3f4o","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"分布广东沿海及海南岛。"}]},{"ID":"20240902101756-bqcrkal","Type":"NodeParagraph","Properties":{"id":"20240902101756-bqcrkal","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"④斑海马"}]},{"ID":"20240902101756-d45mvlw","Type":"NodeParagraph","Properties":{"id":"20240902101756-d45mvlw","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"体长10～18厘米。头冠短小，顶端具5个小突棘。吻管较短，不及头长的1/2。骨质环体部11，尾部40～41；体节1、4、7、11骨环和尾节1、5、9、13、17骨环的背方接结处呈隆起状嵴，背侧方棘亦较其他种类为大。背鳍20～21，臀鳍4，胸鳍17～18。体黄褐色乃至黑褐色，眼上具放射状褐色斑纹，体侧背方第1、4、7节小棘基部各具一大黑斑，是斑海马与其他种海马的不同特征。"}]},{"ID":"20240902101756-ngjzjxv","Type":"NodeParagraph","Properties":{"id":"20240902101756-ngjzjxv","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"分布福建、广东沿海。"}]},{"ID":"20240902101756-xtlg4x0","Type":"NodeParagraph","Properties":{"id":"20240902101756-xtlg4x0","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"⑤日本海马"}]},{"ID":"20240902101756-ro86ndl","Type":"NodeParagraph","Properties":{"id":"20240902101756-ro86ndl","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"体长76～100毫米。头冠低小，上具5个短小钝棘。吻部较短，约近头长的1/3。体侧扁，腹部突出。尾部四棱形，以后渐细，卷曲。骨质环体部11，尾部37～38；躯干部第1、4、7、11和尾部5、9、10、12体环棱棘特别发达。背鳍16～17，臀鳍4，胸鳍13。体灰褐色，头上、吻部及颊部具不规则斑纹，体侧亦有不规则斑纹，腹缘黑褐色。"}]},{"ID":"20240902101756-lrmwaep","Type":"NodeParagraph","Properties":{"id":"20240902101756-lrmwaep","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"分布辽宁、河北、山东、广东沿海。"}]},{"ID":"20240902101756-swglqks","Type":"NodeParagraph","Properties":{"id":"20240902101756-swglqks","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902101756-upv6vzd","Type":"NodeParagraph","Properties":{"id":"20240902101756-upv6vzd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①海马"}]},{"ID":"20240902101756-p4ow1tq","Type":"NodeParagraph","Properties":{"id":"20240902101756-p4ow1tq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"为克氏海马、大海马、斑海马、日本海马的干燥全体。体呈长条形，略弯曲或卷曲，长10～25厘米，上部粗而扁方，直径约2～3厘米，下部细而方，直径约1厘米，尾端略尖而弯曲。头似马头，具管状长嘴，有1对深陷的眼睛。表面黄白色或灰棕色，略有光泽，上部具6棱，下部有4棱，密生突起的横纹，边缘有齿，背部有鳍。骨质坚硬，不易折断。气微腥，味微咸。以个大、色白、体完整者为佳。"}]},{"ID":"20240902101756-sc60wua","Type":"NodeParagraph","Properties":{"id":"20240902101756-sc60wua","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"主产广东、福建及台湾等地。以广东产量最大。"}]},{"ID":"20240902101756-dbolb27","Type":"NodeParagraph","Properties":{"id":"20240902101756-dbolb27","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②刺海马"}]},{"ID":"20240902101756-qexqq7a","Type":"NodeParagraph","Properties":{"id":"20240902101756-qexqq7a","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"为刺海马的干燥全体。形与海马相似，但较小，长约20厘米，通体具硬刺，刺长2～4毫米。其他性状同上种。"}]},{"ID":"20240902101756-gccq0gi","Type":"NodeParagraph","Properties":{"id":"20240902101756-gccq0gi","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"主产福建、广东等地。"}]},{"ID":"20240902101756-k4yuihy","Type":"NodeParagraph","Properties":{"id":"20240902101756-k4yuihy","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"③海蛆（《百草镜》）"}]},{"ID":"20240902101756-wy8e4gc","Type":"NodeParagraph","Properties":{"id":"20240902101756-wy8e4gc","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"又名：小海驹、小海马。为海马的幼体。形状与海马相似而较小。"}]},{"ID":"20240902101756-hz2xu3x","Type":"NodeParagraph","Properties":{"id":"20240902101756-hz2xu3x","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"产地同海马。"}]},{"ID":"20240902101756-2kd74a8","Type":"NodeParagraph","Properties":{"id":"20240902101756-2kd74a8","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【药理作用】克氏海马的乙醇提取物，可延长正常雌小鼠的动情期，对去势鼠则可出现动情期，并使子宫及卵巢（正常小鼠）重量增加。以小鼠前列腺、精囊、提肛肌的重量作为指标，海马（品种未注明）提取液表现雄性激素样作用，其效力较蛇床子、淫羊藿弱，但比蛤蚧强。"}]},{"ID":"20240902101756-ftq526s","Type":"NodeParagraph","Properties":{"id":"20240902101756-ftq526s","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【炮制】海马：用水刷净，切块或打碎。酒炙海马：净海马用黄酒湿润，微火烘烤至酥松而呈黄色即成。"}]},{"ID":"20240902101756-j76a4vd","Type":"NodeParagraph","Properties":{"id":"20240902101756-j76a4vd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902101756-153f3xs","Type":"NodeParagraph","Properties":{"id":"20240902101756-153f3xs","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"甘，温。"}]},{"ID":"20240902101756-lahffix","Type":"NodeParagraph","Properties":{"id":"20240902101756-lahffix","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"性温平，无毒。\""}]},{"ID":"20240902101756-dunsx0q","Type":"NodeParagraph","Properties":{"id":"20240902101756-dunsx0q","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②《品汇精要》：\"味咸，性温平，无毒。\""}]},{"ID":"20240902101756-gdhc49j","Type":"NodeParagraph","Properties":{"id":"20240902101756-gdhc49j","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘，温平，无毒。\""}]},{"ID":"20240902101756-tzch994","Type":"NodeParagraph","Properties":{"id":"20240902101756-tzch994","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902101756-rdbl1n5","Type":"NodeParagraph","Properties":{"id":"20240902101756-rdbl1n5","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"入肝、肾经。"}]},{"ID":"20240902101756-l0ivpv6","Type":"NodeParagraph","Properties":{"id":"20240902101756-l0ivpv6","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①《本草新编》：\"入肾经、命门。\""}]},{"ID":"20240902101756-gxdlgw9","Type":"NodeParagraph","Properties":{"id":"20240902101756-gxdlgw9","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入足少阴、厥阴经。\""}]},{"ID":"20240902101756-359tdxz","Type":"NodeParagraph","Properties":{"id":"20240902101756-359tdxz","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902101756-1fkzw6d","Type":"NodeParagraph","Properties":{"id":"20240902101756-1fkzw6d","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"补肾壮阳，调气活血。治阳痿，遗尿，虚喘，难产，症积，疔疮肿毒。"}]},{"ID":"20240902101756-9dhulrj","Type":"NodeParagraph","Properties":{"id":"20240902101756-9dhulrj","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"主妇人难产。\""}]},{"ID":"20240902101756-ttcprjy","Type":"NodeParagraph","Properties":{"id":"20240902101756-ttcprjy","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"妇人将产，烧末饮服。\"\"《异鱼图》云，主难产及血气痛。\""}]},{"ID":"20240902101756-qo1x4m3","Type":"NodeParagraph","Properties":{"id":"20240902101756-qo1x4m3","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"谓气和血。\""}]},{"ID":"20240902101756-svlqpfn","Type":"NodeParagraph","Properties":{"id":"20240902101756-svlqpfn","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"暖水藏，壮阳道，消瘕块，治疔疮肿毒。\""}]},{"ID":"20240902101756-iit0j8e","Type":"NodeParagraph","Properties":{"id":"20240902101756-iit0j8e","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"⑤《本经逢原》：\"阳虚多用之，可代蛤蚧。\""}]},{"ID":"20240902101756-m0dagrm","Type":"NodeParagraph","Properties":{"id":"20240902101756-m0dagrm","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"⑥《海南介语》：\"主夜遗。\""}]},{"ID":"20240902101756-aww3x2y","Type":"NodeParagraph","Properties":{"id":"20240902101756-aww3x2y","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"⑦《药材学》：\"温通任脉，用于喘息及久喘。\""}]},{"ID":"20240902101756-2i50rbw","Type":"NodeParagraph","Properties":{"id":"20240902101756-2i50rbw","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；或入散剂，0.3～1钱。外用：研末撒。"}]},{"ID":"20240902101756-3ub4wxs","Type":"NodeParagraph","Properties":{"id":"20240902101756-3ub4wxs","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇及阴虚火旺者忌服。"}]},{"ID":"20240902101756-qmrv4hz","Type":"NodeParagraph","Properties":{"id":"20240902101756-qmrv4hz","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902101756-pxxhppt","Type":"NodeParagraph","Properties":{"id":"20240902101756-pxxhppt","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①治远年虚实积聚瘕块：木香一两，海马子一对（雌者黄色，雄者青色），大黄（炒、锉）、青橘皮（汤浸，去白，焙）、白牵牛（炒）各二两，巴豆四十九粒。上六味，以童子小便浸青橘皮软，裹巴豆，以线系定，入小便内再浸七日，职出，麸炒黄，去巴豆，只使青橘皮并余药粗捣筛。每服二钱匕，水一盏，煎三、五沸，去滓，临睡温服。（《圣济总录》木香汤）"}]},{"ID":"20240902101756-znef8kg","Type":"NodeParagraph","Properties":{"id":"20240902101756-znef8kg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②治发背诸恶疮，兼治疔疮：海马一双（炙），穿山甲（黄土炒）、水银、朱砂各二钱，雄黄三钱，轻粉一钱，脑子、麝香各少许。上除水银外，各研为末和合，入水银再研至无星。针破疮口，点药入内，一日一点。（《急救仙方》海马拔毒散）"}]},{"ID":"20240902101756-9d5qjr9","Type":"NodeParagraph","Properties":{"id":"20240902101756-9d5qjr9","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902101756-s6oyvt7","Type":"NodeParagraph","Properties":{"id":"20240902101756-s6oyvt7","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"海马，雌雄成对，其性温暖，故难产及阳虚多用之，如蛤蚧、郎君子之功也。\""}]},{"ID":"20240902101756-m6e4wny","Type":"NodeParagraph","Properties":{"id":"20240902101756-m6e4wny","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"海马，亦虾属也，入肾经命门，专善兴阳，功不亚于海狗，更善堕胎，故能催生也。海马功用不亚腽肭脐，乃尚腽肭脐不尚海马，此世人之大惑也。谁知海马不论雌雄，皆能勃兴阳道，若腽肭脐，必须用雄者始效，贵价而买，仍是赝物，何若用海马之适用哉。\""}]},{"ID":"20240902101756-vjqs0mg","Type":"NodeParagraph","Properties":{"id":"20240902101756-vjqs0mg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902101756-bgteem4","Type":"NodeParagraph","Properties":{"id":"20240902101756-bgteem4","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"海马《中华本草》"}]},{"ID":"20240902101756-bblu9lb","Type":"NodeParagraph","Properties":{"id":"20240902101756-bblu9lb","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目拾遗》"}]},{"ID":"20240902101756-t8avitx","Type":"NodeParagraph","Properties":{"id":"20240902101756-t8avitx","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【拼音名】HáiMǎ"}]},{"ID":"20240902101756-nw8zt65","Type":"NodeParagraph","Properties":{"id":"20240902101756-nw8zt65","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【英文名】SeaHorse"}]},{"ID":"20240902101756-5fsg0hl","Type":"NodeParagraph","Properties":{"id":"20240902101756-5fsg0hl","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【别名】水马、马头鱼、龙落子鱼"}]},{"ID":"20240902101756-to158pd","Type":"NodeParagraph","Properties":{"id":"20240902101756-to158pd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902101756-keq6a07","Type":"NodeParagraph","Properties":{"id":"20240902101756-keq6a07","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"药材基源：为海龙科动物线纹海马、三斑海马、刺海马、大海马、冠海马、小海马等多种海马除去内脏的全体。"}]},{"ID":"20240902101756-s9jp2cw","Type":"NodeParagraph","Properties":{"id":"20240902101756-s9jp2cw","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.HippocampuskelloggiJordauetSnyder2.HippocampustrimaculatusLeach3.HippocampushistrixKaup4.HippocampuskudaBleeker5.HippocampuscoronatusTemmincketSchlegel6.HippocampusjaponicusKaup"}]},{"ID":"20240902101756-b5fk1tr","Type":"NodeParagraph","Properties":{"id":"20240902101756-b5fk1tr","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"采收和储藏：四季捕捉。捕后除去内脏，洗净，晒干；或除去外部灰、黑色膜和内脏后，将尾盘起，晒干，选择大小相似者，用红线缠扎成对。"}]},{"ID":"20240902101756-jh71goe","Type":"NodeParagraph","Properties":{"id":"20240902101756-jh71goe","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902101756-zvojmmm","Type":"NodeParagraph","Properties":{"id":"20240902101756-zvojmmm","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"1.线纹海马，体侧扁，一般体长30-33cm，躯干部七棱形，腹部稍凸出，尾部四棱形，尾端渐细，卷曲。头部似马形，与躯干部垂直，头冠矮小，顶端具5个短小棘，略向后方弯曲。眶上、头侧及颊下各棘较均较粗，亦稍向后方弯曲。体长为头长4.5-6.2倍，头长为吻长2-2.1倍，为眼径5.5-8倍。吻细长，管状，吻长稍大于眼后头长。眼较大，侧位而高，眼间隔小于眼径，微隆起。鼻孔很小，每侧2个，相距甚近，紧位于眼的前方。口小，前位，无牙。鳃盖凸出，无放射状嵴纹，鳃孔小，位于头侧背方。肛门位于躯干第11节的腹侧下方。体无鳞，全为骨环所包，体部骨环11，尾部39-40，体上各环棱棘短钝呈瘤状，惟颈部背方中央嵴纹较锐，具2突起状棘和2颊下棘。胸鳍基部下前方各具1短钝棘。背鳍18-19，较发达，位于躯干最后2环和尾部最前2环的背方。臀鳍4短小。胸鳍18，短宽，略呈扇形。无腹鳍及尾鳍。各鳍无棘，鳍条不分支。体淡黄色或暗灰色，体侧具细小的白色斑点或斑纹。"}]},{"ID":"20240902101756-1mmbocb","Type":"NodeParagraph","Properties":{"id":"20240902101756-1mmbocb","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.三斑海马，体侧扁，一般体长10-18cm，躯干七棱形，腹部凸出，腹下棱较锐，尾部四棱形，尾端渐细，卷曲。头冠生小，顶端具5个短小棘，体长为头长5.3-6.5倍，头长为吻长2.2-2.5倍，为眼径5.3-5.9倍。吻细长，管状，吻长稍大于眼后头长，管状，吻长稍大于眼后头长。眼小而圆，眼上棘较发达，细尖，向后弯曲。口小，前位，鳃盖突出，鳃孔小。颈部背方具一隆起嵴。颊部下方具一细尖弯贡的颊下棘。体无鳞，由骨环所包，体环11；尾环40-41。背鳍20-21，位于躯干最后2环及尾部最前2环的背方。臀鳍4，短小。胸鳍17-18，扇形。无腹鳍及尾鳍。体黑褐色。眼上有放射状褐色斑纹。体侧背方第1、4、7节小棘基部各具一黑色圆斑，故名。"}]},{"ID":"20240902101756-fkcv8k6","Type":"NodeParagraph","Properties":{"id":"20240902101756-fkcv8k6","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"3.刺海马，体侧扁，体长20-24cm。体棘、头棘尖锐而特别发达；头冠不高，具4-5个锐小棘。体长为头长5.1-5.8倍；头长为吻长2.1-2.3倍，为眼径7.3-7.8倍，吻细长，管状，吻长大于或等于眼后头长。眼小，侧位，较高。体部骨环11，尾部35-36背鳍18，臀鳍4，短小，胸鳍18，短宽。体淡黄褐色，背鳍近尖端具1纵列斑点，臀鳍、胸鳍淡色，体上小棘尖端淡黑褐色。"}]},{"ID":"20240902101756-6n2cywu","Type":"NodeParagraph","Properties":{"id":"20240902101756-6n2cywu","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"4.大海马，体侧扁，较高，体长20-24cm。头上小棘发达，体上棱棘短钝粗强，腹部凸出；头冠较低，顶端具5个短钝粗棘。体长为体高5.5-5.8倍；头长为吻长2.2-2.3倍，为眼径8.5-9.4倍。吻细长，管状，吻长等于眼后头长。鳃盖突出，具放射状嵴纹。头侧及眶上、颊下各棘均较粗强。体部骨环11；尾部35-36。背鳍17，臀鳍4，胸鳍16。体淡褐色，头部及体侧有细小暗色斑点，且散布细小的银白色斑点。背鳍有黑色纵列斑纹。臀鳍、胸鳍淡色。"}]},{"ID":"20240902101756-2hiurnd","Type":"NodeParagraph","Properties":{"id":"20240902101756-2hiurnd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"5.冠海马，体侧扁，较小，背部隆起，体长为体高7.5倍，为头长5倍。头长为吻长2.1倍，为眼径5倍。头冠特别高大，约等于吻长，头冠顶端有4个突起。眼中等大，眼间隔中央凹，两侧各有一眶上突起。体部骨环10，尾部41。体环第1、4、10和尾环第4、10、15各节上的突起较长。背鳍13-14，臀鳍4，胸鳍14。体淡褐色，具暗色斑纹，有时亦呈黑褐色。背鳍亦具暗色纵带。"}]},{"ID":"20240902101756-1jodued","Type":"NodeParagraph","Properties":{"id":"20240902101756-1jodued","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"6.小海马，体侧扁，较小，体长7.6-10cm，头冠低小，上有5个短小钝棘。体长为头长4.5-7.8倍，头长为吻长2.4-3.4倍，为眼径4.1-6.4倍。吻管短于眼后头长。鳃盖凸出，无放射状嵴纹。头侧及眶上各棘均特别发达。体部骨环11，尾部37-38。以背侧棱棘为量发达，其次为腹侧棱棘，其他则短钝或不明显。腹部很突出不具棱棘。背鳍16-17，位于射干最后3环和尾部第1环的背方，臀鳍4，胸鳍12-13。体灰褐色，头上、吻部、颊部及体侧具不规则斑纹。腹缘黑褐色。"}]},{"ID":"20240902101756-wm4004l","Type":"NodeParagraph","Properties":{"id":"20240902101756-wm4004l","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902101756-rblue3d","Type":"NodeParagraph","Properties":{"id":"20240902101756-rblue3d","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"生态环境：1.栖息于近海藻类繁茂处，渡海时，头部向上，用背鳍和胸鳍的扇动，作直立游泳。常以尾端缠附于海藻茎枝上，以小型浮游甲壳动物为食。"}]},{"ID":"20240902101756-25l10pg","Type":"NodeParagraph","Properties":{"id":"20240902101756-25l10pg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.栖息于近海内湾水质澄清、海藻繁茂的低潮区，以尾部卷缠在海藻上，体色常随环境而变化。喜食活饵，以口吸食端足类、桡足类、糠虾、毛虾、磷虾、萤虾等浮游甲壳动物。本种产仔多，生长最快噗人工养殖的优良品种。"}]},{"ID":"20240902101756-0848fva","Type":"NodeParagraph","Properties":{"id":"20240902101756-0848fva","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"3.生态、分布同线纹海马。"}]},{"ID":"20240902101756-h2mo0lq","Type":"NodeParagraph","Properties":{"id":"20240902101756-h2mo0lq","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"6.栖息于沿海及内湾的中低潮线一带海藻丛中虽个体小，生长慢，便适温性大，成熟期早，饲养3-8个月即达性成熟，夏秋季为繁殖期，每胎产仔数10-400尾左右。"}]},{"ID":"20240902101756-e899e9d","Type":"NodeParagraph","Properties":{"id":"20240902101756-e899e9d","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"资源分布：1.我国分布于东海和南海。"}]},{"ID":"20240902101756-ft3y9wu","Type":"NodeParagraph","Properties":{"id":"20240902101756-ft3y9wu","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.我国分布于东海及南海。浙江、福建、广东沿海已进行人工养殖。"}]},{"ID":"20240902101756-srm94uh","Type":"NodeParagraph","Properties":{"id":"20240902101756-srm94uh","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"3.生态、分布同线纹海马。"}]},{"ID":"20240902101756-ekd2q15","Type":"NodeParagraph","Properties":{"id":"20240902101756-ekd2q15","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"5.我国渤海有分布，较少。"}]},{"ID":"20240902101756-31amdwj","Type":"NodeParagraph","Properties":{"id":"20240902101756-31amdwj","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"6.我国沿海均有分布。"}]},{"ID":"20240902101756-hq2wavz","Type":"NodeParagraph","Properties":{"id":"20240902101756-hq2wavz","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902101756-7jaq8h5","Type":"NodeParagraph","Properties":{"id":"20240902101756-7jaq8h5","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"生活习性，海马为近海生活的鱼类，尤喜生活于水藻、小甲壳动物较多，风浪不大的海域。海马生活的最适温度为19-32℃，最适海水的相对密度为1.005-1.027。"}]},{"ID":"20240902101756-kvks7im","Type":"NodeParagraph","Properties":{"id":"20240902101756-kvks7im","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"养殖技术，雄鱼尾部腹面有育儿囊，并负有照管卵和仔鱼的任务。雌鱼性成熟后，在产卵期泄殖腔微微扩大，形成生殖乳头（肛突）。海马除1-2月外，皆能繁殖。性成熟的海马发性一般多在上午表现为雌鱼追逐雄鱼，在此期间体表由黑色变为黄白色。雄鱼表现为被动，雌鱼追逐到一定时间，雄鱼充儿囊就张开，其内排出透明的精液，充儿囊与雌鱼肛突相接，雌鱼排卵于大雄鱼的充儿囊中。受精卵历经20余日，仔鱼从育儿囊中排出，刚出生的海马仔即能独立生活。1次产海马苗200-1000只。"}]},{"ID":"20240902101756-vzcz19w","Type":"NodeParagraph","Properties":{"id":"20240902101756-vzcz19w","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"饲养管理海马多选择分池饲养的方法。（1）饲养池的种类①沉淀池：池长50m，宽30m，其作用是沉淀海水中的泥沙。海水必须在该池中沉淀24h，方可放到养殖池内。"}]},{"ID":"20240902101756-7uskxpe","Type":"NodeParagraph","Properties":{"id":"20240902101756-7uskxpe","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"②养殖池：位于沉淀池一侧，较沉淀池略低，池长30m，宽25m，深2.5m，供养成体海马。③海马苗繁殖缸：一般以缸直径70cm，高80cm为宜，缸身埋于地下。专供海马繁殖和饲养海马苗，易于常投食和管理，便于观察海马荔的生活情况。"}]},{"ID":"20240902101756-j2j2o2v","Type":"NodeParagraph","Properties":{"id":"20240902101756-j2j2o2v","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（2）放养，放养前，养殖池先进行洗刷消毒，以杀死敌害生物卵和鱼的寄生虫。然后向养殖池放沉淀过的海水，深度为1-1.5m，并测量池内水温、比重，再放一定数量的竹片，作为海马静止时的附着物。放养时选择体健发育良好，体长2-4cm的海马苗放入池内。每亩约放养6000-10000只。放养后，池子的水门要关牢，防止池内水流失，一般3-5天换水1次，并严防外来敌害生物的侵入。全长5-6cm的海马，可以摄食0.5-1.0cm的小虾类，成鱼期每日投饵2次，每日投饵量依海马成长逐渐增加，一般相当海马体重的6%-10%。"}]},{"ID":"20240902101756-guz1vf9","Type":"NodeParagraph","Properties":{"id":"20240902101756-guz1vf9","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"病害防治，海马最常风的疾病是胃肠炎、车轮虫病、胀膘病、气泡病。胃肠炎是海马灾难性病害，死亡率高。可用抗生素防治。对车轮虫病用8×10（-6）硫酸酮和10×10（-6）高锰酸钾混合溶液浸浴15min，效果显着。对胀膘病要保持水抽清洁，氧气充足，水温稳定，避免强光。气泡病防治，应注意避免强光直射，可针刺破气泡放出气体，或用2.4%的生石灰水浸浴10min或以1%-2%漂白粉进行治疗。"}]},{"ID":"20240902101756-crh8mrx","Type":"NodeParagraph","Properties":{"id":"20240902101756-crh8mrx","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902101756-46zz5k7","Type":"NodeParagraph","Properties":{"id":"20240902101756-46zz5k7","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"性状鉴别（1）线纹海马，体呈扁长形而弯曲，长约30cm，黄白色。头略似马头，有冠状突起，前方有一管状长吻，口小，两眼深陷。躯干部七棱形，尾部四棱形，渐细而卷曲，体上有瓦楞形的节纹并具短棘。体轻，骨质坚硬。气微腥，味微咸。"}]},{"ID":"20240902101756-fx22r2h","Type":"NodeParagraph","Properties":{"id":"20240902101756-fx22r2h","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（2）三斑海马，体节背部第1、4、7节的短棘基部各有一黑褐色斑点。"}]},{"ID":"20240902101756-otjfh9q","Type":"NodeParagraph","Properties":{"id":"20240902101756-otjfh9q","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（3）刺海马体长10-20cm。其头部及体上环节间具尖而细的棘，其尖端呈黑褐色。"}]},{"ID":"20240902101756-l1jd2it","Type":"NodeParagraph","Properties":{"id":"20240902101756-l1jd2it","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（4）大海马，体长20-30cm，黑褐色。头部及体侧有细小暗色或银白色斑点。"}]},{"ID":"20240902101756-lf4amy6","Type":"NodeParagraph","Properties":{"id":"20240902101756-lf4amy6","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（5）冠海马，体较小。头冠大约等于吻长，头冠顶端有4个突起。"}]},{"ID":"20240902101756-bfqvu8v","Type":"NodeParagraph","Properties":{"id":"20240902101756-bfqvu8v","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（6）小海马，体形较小，7-10cm。棕褐色节纹及短棘均较细小。"}]},{"ID":"20240902101756-tgo0slm","Type":"NodeParagraph","Properties":{"id":"20240902101756-tgo0slm","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"显微鉴别（1）线纹海马，粉末白色或黄白色。①横纹肌纤维较多，近无色、淡黄色或棕色，多碎断；侧面观直径45-144μm，有细密横纹，明暗相间，横纹平直或微波状；横断面易见，呈类长方形、类矩圆形、菱形或长卵形，表面平滑，可见细点状或裂隙状孔隙。②胶原纤维散离，直径13-27μm，相互缠绕成团，隐约可见纵向细纹理。胶原纤维团常与含灰色颗粒状物的组织碎片相连结。③皮肤碎片近无色或淡黄色，表面观细胞界取不清楚，隐约可见不规则微波状纵横纹理，布有棕色颗粒状色素物，散在或聚集成星芒状。④骨碎片无色或淡灰色，呈不规则形碎块，骨陷窝呈长条形、裂缝状或类长圆形，排列不规则，边缘骨小管较稀疏。"}]},{"ID":"20240902101756-phv5wue","Type":"NodeParagraph","Properties":{"id":"20240902101756-phv5wue","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（3）刺海马，粉末灰黄色。①横纹肌纤维较多，近无色或淡黄色，成块或碎断，有细密横纹，阴暗相间，横纹微波状，横断面类距圆形，表面平滑。②胶原纤维散离或成团束，隐约可见纵向纹理，常与含灰色颗粒状特的组织碎片相连接。③表皮碎片近无色或淡黄色，表面观细胞界线明显，多角形，棕色颗粒状色素物密集，多聚集为星芒状。④骨质碎片无色或淡灰色，不规碎片状，骨陷窝呈长条状、裂缝状，排列不规则，边缘见风使舵小管稀疏。"}]},{"ID":"20240902101756-5ei04pz","Type":"NodeParagraph","Properties":{"id":"20240902101756-5ei04pz","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（4）大海马，粉末棕色或黄棕色。①横纹肌纤维较多，近无色或淡黄色，多碎断，成束，横纹不明显，横断面类矩圆形，表面平滑，可见细点太裂缝状孔隙。②胶原纤维多散离或2-3成束，可缠绕成团，可见纵向细纹理，常与含灰色颗粒状物的组织碎片相连接。③皮肤碎片不少见，近无色或淡黄色。表面观细胞界线不明显，可见不规则纹理，棕红色颗粒状色素物质稀疏，聚集成星芒状。④骨质碎片无色或淡灰色，不规则碎片状，骨陷窝中小型长条状、裂缝状，排列不规则，边缘内小管稀疏。"}]},{"ID":"20240902101756-1rusmv8","Type":"NodeParagraph","Properties":{"id":"20240902101756-1rusmv8","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"（5）小海马，粉末深棕色或棕色。①横纹肌纤维较多，近无色，多碎断，有明暗相间的横纹，横纹平直，横为面类圆形，表面平滑。②胶原纤维成束或散离，隐约可见纵向纹理，常与含灰色颗粒状物的组织碎片相连接。③皮肤碎片近无色或淡黄色，表面观细胞界线不明显，隐约可见不规则微波状纵横纹理，布有棕色颗粒状色素物，散在或成团。④骨质碎片无色或淡灰色，呈不规则块状，骨隐窝呈长条状、裂缝状或类长圆形，排列不规则，边缘内小管稀疏。"}]},{"ID":"20240902101756-3uq9atd","Type":"NodeParagraph","Properties":{"id":"20240902101756-3uq9atd","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902101756-ckkagh1","Type":"NodeParagraph","Properties":{"id":"20240902101756-ckkagh1","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"1.三斑海马含有谷氨酸（glutamicacid），天冬氨酸（asparticacid），甘氨酸（glycine），脯氨酸（proline），丙氨酸（alanine），亮氨酸（leucine）等17种氨基酸；钙（Ca），磷（P），钠（Na），钾（K），镁（Mg），铁（Fe），锶（Sr），硅（Si）等19种无机元素。另外还含有硬脂酸（stearicacid），胆甾醇（cholesterol）。此外还推测含有胆甾二醇（cholesterdiol）。"}]},{"ID":"20240902101756-75dsent","Type":"NodeParagraph","Properties":{"id":"20240902101756-75dsent","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.刺海马含有蛋白质（protein），脂肪（fat），多种氨基酸。皮肤黄色素为-γ-胡萝卜素（γ-carotene），红色素为虾青素（astaxanthin），剌蛄素（astacene），黑色为黑色素（melanin）。另含乙酰胆碱酯酶，胆碱酯酶，蛋白酶。"}]},{"ID":"20240902101756-o8wogbu","Type":"NodeParagraph","Properties":{"id":"20240902101756-o8wogbu","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"3.大海马中含精氨酸（arginine），天冬氨酸，丙氨酸，某氨酸，脯氨酸，谷氨酸等20多种氨基酸，尚含有药用价值较高的牛磺酸（tourine）。另外还含有大量的钙、镁、钾、钠、铁，较多的锌、锰、铜和少量的铬、钴、硒等无机元素。"}]},{"ID":"20240902101756-5t4syot","Type":"NodeParagraph","Properties":{"id":"20240902101756-5t4syot","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902101756-k7ap51w","Type":"NodeParagraph","Properties":{"id":"20240902101756-k7ap51w","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"1.性激素样作用：线纹海马的乙醇提取物，可延长正常雌小鼠的动情期，对去势鼠则可出现动情期，并使子宫及卵巢（正常小鼠）重量增加。海马（品种未注明）提取液表现雄性激素样作用，其效力较蛇床子、淫羊藿弱，但比蛤蚧强。"}]},{"ID":"20240902101756-f9evkvu","Type":"NodeParagraph","Properties":{"id":"20240902101756-f9evkvu","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.延缓衰老作用：海马能延长小鼠（NiH雄性小鼠）缺氧和存活时间，延长小鼠的游泳时间，显示了较好的抗应激力，增强体质和对外界不良刺激的抵抗力，增强动物的记忆力。海马对MAO-B（单胺氧化酶B）活性、过氧化脂质均有显着影响。海马配人参的制剂经药理实验表明，小鼠游泳持续时间明显延长，并能对抗氢化考的松引起小鼠胸腺萎缩的不良影响，表现出此制剂的补益作用。"}]},{"ID":"20240902101756-sqzgp3n","Type":"NodeParagraph","Properties":{"id":"20240902101756-sqzgp3n","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【炮制】海马:用水刷净，切块或打碎。酒炙海马：净海马用黄酒湿润，微火烘烤至酥松而呈黄色即成。"}]},{"ID":"20240902101756-lfj5cde","Type":"NodeParagraph","Properties":{"id":"20240902101756-lfj5cde","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；咸；性温"}]},{"ID":"20240902101756-pyzrrtg","Type":"NodeParagraph","Properties":{"id":"20240902101756-pyzrrtg","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾经"}]},{"ID":"20240902101756-j0uk3on","Type":"NodeParagraph","Properties":{"id":"20240902101756-j0uk3on","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【功能主治】补肾壮阳；散结消肿。主肾虚阳痿；宫冷不孕遗尿；虚喘；症瘕积聚；跌打损伤；痈疮肿毒"}]},{"ID":"20240902101756-l7t8o69","Type":"NodeParagraph","Properties":{"id":"20240902101756-l7t8o69","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；研末，1-1.5g。外用：适量，研末掺或调敷。"}]},{"ID":"20240902101756-5fggwq3","Type":"NodeParagraph","Properties":{"id":"20240902101756-5fggwq3","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇及阴虚阳亢者禁服。"}]},{"ID":"20240902101756-vs5bny7","Type":"NodeParagraph","Properties":{"id":"20240902101756-vs5bny7","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【附方】①治远年虚实积聚瘕块：木香一两，海马子一对(雌者黄色，雄者青色)，大黄(炒、锉)、青橘皮(汤浸，去白，焙)、白牵中(炒)各二两，巴豆四十九粒。上六味，以童子小便浸青橘皮钦，裹巴豆，以线系定，入小便内再浸七日，取出，教炒黄，去巴豆，只使青稿皮并余药粗捣筛。每服二钱匕，水一盏，煎三、五沸，去滓，临睡温服。(《圣济总录》木香汤)②治发背诸恶疮，兼治疗疮：海马一双(炙)，穿山甲(黄土炒)、水银、朱砂各二钱，雄黄三钱，轻粉一钱，脑子、麝香各少许。上除水银外，各研为末和合，入水银再研至无屋。针破疮口，点药入内，一日一点。(《急救仙方》海马拔毒散)"}]},{"ID":"20240902101756-jlfpdg9","Type":"NodeParagraph","Properties":{"id":"20240902101756-jlfpdg9","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902101756-yef1yb3","Type":"NodeParagraph","Properties":{"id":"20240902101756-yef1yb3","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：海马，雌雄成对，其性温暖，故难产及阳虚多用之，如蛤阶、郎君子之功也。"}]},{"ID":"20240902101756-qpjuy09","Type":"NodeParagraph","Properties":{"id":"20240902101756-qpjuy09","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"2.《本草新编》：海马，亦虾属也，入肾经命门，专善兴阳，功不亚于海狗，更善堕胎，故能催生也。海马功用不亚腽肭脐，乃尚服腕脐不尚海马，此世人之大惑也。谁知海马不论雌雄，皆能勃兴阳道，若赐腕脐，必须用雄者始效，贵价而买，仍是赝物，何若用海马之适用哉。"}]},{"ID":"20240902101756-ped2rna","Type":"NodeParagraph","Properties":{"id":"20240902101756-ped2rna","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：主妇人难产。"}]},{"ID":"20240902101756-fd7xsdh","Type":"NodeParagraph","Properties":{"id":"20240902101756-fd7xsdh","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：妇人将产，烧末被服。《异鱼图》云，主难产及血气痛。"}]},{"ID":"20240902101756-sjh96o8","Type":"NodeParagraph","Properties":{"id":"20240902101756-sjh96o8","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"5.《品汇精要》：调气和血。"}]},{"ID":"20240902101756-q4lmng9","Type":"NodeParagraph","Properties":{"id":"20240902101756-q4lmng9","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：暖水藏，壮阳道，消瘕块，治疔疮肿毒。"}]},{"ID":"20240902101756-jx2ckcj","Type":"NodeParagraph","Properties":{"id":"20240902101756-jx2ckcj","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：阳虚多用之，可代蛤阶。"}]},{"ID":"20240902101756-ouh33tw","Type":"NodeParagraph","Properties":{"id":"20240902101756-ouh33tw","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"8.《海南介语》：主夜遗。"}]},{"ID":"20240902101756-8hgdk5p","Type":"NodeParagraph","Properties":{"id":"20240902101756-8hgdk5p","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"9.《药材学》：温通任脉，用于喘息及久喘。"}]},{"ID":"20240902101756-zbilgi8","Type":"NodeParagraph","Properties":{"id":"20240902101756-zbilgi8","updated":"20240902101835"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902101758-482zt1e","Type":"NodeThematicBreak","Properties":{"id":"20240902101758-482zt1e","updated":"20240902101835"}},{"ID":"20240902101759-ilsvrv5","Type":"NodeParagraph","Properties":{"id":"20240902101759-ilsvrv5","updated":"20240902101835"}}]}