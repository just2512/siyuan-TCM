615px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡冠花 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡冠花 3-20240730140002-vs86560.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 615px;\" parent-style=\"width: 625px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730141400-s5n4f3b","Type":"NodeParagraph","Properties":{"id":"20240730141400-s5n4f3b","updated":"20240730141634"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 439px;","style":"width: 429px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡冠花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡冠花 6-20240730141400-256880u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 429px;\" parent-style=\"width: 439px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 774px;","style":"width: 764px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡冠花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡冠花 7-20240730141634-v5yegpv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 764px;\" parent-style=\"width: 774px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730135626-a4lqwa0","Type":"NodeThematicBreak","Properties":{"id":"20240730135626-a4lqwa0"}},{"ID":"20240903092618-2yent3p","Type":"NodeParagraph","Properties":{"id":"20240903092618-2yent3p","updated":"20240903092625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：鸡冠花"}]},{"ID":"20240903092618-9nexun4","Type":"NodeParagraph","Properties":{"id":"20240903092618-9nexun4","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花《中国药典》"}]},{"ID":"20240903092618-2n613u3","Type":"NodeParagraph","Properties":{"id":"20240903092618-2n613u3","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīGuānHuā"}]},{"ID":"20240903092618-ivkrigh","Type":"NodeParagraph","Properties":{"id":"20240903092618-ivkrigh","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSCELOSIAECRISTATAE"}]},{"ID":"20240903092618-zzpt174","Type":"NodeParagraph","Properties":{"id":"20240903092618-zzpt174","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【别名】鸡公花、鸡髻花、鸡冠头"}]},{"ID":"20240903092618-3sdcthc","Type":"NodeParagraph","Properties":{"id":"20240903092618-3sdcthc","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【来源】本品为苋科植物鸡冠花CelosiacristataL.的干燥花序。秋季花盛开时采收，晒干。"}]},{"ID":"20240903092618-eky4pmj","Type":"NodeParagraph","Properties":{"id":"20240903092618-eky4pmj","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性状】本品为穗状花序，多扁平而肥厚，呈鸡冠状，长8～25cm,宽5～20cm，上缘宽，具皱褶，密生线状鳞片，下端渐窄，常残留扁平的茎。表面红色、紫红色或黄白色。中部以下密生多数小花，每花宿存的苞片及花被片均呈膜质。果实盖裂，种子扁圆肾形，黑色，有光泽。体轻，质柔韧。无臭，味淡。"}]},{"ID":"20240903092618-6nnlxxm","Type":"NodeParagraph","Properties":{"id":"20240903092618-6nnlxxm","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品2g，剪碎，加乙醇30ml,加热回流30分钟，滤过，滤液蒸干，残渣加乙醇2ml使溶解，作为供试品溶液。另取鸡冠花对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各2μl，分别点于同一硅胶G薄层板上，以环已烷-丙酮（5:1）为展开剂，展开，取出，晾干，喷以5％香草醛硫酸溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240903092618-m9vh0q0","Type":"NodeParagraph","Properties":{"id":"20240903092618-m9vh0q0","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903092618-q0dh7vq","Type":"NodeParagraph","Properties":{"id":"20240903092618-q0dh7vq","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花：除去杂质及残茎，切段。"}]},{"ID":"20240903092618-p7wh8md","Type":"NodeParagraph","Properties":{"id":"20240903092618-p7wh8md","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花炭：取净鸡冠花，照炒炭法（附录ⅡD）炒至焦黑色。"}]},{"ID":"20240903092618-oh3nyac","Type":"NodeParagraph","Properties":{"id":"20240903092618-oh3nyac","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性味】甘、涩，凉。"}]},{"ID":"20240903092618-uohqvh8","Type":"NodeParagraph","Properties":{"id":"20240903092618-uohqvh8","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、大肠经。"}]},{"ID":"20240903092618-n7fowvd","Type":"NodeParagraph","Properties":{"id":"20240903092618-n7fowvd","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【功能主治】收敛止血，止带，止痢。用于吐血，崩漏，便血，痔血，赤白带下，久痢不止。"}]},{"ID":"20240903092618-pc1edt3","Type":"NodeParagraph","Properties":{"id":"20240903092618-pc1edt3","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【用法用量】6～12g。"}]},{"ID":"20240903092618-i2uhcnn","Type":"NodeParagraph","Properties":{"id":"20240903092618-i2uhcnn","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。"}]},{"ID":"20240903092618-t26alea","Type":"NodeParagraph","Properties":{"id":"20240903092618-t26alea","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903092618-2owx05v","Type":"NodeParagraph","Properties":{"id":"20240903092618-2owx05v","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花《*辞典》"}]},{"ID":"20240903092618-9m7qtmo","Type":"NodeParagraph","Properties":{"id":"20240903092618-9m7qtmo","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【出处】《岭南本草》"}]},{"ID":"20240903092618-r1y0u78","Type":"NodeParagraph","Properties":{"id":"20240903092618-r1y0u78","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīGuānHuā"}]},{"ID":"20240903092618-nfy5i0g","Type":"NodeParagraph","Properties":{"id":"20240903092618-nfy5i0g","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【别名】鸡髻花、鸡公花（《闽东本草》），鸡角枪（《福建中草药》）。"}]},{"ID":"20240903092618-re7ur43","Type":"NodeParagraph","Properties":{"id":"20240903092618-re7ur43","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【来源】为苋科植物鸡冠花的花序。8～10月间，花序充分长大，并有部分果实成熟时，剪下花序，晒干。"}]},{"ID":"20240903092618-aswet03","Type":"NodeParagraph","Properties":{"id":"20240903092618-aswet03","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903092618-k20747q","Type":"NodeParagraph","Properties":{"id":"20240903092618-k20747q","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花，又名：鸡冠苋。"}]},{"ID":"20240903092618-gpruiyi","Type":"NodeParagraph","Properties":{"id":"20240903092618-gpruiyi","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"一年生草本，高60～90厘米，全体无毛。茎直立，粗壮。单叶互生；长椭圆形至卵状披针形，长5～12厘米，宽3.5～6.5厘米，先端渐尖，全缘，基部渐狭而成叶柄。穗状花序多变异，生于茎的先端或分枝的末端，常呈鸡冠状，色有紫、红、淡红、黄或杂色；花密生，每花有3苞片；花被5，广披针形，长5～8毫米，干膜质，透明；雄蕊5，花丝下部合生成环状；雌蕊1，柱头2浅裂。胞果成热时横裂，内有黑色细小种子2至数粒。花期7～9月。果期9～10月。"}]},{"ID":"20240903092618-oee8ww5","Type":"NodeParagraph","Properties":{"id":"20240903092618-oee8ww5","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国大部地区有栽培，为观赏植物。全国大部分地区有产。"}]},{"ID":"20240903092618-viinpef","Type":"NodeParagraph","Properties":{"id":"20240903092618-viinpef","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性状】为带有短茎的花序，形似鸡冠，或为穗状、卷冠状。上缘呈鸡冠状的部分，密生线状的绒毛，即未开放的小花，一般颜色较深，有红、浅红、白等颜色；中部以下密生许多小花，各小花有膜质灰白色的苞片及花被片。蒴果盖裂；种子黑色，有光泽。气无，味淡。以朵大而扁，色泽鲜艳的白鸡冠花较佳，色红者次之。"}]},{"ID":"20240903092618-ae16wjp","Type":"NodeParagraph","Properties":{"id":"20240903092618-ae16wjp","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【药理作用】试管法证明，煎剂对人阴道毛滴虫有良好作用，虫体与药液接触5～10分钟后即趋消失。"}]},{"ID":"20240903092618-dl78oqm","Type":"NodeParagraph","Properties":{"id":"20240903092618-dl78oqm","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去茎及种子，剪成小块。"}]},{"ID":"20240903092618-ku1djho","Type":"NodeParagraph","Properties":{"id":"20240903092618-ku1djho","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903092618-v0uuzki","Type":"NodeParagraph","Properties":{"id":"20240903092618-v0uuzki","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"甘，凉。"}]},{"ID":"20240903092618-z32kflx","Type":"NodeParagraph","Properties":{"id":"20240903092618-z32kflx","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性寒，味苦微辛。\""}]},{"ID":"20240903092618-uczc8e5","Type":"NodeParagraph","Properties":{"id":"20240903092618-uczc8e5","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"甘，凉，无毒。\""}]},{"ID":"20240903092618-vgzgs7y","Type":"NodeParagraph","Properties":{"id":"20240903092618-vgzgs7y","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"性凉，味甘涩，无毒。\""}]},{"ID":"20240903092618-t8m9atv","Type":"NodeParagraph","Properties":{"id":"20240903092618-t8m9atv","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240903092618-oc94hjf","Type":"NodeParagraph","Properties":{"id":"20240903092618-oc94hjf","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"①《玉楸药解》：\"入足蹶阴肝经。\""}]},{"ID":"20240903092618-4epvx3i","Type":"NodeParagraph","Properties":{"id":"20240903092618-4epvx3i","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肾经。\""}]},{"ID":"20240903092618-cegmn52","Type":"NodeParagraph","Properties":{"id":"20240903092618-cegmn52","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903092618-q0b5m3r","Type":"NodeParagraph","Properties":{"id":"20240903092618-q0b5m3r","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"凉血，止血。治痔漏下血，赤白下痢，吐血，咳血，血淋，妇女崩中，赤白带下。"}]},{"ID":"20240903092618-spokh09","Type":"NodeParagraph","Properties":{"id":"20240903092618-spokh09","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"止肠风下血，妇人崩中带下，赤痢。\""}]},{"ID":"20240903092618-sn1au6j","Type":"NodeParagraph","Properties":{"id":"20240903092618-sn1au6j","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"治痔漏下血，办白下痢，崩中，亦白带下，分赤白用。\""}]},{"ID":"20240903092618-stppx7l","Type":"NodeParagraph","Properties":{"id":"20240903092618-stppx7l","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"③《玉楸药解》：\"清风退热，止衄敛营。治吐血，血崩，血淋诸失血证。\""}]},{"ID":"20240903092618-68088ra","Type":"NodeParagraph","Properties":{"id":"20240903092618-68088ra","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或入丸、散。外用：煎水熏洗。"}]},{"ID":"20240903092618-dpsn5el","Type":"NodeParagraph","Properties":{"id":"20240903092618-dpsn5el","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903092618-pf2vnva","Type":"NodeParagraph","Properties":{"id":"20240903092618-pf2vnva","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"①治五痔肛边肿痛，或窜乳，或窜穴，或作疮，久而不愈，变成漏疮：鸡冠花、风眼草各一两。上为粗末。每用粗末半两，水碗半，煎三、五沸，热洗患处。（《卫生宝鉴》淋渫鸡冠散）"}]},{"ID":"20240903092618-wk5jqdj","Type":"NodeParagraph","Properties":{"id":"20240903092618-wk5jqdj","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"②治赤白下痢：鸡冠花煎酒服，赤用红，白用白。（《濒湖集简方》）"}]},{"ID":"20240903092618-8k32viu","Type":"NodeParagraph","Properties":{"id":"20240903092618-8k32viu","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"③治下血脱肛：㈠鸡冠花、防风等分。为末，糊丸，梧子大。空心米饮每服七十丸。㈡白鸡冠花（炒）、椶榈灰、羌活（各）一两。为末，每服二钱，米饮下。（《永类钤方》）"}]},{"ID":"20240903092618-efcx02m","Type":"NodeParagraph","Properties":{"id":"20240903092618-efcx02m","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"④治吐血不止：白鸡冠花，醋浸煮七次，为末。每服二钱，热酒下。（《经验方》）"}]},{"ID":"20240903092618-yga39f4","Type":"NodeParagraph","Properties":{"id":"20240903092618-yga39f4","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑤治咳血，吐血：鲜白鸡冠花五至八钱（干者二至五钱），和猪肺（不可灌水）冲开水约炖一小时许，饭后分二，三次服。（《泉州本草》）"}]},{"ID":"20240903092618-ks5xypn","Type":"NodeParagraph","Properties":{"id":"20240903092618-ks5xypn","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑥治经水不止：红鸡冠花一味，干晒为末。每服二钱，空心酒调下。忌鱼腥猪肉。（《孙天仁集效方》）"}]},{"ID":"20240903092618-hf5ypof","Type":"NodeParagraph","Properties":{"id":"20240903092618-hf5ypof","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑦治产后血痛：白鸡冠花酒煎服之。（《怪证奇方》）"}]},{"ID":"20240903092618-olef51z","Type":"NodeParagraph","Properties":{"id":"20240903092618-olef51z","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑧治白带、砂淋：白鸡冠花、苦壶芦等分。烧存性，空心火酒服之。（《摘元方》）"}]},{"ID":"20240903092618-8a7pdtb","Type":"NodeParagraph","Properties":{"id":"20240903092618-8a7pdtb","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑨治血淋：白鸡冠花一两，烧炭，米汤送下。（《湖南药物志》）"}]},{"ID":"20240903092618-yzbusfe","Type":"NodeParagraph","Properties":{"id":"20240903092618-yzbusfe","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑩治妇人白带：白鸡冠花，晒干为末。每旦空心酒服三钱，赤带用红者。（《孙天仁集效方》）"}]},{"ID":"20240903092618-z4p0nld","Type":"NodeParagraph","Properties":{"id":"20240903092618-z4p0nld","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑾治风疹：白鸡冠花、向日葵各三钱，冰糖一两。开水炖服。（《闽东本草》）"}]},{"ID":"20240903092618-vllevae","Type":"NodeParagraph","Properties":{"id":"20240903092618-vllevae","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⑿治青光眼：干鸡冠花、干艾根、干牡荆根各五钱。水煎服。（《福建中草药》）"}]},{"ID":"20240903092618-nrfhnwa","Type":"NodeParagraph","Properties":{"id":"20240903092618-nrfhnwa","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"⒀治额疽：鲜鸡冠花、一点红、红莲子草（苋科）各酌量，调红糖捣烂敷患处。（《福建中草药》）"}]},{"ID":"20240903092618-4mdbr5k","Type":"NodeParagraph","Properties":{"id":"20240903092618-4mdbr5k","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903092618-y0e424u","Type":"NodeParagraph","Properties":{"id":"20240903092618-y0e424u","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"鸡冠花《中华本草》"}]},{"ID":"20240903092618-qmxah1p","Type":"NodeParagraph","Properties":{"id":"20240903092618-qmxah1p","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【出处】出自《滇南本草》。"}]},{"ID":"20240903092618-t71sg8z","Type":"NodeParagraph","Properties":{"id":"20240903092618-t71sg8z","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【拼音名】JīGuānHuā"}]},{"ID":"20240903092618-wt9190d","Type":"NodeParagraph","Properties":{"id":"20240903092618-wt9190d","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【别名】鸡髻花、鸡公花、鸡角枪、鸡冠头、鸡骨子花、老来少"}]},{"ID":"20240903092618-ze31maa","Type":"NodeParagraph","Properties":{"id":"20240903092618-ze31maa","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903092618-5udco9z","Type":"NodeParagraph","Properties":{"id":"20240903092618-5udco9z","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"药材基源：为苋科植物鸡冠花的花序。"}]},{"ID":"20240903092618-zvgg1f9","Type":"NodeParagraph","Properties":{"id":"20240903092618-zvgg1f9","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：CelosiacristataL．[C．ArgenteaL.var.Cristata（L．）O.Kuntze］"}]},{"ID":"20240903092618-fctmntp","Type":"NodeParagraph","Properties":{"id":"20240903092618-fctmntp","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"采收和储藏：8-10月间，花序充分长大，并有部分果实成熟时，剪下花序，晒干。"}]},{"ID":"20240903092618-iebi4gl","Type":"NodeParagraph","Properties":{"id":"20240903092618-iebi4gl","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【原形态】一年生直立草本，高30-80cm。全株无毛，粗壮。分枝少，近上部扁平，绿色或带红色，有棱纹凸起。单叶互生，具柄；叶片长椭圆形至卵状披针形，长5-13cm，宽2-6cm，先端渐尖或长尖，基部渐窄成柄，全缘。穗状花序顶生，成扁平肉质鸡冠状、卷冠状或羽毛状，中部以下多花；花被片淡红色至紫红色、黄白或黄色；苞片、小苞片和花被片干膜质，宿存；花被片5，椭圆状卵形，端尖，雄蕊5，花丝下部合生成杯状。胞果卵形，长约3mm，熟时盖裂，包于宿存花被内。种子肾形，黑色，光泽。花期5-8月，果期8-11月。"}]},{"ID":"20240903092618-bezchsi","Type":"NodeParagraph","Properties":{"id":"20240903092618-bezchsi","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【生境分布】原产亚洲热带。我国南北各地区均有栽培，广布于温暖地区。"}]},{"ID":"20240903092618-2gb02po","Type":"NodeParagraph","Properties":{"id":"20240903092618-2gb02po","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240903092618-3l1g7oi","Type":"NodeParagraph","Properties":{"id":"20240903092618-3l1g7oi","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"1.气候土壤：喜温暖气候。对土壤要求不严，但以排水良好的夹砂土栽培较好。"}]},{"ID":"20240903092618-v5smxry","Type":"NodeParagraph","Properties":{"id":"20240903092618-v5smxry","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"2.种植：种子繁殖。一般直播，也可育苗移栽。直播时，每亩用种子5-6两，与拌有人畜粪水的火灰混匀，在畦上按行、株距各约30cm开穴，深约3cm，穴底要平，先施人畜粪水，然后将种子灰均匀撒播。"}]},{"ID":"20240903092618-ux7mcdi","Type":"NodeParagraph","Properties":{"id":"20240903092618-ux7mcdi","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"3.苗高7-10cm时，匀苗、补苗，每穴留壮苗4-5株。除草、追肥，第1次在匀亩后进行，第2次在5月间。天旱时要浇水。"}]},{"ID":"20240903092618-okb6262","Type":"NodeParagraph","Properties":{"id":"20240903092618-okb6262","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"4.病虫害防治：虫害有蛞蝓，在早晨撒鲜石灰粉防治。青虫，用乐果防治。青虫，用6%可湿性六六六防治。"}]},{"ID":"20240903092618-8r92ie3","Type":"NodeParagraph","Properties":{"id":"20240903092618-8r92ie3","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性状】为带有短茎的花序，形似鸡冠，或为穗状、卷冠状，上缘呈鸡冠状的部分，密生线状的绒毛，即未开放的小花，一般颜色较深，有红、浅红、白等颜色；中部以下密生许多小花，各小花有膜质灰白色的苞片及花被片。蒴果盖裂；种子黑色，有光泽。气无，味淡。以朵大而扁、色泽鲜艳的白鸡冠花较佳，色红者次之。"}]},{"ID":"20240903092618-ohkie7i","Type":"NodeParagraph","Properties":{"id":"20240903092618-ohkie7i","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【化学成份】花含山柰甙(kaempferitrin)、苋菜红甙(amaranthim)、松醇(pinite)及大量硝酸钾；黄色花序中含微量苋菜红素，细色花序中含大量苋菜红素。种子含脂肪油12.8%，脂肪酸组成：丹桂酸微量，肉豆蔻酸0.1%，棕榈酸8.7%，硬脂酸1.3%，花生酸微量，山萮酸0.7%，廿四成碳烷酸0.5%，十六碳酸微量51.5%，二十碳烯酸0.1%，芥酸1.9%，二十四碳烯酸0.1%，亚油酸32.9%，亚麻酸2.6%。"}]},{"ID":"20240903092618-csdw9m3","Type":"NodeParagraph","Properties":{"id":"20240903092618-csdw9m3","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【药理作用】试管法证明，煎剂对人阴道毛滴虫有良好作用，虫体与药液接触5-10分钟后即趋消失。10%煎剂在试管中，加等量阴道滴虫养液，30分钟时虫体变圆，活动力减弱，60分钟时大部虫体消失；如前剂浓度为20%，则15分钟时虫体即消失。试管法证明，本品煎剂对人阴道毛滴虫有良好杀灭作用，10%煎剂加等量阴道滴虫培养液，30分钟时虫体变圆，活动力减弱，60分钟时大部分虫体消失；20%煎剂可使虫体5-10分钟内消失。本品10%注射液对孕鼠、孕豚鼠、家兔等宫腔内给药有中期引产作用。"}]},{"ID":"20240903092618-ibevdp3","Type":"NodeParagraph","Properties":{"id":"20240903092618-ibevdp3","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，除去茎及种子，剪成小块。"}]},{"ID":"20240903092618-g5scj0t","Type":"NodeParagraph","Properties":{"id":"20240903092618-g5scj0t","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【性味】甘；凉；无毒"}]},{"ID":"20240903092618-5j8qgqm","Type":"NodeParagraph","Properties":{"id":"20240903092618-5j8qgqm","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾经"}]},{"ID":"20240903092618-xdvyopg","Type":"NodeParagraph","Properties":{"id":"20240903092618-xdvyopg","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【功能主治】凉血；止血。主痔漏下血；赤白下痢；吐血；咳血；血淋；妇女崩中；赤白带下"}]},{"ID":"20240903092618-c7ydehs","Type":"NodeParagraph","Properties":{"id":"20240903092618-c7ydehs","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5-3钱；或入丸、散。外用：煎水熏洗。"}]},{"ID":"20240903092618-o37y0em","Type":"NodeParagraph","Properties":{"id":"20240903092618-o37y0em","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903092618-6pdqvag","Type":"NodeParagraph","Properties":{"id":"20240903092618-6pdqvag","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"1.《滇南本草》：止肠风下血，妇人崩中带下，赤痢。"}]},{"ID":"20240903092618-yim9k73","Type":"NodeParagraph","Properties":{"id":"20240903092618-yim9k73","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：治痔漏下血，赤白下痢，崩中，赤白带下，分赤白用。"}]},{"ID":"20240903092618-7rim415","Type":"NodeParagraph","Properties":{"id":"20240903092618-7rim415","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"3.《玉楸药解》：清风退热，止衄敛营。治吐血，血崩，血淋诸失血证。"}]},{"ID":"20240903092618-lceff2j","Type":"NodeParagraph","Properties":{"id":"20240903092618-lceff2j","updated":"20240903092655"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903092619-5a96i7h","Type":"NodeThematicBreak","Properties":{"id":"20240903092619-5a96i7h","updated":"20240903092655"}},{"ID":"20240903092620-mz1de1l","Type":"NodeParagraph","Properties":{"id":"20240903092620-mz1de1l","updated":"20240903092655"}}]}