Text","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 487px;","style":"width: 477px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 9-20240714115802-3iuthuj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 477px;\" parent-style=\"width: 487px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 12-20240714120836-kv5mb8l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714113727-v6b4pxm","Type":"NodeParagraph","Properties":{"id":"20240714113727-v6b4pxm","updated":"20240714115123"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 324px;","style":"width: 314px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 6-20240714114633-vmydkrt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 314px;\" parent-style=\"width: 324px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 433px;","style":"width: 423px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240714114346-k1si4hf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 423px;\" parent-style=\"width: 433px;\"}"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 320px;","style":"width: 310px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 7-20240714115121-pgqsx7u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 310px;\" parent-style=\"width: 320px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714113416-r92w0v1","Type":"NodeParagraph","Properties":{"id":"20240714113416-r92w0v1","updated":"20240714113416"}},{"ID":"20240714113416-5shp7qq","Type":"NodeParagraph","Properties":{"id":"20240714113416-5shp7qq","updated":"20240714121047"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花、月季花花苞对比（为药典记录的区分法）"}]},{"ID":"20240714120033-b7iiagh","Type":"NodeParagraph","Properties":{"id":"20240714120033-b7iiagh","updated":"20240714120507"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花玫瑰花花苞对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花玫瑰花花苞对比-20240714120505-b45wpwy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714120054-1ywyf9x","Type":"NodeParagraph","Properties":{"id":"20240714120054-1ywyf9x","updated":"20240714120112"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"月季花花苞为圆柱形，玫瑰花花苞类球形（上为月季花，下为玫瑰花）"}]},{"ID":"20240714120203-8e41yis","Type":"NodeParagraph","Properties":{"id":"20240714120203-8e41yis","updated":"20240714120550"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 10-20240714120548-gh1i597.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714120214-l7hjx0d","Type":"NodeParagraph","Properties":{"id":"20240714120214-l7hjx0d","updated":"20240714120333"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"月季花花萼是一个戟形，到最顶上突然收缩的，而玫瑰花是箭形，是从底部缓慢开始收缩的，没有一个突变的过程（左为月季花，右为玫瑰花）"}]},{"ID":"20240714120555-2pqti0t","Type":"NodeParagraph","Properties":{"id":"20240714120555-2pqti0t","updated":"20240714120555"}},{"ID":"20240714113417-a57at14","Type":"NodeParagraph","Properties":{"id":"20240714113417-a57at14","updated":"20240714135118"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：玫瑰花跟月季花本草较为相像。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206113320-y7kvz2x","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"月季花"}]},{"ID":"20240714114738-8naoz71","Type":"NodeParagraph","Properties":{"id":"20240714114738-8naoz71","updated":"20240714114738"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花茎上的刺是直立型的，月季花茎上的刺是倒勾型，少且稀疏；"}]},{"ID":"20240714114740-yi4sawa","Type":"NodeParagraph","Properties":{"id":"20240714114740-yi4sawa","updated":"20240714121146"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花叶片颜色偏黄绿，有很多褶皱偏粗糙，一般有5-9片小叶，而月季花叶片颜色较深，油亮有光泽且表面光滑，小叶一般为3-5片；"}]},{"ID":"20240714114752-uvsfa9u","Type":"NodeParagraph","Properties":{"id":"20240714114752-uvsfa9u","updated":"20240714114752"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花花期集中在4-6月，一年只开一次花，而月季花又名月月红，在适宜养育条件下可以四季开花；"}]},{"ID":"20240714114754-6eee865","Type":"NodeParagraph","Properties":{"id":"20240714114754-6eee865","updated":"20240714114754"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花花朵较小，花瓣较紧密，花香浓郁，而月季花花朵较大，花瓣较松散，花香相对较淡；"}]},{"ID":"20240714113417-tn3jtaq","Type":"NodeThematicBreak","Properties":{"id":"20240714113417-tn3jtaq"}},{"ID":"20240902105158-mn24ber","Type":"NodeParagraph","Properties":{"id":"20240902105158-mn24ber","updated":"20240902105206"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：玫瑰花"}]},{"ID":"20240902105158-y3aerqg","Type":"NodeParagraph","Properties":{"id":"20240902105158-y3aerqg","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"玫瑰花《中国药典》"}]},{"ID":"20240902105158-i2wcigp","Type":"NodeParagraph","Properties":{"id":"20240902105158-i2wcigp","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【拼音名】MéiGuiHuā"}]},{"ID":"20240902105158-li0egye","Type":"NodeParagraph","Properties":{"id":"20240902105158-li0egye","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSROSAERUGOSAE"}]},{"ID":"20240902105158-991xszq","Type":"NodeParagraph","Properties":{"id":"20240902105158-991xszq","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【来源】本品为蔷薇科植物玫瑰RosarugosaThunb.的干燥花蕾。春末夏初花将开放时分批采收，及时低温干燥。"}]},{"ID":"20240902105158-1csh66c","Type":"NodeParagraph","Properties":{"id":"20240902105158-1csh66c","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性状】本品略呈半球形或不规则团状，直径1～2.5cm。花托半球形，与花萼基部合生；萼片5,披针形，黄绿色或棕绿色，被有细柔毛；花瓣多皱缩，展平后宽卵形，呈覆瓦状排列，紫红色，有的黄棕色；雄蕊多数，黄褐色。体轻，质脆。气芳香浓郁，味微苦涩。"}]},{"ID":"20240902105158-gh2idzy","Type":"NodeParagraph","Properties":{"id":"20240902105158-gh2idzy","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品萼片表面观：非腺毛较密，单细胞，多弯曲，长136～680μm，壁厚，木化。腺毛头部多细胞，扁球形，直径64～180μm，柄部多列性，长50～340μm，基部有时可见单细胞分枝。草钙簇晶直径9～25μm。"}]},{"ID":"20240902105158-vbxmqhd","Type":"NodeParagraph","Properties":{"id":"20240902105158-vbxmqhd","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微苦，温。"}]},{"ID":"20240902105158-zgynu7l","Type":"NodeParagraph","Properties":{"id":"20240902105158-zgynu7l","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾经。"}]},{"ID":"20240902105158-ptch6k9","Type":"NodeParagraph","Properties":{"id":"20240902105158-ptch6k9","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气解郁，和血，止痛。用于肝胃气痛，食少呕恶，月经不调，跌扑伤痛。"}]},{"ID":"20240902105158-gif505q","Type":"NodeParagraph","Properties":{"id":"20240902105158-gif505q","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【用法用量】1.5～6g。"}]},{"ID":"20240902105158-bdwrnsp","Type":"NodeParagraph","Properties":{"id":"20240902105158-bdwrnsp","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【贮藏】密闭，置阴凉干燥处。"}]},{"ID":"20240902105158-lq4bkp2","Type":"NodeParagraph","Properties":{"id":"20240902105158-lq4bkp2","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902105158-no8tgm6","Type":"NodeParagraph","Properties":{"id":"20240902105158-no8tgm6","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"玫瑰花《*辞典》"}]},{"ID":"20240902105158-6gn6xx4","Type":"NodeParagraph","Properties":{"id":"20240902105158-6gn6xx4","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【出处】姚可成《食物本草》"}]},{"ID":"20240902105158-csjugp1","Type":"NodeParagraph","Properties":{"id":"20240902105158-csjugp1","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【拼音名】MéiGuiHuā"}]},{"ID":"20240902105158-e1l9vv7","Type":"NodeParagraph","Properties":{"id":"20240902105158-e1l9vv7","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【别名】徘徊花（《群芳诺》），笔头花、湖花（《浙江中药手册》），刺玫花（《河北药材》）。"}]},{"ID":"20240902105158-nguom8a","Type":"NodeParagraph","Properties":{"id":"20240902105158-nguom8a","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷范科植物玫瑰初放的花。4～6月间，当花蕾将开放时分批采摘，用文火迅速烘干。烘时将花摊放成薄层，花冠向下，使其最先干燥，然后翻转烘干其余部分。晒干者，颜色和香气均较差。"}]},{"ID":"20240902105158-d6lry44","Type":"NodeParagraph","Properties":{"id":"20240902105158-d6lry44","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902105158-zh5nbjv","Type":"NodeParagraph","Properties":{"id":"20240902105158-zh5nbjv","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"玫瑰（《群芳谱》）"}]},{"ID":"20240902105158-4onn04q","Type":"NodeParagraph","Properties":{"id":"20240902105158-4onn04q","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"直立灌木。高达2米。干粗壮，枝丛生，密生绒毛、腺毛及刺。单数羽状复叶互生：小叶5～9片，椭圆形至椭圆状倒卵形，长2～5厘米，宽1～2厘米，先端尖或钝，基部圆形或阔楔形，边缘有细锯齿，上面暗绿色，无毛而起皱，下面苍白色，被柔毛；叶柄生柔毛及刺；托叶附着于总叶柄，无锯齿，边缘有腺点。花单生或数朵簇生，直径6～8厘米，单瓣或重瓣，紫色或白色；花梗短，有绒毛、腺毛及刺；花托及花萼具腺毛；萼片5，具长尾状尖，直立，内面及边缘有线状毛；花瓣5；雄蕊多数，着生在萼筒边缘的长盘上；雌蕊多数，包于壶状花托底部。瘦果骨质，扁球形，暗橙红色，直径2～2.5厘米。花期5～6月。果期8～9月。"}]},{"ID":"20240902105158-d98t3v3","Type":"NodeParagraph","Properties":{"id":"20240902105158-d98t3v3","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【生境分布】常生于我国中部以至北部的低山丛林中。庭院或花园中多有栽培。主产于江苏、浙江、福建、山东、四川、河北等地。"}]},{"ID":"20240902105158-uypt85j","Type":"NodeParagraph","Properties":{"id":"20240902105158-uypt85j","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性状】干燥花略成半球形或不规则团状，直径1.5～2厘米。花瓣密集，短而圆，色紫红而鲜艳，中央为黄色花蕊，下部有绿色花萼，其先端分裂成5片。下端有膨大星球形的花托。质轻而脆。气苈香浓郁，味微苦。以朵大、瓣厚、色紫、鲜艳、香气浓者为佳。"}]},{"ID":"20240902105158-6rxasbq","Type":"NodeParagraph","Properties":{"id":"20240902105158-6rxasbq","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902105158-sw32980","Type":"NodeParagraph","Properties":{"id":"20240902105158-sw32980","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"鲜花含挥发油（玫瑰油）约0.03％，主要成分为香茅醇、牻牛儿醇、橙花醇、丁香油酚、苯乙醇等。香茅醇含量可达60％，牻牛儿醇含量次于香茅醇，橙花醇为5～10％，丁香油酚和苯乙醇约各为1％。油又含壬醇、苯甲醇、芳樟醇、乙酸苯乙酯。此外，花尚含槲皮甙、苦味质、鞣质、脂肪油、有机酸（没食子酸）、红色素、黄色素、蜡质、β-胡萝卜素等。"}]},{"ID":"20240902105158-di7m775","Type":"NodeParagraph","Properties":{"id":"20240902105158-di7m775","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"果实含丰富的维生素C，糖类如葡萄糖、果糖、木糖、蔗糖，非挥发酸如柠檬酸、苹果酸、奎宁酸等。黄酮类如槲皮素、异槲皮素等；又含多种色素如植物黄质、玉红黄质西红柿烃、γ-胡萝卜素等。"}]},{"ID":"20240902105158-u9ofk8d","Type":"NodeParagraph","Properties":{"id":"20240902105158-u9ofk8d","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"叶含异槲皮甙。"}]},{"ID":"20240902105158-tlxg2nj","Type":"NodeParagraph","Properties":{"id":"20240902105158-tlxg2nj","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【药理作用】玫瑰花水煎剂能解除口服锑剂的毒性（小鼠）。但仅以吐酒石口服法为限，且吐酒石的抗血吸虫作用亦随毒性解除而消失，据推测，此可能为玫瑰花改变了吐酒石的结构所致。玫瑰油对大鼠有促进胆汁分泌作用。"}]},{"ID":"20240902105158-sn5cnwl","Type":"NodeParagraph","Properties":{"id":"20240902105158-sn5cnwl","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，摘除花柄及蒂。"}]},{"ID":"20240902105158-41utsai","Type":"NodeParagraph","Properties":{"id":"20240902105158-41utsai","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902105158-gvo5yfb","Type":"NodeParagraph","Properties":{"id":"20240902105158-gvo5yfb","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"甘微苦，温."}]},{"ID":"20240902105158-hdw5nz5","Type":"NodeParagraph","Properties":{"id":"20240902105158-hdw5nz5","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"①姚可成《食物本草》：\"味甘微苦，温，无毒。\""}]},{"ID":"20240902105158-fa5usqz","Type":"NodeParagraph","Properties":{"id":"20240902105158-fa5usqz","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"②《随息居饮食谱》：\"甘辛，温。\""}]},{"ID":"20240902105158-ohvh9wd","Type":"NodeParagraph","Properties":{"id":"20240902105158-ohvh9wd","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【归经】《本草再新》：\"入肝、脾二经。\""}]},{"ID":"20240902105158-flvgol0","Type":"NodeParagraph","Properties":{"id":"20240902105158-flvgol0","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902105158-0wg0b6x","Type":"NodeParagraph","Properties":{"id":"20240902105158-0wg0b6x","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"理气解郁，和血散瘀。治肝胃气痛，新久风痹，吐血咯血，月经不调，赤白带下，痢疾，乳痈，肿毒。"}]},{"ID":"20240902105158-drs30x0","Type":"NodeParagraph","Properties":{"id":"20240902105158-drs30x0","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"①姚可成《食物本草》：\"主利肺脾，益肝胆，辟邪恶之气，食之芳香甘美，令人神爽。\""}]},{"ID":"20240902105158-typknea","Type":"NodeParagraph","Properties":{"id":"20240902105158-typknea","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"②《药性考》：\"行血破积，损伤瘀痛，浸酒饮。\""}]},{"ID":"20240902105158-7pcvg57","Type":"NodeParagraph","Properties":{"id":"20240902105158-7pcvg57","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"③《纲目拾遗》：\"和血，行血，理气。治风痹。\""}]},{"ID":"20240902105158-hytqumu","Type":"NodeParagraph","Properties":{"id":"20240902105158-hytqumu","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"舒肝胆之郁气，健脾降火。治腹中冷痛，胃脘积寒，兼能破血。\""}]},{"ID":"20240902105158-glag6qc","Type":"NodeParagraph","Properties":{"id":"20240902105158-glag6qc","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑤《随息居饮食谱》：\"调中活血，舒郁结，辟秽，和肝。酿酒可消乳癖。\""}]},{"ID":"20240902105158-70ve81l","Type":"NodeParagraph","Properties":{"id":"20240902105158-70ve81l","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"用于妇人月经过多，赤白带下及一般肠炎下痢等。\""}]},{"ID":"20240902105158-z2w9x17","Type":"NodeParagraph","Properties":{"id":"20240902105158-z2w9x17","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑦《山东中药》：\"治盱胃气痛，恶心呕吐，消化不良，泄泻，口舌糜破，吐血，噤口痢。\""}]},{"ID":"20240902105158-a8e4jcz","Type":"NodeParagraph","Properties":{"id":"20240902105158-a8e4jcz","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑧《泉州本草》：\"治肺病咳嗽痰血、吐血、咯血。\""}]},{"ID":"20240902105158-qxxdfqp","Type":"NodeParagraph","Properties":{"id":"20240902105158-qxxdfqp","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；浸酒或熬膏。"}]},{"ID":"20240902105158-44jmmr0","Type":"NodeParagraph","Properties":{"id":"20240902105158-44jmmr0","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902105158-m1fj50z","Type":"NodeParagraph","Properties":{"id":"20240902105158-m1fj50z","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"①治肝胃气痛：玫瑰花阴干，冲汤代茶服。（《纲目拾遗》）"}]},{"ID":"20240902105158-qsrbgfl","Type":"NodeParagraph","Properties":{"id":"20240902105158-qsrbgfl","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"②治肝郁吐血，月汛不调：玫瑰花蕊三百朵，初开者，去心蒂；新汲水砂铫内煎取浓汁，滤去渣，再煎，白冰糖一斤收膏，早晚开水冲服。瓷瓶密收，切勿泄气。如专调经，可用红糖收膏。（《饲鹤亭集方》玫瑰膏）"}]},{"ID":"20240902105158-0myod8i","Type":"NodeParagraph","Properties":{"id":"20240902105158-0myod8i","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"③治肺病咳嗽吐血：鲜玫瑰花捣汁炖冰糖服。（《泉州本草》）"}]},{"ID":"20240902105158-z2znhoy","Type":"NodeParagraph","Properties":{"id":"20240902105158-z2znhoy","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"④治新久风痹：玫瑰花（去净蕊蒂，阴干）三钱，红花、全当归各一钱。水煎去滓，好酒和服七剂。（《百草镜》）"}]},{"ID":"20240902105158-p4toz8f","Type":"NodeParagraph","Properties":{"id":"20240902105158-p4toz8f","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑤治肝风头痛：玫瑰花四至五朵，合蚕豆花三至四钱，泡开水代茶频饮。（《泉州本草》）"}]},{"ID":"20240902105158-i81bc9u","Type":"NodeParagraph","Properties":{"id":"20240902105158-i81bc9u","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑥治噤口痢：玫瑰花阴干煎服。（《纲目拾遗》）"}]},{"ID":"20240902105158-xa2utwl","Type":"NodeParagraph","Properties":{"id":"20240902105158-xa2utwl","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑦治乳痈初起，郁症宜此：玫瑰花初开者，阴干、燥者三十朵。去心蒂，陈酒煎，食后服。（《百草镜》）"}]},{"ID":"20240902105158-jis0r7d","Type":"NodeParagraph","Properties":{"id":"20240902105158-jis0r7d","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑧治乳痈：玫瑰花七朵，母丁香七粒。无灰酒煎服。（《纲目拾遗》）"}]},{"ID":"20240902105158-axs5q6e","Type":"NodeParagraph","Properties":{"id":"20240902105158-axs5q6e","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"⑨治肿毒初起：玫瑰花去心蒂，焙为末一钱。好酒和服。（《百草镜》）"}]},{"ID":"20240902105158-7tcl1r9","Type":"NodeParagraph","Properties":{"id":"20240902105158-7tcl1r9","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902105158-rfucwtt","Type":"NodeParagraph","Properties":{"id":"20240902105158-rfucwtt","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"玫瑰花《中华本草》"}]},{"ID":"20240902105158-apnjg8w","Type":"NodeParagraph","Properties":{"id":"20240902105158-apnjg8w","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【出处】出自姚可成《食物本草》。"}]},{"ID":"20240902105158-xn08bk6","Type":"NodeParagraph","Properties":{"id":"20240902105158-xn08bk6","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【拼音名】MéiGuiHuā"}]},{"ID":"20240902105158-atxd7n9","Type":"NodeParagraph","Properties":{"id":"20240902105158-atxd7n9","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【英文名】Rose"}]},{"ID":"20240902105158-n6zz1gy","Type":"NodeParagraph","Properties":{"id":"20240902105158-n6zz1gy","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【别名】徘徊花、笔头花、湖花、刺玫花、刺玫菊"}]},{"ID":"20240902105158-cyvpcta","Type":"NodeParagraph","Properties":{"id":"20240902105158-cyvpcta","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902105158-5gvf6lk","Type":"NodeParagraph","Properties":{"id":"20240902105158-5gvf6lk","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物玫瑰和重瓣玫瑰的花。"}]},{"ID":"20240902105158-bm3nn7p","Type":"NodeParagraph","Properties":{"id":"20240902105158-bm3nn7p","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.RosarugosaThunb.2.RosarugosaThunb.f.plena(Regel)Byhouw-er[R.rugoseThunb.var.plenaRegel]"}]},{"ID":"20240902105158-k6nee30","Type":"NodeParagraph","Properties":{"id":"20240902105158-k6nee30","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月盛花期前，采摘已充分膨大但未开放的花蕾。文火烘干或阴干；或采后装入纸袋，贮石灰缸内，封盖，每年梅雨期更换新石灰。"}]},{"ID":"20240902105158-37nscb1","Type":"NodeParagraph","Properties":{"id":"20240902105158-37nscb1","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902105158-03d4zyd","Type":"NodeParagraph","Properties":{"id":"20240902105158-03d4zyd","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"1.玫瑰直立灌木，高约2m。枝干粗壮，有皮刺和刺毛，小枝密生绒毛。羽状复叶；叶柄及叶轴上有绒毛及疏生小皮刺和刺毛；托叶大部附着于叶柄上；小叶5-9片，椭圆形或椭圆状倒卵形，长2-5cm，宽1-2cm，边缘有钝锯齿，质厚，上面光亮，多皱，无毛，下面苍白色，胡柔毛及腺体，网脉显着。花单生或3-6朵聚生；花梗有绒毛和刺毛；花瓣5或多数；紫红色或白色，芳香，直径6-8cm；花柱离生，被柔毛，柱头稍突出。果扁球形，直径2-2.5cm，红色，平滑，萼片宿存。花期5-6月。果期8-9月。"}]},{"ID":"20240902105158-5la0q7o","Type":"NodeParagraph","Properties":{"id":"20240902105158-5la0q7o","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"2.重瓣玫瑰本变型花紫红色，重瓣，区别于上种。"}]},{"ID":"20240902105158-pgvc3x0","Type":"NodeParagraph","Properties":{"id":"20240902105158-pgvc3x0","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902105158-cpcnqv6","Type":"NodeParagraph","Properties":{"id":"20240902105158-cpcnqv6","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"生态环境：庭院或花园中多有栽培。"}]},{"ID":"20240902105158-rzlrx8z","Type":"NodeParagraph","Properties":{"id":"20240902105158-rzlrx8z","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"资源分布：原产中国北部。全国各地均有栽培。以山东、江苏、浙江及广东最多。"}]},{"ID":"20240902105158-zhnbgne","Type":"NodeParagraph","Properties":{"id":"20240902105158-zhnbgne","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902105158-ijoz9nm","Type":"NodeParagraph","Properties":{"id":"20240902105158-ijoz9nm","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"生物学特性玫瑰是喜阳植物，对气候、土壤适应性强，耐寒、耐旱，怕涝。常先阳光充足、通风良好、地势较高燥平整的地块栽种。低洼积水地不宜种植。"}]},{"ID":"20240902105158-opg5jyj","Type":"NodeParagraph","Properties":{"id":"20240902105158-opg5jyj","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"栽培技术繁殖用分株、压条和扦插繁殖法。分株法：在3月中下旬未发芽前，将取母株周围萌蘖芽长成的新株挖出，连根带土移植。压条法：7-9月间让枝梢露出地面。待长出新根后。至10月中旬或次年春季与母株分离移植。扦插法：扦插法：在早春发芽前，剪取一年生枝条，剪成15-20cm长的插条，插入苗床中，待生根发芽后移植。大田定植时，按行株距50cm×30cm开穴栽种。"}]},{"ID":"20240902105158-8ulatu9","Type":"NodeParagraph","Properties":{"id":"20240902105158-8ulatu9","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"田间管理通常用饼肥、厩肥等作基肥，植株萌动时施1次人粪尿，花苞露红至采共前夕施1次人粪或硫酸铵等。入冬施1次以厩肥为主的越冬肥，肥源不足时，可酌施开花肥及越冬肥。开花后，对病枝、虫咬枝、衰老枝进行修除工作，使植株不断复壮。生长4-5年的植株，花产量逐年下降，趋于老化。此时在腊月里，进行翻挖分切重新栽种，又可更新复壮。用此法栽种后翌年无花，以后连续3年花较多。若安排多地块，逐年分栽，产量可稳定上升。入冬后将玫瑰地普遍翻一下，在近根部施越冬肥后，密情况而定。疏者多培，促进枝条萌发；反之则少培。"}]},{"ID":"20240902105158-sld0dbc","Type":"NodeParagraph","Properties":{"id":"20240902105158-sld0dbc","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有锈病，通常在四季温暖多雨或多雾的地区年份发生，趱孢子终年生存，发病较重。可于早春发芽前喷波美3-4度石硫合剂，生长季节根据病情用25%粉锈宁1000倍液喷雾防治。虫害有黄多带天牛和蔷薇三节叶蜂。黄多带天牛为害应抓信化蛹、羽化及爬出蛹室的时期及时防治，进行根际培土、除草和更新修剪，增加抵抗力，并注意保护天敌广喙蝽、蚂蚁和蟋蟀；冬季翻动植株周围的土，可灭部分越冬蔷薇三节叶蜂虫源，8月上旬，叶蜂幼虫幼龄期可喷2.5%敌杀死2000倍液或25%天幼脲Ⅲ号1×10-4防治。"}]},{"ID":"20240902105158-loen8nm","Type":"NodeParagraph","Properties":{"id":"20240902105158-loen8nm","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902105158-9awjx5s","Type":"NodeParagraph","Properties":{"id":"20240902105158-9awjx5s","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"性状鉴别花蕾或花略呈球形、卵形或不规则团块，直径1.5-2cm。花托壶形或半球形，与花萼基部相连，花托无宿梗或有短宿梗。萼片5枚，披针形，黄绿色至棕绿色，伸展或向外反卷，其内表面（上表面）被细柔毛，显凸起的中脉。花瓣5片或重瓣，广卵圆形，多皱缩，紫红色，少数黄棕色。雄蕊多数，黄褐色，着生于花托周围。有多数花柱在花托口集成头状。体轻、质脆。香气浓郁，味微苦、涩。以花朵大、完整、瓣厚、色紫、色泽鲜、不露蕊、香气浓者为佳。"}]},{"ID":"20240902105158-l1gim2x","Type":"NodeParagraph","Properties":{"id":"20240902105158-l1gim2x","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"显微鉴别萼片表面观：上表面非腺毛较密，单细胞，多弯曲，长136-680μm，壁厚，木化。下表面具多细胞腺毛，腺柄多细胞排成多列，长50-340μm，基部常有数条短小的毛状突起，腺头我细胞集成扁球形，直径64-180μm。气孔不定式。薄壁细胞含草酸钙簇晶。花粉粒：极面观略呈三角形，直径25-30μm，短轴20-25μm。具3孔沟类圆形，直径4-4.6μm。表面具条状雕纹。花梗（近花托部）横切面：表皮细胞1列，排列整齐，有单细胞非腺毛及腺毛。皮层外侧为数列较小的厚壁细胞，向内为薄壁细胞，常含草酸钙簇晶。维管束外韧型，韧皮部相连在环状；木质部束的导管3-6个。髓部薄壁细胞中含草酸钙簇晶。"}]},{"ID":"20240902105158-kfm76t5","Type":"NodeParagraph","Properties":{"id":"20240902105158-kfm76t5","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【化学成份】花含挥发油，内主含芳樟醇（linalool），芳樟醇甲酸酯（linalylformate），β-香茅醇（β-citronellol），香茅醇甲酸酯（citronellylformate），香茅醇乙酸酯（citronellylacetate），牻牛儿醇（geraniOl），牻牛儿酸甲酸酯（geranylformate），牻牛儿酸乙酸酯（geranylacetate），苯乙醇（phenylethanol），橙花醇（nerol）以及3-甲基-1-丁醇（3-methyl-1-butanol），反式-β-罗勒烯（transβ-ocimene），十五烷（pentadecane），2-十三烷酮（2-tridecanone），l-戊醇（1-pentanol），l-己醇（1-hexanol），3-己烯醇（-hexenol），乙酸己酯（hexylacetat），乙酸-3-己烯酯（3-hexenylacetate），苯甲醇（benzylalcohol），丁香油酚（eugenol），甲基丁香油酚（methyleugenol)等。花粉的挥发成分为：6-甲基-5庚烯-2-酮（6-methyl-5-hepten-2-one），牻牛儿醇乙酸酯，橙花醛（neral），牻牛儿醛（geranial)，牻牛儿醇，香茅酸乙酸酯，乙酸橙花醇酯（neryfacetate），牛儿基丙酮（geranylacetone），十五烷，2-十一烷酮（2-undecanone），2-十三烷酮，2-十五烷酮（2-pentadecanone），十四烷醛（tetradecanal），十六烷醛（hexadecanal），乙酸十四烷醇酯（tetradecylacetate)β-苯乙醇，丁香油酚，甲基丁香油酚，乙酸-β-苯乙醇酯（β-phenylethylacetate）。对玫瑰香气起重要作用的微量成分为：β-突厥酮（β-damascone），玫瑰醚（roseoxide)，a-白苏烯（a-naginatene）。花还含槲皮素（quercetin），矢车菊双甙（cyanin），有机酸，β-胡萝卜素（β-carotene），脂肪油等。花托含鞣质成分：玫瑰鞣质（rugosin）A、B、C、D、E、F、G，木麻黄素strictinin），异小木麻黄素（isostrictinin），长梗马兜铃素（pedunculagin)，木麻黄鞣亭（casuarictin），新唢呐素（tellimagrandin）Ⅰ及Ⅱ，1，2，3-三-O-没食子酰葡萄糖（1，2，3-tri-O-galloyl-β-D-glucose），1，2，6-三-O-没食子酰葡萄糖（1，2，6-tri-O-galloyl-β-D-glucose）；其中长梗马兜铃素和新唢呐素I具抗逆病毒作用。果含枸橼酸（citricacid），苹果酸（malicacid），奎宁酸（quinicacid），抗坏血酸（ascorbicacid），槲皮素，异槲皮素（isoquercetin)，植物黄质（phytoxanthin），玉红黄质（rubixanthin），番茄烃（lycopene），γ-胡萝卜素（γ-carotene），葡萄糖（glucose），果糖（fructose），木糖（xylose），蔗糖（sucrose）等。种子油中含多星的不饱和脂肪酸，并含β-谷甾醇（β-Sitosterol）。种子含维生素（vitamin）E及F。茎叶含槲皮素，芸香甙（rutin）等黄酮类化合物。叶含异槲皮素，芹菜素（apigenin）等黄酮类成分和6-去甲氧基-4-O-甲基茵陈色原酮（6-demethoxy-4-O-methylcapillarisin）、6-去甲氧基茵陈色原酮（6-demethoxycapillarisin)等色原酮类成分。又含多种倍半萜类成分：玫瑰萜醛（rugosal）A、D，表玫瑰萜醛（epirugosal）D，玫瑰酸（rugosicacid）A、B、C、D，1，4-胡萝卜二烯醛（carota-l，4-dienal），1，4-胡萝卜二烯酸（carota-1，4-dienoicacid），玫瑰没药萜醇（bisaborosaol）A、B1、B2、C1、C2、D、E1、E2、F2，哈曼拉希酸（hamanasicacid）A，胡萝卜烯醛（dancenal），环氧胡萝卜烯醛（epoxydaucenal)A、B，异胡萝卜烯醛（isodaucenal），异胡萝卜烯酸（isodaucenoicacid），11-羟基-12-氢化异胡萝卜烯醛（ll-hydrox-12-hydroisodaucenal），11，12-去氢胡萝卜烯醛(11，12-dehydrodaucenal），11，12-去氢胡萝卜烯酸（11，12-dehydrodaucenoicacid），羟基异胡萝卜烯酸（hydroxyisodaucenal)，异胡萝卜烯酸（isodaucenol)，玫瑰醛（carotarosal）A,玫瑰螺烯酮（rosacorenone),玫瑰螺烯醇（rosacorenol），断玫瑰醛（secocarotanal），胡萝卜烯（daucene），异胡萝卜烯（isodaucene），1，4-胡萝卜二烯（carota-l，4-diene），3（4），8（15）-菖蒲二烯[accra-3（4），8（15）-diene]，3（4），7（8）-菖蒲二烯〔acora3（4），7（8）-diene]。还含酯类成分：4ˊ-羟基-顺-桂皮酸二十二醇酯（4ˊ-hydroxy-cis-cinnamicaciddocpsulester），4ˊ-羟基-2，3-二氢桂皮酸二十五醇酯（4ˊ-hydroxy-2，3-dihydrocinnamicacidpentacosylester),4ˊ-羟基-顺-桂皮酸二十六醇酯（4ˊ-hydroxy-cis-cinnamicacidhexacosylester），4ˊ-羟基-顺-桂皮酸二十八烷酯（4ˊ-hydroxy-cis-cinnamicacidoctacosylester）。根含糊皮素,儿茶精（catechin），胡萝卜甙（daucosterol），菜油甾醇葡萄糖甙（campesterolglucoside)，委陵菜酸-28-O-葡萄糖酯甙（tormenticacid28-O-glucoside），野雅椿酸-28-O-葡萄糖酯甙（euscaphicacid28-O-glucoside），异阿江榄仁酸-28-O-葡萄糖酯甙（aujunicacid28-O-glucoside）。"}]},{"ID":"20240902105158-f3c1057","Type":"NodeParagraph","Properties":{"id":"20240902105158-f3c1057","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902105158-amja6pn","Type":"NodeParagraph","Properties":{"id":"20240902105158-amja6pn","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"1．抗病毒作用玫瑰花提取物对人免疫缺陷病病毒（艾滋病病毒）、白血病病毒和T细胞白血病病毒均有抗病毒作用。其所含长梗马兜铃素和新唢呐素I对感染小鼠白血病病毒细胞的逆转录酶有抑制作用，其IC50分别为0．04μg/ml和0．10μg/ml，小鼠灌服这两种成分的LD50均大于100mg/kg。"}]},{"ID":"20240902105158-5ougcia","Type":"NodeParagraph","Properties":{"id":"20240902105158-5ougcia","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"2．其他作用玫瑰花水煎剂能解除小鼠口服锑剂的毒性反应，但仅对口服酒石酸锑钾有效，且同时使其抗血吸虫作用消失，故这一作用可能由于玫瑰花煎剂改变了酒石酸锑钾的结构所致。玫瑰油对大鼠有促进胆汁分泌的作用。儿茶精类物质有烟酸样作用，可用于放射病的综合治疗，并有抗肿瘤作用。"}]},{"ID":"20240902105158-oyo39s8","Type":"NodeParagraph","Properties":{"id":"20240902105158-oyo39s8","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【鉴别】（1）本品粗粉2g，加乙醚20ml，振摇1h，滤过。滤液2ml置蒸发皿中，挥干乙醚，滴加数滴5%香草醛浓硫酸液，即显紫红色（检查挥发油）。（2）紫外光谱取本品醇浸液，用95%乙醇配成0.05%的溶液，置1cm比色池中，在UV-265FW紫外分光亮度计上测定吸收线，扫描范围200-400nm，扫描速度60nm/min。结果玫瑰花在λETOHmax210，264，354波段出现3个吸收蜂。"}]},{"ID":"20240902105158-eq4xraa","Type":"NodeParagraph","Properties":{"id":"20240902105158-eq4xraa","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，摘除花柄及蒂。"}]},{"ID":"20240902105158-tsd5cmi","Type":"NodeParagraph","Properties":{"id":"20240902105158-tsd5cmi","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【性味】甘；微苦；温；无毒"}]},{"ID":"20240902105158-vz7tnrz","Type":"NodeParagraph","Properties":{"id":"20240902105158-vz7tnrz","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾经"}]},{"ID":"20240902105158-txg9ucr","Type":"NodeParagraph","Properties":{"id":"20240902105158-txg9ucr","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【功能主治】理气解郁；和血调经。主肝气郁结所致胸膈满闷，脘胁胀痛，乳房作胀，月经不调，痢疾，泄泻，带下，跌打损伤痈肿"}]},{"ID":"20240902105158-g6w33w7","Type":"NodeParagraph","Properties":{"id":"20240902105158-g6w33w7","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：温饮30-60g。"}]},{"ID":"20240902105158-smibez4","Type":"NodeParagraph","Properties":{"id":"20240902105158-smibez4","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚火旺慎服。"}]},{"ID":"20240902105158-8sofw8t","Type":"NodeParagraph","Properties":{"id":"20240902105158-8sofw8t","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902105158-4dkjp3n","Type":"NodeParagraph","Properties":{"id":"20240902105158-4dkjp3n","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"1.《本草正义》：玫瑰花，香气最浓，清而不浊，和而不猛，柔肝醒胃，流气活血，宣通窒滞而绝无辛温刚燥之弊，断推气分药之中、最有捷效而最为驯良者，芳香诸品，殆无其匹。"}]},{"ID":"20240902105158-h5oxuu0","Type":"NodeParagraph","Properties":{"id":"20240902105158-h5oxuu0","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"2.姚可成《食物本草》：主利肺脾，益肝胆，辟邪恶之气，食之芳香甘美，令人神爽。"}]},{"ID":"20240902105158-35wuvsv","Type":"NodeParagraph","Properties":{"id":"20240902105158-35wuvsv","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"3.《药性考》：行血破积，损伤瘀痛，浸酒饮。"}]},{"ID":"20240902105158-bltskxv","Type":"NodeParagraph","Properties":{"id":"20240902105158-bltskxv","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"4.《本草纲目拾遗》：和血，行血，理气。治风痹。"}]},{"ID":"20240902105158-wte988d","Type":"NodeParagraph","Properties":{"id":"20240902105158-wte988d","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"5.《本草再新》：舒肝胆之郁气，健脾降火。治腹中冷痛，胃脘积寒，兼能破血。"}]},{"ID":"20240902105158-dczuvvl","Type":"NodeParagraph","Properties":{"id":"20240902105158-dczuvvl","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"6.《随息居饮食谱》：调中活血，舒郁结，辟秽，和肝。酿酒可消乳癖。"}]},{"ID":"20240902105158-2z6k7l9","Type":"NodeParagraph","Properties":{"id":"20240902105158-2z6k7l9","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"7.《现代实用中药》：用于妇人月经过多，赤白带下及一般肠炎下痢等。"}]},{"ID":"20240902105158-xaqb3y6","Type":"NodeParagraph","Properties":{"id":"20240902105158-xaqb3y6","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"8.《山东中药》：治肝胃气痛，恶心呕吐，消化不良，泄泻，口舌糜破，吐血，噤口痢。"}]},{"ID":"20240902105158-x7aetad","Type":"NodeParagraph","Properties":{"id":"20240902105158-x7aetad","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"9.《泉州本草》：治肺病咳嗽痰血、吐血、咯血。"}]},{"ID":"20240902105158-ax2h8qw","Type":"NodeParagraph","Properties":{"id":"20240902105158-ax2h8qw","updated":"20240902105224"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902105200-maeem0w","Type":"NodeThematicBreak","Properties":{"id":"20240902105200-maeem0w","updated":"20240902105224"}},{"ID":"20240902105201-medggkj","Type":"NodeParagraph","Properties":{"id":"20240902105201-medggkj","updated":"20240902105224"}}]}