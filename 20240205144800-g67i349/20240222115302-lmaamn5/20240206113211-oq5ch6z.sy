kDest","Data":"assets/洋金花 20-20240716112211-m5hgmsh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 459px;\" parent-style=\"width: 469px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716114125-gbk2hm9","Type":"NodeParagraph","Properties":{"id":"20240716114125-gbk2hm9","updated":"20240716114411"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 533px;","style":"width: 523px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"洋金花 (28)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/洋金花 28-20240716114402-smp9uli.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 523px;\" parent-style=\"width: 533px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 481px;","style":"width: 471px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"洋金花 (27)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/洋金花 27-20240716114326-q33zr0n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 471px;\" parent-style=\"width: 481px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716112404-bmmmwbu","Type":"NodeParagraph","Properties":{"id":"20240716112404-bmmmwbu","updated":"20240716112745"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 558px;","style":"width: 548px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"洋金花 (21)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/洋金花 21-20240716112502-0tlky0o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 548px;\" parent-style=\"width: 558px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 529px;","style":"width: 519px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"洋金花 (22)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/洋金花 22-20240716112745-7ob4r6j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 519px;\" parent-style=\"width: 529px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716115205-fe6in68","Type":"NodeParagraph","Properties":{"id":"20240716115205-fe6in68","updated":"20240716115205"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"洋金花 (31)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/洋金花 31-20240716115205-yor1wcw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240716105427-i6yy8dd","Type":"NodeParagraph","Properties":{"id":"20240716105427-i6yy8dd","updated":"20240716114254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：曼陀罗全株有剧毒，药用的它的花，曼陀罗种子比花更毒，在我国一共有三个品种，白花曼陀罗，紫花曼陀罗，大花曼陀罗；而白花曼陀罗则是曼陀罗的本尊；花多在树叉中间向上生长，果实表面长满尖刺；"}]},{"ID":"20240716110609-b0jjkqg","Type":"NodeParagraph","Properties":{"id":"20240716110609-b0jjkqg","updated":"20240716112945"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：曼陀罗开花前呈逆时针或顺时针五角形，开花后呈喇叭状；（据说清晨开花，上午时就闭合）"}]},{"ID":"20240716113522-o7adz8j","Type":"NodeParagraph","Properties":{"id":"20240716113522-o7adz8j","updated":"20240716113556"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：毛曼陀罗除了全身披绒毛外，最大的特点是果实外面的刺是柔软的；"}]},{"ID":"20240716105427-r7wim88","Type":"NodeThematicBreak","Properties":{"id":"20240716105427-r7wim88","updated":"20240716113532"}},{"ID":"20240902100830-uqoi0nb","Type":"NodeParagraph","Properties":{"id":"20240902100830-uqoi0nb","updated":"20240902100841"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：洋金花"}]},{"ID":"20240902100830-jc3gyt7","Type":"NodeParagraph","Properties":{"id":"20240902100830-jc3gyt7","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"洋金花《中国药典》"}]},{"ID":"20240902100830-l6ffpqa","Type":"NodeParagraph","Properties":{"id":"20240902100830-l6ffpqa","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánɡJīnHuā"}]},{"ID":"20240902100830-8r1pend","Type":"NodeParagraph","Properties":{"id":"20240902100830-8r1pend","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSDATURAE"}]},{"ID":"20240902100830-tc58u78","Type":"NodeParagraph","Properties":{"id":"20240902100830-tc58u78","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【别名】曼陀罗、羊惊花、山茄花、风茄花、枫茄花、醉仙桃、大麻子花、广东闹羊花、大喇叭花、金盘托荔枝、假荔枝"}]},{"ID":"20240902100830-7d7x0z3","Type":"NodeParagraph","Properties":{"id":"20240902100830-7d7x0z3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【来源】本品为茄科植物白曼陀罗DaturametelL.的干燥花。4～11月花初开时采收，晒干或低温干燥。"}]},{"ID":"20240902100830-2dn496b","Type":"NodeParagraph","Properties":{"id":"20240902100830-2dn496b","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性状】本品多皱缩成条状，完整者长9～15cm。花萼呈筒状，长为花冠的2/5,灰绿色或灰黄色，先端5裂，基部具纵脉纹5条，表面微有茸毛；花冠呈喇叭状，淡黄色或黄棕色，先端5浅裂，裂片有短尖，短尖下有明显的纵脉纹3条，两裂片之间微凹；雄蕊5,花丝贴生于花冠筒内，长为花冠的3/4；雌蕊1，柱头棒状。烘干品质柔韧，气特异；晒干品质脆，气微，味微苦。"}]},{"ID":"20240902100830-fjgr41d","Type":"NodeParagraph","Properties":{"id":"20240902100830-fjgr41d","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902100830-fge2y5o","Type":"NodeParagraph","Properties":{"id":"20240902100830-fge2y5o","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末淡黄色。花粉粒类球形或长圆形，直径42～65μm,表面有条纹状雕纹。花萼非腺毛1～3细胞，壁具疣状突起，腺毛头部1～5细胞，柄1～5细胞。花冠裂片边缘非腺毛1～10细胞，壁微具疣状突起。花丝基部非腺毛粗大，1～5细胞，基部直径约至128μm，顶端钝圆。花萼、花冠薄壁细胞中有草酸钙砂晶、方晶及簇晶。"}]},{"ID":"20240902100830-vdhl9b6","Type":"NodeParagraph","Properties":{"id":"20240902100830-vdhl9b6","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加浓氨试液1ml，混匀，再加氯仿25ml，摇匀，放置过夜，滤过，滤液蒸干，残渣加氯仿1ml使溶解，作为供试品溶液。另取硫酸阿托品与氢溴酸东莨菪碱对照品，加甲醇制成每1ml各含4mg的混合溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl，分别点于同一硅胶Ｇ薄层板上，以醋酸乙酯－甲醇－浓氨试液（17:2:1）为展开剂，展开，取出，晾干，喷以稀碘化铋钾试液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902100830-kdnfofl","Type":"NodeParagraph","Properties":{"id":"20240902100830-kdnfofl","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温；有毒。"}]},{"ID":"20240902100830-s3ri5t5","Type":"NodeParagraph","Properties":{"id":"20240902100830-s3ri5t5","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、肝经。"}]},{"ID":"20240902100830-62412ht","Type":"NodeParagraph","Properties":{"id":"20240902100830-62412ht","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【功能主治】平喘止咳，镇痛，解痉。用于哮喘咳嗽，脘腹冷痛，风湿痹痛，小儿慢惊；外科麻醉。"}]},{"ID":"20240902100830-v0bxah2","Type":"NodeParagraph","Properties":{"id":"20240902100830-v0bxah2","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.3～0.6g，宜入丸散，亦可作卷烟分次燃吸（一日量不超过1.5g）。外用适量。"}]},{"ID":"20240902100830-c2jbitx","Type":"NodeParagraph","Properties":{"id":"20240902100830-c2jbitx","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【注意】外感及痰热咳喘、青光眼、高血压及心动过速患者禁用。"}]},{"ID":"20240902100830-ykeji63","Type":"NodeParagraph","Properties":{"id":"20240902100830-ykeji63","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处，防霉，防蛀。"}]},{"ID":"20240902100830-i5zshjh","Type":"NodeParagraph","Properties":{"id":"20240902100830-i5zshjh","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【备注】（1）中毒可出现口干，皮肤干燥，瞳孔散大，脉快，颜面潮红，甚则使血压下降而致死。解救可服吐剂，洗胃并服鞣酸制剂，后给以盐类泻剂，强心剂，镇静剂。亦有用绿豆皮4两，金银花2两，连翘1两，甘草5钱。水1000毫升，煎至200毫升，1次服，每2小时服1次。"}]},{"ID":"20240902100830-c4u28ab","Type":"NodeParagraph","Properties":{"id":"20240902100830-c4u28ab","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902100830-ll9vj08","Type":"NodeParagraph","Properties":{"id":"20240902100830-ll9vj08","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"洋金花《*辞典》"}]},{"ID":"20240902100830-pdmyyot","Type":"NodeParagraph","Properties":{"id":"20240902100830-pdmyyot","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【出处】《药物图考》"}]},{"ID":"20240902100830-6xz3jpk","Type":"NodeParagraph","Properties":{"id":"20240902100830-6xz3jpk","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánɡJīnHuā"}]},{"ID":"20240902100830-il18fn3","Type":"NodeParagraph","Properties":{"id":"20240902100830-il18fn3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【别名】山茄花（《扁鹊心书》），曼陀罗花（《御药院方》），押不芦（《癸辛杂识》），胡茄花（《本草原始》），大闹杨花、马兰花（《生草药性备要》），风茄花（《本草求原》），洋大麻子花、关东大麻子花、虎茄花（《山东中药》），风麻花、酒醉花（《陕西中药志》）。"}]},{"ID":"20240902100830-m3cgxqz","Type":"NodeParagraph","Properties":{"id":"20240902100830-m3cgxqz","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【来源】为茄科植物白曼陀罗或毛曼陀罗的干燥花。8～11月间，将初开放的花朵采下，晒干、阴干或微火烘干。亦可捆把后再晒干。"}]},{"ID":"20240902100830-l0mkwtc","Type":"NodeParagraph","Properties":{"id":"20240902100830-l0mkwtc","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902100830-wuyifb9","Type":"NodeParagraph","Properties":{"id":"20240902100830-wuyifb9","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①白曼陀罗，又名：风茄儿、山茄子（《纲目》），大颠茄（《生草药性备要》），颠茄、闷陀罗（《广西通志》），野蓖麻、猪颠茄、猪波罗、老鼠愁、白花曼陀罗、金盘托荔枝。"}]},{"ID":"20240902100830-gqszfvj","Type":"NodeParagraph","Properties":{"id":"20240902100830-gqszfvj","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"一年生草本，全体近于无毛.茎直立，圆柱形，高25～60厘米，基部木质化，上部呈叉状分枝.叶互生，上部的叶近于对生；叶柄长2～6厘米，表面被疏短毛；叶片卵形、长卵形或心脏形，长8～14厘米，宽6～9厘米，先端渐尖或锐尖，基部不对称，圆形或近于阔楔形，全缘或具三角状短齿，两面无毛，或被疏短毛；叶脉背面隆起。花单生于叶腋或上部分枝间；花梗短，直立或斜伸，被白色短柔毛；萼筒状，长4～6厘米，淡黄绿色，先端5裂，裂片三角形，先端尖，花后萼管自近基部处周裂而脱落，遗留的萼管基部宿存，果时增大呈盘状，边缘不反折；花冠漏斗状，长12～16厘米，顶端直径5～7厘米，向下直径渐小，白色，具5棱，裂片5，三角状，先端长尖；雄蕊5，不伸出花冠管外，花药线形、扁平，基部着生；雌蕊1，子房球形，疏生细短刺，2室，胚珠多数，花柱丝状，柱头盾形。蒴果圆球形，表面有疏短刺，成熟后由绿变为淡褐色。种子多数，略呈三角状。花期3～11月。果期4～11月。"}]},{"ID":"20240902100830-n4piavq","Type":"NodeParagraph","Properties":{"id":"20240902100830-n4piavq","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"生长于山坡草地或住宅附近。分布江苏、浙江、福建、广东、广西、湖北，四川等地；上海、南京一带有栽培。"}]},{"ID":"20240902100830-s1xm1f2","Type":"NodeParagraph","Properties":{"id":"20240902100830-s1xm1f2","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②毛曼陀罗，又名：软刺曼陀罗、毛花曼陀罗。"}]},{"ID":"20240902100830-5rb0qha","Type":"NodeParagraph","Properties":{"id":"20240902100830-5rb0qha","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"一年生草本。形与上种相似，但全体密被白色短柔毛；叶互生或近于对生，叶片广卵形，长8～20厘米，宽5～12厘米，全缘或微呈波状。花白色或淡蓝色，萼管基部宿存，边缘向外反折。蒴果近圆形，密生柔软针刺。花期5～9月。果期6～10月。"}]},{"ID":"20240902100830-ihicbkk","Type":"NodeParagraph","Properties":{"id":"20240902100830-ihicbkk","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"分布辽宁、河北、江苏、浙江等地；北京、南京、上海等城市均有栽培。"}]},{"ID":"20240902100830-utee7in","Type":"NodeParagraph","Properties":{"id":"20240902100830-utee7in","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"以上两种植物的根（曼陀罗根）、叶（曼陀罗叶）、果实（曼陀罗子）亦供药用，各详专条。"}]},{"ID":"20240902100830-8u1yyqi","Type":"NodeParagraph","Properties":{"id":"20240902100830-8u1yyqi","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902100830-gj6wu52","Type":"NodeParagraph","Properties":{"id":"20240902100830-gj6wu52","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①南洋金花：为白曼陀罗的干燥花朵。多为数十朵捆成一把。花萼一般已除去。花冠漏斗状，长10～15厘米，黄棕色至淡棕色，皱褶，筒状部具纵皱纹，上部5裂，多已破碎，完整者裂片尖端呈丝状，两者之间呈凹陷，雄蕊5，多包于花冠筒内。雌蕊1。花纸质，易碎。气微，味苦而涩。以去萼、朵大、质厚、整齐、黄棕色、有香气者为佳。"}]},{"ID":"20240902100830-56ehfyb","Type":"NodeParagraph","Properties":{"id":"20240902100830-56ehfyb","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"主产江苏、福建、广东等地。"}]},{"ID":"20240902100830-mzndwry","Type":"NodeParagraph","Properties":{"id":"20240902100830-mzndwry","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②北洋金花：为毛曼陀罗的干燥花朵。多分散，或捆成小把。花形状与南洋金花类似而较短，但带有黄绿色至灰绿色的萼筒，萼筒上有5个棱角，长3～5厘米，灰绿色，外被灰白色柔毛。气味同南洋金花。以朵大、黄棕色、完整、无杂质者为佳。"}]},{"ID":"20240902100830-8tqr4dh","Type":"NodeParagraph","Properties":{"id":"20240902100830-8tqr4dh","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"主产河北、山东、河南等地。"}]},{"ID":"20240902100830-rbagbt0","Type":"NodeParagraph","Properties":{"id":"20240902100830-rbagbt0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"除上述两种外，尚有几种同属植物的干燥花，亦同等入药：①欧曼陀罗，茎淡绿色。花白色。蒴果卵球形，先端具较长的坚硬针刺，成熟时规则的4瓣裂（分布长江流域各省）。"}]},{"ID":"20240902100830-cdcte4r","Type":"NodeParagraph","Properties":{"id":"20240902100830-cdcte4r","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②紫花曼陀罗，茎淡紫红色。花淡紫色；花萼上部亦略具淡紫点。蒴果卵球形，具近于等长的坚硬针刺；成熟时规则的4瓣裂（分布长江流域各省）。"}]},{"ID":"20240902100830-r6vg7v7","Type":"NodeParagraph","Properties":{"id":"20240902100830-r6vg7v7","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③无刺曼陀罗，花白色，蒴果平滑无刺。"}]},{"ID":"20240902100830-wspe7xn","Type":"NodeParagraph","Properties":{"id":"20240902100830-wspe7xn","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"④重瓣曼陀罗，花冠2～3层，外面紫色，内白色。"}]},{"ID":"20240902100830-u3732be","Type":"NodeParagraph","Properties":{"id":"20240902100830-u3732be","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902100830-q7679mn","Type":"NodeParagraph","Properties":{"id":"20240902100830-q7679mn","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"白曼陀罗植物（其他曼陀罗属植物也一样）各部分都含生物碱，但以花中含率为最高，达0.43％。生物碱中以天仙子碱为主，天仙子胺次之（叶中生物碱含率的主次恰与花中的相反）。"}]},{"ID":"20240902100830-cgwa1m0","Type":"NodeParagraph","Properties":{"id":"20240902100830-cgwa1m0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"毛曼陀罗花头含总生物碱约0.3～0.4％，主要为天仙子胺及天仙子碱。"}]},{"ID":"20240902100830-px3i9ad","Type":"NodeParagraph","Properties":{"id":"20240902100830-px3i9ad","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902100830-58ioq06","Type":"NodeParagraph","Properties":{"id":"20240902100830-58ioq06","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①中枢作用"}]},{"ID":"20240902100830-gp8keyg","Type":"NodeParagraph","Properties":{"id":"20240902100830-gp8keyg","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"白曼陀罗花的主要有效成分为东莨菪碱，有显着的镇静作用（阿托品则兴奋大脑）。一般剂量可使人感觉疲倦、进入无梦之睡眠；它还能解除情绪激动，产生\"健忘\"。个别病人可产生不安、激动、幻觉乃至谵妄等阿托品样兴奋症状。过去仅知其可作麻醉前给药，现与冬眠药物合用（在某些情况下，可不用或少用冬眠药物），产生强大的协同作用，广泛应用于\"中药麻醉\"。电生理方法证明，东茛菪碱对大脑皮层及中脑网状结构上行激活系统有抑制作用；临床实践证明，毒扁豆碱（静脉注射，可用至4毫克）有良好的催醒作用，说明其麻醉作用可能与中枢性递质有关。东莨菪碱对呼吸中枢的兴奋作用、抗晕作用与治疗帕金森氏病的作用，都比阿托品强。"}]},{"ID":"20240902100830-mv0jh6m","Type":"NodeParagraph","Properties":{"id":"20240902100830-mv0jh6m","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②周围作用"}]},{"ID":"20240902100830-0ofy7v5","Type":"NodeParagraph","Properties":{"id":"20240902100830-0ofy7v5","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"东莨菪碱能阻断毒草碱型乙酰胆碱受体，因此作用性质上与阿托品相同，仅在作用强度上略有差异。其散瞳、麻痹眼调节及抑制腺体分泌的作用，较阿托品约强1倍，对心脏迷走神经的作用则较弱，中药麻醉过程中，心率显著加快，可事先给心得安以克服之。由于它的抗胆碱作用，洋金花总碱注射液在解救有机磷农药中毒有良好效果。它与阿托品同样有解除血管痉挛的作用，因此能改善微循环及组织器官的血液灌注，而有抗休克的功效。"}]},{"ID":"20240902100830-pw6kspm","Type":"NodeParagraph","Properties":{"id":"20240902100830-pw6kspm","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③体内过程与毒性"}]},{"ID":"20240902100830-d24fnht","Type":"NodeParagraph","Properties":{"id":"20240902100830-d24fnht","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"洋金花总碱口服，较易吸收，分布于全身，可通过胎盘至胎儿循环。用犬和小鼠实验表明，洋金花对生殖功能及胎儿均无影响；大部分在肝中被酶水解，东莨菪碱仅1％以原形从肾排出。犬静脉注射洋金花总碱后，可发生强烈惊厥或角弓反张，终于呼吸衰竭而死亡。用总碱对犬作静脉麻醉（2毫克/公斤），3天后处死，未见内脏有明显形态学改变。犬静脉注射最小致死量为80毫克/公斤，麻醉的最小有效量为2毫克/公斤，安全范围较大。"}]},{"ID":"20240902100830-f0df64w","Type":"NodeParagraph","Properties":{"id":"20240902100830-f0df64w","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【毒性】关于曼陀罗中毒的报道并不少见，据64例的介绍，曼陀罗的花、叶、果实、种子均能使人中毒，中毒的发生一般以深秋（9、10月份）为多，此时的中毒以果实（种子）为主，春季中毒患者往往误将曼陀罗叶与野菜一同煮食而中毒。误食的中毒量，种子为2～30粒，果实为1/4～10枚（一般中毒量约为3枚，有服5枚致死者，但亦有服12枚而得救者），干花为1～30克，用叶而致中毒的病例仅见于外敷。中毒后开始发病的时间，间隔短者仅10分钟，最长可至3小时，一般约为半小时至1小时。主要临床表现为，颜面及皮肤潮红，躁动不安，脉率增快，步态不稳，头晕，幻觉，幻听，口干，口渴，口发麻，呕吐，言语不灵，瞳孔放大，对光反射消失，甚至高烧，昏迷，大小便失禁，阵发性抽搐等。实验室检查，白细胞总数均正常，或轻度增加，其中中性白细胞比率多在65％以上。诊断曼陀罗中毒，除详询病史，细心体检并参考各种临床表现外，还可用猫眼散瞳试验（用患者小便1滴，滴入猫眼，如系曼陀罗中毒，瞳孔可立即散大）来配合诊断。中毒的急救，与阿托品或东莨菪碱中毒相同；民间单方有用防风2钱、桂枝2钱煎服；生甘草4两煎服；生甘草、生绿豆各1～2两捣烂开水泡服或煎服；茶叶1两煎浓汁调豆腐半斤1次服下等法。也有用冷敷与冷浴法治疗儿童曼陀罗中毒者，法用冷湿布置患者额部及胸部，时时更换，至清醒为度。中毒现象较严重者，则用冷水浴法，把中毒的儿童放在浴盆内以冷水淋洗，淋至皮肤潮红全部退尽，可望逐渐清醒。"}]},{"ID":"20240902100830-z4is773","Type":"NodeParagraph","Properties":{"id":"20240902100830-z4is773","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902100830-grdss6k","Type":"NodeParagraph","Properties":{"id":"20240902100830-grdss6k","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"辛，温，有毒。"}]},{"ID":"20240902100830-uscw7dt","Type":"NodeParagraph","Properties":{"id":"20240902100830-uscw7dt","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"辛，温，有毒。\""}]},{"ID":"20240902100830-1q11ize","Type":"NodeParagraph","Properties":{"id":"20240902100830-1q11ize","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②《生草药性备要》：\"味甘，性温，有毒。\""}]},{"ID":"20240902100830-4whptd8","Type":"NodeParagraph","Properties":{"id":"20240902100830-4whptd8","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③《本草便读》：\"辛，温，大毒。\""}]},{"ID":"20240902100830-7yx1jsu","Type":"NodeParagraph","Properties":{"id":"20240902100830-7yx1jsu","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【归经】《本草便读》：\"入肺。\""}]},{"ID":"20240902100830-ni3tphz","Type":"NodeParagraph","Properties":{"id":"20240902100830-ni3tphz","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902100830-s8fxomy","Type":"NodeParagraph","Properties":{"id":"20240902100830-s8fxomy","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"定喘，祛风，麻醉止痛。治哮喘，惊痫，风湿痹痛，脚气，疮疡疼痛。并作外科手术麻醉剂。"}]},{"ID":"20240902100830-10v6a20","Type":"NodeParagraph","Properties":{"id":"20240902100830-10v6a20","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"诸风及寒湿脚气，煎汤洗之。又主惊痫及脱肛，并入麻药。\""}]},{"ID":"20240902100830-4yapnv0","Type":"NodeParagraph","Properties":{"id":"20240902100830-4yapnv0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②《生草药性备要》：\"少服止痛，通关利窍，去头风。\""}]},{"ID":"20240902100830-nacqqy9","Type":"NodeParagraph","Properties":{"id":"20240902100830-nacqqy9","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③《本草便读》：\"止疮疡疼痛，宣痹着寒哮。\""}]},{"ID":"20240902100830-9eityk3","Type":"NodeParagraph","Properties":{"id":"20240902100830-9eityk3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"④《陆川本草》：\"治咳嗽，跌打疼痛。\""}]},{"ID":"20240902100830-i9cafvg","Type":"NodeParagraph","Properties":{"id":"20240902100830-i9cafvg","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤（或泡水），1～1.5分；入散剂，3～5厘；煎酒或作卷烟吸。外用：煎水洗或研末调敷。"}]},{"ID":"20240902100830-eb10it1","Type":"NodeParagraph","Properties":{"id":"20240902100830-eb10it1","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【注意】内服宜慎。体弱者禁用。"}]},{"ID":"20240902100830-k7h0y5g","Type":"NodeParagraph","Properties":{"id":"20240902100830-k7h0y5g","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902100830-mdr3k30","Type":"NodeParagraph","Properties":{"id":"20240902100830-mdr3k30","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①治哮喘：曼陀罗花两五，火硝一钱，川贝一两，法夏八钱，泽兰六钱，冬花五钱。上共研细末，用老姜一斤，捣烂取汁，将药末合匀，以有盖茶盅-只盛贮封固，隔水蒸一小时久，取出，以熟烟丝十两和匀，放通风处，吹至七、八成干（不可过于干燥，恐其易碎）时，贮于香烟罐中备用。每日以旱烟筒或水烟袋，如寻常吸烟法吸之。（《外科十三方考》立止哮喘烟）"}]},{"ID":"20240902100830-jjb2kl9","Type":"NodeParagraph","Properties":{"id":"20240902100830-jjb2kl9","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②治小儿慢惊：曼陀罗花七朵（重一字），天麻二钱半，全蝎（炒）十枚，天南星（炮），丹砂、乳香各二钱半。为末。每服半钱，薄荷汤调下。（《御药院方》）"}]},{"ID":"20240902100830-i2el15m","Type":"NodeParagraph","Properties":{"id":"20240902100830-i2el15m","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③治阳厥气逆多怒而狂：朱砂（水飞）半两，曼陀罗花二钱半。上为细末。每服二钱，温酒调下，若醉便卧，勿令惊觉。（《证治准绳》祛风一醉散）"}]},{"ID":"20240902100830-sly8dfq","Type":"NodeParagraph","Properties":{"id":"20240902100830-sly8dfq","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"④治（病）人难忍艾火灸痛，服此即昏睡不痛，亦不伤人：山茄花（八月收）、火麻花（八月收\"一说七月收\"）。阴干，共研末。每服三钱，小儿只一钱，茶酒任下。一服后即昏睡，可灸五十壮，醒后再服再灸。（《扁鹊心书》睡圣散）"}]},{"ID":"20240902100830-8fe9aqj","Type":"NodeParagraph","Properties":{"id":"20240902100830-8fe9aqj","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"⑤治诸风痛及寒湿脚气：曼陀罗花，茄梗、大蒜梗、花椒叶。煎水洗。（《四川中药志》）"}]},{"ID":"20240902100830-pi04muj","Type":"NodeParagraph","Properties":{"id":"20240902100830-pi04muj","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"⑥治面上生疮：曼陀罗花，晒干研末，少许贴之。（《卫生易简方》）"}]},{"ID":"20240902100830-00twdzp","Type":"NodeParagraph","Properties":{"id":"20240902100830-00twdzp","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902100830-cc2fsbh","Type":"NodeParagraph","Properties":{"id":"20240902100830-cc2fsbh","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"①用于麻醉"}]},{"ID":"20240902100830-7jfw923","Type":"NodeParagraph","Properties":{"id":"20240902100830-7jfw923","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"相传我国名医华佗早在公元200余年，就曾应用\"麻沸散\"作为麻醉剂为病人施行刮骨、剖腹手术。近年来，继针刺麻醉之后，又进一步采用了以洋金花为主的中药麻醉，获得初步成功。基本处方为：洋金花，生草乌、川芎、当归。给药途径：目前计采用口服、灌肠、肌肉注射、静脉点滴、穴位注射（耳穴、鼻穴）及耳根非穴位麻醉等6个途径给药，麻醉效果相似。据临床应用425人次的介绍，其中有高年老人及乳婴；有肝硬变、高血压病患者、休克病人、恶液质患者等，共施行大小手术81种，手术时间最长者达9小时以上，洋金花生药用量。1次高达20克，术后一般恢复良好。上述病例采用中麻手术无1例失败，麻醉效果满意者（指麻醉平稳，病人安静，能顺利完成手术，或手术刺激反应较明显，但不需改用其他麻醉，仍能完成手术操作者）占90％左右。"}]},{"ID":"20240902100830-4s0foy2","Type":"NodeParagraph","Properties":{"id":"20240902100830-4s0foy2","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"禁忌症：㈠青光眼或有眼压增高者；㈡心动过速或有心动过速病史者以及心肺功能明显代偿不全者；㈢高热病人；㈣严重高血压患者；㈤肝肾功能严重损害者。"}]},{"ID":"20240902100830-dx4r05b","Type":"NodeParagraph","Properties":{"id":"20240902100830-dx4r05b","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"存在问题：㈠麻醉深度不够：临床观察及脑电图表明，过去大部分中药麻醉病人的麻醉深度，相当于乙醚麻醉的Ⅲ期一级。因此，对上腹部手术，部分病人肌肉松弛不够满意，内脏牵拉反应明显，使手术操作有一定困难，如在术前或术中配合使用八角枫、锡生藤及汉防己等，或封闭两侧足三里穴等方法，可有助于腹肌松弛。㈡苏醒时间长：采用口服或灌汤法，苏醒时间多在10～12小时；注射给药，苏醒时间约为6～8小时。有报告在手术将结束时，肌肉注射槟榔注射液1～2毫升，同时静脉注射美解眠40毫升，能使苏醒提前3小时左右。对采取口服给药的病例，亦可在手术结束前从胃管抽去剩余药液，并注入甘草绿豆汤，亦能提早清醒。㈢窦性心动过速：可用1％普鲁卡因静滴代替冬眠药物，既能提早苏醒时间，又能控制心率。"}]},{"ID":"20240902100830-pd1qc45","Type":"NodeParagraph","Properties":{"id":"20240902100830-pd1qc45","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240902100830-s5jbs8n","Type":"NodeParagraph","Properties":{"id":"20240902100830-s5jbs8n","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"用洋金花注射液每5天肌注1次，一般注射4～5次，每次注射液中含东莨菪碱0.5～1.0毫克，根据病人年龄、性别、体质强弱等具体情况，用量略有不同。一般于注射后10～15分钟出现反应迟钝；15～20分钟进入浅睡，40～60分钟进入深睡；3～4小时后苏醒，醒后呼吸通顺，略有倦意。共治疗慢性气管炎1200例，临床控制率为70％，显效率为17％，用药后作心、肝、肾功能测定，未见有损害。此外，有用曼陀罗组成复方气管炎片、气管炎注射液作穴位（肺俞、定喘穴）交叉注射，10次为一疗程，验证640例，其中临床近控率36％，显效率23％或用曼陀罗叶100克（鲜叶用600克），甘草50克，制成25％曼陀罗合剂内服，每次4～5毫升，10天一疗程，共治44例，均取得较好疗效。"}]},{"ID":"20240902100830-er53jul","Type":"NodeParagraph","Properties":{"id":"20240902100830-er53jul","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"③治疗精神分裂症"}]},{"ID":"20240902100830-t55ik7u","Type":"NodeParagraph","Properties":{"id":"20240902100830-t55ik7u","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"将曼陀罗花用白酒浸成10％酊剂，或制成20％煎剂。每日早餐后服1次，连服6天，停服1天。用量由10毫升开始，根据反应程度，逐渐增加至40～80毫升，以用药后1小时左右出现迷睡，并维持2～3小时为适宜。服药后有胃部不适及食欲减退的副作用，可在每次服药当天上下午给胃蛋白酶或稀盐酸，并采用0.5％毛果芸香碱眼膏以减轻瞳孔散大及视力模糊。接受此种治疗后，患者的临床表现一般可分三个阶段：第一阶段，服药15分钟左右开始出现轻度不安，口干。瞳孔散大，视物不清。并可出现幻视，意识蒙胧，定向障碍，步态不稳。部分患者有尿意频繁，少数有躁动恐怖情绪。这一阶段约持续1/2～2小时。第二阶段，主要为迷睡状态，可出现肌张力增强或减退，口涎增加，呼吸深缓，这一阶段约2～10小时不等。第三阶段为醒转期，醒后自感头脑清醒，除胸闷、不思饮食、口干外，前述的临床表现均消失。根据对62例精神分裂症患者的观察，单独使用曼陀罗的疗效似不高，但对精神运动性兴奋有良好的宁静作用。"}]},{"ID":"20240902100830-goicq7i","Type":"NodeParagraph","Properties":{"id":"20240902100830-goicq7i","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902100830-2vkgfs4","Type":"NodeParagraph","Properties":{"id":"20240902100830-2vkgfs4","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"洋金花《中华本草》"}]},{"ID":"20240902100830-mw7fhxd","Type":"NodeParagraph","Properties":{"id":"20240902100830-mw7fhxd","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902100830-7vjv7rc","Type":"NodeParagraph","Properties":{"id":"20240902100830-7vjv7rc","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"出自《药物图考》。"}]},{"ID":"20240902100830-d5sq5tb","Type":"NodeParagraph","Properties":{"id":"20240902100830-d5sq5tb","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：曼陀罗，生北土，人家亦栽之。春生夏长，独茎直上，高四、五尺，生不旁引，绿茎碧叶，叶如茄叶，八月开白花，凡六瓣，状如牵牛花而大，攒花中折，骈叶外包，而朝开夜合，结实圆而有丁拐，中有小子。八月采花，九月采实。八月采此花，七月采火麻子花，阴干，等分为末，热酒调服三钱，少顷昏昏如醉。割疮灸火，宜先服此，则不觉其苦也。按周密《癸辛杂识》云：汉北回回地方，有草名押不芦，"}]},{"ID":"20240902100830-5e4bjw1","Type":"NodeParagraph","Properties":{"id":"20240902100830-5e4bjw1","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánɡJīnHuā"}]},{"ID":"20240902100830-3kdduy4","Type":"NodeParagraph","Properties":{"id":"20240902100830-3kdduy4","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【英文名】HinduDaturaFlowerHairyDaturaFlower,DaturaFlower"}]},{"ID":"20240902100830-n9tz18q","Type":"NodeParagraph","Properties":{"id":"20240902100830-n9tz18q","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【别名】曼罗花、蔓陀罗花、千叶蔓陀罗花、层台蔓陀罗花、山茄花、押不芦、胡茄花、大闹杨花、马兰花、风茄花、佛花、天茄弥陀花、洋大麻子花、关东大麻子花、虎茄花、风麻花、酒醉花、羊惊花、枫茄花、广东闹羊花、大嗽叭花"}]},{"ID":"20240902100830-klsv7ie","Type":"NodeParagraph","Properties":{"id":"20240902100830-klsv7ie","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902100830-qz2la6l","Type":"NodeParagraph","Properties":{"id":"20240902100830-qz2la6l","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"药材基源：为茄科植物白曼陀罗、毛曼陀罗的花。"}]},{"ID":"20240902100830-cpd6r33","Type":"NodeParagraph","Properties":{"id":"20240902100830-cpd6r33","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.DaturametelL.2.DaturainnoxiaMill."}]},{"ID":"20240902100830-rvilg6w","Type":"NodeParagraph","Properties":{"id":"20240902100830-rvilg6w","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在7月下旬至8月下旬盛花期，于下午4-5时采摘、晒雨可用50-60℃烘4-6h即干。"}]},{"ID":"20240902100830-fk0ejlo","Type":"NodeParagraph","Properties":{"id":"20240902100830-fk0ejlo","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902100830-rdrxcjv","Type":"NodeParagraph","Properties":{"id":"20240902100830-rdrxcjv","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"一年草本，高30-100cm。全株近无毛。茎直立，圆柱形，基部木质化，上部呈叉状分枝，绿色，表面有不规则皱纹，幼枝四棱形，略带紫色，被短柔毛。叶互生，上部叶近对生；叶柄长2-5cm；叶片宽卵形、长卵形或心脏形，长5-20cm，宽4-15cm，先端渐尖或锐尖，基部不对称，边缘具不规则短齿、或全缘而波状，两面无毛或被疏短毛，叶背面脉隆起。花单生于枝叉间或叶腋；花梗长约1cm，直立或斜伸，被白色短柔毛；花萼筒状，长4-6cm，直径1-1.5cm，淡黄绿色，先端5裂，裂片三角形，整齐或不整齐，先端尖，花后萼管自近基部处周裂而脱落，遗留的萼筒基部则宿存，果时增大呈盘状，直径2.5-3cm，边缘不反折；花冠管漏斗状，长14-20cm，檐部直径5-7cm，下部直径渐小，向上扩呈嗽叭，白色，具5棱，裂片5，裂片5，三角形，先端长尖；雄蕊5，生于花冠管内，花药线形，扁平，基部着生；雌蕊1，子房珠形，2室，疏生短刺毛，胚珠多数，花柱丝状，长11-16cm，柱头盾形。蒴果圆球形或扁球状，直径约3cm，外被疏短刺，熟时淡褐色，不规则4瓣裂。种子多数，扁平，略呈三角形，熟时褐色。花期3-11月，果期4-11月。"}]},{"ID":"20240902100830-s61xxud","Type":"NodeParagraph","Properties":{"id":"20240902100830-s61xxud","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"一年生草本，高1-2m。有恶臭，全株被白色细腺毛及短柔毛。茎粗壮，直立，圆柱形，基部木质化，上部多呈叉状分枝，灰绿色。叶互生或近对生；叶片广卵形，长8-20cm，宽5-12cm，先端急尖，基部斜心形，全缘或呈微波状，背面叶脉隆起。花大，直立或斜升，长15-20cm，直径7-8cm，花冠白色或淡紫色，具5棱；花萼筒部有5棱角，先端5浅裂，花后自近基部断裂，宿存部分椭果实而增大并向外反折。蒴果生于下垂的果梗上，近圆形，密生柔韧针状刺并密被短柔毛，熟时先端不规则裂开。种子多数，肾形，淡褐色或黄褐色。花期5-9月，果期6-10月。"}]},{"ID":"20240902100830-v9jvm82","Type":"NodeParagraph","Properties":{"id":"20240902100830-v9jvm82","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902100830-6taiflr","Type":"NodeParagraph","Properties":{"id":"20240902100830-6taiflr","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡、草地或住宅附近。"}]},{"ID":"20240902100830-j9r66e9","Type":"NodeParagraph","Properties":{"id":"20240902100830-j9r66e9","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"原为栽培种、现村过路旁沙质地上也见有野生。"}]},{"ID":"20240902100830-y53wmhq","Type":"NodeParagraph","Properties":{"id":"20240902100830-y53wmhq","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏、浙江、福建、湖北、广东、广西、四川、贵州、云南、上海、南京等地有栽培。"}]},{"ID":"20240902100830-5xcyz02","Type":"NodeParagraph","Properties":{"id":"20240902100830-5xcyz02","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"分布于辽宁、河北、江苏、浙江、河南。"}]},{"ID":"20240902100830-zw6dmoe","Type":"NodeParagraph","Properties":{"id":"20240902100830-zw6dmoe","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902100830-2z1m8ks","Type":"NodeParagraph","Properties":{"id":"20240902100830-2z1m8ks","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖湿润气候，气温5℃左右种子开始发芽；气温低于2-3℃时，植株死亡。以向阳、土层疏松肥沃、排水良好的砂质壤土栽培为宜。忌连作。前作不宜选茄科植物。"}]},{"ID":"20240902100830-499apwb","Type":"NodeParagraph","Properties":{"id":"20240902100830-499apwb","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖，直播或育苗移栽法。直播法：在3月下旬至4月中旬进行，行株距43cm×33cm，每穴播种6-7颗，每1hm2用种量7.5kg。育苗移栽法：在套种、间种田中或前作还未成熟时，为子经济利用土地，可在3月播种育苗，5-6月上旬幼苗有4-6月片真叶时移栽。"}]},{"ID":"20240902100830-4gfhfw7","Type":"NodeParagraph","Properties":{"id":"20240902100830-4gfhfw7","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"田间管理苗高10-12cm时匀苗、补苗，每穴留壮苗1-2株，结合中耕除草、施人畜粪水1次。苗高33cm时，再中耕除草、追肥1次，并培土以防倒伏。追肥前期以氮肥为主，后期施氮肥配合磷钾肥，做到前轻后重，有利总生物碱含量增加。留种应选主干的第1个分枝所结的果实取出种子，用水洗净晒干。"}]},{"ID":"20240902100830-1egajj3","Type":"NodeParagraph","Properties":{"id":"20240902100830-1egajj3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有黑斑病，可清洁田园，烧毁残株，发病初喷50%退菌特1000倍液。虫害有烟青虫，可在幼虫初孵期或幼龄期用90%晶体敌百虫1000倍液喷杀。还桃蚜、二十八星瓢虫等为害。"}]},{"ID":"20240902100830-vozg4hc","Type":"NodeParagraph","Properties":{"id":"20240902100830-vozg4hc","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902100830-ov3gcte","Type":"NodeParagraph","Properties":{"id":"20240902100830-ov3gcte","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"性状鉴别1.南洋金花（白曼陀罗花）花萼已除去，花冠及附着的雄蕊皱缩成卷条状，长9-16cm，黄棕色。展平后，花冠上部呈吨位叭状，先端5浅裂，裂片先端短尖，短尖下有3条明显的纵脉纹，裂片间微凹陷；雄蕊5，花丝下部紧贴花冠筒，花药扁平，长1-1.5cm。质脆易碎，气微臭，味辛苦。"}]},{"ID":"20240902100830-00jlm80","Type":"NodeParagraph","Properties":{"id":"20240902100830-00jlm80","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.北洋金花（毛曼陀罗花）带有花萼。萼筒长4-9cm，顶端5裂，裂片长约1.5cm，表面密生毛茸。花冠长10-18cm，先端裂片三角形，裂片间有短尖。花药长约1cn。"}]},{"ID":"20240902100830-a21pf1a","Type":"NodeParagraph","Properties":{"id":"20240902100830-a21pf1a","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉粉末特征：（1）白曼陀罗花灰棕色①花粉粒类球形或扁球形，3孔沟不甚明显，表面自两有为放射的细条状纹饰。②腺毛2种，短腺毛头部2-6细胞，柄部1-2（-3）细胞；长原毛头部单细胞，柄部2-6细胞。③非腺毛1-5细胞，稀有10细细胞以上，壁具疣状突起，有的非遥毛中间细胞皱缩。④花冠表皮有气孔，不定式，副卫细胞3-8个。⑤草酸钙砂晶、方晶及簇晶、多存在于花冠及花冠基部薄壁细胞中。此外，有黄棕色条块、花粉囊内壁细胞及螺纹、环纹导管。"}]},{"ID":"20240902100830-it244w3","Type":"NodeParagraph","Properties":{"id":"20240902100830-it244w3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"（2）毛曼陀罗花非腺毛壁光滑或微具疣点；花粉粒外壁有条状雕纹，两极为网纹。"}]},{"ID":"20240902100830-49zys55","Type":"NodeParagraph","Properties":{"id":"20240902100830-49zys55","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902100830-b18h1pb","Type":"NodeParagraph","Properties":{"id":"20240902100830-b18h1pb","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.白曼陀罗花含莨菪烷型生物碱0.12%-0.82%，其中天仙子碱（hyoscine)就是工莨菪碱（scopola-mine)为0.11%-015%，天仙子胺（hyoscyamine)又名莨菪碱为0.01%-0.37%[1，2]。还含阿托品（atropine)[3]。"}]},{"ID":"20240902100830-2svy5ku","Type":"NodeParagraph","Properties":{"id":"20240902100830-2svy5ku","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.毛曼陀罗花含生物碱0.19%-0.53%，其中东莨菪碱为0.17%-0.53%，莨菪为0.01%-0.49%[1，2]。还含阿托品[3]，酪胺（tyramine)，阿相东莨菪碱（aposcopolamine)即是阿相天仙子碱（apohyoscine)[4]。"}]},{"ID":"20240902100830-rk70gu0","Type":"NodeParagraph","Properties":{"id":"20240902100830-rk70gu0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"同属植物曼聍罗的花含生物碱0.14%-0.33%，其中东莨菪为0.03%-0.09%，莨菪碱为0.08%-0.28%[1，5]，还含阿托品[3]。木本曼陀罗的花含较多的东莨菪碱，可多达0.4%，还含莨菪碱[1，5]及微量的阿托品[3]。"}]},{"ID":"20240902100830-u40zhti","Type":"NodeParagraph","Properties":{"id":"20240902100830-u40zhti","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902100830-ew31n54","Type":"NodeParagraph","Properties":{"id":"20240902100830-ew31n54","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.对中枢神经系统的作用：1．1.对行为的影响：兔侧脑室注射东莨菪碱6mg/kg，可出现闭眼、侧卧、翻正反射消失，约经40分钟恢复，但活动仍较少。东莨菪碱与冬眠合剂合用于人、猴、犬均可产生全身麻醉。东莨菪碱与戊巴比妥或眠尔通合用也可使小鼠活动明显减少，表现出与中枢抑制药的协同作用。小剂量东莨菪碱（0.1-0.2mg/kg）使小鼠自主活动增加。小鼠腹腔注射东莨菪碱4mg/kg，能增强中枢兴奋药（苯丙胺、脱氧麻黄碱、咖啡因等）所引起的活动增加，并能对抗利血平及氯丙嗪引起的活动减少，表现中枢兴奋作用。因此认为，东莨菪碱对中枢神经系统的作用是双向性的。"}]},{"ID":"20240902100830-dqg0668","Type":"NodeParagraph","Properties":{"id":"20240902100830-dqg0668","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.2．对脑电的影响：给埋藏电极的清醒猫腹腔注射氢溴酸东莨菪碱0.05-0.1mg/kg，5分钟后，脑电图由低幅快波转变为不规则的高幅慢波。但此时惊醒反应仍存在，动物表现安静。若剂量增至0.25-0.50mg/kg时，脑电活动出现高度同步化和不规则高幅慢波，而且脑电惊醒反应亦消失；动物表现兴奋狂躁。对猴、犬、兔和大鼠等动物，东莨菪碱所引起的脑电反应非常近似，并能阻断多种生理刺激所引起的惊醒反应。"}]},{"ID":"20240902100830-lf9kshu","Type":"NodeParagraph","Properties":{"id":"20240902100830-lf9kshu","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.3．对条件反射的影响：大鼠皮下注射东莨菪碱0.05-100mg/kg，能不同程度地阻断回避性条件反射和二级条件反射，阻断率与剂量呈平行关系。在抑制大鼠回避性条件反射时，东莨菪碱影响二级条件反射及条件反射最强，阿托品则较弱。"}]},{"ID":"20240902100830-prqttjq","Type":"NodeParagraph","Properties":{"id":"20240902100830-prqttjq","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.4．对痛觉的影响：兔钾离子透入法和小鼠热板法证明东莨菪碱有一定的镇痛作用，并能加强杜冷丁的镇痛作用，对抗去甲肾上腺素侧脑室注射引起的痛阈降低和杜冷丁镇痛作用的减弱。小鼠腹腔注射洋金花总碱每只0.2mg，15分钟后，对辐射热的痛阈可提高54.7%。亦有报道，东莨菪碱能对抗震颤素的中枢镇痛作用，且较阿托品为强。"}]},{"ID":"20240902100830-lb4hsjo","Type":"NodeParagraph","Properties":{"id":"20240902100830-lb4hsjo","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.5．与神经递质的相互影响：用1/10万的东莨菪碱作猫侧脑室灌流，能增加乙相胆碱的释放量，灌流期间合并静脉注射东莨菪碱1mg/kg，并不能使乙酰胆碱释放量进一步增加但大鼠腹腔注射东莨菪碱0.63mg/kg，脑中乙酰胆碱含量可减少31%，作用在给药后60分钟，为最强，于120分钟时恢复正常，说明非侧脑室给药仍能促进脑内乙酰胆碱的释放。而使脑组织中乙酰胆碱含量下降。兔静脉注射利血平0.5-1.0mg/kg或脑室注射对氯苯丙氨酸（PCPA）每只5.0mg，均能延长侧脑室注射东莨菪碱2-3mg/kg引起的麻醉，但脑室注射5-HT每只250mg，静脉注射优降宁50mg/kg均显着缩短其麻醉时间；而脑室内注射去甲肾上腺素每只20Oμg，对东莨菪碱的麻醉时间无明显影响。"}]},{"ID":"20240902100830-ge6x3rn","Type":"NodeParagraph","Properties":{"id":"20240902100830-ge6x3rn","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"因此，东莨菪碱对大脑皮层和皮层下某些部位主要是抑制作用，如使意识消失，产生麻醉等，认为这与其阻滞大脑皮层和脑干网质结构M-胆碱受体有关，也可能与它在中枢神经系统对抗去甲肾上腺素作用有关。但对延髓和脊髓则有不同程度的兴奋作用，特别对延髓的呼吸中枢，兴奋作用较明显。为此，东莨菪碱可提高清醒犬的呼吸频率，从而抵消冬眠药物（杜冷丁和氯丙嗪）减慢呼吸的作用。"}]},{"ID":"20240902100830-3t2i4uf","Type":"NodeParagraph","Properties":{"id":"20240902100830-3t2i4uf","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.对循环系统的作用：2.1．对心血管的作用：东莨菪碱能解除迷走神经对心脏的抑制，使交感神经作用占优势，故心率加快。阿托品有类似作用，且更强。正常兔和麻醉犬静脉注射阿托品2-4mg/kg或东莨菪碱4mg/kg后，可拮抗肾上腺素或去甲肾上腺素50μg/kg所诱发的心律紊乱（房性或室性期前收缩，室性心动过速等）、但不能拮抗引起的心率加快。离体兔耳血管灌流表明，20mg的东莨菪碱可以拮抗去甲肾上腺素20μg/0.1mg引起的血管收缩作用，但此作用比阿托品弱得多。"}]},{"ID":"20240902100830-n1kve9v","Type":"NodeParagraph","Properties":{"id":"20240902100830-n1kve9v","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.2．对血流动力学的影响：出血性休克犬静脉注射洋金花总碱，心排血量未见增高，但输血以补充血容量后，洋金花总碱能使心排血量增加。说明洋金花对心排血量的影响与血容量有关。麻醉兔静脉注射东莨菪碱10-20mg/kg，能拮抗静脉注射5μg/kg肾上腺素或去甲肾上腺素的升压作用。实验还表明，东莨菪碱能改善失血性犬的微循环。"}]},{"ID":"20240902100830-godk2b7","Type":"NodeParagraph","Properties":{"id":"20240902100830-godk2b7","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"3.对呼吸系统和平滑肌器官的作用：小剂量洋金花注射液可完全拮抗乙酰胆碱引起离体豚鼠气管平滑肌的收缩作用。洋金花对实验性气管炎大鼠的气管粘液腺有抑制作用，杯状细胞显着减少，此作用与切断单侧迷走神经的作用相似。东莨菪碱能降低胃肠道的蠕动及张力，能阻断胆碱能神经的功能，使膀胱逼尿肌松弛，尿道括约肌收缩，引起尿潴留。"}]},{"ID":"20240902100830-6k2cgi0","Type":"NodeParagraph","Properties":{"id":"20240902100830-6k2cgi0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"4.其它作用：洋金花总碱或东莨菪碱用作与麻醉剂时，可使病人周围血管扩张，体表温度升高，而体温下降。但术后2-6小时体温出现回升。对精神病患者应用洋金花麻醉后，静脉注射给药可见血胆碱酯酶活力的平均值有显着提高，而肌肉注射则不明显。"}]},{"ID":"20240902100830-zob0nzy","Type":"NodeParagraph","Properties":{"id":"20240902100830-zob0nzy","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【毒性】犬静脉注射洋金花总碱后，可发生强烈惊厥或角弓反张，终于呼吸衰竭而死亡。用总碱对犬作静脉麻醉(2mg/kg)，3天后处死，未见内脏有明显形态学改变。犬静脉注射最小致死量为80mg/kg，麻醉的最小有效量为2mg/kg，安全范围较大。洋金花注射液小鼠静脉注射的半数致死量为8.2mg/kg，洋金花总碱犬静脉注射的最小致死量约为75-80mg/kg，2.5mg/kg给犬静脉注射一次，3天后处死，其13种主要脏器与对照组比较未见明显的形态差异。"}]},{"ID":"20240902100830-ki116o3","Type":"NodeParagraph","Properties":{"id":"20240902100830-ki116o3","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902100830-wjr81k0","Type":"NodeParagraph","Properties":{"id":"20240902100830-wjr81k0","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）本品乙醇浸出液浓缩至稠膏状，用1%盐酸溶解，滤过。滤液加浓氨试液使成碱性，用乙醚提取，提取液在水浴上蒸干，加4滴发烟硝酸，再蒸发至干，残潭显浅黄色，加新配的氢氧化钾无水乙醇饱和溶液数滴，即显紫堇色，后为棕红色。（检查生物碱）。"}]},{"ID":"20240902100830-t0tx118","Type":"NodeParagraph","Properties":{"id":"20240902100830-t0tx118","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"（2）薄层色谱取本品粉末1g，加氨水1ml碱化，用氯仿提取，滤过，水浴挥去溶剂，残潭加氯仿1ml溶解为供试液，以0.2%硫酸阿托品乙醇液与0.3%氢溴酸东莨菪碱的乙醇溶液为对照品液，分别吸取上述2种溶液各10μm，点于同一硅胶G薄层板上，以乙酸乙酯-甲醇-浓氨液（17：2：1）展开，取出，晾干，改良碘化铋钾溶液显色，供试液色谱在与对照品色谱相应位置上有相同的色斑。"}]},{"ID":"20240902100830-ldcnaz2","Type":"NodeParagraph","Properties":{"id":"20240902100830-ldcnaz2","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【性味】呸辛；性温；有毒"}]},{"ID":"20240902100830-gayrdss","Type":"NodeParagraph","Properties":{"id":"20240902100830-gayrdss","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；肝经"}]},{"ID":"20240902100830-tv4j5y9","Type":"NodeParagraph","Properties":{"id":"20240902100830-tv4j5y9","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【功能主治】平顺止咳；麻醉止痛；解痉止搐。主哮喘咳嗽；脘腹冷育；风湿痹痛；癫痫；惊风；外科麻醉"}]},{"ID":"20240902100830-h3z9p99","Type":"NodeParagraph","Properties":{"id":"20240902100830-h3z9p99","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.3-0.5g，宜入丸、散用。如作卷烟分次烯吸，每日量不超过0.5g。外用：适量，煎水洗；或研末调敷衍。"}]},{"ID":"20240902100830-ebyi990","Type":"NodeParagraph","Properties":{"id":"20240902100830-ebyi990","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【注意】内服宜慎。体弱者禁用"}]},{"ID":"20240902100830-702aebb","Type":"NodeParagraph","Properties":{"id":"20240902100830-702aebb","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【附方】①治哮喘：曼陀罗花两五，火硝一钱，川贝一两，法夏八钱，泽兰六钱，冬花五钱。上共研细末，用老姜一斤，捣烂取汁，将药末合匀，以有盖茶盅一只盛贮封固，隔水蒸一小时久，取出，以熟烟丝十两和匀，放通风处，吹至七、八成干(不可过于干燥，恐其易碎)时，贮于香烟罐中备用。每日以旱烟筒或水烟袋，如寻常汲烟法吸之。(《外科十三方考》立止哮喘烟)②治小儿慢惊：曼陀罗花七朵(重一字)，天麻二钱半，全蝎(炒)十枚，天南星(炮)、丹砂、乳香各二钱半。为末。每服半钱，薄荷汤调下。(《御药院方》)③治阳厥气逆多怒而狂：朱砂(水飞)半两，曼陀罗花二钱半。上为细末。每服二钱，温酒调下，若醉便卧，勿令惊觉。(《证治准绳》祛风一醉散)④治(病)人难忍艾火灸痛，服此即昏睡不痛，亦不伤人：山茄花(八月收)、火麻花(八月收一说七月收)。阴干，共研末。每服三钱，小儿只一钱，茶酒任下。一服后即昏睡，可灸五十壮，醒后再服再灸。(《扁鹊心书》睡圣散)⑤治诸风痛及寒湿脚气：曼陀罗花、茄梗、大蒜梗、花椒叶。煎水洗。(《四川中药志》)⑥治面上生疮：曼陀罗花，晒干研末，少许贴之。(《卫生易简方》)"}]},{"ID":"20240902100830-gz3qy6y","Type":"NodeParagraph","Properties":{"id":"20240902100830-gz3qy6y","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902100830-meog8jj","Type":"NodeParagraph","Properties":{"id":"20240902100830-meog8jj","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：诸风及寒湿脚气，煎汤洗之。又主惊癎及脱肛，并入麻药。"}]},{"ID":"20240902100830-m409v3n","Type":"NodeParagraph","Properties":{"id":"20240902100830-m409v3n","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.《生草药性备要》：少服止痛，通关利窍，去头风。"}]},{"ID":"20240902100830-8gbapk1","Type":"NodeParagraph","Properties":{"id":"20240902100830-8gbapk1","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"3.《本草便读》：止疮疡疼痛，宣痹着寒哮。"}]},{"ID":"20240902100830-1i3h5gu","Type":"NodeParagraph","Properties":{"id":"20240902100830-1i3h5gu","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"4.《陆川本草》：治咳嗽，跌打疼痛。"}]},{"ID":"20240902100830-t79cdve","Type":"NodeParagraph","Properties":{"id":"20240902100830-t79cdve","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902100830-r49d4uf","Type":"NodeParagraph","Properties":{"id":"20240902100830-r49d4uf","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.用于麻醉：相传我国名医华佗早在公元200余年，就曾应用麻沸散作为麻醉剂为病人施行刮骨、剖腹手术。近年来，继针刺麻醉之后，又进一步采用了以洋金花为主的中药麻醉，获得初步成功。基本处方为：洋金花、生草乌、川芎、当归。给药途径：目前计采用口服、灌汤、肌肉注射、静脉点滴、穴位注射(耳穴、鼻灾)及耳根非穴位麻醉等6个途径给药，麻醉效果相似。据临床应用425人次的介绍，其中有高年老人及乳婴；有肝硬变、高血压病患者、休克病人、恶液质患者等，共施行大小手术81种，手术时间最长者达9小时以上，洋金花生药用量1次高达20g，术后一般恢复良好。上述病例采用中麻手术无l例失败，麻醉效果满意者(指麻醉平稳，病人安静，能顺利完成手术，或手术刺激反应较明显，但不需改用其他麻醉，仍能完成手术操作者)占90%左右。"}]},{"ID":"20240902100830-s8pz0av","Type":"NodeParagraph","Properties":{"id":"20240902100830-s8pz0av","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.1.禁忌症：1.1.1.青光眼或有眼压增高者。"}]},{"ID":"20240902100830-vxwiohh","Type":"NodeParagraph","Properties":{"id":"20240902100830-vxwiohh","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.1.2.心动过速或有心动过速病史者以及心肺功能明显代偿不全者。"}]},{"ID":"20240902100830-hst9s92","Type":"NodeParagraph","Properties":{"id":"20240902100830-hst9s92","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.1.3.高热病人。"}]},{"ID":"20240902100830-a84ojni","Type":"NodeParagraph","Properties":{"id":"20240902100830-a84ojni","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.1.4.严重高血压患者。"}]},{"ID":"20240902100830-0fd6cl1","Type":"NodeParagraph","Properties":{"id":"20240902100830-0fd6cl1","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.1.5.肝肾功能严重损害者。"}]},{"ID":"20240902100830-siytvgu","Type":"NodeParagraph","Properties":{"id":"20240902100830-siytvgu","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.2.存在问题：1.2.1.麻醉深度不够：临床观察及脑电图表明，过去大部分中药麻醉病人的麻醉深度，相当于乙醚麻醉的Ⅲ期一级。因此，对上腹部手术，部分病人肌肉松弛不够满意，内脏牵，可有助于腹肌松弛。"}]},{"ID":"20240902100830-6dquekj","Type":"NodeParagraph","Properties":{"id":"20240902100830-6dquekj","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.2.2.苏醒时间长：采用口服或灌汤法，苏醒时间多在10-12小时；注射给药，苏醒时间约为6-8小时。有报告拉反应明显，使手术操作有一定困难，如在术前或术中配合使用八角枫、锡生藤及汉防己等，或封闭两侧足三里穴等方法在手术将结束时，肌肉注射槟榔注射液l-2ml，同时静脉注射美解眠40ml，能使苏醒提前3小时左右。对采取口服给药的病例，亦可在手术结束前从胃管抽去剩余药液，并注入甘草绿豆汤，亦能提早清醒。"}]},{"ID":"20240902100830-6ql0zpm","Type":"NodeParagraph","Properties":{"id":"20240902100830-6ql0zpm","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"1.2.3.窦性心动过速：可用l%普鲁卡因静滴代替冬眠药物，既能提早苏醒时间，又能控制心率。"}]},{"ID":"20240902100830-jsw08zp","Type":"NodeParagraph","Properties":{"id":"20240902100830-jsw08zp","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"2.治疗慢性气管炎：用洋金花注射液每5天肌注1次，一般注射4-5次，每次注射液中含东莨菪碱0.5-1.0mg，根据病人年龄、性别、体质强弱等具体情况，用量略有不同。一般于注射后10-15分钟出现反应迟钝；15-20分钟进入浅睡，40-60分钟进入深睡；3-4小时后苏醒，醒后呼吸通顺，略有倦意。共治疗慢性气管炎1200例，临床控制率为70%，显效率为17%，用药后作心、肝、肾功能测定，未见有损害。此外，有用曼陀罗组成复方气管炎片、气管炎注射液作穴位(肺俞、定喘穴)交叉注射，10次为一疗程，验证640例，其中临床近控率36%，显效率23%。或用曼陀罗叶100g(鲜叶用600g)，甘草50g，制成25%曼陀罗合剂内服，每次4-5ml，10天一疗程，共治44例，均取得较好疗效。"}]},{"ID":"20240902100830-ay0abde","Type":"NodeParagraph","Properties":{"id":"20240902100830-ay0abde","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"3.治疗精神分裂症：将曼陀罗花用白酒浸成10%酊剂，或制成20%煎剂。每日早餐后服1次，连服6天，停服l天。用量由10ml开始，根据反应程度，逐渐增加至40-80ml，以用药后l小时左右出现迷睡，并维持2-3小时为适宜。服药后有胃部不适及食欲减退的副作用，可在每次服药当天上下午给胃蛋白酶或稀盐酸，并采用0.5%毛果芸香碱眼膏以减轻瞳孔散大及视力模糊。接受此种治疗后，患者的临床表现一般可分三个阶段：第一阶段，服药15分钟左右开始出现轻度不安，口干，瞳孔散大，视物不清。并可出现幻视，意识蒙胧，定向障碍，步态不稳。部分患者有尿意频繁，少数有躁动恐怖情绪。这一阶段约持续l/2-2小时。第二阶段，主要为迷睡状态，可出现肌张力增强或减退，口涎增加，呼吸深缓，这一阶段约2-10小时不等。第三阶段为醒转期，醒后自感头脑清醒，除胸闷、不思饮食、口干外，前述的临床表现均消失。根据对62例精神分裂症患者的观察，单独使用曼陀罗的疗效似不高，但对精神运动性兴奋有良好的宁静作用。"}]},{"ID":"20240902100830-8eha73a","Type":"NodeParagraph","Properties":{"id":"20240902100830-8eha73a","updated":"20240902100913"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902100832-pnkfu6g","Type":"NodeThematicBreak","Properties":{"id":"20240902100832-pnkfu6g","updated":"20240902100913"}},{"ID":"20240902100833-jmjc8kc","Type":"NodeParagraph","Properties":{"id":"20240902100833-jmjc8kc","updated":"20240902100913"}}]}