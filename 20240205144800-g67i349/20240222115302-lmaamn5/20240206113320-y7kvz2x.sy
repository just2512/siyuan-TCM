seParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 191px;\" parent-style=\"width: 201px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 3-20240714111311-f2d00hd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 2-20240714111231-btla2n6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714111657-xegirw0","Type":"NodeParagraph","Properties":{"id":"20240714111657-xegirw0","updated":"20240714124854"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 644px;","style":"width: 634px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 6-20240714111657-3j0kflv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 634px;\" parent-style=\"width: 644px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 258px;","style":"width: 248px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 7-20240714111728-4nznnkr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 248px;\" parent-style=\"width: 258px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 294px;","style":"width: 284px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 9-20240714111826-95tnwlj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 284px;\" parent-style=\"width: 294px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714110416-zsxzp2j","Type":"NodeParagraph","Properties":{"id":"20240714110416-zsxzp2j","updated":"20240714113237"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 332px;","style":"width: 322px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花-20240714110416-omuwqtt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 322px;\" parent-style=\"width: 332px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 532px;","style":"width: 522px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花 17-20240714113237-yx9rhw0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 522px;\" parent-style=\"width: 532px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902084249-stc71ou","Type":"NodeParagraph","Properties":{"id":"20240902084249-stc71ou","updated":"20240902084249"}},{"ID":"20240714123949-gh87a6d","Type":"NodeParagraph","Properties":{"id":"20240714123949-gh87a6d","updated":"20240902084247"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花、月季花花苞对比"}]},{"ID":"20240714123949-gpp5rle","Type":"NodeParagraph","Properties":{"id":"20240714123949-gpp5rle","updated":"20240714123949"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"月季花玫瑰花花苞对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/月季花玫瑰花花苞对比-20240714120505-b45wpwy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714123949-apqvo5k","Type":"NodeParagraph","Properties":{"id":"20240714123949-apqvo5k","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"月季花花苞为圆柱形，玫瑰花花苞类球形（上为月季花，下为玫瑰花）"}]},{"ID":"20240714123949-ewmf3t6","Type":"NodeParagraph","Properties":{"id":"20240714123949-ewmf3t6","updated":"20240714123949"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玫瑰花 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玫瑰花 10-20240714120548-gh1i597.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714123949-tq2vxv8","Type":"NodeParagraph","Properties":{"id":"20240714123949-tq2vxv8","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"月季花花萼是一个戟形，到最顶上突然收缩的，而玫瑰花是箭形，是从底部缓慢开始收缩的，没有一个突变的过程（左为月季花，右为玫瑰花）"}]},{"ID":"20240714123949-zf0cnli","Type":"NodeParagraph","Properties":{"id":"20240714123949-zf0cnli","updated":"20240714123949"}},{"ID":"20240714123949-gvkq1mx","Type":"NodeParagraph","Properties":{"id":"20240714123949-gvkq1mx","updated":"20240714135054"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：玫瑰花跟月季花本草较为相像。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206112511-cl2kwhy","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"玫瑰花"}]},{"ID":"20240714123949-sww70gw","Type":"NodeParagraph","Properties":{"id":"20240714123949-sww70gw","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花茎上的刺是直立型的，月季花茎上的刺是倒勾型，少且稀疏；"}]},{"ID":"20240714123949-jl78mrw","Type":"NodeParagraph","Properties":{"id":"20240714123949-jl78mrw","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花叶片颜色偏黄绿，有很多褶皱偏粗糙，一般有5-9片小叶，而月季花叶片颜色较深，油亮有光泽且表面光滑，小叶一般为3-5片；"}]},{"ID":"20240714123949-kguxfko","Type":"NodeParagraph","Properties":{"id":"20240714123949-kguxfko","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花花期集中在4-6月，一年只开一次花，而月季花又名月月红，在适宜养育条件下可以四季开花；"}]},{"ID":"20240714123949-vcxsqdo","Type":"NodeParagraph","Properties":{"id":"20240714123949-vcxsqdo","updated":"20240714123949"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰花花朵较小，花瓣较紧密，花香浓郁，而月季花花朵较大，花瓣较松散，花香相对较淡；"}]},{"ID":"20240714110628-xw72ppm","Type":"NodeThematicBreak","Properties":{"id":"20240714110628-xw72ppm"}},{"ID":"20240830172339-1nt78hf","Type":"NodeParagraph","Properties":{"id":"20240830172339-1nt78hf","updated":"20240830172346"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：月季花"}]},{"ID":"20240830172339-nz3039d","Type":"NodeParagraph","Properties":{"id":"20240830172339-nz3039d","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"月季花《全国中草药汇编》"}]},{"ID":"20240830172339-6095crb","Type":"NodeParagraph","Properties":{"id":"20240830172339-6095crb","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【拼音名】YuèJìHuā"}]},{"ID":"20240830172339-oe9ohga","Type":"NodeParagraph","Properties":{"id":"20240830172339-oe9ohga","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【英文名】FLOSROSAECHINENSIS"}]},{"ID":"20240830172339-ckh2k9r","Type":"NodeParagraph","Properties":{"id":"20240830172339-ckh2k9r","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【别名】月月红"}]},{"ID":"20240830172339-avguwnw","Type":"NodeParagraph","Properties":{"id":"20240830172339-avguwnw","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【来源】本品为蔷薇科植物月季RosachinensisJacq.的干燥花，其根、叶也入药。全年均可采收，花微开时采摘，阴干或低温干燥。春季挖根，洗净晒干。叶多鲜用。"}]},{"ID":"20240830172339-irim7ca","Type":"NodeParagraph","Properties":{"id":"20240830172339-irim7ca","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈类球形，直径1.5～2.5cm。花托长圆形，萼片5，暗绿色，先端尾尖；花瓣呈覆瓦状排列，有的散落，长圆形，紫红色或淡紫红色；雄蕊多数，黄色。体轻，质脆。气清香，味淡、微苦。"}]},{"ID":"20240830172339-uogezdo","Type":"NodeParagraph","Properties":{"id":"20240830172339-uogezdo","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性味】甘，温。"}]},{"ID":"20240830172339-ywitu3v","Type":"NodeParagraph","Properties":{"id":"20240830172339-ywitu3v","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【归经】归肝经。"}]},{"ID":"20240830172339-git8mqb","Type":"NodeParagraph","Properties":{"id":"20240830172339-git8mqb","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血调经，散毒消肿。花：用于月经不调，痛经，痈疖肿毒，淋巴结结核（未溃破）。叶：淋巴结结核，跌打损伤。根：跌打损伤，白带，遗精。"}]},{"ID":"20240830172339-1nzl430","Type":"NodeParagraph","Properties":{"id":"20240830172339-1nzl430","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【用法用量】花1～2钱；根3～5钱；鲜花或叶外用适量，捣烂敷患处。"}]},{"ID":"20240830172339-lfe67x3","Type":"NodeParagraph","Properties":{"id":"20240830172339-lfe67x3","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处，防压、防蛀。"}]},{"ID":"20240830172339-rx3xnm5","Type":"NodeParagraph","Properties":{"id":"20240830172339-rx3xnm5","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830172339-ctxkld4","Type":"NodeParagraph","Properties":{"id":"20240830172339-ctxkld4","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"月季花《*辞典》"}]},{"ID":"20240830172339-wt1lfpy","Type":"NodeParagraph","Properties":{"id":"20240830172339-wt1lfpy","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目》"}]},{"ID":"20240830172339-jqjlvxk","Type":"NodeParagraph","Properties":{"id":"20240830172339-jqjlvxk","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【拼音名】YuèJìHuā"}]},{"ID":"20240830172339-5m9llyu","Type":"NodeParagraph","Properties":{"id":"20240830172339-5m9llyu","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【别名】四季花（《益部方物略记》），月月红、胜春、斗雪红（《纲目》），月贵花、月记（《南越笔记》），月月开（《分类草药性》），长春花（《现代实用中药》），月月花（《贵州民间方药集》），艳雪红、绸春花（《泉州本草》），月季红（《陕西中药志》），勒泡（《湖南药物志》），月光花、铜棰子、四季春（《闽东本草》）。"}]},{"ID":"20240830172339-vt97avg","Type":"NodeParagraph","Properties":{"id":"20240830172339-vt97avg","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷薇科植物月季花的半开放花。夏、秋采收半开放的花朵，晾干，或用微火烘干。"}]},{"ID":"20240830172339-w9fuch3","Type":"NodeParagraph","Properties":{"id":"20240830172339-w9fuch3","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830172339-ndret7x","Type":"NodeParagraph","Properties":{"id":"20240830172339-ndret7x","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"常绿直立灌木。枝圆柱形，有三棱形钩状皮刺。单数羽状复叶互生；小叶3～5，稀为7枚；小叶有柄，柄上有腺毛及刺；小叶片阔卵形至卵状长椭匮形，长2～7厘米，宽1～4厘米，先端渐尖或急尖，基部阔楔形或圆形，边缘有尖锯齿；总叶柄基部有托叶，边缘具腺毛。花通常数朵簇生，稀单生，红色或玫瑰色，重瓣；总苞2，披针形，先端长尾状，表面有毛，边缘有腺毛；花萼5，向下反卷，有长尾状锐尖头，常羽状裂，外面光滑，内面密被白色绵毛；花瓣倒卵形，先端圆形，脉纹明显，呈覆瓦状排列；雄蕊多数，着生于花萼筒边缘的花盘上；雌蕊多数，包于壶状花托的底部，子房有毛。果实卵形或陀螺形。花期5～9月。"}]},{"ID":"20240830172339-ut8klww","Type":"NodeParagraph","Properties":{"id":"20240830172339-ut8klww","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"本植物的根（月季花根）、叶（月季花叶）亦供药用，各详专条。"}]},{"ID":"20240830172339-q2vwwmy","Type":"NodeParagraph","Properties":{"id":"20240830172339-q2vwwmy","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡或路旁。我国各地普遍栽培。全国大部分地区都有生产。"}]},{"ID":"20240830172339-3gi4aau","Type":"NodeParagraph","Properties":{"id":"20240830172339-3gi4aau","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的花朵呈圆球形，杂有散碎的花瓣。花大小约1.5～2厘米，呈紫色或粉红色。花瓣多数呈长圆形，有纹理，中央为黄色花蕊，花萼绿色，先端裂为5片，下端有膨大成长圆形的花托。质脆，易破碎。微有清香气，味淡微苦.以紫红色、半开放的花蕾、不散瓣、气味清香者为佳。"}]},{"ID":"20240830172339-24jtatx","Type":"NodeParagraph","Properties":{"id":"20240830172339-24jtatx","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830172339-4pyxtba","Type":"NodeParagraph","Properties":{"id":"20240830172339-4pyxtba","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"甘，温."}]},{"ID":"20240830172339-n2qqih7","Type":"NodeParagraph","Properties":{"id":"20240830172339-n2qqih7","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"甘，温，无毒。\""}]},{"ID":"20240830172339-lcpjcoa","Type":"NodeParagraph","Properties":{"id":"20240830172339-lcpjcoa","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"②《闽东本草）：\"性平，味淡，无毒。\""}]},{"ID":"20240830172339-fruir3o","Type":"NodeParagraph","Properties":{"id":"20240830172339-fruir3o","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830172339-dyyu33q","Type":"NodeParagraph","Properties":{"id":"20240830172339-dyyu33q","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"入肝经。"}]},{"ID":"20240830172339-ohlldhx","Type":"NodeParagraph","Properties":{"id":"20240830172339-ohlldhx","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"①《陕西中药志》：\"入肝经。\""}]},{"ID":"20240830172339-sqhaqi2","Type":"NodeParagraph","Properties":{"id":"20240830172339-sqhaqi2","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"②《闽东本草》：\"入肝、肾二经。\""}]},{"ID":"20240830172339-umw5x30","Type":"NodeParagraph","Properties":{"id":"20240830172339-umw5x30","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830172339-9je6z5f","Type":"NodeParagraph","Properties":{"id":"20240830172339-9je6z5f","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"活血调经，消肿解毒。治月经不调，经来腹痛，跌打损伤，血瘀肿痛，痈疽肿毒。"}]},{"ID":"20240830172339-w1h2w84","Type":"NodeParagraph","Properties":{"id":"20240830172339-w1h2w84","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"活血消肿，敷毒。\""}]},{"ID":"20240830172339-9dhx2cp","Type":"NodeParagraph","Properties":{"id":"20240830172339-9dhx2cp","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"②《分类草药性》：\"止血。治红崩、白带。\""}]},{"ID":"20240830172339-92a36t2","Type":"NodeParagraph","Properties":{"id":"20240830172339-92a36t2","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"③《现代实用中药》：\"活血调经。治月经困难，月经期拘挛性腹痛.外用捣敷肿毒，能消肿止痛。\""}]},{"ID":"20240830172339-al5fdjy","Type":"NodeParagraph","Properties":{"id":"20240830172339-al5fdjy","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"④《泉州本草》：\"通经活血化瘀，清肠胃湿热，泻肺火，止咳，止血止痛，消痈毒。治肺虚咳嗽咯血，痢疾，瘰疬溃烂，痈疽肿毒，妇女月经不调。\""}]},{"ID":"20240830172339-rxlbmjs","Type":"NodeParagraph","Properties":{"id":"20240830172339-rxlbmjs","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；或研末。外用：捣敷。"}]},{"ID":"20240830172339-3z0z0st","Type":"NodeParagraph","Properties":{"id":"20240830172339-3z0z0st","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830172339-tuvbh64","Type":"NodeParagraph","Properties":{"id":"20240830172339-tuvbh64","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"①治月经不调：鲜月季花每次五至七钱，开水泡服，连服数次。（《泉州本草》）"}]},{"ID":"20240830172339-1l0rkwh","Type":"NodeParagraph","Properties":{"id":"20240830172339-1l0rkwh","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"②治肺虚咳嗽咯血：月季花合冰糖炖服。（《泉州本草》）"}]},{"ID":"20240830172339-7nur9au","Type":"NodeParagraph","Properties":{"id":"20240830172339-7nur9au","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"③治筋骨疼痛，脚膝肿痛，跌打损伤：月季花瓣干研末，每服一钱，酒冲服。（《湖南药物志，）"}]},{"ID":"20240830172339-tiyu56q","Type":"NodeParagraph","Properties":{"id":"20240830172339-tiyu56q","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"④治产后阴挺：月季花一两炖红酒服。（《闽东本草》）"}]},{"ID":"20240830172339-9pl9hr9","Type":"NodeParagraph","Properties":{"id":"20240830172339-9pl9hr9","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830172339-m0h6uaw","Type":"NodeParagraph","Properties":{"id":"20240830172339-m0h6uaw","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"月季花《中华本草》"}]},{"ID":"20240830172339-425spsr","Type":"NodeParagraph","Properties":{"id":"20240830172339-425spsr","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目》"}]},{"ID":"20240830172339-amkhbak","Type":"NodeParagraph","Properties":{"id":"20240830172339-amkhbak","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【拼音名】YuèJìHuā"}]},{"ID":"20240830172339-l7qfyx9","Type":"NodeParagraph","Properties":{"id":"20240830172339-l7qfyx9","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【英文名】ChineseRoseFlower"}]},{"ID":"20240830172339-o9lx6vh","Type":"NodeParagraph","Properties":{"id":"20240830172339-o9lx6vh","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【别名】四季花、月月红、胜春、斗雪红、月贵花、月记、月月开、长春花、月月花、艳雪红、绸春花、月季红、勒泡、月光花、四香春、月七花"}]},{"ID":"20240830172339-m4ob5wd","Type":"NodeParagraph","Properties":{"id":"20240830172339-m4ob5wd","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830172339-dum2kfe","Type":"NodeParagraph","Properties":{"id":"20240830172339-dum2kfe","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物月季花的花。"}]},{"ID":"20240830172339-17f3j3p","Type":"NodeParagraph","Properties":{"id":"20240830172339-17f3j3p","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：RosachinensisJacq."}]},{"ID":"20240830172339-g30rkt1","Type":"NodeParagraph","Properties":{"id":"20240830172339-g30rkt1","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季选晴天采收半开放的花朵，及时摊开晾干，或用微火烘干。"}]},{"ID":"20240830172339-3nkoah3","Type":"NodeParagraph","Properties":{"id":"20240830172339-3nkoah3","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【原形态】月季花矮小直立灌木。小枝粗壮而略带钩状的皮刺或无刺。羽状复叶，小叶3-5，宽卵形或卵状长圆形，长2-6cm，宽1-3cm，先端渐尖，基部宽楔形或近圆形，边缘有锐锯齿；两面无毛；叶柄及叶轴疏生皮刺及腺毛，托叶大部附生于叶柄上，边缘有腺毛或羽裂。花单生或数朵聚生成伞房状；花梗长，散生短腺毛；萼片卵形，先端尾尖，羽裂，边缘有腺毛；花瓣红色或玫瑰色，重瓣，直径约5cm，微香；花柱分离，子房被柔毛。果卵圆形或梨形，长1.5-2cm，红色。萼片宿存。花期4-9月。果期6-11月。"}]},{"ID":"20240830172339-t1txzn3","Type":"NodeParagraph","Properties":{"id":"20240830172339-t1txzn3","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830172339-ys7npq8","Type":"NodeParagraph","Properties":{"id":"20240830172339-ys7npq8","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡或路旁。"}]},{"ID":"20240830172339-4e5d8p7","Type":"NodeParagraph","Properties":{"id":"20240830172339-4e5d8p7","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"资源分布：我国各地普遍栽培。"}]},{"ID":"20240830172339-qorg99j","Type":"NodeParagraph","Properties":{"id":"20240830172339-qorg99j","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240830172339-m29cchn","Type":"NodeParagraph","Properties":{"id":"20240830172339-m29cchn","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"生物学特性月季适应性强耐寒、耐旱，对土壤要求不严格，以肥沃深厚，排水良好之中性偏酸腐殖土(pH6-6.5)生长较好。喜光，但过于强烈的阳光对花蕾发育不利。喜温暖，气温在22-25℃生长开花最为适宜，夏季高温对开花不利。"}]},{"ID":"20240830172339-l3eqx47","Type":"NodeParagraph","Properties":{"id":"20240830172339-l3eqx47","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"栽培技术用扦插繁殖，育苗移栽。每年在2-3月或7-8月，选健壮枝条剪成16-20cm的插条。在1.3m宽的畦上，作成苗床。按行距33cm开横沟，深13-16cm，每隔7-10cm，斜放插条1根，露出畦面4cm左右，填土压紧，再盖土与畦面齐平。培育1年，即可移栽。移栽在2-3月进行。整好土地，理好排水沟，然后按行距70cm，株距35cm挖穴，每穴栽苗1株，填土压实，浇水定根。"}]},{"ID":"20240830172339-2taghps","Type":"NodeParagraph","Properties":{"id":"20240830172339-2taghps","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"田间管理扦插1月左右，待新苗发出后，要中耕除草、追肥1次。移栽后在每年3月、7月和12月中耕除草、追肥各1次。肥料前两次以人畜粪水为主，冬季可施用土杂肥和过磷酸钙。修枝在早春或冬季进行，每株留3-4个主枝。"}]},{"ID":"20240830172339-vibaika","Type":"NodeParagraph","Properties":{"id":"20240830172339-vibaika","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有黑霉病和白霉病，要注意排水，及时除去受害枝叶，并喷射波尔多液防治。虫害有蔷薇叶蜂、卷叶虫等幼虫食害叶片，锯梢虫和象鼻虫为害嫩枝，可用化学药物毒杀。尺蠖为害叶片，可用化学药剂防治。"}]},{"ID":"20240830172339-3dtfw9u","Type":"NodeParagraph","Properties":{"id":"20240830172339-3dtfw9u","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830172339-qc3x732","Type":"NodeParagraph","Properties":{"id":"20240830172339-qc3x732","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"性状鉴定：花朵多呈圆形或类球形，花朵多呈圆球形，直径1-1.5cm。花托倒圆锥或倒卵形，长5-7mm，直径3-5mm，棕紫色，基部较尖，常带有花梗。萼片5枚，先端尾尖，大多向下反折，短于或等于花冠，背面黄绿色或橙黄色，有疏毛，内面被白色绵毛。花瓣5片或重瓣，覆瓦状排列，少数杂有散瓣，长2-2.5cm，宽1-2.5cm，紫色或淡红色，脉纹明显。雄蕊多数，黄棕色，卷曲，着生于花萼筒上。雌蕊多数，有毛，花柱伸出花托口。体轻，质脆，易碎。气清香，味微苦、涩。"}]},{"ID":"20240830172339-jk1nfvb","Type":"NodeParagraph","Properties":{"id":"20240830172339-jk1nfvb","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"以完整、色紫红、半开放、气清香者为佳。"}]},{"ID":"20240830172339-9tjile3","Type":"NodeParagraph","Properties":{"id":"20240830172339-9tjile3","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"显微鉴定萼片表面观：上表面（内表面）密被单细胞非腺毛，长125-660μm，壁厚且弯曲；下表面具多细胞腺毛，长60-355μm，柄为多细胞排成多列。头部由多细胞集成扁球形；尚有少数短小非腺毛。气孔为不定式。薄壁细胞中含草酸钙簇晶及少数棱晶。"}]},{"ID":"20240830172339-3zfgc3m","Type":"NodeParagraph","Properties":{"id":"20240830172339-3zfgc3m","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"花分粒：极面观呈类三角形，直径25-35μm；赤道面观为椭圆形，直径20-35μm，具三孔沟，内孔类圆形，直径为5.9μm外壁2层。表面具条状雕纹。"}]},{"ID":"20240830172339-etlm5s2","Type":"NodeParagraph","Properties":{"id":"20240830172339-etlm5s2","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"花梗（近花托的端部）横切面：表皮为1列长方形细胞，排列整齐，有少量腺毛。皮层外侧为数列较小的厚壁细胞，内侧为薄壁细胞，常含有草酸钙簇晶。维管束10-23个，外韧型，略呈内外2列相间排列，木质部束导管3-6个。髓部薄壁细胞含有草酸钙簇晶。"}]},{"ID":"20240830172339-2cdy615","Type":"NodeParagraph","Properties":{"id":"20240830172339-2cdy615","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【化学成份】花含挥发油，其成分与玫瑰油相似，大部分为萜醇类化合物，主要为牻牛儿醇(geraniol)，橙花醇(nerol)，香茅醇(citronellol)及其葡萄糖甙。另含没食子酸(gallicacid)，槲皮甙(quercitrin)，鞣质，色素等。"}]},{"ID":"20240830172339-bvwguvs","Type":"NodeParagraph","Properties":{"id":"20240830172339-bvwguvs","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【药理作用】月季花具有较强的抗真菌作用。在3%浓度时即对17种真菌有抗菌作用。已分离出其抗菌的有效成分是没食子酸。"}]},{"ID":"20240830172339-ahg713g","Type":"NodeParagraph","Properties":{"id":"20240830172339-ahg713g","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【鉴别】（1）取本品粗粉2g，加乙醚20ml，振摇浸泡1h，滤过。取滤液2ml置蒸发皿中，待乙醚挥发后加数滴5%香草醛浓硫酸液，深液即显紫褐色。（检查挥发油）（2）紫外色谱取本品醇浸液，用95%乙醇配成0.05%的溶液，置1cm比色池中，在UV-265Fw紫外分光亮度计上测定吸收曲线，扫描范围200-400nm，扫描速度60nm/min。结果于波长为208nm，265nm，293nm处有3个吸收峰。"}]},{"ID":"20240830172339-nrd2ile","Type":"NodeParagraph","Properties":{"id":"20240830172339-nrd2ile","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【炮制】净制：取原材料，除去杂质。炮炙：取净制材料晾干，或微火烘干即可。"}]},{"ID":"20240830172339-rtc5nk9","Type":"NodeParagraph","Properties":{"id":"20240830172339-rtc5nk9","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【性味】甘；温；无毒"}]},{"ID":"20240830172339-icfmy2w","Type":"NodeParagraph","Properties":{"id":"20240830172339-icfmy2w","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾经"}]},{"ID":"20240830172339-t9rfmjp","Type":"NodeParagraph","Properties":{"id":"20240830172339-t9rfmjp","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血调经；解毒消肿。主月经不调；痛经；闭经；跌打损伤；瘀血肿痛；瘰疬；痈肿；烫伤"}]},{"ID":"20240830172339-05kc0w7","Type":"NodeParagraph","Properties":{"id":"20240830172339-05kc0w7","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤或开水泡服，3-6g，鲜品9-15g。外用：适量，鲜品捣敷患处，或干品研末调搽患处。"}]},{"ID":"20240830172339-quzjxx2","Type":"NodeParagraph","Properties":{"id":"20240830172339-quzjxx2","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【注意】不宜久服；脾胃虚寒者及孕妇慎用。"}]},{"ID":"20240830172339-bkote91","Type":"NodeParagraph","Properties":{"id":"20240830172339-bkote91","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830172339-q93m534","Type":"NodeParagraph","Properties":{"id":"20240830172339-q93m534","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：活血消肿，敷毒。"}]},{"ID":"20240830172339-6jm8oye","Type":"NodeParagraph","Properties":{"id":"20240830172339-6jm8oye","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"2.《分类草药性》：止血。治红崩、白带。"}]},{"ID":"20240830172339-c2agdh5","Type":"NodeParagraph","Properties":{"id":"20240830172339-c2agdh5","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"3.《现代实用中药》：活血调经。治月经困难，月经期拘挛性腹痛。外用捣敷肿毒，能消肿止痛。"}]},{"ID":"20240830172339-zzkk3tf","Type":"NodeParagraph","Properties":{"id":"20240830172339-zzkk3tf","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"4.《泉州本草》：通经活血化瘀，清肠胃湿热，泻肺火，止咳，止血止痛，消痈毒。治肺虚咳嗽咯血，痢疾，瘰疬溃烂，痈疽肿毒，妇女月经不调。"}]},{"ID":"20240830172339-6b1nq73","Type":"NodeParagraph","Properties":{"id":"20240830172339-6b1nq73","updated":"20240830172402"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830172340-bdxhb5h","Type":"NodeThematicBreak","Properties":{"id":"20240830172340-bdxhb5h","updated":"20240830172402"}},{"ID":"20240830172341-g90omcc","Type":"NodeParagraph","Properties":{"id":"20240830172341-g90omcc","updated":"20240830172402"}}]}