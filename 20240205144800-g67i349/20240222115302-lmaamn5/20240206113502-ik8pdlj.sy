"width: 695px;\" parent-style=\"width: 705px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830163934-hxf9i4v","Type":"NodeParagraph","Properties":{"id":"20240830163934-hxf9i4v","updated":"20240830164012"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 593px;","style":"width: 583px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大血藤 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大血藤 17-20240711164949-1zwqaa5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 583px;\" parent-style=\"width: 593px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 643px;","style":"width: 633px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大血藤 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大血藤 18-20240711165052-fskzyyq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240711152720-t75dcb1","Type":"NodeParagraph","Properties":{"id":"20240711152720-t75dcb1","updated":"20240711152721"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240711152151-sywm07d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 840px;","style":"width: 830px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240711152721-iu9xnkh.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 830px;\" parent-style=\"width: 840px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240711145816-g4nupk6","Type":"NodeParagraph","Properties":{"id":"20240711145816-g4nupk6","updated":"20240711161451"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 408px;","style":"width: 398px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大血藤 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大血藤 1-20240711145816-jnh4giw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 398px;\" parent-style=\"width: 408px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 723px;","style":"width: 713px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大血藤 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大血藤 2-20240711150002-s0tzvny.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 713px;\" parent-style=\"width: 723px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240711163000-qn4xr1a","Type":"NodeParagraph","Properties":{"id":"20240711163000-qn4xr1a","updated":"20240830164002"},"Children":[{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 331px;","style":"width: 321px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大血藤 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大血藤 5-20240711150343-a2ewhwe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 321px;\" parent-style=\"width: 331px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240711145342-xpsd91r","Type":"NodeThematicBreak","Properties":{"id":"20240711145342-xpsd91r"}},{"ID":"20240830164049-cqqdect","Type":"NodeParagraph","Properties":{"id":"20240830164049-cqqdect","updated":"20240830164057"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：大血藤"}]},{"ID":"20240830164049-in4yw9j","Type":"NodeParagraph","Properties":{"id":"20240830164049-in4yw9j","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"大血藤《中国药典》"}]},{"ID":"20240830164049-rm6le3s","Type":"NodeParagraph","Properties":{"id":"20240830164049-rm6le3s","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【拼音名】DàXuèTénɡ"}]},{"ID":"20240830164049-d1eu1ad","Type":"NodeParagraph","Properties":{"id":"20240830164049-d1eu1ad","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【英文名】CAULISSARGENTODOXAE"}]},{"ID":"20240830164049-c18asba","Type":"NodeParagraph","Properties":{"id":"20240830164049-c18asba","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【别名】血通、红藤、槟榔钻、大血通、大活血"}]},{"ID":"20240830164049-9i8y1ll","Type":"NodeParagraph","Properties":{"id":"20240830164049-9i8y1ll","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【来源】本品为木通科植物大血藤Sargentodoxacuneata（Oliv.）Rehd.etWils.的干燥藤茎。秋、冬二季采收，除去侧枝，截段，干燥。"}]},{"ID":"20240830164049-zdbn03e","Type":"NodeParagraph","Properties":{"id":"20240830164049-zdbn03e","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈圆柱形，略弯曲，长30～60cm，直径1～3cm。表面灰棕色，粗糙，外皮常呈鳞片状剥落，剥落处显暗红棕色，有的可见膨大的节及略凹陷的枝痕或叶痕。质硬，断面皮部红棕色，有数处向内嵌入木部，木部黄白色，有多数细孔状导管，射线呈放射状排列。气微，味微涩。"}]},{"ID":"20240830164049-fayuc1g","Type":"NodeParagraph","Properties":{"id":"20240830164049-fayuc1g","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品横切面：木栓层为多列细胞，含棕红色物。皮层石细胞常数个成群，有的含草酸钙方晶。维管束外韧型。韧皮部分泌细胞常切向排列，与筛管群相间隔；有少数石细胞群散在。束内形成层明显。木质部导管多单个散在，类圆形，直径约至400μｍ，周围有木纤维。射线宽广，外侧石细胞较多，有的含数个草酸钙方晶。髓部可见石细胞群。薄壁细胞含棕色或棕红色物。"}]},{"ID":"20240830164049-2q46yng","Type":"NodeParagraph","Properties":{"id":"20240830164049-2q46yng","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240830164049-txgao6j","Type":"NodeParagraph","Properties":{"id":"20240830164049-txgao6j","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性味】苦，平。"}]},{"ID":"20240830164049-v2q1mgd","Type":"NodeParagraph","Properties":{"id":"20240830164049-v2q1mgd","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【归经】归大肠、肝经。"}]},{"ID":"20240830164049-hvbzrp4","Type":"NodeParagraph","Properties":{"id":"20240830164049-hvbzrp4","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，活血，祛风。用于肠痈腹痛，经闭痛经，风湿痹痛，跌扑肿痛。"}]},{"ID":"20240830164049-4xr3qs0","Type":"NodeParagraph","Properties":{"id":"20240830164049-4xr3qs0","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240830164049-pfmd418","Type":"NodeParagraph","Properties":{"id":"20240830164049-pfmd418","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。"}]},{"ID":"20240830164049-gpyryge","Type":"NodeParagraph","Properties":{"id":"20240830164049-gpyryge","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830164049-e9euogp","Type":"NodeParagraph","Properties":{"id":"20240830164049-e9euogp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"大血藤《*辞典》"}]},{"ID":"20240830164049-jywq3ph","Type":"NodeParagraph","Properties":{"id":"20240830164049-jywq3ph","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【出处】《简易草药》"}]},{"ID":"20240830164049-tdzjha2","Type":"NodeParagraph","Properties":{"id":"20240830164049-tdzjha2","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【拼音名】DàXuèTénɡ"}]},{"ID":"20240830164049-s1j64it","Type":"NodeParagraph","Properties":{"id":"20240830164049-s1j64it","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【英文名】SargentgloryvineStem"}]},{"ID":"20240830164049-ocmi82k","Type":"NodeParagraph","Properties":{"id":"20240830164049-ocmi82k","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【别名】血藤（《本草图经》），红皮藤（《任城日记》），千年健（《简易草药》），大活血（《植物名实图考》），五花血藤（《贵州民间方药集》），红藤、赤沙藤（《浙江中药手册》），蕨心藤（《广西中兽医药植》），活血藤、血通、血木通（《中药志》），穿尖龙、半血莲、过血藤、血灌肠、花血藤（《湖南药物志》），黄梗藤、八卦薛、黄鸡藤、血陈根、红牛鼻陈（《闽东本草》），山红藤（广州部队《常用中草药手册》），五花七、五花血通、大血通（《陕西中草药》），红血藤、黄省藤、鱼藤、红菊花心（《浙江民间常用草药》）。"}]},{"ID":"20240830164049-jvggqqp","Type":"NodeParagraph","Properties":{"id":"20240830164049-jvggqqp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【来源】为木通科植物大血藤的茎。8～9月采收，晒干，除去叶片，切段或切片。"}]},{"ID":"20240830164049-rxa3bc4","Type":"NodeParagraph","Properties":{"id":"20240830164049-rxa3bc4","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶攀援灌木，高达10米。茎褐色，圆形，有条纹，光滑无毛。3出复叶，互生；叶柄长，上面有槽；中间小叶菱状卵形，长7～12厘米，宽3～7厘米，先端尖，基部楔形，全缘，有柄；两侧小叶较中间者大，斜卵形，先端尖，基部两边不对称，内侧楔形，外侧截形或圆形，几无柄。花单性，雌雄异株，总状花序腋生，下垂，具苞片，花多数，芳香；雄花黄色，花萼6片，长圆形，花瓣小，6片，菱状圆形，雄蕊6枚，花丝极短；雌花与雄花同；而有不发育雄蕊6枚，子房上位，1室，有1胚珠。浆果卵圆形。种子卵形，黑色，有光泽。花期3～5月。果期8～10月。"}]},{"ID":"20240830164049-26d86ij","Type":"NodeParagraph","Properties":{"id":"20240830164049-26d86ij","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于林下、溪边。分布河南、安徽、江苏，浙江、江西、福建、广东，广西、湖南、湖北、四川、贵州、陕西等地。产湖北、四川、江西，河南、江苏、浙江、安徽等地。"}]},{"ID":"20240830164049-6fl7ikn","Type":"NodeParagraph","Properties":{"id":"20240830164049-6fl7ikn","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性状】干燥茎呈圆柱形，略弯曲，通常截成长约30厘米的段状，直径1～3厘米。外表棕色或灰棕色，粗糙，具有浅的纵槽纹及明显的横裂纹，有时可见膨大的节部及略凹陷的枝痕或叶柄痕，栓皮常呈鳞片状开裂，脱落处露出淡红棕色的内皮部。质坚韧，有弹性，折断面裂片状；平整的横切面，本质部黄白色，导管呈细孔状，髓射线棕红色，放射状排列。气异香，味淡微涩。以条匀、径粗者佳。"}]},{"ID":"20240830164049-j9yajbu","Type":"NodeParagraph","Properties":{"id":"20240830164049-j9yajbu","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸泡，洗净泥屑，润进，切片，晒干。"}]},{"ID":"20240830164049-g9nrw7x","Type":"NodeParagraph","Properties":{"id":"20240830164049-g9nrw7x","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830164049-fract4w","Type":"NodeParagraph","Properties":{"id":"20240830164049-fract4w","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"苦，平。"}]},{"ID":"20240830164049-g4gvhed","Type":"NodeParagraph","Properties":{"id":"20240830164049-g4gvhed","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"①《浙江民间草药》：\"性平，味酸涩。\""}]},{"ID":"20240830164049-uatx9a0","Type":"NodeParagraph","Properties":{"id":"20240830164049-uatx9a0","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"②《四川中药志》：\"性凉，味苦，无毒。\""}]},{"ID":"20240830164049-s5lw55r","Type":"NodeParagraph","Properties":{"id":"20240830164049-s5lw55r","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【归经】《四川中药志》：\"入肝。大肠二经。\""}]},{"ID":"20240830164049-g73oxht","Type":"NodeParagraph","Properties":{"id":"20240830164049-g73oxht","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830164049-6kdjjfh","Type":"NodeParagraph","Properties":{"id":"20240830164049-6kdjjfh","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"败毒消痈，活血通络，祛风杀虫。治急、慢性阑尾炎，风湿痹痛，赤痢，血淋，月经不调，疳积，虫痛，跌扑损伤。清热解毒，活血，祛风。用于肠痈腹痛、经闭痛经、风湿痹痛、跌打扑痛。"}]},{"ID":"20240830164049-84x34qf","Type":"NodeParagraph","Properties":{"id":"20240830164049-84x34qf","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"①《本草图经》：\"攻血，治血块。\""}]},{"ID":"20240830164049-lp88bfv","Type":"NodeParagraph","Properties":{"id":"20240830164049-lp88bfv","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"②《简易草药》：\"治筋骨疼痛，追风，健腰膝，壮阳事。\""}]},{"ID":"20240830164049-kjc5y2i","Type":"NodeParagraph","Properties":{"id":"20240830164049-kjc5y2i","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"③《中药志》：\"祛风通经络，利尿杀虫。治肠痈，风湿痹痛，麻风，淋病：蛔虫腹痛。\""}]},{"ID":"20240830164049-12o71jt","Type":"NodeParagraph","Properties":{"id":"20240830164049-12o71jt","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"④《湖南药物志》：\"通经补血，强筋壮骨，驱虫。治跌打损伤，风湿疼痛，血晕，血淋，筋骨疼痛，疮疖，血丝虫病。\""}]},{"ID":"20240830164049-ezjgv06","Type":"NodeParagraph","Properties":{"id":"20240830164049-ezjgv06","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑤《闽东本草》\"治心腹绞痛，赤白痢疾。\""}]},{"ID":"20240830164049-03j33bv","Type":"NodeParagraph","Properties":{"id":"20240830164049-03j33bv","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑥广州部队《常用中草药手册》：\"治肢节酸痛，麻木拘挛，水肿，血虚头昏。\""}]},{"ID":"20240830164049-jthrfq9","Type":"NodeParagraph","Properties":{"id":"20240830164049-jthrfq9","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑦《陕西中草药》：\"抗菌消炎，消肿散结，理气活血，祛风杀虫。治阑尾炎，月经不调，崩漏，小儿疳积，蛔虫、蛲虫症。\""}]},{"ID":"20240830164049-pne6mmu","Type":"NodeParagraph","Properties":{"id":"20240830164049-pne6mmu","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；研末或浸酒。外用：捣敷。"}]},{"ID":"20240830164049-i1ewf1k","Type":"NodeParagraph","Properties":{"id":"20240830164049-i1ewf1k","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【注意】《闽东本草》：\"孕妇不宜多服。\""}]},{"ID":"20240830164049-xb1rylk","Type":"NodeParagraph","Properties":{"id":"20240830164049-xb1rylk","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830164049-9z5p59m","Type":"NodeParagraph","Properties":{"id":"20240830164049-9z5p59m","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"①治肠痈，生于小肚角，微肿而小腹隐痛不止者是，若毒气不散，渐大，内攻而溃，则成大患：红藤一两许，以好酒二碗，煎一碗，午前一服，醉，卧之。午后用紫花地丁一两许，亦如前煎服，服后痛必渐止为效。然后以当归五钱，蝉退、僵蚕各二钱，天龙、大黄各一钱，石礍蚆五钱（此草药），老蜘蛛二个（捉放新瓦上，以酒钟盖定，外用火煅干存性），共为末，每空心用酒调送一钱许，日逐渐服自消。（《景岳全书》）"}]},{"ID":"20240830164049-godw5fi","Type":"NodeParagraph","Properties":{"id":"20240830164049-godw5fi","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"②治急、慢性阑尾炎，阑尾脓肿：红藤二两，紫花地丁一两。水煎服。（《浙江民间常用草药》）"}]},{"ID":"20240830164049-ekhtrzv","Type":"NodeParagraph","Properties":{"id":"20240830164049-ekhtrzv","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"③治风湿筋骨疼痛，经闭腰痛：大血藤六钱至一两。水煎服。（《湖南农村常用中草药手册》）"}]},{"ID":"20240830164049-gg1jdir","Type":"NodeParagraph","Properties":{"id":"20240830164049-gg1jdir","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"④治风湿腰腿痛：虹藤、牛膝各三钱，青皮、长春七、朱砂七各二钱，水煎服。（《陕西中草药》）"}]},{"ID":"20240830164049-zvblunr","Type":"NodeParagraph","Properties":{"id":"20240830164049-zvblunr","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑤治肠胃炎腹痛：大血藤三至五钱，水煎服。（《浙江民间常用草药》）"}]},{"ID":"20240830164049-iw8elw4","Type":"NodeParagraph","Properties":{"id":"20240830164049-iw8elw4","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑥治钩虫病：大血藤、钩藤、喇叭花、凤叉蕨各三钱，水煎服。（《湖南农村常用中草药手册》）"}]},{"ID":"20240830164049-4br71x1","Type":"NodeParagraph","Properties":{"id":"20240830164049-4br71x1","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑦治小儿疳积，蛔虫或蛲虫症：红藤五钱，或配红石耳五钱，共研细末，拌白糖食。（《陕西中草药》）"}]},{"ID":"20240830164049-w3juchc","Type":"NodeParagraph","Properties":{"id":"20240830164049-w3juchc","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑧治小儿蛔虫腹痛：红藤根研粉，每次吞服一钱半。（《浙江中医杂志》6：1959）"}]},{"ID":"20240830164049-39t187f","Type":"NodeParagraph","Properties":{"id":"20240830164049-39t187f","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑨治跌打损伤：大血藤，骨碎补各适量共捣烂，敷伤处。（《湖南农村常用中草药手册》）"}]},{"ID":"20240830164049-wb65jou","Type":"NodeParagraph","Properties":{"id":"20240830164049-wb65jou","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑩治血虚经闭：大血藤五钱，益母草三钱，叶下红四钱，香附二钱。水煎，配红砂糖适量调服。（《闽东本草》）"}]},{"ID":"20240830164049-2527gfp","Type":"NodeParagraph","Properties":{"id":"20240830164049-2527gfp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑾治血崩：红藤、仙鹤草、茅根各五钱。水煎服。（《湖南药物志》）"}]},{"ID":"20240830164049-gfsbltq","Type":"NodeParagraph","Properties":{"id":"20240830164049-gfsbltq","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830164049-b3ol9ru","Type":"NodeParagraph","Properties":{"id":"20240830164049-b3ol9ru","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"①治疗急性阑尾炎"}]},{"ID":"20240830164049-qi6aolm","Type":"NodeParagraph","Properties":{"id":"20240830164049-qi6aolm","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"以红藤为主，配合其它清热解毒及活血化瘀药物组成复方治疗。初步观察对急性阑尾炎、阑尾脓肿有较好疗效。上海地区用复方红藤片（每12片含红藤2两、蒲公英1两、生大黄6钱、川朴3厘）内服，每日3次，每次4片（大便次数增多者剂量可减半），先后治疗急性单纯性、早期化脓性阑尾炎1213例。其中首批观察354例，有效率达98％，服药后在3～4天内腹肌紧张、腹痛、触痛均消失，平均在2天和2.5天白细胞和体温分别恢复正常；其后观察的859例，有效率亦达90％。随访146例（时间最长为治疗后11个月，最短为6个月），除25例复发（17.1％）外，余均良好。复发后有14例作手术治疗，11例继续服中、西药物治愈。"}]},{"ID":"20240830164049-02nrdnp","Type":"NodeParagraph","Properties":{"id":"20240830164049-02nrdnp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"②治疗胆道蛔虫病"}]},{"ID":"20240830164049-02gzkso","Type":"NodeParagraph","Properties":{"id":"20240830164049-02gzkso","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"以红藤1两，加黄酒4两，煎至60毫升为1剂。成人日服2次，每次1剂。小儿用量酌减。初步观察5例，分别于服药1～4日后腹痛消失；治疗期间有4例排出蛔虫。"}]},{"ID":"20240830164049-pk259xq","Type":"NodeParagraph","Properties":{"id":"20240830164049-pk259xq","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"③治疗瘤型麻风结节反应"}]},{"ID":"20240830164049-n1g1jj0","Type":"NodeParagraph","Properties":{"id":"20240830164049-n1g1jj0","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"红藤1斤，研粉，制成丸剂，日服2次，每次3钱，或用红藤根1斤切片，白酒10斤浸泡10～20天，每次服10～20毫升，每日3次。分别治疗瘤型麻风结节反应18例和38例，服药后症状均减轻而渐消失。"}]},{"ID":"20240830164049-4v1chnj","Type":"NodeParagraph","Properties":{"id":"20240830164049-4v1chnj","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"④治疗风湿性关节炎"}]},{"ID":"20240830164049-il38z2z","Type":"NodeParagraph","Properties":{"id":"20240830164049-il38z2z","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"用大血藤、透骨香、香樟根各1两，水煎，两次分服，每日1剂。连服数天可见关节红肿消退，疼痛减轻。"}]},{"ID":"20240830164049-0xphzgi","Type":"NodeParagraph","Properties":{"id":"20240830164049-0xphzgi","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"⑤治疗灼伤"}]},{"ID":"20240830164049-7yd2ilu","Type":"NodeParagraph","Properties":{"id":"20240830164049-7yd2ilu","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"以大血藤、金樱子根各1斤，水煎成500毫升，对已发生感染的创面可行湿敷，能促使创面清洁，加速愈合。"}]},{"ID":"20240830164049-x9ezvt7","Type":"NodeParagraph","Properties":{"id":"20240830164049-x9ezvt7","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【备注】本品在华北、东北、中南地区作鸡血藤使用。"}]},{"ID":"20240830164049-ibc9tn6","Type":"NodeParagraph","Properties":{"id":"20240830164049-ibc9tn6","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830164049-0lputl0","Type":"NodeParagraph","Properties":{"id":"20240830164049-0lputl0","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"大血藤《中华本草》"}]},{"ID":"20240830164049-9ovuc84","Type":"NodeParagraph","Properties":{"id":"20240830164049-9ovuc84","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【出处】出自《简易草药》。"}]},{"ID":"20240830164049-tbmzavi","Type":"NodeParagraph","Properties":{"id":"20240830164049-tbmzavi","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【拼音名】DàXuèTénɡ"}]},{"ID":"20240830164049-bvo8t9g","Type":"NodeParagraph","Properties":{"id":"20240830164049-bvo8t9g","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【英文名】StemofSargentgloryvine"}]},{"ID":"20240830164049-jto5vqo","Type":"NodeParagraph","Properties":{"id":"20240830164049-jto5vqo","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【别名】血藤、过山龙、红藤、千年健、血竭、见血飞、血通、大活血、黄省藤、红血藤、血木通、五花血藤、血灌肠、花血藤、赤沙藤、山红藤、活血藤。"}]},{"ID":"20240830164049-haktu2p","Type":"NodeParagraph","Properties":{"id":"20240830164049-haktu2p","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830164049-81jbw65","Type":"NodeParagraph","Properties":{"id":"20240830164049-81jbw65","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"药材基源：为木通科植物大血藤的茎。"}]},{"ID":"20240830164049-vguvpnx","Type":"NodeParagraph","Properties":{"id":"20240830164049-vguvpnx","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sargentodoxacuneata(Oliv.)Rehd.etWils."}]},{"ID":"20240830164049-u68pj65","Type":"NodeParagraph","Properties":{"id":"20240830164049-u68pj65","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"采收和储藏：8-9月采收，除去枝叶，洗净，切段长约30-60cm，或切片，晒干。"}]},{"ID":"20240830164049-fm5g07a","Type":"NodeParagraph","Properties":{"id":"20240830164049-fm5g07a","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【原形态】大血藤落叶木质藤本，长达10m。茎圆柱子形，褐色扭曲，砍断时有红色液汁掺出。三出复叶互生；有长柄；中间小叶倒卵形，长7-12cm，宽3-7cm，侧生小叶较大，斜卵形，先端尖，基部两侧不对称。花单性，雌异株，总状花序出自上年生叶腋基部，长达12cm，下垂；萼片6；花瓣6，黄色；雄花有雄蕊6个，花瓣对生；雌花有退化雄蕊6个，心皮多数，离生，螺旋排列，胚珠1粒。浆果肉质具果柄，多数着生于一球形花托上。种子卵形，黑色，有光泽。花期3-5月，果熟期8-10月。"}]},{"ID":"20240830164049-e9xb0h5","Type":"NodeParagraph","Properties":{"id":"20240830164049-e9xb0h5","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830164049-2xwc34x","Type":"NodeParagraph","Properties":{"id":"20240830164049-2xwc34x","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"生态环境：生于深山疏林、大山沟畔肥沃土壤的灌木丛中。"}]},{"ID":"20240830164049-7klzy0s","Type":"NodeParagraph","Properties":{"id":"20240830164049-7klzy0s","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于中南及陕西、安徽、江苏、浙江、江西、福建、四川、贵州、云南等地。"}]},{"ID":"20240830164049-hxqz0mp","Type":"NodeParagraph","Properties":{"id":"20240830164049-hxqz0mp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【栽培】1.气候土壤以低山地区的溪沟两旁和林边，土层深厚肥沃，排水良好的坡地为宜。2.种植一般以压条繁殖为主。四川地区在冬季落叶后，把母株较长的茎藤分枝，分别绕成直径约30cm的圈，每枝1圈，在株旁开穴，把圈斜放穴里，然后盖土压紧，使半圈埋入土里，半圈露在地面，以利在土中的一半能够生根，露出地面的一半能够长出新的枝条。至来年冬季将所压枝条挖起，按照根的生长情况，将其剪断，使成单株。然后在选好的土地上，按株行距1-1.4米开穴，穴要深大，以能把新株茎藤栽入2/3长较好。栽后覆土打紧，并适当浇水。3.林边成片栽培的第1、2年内，适当中耕除草，追肥。"}]},{"ID":"20240830164049-6xlmdso","Type":"NodeParagraph","Properties":{"id":"20240830164049-6xlmdso","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830164049-yr0c8zn","Type":"NodeParagraph","Properties":{"id":"20240830164049-yr0c8zn","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"性状鉴别茎圆柱形，略弯曲，通弯曲，长30-60cm，直径1-3cm。表面灰棕色，粗糙，外皮常呈鳞片状剥处显暗红棕色，有的可见膨大的节及略凹陷的枝痕或叶痕。质硬，断面皮部红棕色，有数处向内嵌入木部，木部黄白色，有多数细孔状异管，散孔型排列，射线呈放射状。气微，味微涩。"}]},{"ID":"20240830164049-5lvhgo7","Type":"NodeParagraph","Properties":{"id":"20240830164049-5lvhgo7","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面：木栓层为多列面胞，细胞含棕红色物。皮层石细胞常数个成群，有的含草酸钙方晶。维管束外韧型。韧皮部分泌细胞常切向排列，与筛管群相间隔；有少数石细胞群散在。束内形成层明显。木质部导管多单个散在，类圆形，直径约400μm，周围有木纤维。射线宽广，外侧石细胞较多，有的含数个草酸钙方晶。髓部可见石细胞群。薄壁细胞含棕色或棕红色物。"}]},{"ID":"20240830164049-aq1pe3p","Type":"NodeParagraph","Properties":{"id":"20240830164049-aq1pe3p","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【化学成份】大血藤含大黄素（emodin），大黄素甲醚（physcion），β-谷甾醇（β-sitosterol），胡萝卜甙（daucsterol），硬脂酸(stearicacid)，毛柳甙（salidroside），右旋丁香树脂酚二葡萄糖甙（syringaresinolbisglucoside），右旋二氢愈创木脂酸（dihydroguaiareticacid），大黄酚（chrysophanol），香草酸（vanillicacid)，原儿茶酸(protocatechuicacid)以及对香豆酸-对羟基苯乙醇酯（p-hydroxyhenylethylcoumarate）和红藤多糖。"}]},{"ID":"20240830164049-j7n03s7","Type":"NodeParagraph","Properties":{"id":"20240830164049-j7n03s7","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830164049-8gkfehc","Type":"NodeParagraph","Properties":{"id":"20240830164049-8gkfehc","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.对心血管系统的影响1.1对离体蟾蜍心脏的作用按八木氏离体心脏装置，以20ml任氏液灌流，将0.1g大血藤加入灌流液中（0.5%），发现对离体心脏呈轻度抑制，表现心缩力减弱，心率减慢（P＜0.05），心输出量减少（P\u003c0.01）。"}]},{"ID":"20240830164049-3z0ege0","Type":"NodeParagraph","Properties":{"id":"20240830164049-3z0ege0","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.2对离体家兔主动脉条的作用将离体家兔的主动脉条，在离体装置水槽中（37±0.5度）放置lh，0.2ml提取液（1g生药/ml）加入20ml克氏液中（1%），结果血管开始出现明显的收缩作用，该作用可被酚妥拉明阻断，提示其收缩作用可能与a-受体有关。随后又渐出现持久的松驰作用。"}]},{"ID":"20240830164049-1evp0lu","Type":"NodeParagraph","Properties":{"id":"20240830164049-1evp0lu","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.3对离体猪冠状动脉的作用实验方法同上，以0.2ml提取物加入20ml克氏液中，以去甲肾上腺素与氯化钾作正负反应对照，出小时的作用与家兔主动脉条相似。但在氯化钾引起的收缩状态下，加入药物，则收缩作用不再出现，而且立即使血管松弛，提示对治疗冠脉痉挛有利。"}]},{"ID":"20240830164049-6sl91e4","Type":"NodeParagraph","Properties":{"id":"20240830164049-6sl91e4","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.4对动物实验性心肌梗塞的影响1.4.1血藤水溶性提取物对家兔实验性心肌梗塞的影响大血藤水溶性提取物（中药用95%乙醇冷浸，减压浓缩，乙醚提取去除醚溶性物质，糖浆状沉淀加水至沉淀不再发生，滤去沉淀，加明胶溶液至沉淀不再产生，水溶液减压浓缩成糖浆状，甲醇提取，甲醇不溶物，制成水溶剂，内含糖类与甙类）。取健康家兔24只，随机分3组，对照组（等容量生理盐水），大血藤水溶性提取物组（100mg/kg；相当原生药100g），心得安组（0.05mg/kg）。用戊巴比妥钠（300mg/kg）iv麻醉，进行胸前多导联心电图标测。开胸，在左前降支的根部用4号丝线结扎。关胸，描记胸前心电图后立即iv药物，以后每隔6小时推注1次，共4次。在结扎后4小时及24小时再分别进行心电图标测。24小时际测后取出心脏，计算心梗范围的百分率，结果各组家兔在结扎左前降支后4小时，大血藤组与心得安组心电图ST段抬高的总毫伏数（∑△ST）相似，两组均明显低于对照组（P＜0.05。在结扎后24小时差异更为显着（P＜0.01。在结扎后24小时，大血藤组的心梗范围缩小为19.17%，同心得安组19.88%相似，与对照组比较，差异均极其显着P＜0.001。同时又进行了心肌梗塞家兔中心肌乳酸含量的测定：42只家兔分4组，即正常组不结扎左前降支，也不给任何药物，其他3组结扎左前降支，并在描记心电图后，心肌梗塞组ivlmg/kg生理盐水，大血藤组ivl00mg/kg体重，心得安组iv心得安0.05mg/kg体重。每次实验同时测定4组家兔心肌组织内乳酸含量。结果在给药前，心肌梗塞对照组、大血藤组和心得安组的平均∑△ST差异不显着（P＞0.05）。揭示结扎左前降支所致的心肌缺血程度3组间可能基本相似。心肌梗塞动物给生理盐水或药物后l小时，心肌梗塞组在心梗后l小时，心肌组织中乳酸含量显着增加，而大血藤组和心得安组均不增加（与正常组心肌乳酸含量相似），差异极其显着（P＜0.001），由此表明大血藤水溶性提取物能改善心肌乳酸代谢的紊乱。"}]},{"ID":"20240830164049-glev6q7","Type":"NodeParagraph","Properties":{"id":"20240830164049-glev6q7","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.4.2大血藤水溶性提取物对狗实验性心肌梗塞的影响实验用杂种狗19只，随机分为3组：心肌梗塞对照组，在结扎左前降支后不用任何药物治疗；大血藤组，在结扎左前降支的同时，ivl00mg/kg，以后每隔6小时重复1次，共4次；心得安组，在结扎左前降支的同时，iv心得安0.5mg/kg，以后每隔6小时注射1次，共4次。结果表明，大血藤组在结扎左前降支后5分钟心外膜心电图ST段与对照组一样明显抬高，无明显差别P＜0.05。但抬高的ST段恢复较快，在结扎后30分钟，与对照组相比，有明显差别，P＜0.05。与心得安组比较，大血藤的作用较缓慢而弱。大血藤组对结扎后30分钟的心率和股动脉血压影响不大，但左心室峰压下降和左心室舒末压上升，两者变化幅度与对照组相比，差别显着P＜0.05。血液乳酸含量结果与心肌梗塞家兔心肌组织中乳酸含量的变化一致。心梗范围，大血藤组心梗范围缩小，与对照组比较，差异极其显着P＜0.001。心得安组效果更为明显，但与大血藤组比较无显着差异P＜0.05。"}]},{"ID":"20240830164049-hcylnq2","Type":"NodeParagraph","Properties":{"id":"20240830164049-hcylnq2","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.4.3红藤水溶性提取物100mg/kg静脉注射，能使兔实验性心肌梗塞已抬高的ST段显着下降，改善结扎左冠状动脉前降支所致的心肌乳酸代谢紊乱，并缩小心肌梗塞范围。"}]},{"ID":"20240830164049-0519gvd","Type":"NodeParagraph","Properties":{"id":"20240830164049-0519gvd","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.5大血藤水溶性提取物对异丙肾上腺素（ISO）诱导的大鼠心肌缺血的作用大鼠体重150-200g,按体重随机分为用药组（毛柳甙、Lriodendrin、多糖均为5mg/kg，普萘洛尔2mg/kg）及对照组为生理盐水（NS），每只0.5mL,共5组，每组15只。Ip给药30-40分钟后，麻醉并将四肢与心电图机联接，测定肢体标准导联Ⅱ的EKG后，给ISO4mg/kg（ip）观察1、5、10、30、60分钟时EKG的变化。24小时后，按前一天给药、记录的顺序重复一遍。48小时后麻醉、测EKG后即开胸取心，制片，进行病理学检查。结果大血藤多糖对EKG变化的影响，dlP＜0.05，d2P＜0.01。要能具有潜在的治疗意义，病理检查对心肌坏死的保护作用最强（P＜O.01）。Liriodendrin对EKG的作用弱且慢，到d2才出现差别（P＜0.05），病理检查也有保护作用（P＜0.05）。毛柳甙组与盐水对照组之间无统计学差别。植物性多糖主要具有增强或抑制免疫功能，过去未见有抗心肌缺血的报道。其作用机理值得进一步探讨。"}]},{"ID":"20240830164049-f40mxjt","Type":"NodeParagraph","Properties":{"id":"20240830164049-f40mxjt","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"1.6对麻醉猫血压的影响健康猫4只,麻醉后按常规切开气管，插气管套管，分离颈动脉测血压，股iv0.1g/kg大血藤水提液（1g生药相当1ml）后，出现一过性的降压作用，该作用可被阿托品阻断；切除两测迷走神经，降压作用无影响，提示其降压作用要能与外周胆碱能系统有关。"}]},{"ID":"20240830164049-dxeeuxv","Type":"NodeParagraph","Properties":{"id":"20240830164049-dxeeuxv","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"2.对小鼠血浆中环核苷酸的影响取健康雄豚鼠，体重18-24g，分3组，每组5只，第1组每天ip大血藤水提物3g/kg（相当1/4LD50），第2组每天ip丹参素200mg/kg，第3组每天ip生理盐水作对照，连续7日，在最后一天给药后l小时,眼眶取血，测定血浆中cAMP和cGMP量。结果大血藤组和丹参组血浆中cAMP量均明显增加，cCMP量减少不明显。另取小鼠，每组5只，1次ip3g/kg，每隔15、30、90和120分钟，分别从眼眶采血，每组有生理盐水对照。观察不同时间血浆中cAMP和cGMP的变化规律。结果表明在给药后50分钟内，cAMP和cGMP量均上升，其中cAMP增加更明显。cAMP/cGMP值下降，但在60分钟后，cAMP与cCMP量均逐渐下降，cAMP/cGMP值上升。红藤水溶性提取物100mg/kg,使兔血浆cAMP明显增加。"}]},{"ID":"20240830164049-f3o2udj","Type":"NodeParagraph","Properties":{"id":"20240830164049-f3o2udj","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"3.对血小板聚集的影响红藤水溶性提取物体外试验对ADP诱导的兔的兔血小板聚集有明显的抑制和促进解聚作用，ID50为14.6mg/ml。红藤水溶性提取物40、100mg/kg对大鼠ADP诱发的血小板聚集有抑制作用。本品二氯甲烷的提取部位，包括二氢愈创木脂酸在内，能抑制PAF（血小板活化因子）与受体相结合。"}]},{"ID":"20240830164049-bycl0mc","Type":"NodeParagraph","Properties":{"id":"20240830164049-bycl0mc","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"4.对小鼠常压下耐缺氧的影响取健康雄小鼠，体重17-22g，分3组，每组10只，大血藤水提物2g（相当生药）/kg，小鼠ip的LD50为l1.83±2.12g/kg），对照用同体积生理盐水，定时观察，以呼吸停止为死亡指标，结果表明在不同间隔时间均有明显作用。"}]},{"ID":"20240830164049-7jvvtdx","Type":"NodeParagraph","Properties":{"id":"20240830164049-7jvvtdx","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"5.抑菌作用用平碟法试验，25%煎剂对金黄色葡萄球菌、乙型链球菌有极敏感抑菌作用，对大肠杆菌、绿脓杆菌、甲型链球菌、卡他球菌、白色葡萄球菌均有高敏感抑菌作用。"}]},{"ID":"20240830164049-5bubd4b","Type":"NodeParagraph","Properties":{"id":"20240830164049-5bubd4b","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"6.对动物胃肠道平滑肌的作用将小鼠或豚鼠离体肠段，置于20ml不断通空气的洛氏液中，1%及5%大血藤对小鼠肠段当明显的抑制作用。而对豚鼠只需0.5%及2.5%即表现先兴奋后抑制作用，大剂量时还能减弱乙酰胆碱的作用。对小鼠肠蠕动实验表明5-10g/kg的大血藤水提液均能显着抑制小鼠肠蠕动速度。"}]},{"ID":"20240830164049-p6ywuuo","Type":"NodeParagraph","Properties":{"id":"20240830164049-p6ywuuo","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"7.其它作用本品与丹皮合用可预防实验动物的腹腔内粘连。毛柳甙有抗疲劳作用；Liriodendrin有抑制cAMP磷酸二酯酶的作用。"}]},{"ID":"20240830164049-14hv8i5","Type":"NodeParagraph","Properties":{"id":"20240830164049-14hv8i5","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸泡，洗净泥屑，润透，切片，晒干。"}]},{"ID":"20240830164049-v4xgxov","Type":"NodeParagraph","Properties":{"id":"20240830164049-v4xgxov","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【性味】苦；平；无毒"}]},{"ID":"20240830164049-ped3kkh","Type":"NodeParagraph","Properties":{"id":"20240830164049-ped3kkh","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【归经】肝；大肠经"}]},{"ID":"20240830164049-bi8pdbi","Type":"NodeParagraph","Properties":{"id":"20240830164049-bi8pdbi","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【功能主治】解毒消痈；活血止痛；祛风除湿；杀虫。主肠痈；痢疾；乳痛；痛经；经闭；跌打损伤；风湿痹痛；虫积腹痛"}]},{"ID":"20240830164049-k57u2tb","Type":"NodeParagraph","Properties":{"id":"20240830164049-k57u2tb","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g；或酒煮、浸酒。外用：适量；捣烂敷患处。"}]},{"ID":"20240830164049-nkkal5x","Type":"NodeParagraph","Properties":{"id":"20240830164049-nkkal5x","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇慎服。"}]},{"ID":"20240830164049-qxkjdfi","Type":"NodeParagraph","Properties":{"id":"20240830164049-qxkjdfi","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【各家论述】1.《本草图经》：攻血，治血块。2.《简易草药》：治筋骨疼痛，追风，健腰膝，壮阳事。3.《中药志》：祛风通经络，利尿杀虫。治肠痈，风湿痹痛，麻风，淋病，蛔虫腹痛。4.《湖南药物志》：通经补血，强筋壮骨，驱虫。治跌打损伤，风湿疼痛，血晕，血淋，筋骨疼痛，疮疖，血丝虫病。5.《闽东本草》：治心腹绞痛，赤白痢疾。6.广州部队《常用中草药手册》：治肢节酸痛，麻木拘挛，水肿，血虚头昏。7.《陕西中草药》：抗菌消炎，消肿散结，理气活血，祛风杀虫。治阑尾炎，月经不调，崩漏，小儿疳积，蛔虫、蛲虫症。8.《植物名实图考》：大血藤，今江西庐山多有之。蔓生，紫茎，一枝三叶，宛如一叶擘分，或半边圆，或有角而方，无定形，光滑厚韧。根长数尺，外紫内白。有菊花心，掘出曝之，紫液津润。浸酒一宿，艳红如血。"}]},{"ID":"20240830164049-mxt32yp","Type":"NodeParagraph","Properties":{"id":"20240830164049-mxt32yp","updated":"20240830164123"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830164050-wi7d1bf","Type":"NodeThematicBreak","Properties":{"id":"20240830164050-wi7d1bf","updated":"20240830164123"}},{"ID":"20240830164051-oij4oo8","Type":"NodeParagraph","Properties":{"id":"20240830164051-oij4oo8","updated":"20240830164123"}}]}