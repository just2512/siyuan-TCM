ldren":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"断肠草、金银花对比"}]},{"ID":"20240714094134-gz0kj5n","Type":"NodeParagraph","Properties":{"id":"20240714094134-gz0kj5n","updated":"20240714094134"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"金银花 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/金银花 4-20240714092426-uzxyfbg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714091834-ezyiu5y","Type":"NodeParagraph","Properties":{"id":"20240714091834-ezyiu5y","updated":"20240714091842"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：忍冬藤即金银花的藤。"}]},{"ID":"20240714091832-6re7vo9","Type":"NodeThematicBreak","Properties":{"id":"20240714091832-6re7vo9"}},{"ID":"20240830170522-dem9man","Type":"NodeParagraph","Properties":{"id":"20240830170522-dem9man","updated":"20240830170530"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：忍冬藤"}]},{"ID":"20240830170522-3rqczk8","Type":"NodeParagraph","Properties":{"id":"20240830170522-3rqczk8","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"忍冬藤《中国药典》"}]},{"ID":"20240830170522-xp0o7p6","Type":"NodeParagraph","Properties":{"id":"20240830170522-xp0o7p6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【拼音名】RěnDōnɡTénɡ"}]},{"ID":"20240830170522-dmqgcxh","Type":"NodeParagraph","Properties":{"id":"20240830170522-dmqgcxh","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【英文名】CAULISLONICERAE"}]},{"ID":"20240830170522-wn6hfwg","Type":"NodeParagraph","Properties":{"id":"20240830170522-wn6hfwg","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【别名】忍冬、银花藤、金银藤"}]},{"ID":"20240830170522-d7j3q6k","Type":"NodeParagraph","Properties":{"id":"20240830170522-d7j3q6k","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【来源】本品为忍冬科植物忍冬LonicerajaponicaThunb.的干燥茎枝。秋、冬二季采割，晒干。"}]},{"ID":"20240830170522-zccvoo7","Type":"NodeParagraph","Properties":{"id":"20240830170522-zccvoo7","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈长圆柱形，多分枝，常缠绕成束，直径1.5～6mm。表面棕红色至暗棕色，有的灰绿色，光滑或被茸毛；外皮易剥落。枝上多节，节间长6～9cm，有残叶及叶痕。质脆，易折断，断面黄白色，中空。无臭，老枝味微苦，嫩枝味淡。"}]},{"ID":"20240830170522-hpz5ys3","Type":"NodeParagraph","Properties":{"id":"20240830170522-hpz5ys3","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，洗净，闷润，切段，干燥。"}]},{"ID":"20240830170522-ykxtbgv","Type":"NodeParagraph","Properties":{"id":"20240830170522-ykxtbgv","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性味】甘，寒。"}]},{"ID":"20240830170522-aqgujov","Type":"NodeParagraph","Properties":{"id":"20240830170522-aqgujov","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、胃经。"}]},{"ID":"20240830170522-pa5jqys","Type":"NodeParagraph","Properties":{"id":"20240830170522-pa5jqys","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，疏风通络。用于温病发热，热毒血痢，痈肿疮疡，风湿热痹，关节红肿热痛。"}]},{"ID":"20240830170522-v4ah6bb","Type":"NodeParagraph","Properties":{"id":"20240830170522-v4ah6bb","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～30g。"}]},{"ID":"20240830170522-kysboxw","Type":"NodeParagraph","Properties":{"id":"20240830170522-kysboxw","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240830170522-to3xlz5","Type":"NodeParagraph","Properties":{"id":"20240830170522-to3xlz5","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240830170522-6g15zmo","Type":"NodeParagraph","Properties":{"id":"20240830170522-6g15zmo","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"忍冬藤《*辞典》"}]},{"ID":"20240830170522-ckbdo9z","Type":"NodeParagraph","Properties":{"id":"20240830170522-ckbdo9z","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【出处】《本草经集注》"}]},{"ID":"20240830170522-mh4i7tg","Type":"NodeParagraph","Properties":{"id":"20240830170522-mh4i7tg","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【拼音名】RěnDōnɡTénɡ"}]},{"ID":"20240830170522-j4ykzo6","Type":"NodeParagraph","Properties":{"id":"20240830170522-j4ykzo6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【别名】老翁须、金钗股、大薜荔、水杨藤、千金藤（《苏沈良方》），鸳鸯草（《墨庄漫录》），鹭鸶藤（《履巉岩本草》），忍冬草（《证治要诀》），左缠藤（《余居士选奇方》），忍寒草（《集验方\"\u003e洪氏集验方》），通灵草、蜜桶藤（《土宿本草》），金银花藤（《丹溪心法》），金银藤（《乾坤生意秘韫》），金银花杆（《滇南本草》），甜藤（《本草述》），右篆藤（《分类草药性》），右旋藤（《贵州民间方药集》），二花秧、银花秧（《河南中药手册》）。"}]},{"ID":"20240830170522-thpznp5","Type":"NodeParagraph","Properties":{"id":"20240830170522-thpznp5","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【来源】为忍冬科植物忍冬的茎叶。秋、冬割取带叶的茎藤，扎成小捆，晒干。"}]},{"ID":"20240830170522-zel1dzk","Type":"NodeParagraph","Properties":{"id":"20240830170522-zel1dzk","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830170522-4jf3j04","Type":"NodeParagraph","Properties":{"id":"20240830170522-4jf3j04","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"忍冬（《别录》）"}]},{"ID":"20240830170522-iod2iwa","Type":"NodeParagraph","Properties":{"id":"20240830170522-iod2iwa","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"多年生半常绿缠绕灌木，高达9米。茎中空，幼枝密生短柔毛。叶对生；叶柄长4～10毫米，密被短柔毛；叶片卵圆形，或长卵形，长2.5～8厘米，宽1～5.5厘米，先端短尖，罕钝圆，基部圆形或近于心形，全缘，两面和边缘均被短柔毛。花成对腋生；花梗密被短柔毛；苞片2枚，叶状，广卵形；小苞长约1毫米；花萼短小，5裂，裂片三角形，先端急尖；合瓣花冠左右对称，长达5厘米，唇形，上唇4浅裂，花冠筒细长，约与唇部等长，外面被短柔毛，花初开时为白色，2～3日后变金黄色；雄蕊5，着生在花冠管口附近；子房下位，花柱细长，和雄蕊皆伸出花冠外。浆果球形，直径约6毫米，熟时黑色。花期5～7月。果期7～10月。"}]},{"ID":"20240830170522-dk5u2nm","Type":"NodeParagraph","Properties":{"id":"20240830170522-dk5u2nm","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830170522-qsolf0b","Type":"NodeParagraph","Properties":{"id":"20240830170522-qsolf0b","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"生于山野中，亦有栽培。分布辽宁、河北、河南、山东、安徽、江苏、浙江、福建、广东、广西、江西、湖南、湖北、四川、贵州、云南、陕西、甘肃等地。"}]},{"ID":"20240830170522-t4hb4p8","Type":"NodeParagraph","Properties":{"id":"20240830170522-t4hb4p8","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"主产浙江、四川、江苏、河南、陕西、山东、广西、湖南等地。此外安徽、甘肃、湖北、江西、福建、山西、云南、辽宁、河北等地亦产。"}]},{"ID":"20240830170522-wshaz9h","Type":"NodeParagraph","Properties":{"id":"20240830170522-wshaz9h","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性状】干燥茎呈细长圆柱形，直径1.5～6毫米，表面暗红色或灰棕色，有细柔毛，尤以嫩枝为多。皮部易剥落，常撕裂作纤维状。茎上常带有椭圆形、绿黄色的叶，多破碎不全。质坚脆，断面灰白色或黄白色，中央髓部有空隙。气弱，味淡。以外皮枣红色、质嫩带叶者为佳。"}]},{"ID":"20240830170522-oceu9xr","Type":"NodeParagraph","Properties":{"id":"20240830170522-oceu9xr","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【化学成份】叶含忍冬甙即木犀草素-7-鼠李糖葡萄糖甙、木犀草素等黄酮类。茎含鞣质、生物碱。"}]},{"ID":"20240830170522-3btkvcs","Type":"NodeParagraph","Properties":{"id":"20240830170522-3btkvcs","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830170522-lutp32n","Type":"NodeParagraph","Properties":{"id":"20240830170522-lutp32n","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"木犀草素对平滑肌（兔寓体小肠）有解痉作用，但不及罂粟碱；并有轻度利尿（增加氯化钠的排出）作用。"}]},{"ID":"20240830170522-3g41iat","Type":"NodeParagraph","Properties":{"id":"20240830170522-3g41iat","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"木犀草素在年幼大鼠（生后25～28天）口服后，可使胸腺萎缩，此作用与垂体-肾上腺系统有关，可用来解释其抗炎作用。木犀草素在体外，浓度为1：350000时，能抑制葡萄球菌及枯草杆菌的生长。"}]},{"ID":"20240830170522-tp7x1xz","Type":"NodeParagraph","Properties":{"id":"20240830170522-tp7x1xz","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，用水浸泡，润透，切片，晒干。"}]},{"ID":"20240830170522-dmmnli6","Type":"NodeParagraph","Properties":{"id":"20240830170522-dmmnli6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240830170522-vwjo5d7","Type":"NodeParagraph","Properties":{"id":"20240830170522-vwjo5d7","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"甘，寒。"}]},{"ID":"20240830170522-cs444ys","Type":"NodeParagraph","Properties":{"id":"20240830170522-cs444ys","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"甘，温，无毒。\""}]},{"ID":"20240830170522-c1d51su","Type":"NodeParagraph","Properties":{"id":"20240830170522-c1d51su","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味辛。\""}]},{"ID":"20240830170522-o2aazns","Type":"NodeParagraph","Properties":{"id":"20240830170522-o2aazns","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"③《本草拾遗》：\"小寒。\""}]},{"ID":"20240830170522-7tmb1sj","Type":"NodeParagraph","Properties":{"id":"20240830170522-7tmb1sj","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"味甘苦，性微寒。\""}]},{"ID":"20240830170522-mgpc9wp","Type":"NodeParagraph","Properties":{"id":"20240830170522-mgpc9wp","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240830170522-7jt27qh","Type":"NodeParagraph","Properties":{"id":"20240830170522-7jt27qh","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"入心、肺经。"}]},{"ID":"20240830170522-npya0f6","Type":"NodeParagraph","Properties":{"id":"20240830170522-npya0f6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①《要药分剂》：\"入肺经。\""}]},{"ID":"20240830170522-kuyxaz8","Type":"NodeParagraph","Properties":{"id":"20240830170522-kuyxaz8","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入心、肺二经。\""}]},{"ID":"20240830170522-gv6cnqj","Type":"NodeParagraph","Properties":{"id":"20240830170522-gv6cnqj","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830170522-mw3qajb","Type":"NodeParagraph","Properties":{"id":"20240830170522-mw3qajb","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"清热，解毒，通络。治温病发热，热毒血痢，传染性肝炎，痈肿疮毒，筋骨疼痛。"}]},{"ID":"20240830170522-f8mxu0v","Type":"NodeParagraph","Properties":{"id":"20240830170522-f8mxu0v","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主寒热身肿。\""}]},{"ID":"20240830170522-7oiesu7","Type":"NodeParagraph","Properties":{"id":"20240830170522-7oiesu7","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"煮汁以酿酒，补虚疗风。\""}]},{"ID":"20240830170522-2b5mn90","Type":"NodeParagraph","Properties":{"id":"20240830170522-2b5mn90","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主腹胀满，能土气下澼。\""}]},{"ID":"20240830170522-sekd9ur","Type":"NodeParagraph","Properties":{"id":"20240830170522-sekd9ur","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主热毒血痢水痢。\""}]},{"ID":"20240830170522-9f16m77","Type":"NodeParagraph","Properties":{"id":"20240830170522-9f16m77","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑤《履巉岩本草》：\"治筋骨疼痛。\""}]},{"ID":"20240830170522-6r6rxsj","Type":"NodeParagraph","Properties":{"id":"20240830170522-6r6rxsj","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"宽中下气，消痰，祛风热，清咽喉热痛。\""}]},{"ID":"20240830170522-kp7d6pz","Type":"NodeParagraph","Properties":{"id":"20240830170522-kp7d6pz","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"治一切风湿气及诸肿毒，痈疽疥癣，杨梅恶疮，散热解毒。\""}]},{"ID":"20240830170522-8fumu65","Type":"NodeParagraph","Properties":{"id":"20240830170522-8fumu65","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑧《本草再新》：\"治心虚火旺，补气宽中，咳嗽，痈痿。。"}]},{"ID":"20240830170522-t76uqw9","Type":"NodeParagraph","Properties":{"id":"20240830170522-t76uqw9","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑨《南京民间药草》：\"茎叶及花对眼睛发炎时有疗效。\""}]},{"ID":"20240830170522-89ilwgq","Type":"NodeParagraph","Properties":{"id":"20240830170522-89ilwgq","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑩《贵州民间方药集》：\"叶：外敷治刀伤。\""}]},{"ID":"20240830170522-6yxtp04","Type":"NodeParagraph","Properties":{"id":"20240830170522-6yxtp04","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑾广州部队《常用中草药手册》：\"治湿热腿痛。\""}]},{"ID":"20240830170522-juegg5s","Type":"NodeParagraph","Properties":{"id":"20240830170522-juegg5s","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.3～1两；入丸、散或浸酒。外用：煎水熏洗、熬膏贴或研末调敷。"}]},{"ID":"20240830170522-l1ceppw","Type":"NodeParagraph","Properties":{"id":"20240830170522-l1ceppw","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830170522-0n7cr3g","Type":"NodeParagraph","Properties":{"id":"20240830170522-0n7cr3g","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①治四时外感、发热口渴，或兼肢体酸痛者：忍冬藤（带叶或花，干者）一两（鲜者三两）。煎汤代茶频饮。（《泉州本草》）"}]},{"ID":"20240830170522-p6gunn3","Type":"NodeParagraph","Properties":{"id":"20240830170522-p6gunn3","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②治热毒血痢：忍冬藤浓煎坎。（《圣惠方》）"}]},{"ID":"20240830170522-ef89q8s","Type":"NodeParagraph","Properties":{"id":"20240830170522-ef89q8s","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"③治痈疽发背、肠痈、奶痈、无名肿痛，憎寒壮热，类若伤寒：忍冬草（去梗）、黄芪（去芦）各五两，当归一两二钱，甘草（炙）八两。上为细末，每服二钱，酒一盏半，煎至一盏，若病在上食后服，病在下食前服，少顷再进第二服；留渣外敷。未成脓者内消，已成脓者即溃。（《局方》神效托里散）"}]},{"ID":"20240830170522-bfhhu60","Type":"NodeParagraph","Properties":{"id":"20240830170522-bfhhu60","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"④治一切痈疽：忍冬藤（生取）五两，大甘草节一两。上用水二碗，煎一碗，入无灰好酒一碗，再煎数沸，去滓，分三服，一昼夜用尽，病重昼夜二剂，至大小便通利为度；另用忍冬藤一把烂研，酒少许敷四周。（《外科精要》忍冬酒）"}]},{"ID":"20240830170522-vngpjx9","Type":"NodeParagraph","Properties":{"id":"20240830170522-vngpjx9","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑤治诸般肿痛，金刃伤疮，恶疮：金银藤四两，吸铁石三钱，香油一斤。熬枯去滓，入黄丹八两，待熬至滴水不散，如常摊用。（《乾坤生意秘韫》忍冬膏）"}]},{"ID":"20240830170522-xb0dxhb","Type":"NodeParagraph","Properties":{"id":"20240830170522-xb0dxhb","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑥治恶疮不愈：左缠藤一把。捣烂，入雄黄五分，水二升，瓦罐煎之，以纸封七重，穿一孔，待气出，以疮对孔熏之，三时久.大出黄水后，用生肌药取效。亦治轻粉毒痈。（《余居士选奇方》）"}]},{"ID":"20240830170522-ozjdgh9","Type":"NodeParagraph","Properties":{"id":"20240830170522-ozjdgh9","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑦治疮久成漏：忍冬草浸酒常服。（《证治要诀》）"}]},{"ID":"20240830170522-sscu35a","Type":"NodeParagraph","Properties":{"id":"20240830170522-sscu35a","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑧治风湿性关节炎：忍冬藤一两，稀莶草四钱，鸡血藤五钱，老鹤草五钱，白薇四钱，水煎服。（《山东中药》）"}]},{"ID":"20240830170522-rgi95ov","Type":"NodeParagraph","Properties":{"id":"20240830170522-rgi95ov","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"⑨治毒草中毒：鲜金银花嫩茎叶适量，用冷开水洗净，嚼细服下。（《上海常用中草药》）"}]},{"ID":"20240830170522-5utoszo","Type":"NodeParagraph","Properties":{"id":"20240830170522-5utoszo","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830170522-fxxelpk","Type":"NodeParagraph","Properties":{"id":"20240830170522-fxxelpk","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"忍冬茎叶及花功用皆同。昔人称其治风、除胀、解痢为要药，而后世不复知用；后世称其消肿、散毒、治疮为要药，而昔人并未言及，乃知古今之理，万变不同，未可一辙论也。按陈自明《外科精要》云，忍冬酒治痈疽发背，初发便当服此，其效甚奇，胜于红内消。洪迈、沈括诸方所载甚详。\""}]},{"ID":"20240830170522-51fhz28","Type":"NodeParagraph","Properties":{"id":"20240830170522-51fhz28","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②《医学真传》：\"余每用银花，人多异之，谓非痈毒疮疡，用之何益?夫银花之藤，乃宣通经脉之药也。……通经脉而调气血，何病不宜，岂必痈毒而后用之哉。\""}]},{"ID":"20240830170522-hswc66i","Type":"NodeParagraph","Properties":{"id":"20240830170522-hswc66i","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"③《本革正义》：\"忍冬，《别录》称其甘温，实则主治功效，皆以清热解毒见长，必不可以言温。故陈藏器谓为小寒，且明言其非温；甄权则称其味辛，盖惟辛能散，乃以解除热毒，权说是也。今人多用其花，实则花性轻扬，力量甚薄，不如枝蔓之气味俱厚。古人只称忍冬，不言为花，则并不用花入药，自可于言外得之。观《纲目》所附诸方，尚是藤叶为多，更是明证。《别录》谓主治寒热身肿，盖亦指寒热痈肿之疮疡而言，与陈自明《外科精要》之忍冬酒、忍冬圆同意，非能泛治一切肿胀。甄权谓治腹胀满，恐有误会；虽味辛能散，而性本寒凉，必非通治胀满之药。甄权又谓能止气下澼，则热毒蕴于肠腑之辩积滞下，此能清之，亦犹陈藏器谓治热毒血痢耳。藏器又谓治水痢，则谓大便自利之水泄，惟热痢或可用之，而脾肾虚惫之自利，非其所宜。濒湖谓治诸肿毒，痈疽疥癣，杨梅诸恶疮，散热解毒。则今人多用其花，寿颐已谓不如藤叶之力厚，且不仅煎剂之必须，即外用煎汤洗涤亦大良。随处都有，取之不竭，真所谓简、便、贱三字毕备之良药也。\""}]},{"ID":"20240830170522-1o07n8m","Type":"NodeParagraph","Properties":{"id":"20240830170522-1o07n8m","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240830170522-q5fkji5","Type":"NodeParagraph","Properties":{"id":"20240830170522-q5fkji5","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"①治疗传染性肝炎"}]},{"ID":"20240830170522-gxcbk4o","Type":"NodeParagraph","Properties":{"id":"20240830170522-gxcbk4o","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"取忍冬藤2两，加水1000毫升，煎至400毫升，早晚分服。15天为一疗程，每疗程间隔1～3天。治疗22例，其中症状基本消失，肝功能正常者12例；症状、体征部分消失或明显减轻，肝功能明显好转者6例；症状、体征无明显变化者4例。"}]},{"ID":"20240830170522-rrulplx","Type":"NodeParagraph","Properties":{"id":"20240830170522-rrulplx","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"②治疗细菌性痢疾及肠炎"}]},{"ID":"20240830170522-1l9chgb","Type":"NodeParagraph","Properties":{"id":"20240830170522-1l9chgb","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"以忍冬藤100克切碎，置于瓦罐内，加水200毫升，放置12小时后，用文火煎煮3小时，加入适量蒸馏水，使成100毫升，过滤。每日每公斤体重服1.6～2.4毫升，按病情轻重，酌予增减。一般初服20毫升，每4小时1次；症状好转后，改为20毫升，一天4次，至泄泻停止后2天为止。治疗菌痢60例，肠炎90例，除4例服药1～2日未继续服用外，其余146例均获良好效果。症状平均消失时间为：腹痛3天，退热2天，里急后重2.5天，泄泻停止2天，大便成形4.4天。未见不良反应。另有用忍冬藤1.5两，每日2次煎服，同时以忍冬藤5钱煎水保留灌肠，每日1次。7日为一疗程。治疗急性菌痢167例，经一疗程治愈者131例（78.44％），无效者36例。用药后平均2天退热，大便次数、性状及镜检恢复正常平均日数分别为5.6、4.5、4.9天，细菌培养转阴日数，多数在3天左右，肠镜检查肠道病变在10日内的阴转率为：非溃疡型84.6％，溃疡型80％。治疗慢性菌痢80例，一疗程的治愈率为73.9％。发热病例平均1.5天退热，大便次数、性状及镜检分别平均在5.5、4.6天恢复正常，细菌培养平均3.7天转阴；肠镜检查：24例非溃疡型皆恢复正常，38例溃疡型在10日内痊愈者占84.2％。"}]},{"ID":"20240830170522-z4aei9x","Type":"NodeParagraph","Properties":{"id":"20240830170522-z4aei9x","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"此外，用忍冬藤4两煎服，或结合辨证加用其它药物，治疗阑尾炎亦有一定效果。"}]},{"ID":"20240830170522-u6sk8qy","Type":"NodeParagraph","Properties":{"id":"20240830170522-u6sk8qy","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830170522-ivw8pi0","Type":"NodeParagraph","Properties":{"id":"20240830170522-ivw8pi0","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"忍冬藤《中华本草》"}]},{"ID":"20240830170522-k24qd78","Type":"NodeParagraph","Properties":{"id":"20240830170522-k24qd78","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240830170522-6488543","Type":"NodeParagraph","Properties":{"id":"20240830170522-6488543","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"出自《本草经集注》。"}]},{"ID":"20240830170522-en94wi9","Type":"NodeParagraph","Properties":{"id":"20240830170522-en94wi9","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"《苏沈良方》：忍冬，古人但为补药，未尝治疽。若仓卒求不获，只用干叶为散，每服三方寸匕，甘草方寸匕。酒煮服之亦可，然不及生者。"}]},{"ID":"20240830170522-ex89se2","Type":"NodeParagraph","Properties":{"id":"20240830170522-ex89se2","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【拼音名】RěnDōnɡTénɡ"}]},{"ID":"20240830170522-zevmod4","Type":"NodeParagraph","Properties":{"id":"20240830170522-zevmod4","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【英文名】JapaneseHoneysuckleStem,HoneysuckleStem,JapaneseHoneysuckle"}]},{"ID":"20240830170522-woz84td","Type":"NodeParagraph","Properties":{"id":"20240830170522-woz84td","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【别名】老翁须、金钗股、大薜荔、水杨藤、千金藤、鸳鸯草、鹭鸶藤、忍冬草、左缠藤、忍寒草、通灵草、蜜桶藤、金银花藤、金银藤、金银花杆、甜藤、右篆藤、右旋藤、二花秧、银花秧、金银藤、金银花藤、净制忍冬藤、忍冬草、银花秧、二花藤"}]},{"ID":"20240830170522-3w9udlu","Type":"NodeParagraph","Properties":{"id":"20240830170522-3w9udlu","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830170522-23u2w45","Type":"NodeParagraph","Properties":{"id":"20240830170522-23u2w45","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"药材基源：为忍科植物忍冬、华南忍冬、菰腺忍冬、黄褐毛忍冬等的茎枝。"}]},{"ID":"20240830170522-l6cqnes","Type":"NodeParagraph","Properties":{"id":"20240830170522-l6cqnes","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：LonmicerajaponicaThunb.L.confusa(Sweet)DC.L.hypoglaucaMiq.L.fuluotomentosaHsuetS.C.Chneg"}]},{"ID":"20240830170522-g639oas","Type":"NodeParagraph","Properties":{"id":"20240830170522-g639oas","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬两季割取，除去杂质，捆成束或卷成团，晒干。"}]},{"ID":"20240830170522-jqyrr21","Type":"NodeParagraph","Properties":{"id":"20240830170522-jqyrr21","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830170522-1sxnlde","Type":"NodeParagraph","Properties":{"id":"20240830170522-1sxnlde","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"1.忍冬多年生半常绿缠绕木质藤本，长达9m。茎中空，多分枝，幼枝密被短柔毛和腺毛。叶对生；叶柄长4-10cm，密被短柔毛；叶纸质，叶片卵形、长圆卵形或卵状披针形，长2.5-8cm，宽1-5.5cm，先端短尖、渐尖或钝圆，基部圆形或近心形，全缘，两面和边缘均被短柔毛。花成对腋生，花梗密被短柔毛和腺毛；总花梗通常单生于小枝上部叶腋，与对柄等长或稍短，生于下部者长2-4cm，密被短柔毛和腺毛；苞片2枚，叶状，广卵形或椭圆形，长约3.5mm，被毛或近无毛；小苞片长约1mm，被短毛及腺毛；花萼短小，萼筒长约2mm，无毛，5齿裂，裂片卵状三角形或长三角形，先端尖，外面和边缘密被毛；花冠唇形，长3-5cm，上唇4浅裂，花冠筒细长，外面被短毛和腺毛，上唇4裂片先端钝形，下唇带状而反曲，花初开时为白色，2-3d后变金黄色；雄蕊5，着生于花冠内面筒口附近，伸出花冠外；雌蕊1，子房下位，花柱细长，伸出。浆果球形，直径6-7mm，成熟时蓝黑色，有光泽。花期4-7月，果期6-11月。"}]},{"ID":"20240830170522-z9s26ai","Type":"NodeParagraph","Properties":{"id":"20240830170522-z9s26ai","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"2.华南忍冬本种与忍科的区别在于：幼枝、叶柄、总花梗、苞片、小苞片均被灰黄色卷曲短柔毛，并疏被微腺毛；小枝淡红褐色或近褐色。叶片卵形至卵状长圆形，幼时两面被短糙毛，老时上面无毛。苞片披针形，长1-2mm；小苞片先端具缘毛；萼筒被柔毛。果实黑色。花期4-5月，果熟期10月。"}]},{"ID":"20240830170522-9d9hyy3","Type":"NodeParagraph","Properties":{"id":"20240830170522-9d9hyy3","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"3.菰腺忍冬本种与前两种的区别在于：叶下面有时粉绿色，有柄或具极短柄的黄色至橘红色蘑菇形腺体。苞片线状披针形，与萼筒近等长，外面具短糙毛和缘毛；花冠白色，有时有淡红晕，后变金黄色，外面疏被倒生微伏毛，并常具无柄或有短柄的腺。果实有时具白粉。花期4-6月，果熟期10-11月。"}]},{"ID":"20240830170522-4xooijn","Type":"NodeParagraph","Properties":{"id":"20240830170522-4xooijn","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"4.黄褐毛忍冬本种与前三种的区别在于：幼枝、叶柄、叶下面、总花梗、苞片、小苞片和萼齿均密被形展或弯伏的黄褐色毡毛关糙毛，毛长不超过2mm，幼枝和叶两面散生橘红色短腺毛。叶片纸质，卵状长圆形至长圆状披针形。苞片钻形；小苞片卵形至线状披针形；双花下面不具苞关叶；花冠和苞片均较短，花冠外面密被黄褐色倒伏毛和开展的短腺毛。花期6-7月。"}]},{"ID":"20240830170522-wreqf56","Type":"NodeParagraph","Properties":{"id":"20240830170522-wreqf56","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830170522-lg8vtco","Type":"NodeParagraph","Properties":{"id":"20240830170522-lg8vtco","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"性状鉴别本品常捆成束或卷成团。茎枝长圆本形，多分枝，直径1.5-6mm，节间长3-6cm，有殖叶及叶痕。表面棕红色或暗棕色，有细纵纹，老枝光滑，细枝有淡黄色毛茸；外皮易剥落露出灰白色同皮。质硬脆，易折断，断面黄白色，中心空洞。气微，老枝味微苦，嫩枝味淡。"}]},{"ID":"20240830170522-ax0wyu6","Type":"NodeParagraph","Properties":{"id":"20240830170522-ax0wyu6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"以表面色棕红、质嫩者为佳。"}]},{"ID":"20240830170522-3npjskw","Type":"NodeParagraph","Properties":{"id":"20240830170522-3npjskw","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"显微鉴别细枝横切面：表皮细胞1列；单细胞非腺毛壁厚，有疣状突起；腺毛柄较长。皮层较宽，纤维成环，内侧皮层细胞较小或已产生木栓层。韧皮部较窄，有的射线细胞含草酸钙簇晶；较粗茎的韧皮部有少数纤维。形成层成环。木质部导管散列，木射线宽1-2列细胞，有纹孔。髓周细胞壁木化，中央呈空洞。"}]},{"ID":"20240830170522-c7p982j","Type":"NodeParagraph","Properties":{"id":"20240830170522-c7p982j","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830170522-9p4eoa2","Type":"NodeParagraph","Properties":{"id":"20240830170522-9p4eoa2","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"藤含绿原酸（chlorogenicacid），异绿原酸（isochlorogenicacid）[1]。地上部分含马钱子甙（loganin），断马钱子甙二甲基缩醛（secologanindimethylacetal），断马钱子甙半缩醛内酯（vogeloside），表断马钱子甙半缩醛内酯（epi-vogeloside）[2]，常春藤皂甙元-3-O-α-L-吡喃阿拉伯糖甙（hederagenin-3-O-α-L-arbinopyranoside），常春藤皂甙元-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-吡喃阿拉伯糖甙[hederagenin-3-O-β-D-glucopyranosyl(1→2)-α-L-arabinopyranoside]，常春藤皂甙元-3-O-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-arabinopyranosyl-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranoside]，常春藤皂甙元-3-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-β-D-glucpyranosyl(1→2)-α-L-arabinopyranosyl-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranosyl(1→6)-β-D-glucopy-ranoside]，常春藤皂甙元-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyranosyl-28-O-β-D-glucopy-ranoside,]常春藤皂甙元-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyran-nosyl-28-O-β-D-glucopyrananosyl(1→6)-β-D-glucopyranoside]，常春藤皂甙元-3-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranoside]，常春藤皂甙元-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-3-乙酰基-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyran-nosyl-28-O-6-acetyl-β-D-glucopranosyl(1→6)-β-O-glucpyrano-side]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-吡喃阿拉伯糖甙[oleanolicacid-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-吡喃阿拉伯糖甙[oleanolicacid]-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-吡喃阿拉伯糖甙-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[oleanolicacid-3-O-α-L-ara-binopyranosyl-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyran-noside]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[oleanolicacid-3-O-β-D-glucopyansoyl（1→2）-α-L-arabinopyran-nosyl-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranoside]，齐墩果酸-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[oleanolicacid-3-O-α-L-rhamnopyranosyl()1→2]-α-L-arabinopyranosyl-28-O-β-D-glu-copyranosyl(1→6)-β-D-glucopyranoside][3]，常春藤皂甙元-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-3-乙酰基-β-D-吡喃木糖基-α-L-吡喃阿拉伯糖基（1-α-L-吡喃阿拉伯糖基6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyranosyl(1-α-L-吡喃阿拉伯糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyranosyl-28-O-3-acetyl-β-D-xylopyranosyl(1→6)-β-D-glucopyranoside]、常春藤皂甙元-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃木糖基（1→6）-β-D-吡喃葡萄糖糖甙[gederangenin-3-O-β-D-吡喃木糖基（1→6）-β-D-吡喃葡萄糖甙[hederagenin-3-O-α-L-rhamnopyr-ranosyl(1→6)-β-D-glucopyranoside][4]，还含铁、钡、锰、锌、钛、锶、铜等微量元素[5]。"}]},{"ID":"20240830170522-c2djbxp","Type":"NodeParagraph","Properties":{"id":"20240830170522-c2djbxp","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"幼枝含断氧化马钱子甙（secoxyloganin）[6].。"}]},{"ID":"20240830170522-tpvt5ho","Type":"NodeParagraph","Properties":{"id":"20240830170522-tpvt5ho","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"叶含木犀草素（luteolin），忍冬素（loniceraflavone），3-甲氧基-5，7，4-三羟基黄酮（3-methoxy-5,7,4-trihydroxyflavaone），木犀草素-7-鼠李葡萄糖甙即忍冬甙（luteolin-7-rhamnoglucoside,loni-cerin），木犀草素-7-O-双半乳糖甙（luteolin-7-O-digalactoside），忍冬素-6-鼠李葡萄糖甙（loniceraflavone-6-rhamnohlucoside），异绿原酸及咖啡酸（caffeicacid）[7]，香草酸（vanillicacid）及喜树次碱（venoterpine）等[8]。"}]},{"ID":"20240830170522-6erjsty","Type":"NodeParagraph","Properties":{"id":"20240830170522-6erjsty","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"菰腺忍冬地上部分含左旋-4-羟基-2，6-二-（4-羟基-3-甲氧基）苯基-3，7-二氧双环[3，3，0]辛烷[4-hydroxy-2，6-di-(4-hy-droxy-3-methoxy)phenyl-3,7-dioxobicyclo[3,3,0]octane]，正-10-二十九醇（n-10-nonaconsanol），东莨菪素（scopoletin），丁香酸（syringicacid），β-谷甾醇（β-sitosterol）及β-谷甾醇葡萄糖甙（β-sitosterolglucoside）[9]."}]},{"ID":"20240830170522-guo6bzz","Type":"NodeParagraph","Properties":{"id":"20240830170522-guo6bzz","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830170522-ubr9txh","Type":"NodeParagraph","Properties":{"id":"20240830170522-ubr9txh","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"1.抗菌、消炎作用：本品所含的木犀草素在1：350，000浓度时可抑制葡萄球菌和枯草杆菌的生长。对卡他、白色念珠、伤寒、痢疾、变形等菌亦有抑制作用。忍冬地上部分50%煎剂，用平板挖沟法，对伤寒杆菌、福氏痢疾杆菌、金黄色葡萄球菌及绿脓杆菌具抑制作用；茎叶50%鲜汁对伤寒杆菌、福氏痢疾杆菌及金黄色葡萄球菌具抑制作用，但弱于干的整个地上部分。在体内亦有较强的抗感染作用。对H.Su-is病毒有很强的抑制作用。在剂量20mg／kg×7d，能明显抑制大鼠植入羊毛球所致的发炎过程。"}]},{"ID":"20240830170522-lpwsse6","Type":"NodeParagraph","Properties":{"id":"20240830170522-lpwsse6","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"2.对心血管的作用：木犀草素在5×10浓度时，能降低离体蛙心的舒张期幅度，对收缩期幅度有轻度降低，心率变慢，输出量减少。在2×10浓度时，能增加离体豚鼠心脏的收缩期及舒张期幅度，心率变快，而对冠状动脉及血容量则无直接影响。对狗的心肺装置，5-10mg木犀草素可使动脉压有所增加而降低静脉压，10mg可使大鼠下肢血流减少（33%），5-15mg可使猫、犬血压升高12-30%。上述作用不能被α-肾上腺素能阻滞剂所阻断。大鼠0.5g／kg皮下注射有增强毛细血管的作用。对兔实验性动脉粥样硬化有降低血胆甾醇的作用。"}]},{"ID":"20240830170522-alz3oiv","Type":"NodeParagraph","Properties":{"id":"20240830170522-alz3oiv","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"3.解痉作用：木犀草素对兔离体小肠、豚鼠气管平滑肌及回肠有解痉作用。"}]},{"ID":"20240830170522-anq9hfo","Type":"NodeParagraph","Properties":{"id":"20240830170522-anq9hfo","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"4.其它作用：用小鼠酚红法和大鼠毛细管法试验，木犀草素有较好的祛痰作用。木犀草素对NK／Ly腹水癌细胞体外培养有抑制生长的作用。"}]},{"ID":"20240830170522-w9impdy","Type":"NodeParagraph","Properties":{"id":"20240830170522-w9impdy","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【毒性】木犀草素小鼠腹腔注射的LD50为180mg／kg。"}]},{"ID":"20240830170522-n16igfc","Type":"NodeParagraph","Properties":{"id":"20240830170522-n16igfc","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质，用水浸泡，润透，切片，晒干。"}]},{"ID":"20240830170522-kg8a4bc","Type":"NodeParagraph","Properties":{"id":"20240830170522-kg8a4bc","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；性寒"}]},{"ID":"20240830170522-mqnxbeo","Type":"NodeParagraph","Properties":{"id":"20240830170522-mqnxbeo","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【归经】归心；肺经"}]},{"ID":"20240830170522-v9i12oi","Type":"NodeParagraph","Properties":{"id":"20240830170522-v9i12oi","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；通络。主温病发热；疮痈肿毒；热毒血痢；风湿热痹"}]},{"ID":"20240830170522-fs4g47g","Type":"NodeParagraph","Properties":{"id":"20240830170522-fs4g47g","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-30g；或入丸、散；或浸酒。外用：适量，煎水熏洗，或熬膏贴，或研末调敷衍，赤可用鲜品捣敷。"}]},{"ID":"20240830170522-9mfb5be","Type":"NodeParagraph","Properties":{"id":"20240830170522-9mfb5be","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒，泄泻不止者禁用。"}]},{"ID":"20240830170522-4o92z2z","Type":"NodeParagraph","Properties":{"id":"20240830170522-4o92z2z","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240830170522-twemqiz","Type":"NodeParagraph","Properties":{"id":"20240830170522-twemqiz","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"1.《本草纲目》：忍冬茎叶及花功用皆同。昔人称其治风、除胀、解痢为要药，而后世不复知用：后世称其消肿、散毒、治疮为要药，而昔人并未言及，乃知古今之理，万变不同，未可一辙论也。按陈自明《外科精要》云，忍冬酒治痈疽发背，初发便当服此，其效甚奇，胜于红内消。洪迈、沈括诸方所载甚详。"}]},{"ID":"20240830170522-2qqgis7","Type":"NodeParagraph","Properties":{"id":"20240830170522-2qqgis7","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"2.《医学真传》：余每用银花，人多异之，谓非痈毒疮疡，用之何益？夫银花之藤，乃宣通经脉之药也。通经脉而调气血，何病不宜，岂必痈毒而后用之哉。"}]},{"ID":"20240830170522-vasrx74","Type":"NodeParagraph","Properties":{"id":"20240830170522-vasrx74","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"3.《本草正义》：忍冬，《别录》称其甘温，实则主治功效，皆以清热解毒见长，必不可以言温。故陈藏器谓为小寒，且明言其非温；甄权则称其味辛，盖惟辛能散，乃以解除热毒，权说是也。今人多用其花，实则花性轻扬，力量甚薄，不如枝蔓之气味俱厚。古人只称忍冬，不言为花，则并不用花入药，自可于言外得之。观《纲目》所附诸方，尚是藤叶为多，更是明证。《别录》谓主治寒热身肿，盖亦指寒热痈肿之疮疡而言，与陈自明《外科精要》之忍冬酒、忍冬圆同意，非能泛治一切肿胀。甄权谓治腹胀满，恐有误会；虽味辛能散，而性本寒凉，必非通治胀满之药。甄权又谓能止气下僻，则热毒蕴于肠腑之僻积滞下，此能清之，亦犹陈藏器谓治热毒血痢耳。藏器又谓治水痢，则谓大便自利之水泄，惟热痢或可用之，而脾肾虚惫之自利，非其所宜。濒湖谓治诸肿毒，痈疽疥癣，杨梅诸恶疮，散热解毒。则今人多用其花，寿颐已谓不如藤叶之力厚，且不仅煎剂之必须，即外用煎汤洗涤亦大良。随处都有，取之不竭，真所谓简、便、贱三字毕备之良药也。"}]},{"ID":"20240830170522-47zvvof","Type":"NodeParagraph","Properties":{"id":"20240830170522-47zvvof","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"4.《名医别录》：主寒热身肿。"}]},{"ID":"20240830170522-6glt9kc","Type":"NodeParagraph","Properties":{"id":"20240830170522-6glt9kc","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"5.陶弘景：煮汁以酿酒，补虚疗风。"}]},{"ID":"20240830170522-nr4tqx0","Type":"NodeParagraph","Properties":{"id":"20240830170522-nr4tqx0","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"6.《药性论》：主腹胀满，能止气下僻。"}]},{"ID":"20240830170522-ap5b7vb","Type":"NodeParagraph","Properties":{"id":"20240830170522-ap5b7vb","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"7.《本草拾遗》：主热毒血痢水痢。"}]},{"ID":"20240830170522-zzqqp8l","Type":"NodeParagraph","Properties":{"id":"20240830170522-zzqqp8l","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"8.《履？岩本草》：治筋骨疼痛。"}]},{"ID":"20240830170522-kdeovjt","Type":"NodeParagraph","Properties":{"id":"20240830170522-kdeovjt","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"9.《滇南本草》：宽中下气，消痰，祛风热，清咽喉热痛。"}]},{"ID":"20240830170522-f410lhs","Type":"NodeParagraph","Properties":{"id":"20240830170522-f410lhs","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"10.《本草纲目》：治上切风湿气及诸肿毒，痈疽疥癣，杨梅恶疮，散热解毒。"}]},{"ID":"20240830170522-gossjrh","Type":"NodeParagraph","Properties":{"id":"20240830170522-gossjrh","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"11.《本草再新》：治心虚火旺，补气宽中，咳嗽，痈痿。"}]},{"ID":"20240830170522-zfgpw37","Type":"NodeParagraph","Properties":{"id":"20240830170522-zfgpw37","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"12.《南京民间药草》：茎叶及花对眼睛发炎时有疗效。"}]},{"ID":"20240830170522-n7pxnd1","Type":"NodeParagraph","Properties":{"id":"20240830170522-n7pxnd1","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"13.《贵州民间方药集》：叶：外敷治刀伤。"}]},{"ID":"20240830170522-5gddj0f","Type":"NodeParagraph","Properties":{"id":"20240830170522-5gddj0f","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"14.广州部队《常用中草药手册》：治湿热腿痛。"}]},{"ID":"20240830170522-wbmygnl","Type":"NodeParagraph","Properties":{"id":"20240830170522-wbmygnl","updated":"20240830170556"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830170523-7ictukk","Type":"NodeThematicBreak","Properties":{"id":"20240830170523-7ictukk","updated":"20240830170556"}},{"ID":"20240830170524-dua87d3","Type":"NodeParagraph","Properties":{"id":"20240830170524-dua87d3","updated":"20240830170556"}}]}