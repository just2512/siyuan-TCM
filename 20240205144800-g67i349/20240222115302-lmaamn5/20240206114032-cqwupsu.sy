:"NodeLinkDest","Data":"assets/檀香树 9-20240715164008-23hwmcb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 513px;\" parent-style=\"width: 523px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"檀香树 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/檀香树 10-20240715164608-evyl0g2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715162513-d751hsa","Type":"NodeParagraph","Properties":{"id":"20240715162513-d751hsa","updated":"20240715164628"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"檀香树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/檀香树-20240715162513-71z1sey.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715161800-knymmn3","Type":"NodeParagraph","Properties":{"id":"20240715161800-knymmn3","updated":"20240902095318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：檀香心材是名贵中药，根部、主干碎材可以提炼精油，檀香精油被称为液体黄金；"}]},{"ID":"20240715171156-a1qxdal","Type":"NodeParagraph","Properties":{"id":"20240715171156-a1qxdal","updated":"20240902095320"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：檀香是一种半寄生植物，须根上有很多吸盘，吸附在寄主植物根上，从寄主植物上获得养分，与寄主相伴相生；"}]},{"ID":"20240715161610-ml0h8ry","Type":"NodeThematicBreak","Properties":{"id":"20240715161610-ml0h8ry"}},{"ID":"20240902095432-ta1n2u9","Type":"NodeParagraph","Properties":{"id":"20240902095432-ta1n2u9","updated":"20240902095439"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：檀香"}]},{"ID":"20240902095432-2z72ebq","Type":"NodeParagraph","Properties":{"id":"20240902095432-2z72ebq","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"檀香《中国药典》"}]},{"ID":"20240902095432-vxm1hxa","Type":"NodeParagraph","Properties":{"id":"20240902095432-vxm1hxa","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【拼音名】TánXiānɡ"}]},{"ID":"20240902095432-30qzzjs","Type":"NodeParagraph","Properties":{"id":"20240902095432-30qzzjs","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【英文名】LIGNUMSANTALIALBI"}]},{"ID":"20240902095432-bgh96by","Type":"NodeParagraph","Properties":{"id":"20240902095432-bgh96by","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【别名】白檀、白檀木"}]},{"ID":"20240902095432-i3xlbog","Type":"NodeParagraph","Properties":{"id":"20240902095432-i3xlbog","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【来源】本品为檀香科檀香属植物檀香SantalumalbumL.树干的心材。"}]},{"ID":"20240902095432-q98tvd4","Type":"NodeParagraph","Properties":{"id":"20240902095432-q98tvd4","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性状】本品为长短不一的圆柱形木段，有的略弯曲，一般长约1m，直径10～30cm。外表面灰黄色或黄褐色，光滑细腻，有的具疤节或纵裂，横截面呈棕黄色，显油迹；棕色年轮明显或不明显，纵向劈开纹理顺直。质坚实，不易折断。气清香，燃烧时香气更浓；味淡，嚼之微有辛辣感。"}]},{"ID":"20240902095432-p65l9ab","Type":"NodeParagraph","Properties":{"id":"20240902095432-p65l9ab","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902095432-2h5l8q8","Type":"NodeParagraph","Properties":{"id":"20240902095432-2h5l8q8","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：导管单个散在，偶有2～3个联合，木射线由1～2列径向延长的细胞组成，木纤维与纤维管胞无明显区别，木薄壁细胞单个散在或数个联结，有的含草酸钙方晶，导管、射线细胞、木薄壁细胞内均可见油滴。"}]},{"ID":"20240902095432-lmd1g1o","Type":"NodeParagraph","Properties":{"id":"20240902095432-lmd1g1o","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"（2）取本品[含量测定]项下的挥发油，加乙醚制成每1ml含10μl的溶液，作为供试品溶液。另取檀香醇对照品，加乙醚制成每1ml含5μl的溶液（或用印度檀香的挥发油加乙醚制成每1ml含10μl的溶液）作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述两种溶液各10μl,分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）－醋酸乙酯（85:15）为展开剂，展开，取出，晾干，喷以对二甲氨基苯甲醛溶液（取对二甲氨基苯甲醛0.25g，溶于冰醋酸50g中，加85％磷酸5g与水20ml，混匀），在80～90℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同的紫蓝色斑点。"}]},{"ID":"20240902095432-mhb7aop","Type":"NodeParagraph","Properties":{"id":"20240902095432-mhb7aop","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【含量测定】取本品刨花（厚1mm）30g,照挥发油测定法（附录ⅩD）测定。本品含挥发油不得少于3.0％（ml/g）。"}]},{"ID":"20240902095432-ajmi3de","Type":"NodeParagraph","Properties":{"id":"20240902095432-ajmi3de","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，镑片或锯成小段，劈成小碎块。"}]},{"ID":"20240902095432-gyd3v2v","Type":"NodeParagraph","Properties":{"id":"20240902095432-gyd3v2v","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902095432-hiz113d","Type":"NodeParagraph","Properties":{"id":"20240902095432-hiz113d","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【归经】归脾、胃、心、肺经。"}]},{"ID":"20240902095432-otxjvbi","Type":"NodeParagraph","Properties":{"id":"20240902095432-otxjvbi","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气温中，开胃止痛。用于寒凝气滞，胸痛，腹痛，胃痛食少；冠心病，心绞痛。"}]},{"ID":"20240902095432-7v4ve3l","Type":"NodeParagraph","Properties":{"id":"20240902095432-7v4ve3l","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【用法用量】2～5g。"}]},{"ID":"20240902095432-7s091ev","Type":"NodeParagraph","Properties":{"id":"20240902095432-7s091ev","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902095432-3kv0ozo","Type":"NodeParagraph","Properties":{"id":"20240902095432-3kv0ozo","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902095432-u4gji6u","Type":"NodeParagraph","Properties":{"id":"20240902095432-u4gji6u","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"檀香《*辞典》"}]},{"ID":"20240902095432-o691n4x","Type":"NodeParagraph","Properties":{"id":"20240902095432-o691n4x","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902095432-7t0q1b1","Type":"NodeParagraph","Properties":{"id":"20240902095432-7t0q1b1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【拼音名】TánXiānɡ"}]},{"ID":"20240902095432-mxt1lqf","Type":"NodeParagraph","Properties":{"id":"20240902095432-mxt1lqf","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【别名】旃檀（竺法真《罗浮山疏》），白檀（陶弘景），白檀香、黄檀香（《本草图经》），真檀，裕香（《纲目》）。"}]},{"ID":"20240902095432-ugp1cwr","Type":"NodeParagraph","Properties":{"id":"20240902095432-ugp1cwr","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【来源】为檀香科植物檀香的心材。全年可采。采得后切成小段，除去边材（制造檀香器具时，剩下的碎材，亦可利用）。"}]},{"ID":"20240902095432-p1r13p1","Type":"NodeParagraph","Properties":{"id":"20240902095432-p1r13p1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902095432-zj4gldp","Type":"NodeParagraph","Properties":{"id":"20240902095432-zj4gldp","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"常绿小乔木，高6～9米。具寄生根。树皮褐色，粗糙或有纵裂；多分枝，幼枝光滑无毛。叶对生；革质；叶片椭圆状卵形或卵状披针形，长3.5～5厘米，宽2～2.5厘米，先端急尖或近急尖，基部楔形，全缘，上面绿色，下面苍白色，无毛；叶柄长0.7～1厘米，光滑无毛。花腋生和顶生，为三歧式的聚伞状圆锥花序；花梗对生，长约与花被管相等；花多数，小形，最初为淡黄色，后变为深锈紫色；花被钟形，先端4裂，裂片卵圆形，无毛；蜜腺4枚，略呈圆形，着生在花被管的中部，与花被片互生；雄蕊4，与蜜腺互生，略与雌蕊等长，花药2室，纵裂，花丝线形；子房半下位，花柱柱状，柱头3裂。核果球形，大小似樱桃核，成熟时黑色，肉质多汁，内果皮坚硬，具3短棱。种子圆形，光滑无毛。"}]},{"ID":"20240902095432-mur05dl","Type":"NodeParagraph","Properties":{"id":"20240902095432-mur05dl","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"本植物心材中的树脂（檀香泥）亦供药用，另详专条。"}]},{"ID":"20240902095432-cwqgosp","Type":"NodeParagraph","Properties":{"id":"20240902095432-cwqgosp","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【生境分布】野生或栽培。分布印度、马来西亚、澳大利亚及印度尼西亚等地。我国台湾亦有栽培。主产于印度。印度尼西亚等地。"}]},{"ID":"20240902095432-pwg4i8y","Type":"NodeParagraph","Properties":{"id":"20240902095432-pwg4i8y","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性状】分黄檀香和白檀香两种。多呈圆柱形或微扁；挺直，少数微有弯曲，常锯成长短不等之段，一般长50～100厘米，直径10～20厘米。表面淡黄棕色，放置日久则颜色较深，外表光滑细致，可见细长的纵裂隙。两端平截面整齐，截断面圆形或微扁圆形，具细长裂隙，呈放射状排列，并可见锯断痕迹。质致密而坚实，极难折断，碎块折断后呈刺状。具异香，燃烧时更为浓烈，味微苦。黄檀香色深，味较浓；白檀香质坚，色稍淡。制造器具后剩余的碎材，称为檀香块，大小形状，极不规则，表面光滑碗稍粗糙，色较深，有时可见年轮，呈波纹状。纵劈后，断面纹理整齐，纵直而具细沟。以色黄，质坚而致密、油性大，香味浓厚者为佳。"}]},{"ID":"20240902095432-cmfwoy8","Type":"NodeParagraph","Properties":{"id":"20240902095432-cmfwoy8","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【化学成份】心材含挥发油（白檀油）3～5％。油含α-檀香萜醇和β-檀香萜醇90％以上，檀萜烯、α-檀香萜烯和β-檀香萜烯、檀萜烯酮、檀萜烯酮醇及少量的檀香萜酸、檀油酸、紫檀萜醛。"}]},{"ID":"20240902095432-dl3ix3r","Type":"NodeParagraph","Properties":{"id":"20240902095432-dl3ix3r","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸泡，镑片或劈碎，晾干。"}]},{"ID":"20240902095432-fyizyp3","Type":"NodeParagraph","Properties":{"id":"20240902095432-fyizyp3","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902095432-02m17ec","Type":"NodeParagraph","Properties":{"id":"20240902095432-02m17ec","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902095432-xdmelom","Type":"NodeParagraph","Properties":{"id":"20240902095432-xdmelom","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"热，无毒。\""}]},{"ID":"20240902095432-ieywrys","Type":"NodeParagraph","Properties":{"id":"20240902095432-ieywrys","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"②《珍珠囊》：\"甘苦。\""}]},{"ID":"20240902095432-6fm5sx4","Type":"NodeParagraph","Properties":{"id":"20240902095432-6fm5sx4","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"气温，味辛，无毒。\""}]},{"ID":"20240902095432-r4u3ftq","Type":"NodeParagraph","Properties":{"id":"20240902095432-r4u3ftq","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902095432-u6259n6","Type":"NodeParagraph","Properties":{"id":"20240902095432-u6259n6","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"入脾，胃、肺经。"}]},{"ID":"20240902095432-06py2j1","Type":"NodeParagraph","Properties":{"id":"20240902095432-06py2j1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴，足少阴、阳明经。\""}]},{"ID":"20240902095432-zq5816r","Type":"NodeParagraph","Properties":{"id":"20240902095432-zq5816r","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"脾，肺。\""}]},{"ID":"20240902095432-c8k650q","Type":"NodeParagraph","Properties":{"id":"20240902095432-c8k650q","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾、肺三经。\""}]},{"ID":"20240902095432-vs3tfwn","Type":"NodeParagraph","Properties":{"id":"20240902095432-vs3tfwn","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902095432-ddcyacb","Type":"NodeParagraph","Properties":{"id":"20240902095432-ddcyacb","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"理气，和胃。治心腹疼痛，噎膈呕吐，胸膈不舒。"}]},{"ID":"20240902095432-r5g1mw9","Type":"NodeParagraph","Properties":{"id":"20240902095432-r5g1mw9","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①陶弘警：\"消风肿。\""}]},{"ID":"20240902095432-974wl43","Type":"NodeParagraph","Properties":{"id":"20240902095432-974wl43","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主心腹霍乱，中恶，杀虫。\""}]},{"ID":"20240902095432-9wed0uz","Type":"NodeParagraph","Properties":{"id":"20240902095432-9wed0uz","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治心痛，霍乱。肾气腹痛，浓煎服；水磨敷外肾并腰肾痛处。\""}]},{"ID":"20240902095432-idgd3ef","Type":"NodeParagraph","Properties":{"id":"20240902095432-idgd3ef","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"④《珍珠囊》：\"引胃气上升，进食。\""}]},{"ID":"20240902095432-nvqx5b6","Type":"NodeParagraph","Properties":{"id":"20240902095432-nvqx5b6","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"治噎膈吐食。又面生黑子，每夜以浆水洗拭令赤，磨汁涂之。\""}]},{"ID":"20240902095432-q05ik44","Type":"NodeParagraph","Properties":{"id":"20240902095432-q05ik44","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"⑥《本草备要》；\"调脾胃，利胸膈，为理气要药。\""}]},{"ID":"20240902095432-zjoo96a","Type":"NodeParagraph","Properties":{"id":"20240902095432-zjoo96a","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；或入丸、散。外用：磨汁涂。"}]},{"ID":"20240902095432-potwsa5","Type":"NodeParagraph","Properties":{"id":"20240902095432-potwsa5","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【注意】《本草汇言》：\"如阴虚火盛，有动血致嗽者，勿用之。\""}]},{"ID":"20240902095432-wfu2v3q","Type":"NodeParagraph","Properties":{"id":"20240902095432-wfu2v3q","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902095432-tazs2uz","Type":"NodeParagraph","Properties":{"id":"20240902095432-tazs2uz","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①治心腹诸痛，属半虚半实者：丹参一两，白檀香、砂仁各一钱半。水煎服。（《医学金针》丹参饮）"}]},{"ID":"20240902095432-ata1yhc","Type":"NodeParagraph","Properties":{"id":"20240902095432-ata1yhc","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"②治心腹冷痛：白檀香三钱（为极细末），干姜五钱。泡汤调下。"}]},{"ID":"20240902095432-w6fxim3","Type":"NodeParagraph","Properties":{"id":"20240902095432-w6fxim3","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"③治噎膈饮食不入：白檀香一钱五分，茯苓，橘红各二钱。俱为极细末，人参汤调下。"}]},{"ID":"20240902095432-v2bc444","Type":"NodeParagraph","Properties":{"id":"20240902095432-v2bc444","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"④治阴寒霍乱：白檀香、霍香梗、木香、肉桂各一钱五分。为极细末。每用一钱，炒姜五钱，泡汤调下。（②方以下出《本草汇言》）"}]},{"ID":"20240902095432-5i6zvnp","Type":"NodeParagraph","Properties":{"id":"20240902095432-5i6zvnp","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"⑤解恶毒风肿：白檀香、沉香各一块，重一分，槟榔一枚。上三味各于砂盆中以水三盏细磨取尽，滤去滓，银石铫内煎沸，候温，分作三服。（《圣济总录》檀香饮）"}]},{"ID":"20240902095432-fir8xn1","Type":"NodeParagraph","Properties":{"id":"20240902095432-fir8xn1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902095432-17grvgc","Type":"NodeParagraph","Properties":{"id":"20240902095432-17grvgc","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①李杲：\"檀香能调气而清香，引芳香之物上行至极高之分，最宜橙橘之属，佐以姜、枣，将以葛根、豆蔻、缩砂、益智通行阳明之经，在胸膈之上，处咽嗌之中，同为理气之药。\""}]},{"ID":"20240902095432-6qv3odf","Type":"NodeParagraph","Properties":{"id":"20240902095432-6qv3odf","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"②《本草述》：\"白檀之用，在洁古云引胃气上升，进饮食，而时珍所谓治噎膈吐食，不几能升者又能降乎?东垣所说，白檀调气在胸膈之上，处咽嗌之间，而《日华子》更言煎服止心腹痛、霍乱、肾气痛，是则其调气不止在上焦而已也。总之，元气根于肾，畅于脾胃，统于肺，由下而升，即得从上而降，盖原其所自始，义固如是；而胸膈之上，咽喉之间，乃主气之肺，其所治在斯耳。第白檀功用，尽于东垣散冷气一语，如弘景消风热肿毒，亦即阳气之不能达于阴者，所郁聚为热风，是热之所化耳，无二义也，非谓其治冷又治热也。\""}]},{"ID":"20240902095432-2sul9jt","Type":"NodeParagraph","Properties":{"id":"20240902095432-2sul9jt","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"白檀香，熏之清爽可爱，凡因冷气上结，饮食不进，气逆上吐，抑郁不舒，服之能引胃气上升。且能散风辟邪，消肿住痛，功专入脾与肺，不似沉香力专主降，而能引气下行也。\""}]},{"ID":"20240902095432-036wyps","Type":"NodeParagraph","Properties":{"id":"20240902095432-036wyps","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902095432-3kcvgdq","Type":"NodeParagraph","Properties":{"id":"20240902095432-3kcvgdq","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"檀香《中华本草》"}]},{"ID":"20240902095432-nyt4hig","Type":"NodeParagraph","Properties":{"id":"20240902095432-nyt4hig","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902095432-mv8wrgq","Type":"NodeParagraph","Properties":{"id":"20240902095432-mv8wrgq","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"出自《名医别录》。"}]},{"ID":"20240902095432-bqy7em7","Type":"NodeParagraph","Properties":{"id":"20240902095432-bqy7em7","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：白擅，树如檀，出海南。"}]},{"ID":"20240902095432-t04mjhq","Type":"NodeParagraph","Properties":{"id":"20240902095432-t04mjhq","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：檀香有数种，黄、白、紫之异，今人盛用。"}]},{"ID":"20240902095432-v3mx5o0","Type":"NodeParagraph","Properties":{"id":"20240902095432-v3mx5o0","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：檀香，今岭南诸地亦留有之。树叶留似荔枝，皮青色而滑泽。"}]},{"ID":"20240902095432-2ihuhqn","Type":"NodeParagraph","Properties":{"id":"20240902095432-2ihuhqn","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【拼音名】TánXiānɡ"}]},{"ID":"20240902095432-o3fvbrd","Type":"NodeParagraph","Properties":{"id":"20240902095432-o3fvbrd","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【别名】旃檀、白檀、檀香木、真檀"}]},{"ID":"20240902095432-wzfigiw","Type":"NodeParagraph","Properties":{"id":"20240902095432-wzfigiw","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902095432-vqi00d1","Type":"NodeParagraph","Properties":{"id":"20240902095432-vqi00d1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"药材基源：为檀香科植物檀香树干的心材。"}]},{"ID":"20240902095432-qdjun6q","Type":"NodeParagraph","Properties":{"id":"20240902095432-qdjun6q","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SantalumalbumL."}]},{"ID":"20240902095432-94s1uac","Type":"NodeParagraph","Properties":{"id":"20240902095432-94s1uac","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"采收和储藏：原产地植后30～40年采伐，锯成段，砍去色淡的边材，心材干燥入药。"}]},{"ID":"20240902095432-lf3g0vl","Type":"NodeParagraph","Properties":{"id":"20240902095432-lf3g0vl","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿小乔木，高约10m。枝具条纹，有多数皮孔和半圆形的叶痕；小枝细长，节间稍肿大。叶片椭圆状卵形，膜质，长4-8cm，宽2-4cm，先端锐尖，基部楔形或阔楔形，多少下延，边缘波状，稍外折，背面有白粉，中脉在背面突起，侧脉约10对；叶柄细长，长1-1.5cm。三歧聚伞式圆锥花序腋生或顶生，长2.5-4cm；苞片2枚，钻状披针形，长2.5-3mm，早落；总花梗长2-5cm；花梗长2-4mm；花长4-.5mm，直径5.6mm；花被管钟状，长约2mm，淡绿色；花被4裂，裂片卵状三角形，内部初时绿黄色，后呈深棕红色；雄蕊4，外伸；花盘裂片卵圆形，长约1mm；花柱长3mm，深红色，柱头浅3（-4）裂。核果长1-1.2cm，直径约1cm，外果皮肉质多汁，成熟时深紫红色至紫黑色，先端稍平坦，宿存花枝基多少隆起，内果皮具纵棱3-4条。花期5-6月，果期7-9月。"}]},{"ID":"20240902095432-gzpqf0c","Type":"NodeParagraph","Properties":{"id":"20240902095432-gzpqf0c","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902095432-xyy6x7h","Type":"NodeParagraph","Properties":{"id":"20240902095432-xyy6x7h","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"生态环境：野生或栽培。"}]},{"ID":"20240902095432-upyfbyz","Type":"NodeParagraph","Properties":{"id":"20240902095432-upyfbyz","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于澳大利亚、印度尼西亚和南亚等地。我国台湾、广东、海南、云南有引种。"}]},{"ID":"20240902095432-gzi6dfg","Type":"NodeParagraph","Properties":{"id":"20240902095432-gzi6dfg","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902095432-f1ipud0","Type":"NodeParagraph","Properties":{"id":"20240902095432-f1ipud0","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"生物学特性半寄生性树种，喜热带、亚热带气候。能耐0～2℃的低温，遇短期霜冻，能安全越冬。在海拔600～1000m丘陵山地、年雨量600～2000mm、年平均气温10～35℃之间适宜生长。喜光，不耐荫蔽，较耐干旱，忌积水。在酸性红壤、黄壤或河边冲积砂质壤上均生长良好，忌粘土，在干燥多石砾的土壤上生长缓慢，但心材含油量高；在疏松肥沃的土壤上生长迅速，但心材质量差。栽培技术檀香除本身根系吸收营养外，还需要纤细的小根产生吸盘吸附寄生植物的根部，从而吸取营养。我国可选择寄主催吐萝芙木、长春花、儿茶、台湾相思树、栀子、南洋檀、楠皮木、紫珠、木棉、诃子、厚树皮、山大颜等。主要用种子繁殖，育苗移栽法。9～11月，采摘粒大、饱满、紫红色的成熟果实作种，采回后立即用清水洗去果皮，种子阴干后用（50～100）X10（-6）赤霉素浸种24h然后砂藏催芽，待次年春季，气温回升时播种，可促进种子发芽。幼苗出现真叶时，必须把幼苗分别移栽于预先种有寄生植物的盆内3～4月定植，按行株距4mX4m或5cm×5m开穴，穴径60cm，穴深50cm，每穴施腐熟有机肥。定植时将苗连同寄主带上团栽入穴内，覆土压实。"}]},{"ID":"20240902095432-utodiyh","Type":"NodeParagraph","Properties":{"id":"20240902095432-utodiyh","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"田间管理栽培后要有一定荫蔽。要经常保持植株周围土壤疏松湿润，培育1～2年内要浅松土，忌深翻。每年施肥2～3次，以人畜粪为主。檀香和寄主植物有缺株应及时补苗，寄生植物生长过旺，需进行修剪侧枝，促进主干生长。"}]},{"ID":"20240902095432-omjinhn","Type":"NodeParagraph","Properties":{"id":"20240902095432-omjinhn","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902095432-zg4z3qy","Type":"NodeParagraph","Properties":{"id":"20240902095432-zg4z3qy","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"性状鉴别心材圆柱形，有的略弯曲，长50-100cm，直径10-20cm。表面淡灰黄色，光滑细密，有时可见纵裂纹，有刀削痕。横切面棕色，显油迹；纵向劈开纹理顺直。质坚实，不易折断。气清香，味微苦。燃烧时香气浓烈。"}]},{"ID":"20240902095432-67zv8m9","Type":"NodeParagraph","Properties":{"id":"20240902095432-67zv8m9","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"以体重质坚、显油迹、香气浓郁而持久、烧之气香者为佳。"}]},{"ID":"20240902095432-y5wl9as","Type":"NodeParagraph","Properties":{"id":"20240902095432-y5wl9as","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：淡黄棕色。"}]},{"ID":"20240902095432-3g67t20","Type":"NodeParagraph","Properties":{"id":"20240902095432-3g67t20","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"①含晶厚壁细胞类长方形或长方形，直径约至45μm，壁厚，于角隅处特厚，木化，层纹隐约可见，胞腔内含草酸钙方晶；含晶细胞位于纤维旁，形成晶纤维。②草酸钙方晶多面形、鱼类方形、鱼尾状双晶及膝状双晶等，直径22-42μm。③韧型纤维直径14-20μm，壁厚约6μm，具单纹孔。④纤维管胞少数，切向壁有具线纹孔，纹孔口斜裂缝状或相交成十字形。⑤具缘纹孔导管直径约至64μm，含红棕色或黄棕色分泌物。③木射线宽l-3列细胞，壁稍厚，具单纹孔。此外，有时可见管状分泌细胞，内贮红棕色及黄棕色分泌物。"}]},{"ID":"20240902095432-ip0vr69","Type":"NodeParagraph","Properties":{"id":"20240902095432-ip0vr69","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"理化鉴别取本品粉末燃烧时，有浓郁檀香气。"}]},{"ID":"20240902095432-1vxs2nl","Type":"NodeParagraph","Properties":{"id":"20240902095432-1vxs2nl","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"品质标志《中华人民共和国药典》1995年版规定：本品含挥发油不得少于3．0％（ml/g）。"}]},{"ID":"20240902095432-6dg9oef","Type":"NodeParagraph","Properties":{"id":"20240902095432-6dg9oef","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"本品含水分不得过12．0％。"}]},{"ID":"20240902095432-2wyxowt","Type":"NodeParagraph","Properties":{"id":"20240902095432-2wyxowt","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【化学成份】心材含挥发油(白檀油)3-5%。油含A檀香萜醇和β-檀香萜醇(α-，β-Santalol)90%以上，檀萜烯(Santene)、α-檀香萜烯和β-檀香花烯(α-，β-Santalene)、檀萜烯酮(Santenone)、檀萜烯酮醇(Santenonealcohol)、及少量的檀香萜酸(Santalicacid)、檀油酸(Teresantalicacid)、紫檀萜醛(Santalaldehyde)。树干、枝和根的心材含挥发油(白檀油)1.6%-6%；根部心材产油率达10%，茎部心材次之。挥发油的主成分为α-及β-檀香醇(α-，β-santalol)，达90%以上；并含α-及β-檀香烯(α-，β-santalene)、檀烯(santene)、檀萜酮(α-santenone)、α-檀萜醇(α-santenol)、檀香酮(santalone)、檀香酸(santalicacid)、檀油酸(teresantalicacid)、异戊醛isovaleraldehyde)、檀油醇(teresantalol)，以及三环准檀香醛(tricycloekasantal)。本部分另含檀香色素(santalin)、去氧檀香色素(deoxysantalin)及银槭醛(sinapylaldehyde)、松柏醛(阿魏醛，coniferylaldehyde，ferulaldehyde)、紫丁香醛(syringicaldehyde)、香荚醛(vanillin)。另报道国产檀香木含挥发油量高达10%，通常为2.5%－5%，云南引种7年的小树出油率较低(1.52%)，侧枝更低(0.51%)。用GC-MS测定了含量较低的各组分，在20个化合物中，12个是已知化合物，如三环准檀香醛、α-檀香烯、α和β-檀香醇、α和β-檀萜醇，以及反-α-佛手烯(trans-α-berg-amotene)、香榧醇(nuciferol)及α-姜黄烯(α-curcumene)等。"}]},{"ID":"20240902095432-97ipcww","Type":"NodeParagraph","Properties":{"id":"20240902095432-97ipcww","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【药理作用】增强胃肠蠕动，促进消化液的分泌。檀香油之抗菌作用不强，对伤寒杆菌之酚系数在0.1以下。能减轻无效的咳嗽；过量可引起胃、肾、皮肤刺激。用于小便困难，可改善症状。对大鼠饲喂0.5-2g/kg，数日后，可使尿路中金黄色葡萄球菌的生长减少60%。檀香油的抑菌浓度为1：64000-1：128000，对痢疾杆菌亦有效；1：32000浓度对鸟型结核杆菌有抑制作用，对大肠杆菌无作用。檀香油尚有利尿作用，麻痹离体兔小肠，对兔耳皮肤有刺激作用。"}]},{"ID":"20240902095432-9z5ikv5","Type":"NodeParagraph","Properties":{"id":"20240902095432-9z5ikv5","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【炮制】用水浸泡，镑片或劈碎，晾干。"}]},{"ID":"20240902095432-h97i255","Type":"NodeParagraph","Properties":{"id":"20240902095432-h97i255","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【性味】辛;性温"}]},{"ID":"20240902095432-0xwr4i2","Type":"NodeParagraph","Properties":{"id":"20240902095432-0xwr4i2","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃;肺经"}]},{"ID":"20240902095432-ulxvzz1","Type":"NodeParagraph","Properties":{"id":"20240902095432-ulxvzz1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【功能主治】行气;散寒;止痛。主胸腹胀痛;霍乱吐泻;噎膈吐食；寒疝腹痛及肿毒"}]},{"ID":"20240902095432-1a50cvw","Type":"NodeParagraph","Properties":{"id":"20240902095432-1a50cvw","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5-3g，后下；或入丸、散。外用：适量，磨汁涂。"}]},{"ID":"20240902095432-r96obzu","Type":"NodeParagraph","Properties":{"id":"20240902095432-r96obzu","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【注意】《本草汇言》：如阴虚火盛，有动血致嗽者，勿用之。"}]},{"ID":"20240902095432-ke3zqsz","Type":"NodeParagraph","Properties":{"id":"20240902095432-ke3zqsz","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【附方】①治心腹诸痛，属半虚半实者：丹参一两，白檀香、砂仁各一钱半。水煎服。(《医学金针》丹参饮)②治心腹冷痛：白檀香三钦(为极细末)，干姜五钱。泡汤调下。③治噎膈饮食不入：白檀香一钱五分，茯苓、橘红各二钱。俱为极细末，人参汤凋下。④治阴寒霍乱：白檀香、藿香梗、木香、肉桂各一钱五分。为极细末。每用一钱，炒姜五钱，泡汤调下。(②方以下出《本草汇言》)⑤解恶毒风肿：白檀香、沉香各一块，重一分，槟榔一枚。上三味各于砂盆中以水三盏细磨取尽，滤去滓，银石铫内煎沸，候温，分作三服。(《圣济总录》檀香饮)"}]},{"ID":"20240902095432-73by3dp","Type":"NodeParagraph","Properties":{"id":"20240902095432-73by3dp","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902095432-vgnpu6y","Type":"NodeParagraph","Properties":{"id":"20240902095432-vgnpu6y","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：消风肿。"}]},{"ID":"20240902095432-4w8o0wg","Type":"NodeParagraph","Properties":{"id":"20240902095432-4w8o0wg","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：主心腹霍乱，中恶，杀虫。"}]},{"ID":"20240902095432-tr4okra","Type":"NodeParagraph","Properties":{"id":"20240902095432-tr4okra","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：治心痛，霍乱。肾气腹痛，浓煎服；水磨敷外肾并腰肾病处。"}]},{"ID":"20240902095432-b8v5pv2","Type":"NodeParagraph","Properties":{"id":"20240902095432-b8v5pv2","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"4.《珍珠囊》：引胃气止升，进食。"}]},{"ID":"20240902095432-hwdqito","Type":"NodeParagraph","Properties":{"id":"20240902095432-hwdqito","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：治噎膈吐食。又面生黑子，每夜以浆水洗拭令赤，磨汁涂之。"}]},{"ID":"20240902095432-iq5rffi","Type":"NodeParagraph","Properties":{"id":"20240902095432-iq5rffi","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"6.《本草备要》：调脾胃，利胸膈，为理气要药。"}]},{"ID":"20240902095432-v6ibxh1","Type":"NodeParagraph","Properties":{"id":"20240902095432-v6ibxh1","updated":"20240902095451"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902095433-i0na9se","Type":"NodeThematicBreak","Properties":{"id":"20240902095433-i0na9se","updated":"20240902095451"}},{"ID":"20240902095434-cl363sy","Type":"NodeParagraph","Properties":{"id":"20240902095434-cl363sy","updated":"20240902095451"}}]}