odeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚 6-20240826144451-na8uicj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 481px;\" parent-style=\"width: 491px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 679px;","style":"width: 669px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"皂荚7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚7-20240702113631-d26fu3r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 669px;\" parent-style=\"width: 679px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826144548-4x0evj4","Type":"NodeParagraph","Properties":{"id":"20240826144548-4x0evj4","updated":"20240826144548"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"皂荚6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/皂荚6-20240702113523-zj6gjh1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718100520-oeokgco","Type":"NodeThematicBreak","Properties":{"id":"20240718100520-oeokgco"}},{"ID":"20240902133719-dhpp4fe","Type":"NodeParagraph","Properties":{"id":"20240902133719-dhpp4fe","updated":"20240902133726"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：皂角刺"}]},{"ID":"20240902133719-9bvzl6b","Type":"NodeParagraph","Properties":{"id":"20240902133719-9bvzl6b","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"皂角刺《中国药典》"}]},{"ID":"20240902133719-p1grs7r","Type":"NodeParagraph","Properties":{"id":"20240902133719-p1grs7r","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZàoJiǎoCì"}]},{"ID":"20240902133719-oef0xsd","Type":"NodeParagraph","Properties":{"id":"20240902133719-oef0xsd","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【英文名】SPINAGLEDITSIAE"}]},{"ID":"20240902133719-55jnzbn","Type":"NodeParagraph","Properties":{"id":"20240902133719-55jnzbn","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【别名】天丁、皂丁"}]},{"ID":"20240902133719-mgzkh7q","Type":"NodeParagraph","Properties":{"id":"20240902133719-mgzkh7q","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【来源】本品为豆科植物皂荚GleditsiasinensisLam.的干燥棘刺。全年均可采收，干燥，或趁鲜切片，干燥。"}]},{"ID":"20240902133719-kskxbby","Type":"NodeParagraph","Properties":{"id":"20240902133719-kskxbby","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性状】本品为主刺及1～2次分枝的棘刺。主刺长3～15cm或更长，直径0.3～1cm；分枝刺长1～6cm，刺端锐尖。表面紫棕色或棕褐色。体轻，质坚硬，不易折断。切片厚0.1～0.3cm，常带有尖细的刺端；木部黄白色，髓部疏松，淡红棕色；质脆，易折断。无臭，味淡。"}]},{"ID":"20240902133719-87r8qzc","Type":"NodeParagraph","Properties":{"id":"20240902133719-87r8qzc","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品横切面：表皮细胞1列，外被角质层，有时可见单细胞非腺毛。皮层为2～3列薄壁细胞，细胞中有时含棕红色物。中柱鞘纤维束断续排列成环，纤维束周围的薄壁细胞有的含草酸钙方晶，偶见簇晶，纤维束旁常有单个或2～3个相聚的石细胞，壁薄。韧皮部狭窄。形成层成环。木质部连接成环，木射线宽1～2列细胞。髓部宽广，薄壁细胞含少量淀粉粒。"}]},{"ID":"20240902133719-yg6xjhf","Type":"NodeParagraph","Properties":{"id":"20240902133719-yg6xjhf","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质；未切片者略泡，润透，切厚片，干燥。"}]},{"ID":"20240902133719-pkh7yqx","Type":"NodeParagraph","Properties":{"id":"20240902133719-pkh7yqx","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902133719-bmhcvh2","Type":"NodeParagraph","Properties":{"id":"20240902133719-bmhcvh2","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、胃经。"}]},{"ID":"20240902133719-yao62q8","Type":"NodeParagraph","Properties":{"id":"20240902133719-yao62q8","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【功能主治】消肿托毒，排脓，杀虫。用于痈疽初起或脓成不溃；外治疥癣麻风。"}]},{"ID":"20240902133719-ig6tsqv","Type":"NodeParagraph","Properties":{"id":"20240902133719-ig6tsqv","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。外用适量，醋蒸取汁涂患处。"}]},{"ID":"20240902133719-dfnx3l1","Type":"NodeParagraph","Properties":{"id":"20240902133719-dfnx3l1","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【贮藏】置干燥处。"}]},{"ID":"20240902133719-eih4hoy","Type":"NodeParagraph","Properties":{"id":"20240902133719-eih4hoy","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【备注】（1）同属植物新疆皂荚GleditsiatriacanthosL.，其相应药用部分功效类同。"}]},{"ID":"20240902133719-3x2jmso","Type":"NodeParagraph","Properties":{"id":"20240902133719-3x2jmso","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902133719-amygniv","Type":"NodeParagraph","Properties":{"id":"20240902133719-amygniv","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"皂角刺《*辞典》"}]},{"ID":"20240902133719-p6faojn","Type":"NodeParagraph","Properties":{"id":"20240902133719-p6faojn","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【出处】《本草衍义补遗》"}]},{"ID":"20240902133719-osoc4n8","Type":"NodeParagraph","Properties":{"id":"20240902133719-osoc4n8","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZàoJiǎoCì"}]},{"ID":"20240902133719-w5rjjpd","Type":"NodeParagraph","Properties":{"id":"20240902133719-w5rjjpd","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【别名】皂荚刺（《圣惠方》），皂刺（《医学入门》），天丁（《纲目》），皂角针（《江苏植药志》），皂针（《中药材手册》）。"}]},{"ID":"20240902133719-gwgbzqm","Type":"NodeParagraph","Properties":{"id":"20240902133719-gwgbzqm","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【来源】为豆科植物皂荚的棘刺。全年可采，但以9月至翌年3月间为宜。"}]},{"ID":"20240902133719-0die0ra","Type":"NodeParagraph","Properties":{"id":"20240902133719-0die0ra","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【原形态】植物形态详\"皂荚\"条。"}]},{"ID":"20240902133719-bjnq6jy","Type":"NodeParagraph","Properties":{"id":"20240902133719-bjnq6jy","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产江苏、湖北、河北、山西、河南、山东。此外，广东、广西、四川、安徽、浙江、贵州、陕西、江西、甘肃等地亦产。"}]},{"ID":"20240902133719-b5u8ttv","Type":"NodeParagraph","Properties":{"id":"20240902133719-b5u8ttv","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性状】完整的棘刺有多数分枝，主刺圆柱形，长5～15厘米，基部粗约8～12毫米，末端尖锐；分枝刺一般长1.5～7厘米，有时再分歧成小刺。表面棕紫色，尖部红棕色，光滑或有细皱纹。质坚硬，难折断。药材多纵切成斜片或薄片，厚在2毫米以下，木质部黄白色，中心为淡灰棕色而疏松的髓部。无臭，味淡。以片薄、纯净，整齐者为佳。"}]},{"ID":"20240902133719-ncu2zjr","Type":"NodeParagraph","Properties":{"id":"20240902133719-ncu2zjr","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【化学成份】含黄酮甙、酚类，氨基酸。"}]},{"ID":"20240902133719-ldzo778","Type":"NodeParagraph","Properties":{"id":"20240902133719-ldzo778","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质；用水浸泡，润透后切片，晒干。"}]},{"ID":"20240902133719-mamkqey","Type":"NodeParagraph","Properties":{"id":"20240902133719-mamkqey","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902133719-8j51trc","Type":"NodeParagraph","Properties":{"id":"20240902133719-8j51trc","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240902133719-rtp1lq2","Type":"NodeParagraph","Properties":{"id":"20240902133719-rtp1lq2","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"辛，温，无毒。\""}]},{"ID":"20240902133719-8rwgiom","Type":"NodeParagraph","Properties":{"id":"20240902133719-8rwgiom","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"辛咸，温。\""}]},{"ID":"20240902133719-q696dmd","Type":"NodeParagraph","Properties":{"id":"20240902133719-q696dmd","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"性温，味辛，有小毒。\""}]},{"ID":"20240902133719-e4sa0t5","Type":"NodeParagraph","Properties":{"id":"20240902133719-e4sa0t5","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902133719-3omgom0","Type":"NodeParagraph","Properties":{"id":"20240902133719-3omgom0","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"搜风，拔毒，消肿，排脓。治痈肿，疮毒，疠风，癣疮，胎衣不下。"}]},{"ID":"20240902133719-cog1x1g","Type":"NodeParagraph","Properties":{"id":"20240902133719-cog1x1g","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"①《本草图经》：\"米醋熬嫩刺针作浓煎，以敷疮癣。\""}]},{"ID":"20240902133719-ivymjcx","Type":"NodeParagraph","Properties":{"id":"20240902133719-ivymjcx","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"②杨士瀛：\"能引诸药上行，治上焦病。\""}]},{"ID":"20240902133719-j5m9daq","Type":"NodeParagraph","Properties":{"id":"20240902133719-j5m9daq","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"③《本草衍义补遗》：\"治痈疽已溃，能引至溃处。\""}]},{"ID":"20240902133719-rpqyp59","Type":"NodeParagraph","Properties":{"id":"20240902133719-rpqyp59","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治痈肿，妒乳，风疠恶疮，胞衣不下，杀虫。\""}]},{"ID":"20240902133719-6vq3dtb","Type":"NodeParagraph","Properties":{"id":"20240902133719-6vq3dtb","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑤《本草崇原》：\"去风化痰，败毒攻毒。定小儿惊风发搐，攻痘疮起发，化毒成浆。\""}]},{"ID":"20240902133719-1fnlixh","Type":"NodeParagraph","Properties":{"id":"20240902133719-1fnlixh","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑥《四川中药志》：\"治风热疮疹，并能通乳。\""}]},{"ID":"20240902133719-ufaqkzc","Type":"NodeParagraph","Properties":{"id":"20240902133719-ufaqkzc","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑦《药材学》：\"治扁桃体炎。\""}]},{"ID":"20240902133719-j02kfes","Type":"NodeParagraph","Properties":{"id":"20240902133719-j02kfes","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱；或入丸、散。外用：醋煎涂，研末撒或调敷。"}]},{"ID":"20240902133719-rumr6st","Type":"NodeParagraph","Properties":{"id":"20240902133719-rumr6st","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏）：\"凡痈疽已溃不宜服，孕妇亦忌之。\""}]},{"ID":"20240902133719-f7gpcm6","Type":"NodeParagraph","Properties":{"id":"20240902133719-f7gpcm6","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902133719-cfwwigw","Type":"NodeParagraph","Properties":{"id":"20240902133719-cfwwigw","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"①治痈疽恶毒，外发内发，欲破未破，在四肢肩背肚腹之外者，则痛极大肿，在胸膈腰胁肚腹肠胃之内者，则痛极大胀：皂荚刺飞尖一两，乳香、没药、当归、川芎、甘草各二钱，白芷、花粉、金银花各五钱。水、酒各二碗，煎一碗半。毒在上，食后服；毒在中半饱服；毒在下空心服。未成可消，已成即溃。（《医鉴初集》）"}]},{"ID":"20240902133719-z0uj9un","Type":"NodeParagraph","Properties":{"id":"20240902133719-z0uj9un","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"②治癌瘭恶疮：皂角刺（烧存性，研）、白及少许，为末，敷之。（《仁斋直指方》）"}]},{"ID":"20240902133719-87kw026","Type":"NodeParagraph","Properties":{"id":"20240902133719-87kw026","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"③治妇人乳痈：皂角刺（烧存性）一两，蚌粉一钱。和研，每服一钱，温酒下。（《仁斋直指方》）"}]},{"ID":"20240902133719-nz5jeqy","Type":"NodeParagraph","Properties":{"id":"20240902133719-nz5jeqy","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"④治疮无头者：皂角刺（阴干烧灰），为末，每服三钱，酒调，嚼葵菜子三、五个，前药送下。（《儒门事亲》）"}]},{"ID":"20240902133719-9e5ea9a","Type":"NodeParagraph","Properties":{"id":"20240902133719-9e5ea9a","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑤治痔疾，肛边痒痛不止：皂荚刺二两（烧令烟尽），臭樗皮一两（微炙），防风一两（去芦头），赤芍药一两，枳壳一两（麸炒微黄，去瓤）。上药，捣罗为末，用酽醋一斤，熬一半成膏，次下余药，和丸，如小豆大，每于食前，煎防风汤下二十丸。（《圣惠方》皂荚刺丸）"}]},{"ID":"20240902133719-d18rjpq","Type":"NodeParagraph","Properties":{"id":"20240902133719-d18rjpq","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑥治腹内生疮在肠脏：皂角刺不拘多少，好酒一碗，煎至七分，温服。不饮酒者，水煎亦可。（《蔺氏经验方》）"}]},{"ID":"20240902133719-odnbf5t","Type":"NodeParagraph","Properties":{"id":"20240902133719-odnbf5t","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑦治大风疠疮，体废肢损，形残貌变者：皂角刺飞尖一斤（微炒，研为极细末），赤链蛇一条（切碎，酒煮，去骨取肉，焙），胡麻仁三两，生半夏二两，真铅粉一两。俱炒燥，研为末，和皂荚刺末，一总水泛为丸，如绿豆大，晒干，入净磁瓶内。每早晚各服三钱，白汤下。（《本草汇言》）"}]},{"ID":"20240902133719-6dkxsdk","Type":"NodeParagraph","Properties":{"id":"20240902133719-6dkxsdk","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑧治胎衣不下：皂角刺烧为末，每服一钱，温酒调下。（《妇人良方补遗》）"}]},{"ID":"20240902133719-ocxnwoi","Type":"NodeParagraph","Properties":{"id":"20240902133719-ocxnwoi","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑨治小便淋闭：皂角刺（烧存性）、破故纸等分。为末，无灰酒服。（《圣济总录》）"}]},{"ID":"20240902133719-r0aqzuy","Type":"NodeParagraph","Properties":{"id":"20240902133719-r0aqzuy","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"⑩治小儿重舌：皂角刺灰，入朴硝或脑子少许，漱口，掺入舌下，涎出自消。（《圣惠方》）"}]},{"ID":"20240902133719-h6268y4","Type":"NodeParagraph","Properties":{"id":"20240902133719-h6268y4","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗急性扁桃体炎：皂角刺3钱水煎，早晚2次分服。观察10例，1例无效（并发扁桃体周围脓肿），其余均在2～8日内治愈。大都在服药次日，体温及白细胞即下降至正常，自觉症状及扁桃体红肿减轻。"}]},{"ID":"20240902133719-ih7x25d","Type":"NodeParagraph","Properties":{"id":"20240902133719-ih7x25d","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902133719-bqzwxb9","Type":"NodeParagraph","Properties":{"id":"20240902133719-bqzwxb9","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"皂角刺《中华本草》"}]},{"ID":"20240902133719-4is29sn","Type":"NodeParagraph","Properties":{"id":"20240902133719-4is29sn","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草衍义补遗》。"}]},{"ID":"20240902133719-vxipq5u","Type":"NodeParagraph","Properties":{"id":"20240902133719-vxipq5u","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【拼音名】ZàoJiǎoCì"}]},{"ID":"20240902133719-ingq4yu","Type":"NodeParagraph","Properties":{"id":"20240902133719-ingq4yu","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【英文名】ChineseHoneylocustSpine,SpineofChineseHoneylocust"}]},{"ID":"20240902133719-lxavelp","Type":"NodeParagraph","Properties":{"id":"20240902133719-lxavelp","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【别名】皂荚刺、皂刺、天丁、皂角针、皂针。"}]},{"ID":"20240902133719-sty4oos","Type":"NodeParagraph","Properties":{"id":"20240902133719-sty4oos","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902133719-xnf4ft0","Type":"NodeParagraph","Properties":{"id":"20240902133719-xnf4ft0","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物皂荚的棘刺。"}]},{"ID":"20240902133719-y0jtnk2","Type":"NodeParagraph","Properties":{"id":"20240902133719-y0jtnk2","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.GleditsiasinensisLam.[G.horridaWilld.]2.GleditsiajaponicaMiq.[Ghorrida（Thunb.）Makino]"}]},{"ID":"20240902133719-7uvftie","Type":"NodeParagraph","Properties":{"id":"20240902133719-7uvftie","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年可采，但以9月至翌年3月间为宜，切片晒干。"}]},{"ID":"20240902133719-q7vpybq","Type":"NodeParagraph","Properties":{"id":"20240902133719-q7vpybq","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902133719-zdqx6c7","Type":"NodeParagraph","Properties":{"id":"20240902133719-zdqx6c7","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"1.皂荚乔木，高达15cm。刺粗壮，通常分枝，长可达16cm，圆柱形。小枝无毛。一回偶数羽状复叶，长12-18cm；小叶6-14片，长卵形、长椭圆形至卵状披针形，长3-8cm，宽1.5-3.5cm，先端钝或渐尖，基部斜圆形或斜楔形，边缘有细锯齿，无毛。花杂性，排成腋生的总状花序；花萼钟状，有4枚披针形裂片；花瓣4，白色；雄蕊6-8；子房条形，沿缝线有毛。荚果条形，不扭转，长12-30，宽2-4cm，微厚，黑棕色，被白色粉霜。花期4-5月，果期9-10月。"}]},{"ID":"20240902133719-31jid9x","Type":"NodeParagraph","Properties":{"id":"20240902133719-31jid9x","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"2．山皂荚乔木，高可达25m。刺略扁，长5-10cm，常有分枝。幼枝淡紫色。一回偶数羽状复叶，长25-30cm；小叶8-12对，长椭圆形或卵状长椭圆形，长l-4cm，全缘或有疏圆齿，上面有光泽，中助上有短柔毛，下面无毛；长枝上为二回偶数现状复叶，有3-6对羽片；小叶5-10对，狭卵形、卵状长圆形或卵状披针形；叶轴有短柔毛。细长总状花序；花有短梗；杂性异株，花黄绿色；雄蕊花瓣椭圆形，雄蕊8；两性花的雄蕊较小。荚果长25-30cm，宽2-3.5cm，扭曲，并有泡状隆起，种子靠近中部；种子卵状椭形，稍扁，栗褐色。花、果期6-11月。"}]},{"ID":"20240902133719-vr1xsur","Type":"NodeParagraph","Properties":{"id":"20240902133719-vr1xsur","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902133719-tgp92ca","Type":"NodeParagraph","Properties":{"id":"20240902133719-tgp92ca","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于路边、沟旁、住宅附近。"}]},{"ID":"20240902133719-q5cfm7c","Type":"NodeParagraph","Properties":{"id":"20240902133719-q5cfm7c","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"2.生于山地林中。"}]},{"ID":"20240902133719-qnyjqg5","Type":"NodeParagraph","Properties":{"id":"20240902133719-qnyjqg5","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北、华东、华南、以及四川、贵州等地。"}]},{"ID":"20240902133719-k18sx45","Type":"NodeParagraph","Properties":{"id":"20240902133719-k18sx45","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"2.分布于吉林、辽宁、河北、山东、江苏、安徽、浙江、河南等地。"}]},{"ID":"20240902133719-v2fr1cg","Type":"NodeParagraph","Properties":{"id":"20240902133719-v2fr1cg","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902133719-iuzb8gv","Type":"NodeParagraph","Properties":{"id":"20240902133719-iuzb8gv","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"性状鉴别完整的棘刺为主刺及l-2次分枝；扁圆柱状，长5-18cm，基部粗8-12mm，末端尖锐；分枝刺螺旋形排列，与主刺成60°-80°角，向周围伸出，一般长约1-7cm；于次分枝上又常有更小的刺，分枝刺基部内侧常呈小阜状隆起；全体紫棕色，光滑或有细皱纹。体轻，质坚硬，不易折断。商品多切成斜薄片，一般是长披针形，长2-6cm，宽3-7mm，厚l-3mm。常带有尖细的刺端，切面木质部黄白色，中心髓部松软，呈淡红色。质脆，易折断，无臭。味谈。以片薄、纯净、无核梗、色棕紫、切片中间棕红色、慷心者为佳。"}]},{"ID":"20240902133719-qm1hwlt","Type":"NodeParagraph","Properties":{"id":"20240902133719-qm1hwlt","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"显微鉴别刺的横切面：最外一层表皮细胞外被角质层。皮层薄，有的薄壁细胞合少量淀粉粒。中柱鞘处有厚壁纤维和厚壁细胞断续环列。薄壁细胞常合草酸钙方晶或簇晶。韧皮部呈新月形，极小。木质部发达，由木化的木薄壁细胞、纤维和导管组成。髓宽广，占整个断面的一半以上，髓细胞大形，不规则，常合少量棕色物质。"}]},{"ID":"20240902133719-5t1qhbg","Type":"NodeParagraph","Properties":{"id":"20240902133719-5t1qhbg","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"粉末特征：棕褐色，纤维性。①表皮细胞有棕色内含物及小颗粒状晶体，表面观可见气孔。②中柱鞘纤维多碎断，徽黄色，壁厚，胞腔不明显，周围薄壁细胞含草酸钙方晶，直径17-22μm，簇晶直径6-8μm，形成晶鞘纤维。纤维束厚壁性，分隔纤维，薄壁性纤维有的具单纹孔。③木薄壁细胞方形或类多角形，具纹孔。④有螺纹导管及具缘纹孔导管碎片散在。⑤髓细胞大形，具众多单纹孔。"}]},{"ID":"20240902133719-18xcskj","Type":"NodeParagraph","Properties":{"id":"20240902133719-18xcskj","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【化学成份】含黄酮甙、酚类、氨基酸。黄酮类化合物为黄颜木素(fustin即3，7，3，4，-四羟基双氢黄酮)、非瑟素(fisetin即3，7，3，4-四羟基黄酮)，并含有无色花青素。"}]},{"ID":"20240902133719-k9951sh","Type":"NodeParagraph","Properties":{"id":"20240902133719-k9951sh","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902133719-n82xob6","Type":"NodeParagraph","Properties":{"id":"20240902133719-n82xob6","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"抗癌作用：1.体外试验，热水浸出物对JTC-26抑制率为50-70%。"}]},{"ID":"20240902133719-s24zqtc","Type":"NodeParagraph","Properties":{"id":"20240902133719-s24zqtc","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"2.体内实验，对浊鼠肉瘤-180有抑制活性的作用。煎剂用平板打洞法，对金黄色葡萄球菌和卡他球菌有抑制作用；水浸剂60g/kg灌胃对肉瘤-180的抑制率为32.8%。"}]},{"ID":"20240902133719-6ytyd8b","Type":"NodeParagraph","Properties":{"id":"20240902133719-6ytyd8b","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902133719-fbbt5cg","Type":"NodeParagraph","Properties":{"id":"20240902133719-fbbt5cg","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"理化鉴别取本品粉末1g，加乙醇20ml，置水浴上回流15min，滤过。取滤液lml，加镁粉少量与盐酸3-4滴，显红色。"}]},{"ID":"20240902133719-82ucagz","Type":"NodeParagraph","Properties":{"id":"20240902133719-82ucagz","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"（检查黄酮）"}]},{"ID":"20240902133719-rxosjqm","Type":"NodeParagraph","Properties":{"id":"20240902133719-rxosjqm","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【炮制】拣去杂质；用水浸泡，润透后切片，晒干。"}]},{"ID":"20240902133719-8zep0tg","Type":"NodeParagraph","Properties":{"id":"20240902133719-8zep0tg","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【性味】辛；温"}]},{"ID":"20240902133719-nmzetsc","Type":"NodeParagraph","Properties":{"id":"20240902133719-nmzetsc","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肺经"}]},{"ID":"20240902133719-asuvwsi","Type":"NodeParagraph","Properties":{"id":"20240902133719-asuvwsi","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【功能主治】消毒透脓；搜风；杀虫。主痈疽肿毒；瘰疬；疮疹顽癣；产后缺乳；胎衣不下；疠风"}]},{"ID":"20240902133719-9hjd44s","Type":"NodeParagraph","Properties":{"id":"20240902133719-9hjd44s","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；或入丸、散。外用：适量，醋煎涂，或研末撒，或调敷。"}]},{"ID":"20240902133719-92ynwk1","Type":"NodeParagraph","Properties":{"id":"20240902133719-92ynwk1","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【注意】《本草经疏》：凡痈疽已溃不宜服，孕妇亦忌之。"}]},{"ID":"20240902133719-sb2a97p","Type":"NodeParagraph","Properties":{"id":"20240902133719-sb2a97p","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902133719-ui05f0u","Type":"NodeParagraph","Properties":{"id":"20240902133719-ui05f0u","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"1.《医学入门》：皂刺，凡痈疽未破者，能开窍；已破者能引药达疮所，乃诸恶疮癣及疠风要药也。"}]},{"ID":"20240902133719-gtgst6l","Type":"NodeParagraph","Properties":{"id":"20240902133719-gtgst6l","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：皂荚刺治风杀虫，功与荚同，但其锐利直达病所为异耳。"}]},{"ID":"20240902133719-mhp4492","Type":"NodeParagraph","Properties":{"id":"20240902133719-mhp4492","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：皂荚刺，拔毒祛风。凡痈疽未成者，能引之以消散，将破者，能引之以出头，已溃者能引之以行脓。于疡毒药中为第一要剂。又泄血中风热风毒，故厉风药中亦推此药为开导前锋也。沈氏曰，皂荚刺宜用头刺极尖锐者佳，刺下节如枝硬（梗）者，力薄不及也。姚继元云，治疠风癞疾，风癣风疮，搔痒风屑，与苦参同用，其力更倍。"}]},{"ID":"20240902133719-9k9fq4q","Type":"NodeParagraph","Properties":{"id":"20240902133719-9k9fq4q","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：角刺治痘疹气滞，不能起顶灌脓者，功效最捷，而气虚者慎勿误用，恐透表过锐，反生虚泡也。若血滞不能起顶灌脓，叉需鲮鲤，当非角刺所宜。丹方治大风恶疾，眉落鼻崩，用皂角刺三斤烧灰为末，食后煎大黄汤，调一匕服之，不终剂而愈。肿疡服之即消，溃疡服之难敛，以其性善开泄也。"}]},{"ID":"20240902133719-t4vlffw","Type":"NodeParagraph","Properties":{"id":"20240902133719-t4vlffw","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：m醋熬嫩刺针作浓煎，以敷疮癣。"}]},{"ID":"20240902133719-15ipv8x","Type":"NodeParagraph","Properties":{"id":"20240902133719-15ipv8x","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"6.杨士瀛：能引诸药上行，治上焦病。"}]},{"ID":"20240902133719-ia65u6n","Type":"NodeParagraph","Properties":{"id":"20240902133719-ia65u6n","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"7.《本草衍义补遗》：治痈疽已溃，能引至溃处。"}]},{"ID":"20240902133719-pp1xwmu","Type":"NodeParagraph","Properties":{"id":"20240902133719-pp1xwmu","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"8.《本草纲目》：治痈肿，妒乳，风疠恶疮，胞衣不下，杀虫。"}]},{"ID":"20240902133719-0ticcaw","Type":"NodeParagraph","Properties":{"id":"20240902133719-0ticcaw","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"9.《本草崇原》：去风化痰，败毒攻毒。定小儿惊风发搐，攻痘疮起发，化毒成浆。"}]},{"ID":"20240902133719-4chkqry","Type":"NodeParagraph","Properties":{"id":"20240902133719-4chkqry","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"10.《四川中药志》：治风热疮疹，并能通乳。"}]},{"ID":"20240902133719-ba9g7ep","Type":"NodeParagraph","Properties":{"id":"20240902133719-ba9g7ep","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"11.《药材学》：治扁桃体炎。"}]},{"ID":"20240902133719-lb78bdq","Type":"NodeParagraph","Properties":{"id":"20240902133719-lb78bdq","updated":"20240902133726"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902133720-6inyrj0","Type":"NodeThematicBreak","Properties":{"id":"20240902133720-6inyrj0","updated":"20240902133726"}},{"ID":"20240902133721-3rfudjz","Type":"NodeParagraph","Properties":{"id":"20240902133721-3rfudjz","updated":"20240902133726"}}]}