ng"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 15-20240724161118-xgcu7fj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 544px;\" parent-style=\"width: 554px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161633-vi0wbjw","Type":"NodeParagraph","Properties":{"id":"20240724161633-vi0wbjw","updated":"20240724161633"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莲藕"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莲藕-20240621115734-erwam2l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 553px;","style":"width: 543px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115903-l36gque.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 543px;\" parent-style=\"width: 553px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161633-20t85jh","Type":"NodeParagraph","Properties":{"id":"20240724161633-20t85jh","updated":"20240724161633"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 7-20240724155706-fopuwcu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 721px;","style":"width: 711px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 8-20240724155737-t3yiio5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 711px;\" parent-style=\"width: 721px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161633-oi2qzi4","Type":"NodeParagraph","Properties":{"id":"20240724161633-oi2qzi4","updated":"20240724161633"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 6-20240724155553-f41agfl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161636-e9at70o","Type":"NodeThematicBreak","Properties":{"id":"20240724161636-e9at70o"}},{"ID":"20240902165849-5xv6pwn","Type":"NodeParagraph","Properties":{"id":"20240902165849-5xv6pwn","updated":"20240902165857"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：荷叶"}]},{"ID":"20240902165849-jc7st6g","Type":"NodeParagraph","Properties":{"id":"20240902165849-jc7st6g","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶《中国药典》"}]},{"ID":"20240902165849-1pdig6y","Type":"NodeParagraph","Properties":{"id":"20240902165849-1pdig6y","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【拼音名】HéYè"}]},{"ID":"20240902165849-xesf8n0","Type":"NodeParagraph","Properties":{"id":"20240902165849-xesf8n0","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【英文名】FOLIUMNELUMBINIS"}]},{"ID":"20240902165849-x6bbfcr","Type":"NodeParagraph","Properties":{"id":"20240902165849-x6bbfcr","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【来源】本品为睡莲科植物莲NelumbonuciferaGaertn.的干燥叶。夏、秋二季采收，晒至七、八成干时，除去叶柄，折成半圆形或折扇形，干燥。"}]},{"ID":"20240902165849-mb8izq9","Type":"NodeParagraph","Properties":{"id":"20240902165849-mb8izq9","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈半圆形或折扇形，展开后呈类圆形，全缘或稍呈波状，直径20～50cm。上表面深绿色或黄绿色，较粗糙；下表面淡灰棕色，较光滑，有粗脉21～22条，自中心向四周射出；中心有突起的叶柄残基。质脆，易破碎。稍有清香气，味微苦。"}]},{"ID":"20240902165849-tzlnnc4","Type":"NodeParagraph","Properties":{"id":"20240902165849-tzlnnc4","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末灰绿色。上表皮细胞多角形，外壁乳头状或短绒毛状突起；气孔不定式，副卫细胞5～8个。下表皮细胞垂周壁略波状弯曲，有时可见连珠状增厚。草酸钙簇晶多见，直径约至40μm。"}]},{"ID":"20240902165849-uj4gc5d","Type":"NodeParagraph","Properties":{"id":"20240902165849-uj4gc5d","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902165849-s2u5ipu","Type":"NodeParagraph","Properties":{"id":"20240902165849-s2u5ipu","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶：喷水，稍润，切丝，干燥。"}]},{"ID":"20240902165849-j4l7xy4","Type":"NodeParagraph","Properties":{"id":"20240902165849-j4l7xy4","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶炭：取净荷叶，照煅炭法（附录ⅡD）煅成炭。"}]},{"ID":"20240902165849-hv7jh3m","Type":"NodeParagraph","Properties":{"id":"20240902165849-hv7jh3m","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》"}]},{"ID":"20240902165849-j3yvjks","Type":"NodeParagraph","Properties":{"id":"20240902165849-j3yvjks","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶炭：取净荷叶，放煅锅内装满，上面覆盖一锅，两锅结合处用黄泥封闭，上面锅底贴白纸，用火煅至白纸显焦黄色为止，待凉取出。"}]},{"ID":"20240902165849-ww6rc78","Type":"NodeParagraph","Properties":{"id":"20240902165849-ww6rc78","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性味】苦，平。"}]},{"ID":"20240902165849-zkmeckd","Type":"NodeParagraph","Properties":{"id":"20240902165849-zkmeckd","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、脾、胃经。"}]},{"ID":"20240902165849-6qh9mex","Type":"NodeParagraph","Properties":{"id":"20240902165849-6qh9mex","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解暑，升发清阳，凉血止血。用于暑热烦渴，暑湿泄泻，脾虚泄泻，血热吐衄，便血崩漏。荷叶炭收涩化瘀止血。用于多种出血症及产后血晕。"}]},{"ID":"20240902165849-7cn1bwk","Type":"NodeParagraph","Properties":{"id":"20240902165849-7cn1bwk","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g；鲜品15～30g；荷叶炭3～6g。"}]},{"ID":"20240902165849-8s2cisv","Type":"NodeParagraph","Properties":{"id":"20240902165849-8s2cisv","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902165849-j4qc6wm","Type":"NodeParagraph","Properties":{"id":"20240902165849-j4qc6wm","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶《*辞典》"}]},{"ID":"20240902165849-mk3qc02","Type":"NodeParagraph","Properties":{"id":"20240902165849-mk3qc02","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【出处】《食疗本草》"}]},{"ID":"20240902165849-wjp9200","Type":"NodeParagraph","Properties":{"id":"20240902165849-wjp9200","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【拼音名】HéYè"}]},{"ID":"20240902165849-3m6rmnf","Type":"NodeParagraph","Properties":{"id":"20240902165849-3m6rmnf","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【别名】蘧（《尔雅》）。"}]},{"ID":"20240902165849-sl2zpmj","Type":"NodeParagraph","Properties":{"id":"20240902165849-sl2zpmj","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【来源】为睡莲科植物莲的叶。6～9月收采，除去叶柄，晒至七、八成干，对折成半四形，晒干。夏季，亦用鲜叶或初生嫩叶（荷钱）。"}]},{"ID":"20240902165849-b3i8epg","Type":"NodeParagraph","Properties":{"id":"20240902165849-b3i8epg","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【生境分布】全国大部地区均产。"}]},{"ID":"20240902165849-sddujxk","Type":"NodeParagraph","Properties":{"id":"20240902165849-sddujxk","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的叶通常折叠成半圆形或扇形，完整或稍破碎。叶片展开后呈圆盾形，直径30余厘米。正面青绿色或棕绿色，有白色短粗腺毛：背面灰黄色或淡灰绿色，平滑有光泽；中心有一突起的叶柄残基；全缘；叶脉明显，粗脉21～22条，由中心向外放射，并分生多数细脉。质脆，易碎。微有消香气，味淡微涩。以叶大、完整、色绿、无斑点者为佳。"}]},{"ID":"20240902165849-r196ywa","Type":"NodeParagraph","Properties":{"id":"20240902165849-r196ywa","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【化学成份】叶含莲碱、荷叶碱、原荷叶碱、亚美罂粟碱、前荷叶碱、N-去甲基荷叶碱、D-N-甲基乌药碱、番荔枝碱、鹅掌楸碱、槲皮素、异槲皮甙、莲甙、酒石酸、柠檬酸、苹果酸、葡萄糖酸、草酸、琥珀酸、鞣质。还含抗有丝分裂作用的碱性成分。"}]},{"ID":"20240902165849-z4jsiv4","Type":"NodeParagraph","Properties":{"id":"20240902165849-z4jsiv4","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【炮制】荷叶：以水洗净，剪去蒂及边缘，切丝，晒干。荷叶炭：取净荷叶，置锅内，上覆一口径略小的锅，上贴白纸，两锅交接处用黄泥封固，煅至白纸呈焦黄色，停火，待冷取出。"}]},{"ID":"20240902165849-p100xp7","Type":"NodeParagraph","Properties":{"id":"20240902165849-p100xp7","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902165849-6l9bd0x","Type":"NodeParagraph","Properties":{"id":"20240902165849-6l9bd0x","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"苦涩，平。"}]},{"ID":"20240902165849-6xajg23","Type":"NodeParagraph","Properties":{"id":"20240902165849-6xajg23","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性微温平，味辛。\""}]},{"ID":"20240902165849-uqtgzsc","Type":"NodeParagraph","Properties":{"id":"20240902165849-uqtgzsc","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②《本草崇原》：\"气味苦，平，无毒。\""}]},{"ID":"20240902165849-nvwfriy","Type":"NodeParagraph","Properties":{"id":"20240902165849-nvwfriy","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"苦涩，平，微咸。\""}]},{"ID":"20240902165849-lxivn99","Type":"NodeParagraph","Properties":{"id":"20240902165849-lxivn99","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902165849-2x423w7","Type":"NodeParagraph","Properties":{"id":"20240902165849-2x423w7","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"入心、肝、脾经。"}]},{"ID":"20240902165849-f2rxi41","Type":"NodeParagraph","Properties":{"id":"20240902165849-f2rxi41","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①《本草求真》：\"入胆。\""}]},{"ID":"20240902165849-dkyu7z0","Type":"NodeParagraph","Properties":{"id":"20240902165849-dkyu7z0","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入心、肝、肺三经。\""}]},{"ID":"20240902165849-u996la2","Type":"NodeParagraph","Properties":{"id":"20240902165849-u996la2","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》：\"入足太阴、阳明经。\""}]},{"ID":"20240902165849-krk5342","Type":"NodeParagraph","Properties":{"id":"20240902165849-krk5342","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902165849-mamzmoe","Type":"NodeParagraph","Properties":{"id":"20240902165849-mamzmoe","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"清暑利湿，升发滑阳，止血。治暑湿泄泻、眩晕，水气浮肿，雷头风，吐血，衄血，崩漏，便血，产后血晕。"}]},{"ID":"20240902165849-mz6x424","Type":"NodeParagraph","Properties":{"id":"20240902165849-mz6x424","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①盂诜：\"破血。\""}]},{"ID":"20240902165849-rpri25s","Type":"NodeParagraph","Properties":{"id":"20240902165849-rpri25s","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"主血胀腹痛，产后胞衣不下，酒煮服之；又主食野菌毒，水煮服之。\""}]},{"ID":"20240902165849-dlocync","Type":"NodeParagraph","Properties":{"id":"20240902165849-dlocync","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"止渴，并产后口干，心肺燥，烦闷。\""}]},{"ID":"20240902165849-401eugo","Type":"NodeParagraph","Properties":{"id":"20240902165849-401eugo","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"④《日用本草》：\"治呕血、吐血。\""}]},{"ID":"20240902165849-tjctdu8","Type":"NodeParagraph","Properties":{"id":"20240902165849-tjctdu8","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"上清头目之凤热，止眩晕，清痰，泄气，止呕，头闷疼。\""}]},{"ID":"20240902165849-g7ojodz","Type":"NodeParagraph","Properties":{"id":"20240902165849-g7ojodz","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑥《品汇精要》：\"治食蟹中毒。\""}]},{"ID":"20240902165849-yx60wjl","Type":"NodeParagraph","Properties":{"id":"20240902165849-yx60wjl","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"生发元气，裨助脾胃，涩精浊，散瘀血，淆水肿、痈肿，发痘疮。治吐血、咯血。衄血、下血，溺血、血淋、崩中、产后恶血、损伤败血。\""}]},{"ID":"20240902165849-k35pfcs","Type":"NodeParagraph","Properties":{"id":"20240902165849-k35pfcs","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑧《本草通玄》：\"开胃消食，止血固精。\""}]},{"ID":"20240902165849-o4eev2j","Type":"NodeParagraph","Properties":{"id":"20240902165849-o4eev2j","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑨《本草备要》：\"洗肾囊风。\""}]},{"ID":"20240902165849-267r2wc","Type":"NodeParagraph","Properties":{"id":"20240902165849-267r2wc","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑩《生草药性备要》：\"舂汁，治白浊，（煅）存性，治莲蓬疮。\""}]},{"ID":"20240902165849-c5nvzig","Type":"NodeParagraph","Properties":{"id":"20240902165849-c5nvzig","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑾《太苹再新，：\"清凉解暑，止渴生津，治泻痢，解火热。\""}]},{"ID":"20240902165849-75duj2z","Type":"NodeParagraph","Properties":{"id":"20240902165849-75duj2z","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑿《现代实用中药》：\"用于妇人慢性子宫炎，赤白带下，男子遗精或夜尿证；又为解毒药。\""}]},{"ID":"20240902165849-c3pzikr","Type":"NodeParagraph","Properties":{"id":"20240902165849-c3pzikr","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～3钱（鲜者0.5～1两）；或入丸、散。外用：捣敷、研末掺或煎水洗。"}]},{"ID":"20240902165849-dc69z7g","Type":"NodeParagraph","Properties":{"id":"20240902165849-dc69z7g","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902165849-jc47jsf","Type":"NodeParagraph","Properties":{"id":"20240902165849-jc47jsf","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"畏桐油，茯苓、白银。\""}]},{"ID":"20240902165849-4x43znw","Type":"NodeParagraph","Properties":{"id":"20240902165849-4x43znw","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"升散消耗，虚者禁之。\""}]},{"ID":"20240902165849-sm0tmgn","Type":"NodeParagraph","Properties":{"id":"20240902165849-sm0tmgn","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"③《随息居饮食谱》：\"凡上焦邪盛，治宜清降者，切不可用。\""}]},{"ID":"20240902165849-t1q6igu","Type":"NodeParagraph","Properties":{"id":"20240902165849-t1q6igu","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902165849-s436dsp","Type":"NodeParagraph","Properties":{"id":"20240902165849-s436dsp","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①治秋时晚发之伏暑，并治湿温初起：连翘三钱（去心），杏仁二钱（去皮、尖，研），瓜蒌壳三钱，陈皮一钱五分，茯苓三钱，制半夏一钱，甘草五分，佩兰叶一钱。加荷叶二钱为引，水煎服。（《时病论》）"}]},{"ID":"20240902165849-6v35csl","Type":"NodeParagraph","Properties":{"id":"20240902165849-6v35csl","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②治阳水浮肿：败荷叶烧存性，研末。每服二钱，米饮调下，日三服。（《证治要诀》）"}]},{"ID":"20240902165849-dk1fe95","Type":"NodeParagraph","Properties":{"id":"20240902165849-dk1fe95","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"③治雷头风证，头面疙宿肿痛，憎寒发热，状如伤寒：荷叶一枚，升麻五钱，苍术五钱。水煎温服。（《内经类编试效方》清震汤）"}]},{"ID":"20240902165849-cbyi4eq","Type":"NodeParagraph","Properties":{"id":"20240902165849-cbyi4eq","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"④治阳乘于阴，以致吐血衄血：生荷叶、生艾叶、生柏叶、生地黄各等分。上研，丸鸡子大。每服一丸，水煎服。（《妇人良方》四生丸）"}]},{"ID":"20240902165849-7mppnsf","Type":"NodeParagraph","Properties":{"id":"20240902165849-7mppnsf","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑤治吐血不止：㈠经霜败荷叶，烧存性，研末，新水服二钱。（《肘后方》）㈡嫩荷叶七个，擂水服。（《纲目》）"}]},{"ID":"20240902165849-oyuuikd","Type":"NodeParagraph","Properties":{"id":"20240902165849-oyuuikd","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑥治吐血咯血：荷叶焙干，为末，米饮下二钱匕。（《经验后方》）"}]},{"ID":"20240902165849-dnx6iu5","Type":"NodeParagraph","Properties":{"id":"20240902165849-dnx6iu5","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑦治崩中下血：荷叶（烧研）半两，蒲黄、黄芩各一两。为末。每空心酒服三钱。（《纲目》）"}]},{"ID":"20240902165849-clmd6no","Type":"NodeParagraph","Properties":{"id":"20240902165849-clmd6no","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑧治下痢赤白：荷叶烧研，每服二钱：红痢蜜、白痢沙糖汤下。（《纲目》）"}]},{"ID":"20240902165849-stj52zs","Type":"NodeParagraph","Properties":{"id":"20240902165849-stj52zs","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑨治产后血运，烦闷不识人。或狂言乱语，气欲绝：荷叶三片，蒲黄二两，甘草二两（炙微赤，锉）。上药捣筛为散。每服三钱，以水一中盏，煎至五分，入生地黄汁一合，蜜半匙，更煎三，五沸，去滓，不计时候温服。（《圣惠方》荷叶散）"}]},{"ID":"20240902165849-qbvm8zk","Type":"NodeParagraph","Properties":{"id":"20240902165849-qbvm8zk","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑩治妊娠伤寒，大热闷乱，燥渴，恐伤胎脏：卷荷叶嫩者（焙干）一两，蚌粉花半两。上为末。每服二钱，入蜜少许，新汲水调下，食前服。（《三因方》罩胎散）"}]},{"ID":"20240902165849-hdgbodr","Type":"NodeParagraph","Properties":{"id":"20240902165849-hdgbodr","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑾治脱肛不收：贴水荷叶，焙，研，酒服二钱，仍以荷叶盛末坐之。（《经验良方》）"}]},{"ID":"20240902165849-kdqwopx","Type":"NodeParagraph","Properties":{"id":"20240902165849-kdqwopx","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⑿治遍身风宿：荷叶三十枚，石灰一斗，淋汁，合煮渍之，半日乃出，数日一作。（《圣惠方》）"}]},{"ID":"20240902165849-8uod1j3","Type":"NodeParagraph","Properties":{"id":"20240902165849-8uod1j3","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒀治赤游火丹：新生荷叶，捣烂，入盐涂之。（《摘元方》）"}]},{"ID":"20240902165849-q3xuzdj","Type":"NodeParagraph","Properties":{"id":"20240902165849-q3xuzdj","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒁治黄水疮：荷叶烧炭，研细末，香油调匀，敷患处，一日二次。（《单方验方新医疗法选编》）"}]},{"ID":"20240902165849-39994cf","Type":"NodeParagraph","Properties":{"id":"20240902165849-39994cf","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒂治脚胫生疮，浸淫腿膝，脓水淋漓，热痹痒痛：干荷叶四个，藁本二钱半。上细切，水二斗，煎至五升，去渣。温热得所，淋渫，仍服大黄左经汤。（《证治准绳》荷叶藁本汤）"}]},{"ID":"20240902165849-ltheim9","Type":"NodeParagraph","Properties":{"id":"20240902165849-ltheim9","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒃治漆疮：荷叶（燥者）一斤。以水一斗，煮取五升。洗了，以贯众末掺之，干则以油和涂。（《圣济总录》荷叶汤）"}]},{"ID":"20240902165849-04u7qhk","Type":"NodeParagraph","Properties":{"id":"20240902165849-04u7qhk","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒄治扑打坠损，恶血攻心，闷乱疼痛：火干荷叶五斤。烧令烟尽，细研，食前以童子热小便-小盏，调三钱匕，日三服。（《圣惠方》）"}]},{"ID":"20240902165849-7ybihws","Type":"NodeParagraph","Properties":{"id":"20240902165849-7ybihws","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"⒅治斧伤疮：荷叶烧研擦之。（《濒湖集简方》）"}]},{"ID":"20240902165849-dmotd97","Type":"NodeParagraph","Properties":{"id":"20240902165849-dmotd97","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902165849-487aqrf","Type":"NodeParagraph","Properties":{"id":"20240902165849-487aqrf","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"按闻人规《疽疹八十一论》云，痘疮已出，复为风寒外袭，则窍闭血凝，其点不长，或变黑色，此为倒黡，必身痛，四肢微厥，但温肌散邪，则热气复行而斑自出也，宜紫背荷叶散治之。盖荷叶能升发阳气，散瘀血，留好血，僵蚕能解结滞之气也，此药只得而活人甚多，胜于人牙、龙脑也。又戴原礼《证治要诀》云，荷叶服之，令人瘦劣，单服可以消阳水浮肿之气。\""}]},{"ID":"20240902165849-h7wcw7f","Type":"NodeParagraph","Properties":{"id":"20240902165849-h7wcw7f","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"荷叶，功略同于藕及莲心，而多入肝分，平热、去湿，以行清气，以青入肝也。然苦涩之味，实以泻心肝而清金固水，故能去瘀、保精、除妄热、平气血也。\""}]},{"ID":"20240902165849-lh5bj33","Type":"NodeParagraph","Properties":{"id":"20240902165849-lh5bj33","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902165849-fg7e76l","Type":"NodeParagraph","Properties":{"id":"20240902165849-fg7e76l","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"荷叶《中华本草》"}]},{"ID":"20240902165849-sgwyurj","Type":"NodeParagraph","Properties":{"id":"20240902165849-sgwyurj","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【出处】出自《食疗本草》"}]},{"ID":"20240902165849-rqwts45","Type":"NodeParagraph","Properties":{"id":"20240902165849-rqwts45","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【拼音名】HéYè"}]},{"ID":"20240902165849-rdwfqru","Type":"NodeParagraph","Properties":{"id":"20240902165849-rdwfqru","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【英文名】LotusLeaf"}]},{"ID":"20240902165849-vyug8ck","Type":"NodeParagraph","Properties":{"id":"20240902165849-vyug8ck","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【别名】蕸。"}]},{"ID":"20240902165849-1mwl1yx","Type":"NodeParagraph","Properties":{"id":"20240902165849-1mwl1yx","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902165849-pij7pvh","Type":"NodeParagraph","Properties":{"id":"20240902165849-pij7pvh","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"药材基源：为睡莲科植物莲NelumbonuciferaGaertn.的叶"}]},{"ID":"20240902165849-c7khi7c","Type":"NodeParagraph","Properties":{"id":"20240902165849-c7khi7c","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：NelumbonuciferaGaertn"}]},{"ID":"20240902165849-szsyfsz","Type":"NodeParagraph","Properties":{"id":"20240902165849-szsyfsz","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-9月花末开放时采收，除去叶柄，晒至七、八成干，对折成半圆形，晒干。夏季，亦用鲜叶或初生嫩叶(荷钱)。"}]},{"ID":"20240902165849-ei2hd8j","Type":"NodeParagraph","Properties":{"id":"20240902165849-ei2hd8j","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【原形态】莲多年生水生草本。根茎横生，肥厚，节间膨大，内有多数纵行通气孔洞，外生须状不定根。节上生叶，露出水面；叶柄着生于叶背中央，粗壮，圆柱形，多刺；叶片圆形，直径25-90cm，全缘或稍呈波状，上面粉绿色，下面叶脉从中央射出，有1-2次叉状分枝。花单生于花梗顶端，花梗与叶柄等长或稍长，也散生小刺；花直径10-20cm，芳香，红色、粉红色或白色；花瓣椭圆形或倒卵形，长5-10cm，宽3-5cm；雄蕊多数，花药条形，花丝细长，着生于托之一；心皮多数埋藏于膨大的花托内，子房椭圆形，花柱极短。花后结“莲蓬”，倒锥形，直径5-10cm，有小孔20-30个，每孔内含果实1枚；坚果椭圆形或卵形，长1.5-2.5cm，果皮革质，坚硬，熟时黑褐色。种子卵形，或椭圆形，长1.2-1.7cm，种皮红色或白色。花期6-8月，果期8-10月。"}]},{"ID":"20240902165849-l3wrque","Type":"NodeParagraph","Properties":{"id":"20240902165849-l3wrque","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902165849-wswvmob","Type":"NodeParagraph","Properties":{"id":"20240902165849-wswvmob","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"生态环境：生于水泽、池塘、湖沼或水田内，野生或栽培。"}]},{"ID":"20240902165849-vhln5bs","Type":"NodeParagraph","Properties":{"id":"20240902165849-vhln5bs","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"资源分布：广布于南北各地。"}]},{"ID":"20240902165849-kepq1lg","Type":"NodeParagraph","Properties":{"id":"20240902165849-kepq1lg","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902165849-j5tze61","Type":"NodeParagraph","Properties":{"id":"20240902165849-j5tze61","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"性状鉴别叶多折成半圆形或扇形，展开后类圆盾形，直径20-50cm，全缘或稍成波状。上表面深绿色或黄绿色，较粗糙；下表面淡灰棕色，较光滑，有粗脉21-22条，自中心向四周射出，中心有突起的叶柄残基。质脆，易破碎。微有清香气，味微苦。"}]},{"ID":"20240902165849-jzubxhc","Type":"NodeParagraph","Properties":{"id":"20240902165849-jzubxhc","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：灰绿色。①上表皮细胞表面观多角形，外壁乳头状或短绒毛突起呈双圆圈状；不定式气孔，副卫细胞5-8个。②下表皮细胞垂周壁波状弯曲，有的可见连副珠状增厚。③草酸钙簇晶直径约40μm。④导管旁常有分泌细胞，内含黄棕色物。"}]},{"ID":"20240902165849-4o811z2","Type":"NodeParagraph","Properties":{"id":"20240902165849-4o811z2","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【化学成份】荷叶含斑点亚洲罂粟碱(roemerine)，荷叶碱(nuciferine)，原荷叶碱(nornuciferine)，消旋亚美罂粟碱(armepavine)，前荷叶碱(pronuciferine)，N-去甲基荷叶碱(N-nornuciferine)，番荔枝碱(anonaine)，鹅掌楸碱(liriodenine)巴婆碱（asimilobine），N-去甲亚美罂粟碱（N-norarmepavine），北美鹅掌楸尼定碱（lirinidine）槲皮素(quercetin)，及色矢车菊素（leucocyanidin）和无色飞燕草素（leucocyanidin）。此外尚含荷叶甙（nelunboside），草酸，琥珀酸，苹果酸，柠檬酸，酒石酸，葡萄酸（gluconicside），及鞣质。从印度荷叶中还分得10-二十九烷醇（10-nonacosanol），β-谷甾醇（β-sitosterol）及两个未确定的三十碳及三十二碳的仲醇。还含去氢斑点亚洲罂粟碱（dehydroroemerine），去氢荷叶碱（dehydronuciferine），去氢番荔枝碱（dehydroanonaine），N-甲基异乌药碱（N-methylcoclau-rine）。"}]},{"ID":"20240902165849-dfr2dhz","Type":"NodeParagraph","Properties":{"id":"20240902165849-dfr2dhz","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【炮制】荷叶：以水洗净，剪去蒂及边缘，切丝，晒干。荷叶炭：取净荷叶，置锅内，上覆一口径略小的锅，上贴白纸，两锅交接处用黄泥封固，煅至白纸呈焦黄色，停火，待冷取出。"}]},{"ID":"20240902165849-xt7tm07","Type":"NodeParagraph","Properties":{"id":"20240902165849-xt7tm07","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【性味】苦；涩；平；"}]},{"ID":"20240902165849-at9o6ye","Type":"NodeParagraph","Properties":{"id":"20240902165849-at9o6ye","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【归经】心；肝；脾；胆；肺经"}]},{"ID":"20240902165849-0cos30s","Type":"NodeParagraph","Properties":{"id":"20240902165849-0cos30s","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解暑；升发清阳；散瘀止血。主暑湿烦渴；头痛眩晕；脾虚腹胀；大便泄泻；叶血下血；产后恶露不净"}]},{"ID":"20240902165849-jj7n1x6","Type":"NodeParagraph","Properties":{"id":"20240902165849-jj7n1x6","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g（鲜品15-30g）；荷叶炭3-6g，或入丸、散。外用：适量，捣敷或煎水洗。"}]},{"ID":"20240902165849-h3d4lht","Type":"NodeParagraph","Properties":{"id":"20240902165849-h3d4lht","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902165849-1n9am77","Type":"NodeParagraph","Properties":{"id":"20240902165849-1n9am77","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"1.《本草从新》：升散消耗，虚者禁之。"}]},{"ID":"20240902165849-qt30wlm","Type":"NodeParagraph","Properties":{"id":"20240902165849-qt30wlm","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"2.《随息居饮食谱》：凡上焦邪盛，治宜清降者，切不可用。"}]},{"ID":"20240902165849-1csono3","Type":"NodeParagraph","Properties":{"id":"20240902165849-1csono3","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【附方】①治秋时晚发之伏暑，并治湿温初起：连翘三钱(去心)，杏仁二钱(去皮、尖，研)，瓜蒌壳三钱，陈皮一钱五分，茯苓三钱，制半夏一钱，甘草五分，佩兰叶一钱。加荷叶二钱为引，水煎服。(《时病论》)②治阳水浮肿：败荷叶烧存性，研末。每服二钱，米饮调下，日三服。(《证治要诀》)③治雷头风证，头面疙瘩肿痛，憎寒发热，状如伤寒：荷叶一枚，升麻五钱，苍术五钱。水煎温服。(《内经类编试效方》清震汤)④治阳乘于阴，以致吐血衄血：生荷叶、生艾叶、生柏叶、生地黄各等分。上研，丸鸡子大。每服一丸，水煎服。(《妇人良方》四生丸)⑤治吐血不止：一、经霜败荷叶，烧存性，研末，新水服二钱。(《肘后方》)二、嫩荷叶七个，擂水服。(《纲目》)⑥治吐血咯血：荷叶焙干，为末，米饮下二钱匕。(《经验后方》)⑦治崩中下血：荷叶(烧研)半两，蒲黄、黄芩各一两。为末。每空心酒服三钱。(《纲目》)⑧治下痢赤白：荷叶烧研，每服二钱；红痢蜜、白痢沙糖汤下。(《纲目》)⑨治产后血运，烦闷不识人，或狂言乱语，气欲绝：荷叶三片，蒲黄二两，甘草二两(炙微赤，锉)。上药捣筛为散。每服三钱，以水一中盏，煎至五分，入生地黄汁一合，蜜半匙，更煎三、五沸，去滓，不计时候温服。(《圣惠方》荷叶散)⑩治妊娠伤寒，大热闷乱，燥渴，恐伤胎赃：卷荷叶嫩者(焙干)一两，蚌粉花半两。上为末。每服二钱，入蜜少许，新汲水调下，食前服。(《三因方》罩胎散)11.治脱肛不收：贴水荷叶，焙，研，酒服二钱，仍以荷叶盛末坐之。(《经验良方》)12.治遍身风疠：荷叶三十枚，石灰一斗，淋汁，合煮渍之，半日乃出，数日一作。(《圣惠方》)13.治赤游火丹：新生荷叶，捣烂，入盐涂之。(《摘元方》)14.治黄水疮：荷叶烧炭，研细末，香油调匀，敷患处，一日二次。(《单方验方新医疗法选编》)15.治脚胫生疮，浸淫腿膝，脓水淋漓，热痹痒痛：干荷叶四个，藁本二钱半。上细切，水二斗，煎至五升，去渣。温热得所，淋渫，仍服大黄左经汤。(《证治准绳》荷叶藁本汤)16.治漆疮：荷叶(燥者)一斤。以水一斗，煮取五升。洗了，以贯众末掺之，干则以油和涂。(《圣济总录》荷叶汤)17.治扑打坠损，恶血攻心，闷乱疼痛：火干荷叶五斤。烧令烟尽，细研，食前以童子热小便一小盏，调三钱匕，日三服。(《圣惠方》)18.治斧伤疮：荷叶烧研擦之。(《濒湖集简方》)"}]},{"ID":"20240902165849-6erplsu","Type":"NodeParagraph","Properties":{"id":"20240902165849-6erplsu","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902165849-r9zhwf1","Type":"NodeParagraph","Properties":{"id":"20240902165849-r9zhwf1","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"1.孟诜：破血。"}]},{"ID":"20240902165849-0sznvj9","Type":"NodeParagraph","Properties":{"id":"20240902165849-0sznvj9","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"2.《本草通玄》：开胃消食，止血固精。"}]},{"ID":"20240902165849-4b1r7if","Type":"NodeParagraph","Properties":{"id":"20240902165849-4b1r7if","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"3.《本草再新》：清凉解暑，止渴生津，治泻痢，解火热。"}]},{"ID":"20240902165849-i9tnovs","Type":"NodeParagraph","Properties":{"id":"20240902165849-i9tnovs","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"4.《现代实用中药》：用于妇人慢性子宫炎，赤白带下，男子遗精或夜尿证；又为解毒药。"}]},{"ID":"20240902165849-r8doruy","Type":"NodeParagraph","Properties":{"id":"20240902165849-r8doruy","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"5.《本草拾遗》：主血胀腹痛，产后胞衣不下，酒煮服之；又主食野菌毒，水煮服之。"}]},{"ID":"20240902165849-5tqhtk1","Type":"NodeParagraph","Properties":{"id":"20240902165849-5tqhtk1","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：止渴，并产后口干，心肺燥，烦闷。"}]},{"ID":"20240902165849-f1ja77e","Type":"NodeParagraph","Properties":{"id":"20240902165849-f1ja77e","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"7.《日用本草》：治呕血、吐血。"}]},{"ID":"20240902165849-xhzkrcj","Type":"NodeParagraph","Properties":{"id":"20240902165849-xhzkrcj","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"8.《滇南本草》：上清头目之风热，止眩晕，清痰，泄气，止呕，头闷疼。"}]},{"ID":"20240902165849-ktc9a5j","Type":"NodeParagraph","Properties":{"id":"20240902165849-ktc9a5j","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"9.《品汇精要》：治食蟹中毒。"}]},{"ID":"20240902165849-kpqgu3i","Type":"NodeParagraph","Properties":{"id":"20240902165849-kpqgu3i","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：生发元气，裨助脾胃，涩精浊，散瘀血，清水肿、痈肿，发痘疮。治吐血、咯血、衄血、下血、溺血、血淋、崩中、产后恶血、损伤败血。"}]},{"ID":"20240902165849-xgjk68v","Type":"NodeParagraph","Properties":{"id":"20240902165849-xgjk68v","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"11．《本草备要》；洗肾囊风。"}]},{"ID":"20240902165849-l4atmh5","Type":"NodeParagraph","Properties":{"id":"20240902165849-l4atmh5","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"12．《生草药性备要》：春汁，治白浊，(煅)存性，治莲疮。"}]},{"ID":"20240902165849-hmo2vhp","Type":"NodeParagraph","Properties":{"id":"20240902165849-hmo2vhp","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"13．《纲目》：按闻人规《痘疹八十一论》云，痘疮已出，复为风寒外袭，则窍闭血凝，其点不长，或变黑色，此为倒黡，必身痛，四肢微厥，但温肌散邪，则热气复行而斑自出也，宜紫背荷叶散治之。盖荷叶能升发阳气，散瘀血，留好血，僵蚕能解结滞之气也，此药易得而活人甚多，胜于人牙、龙脑也。又戴原礼《证治要诀》云，荷叶服之，令人瘦劣，单服可以消阳水浮肿之气。"}]},{"ID":"20240902165849-12qe9jn","Type":"NodeParagraph","Properties":{"id":"20240902165849-12qe9jn","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"14．《医林纂要》：荷叶，功略同于藕及莲心，而多入肝分，平热、去湿，以行清气，以青入肝也。然苦涩之味，实以泻心肝而清金固水，故能去瘀、保精、除妄热、平气血也。"}]},{"ID":"20240902165849-2zpf5ax","Type":"NodeParagraph","Properties":{"id":"20240902165849-2zpf5ax","updated":"20240902165905"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902165850-z434k46","Type":"NodeThematicBreak","Properties":{"id":"20240902165850-z434k46","updated":"20240902165905"}},{"ID":"20240902165852-upge8xx","Type":"NodeParagraph","Properties":{"id":"20240902165852-upge8xx","updated":"20240902165905"}}]}