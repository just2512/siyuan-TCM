aragraph","Properties":{"id":"20240729085735-o4nkz8w","updated":"20240729085735"},"Children":[{"Type":"NodeText","Data":"银杏"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雌雄树对比"}]},{"ID":"20240729085735-bihvaun","Type":"NodeParagraph","Properties":{"id":"20240729085735-bihvaun","updated":"20240729085735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"银杏雄树雌树对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/银杏雄树雌树对比-20240717161728-90ytfep.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"银杏雄树雌树对比 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/银杏雄树雌树对比 1-20240717161810-1n5ccl6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729085735-s84jjma","Type":"NodeParagraph","Properties":{"id":"20240729085735-s84jjma","updated":"20240729085735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"银杏树 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/银杏树 10-20240717162448-2k3o8sz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729085812-uactpet","Type":"NodeThematicBreak","Properties":{"id":"20240729085812-uactpet"}},{"ID":"20240902175942-rgkt8ht","Type":"NodeParagraph","Properties":{"id":"20240902175942-rgkt8ht","updated":"20240902175948"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白果叶"}]},{"ID":"20240902175942-enxw0pn","Type":"NodeParagraph","Properties":{"id":"20240902175942-enxw0pn","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"白果叶《*辞典》"}]},{"ID":"20240902175942-kku5tax","Type":"NodeParagraph","Properties":{"id":"20240902175942-kku5tax","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【出处】《品汇精要》"}]},{"ID":"20240902175942-mebt9b6","Type":"NodeParagraph","Properties":{"id":"20240902175942-mebt9b6","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiGuǒYè"}]},{"ID":"20240902175942-03x98q3","Type":"NodeParagraph","Properties":{"id":"20240902175942-03x98q3","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【来源】为银杏科植物银杏的叶片。"}]},{"ID":"20240902175942-1354g8r","Type":"NodeParagraph","Properties":{"id":"20240902175942-1354g8r","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【性状】干燥叶片，大多折叠或已破碎，完整者呈扇形。上缘有不规则波状缺刻，有时中间凹入，基部楔形，叶脉为射出数回二分又平行脉，细而密，光滑无毛，易纵向撕裂。气清香，味微涩。以叶色黄绿，整齐不破者为佳。"}]},{"ID":"20240902175942-m09msj5","Type":"NodeParagraph","Properties":{"id":"20240902175942-m09msj5","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902175942-s87hi3r","Type":"NodeParagraph","Properties":{"id":"20240902175942-s87hi3r","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"叶含异鼠李素、山柰酚、山柰酚-3-鼠李葡萄糖甙、槲皮素、芸香甙、槲皮甙，白果双黄酮、异白果双黄酮，白果苦内酯A，儿茶精、表儿茶精、汉食子儿茶精等鞣质类成分。"}]},{"ID":"20240902175942-4662431","Type":"NodeParagraph","Properties":{"id":"20240902175942-4662431","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"白果叶含蜡0.7～1％，其中10％是酸性成分，15％是蜡酯，75％是非酯成分；蜡的主要成分是白果醇、廿九烷、廿九烷-10-酮、廿八烷醇。白果叶中尚含莽草酸、α-己烯醛、亚麻酸，β-谷甾醇和微量豆甾醇等。"}]},{"ID":"20240902175942-wuju8ce","Type":"NodeParagraph","Properties":{"id":"20240902175942-wuju8ce","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【性味】《中药志》：\"甘苦涩，平。\""}]},{"ID":"20240902175942-n6mh10y","Type":"NodeParagraph","Properties":{"id":"20240902175942-n6mh10y","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902175942-4ff8jr8","Type":"NodeParagraph","Properties":{"id":"20240902175942-4ff8jr8","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"益心敛肺，化湿止泻。治胸闷心痛，心悸怔忡，痰喘咳嗽，泻痢，白带。"}]},{"ID":"20240902175942-uimrihq","Type":"NodeParagraph","Properties":{"id":"20240902175942-uimrihq","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"为末和面作饼，煨熟食之，止泻痢。\""}]},{"ID":"20240902175942-xcxxo86","Type":"NodeParagraph","Properties":{"id":"20240902175942-xcxxo86","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"②《中药志》：\"敛肺气，平喘咳，止带浊。治痰喘咳嗽，白带白浊。\""}]},{"ID":"20240902175942-0kyvjdi","Type":"NodeParagraph","Properties":{"id":"20240902175942-0kyvjdi","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"③苏医《中草药手册》：\"治象皮腿。\""}]},{"ID":"20240902175942-b32suzn","Type":"NodeParagraph","Properties":{"id":"20240902175942-b32suzn","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或研末。"}]},{"ID":"20240902175942-2elg5e6","Type":"NodeParagraph","Properties":{"id":"20240902175942-2elg5e6","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【注意】《中药志》：\"有实邪者忌用。\""}]},{"ID":"20240902175942-0zux1xo","Type":"NodeParagraph","Properties":{"id":"20240902175942-0zux1xo","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902175942-wu15hqt","Type":"NodeParagraph","Properties":{"id":"20240902175942-wu15hqt","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"用于治疗冠状动脉硬化性心脏病"}]},{"ID":"20240902175942-hnurce2","Type":"NodeParagraph","Properties":{"id":"20240902175942-hnurce2","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"初步观察对心绞痛有较好效果，对降低胆甾醇及血压也有一定作用。㈠用银杏叶的提取物制成片剂内服，每次2片（每片含黄酮2毫克），每日3次；或制成针剂肌肉注射，每次2～4毫升（每2毫升含黄酮1.3～1.7毫克），每日2次。据139例的观察，显效（心绞痛消失或明显减轻或发作次数明显减少，心电图恢复正常或好转）占34.5％，有效（心绞痛程度减轻或发作次数减少，心电图好转，但仍有波动）占43.2％。大部分病人在用药后3～10天内生效，少数在20～40天才出现疗效。停药后，部分病例症状复发，但程度较治疗前为轻，继续用药仍然有效。约近半数病例心电图恢复正常或存改善，但与心绞痛的改善并不完全一致。血压高的病例，多数用药后有不同程度的下降，但单独应用不及与降压药合并使用效果显著。49例高胆甾醇的患者，治疗后下降20～40毫克％或40毫克％以上的25例，占51.02％，上升20毫克％的18例，无变化6例。另据100例血清胆甾醇过高症的治疗结果，胆甾醇降低者88例，磷脂升高者65例，胆甾醇与磷脂之比例有改善者71例；3项综合评定：显效者49例，有效者50例，无效1例。也有通过23例观察，未见血压和胆甾醇有明显变化。㈡用银杏甙元含片（每片含银杏甙元0.5毫克）舌下含服，每次2片，每日3次。治疗心绞痛41例，总有效率70.1％，其中显效占34.1％。原来用硝酸甘油的32例患者，治疗后15例减量，9例停药。约半数病人治疗前心电图显示有冠状动脉供血不足，9周后复查改善情况与临床疗效相符。有用银杏叶双黄酮片剂舌下含服，每次2片（含1.2毫克），每日3次。24例心绞痛患者经治疗6周后，1例显效，9例改善，14例基本无效；原来用硝酸甘油的21例，治疗后停用者1例，减量者9例；心电图有异常的18例中，有1例好转。疗效发生时间，最早在用药后2周，多数在4～5周。㈢银杏叶、川芎、红花各5钱，制成片剂，每日3次分服。60例心绞痛患者，服药8周后总有效率为75.5％，其中显效率为11.7％。见效时间在2～5周。半数以上病例可以停用或减少硝酸甘油类药物的用量。另有用银杏叶、首乌、钩藤制成片剂内服，每日量均为1.5钱，治疗心绞痛129例，服药后4周的近期有效率为60.4％，显效率占8.5％，疗效大多出现在服药2周内。此外，还有用银杏叶配合杜仲、首乌，或配合锦鸡儿，制成片剂或针剂，对心绞痛、高血压，及降低胆甾醇方面均有一定效果。银杏叶的副作用较少，但也有少数患者有食欲减退、恶心、稀便、腹胀，口干、鼻塞及头晕、头痛、耳鸣等，个别病例出现过敏性皮疹。如在治疗过程中出现血压明显下降，心绞痛加重，特别是心功能不全加重时，需减量或停药。"}]},{"ID":"20240902175942-mcakqkr","Type":"NodeParagraph","Properties":{"id":"20240902175942-mcakqkr","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902175942-vswfmt1","Type":"NodeParagraph","Properties":{"id":"20240902175942-vswfmt1","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"白果叶《中华本草》"}]},{"ID":"20240902175942-wsikwyy","Type":"NodeParagraph","Properties":{"id":"20240902175942-wsikwyy","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【出处】出自《品汇精要》。"}]},{"ID":"20240902175942-8j5lpl0","Type":"NodeParagraph","Properties":{"id":"20240902175942-8j5lpl0","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiGuǒYè"}]},{"ID":"20240902175942-cqkb1is","Type":"NodeParagraph","Properties":{"id":"20240902175942-cqkb1is","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【别名】银杏叶"}]},{"ID":"20240902175942-lrwxje5","Type":"NodeParagraph","Properties":{"id":"20240902175942-lrwxje5","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175942-qdxbbce","Type":"NodeParagraph","Properties":{"id":"20240902175942-qdxbbce","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"药材基源：为银杏科植物银杏的叶。"}]},{"ID":"20240902175942-m3alus0","Type":"NodeParagraph","Properties":{"id":"20240902175942-m3alus0","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：GinkgobilobeL."}]},{"ID":"20240902175942-3mjete2","Type":"NodeParagraph","Properties":{"id":"20240902175942-3mjete2","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采，除去杂质，洗净，晒干或鲜用。"}]},{"ID":"20240902175942-6urm0yl","Type":"NodeParagraph","Properties":{"id":"20240902175942-6urm0yl","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【原形态】银杏，落叶乔木，高可达40m。枝有有长枝与短枝，幼树树皮淡灰褐色，浅纵裂，老则灰褐色，深纵裂。叶在长枝上螺旋状散生，在短枝上3-5（-8）簇生；柄长3-10cm；叶片扇形，淡绿色，无毛，有多数2叉状并列的细脉，上缘宽5-8cm，浅波状，有时中央浅裂或深裂。雌雄异株，花单性，稀同株；球花生于短枝顶端的鳞片状叶的腋内；雄球花成柔荑花序状，下垂；雌球花有长梗，梗端常分2叉，每叉顶生一盘状珠座，每珠座生一胚珠，仅一个发育成种子。种子核果状，椭圆形至近球形，长2.5-3.5cm，径约2cm；外种皮肉质，有白粉，熟时淡黄色或橙黄色；中种皮骨质，白色，具2-3棱；内种皮膜质，胚乳丰富。花期3-4月，种子成熟期9-10月。"}]},{"ID":"20240902175942-rog2zbm","Type":"NodeParagraph","Properties":{"id":"20240902175942-rog2zbm","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902175942-recy7bv","Type":"NodeParagraph","Properties":{"id":"20240902175942-recy7bv","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔500-1000m的酸性土壤、排水良好地带的天然林中。"}]},{"ID":"20240902175942-rtv6xfo","Type":"NodeParagraph","Properties":{"id":"20240902175942-rtv6xfo","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"资源分布：北自沈阳，南达广州，东起华东，西南至贵州、云南都有栽培。"}]},{"ID":"20240902175942-omv6yy7","Type":"NodeParagraph","Properties":{"id":"20240902175942-omv6yy7","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175942-eji75kf","Type":"NodeParagraph","Properties":{"id":"20240902175942-eji75kf","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"1.性状鉴定叶片多皱折或破碎，完整呈扇形，长4-8cm，宽5-10cm，上缘有不规则波状缺刻，有的中央凹入，基部楔形，叶脉细密，为多数二叉状平行脉；叶柄长2-7cm。纸质，易纵向撕裂。气微，味微涩。以色黄绿、完整者为佳。"}]},{"ID":"20240902175942-qbp1mk8","Type":"NodeParagraph","Properties":{"id":"20240902175942-qbp1mk8","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别叶横切面上表面细胸1列，外被角质层。叶肉细胞分化不明显，多用形或类长圆形，细胞中常含棕色物或布满油滴状物；维管束外韧型，分泌道存在于维管束间。下表皮细胞1列，外被角质层；有内陷气孔。较老叶维管束周围有1-2列厚壁细胞组成的维管束鞘；叶内细胞含草酸钙簇晶，直径8-106μm。"}]},{"ID":"20240902175942-bgi4xid","Type":"NodeParagraph","Properties":{"id":"20240902175942-bgi4xid","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"3.理化鉴别（1）取本品碎片10g，加水10ml，煮沸15mim，趁热滤过。取滤液2ml，加镁粉少量及盐酸3-4滴，置水浴中加热分钟，显棕红色。（检查黄酮类）（2）取上述滤液适量点于滤纸上，喷2%三氯化铝乙醇溶液，干后置紫外光灯（365nm）下观察，显黄绿色荧光。（检查黄酮类）"}]},{"ID":"20240902175942-1hedxlg","Type":"NodeParagraph","Properties":{"id":"20240902175942-1hedxlg","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【化学成份】叶含黄酮类化合物属于黄酮类及其甙的成分有山柰酚（keampferol），木犀草素（luteolin）,杨梅树皮素（myricetin）,槲皮素（quercetin）,异鼠李素（isorhamnetin）,丁香黄素（syringetin）,山柰酚-3-鼠李葡萄糖甙（kaempferol-3-rhamno-glucoside）,山柰酚-3（6-对香豆酰葡萄糖基-β-1，4-鼠李糖甙[kaempferol-3-(6-p-coumaroylglucosyl-β-1，4-rhamnoside)],山柰酚-3-O-（2-O-β-D-吡喃葡萄糖基）-α-L-吡喃鼠李糖甙[kaempfer-ol-3-O(2-O-β-D-glucopyranosyl)-α-L-rhamnoyranoside],山柰酚-3-O-[2-O-6-O-[对-（7-O-β-D-吡喃葡萄糖基）香豆酰基]-β-D-吡喃葡萄糖基]-α-L-吡喃鼠李糖甙"}]},{"ID":"20240902175942-8uoecz9","Type":"NodeParagraph","Properties":{"id":"20240902175942-8uoecz9","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902175942-31fie3x","Type":"NodeParagraph","Properties":{"id":"20240902175942-31fie3x","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"1.对心血管的影响从白果叶中提出的黄酮醇Flavonol(为槲皮素、山柰酚、异鼠李素之混合物)或银杏双黄酮类，对豚鼠离体心脏灌流可引起冠状血管扩张，注射于豚鼠后肢灌流之动脉内，可扩张后肢血营，叶中之双黄酮对大鼠后肢血管亦有扩张作用。叶的粗提取物(每1ml含总黄酮甙4.263mg)可对抗肾上腺素所致离体兔耳的血管收缩作用，总甙之作用较弱；对麻醉兔肌肉注射临床用量的20-40倍，对血压、呼吸均无影响。乙醇提取物与黄酮醇一样，对猫、兔血压、心脏、呼吸亦无影响；如应用大于血管扩张剂量100-1000倍的黄酮醇，注射于豚鼠，可引起中等度的降压，心率及呼吸的增加；对大白鼠则表现升压，但这些改变与麻醉、动物兴奋、溶剂的影响有关，无实际价值。叶的提取制剂口服或静脉注射，可使巴金森氏病患者的脑血流增加，改善脑的营养。"}]},{"ID":"20240902175942-wm7g9zb","Type":"NodeParagraph","Properties":{"id":"20240902175942-wm7g9zb","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"2.对平滑肌的作用黄酮醇或银杏双黄酮类对豚鼠离体肠管有解痉作用，有对抗徐缓激肽的作用，还能对抗组织胺及氯化钡引起的痉挛，其作用强度与罂粟碱相似，但较持久；叶的乙醇提取物对豚鼠离体气管和回肠，能拮抗组织胺和乙酰胆碱的致痉作用，在肠管实验中还可对抗氯化钡的作用，腹腔注射可制止组织胺所致之豚鼠哮喘，银杏叶的黄酮类物在豚鼠肺溢流实验或组胺喷雾实验中，表现对支气管有扩张作用。叶中的双黄酮对心动徐缓素Bradykinin所致肠管痉挛有解痉作用。"}]},{"ID":"20240902175942-pps471e","Type":"NodeParagraph","Properties":{"id":"20240902175942-pps471e","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"3.其他作用：含有黄酮、银杏亭、白果双黄酮的片剂，对高胆甾醇血症患者似能降低血清胆甾醇水平、升高磷脂，改善C/P比值，对高血压病人似有一定的降压作用，但幅度不大。初步试管试验对绿脓杆菌、金黄色葡萄球菌、痢疾杆菌有抑菌作用。从银杏树皮中分离出之生物碱具有收缩血管及扩张瞳孔的作用。"}]},{"ID":"20240902175942-yv1t28l","Type":"NodeParagraph","Properties":{"id":"20240902175942-yv1t28l","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【毒性】叶提取物0.5-1ml／kg(1ml相当0.5g生药)给家兔静脉注射连续10天，对血象，肝、肾功能及病理检查均无改变，用比人用量大10-40倍的药物，给狗连续静脉注射1周，出现流涎、恶心、呕吐、腹泻、食欲减退等现象；组织切片检查，小肠粘膜分泌亢进，麻醉狗、兔肠蠕动增加，注射局部血管变硬。黄酮醇对血象、凝血系统无影响，但更高剂量可妨碍血液凝固。"}]},{"ID":"20240902175942-v5mftw3","Type":"NodeParagraph","Properties":{"id":"20240902175942-v5mftw3","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【性味】苦；甘；涩；性平；小毒"}]},{"ID":"20240902175942-5z0kyfr","Type":"NodeParagraph","Properties":{"id":"20240902175942-5z0kyfr","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【归经】心；肺；脾经"}]},{"ID":"20240902175942-9wznu6g","Type":"NodeParagraph","Properties":{"id":"20240902175942-9wznu6g","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【功能主治】活血养心，敛肺涩肠。主胸痹心痛；喘咳痰嗽；泄泻痢疾；白带"}]},{"ID":"20240902175942-bpkv9on","Type":"NodeParagraph","Properties":{"id":"20240902175942-bpkv9on","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-9g；或用提取物作片剂；或入丸、散。外用：适量，捣敷或搽；或煎水洗。"}]},{"ID":"20240902175942-vjt66px","Type":"NodeParagraph","Properties":{"id":"20240902175942-vjt66px","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【注意】《中药志》：有实邪者忌用。"}]},{"ID":"20240902175942-2fqr0mv","Type":"NodeParagraph","Properties":{"id":"20240902175942-2fqr0mv","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902175942-v0k2bjz","Type":"NodeParagraph","Properties":{"id":"20240902175942-v0k2bjz","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"1.《品汇精要》：为末和面作饼，煨熟食之，止泻痢。"}]},{"ID":"20240902175942-out9f6n","Type":"NodeParagraph","Properties":{"id":"20240902175942-out9f6n","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"2.《中药志》：敛肺气，平喘咳，止带浊。治痰喘咳嗽，白带白浊。"}]},{"ID":"20240902175942-ybp353c","Type":"NodeParagraph","Properties":{"id":"20240902175942-ybp353c","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"3.苏医《中草药手册》：治象皮腿。"}]},{"ID":"20240902175942-p62p6jz","Type":"NodeParagraph","Properties":{"id":"20240902175942-p62p6jz","updated":"20240902175949"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902175943-dx53den","Type":"NodeThematicBreak","Properties":{"id":"20240902175943-dx53den","updated":"20240902175949"}},{"ID":"20240902175944-qk0rlzj","Type":"NodeParagraph","Properties":{"id":"20240902175944-qk0rlzj","updated":"20240902175949"}}]}