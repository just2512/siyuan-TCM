pe":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桂花 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桂花 16-20240715130911-fw8emd7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715124752-f56fjlv","Type":"NodeParagraph","Properties":{"id":"20240715124752-f56fjlv","updated":"20240715124927"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 560px;","style":"width: 550px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桂花 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桂花 3-20240715124927-h3izqn6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 550px;\" parent-style=\"width: 560px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 561px;","style":"width: 551px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桂花 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桂花 2-20240715124752-y9o744i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 551px;\" parent-style=\"width: 561px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902092103-pz0716i","Type":"NodeParagraph","Properties":{"id":"20240902092103-pz0716i","updated":"20240902092118"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为木犀树的花；"}]},{"ID":"20240715124756-mkb1adq","Type":"NodeThematicBreak","Properties":{"id":"20240715124756-mkb1adq"}},{"ID":"20240715124936-qoztf4s","Type":"NodeParagraph","Properties":{"id":"20240715124936-qoztf4s","updated":"20240902092205"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂花"}]},{"ID":"20240902092213-ppc53uy","Type":"NodeParagraph","Properties":{"id":"20240902092213-ppc53uy","updated":"20240902092213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味归经"}]},{"ID":"20240902092213-dqhrxva","Type":"NodeParagraph","Properties":{"id":"20240902092213-dqhrxva","updated":"20240902092213"},"Children":[{"Type":"NodeText","Data":"性温，味辛。归肺经、脾经、肾经。"}]},{"ID":"20240902092226-dvfkqfb","Type":"NodeParagraph","Properties":{"id":"20240902092226-dvfkqfb","updated":"20240902092226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能"}]},{"ID":"20240902092226-z22vnrq","Type":"NodeParagraph","Properties":{"id":"20240902092226-z22vnrq","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"温肺化饮，散寒止痛。"}]},{"ID":"20240902092226-np6meoj","Type":"NodeParagraph","Properties":{"id":"20240902092226-np6meoj","updated":"20240902092226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主治"}]},{"ID":"20240902092226-54dzqz8","Type":"NodeParagraph","Properties":{"id":"20240902092226-54dzqz8","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"用于痰饮咳喘，脘腹冷痛，肠风血痢，经闭痛经，寒疝腹痛，牙痛，口臭。"}]},{"ID":"20240902092226-tmafqwt","Type":"NodeParagraph","Properties":{"id":"20240902092226-tmafqwt","updated":"20240902092226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"}]},{"ID":"20240902092226-p8uqsg7","Type":"NodeParagraph","Properties":{"id":"20240902092226-p8uqsg7","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"内服：煎汤，3-9g；或泡茶。"}]},{"ID":"20240902092226-1tljnvo","Type":"NodeParagraph","Properties":{"id":"20240902092226-1tljnvo","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"外用：适量，煎汤含漱或蒸热外熨。"}]},{"ID":"20240902092226-n91wmje","Type":"NodeParagraph","Properties":{"id":"20240902092226-n91wmje","updated":"20240902092226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相关论述"}]},{"ID":"20240902092226-a7fuq6w","Type":"NodeParagraph","Properties":{"id":"20240902092226-a7fuq6w","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"1、《纲目》：“同麻油蒸熟，润发及作面脂。”"}]},{"ID":"20240902092226-orfxnk4","Type":"NodeParagraph","Properties":{"id":"20240902092226-orfxnk4","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"2、《本草汇言》：“散冷气，消瘀血，止肠风血痢。凡患阴寒冷气，瘕疝奔豚，腹内一切冷病，蒸热布裹熨之。”"}]},{"ID":"20240902092226-d3zzzgg","Type":"NodeParagraph","Properties":{"id":"20240902092226-d3zzzgg","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"3、柴裔《食鉴本草》：“益阳消阴，平肝补肾。”"}]},{"ID":"20240902092226-bgsc6rb","Type":"NodeParagraph","Properties":{"id":"20240902092226-bgsc6rb","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"4、《国药的药理学》：“除口臭及视物不明。”"}]},{"ID":"20240902092226-7tleu94","Type":"NodeParagraph","Properties":{"id":"20240902092226-7tleu94","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"5、《安徽中草药》：“散寒破结，温肺止咳。主治胃寒腹痛，瘰疬。”"}]},{"ID":"20240902092226-jdetiz1","Type":"NodeParagraph","Properties":{"id":"20240902092226-jdetiz1","updated":"20240902092226"},"Children":[{"Type":"NodeText","Data":"6、《浙江药用植物志》：“治痰饮喘咳，经闭腹痛。”"}]},{"ID":"20240902092241-pvi8fdq","Type":"NodeParagraph","Properties":{"id":"20240902092241-pvi8fdq","updated":"20240902092241"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"临床应用"}]},{"ID":"20240902092241-9tsbswk","Type":"NodeParagraph","Properties":{"id":"20240902092241-9tsbswk","updated":"20240902092241"},"Children":[{"Type":"NodeText","Data":"1、生津，辟臭，化痰，治风虫牙痛：木犀花、百药煎、孩儿茶。作膏饼噙。（《纲目》）"}]},{"ID":"20240902092241-jp4x4fl","Type":"NodeParagraph","Properties":{"id":"20240902092241-jp4x4fl","updated":"20240902092241"},"Children":[{"Type":"NodeText","Data":"2、治口臭：桂花6g，蒸馏水500ml，浸泡一昼夜，漱口用。（《青岛中草药手册》）"}]},{"ID":"20240902092241-aiasvk4","Type":"NodeParagraph","Properties":{"id":"20240902092241-aiasvk4","updated":"20240902092241"},"Children":[{"Type":"NodeText","Data":"3、治胃寒腹痛：桂花、高良姜各4.5g，小茴香3g。煎服。（《安徽中草药》）"}]},{"ID":"20240902092252-3s7r4bi","Type":"NodeParagraph","Properties":{"id":"20240902092252-3s7r4bi","updated":"20240902092252"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相关方剂"}]},{"ID":"20240902092252-qy6becm","Type":"NodeParagraph","Properties":{"id":"20240902092252-qy6becm","updated":"20240902092252"},"Children":[{"Type":"NodeText","Data":"①治口臭：桂花适量，煎水含漱。(《安徽中草药》)"}]},{"ID":"20240902092252-4sxn5ds","Type":"NodeParagraph","Properties":{"id":"20240902092252-4sxn5ds","updated":"20240902092252"},"Children":[{"Type":"NodeText","Data":"②治胃寒腹痛：桂花、高良姜各4.5克，小茴香3克。煎服。(《安徽中草药》)"}]},{"ID":"20240902092252-5sgfhm0","Type":"NodeParagraph","Properties":{"id":"20240902092252-5sgfhm0","updated":"20240902092252"},"Children":[{"Type":"NodeText","Data":"③治胃寒气痛：桂花3克，香附、高良姜各9克，砂仁6克。水煎服。(《青岛中草药手册》)"}]},{"ID":"20240902092252-wd0rwp3","Type":"NodeParagraph","Properties":{"id":"20240902092252-wd0rwp3","updated":"20240902092252"},"Children":[{"Type":"NodeText","Data":"④治经闭腹痛：桂花、对月草、倒竹散、益母草各12克，艾叶9克，月季花6克。水煎服。(《万县中草药》)"}]},{"ID":"20240902092303-gd2jb5l","Type":"NodeParagraph","Properties":{"id":"20240902092303-gd2jb5l","updated":"20240902092303"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药膳食疗"}]},{"ID":"20240902092303-7m5mxhx","Type":"NodeParagraph","Properties":{"id":"20240902092303-7m5mxhx","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"桂花糖炖雪梨杏脯："}]},{"ID":"20240902092303-8zsqgl5","Type":"NodeParagraph","Properties":{"id":"20240902092303-8zsqgl5","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"1、材料：雪梨200克，杏10克，桂花糖20克。"}]},{"ID":"20240902092303-jfi76i5","Type":"NodeParagraph","Properties":{"id":"20240902092303-jfi76i5","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"2、做法：雪梨去核切块，杏脯切条，将杏脯放在雪梨上，注入适量清水，用保鲜膜将碗口封住，电蒸锅注水烧开，放入食材，盖上锅盖，调转旋钮定时蒸20分钟，待时间到取出，去除保鲜膜，加入桂花糖即可。"}]},{"ID":"20240902092303-v35d22m","Type":"NodeParagraph","Properties":{"id":"20240902092303-v35d22m","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"3、功效：散寒润肺、化痰止咳。"}]},{"ID":"20240902092303-wxg5onc","Type":"NodeParagraph","Properties":{"id":"20240902092303-wxg5onc","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"桂花山药羹："}]},{"ID":"20240902092303-vw0jxgf","Type":"NodeParagraph","Properties":{"id":"20240902092303-vw0jxgf","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"1、药材：山药150克，鲜桂花5克(干品1克)。冰糖适量。"}]},{"ID":"20240902092303-dobbzmk","Type":"NodeParagraph","Properties":{"id":"20240902092303-dobbzmk","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"2、做法：将去皮洗净切成小丁的山药放入锅中，加水适量开始煮。待山药煮至七八成熟时，放入桂花、冰糖，煮至山药糯软、汤汁浓稠，即可食用。"}]},{"ID":"20240902092303-85g5t86","Type":"NodeParagraph","Properties":{"id":"20240902092303-85g5t86","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"3、功效：健脾固肾、补肺化痰。适用于痰饮喘咳、肺结核低热、慢性支气管炎、泄泻等症。"}]},{"ID":"20240902092303-d77c28v","Type":"NodeParagraph","Properties":{"id":"20240902092303-d77c28v","updated":"20240902092303"},"Children":[{"Type":"NodeText","Data":"4、食法：随时食用。"}]},{"ID":"20240902092308-44o3b3a","Type":"NodeParagraph","Properties":{"id":"20240902092308-44o3b3a","updated":"20240902092308"},"Children":[{"Type":"NodeText","Data":"桂花肚丝："}]},{"ID":"20240902092308-evdyk8d","Type":"NodeParagraph","Properties":{"id":"20240902092308-evdyk8d","updated":"20240902092308"},"Children":[{"Type":"NodeText","Data":"1、药材：桂花20朵。熟猪肚400克，胡萝卜40克，料酒10毫升，醋5毫升，盐3克，味精1克，水淀粉10毫升，鸡汤20毫升，植物油300克，葱末、姜末、蒜末各5克。"}]},{"ID":"20240902092308-mp507ia","Type":"NodeParagraph","Properties":{"id":"20240902092308-mp507ia","updated":"20240902092308"},"Children":[{"Type":"NodeText","Data":"2、做法：桂花用清水洗净;猪肚洗净，切成丝：胡萝卜洗净切丝。锅入植物油，烧至八成热时，入猪肚和胡萝卜，迅速翻炒5分钟捞出。锅留底油，加入葱末、姜末、蒜末、肚丝、胡萝卜丝，倒料酒、醋，加入鸡汤、盐、味精，烧开后加水淀粉勾芡，倒入桂花搅匀即可。"}]},{"ID":"20240902092308-1fehjs2","Type":"NodeParagraph","Properties":{"id":"20240902092308-1fehjs2","updated":"20240902092308"},"Children":[{"Type":"NodeText","Data":"3、功效：补益脾胃。"}]},{"ID":"20240902092308-udl7y7b","Type":"NodeParagraph","Properties":{"id":"20240902092308-udl7y7b","updated":"20240902092308"},"Children":[{"Type":"NodeText","Data":"4、食法：佐餐食用。"}]},{"ID":"20240902092329-2f5vd4z","Type":"NodeParagraph","Properties":{"id":"20240902092329-2f5vd4z","updated":"20240902092329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药材性状"}]},{"ID":"20240902092329-xqb955p","Type":"NodeParagraph","Properties":{"id":"20240902092329-xqb955p","updated":"20240902092329"},"Children":[{"Type":"NodeText","Data":"花小，具细柄；花萼细小，浅4裂，膜质；花冠4裂，裂片矩圆形，多皱缩，长3-4mm，淡黄至黄棕色。气芳香，味淡。以身干、色淡黄、有香气者为佳。"}]},{"ID":"20240902092329-rul2nvt","Type":"NodeParagraph","Properties":{"id":"20240902092329-rul2nvt","updated":"20240902092329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"品种分类"}]},{"ID":"20240902092329-wvlckzt","Type":"NodeParagraph","Properties":{"id":"20240902092329-wvlckzt","updated":"20240902092329"},"Children":[{"Type":"NodeText","Data":"桂花经过长期栽植、自然杂交和人工选育，产生了许多栽培品种。通过进一步调查清理，已初步确定各桂花品种32个。以花色而言，有金桂、银桂、丹桂之分；以叶型而言，有柳叶桂、金扇桂、滴水黄、葵花叶、柴柄黄之分；以花期而言，有八月桂、四季桂等之分等。"}]},{"ID":"20240902092329-be4v5xz","Type":"NodeParagraph","Properties":{"id":"20240902092329-be4v5xz","updated":"20240902092329"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂花辨别"}]},{"ID":"20240902092329-ca4380g","Type":"NodeParagraph","Properties":{"id":"20240902092329-ca4380g","updated":"20240902092329"},"Children":[{"Type":"NodeText","Data":"先看：花色均匀，大小较一致的为好。"}]},{"ID":"20240902092329-phfppst","Type":"NodeParagraph","Properties":{"id":"20240902092329-phfppst","updated":"20240902092329"},"Children":[{"Type":"NodeText","Data":"再闻：无霉味，气味清淡纯香，不浓郁。"}]},{"ID":"20240902092329-i53v6g1","Type":"NodeParagraph","Properties":{"id":"20240902092329-i53v6g1","updated":"20240902092329"},"Children":[{"Type":"NodeText","Data":"试泡：试泡一些，水变色不明显，气味久不消退。为较好。那种水变色，泡前气味浓郁，泡后无味的为添加香精的。"}]},{"ID":"20240902092349-udoo04u","Type":"NodeThematicBreak","Properties":{"id":"20240902092349-udoo04u"}},{"ID":"20240902092350-lsgvcbw","Type":"NodeParagraph","Properties":{"id":"20240902092350-lsgvcbw"}}]}