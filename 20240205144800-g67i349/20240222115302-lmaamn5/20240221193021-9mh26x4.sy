{"ID":"20240221193021-9mh26x4","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240221193021-9mh26x4","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240221193021-9mh26x4\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240221193030-qu67a98\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240221193030-qu67a98\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240221193030-qu67a98\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"桂花","type":"doc","updated":"20240902092350"},"Children":[{"ID":"20240221193030-qu67a98","Type":"NodeParagraph","Properties":{"id":"20240221193030-qu67a98","updated":"20240715125910"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240221193030-vx24ge4.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 691px;","style":"width: 681px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桂花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桂花 8-20240715125910-8cjar3x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 681px;\" parent-style=\"width: 691px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715124700-eavupyi","Type":"NodeParagraph","Properties":{"id":"20240715124700-eavupyi","updated":"20240715125240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 461px;","st