3px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 9-20240715092751-d1pky2j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715093137-mso383x","Type":"NodeParagraph","Properties":{"id":"20240715093137-mso383x","updated":"20240715094143"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 12-20240715093137-vxi17wl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 580px;","style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"构树 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/构树 13-20240715093211-b4apxg8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\" parent-style=\"width: 580px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715091349-9fw2byi","Type":"NodeParagraph","Properties":{"id":"20240715091349-9fw2byi","updated":"20240715092044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：同一株钩树的叶子有多种形态；"}]},{"ID":"20240715092045-d2adtuo","Type":"NodeParagraph","Properties":{"id":"20240715092045-d2adtuo","updated":"20240715093035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：构树分雌雄异株；雄树的花为柔荑花序，长至3-8cm，可作为一种难得的野菜食用，雌树的花为球形头状，顶端被毛，聚花果直径1.5-3cm，成熟时橙红色，肉质，有些人小时候常摘来吃，中药名叫禇实子；"}]},{"ID":"20240715091349-1ic19yv","Type":"NodeThematicBreak","Properties":{"id":"20240715091349-1ic19yv"}},{"ID":"20240902085724-i8xjcnh","Type":"NodeParagraph","Properties":{"id":"20240902085724-i8xjcnh","updated":"20240902085726"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"构树"}]},{"ID":"20240715091350-cp5bykg","Type":"NodeParagraph","Properties":{"id":"20240715091350-cp5bykg","updated":"20240830173009"},"Children":[{"Type":"NodeText","Data":"功能主治\n子：补肾，强筋骨，明目，利尿。对于出现腰膝酸软，肾虚目昏，阳痿，水肿的患者服用构树子是比较有疗效的，效果不错。\n叶：构树的叶可以清热，凉血，利湿，杀虫。用于鼻衄，肠炎，痢疾。\n皮：构树的皮可以利尿消肿，祛风湿。用于水肿，筋骨酸痛；外用治神经性皮炎及癣症。\n乳：利水消肿解毒，治水肿癣疾，蛇、虫、蜂、蝎、狗咬。"}]},{"ID":"20240830173023-5u1qdwn","Type":"NodeParagraph","Properties":{"id":"20240830173023-5u1qdwn","updated":"20240830173025"},"Children":[{"Type":"NodeText","Data":"单方验方\n咽喉肿痛，咳嗽痰多：准备二十克构树根，二十克香茅草根，十五克草决明根，三十克稻草根，十五克马鞭草根。煎汤内服或泡水代茶饮，效果甚佳。\n久咳不愈：用二十克构树根，十五克小拔毒散，十五克草决明根，十五克千张纸根。煎汤内服。\n恶心呕吐，不思饮食：构树根20克，糯米饭20克，石菖蒲10克。煎汤内服。\n用法用量：子10 - 20克；叶15 - 30克；皮15 - 25克，外用割伤树皮取鲜浆汁外擦。"}]},{"ID":"20240830173010-6badm6b","Type":"NodeThematicBreak","Properties":{"id":"20240830173010-6badm6b"}},{"ID":"20240830173011-9fvn9xl","Type":"NodeParagraph","Properties":{"id":"20240830173011-9fvn9xl"}}]}