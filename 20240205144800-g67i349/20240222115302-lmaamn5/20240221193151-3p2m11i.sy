Image","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"凤仙花 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/凤仙花 14-20240727133148-kj3ua9q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727133730-mr40omo","Type":"NodeParagraph","Properties":{"id":"20240727133730-mr40omo","updated":"20240727133730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"凤仙花果实爆炸20240727_133659"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/凤仙花果实爆炸20240727_133659-20240727133729-s9akfgh.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727132512-2whup9p","Type":"NodeParagraph","Properties":{"id":"20240727132512-2whup9p","updated":"20240727133205"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：凤仙花的种子被称之为‘急性子’，因为稍微有点外力作用，种子就会爆炸开来（民间有一种用法是炖肉炖排骨不容易炖烂，放点‘急性子’就容易煮烂了）；"}]},{"ID":"20240727131657-wka61y9","Type":"NodeThematicBreak","Properties":{"id":"20240727131657-wka61y9"}},{"ID":"20240902175339-sounsfv","Type":"NodeParagraph","Properties":{"id":"20240902175339-sounsfv","updated":"20240902175347"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：透骨草"}]},{"ID":"20240902175339-kv3wd0y","Type":"NodeParagraph","Properties":{"id":"20240902175339-kv3wd0y","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"透骨草《全国中草药汇编》"}]},{"ID":"20240902175339-x3pab2y","Type":"NodeParagraph","Properties":{"id":"20240902175339-x3pab2y","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【拼音名】TòuGǔCǎo"}]},{"ID":"20240902175339-cc57jnt","Type":"NodeParagraph","Properties":{"id":"20240902175339-cc57jnt","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【来源】大戟科地构叶属植物地构叶Speranskiatuberculata（Bunge）Baill.、凤仙花科草本植物凤仙花ImpatiensbalsaminaL.、紫葳科角蒿属植物角蒿IncarvilleasinensisLam.、豆科野豌豆属植物山野豌豆ViciaamoenaFisch.的全草和杜鹃花科白珠树属植物滇白珠Gaultheriayunnanensis（Franch.）Rehd.的全株。夏秋采。"}]},{"ID":"20240902175339-ec51ay3","Type":"NodeParagraph","Properties":{"id":"20240902175339-ec51ay3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【炮制】洗净，晒干，切碎用。"}]},{"ID":"20240902175339-7ihuxd5","Type":"NodeParagraph","Properties":{"id":"20240902175339-7ihuxd5","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【性味】辛、苦，温。有小毒。"}]},{"ID":"20240902175339-svb95tl","Type":"NodeParagraph","Properties":{"id":"20240902175339-svb95tl","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾经。"}]},{"ID":"20240902175339-gorn1rn","Type":"NodeParagraph","Properties":{"id":"20240902175339-gorn1rn","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿，解毒止痛。用于风湿关节痛；外用治疮疡肿毒。"}]},{"ID":"20240902175339-8jqye63","Type":"NodeParagraph","Properties":{"id":"20240902175339-8jqye63","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【用法用量】2～3钱，煎服。外用适量，煎汤熏洗患处。"}]},{"ID":"20240902175339-7xw2x5a","Type":"NodeParagraph","Properties":{"id":"20240902175339-7xw2x5a","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用治风湿痹痛无论新久，均可应用。可配合五加皮、忍冬藤、油松节、威灵仙要同用。对于跌打损伤、瘀滞疼痛，或妇女经闭不行，可配合当归、桃仁、泽兰等药同用。此外本品还可治疗疮疖痈肿、蛇虫咬伤，可用鲜草适量，打烂外敷。"}]},{"ID":"20240902175339-o3xufin","Type":"NodeParagraph","Properties":{"id":"20240902175339-o3xufin","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902175339-umz6765","Type":"NodeParagraph","Properties":{"id":"20240902175339-umz6765","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"透骨草《*辞典》"}]},{"ID":"20240902175339-fjjwk9x","Type":"NodeParagraph","Properties":{"id":"20240902175339-fjjwk9x","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【出处】《灵秘丹药笺》"}]},{"ID":"20240902175339-76scr91","Type":"NodeParagraph","Properties":{"id":"20240902175339-76scr91","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【拼音名】TòuGǔCǎo"}]},{"ID":"20240902175339-ty9nat0","Type":"NodeParagraph","Properties":{"id":"20240902175339-ty9nat0","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175339-b7p77ku","Type":"NodeParagraph","Properties":{"id":"20240902175339-b7p77ku","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"为大戟科植物地构叶或凤仙花科植物凤仙的全草。"}]},{"ID":"20240902175339-e30rmhq","Type":"NodeParagraph","Properties":{"id":"20240902175339-e30rmhq","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①地构叶于5～6月间开花结实时采收，晒干。"}]},{"ID":"20240902175339-ql5w8t8","Type":"NodeParagraph","Properties":{"id":"20240902175339-ql5w8t8","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②凤仙于夏、秋季种子成熟时采收，除去细枝，晒干。"}]},{"ID":"20240902175339-7svd8lt","Type":"NodeParagraph","Properties":{"id":"20240902175339-7svd8lt","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902175339-zdxu9hw","Type":"NodeParagraph","Properties":{"id":"20240902175339-zdxu9hw","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①地构叶，又名：地构菜。"}]},{"ID":"20240902175339-61um3f7","Type":"NodeParagraph","Properties":{"id":"20240902175339-61um3f7","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～50厘米。根茎横走，淡黄褐色。茎直立，丛生，被灰白色卷曲柔毛。叶互生；无柄或具短柄；叶片披针形至椭圆状披针形，厚纸质，长1.5～7厘米，宽0.5～2厘米，先端钝尖或渐尖，基部阔楔形或近圆形，先端全缘，下面2/3部分具稀大齿牙，两面被白色柔毛，下面并具腺体。总状花序顶生，密被短柔毛；花小，单性，同株；雄花位于花序的上端，具长卵状椭圆形或披针形的叶状苞2枚，苞片内通常具1～3朵花；萼片5，稀4枚；花瓣5，稀4枚，呈鳞片状；黄色腺体盆状，与花瓣互生；雄蕊10～15；花序下部的花略大，中间1朵为雌花，两侧为雄花；苞2枚，雌花具较长的花梗；萼片5～6；花瓣6；子房上位，花柱3枚，均2裂。蒴果三棱状，顶端开裂；每室有种子1枚，三角状倒卵形，绿色。花期4～5月。果期5～6月。"}]},{"ID":"20240902175339-y8cexbb","Type":"NodeParagraph","Properties":{"id":"20240902175339-y8cexbb","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"生于草地及山坡。分布吉林、辽宁、河北、河南、山东、山西、安徽、江苏、陕西、甘肃等地。"}]},{"ID":"20240902175339-qscyvpp","Type":"NodeParagraph","Properties":{"id":"20240902175339-qscyvpp","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②凤仙，详\"凤仙\"条。"}]},{"ID":"20240902175339-80zkhdn","Type":"NodeParagraph","Properties":{"id":"20240902175339-80zkhdn","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175339-jo5cyxf","Type":"NodeParagraph","Properties":{"id":"20240902175339-jo5cyxf","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①珍珠透骨草"}]},{"ID":"20240902175339-fd2nreg","Type":"NodeParagraph","Properties":{"id":"20240902175339-fd2nreg","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"为植物地构叶的带有根茎的干燥全草。根茎圆柱状，长约10厘米；表面灰黄色，断面黄白色，木质状。茎圆柱形或微有棱，长10～20厘米，下端直径1～2毫米；表面淡绿色至灰绿色，被有灰白色柔毛；质坚硬，易折断，断面黄白色。叶多卷曲皱缩，灰绿色，被灰白色柔毛；质脆，易脱落。有时花序上留有圆形小花和果实。气微，味淡。以色绿、枝嫩、带有珍珠状果实者为佳。"}]},{"ID":"20240902175339-g1jhpfv","Type":"NodeParagraph","Properties":{"id":"20240902175339-g1jhpfv","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"主产山东、河南、江苏。此外，甘肃、山西、陕西亦产。"}]},{"ID":"20240902175339-w0dr9ih","Type":"NodeParagraph","Properties":{"id":"20240902175339-w0dr9ih","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②风仙透骨草"}]},{"ID":"20240902175339-11j8khy","Type":"NodeParagraph","Properties":{"id":"20240902175339-11j8khy","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"为植物风仙的干燥茎，呈长圆柱状，长30～60厘米，下端直径1～2厘米，多皱缩，具纵棱，表面黄棕色至淡棕色，节部膨大，有叶痕及芽痕，或少有分枝。质轻脆，易折断，断面中空，或有白色膜质状髓。气微弱，味微酸。"}]},{"ID":"20240902175339-l5vm1bh","Type":"NodeParagraph","Properties":{"id":"20240902175339-l5vm1bh","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"产安徽、江苏、浙江、江西、河北、新疆等地。"}]},{"ID":"20240902175339-kx75m3n","Type":"NodeParagraph","Properties":{"id":"20240902175339-kx75m3n","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"透骨草的药材品种比较复杂，除上述使用较广的两种外，尚有下列几种："}]},{"ID":"20240902175339-vbgbg0m","Type":"NodeParagraph","Properties":{"id":"20240902175339-vbgbg0m","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①羊角透骨草"}]},{"ID":"20240902175339-z0y8j2c","Type":"NodeParagraph","Properties":{"id":"20240902175339-z0y8j2c","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"为紫葳科植物角蒿的全草。产辽宁、吉林、黑龙江、山东等地。参见\"角蒿\"条。"}]},{"ID":"20240902175339-ydh8yu8","Type":"NodeParagraph","Properties":{"id":"20240902175339-ydh8yu8","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②铁线透骨草（《医学指南》）"}]},{"ID":"20240902175339-064bq28","Type":"NodeParagraph","Properties":{"id":"20240902175339-064bq28","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"为毛茛种植物黄花铁线莲的干燥全草，产河北、北京。参见\"黄花铁线莲\"条。铁线透骨草商品中尚有用细叶铁线莲的全草者。"}]},{"ID":"20240902175339-19t2wsz","Type":"NodeParagraph","Properties":{"id":"20240902175339-19t2wsz","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"③东北地区尚用豆科植物山野豌豆、广布野豌豆，假香野豌豆的全草作透骨草。参见\"山野豌豆\"条。"}]},{"ID":"20240902175339-qxx4pg3","Type":"NodeParagraph","Properties":{"id":"20240902175339-qxx4pg3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"④云南、贵州地区则用杜鹃花科植物云南白珠树的枝叶作透骨草。参见\"透骨香\"条。"}]},{"ID":"20240902175339-j3l1gs3","Type":"NodeParagraph","Properties":{"id":"20240902175339-j3l1gs3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"透骨草始见于《救荒本草》，据所述图形，为唇形科植物益母草，并非本品。《纲目》有名未用中载有透骨草，但形态不详。《本草原始》的透骨草系指大戟科的地构叶。《纲目拾遗》引《灵秘丹药笺》云：\"风仙花一名透骨草。\"即凤仙花科的凤仙；所引《医学指南》的铁线透骨草，则为毛茛科铁线莲属的透骨草，可见古代药用的透骨草已非一种。"}]},{"ID":"20240902175339-hg0spov","Type":"NodeParagraph","Properties":{"id":"20240902175339-hg0spov","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【化学成份】凤仙的发芽嫩枝含吲垛-3-乙腈。茎含山柰酚-3-葡萄糖甙、槲皮素-3-葡萄糖甙、缔纹天竺素-3-葡萄糖甙、矢车菊素-5-葡萄糖甙。叶含1，2，4-三羟基萘-4-葡萄糖甙与山柰酚及山柰酚-3-阿拉伯糖甙。"}]},{"ID":"20240902175339-gytt476","Type":"NodeParagraph","Properties":{"id":"20240902175339-gytt476","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，切段。"}]},{"ID":"20240902175339-8qeo20k","Type":"NodeParagraph","Properties":{"id":"20240902175339-8qeo20k","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902175339-ivk37s9","Type":"NodeParagraph","Properties":{"id":"20240902175339-ivk37s9","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①《本草原始》：\"味甘，无毒。\""}]},{"ID":"20240902175339-8m23q26","Type":"NodeParagraph","Properties":{"id":"20240902175339-8m23q26","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②《中药志》：\"辛，温。\""}]},{"ID":"20240902175339-2dgdbi3","Type":"NodeParagraph","Properties":{"id":"20240902175339-2dgdbi3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902175339-4ctsnl7","Type":"NodeParagraph","Properties":{"id":"20240902175339-4ctsnl7","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"祛风，除湿，舒筋，活血，止痛。治风湿痹痛，筋骨挛缩，寒湿脚气，疮癣肿毒。"}]},{"ID":"20240902175339-ylrv4z7","Type":"NodeParagraph","Properties":{"id":"20240902175339-ylrv4z7","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"治筋骨一切风湿疼痛挛缩，寒湿脚气。\""}]},{"ID":"20240902175339-fnmhjzl","Type":"NodeParagraph","Properties":{"id":"20240902175339-fnmhjzl","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②《灵秘丹药笺》：\"疗热毒。\""}]},{"ID":"20240902175339-nribzpn","Type":"NodeParagraph","Properties":{"id":"20240902175339-nribzpn","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"③《山东中草药手册》：\"祛风湿，活血，止痛。\""}]},{"ID":"20240902175339-wzdns70","Type":"NodeParagraph","Properties":{"id":"20240902175339-wzdns70","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3～5钱；或入丸、散。外用：煎水熏洗。"}]},{"ID":"20240902175339-gace550","Type":"NodeParagraph","Properties":{"id":"20240902175339-gace550","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【注意】《中药志》：\"孕妇忌服。\""}]},{"ID":"20240902175339-6kv7xox","Type":"NodeParagraph","Properties":{"id":"20240902175339-6kv7xox","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902175339-1b4v6em","Type":"NodeParagraph","Properties":{"id":"20240902175339-1b4v6em","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"①治风气疼痛，不拘远年近日：透骨草二两，穿山甲二两，防风二两，当归三两，白蒺藜四两，白芍三两，稀莶四两（去茎用叶，九蒸九晒），海风藤二两，生地四两，广皮一两，甘草一两。以上为末，用猪板油一斤，炼蜜为丸梧桐子大。早晚各服五钱，酒下。（《周益生家宝方》）"}]},{"ID":"20240902175339-lcrfp1q","Type":"NodeParagraph","Properties":{"id":"20240902175339-lcrfp1q","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"②治风湿性关节炎，筋骨拘挛：透骨草三钱，制川乌、制草乌各一钱，伸筋草二钱。水煎服。（《陕甘宁青中草药选》）"}]},{"ID":"20240902175339-o6y5ew2","Type":"NodeParagraph","Properties":{"id":"20240902175339-o6y5ew2","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"③治肿毒初起：透骨草、漏芦、防风、地榆等分。煎汤绵蘸，乘热不住荡之。（《杨诚经验方》）"}]},{"ID":"20240902175339-btzrs57","Type":"NodeParagraph","Properties":{"id":"20240902175339-btzrs57","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"④治阴囊湿疹，疮疡肿毒：透骨草、蛇床子、白藓皮、艾叶。煎水外洗。（《陕甘宁青中草药选》）"}]},{"ID":"20240902175339-8a3rhjw","Type":"NodeParagraph","Properties":{"id":"20240902175339-8a3rhjw","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902175339-gm2o5zt","Type":"NodeParagraph","Properties":{"id":"20240902175339-gm2o5zt","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"透骨草《中华本草》"}]},{"ID":"20240902175339-s4xdrjb","Type":"NodeParagraph","Properties":{"id":"20240902175339-s4xdrjb","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【出处】出自《灵秘丹药笺》。透骨草始见于《救荒本草》，据所述图形，为唇形科植物益母草LeonurusheterophyllusSweet，并非本品。《纲目》有名未用中载有透骨草，但形态不详。《本草原始》的透骨草系指大戟科的地构叶Speranskiatuberculata(Bge．)Baill.。《纲目拾遗》引《灵秘丹药笺》云：凤仙花一名透骨草。即凤仙花科的凤仙Impatiensbalsamina"}]},{"ID":"20240902175339-wm09i10","Type":"NodeParagraph","Properties":{"id":"20240902175339-wm09i10","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【拼音名】TòuGǔCǎo"}]},{"ID":"20240902175339-jvooxeh","Type":"NodeParagraph","Properties":{"id":"20240902175339-jvooxeh","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【英文名】HerbofTuberculateSperanskia,TrberculateSperanskiaHerb,GardenBalsamStem"}]},{"ID":"20240902175339-zvp0vw3","Type":"NodeParagraph","Properties":{"id":"20240902175339-zvp0vw3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【别名】珍珠透骨草、竹格叉、吉盖草、枸皮草。"}]},{"ID":"20240902175339-ba41nae","Type":"NodeParagraph","Properties":{"id":"20240902175339-ba41nae","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902175339-qeekzff","Type":"NodeParagraph","Properties":{"id":"20240902175339-qeekzff","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"药材基源：为大戟科植物地构叶的全草。"}]},{"ID":"20240902175339-yu6n6kv","Type":"NodeParagraph","Properties":{"id":"20240902175339-yu6n6kv","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Speranskiatuberculata（Bunge）Baill[CrotontuberculataBunge]"}]},{"ID":"20240902175339-fju0tss","Type":"NodeParagraph","Properties":{"id":"20240902175339-fju0tss","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月间开花结实时采收，除去杂质，鲜用或晒干备用。"}]},{"ID":"20240902175339-zjos32n","Type":"NodeParagraph","Properties":{"id":"20240902175339-zjos32n","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【原形态】地构叶多年生草本，高15-50cm。根茎横走，淡黄褐色；茎直立，丛生，被灰白色卷曲柔毛。叶互生或于基部对生；无柄或具短柄；叶片厚纸质，披针形至椭圆状披针形，长1.5-7cm，宽0.5-2cm，先端钝尖或渐尖，基部宽楔形或近圆形，上部全缘，下部具齿牙，两面被白色柔毛，以沿脉处为密。总状花序顶生；花单性同序；雄花位于花序上部，具长卵状椭圆形或披针形的叶状苞片2枚，苞片内有花l-3朵；萼片5，稀4，花瓣5，稀4，呈鳞片状，黄色腺体盆状，与花瓣互生，雄蕊10-15，花盘锦体5，黄色；花序下部的花略大，中间1朵为雌花，两侧为雄花；苞片2；雌花具较长的花梗，萼片5-6，花瓣6，子房上位，花柱3枚，均2裂。蒴果三角状扁圆球形，被柔毛和疣状突起，先端开裂；每室有种子1颗，三角状倒卵形，绿色。花期4-5月，果期5-6月。"}]},{"ID":"20240902175339-stluhkw","Type":"NodeParagraph","Properties":{"id":"20240902175339-stluhkw","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902175339-j4wemec","Type":"NodeParagraph","Properties":{"id":"20240902175339-j4wemec","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡及草地。"}]},{"ID":"20240902175339-k2amvky","Type":"NodeParagraph","Properties":{"id":"20240902175339-k2amvky","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北及陕西、宁夏、甘肃、山东、江苏、安徽、河南、湖南、四川等地。"}]},{"ID":"20240902175339-g1hnt5i","Type":"NodeParagraph","Properties":{"id":"20240902175339-g1hnt5i","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902175339-ags9g3l","Type":"NodeParagraph","Properties":{"id":"20240902175339-ags9g3l","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"性状鉴别茎多分枝，呈圆柱形或微有棱，通常长10-30cm，直径1-4mm，茎基部有时连有部分根茎；茎表面浅绿色或灰绿色，近基部淡紫色，被灰白色柔毛，具互生叶或叶痕，质脆，易折断，断面黄白色。根茎长短不一，表面土棕色或黄棕色，略粗糙；质稍坚硬，断面黄白色。叶多卷曲而皱缩或破碎，呈灰绿色，两面均被白色细柔毛，下表面近叶脉处较显着。枝稍有时可见总状花序和果序；花型小；蒴果三角状扁圆形。气微，味淡而后微苦。以色绿、枝嫩，带“珍珠”果者为佳。"}]},{"ID":"20240902175339-iomf827","Type":"NodeParagraph","Properties":{"id":"20240902175339-iomf827","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"显微鉴别茎横切面：表皮细胞类方形或切向略延长，外被角质层，有非腺毛及少数气孔。绿皮层为5-6层细胞，部分细胞内含草酸钙簇晶，直径14-24μm；外侧2-3层为厚角组织。中柱鞘为2-4层纤维排列成断续的环带，纤维多角形而扁，壁厚，弱木化，层纹明显。韧皮部较窄。本质部宽阔，导管单独散在或2-5个成群；木纤维多数，常径向整齐排列；木射线细胞1列。髓约占茎直径的2/5，少数细胞内含草酸钙簇晶。"}]},{"ID":"20240902175339-obf1xw7","Type":"NodeParagraph","Properties":{"id":"20240902175339-obf1xw7","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"叶表面观：上表皮细胞垂周壁近平直，气孔稀少，主为平轴式，次为不定式和不等式，副卫细胞2-4个，下表皮细胞垂周壁稍弯曲，气孔多数，余同上表皮。非腺毛上下表皮均有，通常为单细胞，偶有双细胞者，长230-460μm，直径约18μm，壁厚，表面有显着的疣状凸起。叶肉组织的少数细胞含草酸钙簇晶，直径16-25μm。"}]},{"ID":"20240902175339-dci55fi","Type":"NodeParagraph","Properties":{"id":"20240902175339-dci55fi","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902175339-g8vdkfb","Type":"NodeParagraph","Properties":{"id":"20240902175339-g8vdkfb","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"凤仙的发芽嫩枝含吲哚-3-乙腈(Indole-3-ace-tonitrile)。茎含山柰酚-3-葡萄糖甙(Kaempferol-3-glucoside)、槲皮素-3-葡萄糖甙(Quercetin-3-glucoside)、缔纹天竺素-3-葡萄糖甙(Pelargonidin-3-glucoside)、矢车菊素-3-葡萄糖甙(Cyanidin-3-glucoside)。叶含1，2，4-三羟基萘-4-葡萄糖甙(1，2，4-TrihydroxynaphCha-lene-4-glucdoside)与山柰酚及山亲酚-3-阿拉伯糖甙(KaemPferol-3-arabinoside)。凤仙全草含对羟基苯甲酸、龙胆酸(gentisicacid)、阿魏酸(ferukicacid)、对香豆酸(p-coumaricacid)、芥子酸(sinapicacid)、咖啡酸(caffeicacid),另含东莨菪素(scopoletin)。叶含肉桂酸酯类、山柰素-3-阿拉伯糖甙(kaempferol-3-arabinoside)及山柰素。茎含山柰素-3-葡萄糖甙、槲皮素、天竺葵素(pelargonidin)、矢车菊素(cyanidin)、翠雀花素(delphinidin)。"}]},{"ID":"20240902175339-esrejmz","Type":"NodeParagraph","Properties":{"id":"20240902175339-esrejmz","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"此外，地上部分含指甲花醌(lawsone)及指甲花醌甲醚。"}]},{"ID":"20240902175339-rf0i2lf","Type":"NodeParagraph","Properties":{"id":"20240902175339-rf0i2lf","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别透骨草粉末0.5g，加甲醇5ml，浸演2h，并时时振摇，滤过，取滤液2ml于试管中，加2％铁氰化钾-2％三氯化铁试剂（临用时，将两种溶液等量混合）2-3滴，均显蓝色。（检查酚类）"}]},{"ID":"20240902175339-svflsq4","Type":"NodeParagraph","Properties":{"id":"20240902175339-svflsq4","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，切段。"}]},{"ID":"20240902175339-cv1eoiw","Type":"NodeParagraph","Properties":{"id":"20240902175339-cv1eoiw","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【性味】辛；性温"}]},{"ID":"20240902175339-icfmae3","Type":"NodeParagraph","Properties":{"id":"20240902175339-icfmae3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【归经】肺；肝经"}]},{"ID":"20240902175339-pj2s1p9","Type":"NodeParagraph","Properties":{"id":"20240902175339-pj2s1p9","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风除湿；舒筋活血；散瘀消肿；解毒目痛。主风湿痹痛；筋骨挛缩；寒湿脚气；腰部扭伤；瘫痪；闭经；阴囊湿疹；疮疖肿毒"}]},{"ID":"20240902175339-0mmmcsr","Type":"NodeParagraph","Properties":{"id":"20240902175339-0mmmcsr","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g。外用：适量，煎水熏洗；或捣敷。"}]},{"ID":"20240902175339-0ctk8i3","Type":"NodeParagraph","Properties":{"id":"20240902175339-0ctk8i3","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【附方】①治风气疼痛，不拘远年近日：透骨草二两，穿山甲二两，防风二两，当归三两，白蒺藜四两，白芍三两，豨莶四两(去茎用叶，九蒸九晒)，海风藤二两，生地四两，广皮一两，甘草一两。以上为末，用猪板油一斤，炼蜜为丸梧桐子大。早晚各服五钱，酒下。(《周益生家宝方》)②治风湿性关节炎，筋骨拘挛：透骨草三钱，制川乌、制草乌各一钱，伸筋草二钱。水煎服。(《陕甘宁青中草药选》)③治肿毒初起：透骨草、漏芦、防风、地榆等分。煎汤绵蘸，乘热不住荡之。(《杨诚经验方》)④治阴囊湿疹，疮疡肿毒：透骨草、蛇床子、白藓皮、艾叶。煎水外洗。(《陕甘宁青中草药选》)"}]},{"ID":"20240902175339-77fvtg4","Type":"NodeParagraph","Properties":{"id":"20240902175339-77fvtg4","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902175339-5lm6dso","Type":"NodeParagraph","Properties":{"id":"20240902175339-5lm6dso","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：治筋骨一切风湿疼痛挛缩，寒湿脚气。"}]},{"ID":"20240902175339-cnqd55d","Type":"NodeParagraph","Properties":{"id":"20240902175339-cnqd55d","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"2.《灵秘丹药笺》：疗热毒。"}]},{"ID":"20240902175339-vz3teoh","Type":"NodeParagraph","Properties":{"id":"20240902175339-vz3teoh","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"3.《山东中草药手册》：祛风湿，活血，止痛。"}]},{"ID":"20240902175339-hsvtdi1","Type":"NodeParagraph","Properties":{"id":"20240902175339-hsvtdi1","updated":"20240902175354"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902175341-an3bi97","Type":"NodeThematicBreak","Properties":{"id":"20240902175341-an3bi97","updated":"20240902175354"}},{"ID":"20240902175341-suno260","Type":"NodeParagraph","Properties":{"id":"20240902175341-suno260","updated":"20240902175354"}}]}