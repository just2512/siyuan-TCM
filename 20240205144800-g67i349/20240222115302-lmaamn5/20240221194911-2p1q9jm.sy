{"ID":"20240221194911-2p1q9jm","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240221194911-2p1q9jm","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240221194911-2p1q9jm\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240221194918-do1zpki\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240221194918-do1zpki\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240221194918-do1zpki\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"石榴皮","type":"doc","updated":"20240902134118"},"Children":[{"ID":"20240718133252-fh6atvl","Type":"NodeParagraph","Properties":{"id":"20240718133252-fh6atvl","updated":"20240718133252"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 315px;","style":"width: 305px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 1-20240718133252-4yt7eg8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 305px;\" parent-style=\"width: 315px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718133541-2v8lmi2","Type":"NodeParagraph","Properties":{"id":"20240718133541-2v8lmi2","updated":"20240718133541"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 384px;","style":"width: 374px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 2-20240718133541-4ng9bka.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 374px;\" parent-style=\"width: 384px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240221194918-do1zpki","Type":"NodeParagraph","Properties":{"id":"20240