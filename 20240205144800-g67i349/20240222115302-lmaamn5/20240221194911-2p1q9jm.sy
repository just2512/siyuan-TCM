Data":"​"}]},{"ID":"20240718134318-7xziu29","Type":"NodeParagraph","Properties":{"id":"20240718134318-7xziu29","updated":"20240718135511"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 698px;","style":"width: 688px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 9-20240718134657-37acv67.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 688px;\" parent-style=\"width: 698px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 397px;","style":"width: 387px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 7-20240718134422-by3xkoi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 387px;\" parent-style=\"width: 397px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718135757-2vphgv9","Type":"NodeParagraph","Properties":{"id":"20240718135757-2vphgv9","updated":"20240718135830"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 718px;","style":"width: 708px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 16-20240718135757-s2jz9zw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 708px;\" parent-style=\"width: 718px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 475px;","style":"width: 465px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 17-20240718135830-mdvfazs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 465px;\" parent-style=\"width: 475px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718133751-s4jm1w0","Type":"NodeParagraph","Properties":{"id":"20240718133751-s4jm1w0","updated":"20240718135532"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 8-20240718134550-q9299i0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 810px;","style":"width: 800px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石榴 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石榴 4-20240718133955-o7b8fio.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 800px;\" parent-style=\"width: 810px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718133829-0jnnewb","Type":"NodeThematicBreak","Properties":{"id":"20240718133829-0jnnewb"}},{"ID":"20240902134110-f7ht0m6","Type":"NodeParagraph","Properties":{"id":"20240902134110-f7ht0m6","updated":"20240902134118"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：石榴皮"}]},{"ID":"20240902134110-p3qtrkv","Type":"NodeParagraph","Properties":{"id":"20240902134110-p3qtrkv","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴皮《中国药典》"}]},{"ID":"20240902134110-5ncd35e","Type":"NodeParagraph","Properties":{"id":"20240902134110-5ncd35e","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíLiuPí"}]},{"ID":"20240902134110-3ijd8db","Type":"NodeParagraph","Properties":{"id":"20240902134110-3ijd8db","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【英文名】PERICARPIUMGRANATI"}]},{"ID":"20240902134110-ki7bou2","Type":"NodeParagraph","Properties":{"id":"20240902134110-ki7bou2","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【来源】本品为石榴科植物石榴PunicagranatumL.的干燥果皮。秋季果实成熟后收集果皮，晒干。"}]},{"ID":"20240902134110-w7zl6ak","Type":"NodeParagraph","Properties":{"id":"20240902134110-w7zl6ak","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则的片状或瓢状，大小不一，厚1.5～3mm。外表面红棕色、棕黄色或暗棕色，略有光泽，粗糙，有多数疣状突起。有的有突起的筒状宿萼及粗短果梗或果梗痕。内表面黄色或红棕色，有隆起呈网状的果蒂残痕。质硬而脆，断面黄色，略显颗粒状。无臭，味苦涩。"}]},{"ID":"20240902134110-nxeya9v","Type":"NodeParagraph","Properties":{"id":"20240902134110-nxeya9v","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902134110-r697hbx","Type":"NodeParagraph","Properties":{"id":"20240902134110-r697hbx","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"（1）本品横切面：外果皮为一列表皮细胞，排列较紧密，外被角质层。中果皮较厚，薄壁细胞内含淀粉粒及草酸钙簇晶或方晶；石细胞单个散在，类圆形、长方形或不规则形，少数呈分枝状，壁较厚；维管束散在。内果皮薄壁细胞较少，亦含淀粉粒及草酸钙晶体，石细胞较小。"}]},{"ID":"20240902134110-190yy36","Type":"NodeParagraph","Properties":{"id":"20240902134110-190yy36","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"粉末红棕色。石细胞类圆形、长方形或不规则形，少数分枝状，直径27～102μm，壁较厚，胞腔大，有的含棕色物。表皮细胞类方形或类长方形，壁略厚。草酸钙簇晶直径10～25μm,稀有方晶。螺纹及网纹导管直径12～18μm。淀粉粒类圆形，直径2～10μm。"}]},{"ID":"20240902134110-iddwqix","Type":"NodeParagraph","Properties":{"id":"20240902134110-iddwqix","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加水10ml，置60℃水浴中加热10分钟，趁热滤过。取滤液1ml,加1％三氯化铁乙醇溶液1滴，即显墨绿色。"}]},{"ID":"20240902134110-3loob52","Type":"NodeParagraph","Properties":{"id":"20240902134110-3loob52","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【含量测定】"}]},{"ID":"20240902134110-epp7p59","Type":"NodeParagraph","Properties":{"id":"20240902134110-epp7p59","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"取本品粉末（过三号筛）约10g,精密称定，照鞣质含量测定法（附录ⅩB）测定，即得。"}]},{"ID":"20240902134110-on0l862","Type":"NodeParagraph","Properties":{"id":"20240902134110-on0l862","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"本品含鞣质不得少于10.0％。"}]},{"ID":"20240902134110-m0z91br","Type":"NodeParagraph","Properties":{"id":"20240902134110-m0z91br","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902134110-hng3uhp","Type":"NodeParagraph","Properties":{"id":"20240902134110-hng3uhp","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴皮：除去杂质，洗净，切块，干燥。"}]},{"ID":"20240902134110-nyqbzqi","Type":"NodeParagraph","Properties":{"id":"20240902134110-nyqbzqi","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴皮炭：取石榴皮块，照炒炭法（附录ⅡD）炒至表面黑黄色、内部棕褐色。"}]},{"ID":"20240902134110-ahzfdxy","Type":"NodeParagraph","Properties":{"id":"20240902134110-ahzfdxy","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性味】酸、涩，温。"}]},{"ID":"20240902134110-91nqn1h","Type":"NodeParagraph","Properties":{"id":"20240902134110-91nqn1h","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【归经】归大肠经。"}]},{"ID":"20240902134110-pxhugjh","Type":"NodeParagraph","Properties":{"id":"20240902134110-pxhugjh","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【功能主治】涩肠止泻，止血，驱虫。用于久泻，久痢，便血，脱肛，崩漏，白带，虫积腹痛。"}]},{"ID":"20240902134110-kpc5zp5","Type":"NodeParagraph","Properties":{"id":"20240902134110-kpc5zp5","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～9g。"}]},{"ID":"20240902134110-bhy9wyn","Type":"NodeParagraph","Properties":{"id":"20240902134110-bhy9wyn","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902134110-m4xrvws","Type":"NodeParagraph","Properties":{"id":"20240902134110-m4xrvws","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【备注】（1）石榴皮碱中毒时，能引起发热、头晕、视物模糊、蚁走感、恶心、呕吐，甚至可招致弱视、腓肠肌痉挛，全身搐搦而虚脱。解决方法：给服通用解毒散或碘酊1毫升，加水至100毫升，洗胃，给与泻盐。抽搐可用巴比妥类，头痛可用阿司匹林，对症治疗。"}]},{"ID":"20240902134110-eamoih3","Type":"NodeParagraph","Properties":{"id":"20240902134110-eamoih3","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902134110-eb6rlnh","Type":"NodeParagraph","Properties":{"id":"20240902134110-eb6rlnh","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴皮《*辞典》"}]},{"ID":"20240902134110-5u7xp9n","Type":"NodeParagraph","Properties":{"id":"20240902134110-5u7xp9n","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【出处】《雷公炮炙论》"}]},{"ID":"20240902134110-n3g5hp5","Type":"NodeParagraph","Properties":{"id":"20240902134110-n3g5hp5","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíLiuPí"}]},{"ID":"20240902134110-u4zyjvt","Type":"NodeParagraph","Properties":{"id":"20240902134110-u4zyjvt","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【别名】石榴壳（《雷公炮炙论》），酸石榴皮（《肘后方》），安石榴酸实壳（《别录》），酸榴皮（《纲目》），西榴皮（《闽东本草》）。"}]},{"ID":"20240902134110-4vujmi0","Type":"NodeParagraph","Properties":{"id":"20240902134110-4vujmi0","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【来源】为石榴科植物石榴的果皮。秋季果实成熟，顶端开裂时采摘，除去种子及隔瓤，切瓣晒干，或微火烘干。"}]},{"ID":"20240902134110-c5uz8va","Type":"NodeParagraph","Properties":{"id":"20240902134110-c5uz8va","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902134110-g0ca6dr","Type":"NodeParagraph","Properties":{"id":"20240902134110-g0ca6dr","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴（《雷公炮炙论》）又名：楮榴（《广雅》），安石榴（张华《博物志》），丹若（《酉阳杂俎》），金罂（《纲目》），金庞（《群芳谱》），榭榴、海石榴、安息榴、西安榴、钟石榴。"}]},{"ID":"20240902134110-0mskzbd","Type":"NodeParagraph","Properties":{"id":"20240902134110-0mskzbd","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"落叶灌木或乔木，高2～5米。树皮青灰色；幼枝近圆形或微呈四棱形，枝端通常呈刺状，无毛，叶对生或簇生；叶片倒卵形至长椭圆形，长2.5～6厘米，宽1～1.8厘米，先端尖或微凹；基部渐狭，全缘，上面有光泽，无毛，下面有隆起的主脉，具短柄。花1至数朵，生小枝顶端或腋生，花梗长2～3毫米；花的直径约3厘米；萼筒钟状，肉质而厚，红色，裂片6，三角状卵形；花瓣6，红色，与萼片互生，倒卵形，有皱纹；雄蕊多数，着生于萼管中部，花药球形，花丝细短；雌蕊1，子房下位或半下位，上部6室，具侧膜胎座，下部3室，具中轴胎座，花柱圆形，柱头头状。浆果近球形，果皮肥厚革质，熟时黄色，或带红色，内具薄隔膜，顶端有宿存花萼。种子多数，倒卵形，带棱角。花期5～6月。果期7～8月。"}]},{"ID":"20240902134110-clhy2gs","Type":"NodeParagraph","Properties":{"id":"20240902134110-clhy2gs","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"本植物的根皮（石榴根）、叶（石榴叶）、花（石榴花）、果实（酸石榴、甜石榴）等亦供药用，各详专条。"}]},{"ID":"20240902134110-xz24suq","Type":"NodeParagraph","Properties":{"id":"20240902134110-xz24suq","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡向阳处或栽培于庭园。我国大部分地区有分布。"}]},{"ID":"20240902134110-kza3eir","Type":"NodeParagraph","Properties":{"id":"20240902134110-kza3eir","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的果皮呈不规则形或半圆形的碎片状，厚2～3毫米。外表面暗红色或棕红色，粗糙，具白色小凸点；顶端具残存的宿萼；基部有果柄。内面鲜黄色或棕黄色，并有隆起呈网状的果蒂残痕。质脆而坚，易折断。气微弱，味涩。以皮厚实、色红褐者为佳。"}]},{"ID":"20240902134110-hyfxn6n","Type":"NodeParagraph","Properties":{"id":"20240902134110-hyfxn6n","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【化学成份】含鞣质10.4～21.3％、蜡0.8％、树脂4.5％、甘露醇1.8％、糖2.7％、树胶3.2％、菊粉1.O％、粘质0.6％、没食子酸4.0％、苹果酸、果胶和草酸钙、异槲皮甙。"}]},{"ID":"20240902134110-7qji9nk","Type":"NodeParagraph","Properties":{"id":"20240902134110-7qji9nk","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902134110-ahb8zl1","Type":"NodeParagraph","Properties":{"id":"20240902134110-ahb8zl1","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"拣去杂质，去净残留的内瓤及子，洗净，切块，晒干。"}]},{"ID":"20240902134110-aquloen","Type":"NodeParagraph","Properties":{"id":"20240902134110-aquloen","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使石榴皮、叶、根，勿令犯铁。若使石榴壳，不计干湿，先用浆水浸一宿，至明漉出，其水如墨汁，……方可用。\""}]},{"ID":"20240902134110-tsznzhp","Type":"NodeParagraph","Properties":{"id":"20240902134110-tsznzhp","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902134110-1fuf3ra","Type":"NodeParagraph","Properties":{"id":"20240902134110-1fuf3ra","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"酸涩，温，有毒。"}]},{"ID":"20240902134110-kwaifva","Type":"NodeParagraph","Properties":{"id":"20240902134110-kwaifva","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味酸，无毒。\""}]},{"ID":"20240902134110-h9x753s","Type":"NodeParagraph","Properties":{"id":"20240902134110-h9x753s","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性寒，味酸涩。\""}]},{"ID":"20240902134110-jw2uglc","Type":"NodeParagraph","Properties":{"id":"20240902134110-jw2uglc","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"酸涩，沮，无毒。\""}]},{"ID":"20240902134110-ouuzo4a","Type":"NodeParagraph","Properties":{"id":"20240902134110-ouuzo4a","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"④《广西中药》：\"味苦涩，性温，有毒。\""}]},{"ID":"20240902134110-kb6hhjx","Type":"NodeParagraph","Properties":{"id":"20240902134110-kb6hhjx","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902134110-3mhd8ij","Type":"NodeParagraph","Properties":{"id":"20240902134110-3mhd8ij","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"入大肠、肾经。"}]},{"ID":"20240902134110-1b3bzgr","Type":"NodeParagraph","Properties":{"id":"20240902134110-1b3bzgr","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入大肠、肾二经。\""}]},{"ID":"20240902134110-e3rx39w","Type":"NodeParagraph","Properties":{"id":"20240902134110-e3rx39w","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入手太阴、足少阴经。\""}]},{"ID":"20240902134110-v5rkh7f","Type":"NodeParagraph","Properties":{"id":"20240902134110-v5rkh7f","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902134110-qkf42db","Type":"NodeParagraph","Properties":{"id":"20240902134110-qkf42db","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"涩肠，止血，驱虫。治久泻，久痢，便血，脱肛，滑精，崩漏，带下，虫积腹痛，疥癣。"}]},{"ID":"20240902134110-lnptri3","Type":"NodeParagraph","Properties":{"id":"20240902134110-lnptri3","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"疗下痢，止漏精。\""}]},{"ID":"20240902134110-lft0dk6","Type":"NodeParagraph","Properties":{"id":"20240902134110-lft0dk6","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治筋骨风，腰脚不遂，步行挛急疼痛。主涩肠，止赤白下痢。取汁止目泪下，治漏精。\""}]},{"ID":"20240902134110-v8hyz9d","Type":"NodeParagraph","Properties":{"id":"20240902134110-v8hyz9d","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"③《本草拾遗》：\"主蛔虫。煎服。\""}]},{"ID":"20240902134110-glaggqq","Type":"NodeParagraph","Properties":{"id":"20240902134110-glaggqq","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"治日久水泻，同炒砂糖煨服，又治痢脓血，大肠下血。\"\"同马兜铃煎治小儿疳虫。\""}]},{"ID":"20240902134110-ehfqain","Type":"NodeParagraph","Properties":{"id":"20240902134110-ehfqain","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑤《本草蒙筌》：\"理虫牙。\""}]},{"ID":"20240902134110-al7ic4r","Type":"NodeParagraph","Properties":{"id":"20240902134110-al7ic4r","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"止泻痢，下血，脱肛，崩中带下。\""}]},{"ID":"20240902134110-8lxtu4h","Type":"NodeParagraph","Properties":{"id":"20240902134110-8lxtu4h","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑦《生草药性备要》：\"治瘤子疮，洗疝痛。\""}]},{"ID":"20240902134110-2y9zegv","Type":"NodeParagraph","Properties":{"id":"20240902134110-2y9zegv","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑧《本草求原》：\"洗斑疥癞。\""}]},{"ID":"20240902134110-xvzfkvb","Type":"NodeParagraph","Properties":{"id":"20240902134110-xvzfkvb","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑨《科学的民间药草》：\"驱除钩、绦虫。\""}]},{"ID":"20240902134110-7zhiqrp","Type":"NodeParagraph","Properties":{"id":"20240902134110-7zhiqrp","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.8～1.5钱；或入散剂。外用：煎水熏洗或研末调涂。"}]},{"ID":"20240902134110-1nnwhrw","Type":"NodeParagraph","Properties":{"id":"20240902134110-1nnwhrw","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【注意】《本草从新》：\"能恋膈成痰，痢积未尽者，服之太早，反为害也。\""}]},{"ID":"20240902134110-4i36rbj","Type":"NodeParagraph","Properties":{"id":"20240902134110-4i36rbj","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902134110-4ccgggm","Type":"NodeParagraph","Properties":{"id":"20240902134110-4ccgggm","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"①治久痢不瘥：陈石榴焙干，为细末，米汤调下三、四钱。（《普济方》神授散）"}]},{"ID":"20240902134110-evfpvdz","Type":"NodeParagraph","Properties":{"id":"20240902134110-evfpvdz","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"②治妊身暴下不止，腹痛：安石榴皮二两，当归三两，阿胶二两（炙），熟艾如鸡子大二枚。上四物以水九升，煮取二升，分三服。（《产经方》石榴皮汤）"}]},{"ID":"20240902134110-54x6rwx","Type":"NodeParagraph","Properties":{"id":"20240902134110-54x6rwx","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"③治粪前有血，令人面黄：酢石榴皮，炙研末，每服二钱，用茄子枝煎汤服。（《千金方》）"}]},{"ID":"20240902134110-ob0vm33","Type":"NodeParagraph","Properties":{"id":"20240902134110-ob0vm33","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"④治脱肛：石榴皮、陈壁土，加白矾少许，浓煎熏洗，再加五倍子炒研敷托上之。（《医钞类编》）"}]},{"ID":"20240902134110-mm8dg83","Type":"NodeParagraph","Properties":{"id":"20240902134110-mm8dg83","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑤治诸虫心痛不可忍，多吐酸水：酸石榴皮一两（锉），桃符二两（锉），胡粉一两，酒二合，槟榔末二钱。上件药，以水二大盏，煎前二味至一盏，去滓，下胡粉、槟榔、酒，更煎一沸，稍热，分为三服。（《圣惠方》石榴皮散）"}]},{"ID":"20240902134110-lgwe4l2","Type":"NodeParagraph","Properties":{"id":"20240902134110-lgwe4l2","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑥驱绦虫、蛔虫：石榴皮、槟榔各等分，研细末，每次服二钱（小儿酌减），每日二次，连服二天。（《山东中草药手册》）"}]},{"ID":"20240902134110-5afbc3k","Type":"NodeParagraph","Properties":{"id":"20240902134110-5afbc3k","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑦治丁肿恶毒：以针刺四畔，榴皮着疮上，以面围四畔灸之，以痛为度，仍用榴末敷上，急裹，经宿，连根自出也。（《肘后方》）"}]},{"ID":"20240902134110-3q48tqm","Type":"NodeParagraph","Properties":{"id":"20240902134110-3q48tqm","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑧治牛皮癣：㈠石榴皮蘸极细的明矾粉搓患处，初搓时微痛。（《山东中草药手册，）㈡石榴皮（炒炭），研细末一份，麻油三份，调成糊状。用时将药油摇匀。以毛笔蘸药匀涂患处，每日二次。（《全展选编·皮肤科》）"}]},{"ID":"20240902134110-zowk3zs","Type":"NodeParagraph","Properties":{"id":"20240902134110-zowk3zs","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑨预防稻田皮炎：石榴皮二两，五倍子二两，地榆（炒黑）二两，明矾五两。取清水五斤，将前三味药放入水内煎沸后，再煎10分钟，然后加入明矾，用木棒不断搅拌，至明矾全部溶于水中，再煎至剩下药液3斤左右，去渣冷却备用。用时须在下水前将手、脚在药液中浸泡一下；也可用棉花球蘸涂。待药液干后入水工作。每次出水休息，必须如前浸涂后再下水工作。（《上海中医药杂志》（6）：170，1966）"}]},{"ID":"20240902134110-3bye4qu","Type":"NodeParagraph","Properties":{"id":"20240902134110-3bye4qu","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑩治脚肚生疮，初起如粟，搔之渐开，黄水浸淫，痒痛溃烂，遂致绕胫而成痼疾：酸榴皮煎汤冷定，日日扫之，取愈乃止。（《医学正宗》）"}]},{"ID":"20240902134110-z22iyhe","Type":"NodeParagraph","Properties":{"id":"20240902134110-z22iyhe","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"⑾治汤火烫伤：石榴果皮适量。研末，麻油调搽患处。（《贵州草药》）"}]},{"ID":"20240902134110-09tl32m","Type":"NodeParagraph","Properties":{"id":"20240902134110-09tl32m","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902134110-d7m3fav","Type":"NodeParagraph","Properties":{"id":"20240902134110-d7m3fav","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"①治疗细菌性痢疾"}]},{"ID":"20240902134110-9q6dbu9","Type":"NodeParagraph","Properties":{"id":"20240902134110-9q6dbu9","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"取石榴皮制成50％或60％煎剂，每次10～20毫升，日服3～4次，7～10天为一疗程；对慢性菌痢可以连服2周、停药1周再服2周为一疗程。治疗急性菌痢50例，经一疗程后近期治愈49例，进步1例。服药后平均退热时间1.3天，腹痛，里急后重消失时间为4.8天左右，大便恢复正常时间在4.6天上下，粪便镜检恢复正常为5.3天。治疗慢性菌痢4例，停药后2周经乙状结肠镜检查，病变均消失，粪便培养3次以上均为阴性。"}]},{"ID":"20240902134110-v50ivxb","Type":"NodeParagraph","Properties":{"id":"20240902134110-v50ivxb","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"②治疗阿米巴痢疾"}]},{"ID":"20240902134110-0nm7pdl","Type":"NodeParagraph","Properties":{"id":"20240902134110-0nm7pdl","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"60％石榴皮煎液每服20毫升，每日3次，饭后服，连服6日为一疗程。如无效可再服一个疗程。40例患者一疗程后随访半年，均无任何症状，其中36例连续粪检3次均为阴性。服药期间偶有恶心、耳鸣，能自行消失。"}]},{"ID":"20240902134110-qpuijaf","Type":"NodeParagraph","Properties":{"id":"20240902134110-qpuijaf","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"③治疗多种感染性炎症"}]},{"ID":"20240902134110-6mgrnl3","Type":"NodeParagraph","Properties":{"id":"20240902134110-6mgrnl3","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"取石榴皮制成100％煎液，烘干研粉装胶囊口服，每日3次，每次1～2粒。治疗肠炎、胆道感染、急慢性气管炎、肺部感染、慢性阑尾炎、淋巴结炎、多发性疖肿、外伤感染等共415例，痊愈305例，基本痊愈57例，好转36例，无效17例。"}]},{"ID":"20240902134110-gd7htk6","Type":"NodeParagraph","Properties":{"id":"20240902134110-gd7htk6","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"此外，用石榴皮炒焦研粉，撒布耳内，对化脓性中耳炎有一定疗效。"}]},{"ID":"20240902134110-nwx150w","Type":"NodeParagraph","Properties":{"id":"20240902134110-nwx150w","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902134110-tcurp5e","Type":"NodeParagraph","Properties":{"id":"20240902134110-tcurp5e","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"石榴皮《中华本草》"}]},{"ID":"20240902134110-2cg0l6f","Type":"NodeParagraph","Properties":{"id":"20240902134110-2cg0l6f","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240902134110-nfyoj21","Type":"NodeParagraph","Properties":{"id":"20240902134110-nfyoj21","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"出自1.《雷公炮炙论》。"}]},{"ID":"20240902134110-cf4xl76","Type":"NodeParagraph","Properties":{"id":"20240902134110-cf4xl76","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：安石榴，旧不注所出州土，或云本生西域。陆玑与弟云书云，张骞为汉使外国十八年，得涂林安石榴是也。今处处有之。木不甚高大，枝柯附干，自地便生作丛，种极易息，折其条盘土中便生。花有黄、赤二色，实亦有甘、酢二种，甘者可食，酢者入药。又有一种山石榴，形颇相类而绝小，不作房，生青、齐间，甚多，不入药，但蜜渍以当果，或寄京下，甚美。"}]},{"ID":"20240902134110-l52f9ft","Type":"NodeParagraph","Properties":{"id":"20240902134110-l52f9ft","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：安石"}]},{"ID":"20240902134110-2oicun8","Type":"NodeParagraph","Properties":{"id":"20240902134110-2oicun8","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíLiuPí"}]},{"ID":"20240902134110-nkcuo9p","Type":"NodeParagraph","Properties":{"id":"20240902134110-nkcuo9p","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【英文名】PomegranateRind"}]},{"ID":"20240902134110-oriovcb","Type":"NodeParagraph","Properties":{"id":"20240902134110-oriovcb","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【别名】石榴壳、安石榴酸实壳、酸石榴皮、酸榴皮、西榴皮"}]},{"ID":"20240902134110-vz8jfae","Type":"NodeParagraph","Properties":{"id":"20240902134110-vz8jfae","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902134110-tqcy7vb","Type":"NodeParagraph","Properties":{"id":"20240902134110-tqcy7vb","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"药材基源：为石榴科植物石榴的果皮。"}]},{"ID":"20240902134110-mxmg74t","Type":"NodeParagraph","Properties":{"id":"20240902134110-mxmg74t","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：PunicagranatumL."}]},{"ID":"20240902134110-i5f6w0z","Type":"NodeParagraph","Properties":{"id":"20240902134110-i5f6w0z","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季果实厚熟，顶端开裂时采摘，除去种子及隔瓤，切瓣晒干，或微火烘干。"}]},{"ID":"20240902134110-aivjfv6","Type":"NodeParagraph","Properties":{"id":"20240902134110-aivjfv6","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【原形态】落叶灌木或乔木，高通常3-5m，稀达10m。枝顶常成尖锐尖长刺，幼枝有棱角，无毛，老枝近圆柱形。叶对生或簇生；叶柄短；叶片长圆圆状披针形，纸质，长2-9cm，宽1-1.8cm，先端尖或微凹，基部渐狭，全缘，上面光亮；侧脉稍细密。花1-5朵生枝顶；花梗长2-3mm；花径约3cm；萼筒钟状，长2-3cm，通常红色或淡黄色，6裂，裂片略外展，卵状三角形，外面近顶端有一黄绿以腺体，边缘有小乳突；花瓣6，红色、黄色或白色，与萼片互生，倒卵形，长1.5-3cm，宽1-2cm，先端圆钝；雄蕊多数，着生于萼管中部，花药球形，花丝细短；雌蕊1，子房下位，柱头头状。浆果近球形，直径5-12cm，通常淡黄褐色、淡黄绿色或带红色，果皮肥厚，先端有宿存花萼裂片。种子多数，钝角形，红色至乳白色。花期5-6月。果期7-8月。"}]},{"ID":"20240902134110-y9mnrd0","Type":"NodeParagraph","Properties":{"id":"20240902134110-y9mnrd0","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902134110-6l6719m","Type":"NodeParagraph","Properties":{"id":"20240902134110-6l6719m","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"生态环境：生于向阳山坡或栽培于庭园等处。"}]},{"ID":"20240902134110-cagqs07","Type":"NodeParagraph","Properties":{"id":"20240902134110-cagqs07","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"资源分布：我国大部分地区均有分布。"}]},{"ID":"20240902134110-mxcdql2","Type":"NodeParagraph","Properties":{"id":"20240902134110-mxcdql2","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902134110-7zl99jn","Type":"NodeParagraph","Properties":{"id":"20240902134110-7zl99jn","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖向阳的环境，耐旱、耐寒，也耐瘠薄，不耐，不涝和荫蔽。对土壤要求不严，但以排水良好的夹沙土栽培为宜。"}]},{"ID":"20240902134110-uxboojc","Type":"NodeParagraph","Properties":{"id":"20240902134110-uxboojc","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"栽培技术用扦插、压条或分株繁殖。扦插繁殖，育苗移栽：在冬季进行，选取直径1cm左右的粗的、健壮的枝条，剪成6-7节长的插条。然后在1.3m宽的苗床上，按行距33cm开横沟，深约16cm，每隔10-13cm扦插1根，露出地面约1/4，盖土压紧，培育1-2年，在冬季落叶后至早春发芽前移栽，行、株距各3m左右。压条繁殖：4月芽萌动前压条的，夏季才能生根，7-8月可分割，次春移植；7-8月压条的，当年可生根，次春同时分割和移植。分株繁殖：在冬季至早春发芽前，把树脚萌发的小苗连根挖起栽肿。"}]},{"ID":"20240902134110-rmw3caq","Type":"NodeParagraph","Properties":{"id":"20240902134110-rmw3caq","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"田间管理扦插萌芽后，要注意培养主干，只留1-2芽生长，其余除去。中耕除草、追肥3次，在4、6、8月进行，可施人畜粪水。移栽后，每年中耕除草3次，在4、7、9月进行；追肥2次，在3月及11月用人畜粪水、厩肥等，在树财开沟施用。冬季要修剪1次，使树冠枝条稀疏均匀。分株繁殖的管理，与育苗移栽相同。"}]},{"ID":"20240902134110-vx55ktn","Type":"NodeParagraph","Properties":{"id":"20240902134110-vx55ktn","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"病虫害防治虫害有介壳虫，用50%杀螟松乳油1000倍液喷雾，每隔10日1次，连喷3-4次。"}]},{"ID":"20240902134110-uahuvwp","Type":"NodeParagraph","Properties":{"id":"20240902134110-uahuvwp","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902134110-18dmajr","Type":"NodeParagraph","Properties":{"id":"20240902134110-18dmajr","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"性状鉴别果皮半圆形或不规则块片，大小不一，厚1.5-3mm。外表面黄棕色、暗红色或棕红色，稍具光泽，粗糙，有棕色小点，有的有突起的筒状宿萼或粗短果柄。内表面黄色或红棕色，有种子脱落后的凹窝，呈网状隆起。质硬而脆，断面黄色，略显颗粒状。气微，味苦涩。"}]},{"ID":"20240902134110-u6en4ji","Type":"NodeParagraph","Properties":{"id":"20240902134110-u6en4ji","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"以皮厚、棕红色者为佳。"}]},{"ID":"20240902134110-4b29fma","Type":"NodeParagraph","Properties":{"id":"20240902134110-4b29fma","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"显微鉴别果皮横切面：外果皮为一列表皮细胞，排列较紧密，外被角质层。中果皮较厚，薄壁细胞内含淀粉粒及草酸钙簇晶或方晶；石细胞单个散在，类圆形，长方形或不规则形，少数分枝状，壁较厚，胞腔大具纹孔；维管束散在。内果皮薄壁细胞较小，亦含淀粉粒及草酸钙簇晶或方晶；石细胞较小。"}]},{"ID":"20240902134110-t92fpgu","Type":"NodeParagraph","Properties":{"id":"20240902134110-t92fpgu","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄绿色。①石细胞无色、淡黄色或黄棕色。类圆形、长方形或不规则形，有的短分枝，枝端圆钝或膨大，有的边缘呈波状，直径25-121μm，长至μm，长至238μm，壁厚5-46μm，层纹明显，孔沟有分叉，有的含棕色物。②草酸钙簇晶直径3-27μm，棱角较宽；方晶直径3-15μm。③果皮表皮细胞断面观呈类言形，外壁稍厚，角质层厚10-17μm；表面观呈圆多角形，角质层表面呈颗粒性。④导管主要为螺纹导管，直径约4μm；另有网纹导管，直径至25μm。⑤淀粉粒单粒类圆形，直径3-7μm；复粒由2-3分粒组成。⑥棕色块形状不规则。"}]},{"ID":"20240902134110-6nqurb3","Type":"NodeParagraph","Properties":{"id":"20240902134110-6nqurb3","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902134110-c2lsw4t","Type":"NodeParagraph","Properties":{"id":"20240902134110-c2lsw4t","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"果皮含鞣质（tannin)10.4%，蜡（wax)0.8%，树脂肪（resin)4.5%，甘露醇（D-mannitol)1.8%，粘液质（mucilage)0.6%，没食子酸（galicacid)4.0%，苹果酸（amlicacid)、果胶（pectin)和草酸钙（calciumoxalate)4.0%，树胶（gum)3.2%，菊糖（inulin)1.0%，非结晶糖2.7%[1]。从鞣质中分得：石榴皮苦素（granatin)A、B[2]，石榴皮鞣质（punicalin)，2，3-O-连二没食子酰石榴皮鞣质（punicalagin)[3]。果皮还含反油酸（elaidicaicd)[4]，异槲皮甙（isoquercetrin)[5]，矢车菊素-3-葡萄糖甙cyanidin-3-glucoside)，矢车菊素-3，5-二葡萄糖（cyanindin-3，-5-diglucosede)，啼纹天竺素-3-葡萄糖甙（pelargonidin-3-glucoside)，啼纹天竺素-3，5-二葡萄糖甙（pelargonidin-3，5-diglucoside)[6]。又从果皮的甲醇提取物中分得四聚没食子酸（tetramericgallicacid)，有抑制碳酸脱氢酶的活性[7]。"}]},{"ID":"20240902134110-gsasr1e","Type":"NodeParagraph","Properties":{"id":"20240902134110-gsasr1e","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"果皮、茎皮、树皮均含生物碱，已分离出：石榴皮碱（pel-letierine,punicine)，异石榴皮碱（isopelletierine)，伪石榴皮碱（pseudopelletierine)，N-甲基异石榴皮碱（N-methylisopelletie-rine)[8,9]等。又从树皮所含鞣质中分离出：石榴皮鞣质,2,3-O-连二没食子酰石榴皮鞣质，2-O-没食子酰-4，6-（s,s)并没食子酸连二没食子酰-D-葡萄糖[2-O-galloyl-4，6）s,s)-gallgyl-D-glu-cose]，2，3-（s）-六羟基联苯二甲酰基-D-葡萄糖[2，3-（s）-hexahy-droxydiphenoyl-D-葡萄糖[6-O-galloyl-2，3-(s)-hexahydroxydiphenoyl-D-glucose]，长A、B、C、D，石榴皮葡萄糖酸（punigluconin)，木麻黄鞣质（cacortein)，木麻黄鞣宁（casuarinin_[11]。"}]},{"ID":"20240902134110-xqhibbo","Type":"NodeParagraph","Properties":{"id":"20240902134110-xqhibbo","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902134110-7lghenh","Type":"NodeParagraph","Properties":{"id":"20240902134110-7lghenh","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"1.驱虫：石榴皮碱对绦虫有很强的杀灭力，能作用于虫的肌肉，使其陷入持续收缩。盐酸石榴碱1：10000浓度，于5-10分钟后即杀死绦虫。临床证明生物碱与鞣酸结合者驱虫效果较好，这是因为鞣质能使生物碱变成难溶而难吸收的化合物，从而可以充分地对肠寄生虫子发挥作用。"}]},{"ID":"20240902134110-ibw5zkh","Type":"NodeParagraph","Properties":{"id":"20240902134110-ibw5zkh","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"2.抗菌：煎剂用试管稀释法,1：2560对白喉杆菌，1：1280对金黄色葡萄球菌、史氏及福氏痢疾杆菌以及变形杆菌等有抑制作用。对霍乱弧菌，伤寒杆菌、绿脓杆菌及结核杆菌等有明显的抑制作用。"}]},{"ID":"20240902134110-tfj22dl","Type":"NodeParagraph","Properties":{"id":"20240902134110-tfj22dl","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"3.抗真菌：水浸剂用试管稀释法，1：4对堇色毛癣菌、红色表皮癣菌、奥杜盎小孢子菌及星形奴卡菌等皮癣真菌等10种皮癣真菌有抑制作用。"}]},{"ID":"20240902134110-wbz3vj2","Type":"NodeParagraph","Properties":{"id":"20240902134110-wbz3vj2","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"4.抗病毒：试验证明，石榴皮煎剂稀释到1：10000-1：100000仍有抑制流感病毒（甲型PR3株）的作用。参见\"石榴根\"条。"}]},{"ID":"20240902134110-34jr6ky","Type":"NodeParagraph","Properties":{"id":"20240902134110-34jr6ky","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【毒性】生物碱部分是石榴根皮的主要毒性成分，较原生药的毒性强25倍，动物中毒后多死于呼吸抑制；对骨骼肌有藜芦碱，或箭毒样作用。"}]},{"ID":"20240902134110-9z00mcq","Type":"NodeParagraph","Properties":{"id":"20240902134110-9z00mcq","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【鉴别】取本品粉末1g，加水10ml，置60℃水浴中加热10分钟，趁热滤过。取滤液1ml，加1%三氯化铁试液1滴，立即显墨绿色。（鞣质反应）"}]},{"ID":"20240902134110-tbpe6o8","Type":"NodeParagraph","Properties":{"id":"20240902134110-tbpe6o8","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902134110-p8p29uw","Type":"NodeParagraph","Properties":{"id":"20240902134110-p8p29uw","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"1.拣去杂质，去净残留的内瓤及子，洗净，切块，晒。"}]},{"ID":"20240902134110-3p29m80","Type":"NodeParagraph","Properties":{"id":"20240902134110-3p29m80","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》：凡使石榴皮、叶、根，勿令犯铁。若使石榴壳，不计干湿，先用浆水浸一宿，至明漉出，其水如墨汁，方可用。"}]},{"ID":"20240902134110-efnni2u","Type":"NodeParagraph","Properties":{"id":"20240902134110-efnni2u","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【性味】味酸；涩；性温；小毒"}]},{"ID":"20240902134110-blvucnn","Type":"NodeParagraph","Properties":{"id":"20240902134110-blvucnn","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【归经】归大肠经"}]},{"ID":"20240902134110-ptofaji","Type":"NodeParagraph","Properties":{"id":"20240902134110-ptofaji","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【功能主治】涩肠止泻；止血；驱虫；痢疾；肠风下血；崩漏；带下；害虫。主鼻衄；中耳炎；创伤出血；月经不调；红崩白带；牙痛；吐血；久泻；久痢；便血；脱肛；滑精；崩漏；带下；虫积腹痛；疥癣"}]},{"ID":"20240902134110-xqj1yq4","Type":"NodeParagraph","Properties":{"id":"20240902134110-xqj1yq4","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；或入丸、散。外用：适量，煎水熏洗，研末撒或调敷。"}]},{"ID":"20240902134110-qz7npmf","Type":"NodeParagraph","Properties":{"id":"20240902134110-qz7npmf","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【注意】《本草从新》：能恋膈成痰，痢积未尽者，服之太早，反为害也。"}]},{"ID":"20240902134110-39b9uda","Type":"NodeParagraph","Properties":{"id":"20240902134110-39b9uda","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【附方】黄连汤《备急千金要方》：痢疾；石榴皮散《太平圣惠方》：诸虫心痛。"}]},{"ID":"20240902134110-4shf5h5","Type":"NodeParagraph","Properties":{"id":"20240902134110-4shf5h5","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902134110-rouyt1d","Type":"NodeParagraph","Properties":{"id":"20240902134110-rouyt1d","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"1.《别录》：疗下痢，止漏精。"}]},{"ID":"20240902134110-3jevx4z","Type":"NodeParagraph","Properties":{"id":"20240902134110-3jevx4z","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：治筋骨风，腰脚不遂，步行挛急疼痛。主涩肠，止赤白下痢。取汁止目泪下，治漏精。"}]},{"ID":"20240902134110-dgqt7ms","Type":"NodeParagraph","Properties":{"id":"20240902134110-dgqt7ms","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：主蛔虫。煎服。"}]},{"ID":"20240902134110-ikt6uy6","Type":"NodeParagraph","Properties":{"id":"20240902134110-ikt6uy6","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"4.《滇南本草》：治日久水泻，同炒砂糖煨服，又治痢脓血，大肠下血。同马兜铃煎治小儿疳虫。并洗膀胱。"}]},{"ID":"20240902134110-5puul71","Type":"NodeParagraph","Properties":{"id":"20240902134110-5puul71","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"5.《本草蒙筌》：理虫牙。"}]},{"ID":"20240902134110-401pd00","Type":"NodeParagraph","Properties":{"id":"20240902134110-401pd00","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：止泻痢，下血，脱肛，崩中带下。"}]},{"ID":"20240902134110-vdgmtec","Type":"NodeParagraph","Properties":{"id":"20240902134110-vdgmtec","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"7.《生草药性备要》：治瘤子疮，洗疝痛。"}]},{"ID":"20240902134110-obu5m5x","Type":"NodeParagraph","Properties":{"id":"20240902134110-obu5m5x","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"8.《本草求原》：洗zi疥癞。"}]},{"ID":"20240902134110-x49aubk","Type":"NodeParagraph","Properties":{"id":"20240902134110-x49aubk","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"9.《科学的民间药草》：驱除钩、绦虫。"}]},{"ID":"20240902134110-iw92jdo","Type":"NodeParagraph","Properties":{"id":"20240902134110-iw92jdo","updated":"20240902134139"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902134111-oex1fwf","Type":"NodeThematicBreak","Properties":{"id":"20240902134111-oex1fwf","updated":"20240902134139"}},{"ID":"20240902134112-vecsgjh","Type":"NodeParagraph","Properties":{"id":"20240902134112-vecsgjh","updated":"20240902134139"}}]}