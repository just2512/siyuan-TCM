":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722145132-yokeowk","Type":"NodeParagraph","Properties":{"id":"20240722145132-yokeowk","updated":"20240722145132"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"人参 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/人参 8-20240722142551-ya5w6x6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 539px;","style":"width: 529px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"人参 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/人参 4-20240722142018-zsszxvk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 529px;\" parent-style=\"width: 539px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722145132-5ih1yt2","Type":"NodeParagraph","Properties":{"id":"20240722145132-5ih1yt2","updated":"20240722145132"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 348px;","style":"width: 338px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"人参 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/人参 11-20240722144947-azs13ux.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 338px;\" parent-style=\"width: 348px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 898px;","style":"width: 888px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"人参 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/人参 12-20240722145056-l73iua7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 888px;\" parent-style=\"width: 898px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607094257-7gxc792","Type":"NodeParagraph","Properties":{"id":"20240607094257-7gxc792","updated":"20240722145706"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：红参其实是人参的熟制品，人参熟制以后变红了，所以才叫红参；"}]},{"ID":"20240607094258-bpdxfdu","Type":"NodeThematicBreak","Properties":{"id":"20240607094258-bpdxfdu"}},{"ID":"20240607094259-w9ylyw5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607094259-w9ylyw5","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"红参"}]},{"ID":"20240607094259-666h35g","Type":"NodeParagraph","Properties":{"id":"20240607094259-666h35g","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607094259-yzclzaq","Type":"NodeParagraph","Properties":{"id":"20240607094259-yzclzaq","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" RADIX GINSENG RUBRA"}]},{"ID":"20240607094259-8djlugb","Type":"NodeParagraph","Properties":{"id":"20240607094259-8djlugb","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094259-ekivgab","Type":"NodeParagraph","Properties":{"id":"20240607094259-ekivgab","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 本品为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"人参"},{"Type":"NodeText","Data":"Panax ginseng C.A.Mey.的栽培品（习称“圆参”）经蒸制后的干燥根。秋季采挖，洗净，蒸制后，干燥。"}]},{"ID":"20240607094259-6j1lelo","Type":"NodeParagraph","Properties":{"id":"20240607094259-6j1lelo","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094259-4lrcj67","Type":"NodeParagraph","Properties":{"id":"20240607094259-4lrcj67","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 主根呈纺锤形或圆柱形，长3～10cm,直径1～2cm。表面半透明，红棕色，偶有不透明的暗黄褐色斑块，具纵沟、皱纹及细根痕，上部有断续的不明显环纹；下部有2～3条扭曲交叉的支根，并带弯曲的须根或仅具须根残迹。根茎（芦头）长1～2cm，上有数个凹窝状茎痕（芦碗），有的带有1～2条完整或折断的不定根（{丁}）。质硬而脆，断面平坦，角质样。气微香而特异，味甘、微苦。"}]},{"ID":"20240607094259-0g3qrya","Type":"NodeParagraph","Properties":{"id":"20240607094259-0g3qrya","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607094259-jd0k75u","Type":"NodeParagraph","Properties":{"id":"20240607094259-jd0k75u","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，密闭，防蛀。"}]},{"ID":"20240607094259-9q5r377","Type":"NodeParagraph","Properties":{"id":"20240607094259-9q5r377","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094259-63v7k42","Type":"NodeParagraph","Properties":{"id":"20240607094259-63v7k42","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 润透，切薄片，干燥或用时捣碎。"}]},{"ID":"20240607094259-m4ag8iu","Type":"NodeParagraph","Properties":{"id":"20240607094259-m4ag8iu","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607094259-0tab2pn","Type":"NodeParagraph","Properties":{"id":"20240607094259-0tab2pn","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" （1） 照人参项下的[鉴别]（1） 项试验，除淀粉粒糊化轮廓模糊外，其他特征应相同。"}]},{"ID":"20240607094259-ln8ck1b","Type":"NodeParagraph","Properties":{"id":"20240607094259-ln8ck1b","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"（2） 照人参项下的[鉴别]（2）项试验，应显相同结果。"}]},{"ID":"20240607094259-xb2nyq4","Type":"NodeParagraph","Properties":{"id":"20240607094259-xb2nyq4","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607094259-brst4xf","Type":"NodeParagraph","Properties":{"id":"20240607094259-brst4xf","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240607094259-om0x83s","Type":"NodeParagraph","Properties":{"id":"20240607094259-om0x83s","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；乙腈-0.05％磷酸溶液（99：400）为流动相；检测波长为203nm。理论板数按人参皂苷Re峰计算应不低于2500。"}]},{"ID":"20240607094259-nwvjing","Type":"NodeParagraph","Properties":{"id":"20240607094259-nwvjing","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取人参皂苷Re对照品12.5mg，置10ml量瓶中，加甲醇至刻度，摇匀，精密量取5ml,置25ml量瓶中，加甲醇至刻度，摇匀；另精密称取人参皂苷Rg1对照品10mg，置25ml量瓶中，加甲醇至刻度，摇匀,即得（每1ml中含人参皂苷Rg10.4mg；含人参皂苷Re0.25mg）。"}]},{"ID":"20240607094259-fb6280q","Type":"NodeParagraph","Properties":{"id":"20240607094259-fb6280q","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末（过四号筛）约1g，精密称定，置索氏提取器中，加氯仿40ml，加热回流3小时，弃去氯仿液，药渣挥去氯仿，连同滤纸筒移至100ml具塞锥形瓶中，精密加入水饱和的正丁醇50ml，密塞，放置过夜，超声处理（功率250W，频率50kHz）30分钟，滤过，精密量取续滤液25ml，置蒸发皿中，蒸干，残渣加甲醇溶解并转移至5ml量瓶中，加甲醇至刻度，摇匀，即得。"}]},{"ID":"20240607094259-tertgh3","Type":"NodeParagraph","Properties":{"id":"20240607094259-tertgh3","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取上述两种对照品溶液各10μl与供试品溶液20μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240607094259-0ox47ic","Type":"NodeParagraph","Properties":{"id":"20240607094259-0ox47ic","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"本品含人参皂苷Rg1（C42H72O14）和人参皂苷Re（C48H82O18）的总量不得少于0.20％。"}]},{"ID":"20240607094259-kapj2h5","Type":"NodeParagraph","Properties":{"id":"20240607094259-kapj2h5","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094259-2uxfma1","Type":"NodeParagraph","Properties":{"id":"20240607094259-2uxfma1","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 归脾、肺、心经。"}]},{"ID":"20240607094259-9yik8kf","Type":"NodeParagraph","Properties":{"id":"20240607094259-9yik8kf","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094259-wsv0xt5","Type":"NodeParagraph","Properties":{"id":"20240607094259-wsv0xt5","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 甘、微苦，温。"}]},{"ID":"20240607094259-fy3p5sp","Type":"NodeParagraph","Properties":{"id":"20240607094259-fy3p5sp","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094259-7fdhmzk","Type":"NodeParagraph","Properties":{"id":"20240607094259-7fdhmzk","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 不宜与藜芦同用。"}]},{"ID":"20240607094259-pi0czwl","Type":"NodeParagraph","Properties":{"id":"20240607094259-pi0czwl","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094259-iik4w67","Type":"NodeParagraph","Properties":{"id":"20240607094259-iik4w67","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 大补元气，复脉固脱，益气摄血。用于体虚欲脱，肢冷脉微，气不摄血，崩漏下血；心力衰竭，心原性休克。"}]},{"ID":"20240607094259-tk2kicq","Type":"NodeParagraph","Properties":{"id":"20240607094259-tk2kicq","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094259-lrt9rfq","Type":"NodeParagraph","Properties":{"id":"20240607094259-lrt9rfq","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240607094259-fyshxqw","Type":"NodeParagraph","Properties":{"id":"20240607094259-fyshxqw","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094259-3neyd8j","Type":"NodeParagraph","Properties":{"id":"20240607094259-3neyd8j","updated":"20240607094259"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607094300-5k481kd","Type":"NodeThematicBreak","Properties":{"id":"20240607094300-5k481kd","updated":"20240607094259"}},{"ID":"20240607094301-7y69515","Type":"NodeParagraph","Properties":{"id":"20240607094301-7y69515","updated":"20240607094259"}}]}