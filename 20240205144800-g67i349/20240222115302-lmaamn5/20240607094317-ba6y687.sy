penParen"},{"Type":"NodeLinkDest","Data":"assets/人参、西洋参对比 2-20240726155344-mdii8ht.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 609px;\" parent-style=\"width: 619px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726153841-dmomkru","Type":"NodeParagraph","Properties":{"id":"20240726153841-dmomkru","updated":"20240801111824"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：人参和西洋参较为相像，人参叶子偏窄一点，叶边锯齿不如西洋参明显；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205165628-u3pxv3y","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"021人参"}]},{"ID":"20240607094400-vxfarzf","Type":"NodeThematicBreak","Properties":{"id":"20240607094400-vxfarzf"}},{"ID":"20240607094401-r8o1772","Type":"NodeParagraph","Properties":{"id":"20240607094401-r8o1772","updated":"20240902174324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西洋参"}]},{"ID":"20240607094401-8vdynlo","Type":"NodeParagraph","Properties":{"id":"20240607094401-8vdynlo","updated":"20240607094401"},"Children":[{"Type":"NodeText","Data":"《中国药典》：西洋参"}]},{"ID":"20240607094401-yycg9n7","Type":"NodeParagraph","Properties":{"id":"20240607094401-yycg9n7","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094401-0o9dgoj","Type":"NodeParagraph","Properties":{"id":"20240607094401-0o9dgoj","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" Xī Yánɡ Shēn"}]},{"ID":"20240607094401-kl4vxjq","Type":"NodeParagraph","Properties":{"id":"20240607094401-kl4vxjq","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607094401-9ah9n6d","Type":"NodeParagraph","Properties":{"id":"20240607094401-9ah9n6d","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" RADIX PANACIS QUINQUEFOLII"}]},{"ID":"20240607094401-m8jihoi","Type":"NodeParagraph","Properties":{"id":"20240607094401-m8jihoi","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094401-zw234nx","Type":"NodeParagraph","Properties":{"id":"20240607094401-zw234nx","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 本品为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西洋参"},{"Type":"NodeText","Data":"Panax quinquefolium L．的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。均系栽培品，秋季采挖，洗净，晒干或低温干燥。"}]},{"ID":"20240607094401-blv8kht","Type":"NodeParagraph","Properties":{"id":"20240607094401-blv8kht","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094401-wlva3qp","Type":"NodeParagraph","Properties":{"id":"20240607094401-wlva3qp","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 本品呈纺锤形、圆柱形或圆锥形，长3～12cm，直径0.8～2cm。表面浅黄褐色或黄白色，可见横向环纹及线状皮孔，并有细密浅纵皱纹及须根痕。主根中下部有一至数条侧根；多已折断。有的上端有根茎（芦头），环节明显，茎痕（芦碗）圆形或半圆形具不定根疔或已折断。体重，质坚实，不易折断，断面平坦，浅黄白色，略显粉性，皮部可见黄棕色点状树脂道，形成层环纹棕黄色，本部略呈放射状纹理。气微而特异，味微苦、甘。"}]},{"ID":"20240607094401-tka8npm","Type":"NodeParagraph","Properties":{"id":"20240607094401-tka8npm","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607094401-va8oo0n","Type":"NodeParagraph","Properties":{"id":"20240607094401-va8oo0n","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，密闭，防蛀。"}]},{"ID":"20240607094401-uvwmsf0","Type":"NodeParagraph","Properties":{"id":"20240607094401-uvwmsf0","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094401-le7dhb4","Type":"NodeParagraph","Properties":{"id":"20240607094401-le7dhb4","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 去芦，润透，切薄片，干燥或用时捣碎。"}]},{"ID":"20240607094401-1ykxsxq","Type":"NodeParagraph","Properties":{"id":"20240607094401-1ykxsxq","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607094401-vsprip3","Type":"NodeParagraph","Properties":{"id":"20240607094401-vsprip3","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 取本品粉末 1g，加甲醇25ml，加热回流 1小时，放冷，滤过，滤液蒸干，残渣加水20ml使溶解，用乙醚振摇提取2次，每次10ml，弃去乙醚液，水层用水饱和的正丁醇振摇提取3次，每次15ml，合并正丁醇提取液，用水洗涤2次，每次10ml，分取正丁醇液，蒸干，残渣加甲醇1ml使溶解,作为供试品溶液。另取西洋参对照药材 1g，同法制成对照药材溶液。再取拟人参皂苷 F\u003c[11]\u003e、人参皂苷 Rb1、Re、Rg1对照品，加甲醇制成每 1ml各含2mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取上述六种溶液各2μl，分别点于同一硅胶 G薄层板上，以氯仿-醋酸乙酯-甲醇-水（15:40:22:10）5～10℃放置12小时的下层溶液为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在105℃加热至斑点显色清晰，分别置日光及紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱及对照品色谱相应的位置上，分别显相同颜色的斑点或荧光斑点。"}]},{"ID":"20240607094401-38xdibm","Type":"NodeParagraph","Properties":{"id":"20240607094401-38xdibm","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607094401-zh7jzh8","Type":"NodeParagraph","Properties":{"id":"20240607094401-zh7jzh8","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240607094401-jtkxmgb","Type":"NodeParagraph","Properties":{"id":"20240607094401-jtkxmgb","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；乙腈-水（30:70）为流动相；检测波长为203nm；柱温40℃。理论板数按人参皂苷 Rb1峰计算应不低于4000。"}]},{"ID":"20240607094401-ivkxzkp","Type":"NodeParagraph","Properties":{"id":"20240607094401-ivkxzkp","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取人参皂苷 Rb1对照品7.5mg，置25ml量瓶中，加甲醇至刻度，摇匀，即得（每 1ml中含人参皂苷 Rb10.3mg）。"}]},{"ID":"20240607094401-vh49x2r","Type":"NodeParagraph","Properties":{"id":"20240607094401-vh49x2r","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品细粉约0.5g，精密称定，置锥形瓶中，精密加入甲醇50ml，称定重量，加热回流1.5小时，放冷，再称定重量，用甲醇补足减失的重量，摇匀，滤过。精密量取续滤液25ml，置蒸发皿中，蒸干。残渣以水饱和的正丁醇50ml分次转移至分液漏斗中，加氨试液振摇提取 2次，每次5ml，合并水液。用水饱和的正丁醇振摇提取2次，每次10ml，合并正丁醇提取液，用正丁醇饱和的水洗涤2次；每次10ml，合并水液，再以水饱和的正丁醇10ml振摇提取。合并前后2次的正丁醇提取液，蒸干，残渣加甲醇转移至10ml量瓶中，并加甲醇至刻度。摇匀，用微孔滤膜（0.45μm）滤过，取续滤液，即得。"}]},{"ID":"20240607094401-jks0fp2","Type":"NodeParagraph","Properties":{"id":"20240607094401-jks0fp2","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取对照品溶液与供试品溶液各10μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240607094401-4prcusf","Type":"NodeParagraph","Properties":{"id":"20240607094401-4prcusf","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"本品含人参皂苷 Rb1（C54H92O23）不得少于1.0％。"}]},{"ID":"20240607094401-x70zmej","Type":"NodeParagraph","Properties":{"id":"20240607094401-x70zmej","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094401-xrs7ohx","Type":"NodeParagraph","Properties":{"id":"20240607094401-xrs7ohx","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 归心、肺、肾经。"}]},{"ID":"20240607094401-popxl4u","Type":"NodeParagraph","Properties":{"id":"20240607094401-popxl4u","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094401-teqj6hc","Type":"NodeParagraph","Properties":{"id":"20240607094401-teqj6hc","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 甘、微苦，凉。"}]},{"ID":"20240607094401-v85rruf","Type":"NodeParagraph","Properties":{"id":"20240607094401-v85rruf","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094401-q8y5f54","Type":"NodeParagraph","Properties":{"id":"20240607094401-q8y5f54","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 不宜与藜芦同用。"}]},{"ID":"20240607094401-retokm7","Type":"NodeParagraph","Properties":{"id":"20240607094401-retokm7","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094401-8i37hbz","Type":"NodeParagraph","Properties":{"id":"20240607094401-8i37hbz","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 补气养阴，清热生津。用于气虚阴亏，内热，咳喘痰血，虚热烦倦，消渴，口燥咽干。"}]},{"ID":"20240607094401-iz4ugtw","Type":"NodeParagraph","Properties":{"id":"20240607094401-iz4ugtw","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094401-7io9gkj","Type":"NodeParagraph","Properties":{"id":"20240607094401-7io9gkj","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 3～6g。"}]},{"ID":"20240607094401-mp0mmuq","Type":"NodeParagraph","Properties":{"id":"20240607094401-mp0mmuq","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094401-jk3ckek","Type":"NodeParagraph","Properties":{"id":"20240607094401-jk3ckek","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607094401-zfu2tur","Type":"NodeParagraph","Properties":{"id":"20240607094401-zfu2tur","updated":"20240902174331"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《中药大辞典》：西洋参"}]},{"ID":"20240607094401-a4bwzdv","Type":"NodeParagraph","Properties":{"id":"20240607094401-a4bwzdv","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094401-l1hbtek","Type":"NodeParagraph","Properties":{"id":"20240607094401-l1hbtek","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" Xī Yánɡ Shēn"}]},{"ID":"20240607094401-dqygnrp","Type":"NodeParagraph","Properties":{"id":"20240607094401-dqygnrp","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607094401-7f3p8em","Type":"NodeParagraph","Properties":{"id":"20240607094401-7f3p8em","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 西洋人参（《本草从新》），洋参（《药性考》），西参（《增订伪药条辨》），花旗参、广东人参（《中国药植志》）。"}]},{"ID":"20240607094401-8x5tgx2","Type":"NodeParagraph","Properties":{"id":"20240607094401-8x5tgx2","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607094401-w1m7bap","Type":"NodeParagraph","Properties":{"id":"20240607094401-w1m7bap","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 《纲目》"}]},{"ID":"20240607094401-shyabp0","Type":"NodeParagraph","Properties":{"id":"20240607094401-shyabp0","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094401-jkey3xj","Type":"NodeParagraph","Properties":{"id":"20240607094401-jkey3xj","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西洋参"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。选取生长3～6年的根，于秋季挖采，除去分枝、须尾，晒干。喷水湿润，撞去外皮，再用硫黄熏之，晒干后，其色白起粉者，称为\"粉光西洋参\"。挖起后即连皮晒干或烘干者，为\"原皮西洋参\"。"}]},{"ID":"20240607094401-geg350z","Type":"NodeParagraph","Properties":{"id":"20240607094401-geg350z","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607094401-nxsw3tk","Type":"NodeParagraph","Properties":{"id":"20240607094401-nxsw3tk","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 原产北美，我国亦有栽培。"}]},{"ID":"20240607094401-v50a061","Type":"NodeParagraph","Properties":{"id":"20240607094401-v50a061","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607094401-tk2we8n","Type":"NodeParagraph","Properties":{"id":"20240607094401-tk2we8n","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 多年生草木，全体无毛。根肉质，纺锤形，有时呈分歧状。根茎短。茎圆柱形，长约25厘米，有纵条纹，或略具棱。掌状5出复叶，通常3～4枚，轮生于茎端；叶柄长5～7厘米；小叶片膜质，广卵形至倒卵形，长4～9厘米，宽2.5～5厘米，先端突尖，边缘具粗锯齿，基部楔形，最下两小叶最小；小叶柄长约1.5厘米，最下二小叶柄较短或近于无柄。总花梗由茎端叶柄中央抽出，较叶柄稍长或近于等长；伞形花序，花多数，花梗细短，基部有卵形小苞片1枚；萼绿色，钟状，先端5齿裂，裂片钝头，萼筒基部有三角形小苞片1枚；花瓣5，绿白色，矩圆形；雄蕊5，花丝基部稍宽，花药卵形至矩圆形；雌蕊1，子房下位，2室，花柱2，上部分离呈叉状，下部合生；花盘肉质环状。浆果扁圆形，成对状，熟时鲜红色，果柄伸长。花期7月。果熟期9月。"}]},{"ID":"20240607094401-kvty5h6","Type":"NodeParagraph","Properties":{"id":"20240607094401-kvty5h6","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094401-puivyy7","Type":"NodeParagraph","Properties":{"id":"20240607094401-puivyy7","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 干燥根略呈圆柱形而带纺锤状，长2～6厘米，粗0.5～1厘米，外表现细横纹及不规则的纵皱，顶端的细纹较密而呈环状。折断面平坦，淡黄色，有暗色形成层环，并散有多数红棕色树脂管及细管。由于加工不同，一般分为粉光西洋参及原皮西洋参二类，每类又因野生和栽培而有不同："}]},{"ID":"20240607094401-jf14ggr","Type":"NodeParagraph","Properties":{"id":"20240607094401-jf14ggr","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"①粉光西洋参"}]},{"ID":"20240607094401-i6ucd1z","Type":"NodeParagraph","Properties":{"id":"20240607094401-i6ucd1z","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"野生者形较小，或有分歧，色白而光，外表横纹细密。体轻。气香而浓，味微甜带苦。栽培者，皮色白，细纹不及野生者紧密。体重质坚而味淡。"}]},{"ID":"20240607094401-n4uwsws","Type":"NodeParagraph","Properties":{"id":"20240607094401-n4uwsws","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"②原皮西洋参"}]},{"ID":"20240607094401-vtfwnbc","Type":"NodeParagraph","Properties":{"id":"20240607094401-vtfwnbc","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"野生者形粗如大拇指，或较小。外表土黄色，横纹色黑而细密。内部黄白色。体质轻松。气香味浓，品质优良。栽培者，形与野生者相似，但外皮淡黄，皮细，横纹不黑而较疏。体质结实而沉重。味较淡。以上二种均以条匀、质硬、体轻、表面横纹紧密、气清香、味浓者为佳。一般又以野生者为上品，栽培者次之。"}]},{"ID":"20240607094401-f01ht4r","Type":"NodeParagraph","Properties":{"id":"20240607094401-f01ht4r","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"主产美国、加拿大及法国。"}]},{"ID":"20240607094401-9b3fujv","Type":"NodeParagraph","Properties":{"id":"20240607094401-9b3fujv","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607094401-psugc1y","Type":"NodeParagraph","Properties":{"id":"20240607094401-psugc1y","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 根茎含人参皂甙Ro、Rb1、Rb2、Rc、Rd、Re、Rg1以及假人参皂甙F1（pseudoginsenosideF11），尚含精氨酸、天冬氨酸等18种氨基酸；又含挥发油、树脂等。"}]},{"ID":"20240607094401-rktz27t","Type":"NodeParagraph","Properties":{"id":"20240607094401-rktz27t","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607094401-1ai2v6d","Type":"NodeParagraph","Properties":{"id":"20240607094401-1ai2v6d","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 动物实验，对大脑有镇静作用，对生命中枢则有中度的兴奋作用。"}]},{"ID":"20240607094401-dorqjcl","Type":"NodeParagraph","Properties":{"id":"20240607094401-dorqjcl","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094401-48vfpxx","Type":"NodeParagraph","Properties":{"id":"20240607094401-48vfpxx","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 原药用清水喷潮，覆盖湿布，夏秋润2天，冬春润3天，取出切片，晾干。"}]},{"ID":"20240607094401-incerk2","Type":"NodeParagraph","Properties":{"id":"20240607094401-incerk2","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094401-vtgbmqt","Type":"NodeParagraph","Properties":{"id":"20240607094401-vtgbmqt","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 《本草再新》：\"入心、肺、肾三经。\""}]},{"ID":"20240607094401-85jirya","Type":"NodeParagraph","Properties":{"id":"20240607094401-85jirya","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094401-7nrpk9z","Type":"NodeParagraph","Properties":{"id":"20240607094401-7nrpk9z","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 甘微苦，凉。"}]},{"ID":"20240607094401-aoka4vw","Type":"NodeParagraph","Properties":{"id":"20240607094401-aoka4vw","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"①《本草从新》：\"苦微甘，寒。\""}]},{"ID":"20240607094401-o7zoh27","Type":"NodeParagraph","Properties":{"id":"20240607094401-o7zoh27","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"味甘辛，性凉，无毒。\""}]},{"ID":"20240607094401-gd1jpis","Type":"NodeParagraph","Properties":{"id":"20240607094401-gd1jpis","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094401-ntoww37","Type":"NodeParagraph","Properties":{"id":"20240607094401-ntoww37","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 中阳衰微，胃有寒湿者忌服。"}]},{"ID":"20240607094401-5ng5v2r","Type":"NodeParagraph","Properties":{"id":"20240607094401-5ng5v2r","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"①《本草从新》：\"脏寒者服之，即作腹痛，郁火服之，火不透发，反生寒热。\""}]},{"ID":"20240607094401-dykv6qm","Type":"NodeParagraph","Properties":{"id":"20240607094401-dykv6qm","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"②《纲目拾遗》：\"忌铁器及火炒。\""}]},{"ID":"20240607094401-uativcs","Type":"NodeParagraph","Properties":{"id":"20240607094401-uativcs","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094401-otsq1wh","Type":"NodeParagraph","Properties":{"id":"20240607094401-otsq1wh","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 益肺阴，清虚火，生津止渴。治肺虚久嗽，失血，咽干口渴，虚热烦倦。"}]},{"ID":"20240607094401-xmuh6ek","Type":"NodeParagraph","Properties":{"id":"20240607094401-xmuh6ek","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"①《本草从新》：\"补肺降火，生津液，除烦倦。虚而有火者相宜。\""}]},{"ID":"20240607094401-r9dwpmy","Type":"NodeParagraph","Properties":{"id":"20240607094401-r9dwpmy","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"②《药性考》：\"补阴退热。姜制益气，扶正气。\""}]},{"ID":"20240607094401-zvwu55h","Type":"NodeParagraph","Properties":{"id":"20240607094401-zvwu55h","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"治肺火旺，咳嗽痰多，气虚呵喘，失血，劳伤，固精安神，生产诸虚。\""}]},{"ID":"20240607094401-lbrqrfi","Type":"NodeParagraph","Properties":{"id":"20240607094401-lbrqrfi","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"清肺肾，凉心脾以降火，消暑，解酒。\""}]},{"ID":"20240607094401-4925fnm","Type":"NodeParagraph","Properties":{"id":"20240607094401-4925fnm","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"⑧《医学衷中参西录》：\"能补助气分，并能补益血分。\""}]},{"ID":"20240607094401-cbttudz","Type":"NodeParagraph","Properties":{"id":"20240607094401-cbttudz","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094401-jrbodlq","Type":"NodeParagraph","Properties":{"id":"20240607094401-jrbodlq","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤（另煎和服），0.8～2钱。"}]},{"ID":"20240607094401-3g7kbcc","Type":"NodeParagraph","Properties":{"id":"20240607094401-3g7kbcc","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607094401-eiw0wh8","Type":"NodeParagraph","Properties":{"id":"20240607094401-eiw0wh8","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 治肠红：西洋参蒸桂圆服之。（《类聚要方》）"}]},{"ID":"20240607094401-oqrdmts","Type":"NodeParagraph","Properties":{"id":"20240607094401-oqrdmts","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094401-i20eja0","Type":"NodeParagraph","Properties":{"id":"20240607094401-i20eja0","updated":"20240902174347"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607094401-r5xzo9b","Type":"NodeParagraph","Properties":{"id":"20240607094401-r5xzo9b","updated":"20240902174336"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《中华本草》：西洋参"}]},{"ID":"20240607094401-9s3i2pl","Type":"NodeParagraph","Properties":{"id":"20240607094401-9s3i2pl","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094401-ngnlz5m","Type":"NodeParagraph","Properties":{"id":"20240607094401-ngnlz5m","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" Xī Yánɡ Shēn"}]},{"ID":"20240607094401-em6cyfr","Type":"NodeParagraph","Properties":{"id":"20240607094401-em6cyfr","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607094401-syw7d2w","Type":"NodeParagraph","Properties":{"id":"20240607094401-syw7d2w","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 西洋人参、洋参、西参、花旗参、广东人参"}]},{"ID":"20240607094401-121id76","Type":"NodeParagraph","Properties":{"id":"20240607094401-121id76","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607094401-iqhrmsa","Type":"NodeParagraph","Properties":{"id":"20240607094401-iqhrmsa","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" American Ginseng"}]},{"ID":"20240607094401-i5hm9c9","Type":"NodeParagraph","Properties":{"id":"20240607094401-i5hm9c9","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607094401-j88973q","Type":"NodeParagraph","Properties":{"id":"20240607094401-j88973q","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 1.《本草纲目拾遗》：西洋参，若对半擘开者，名片参，不佳。反藜芦。入药选皮细洁，切开中心不黑，紧实而大者良。近日有嫌其性寒，饭锅上蒸数十次而用者，或用桂圆肉拌蒸而用者。"}]},{"ID":"20240607094401-pppv2ut","Type":"NodeParagraph","Properties":{"id":"20240607094401-pppv2ut","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"2.《增订伪药条辨》：西洋参，欲鉴别其真伪，必须分气味、形色、性质。真光西参，色白，质轻，性松，气清芬，切片内层肉纹有细微菊花心之纹眼，味初嚼则苦，渐含则兼甘味，口觉甚清爽，气味能久留口中。若副光伪参，色虽白，质重而坚，内层"}]},{"ID":"20240607094401-ildsyln","Type":"NodeParagraph","Properties":{"id":"20240607094401-ildsyln","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094401-aq5ob39","Type":"NodeParagraph","Properties":{"id":"20240607094401-aq5ob39","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 药材基源：为五加科植物西洋参的根。"}]},{"ID":"20240607094401-c0mwyr4","Type":"NodeParagraph","Properties":{"id":"20240607094401-c0mwyr4","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Panax quinquefolium L."}]},{"ID":"20240607094401-hpcy8se","Type":"NodeParagraph","Properties":{"id":"20240607094401-hpcy8se","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9月下旬采收，把参根泥土冲洗干净，置于室外稍风干，放进干燥室干燥架上，摊薄，加温或红外线干燥，开始温度保持21-22℃每日使温度略略增加，并行翻动，适时排潮，最后干燥的温度不宜超过33℃，3星期至1个月时间干透，按大、中、小分等或加工成各种等级洋参。"}]},{"ID":"20240607094401-c36xdc7","Type":"NodeParagraph","Properties":{"id":"20240607094401-c36xdc7","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607094401-q1ukwph","Type":"NodeParagraph","Properties":{"id":"20240607094401-q1ukwph","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 我国东北及北京、西安、江西等地有栽培。原产北美。"}]},{"ID":"20240607094401-v6zv1s6","Type":"NodeParagraph","Properties":{"id":"20240607094401-v6zv1s6","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607094401-lxefjrc","Type":"NodeParagraph","Properties":{"id":"20240607094401-lxefjrc","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高25-30cm。根肉质，纺锤形，时有分枝。茎圆柱形，具纵条纹。掌状复叶，通常3-4枚轮生茎顶；叶柄压扁状，长5-7cm；小叶通常5，稀7片，下方2片较小；小叶柄长1-2cm；小叶片倒卵形、宽卵形或阔椭圆形，长4-9cm，宽2-5cm，先端急尾尖，基部下延楔形，边缘具粗锯齿，上面叶脉有稀疏细刚毛。伞形花序单一顶生，有20-80多朵小花集成圆球形，总药梗长10-20cm，苞片卵形；萼钟状，绿色，5齿裂；花冠绿白色，5瓣，长圆形；雄蕊5，花丝基部稍扁；雌蕊1，子房下位，2室，花柱2，上部分离，环状花盘，肉质。核果状浆果，扁球形，多数，含集成头状，成熟时鲜红色。花期5-6月，果期6-9月。"}]},{"ID":"20240607094401-nnrx18o","Type":"NodeParagraph","Properties":{"id":"20240607094401-nnrx18o","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607094401-v7zqxe7","Type":"NodeParagraph","Properties":{"id":"20240607094401-v7zqxe7","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜湿润环境，美国主产区年平均气湿为3.6-12.7℃，1月份平均气温为.0-3.9℃，7月份平均气温为20.1-24℃，年雨量1100-1200mm。土壤为森林灰棕壤，表层灰褐色，团粒结构，腐殖质含量较高，pH5.3-6.5，通透性良好。"}]},{"ID":"20240607094401-ox9i34v","Type":"NodeParagraph","Properties":{"id":"20240607094401-ox9i34v","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"西洋参是一种阴性植物，忌强光照射，故栽培时需搭棚遮光，参棚透光度20%-25%。不同季节透光度应有不同，春季透光度稍大（22%）可减轻病害，夏季高温季节透光度宜小。"}]},{"ID":"20240607094401-zurajb8","Type":"NodeParagraph","Properties":{"id":"20240607094401-zurajb8","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"栽培技术 前作物宜选禾本科及豆科植物，不宜在烟草、茄等茄科作物土壤培。土壤宜选透水性能好，肥沃，并夹有大粒粗砂的砂质壤土，不宜选粘土或排水不良容易积水的低洼地区栽培。土地选好后，休闲1年并进行翻晒8-10次，在翻晒同时施入基肥，翻深30-40cm。地整细后，南北走向做畦，畦宽1.5-1.8m，畦高25-30cm，作业道40cm。秋播或春播，播种深度3cm，行株距8.3cm×3cm或10cm×5cm，播后哇面覆稻草10cm，充分浇水，水分宜透过覆草层与畦面湿土相接。用苇帘或尼龙网搭棚遮荫，透光度20%。"}]},{"ID":"20240607094401-rgqt430","Type":"NodeParagraph","Properties":{"id":"20240607094401-rgqt430","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间，根据田间需水情况，采用浇灌或喷灌方式浇水。参畦内杂草根及时清除。生长期、花果期、休眼期均需追肥。不留种地，当花茎抽出1-2cm时，选晴天及时摘除。"}]},{"ID":"20240607094401-y8coddi","Type":"NodeParagraph","Properties":{"id":"20240607094401-y8coddi","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"病虫害防治 主要病害有：立枯病，可用50%多菌灵防治。疫病，发病初期叶面喷瑞毒霉500倍液防治。锈腐病、根腐病，发病初期用50%多菌灵或50%甲基托布津500倍液，浇灌病穴。还有猝倒病、黑斑病等、虫害有地老虎、金针虫等，人工捕捉或用毒饵诱杀。"}]},{"ID":"20240607094401-ntm1nwm","Type":"NodeParagraph","Properties":{"id":"20240607094401-ntm1nwm","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094401-ahkecdj","Type":"NodeParagraph","Properties":{"id":"20240607094401-ahkecdj","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 全须生晒洋参的主根圆柱形或短圆柱形，下部有分歧状支根，有时下部无支根分歧则主根，有时下部无支根分歧则主根呈圆锥形或纺锤形，长1.5-9cm，直径0.5-3cm；外表淡黄色或土黄色，有必集的细环纹，另有纵皱及少数横长皮孔。根茎已除去或部分殖留，圆柱形或扁圆柱形，长0.1-1.3cm，直径0.1-1cm，具1-4个凹窝状茎痕，不定根有时可见。支根无或2-6个，具须根，上有疣状突起。质硬脆，断面淡黄白色，有棕色或棕黄构环，皮部散有橙红色或红棕色小点，有放射状裂隙。气微香，味苦微甘。"}]},{"ID":"20240607094401-1gl35gp","Type":"NodeParagraph","Properties":{"id":"20240607094401-1gl35gp","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"全须生晒洋参如除去支根与不定根则称为生晒洋参，性状与全须生晒洋参相似。"}]},{"ID":"20240607094401-mr6ypbb","Type":"NodeParagraph","Properties":{"id":"20240607094401-mr6ypbb","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"进口西洋参多加工成生晒洋参。表面灰黄色、棕黄色或土黄色，环纹较明显，多元根茎。质坚硬。"}]},{"ID":"20240607094401-sqlc6d5","Type":"NodeParagraph","Properties":{"id":"20240607094401-sqlc6d5","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"以条匀、质硬，表面横纹紧密、气清香，味浓者为佳。"}]},{"ID":"20240607094401-nyaksow","Type":"NodeParagraph","Properties":{"id":"20240607094401-nyaksow","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：淡米黄以或淡黄白色。①树脂道纵断面观呈管道状，内含大量金黄色油滴状分泌物和少量橘状分泌物和少量橘红色条块状分泌物；横断面观呈类圆形、圆多角形或类长圆形，内径34-340μm，由5-11个分泌细胞围成，分泌物多呈油滴状，少为颗粒状或团块状；周围分泌细胞中含油滴状或颗粒状分泌物。②草酸钼簇晶较多，直径17-78μm。③木栓细胞无色、淡黄色或淡黄棕以，表面观类多角形或类方形，垂周壁薄，细波状弯曲，内偶见草酸钼小方晶。④导管主要为网纹、梯纹导管，少数为环纹、螺纹、穿孔多位于侧壁。⑤薄壁细胞类圆形或类长圆形，含细颗粒状物。⑥淀粉粒单粒类圆形、类椭圆形或卵形，直径7-22μm，脐点点状、裂缝状、人字状或V字形，当选数十字形，层纹不明显；复粒较少，2-8分粒组成。"}]},{"ID":"20240607094401-bcdeqmg","Type":"NodeParagraph","Properties":{"id":"20240607094401-bcdeqmg","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607094401-9mx1lw2","Type":"NodeParagraph","Properties":{"id":"20240607094401-9mx1lw2","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 根茎含甙类，主要是人参皂甙(Panaquilon)；又含挥发油、树脂等。含总皂甙6.4%-7.3%,水解主要得到人参二醇；另含人参三醇和齐墩果酸。辽宁栽培品中含人参皂甙(ginsenosides)Rb1、Rb2、Rd、Re、Rf、Rg1、Rg2、Rg3、Rh1、R。和RA0，亦有报道Rc。此外，含胡萝卜甙(daucosterin)、齐墩果酸、豆甾烯醇(stigmast-5-en-3ol)、豆甾-3,5-二烯-7-酮(stigmast-3,5-diene-7-one)。栽培品尚含挥发油、油脂、氨基酸和多种微量元素。挥发油中已鉴定出32种成分，其中β-金合欢烯含量最高为26.05%，其次为十六烷8.9%和β-古芸烯7.89%，另外含量在1%以上的尚有己酸、十二烷、长叶薄荷酮、长叶烯、β-甜没药烯、反丁香烯、3-苯基-十一烷、6-苯基-十二烷、4-苯基-十二烷、3-苯基-十二烷、2-苯基-十二烷。油脂中含有己酸、辛酸、庚酸、壬酸、十五酸、十六酸、十七酸、十八酸、十八烯酸、十八二烯酸、9,12,15-十八三烯酸、8-甲基癸酸，亦有报道尚含乙酸。氨基酸有17种以上，其中人体必需氨基酸有苏氨酸、缬氨酸、蛋氨酸、异亮氨酸、亮氨酸、赖氨酸和苯丙氨酸；另组氨酸和精氨酸等。含有人体必需的微量元素有铁、铬、铜、硼、锰、锶、和锌，另含钙、钾、镁、磷几种人体宏量元素。有报道自西洋参根中尚得到假人参皂甙-F11(pseudoginsenoside-F11)。"}]},{"ID":"20240607094401-o4thcmb","Type":"NodeParagraph","Properties":{"id":"20240607094401-o4thcmb","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607094401-mp1bjlo","Type":"NodeParagraph","Properties":{"id":"20240607094401-mp1bjlo","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 1.西洋参皂甙60mg/kg腹腔注射，有抗疲劳作用，可延长小鼠游泳时间。"}]},{"ID":"20240607094401-tbxo0je","Type":"NodeParagraph","Properties":{"id":"20240607094401-tbxo0je","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"2.抗利尿：西洋参皂甙60mg/kg腹腔注射，对大鼠有抗利尿作用。"}]},{"ID":"20240607094401-iwuu1p7","Type":"NodeParagraph","Properties":{"id":"20240607094401-iwuu1p7","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"3.耐缺氧：西洋参皂甙60mg/kg腹腔注射，可延长缺氧小鼠的存活时间。"}]},{"ID":"20240607094401-5b8ltri","Type":"NodeParagraph","Properties":{"id":"20240607094401-5b8ltri","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"4.抗惊厥：西洋参皂甙60mg/kg腹腔注射，对戊四唑惊厥及士的宁惊厥死亡率均有降低。"}]},{"ID":"20240607094401-i9hhcid","Type":"NodeParagraph","Properties":{"id":"20240607094401-i9hhcid","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"5.其他：西洋参水提物(2g/ml)0.5ml/只灌胃，对小鼠切尾取血毛细管法试验有促进凝血作用。西洋参皂甙60mg/kg灌胃，对实验性瘀血大鼠，可降低血浆比粘度，增加红细胞膜流动性。西洋参总皂甙能抑制胶原诱导的大鼠血小板聚集，IC50为1.012mg/ml。"}]},{"ID":"20240607094401-3u0e1aa","Type":"NodeParagraph","Properties":{"id":"20240607094401-3u0e1aa","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094401-9rmjqlj","Type":"NodeParagraph","Properties":{"id":"20240607094401-9rmjqlj","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 原药去芦，用清水喷潮，覆盖湿布，润透，夏秋润2天，冬春润3天，取出切薄片，干燥或用时捣碎。"}]},{"ID":"20240902174338-pu0jlpd","Type":"NodeThematicBreak","Properties":{"id":"20240902174338-pu0jlpd"}},{"ID":"20240902174339-f3u9kmd","Type":"NodeParagraph","Properties":{"id":"20240902174339-f3u9kmd"}},{"ID":"20240607094401-ganndth","Type":"NodeParagraph","Properties":{"id":"20240607094401-ganndth","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607094401-bn03f37","Type":"NodeParagraph","Properties":{"id":"20240607094401-bn03f37","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末2g，加已醚30ml，水浴上回流1h，弃去已醚液，残潭用70%已醇20ml回流提取1h，提取液蒸去已醇，加水适量溶解，水浴液移至分液漏斗，用水饱和的正丁醇萃取3次，合并正丁醇萃取液，浓缩至干，以甲醇溶解成每毫升相当于1g生药的供试品溶液。另取人参皂甙Rb1和人参皂甙Rg1，以甲醇溶解成每1ml各2mg的对照深液，再取上述两种溶液各1μ，点于同一硅胶H板上，以氯仿-已酸已酯-甲醇-水（15：14：22：10）下层液展开，展距12-14cm，取出晾干，喷以10%硫酸已醇液，110℃烘烤数分钟，供试品色谱中在与对照品色谱相应的位置上显相同的紫色斑马点。"}]},{"ID":"20240607094401-7i5hqtu","Type":"NodeParagraph","Properties":{"id":"20240607094401-7i5hqtu","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094401-oi2am43","Type":"NodeParagraph","Properties":{"id":"20240607094401-oi2am43","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 归肺；胃；心；肾经"}]},{"ID":"20240607094401-ufiytpu","Type":"NodeParagraph","Properties":{"id":"20240607094401-ufiytpu","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094401-6rims1k","Type":"NodeParagraph","Properties":{"id":"20240607094401-6rims1k","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 味甘；微苦；性寒"}]},{"ID":"20240607094401-nuqazid","Type":"NodeParagraph","Properties":{"id":"20240607094401-nuqazid","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094401-pikfdxe","Type":"NodeParagraph","Properties":{"id":"20240607094401-pikfdxe","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 中阳衰微，胃有寒湿者忌服。"}]},{"ID":"20240607094401-7bjfdwp","Type":"NodeParagraph","Properties":{"id":"20240607094401-7bjfdwp","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"1.《本草从新》：脏寒者服之，即作腹痛，郁火服之，火不透发，反生寒热。"}]},{"ID":"20240607094401-9l3ppky","Type":"NodeParagraph","Properties":{"id":"20240607094401-9l3ppky","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"2.《纲目拾遗》：忌铁器及火炒。不宜与藜芦同用。"}]},{"ID":"20240607094401-2cq2ptv","Type":"NodeParagraph","Properties":{"id":"20240607094401-2cq2ptv","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094401-bpxjump","Type":"NodeParagraph","Properties":{"id":"20240607094401-bpxjump","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 补气养阴；清火生津。主气虚阴专火旺，咳嗽痰血，虚热烦烦倦，内热消渴，口燥烟干"}]},{"ID":"20240607094401-qb12lh0","Type":"NodeParagraph","Properties":{"id":"20240607094401-qb12lh0","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094401-4xs3vlk","Type":"NodeParagraph","Properties":{"id":"20240607094401-4xs3vlk","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g；或入丸、散。"}]},{"ID":"20240607094401-r4xrl2c","Type":"NodeParagraph","Properties":{"id":"20240607094401-r4xrl2c","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607094401-g9yikt5","Type":"NodeParagraph","Properties":{"id":"20240607094401-g9yikt5","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 1.《本草求原》：肺气本于肾，凡益肺气之药，多带微寒，但此则苦寒，唯火盛伤气，咳嗽痰血，劳伤失精者宜之。"}]},{"ID":"20240607094401-7z8glwj","Type":"NodeParagraph","Properties":{"id":"20240607094401-7z8glwj","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"2.《医学衷中参西录》：西洋参，性凉而补，凡欲用人参而不受人参之温补者，皆可以此代之。惟白虎加人参汤中之人参，仍宜用党参，而不可代以西洋参，以其不若党参具有升发之力，能助石膏逐邪外出也。且《本经》谓人参味甘，未尝言苦，适与党参之味相符，是以古之人参，即今之党参，若西洋参与高丽参，其味皆甘而兼苦，故用于古方不宜也。"}]},{"ID":"20240607094401-var8j75","Type":"NodeParagraph","Properties":{"id":"20240607094401-var8j75","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"3.《增订伪药条辨》：西参滋阴降火，东参提气助火，效用相反，凡是阴虚火旺，劳嗽之人，每用真西参，则气平火敛，咳嗽渐平，若用伪光参，则反现面赤舌红，干咳痰血，口燥气促诸危象焉。"}]},{"ID":"20240607094401-oc0gjt5","Type":"NodeParagraph","Properties":{"id":"20240607094401-oc0gjt5","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"4.《本草从新》：补肺降火，生津液，除烦倦。虚而有火者相宜。"}]},{"ID":"20240607094401-94spr25","Type":"NodeParagraph","Properties":{"id":"20240607094401-94spr25","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"5.《药性考》：补阴退热。姜制益气，扶正气。"}]},{"ID":"20240607094401-iz082ip","Type":"NodeParagraph","Properties":{"id":"20240607094401-iz082ip","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"6.《本草再新》：治肺火旺，咳嗽痰多，气虚呵喘，失血，劳伤，固精安神，生产诸虚。"}]},{"ID":"20240607094401-0ps6o7e","Type":"NodeParagraph","Properties":{"id":"20240607094401-0ps6o7e","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"7.《本草求原》：清肺肾，凉心脾以降火，消暑，解酒。"}]},{"ID":"20240607094401-fp27o8x","Type":"NodeParagraph","Properties":{"id":"20240607094401-fp27o8x","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"8.《医学衷中参西录》：能补助气分，并能补益血分。"}]},{"ID":"20240607094401-pyi4rlf","Type":"NodeParagraph","Properties":{"id":"20240607094401-pyi4rlf","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094401-tlh5kzj","Type":"NodeParagraph","Properties":{"id":"20240607094401-tlh5kzj","updated":"20240902174348"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607094401-7iezpel","Type":"NodeThematicBreak","Properties":{"id":"20240607094401-7iezpel","updated":"20240902174348"}},{"ID":"20240607094401-wfo358o","Type":"NodeParagraph","Properties":{"id":"20240607094401-wfo358o","updated":"20240902174348"}}]}