{"ID":"20240620082556-c1wsixd","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240620082556-c1wsixd","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240620082556-c1wsixd\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620082605-3my8oap\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240620082606-pj0u6bh\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240620082606-pj0u6bh\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"鹅不食草（石胡荽、通鼻草）","type":"doc","updated":"20240903093518"},"Children":[{"ID":"20240730171757-59b8t57","Type":"NodeParagraph","Properties":{"id":"20240730171757-59b8t57","updated":"20240730171819"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 8-20240730171757-jtw65h8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 626px;","style":"width: 616px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 9-20240730171819-n7a26fj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 616px;\" parent-style=\"width: 626px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620082605-3my8oap","Type":"NodeParagraph","Properties":{"id":"20240620082605-3my8oap","updated":"20240730172523"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":