t-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730171031-xhwoyyt","Type":"NodeParagraph","Properties":{"id":"20240730171031-xhwoyyt","updated":"20240730171420"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 579px;","style":"width: 569px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 4-20240730171420-5nfcl22.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 569px;\" parent-style=\"width: 579px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 667px;","style":"width: 657px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 1-20240730171031-pwipu4y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 657px;\" parent-style=\"width: 667px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730171501-rswz238","Type":"NodeParagraph","Properties":{"id":"20240730171501-rswz238","updated":"20240730171608"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 662px;","style":"width: 652px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 5-20240730171501-u59a6cf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 652px;\" parent-style=\"width: 662px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 6-20240730171608-3icjc2k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730171659-jqahy3z","Type":"NodeParagraph","Properties":{"id":"20240730171659-jqahy3z","updated":"20240730171659"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 765px;","style":"width: 755px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 7-20240730171651-gvbqh75.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 755px;\" parent-style=\"width: 765px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240730171341-wlbauo1","Type":"NodeParagraph","Properties":{"id":"20240730171341-wlbauo1","updated":"20240730171341"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 763px;","style":"width: 753px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹅不食草 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹅不食草 3-20240730171341-q8j6etc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 753px;\" parent-style=\"width: 763px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240730171217-xt3t8hz","Type":"NodeThematicBreak","Properties":{"id":"20240730171217-xt3t8hz"}},{"ID":"20240903093510-2tz68q5","Type":"NodeParagraph","Properties":{"id":"20240903093510-2tz68q5","updated":"20240903093518"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：鹅不食草"}]},{"ID":"20240903093510-3qi43g8","Type":"NodeParagraph","Properties":{"id":"20240903093510-3qi43g8","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"鹅不食草《中国药典》"}]},{"ID":"20240903093510-360sz0q","Type":"NodeParagraph","Properties":{"id":"20240903093510-360sz0q","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【拼音名】éBùShíCǎo"}]},{"ID":"20240903093510-wom1l8z","Type":"NodeParagraph","Properties":{"id":"20240903093510-wom1l8z","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【英文名】HERBACENTIPEDAE"}]},{"ID":"20240903093510-ko48qxy","Type":"NodeParagraph","Properties":{"id":"20240903093510-ko48qxy","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【别名】球子草、石胡蒌、地胡椒、三牙戟"}]},{"ID":"20240903093510-oz41v54","Type":"NodeParagraph","Properties":{"id":"20240903093510-oz41v54","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【来源】本品为菊科植物鹅不食草Centipedaminima（L.）A.Br.etAschers.的干燥全草。夏、秋二季花开时采收，洗去泥沙，晒干。"}]},{"ID":"20240903093510-ane7hjx","Type":"NodeParagraph","Properties":{"id":"20240903093510-ane7hjx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性状】本品缠结成团。须根纤细，淡黄色。茎细，多分枝；质脆，易折断，断面黄白色。叶小，近无柄；叶片多皱缩、破碎，完整者展平后呈匙形，表面灰绿色或棕褐色，边缘有3～5个锯齿。头状花序黄色或黄褐色。气微香，久嗅有刺激感，味苦、微辛。"}]},{"ID":"20240903093510-svga4sx","Type":"NodeParagraph","Properties":{"id":"20240903093510-svga4sx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末灰绿色至灰棕色。茎表皮细胞呈长方形或类多角形，壁稍厚，表面隐约可见角质纹理；具气孔。叶表皮细胞呈类多角形，垂周壁薄，波状弯曲；气孔不定式，副卫细胞4～6个。腺毛顶面观呈鞋底形，细胞成对排列，内含黄色物。花冠表皮细胞黄色，表面观呈长方形或类多角形，细胞向外延伸呈绒毛状突起，表面有角质纹理。非腺毛着生于花冠表皮，2列性；1列为单细胞，稍短，另列为2细胞，基部细胞较短，先端常呈钩状或卷曲，上部2/3表面有微细角质纹理。花粉粒淡黄色，呈类圆形，直径15～22μm，具3孔沟，表面有刺。"}]},{"ID":"20240903093510-xz8tat5","Type":"NodeParagraph","Properties":{"id":"20240903093510-xz8tat5","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【炮制】除去杂质，切段，干燥。"}]},{"ID":"20240903093510-itzh5sf","Type":"NodeParagraph","Properties":{"id":"20240903093510-itzh5sf","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240903093510-x6t423u","Type":"NodeParagraph","Properties":{"id":"20240903093510-x6t423u","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【归经】归肺、肝经。"}]},{"ID":"20240903093510-39vpoly","Type":"NodeParagraph","Properties":{"id":"20240903093510-39vpoly","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【功能主治】通鼻窍，止咳，用于风寒头痛，咳嗽痰多，鼻塞不通，鼻渊流涕。"}]},{"ID":"20240903093510-033qn8f","Type":"NodeParagraph","Properties":{"id":"20240903093510-033qn8f","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【用法用量】6～9g。外用适量。"}]},{"ID":"20240903093510-wwqidsw","Type":"NodeParagraph","Properties":{"id":"20240903093510-wwqidsw","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【贮藏】置通风干燥处。"}]},{"ID":"20240903093510-kqi4am8","Type":"NodeParagraph","Properties":{"id":"20240903093510-kqi4am8","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240903093510-5hhqdpm","Type":"NodeParagraph","Properties":{"id":"20240903093510-5hhqdpm","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"鹅不食草《*辞典》"}]},{"ID":"20240903093510-wt1p6k6","Type":"NodeParagraph","Properties":{"id":"20240903093510-wt1p6k6","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【出处】《食性本草》"}]},{"ID":"20240903093510-x8btgws","Type":"NodeParagraph","Properties":{"id":"20240903093510-x8btgws","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【拼音名】éBùShíCǎo"}]},{"ID":"20240903093510-xtem6jm","Type":"NodeParagraph","Properties":{"id":"20240903093510-xtem6jm","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【别名】食胡荽（《品汇精要》），野园荽（《濒湖集简方》），鸡肠草（《纲目》），鹅不食（《生草药性备要》），地芫荽（《医林纂要》），满天星、沙飞草、地胡椒、大救驾（《简易草药》），三节剑（《分类草药性》），山胡椒、连地稗（《岭南采药录》），球子草（《广州植物志》），二郎戟、小救驾（《贵州民间方药集》），杜网草、猪屎草（《福建民间草药》），砂药草（《江苏植药志》），白地茜（《南宁市药物志》），猪屎潺（《广西中药志》），通天窍（《四川中药志》），雾水沙、猫沙、小拳头（《广东中药》），铁拳头、散星草、地杨梅、三"}]},{"ID":"20240903093510-jv9q2ik","Type":"NodeParagraph","Properties":{"id":"20240903093510-jv9q2ik","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【来源】为菊科植物石胡荽的带花全草。花开放时采收，去净泥杂，晒干。"}]},{"ID":"20240903093510-p8kg2yw","Type":"NodeParagraph","Properties":{"id":"20240903093510-p8kg2yw","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240903093510-u1hf89r","Type":"NodeParagraph","Properties":{"id":"20240903093510-u1hf89r","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"石胡荽（《四声本草》）"}]},{"ID":"20240903093510-nxmz9ae","Type":"NodeParagraph","Properties":{"id":"20240903093510-nxmz9ae","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"一年生匍匐状柔软草本。枝多广展，高8～20厘米，近秃净或稍被绵毛。叶互生；叶片小，匙形，长7～20毫米，宽3～5毫米，先端钝，基部楔形，边缘有疏齿。头状花序无柄，直径3～4毫米，腋生；总苞片约2列，边缘膜质；花托平坦或稍隆起；花杂性，淡黄色或黄绿色，管状；雌花位于头状花序的外围，多列，花冠短；两性花，数朵，位于头状花序的中央，花冠钟状，顶端4裂；雄蕊4，围绕花柱四周，花药短，基部钝形；花柱裂片短，钝或截头形。瘦果四棱形，棱上有毛，无冠毛。花期9～11月。"}]},{"ID":"20240903093510-q2d11sh","Type":"NodeParagraph","Properties":{"id":"20240903093510-q2d11sh","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于稻田或阴湿处、路旁。分布黑龙江、吉林、辽宁、河北、河南、山东、湖南、湖北、江苏、浙江、安徽、江西、四川、贵州、福建、台湾、广东、广西等地。主产浙江、湖北、江苏、广东等地。此外，广西、河南、江西、福建、安徽等地亦产。"}]},{"ID":"20240903093510-akflee5","Type":"NodeParagraph","Properties":{"id":"20240903093510-akflee5","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的全草，相互缠成团，灰绿色或棕褐色。茎细而多分枝，颜色较深，质脆易断，断面黄白色，中央有白色的髓或日形成空洞。叶小，多皱折、破碎不全，完整的叶片呈匙形，边缘有3～5个锯齿，叶脉不明显，质极脆，易碎落。头状花序小，球形，黄色或黄褐色。微有香气，久嗅有刺激性，味苦、微辛。以灰绿色、有花序、无杂质、嗅之打喷嚏者为佳。"}]},{"ID":"20240903093510-e8ofaag","Type":"NodeParagraph","Properties":{"id":"20240903093510-e8ofaag","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草中含多种三萜成分、蒲公英赛醇、蒲公英甾醇、山金车烯二醇及另一种未知的三萜二醇尚含有豆甾醇、谷甾醇、黄酮类、挥发油、有机酸等。"}]},{"ID":"20240903093510-ptem589","Type":"NodeParagraph","Properties":{"id":"20240903093510-ptem589","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【药理作用】挥发油和乙醇提取液体部分有某些止咳、祛痰、平喘作用，沉淀部分止咳效果不明显，无祛痰作用。煎剂25～50％在马铃薯鸡蛋固体培养基内对结核杆菌有某些抑制作用。"}]},{"ID":"20240903093510-cscyx63","Type":"NodeParagraph","Properties":{"id":"20240903093510-cscyx63","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，切段，晒干。"}]},{"ID":"20240903093510-clz6m25","Type":"NodeParagraph","Properties":{"id":"20240903093510-clz6m25","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903093510-it0tuak","Type":"NodeParagraph","Properties":{"id":"20240903093510-it0tuak","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"辛，温。"}]},{"ID":"20240903093510-vsv04yk","Type":"NodeParagraph","Properties":{"id":"20240903093510-vsv04yk","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"①《履巉岩本草》：\"温，无毒。\""}]},{"ID":"20240903093510-i6bgeba","Type":"NodeParagraph","Properties":{"id":"20240903093510-i6bgeba","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"辛苦。温。\""}]},{"ID":"20240903093510-0g93xpl","Type":"NodeParagraph","Properties":{"id":"20240903093510-0g93xpl","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【归经】《得配本草》：\"入手太阴经气分。\""}]},{"ID":"20240903093510-xcuh7vu","Type":"NodeParagraph","Properties":{"id":"20240903093510-xcuh7vu","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903093510-r6j0bka","Type":"NodeParagraph","Properties":{"id":"20240903093510-r6j0bka","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"祛风，散寒，胜湿，去翳，通鼻塞。治感冒，寒哮，喉痹，百日咳，痧气腹痛，阿米巴痢，疟疾，疳泻，鼻渊，鼻息肉，目翳涩痒，臁疮，疥癣，跌打。"}]},{"ID":"20240903093510-9oz63t5","Type":"NodeParagraph","Properties":{"id":"20240903093510-9oz63t5","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"去目翳，按塞鼻中，翳膜自落。\""}]},{"ID":"20240903093510-7wpncwc","Type":"NodeParagraph","Properties":{"id":"20240903093510-7wpncwc","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"②《四声本草》：\"通鼻气，利九窍，吐风痰。\""}]},{"ID":"20240903093510-b87g9p3","Type":"NodeParagraph","Properties":{"id":"20240903093510-b87g9p3","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"解毒，明目，散目赤肿、云翳，耳聋，头痛脑酸，治痰疟齁蛤，鼻塞不通，塞鼻息自落，又散疮肿。\""}]},{"ID":"20240903093510-rennupv","Type":"NodeParagraph","Properties":{"id":"20240903093510-rennupv","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"④《生草药性备要》：\"理跌打折骨，上痛消肿。\""}]},{"ID":"20240903093510-kc2ecru","Type":"NodeParagraph","Properties":{"id":"20240903093510-kc2ecru","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"通郁，去寒，截疟，止痢。以于末搐鼻，可发嚏去寒郁。\""}]},{"ID":"20240903093510-0bp9957","Type":"NodeParagraph","Properties":{"id":"20240903093510-0bp9957","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑥《植物名实图考》：\"治痧症。\""}]},{"ID":"20240903093510-jnwqn1m","Type":"NodeParagraph","Properties":{"id":"20240903093510-jnwqn1m","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑦《广西药植图志》：\"治疳积。\""}]},{"ID":"20240903093510-q9zydel","Type":"NodeParagraph","Properties":{"id":"20240903093510-q9zydel","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑧《广西中药物》：\"治喉毒。\""}]},{"ID":"20240903093510-cpavztq","Type":"NodeParagraph","Properties":{"id":"20240903093510-cpavztq","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑨《广东中药》Ⅱ：\"治百日咳。\""}]},{"ID":"20240903093510-xljomi4","Type":"NodeParagraph","Properties":{"id":"20240903093510-xljomi4","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑩广州部队《常用中草药手册》：\"治风湿性腰腿痛。\""}]},{"ID":"20240903093510-e3xpwo8","Type":"NodeParagraph","Properties":{"id":"20240903093510-e3xpwo8","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱；或捣汁。外用：捣烂塞鼻、研末搐鼻或捣敷。"}]},{"ID":"20240903093510-pg8skqt","Type":"NodeParagraph","Properties":{"id":"20240903093510-pg8skqt","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903093510-s6sse0t","Type":"NodeParagraph","Properties":{"id":"20240903093510-s6sse0t","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"①治伤风头痛、鼻塞，目翳：鹅不食草（鲜或干均可）搓揉，嗅其气，即打喷嚏，每日二次。（《贵阳民间药草》）"}]},{"ID":"20240903093510-kqyrk5r","Type":"NodeParagraph","Properties":{"id":"20240903093510-kqyrk5r","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"②治寒痰齁喘：野园荽研汁和酒服。（《濒湖集简方》）"}]},{"ID":"20240903093510-ops6bcq","Type":"NodeParagraph","Properties":{"id":"20240903093510-ops6bcq","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"③治脑漏：鲜石胡荽捣烂，塞鼻孔内。（《浙江民间草药》）"}]},{"ID":"20240903093510-njt8jn1","Type":"NodeParagraph","Properties":{"id":"20240903093510-njt8jn1","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"④治单双喉蛾：鹅不食草一两，槽米一两。将鹅不食草捣烂，取汁浸糯米磨浆，给患者徐徐含咽。（《广西民间常用草药》）"}]},{"ID":"20240903093510-p9gvu9c","Type":"NodeParagraph","Properties":{"id":"20240903093510-p9gvu9c","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑤治目病肿胀红赤，昏暗羞明，隐涩疼痛。风痒，鼻塞，头痛，脑酸，外翳攀睛，眵泪稠粘：鹅不食草二钱，青黛一钱，川芎一钱。为细末，先噙水满口，每用米许搐入鼻内，以泪出为度。不拘时候。（《原机启微》搐鼻碧云散）"}]},{"ID":"20240903093510-0t8wc56","Type":"NodeParagraph","Properties":{"id":"20240903093510-0t8wc56","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑥治胬肉攀睛：鲜鹅不食草二两：捣烂，取汁煮沸澄清，加梅片一分调匀，点入眼内。（《广西民间常用草药》）"}]},{"ID":"20240903093510-dq5x10t","Type":"NodeParagraph","Properties":{"id":"20240903093510-dq5x10t","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑦治脾寒疟疾：石胡荽一把，杵汁半碗，入酒半碗，和服。（《濒湖集简方》）"}]},{"ID":"20240903093510-qcvu4ho","Type":"NodeParagraph","Properties":{"id":"20240903093510-qcvu4ho","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑧治间日疟及三日疟：鲜鹅不食草，捻成团，填鼻内，初感有喷嚏，宜稍忍耐，过一夜，效。（《现代实用中药》）"}]},{"ID":"20240903093510-n00gx1f","Type":"NodeParagraph","Properties":{"id":"20240903093510-n00gx1f","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑨治阿米巴痢疾：石胡荽、乌韭根各五钱。水煎服，每日一剂；血多者加仙鹤草五钱。（《江西草药》）"}]},{"ID":"20240903093510-eaz5s6f","Type":"NodeParagraph","Properties":{"id":"20240903093510-eaz5s6f","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑩治疳积腹泻：鲜石胡荽三钱。水煎服。（《湖南药物志》）"}]},{"ID":"20240903093510-18jwwqw","Type":"NodeParagraph","Properties":{"id":"20240903093510-18jwwqw","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑾治痧症腹痛：球子草花序捣碎，以鼻闻之。使打嚏。（《浙江民间草药》）"}]},{"ID":"20240903093510-z78gxzk","Type":"NodeParagraph","Properties":{"id":"20240903093510-z78gxzk","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⑿治湿毒胫疮：野园荽（夏月采取，晒干为末）每以五钱，汞粉五分，桐油调作隔纸膏，周围缝定，以茶洗净，缚上膏药，黄水出。（《简便单方》）"}]},{"ID":"20240903093510-abi5ep0","Type":"NodeParagraph","Properties":{"id":"20240903093510-abi5ep0","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒀治肿毒：野园荽一把，穿山甲（烧存性）七分，当归尾三钱。捣烂入酒一碗，绞汁服，以渣敷之。（《濒濒湖集简方》）"}]},{"ID":"20240903093510-kxm76kq","Type":"NodeParagraph","Properties":{"id":"20240903093510-kxm76kq","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒁治痔疮肿痛：石胡荽捣贴之。（《濒湖集简方》）"}]},{"ID":"20240903093510-0frlw2v","Type":"NodeParagraph","Properties":{"id":"20240903093510-0frlw2v","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒂治牛皮癣：鹅不食草捣涂。（《贵阳民间药草》）"}]},{"ID":"20240903093510-ez88isg","Type":"NodeParagraph","Properties":{"id":"20240903093510-ez88isg","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒃治蛇伤：鲜石胡荽捣烂，外敷伤部。（《泉州本草》）"}]},{"ID":"20240903093510-4lktygs","Type":"NodeParagraph","Properties":{"id":"20240903093510-4lktygs","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒄治跌打肿痛：鹅不食草适量，捣烂，炒热，敷患处。（《广西民间常用草药》）"}]},{"ID":"20240903093510-91ev0r5","Type":"NodeParagraph","Properties":{"id":"20240903093510-91ev0r5","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"⒅治鸡眼：先将鸡眼厚皮削平，用鲜石胡荽捣烂包敷患处，三至五天取下。（《浙江民间常用草药》）"}]},{"ID":"20240903093510-32gs7nx","Type":"NodeParagraph","Properties":{"id":"20240903093510-32gs7nx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903093510-bk302zt","Type":"NodeParagraph","Properties":{"id":"20240903093510-bk302zt","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"鹅不食草，上达头脑，而治顶痛目病，通鼻气而落息肉；内达肺经而治齁蛤、痰疟，散疮肿；其除翳之功，尤显神妙。按倪惟德《原机启微集》云：治目翳搐鼻，碧云散用鹅不食草解毒为君，青黛去热为佐，川芎之辛破留除邪为使，升透之药也，大抵如开锅盖法，常欲邪毒不闭，令有出路。然力小而锐，宜常嗜以聚其力，凡目中诸病，皆可用之，生挼更神。\""}]},{"ID":"20240903093510-dj66fut","Type":"NodeParagraph","Properties":{"id":"20240903093510-dj66fut","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"石胡荽，利九窍，通鼻气之药也。其味辛烈，其气辛熏，其性升散，能通肺经，上达头脑，故主齁蛤痰喘，气闭不通，鼻塞鼻痔，胀闷不利，去目中翳障，并头中寒邪、头风脑痛诸疾，皆取辛温升散之功也。\""}]},{"ID":"20240903093510-o3yfklz","Type":"NodeParagraph","Properties":{"id":"20240903093510-o3yfklz","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903093510-8d5l487","Type":"NodeParagraph","Properties":{"id":"20240903093510-8d5l487","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"①治疗疟疾"}]},{"ID":"20240903093510-7utmnxe","Type":"NodeParagraph","Properties":{"id":"20240903093510-7utmnxe","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"将石胡荽制成注射剂（每毫升含生药2克），在发作前2小时注射1次，连用3月。每次剂置：1～3岁2毫升，4～8岁3毫升，9～14岁4毫升，15岁以上5毫升。观察各型疟疾现症病人187例，经1～3次用药，痊愈175例（93.6％）。与氯喹、伯喹对照组相比，疗效无显着差别。治疗中有3例注射后发生恶心和轻度呕吐，停药后自行消失。"}]},{"ID":"20240903093510-mc0m1hj","Type":"NodeParagraph","Properties":{"id":"20240903093510-mc0m1hj","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"②治疗百日咳"}]},{"ID":"20240903093510-w5t799z","Type":"NodeParagraph","Properties":{"id":"20240903093510-w5t799z","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"据300余例的观察，治愈率一般在90％左右。大都在用药后24小时内典型痉咳开始减轻。治愈时间，短者3～6天，长者10～15天。制剂及剂量：㈠取鲜品5两，制成煎液500毫升，再加入等量糖浆。按患儿年龄大小，每日用20～40毫升，4次分服。㈡取鲜生药1斤，制成煎液500毫升，再加入糖浆至1000毫升。1～4岁3～10毫升，5～8岁11～20毫升。每日3次。㈢取全草1500克，制成蒸馏液500毫升，再和入等量糖浆。1～5岁5～10毫升，5岁以上15毫升，日服3～4次"}]},{"ID":"20240903093510-em0ydaf","Type":"NodeParagraph","Properties":{"id":"20240903093510-em0ydaf","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"③治疗软组织损伤"}]},{"ID":"20240903093510-e1bi4gq","Type":"NodeParagraph","Properties":{"id":"20240903093510-e1bi4gq","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"将鹅不食草研成粉末，成人每次用2～3钱（小儿减半），以黄酒6～8两（不饮酒者用酒水各半）、红糖1～2两同煮（沸后密盖勿令泄气），过滤后温服；药渣趁热敷于患部。亦可用粉剂每日3～6克，或以鲜草1～2两捣汁，分3次以温酒冲服。治疗胸、背、腰部等软组织损伤（包括跌伤、打伤、挫伤、扭伤等），均有效。据数十例观察，大多于用药后1～2天痊愈。除胃痛患者服酒煮剂后间有疼痛外，一般无副作用。亦有将鲜石胡荽制成注射剂（每1500克鲜药制成500毫升）作穴位注射，治疗关节扭伤、腰肌劳损、风湿疼痛等症，观察94例，痊愈31例，好转60例。有效率达97％。用法：于痛点或循经取穴注射，每次0.2～0.5毫升，隔日1次，一般3～5次为一疗程。"}]},{"ID":"20240903093510-wqkd534","Type":"NodeParagraph","Properties":{"id":"20240903093510-wqkd534","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"④治疗鼻炎"}]},{"ID":"20240903093510-s02mdo6","Type":"NodeParagraph","Properties":{"id":"20240903093510-s02mdo6","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"包括急性鼻炎、慢性单纯性鼻炎、肥厚性鼻炎、变态反应性鼻炎等。大多数病例用药后头痛、鼻塞等症状消失或减轻。用法：将鹅不食草研成细粉吸入鼻孔，每日数次；或用棉花浸湿拧干后，包药粉少许，卷成细条塞鼻，20～30分钟后取出，每日1次；或制成油膏纱条，放置鼻腔内，1小时后取出。用药后除初起有喷嚏、流泪与流鼻涕外，余无不良反应。"}]},{"ID":"20240903093510-o55dri3","Type":"NodeParagraph","Properties":{"id":"20240903093510-o55dri3","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903093510-rvopxi2","Type":"NodeParagraph","Properties":{"id":"20240903093510-rvopxi2","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"鹅不食草《中华本草》"}]},{"ID":"20240903093510-t8n7bpe","Type":"NodeParagraph","Properties":{"id":"20240903093510-t8n7bpe","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【出处】"}]},{"ID":"20240903093510-u8gcznf","Type":"NodeParagraph","Properties":{"id":"20240903093510-u8gcznf","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"出自《食性本草》。"}]},{"ID":"20240903093510-50yjytl","Type":"NodeParagraph","Properties":{"id":"20240903093510-50yjytl","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"1.《品汇精要》：食胡荽，春生苗叶，茎圆而中空，折之有白汁。节间生叶，青绿色。其花细白，至夏作丛而开，子叶与胡荽无异。此草鹅皆不食，故名鹅不食草。"}]},{"ID":"20240903093510-5yebnw0","Type":"NodeParagraph","Properties":{"id":"20240903093510-5yebnw0","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：石胡荽，生石缝及阴湿处，小草也。高二、三寸，冬月生苗，细茎小叶，形状宛如嫩胡荽，其气辛熏不堪食，鹅亦不食之。夏开细花，黄色，结细子，极易繁衍，僻地则铺满也。"}]},{"ID":"20240903093510-ts6p6pu","Type":"NodeParagraph","Properties":{"id":"20240903093510-ts6p6pu","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【拼音名】éBùShíCǎo"}]},{"ID":"20240903093510-oiweuak","Type":"NodeParagraph","Properties":{"id":"20240903093510-oiweuak","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【英文名】SmallCentipedaHerb"}]},{"ID":"20240903093510-iy0x92d","Type":"NodeParagraph","Properties":{"id":"20240903093510-iy0x92d","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【别名】食胡荽、野园荽、鸡肠草、鹅不食、地芫荽、满天星、沙飞草、地胡椒、大救驾、三节剑、山胡椒、连地稗、球子草、二郎戟、小救驾、杜网草、猪屎草、砂药草、白地茜、猪屎潺、通天窍、雾水沙、猫沙、小拳头、铁拳头、散星草、地杨梅、三牙钻、蚊子草、白珠子草、二郎剑"}]},{"ID":"20240903093510-xdi62tc","Type":"NodeParagraph","Properties":{"id":"20240903093510-xdi62tc","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903093510-a3x7fen","Type":"NodeParagraph","Properties":{"id":"20240903093510-a3x7fen","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"药材基源：为菊科植物石胡荽的全草。"}]},{"ID":"20240903093510-xzlt9mn","Type":"NodeParagraph","Properties":{"id":"20240903093510-xzlt9mn","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Centipedaminima(L.)A.Br.EtAscher."}]},{"ID":"20240903093510-diifzpw","Type":"NodeParagraph","Properties":{"id":"20240903093510-diifzpw","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-11月花开时采收，鲜用或晒干。"}]},{"ID":"20240903093510-hhr9k0r","Type":"NodeParagraph","Properties":{"id":"20240903093510-hhr9k0r","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【原形态】石胡荽一年生小草本，高5-20cm。茎纤细，多分枝，基部匍匐，着地后易生根，无毛或略具细绵毛。叶互生；无柄；叶片楔状倒披针形，长7-20mm，宽3-5mm，先端钝，边缘不规则的疏齿，无毛，或下面稍有细毛。头状花序细小，扁球形，直径约3mm，单生于叶腋，无总花梗或近于无总花梗；总苞半球形；总苞片2层，椭圆状披针形，绿色，边缘膜质，外层较内层大；花托平坦，无托片；花杂性，淡黄色或黄绿色，全为筒状；外围雌花多层，花冠细，有不明显的裂片；中央的两性花，花冠明显4裂。瘦果椭圆形，长约1mm，具4棱，边缘有长毛；无冠毛。花期9-11月。"}]},{"ID":"20240903093510-usokg0c","Type":"NodeParagraph","Properties":{"id":"20240903093510-usokg0c","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903093510-7y79bhn","Type":"NodeParagraph","Properties":{"id":"20240903093510-7y79bhn","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"生态环境：生于路旁芒野、田埂及阴湿草地上。"}]},{"ID":"20240903093510-vpi37ga","Type":"NodeParagraph","Properties":{"id":"20240903093510-vpi37ga","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华中、华工、华南、西南。"}]},{"ID":"20240903093510-thvy1pk","Type":"NodeParagraph","Properties":{"id":"20240903093510-thvy1pk","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240903093510-cazo4uf","Type":"NodeParagraph","Properties":{"id":"20240903093510-cazo4uf","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"性状鉴别全草扭集成团。须根纤细，淡黄色；茎细，多分枝，质脆，易折断，断面黄白色。叶小，近无柄；叶片多皱缩或破碎，完整者展平后呈匙形，表面灰绿色或棕褐色，边缘有3-5个齿。头状花序黄色或黄褐色。气微午，久闻有刺激感，味苦；微辛。"}]},{"ID":"20240903093510-6vuehet","Type":"NodeParagraph","Properties":{"id":"20240903093510-6vuehet","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"以色灰绿、刺激性气强者为佳。"}]},{"ID":"20240903093510-y11ax9z","Type":"NodeParagraph","Properties":{"id":"20240903093510-y11ax9z","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"显微鉴别叶横切面：上表皮细胞略切微延长。栅状组织1列；海棉组织细胞类圆形。下表皮腺毛较多，并有非腺毛，由4-6个细胞组成，长560-750μm，基部细胞直径40-60μm，向上逐渐变小，顶端细胞窄细胞窄细，扭曲成革命状四表皮表面观：壁径约20μm，气孔不定式。"}]},{"ID":"20240903093510-crdh2gt","Type":"NodeParagraph","Properties":{"id":"20240903093510-crdh2gt","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"茎横切面：表皮细胞1列，类方形或略切向延长，壁略厚，外覆角质层。皮层细胞5-8列，细胞间隙较大。韧皮部外侧有纤维4-15个成束，弱木化，直径8-16μm，壁厚3-4μm。木质部导管数列，径向排列，木化。射线弱木化。中央有大型有髓部。"}]},{"ID":"20240903093510-ee06cms","Type":"NodeParagraph","Properties":{"id":"20240903093510-ee06cms","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【化学成份】全草含棕榈酸蒲公英甾醇酯（taraxasterylpalmitate），乙酸蒲公英甾醇酯（taraxasterylacetate），蒲公英甾醇（taraxasterol），豆甾醇（stigmasterol），山金车二醇（arnodiol）[1]，谷甾醇（sitosterol），十九酸三十四醇酯（tetratriacontanylnonade-caoate），2-异丙基-5-甲基氢酯-4-O-β-D-吡喃木糖甙（2-isopropyl-5-methylhydroquinone-4-O-β-D-xylopyranoside)，2α，3β，19α，23-四羟基-12-乌苏烯-28-O-β-D-吡喃木糖甙（2α，3β，19α，23-te-trahydroxyurs-12-ene-28-oicacid-28-O-β-D-吡喃木糖甙（2α，21β，22α28-tetrahydroxyolean-12-ene-28-O-β-D-xylopyranoside），3β，16α，21β，22α，28-五羟基-12-齐墩果烯-28-O-β-D-吡喃木糖甙（3β，16α，21β，22α，28-pentahydroxyolean-12-ene-28-O-β-D-xy-lopyranoside），3，3′，5，5′-四甲氧基芪（3，3′，5，5′-tetram-ethoxystibene）[2]，1α，3β，19α，23-四羟基-12-乌苏烯-28-酸-28-O-β-D-吡喃木糖甙（1α，3β，19α，23-tetrahydroxyurs-12-ene-28-oicacid-28-O-β-D-xylopyranoside），1β，2α，19α，23-五羟基-12乌苏烯-28-酸-28-O-β-D-吡喃木糖甙（1β，2α，3β，19α，23-pentahydroxyurs-12-ene-28-licacid-28-O-β-D-xylopyranoside），3α，21α，22α，28四羟基-12-齐墩果类-28-O-β-D-吡喃木糖甙（3α，21α，22α，28-te-trahydroxyolean-12-ene-28-O-β-D-吡喃木糖甙（3α21α，22α，28-te-trahydroxyolean-12-ene-28-O-β-D-xylopyranoside），3α，16α，21α，22α，28-五羟基-12-齐墩果烯-28-O-β-D-吡喃木糖甙（3α，16α，21α，22α，28-pentahydroxyolean-12-ene-28-O-β-D-xylopyrano-side）[3]，6-羟基-反-8-二十六碳-烯3-酮（6-hydroxyhexacos-trans-8-ene-3-one），3，5，4-三甲氧基-反-芪（3，5，4′-trimethoxy-trans-stilbene），3α，21β，22α，28-四羟基-12-齐墩果烯-28-O-β-D-吡喃木糖甙3α，21β，22α，28-五羟基-12-齐墩果烯-（28-O-β-D-xylopyranoside）[4]，川陈皮素（nobiletin）[5]，羽扇豆醇（lupeol），二十六醇（hexacosanol）[6]，乙酸羽扇豆酯（lupeylacetate），10-异丁酰氧基-8，9-环氧百里香酚异丁酰氧基-8-羟基百里香酚（9，10-diisobutyryloxy-8-hydroxythymol），知叶老灌草素（brevifolin），堆心菊灵（helenalin），异丁酸堆心菊灵内酯（flo-rilenalinisobutyrate）[7]，异丁酰二氢堆心菊灵（isobutyroylplenolin），千里光酰二氢堆心菊灵（senecoylplenolin），四氢堆心菊灵（tetrahydrohelenalin），α-莎草酮（α-cyperone），槲皮素-3，7，3-三甲酯（quercetin-3，7，3-trimethylether），槲皮素-3，7，3，4-四甲酯（quercetin-3，7，3，4-tetramethyl-ether）[8]，槲皮素-3-甲酯（quercetin-3-methyl-ether），槲皮素-3，3-二甲酯（quercetin-3，3-dimethylether），芹菜素（apigenin），咸南藤酰胺乙酸酯（aurantiamideacetate）[8，9]，6-O-千里光酰二氢菊灵（6-O-senecoylplenolin），山金画内酯（arnicolide）C等[9]。"}]},{"ID":"20240903093510-gov4jcr","Type":"NodeParagraph","Properties":{"id":"20240903093510-gov4jcr","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240903093510-nupkh33","Type":"NodeParagraph","Properties":{"id":"20240903093510-nupkh33","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"1.抑菌作用：本品煎剂25-50%对结核杆菌有抑制作用。"}]},{"ID":"20240903093510-bh38aic","Type":"NodeParagraph","Properties":{"id":"20240903093510-bh38aic","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.止咳、平喘作用：本品挥发油和乙醇提取液部分有止咳、祛痰、平喘作用。"}]},{"ID":"20240903093510-gwqlcv3","Type":"NodeParagraph","Properties":{"id":"20240903093510-gwqlcv3","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"3.抗癌作用：Brevelin显示对大白鼠Walker肉瘤有抑制作用，一些Helenalin的衍生物也显示抗癌活性。"}]},{"ID":"20240903093510-522v5aw","Type":"NodeParagraph","Properties":{"id":"20240903093510-522v5aw","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"4.抗变态反应活性：鹅不食草的热水提取物经被动皮肤过敏试验表现出具显着的抗变态反应活性。由鹅不食草的氯仿提取物的甲醇可溶部分分离得到的Arnicolidec、6-O-Senecioylplenolin、Aurantiamideacetate和三个黄酮类化合物槲皮素-3，3二甲酯，槲皮素3-甲酯和芹菜素均显示了较强的抗变态反应活性。"}]},{"ID":"20240903093510-fxzpepu","Type":"NodeParagraph","Properties":{"id":"20240903093510-fxzpepu","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品粉末1g，加乙醇10ml，在水浴上回流加热10min，乘热滤过。滤液供以下试验。①取滤液1ml，放入小试管中，在水浴上挥去乙醇，加氯仿1ml，浓硫酸1ml，俟两液分层后，氯仿层呈青色，硫酸层呈绿色荧光。（检查甾类）②取滤液1ml，放入小蒸发皿中，于水浴上蒸干，加醋酸酐-浓硫酸（19：1）试剂两滴，混匀，产生黄色，后转变为红色→紫色→青色→污绿色。（检查甾类）"}]},{"ID":"20240903093510-tgyvqq8","Type":"NodeParagraph","Properties":{"id":"20240903093510-tgyvqq8","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【炮制】拣净杂质，切段，晒干。"}]},{"ID":"20240903093510-fqrjm56","Type":"NodeParagraph","Properties":{"id":"20240903093510-fqrjm56","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【性味】味辛；性温"}]},{"ID":"20240903093510-vzj1m2b","Type":"NodeParagraph","Properties":{"id":"20240903093510-vzj1m2b","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【归经】归肺；肝经"}]},{"ID":"20240903093510-0jtnre7","Type":"NodeParagraph","Properties":{"id":"20240903093510-0jtnre7","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风通窃、解毒消肿。主感冒；头痛；鼻渊；鼻息肉；咳嗽；喉痹；耳聋；目赤翳膜；疟疾；风湿痹痛；跌打损伤；肿毒；疥癣"}]},{"ID":"20240903093510-6jsl8yt","Type":"NodeParagraph","Properties":{"id":"20240903093510-6jsl8yt","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，5-9g；或捣汁。外用：适量，捣敷；或捣烂塞鼻；或研末畜鼻。"}]},{"ID":"20240903093510-hhyrldx","Type":"NodeParagraph","Properties":{"id":"20240903093510-hhyrldx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【附方】①治伤风头痛、鼻塞，目翳:鹅不食草(鲜或干均可)搓揉，嗅其气，即打喷嚏，每日二次。(《贵阳民间药草》)②治寒痰GOU喘:野园荽研汁和酒服。(《濒湖集简方》)③治脑漏:鲜石胡荽捣烂，塞鼻孔内。(《浙江民间草药》)④治单双喉蛾:鹅不食草一两，糯米一两。将鹅不食草捣烂，取汁浸糯米磨浆，给患者徐徐含咽。(《广西民间常用草药》)⑤治目病肿胀红赤，昏暗羞明，隐涩疼痛，风痒，鼻塞，头痛，脑酸，外翳攀睛，眵泪稠粘:鹅不食草二钱，青黛一钱，川芎一钱。为细末，先噙水满口，每用米许XIU入鼻内，以泪出为度。不拘时候。(《原机启微》GOU鼻碧云散)⑥治胬肉攀睛:鲜鹅不食草二两。捣烂，取汁煮沸澄清，加梅片一分调匀，点入眼内。(《广西民间常用草药》)⑦治脾寒疟疾:石胡荽一把，杵汁半碗，入酒半碗，和服。(《濒湖集简方》)⑧治间日疟及三日疟:鲜鹅不食草，捻成团，填鼻内，初感有喷嚏，宜稍忍耐，过一夜，效。(《现代实用中药》)⑨治阿米巴痢疾:石胡荽、乌韭根各五钱。水煎服，每日一剂；血多者加仙鹤草五钱。(《江西草药》)⑩治疳积腹泻:鲜石胡荽三钱。水煎服。(《湖南药物志》)(11)治愈症腹痛:球子草花序捣碎，以鼻闻之，使打嚏。(《浙江民间草药》)(12)治湿毒胫疮:野园荽(夏月采取，晒干为末)每以五钱，汞粉五分，桐油调作隔纸膏，周围缝定，以茶洗净，缚上膏药，黄水出。(《简便单方》)(13)治肿毒:野园荽一把，穿山甲(烧存性)七分，当归尾三钱。捣烂入酒一碗，绞计服，以渣敷之。(《濒湖集简方》)(14)治痔疮肿痛:石胡荽捣贴之。(《濒湖集简方》)(15)治牛皮癣:鹅不食草捣涂。(《贵阳民间药草》)(16)治蛇伤:鲜石胡荽捣烂，外敷伤部。(《泉州本草》)(17)治跌打肿痛:鹅不食草适量，捣烂，炒热，敷患处。(《广西民间常用草药》)(18)治鸡眼:先将鸡眼厚皮削平，用鲜石胡荽捣烂包敷患处，三至五天取下。(《浙江民间常用草药》)"}]},{"ID":"20240903093510-8shfj5z","Type":"NodeParagraph","Properties":{"id":"20240903093510-8shfj5z","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903093510-ye6h4zo","Type":"NodeParagraph","Properties":{"id":"20240903093510-ye6h4zo","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：鹅中食草，上达头脑，而治顶痛目病，通鼻气而落瘪肉；内达肺经而治GOUHE、痰疟，散疮肿；其除翳之功，尤显神妙。按倪惟德《原机启微集》云：治目翳鼻，碧云散用鹅不食草解毒为君，青黛去热为佐，川草之辛破留除邪为使，升透之药也。大抵如开锅盖法，常欲邪毒不闭，令有出路。然力小而锐，宜常以聚其力，凡目中诸病，皆可用之，生更神。"}]},{"ID":"20240903093510-zfoqzmg","Type":"NodeParagraph","Properties":{"id":"20240903093510-zfoqzmg","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：石胡妥，利九窍，通鼻气之药也。其味辛烈，其气辛熏，其性升散，能通肺经，上达头脑，故主GOUHE痰喘，气闭不通，鼻塞鼻痔，胀闷不利，去目中翳障，并头中寒邪、头风脑痛诸疾，皆取辛温升散之功也。"}]},{"ID":"20240903093510-xxvfow5","Type":"NodeParagraph","Properties":{"id":"20240903093510-xxvfow5","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：去目翳，LU塞鼻中，翳膜自落。"}]},{"ID":"20240903093510-e4quhkm","Type":"NodeParagraph","Properties":{"id":"20240903093510-e4quhkm","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"4.《四声本草》：通鼻气，利九窍，吐风痰。"}]},{"ID":"20240903093510-d2jd87e","Type":"NodeParagraph","Properties":{"id":"20240903093510-d2jd87e","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：解毒，明日，散目赤肿、云翳，耳聋，头痛脑酸，治痰疟GUHE，鼻塞不通，塞鼻瘪自落，又散疮肿。"}]},{"ID":"20240903093510-vurpcgk","Type":"NodeParagraph","Properties":{"id":"20240903093510-vurpcgk","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"6.《生草药性备要》：理跌打折骨，止痛消肿。"}]},{"ID":"20240903093510-thjrarx","Type":"NodeParagraph","Properties":{"id":"20240903093510-thjrarx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"7.《医林篆要》：通郁，去寒，藏疟，止痢。以干未搐鼻，可发嚏去寒郁。"}]},{"ID":"20240903093510-p7ckyqy","Type":"NodeParagraph","Properties":{"id":"20240903093510-p7ckyqy","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"8.《植物名实图考》：治痧症。"}]},{"ID":"20240903093510-f5f14we","Type":"NodeParagraph","Properties":{"id":"20240903093510-f5f14we","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"9.《广西药植图志》：治疳积。"}]},{"ID":"20240903093510-iog9hng","Type":"NodeParagraph","Properties":{"id":"20240903093510-iog9hng","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"10.《广西中药志》：治喉毒。"}]},{"ID":"20240903093510-3bzhwci","Type":"NodeParagraph","Properties":{"id":"20240903093510-3bzhwci","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"11.《广东中药》Ⅱ：治百日咳。"}]},{"ID":"20240903093510-wk0t3zx","Type":"NodeParagraph","Properties":{"id":"20240903093510-wk0t3zx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"12.广州部队《常用中草药手册》：治风湿性腰腿痛。"}]},{"ID":"20240903093510-bqj23kf","Type":"NodeParagraph","Properties":{"id":"20240903093510-bqj23kf","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240903093510-i8z40lp","Type":"NodeParagraph","Properties":{"id":"20240903093510-i8z40lp","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"1.治疗疟疾：将石胡荽制成注射剂(每毫升含生药2g)，在发作前2小时注射1次，连用3日。每次剂量：1-3岁2ml，4-8岁3ml，9-14岁4ml，15岁以上5ml。观察各型疟疾现症病人187例，经1-3次用药，痊愈175例(93.6%)。与氯喹、伯喹对照组相比，疗效无显着差别。治疗中有3例注射后发生恶心和轻度呕吐，停药后自行消失。"}]},{"ID":"20240903093510-dy0omvg","Type":"NodeParagraph","Properties":{"id":"20240903093510-dy0omvg","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.治疗百日咳：据300余例的观察，治愈率一般在90%左右。大都在用药后24小时内典型痉咳开始减轻。治愈时间，短者3-6天，长者10-15天。"}]},{"ID":"20240903093510-gzcnbmb","Type":"NodeParagraph","Properties":{"id":"20240903093510-gzcnbmb","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"制剂及剂量：2.1.取鲜品5两，制成煎液500ml，再加入等量糖浆。按患儿年龄大小，每日用20-40ml，4次分服。"}]},{"ID":"20240903093510-76btc2n","Type":"NodeParagraph","Properties":{"id":"20240903093510-76btc2n","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.2.取鲜生药1斤，制成煎液500ml，再加入糖浆至1000ml。1-4岁3-10ml，5-8岁11-20ml。每日3次。"}]},{"ID":"20240903093510-vtd4xnn","Type":"NodeParagraph","Properties":{"id":"20240903093510-vtd4xnn","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"2.3.取全草1500g，制成蒸馏液500ml，再和入等量糖浆。1-5岁5-10ml，5岁以上15ml，日服3-4次。"}]},{"ID":"20240903093510-wtzi62h","Type":"NodeParagraph","Properties":{"id":"20240903093510-wtzi62h","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"3.治疗软组织损伤：将鹅不食草研成粉末，成人每次用2-3钱(小儿减半)，以黄酒6-8两(不饮酒者用酒水各半)、红糖1-2两同煮(沸后密盖勿令泄气)，过滤后温服；药渣趁热敷于患部。亦可用粉剂每日3-6g，或以鲜草1-2两捣汁，分3次以温酒冲服。治疗胸、背、腰部等软组织损伤(包括跌伤、打伤、挫伤、扭伤等)，均有效。据数十例观察，大多于用药后1-2天痊愈。除胃痛患者服酒煮剂后间有疼痛外，一般无副作用。亦有将鲜石胡荽制成注射剂(每1500g鲜药制成500ml)作穴位注射，治疗关节扭伤、腰肌劳损、风湿疼痛等症，观察94例，痊愈31例，好转60例，有效率达97%。用法：于痛点或循经取穴注射，每次0.2-0.5ml，隔日1次，一般3-5次为一疗程。"}]},{"ID":"20240903093510-y55y6bx","Type":"NodeParagraph","Properties":{"id":"20240903093510-y55y6bx","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"4.治疗鼻炎：包括急性鼻炎、慢性单纯性鼻炎、肥厚性鼻炎、变态反应性鼻炎等。大多数病例用药后头痛、鼻塞等症状消失或减轻。用法：将鹅不食草研成细粉吸入鼻孔，每日数次；或用棉花浸湿拧干后，包药粉少许，卷成细条塞鼻，20-3O分钟后取出，每日1次；或制成油膏纱条，放置鼻腔内，1小时后取出。用药后除初起有喷嚏、流泪与流鼻涕外，余无不良反应。"}]},{"ID":"20240903093510-8zmvk7g","Type":"NodeParagraph","Properties":{"id":"20240903093510-8zmvk7g","updated":"20240903093605"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903093512-hu3aqxh","Type":"NodeThematicBreak","Properties":{"id":"20240903093512-hu3aqxh","updated":"20240903093605"}},{"ID":"20240903093513-mzlqywq","Type":"NodeParagraph","Properties":{"id":"20240903093513-mzlqywq","updated":"20240903093605"}}]}