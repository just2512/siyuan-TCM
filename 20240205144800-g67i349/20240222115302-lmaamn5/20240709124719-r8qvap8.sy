{"ID":"20240709124719-r8qvap8","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240709124719-r8qvap8","title":"盐肤木","type":"doc","updated":"20240902133848"},"Children":[{"ID":"20240709125218-wu3ifu1","Type":"NodeParagraph","Properties":{"id":"20240709125218-wu3ifu1","updated":"20240709125218"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"盐肤木 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/盐肤木 2-20240709125218-eo8j76u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240709125115-0igstdg","Type":"NodeParagraph","Properties":{"id":"20240709125115-0igstdg","updated":"20240709125115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 376px;","style":"width: 366px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五倍子 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五倍子 4-20240709123257-9oryo6b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 366px;\" parent-style=\"width: 376px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 374px;","style":"width: 364px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"盐肤木"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/盐肤木-20240709124821-i5lmxgd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 445px;","style":"width: 435px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"盐肤