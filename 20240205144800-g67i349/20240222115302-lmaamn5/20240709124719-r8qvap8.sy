709125115-ubkw253","Type":"NodeParagraph","Properties":{"id":"20240709125115-ubkw253","updated":"20240709125115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五倍子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五倍子 5-20240709123512-1bozd2p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五倍子 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五倍子 16-20240709124450-tuf6wr8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830113033-tfnp6sn","Type":"NodeParagraph","Properties":{"id":"20240830113033-tfnp6sn","updated":"20240830113033"}},{"ID":"20240830113033-6apsu5r","Type":"NodeParagraph","Properties":{"id":"20240830113033-6apsu5r","updated":"20240830113033"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"青麸杨和盐肤木区别"}]},{"ID":"20240830113033-6y0in6s","Type":"NodeParagraph","Properties":{"id":"20240830113033-6y0in6s","updated":"20240830113033"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青麸杨、盐肤木对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青麸杨、盐肤木对比-20240830111935-39teuri.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830113033-fw5l3op","Type":"NodeParagraph","Properties":{"id":"20240830113033-fw5l3op","updated":"20240830113033"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（上图中，左为青麸杨，右为盐肤木；盐肤木右叶托，青麸杨没有；）"}]},{"ID":"20240830111436-3kn26nt","Type":"NodeParagraph","Properties":{"id":"20240830111436-3kn26nt","updated":"20240830111449"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：盐肤木跟青麸杨外形相似，且都属于世界上最咸的植物之一；"}]},{"ID":"20240718110556-kvm36z5","Type":"NodeParagraph","Properties":{"id":"20240718110556-kvm36z5","updated":"20240830111458"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：主要用的是盐肤木的根；"}]},{"ID":"20240830111056-z5gwvj3","Type":"NodeParagraph","Properties":{"id":"20240830111056-z5gwvj3","updated":"20240830111510"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：盐肤木一到冬季盐肤木果实表面就会长一层白色的结晶体，把果实采下用热水把白霜溶解干净，再把过滤的热水放锅里熬煮，水分煮干后会留下一层白色的结晶体，这个就是天然的植物盐；"}]},{"ID":"20240709124903-6e8xe02","Type":"NodeThematicBreak","Properties":{"id":"20240709124903-6e8xe02"}},{"ID":"20240902133843-xrvy5tc","Type":"NodeParagraph","Properties":{"id":"20240902133843-xrvy5tc","updated":"20240902133848"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：盐肤木根"}]},{"ID":"20240902133843-3hlescr","Type":"NodeParagraph","Properties":{"id":"20240902133843-3hlescr","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"盐肤木根"}]},{"ID":"20240902133843-dnt3g6w","Type":"NodeParagraph","Properties":{"id":"20240902133843-dnt3g6w","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【拼音名】YánFūMùGēn"}]},{"ID":"20240902133843-yqbvpzc","Type":"NodeParagraph","Properties":{"id":"20240902133843-yqbvpzc","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【别名】盐麸子根、文蛤根、五倍根、泡木根、耳八蜈蚣、五倍子根。"}]},{"ID":"20240902133843-pc4x249","Type":"NodeParagraph","Properties":{"id":"20240902133843-pc4x249","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902133843-0mi5y09","Type":"NodeParagraph","Properties":{"id":"20240902133843-0mi5y09","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"药材基源：为漆树科植物盐肤木RhuschinensisMill．的树根。"}]},{"ID":"20240902133843-kos9l2y","Type":"NodeParagraph","Properties":{"id":"20240902133843-kos9l2y","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：RhuschinensisMill.[SchinusindicusBurm.；SemialataMurr.；R.javanicaThunb.]"}]},{"ID":"20240902133843-ej9mh1q","Type":"NodeParagraph","Properties":{"id":"20240902133843-ej9mh1q","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，鲜用或切片晒干。"}]},{"ID":"20240902133843-8tipjjo","Type":"NodeParagraph","Properties":{"id":"20240902133843-8tipjjo","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【原形态】盐肤子落叶小乔木或灌木，高2-10m。小枝棕褐色，被锈色柔毛，具圆形小皮孔。奇数羽状复叶互生，叶轴及叶柄常有翅；小叶5-13，小叶无柄；小叶纸质，多形，常为卵形或椭圆状卵形或长圆形，长6-12cm，宽3-7cm。先端急尖，基部圆形，边缘具粗锯齿或圆锯，叶面暗绿色，叶背粉绿色，被白粉，叶面沿中脉疏被柔毛或近无毛，叶背被锈色柔毛。圆锥花序宽大，顶生，多分枝，雄花序长30-40cm，雌花序较短，密被锈色柔毛；花小，杂性，黄白色；雄花花萼裂片长卵形，长约1mm，花瓣倒卵状长圆形，长约2mm，开花时外卷，雄蕊伸出，花丝线形，花药卵形；雌花花萼裂片较短，长约0.6mm，花瓣椭圆状卵形，长约1.6mm；花盘无毛；子房卵形，长约1mm，密被白色微柔毛；花柱3，柱头头状。核果球形，略压扁，径约4-5mm，被具节柔毛和腺毛，成熟时红色，果核径3-4mm。花期8-9月，果期10月。"}]},{"ID":"20240902133843-2faw0dj","Type":"NodeParagraph","Properties":{"id":"20240902133843-2faw0dj","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902133843-mhu3x0b","Type":"NodeParagraph","Properties":{"id":"20240902133843-mhu3x0b","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔350-2300m的石灰山灌丛、疏林中。"}]},{"ID":"20240902133843-9r5jnre","Type":"NodeParagraph","Properties":{"id":"20240902133843-9r5jnre","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地（除新疆、青海外）。"}]},{"ID":"20240902133843-ovgudmu","Type":"NodeParagraph","Properties":{"id":"20240902133843-ovgudmu","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【化学成份】根、茎中含2种黄酮甙元：3，7，4'-三羟基黄酮(3，7，4'-trihydroxyflavone)，3，7，3'，4'-四羟基黄酮(3，7，3'，4'-tetrahydroxyflavone)，7-羟基-6-甲氧基香豆素(7-hydroxy-6-methoxycoumarin)，没食子酸(gallicacid)，没食子酸乙酯(ethylgallate)，水黄皮黄素(pongapin)，四甲氧基非瑟素(tetramethoxy-fisetin)，去甲氧基小黄皮精(demethoxykanugin)，二苯甲酰甲烷(dibenzoylmethane)，椭圆叶崖豆藤酮(ovalitenone)，槲皮素(quercetin)，β-谷甾醇(β-sitosterol)。"}]},{"ID":"20240902133843-hhs2rwy","Type":"NodeParagraph","Properties":{"id":"20240902133843-hhs2rwy","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【性味】酸；咸；平"}]},{"ID":"20240902133843-paa3kcm","Type":"NodeParagraph","Properties":{"id":"20240902133843-paa3kcm","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风湿；利水消肿；活血散毒。主风湿痹痛；水肿；咳嗽；跌打肿痛；乳痈；癣疮"}]},{"ID":"20240902133843-cv9pgd1","Type":"NodeParagraph","Properties":{"id":"20240902133843-cv9pgd1","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g；鲜品30-60g。外用：适量，研末调敷；或煎水洗；或鲜品捣敷。"}]},{"ID":"20240902133843-ee5j11d","Type":"NodeParagraph","Properties":{"id":"20240902133843-ee5j11d","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【各家论述】《纲目》：“按《本草集议》云，盐麸子根，能软鸡骨。岑公云，有人被鸡骨鲠，项肿可畏，用此根煎醋啜至三碗，便吐出也。”"}]},{"ID":"20240902133843-ckijyaz","Type":"NodeParagraph","Properties":{"id":"20240902133843-ckijyaz","updated":"20240902133847"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902133844-va5apq1","Type":"NodeThematicBreak","Properties":{"id":"20240902133844-va5apq1","updated":"20240902133847"}},{"ID":"20240902133845-1sptef3","Type":"NodeParagraph","Properties":{"id":"20240902133845-1sptef3","updated":"20240902133847"}}]}