pe":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七指毛桃 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七指毛桃 8-20240830092931-m97az5p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830092051-mcdknxv","Type":"NodeParagraph","Properties":{"id":"20240830092051-mcdknxv","updated":"20240830092618"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 330px;","style":"width: 320px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七指毛桃 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七指毛桃 5-20240830092051-tnku3za.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 320px;\" parent-style=\"width: 330px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 435px;","style":"width: 425px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七指毛桃 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七指毛桃 6-20240830092618-jf3x8rf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 425px;\" parent-style=\"width: 435px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830084328-0g84y17","Type":"NodeParagraph","Properties":{"id":"20240830084328-0g84y17","updated":"20240830084328"}},{"ID":"20240830081618-k2atn66","Type":"NodeParagraph","Properties":{"id":"20240830081618-k2atn66","updated":"20240830081731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：五指毛桃像人的手掌，叶分裂五片；"}]},{"ID":"20240830081618-wd3r60x","Type":"NodeParagraph","Properties":{"id":"20240830081618-wd3r60x","updated":"20240830093709"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：除了五指毛桃，还有一指毛桃、三指毛桃、七指毛桃；（分辨是几指毛桃主要看叶片数量；五指毛桃根煲汤有椰奶香味，一指毛桃根煲汤没有太多香味，七指毛桃奶香浓欲为极品较稀少；）"}]},{"ID":"20240830084904-0eokx0g","Type":"NodeParagraph","Properties":{"id":"20240830084904-0eokx0g","updated":"20240830090605"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"整理过程中，发现不少视频创作者特地提到当*指毛桃两米以内出现‘断肠草’时不能将*指毛桃根部挖来煲汤，否则坐等开席（个人感觉是怕有人误挖到断肠草的根）；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"断肠草有剧毒，甚而至于有评论称山顶上有断肠草时整个山的东西都别碰，因为下雨水会携带毒性流下来，虽然这种说法略显夸张，但也反映了断肠草毒性之强；所以如果没有专业人士的指导，还是谨遵老人言，免得吃亏在眼前；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240506102358-3l0i7cd","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"277钩吻（断肠草）"}]},{"ID":"20240830081621-dafqcqk","Type":"NodeThematicBreak","Properties":{"id":"20240830081621-dafqcqk"}},{"ID":"20240830114949-fbls0qs","Type":"NodeParagraph","Properties":{"id":"20240830114949-fbls0qs","updated":"20240830114956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：五指毛桃"}]},{"ID":"20240830114949-6am70h0","Type":"NodeParagraph","Properties":{"id":"20240830114949-6am70h0","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"五指毛桃《全国中草药汇编》"}]},{"ID":"20240830114949-tk6gvro","Type":"NodeParagraph","Properties":{"id":"20240830114949-tk6gvro","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【拼音名】WúZhǐMáoTáo"}]},{"ID":"20240830114949-4x6w4nh","Type":"NodeParagraph","Properties":{"id":"20240830114949-4x6w4nh","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【别名】五指榕、五指牛奶、五指香、五叉牛奶、土黄芪[广东]、三爪龙、五爪龙、五爪桃、山狗差"}]},{"ID":"20240830114949-1r2ah1p","Type":"NodeParagraph","Properties":{"id":"20240830114949-1r2ah1p","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830114949-vw2hnqm","Type":"NodeParagraph","Properties":{"id":"20240830114949-vw2hnqm","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"为桑科榕属植物粗叶榕FicussimplicissimaLour.[F.hirtaVahlvar.palmatiloba（Merr.）Chum]，以根入药。全年可采，洗净晒干。"}]},{"ID":"20240830114949-beddvyg","Type":"NodeParagraph","Properties":{"id":"20240830114949-beddvyg","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"注：佛掌榕FicussimplicissimaLour.var.hirtaMigo功效近似前种。"}]},{"ID":"20240830114949-ms7zuim","Type":"NodeParagraph","Properties":{"id":"20240830114949-ms7zuim","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【原形态】灌木或小乔木，高1～2米，全株具贴伏短硬毛和白色乳汁。根浅黄色，皮柔韧，有香气。茎直立，很少分枝。叶互生，纸质，长椭圆披针形或广卵形。夏季花序托球形，成对腋生。花序托熟时由红变黑。"}]},{"ID":"20240830114949-ettcixj","Type":"NodeParagraph","Properties":{"id":"20240830114949-ettcixj","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【性味】甘，微温。"}]},{"ID":"20240830114949-0wnf2a5","Type":"NodeParagraph","Properties":{"id":"20240830114949-0wnf2a5","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【功能主治】健脾化湿，行气化痰，舒筋活络。用于肺结核咳嗽，慢性支气管炎，风湿性关节炎，腰腿疼，脾虚浮肿，病后盗汗，白带。"}]},{"ID":"20240830114949-ke89e1g","Type":"NodeParagraph","Properties":{"id":"20240830114949-ke89e1g","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～2两。"}]},{"ID":"20240830114949-fnx4zh2","Type":"NodeParagraph","Properties":{"id":"20240830114949-fnx4zh2","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830114949-34nhepo","Type":"NodeParagraph","Properties":{"id":"20240830114949-34nhepo","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"五指毛桃《中华本草》"}]},{"ID":"20240830114949-jde0931","Type":"NodeParagraph","Properties":{"id":"20240830114949-jde0931","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【拼音名】WúZhǐMáoTáo"}]},{"ID":"20240830114949-jh1zv51","Type":"NodeParagraph","Properties":{"id":"20240830114949-jh1zv51","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【别名】五指牛奶、土黄芪、土五加皮、五爪龙、母猪奶、南芪"}]},{"ID":"20240830114949-solw0r1","Type":"NodeParagraph","Properties":{"id":"20240830114949-solw0r1","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830114949-sfh64mc","Type":"NodeParagraph","Properties":{"id":"20240830114949-sfh64mc","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"药材基源：为桑科植物裂掌榕的根。"}]},{"ID":"20240830114949-qv29llp","Type":"NodeParagraph","Properties":{"id":"20240830114949-qv29llp","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：FicussimplicissimaLour.［F.hirtaVahlvar.palmatiloba(Merr.)Chun］"}]},{"ID":"20240830114949-1kqo9to","Type":"NodeParagraph","Properties":{"id":"20240830114949-1kqo9to","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采收，洗净，切片，晒干。"}]},{"ID":"20240830114949-g4nywqv","Type":"NodeParagraph","Properties":{"id":"20240830114949-g4nywqv","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【原形态】灌木或落叶小乔木，高1-2m，全株被黄褐色贴伏短硬毛，有乳汁。叶互生；叶片纸质，多型，长椭圆状披针形或狭广卵形，长8-25m，宽4-10(-18)cm，先端急尖或渐尖，基部圆形或心形，常具3-5深裂片，微波状锯齿或全缘，两面粗糙，基出脉3-7条；具叶柄，长2-7m；托叶卵状披针形，长0.8-2cm。隐头花序，花序托对生于叶腋或已落叶的叶腋间，球形，直径5-10mm，顶部有苞片形成的脐状突起，幼时特别明显，基部苞片卵状披针形，被紧贴的柔毛；总花梗短，长5mm，或无；雄花、瘿花生于同一花序托内；雄花生于近顶部，花被片4，线状披计形，雄蕊1-2；瘿花花被片与雄花相似，花柱侧生；雌花生于另一花序托内，花被片4。瘦果椭圆形。花期5-7月，果期8-10月。"}]},{"ID":"20240830114949-da5navb","Type":"NodeParagraph","Properties":{"id":"20240830114949-da5navb","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830114949-e9qk105","Type":"NodeParagraph","Properties":{"id":"20240830114949-e9qk105","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山林中或山谷灌木丛中，以及村寨沟旁。"}]},{"ID":"20240830114949-z7okdnx","Type":"NodeParagraph","Properties":{"id":"20240830114949-z7okdnx","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、广东、海南、广西、贵州、云南等地。"}]},{"ID":"20240830114949-44t9fhy","Type":"NodeParagraph","Properties":{"id":"20240830114949-44t9fhy","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830114949-4z6fl0x","Type":"NodeParagraph","Properties":{"id":"20240830114949-4z6fl0x","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"性状鉴别根略呈圆柱形，有分枝，长短不一，直径0.2-2.5cm，表面灰棕色或褐色，有纵皱纹，可见明显的横向皮孔及须根痕。部分栓皮脱落后露出黄色皮部。质坚硬，难折断，断面呈纤维性。饮片通常厚1-1.5cm，皮薄，木部呈黄白色，有众多同心环，可见放射状纹理，皮部与木部易分离。气微香，味甘。"}]},{"ID":"20240830114949-8cddyd3","Type":"NodeParagraph","Properties":{"id":"20240830114949-8cddyd3","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"显微鉴别根横切面：木栓层为10余列细胞，排列整齐，几乎每个细胞含一个草酸钙方晶。皮层窄，分布较多草酸钙方晶，石细胞散在。韧皮部宽广，有很多纤维，单个或成束，壁厚，其间夹有乳管。形成层环明显。木部射线宽1-10余列细胞，导管径向排列，单个散生或数个相聚，类圆形，直径30-200μm，木纤维与木薄壁细胞交互排列成同心环。薄壁细胞含淀粉粒。幼根几无草酸钙方晶。"}]},{"ID":"20240830114949-hmji4zz","Type":"NodeParagraph","Properties":{"id":"20240830114949-hmji4zz","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"粉末特征灰黄色。"}]},{"ID":"20240830114949-66vojio","Type":"NodeParagraph","Properties":{"id":"20240830114949-66vojio","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"1．木栓细胞类方形，内含棕色物。"}]},{"ID":"20240830114949-cjg5htk","Type":"NodeParagraph","Properties":{"id":"20240830114949-cjg5htk","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"2．导管类圆形，直径30-200μm，多为具缘纹孔导管。"}]},{"ID":"20240830114949-1ghxjav","Type":"NodeParagraph","Properties":{"id":"20240830114949-1ghxjav","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"3．方晶多存于薄壁细胞中，直径15-18μm。"}]},{"ID":"20240830114949-cq8f6rb","Type":"NodeParagraph","Properties":{"id":"20240830114949-cq8f6rb","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"4．石细胞单个或多个聚集成群，孔沟明显，直径16-45μm。"}]},{"ID":"20240830114949-4lx7yh6","Type":"NodeParagraph","Properties":{"id":"20240830114949-4lx7yh6","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"5．乳管微弯曲，直径11-22μm，常与纤维并列。"}]},{"ID":"20240830114949-nwkrriv","Type":"NodeParagraph","Properties":{"id":"20240830114949-nwkrriv","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"6．淀粉粒单粒或复粒，单粒的直径5-25μm。"}]},{"ID":"20240830114949-iqcqskb","Type":"NodeParagraph","Properties":{"id":"20240830114949-iqcqskb","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"理化鉴别取根的粗粉2g，加乙醇20ml，置水浴中加热10分钟，滤过；取滤液2ml，加7%盐酸羟胺及10%氢氧化钾的甲醇溶液至呈碱性；于水浴上微沸2分钟，冷却，加稀盐酸酸化；加入1%三氯化铁试液2滴，摇匀，显紫红色。"}]},{"ID":"20240830114949-knofeno","Type":"NodeParagraph","Properties":{"id":"20240830114949-knofeno","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【化学成份】含氨基酸、糖类、甾体、香豆精等。"}]},{"ID":"20240830114949-onbxt12","Type":"NodeParagraph","Properties":{"id":"20240830114949-onbxt12","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【药理作用】五指毛桃根煎剂、乙醇提取物、乙醇回流后残渣的水提取物，分别给小鼠灌服对氨水喷雾引起的咳嗽均有明显的止咳作用。试管试验对金黄色葡萄球菌、甲型链球菌亦有较好的抑菌作用。"}]},{"ID":"20240830114949-cjtr2g9","Type":"NodeParagraph","Properties":{"id":"20240830114949-cjtr2g9","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【炮制】取原药材，除去杂质。产地未切片者，洗净，润透，切厚片，干燥。饮片性状：本品为圆形厚片，皮部狭窄，易撕裂，纤维性；木部宽广，淡黄色。周边灰黄色或棕黄色。质坚硬。气微，味淡。贮干燥容器内，置通风干燥处。"}]},{"ID":"20240830114949-j7nzbgr","Type":"NodeParagraph","Properties":{"id":"20240830114949-j7nzbgr","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【性味】甘；性平"}]},{"ID":"20240830114949-q1ubhmg","Type":"NodeParagraph","Properties":{"id":"20240830114949-q1ubhmg","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【功能主治】健脾补肺；行气利湿；舒筋活络。主脾虚浮肿；食少无力；肺痨咳嗽；盗汗；带下；产后无乳；风湿痹痛；水肿；肝硬化腹水；肝炎；跌打损伤"}]},{"ID":"20240830114949-3pyvp0a","Type":"NodeParagraph","Properties":{"id":"20240830114949-3pyvp0a","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，60-90g。"}]},{"ID":"20240830114949-ofsmhcz","Type":"NodeParagraph","Properties":{"id":"20240830114949-ofsmhcz","updated":"20240830114956"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830114950-e5k5o0w","Type":"NodeThematicBreak","Properties":{"id":"20240830114950-e5k5o0w","updated":"20240830114956"}},{"ID":"20240830114951-u7wapf9","Type":"NodeParagraph","Properties":{"id":"20240830114951-u7wapf9","updated":"20240830114956"}}]}