idth: 377px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树6-20240703165809-cd0xwoe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 377px;\" parent-style=\"width: 387px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 853px;","style":"width: 843px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树4-20240703165501-bdiqwmg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 843px;\" parent-style=\"width: 853px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715131313-r8n9dsy","Type":"NodeThematicBreak","Properties":{"id":"20240715131313-r8n9dsy"}},{"ID":"20240902092658-2wa29j4","Type":"NodeParagraph","Properties":{"id":"20240902092658-2wa29j4","updated":"20240902092705"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：桃胶"}]},{"ID":"20240902092658-inp4x08","Type":"NodeParagraph","Properties":{"id":"20240902092658-inp4x08","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"桃胶《*辞典》"}]},{"ID":"20240902092658-qa4it4p","Type":"NodeParagraph","Properties":{"id":"20240902092658-qa4it4p","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902092658-8w8mayl","Type":"NodeParagraph","Properties":{"id":"20240902092658-8w8mayl","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【拼音名】TáoJiāo"}]},{"ID":"20240902092658-4lcxv4o","Type":"NodeParagraph","Properties":{"id":"20240902092658-4lcxv4o","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷薇科植物桃或山桃等树皮中分泌出来的树脂。夏季采收，用刀切割树皮，待树脂溢出后收集。水浸，洗去杂质，晒干。"}]},{"ID":"20240902092658-za0fgr3","Type":"NodeParagraph","Properties":{"id":"20240902092658-za0fgr3","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【化学成份】树胶的主要组成为半乳糖、鼠李糖、α-葡萄糖醛酸等。"}]},{"ID":"20240902092658-8vt04xb","Type":"NodeParagraph","Properties":{"id":"20240902092658-8vt04xb","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【性味】《唐本草》：\"味甘苦，平，无毒。\""}]},{"ID":"20240902092658-vyjcjci","Type":"NodeParagraph","Properties":{"id":"20240902092658-vyjcjci","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902092658-flybnmf","Type":"NodeParagraph","Properties":{"id":"20240902092658-flybnmf","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"治石淋，血淋，痢疾。"}]},{"ID":"20240902092658-vm1k1gb","Type":"NodeParagraph","Properties":{"id":"20240902092658-vm1k1gb","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主保中不饥，忍风寒。\""}]},{"ID":"20240902092658-kr5s18p","Type":"NodeParagraph","Properties":{"id":"20240902092658-kr5s18p","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"主下石淋，破血，中恶疰忤。\""}]},{"ID":"20240902092658-llxs9x2","Type":"NodeParagraph","Properties":{"id":"20240902092658-llxs9x2","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"和血益气，治下痢，止痛。\""}]},{"ID":"20240902092658-wor4ffw","Type":"NodeParagraph","Properties":{"id":"20240902092658-wor4ffw","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎扬，0.5～1两，或入丸、散。"}]},{"ID":"20240902092658-2hxm68c","Type":"NodeParagraph","Properties":{"id":"20240902092658-2hxm68c","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902092658-n8cly30","Type":"NodeParagraph","Properties":{"id":"20240902092658-n8cly30","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"①治石淋作痛：桃木胶如枣大，夏以冷水三合，冬以汤三合和服，日三服，当下石，石尽即止。（《古今录验方》）"}]},{"ID":"20240902092658-jl2c12m","Type":"NodeParagraph","Properties":{"id":"20240902092658-jl2c12m","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"②治血淋：石膏、木通、桃胶（炒作末）各半两。上为细末。每服二钱，水一盏，煎至七分，通口服，食前。（《杨氏家藏方》桃胶散）"}]},{"ID":"20240902092658-g7q0oty","Type":"NodeParagraph","Properties":{"id":"20240902092658-g7q0oty","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"③治产后下痢赤白，里急后重疞痛：桃胶（焙干）、沉香、蒲黄（炒）各等分。为末。每服二钱，食前米饮下。（《妇人良方》）"}]},{"ID":"20240902092658-jx7865k","Type":"NodeParagraph","Properties":{"id":"20240902092658-jx7865k","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"④治虚热作渴：桃胶如弹丸大，含之咽津。（《千金方》）"}]},{"ID":"20240902092658-g8vi9y2","Type":"NodeParagraph","Properties":{"id":"20240902092658-g8vi9y2","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"⑤治糖尿病：桃胶，用微温水洗净，放在小锅内煮食，随便加些调味盐类亦可（但不要加入甜味）。每次服一至二两。（《草药验方交流集》）"}]},{"ID":"20240902092658-262nsxd","Type":"NodeParagraph","Properties":{"id":"20240902092658-262nsxd","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"⑥治疮疹黑黡，发搐危困：桃胶煎汤饮之。一方水熬成膏，温酒调下，无时。（《小儿卫生总微论方》桃胶汤）"}]},{"ID":"20240902092658-hgwx9le","Type":"NodeParagraph","Properties":{"id":"20240902092658-hgwx9le","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【各家论述】《本经逢原》：\"桃树上胶，最通津液，能治血淋，石淋。痘疮黑陷，必胜膏用之。\""}]},{"ID":"20240902092658-4xzis9u","Type":"NodeParagraph","Properties":{"id":"20240902092658-4xzis9u","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902092658-zmx4d73","Type":"NodeParagraph","Properties":{"id":"20240902092658-zmx4d73","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"桃胶《中华本草》"}]},{"ID":"20240902092658-hvp6mo8","Type":"NodeParagraph","Properties":{"id":"20240902092658-hvp6mo8","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【出处】出自《名医别录》。《纲目》：桃茂盛时，以刀割树皮，久则胶溢出，采收，以桑灰汤浸过曝干用。"}]},{"ID":"20240902092658-swdd3df","Type":"NodeParagraph","Properties":{"id":"20240902092658-swdd3df","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【拼音名】TáoJiāo"}]},{"ID":"20240902092658-zx94thy","Type":"NodeParagraph","Properties":{"id":"20240902092658-zx94thy","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【英文名】PeachResin"}]},{"ID":"20240902092658-tai4g62","Type":"NodeParagraph","Properties":{"id":"20240902092658-tai4g62","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902092658-pxil8im","Type":"NodeParagraph","Properties":{"id":"20240902092658-pxil8im","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物桃或山桃等树皮中分泌出来的树脂"}]},{"ID":"20240902092658-v3y43mk","Type":"NodeParagraph","Properties":{"id":"20240902092658-v3y43mk","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.AmygdaluspersicaL.[Prunuspersica(L.)Batsch.]2.Amygdalusdavidiana(Carr.)C.deVosexHenry[PersicadavidianaCarr.;Prunusdavidiana(Carr.)Franch.]"}]},{"ID":"20240902092658-bpzz0wo","Type":"NodeParagraph","Properties":{"id":"20240902092658-bpzz0wo","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季采收，用刀切割树皮，待树脂溢出后收集。水浸，洗去杂质，晒干。"}]},{"ID":"20240902092658-i1z0zy1","Type":"NodeParagraph","Properties":{"id":"20240902092658-i1z0zy1","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902092658-nga1ic1","Type":"NodeParagraph","Properties":{"id":"20240902092658-nga1ic1","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"1.桃落叶小乔木，高达3-8m。小枝绿色或半边红褐色，无毛。叶互生，在短枝上呈簇生状；叶柄长1-2cm，通常有1至数枚腺体；叶片椭圆状披针形至倒卵状披针形，边缘具细锯齿，两面无毛。花通常单生，生于叶开放，直径约2.5-3.5cm，具短梗；萼片5，基部合生成短萼筒，无毛。叶柄长7-12mm，具腺点。花通常单生，直径约2.5-3.5cm；具短梗；萼片5，基部合生成短萼筒，外被绒毛；花瓣5，倒卵形，粉红色；罕为白色；雄蕊多数，子房1室。花柱细长，柱头小，圆头状。核果近球形，直径5-7cm，表面有短绒毛；果肉白色或黄色；离核或粘核。种子1枚，扁卵状心形。花期3-4月，果期6-7月。"}]},{"ID":"20240902092658-0b57vw5","Type":"NodeParagraph","Properties":{"id":"20240902092658-0b57vw5","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.山桃落叶小乔木，高5-9m。叶互生；托叶早落；叶柄长1.5-3cm；叶片卵状披针形，长4-8cm，宽2-3.5cm，花单生，萼片5，花瓣5，阔倒卵形，粉红色至白色。核果近圆形，黄绿色，表面被黄褐色柔毛。果肉离核；核小，坚硬。种子1颗，棕红色。花期3-4月。果期6-7月。"}]},{"ID":"20240902092658-46rj2g7","Type":"NodeParagraph","Properties":{"id":"20240902092658-46rj2g7","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902092658-f3baevb","Type":"NodeParagraph","Properties":{"id":"20240902092658-f3baevb","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"生态环境：生于海拔800-1200m的山坡、山谷沟底或荒野疏林及灌丛内。"}]},{"ID":"20240902092658-4bpej1o","Type":"NodeParagraph","Properties":{"id":"20240902092658-4bpej1o","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"资源分布：1.桃全国各地普遍栽培。"}]},{"ID":"20240902092658-vlurfd4","Type":"NodeParagraph","Properties":{"id":"20240902092658-vlurfd4","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.分布于河北、山西、陕西、甘肃、山东、河南、四川、云南等地。"}]},{"ID":"20240902092658-lfyfrx6","Type":"NodeParagraph","Properties":{"id":"20240902092658-lfyfrx6","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902092658-gcvivyb","Type":"NodeParagraph","Properties":{"id":"20240902092658-gcvivyb","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"生物学特性1.桃喜阳光和温暖的气候，在肥沃高燥的砂质壤土中生长最好。怕涝，在低洼碱性土壤中生长不良。幼树抗寒力弱，容易冻梢。耐修剪，寿命较短。"}]},{"ID":"20240902092658-1rzld3q","Type":"NodeParagraph","Properties":{"id":"20240902092658-1rzld3q","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.山桃喜光，在半阴处也能生长，耐寒，耐旱。对土壤要求不严贫瘠、荒山均可种植。"}]},{"ID":"20240902092658-ne4mcxk","Type":"NodeParagraph","Properties":{"id":"20240902092658-ne4mcxk","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"栽培技术1.桃以嫁接繁殖为主。用山桃、毛桃、为砧木，可增强其抗涝、抗寒性。供砧木用桃核在湿沙中完成春化阶段，使硬壳容易裂开，易于发芽，3月播种，4月上旬即可出芽。有经沙藏的种子，可在秋季播种，选地势高燥的圃地培育桃苗，苗木生长迅速，当年秋季幼苗可长20-30cm高。芽接一般以8月下旬、中旬为宜，多采用丁字形芽接法，或在春季4月上旬进行枝接，多采用切接、腹接和劈接法。"}]},{"ID":"20240902092658-u2sbhu3","Type":"NodeParagraph","Properties":{"id":"20240902092658-u2sbhu3","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.山桃用种子繁殖。6-9月份摘下成熟果实，除去果肉，将种子在水中冲洗干净，捞出晾干，沙藏。春播，3月上旬进行至4月初播种，把经过沙藏种子取出，按行株距35cm×(20-30)cm，深5-6cm穴播，覆土，浇水，15d左右可出苗。幼苗在苗圃培育1-2年出圃定植。秋播于10月中旬至11月上旬，可以当年采收的种子，不经沙藏处理，直接播种，于翌年春生苗。山桃苗木一般常作为桃树品种的砧木。"}]},{"ID":"20240902092658-cg1lji5","Type":"NodeParagraph","Properties":{"id":"20240902092658-cg1lji5","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"田间管理1.桃注意整形修剪，加强土、肥、水管理。"}]},{"ID":"20240902092658-uy7408y","Type":"NodeParagraph","Properties":{"id":"20240902092658-uy7408y","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.山桃幼苗出土后，应及时进行追肥、浇水、中耕除草。定植结果后，于每年的冬季进行修剪，剪除徒长枝、过密枝、病虫枝、细弱枝，使通风透光，提高果实的产量。"}]},{"ID":"20240902092658-lxf30n3","Type":"NodeParagraph","Properties":{"id":"20240902092658-lxf30n3","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"病虫害防治1.桃抗病能力弱，量易遭受虫害。桃炭疽病，主要为害果实，也为害叶和新梢，发芽前喷波美3度石硫合剂，发芽后喷65%代森锌500倍液2-3次。流胶病，发生在树枝干，加强栽培管理，枝干涂白，预防冻害和日烧伤，防治蛀食枝干的害虫。桃蚜，为害叶片，发芽前喷波美3度石硫合剂，生长期用2.5%溴氰菊酯5000倍液。"}]},{"ID":"20240902092658-7j56drp","Type":"NodeParagraph","Properties":{"id":"20240902092658-7j56drp","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.山桃桃缩叶病，为害叶片、新梢、果实，严重时造成落叶甚至枝条枯死。发芽前喷波美5度石硫合剂。虫害有桃芽、桃粉蚜。"}]},{"ID":"20240902092658-0izw4qv","Type":"NodeParagraph","Properties":{"id":"20240902092658-0izw4qv","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈不规则的块状、泪滴状等，大小不一，表面淡黄色、黄棕色，角质样，半透明。质韧软，干透较硬，断面有光泽。气微，加水有粘性。"}]},{"ID":"20240902092658-jfifsrq","Type":"NodeParagraph","Properties":{"id":"20240902092658-jfifsrq","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【化学成份】树胶的主要组成为半乳糖(galactose)，鼠李糖(rhamnose)，α-葡萄糖醛酸(a-glucuronicacid)等。"}]},{"ID":"20240902092658-k6194ep","Type":"NodeParagraph","Properties":{"id":"20240902092658-k6194ep","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【性味】甘苦；平；无毒"}]},{"ID":"20240902092658-58grdei","Type":"NodeParagraph","Properties":{"id":"20240902092658-58grdei","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【归经】大肠；膀胱经"}]},{"ID":"20240902092658-vd2d3l8","Type":"NodeParagraph","Properties":{"id":"20240902092658-vd2d3l8","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【功能主治】和血；通淋；止痢。主石淋；血淋；痢疾；腹痛；糖尿病；乳糜尿"}]},{"ID":"20240902092658-gm7ee63","Type":"NodeParagraph","Properties":{"id":"20240902092658-gm7ee63","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g，或入丸、散。"}]},{"ID":"20240902092658-uryr51p","Type":"NodeParagraph","Properties":{"id":"20240902092658-uryr51p","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【附方】①治石淋作痛：桃木胶如枣大，夏以冷水三合，冬以汤三合和服，日三服，当下石，石尽即止。(《古今录验方》)②治血淋：石膏、木通、桃胶(炒作末)各半两。上为细末。每服二钱，水一盏，煎至七分，通口服，食前。(《杨氏家藏方》桃胶散)③治产后下痢赤白，里急后重病痛：桃胶(焙干)、沉香、蒲黄(炒)各等分。为末。每服二钱，食前米饮下。(《妇人良方》)④治虚热作渴：桃胶如弹丸大，含之咽津。(《千金方》)⑤治糖尿病：桃胶，用微温水洗净，放在小锅内煮食，随便加些调味盐类亦可(但不要加入甜味)。每次服一至二两。(《草药验方交流集》)⑥治疮疹黑黡，发搐危困：桃胶煎汤饮之。一方水熬成膏，温酒调下，无时。(《小儿卫生总微论方》桃胶汤)"}]},{"ID":"20240902092658-qcu8vf4","Type":"NodeParagraph","Properties":{"id":"20240902092658-qcu8vf4","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902092658-8rmn73v","Type":"NodeParagraph","Properties":{"id":"20240902092658-8rmn73v","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"1.《别录》：主保中不饥，忍风寒。"}]},{"ID":"20240902092658-d6w1wrj","Type":"NodeParagraph","Properties":{"id":"20240902092658-d6w1wrj","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：主下石淋，破血，中恶疰忤。"}]},{"ID":"20240902092658-629o64a","Type":"NodeParagraph","Properties":{"id":"20240902092658-629o64a","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：和血益气，治下痢，止痛。"}]},{"ID":"20240902092658-wjti3yj","Type":"NodeParagraph","Properties":{"id":"20240902092658-wjti3yj","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：桃树上胶，最通津液，能治血淋，石淋。痘疮黑陷，必胜膏用之。"}]},{"ID":"20240902092658-lvbukfi","Type":"NodeParagraph","Properties":{"id":"20240902092658-lvbukfi","updated":"20240902092715"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902092700-tnv4hwz","Type":"NodeThematicBreak","Properties":{"id":"20240902092700-tnv4hwz","updated":"20240902092715"}},{"ID":"20240902092701-4mszcr0","Type":"NodeParagraph","Properties":{"id":"20240902092701-4mszcr0","updated":"20240902092715"}}]}