=\"width: 747px;\" parent-style=\"width: 757px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729094121-ki95rwd","Type":"NodeParagraph","Properties":{"id":"20240729094121-ki95rwd","updated":"20240729100024"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 448px;","style":"width: 438px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"隔山消 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/隔山消 5-20240729094121-gdqzzjg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 438px;\" parent-style=\"width: 448px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 783px;","style":"width: 773px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"隔山消 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/隔山消 10-20240729100024-3k9onvf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 773px;\" parent-style=\"width: 783px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729093423-yejkxya","Type":"NodeThematicBreak","Properties":{"id":"20240729093423-yejkxya"}},{"ID":"20240903085824-dhgdf12","Type":"NodeParagraph","Properties":{"id":"20240903085824-dhgdf12","updated":"20240903085833"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：隔山消"}]},{"ID":"20240903085824-mchkn1z","Type":"NodeParagraph","Properties":{"id":"20240903085824-mchkn1z","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"隔山消《*辞典》"}]},{"ID":"20240903085824-mlwnf5i","Type":"NodeParagraph","Properties":{"id":"20240903085824-mlwnf5i","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目》"}]},{"ID":"20240903085824-x1v2slo","Type":"NodeParagraph","Properties":{"id":"20240903085824-x1v2slo","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【拼音名】GéShānXiāo"}]},{"ID":"20240903085824-ah4k207","Type":"NodeParagraph","Properties":{"id":"20240903085824-ah4k207","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【别名】隔山撬（《分类草药性》），隔山锹（《天宝本草》）。"}]},{"ID":"20240903085824-83x3jq0","Type":"NodeParagraph","Properties":{"id":"20240903085824-83x3jq0","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【来源】为萝藦科植物耳叶牛皮消的块根。秋季采收，洗净，晒干。"}]},{"ID":"20240903085824-5jwdxc2","Type":"NodeParagraph","Properties":{"id":"20240903085824-5jwdxc2","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【生境分布】产四川、江苏、江西等地。"}]},{"ID":"20240903085824-s4nzqwm","Type":"NodeParagraph","Properties":{"id":"20240903085824-s4nzqwm","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【性状】干燥块根呈圆柱形，微弯曲，长约10～20厘米，直径约2～3厘米。外表黄褐色或红棕色，栓皮粗糙，有明显纵横皱纹，皮孔横长突起，栓皮破裂处露出黄白色的木质部。质坚硬，断面淡黄棕色，粉质，有辐射状花纹及鲜黄色孔点。气无，味先苦后甜。"}]},{"ID":"20240903085824-3oozgt4","Type":"NodeParagraph","Properties":{"id":"20240903085824-3oozgt4","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含淀粉44％，又含皂甙。"}]},{"ID":"20240903085824-9wetqd5","Type":"NodeParagraph","Properties":{"id":"20240903085824-9wetqd5","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240903085824-fk745yk","Type":"NodeParagraph","Properties":{"id":"20240903085824-fk745yk","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"①《贵阳民间药草》：\"甘苦，平，无毒。\""}]},{"ID":"20240903085824-68lkzox","Type":"NodeParagraph","Properties":{"id":"20240903085824-68lkzox","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"②《陕西中草药》：\"甘微辛，平。\""}]},{"ID":"20240903085824-hksr0zl","Type":"NodeParagraph","Properties":{"id":"20240903085824-hksr0zl","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240903085824-xr8k5uh","Type":"NodeParagraph","Properties":{"id":"20240903085824-xr8k5uh","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"养阴补虚，健脾消食。治虚损劳伤，痢疾，疳积，胃痛饱胀，白带，疮癣。"}]},{"ID":"20240903085824-yvjvh7m","Type":"NodeParagraph","Properties":{"id":"20240903085824-yvjvh7m","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"主腹胀积滞。\""}]},{"ID":"20240903085824-hm4sm5r","Type":"NodeParagraph","Properties":{"id":"20240903085824-hm4sm5r","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"②《草木便方》：\"醋磨涂癣。\""}]},{"ID":"20240903085824-ya8fsg5","Type":"NodeParagraph","Properties":{"id":"20240903085824-ya8fsg5","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"③《分类草药性》：\"消食积，下乳，补虚弱。\""}]},{"ID":"20240903085824-9hgk8cm","Type":"NodeParagraph","Properties":{"id":"20240903085824-9hgk8cm","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"④《贵州民间方药集》：\"外用治疮毒、鱼口。\""}]},{"ID":"20240903085824-htvtlg9","Type":"NodeParagraph","Properties":{"id":"20240903085824-htvtlg9","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑤《陕西中草药》：\"滋阴养血，健脾顺气，镇静止痛，催乳。治胃痛腹胀，虚劳，肾虚腰痛，阳萎，小儿痞块，白带，乳汁不足。\""}]},{"ID":"20240903085824-t2pj4nj","Type":"NodeParagraph","Properties":{"id":"20240903085824-t2pj4nj","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑥《南方主要有毒植物》：\"治肾炎水肿，胃及十二指肠溃疡。\""}]},{"ID":"20240903085824-ow1ezyo","Type":"NodeParagraph","Properties":{"id":"20240903085824-ow1ezyo","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑦《江西草药》：\"清热解毒，顺气止痢。\""}]},{"ID":"20240903085824-l9lmgog","Type":"NodeParagraph","Properties":{"id":"20240903085824-l9lmgog","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～3钱（鲜者0.5～1两）；或入丸、散。外用：捣敷或磨汁涂。"}]},{"ID":"20240903085824-nn2dh05","Type":"NodeParagraph","Properties":{"id":"20240903085824-nn2dh05","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240903085824-wj2uwfv","Type":"NodeParagraph","Properties":{"id":"20240903085824-wj2uwfv","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"①治痢疾：耳叶牛皮消根一两。水煎服，每日一剂。（《江西草药》）"}]},{"ID":"20240903085824-9gq8bxo","Type":"NodeParagraph","Properties":{"id":"20240903085824-9gq8bxo","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"②治食积饱胀：隔山消一钱。打成粉子，用开水吞服，每天一次。（贵州《常用民间草药手册》）"}]},{"ID":"20240903085824-sjzk3j2","Type":"NodeParagraph","Properties":{"id":"20240903085824-sjzk3j2","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"③治胃气痛，年久未愈：隔山消二钱，万年荞一钱。打成细粉，每天三次，每次用开水吞一钱。（贵州《常用民间草药手册》）"}]},{"ID":"20240903085824-jisjrih","Type":"NodeParagraph","Properties":{"id":"20240903085824-jisjrih","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"④治多年老胃病：隔山消一两，鸡屎藤五钱。炖猪肉服。（《贵阳民间药草》）"}]},{"ID":"20240903085824-bxte0dk","Type":"NodeParagraph","Properties":{"id":"20240903085824-bxte0dk","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑤治气膈噎食，转食：隔山消二两，鸡肫皮一两，牛胆南星、朱砂各一两，急性子二钱。为末，炼蜜丸，小豆大。每服一钱，淡姜汤下。（《孙天仁集效方》）"}]},{"ID":"20240903085824-0r8my28","Type":"NodeParagraph","Properties":{"id":"20240903085824-0r8my28","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑥治小儿痞块：隔山撬一两。煎水加白糖当茶喝，每日三、五次。（《陕西中草药》）"}]},{"ID":"20240903085824-rhmy6jf","Type":"NodeParagraph","Properties":{"id":"20240903085824-rhmy6jf","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑦治小儿疳疾，隔食，并能开胃健脾：隔山消、苦荞头、鸡屎藤、马蹄草、鱼鳅串、侧耳根。研末，加石柑子叶、鸡内金，蒸鸡子服。（《四川中药志》）"}]},{"ID":"20240903085824-1sb9slx","Type":"NodeParagraph","Properties":{"id":"20240903085824-1sb9slx","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑧治食疟：隔山消（细末）五分，地枯牛三个（去头、脚，焙焦，研末）。混合，用米汁送下。（《贵阳民间药草》）"}]},{"ID":"20240903085824-jz43abu","Type":"NodeParagraph","Properties":{"id":"20240903085824-jz43abu","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"⑨催乳：隔山撬一两。炖肉吃。（《陕西中草药》）"}]},{"ID":"20240903085824-l867y88","Type":"NodeParagraph","Properties":{"id":"20240903085824-l867y88","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【备注】本品在江苏作白首乌使用。"}]},{"ID":"20240903085824-dlf1c8p","Type":"NodeParagraph","Properties":{"id":"20240903085824-dlf1c8p","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240903085824-vxcf7l4","Type":"NodeParagraph","Properties":{"id":"20240903085824-vxcf7l4","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"隔山消《中华本草》"}]},{"ID":"20240903085824-i2zvias","Type":"NodeParagraph","Properties":{"id":"20240903085824-i2zvias","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【出处】出自于《本草纲目》"}]},{"ID":"20240903085824-wbzfp24","Type":"NodeParagraph","Properties":{"id":"20240903085824-wbzfp24","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【拼音名】GéShānXiāo"}]},{"ID":"20240903085824-fkn0mcm","Type":"NodeParagraph","Properties":{"id":"20240903085824-fkn0mcm","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【英文名】RootofWilfordSwallowwort"}]},{"ID":"20240903085824-7qztc61","Type":"NodeParagraph","Properties":{"id":"20240903085824-7qztc61","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【别名】隔山撬、隔山牛皮消、白首乌、白何首乌、山瓜蒌"}]},{"ID":"20240903085824-hb2njul","Type":"NodeParagraph","Properties":{"id":"20240903085824-hb2njul","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240903085824-gnrdr6d","Type":"NodeParagraph","Properties":{"id":"20240903085824-gnrdr6d","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"药材基源：为萝藦科植物隔山消的块根。"}]},{"ID":"20240903085824-3vhhmnp","Type":"NodeParagraph","Properties":{"id":"20240903085824-3vhhmnp","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cynanchumwilfordii(Maxim.)Hemsl.[CynanchumwilfordiiMaxim.]"}]},{"ID":"20240903085824-s80lu3u","Type":"NodeParagraph","Properties":{"id":"20240903085824-s80lu3u","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收,洗净,切片，晒干"}]},{"ID":"20240903085824-hyfwgv4","Type":"NodeParagraph","Properties":{"id":"20240903085824-hyfwgv4","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【原形态】草质藤本。肉质根近纺锤形，长约10cm，径约2cm，灰褐色。茎被单列毛。叶对生；叶片薄纸质，卵形，长5-6cm，宽2-4cm,先端短渐尖，基部耳状心形，两面被微柔毛；基脉3-4条，放射状，侧脉4对。近伞房状聚伞兵花序半球形，有花15-20朵，花序梗被单列毛；花萼外面被柔毛；花冠淡黄色，辐状，裂片长圆形，外面无毛，内面被长柔毛；副花冠裂片近四方形，比合蕊柱短，先端截形，基部紧狭；花粉块每室1个，长圆形，下垂，花柱细长柱状略突起。蓇葖果单生，披针形，长达12cm，直径约1cm。种子卵形，顶端具长约2cm的白色绢质种毛。花期5-9月，果期7-10月。"}]},{"ID":"20240903085824-qaxup5d","Type":"NodeParagraph","Properties":{"id":"20240903085824-qaxup5d","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240903085824-sdx7e01","Type":"NodeParagraph","Properties":{"id":"20240903085824-sdx7e01","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"生态环境：生于每拔800-1300m的山坡、山谷或灌木丛中、路边草地。"}]},{"ID":"20240903085824-wcgrfte","Type":"NodeParagraph","Properties":{"id":"20240903085824-wcgrfte","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于辽宁、山西、陕西、甘肃、新疆、山东、江苏、安徽、河南、湖北、湖南和四川等地。"}]},{"ID":"20240903085824-25fcew3","Type":"NodeParagraph","Properties":{"id":"20240903085824-25fcew3","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别根圆柱形或纺锤形，长10-20cm，直径1-4cm，微弯曲，表面白色或黄白色，具纵皱纹及横长皮孔，栓皮破裂处显黄白色木部。质坚硬，折断面不平坦，灰白色，微带粉状。气微，味苦甜。"}]},{"ID":"20240903085824-pqf1pvq","Type":"NodeParagraph","Properties":{"id":"20240903085824-pqf1pvq","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【化学成份】根中分离得到隔山消甙（wilfoside）C3N、C1N、C2N、C3G、C1G、C2G[1]、D1N、K1N、M1N、F1N、W1N、G1G[2]。"}]},{"ID":"20240903085824-fqmlhix","Type":"NodeParagraph","Properties":{"id":"20240903085824-fqmlhix","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240903085824-81f11qe","Type":"NodeParagraph","Properties":{"id":"20240903085824-81f11qe","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"取原药材，除去杂质，筛去灰沙。洗净，润透，切薄片，干燥。"}]},{"ID":"20240903085824-p1ataop","Type":"NodeParagraph","Properties":{"id":"20240903085824-p1ataop","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"饮片性状：为类圆形薄片，边缘内卷。表面白色或黄白色，显粉性，有放射状略突起的盘脉纹。周边黄褐色或浅黄色。质脆。无臭，味先微苦后略甜。"}]},{"ID":"20240903085824-5s3jtd5","Type":"NodeParagraph","Properties":{"id":"20240903085824-5s3jtd5","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"贮干燥容器内，置通风干燥处。"}]},{"ID":"20240903085824-t8zw9xt","Type":"NodeParagraph","Properties":{"id":"20240903085824-t8zw9xt","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；微苦；性微温；"}]},{"ID":"20240903085824-hbtv4me","Type":"NodeParagraph","Properties":{"id":"20240903085824-hbtv4me","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【归经】脾；胃；肾经"}]},{"ID":"20240903085824-k3gaq29","Type":"NodeParagraph","Properties":{"id":"20240903085824-k3gaq29","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【功能主治】补肝肾；强筋骨；健脾胃；解毒。主肝肾两虚；头昏眼花；失眠健忘；须发早白；阳痿；遗精；腰膝酸攀登；脾虚不运；脘腹胀满；仞欲不振；泄泻；产后乳少；鱼口疮毒。"}]},{"ID":"20240903085824-9yen8fg","Type":"NodeParagraph","Properties":{"id":"20240903085824-9yen8fg","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤,9-15g外用：鲜品适量，捣敷。"}]},{"ID":"20240903085824-r0z6xeo","Type":"NodeParagraph","Properties":{"id":"20240903085824-r0z6xeo","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【附方】①治痢疾:耳叶牛皮消根一两。水煎服,每日一剂。(《江西草药》)②治食积饱胀:隔山消一钱。打成粉子,用开水吞服,每天一次。(贵州《常用民间草药手册》)③治胃气痛,年入未愈:隔山消二钱,万年荞一钱。打成细粉,每天三次,每次用开水吞一钱。(贵州《常用民间草药手册》)④治多年老胃病:隔山消一两,鸡屎藤五钱。炖猪肉服。(《贵阳民间药草》)⑤治气膈噎食,转食:隔山消二两,鸡肫皮一两,牛胆南星、朱砂各一两,急性子二钱。为末,炼蜜丸,小豆大。每服一钱,淡姜汤下。(《孙天仁集效方》)⑥治小儿痞块:隔山撬一两。煎水加白糖当茶喝,每日三、五次(《陕西中草药》)⑦治小儿疳疾,隔食,并能开胃健脾:隔山消、苦荞头、鸡屎藤、马蹄草、鱼鳅串、侧耳根。研末,加石柑子叶、鸡内金,蒸鸡子服。(《四川中药志》)⑧治食疟:隔山消(细末)五分,地牯牛三个(去头、脚,焙焦,研末)。混合,用米汁送下。(《贵阳民间药草》)⑨催乳:隔山撬一两。炖肉吃。(《陕西中草药》)"}]},{"ID":"20240903085824-vzqw54b","Type":"NodeParagraph","Properties":{"id":"20240903085824-vzqw54b","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240903085824-du9a3d0","Type":"NodeParagraph","Properties":{"id":"20240903085824-du9a3d0","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：主腹胀积滞。"}]},{"ID":"20240903085824-0w00dl4","Type":"NodeParagraph","Properties":{"id":"20240903085824-0w00dl4","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"2.《草木便方》：醋磨涂癣。"}]},{"ID":"20240903085824-r3wseog","Type":"NodeParagraph","Properties":{"id":"20240903085824-r3wseog","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"3.《分类草药性》：消食积,下乳,补虚弱。"}]},{"ID":"20240903085824-ahiozi9","Type":"NodeParagraph","Properties":{"id":"20240903085824-ahiozi9","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"4.《贵州民间方药集》：外用治疮毒、鱼口。"}]},{"ID":"20240903085824-aqhd5kq","Type":"NodeParagraph","Properties":{"id":"20240903085824-aqhd5kq","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"5.《陕西中草药》：滋阴养血,健脾顺气,镇静止痛,催乳。治胃痛腹胀,虚劳,肾虚腰痛,阳萎,小儿痞块,白带,乳汁不足。"}]},{"ID":"20240903085824-u6v03d8","Type":"NodeParagraph","Properties":{"id":"20240903085824-u6v03d8","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"6.《南方主要有毒植物》：治肾炎水肿,胃及十二指肠溃疡。"}]},{"ID":"20240903085824-kxubjlw","Type":"NodeParagraph","Properties":{"id":"20240903085824-kxubjlw","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"7.《江西草药》：清热解毒,顺气止痢。"}]},{"ID":"20240903085824-6j3cz1d","Type":"NodeParagraph","Properties":{"id":"20240903085824-6j3cz1d","updated":"20240903085832"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240903085826-6ies0ei","Type":"NodeThematicBreak","Properties":{"id":"20240903085826-6ies0ei","updated":"20240903085832"}},{"ID":"20240903085827-xqtgfvu","Type":"NodeParagraph","Properties":{"id":"20240903085827-xqtgfvu","updated":"20240903085832"}}]}