ng"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木贼草、问荆草、节节草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木贼草、问荆草、节节草-20240714161249-jovvokk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714173452-39ecczk","Type":"NodeParagraph","Properties":{"id":"20240714173452-39ecczk","updated":"20240714173452"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（左为木贼、中为问荆草、右为节节草）"}]},{"ID":"20240714173452-bj8ulsz","Type":"NodeParagraph","Properties":{"id":"20240714173452-bj8ulsz","updated":"20240714173452"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240714172903-02t1crj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714173452-3d6csed","Type":"NodeParagraph","Properties":{"id":"20240714173452-3d6csed","updated":"20240715081139"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：木贼、问荆草、节节草三者较为相像。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206105320-uy3iyuc","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"木贼"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240714160823-f3ouj0x","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"问荆草（问金草）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"；"}]},{"ID":"20240714173452-3tyii2y","Type":"NodeParagraph","Properties":{"id":"20240714173452-3tyii2y","updated":"20240714173452"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木贼茎节是三者之中最粗的，独立而没有分叉，偶尔出现三分之一的细分枝；木贼植株能长得很高，能达到一米甚至三米以上，又有记载戏称它为通天草；"}]},{"ID":"20240714173452-uuzu428","Type":"NodeParagraph","Properties":{"id":"20240714173452-uuzu428","updated":"20240723161131"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"节节草的茎比木贼明显细，结突出分支明显比木贼多，丛生密集，高可达一米，一年生（有的人小时候会把它的节打开，夹在眉毛头发上玩）；"}]},{"ID":"20240714173452-0e7v8zv","Type":"NodeParagraph","Properties":{"id":"20240714173452-0e7v8zv","updated":"20240723161139"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"问荆草植株成熟后分枝开始环生，非常密集，植株高度在30-50厘米，常生长在田边（传说它是吸收土壤里的金元素生长的，有它的地方就有金子）；"}]},{"ID":"20240714173452-p71h0qx","Type":"NodeParagraph","Properties":{"id":"20240714173452-p71h0qx","updated":"20240714173452"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三者无花无叶无果，都是靠顶部孢子结构繁殖；问荆草茎杆实心，其他两者是空心的；"}]},{"ID":"20240714171736-t7982zk","Type":"NodeThematicBreak","Properties":{"id":"20240714171736-t7982zk"}},{"ID":"20240714171740-b8jpgnv","Type":"NodeParagraph","Properties":{"id":"20240714171740-b8jpgnv","updated":"20240902160048"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"节节草"}]},{"ID":"20240902160045-bjbh21r","Type":"NodeParagraph","Properties":{"id":"20240902160045-bjbh21r","updated":"20240902160101"},"Children":[{"Type":"NodeText","Data":"性味归经：甘、微苦，平。"}]},{"ID":"20240902160106-htr4g53","Type":"NodeParagraph","Properties":{"id":"20240902160106-htr4g53","updated":"20240902160113"},"Children":[{"Type":"NodeText","Data":"功能主治：清热，利尿，明目退翳，祛痰止咳。用于目赤肿痛，角膜云翳，肝炎，咳嗽，支气管炎，泌尿系感染。"}]},{"ID":"20240902160046-r9nli5z","Type":"NodeThematicBreak","Properties":{"id":"20240902160046-r9nli5z","updated":"20240902160109"}},{"ID":"20240902160046-jdvv6ph","Type":"NodeParagraph","Properties":{"id":"20240902160046-jdvv6ph","updated":"20240902160109"}}]}