d":"20240902085758"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 682px;","style":"width: 672px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枇杷 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枇杷 8-20240715095024-mejkin0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 672px;\" parent-style=\"width: 682px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枇杷 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枇杷 10-20240715095119-5ynchoc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715095414-7jk1b34","Type":"NodeParagraph","Properties":{"id":"20240715095414-7jk1b34","updated":"20240715095414"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 549px;","style":"width: 539px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枇杷"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枇杷-20240715094251-q9tsyjw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 539px;\" parent-style=\"width: 549px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 550px;","style":"width: 540px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枇杷 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枇杷 5-20240715094708-liplka4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 540px;\" parent-style=\"width: 550px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715095414-kk6m3cs","Type":"NodeParagraph","Properties":{"id":"20240715095414-kk6m3cs","updated":"20240715095414"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枇杷 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枇杷 4-20240715094633-1k9d461.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715095417-11tpszr","Type":"NodeThematicBreak","Properties":{"id":"20240715095417-11tpszr"}},{"ID":"20240902085843-4gu2gdw","Type":"NodeParagraph","Properties":{"id":"20240902085843-4gu2gdw","updated":"20240902085849"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：枇杷"}]},{"ID":"20240902085843-av3f0nu","Type":"NodeParagraph","Properties":{"id":"20240902085843-av3f0nu","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"枇杷《*辞典》"}]},{"ID":"20240902085843-olgzjhx","Type":"NodeParagraph","Properties":{"id":"20240902085843-olgzjhx","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【出处】《别录》"}]},{"ID":"20240902085843-n61wb7c","Type":"NodeParagraph","Properties":{"id":"20240902085843-n61wb7c","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【拼音名】PíPá"}]},{"ID":"20240902085843-dfexjhu","Type":"NodeParagraph","Properties":{"id":"20240902085843-dfexjhu","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷薇科植物枇杷的果实。"}]},{"ID":"20240902085843-g59qxv8","Type":"NodeParagraph","Properties":{"id":"20240902085843-g59qxv8","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿小乔木，高3～8米。小枝粗壮，被锈色绒毛。单叶互生；叶片革质；长椭圆形至倒卵状披针形，长15～30厘米，宽4～7厘米，先端短尖，基部楔形，边缘有疏锯齿，上面深绿色有光泽，下面密被锈色绒毛，侧脉11～21对，直达锯齿顶端；叶柄极短或无柄；托叶2枚，大而硬，三角形，渐尖。花每数十朵聚合为顶生圆锥花序，花序有分枝，密被绒毛；苞片凿状，有褐色绒毛；花萼5浅裂，萼管短，密被绒毛；花瓣5，白色，倒卵形，内面近基部有毛；雄蕊20～25；子房下位，5室，每室有胚珠2枚，花柱5，柱头头状。果为浆果状梨果，圆形或近圆形，黄色或橙黄色；核数颗，圆形或扁圆形，棕褐色。花期9～11月。果期翌年4～5月。"}]},{"ID":"20240902085843-3m59qqn","Type":"NodeParagraph","Properties":{"id":"20240902085843-3m59qqn","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【生境分布】常栽种于村边、平地或坡地。分布陕西、甘肃、河南、江苏、浙江、安徽、福建、台湾、广东、广西、江西、湖南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240902085843-52d9edj","Type":"NodeParagraph","Properties":{"id":"20240902085843-52d9edj","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含水分90.26％，总氮2.15％，碳水化物67.30％，其中还原糖占71.31％，戊聚糖3.74％，粗纤维2.65％。果肉含脂肪，糖，蛋白质，纤维素，果胶，鞣质，灰分（钠、钾、铁、钙、磷）及维生素B1、C。又含隐黄素、β-胡萝卜素等色素。果酱含葡萄糖、果糖、蔗糖、苹果酸。"}]},{"ID":"20240902085843-i4t9osp","Type":"NodeParagraph","Properties":{"id":"20240902085843-i4t9osp","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902085843-fybxztp","Type":"NodeParagraph","Properties":{"id":"20240902085843-fybxztp","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"甘酸，凉。"}]},{"ID":"20240902085843-qpx1dlp","Type":"NodeParagraph","Properties":{"id":"20240902085843-qpx1dlp","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"①《蜀本草》：\"《图经》云，味甘酸。\""}]},{"ID":"20240902085843-10q2xnj","Type":"NodeParagraph","Properties":{"id":"20240902085843-10q2xnj","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"味甘，寒，无毒。\""}]},{"ID":"20240902085843-9cnq3ub","Type":"NodeParagraph","Properties":{"id":"20240902085843-9cnq3ub","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【归经】《本草求真》：\"入脾、肺，兼入肝。\""}]},{"ID":"20240902085843-tkyt3wk","Type":"NodeParagraph","Properties":{"id":"20240902085843-tkyt3wk","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902085843-j4meifu","Type":"NodeParagraph","Properties":{"id":"20240902085843-j4meifu","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"润肺，止渴，下气。治肺痿咳嗽吐血，衄血，燥渴，呕逆。"}]},{"ID":"20240902085843-788v8lr","Type":"NodeParagraph","Properties":{"id":"20240902085843-788v8lr","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"①孟诜：\"利五脏。\""}]},{"ID":"20240902085843-st4misj","Type":"NodeParagraph","Properties":{"id":"20240902085843-st4misj","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"②崔禹锡《食经》：\"下气，止哕呕逆。\""}]},{"ID":"20240902085843-4286o7i","Type":"NodeParagraph","Properties":{"id":"20240902085843-4286o7i","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"③《日华子》：\"治肺气，润五脏，下气。止呕逆，并渴疾。\""}]},{"ID":"20240902085843-ikcc0zp","Type":"NodeParagraph","Properties":{"id":"20240902085843-ikcc0zp","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"治肺痿痨伤吐血，咳嗽吐痰，哮吼。又治小儿惊风发热。\""}]},{"ID":"20240902085843-mgfzu5q","Type":"NodeParagraph","Properties":{"id":"20240902085843-mgfzu5q","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【注意】《随息居饮食谱》：\"多食助湿生痰，脾虚滑泄者忌之。\""}]},{"ID":"20240902085843-edu66a4","Type":"NodeParagraph","Properties":{"id":"20240902085843-edu66a4","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【各家论述】《本经逢原》：\"必极熟，乃有止渴下气润五脏之功。若带生味酸，力能助肝伐脾，食之令人中满泄泻。\""}]},{"ID":"20240902085843-62qgr6x","Type":"NodeParagraph","Properties":{"id":"20240902085843-62qgr6x","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902085843-xq913hy","Type":"NodeParagraph","Properties":{"id":"20240902085843-xq913hy","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"枇杷《中华本草》"}]},{"ID":"20240902085843-aiqej65","Type":"NodeParagraph","Properties":{"id":"20240902085843-aiqej65","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【出处】出自《名医别录》。"}]},{"ID":"20240902085843-2u0v04k","Type":"NodeParagraph","Properties":{"id":"20240902085843-2u0v04k","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【拼音名】PíPá"}]},{"ID":"20240902085843-79nlyq4","Type":"NodeParagraph","Properties":{"id":"20240902085843-79nlyq4","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【英文名】LoquatLeaf"}]},{"ID":"20240902085843-4sn5eql","Type":"NodeParagraph","Properties":{"id":"20240902085843-4sn5eql","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902085843-a44rq2q","Type":"NodeParagraph","Properties":{"id":"20240902085843-a44rq2q","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物枇杷的果实。"}]},{"ID":"20240902085843-av67jxm","Type":"NodeParagraph","Properties":{"id":"20240902085843-av67jxm","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Eriobotryajaponica(Thunb.)Lindl.[MespilusjaponicaThunb.]"}]},{"ID":"20240902085843-26yrc54","Type":"NodeParagraph","Properties":{"id":"20240902085843-26yrc54","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"采收和储藏：枇杷果实因成熟不一致，宜分次采收。"}]},{"ID":"20240902085843-wil3b10","Type":"NodeParagraph","Properties":{"id":"20240902085843-wil3b10","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【原形态】枇杷常绿小乔木，高约10m。小枝粗壮，黄褐色，密生锈色或灰棕色绒毛。叶片革质；叶柄短或几无柄，长6-10mm，有灰棕色绒毛；托叶钻形，有毛；叶片披针形、倒披针形、倒卵形或长椭圆形，长12-30cm，宽3-9cm，先端急尖或渐尖，基部楔形或渐狭成叶柄，上部边缘有疏锯齿，上面光亮、多皱，下面及叶脉密生灰棕色绒毛，侧脉11-21对，圆锥花序顶生，总花梗和花梗密生锈色绒毛；花直径1.2-2cm；萼筒浅杯状，萼片三角卵形，外面有锈色绒毛；花瓣白色，长圆形或卵形，长5-9mm，宽4-6mm，基部具爪，有锈色绒毛；雄蕊20，花柱5，离生，柱头头状，无毛。果实球形或长圆形，直径3-5cm，黄色或橘黄色；种子1-5颗，球形或扁球形，直径1-1.5cm，褐色，光亮，种皮纸质。花期10-12月。果期翌年5-6月。"}]},{"ID":"20240902085843-rs74cec","Type":"NodeParagraph","Properties":{"id":"20240902085843-rs74cec","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902085843-gf28dnw","Type":"NodeParagraph","Properties":{"id":"20240902085843-gf28dnw","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"生态环境：常栽种于村边、平地或坡地。"}]},{"ID":"20240902085843-bldmcg4","Type":"NodeParagraph","Properties":{"id":"20240902085843-bldmcg4","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于中南及陕西、甘肃、江苏、安徽、浙江、江西、福建、台湾、四川、贵州、云南等地。"}]},{"ID":"20240902085843-jtviktv","Type":"NodeParagraph","Properties":{"id":"20240902085843-jtviktv","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【性状】果实圆形或椭圆形，直径2-5cm，外果皮黄色或橙黄色，具柔毛，顶部具黑色宿存萼齿，除去萼齿可见一小空室。基部有短果柄，具糙毛。外果皮薄，中果皮肉质，厚3-7mm，内果皮纸膜质，棕色，内有1至多颗种子。气微清香，味甘、酸。"}]},{"ID":"20240902085843-twxc5ux","Type":"NodeParagraph","Properties":{"id":"20240902085843-twxc5ux","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240902085843-ii9xvtf","Type":"NodeParagraph","Properties":{"id":"20240902085843-ii9xvtf","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"果实含隐黄质(cryptoxanthin)，新-β-胡罗卜素(neo-β-carotene)及DL-乳酸(DL-lacticacid)及酒石酸(tartaricacid)，未成熟果实含转化糖，蔗糖(sucrose)，游离枸橼酸(citricacid)，苹果酸(malicacid)，成熟果实含转化糖，蔗糖，苹果酸。此外尚含有果胶(pectin)3.3%，戊糖，苹果酸，琥珀酸(succinicacid)，氧化酶，淀粉酶，苦杏仁酶及转化梅。"}]},{"ID":"20240902085843-xcu3afj","Type":"NodeParagraph","Properties":{"id":"20240902085843-xcu3afj","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"果肉及果皮还含有六氢西红柿烃(phytofluene)，顺式-新-β-胡萝卜素，β-胡萝卜素，γ-胡萝卜素，β-胡萝卜素氧化物(mutatochrome)，隐黄质5，6，5'，6'-二氧化物(cryptoxanthin5，6，5'6'-diepoxide)，隐黄质5，6-环氧化物(cryptoxanthin5，6-epoxide)，隐黄质，隐黄质5，6，5ˊ，8ˊ-二环氧化物(cryptoxanthin5，6，5ˊ，8ˊ-diepoxide)，隐黄素(cryptoflavin)，叶黄素(lutein)，顺-叶黄素(cislutein)，异叶黄素(isolutein)，堇黄质(violaxanthin)，菊黄质(crysanthemxanthin)，黄体呋喃素(luteoxanthin)，新黄素(neoxanthin)。"}]},{"ID":"20240902085843-gt1591m","Type":"NodeParagraph","Properties":{"id":"20240902085843-gt1591m","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【性味】甘、酸；凉；无毒"}]},{"ID":"20240902085843-pwt2orv","Type":"NodeParagraph","Properties":{"id":"20240902085843-pwt2orv","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肺；肝经"}]},{"ID":"20240902085843-48zufdr","Type":"NodeParagraph","Properties":{"id":"20240902085843-48zufdr","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【功能主治】润肺下气；止渴。主肺热咳喘，吐逆，烦渴"}]},{"ID":"20240902085843-mmayghy","Type":"NodeParagraph","Properties":{"id":"20240902085843-mmayghy","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：生食或煎汤，30-60g。"}]},{"ID":"20240902085843-et0lf83","Type":"NodeParagraph","Properties":{"id":"20240902085843-et0lf83","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【注意】《随息居饮食谱》：多食助湿生痰，脾虚滑泄者忌之。"}]},{"ID":"20240902085843-1xv5wkq","Type":"NodeParagraph","Properties":{"id":"20240902085843-1xv5wkq","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902085843-8mzkpfb","Type":"NodeParagraph","Properties":{"id":"20240902085843-8mzkpfb","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"1.《本经逢原》：必极熟，乃有止渴下气润五脏之功。若带生味酸，力能助肝伐脾，食之令人中满泄泻。"}]},{"ID":"20240902085843-luvumzp","Type":"NodeParagraph","Properties":{"id":"20240902085843-luvumzp","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"2.孟诜：利五脏。"}]},{"ID":"20240902085843-osckmnn","Type":"NodeParagraph","Properties":{"id":"20240902085843-osckmnn","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"3.崔禹锡《食经》：下气，止哕呕逆。"}]},{"ID":"20240902085843-6h946gx","Type":"NodeParagraph","Properties":{"id":"20240902085843-6h946gx","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"4.《日华子》：治肺气，润五脏，下气，止呕逆，并渴疾。"}]},{"ID":"20240902085843-nd3p4li","Type":"NodeParagraph","Properties":{"id":"20240902085843-nd3p4li","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：治肺痿痨伤吐血，咳嗽吐痰，哮吼。又治小儿惊风发热。"}]},{"ID":"20240902085843-llhu7gx","Type":"NodeParagraph","Properties":{"id":"20240902085843-llhu7gx","updated":"20240902085852"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902085844-myn4afu","Type":"NodeThematicBreak","Properties":{"id":"20240902085844-myn4afu","updated":"20240902085852"}},{"ID":"20240902085845-4kagukn","Type":"NodeParagraph","Properties":{"id":"20240902085845-4kagukn","updated":"20240902085852"}}]}