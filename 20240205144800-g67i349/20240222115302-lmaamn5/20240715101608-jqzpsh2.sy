\" parent-style=\"width: 444px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 780px;","style":"width: 770px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 9-20240715103216-qh17hc7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 770px;\" parent-style=\"width: 780px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715102751-ylw9zio","Type":"NodeParagraph","Properties":{"id":"20240715102751-ylw9zio","updated":"20240715102809"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 4-20240715102751-z4xgukg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 780px;","style":"width: 770px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 5-20240715102809-ws9zax4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 770px;\" parent-style=\"width: 780px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715104019-q6hg4so","Type":"NodeParagraph","Properties":{"id":"20240715104019-q6hg4so","updated":"20240715104302"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 16-20240715104046-dq348s2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 827px;","style":"width: 817px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 17-20240715104302-rsaeyph.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 817px;\" parent-style=\"width: 827px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715104305-xuhjzly","Type":"NodeThematicBreak","Properties":{"id":"20240715104305-xuhjzly"}},{"ID":"20240902090851-2jmp7lp","Type":"NodeParagraph","Properties":{"id":"20240902090851-2jmp7lp","updated":"20240902090854"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柠檬"}]},{"ID":"20240902090845-07k7038","Type":"NodeParagraph","Properties":{"id":"20240902090845-07k7038","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"黎檬子（《东坡志林》），黎朦子（《桂海虞衡志》），黎檬子（《岭外代答》），宜母子、里木子、梨橡干（《事物绀珠》），药果（《广东新语》），檬子、梦子（《通雅》），宜蒙子、宜母果（《岭南杂记》），柠果（《南宁市药物志》）。"}]},{"ID":"20240902090845-t7keno6","Type":"NodeParagraph","Properties":{"id":"20240902090845-t7keno6","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"《岭南采药录》"}]},{"ID":"20240902090845-7iu53ju","Type":"NodeParagraph","Properties":{"id":"20240902090845-7iu53ju","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"为芸香科植物黎檬或洋柠檬的果实。"}]},{"ID":"20240902090845-gabbzcy","Type":"NodeParagraph","Properties":{"id":"20240902090845-gabbzcy","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"①黎檬又名:里木树（《粤语》）。"}]},{"ID":"20240902090845-4qtjyp8","Type":"NodeParagraph","Properties":{"id":"20240902090845-4qtjyp8","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"丛生性秃净灌木，具坚硬棘刺。叶互生，小形，矩圆形至椭圆状矩圆形，先端短尖或钝，边缘有钝锯齿；叶柄短，有狭边，顶端有节。花单生或簇生于叶腋内；萼5裂，杯状；花冠5瓣，线状矩圆形，下部渐狭，外面淡紫色，内面白色；雄蕊20以上；子房上部渐狭，8～10室，花柱大，脱落，每室有胚珠数颗。柑果近圆形，先端有不发育的乳头状突起，长约4.5厘米，宽约5厘米，黄色至朱红色，皮薄易剥，且有粘土味，瓤囊8～10瓣，味极酸。种子3～4颗，卵形。花期春季。"}]},{"ID":"20240902090845-53gdno7","Type":"NodeParagraph","Properties":{"id":"20240902090845-53gdno7","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"我国南部有栽培。"}]},{"ID":"20240902090845-rilu2xb","Type":"NodeParagraph","Properties":{"id":"20240902090845-rilu2xb","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"②洋柠檬"}]},{"ID":"20240902090845-5zjaxto","Type":"NodeParagraph","Properties":{"id":"20240902090845-5zjaxto","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"常绿小乔木。有坚硬的棘针。叶互生，革质，有半透明的油点；叶片小，长椭圆形至椭圆状卵形，长7～11厘米，宽3～4厘米，先端尖，边缘微呈钝齿状，叶基圆形；叶柄短，叶翼狭长，几与叶片连结而突出。花单生或丛生于叶腋，长1～2厘米，有香气；萼杯状，5裂齿；花冠5瓣，长椭圆形，质厚，外面粉红色，内面白色；雄蕊20或更多；雌蕊1，子房8～10室，花柱粗，常早落，柱头头状。柑果长椭圆形或卵圆形，先端有乳头状突起，长9～13.5厘米，宽4～7厘米，黄色有光泽，果皮微粗，瓤囊8～10瓣，味极酸。种子3～4粒，卵圆形，淡黄色。花期春季。"}]},{"ID":"20240902090845-y3ibmn1","Type":"NodeParagraph","Properties":{"id":"20240902090845-y3ibmn1","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"广东有栽培。"}]},{"ID":"20240902090845-1qv1li7","Type":"NodeParagraph","Properties":{"id":"20240902090845-1qv1li7","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药理作用"},{"Type":"NodeText","Data":"橙皮甙，柚皮甙有抗炎作用，参见\"柚\"条。"}]},{"ID":"20240902090845-fwrhdl4","Type":"NodeParagraph","Properties":{"id":"20240902090845-fwrhdl4","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"《桂海虞衡志》:\"味极酸。\""}]},{"ID":"20240902090845-341u3d6","Type":"NodeParagraph","Properties":{"id":"20240902090845-341u3d6","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"生津，止渴，祛暑，安胎。咽痛口干，胃脘胀气，高血压，心肌梗塞，不思饮食。"}]},{"ID":"20240902090845-2e93ngf","Type":"NodeParagraph","Properties":{"id":"20240902090845-2e93ngf","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"①《食物考》:\"浆饮渴瘳，能辟暑。孕妇宜食，能安胎。\""}]},{"ID":"20240902090845-wp9u5ac","Type":"NodeParagraph","Properties":{"id":"20240902090845-wp9u5ac","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"②《粤语》:\"以盐腌，岁久色黑，可治伤寒痰火。\""}]},{"ID":"20240902090845-4vwaxnb","Type":"NodeParagraph","Properties":{"id":"20240902090845-4vwaxnb","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"③《岭南随笔》:\"治哕。\""}]},{"ID":"20240902090845-y3gxb0x","Type":"NodeParagraph","Properties":{"id":"20240902090845-y3gxb0x","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"④《纲目拾遗》:\"腌食，下气和胃。\""}]},{"ID":"20240902090845-k22lty4","Type":"NodeParagraph","Properties":{"id":"20240902090845-k22lty4","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服:绞汁饮或生食。"}]},{"ID":"20240902090845-zy8llid","Type":"NodeParagraph","Properties":{"id":"20240902090845-zy8llid","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"①柠檬一个，马蹄十只，水煎服，每日一次，治高血压，咽痛口干。"}]},{"ID":"20240902090845-blwtdea","Type":"NodeParagraph","Properties":{"id":"20240902090845-blwtdea","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"②咸柠檬茶：柠檬煮熟，去皮晒干，装入瓷罐中，用盐适量腌制，贮藏日久者更佳，每次用一个，开水冲服。有下气，和胃，消炎作用。适用于急性胃肠炎，腹泻，呕吐，食后饱胀，呃逆等症。"}]},{"ID":"20240902090845-ly3vnm5","Type":"NodeParagraph","Properties":{"id":"20240902090845-ly3vnm5","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"③鲜柠檬肉绞汁，用小火煎煮成膏状，冷却后加入白糖粉将膏汁吸干，装瓶备用。每次服用10克，用开水冲服，每日两次，可治热病伤津口渴，中暑呕恶，以及先兆流产腹痛，胎漏下血等症。"}]},{"ID":"20240902090845-907i31a","Type":"NodeParagraph","Properties":{"id":"20240902090845-907i31a","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"④糖渍柠檬：鲜柠檬500克，去皮核切块，用白糖250克浸渍一日，用小火煎熬至水分将干时停火冷却，再加入白糖适量，装瓶备用。有生津止渴，开胃，安胎作用。经常食用，可治食欲不振，口干消渴，以及妊娠食少，呕恶等症。"}]},{"ID":"20240902090845-axwc96l","Type":"NodeParagraph","Properties":{"id":"20240902090845-axwc96l","updated":"20240902090845"},"Children":[{"Type":"NodeText","Data":"⑤柠檬露：一公斤凉开水，加入柠檬酸0.35克,食盐2克,白糖100克,复合维生素B溶液10毫升,食用香精0.2毫升,混合搅匀并盖好，贮存于冰箱内随时食用，是夏季良好的清凉饮料。"}]},{"ID":"20240902090845-2wwj93s","Type":"NodeParagraph","Properties":{"id":"20240902090845-2wwj93s","updated":"20240902090845"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录《中药大辞典》"}]},{"ID":"20240902090847-lk0wdp6","Type":"NodeThematicBreak","Properties":{"id":"20240902090847-lk0wdp6"}},{"ID":"20240902090848-28ms3i2","Type":"NodeParagraph","Properties":{"id":"20240902090848-28ms3i2"}}]}