{"ID":"20240715101608-jqzpsh2","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240715101608-jqzpsh2","title":"柠檬","type":"doc","updated":"20240902091059"},"Children":[{"ID":"20240715102656-nb078kl","Type":"NodeParagraph","Properties":{"id":"20240715102656-nb078kl","updated":"20240715102656"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 2-20240715102656-dltn2qh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715102641-nm0qdsc","Type":"NodeParagraph","Properties":{"id":"20240715102641-nm0qdsc","updated":"20240715102641"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 507px;","style":"width: 497px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 1-20240715102641-mu7z4kk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 497px;\" parent-style=\"width: 507px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715103010-dlazq6l","Type":"NodeParagraph","Properties":{"id":"20240715103010-dlazq6l","updated":"20240715103010"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 422px;","style":"width: 412px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柠檬 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柠檬 7-20240715103010-okv06q8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 412px;\" parent-style=\"width: 422px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902091059-pk