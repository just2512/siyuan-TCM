ype":"NodeLinkText","Data":"冬凌草 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 10-20240830150539-n2oljvo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 497px;","style":"width: 487px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬凌草 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 11-20240830150612-g9mxycs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 487px;\" parent-style=\"width: 497px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830145842-ybwe6ji","Type":"NodeParagraph","Properties":{"id":"20240830145842-ybwe6ji","updated":"20240830150501"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬凌草 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 6-20240830145837-ihuk45n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 856px;","style":"width: 846px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬凌草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 7-20240830145904-pstntu3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 846px;\" parent-style=\"width: 856px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830150155-8ne2jjf","Type":"NodeParagraph","Properties":{"id":"20240830150155-8ne2jjf","updated":"20240830150449"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬凌草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 9-20240830150449-9mq2472.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬凌草 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬凌草 8-20240830150152-pxzccm9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830143549-w329rgc","Type":"NodeParagraph","Properties":{"id":"20240830143549-w329rgc","updated":"20240830143645"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：冬凌草在冬天的时候会结出薄如蝉翼，形状如蝴蝶一样的冰凌片；"}]},{"ID":"20240830152144-u13lq4a","Type":"NodeParagraph","Properties":{"id":"20240830152144-u13lq4a","updated":"20240830152240"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：冬凌草老枝是灰褐色圆柱形，新枝是四棱形的，两叶对生。"}]},{"ID":"20240830143113-9nwc8zc","Type":"NodeThematicBreak","Properties":{"id":"20240830143113-9nwc8zc"}},{"ID":"20240830143136-6rfmlyc","Type":"NodeParagraph","Properties":{"id":"20240830143136-6rfmlyc","updated":"20240830143142"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：冬凌草"}]},{"ID":"20240830143136-rv649nf","Type":"NodeParagraph","Properties":{"id":"20240830143136-rv649nf","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"冬凌草《中华本草》"}]},{"ID":"20240830143136-guztnfc","Type":"NodeParagraph","Properties":{"id":"20240830143136-guztnfc","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【拼音名】DōnɡLínɡCǎo"}]},{"ID":"20240830143136-dk7x380","Type":"NodeParagraph","Properties":{"id":"20240830143136-dk7x380","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【别名】山香草、破血丹、雪花草、野藿香、六月令、山荏、冰凌草"}]},{"ID":"20240830143136-lin1g40","Type":"NodeParagraph","Properties":{"id":"20240830143136-lin1g40","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830143136-2cs3i86","Type":"NodeParagraph","Properties":{"id":"20240830143136-2cs3i86","updated":"20240830143136"},"Children":[{"Type":"NodeText","Data":"药材基源：为唇形科植物碎米桠的全草。"}]},{"ID":"20240830143136-njkmdk4","Type":"NodeParagraph","Properties":{"id":"20240830143136-njkmdk4","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收，洗净，晒干。"}]},{"ID":"20240830143136-ga09rfq","Type":"NodeParagraph","Properties":{"id":"20240830143136-ga09rfq","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【原形态】碎米桠，小灌木，高0.5-1m。根茎木质，有长纤维状须根。茎直立，基部近圆柱形，皮层纵向剥落，茎上部及分枝均四棱形，具条纹，褐色或带紫红色，密被小疏柔毛，幼枝极密被绒毛，带紫红色。叶对生；叶柄连具翅假柄在内长1-1.3cm，向上渐变短；叶片卵圆形或菱状卵圆形，长2-6cm，宽1.3-3cm，先端锐尖或渐尖，后一情况先端一齿较长，基部宽楔形，骤然渐狭下延成假翅，边缘具粗圆齿状锯齿，齿尖具胼胝体，上面疏被小疏柔毛及腺点，下面密被灰白色短绒毛至近无毛，脉纹常带紫红色。聚伞花序3-5花，在茎及分枝顶上排列成狭圆锥花序，总梗与长2-5mm的花梗及序轴密被微柔毛，但常带紫红色；苞叶菱形或菱状卵，圆形至披针形，向上渐变小，在圆锥花序下部者十分超出于聚伞花序；小苞片钻状线形或线形，被微柔毛；花萼钟形，长2.5-3mm，外密被灰色微预知毛及腺点，明显带紫红色，10脉，萼齿5，微呈3/2式二唇形，齿均卵圆状三角形，近钝尖，约占花萼长之半，上唇3齿，中齿略小，下唇2稍大而平伸，果时花萼增大；花冠长约7mm，但也有雄蕊退化的花冠变小，外疏被微柔毛及腺点，冠筒长3.5-5mm，基部上方浅囊状突起，至喉部直径2-2.5mm，冠檐二唇形，上唇外反，先端具4圆齿，下唇宽卵形内凹；雄蕊4，略伸出，或有时雄蕊退化而内藏花丝扁平，中部以下具髯毛；花柱丝状，伸出，先端相等2浅裂；花盘环状。小坚果倒卵状三棱形。花期7-10月，果期8-11月。"}]},{"ID":"20240830143136-wvwufzs","Type":"NodeParagraph","Properties":{"id":"20240830143136-wvwufzs","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830143136-pdgv3xu","Type":"NodeParagraph","Properties":{"id":"20240830143136-pdgv3xu","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡、灌木丛、林地及路边向阳处。"}]},{"ID":"20240830143136-5g7j09h","Type":"NodeParagraph","Properties":{"id":"20240830143136-5g7j09h","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于河北、山西、陕西、甘肃、安徽、浙江、江西、河南、湖北、湖南、广西、四川、贵州。"}]},{"ID":"20240830143136-ao0g9vo","Type":"NodeParagraph","Properties":{"id":"20240830143136-ao0g9vo","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830143136-0i6z19m","Type":"NodeParagraph","Properties":{"id":"20240830143136-0i6z19m","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"性状鉴别，茎基部近圆形，上部方柱形，长30-70cm。下部表面灰棕色或灰褐色，外皮纵向剥落；上部表皮红紫色，有柔撬，质硬脆，断面淡黄色。叶对生，叶片皱缩，展平后呈卵形或菱状卵形，长2-6cm，宽1.5-3cm，先端锐尖或渐尖，基部宽楔形，并骤然渐狭下延成假翅，边缘具粗锯齿，齿尖具胼胝体，上面棕绿色，有腺点，下面淡绿色，沿脉有疏柔毛；具叶柄。聚伞状圆锥花序顶生，总梗与小花梗及花序轴密被柔毛；花小；花萼钟形，萼齿5，二唇形，花冠二唇形，雄蕊4。小坚果倒卵状三棱形，淡褐色，无毛。气微香，味苦、甘。"}]},{"ID":"20240830143136-da8vdfw","Type":"NodeParagraph","Properties":{"id":"20240830143136-da8vdfw","updated":"20240830143136"},"Children":[{"Type":"NodeText","Data":"以叶多、色绿者为佳。"}]},{"ID":"20240830143136-l47yq9a","Type":"NodeParagraph","Properties":{"id":"20240830143136-l47yq9a","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；甘；性微寒"}]},{"ID":"20240830143136-5wncjzv","Type":"NodeParagraph","Properties":{"id":"20240830143136-5wncjzv","updated":"20240830143136"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；活血止痛。主咽喉肿痛；感冒头痛；气管炎；慢性肝炎；风湿关节痛；蛇虫咬伤"}]},{"ID":"20240830143136-yraxoje","Type":"NodeParagraph","Properties":{"id":"20240830143136-yraxoje","updated":"20240830143143"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830143137-2643lgq","Type":"NodeThematicBreak","Properties":{"id":"20240830143137-2643lgq","updated":"20240830143143"}},{"ID":"20240830143138-qx66262","Type":"NodeParagraph","Properties":{"id":"20240830143138-qx66262","updated":"20240830143143"}}]}