yle=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-0yccldg","Type":"NodeParagraph","Properties":{"id":"20240724093153-0yccldg","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 6-20240724091245-hpqftri.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 7-20240724091305-mlhsggy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-lrq5ktv","Type":"NodeParagraph","Properties":{"id":"20240724093153-lrq5ktv","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 667px;","style":"width: 657px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 2-20240724085209-jvluplq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 657px;\" parent-style=\"width: 667px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 3-20240724085300-5p0vvze.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-khatyg8","Type":"NodeParagraph","Properties":{"id":"20240724093153-khatyg8","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 2-20240724090646-8m5ug6j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 635px;","style":"width: 625px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 4-20240724085433-w05x7l8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 625px;\" parent-style=\"width: 635px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-mnptgi5","Type":"NodeParagraph","Properties":{"id":"20240724093153-mnptgi5","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 394px;","style":"width: 384px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 5-20240724090946-q2mnh94.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 384px;\" parent-style=\"width: 394px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 778px;","style":"width: 768px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 3-20240724090756-wcokm6z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 768px;\" parent-style=\"width: 778px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-o94z79x","Type":"NodeParagraph","Properties":{"id":"20240724093153-o94z79x","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻 4-20240724090851-nktqq6i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724085801-gd3xcyg","Type":"NodeParagraph","Properties":{"id":"20240724085801-gd3xcyg","updated":"20240724085817"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：即苎麻的叶子；"}]},{"ID":"20240724085809-2zmpmbk","Type":"NodeThematicBreak","Properties":{"id":"20240724085809-2zmpmbk"}},{"ID":"20240902111836-d1fjhq5","Type":"NodeParagraph","Properties":{"id":"20240902111836-d1fjhq5","updated":"20240902111842"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：白背叶"}]},{"ID":"20240902111836-pcjhsx2","Type":"NodeParagraph","Properties":{"id":"20240902111836-pcjhsx2","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"白背叶《全国中草药汇编》"}]},{"ID":"20240902111836-44kgc4t","Type":"NodeParagraph","Properties":{"id":"20240902111836-44kgc4t","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiBèiYè"}]},{"ID":"20240902111836-nsz3us1","Type":"NodeParagraph","Properties":{"id":"20240902111836-nsz3us1","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【别名】野桐、叶下白、白背木、白背娘、白朴树、白帽顶"}]},{"ID":"20240902111836-2yrfpbh","Type":"NodeParagraph","Properties":{"id":"20240902111836-2yrfpbh","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【来源】为大戟科野桐属植物白背叶Mallotusapelta（Lour.）Muell.-Arg.以根及叶入药。根全年可采，洗净，切片，晒干。叶多鲜用，或夏、秋采集，晒干研粉。"}]},{"ID":"20240902111836-gg88uxa","Type":"NodeParagraph","Properties":{"id":"20240902111836-gg88uxa","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【性味】微苦、涩，平。"}]},{"ID":"20240902111836-190iaqe","Type":"NodeParagraph","Properties":{"id":"20240902111836-190iaqe","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【功能主治】根：柔肝活血，健脾化湿，收敛固脱。用于慢性肝炎，肝脾肿大，子宫脱垂，脱肛，白带，妊娠水肿。叶：消炎止血。外用治中耳炎，疖肿，跌打损伤，外伤出血。"}]},{"ID":"20240902111836-o2ec106","Type":"NodeParagraph","Properties":{"id":"20240902111836-o2ec106","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【用法用量】根0.5～1两；叶外用适量，鲜叶捣烂敷或干叶研粉敷患处。"}]},{"ID":"20240902111836-u20qeq6","Type":"NodeParagraph","Properties":{"id":"20240902111836-u20qeq6","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902111836-2n04b6a","Type":"NodeParagraph","Properties":{"id":"20240902111836-2n04b6a","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"白背叶《*辞典》"}]},{"ID":"20240902111836-p0aii1e","Type":"NodeParagraph","Properties":{"id":"20240902111836-p0aii1e","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【出处】《南宁市药物志》"}]},{"ID":"20240902111836-1utz5dx","Type":"NodeParagraph","Properties":{"id":"20240902111836-1utz5dx","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiBèiYè"}]},{"ID":"20240902111836-o3tpqvn","Type":"NodeParagraph","Properties":{"id":"20240902111836-o3tpqvn","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【别名】白帽顶、白膜叶（《岭南草药志》）。"}]},{"ID":"20240902111836-hb1ox6a","Type":"NodeParagraph","Properties":{"id":"20240902111836-hb1ox6a","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【来源】为大戟科植物白楸的叶。全年可采，鲜用或晒干。"}]},{"ID":"20240902111836-l1c76so","Type":"NodeParagraph","Properties":{"id":"20240902111836-l1c76so","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902111836-9yvej2f","Type":"NodeParagraph","Properties":{"id":"20240902111836-9yvej2f","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"白楸又名：白背娘、白背桐、白朴树、白泡树、白面简、白鹤树、白匏仔、白背木、白面虎、白吊栗、野桐、白面戟、木梗天青地白、白毛树、野芙蓉、白林树、橡皮柴、谷皮柴、白桃叶、白面风。"}]},{"ID":"20240902111836-z1jnuxl","Type":"NodeParagraph","Properties":{"id":"20240902111836-z1jnuxl","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"灌木或小乔木，小枝、叶柄和花序均被灰白色星状茸毛。叶互生，圆卵形，长7～17厘米，宽5～14厘米，基部近截形或短截形，具2腺点，先端渐尖，全缘或不规则3裂，有稀疏钝齿，上面近无毛，下面灰白色，密被星状茸毛，有细密棕色腺体；叶柄长1.5～8厘米，密被柔毛。花单性，雌雄异株；圆锥花序顶生或腋生，长8～25厘米，被黄褐色茸毛；雄花簇生，萼片3～4，卵形，外被密毛，内面有红色腺点，无花瓣，雄蕊多数，花丝分离；雌花单生，花萼钟状，具不等的5裂，外被星状茸毛，无花瓣，子房3室，密生星状茸毛，花柱3。蒴果近球形，密生羽毛状软刺。籽粒小，圆形，色黑而有光泽。花期6～7月。果期10～11月。"}]},{"ID":"20240902111836-v4maf27","Type":"NodeParagraph","Properties":{"id":"20240902111836-v4maf27","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山谷、村边、路旁或灌木草丛中。分布广东、广西、湖南、福建、浙江、安徽、河南等地。"}]},{"ID":"20240902111836-rp3esmk","Type":"NodeParagraph","Properties":{"id":"20240902111836-rp3esmk","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【性味】《南宁市药物志》：\"寒，无毒。\""}]},{"ID":"20240902111836-gzfo86q","Type":"NodeParagraph","Properties":{"id":"20240902111836-gzfo86q","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902111836-9co1g9y","Type":"NodeParagraph","Properties":{"id":"20240902111836-9co1g9y","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"清热，利湿，止痛，解毒，止血。治淋浊，胃痛，口疮，痔疮，溃疡，跌打损伤，蛇咬伤，外伤出血。"}]},{"ID":"20240902111836-ts52e9k","Type":"NodeParagraph","Properties":{"id":"20240902111836-ts52e9k","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"《南宁市药物志》：\"清热，利水，祛风湿，止痛。治淋浊，痔疮，跌打，蛇伤。止痒，消肿。\""}]},{"ID":"20240902111836-zveajoq","Type":"NodeParagraph","Properties":{"id":"20240902111836-zveajoq","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5～3钱。外用：研末撒或煎水洗。"}]},{"ID":"20240902111836-ecxyoxd","Type":"NodeParagraph","Properties":{"id":"20240902111836-ecxyoxd","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902111836-m8mccr6","Type":"NodeParagraph","Properties":{"id":"20240902111836-m8mccr6","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"①治胃痛呕水：白背叶草头浸男子尿一星期，取起洗净晒干。每用二两，雄鸡一只去肠杂头肺，水适量炖服，每星期一次。（《闽南民间草药》）"}]},{"ID":"20240902111836-8g66ape","Type":"NodeParagraph","Properties":{"id":"20240902111836-8g66ape","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"②治鹅口疮：白背叶适量蒸水，用消毒棉卷蘸水拭抹患处，一日三次，连抹两天。（《岭南草药志》）"}]},{"ID":"20240902111836-f478fxh","Type":"NodeParagraph","Properties":{"id":"20240902111836-f478fxh","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"③治外伤出血，溃疡：白背叶晒干，擦成棉绒样收贮，出血时取适量贴上，外加绷带固定。（《岭南草药志》）"}]},{"ID":"20240902111836-7stv78o","Type":"NodeParagraph","Properties":{"id":"20240902111836-7stv78o","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"④治皮肤湿痒：白背叶煎水洗。（《福建中草药》）"}]},{"ID":"20240902111836-y89vs3l","Type":"NodeParagraph","Properties":{"id":"20240902111836-y89vs3l","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"⑤治产后风：白背叶、艾叶，酒煎服。（江西《草药手册》）"}]},{"ID":"20240902111836-7rvyryb","Type":"NodeParagraph","Properties":{"id":"20240902111836-7rvyryb","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"⑥治溃疡：白背叶鲜叶捣烂，麻油或菜油凋敷。（江西《草药手册》）"}]},{"ID":"20240902111836-12826np","Type":"NodeParagraph","Properties":{"id":"20240902111836-12826np","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"⑦治跌打扭伤：鲜白背叶适量，捣敷。（苏医《中草药手册》）"}]},{"ID":"20240902111836-z3b94xf","Type":"NodeParagraph","Properties":{"id":"20240902111836-z3b94xf","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗慢性中耳炎:取干白背叶1两研成粗末，加水半斤，置于加盖的瓷盅内，隔水炖2小时以上，去渣，过滤，滤液内加适量防腐剂。用时先将患耳脓水洗净，药棉拭干，再滴入药液，每次3～4滴，每日3次。疗程3～15天。77例经1～12个月随访，痊愈32例，显效24例，好转21例。"}]},{"ID":"20240902111836-vg1gb5r","Type":"NodeParagraph","Properties":{"id":"20240902111836-vg1gb5r","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【备注】本植物的根（白背叶根）亦供药用，另详专条."}]},{"ID":"20240902111836-lk0es5p","Type":"NodeParagraph","Properties":{"id":"20240902111836-lk0es5p","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902111836-kmp8g8p","Type":"NodeParagraph","Properties":{"id":"20240902111836-kmp8g8p","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"白背叶《中华本草》"}]},{"ID":"20240902111836-0frpl4u","Type":"NodeParagraph","Properties":{"id":"20240902111836-0frpl4u","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【出处】出自《贵州草药》。"}]},{"ID":"20240902111836-m1hk2fa","Type":"NodeParagraph","Properties":{"id":"20240902111836-m1hk2fa","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【拼音名】BáiBèiYè"}]},{"ID":"20240902111836-ynlro60","Type":"NodeParagraph","Properties":{"id":"20240902111836-ynlro60","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【英文名】LeafofWhitebackleafMallotus"}]},{"ID":"20240902111836-5pi8rzg","Type":"NodeParagraph","Properties":{"id":"20240902111836-5pi8rzg","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【别名】白鹤叶、白面戟、白面风、白桃叶。"}]},{"ID":"20240902111836-qhzay5v","Type":"NodeParagraph","Properties":{"id":"20240902111836-qhzay5v","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902111836-zrn0qln","Type":"NodeParagraph","Properties":{"id":"20240902111836-zrn0qln","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"药材基源：为大戟科植物白背叶的叶。"}]},{"ID":"20240902111836-nanjodr","Type":"NodeParagraph","Properties":{"id":"20240902111836-nanjodr","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Mallotusapelta（Lour.）Muell.Arg.[RicinusapeltaLour.]"}]},{"ID":"20240902111836-v2i7v24","Type":"NodeParagraph","Properties":{"id":"20240902111836-v2i7v24","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，鲜用或晒干。"}]},{"ID":"20240902111836-7d9cn8j","Type":"NodeParagraph","Properties":{"id":"20240902111836-7d9cn8j","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【原形态】白背叶直立灌木或小乔木，高1.5-3m。小枝、叶柄和花序均被白色或微黄色星状绒毛，单叶互生；叶柄长1-8cm，密被白色星状毛；叶阔卵形，长4.5-23cm，宽3.5-16cm，先端渐尖，基部近截平或短截形或略呈心形，具2腺点，全缘或顶部3浅裂，有稀疏钝齿，上面绿色，被星状柔毛或近无毛，背面灰白色，密被星状绒毛，有细密红棕色腺点；掌状脉3条。花单性异株；雄花序为不分枝或分枝的穗状花序，顶生，长15-30cm，被黄褐色绒毛；雄花簇生；具短梗或近无梗；萼3-6裂，裂片卵形，不等长，外面被密毛，内面有红色腺点。镊合状排列；无花瓣；花盘无腺体；雄蕊多数，花丝分离，花药2室；雌穗状花序不分枝，顶生或侧生，略比雄花序短，约15cm，果时圆柱状；雌花单生；无柄；花萼钟状，3-5裂，裂片卵形，长3-4mm，外被星状绒毛；无花瓣；子房有软刺，刺上密生星状柔毛，3-4室，花柱3，短，基部连合，被皮刺及稠密星状毛。果序圆柱形，长2.5-15cm以上，直径2-3cm；蒴果近球形，密被羽状软刺和灰白色或淡黄色星状绒毛，软刺长2-6mm，种子近球形，黑色，光亮。花期4-7月，果期8-11月。"}]},{"ID":"20240902111836-fafptgk","Type":"NodeParagraph","Properties":{"id":"20240902111836-fafptgk","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902111836-eptmfaj","Type":"NodeParagraph","Properties":{"id":"20240902111836-eptmfaj","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"生态环境：生于山坡路旁灌丛中或林缘。"}]},{"ID":"20240902111836-ii7hkxt","Type":"NodeParagraph","Properties":{"id":"20240902111836-ii7hkxt","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、江苏、安徽、浙江、江西、福建、河南、湖南、广东、海南、广西、贵州、云南等地。"}]},{"ID":"20240902111836-k44w9y7","Type":"NodeParagraph","Properties":{"id":"20240902111836-k44w9y7","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别单叶互生，具长柄；叶片圆卵形，长7-12cm，宽5-14cm，先端渐尖，基部近截形或短截形，具2腺点，全缘或不规则3浅裂，上面近无毛，下面灰白色，密被星状毛，有细密棕色腺点。气微，味苦、涩。"}]},{"ID":"20240902111836-7n1tey4","Type":"NodeParagraph","Properties":{"id":"20240902111836-7n1tey4","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；性平"}]},{"ID":"20240902111836-w91x1a2","Type":"NodeParagraph","Properties":{"id":"20240902111836-w91x1a2","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾经"}]},{"ID":"20240902111836-iqpdbu0","Type":"NodeParagraph","Properties":{"id":"20240902111836-iqpdbu0","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热；解毒；祛湿；止血。主蜂窝组织炎；化脓性中耳炎；鹅口疮；湿疹；跌打损伤；外伤出血"}]},{"ID":"20240902111836-51qmdpj","Type":"NodeParagraph","Properties":{"id":"20240902111836-51qmdpj","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【用法用量】外用：适量，捣敷；研末撒；或煎水洗。内服：煎汤，1.5-9g。"}]},{"ID":"20240902111836-equqvo6","Type":"NodeParagraph","Properties":{"id":"20240902111836-equqvo6","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902111836-rkh9516","Type":"NodeParagraph","Properties":{"id":"20240902111836-rkh9516","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"1.《贵州草药》：止血，生肌，排石。"}]},{"ID":"20240902111836-j67nbze","Type":"NodeParagraph","Properties":{"id":"20240902111836-j67nbze","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"2.《贵州药植目录》：顺气宽中，消食止痛。"}]},{"ID":"20240902111836-bmbky2p","Type":"NodeParagraph","Properties":{"id":"20240902111836-bmbky2p","updated":"20240902111841"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902111837-wv0a1xl","Type":"NodeThematicBreak","Properties":{"id":"20240902111837-wv0a1xl","updated":"20240902111841"}},{"ID":"20240902111838-igxa81u","Type":"NodeParagraph","Properties":{"id":"20240902111838-igxa81u","updated":"20240902111841"}}]}