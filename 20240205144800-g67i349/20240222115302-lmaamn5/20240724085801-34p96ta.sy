{"ID":"20240724085801-34p96ta","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240724085801-34p96ta","title":"白背叶（苎麻叶）","type":"doc","updated":"20240902111842"},"Children":[{"ID":"20240724093247-au5q31z","Type":"NodeParagraph","Properties":{"id":"20240724093247-au5q31z","updated":"20240724093247"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 536px;","style":"width: 526px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白背叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白背叶-20240724093247-b2ozgii.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 526px;\" parent-style=\"width: 536px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724093153-nquml82","Type":"NodeParagraph","Properties":{"id":"20240724093153-nquml82","updated":"20240724093153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 472px;","style":"width: 462px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 5-20240724085519-xkylk1s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 462px;\" parent-style=\"width: 472px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 495px;","style":"width: 485px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苎麻根 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苎麻根 6-20240724085619-885clht.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 485px;\" parent-style=\"width: 495px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"2024072409315