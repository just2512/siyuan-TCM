ID":"20240724161447-jr9mpmy","Type":"NodeParagraph","Properties":{"id":"20240724161447-jr9mpmy","updated":"20240724161447"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莲藕"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莲藕-20240621115734-erwam2l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 553px;","style":"width: 543px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115903-l36gque.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 543px;\" parent-style=\"width: 553px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161447-vsmoekc","Type":"NodeParagraph","Properties":{"id":"20240724161447-vsmoekc","updated":"20240724161447"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 7-20240724155706-fopuwcu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 721px;","style":"width: 711px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 8-20240724155737-t3yiio5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 711px;\" parent-style=\"width: 721px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161447-f2y7xb4","Type":"NodeParagraph","Properties":{"id":"20240724161447-f2y7xb4","updated":"20240724161447"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 6-20240724155553-f41agfl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724161449-853us6o","Type":"NodeThematicBreak","Properties":{"id":"20240724161449-853us6o"}},{"ID":"20240902170144-171xfjh","Type":"NodeParagraph","Properties":{"id":"20240902170144-171xfjh","updated":"20240902170151"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：莲子心"}]},{"ID":"20240902170144-0e0kmhs","Type":"NodeParagraph","Properties":{"id":"20240902170144-0e0kmhs","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"莲子心《中国药典》"}]},{"ID":"20240902170144-q8pbdhi","Type":"NodeParagraph","Properties":{"id":"20240902170144-q8pbdhi","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【拼音名】LiánZǐXīn"}]},{"ID":"20240902170144-lflaqk4","Type":"NodeParagraph","Properties":{"id":"20240902170144-lflaqk4","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【英文名】PLUMULANELUMBINIS"}]},{"ID":"20240902170144-vvasyai","Type":"NodeParagraph","Properties":{"id":"20240902170144-vvasyai","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【别名】莲心"}]},{"ID":"20240902170144-4prqucf","Type":"NodeParagraph","Properties":{"id":"20240902170144-4prqucf","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【来源】本品为睡莲科植物莲NelumbonuciferaGaertn.的成熟种子中间的绿色胚根（莲心）。取出，晒干。"}]},{"ID":"20240902170144-7f8ccvw","Type":"NodeParagraph","Properties":{"id":"20240902170144-7f8ccvw","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性状】本品略呈细棒状，长1～1.4cm，直径约0.2cm。幼叶绿色，一长一短，卷成箭形，先端向下反折，两幼叶间可见细小胚芽。胚根圆柱形，长约3mm，黄白色。质脆，易折断，断面有数个小孔。气微，味苦。"}]},{"ID":"20240902170144-olfy2sc","Type":"NodeParagraph","Properties":{"id":"20240902170144-olfy2sc","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902170144-09ilo12","Type":"NodeParagraph","Properties":{"id":"20240902170144-09ilo12","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末灰绿色。表皮细胞略呈长方形，壁薄。叶肉细胞壁薄，类圆形，细胞内含众多淀粉粒与绿色色素。胚根细胞呈长方形，排列整齐，壁菲薄，有的含脂肪油滴。幼叶组织中细胞间隙较大。"}]},{"ID":"20240902170144-r3bad3y","Type":"NodeParagraph","Properties":{"id":"20240902170144-r3bad3y","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加氯仿15ml，再加10％氢氧化钠溶液1ml,加热回流15分钟，滤过，滤液置水浴上蒸去氯仿，残渣加稀盐酸2ml使溶解，滤过，取滤液1ml,加碘化铋钾试液1～2滴，生成橙红色沉淀。"}]},{"ID":"20240902170144-eh7rw79","Type":"NodeParagraph","Properties":{"id":"20240902170144-eh7rw79","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒。"}]},{"ID":"20240902170144-hfyfkyw","Type":"NodeParagraph","Properties":{"id":"20240902170144-hfyfkyw","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【归经】归心、肾经。"}]},{"ID":"20240902170144-x0lqlb2","Type":"NodeParagraph","Properties":{"id":"20240902170144-x0lqlb2","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【功能主治】清心安神，交通心肾，涩精止血。用于热入心包，神昏谵语，心肾不交，失眠遗精，血热吐血。"}]},{"ID":"20240902170144-earqijb","Type":"NodeParagraph","Properties":{"id":"20240902170144-earqijb","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【用法用量】2～5g。"}]},{"ID":"20240902170144-tf62wci","Type":"NodeParagraph","Properties":{"id":"20240902170144-tf62wci","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902170144-98i9pif","Type":"NodeParagraph","Properties":{"id":"20240902170144-98i9pif","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"莲子心《*辞典》"}]},{"ID":"20240902170144-z1psn0h","Type":"NodeParagraph","Properties":{"id":"20240902170144-z1psn0h","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【出处】《食性本草》"}]},{"ID":"20240902170144-nbb4nev","Type":"NodeParagraph","Properties":{"id":"20240902170144-nbb4nev","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【拼音名】LiánZǐXīn"}]},{"ID":"20240902170144-prks6kl","Type":"NodeParagraph","Properties":{"id":"20240902170144-prks6kl","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【别名】薏（《尔雅》），苦薏（《本草图经》），莲薏（《纲目》），莲心（《本草再新》）。"}]},{"ID":"20240902170144-u5qfadv","Type":"NodeParagraph","Properties":{"id":"20240902170144-u5qfadv","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【来源】为睡莲科植物莲的成熟种子的绿色胚芽。秋季采收莲子时，从莲子中剥取，晒干。"}]},{"ID":"20240902170144-9nxr8dg","Type":"NodeParagraph","Properties":{"id":"20240902170144-9nxr8dg","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【生境分布】主产湖南、湖北、福建、江苏、浙江等地。"}]},{"ID":"20240902170144-s59e4bc","Type":"NodeParagraph","Properties":{"id":"20240902170144-s59e4bc","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性状】干燥的莲心，略成棒状，长1.2～1.6厘米。顶端膏绿色，有2个分歧，一长一短，先端反折，紧密互贴，用水浸软后展开，可见2片盾状卷曲的幼叶。中央的胚芽直立，长约2毫米。基部胚根黄绿色，略呈圆柱形，长2～4毫米。质脆，易折断，断面有多数小孔。气无，味苦。以个大、色青绿。未经煮者为佳。"}]},{"ID":"20240902170144-f6aejrc","Type":"NodeParagraph","Properties":{"id":"20240902170144-f6aejrc","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【化学成份】含莲心碱、异莲心碱、甲基莲心碱、荷叶碱、前荷叶碱、牛角花素、甲基紫堇杷灵、去甲基乌药碱。又含水犀草甙、金丝桃甙、芸香甙等黄酮类。"}]},{"ID":"20240902170144-6udjal1","Type":"NodeParagraph","Properties":{"id":"20240902170144-6udjal1","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【药理作用】降压作用、从莲子心提出莲心碱结晶，有短暂降压之效，改变为季铵盐，则出现强而持久的降压作用。氧位甲基-莲心碱硫酸甲酯季铵盐对迷走神经节阻滞作用强而持久，但并不是通过迷走神经而致持久降压；脊髓猫和狗头交叉循环试验都指出其降压机理主要是外周作用。莲子心非结晶生物碱Nn-9，具有较强降压作用。麻醉猫静脉注射1～2毫克/公斤，可降低原血压水平约50％，维持2～3小时；狗血压于半小时即恢复；兔子不降压。有快速耐受性。经进一步实验，证明此生物碱降压机理主要是释放组织胺，使外周血管扩张，其次与神经因素也有关。"}]},{"ID":"20240902170144-tde4nlf","Type":"NodeParagraph","Properties":{"id":"20240902170144-tde4nlf","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902170144-2ffni7g","Type":"NodeParagraph","Properties":{"id":"20240902170144-2ffni7g","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"苦，寒。"}]},{"ID":"20240902170144-0xyys5w","Type":"NodeParagraph","Properties":{"id":"20240902170144-0xyys5w","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"①陆玑《诗琉》：\"味甚苦。\""}]},{"ID":"20240902170144-4hgnq3l","Type":"NodeParagraph","Properties":{"id":"20240902170144-4hgnq3l","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"苦，寒，无毒。\""}]},{"ID":"20240902170144-j5bn0wf","Type":"NodeParagraph","Properties":{"id":"20240902170144-j5bn0wf","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"③《重庆堂随笔》：\"甘苦咸。\""}]},{"ID":"20240902170144-a8txiw2","Type":"NodeParagraph","Properties":{"id":"20240902170144-a8txiw2","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【归经】《本草再新》：\"入心、肺、肾三经。\""}]},{"ID":"20240902170144-oo42ynz","Type":"NodeParagraph","Properties":{"id":"20240902170144-oo42ynz","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902170144-az945qg","Type":"NodeParagraph","Properties":{"id":"20240902170144-az945qg","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"清心，去热，止血，涩精。治心烦，口渴，吐血，遗精，目赤肿痛。"}]},{"ID":"20240902170144-l2y4rys","Type":"NodeParagraph","Properties":{"id":"20240902170144-l2y4rys","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"①《食性本草》：\"生取为末，以米饮调下三钱，疗血渴疾、产后渴疾。\""}]},{"ID":"20240902170144-drj3v00","Type":"NodeParagraph","Properties":{"id":"20240902170144-drj3v00","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"止霍乱。\""}]},{"ID":"20240902170144-p7r50tn","Type":"NodeParagraph","Properties":{"id":"20240902170144-p7r50tn","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"③《大明一练志》：\"清心去热。\""}]},{"ID":"20240902170144-1a3b3k4","Type":"NodeParagraph","Properties":{"id":"20240902170144-1a3b3k4","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"泻心，坚肾。\""}]},{"ID":"20240902170144-icry46b","Type":"NodeParagraph","Properties":{"id":"20240902170144-icry46b","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"⑤《本革再新》：\"清心火，平肝火，泻脾火，降肺火。消暑除烦，生律止渴，治目红肿。\""}]},{"ID":"20240902170144-pycqr7k","Type":"NodeParagraph","Properties":{"id":"20240902170144-pycqr7k","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"⑥《随息居饮食谱》：\"敛液止汗，靖热养神，止血固精。\""}]},{"ID":"20240902170144-wu19rnk","Type":"NodeParagraph","Properties":{"id":"20240902170144-wu19rnk","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.5～1钱；或入散剂。"}]},{"ID":"20240902170144-8ujk0d9","Type":"NodeParagraph","Properties":{"id":"20240902170144-8ujk0d9","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902170144-nh6gg0b","Type":"NodeParagraph","Properties":{"id":"20240902170144-nh6gg0b","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"①治太阴温病，发汗过多，神昏谵语者：元参心三钱，莲子心五分，竹叶卷心二钱，连翘心二钱，犀角尖二钱（磨，冲），连心麦冬三钱。水煎服。（《温病条辨》情宫汤）"}]},{"ID":"20240902170144-theamne","Type":"NodeParagraph","Properties":{"id":"20240902170144-theamne","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"②治劳心吐血：莲子心、糯米。上为细末，酒调服。（《百一选方》）"}]},{"ID":"20240902170144-xu2ppcf","Type":"NodeParagraph","Properties":{"id":"20240902170144-xu2ppcf","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"③治遗精：莲子心一撮，为末，八层砂一分。每服一钱，白汤下，日二。（《医林纂要》）"}]},{"ID":"20240902170144-1c33qzn","Type":"NodeParagraph","Properties":{"id":"20240902170144-1c33qzn","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【各家论述】《温病条辨》：\"莲心，由心走肾，能使心火下通于肾，又回环上升，能使肾水上潮于心。\""}]},{"ID":"20240902170144-ol6vm93","Type":"NodeParagraph","Properties":{"id":"20240902170144-ol6vm93","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902170144-vmvr5l1","Type":"NodeParagraph","Properties":{"id":"20240902170144-vmvr5l1","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"莲子心《中华本草》"}]},{"ID":"20240902170144-nh499rt","Type":"NodeParagraph","Properties":{"id":"20240902170144-nh499rt","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【出处】出自《食性本草》"}]},{"ID":"20240902170144-iwvk8dc","Type":"NodeParagraph","Properties":{"id":"20240902170144-iwvk8dc","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【拼音名】LiánZǐXīn"}]},{"ID":"20240902170144-xjq6u22","Type":"NodeParagraph","Properties":{"id":"20240902170144-xjq6u22","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【英文名】LotusPlumule"}]},{"ID":"20240902170144-ys1z305","Type":"NodeParagraph","Properties":{"id":"20240902170144-ys1z305","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【别名】薏、苦薏、莲薏、莲心。"}]},{"ID":"20240902170144-qazxd4t","Type":"NodeParagraph","Properties":{"id":"20240902170144-qazxd4t","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902170144-qi13bww","Type":"NodeParagraph","Properties":{"id":"20240902170144-qi13bww","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"药材基源：为睡莲科植物莲NelumbonuciferaGaertn.的成熟种子中的幼叶及胚根。"}]},{"ID":"20240902170144-b18qgxl","Type":"NodeParagraph","Properties":{"id":"20240902170144-b18qgxl","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：NelumbonuciferaGaertn."}]},{"ID":"20240902170144-478svdv","Type":"NodeParagraph","Properties":{"id":"20240902170144-478svdv","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"采收和储藏：将莲子剥开，取出绿色胚（莲心），晒干。"}]},{"ID":"20240902170144-xcj8yi4","Type":"NodeParagraph","Properties":{"id":"20240902170144-xcj8yi4","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【原形态】莲多年生水生草本。根茎横生，肥厚，节间膨大，内有多数纵行通气孔洞，外生须状不定根。节上生叶，露出水面；叶柄着生于叶背中央，粗壮，圆柱形，多刺；叶片圆形，直径25-90cm，全缘或稍呈波状，上面粉绿色，下面叶脉从中央射出，有1-2次叉状分枝。花单生于花梗顶端，花梗与叶柄等长或稍长，也散生小刺；花直径10-20cm，芳香，红色、粉红色或白色；花瓣椭圆形或倒卵形，长5-10cm，宽3-5cm；雄蕊多数，花药条形，花丝细长，着生于托之一；心皮多数埋藏于膨大的花托内，子房椭圆形，花柱极短。花后结“莲蓬”，倒锥形，直径5-10cm，有小孔20-30个，每孔内含果实1枚；坚果椭圆形或卵形，长1.5-2.5cm，果皮革质，坚硬，熟时黑褐色。种子卵形，或椭圆形，长1.2-1.7cm，种皮红色或白色。花期6-8月，果期8-10月。"}]},{"ID":"20240902170144-90in7na","Type":"NodeParagraph","Properties":{"id":"20240902170144-90in7na","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902170144-pyl643z","Type":"NodeParagraph","Properties":{"id":"20240902170144-pyl643z","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"生态环境：生于水泽、池塘、湖沼或水田内，野生或栽培。"}]},{"ID":"20240902170144-2tc644f","Type":"NodeParagraph","Properties":{"id":"20240902170144-2tc644f","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"资源分布：广布于南北各地。"}]},{"ID":"20240902170144-ncpimjd","Type":"NodeParagraph","Properties":{"id":"20240902170144-ncpimjd","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别本品为莲子除去子叶的胚，略呈细棒状，绿色，长1-1.5cm，直径约2mm。其中幼叶2枚，一长一短，卷成箭形，向下反折；胚芽极小，位于两幼叶之间；胚圆柱形，长约3mm，黄白色。质脆，易折断，断面有多数小孔。气无，味极苦。"}]},{"ID":"20240902170144-7qwl16v","Type":"NodeParagraph","Properties":{"id":"20240902170144-7qwl16v","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【化学成份】莲子心含莲心碱（liensinine），异莲心碱（isoliensinine），甲基莲心碱（neferine），荷叶碱（nuciferine），前荷叶碱（pronuciferine），牛角花碱（lorusine），甲基紫堇杷灵（methylcorypalline），去甲基衡州悟乌药碱（demethylcoclaurine或higenamine），亚美罂粟碱（armepavine），莲子碱（nelumbine），4’-甲基衡州悟乌药碱(4’-methyl-N-methylcoclaurine)，此外尚含木犀草甙（galuteolin），金丝桃甙（hyperin）以及芸香甙（rutin），β-谷甾醇（β-sitosterol），β-谷甾醇脂肪酸酯（β-sitosterolfattyacidester），棕榈酸，不饱和酮酸及叶绿素（chlorophylls）等。"}]},{"ID":"20240902170144-cn7f22f","Type":"NodeParagraph","Properties":{"id":"20240902170144-cn7f22f","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902170144-3imrqhi","Type":"NodeParagraph","Properties":{"id":"20240902170144-3imrqhi","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"1.对心血管作用：莲心非晶性生物碱Nn-9对麻醉猫静脉注射1-2mg/kg，能降代血压50%，维持2-3小时；同样剂量，对狗的降压作用只能持续30分钟；对兔无降压作用，对猫和狗的降压作用有快速耐受性。Nn-9的降压机制主要是释放组胺，使外周血管扩张，其次与神经因素也有关。莲心碱10mg/kg给麻醉猫静脉注射，亦有短暂的降压作用，在10-20分钟即恢复；但如改成季铵碱则出现强而持久的降压作用。从实验结果睦，结晶性的莲心碱并非主要降压成分，而非晶性生物碱Nn-9具有较强的降压作用。甲基莲心碱30μmol/L对离体兔心乳头状肌能明显抑制收缩、肾上腺素诱发的扑克律性，延长功能性不应期，降低兴奋性；0.3mmol/L明显抑掉离体兔左心房正阶梯现象，但不翻转为负阶梯现象，其抗心律失常作用可能与其抑制Na+内流和Ca2+转运有关。甲基莲心碱5mg/kg静脉注射，能对抗肾上腺素所致兔心律失常、乌头碱所致大鼠心律失常、哇巴因所致豚鼠心律失常及结扎大鼠冠脉复灌的心失常。甲基连心碱30μmol/L使兔窦房结跨膜电位振幅(APA)及零相最大上升速率(Vmax)降低；40μmol/L可使培养的乳鼠心肌细胞跨膜电位APA、Vmax及最大舒张电位(MDP)降低，对Vmax和MDP为浓度依赖性抑制，结果表明皿基莲心碱对心肌跨膜慢Na+和/或Ca2+内流具抑制作用。甲基莲心碱10μmol/L，使仔猪浦肯野纤维跨膜电位Vmax抑制，有效不应期(ERP)延长，ERP/APD50比值增大；1-100μmol/L累积给药，呈浓度依赖的抑制Vmax，延长ERP，APD50（动作电位复极50%时程）缩短，较高浓度APD50延长，APA降低。"}]},{"ID":"20240902170144-7dptg0k","Type":"NodeParagraph","Properties":{"id":"20240902170144-7dptg0k","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"2.对平滑肌作用：去甲基衡州乌药碱则具有显着的平滑肌松弛作用。"}]},{"ID":"20240902170144-168817i","Type":"NodeParagraph","Properties":{"id":"20240902170144-168817i","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【鉴别】本品粉末1g，加乙醇冷浸过夜，滤过。滤液水浴上蒸干，残渣用1%盐酸溶液1ml溶解，滤液适当加1%盐酸溶液稀释后，加碘化铋后，加碘化铋钾试液1滴，立即有橘黄色沉淀产生。"}]},{"ID":"20240902170144-kwl6nd9","Type":"NodeParagraph","Properties":{"id":"20240902170144-kwl6nd9","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【性味】苦；寒"}]},{"ID":"20240902170144-y598z64","Type":"NodeParagraph","Properties":{"id":"20240902170144-y598z64","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【归经】心；肺；肾经"}]},{"ID":"20240902170144-4syqz4c","Type":"NodeParagraph","Properties":{"id":"20240902170144-4syqz4c","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【功能主治】清心火；平肝火，止血；固精。主神昏谵语；烦燥不眠；眩晕止赤；吐血；遗精"}]},{"ID":"20240902170144-7bele7o","Type":"NodeParagraph","Properties":{"id":"20240902170144-7bele7o","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1.5-3g；或入散剂。"}]},{"ID":"20240902170144-r2rjass","Type":"NodeParagraph","Properties":{"id":"20240902170144-r2rjass","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【附方】①治太阴温病，发汗过多，神昏谵语者：元参心三钱，莲子心五分，竹叶卷心二钱，连翘心二钱，犀角尖二钱(磨，冲)，连心麦冬三钱。水煎服。(《温病条辨》清宫汤)②治劳心吐血：莲子心、糯米。上为细末，酒调服。(《百一选方》)③治遗精：莲子心一撮，为末，入辰砂一分。每服一钱，白汤下，日二。(《医林纂要》)"}]},{"ID":"20240902170144-6nwbhov","Type":"NodeParagraph","Properties":{"id":"20240902170144-6nwbhov","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902170144-ewdpweo","Type":"NodeParagraph","Properties":{"id":"20240902170144-ewdpweo","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"1.《大明一统志》：清心去热。"}]},{"ID":"20240902170144-vtx4rq7","Type":"NodeParagraph","Properties":{"id":"20240902170144-vtx4rq7","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"2.《医林纂要》：泻心，坚肾。"}]},{"ID":"20240902170144-blhwsaz","Type":"NodeParagraph","Properties":{"id":"20240902170144-blhwsaz","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"3.《本草再新》：清心火，平肝火，泻脾火，降肺火。消暑除烦，生津止渴，治目红肿。"}]},{"ID":"20240902170144-oc3s353","Type":"NodeParagraph","Properties":{"id":"20240902170144-oc3s353","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"4.《随息居饮食谱》：敛液止汗，清热养神，止血固精。"}]},{"ID":"20240902170144-1ddnvbs","Type":"NodeParagraph","Properties":{"id":"20240902170144-1ddnvbs","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"5.《温病条辨》：莲心，由心走肾，能使心火下通于肾，又回环上升，能使肾水上潮于心。"}]},{"ID":"20240902170144-hh2jlql","Type":"NodeParagraph","Properties":{"id":"20240902170144-hh2jlql","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"6.《食性本草》：生取为末，以米饮调下三钱，疗血渴疾、产后渴疾。"}]},{"ID":"20240902170144-skg9rxa","Type":"NodeParagraph","Properties":{"id":"20240902170144-skg9rxa","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"7.《日华子本草》：止霍乱。"}]},{"ID":"20240902170144-eodld3l","Type":"NodeParagraph","Properties":{"id":"20240902170144-eodld3l","updated":"20240902170157"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902170146-scuyiig","Type":"NodeThematicBreak","Properties":{"id":"20240902170146-scuyiig","updated":"20240902170157"}},{"ID":"20240902170147-7148934","Type":"NodeParagraph","Properties":{"id":"20240902170147-7148934","updated":"20240902170157"}}]}