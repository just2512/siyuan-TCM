"Properties":{"parent-style":"width: 637px;","style":"width: 627px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 2-20240801125004-b7jh23b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 627px;\" parent-style=\"width: 637px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801125643-kcxj9qm","Type":"NodeParagraph","Properties":{"id":"20240801125643-kcxj9qm","updated":"20240801125643"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 4-20240801125213-innu2nx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 5-20240801125314-94qkqr9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 431px;","style":"width: 421px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 6-20240801125412-x60ccjv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 421px;\" parent-style=\"width: 431px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801130401-7qfnh2w","Type":"NodeParagraph","Properties":{"id":"20240801130401-7qfnh2w","updated":"20240801130942"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 374px;","style":"width: 364px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 8-20240801130830-7cz621n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 357px;","style":"width: 347px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 7-20240801130401-62gury2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 347px;\" parent-style=\"width: 357px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 441px;","style":"width: 431px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"文竹 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/文竹 10-20240801130941-vwi1bdk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801125727-h4wegwh","Type":"NodeParagraph","Properties":{"id":"20240801125727-h4wegwh","updated":"20240801125802"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：天门冬跟文竹较为相似，注意甄别；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240504154557-h3oppkt","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"022天门冬（天冬、武竹）"}]},{"ID":"20240801125812-po1zauc","Type":"NodeParagraph","Properties":{"id":"20240801125812-po1zauc","updated":"20240830170720"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：该本草较少药用，多作盆景，仅因跟天门冬相似才收录；"}]},{"ID":"20240801125728-461tswn","Type":"NodeThematicBreak","Properties":{"id":"20240801125728-461tswn"}},{"ID":"20240830170722-7va87f6","Type":"NodeParagraph","Properties":{"id":"20240830170722-7va87f6","updated":"20240830170727"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：文竹"}]},{"ID":"20240830170722-6bo6fok","Type":"NodeParagraph","Properties":{"id":"20240830170722-6bo6fok","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"文竹《全国中草药汇编》"}]},{"ID":"20240830170722-zay6u2y","Type":"NodeParagraph","Properties":{"id":"20240830170722-zay6u2y","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【拼音名】WénZhú"}]},{"ID":"20240830170722-ffygvqo","Type":"NodeParagraph","Properties":{"id":"20240830170722-ffygvqo","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【别名】小百部"}]},{"ID":"20240830170722-98kxpeb","Type":"NodeParagraph","Properties":{"id":"20240830170722-98kxpeb","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【来源】百合科文竹Asparagussetaceus（Kunth）Jessop[A.plumosusBaker]，以块根入药。"}]},{"ID":"20240830170722-17yo216","Type":"NodeParagraph","Properties":{"id":"20240830170722-17yo216","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【生境分布】各地栽培。"}]},{"ID":"20240830170722-ol9q33q","Type":"NodeParagraph","Properties":{"id":"20240830170722-ol9q33q","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【性味】甘、微苦，平。"}]},{"ID":"20240830170722-na7us3j","Type":"NodeParagraph","Properties":{"id":"20240830170722-na7us3j","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【功能主治】润肺止咳。主治肺结核咳嗽，急性支气管炎，阿米巴痢疾。"}]},{"ID":"20240830170722-n6wv04s","Type":"NodeParagraph","Properties":{"id":"20240830170722-n6wv04s","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【用法用量】块根0.2～1两，水煎服。"}]},{"ID":"20240830170722-ir5tb1g","Type":"NodeParagraph","Properties":{"id":"20240830170722-ir5tb1g","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240830170722-gc7b35n","Type":"NodeParagraph","Properties":{"id":"20240830170722-gc7b35n","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"文竹《*辞典》"}]},{"ID":"20240830170722-d1rsc82","Type":"NodeParagraph","Properties":{"id":"20240830170722-d1rsc82","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【出处】《福建民间草药》"}]},{"ID":"20240830170722-u7t8dg0","Type":"NodeParagraph","Properties":{"id":"20240830170722-u7t8dg0","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【拼音名】WénZhú"}]},{"ID":"20240830170722-h72kw6z","Type":"NodeParagraph","Properties":{"id":"20240830170722-h72kw6z","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【别名】蓬莱竹（《福建民间草药》）。"}]},{"ID":"20240830170722-61xm0tl","Type":"NodeParagraph","Properties":{"id":"20240830170722-61xm0tl","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【来源】为百合科植物文竹的全草。"}]},{"ID":"20240830170722-cr4wwec","Type":"NodeParagraph","Properties":{"id":"20240830170722-cr4wwec","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【原形态】多年生草本。根长，稍肉质。茎攀援状，本质、秃净；枝和叶状枝极多数，纤细，水平排列，状如羊齿的枝叶。主茎上的鳞状叶白色，下部有三角状刺。花小，两性，稍白色，1～3朵或4朵生于一短柄上，长约3毫米；花被钟状，6裂；雄蕊6，着生于花被基部；子房有3棱，3室，柱头3裂。浆果球形，紫黑色；有种子1～3颗。花期夏月。"}]},{"ID":"20240830170722-wwh5e9e","Type":"NodeParagraph","Properties":{"id":"20240830170722-wwh5e9e","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【生境分布】我国各地均有栽培。"}]},{"ID":"20240830170722-ygdq9lx","Type":"NodeParagraph","Properties":{"id":"20240830170722-ygdq9lx","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒。"}]},{"ID":"20240830170722-nx0sohf","Type":"NodeParagraph","Properties":{"id":"20240830170722-nx0sohf","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【功能主治】凉血解毒，利尿通淋。"}]},{"ID":"20240830170722-nsrlg3p","Type":"NodeParagraph","Properties":{"id":"20240830170722-nsrlg3p","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240830170722-w6ub43w","Type":"NodeParagraph","Properties":{"id":"20240830170722-w6ub43w","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"①治郁热咳血：文竹五至八钱。酌冲开水和冰糖炖服。"}]},{"ID":"20240830170722-khqjfk3","Type":"NodeParagraph","Properties":{"id":"20240830170722-khqjfk3","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"②治小便淋沥：文竹一两。酌加水煎，取半碗，日服两次。（性味以下出《福建民间草药》）"}]},{"ID":"20240830170722-fyj0lnm","Type":"NodeParagraph","Properties":{"id":"20240830170722-fyj0lnm","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830170722-0cd41x4","Type":"NodeParagraph","Properties":{"id":"20240830170722-0cd41x4","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"文竹《中华本草》"}]},{"ID":"20240830170722-m9oh83v","Type":"NodeParagraph","Properties":{"id":"20240830170722-m9oh83v","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【出处】出自《福建民间草药》。"}]},{"ID":"20240830170722-8q8xj3m","Type":"NodeParagraph","Properties":{"id":"20240830170722-8q8xj3m","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【拼音名】WénZhú"}]},{"ID":"20240830170722-hm8g6t3","Type":"NodeParagraph","Properties":{"id":"20240830170722-hm8g6t3","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【英文名】HerbofSetoseAsparagus"}]},{"ID":"20240830170722-zzkaoti","Type":"NodeParagraph","Properties":{"id":"20240830170722-zzkaoti","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【别名】蓬莱竹、小百部"}]},{"ID":"20240830170722-tse9zld","Type":"NodeParagraph","Properties":{"id":"20240830170722-tse9zld","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830170722-5rhl1zp","Type":"NodeParagraph","Properties":{"id":"20240830170722-5rhl1zp","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"药材基源：为百合科植物文竹的块根或全株。"}]},{"ID":"20240830170722-qxh4qoq","Type":"NodeParagraph","Properties":{"id":"20240830170722-qxh4qoq","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Asparagussetaceus(Kunth)Jessop[AsparagopsissetaceaKunth;AsparagusplumosusBak.]"}]},{"ID":"20240830170722-rc3sbke","Type":"NodeParagraph","Properties":{"id":"20240830170722-rc3sbke","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季割去蔓茎，挖出块根，去掉泥土，用水煮或蒸至皮裂，剥去外皮，切段，干燥。全株全年均可采，鲜用或晒干。"}]},{"ID":"20240830170722-jp4x1fq","Type":"NodeParagraph","Properties":{"id":"20240830170722-jp4x1fq","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【原形态】文竹，多年生攀援藤本，茎藤长可达4m。根细长，稍呈肉质。茎的分枝极多，分枝表面平滑。叶状枝常每10-13枚成簇，呈刚毛状，略具三棱，长4-5mm；叶呈鳞片状，基部有短小的刺状距或距不明显。花两性，白色，通常每1-3（偶有4）朵腋生，具短花梗；花被片倒卵状披针形，长约7mm。浆果呈小球状，直径约6-7mm，熟时紫黑色，含种子1-3颗。花期9-10月，果期冬季至翌年春季。"}]},{"ID":"20240830170722-9k6rkfc","Type":"NodeParagraph","Properties":{"id":"20240830170722-9k6rkfc","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【生境分布】在各地常见有人工栽培，原产非洲南部"}]},{"ID":"20240830170722-teiawvb","Type":"NodeParagraph","Properties":{"id":"20240830170722-teiawvb","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【栽培】生物学特性，喜温暖、湿润略荫蔽的环境，忌霜冻，怕干旱。要求土壤富含腐殖质和排水良好。栽培技术，用种子繁殖，分株繁殖亦可。种子12月至翌年4月陆续成熟。采下后即可播种，点播，间距2cm，覆土相当1颗种子厚，播后盖上薄膜，气温20度左右，待20-40d苗出齐后，去掉地膜，需搭荫棚。当幼苗长满畦面，即可分植。田间管理，栽后喷水保苗，第2d浇足透水。需搭荫棚栽培，注意保持环境湿润，每10d可施1次稀薄液肥。"}]},{"ID":"20240830170722-ptvev19","Type":"NodeParagraph","Properties":{"id":"20240830170722-ptvev19","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别根细长，稍肉质，长15-24cm，直径3-4mm。表面黄白色，有深浅不等的皱纹，并有纤细支根。质较柔韧，不易折断，断面黄白色。气微香，味苦微辛。"}]},{"ID":"20240830170722-al3aatl","Type":"NodeParagraph","Properties":{"id":"20240830170722-al3aatl","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含氨基酸：天冬氨酸（asparticacid），苏氨酸（threonine），丝氨酸（serine），谷氨酸（glutamicacid），甘氨酸（glycine），丙氨酸（alanine），缬氨酸（valine），蛋氨酸（methionine），异亮氨酸（isoleucine），赖氨酸（lysine），组氨酸（histidine），精氨酸（arginine），脯氨酸（proline），半胱氨酸（cysteine）。微量元素：钙、锰、铁、铜、锌、铬、铅。"}]},{"ID":"20240830170722-8sc22n6","Type":"NodeParagraph","Properties":{"id":"20240830170722-8sc22n6","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；微苦；性寒"}]},{"ID":"20240830170722-pg5iel8","Type":"NodeParagraph","Properties":{"id":"20240830170722-pg5iel8","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【功能主治】润肺止咳；凉血通林。主阴虚肺燥；咳嗽；咯血；小便淋沥"}]},{"ID":"20240830170722-uwq12aq","Type":"NodeParagraph","Properties":{"id":"20240830170722-uwq12aq","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-30g。"}]},{"ID":"20240830170722-4w2wyor","Type":"NodeParagraph","Properties":{"id":"20240830170722-4w2wyor","updated":"20240830170733"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830170723-5rexm6i","Type":"NodeThematicBreak","Properties":{"id":"20240830170723-5rexm6i","updated":"20240830170733"}},{"ID":"20240830170724-bi3i6pk","Type":"NodeParagraph","Properties":{"id":"20240830170724-bi3i6pk","updated":"20240830170733"}}]}