3px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 25-20240829170039-tcd17ip.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 532px;","style":"width: 522px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 5-20240829163317-1irkxgo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 522px;\" parent-style=\"width: 532px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829165126-0y73ede","Type":"NodeParagraph","Properties":{"id":"20240829165126-0y73ede","updated":"20240829165626"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 438px;","style":"width: 428px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 19-20240829165125-v039xov.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 428px;\" parent-style=\"width: 438px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 819px;","style":"width: 809px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (21)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 21-20240829165626-5nm9mag.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 809px;\" parent-style=\"width: 819px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829162558-pz55m8v","Type":"NodeThematicBreak","Properties":{"id":"20240829162558-pz55m8v"}},{"ID":"20240830161308-ul50sal","Type":"NodeParagraph","Properties":{"id":"20240830161308-ul50sal","updated":"20240830161315"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：十大功劳根"}]},{"ID":"20240830161308-g3lecms","Type":"NodeParagraph","Properties":{"id":"20240830161308-g3lecms","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"十大功劳根"}]},{"ID":"20240830161308-lzy0bw1","Type":"NodeParagraph","Properties":{"id":"20240830161308-lzy0bw1","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíDàGōnɡLáoGēn"}]},{"ID":"20240830161308-rzwyqou","Type":"NodeParagraph","Properties":{"id":"20240830161308-rzwyqou","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【别名】土黄柏、刺黄柏、刺黄芩、刺黄连、老鼠刺、土黄连。"}]},{"ID":"20240830161308-76jzb7t","Type":"NodeParagraph","Properties":{"id":"20240830161308-76jzb7t","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830161308-wp7xhfq","Type":"NodeParagraph","Properties":{"id":"20240830161308-wp7xhfq","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"药材基源：为小檗科植物阔时十大功劳、细叶十大功劳、华南十大功劳和西藏十大功劳的根。"}]},{"ID":"20240830161308-khyx7gk","Type":"NodeParagraph","Properties":{"id":"20240830161308-khyx7gk","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Mahoniabealei(Fort.)2.Mahoniafortunei(Lindl.)3.Mahoniajaponica(Thunb.)4.MahoniacalamicalisSpareetFisch."}]},{"ID":"20240830161308-shcwiw9","Type":"NodeParagraph","Properties":{"id":"20240830161308-shcwiw9","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采挖，洗净泥土，除去须根，切段，晒干，或鲜用。"}]},{"ID":"20240830161308-mxjyvic","Type":"NodeParagraph","Properties":{"id":"20240830161308-mxjyvic","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830161308-srdt29b","Type":"NodeParagraph","Properties":{"id":"20240830161308-srdt29b","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"1.阔叶十大功劳常绿灌木，高1-4m。茎表面土黄色或褐包，粗糙，断面黄色。叶互生，厚革质，具柄，基部扩大抱茎；奇数羽状复叶，长25-40cm,小叶7-15片，侧生小叶无柄，阔卵形，大小不等，长4-12cm，宽2.5-4.5cm，顶生小叶较大，有柄，先端渐尖，基部阔楔形或近圆形，边缘反卷，每边有2-8枚大的刺状锯齿，上面深绿色，有光泽，下面黄绿色。总状花序生于茎顶，直立，长5-10cm,6-9个簇生，小苞片1；萼片9，排成三；花黄褐色，花瓣6，长圆形，先端2浅裂，基部有2密腺；雄厚蕊6；雌蕊1。浆果卵圆形，直径约5mm，成熟时蓝黑色，被白粉。花期8-10月，果期10-12月。"}]},{"ID":"20240830161308-iv3ja6z","Type":"NodeParagraph","Properties":{"id":"20240830161308-iv3ja6z","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"2.细叶十大功劳常绿灌木，高1-2m。茎直立，树皮灰色，多分枝。叶互生；奇数羽状复叶；叶柄基部膨大；叶革质，小叶5-13片，狭披针形至披针，长6-12cm，宽0.7-1.5cm，先端长尖而具锐刺，基部楔形，边缘每边有刺状锯齿6-13个，上面貌一新深绿色，有光泽，叶脉不明显，下面黄绿色；叶脉自基疗3出。总状花序自枝顶牙鳞腋间抽出，长3-6cm，花梗基部具总苞，苞片卵状三角形；萼片9，花瓣状；花瓣6，黄色，长圆形，全缘；雄蕊6，花丝线形，花药瓣裂；子房卵圆形，无花柱，柱头头状。浆果卵圆形，熟果卵圆形，熟时蓝黑色，外被白粉。花期7－8月，果期8－10。"}]},{"ID":"20240830161308-uyxlpdy","Type":"NodeParagraph","Properties":{"id":"20240830161308-uyxlpdy","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"3.华南十大功劳常绿灌木，高可达4m。茎直立，分枝少，枝、茎断面为黄色。叶互生；奇数羽状复叶，长约45cm；叶厚革质，小叶7-15片，椭圆状卵形或披针形，长4-10cm，宽2.5-3.5cm，侧生小叶无柄，顶生小叶有柄，先端渐尖有尖刺，基部圆形或近截形，边缘反卷，每边有2-6个粗大刺状锯齿，齿距约1cm，上面暗灰绿色，下面暗灰黄绿色，两面叶脉不明显。总状花序下垂，长10-25cm，约10个簇生，花梗细，长6-10mm；苞片阔，披针形；萼片5，排成三轮；花黄色，6瓣，先端2裂；雄蕊6；子房内含胚珠4-5。浆果卵形，长8-9mm，直径4-5mm，暗紫色，被白粉。花期6-7月。"}]},{"ID":"20240830161308-xo0gczs","Type":"NodeParagraph","Properties":{"id":"20240830161308-xo0gczs","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"4.西藏十大功劳常绿灌木，高约1.5m。茎粗壮，断面深黄色。叶互生；奇数羽状复叶聚生茎顶，长20-35cm；小叶厚革质，9-13片，叶片卵形到披针形，长4-11.5cm，宽1.5-4.2cm，先端长尾尖，基部宽楔形，叶缘每边有4-9个粗刺锯齿，上面暗黄绿色，下面黄绿色；网脉明显。总状花序顶生，长5-9cm；萼片9，排成三轮，外轮卵形或近圆形，中轮长圆形，内轮与中轮萼片相似；花瓣黄色，6瓣，狭倒卵形，先端缺裂，基部有2枚腺体；雄蕊6，长3.5mm，子房内含胚珠4-5。浆果近球形，直径约7mm，紫黑色，被白粉，无宿存花柱。花期7月。"}]},{"ID":"20240830161308-8pjvxny","Type":"NodeParagraph","Properties":{"id":"20240830161308-8pjvxny","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830161308-74a7mb7","Type":"NodeParagraph","Properties":{"id":"20240830161308-74a7mb7","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于向阳山坡的灌丛中，也有栽培。"}]},{"ID":"20240830161308-388y1v4","Type":"NodeParagraph","Properties":{"id":"20240830161308-388y1v4","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"2.生于山坡灌丛、路边。"}]},{"ID":"20240830161308-zv6mpgz","Type":"NodeParagraph","Properties":{"id":"20240830161308-zv6mpgz","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"3.生于阴湿山坡或山谷的乔灌林下。"}]},{"ID":"20240830161308-1fhpwfi","Type":"NodeParagraph","Properties":{"id":"20240830161308-1fhpwfi","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"4.生于山坡、路边灌丛中。"}]},{"ID":"20240830161308-cqd43ef","Type":"NodeParagraph","Properties":{"id":"20240830161308-cqd43ef","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于狭西、安微、浙江、江西、福建、河南、湖北、湖南、四川等地。"}]},{"ID":"20240830161308-wdcbyhs","Type":"NodeParagraph","Properties":{"id":"20240830161308-wdcbyhs","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"2.分布于江苏、浙、江西、福建、湖北、湖南、广东等地。"}]},{"ID":"20240830161308-u7qym37","Type":"NodeParagraph","Properties":{"id":"20240830161308-u7qym37","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"3.分布于浙江、福建、台湾、广东等地。"}]},{"ID":"20240830161308-1ins73p","Type":"NodeParagraph","Properties":{"id":"20240830161308-1ins73p","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"4.分布于西藏南部及东南部。"}]},{"ID":"20240830161308-bz5k3ez","Type":"NodeParagraph","Properties":{"id":"20240830161308-bz5k3ez","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830161308-oc31hij","Type":"NodeParagraph","Properties":{"id":"20240830161308-oc31hij","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"1.阔叶十大功劳根含小檗碱(berberine)。"}]},{"ID":"20240830161308-idm1r4y","Type":"NodeParagraph","Properties":{"id":"20240830161308-idm1r4y","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"2.华南十大功劳根含异粉防己碱(isotetrandrine)，小檗碱(berberine)，掌叶防己碱(palmatine)，药根碱(iatrorrhizine)及小檗胺(berbamine)。"}]},{"ID":"20240830161308-5o38ooi","Type":"NodeParagraph","Properties":{"id":"20240830161308-5o38ooi","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【性味】苦；性寒"}]},{"ID":"20240830161308-gdm9pql","Type":"NodeParagraph","Properties":{"id":"20240830161308-gdm9pql","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【归经】脾；肝；大肠经"}]},{"ID":"20240830161308-ul0lioa","Type":"NodeParagraph","Properties":{"id":"20240830161308-ul0lioa","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热；燥湿；消肿；解毒。主湿热痢疾；腹泻；黄疸；肺痨咳血；咽喉痛；目赤肿痛；疮疡；湿疹"}]},{"ID":"20240830161308-hhkav5h","Type":"NodeParagraph","Properties":{"id":"20240830161308-hhkav5h","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，10-15g，鲜品30-60g。外用：适量，捣烂或研末调敷。"}]},{"ID":"20240830161308-60s1owp","Type":"NodeParagraph","Properties":{"id":"20240830161308-60s1owp","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者慎服。"}]},{"ID":"20240830161308-ii5rtu2","Type":"NodeParagraph","Properties":{"id":"20240830161308-ii5rtu2","updated":"20240830161315"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830161310-donk01w","Type":"NodeThematicBreak","Properties":{"id":"20240830161310-donk01w","updated":"20240830161315"}},{"ID":"20240830161327-5uikalq","Type":"NodeParagraph","Properties":{"id":"20240830161327-5uikalq","updated":"20240830161334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：十大功劳叶"}]},{"ID":"20240830161327-6h8fzdq","Type":"NodeParagraph","Properties":{"id":"20240830161327-6h8fzdq","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"十大功劳叶《*辞典》"}]},{"ID":"20240830161327-sgkbjz4","Type":"NodeParagraph","Properties":{"id":"20240830161327-sgkbjz4","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【出处】《本草再新》"}]},{"ID":"20240830161327-ighc4bu","Type":"NodeParagraph","Properties":{"id":"20240830161327-ighc4bu","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíDàGōnɡLáoYè"}]},{"ID":"20240830161327-anjhxdw","Type":"NodeParagraph","Properties":{"id":"20240830161327-anjhxdw","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【别名】功劳叶（《饮片新参》）。"}]},{"ID":"20240830161327-388utwx","Type":"NodeParagraph","Properties":{"id":"20240830161327-388utwx","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【来源】为小檗科植物阔叶十大功劳、细叶十大功劳或华南十大功劳的叶。秋季采收。"}]},{"ID":"20240830161327-10sqrfe","Type":"NodeParagraph","Properties":{"id":"20240830161327-10sqrfe","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830161327-2qb20gw","Type":"NodeParagraph","Properties":{"id":"20240830161327-2qb20gw","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"①阔叶十大功劳，又名：刺黄檗、大叶黄柏、黄柏树、皮氏黄莲竹、老鼠刺。"}]},{"ID":"20240830161327-qw3begm","Type":"NodeParagraph","Properties":{"id":"20240830161327-qw3begm","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"常绿灌木。高达4米。羽状复叶互生，长30～45厘米，小叶9～16枚，宽卵形或长卵形，长6～12厘米，先端渐尖，边缘各具2～8个大齿，基部近心形而不相等；上面绿色，下面带灰白色。总状花序丛生茎顶；花序柄粗壮，压扁，花密聚，黄色；苞片1，卵圆披针形；萼片9；花瓣6；雄蕊6，雌蕊1。浆果卵形，暗蓝色，被蜡粉。花期5～7月。果熟期11月至翌年1月。"}]},{"ID":"20240830161327-ri0mszp","Type":"NodeParagraph","Properties":{"id":"20240830161327-ri0mszp","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"生于山坡及灌丛中；也有栽培。分布我国南部、中部及华东等地。"}]},{"ID":"20240830161327-p35j8lh","Type":"NodeParagraph","Properties":{"id":"20240830161327-p35j8lh","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"②细叶十大功劳，又名：猫儿头、刀瓜山树、黄天竹、狭叶十大功劳。"}]},{"ID":"20240830161327-4hkelp1","Type":"NodeParagraph","Properties":{"id":"20240830161327-4hkelp1","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"常绿灌木。高1～2米。茎直立，多分枝，无刺。单数羽状复叶互生，小叶7～13，革质，狭披针形，长8～12厘米，先端长渐尖，基部楔形，边缘各有刺锯齿6～13个，下面灰黄绿色，但无蜡状白粉。总状花序生自枝顶芽鳞腋间，长3～5厘米；两性花黄色，多数密生，有短柄；萼片9；花瓣6；花药2瓣裂；子房上位，1室。浆果卵圆形，蓝黑色，被蜡粉。"}]},{"ID":"20240830161327-7ugs410","Type":"NodeParagraph","Properties":{"id":"20240830161327-7ugs410","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"生于山坡灌丛中；也有栽培。分布四川、湖北以及浙江等地。"}]},{"ID":"20240830161327-vvuc0tl","Type":"NodeParagraph","Properties":{"id":"20240830161327-vvuc0tl","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"⑧华南十大功劳"}]},{"ID":"20240830161327-rlw2byn","Type":"NodeParagraph","Properties":{"id":"20240830161327-rlw2byn","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"常绿灌木，高约2米。茎直立，少分枝。羽状复叶，小叶9～17枚，卵状椭圆形成长椭圆状披针形，长6～12匣米，先端呈尖刺状，基部歪斜，广楔形或截齐，边缘各具2～6个大齿。总状花序丛生枝顶；花疏松，下垂，淡黄色；花轴瘦长，小花梗基部有卵圆形的宿存苞片；萼片9，3列；花瓣6，先端2裂，基部有2蜜腺；雄蕊6，药瓣裂；雌蕊1，子房1室。浆果近球形，蓝黑色，被蜡粉。花期1～2月。果熟期5～6月。"}]},{"ID":"20240830161327-9q1sbt7","Type":"NodeParagraph","Properties":{"id":"20240830161327-9q1sbt7","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"生于山地灌丛中；也有栽培。分布于我国南部及西南各地。"}]},{"ID":"20240830161327-yyrekl5","Type":"NodeParagraph","Properties":{"id":"20240830161327-yyrekl5","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"以上3种植物的根（阔叶十大功劳、华南十大功劳的根名茨黄连，细叶十大功劳的根名刺黄柏）、茎（功劳木）、果实（功劳子）亦供药用，各详专条。"}]},{"ID":"20240830161327-4z6de86","Type":"NodeParagraph","Properties":{"id":"20240830161327-4z6de86","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830161327-ozex1eq","Type":"NodeParagraph","Properties":{"id":"20240830161327-ozex1eq","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"①阔叶十大功劳叶，呈卵状椭圆形，先端渐尖而有锐刺，基部心形或近截形而歪斜，边缘两侧各具2～8个刺状齿，齿尖向叶背微弯，上面紫绿色有光泽，下面黄绿色。质硬而脆。气微弱，味淡。"}]},{"ID":"20240830161327-309l5oc","Type":"NodeParagraph","Properties":{"id":"20240830161327-309l5oc","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"②细叶十大功劳叶，呈狭披针形，边缘两侧各具6～13个刺状齿，其他与上种相同。"}]},{"ID":"20240830161327-vbaequ8","Type":"NodeParagraph","Properties":{"id":"20240830161327-vbaequ8","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"以上药材产浙江、安徽、江西等地。"}]},{"ID":"20240830161327-n5x9zz2","Type":"NodeParagraph","Properties":{"id":"20240830161327-n5x9zz2","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"⑧华南十大功劳叶，药材性状同阔叶十大功劳叶。使用于福建、云南。"}]},{"ID":"20240830161327-zlas20d","Type":"NodeParagraph","Properties":{"id":"20240830161327-zlas20d","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"据《植物名实图考》所载十大功劳，即为上述小檗科植物。但目前仅浙江、江西等少数地区有药材，福建、广东、广西等地民间亦使用之。西藏地区所用的十大功劳叶，为西藏十大功劳的叶。至于市场上广泛使用的功劳叶，则为冬青种植物枸骨的叶。参见\"枸骨叶\"条。"}]},{"ID":"20240830161327-lf4fp4y","Type":"NodeParagraph","Properties":{"id":"20240830161327-lf4fp4y","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830161327-360gg4y","Type":"NodeParagraph","Properties":{"id":"20240830161327-360gg4y","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"华南十大功劳叶含异汉防己碱1.566％，小蘖碱0.035％，掌叶防己碱0.035％，药根碱0.087％。"}]},{"ID":"20240830161327-5ha1t9d","Type":"NodeParagraph","Properties":{"id":"20240830161327-5ha1t9d","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"细叶十大功劳、阔叶十大功劳均含小檗碱。"}]},{"ID":"20240830161327-vh8gt62","Type":"NodeParagraph","Properties":{"id":"20240830161327-vh8gt62","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【性味】《饮片新参》：\"苦，凉。\""}]},{"ID":"20240830161327-jz6ufly","Type":"NodeParagraph","Properties":{"id":"20240830161327-jz6ufly","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【归经】《本草再新》：\"入肺经。\""}]},{"ID":"20240830161327-gvohf16","Type":"NodeParagraph","Properties":{"id":"20240830161327-gvohf16","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830161327-xcx1rj6","Type":"NodeParagraph","Properties":{"id":"20240830161327-xcx1rj6","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"清热补虚，止咳化痰。治肺痨咳血，骨蒸潮热，头晕耳鸣，腰酸腿软，心烦，目赤。"}]},{"ID":"20240830161327-46ssq0c","Type":"NodeParagraph","Properties":{"id":"20240830161327-46ssq0c","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"①《本草再新》：\"治虚劳咳嗽。\""}]},{"ID":"20240830161327-q4oxn6h","Type":"NodeParagraph","Properties":{"id":"20240830161327-q4oxn6h","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"②《植物名实图考》：\"治吐血。\""}]},{"ID":"20240830161327-ng8knxv","Type":"NodeParagraph","Properties":{"id":"20240830161327-ng8knxv","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"③《饮片新参》：\"治肺劳，止咳化痰，退虚热，杀虫。\""}]},{"ID":"20240830161327-n69o45g","Type":"NodeParagraph","Properties":{"id":"20240830161327-n69o45g","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"④《现代实用中药》：\"清凉性滋养强壮药。功效与女贞子相似，适用于潮热、骨蒸、腰酸、膝软、头晕、耳鸣等证。\""}]},{"ID":"20240830161327-z394yud","Type":"NodeParagraph","Properties":{"id":"20240830161327-z394yud","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"⑤《陆川本草》：\"泻火退热。治温病发热，心烦，下利，赤眼。\""}]},{"ID":"20240830161327-b48bfy0","Type":"NodeParagraph","Properties":{"id":"20240830161327-b48bfy0","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"⑥《西藏常用中草药》：\"治湿热痢疾，目赤肿痛，痈肿疮毒。\""}]},{"ID":"20240830161327-e6szb9l","Type":"NodeParagraph","Properties":{"id":"20240830161327-e6szb9l","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～3钱。"}]},{"ID":"20240830161327-fteerre","Type":"NodeParagraph","Properties":{"id":"20240830161327-fteerre","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【附方】治风火牙痛：十大功劳叶三钱。水煎顿服。每日一剂，痛甚者服二剂。（《江西草药》）"}]},{"ID":"20240830161327-95rt0kc","Type":"NodeParagraph","Properties":{"id":"20240830161327-95rt0kc","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830161327-79c3ook","Type":"NodeParagraph","Properties":{"id":"20240830161327-79c3ook","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"十大功劳叶《中华本草》"}]},{"ID":"20240830161327-8xt867q","Type":"NodeParagraph","Properties":{"id":"20240830161327-8xt867q","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草再新》。"}]},{"ID":"20240830161327-yk18v4s","Type":"NodeParagraph","Properties":{"id":"20240830161327-yk18v4s","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShíDàGōnɡLáoYè"}]},{"ID":"20240830161327-29agwvv","Type":"NodeParagraph","Properties":{"id":"20240830161327-29agwvv","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【英文名】LeafofLeatherleafMahonia,LeafofChineseMahonia,LeafofJapaneseMahonia"}]},{"ID":"20240830161327-kr7ha0u","Type":"NodeParagraph","Properties":{"id":"20240830161327-kr7ha0u","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【别名】功劳叶"}]},{"ID":"20240830161327-ptu7hir","Type":"NodeParagraph","Properties":{"id":"20240830161327-ptu7hir","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830161327-mmsef2i","Type":"NodeParagraph","Properties":{"id":"20240830161327-mmsef2i","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"药材基源：为小檗科植物阔叶十大功劳Mahoniabealei(Fort.)Carr.的叶。"}]},{"ID":"20240830161327-ivfdufy","Type":"NodeParagraph","Properties":{"id":"20240830161327-ivfdufy","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Mahoniabealei(Fort.)2.Mahoniafortunei(Lindl.)"}]},{"ID":"20240830161327-z8aiqc7","Type":"NodeParagraph","Properties":{"id":"20240830161327-z8aiqc7","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采摘，晒干备用。"}]},{"ID":"20240830161327-f4va4fh","Type":"NodeParagraph","Properties":{"id":"20240830161327-f4va4fh","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830161327-os5aln0","Type":"NodeParagraph","Properties":{"id":"20240830161327-os5aln0","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"1.阔叶十大功劳常绿灌木，高1-4m。茎表面土黄色或褐包，粗糙，断面黄色。叶互生，厚革质，具柄，基部扩大抱茎；奇数羽状复叶，长25-40cm,小叶7-15片，侧生小叶无柄，阔卵形，大小不等，长4-12cm，宽2.5-4.5cm，顶生小叶较大，有柄，先端渐尖，基部阔楔形或近圆形，边缘反卷，每边有2-8枚大的刺状锯齿，上面深绿色，有光泽，下面黄绿色。总状花序生于茎顶，直立，长5-10cm,6-9个簇生，小苞片1；萼片9，排成三；花黄褐色，花瓣6，长圆形，先端2浅裂，基部有2密腺；雄厚蕊6；雌蕊1。浆果卵圆形，直径约5mm，成熟时蓝黑色，被白粉。花期8-10月，果期10-12月。"}]},{"ID":"20240830161327-grinfuz","Type":"NodeParagraph","Properties":{"id":"20240830161327-grinfuz","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"2.细叶十大功劳常绿灌木，高1-2m。茎直立，树皮灰色，多分枝。叶互生；奇数羽状复叶；叶柄基部膨大；叶革质，小叶5-13片，狭披针形至披针，长6-12cm，宽0.7-1.5cm，先端长尖而具锐刺，基部楔形，边缘每边有刺状锯齿6-13个，上面貌一新深绿色，有光泽，叶脉不明显，下面黄绿色；叶脉自基疗3出。总状花序自枝顶牙鳞腋间抽出，长3-6cm，花梗基部具总苞，苞片卵状三角形；萼片9，花瓣状；花瓣6，黄色，长圆形，全缘；雄蕊6，花丝线形，花药瓣裂；子房卵圆形，无花柱，柱头头状。浆果卵圆形，熟果卵圆形，熟时蓝黑色，外被白粉。花期7－8月，果期8－10。"}]},{"ID":"20240830161327-wydpgbh","Type":"NodeParagraph","Properties":{"id":"20240830161327-wydpgbh","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830161327-nqake7g","Type":"NodeParagraph","Properties":{"id":"20240830161327-nqake7g","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于向阳山坡的灌丛中，也有栽培。"}]},{"ID":"20240830161327-wxjn1e9","Type":"NodeParagraph","Properties":{"id":"20240830161327-wxjn1e9","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"2.生于山坡灌丛、路边。也有栽培于庭园。"}]},{"ID":"20240830161327-akwq37z","Type":"NodeParagraph","Properties":{"id":"20240830161327-akwq37z","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于狭西、安微、浙江、江西、福建、河南、湖北、湖南、四川等地。"}]},{"ID":"20240830161327-v3icew8","Type":"NodeParagraph","Properties":{"id":"20240830161327-v3icew8","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"2.分布于江苏、浙、江西、福建、湖北、湖南、广东等地。"}]},{"ID":"20240830161327-lj5e3ga","Type":"NodeParagraph","Properties":{"id":"20240830161327-lj5e3ga","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【栽培】阔叶十大功劳：1.气候土壤性喜凉爽，以疏松肥沃的砂质壤土或冲积土较好。2.种植用种子繁殖，育苗移栽。四川地区在3月播种。把土敲细整平，作成1.3米宽的畦为苗床。然后在畦上开成横沟，沟距25cm，深约7cm。把种子撒入，每亩约需种子40-50斤，并施猪粪水，最后盖上3cm厚细土。培育2-3年，当苗高33cm左右即可移栽，于3-4月在整好的地上，开1.3米宽的畦，按行株距各约33cm开穴，每穴1株，盖土压紧，再盖上与畦面齐平，浇水。3.追肥2次，在5、9月中除后施用。移栽后每年中耕除草2-3次，追肥1次，肥料以猪粪水为宜。"}]},{"ID":"20240830161327-1c3q7ux","Type":"NodeParagraph","Properties":{"id":"20240830161327-1c3q7ux","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240830161327-uh5lo04","Type":"NodeParagraph","Properties":{"id":"20240830161327-uh5lo04","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"1.性别鉴别叶片阔卵形，长约4-12cm，宽2.5-8cm，基部宽楔形或近圆形，不对称，先端渐尖，边缘略反卷，两侧各有2-8个刺状锯齿，上表面绿色，具光泽，下表面色浅，黄绿色；厚革质。叶柄短或无。气弱，味苦。"}]},{"ID":"20240830161327-cppx2ue","Type":"NodeParagraph","Properties":{"id":"20240830161327-cppx2ue","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"显微鉴别叶横切面：上表皮细胞1列，有的内含红棕色物质，外被角质层，厚可达8um，下表皮细胞1列，有较多气孔。上、下表皮内侧各有1-2列纤维，多角形，壁微木化。栅栏组织细胞1-3列，通过主脉。海绵组织细胞内含草酸钙方晶。主脉维管束3，外韧型，外有众多纤维环列，下方的纤维常与下表皮内侧的纤维维相连。"}]},{"ID":"20240830161327-1zfu5ra","Type":"NodeParagraph","Properties":{"id":"20240830161327-1zfu5ra","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【化学成份】"}]},{"ID":"20240830161327-9yo963m","Type":"NodeParagraph","Properties":{"id":"20240830161327-9yo963m","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"阔叶十大功劳叶含小檗碱（berberine）。同属植物细叶十大功劳叶含药根碱（jatrorrizine），小檗碱，掌叶防已碱（palmatine）及木兰花碱（magnoflorine）。"}]},{"ID":"20240830161327-c2nx9yo","Type":"NodeParagraph","Properties":{"id":"20240830161327-c2nx9yo","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"华南十大功劳叶含异粉防已碱（isotetrandrine），小檗碱，掌叶防已碱，药根碱及木兰花碱。"}]},{"ID":"20240830161327-txb89e3","Type":"NodeParagraph","Properties":{"id":"20240830161327-txb89e3","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830161327-pswurjq","Type":"NodeParagraph","Properties":{"id":"20240830161327-pswurjq","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"1.抗菌作用：阔叶十大功劳的水煎剂25%在体外对金黄色葡萄球菌、大肠杆菌、绿脓杆菌有轻度抑制作用。"}]},{"ID":"20240830161327-0knub3i","Type":"NodeParagraph","Properties":{"id":"20240830161327-0knub3i","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"2.药根碱硫氰酸盐、四氢药根碱-N一甲基硫氰酸盐、棕榈碱硫氰酸盐等生物碱在低浓度（0.001-0.002%）时能促进离体肠管的自发运动，高浓度（0.01%以上）时可导致张力上升、运动抑制。对离体蛙心，药根碱为先抑制后兴奋，掌叶防己碱则为轻度兴奋。对麻醉兔，3.血压：静脉注射此等生物碱皆可引起短暂或轻度的血压下降。对蟾蜍后肢血管无明显影响。它们的降压作用似与中枢无关（椎动脉注射时不降压，阻断颈动脉血流及闭塞气管引起之升压反射皆不受影响），亦不受阿托品的影响，但能抑制肾上腺素的升压作用。"}]},{"ID":"20240830161327-ft8289y","Type":"NodeParagraph","Properties":{"id":"20240830161327-ft8289y","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"4.在以艾氏腹水癌作体内抗癌的筛选试验中，发现其中所含成分异汉防己碱有抗癌作用。"}]},{"ID":"20240830161327-yx9qejc","Type":"NodeParagraph","Properties":{"id":"20240830161327-yx9qejc","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"5.其他：对坐骨神经、腓肠肌标本、体温、血糖等皆无作用，亦不溶血。华南十大功劳，含小檗碱，作用见黄连。"}]},{"ID":"20240830161327-yjxdozr","Type":"NodeParagraph","Properties":{"id":"20240830161327-yjxdozr","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【毒性】从细叶十大功劳中提出的3种生物碱（药根碱硫氰酸盐、四氢药根碱-N一甲基硫氰酸盐、棕榈碱硫氰酸盐）对小鼠静脉注射之半数致死量分别为0.1、0.08、0.098mg/10g。"}]},{"ID":"20240830161327-1yr9pah","Type":"NodeParagraph","Properties":{"id":"20240830161327-1yr9pah","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240830161327-j4nixer","Type":"NodeParagraph","Properties":{"id":"20240830161327-j4nixer","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"理化鉴定（1）取本品粗粉约0.1g,加1%HCL5ML，水温浸15min，滤液加碘化铋钾试剂数滴生成橙红色沉淀。"}]},{"ID":"20240830161327-mszh0kd","Type":"NodeParagraph","Properties":{"id":"20240830161327-mszh0kd","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"2.薄层色谱取本品粉末1g，加乙醇10ml,冷浸30min，时加振摇，滤过，滤液。另取盐酸小檗碱，乙醇溶解成每1ml含0.5-1mg的对照品溶液。取上述两种溶液各10ul，点于同一硅胶H-CMC薄层板上，以正丁醇-冰醋酸-水（7：1：2）展开，展距10cm，取出晾干，于254nm紫外分析灯下观察，供试品色谱在与对照品色谱相应的位置上显相同的黄色斑点。"}]},{"ID":"20240830161327-swueoi1","Type":"NodeParagraph","Properties":{"id":"20240830161327-swueoi1","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【炮制】取叶洗净，阴干备用。"}]},{"ID":"20240830161327-ox4syf6","Type":"NodeParagraph","Properties":{"id":"20240830161327-ox4syf6","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【性味】苦；寒"}]},{"ID":"20240830161327-afyzl2z","Type":"NodeParagraph","Properties":{"id":"20240830161327-afyzl2z","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【归经】肝；胃；肺；大肠经"}]},{"ID":"20240830161327-59jh4js","Type":"NodeParagraph","Properties":{"id":"20240830161327-59jh4js","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热补虚；燥湿；解毒。主肺痨咳血；骨蒸潮热；头晕耳鸣；腰酸腿软；湿热黄疸；带下；痢疾；风热感冒；目赤肿痛；痈肿疮疡"}]},{"ID":"20240830161327-wi7oeau","Type":"NodeParagraph","Properties":{"id":"20240830161327-wi7oeau","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，6-9g。外用：适量，研末调敷。"}]},{"ID":"20240830161327-b66iqd7","Type":"NodeParagraph","Properties":{"id":"20240830161327-b66iqd7","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【注意】脾胃虚寒者慎用"}]},{"ID":"20240830161327-mp5q6ei","Type":"NodeParagraph","Properties":{"id":"20240830161327-mp5q6ei","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【附方】治风火牙痛：十大功劳叶三钱。水煎顿服。每日一剂，痛甚者服二剂。(《江西草药》)"}]},{"ID":"20240830161327-5w40oss","Type":"NodeParagraph","Properties":{"id":"20240830161327-5w40oss","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【各家论述】1.《本草再新》：治虚劳咳嗽。2.《植物名实图考》：十大功劳，生广信。丛生，硬茎直黑，对叶排比，光泽而劲，锯齿如刺，梢端生长须数茎，结小实似鱼子兰。又一种，叶细长，齿短无刺，开花成簇，亦如鱼子兰。......治吐血。3.《饮片新参》：治肺劳，止咳化痰，退虚热，杀虫。4.《现代实用中药》：性滋养强壮药。功效与女贞子相似，适用于潮热、骨蒸、腰酸、膝软、头晕、耳鸣等证。5.《陆川本草》。泻火退热。治温病发热，心烦，下利，赤眼。6.《西藏常用中草药》：治湿热痢疾，目赤肿痛，痈肿疮毒。"}]},{"ID":"20240830161327-qyoh59t","Type":"NodeParagraph","Properties":{"id":"20240830161327-qyoh59t","updated":"20240830161343"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830161329-dmr3x1e","Type":"NodeThematicBreak","Properties":{"id":"20240830161329-dmr3x1e","updated":"20240830161343"}},{"ID":"20240830161330-kfutzmd","Type":"NodeParagraph","Properties":{"id":"20240830161330-kfutzmd","updated":"20240830161343"}}]}