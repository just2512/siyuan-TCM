{"ID":"20240812103742-c6vosfv","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240812103742-c6vosfv","title":"十大功劳（土黄连）","type":"doc","updated":"20240830161334"},"Children":[{"ID":"20240829163728-5jjd6mw","Type":"NodeParagraph","Properties":{"id":"20240829163728-5jjd6mw","updated":"20240829163827"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 8-20240829163728-raonql2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 630px;","style":"width: 620px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 9-20240829163827-upt5lko.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 620px;\" parent-style=\"width: 630px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829163945-0g2ypdj","Type":"NodeParagraph","Properties":{"id":"20240829163945-0g2ypdj","updated":"20240829164617"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 632px;","style":"width: 622px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"十大功劳 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/十大功劳 10-20240829163945-m30mmur.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 622px;\" parent-style=\"width: 632px;\"}"},{"Type":"NodeText","Data":"​"},{"Type"