=\"width: 394px;\" parent-style=\"width: 404px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829082005-84rua7f","Type":"NodeParagraph","Properties":{"id":"20240829082005-84rua7f","updated":"20240829082005"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为山莓"}]},{"ID":"20240829082005-em8bd95","Type":"NodeParagraph","Properties":{"id":"20240829082005-em8bd95","updated":"20240829082005"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 392px;","style":"width: 382px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山莓"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山莓-20240812092000-tnl10p9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 382px;\" parent-style=\"width: 392px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山莓 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山莓 1-20240812092049-mmaz0dk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山莓 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山莓 2-20240812092145-gc6mizd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829082005-z96gsrs","Type":"NodeParagraph","Properties":{"id":"20240829082005-z96gsrs","updated":"20240829082005"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 721px;","style":"width: 711px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蓬蘽 (22)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蓬蘽 22-20240812103556-4f3nkq1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 711px;\" parent-style=\"width: 721px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829083710-4a7k3t9","Type":"NodeParagraph","Properties":{"id":"20240829083710-4a7k3t9","updated":"20240829083731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：正宗覆盆子有5或7叶；"}]},{"ID":"20240829082001-ms9vtqv","Type":"NodeThematicBreak","Properties":{"id":"20240829082001-ms9vtqv"}},{"ID":"20240829081503-a1ce4iy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-a1ce4iy","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆《新修本草》"}]},{"ID":"20240829081503-trv87c4","Type":"NodeParagraph","Properties":{"id":"20240829081503-trv87c4","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主益气轻身，令发不白。五月采实。"}]},{"ID":"20240829081503-5bj1ud9","Type":"NodeParagraph","Properties":{"id":"20240829081503-5bj1ud9","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"蓬 是根名，方家不用，乃昌容所服，以易颜色者也。覆盆是实名，李云是莓子，乃似覆盆之形，而以津汁为味，其核甚微细。药中所用覆盆子小异。此未详熟是？"}]},{"ID":"20240829081503-6njmd7p","Type":"NodeParagraph","Properties":{"id":"20240829081503-6njmd7p","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"〔谨案〕覆盆、蓬大而甘，瘠地则子细而酸。"}]},{"ID":"20240829081503-dgddksj","Type":"NodeParagraph","Properties":{"id":"20240829081503-dgddksj","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"此乃子有甘、酸，根无酸味。陶景以根酸子甘，将根入果，重出子条，殊为孟浪。"}]},{"ID":"20240829081503-rt0ewik","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-rt0ewik","updated":"20240829081504"}},{"ID":"20240829081503-b31ytt1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-b31ytt1","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《证类本草》"}]},{"ID":"20240829081503-pdmryt0","Type":"NodeParagraph","Properties":{"id":"20240829081503-pdmryt0","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主益气轻身，令发不白。五月采。"}]},{"ID":"20240829081503-k5ocht2","Type":"NodeParagraph","Properties":{"id":"20240829081503-k5ocht2","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶蓬 是根名，方∶家不用，乃昌容所服以易颜者也。覆盆是实名，李云是莓子，乃似覆盆之形。而以津汁为味，其核微细。药中用覆盆子小异。此未详孰是？唐本注云∶覆盆，蓬 ，一物异名，本谓实，非根也。李云莓子，近之矣。其根不入药用。然生处不同，沃地则子大而甘，瘠地则子细而酸。此乃子有甘、酸，根无酸味。陶景以根酸、子甘，将根入果，重出子条，殊为孟浪。今注蓬 ，乃覆盆之苗也，覆盆，乃蓬 之子也。陶注、唐注皆非。今用覆盆子补虚续绝，强阴健阳，悦泽肌肤，安和脏腑，温中益力，疗劳损风虚，补肝明目。臣禹锡等谨按蜀本注∶李云是蓬 子也。陶云蓬 子津味，与覆盆子小异，而云未审，乃慎之至也。苏云覆盆、蓬 一物也，而云剩出此条者，亦非也。今据蓬 即莓也。按∶《切韵》莓，音茂，其子覆盆也。又按∶ 者，藤也。今此云覆盆子，则不言其蔓藤也，前云蓬，则不言其子实也。犹如芎 与蘼芜异条，附子与乌头殊用。药性论云∶覆盆子，臣，微热，味甘、辛。能主男子肾精虚竭，女子食之有子。主阴痿，能令坚长。孟诜云∶覆盆子，味酸，五月于麦田中得之良。采得及烈日晒干，免烂不堪。江东亦有，名悬钩子。大小形异，气味、功力同。北土即无悬钩，南地无覆盆，是土地有前后生，非两种物耳。陈藏器云∶榨取汁，合成膏，涂发不白。食其子，令人好颜色。叶挪绞取汁，滴目中，去肤赤，有虫出如丝线。陈士良云∶蓬 似蚕莓大，覆盆小，其苗各别。日华子云∶莓子，安五脏，益颜色，养精气，长发，强志，疗中风身热及惊。又有树莓，即是覆盆子。"}]},{"ID":"20240829081503-mpveqgz","Type":"NodeParagraph","Properties":{"id":"20240829081503-mpveqgz","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"图经文具蓬 条下。"}]},{"ID":"20240829081503-o5dgoud","Type":"NodeParagraph","Properties":{"id":"20240829081503-o5dgoud","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，用东流水淘去黄叶并皮、蒂尽了，用酒蒸一宿，以东流水淘两遍，又晒干方用，为妙也。"}]},{"ID":"20240829081503-fx3x883","Type":"NodeParagraph","Properties":{"id":"20240829081503-fx3x883","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"衍义曰∶覆盆子，长条，四、五月红熟，秦州甚多，永兴华州亦有。及时，山中人采来卖。"}]},{"ID":"20240829081503-295u6r9","Type":"NodeParagraph","Properties":{"id":"20240829081503-295u6r9","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"其味酸甘，外如荔枝。樱桃许大，软红可爱，失采则就枝生蛆。益肾脏，缩小便，服之，当覆其溺器，如此取名。食之多热，收时五、六分热便可采。烈日曝，仍须薄绵蒙之。今人取汁作煎为果，仍少加蜜，或熬为稀汤，点服，治肺虚寒。采时着水则不堪煎。"}]},{"ID":"20240829081503-e1o6rs2","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-e1o6rs2","updated":"20240829081504"}},{"ID":"20240829081503-z7r73by","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-z7r73by","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草蒙筌》"}]},{"ID":"20240829081503-iweh13b","Type":"NodeParagraph","Properties":{"id":"20240829081503-iweh13b","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"味甘，气平、微热。无毒。道傍田侧，处处有生。苗长七八寸余，实结四五颗止。"}]},{"ID":"20240829081503-zwc0jsi","Type":"NodeParagraph","Properties":{"id":"20240829081503-zwc0jsi","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"大若半弹而有蒂，（承之如柿蒂状。）微生黑毛而中虚。（去蒂中虚而白。）赤熟夏初，小儿竞采。江南咸谓 子，《本经》易名覆盆。因益肾易收小便，人服之当覆溺器。由此为誉，大能拯 。益气温中，补虚续绝。"}]},{"ID":"20240829081503-scwpm6z","Type":"NodeParagraph","Properties":{"id":"20240829081503-scwpm6z","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"安和五脏，悦泽肌肤。疗中风发热成惊，治肾伤精竭流滑。明目黑发，耐老轻身。男子久服强阴，女人多服结孕。"}]},{"ID":"20240829081503-zz02nie","Type":"NodeParagraph","Properties":{"id":"20240829081503-zz02nie","updated":"20240829081504"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"绞汁，堪滴目中。止冷泪浸淫，去赤花盲暗。"}]},{"ID":"20240829081503-kldmivc","Type":"NodeParagraph","Properties":{"id":"20240829081503-kldmivc","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"又种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇"},{"Type":"NodeText","Data":"，附地而生。苗茎仅长寸余，茎端只结一实。小而光洁，略异覆盆。下有蛇藏，切勿采食。敷蛇虫咬毒最效，疗射工溪毒亦良。仍有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蓬"},{"Type":"NodeText","Data":"，甘酸咸味。茎粗叶疏类树，枝枝有刺软柔。结实盈枝，亦熟而擎蒂中实；俗呼树 ，采食与覆盆同时。安五脏，益精气。长阴悦颜色，强志力有子。"}]},{"ID":"20240829081503-f8apuua","Type":"NodeParagraph","Properties":{"id":"20240829081503-f8apuua","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"（谟）按∶覆盆、蓬 ，本系两种。《本经》不考，妄注蓬 即是覆盆，一种二名，则甚误也。殊不知蓬 枝茎类树而粗长，结实有百千颗；覆盆枝茎是草而短小，结实仅四五枝。蓬赤熟，擎蒂中实而味酸；覆盆赤熟，蒂脱中虚而味甜。大相差殊，何得混指。故特别白，以释其疑。"}]},{"ID":"20240829081503-57s97k0","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-57s97k0","updated":"20240829081504"}},{"ID":"20240829081503-dtqb6l9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-dtqb6l9","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草述钩元》"}]},{"ID":"20240829081503-0r1zjds","Type":"NodeParagraph","Properties":{"id":"20240829081503-0r1zjds","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"其总包似盆之覆。故名。皮色青绿。剥去皮。内细子乌赤色。五月采之。（当之）惟五月熟。状如覆盆。而味甘美者。为覆盆子。余不堪入药。（藏器）蓬与覆盆。功用相近。虽是二物。其实一类也。蓬子以八九月熟。覆盆四五月熟。色皆乌赤。故能补肾。（濒湖）此类凡五种。蓬藤蔓繁衍。茎有倒刺。逐节生叶。如掌大。状类小葵。面青背白。浓而有毛。六七月开小白花。结实成簇。生青熟紫黯。微有黑毛。状如熟椹而扁。冬月苗叶不凋。以其熟于深秋。俗名割田是也。覆盆蔓小于蓬。亦有钩刺。一枝五叶。叶小而面背皆青。光薄而无毛。开白花。四五月实成。子亦小于蓬而稀疏。生青熟乌赤。冬月苗凋。以其熟于盛夏。伪名插田。即尔雅所谓缺盆也。二者俱可入药。一种蔓如覆盆。一枝三叶即莓实如覆黄花。"}]},{"ID":"20240829081503-bd036sv","Type":"NodeParagraph","Properties":{"id":"20240829081503-bd036sv","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"湖）味甘微长。女子食肾添精。缩小浊。鹤膝风。诸补肾。（嵩）同黄柏子衍宗丸。治男子精痿。临房不举。或精〔论〕覆盆蓬。二子相似。第蓬以深秋熟。冬月不凋。覆盆以盛夏熟。冬月凋。其所禀功。"}]},{"ID":"20240829081503-awm2plk","Type":"NodeParagraph","Properties":{"id":"20240829081503-awm2plk","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"又生阴谁适及始缪氏。阳强不倒者。忌服。"}]},{"ID":"20240829081503-9rk41q6","Type":"NodeParagraph","Properties":{"id":"20240829081503-9rk41q6","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"〔辨治〕上圆平底似覆盆样。去皮及心。用细子乌赤色味甘者。水洗。晒干后。酒拌。"}]},{"ID":"20240829081503-lxd35ie","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-lxd35ie","updated":"20240829081504"}},{"ID":"20240829081503-9bzup6o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-9bzup6o","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《顾松园医镜》"}]},{"ID":"20240829081503-6nfmybn","Type":"NodeParagraph","Properties":{"id":"20240829081503-6nfmybn","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"〔甘平，入肾、肺二经，去蒂酒蒸。〕起阴痿而令坚长，益肾脏而缩小便。〔故有覆盆之名。〕固涩之品，精滑者宜之。"}]},{"ID":"20240829081503-j4klbsj","Type":"NodeParagraph","Properties":{"id":"20240829081503-j4klbsj","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"小便不利者禁用。"}]},{"ID":"20240829081503-owaoi2k","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-owaoi2k","updated":"20240829081504"}},{"ID":"20240829081503-1tcp67m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-1tcp67m","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《千金翼方》"}]},{"ID":"20240829081503-dnsfr7a","Type":"NodeParagraph","Properties":{"id":"20240829081503-dnsfr7a","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主益气轻身，令发不白。五月采。"}]},{"ID":"20240829081503-0dpx1n7","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-0dpx1n7","updated":"20240829081504"}},{"ID":"20240829081503-j5t0las","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-j5t0las","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草便读》"}]},{"ID":"20240829081503-fy4bq1i","Type":"NodeParagraph","Properties":{"id":"20240829081503-fy4bq1i","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"入肾兼酸苦之功．治专固摄．益下有封藏之力．味属甘温．（覆盆子因此子形似覆盆．故名．凡藤蔓之子．皆可并入肝肾．味甘而酸之品．皆能补而兼固．此物甘酸而温．其能补摄肝肾可知．下焦固则遗滑等证皆可愈耳．覆盆入肾经血分．能温补命门．益精固下．阴不足而相火旺者不宜．）"}]},{"ID":"20240829081503-fu22w7f","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-fu22w7f","updated":"20240829081504"}},{"ID":"20240829081503-8qaqf2n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-8qaqf2n","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草从新》"}]},{"ID":"20240829081503-4269rya","Type":"NodeParagraph","Properties":{"id":"20240829081503-4269rya","updated":"20240829081504"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"温补肝肾、涩缩小便．"}]},{"ID":"20240829081503-zyuojx1","Type":"NodeParagraph","Properties":{"id":"20240829081503-zyuojx1","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"甘酸而温．益肾脏而固精．补肝虚而明目．起阳痿．缩小便．（寇宗 曰∶服之可覆其溺器、故名、李当之曰∶子似覆盆之形、因名之．）续绝伤．美颜色．乌须发．（捣汁涂发、不白．）女子多孕．同蜜为膏．治肺气虚寒．（李士材曰∶强肾无燥热之偏、固精无凝滞之害、金玉之品也．）性固涩．小便不利者勿服．去蒂淘净．捣饼．用时酒拌蒸．叶绞汁．滴目中．出目弦虫．除肤赤．收湿止泪． 疮溃烂、酸浆水洗后、覆盆叶为末掺之、日一次、以愈为度．）"}]},{"ID":"20240829081503-2zokrb9","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-2zokrb9","updated":"20240829081504"}},{"ID":"20240829081503-02vg8xj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-02vg8xj","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草撮要》"}]},{"ID":"20240829081503-fajqiyb","Type":"NodeParagraph","Properties":{"id":"20240829081503-fajqiyb","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"味甘．入足少阴经．功专益肾精．缩小便．得肉苁蓉、补骨脂治阳气不起．同蜜为膏．治肺气虚寒．小便不利者勿服．用宜去蒂．淘净．捣饼酒拌蒸．叶绞汁滴目中出目弦虫．除肤赤．收湿止泪． 疮溃烂．酸浆水洗后．以覆盆叶为末掺之良．"}]},{"ID":"20240829081503-9n7n1rq","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-9n7n1rq","updated":"20240829081504"}},{"ID":"20240829081503-8fr137n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-8fr137n","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草纲目》"}]},{"ID":"20240829081503-2web5xl","Type":"NodeParagraph","Properties":{"id":"20240829081503-2web5xl","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"「释名」奎、西国草、毕楞伽、大麦莓、插田包、乌包子。"}]},{"ID":"20240829081503-f9sct5q","Type":"NodeParagraph","Properties":{"id":"20240829081503-f9sct5q","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"「气味」甘、平、无毒。"}]},{"ID":"20240829081503-bblw3vx","Type":"NodeParagraph","Properties":{"id":"20240829081503-bblw3vx","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"「主治」益肾脏，治阳痿，缩小便，补肚明目（叶亦有明目作用）"}]},{"ID":"20240829081503-vc4q6on","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-vc4q6on","updated":"20240829081504"}},{"ID":"20240829081503-9a8fx4l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-9a8fx4l","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《冯氏锦囊秘录》"}]},{"ID":"20240829081503-7g0osnm","Type":"NodeParagraph","Properties":{"id":"20240829081503-7g0osnm","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"得木气而生，味甘、酸，气温，无毒。入足少阴经。补虚续绝，强阴健阳，添精益气，精滑能固，阴痿能强，悦泽肌肤，安和脏腑，长发强志，即有补益之功，复多收敛之义。名为覆盆者，服之能使尿盆皆覆也。同车前、五味、菟丝子、蒺藜，为五子衍宗丸，治男子精气亏乏，中年无子。加入巴戟天、腽肭脐、补骨脂、鹿茸、白胶、山茱萸、肉苁蓉，治阳虚阴痿，临房不举，精寒精薄，宜去蒂酒煮用。"}]},{"ID":"20240829081503-c4fjfxr","Type":"NodeParagraph","Properties":{"id":"20240829081503-c4fjfxr","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"覆盆子，益肾脏而固精，补肝虚而明目，起阳痿缩小便。专治肾伤精竭流滑，用之强阴固涩，以助闭蛰封藏，女人多服，结孕亦温，补肝肾之力欤！"}]},{"ID":"20240829081503-ow539mp","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-ow539mp","updated":"20240829081504"}},{"ID":"20240829081503-ve9oefa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-ve9oefa","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草求真》"}]},{"ID":"20240829081503-y908dz8","Type":"NodeParagraph","Properties":{"id":"20240829081503-y908dz8","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"（蔓草）涩精固脱"}]},{"ID":"20240829081503-w8gs7mj","Type":"NodeParagraph","Properties":{"id":"20240829081503-w8gs7mj","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"覆盆子（专入肾）。甘酸微温。性禀中和。功能而不燥。固精而不凝。（李士材曰。强肾无燥热之偏。固精无凝涩之害。金玉之品也。）故服阴痿能强。肌肤能泽。脏腑能和。须发不白。女子服之多孕。既有补益之功。复多收敛之义。名为覆盆子者。服之能使溺盆皆覆也。但真甚少。药肆多以树莓代充。酒浸色红者是真。否即属假。去蒂淘净捣饼。用时酒拌蒸。（同车前五味菟丝蒺藜子为五子衍宗丸。治男子精气亏乏中年无子。加入巴戟天腽肭脐补骨脂鹿茸白胶山茱萸肉苁蓉。治阳虚阴痿临房不举。精寒精薄。宜去蒂。酒煮用。）"}]},{"ID":"20240829081503-yk2vhj0","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-yk2vhj0","updated":"20240829081504"}},{"ID":"20240829081503-c7lxvcy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-c7lxvcy","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草崇原》"}]},{"ID":"20240829081503-3sy4num","Type":"NodeParagraph","Properties":{"id":"20240829081503-3sy4num","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"气味酸平，无毒。主安五脏，益精气，长阴，令人坚，强志倍力，有子。久服轻身不老。"}]},{"ID":"20240829081503-jmi8dio","Type":"NodeParagraph","Properties":{"id":"20240829081503-jmi8dio","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"（《别录》名覆盆。《本经》名蓬 。始出荆山平泽及冤句，今处处有之。藤蔓繁衍，茎有蓬然近时只知有覆盆，不知有蓬 矣。愚以覆盆、蓬 功用相同，故合而为一。）"}]},{"ID":"20240829081503-8olfdn6","Type":"NodeParagraph","Properties":{"id":"20240829081503-8olfdn6","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"《本经》名蓬 ，以其藤蔓繁衍，苗叶不凋，结子则蓬蓬而 也。《别录》名覆盆，以其形圆而扁，如釜如盆，就蒂结实，倒垂向下，一如盆之下覆也。气味酸平，藤蔓繁衍，具春生夏长之气，覆下如盆。得秋时之金气，冬叶不凋。得冬令之水精，结实形圆。具中央之土气，体备四时，质合五行，故主安五脏。肾受五脏之精而藏之，故益精气而长阴。肾气充足，则令人坚，强志倍力，有子。是覆盆虽安五脏，补肾居多，所以然者，水天上下之气，交相输应也,天气下覆,水气上升,故久服轻身不老。"}]},{"ID":"20240829081503-29aayjg","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-29aayjg","updated":"20240829081504"}},{"ID":"20240829081503-wj68xb1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-wj68xb1","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《医学入门》"}]},{"ID":"20240829081503-919by64","Type":"NodeParagraph","Properties":{"id":"20240829081503-919by64","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"覆盆子甘性微热，阴痿肾虚精气竭，补肝明目治肺虚，妇人宜子须频啜。"}]},{"ID":"20240829081503-78h3ulr","Type":"NodeParagraph","Properties":{"id":"20240829081503-78h3ulr","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶益肾脏，服之小盒饭复溺盆。无毒。主男子肾虚精竭，阴痿能令坚长；治肝经风虚，明目去翳；治肺气虚寒少力。取汁入蜜作煎点眼，妇人食之有子，久服轻身发不白，悦颜色，和脏腑。入药水洗去皮蒂，酒蒸日干。苗，名蓬 ，味酸、咸，平。功力同子。疗中风身热大惊，又烂弦血风，冷泪侵淫，青盲目暗，或有虫等症。取苗日干为末，薄绵裹之，以男乳汁浸如人行七八里久，用注目中，仰卧，不过三四日，视物如少年，忌酒面。"}]},{"ID":"20240829081503-wiqpyg1","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-wiqpyg1","updated":"20240829081504"}},{"ID":"20240829081503-x8j5mty","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-x8j5mty","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《本草分经》"}]},{"ID":"20240829081503-7ahql2s","Type":"NodeParagraph","Properties":{"id":"20240829081503-7ahql2s","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"甘酸温而性固涩，补益肝肾，固精明目，起阳痿缩小便，强肾无燥热之偏，固精无凝滞之害。叶绞汁治目弦虫，除肤赤。"}]},{"ID":"20240829081503-cpkqnef","Type":"NodeThematicBreak","Properties":{"id":"20240829081503-cpkqnef","updated":"20240829081504"}},{"ID":"20240829081503-j3r84cu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081503-j3r84cu","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"覆盆子《中药学》"}]},{"ID":"20240829081503-87uc0ck","Type":"NodeParagraph","Properties":{"id":"20240829081503-87uc0ck","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为蔷薇植物覆盆子的未成熟果实。"}]},{"ID":"20240829081503-7xr1fbo","Type":"NodeParagraph","Properties":{"id":"20240829081503-7xr1fbo","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、酸，微温。入肝、肾经。"}]},{"ID":"20240829081503-t49g0e8","Type":"NodeParagraph","Properties":{"id":"20240829081503-t49g0e8","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【功效】益肾固精，缩尿。"}]},{"ID":"20240829081503-9hofwcz","Type":"NodeParagraph","Properties":{"id":"20240829081503-9hofwcz","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于肾虚阳痿，遗精早泄，小便频数及小儿遗尿等症。"}]},{"ID":"20240829081503-57iozs3","Type":"NodeParagraph","Properties":{"id":"20240829081503-57iozs3","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"覆盆子滋养肝肾，且有收涩作用，故有良好的固精缩尿的功效。配以枸杞子、菟丝子、五味子等则益肾补精，用治肾虚阳痿、遗精早泄；配以桑螵蛸、益智仁、菟丝子等则固肾缩尿，用治小便频数、小儿遗尿等症。"}]},{"ID":"20240829081503-0t2lk8g","Type":"NodeParagraph","Properties":{"id":"20240829081503-0t2lk8g","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【处方用名】覆盆子（洗净，晒干用）。"}]},{"ID":"20240829081503-kklq8dn","Type":"NodeParagraph","Properties":{"id":"20240829081503-kklq8dn","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240829081503-66m5wqp","Type":"NodeParagraph","Properties":{"id":"20240829081503-66m5wqp","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【按语】1.覆盆子一药，具有益肾缩尿的良好作用，以功效而得名。本品性微温而不燥热，功能收敛固精而无凝滞的弊害，补肾助阳而无伤阴的缺点，故善于滋养肝肾，又可明目，适用于遗精、早泄、多尿、遗溺及眼目昏糊等症。"}]},{"ID":"20240829081503-adcqss9","Type":"NodeParagraph","Properties":{"id":"20240829081503-adcqss9","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"2.据明代《本草纲目》记载，覆盆子与悬钩子是两种植物。但《中药志》说，目前市场所用主要为植物秦氏悬钩子的果实，其它悬钩于属多种植物的果实，皆能作覆盆子用。"}]},{"ID":"20240829081503-hu5rv27","Type":"NodeParagraph","Properties":{"id":"20240829081503-hu5rv27","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《别录》：「益气....，令发不白。」"}]},{"ID":"20240829081503-19h2ops","Type":"NodeParagraph","Properties":{"id":"20240829081503-19h2ops","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"《药性本草》：「男子肾精虚竭，阴痿。」"}]},{"ID":"20240829081503-kkk10ks","Type":"NodeParagraph","Properties":{"id":"20240829081503-kkk10ks","updated":"20240829081504"},"Children":[{"Type":"NodeText","Data":"《本草备要》：「益肾脏而固精，补肝虚而明目，起阳痿，缩小便。」"}]},{"ID":"20240829081602-dgw57ve","Type":"NodeThematicBreak","Properties":{"id":"20240829081602-dgw57ve"}},{"ID":"20240829081604-nisomae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081604-nisomae","updated":"20240829081613"},"Children":[{"Type":"NodeText","Data":"《中国药典》：覆盆子"}]},{"ID":"20240829081604-a6474qj","Type":"NodeParagraph","Properties":{"id":"20240829081604-a6474qj","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240829081604-bqobzef","Type":"NodeParagraph","Properties":{"id":"20240829081604-bqobzef","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" Fù Pén Zi"}]},{"ID":"20240829081604-j5j1nyc","Type":"NodeParagraph","Properties":{"id":"20240829081604-j5j1nyc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240829081604-fuzyyyl","Type":"NodeParagraph","Properties":{"id":"20240829081604-fuzyyyl","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" FRUCTUS RUBI"}]},{"ID":"20240829081604-wvcjxm1","Type":"NodeParagraph","Properties":{"id":"20240829081604-wvcjxm1","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240829081604-v6f5s3w","Type":"NodeParagraph","Properties":{"id":"20240829081604-v6f5s3w","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 本品为蔷薇科悬钩子属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"华东覆盆子"},{"Type":"NodeText","Data":"Rubus chingii Hu的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。夏初果实由绿变绿黄时采收，除去梗、叶，置沸水中略烫或略蒸，取出，干燥。"}]},{"ID":"20240829081604-n12dld4","Type":"NodeParagraph","Properties":{"id":"20240829081604-n12dld4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240829081604-z7jrm8i","Type":"NodeParagraph","Properties":{"id":"20240829081604-z7jrm8i","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 本品为聚合果，由多数小核果聚合而成，呈圆锥形或扁圆锥形，高0.6～1.3cm,直径0.5～1.2cm。表面黄绿色或淡棕色，顶端钝圆，基部中心凹入。宿萼棕褐色，下有果梗痕。小果易剥落，每个小果呈半月形，背面密被灰白色茸毛，两侧有明显的网纹，腹部有突起的棱线。体轻，质硬。气微，味微酸涩。"}]},{"ID":"20240829081604-1ryiz1n","Type":"NodeParagraph","Properties":{"id":"20240829081604-1ryiz1n","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240829081604-csjt7om","Type":"NodeParagraph","Properties":{"id":"20240829081604-csjt7om","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240829081604-94tzjrg","Type":"NodeParagraph","Properties":{"id":"20240829081604-94tzjrg","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240829081604-3rkxjrd","Type":"NodeParagraph","Properties":{"id":"20240829081604-3rkxjrd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 本品粉末棕黄色。非腺毛单细胞，长60～450μm，直径12～20μm,壁甚厚，木化，大多数具双螺纹，有的体部易脱落，足部残留而埋于表皮层，表面观圆多角形或长圆形，直径约至23μm,胞腔分枝，似石细胞状。草酸钙簇晶较多见，直径18～50μm 。果皮纤维黄色，上下层纵横或斜向交错排列。"}]},{"ID":"20240829081604-11s7ozc","Type":"NodeParagraph","Properties":{"id":"20240829081604-11s7ozc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240829081604-7p2qmep","Type":"NodeParagraph","Properties":{"id":"20240829081604-7p2qmep","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 归肾、膀胱经。"}]},{"ID":"20240829081604-bpi0uye","Type":"NodeParagraph","Properties":{"id":"20240829081604-bpi0uye","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240829081604-fl4kkjr","Type":"NodeParagraph","Properties":{"id":"20240829081604-fl4kkjr","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 甘、酸，温。"}]},{"ID":"20240829081604-0wjfie4","Type":"NodeParagraph","Properties":{"id":"20240829081604-0wjfie4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240829081604-d7ok1rq","Type":"NodeParagraph","Properties":{"id":"20240829081604-d7ok1rq","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 益肾，固精，缩尿。用于肾虚遗尿，小便频数，阳痿早泄，遗精滑精。"}]},{"ID":"20240829081604-5c58bu5","Type":"NodeParagraph","Properties":{"id":"20240829081604-5c58bu5","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240829081604-0bfbs42","Type":"NodeParagraph","Properties":{"id":"20240829081604-0bfbs42","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240829081604-p1ecksk","Type":"NodeParagraph","Properties":{"id":"20240829081604-p1ecksk","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240829081604-5tyhel9","Type":"NodeParagraph","Properties":{"id":"20240829081604-5tyhel9","updated":"20240829081604"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240829081613-ifyvrnm","Type":"NodeThematicBreak","Properties":{"id":"20240829081613-ifyvrnm"}},{"ID":"20240829081604-qdp8m3x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081604-qdp8m3x","updated":"20240829081604"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：覆盆子"}]},{"ID":"20240829081604-hi43m5r","Type":"NodeParagraph","Properties":{"id":"20240829081604-hi43m5r","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240829081604-rsky3js","Type":"NodeParagraph","Properties":{"id":"20240829081604-rsky3js","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" Fù Pén Zi"}]},{"ID":"20240829081604-09ion51","Type":"NodeParagraph","Properties":{"id":"20240829081604-09ion51","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240829081604-jvfzowc","Type":"NodeParagraph","Properties":{"id":"20240829081604-jvfzowc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 覆盆（《别录》），乌藨子（《纲目》），小托盘（《中药材手册》），竻藨子（《江西中药》）。"}]},{"ID":"20240829081604-0ncuyan","Type":"NodeParagraph","Properties":{"id":"20240829081604-0ncuyan","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240829081604-w9o9f2c","Type":"NodeParagraph","Properties":{"id":"20240829081604-w9o9f2c","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240829081604-euj3j65","Type":"NodeParagraph","Properties":{"id":"20240829081604-euj3j65","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240829081604-w7uyka3","Type":"NodeParagraph","Properties":{"id":"20240829081604-w7uyka3","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶覆盆子"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"插田泡"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未成熟果实"},{"Type":"NodeText","Data":"。立夏后，果实已饱满而尚呈绿色时采摘，除净梗叶，用沸水浸1～2分钟后，置烈日下晒干。"}]},{"ID":"20240829081604-jg4juw6","Type":"NodeParagraph","Properties":{"id":"20240829081604-jg4juw6","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240829081604-avt98ki","Type":"NodeParagraph","Properties":{"id":"20240829081604-avt98ki","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" ①掌叶覆盆子"}]},{"ID":"20240829081604-x5rx88u","Type":"NodeParagraph","Properties":{"id":"20240829081604-x5rx88u","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高2～3米。枝细圆，红棕色；幼枝绿色，有白粉，具稀疏、微弯曲的皮刺，长4～5毫米。叶单生或敷叶簇生，长3～5厘米，有达7厘米者，掌状5裂，罕有3裂，中央1片大，长卵形或长椭圆形，先端渐尖，常呈尾状，两侧裂片较小，常不相等，裂片边缘具重锯齿；主脉5出，上被柔毛，下面叶脉上均有柔毛；叶柄细，长3～4.5厘米，有极小的刺；托叶2枚，线状披针形。花单生于小枝顶端，花梗细，长2～3厘米；花萼5，宿存，卵状长圆形，两面有毛；花瓣5，卵圆形；雄蕊多数，花药丁字着生，2室；雌蕊多数，着生在凸出的花托上。聚合果近球形。花期4月。果期6～8月。"}]},{"ID":"20240829081604-tsqgs7m","Type":"NodeParagraph","Properties":{"id":"20240829081604-tsqgs7m","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"生于溪旁或山坡林中。分布安徽、江苏、浙江、江西、福建等地。"}]},{"ID":"20240829081604-ify5dwp","Type":"NodeParagraph","Properties":{"id":"20240829081604-ify5dwp","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②插田泡，详\"倒生根\"条。"}]},{"ID":"20240829081604-4oe6qu4","Type":"NodeParagraph","Properties":{"id":"20240829081604-4oe6qu4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240829081604-rtzug23","Type":"NodeParagraph","Properties":{"id":"20240829081604-rtzug23","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 干燥聚合果为多数小果集合而成，全体呈圆锥形、扁圆形或球形，直径4～9毫米，高5～12毫米。表面灰绿色带灰白色毛茸。上部钝圆，底部扁平，有棕褐色的总苞，5裂，总苞上生有棕色毛，下面常带果柄，脆而易脱落。小果易剥落，每个小果具三棱，呈半月形，背部密生灰白色毛茸，两侧有明显的网状纹，内含棕色种子1枚。气清香，味甘微酸。以个大、饱满、粒整、结实、色灰绿、无叶梗者为佳。"}]},{"ID":"20240829081604-ka1mg3g","Type":"NodeParagraph","Properties":{"id":"20240829081604-ka1mg3g","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"主产浙江、福建、湖北等地。"}]},{"ID":"20240829081604-v8gufbz","Type":"NodeParagraph","Properties":{"id":"20240829081604-v8gufbz","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"覆盆子药材主要为掌叶覆盆子的果实。插田泡的果实使用于陕西、四川等地，《植物名实图考》所载的覆盆子图即为此种。"}]},{"ID":"20240829081604-ato7vfx","Type":"NodeParagraph","Properties":{"id":"20240829081604-ato7vfx","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240829081604-bss3bzv","Type":"NodeParagraph","Properties":{"id":"20240829081604-bss3bzv","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 掌叶覆盆子含有机酸、糖类及少量维生素C。"}]},{"ID":"20240829081604-prwdrd2","Type":"NodeParagraph","Properties":{"id":"20240829081604-prwdrd2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240829081604-u1gu807","Type":"NodeParagraph","Properties":{"id":"20240829081604-u1gu807","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 以大鼠、兔的阴道涂片及内膜切片作观察指标，覆盆子似有雌激素样作用。"}]},{"ID":"20240829081604-11ez55q","Type":"NodeParagraph","Properties":{"id":"20240829081604-11ez55q","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240829081604-9a8g3r6","Type":"NodeParagraph","Properties":{"id":"20240829081604-9a8g3r6","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 筛去灰屑，拣净杂质，去柄。"}]},{"ID":"20240829081604-v0jkiu3","Type":"NodeParagraph","Properties":{"id":"20240829081604-v0jkiu3","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使覆盆子，用酒蒸一宿，以水淘两遍，晒干用。\""}]},{"ID":"20240829081604-gmjnfq2","Type":"NodeParagraph","Properties":{"id":"20240829081604-gmjnfq2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②《纲目》；\"采得覆盆子，捣作薄饼，晒干密贮，临时以酒拌蒸，尤妙。\""}]},{"ID":"20240829081604-i6nylr0","Type":"NodeParagraph","Properties":{"id":"20240829081604-i6nylr0","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240829081604-gnqr9vr","Type":"NodeParagraph","Properties":{"id":"20240829081604-gnqr9vr","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 《滇南本草》：\"入肝、肾二经。\""}]},{"ID":"20240829081604-vcs7p9q","Type":"NodeParagraph","Properties":{"id":"20240829081604-vcs7p9q","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240829081604-cpt9csv","Type":"NodeParagraph","Properties":{"id":"20240829081604-cpt9csv","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 甘酸，平。"}]},{"ID":"20240829081604-b0vqf4h","Type":"NodeParagraph","Properties":{"id":"20240829081604-b0vqf4h","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味甘，平，无毒。\""}]},{"ID":"20240829081604-k31p8ws","Type":"NodeParagraph","Properties":{"id":"20240829081604-k31p8ws","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"味甘辛，平。\""}]},{"ID":"20240829081604-r67xgrr","Type":"NodeParagraph","Properties":{"id":"20240829081604-r67xgrr","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"微热，味甘辛。\""}]},{"ID":"20240829081604-gc855he","Type":"NodeParagraph","Properties":{"id":"20240829081604-gc855he","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"④孟诜：\"味酸。\""}]},{"ID":"20240829081604-a6sm8qi","Type":"NodeParagraph","Properties":{"id":"20240829081604-a6sm8qi","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240829081604-5duklr4","Type":"NodeParagraph","Properties":{"id":"20240829081604-5duklr4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 肾虚有火，小便短涩者慎服。"}]},{"ID":"20240829081604-7kg3pqb","Type":"NodeParagraph","Properties":{"id":"20240829081604-7kg3pqb","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"强阳不倒者忌之。\""}]},{"ID":"20240829081604-lgiicgz","Type":"NodeParagraph","Properties":{"id":"20240829081604-lgiicgz","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"肾热阴虚，血燥血少之证戒之。\""}]},{"ID":"20240829081604-vpah3yp","Type":"NodeParagraph","Properties":{"id":"20240829081604-vpah3yp","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"小便不利者勿服。\""}]},{"ID":"20240829081604-e9114md","Type":"NodeParagraph","Properties":{"id":"20240829081604-e9114md","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240829081604-7yi8su1","Type":"NodeParagraph","Properties":{"id":"20240829081604-7yi8su1","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 补肝肾，缩小便，助阳，固精，明目。治阳痿，遗精，溲数，遗溺，虚劳，目暗。"}]},{"ID":"20240829081604-pqu13x5","Type":"NodeParagraph","Properties":{"id":"20240829081604-pqu13x5","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主益气轻身，令发不白。\""}]},{"ID":"20240829081604-lsorejo","Type":"NodeParagraph","Properties":{"id":"20240829081604-lsorejo","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"主男子肾精虚竭，女子食之有子。主阴痿。\""}]},{"ID":"20240829081604-gnk0jfm","Type":"NodeParagraph","Properties":{"id":"20240829081604-gnk0jfm","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"安五脏，益颜色，养精气，长发，强志。疗中风身热及惊。\""}]},{"ID":"20240829081604-guifc9u","Type":"NodeParagraph","Properties":{"id":"20240829081604-guifc9u","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"④《开宝本草》：\"补虚续绝，强阴建阳，悦泽肌肤，安和脏腑，温中益力，疗劳损风虚，补肝明目。\""}]},{"ID":"20240829081604-rfqr4ya","Type":"NodeParagraph","Properties":{"id":"20240829081604-rfqr4ya","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义》：\"益肾脏，缩小便。\""}]},{"ID":"20240829081604-nopmsw4","Type":"NodeParagraph","Properties":{"id":"20240829081604-nopmsw4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"⑥《本草蒙筌》：\"治肾伤精竭流滑。\""}]},{"ID":"20240829081604-5jkw6lt","Type":"NodeParagraph","Properties":{"id":"20240829081604-5jkw6lt","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"⑦《本草述》：\"治劳倦、虚劳，肝肾气虚恶寒，肾气虚逆咳嗽、痿、消瘅、泄泻、赤白浊，鹤膝风，诸见血证及目疾。\""}]},{"ID":"20240829081604-bxj37t2","Type":"NodeParagraph","Properties":{"id":"20240829081604-bxj37t2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240829081604-37w63l2","Type":"NodeParagraph","Properties":{"id":"20240829081604-37w63l2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～2钱：浸酒、熬膏或入丸、散。"}]},{"ID":"20240829081604-zl9f7gf","Type":"NodeParagraph","Properties":{"id":"20240829081604-zl9f7gf","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240829081604-ppr96y2","Type":"NodeParagraph","Properties":{"id":"20240829081604-ppr96y2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" ①治阳事不起：覆盆子，酒浸，焙研为末，每旦酒服三钱。（《濒湖集简方》）"}]},{"ID":"20240829081604-57ckw6z","Type":"NodeParagraph","Properties":{"id":"20240829081604-57ckw6z","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②添精补髓，疏利肾气，不问下焦虚实寒热，服之自能平秘：枸杞子八两，菟丝子八两（酒蒸，捣饼），五味子二两（研碎），覆盆子四两（酒洗，去目）。车前子二两（扬净），上药，俱择精新者，焙晒干，共为细末，炼蜜丸，梧桐子大。每服，空心九十丸，上床时五十丸，百沸汤或盐汤送下，冬月用温酒送下。（《摄生众妙方》五子衍宗丸）"}]},{"ID":"20240829081604-fwlxpdd","Type":"NodeParagraph","Properties":{"id":"20240829081604-fwlxpdd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③治肺虚寒：覆盆子，取汁作煎为果，仍少加蜜，或熬为稀饧，点服。（《本草衍义》）"}]},{"ID":"20240829081604-us2huxm","Type":"NodeParagraph","Properties":{"id":"20240829081604-us2huxm","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240829081604-dbmxrxl","Type":"NodeParagraph","Properties":{"id":"20240829081604-dbmxrxl","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"覆盆子、蓬蘽，功用大抵相近，虽是二物，其实一类而二种也。一早熟，一晚熟，兼用无妨。其补益与桑椹同功。若树莓则不可混采者也。\""}]},{"ID":"20240829081604-tzkxs09","Type":"NodeParagraph","Properties":{"id":"20240829081604-tzkxs09","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"覆盆子，其主益气者，言益精气也。肾藏精、肾纳气，精气充足，则身自轻，发不白也。苏恭主补虚续绝，强阴建阳，悦泽肌肤，安和脏腑。甄权主男子肾精虚竭，阴痿，女子食之有子。大明主安五脏，益颜色，养精气，长发，强志。皆取其益肾添精，甘酸收敛之义耳。\""}]},{"ID":"20240829081604-fqbzjj3","Type":"NodeParagraph","Properties":{"id":"20240829081604-fqbzjj3","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"覆盆子，甘平入肾，起阳治痿，固精摄溺，强肾而无燥热之偏，固精而无疑涩之害，金玉之品也。\""}]},{"ID":"20240829081604-e4qovmw","Type":"NodeParagraph","Properties":{"id":"20240829081604-e4qovmw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"④《本草述》：\"覆盆子，方书用之治劳倦虚劳等证，或补肾元阳，或益肾阴气，或专滋精血，随其所宜之主，皆能相助为理也。\""}]},{"ID":"20240829081604-xr3im2a","Type":"NodeParagraph","Properties":{"id":"20240829081604-xr3im2a","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"覆盆，为滋养真阴之药，味带微酸，能收摄耗散之阴气而生精液，故寇宗奭谓益肾缩小便，服之当覆其溺器，语虽附会，尚为有理。《本经》主安五脏，脏者阴也。凡子皆坚实，多能补中，况有酸收之力，自能补五脏之阴而益精气。凡子皆重，多能益肾，而此又专入肾阴，能坚肾气，强志倍力有子，皆补益肾阴之效也。《别录》益气轻身，令发不白，仍即《本经》之意。惟此专养阴，非以助阳，《本经》、《别录》并未言温，其以为微温微热者，皆后人臆测之辞，一似凡补肾者皆属温药，不知肾阴肾阳，药物各有专主，滋养真阴者，必非温药。\""}]},{"ID":"20240829081604-tpk1tom","Type":"NodeParagraph","Properties":{"id":"20240829081604-tpk1tom","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240829081604-atsglrp","Type":"NodeParagraph","Properties":{"id":"20240829081604-atsglrp","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，尚有多种同属植物的果实亦作覆盆子使用，如：悬钩子（参见\"悬钩子\"条）使用于江苏；灰毛果莓（参见\"硬枝黑锁梅\"条）使用于云南；拟覆盆子使用于西藏等。"}]},{"ID":"20240829081604-5j305cw","Type":"NodeParagraph","Properties":{"id":"20240829081604-5j305cw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240829081604-d3oe6nc","Type":"NodeParagraph","Properties":{"id":"20240829081604-d3oe6nc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240829081604-zhvo07f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240829081604-zhvo07f","updated":"20240829081604"},"Children":[{"Type":"NodeText","Data":"《中华本草》：覆盆子"}]},{"ID":"20240829081604-c4hub9x","Type":"NodeParagraph","Properties":{"id":"20240829081604-c4hub9x","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240829081604-bowwul2","Type":"NodeParagraph","Properties":{"id":"20240829081604-bowwul2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" Fù Pén Zi"}]},{"ID":"20240829081604-4jlbsub","Type":"NodeParagraph","Properties":{"id":"20240829081604-4jlbsub","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240829081604-ieie4vw","Type":"NodeParagraph","Properties":{"id":"20240829081604-ieie4vw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 覆盆、乌藨子、小托盘、山泡、竻藨子"}]},{"ID":"20240829081604-uai36pd","Type":"NodeParagraph","Properties":{"id":"20240829081604-uai36pd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240829081604-6f0ivqj","Type":"NodeParagraph","Properties":{"id":"20240829081604-6f0ivqj","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" Palmleaf Raspberry Fruit"}]},{"ID":"20240829081604-zpihrh4","Type":"NodeParagraph","Properties":{"id":"20240829081604-zpihrh4","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240829081604-qu13uow","Type":"NodeParagraph","Properties":{"id":"20240829081604-qu13uow","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 出自《本草经集注》。"}]},{"ID":"20240829081604-yuxt19g","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240829081604-yuxt19g","updated":"20240829081606"},"Children":[{"ID":"20240829081604-vc7yd7e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240829081604-vc7yd7e","updated":"20240829081604"},"Children":[{"ID":"20240829081604-7q5kwkt","Type":"NodeParagraph","Properties":{"id":"20240829081604-7q5kwkt","updated":"20240829081604"},"Children":[{"Type":"NodeText","Data":"孟说：覆盆子，五月于麦田中得之良，采得，烈日晒干，免烂不堪。"}]}]}]},{"ID":"20240829081604-w48zwoq","Type":"NodeParagraph","Properties":{"id":"20240829081604-w48zwoq","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：覆盆子，旧不着所出州士，今并处处有之，而秦、吴地尤多。苗短不过尺，茎叶皆有刺，花自，子赤黄油口半弹丸大，而下有茎承如柿蒂状，小儿多食。其实五月采，其茵叶采无时。江南人谓之葛，然其地所生差晚，三月始有苗，八九月开花，十月而实成，功用则同，古方多用。"}]},{"ID":"20240829081604-tm565b5","Type":"NodeParagraph","Properties":{"id":"20240829081604-tm565b5","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：覆盆子，"}]},{"ID":"20240829081604-m5ul0os","Type":"NodeParagraph","Properties":{"id":"20240829081604-m5ul0os","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240829081604-v4iwwzc","Type":"NodeParagraph","Properties":{"id":"20240829081604-v4iwwzc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物掌叶覆盆子的果实。"}]},{"ID":"20240829081604-j15q1os","Type":"NodeParagraph","Properties":{"id":"20240829081604-j15q1os","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rubus chingii Hu"}]},{"ID":"20240829081604-vyxb9mm","Type":"NodeParagraph","Properties":{"id":"20240829081604-vyxb9mm","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-8月间果实已饱满呈绿色未成熟时采收，将摘下的果实拣净梗、叶，用沸水烫1-2min，取出置烈日下晒干。"}]},{"ID":"20240829081604-bdrigro","Type":"NodeParagraph","Properties":{"id":"20240829081604-bdrigro","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240829081604-b80f7fc","Type":"NodeParagraph","Properties":{"id":"20240829081604-b80f7fc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔至中海拔地区，在山坡、路边阳处或阴处灌木丛中常见。"}]},{"ID":"20240829081604-cxp1dth","Type":"NodeParagraph","Properties":{"id":"20240829081604-cxp1dth","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏、安徽、浙江、江西、福建、广西等地。"}]},{"ID":"20240829081604-8q0438o","Type":"NodeParagraph","Properties":{"id":"20240829081604-8q0438o","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240829081604-t7pnliw","Type":"NodeParagraph","Properties":{"id":"20240829081604-t7pnliw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 掌叶覆盆子 落叶灌木，高2-3m。幼枝绿色，有白粉，有少数倒刺。单叶互生；叶柄长3-4.5cm；托叶线状披针形；叶片近圆形，直径5-9cm，掌状5深裂，中裂片菱状卵形，基部近心形，边缘有重锯齿，两面脉上有白色短柔毛；基生五出脉。花两性；单生于短枝的顶端，花萼5，宿存，卵状长圆形，萼裂片两面有短柔毛；花瓣5，白色，椭圆形或卵状长圆形，先端圆钝；直径2.5-3.5cm；花梗长2-3.5cm；雄蕊多数，花丝宽扁；花药丁字着生，2室；雌蕊多数，具柔毛，着生在凸起的花托上。聚合果球形，直径1.5-2cm，红色，下垂；小核果密生灰白色柔毛。花期3-4月，果期5-8月。"}]},{"ID":"20240829081604-qvwwb0b","Type":"NodeParagraph","Properties":{"id":"20240829081604-qvwwb0b","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240829081604-x18hljk","Type":"NodeParagraph","Properties":{"id":"20240829081604-x18hljk","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜冷凉气候，忌炎热，喜光忌暴晒。一般土壤均可栽种，但以土质疏松、富含腐殖质、排水良好的酸性黄壤土为好。"}]},{"ID":"20240829081604-aaj5q6v","Type":"NodeParagraph","Properties":{"id":"20240829081604-aaj5q6v","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"栽培技术 用根蘖、埋根、扦插或压条繁殖法。根蘖繁殖：2-3月，挖取由根蘖苗长成的植株，经适当修剪后，分株假植或定植。埋根繁殖：利用挖根蘖苗时修剪下来的较粗的侧根，截成长10cm左右的根段，插入苗床，培育1年后定植。扦插繁殖：在春季萌芽前剪取一年生枝条，将枝条剪成15-20cm作插条，按行株距10cm×5cm插入苗床，覆膜保温保湿，苗高50cm即可了圃定植。压条繁殖：7-8月，将母株接近地面的一年生枝条压入土中，枝条入土部分割伤。翌年春，将压条长出的幼苗截离母体，另行栽植。定植按行株距2cm×0.5cm开穴，穴宽深30-40cm，每穴施入土杂肥5kg和细土拌匀，栽后踏实浅水。"}]},{"ID":"20240829081604-d45lyno","Type":"NodeParagraph","Properties":{"id":"20240829081604-d45lyno","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"田间管理 定植后每年中耕、除草、追肥3-4次。生长期适时修剪整形，搭架引缚。春季修剪，每丛保留7-9个粗壮枝条，结合采用单柱或双柱或篱架引缚；夏季修剪每株保留12-15个均匀分布的健壮枝条，对保留的基生枝进行摘心；秋剪在果实采完后进行，剪去枯枝、病枝、弱枝，疏剪密枝。雨水或干旱过多时，及时排灌水。"}]},{"ID":"20240829081604-rc77exd","Type":"NodeParagraph","Properties":{"id":"20240829081604-rc77exd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240829081604-xx9xigc","Type":"NodeParagraph","Properties":{"id":"20240829081604-xx9xigc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 聚事果由众多核果聚合而成，略呈圆锥形或类球形，上端钝圆，底部较平坦，高0.6-1.3cm，直径0.5-1.2cm。表面灰绿色或淡棕色，密被灰白色或灰绿色短绒毛，宿萼棕色，5裂，先端多折断，上有多数残存花丝，下有果柄痕或连有细果柄。小核果约呈半月形，背面隆起，腹面有突起棱线；表面棕色，背面及先端有灰白色毛，腹面及两侧有网状凹纹。质硬，内含棕色种子1粒。气清香，味微酸涩。以颗粒完整、饱满、色黄绿、具酸味者为佳。"}]},{"ID":"20240829081604-or7adi6","Type":"NodeParagraph","Properties":{"id":"20240829081604-or7adi6","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"显微鉴别 小核果横切面：外果皮1列细胞，角质层处缘细波状；背面有单细胞非腺毛。中果皮为数至十数列细胞，有的含草酸钙簇晶；最外2-3列为厚角组织；维管束外韧型，周围有纤维网细胞；最内1-4列细胞壁条状或网状增厚。内果皮为多列纤维，外缘呈8-10个脊状突起，纤维细长，壁木化，外侧2-12列纤维沿果轴平行排列，内侧6-11列与之相垂直。种皮内、外表皮细胞均含棕色色素，其间为数列薄壁细胞，种脊维管束位于果实腹侧。胚乳及子叶细胞含脂肪油及糊粉粒，后者还含细小草酸钙簇晶。"}]},{"ID":"20240829081604-34btmkj","Type":"NodeParagraph","Properties":{"id":"20240829081604-34btmkj","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄棕色。①单细胞非腺毛，多平直，有的略弯曲或先端弯成钩状，完整者长37-362μm，直径7-20μm，壁厚，木化，胞腔线形或不明显，有的表面可见双螺状裂纹。②果皮表皮细胞断面观类长方形，外被角质层；表面观类多角形，垂周壁念珠状增厚，其间有非腺毛残存足部，似石细胞状，孔沟较粗，气孔不定式，副卫细胞4-6个。"}]},{"ID":"20240829081604-uoudlpf","Type":"NodeParagraph","Properties":{"id":"20240829081604-uoudlpf","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"③内果皮纤维上下层垂直、斜向交错或平行排列；纤维较细长，直径约9μm，壁稍厚，木化。④草酸钙簇晶直径9-40μm。⑤网纹细胞管状、长卵形或卵形，直径7-26μm，壁有网状或细条状增厚纹理，木化或微木化。另有种皮表皮细胞及螺纹导管。子叶及细胞含有糊粉粒、脂肪油及细小簇晶。"}]},{"ID":"20240829081604-azblfzp","Type":"NodeParagraph","Properties":{"id":"20240829081604-azblfzp","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240829081604-dkofkq8","Type":"NodeParagraph","Properties":{"id":"20240829081604-dkofkq8","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 覆盆子含有机酸、糖类及少量维生素 C，并没食子酸(ellagic acid)，β-谷甾醇(β-sitosterol)，覆盆子酸(fupenzic acid)。"}]},{"ID":"20240829081604-fu1g7m8","Type":"NodeParagraph","Properties":{"id":"20240829081604-fu1g7m8","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240829081604-qw2y5cr","Type":"NodeParagraph","Properties":{"id":"20240829081604-qw2y5cr","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 1.抑菌作用100%煎剂用平板打洞法，对葡萄球菌有抑制作用，对霍乱弧菌也有抑制作用。"}]},{"ID":"20240829081604-fovi11k","Type":"NodeParagraph","Properties":{"id":"20240829081604-fovi11k","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"2.雌激素样作用 大鼠、兔的阴道涂片及内膜切片等指标表明，覆盆子似有雌激素样作用。"}]},{"ID":"20240829081604-qv00zaw","Type":"NodeParagraph","Properties":{"id":"20240829081604-qv00zaw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240829081604-j3vm0ds","Type":"NodeParagraph","Properties":{"id":"20240829081604-j3vm0ds","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 筛去灰屑，拣净杂质，去柄。"}]},{"ID":"20240829081604-rt2x6sd","Type":"NodeParagraph","Properties":{"id":"20240829081604-rt2x6sd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使覆盆子，用酒蒸一宿，以水淘两遍，晒干用。"}]},{"ID":"20240829081604-i5mc09x","Type":"NodeParagraph","Properties":{"id":"20240829081604-i5mc09x","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：采得覆盆子，捣作薄讲，晒干密贮，临时以酒拌蒸，尤妙。"}]},{"ID":"20240829081604-52y2hnl","Type":"NodeParagraph","Properties":{"id":"20240829081604-52y2hnl","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240829081604-3sm0dq8","Type":"NodeParagraph","Properties":{"id":"20240829081604-3sm0dq8","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240829081604-lx0hwvn","Type":"NodeParagraph","Properties":{"id":"20240829081604-lx0hwvn","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240829081604-1uxukgl","Type":"NodeParagraph","Properties":{"id":"20240829081604-1uxukgl","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 甘酸；平；无毒"}]},{"ID":"20240829081604-a4cdb50","Type":"NodeParagraph","Properties":{"id":"20240829081604-a4cdb50","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240829081604-ewceo2v","Type":"NodeParagraph","Properties":{"id":"20240829081604-ewceo2v","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 肾虚有火，小便短涩者慎服。"}]},{"ID":"20240829081604-f593nvp","Type":"NodeParagraph","Properties":{"id":"20240829081604-f593nvp","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：强阳不倒者忌之。"}]},{"ID":"20240829081604-oo3paht","Type":"NodeParagraph","Properties":{"id":"20240829081604-oo3paht","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：肾热阴虚，血燥血少之证戒之。"}]},{"ID":"20240829081604-8hzwkur","Type":"NodeParagraph","Properties":{"id":"20240829081604-8hzwkur","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：小便不利者勿服。"}]},{"ID":"20240829081604-48l6t5c","Type":"NodeParagraph","Properties":{"id":"20240829081604-48l6t5c","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240829081604-uhoft75","Type":"NodeParagraph","Properties":{"id":"20240829081604-uhoft75","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 补肝益肾，固精缩尿，明目。主阳痿早泄，遗精滑精，宫冷不孕，带下清稀，尿频遗溺，目昏暗，须发早白"}]},{"ID":"20240829081604-c2756tw","Type":"NodeParagraph","Properties":{"id":"20240829081604-c2756tw","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240829081604-7mzf7e2","Type":"NodeParagraph","Properties":{"id":"20240829081604-7mzf7e2","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或入丸、散，亦可浸酒或熬膏。"}]},{"ID":"20240829081604-3khzvwo","Type":"NodeParagraph","Properties":{"id":"20240829081604-3khzvwo","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240829081604-x5coyab","Type":"NodeParagraph","Properties":{"id":"20240829081604-x5coyab","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" ①治阳事不起：覆盆子，酒浸，焙研为末，每旦酒服三钱。(《濒湖集简方》)②添精补髓，疏利肾气，不问下焦虚实寒热，服之自能平：枸杞子八两，菟丝于八两(酒蒸，捣讲)，五味子二两(研碎)，覆盆子四两(酒洗，去目)，车前子二两(扬净)。上药，俱择精新者，焙晒干，共为细末，炼蜜丸，梧桐子大。每服，空心九十丸、上床时五十丸，白沸汤或盐汤送下，冬月用温酒送下。(《摄生众妙方》五子衍宗丸)③治肺虚寒：覆盆子，取汁作煎为果，仍少加蜜，或熬为稀杨，点服。(《本草衍义》)"}]},{"ID":"20240829081604-tt8jdny","Type":"NodeParagraph","Properties":{"id":"20240829081604-tt8jdny","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240829081604-t55f438","Type":"NodeParagraph","Properties":{"id":"20240829081604-t55f438","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：覆盆子、蓬，功用大抵相近，虽是二物，其实一类而二种也。一早熟，一晚熟，兼用无妨。其补益与桑椹同功。若树莓则不可混采者也。"}]},{"ID":"20240829081604-bibxhtn","Type":"NodeParagraph","Properties":{"id":"20240829081604-bibxhtn","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：覆盆子，其主益气者，言益精气也。肾藏精、肾纳气，精气充足，则身自轻，发不白也。苏恭主补虚续绝，强阴建阳，悦泽肌肤，安和脏腑。甄权主男子肾精虚竭，阴痿，女子食之有子。大阴主安五脏，益颜色，养精气，长发，强志。皆取其益肾添精，甘酸收敛之义耳。"}]},{"ID":"20240829081604-yq5iv5o","Type":"NodeParagraph","Properties":{"id":"20240829081604-yq5iv5o","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：覆盆子，甘平人肾，起阳治屡，固精摄溺，强肾而无燥热之偏，固精而无凝涩之害，金玉之品也。"}]},{"ID":"20240829081604-xz3qst3","Type":"NodeParagraph","Properties":{"id":"20240829081604-xz3qst3","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"4.《本草述》：覆盆子，方书用之治劳倦虚劳等证，或补肾元阳，或益肾阴气，或专滋精血，随其所宜之主，皆能相助为理也。"}]},{"ID":"20240829081604-aeir1mc","Type":"NodeParagraph","Properties":{"id":"20240829081604-aeir1mc","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：覆盆，为滋养真阴之药，味带微酸，能收摄耗散之阴气而生精液，故寇宗爽谓益肾缩小便，服之当覆其溺器，语虽附会，尚为有理。《本经》主安五脏，脏看阴也。月子皆坚实，多能补中，况有酸收之力，自能补五脏之阴而益精气。凡子皆重，多能益肾，而此又专人肾阴，能坚肾气，强志倍力有子，皆补益肾阴之效也。《别录》益气轻身，令发不自，仍即《本经》之意。惟此专养阴，非以助阳，《本经》、《别录》并未言温，其以为微温微热者，皆后人臆测之辞，一似凡补肾看皆届温药，不知肾阴肾阳，药物备肩'专主，滋养真阴者，必非温药。"}]},{"ID":"20240829081604-y368fdf","Type":"NodeParagraph","Properties":{"id":"20240829081604-y368fdf","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"6.《别录》：主益气轻身，令发不白。"}]},{"ID":"20240829081604-m06icz1","Type":"NodeParagraph","Properties":{"id":"20240829081604-m06icz1","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：主男子肾精虚竭，女子食之有子。主阴痿。"}]},{"ID":"20240829081604-bhs92yd","Type":"NodeParagraph","Properties":{"id":"20240829081604-bhs92yd","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：安五脏，益颜色，养精气，长发，强志。疗中风身热及惊。"}]},{"ID":"20240829081604-s1auduh","Type":"NodeParagraph","Properties":{"id":"20240829081604-s1auduh","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"9.《开宝本草》：补虚续绝，强阴建阳，悦泽肌肤，安和脏腑，温中益力，疗劳损风虚，补肝明目。"}]},{"ID":"20240829081604-hjwsq4d","Type":"NodeParagraph","Properties":{"id":"20240829081604-hjwsq4d","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"10.《本草衍义》：益肾脏，缩小便。"}]},{"ID":"20240829081604-micc3xx","Type":"NodeParagraph","Properties":{"id":"20240829081604-micc3xx","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"11.《本草蒙签》：治肾伤精竭流滑。"}]},{"ID":"20240829081604-lphedw1","Type":"NodeParagraph","Properties":{"id":"20240829081604-lphedw1","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"12.《本草述》：治劳倦、虚劳，肝肾气虚恶寒，肾气虚逆咳嗽、痿、消渴、泄泻、赤白浊，鹤膝风，诸见血证及目疾。"}]},{"ID":"20240829081604-jwuvwfs","Type":"NodeParagraph","Properties":{"id":"20240829081604-jwuvwfs","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240829081604-4aq5k6j","Type":"NodeParagraph","Properties":{"id":"20240829081604-4aq5k6j","updated":"20240829081606"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240829081604-j8plo9n","Type":"NodeThematicBreak","Properties":{"id":"20240829081604-j8plo9n","updated":"20240829081606"}},{"ID":"20240829081604-zgi7dgj","Type":"NodeParagraph","Properties":{"id":"20240829081604-zgi7dgj","updated":"20240829081606"}}]}