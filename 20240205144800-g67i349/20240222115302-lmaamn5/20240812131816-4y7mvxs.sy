{"ID":"20240812131816-4y7mvxs","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240812131816-4y7mvxs","title":"芝麻（脂麻）","type":"doc","updated":"20240902160305"},"Children":[{"ID":"20240829150200-wz2w3m1","Type":"NodeParagraph","Properties":{"id":"20240829150200-wz2w3m1","updated":"20240829150200"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 2-20240812111157-za3ht7w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829150200-jozxu7b","Type":"NodeParagraph","Properties":{"id":"20240829150200-jozxu7b","updated":"20240829150420"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240829150420-m6ksf55.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻-20240812111634-c1p1cuu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240829150608-h0yb761","Type":"NodeParagraph","Properties":{"id":"20240829150608-h0yb761","updated":"20240829150733"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data