"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 7-20240829150457-cedwqtd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 601px;","style":"width: 591px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 10-20240829150819-lschyhk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 591px;\" parent-style=\"width: 601px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829151337-0bez3hi","Type":"NodeParagraph","Properties":{"id":"20240829151337-0bez3hi","updated":"20240829151337"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 2-20240812111948-5k061w7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 814px;","style":"width: 804px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 3-20240812112318-zlqsoo6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 804px;\" parent-style=\"width: 814px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829151629-joyfg1y","Type":"NodeParagraph","Properties":{"id":"20240829151629-joyfg1y","updated":"20240829151656"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 373px;","style":"width: 363px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 16-20240829151629-cqxrcv6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 363px;\" parent-style=\"width: 373px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 869px;","style":"width: 859px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芝麻 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芝麻 17-20240829151656-08u2auo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 859px;\" parent-style=\"width: 869px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829150218-neooucy","Type":"NodeThematicBreak","Properties":{"id":"20240829150218-neooucy"}},{"ID":"20240902160300-cu1ktix","Type":"NodeParagraph","Properties":{"id":"20240902160300-cu1ktix","updated":"20240902160305"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：黑芝麻"}]},{"ID":"20240902160300-bqksvba","Type":"NodeParagraph","Properties":{"id":"20240902160300-bqksvba","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"黑芝麻《中国药典》"}]},{"ID":"20240902160300-vl30wb8","Type":"NodeParagraph","Properties":{"id":"20240902160300-vl30wb8","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【拼音名】HēiZhīMɑ"}]},{"ID":"20240902160300-nl6u850","Type":"NodeParagraph","Properties":{"id":"20240902160300-nl6u850","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【英文名】SEMENSESAMINIGRUM"}]},{"ID":"20240902160300-z5513op","Type":"NodeParagraph","Properties":{"id":"20240902160300-z5513op","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【别名】胡麻、油麻、巨胜、脂麻"}]},{"ID":"20240902160300-wgcxlw1","Type":"NodeParagraph","Properties":{"id":"20240902160300-wgcxlw1","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【来源】本品为脂麻科（胡麻科）脂麻属植物脂麻SesamumindicumL.的干燥成熟种子。秋季果实成熟时采割植株，晒干，打下种子，除去杂质，再晒干。"}]},{"ID":"20240902160300-yysoa4o","Type":"NodeParagraph","Properties":{"id":"20240902160300-yysoa4o","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性状】本品呈扁卵圆形，长约3mm,宽约2mm。表面黑色，平滑或有网状皱纹。尖端有棕色点状种脐。种皮薄，子叶2,白色，富油性。气微，味甘，有油香气。"}]},{"ID":"20240902160300-yq62k65","Type":"NodeParagraph","Properties":{"id":"20240902160300-yq62k65","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902160300-8imqsis","Type":"NodeParagraph","Properties":{"id":"20240902160300-8imqsis","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"（1）取本品1g，研碎，加石油醚（60～90℃）10ml，浸泡1小时，倾取上清液，置试管中，加含蔗糖0.1g的盐酸10ml，振摇半分钟，酸层显粉红色，静置后，渐变为红色。"}]},{"ID":"20240902160300-7ipmb9i","Type":"NodeParagraph","Properties":{"id":"20240902160300-7ipmb9i","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"（2）取本品0.5g，捣碎，加氯仿10ml，浸渍2小时，滤过，滤液挥干，残渣加氯仿1ml使溶解，作为供试品溶液。另取芝麻素及β－谷甾醇对照品，加氯仿分别制成每1ml含2mg的溶液，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取供试品溶液5μl、对照品溶液各2μl，分别点于同一硅胶Ｇ薄层板上，以环己烷－乙醚－醋酸乙酯（20:5.5:2.5）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240902160300-4yqrg3m","Type":"NodeParagraph","Properties":{"id":"20240902160300-4yqrg3m","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902160300-avnlvbm","Type":"NodeParagraph","Properties":{"id":"20240902160300-avnlvbm","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"黑芝麻除去杂质，洗净，晒干。用时捣碎。"}]},{"ID":"20240902160300-9eberac","Type":"NodeParagraph","Properties":{"id":"20240902160300-9eberac","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"炒黑芝麻取净黑芝麻，照清炒法（附录ⅡD）炒至有爆声。用时捣碎。"}]},{"ID":"20240902160300-mbcgqdp","Type":"NodeParagraph","Properties":{"id":"20240902160300-mbcgqdp","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性味】甘，平。"}]},{"ID":"20240902160300-d1xnqya","Type":"NodeParagraph","Properties":{"id":"20240902160300-d1xnqya","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾、大肠经。"}]},{"ID":"20240902160300-oxov08i","Type":"NodeParagraph","Properties":{"id":"20240902160300-oxov08i","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【功能主治】补肝肾，益精血，润肠燥。用于头晕眼花，耳鸣耳聋，须发早白，病后脱发，肠燥便秘。"}]},{"ID":"20240902160300-7ur3x3m","Type":"NodeParagraph","Properties":{"id":"20240902160300-7ur3x3m","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【用法用量】9～15g。"}]},{"ID":"20240902160300-afrewx3","Type":"NodeParagraph","Properties":{"id":"20240902160300-afrewx3","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902160300-dx5xe52","Type":"NodeParagraph","Properties":{"id":"20240902160300-dx5xe52","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"黑芝麻《*辞典》"}]},{"ID":"20240902160300-ossi3f2","Type":"NodeParagraph","Properties":{"id":"20240902160300-ossi3f2","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【拼音名】HēiZhīMɑ"}]},{"ID":"20240902160300-bcc3kcd","Type":"NodeParagraph","Properties":{"id":"20240902160300-bcc3kcd","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【英文名】SemenSesamiNigrum"}]},{"ID":"20240902160300-dvecb9r","Type":"NodeParagraph","Properties":{"id":"20240902160300-dvecb9r","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【别名】胡麻子、脂麻"}]},{"ID":"20240902160300-66rod5k","Type":"NodeParagraph","Properties":{"id":"20240902160300-66rod5k","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【来源】为脂麻科植物脂麻SesamumindicumL.的种子。秋季果实成熟时采割植株，晒干，打下种子，除去杂质，再晒干。"}]},{"ID":"20240902160300-rq48e32","Type":"NodeParagraph","Properties":{"id":"20240902160300-rq48e32","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【原形态】一年生草本，高达1m。茎直立，四棱形，稍有柔毛。叶对生或上部叶互生；上部叶披针形或狭椭圆形，全缘，中部叶卵形，有锯齿，下部叶3裂。花单生或2～3朵生叶叶腋；花萼长约6mm，裂片披针形；花冠白色或淡紫色，长约2.5cm。蒴果四棱状长椭圆形，长约2.5cm，上下几等宽，顶端稍尖，有细毛，种子多数，黑色、白色或淡黄色。花期5～9月，果期7～9月。"}]},{"ID":"20240902160300-v9u1652","Type":"NodeParagraph","Properties":{"id":"20240902160300-v9u1652","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【生境分布】除西藏外，各省区均有栽培。主产山东、河南、湖北、四川、安徽、江西、河北。"}]},{"ID":"20240902160300-lcbk2rr","Type":"NodeParagraph","Properties":{"id":"20240902160300-lcbk2rr","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性状】种子扁卵圆形，长约3mm，宽约2mm。表面黑色，平滑或有网状皱纹，先端有棕色点状种脐。种皮薄，子叶2，白色，富油性。味甘，有油香气。"}]},{"ID":"20240902160300-0fg6ivg","Type":"NodeParagraph","Properties":{"id":"20240902160300-0fg6ivg","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【化学成份】含脂肪油，为油酸、亚油酸、棕榈酸、硬脂酸、花生酸等甘油脂，并含芝麻素（sesamin）、芝麻林酚素（sesamolin）、芝麻酚（sesamol）、胡麻甙（pedaliin）、车前糖（planteose）、芝麻糖（sesamose）等。"}]},{"ID":"20240902160300-0l9ntq9","Type":"NodeParagraph","Properties":{"id":"20240902160300-0l9ntq9","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性味】性平，味甘。"}]},{"ID":"20240902160300-6ceu5wq","Type":"NodeParagraph","Properties":{"id":"20240902160300-6ceu5wq","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【功能主治】补肝肾，益精血，润肠燥。用于头晕眼花、耳鸣耳聋、须发早白、病后脱发、肠燥便秘。"}]},{"ID":"20240902160300-c5mtium","Type":"NodeParagraph","Properties":{"id":"20240902160300-c5mtium","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902160300-i32fkjc","Type":"NodeParagraph","Properties":{"id":"20240902160300-i32fkjc","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"黑芝麻《中华本草》"}]},{"ID":"20240902160300-2yvitfv","Type":"NodeParagraph","Properties":{"id":"20240902160300-2yvitfv","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【出处】《晶珠本草》记载：“芝麻分黑白两种。除颜色不同外，形状大小一样，扁而微椭圆形，上大下小，有棱，略像菥蓂子，用指挤压有油性。治龙病、镇风，增加体力。”巴保说：芝麻性温、缓、凉、重，化味辛。生发，增生体力，涩尿，舒心，提升胃温，生培根、赤巴。让钧多杰说：黑、白芝麻均祛风，治龙病。"}]},{"ID":"20240902160300-rvn2w4f","Type":"NodeParagraph","Properties":{"id":"20240902160300-rvn2w4f","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【拼音名】HēiZhīMɑ"}]},{"ID":"20240902160300-xleqjt9","Type":"NodeParagraph","Properties":{"id":"20240902160300-xleqjt9","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【别名】胡麻、巨胜、狗虱、乌麻、乌麻子、油麻、油麻子、黑油麻、脂麻、巨胜子、黑脂麻、乌芝麻、小胡麻"}]},{"ID":"20240902160300-okyog8x","Type":"NodeParagraph","Properties":{"id":"20240902160300-okyog8x","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902160300-suy2qy1","Type":"NodeParagraph","Properties":{"id":"20240902160300-suy2qy1","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"药材基源：为胡麻科植物芝麻的黑色种子。"}]},{"ID":"20240902160300-mg8v4n4","Type":"NodeParagraph","Properties":{"id":"20240902160300-mg8v4n4","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：SesamumindicumL.[S.orientaleL]"}]},{"ID":"20240902160300-vkqflvj","Type":"NodeParagraph","Properties":{"id":"20240902160300-vkqflvj","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"采收和储藏：8-9月果实呈黄黑时采收，割取全株，捆扎成小把，顶端向上，晒干，打下种子，去除杂质后再晒。"}]},{"ID":"20240902160300-1rhxqpk","Type":"NodeParagraph","Properties":{"id":"20240902160300-1rhxqpk","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【原形态】芝麻，一年生草本，高80-180cm。茎直立，四棱形，棱角突出，基部稍木质化，不分枝，具短柔毛。叶对生，或上部者互生；叶柄长1-7cm；叶片卵形、长圆形或披针形，长5-15cm，宽1-8cm，先端急尖或渐尖，基部楔形，全缘、有锯齿或下部叶3浅裂，表面绿色，背面淡绿色，两面无毛或稍被白以柔毛。花单生，或2-3朵生于叶腋，直径1-1.5cm；花萼稍合生，绿色，5裂，裂片披针形，长5-10cm，具柔毛；花冠筒状，唇形，长1.5-2.5cm，白色，有紫色或黄色采晕，裂片圆形，外侧被柔毛；雄蕊4，着生于花冠筒基部，花药黄色，呈矢形；雌蕊1，心皮2，子房圆锥形，初期呈假4室，成熟后为2室，花柱线形，柱头2裂。蒴果椭圆形，长2-2.5cm，多4棱或6、8棱，纵裂，初期绿色，成熟后黑褐色，具短柔毛。种子多数，卵形，两侧扁平，黑然、白色或淡黄色。花期5-9月，果期7-9月。"}]},{"ID":"20240902160300-glacquf","Type":"NodeParagraph","Properties":{"id":"20240902160300-glacquf","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902160300-xeem9p9","Type":"NodeParagraph","Properties":{"id":"20240902160300-xeem9p9","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"生态环境：常栽培于夏季气温较高，气候干燥，排水良好的沙壤土或壤土地区。"}]},{"ID":"20240902160300-ndho45a","Type":"NodeParagraph","Properties":{"id":"20240902160300-ndho45a","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"资源分布：我国除西藏高原外，各地区均有栽培。"}]},{"ID":"20240902160300-8oa8u16","Type":"NodeParagraph","Properties":{"id":"20240902160300-8oa8u16","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902160300-fgwdfvr","Type":"NodeParagraph","Properties":{"id":"20240902160300-fgwdfvr","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"性状鉴别：本品扁卵圆形，长2.5～4mm，宽1.5～2mm，一端钝圆，另端尖，厚约1mm，表面黑色，有网状皱纹或不明显，扩大镜下可见细小疣状突起，边缘平滑或有2圈凸起的棱线，尖端有圆点状棕色的种脐，种皮膜质。胚乳白色，肉质，包于胚外成1薄层。胚直生，有2片大形白色的子叶，油性。气微弱，味淡，压碎后有麻油香气。"}]},{"ID":"20240902160300-ga9gkpx","Type":"NodeParagraph","Properties":{"id":"20240902160300-ga9gkpx","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"显微鉴别：种子横切面：种皮部分最外为1列栅状排列的圆柱形细胞，外壁略向外凸出呈圆头状，细胞中充满黑色素，并含一枚大型的球状草酸钙结晶团，系由大量小柱晶结合而成，向内为一列扁形细胞，壁薄，细胞腔内常见分散的小柱晶，再向内可见数层颓废的压扁的外胚乳细胞，内胚乳为3～4层薄壁细胞，多角形。子叶呈双面型，上表皮之下为圆柱形的栅栏细胞。胚乳与胚的细胞内均充满淀粉粒和脂肪油。"}]},{"ID":"20240902160300-z2d8z14","Type":"NodeParagraph","Properties":{"id":"20240902160300-z2d8z14","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"粉末鉴别：黑灰色，油性，具香气。外种皮细胞表面观呈多角形，细胞内充满黑色素，并含一枚大型的球状草酸钙结晶团，直径25～48μm。子叶及胚乳细胞类圆形，含大量糊粉粒。游离糊粉粒卵圆形，长3～7μm，内含一个球晶体及一个方形或多角形的拟晶体。脂肪油滴散在。"}]},{"ID":"20240902160300-9slo7l4","Type":"NodeParagraph","Properties":{"id":"20240902160300-9slo7l4","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【化学成份】黑芝麻种子含脂肪油可达55％，油中含油酸(约48％)、亚油酸(约37％)、棕榈酸、硬脂酸、花生油酸、廿四烷酸的甘油脂，并含芝麻素(sesaminC(20)H(18)O(6))、芝麻林素(sesamolin,C(20)H(18)O(7))、芝麻酚(sesamol，C(7)H(6)O(3))、维生素E、植物甾醇、卵磷脂等成分。尚含胡麻甙(pedaliin)、蛋白质及寡糖类、车前糖(planteose)、芝麻糖(sesamose)。以及少量磷、钾及细胞色素C(cytochromec)、叶酸，烟酸、蔗糖、戊聚糖和多量的钙等。"}]},{"ID":"20240902160300-8b09w5z","Type":"NodeParagraph","Properties":{"id":"20240902160300-8b09w5z","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902160300-jq3taar","Type":"NodeParagraph","Properties":{"id":"20240902160300-jq3taar","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"1．降血糖作用：种子提取物给大鼠口服，可降低血糖，增加肝脏及肌肉中糖元的含量，但大剂量则降低糖元含量。"}]},{"ID":"20240902160300-umt4hgm","Type":"NodeParagraph","Properties":{"id":"20240902160300-umt4hgm","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"2．促肾上腺作用：黑芝麻0.2ml／100g体重喂饲大鼠，可增加肾上腺中抗坏血酸及胆固醇含量。"}]},{"ID":"20240902160300-28nw57s","Type":"NodeParagraph","Properties":{"id":"20240902160300-28nw57s","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"3．抗炎作用：灭菌的芝麻油涂布皮肤粘膜，有减轻刺激，促进炎症恢复等作用。"}]},{"ID":"20240902160300-54ib202","Type":"NodeParagraph","Properties":{"id":"20240902160300-54ib202","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"4．致泻作用：种子有致泻作用。"}]},{"ID":"20240902160300-dm7rrz7","Type":"NodeParagraph","Properties":{"id":"20240902160300-dm7rrz7","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"5．对心血管作用：黑芝麻中的亚油酸可使血中胆固醇含量降低，有防治冠状动脉硬化的作用。"}]},{"ID":"20240902160300-dvn3opa","Type":"NodeParagraph","Properties":{"id":"20240902160300-dvn3opa","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；性平"}]},{"ID":"20240902160300-e7be8z1","Type":"NodeParagraph","Properties":{"id":"20240902160300-e7be8z1","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【归经】肝；脾；肾经"}]},{"ID":"20240902160300-hul5g5i","Type":"NodeParagraph","Properties":{"id":"20240902160300-hul5g5i","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【功能主治】补益肝肾；养血益精；润肠通便。主肝肾不足所致的头晕耳鸣、腰脚痿软、须发早发、肌肤干燥；肠燥便秘；妇人乳少；痈疮湿疹；风癞疬疡；小儿瘰疬；汤火伤；痔疮"}]},{"ID":"20240902160300-4jz01e5","Type":"NodeParagraph","Properties":{"id":"20240902160300-4jz01e5","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9-15g；或入丸、散。外用：适量，煎水洗浴或捣敷。"}]},{"ID":"20240902160300-xfu7clb","Type":"NodeParagraph","Properties":{"id":"20240902160300-xfu7clb","updated":"20240902160306"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902160301-uwsxx1y","Type":"NodeThematicBreak","Properties":{"id":"20240902160301-uwsxx1y","updated":"20240902160306"}},{"ID":"20240902160302-bdsc4r2","Type":"NodeParagraph","Properties":{"id":"20240902160302-bdsc4r2","updated":"20240902160306"}}]}