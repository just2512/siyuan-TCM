:"20240829113527-h0hhgpj","Type":"NodeParagraph","Properties":{"id":"20240829113527-h0hhgpj","updated":"20240902102151"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛大力"}]},{"ID":"20240902102152-ah18z6y","Type":"NodeParagraph","Properties":{"id":"20240902102152-ah18z6y","updated":"20240902102204"},"Children":[{"Type":"NodeText","Data":"性味：味甘，性平；"}]},{"ID":"20240902102205-eu73ec7","Type":"NodeParagraph","Properties":{"id":"20240902102205-eu73ec7","updated":"20240902102215"},"Children":[{"Type":"NodeText","Data":"归经：归肾、肺经；"}]},{"ID":"20240902102215-ibpb2sz","Type":"NodeParagraph","Properties":{"id":"20240902102215-ibpb2sz","updated":"20240902102220"},"Children":[{"Type":"NodeText","Data":"功效：补虚润肺，强筋活络。"}]},{"ID":"20240902102221-iuv8vqo","Type":"NodeParagraph","Properties":{"id":"20240902102221-iuv8vqo","updated":"20240902102226"},"Children":[{"Type":"NodeText","Data":"主治：用于腰肌劳损，风湿性关节炎，治肺热，肺虚咳嗽，肺结核，慢性支气管炎，慢性肝炎，遗精，白带。"}]},{"ID":"20240902102238-l0czeya","Type":"NodeParagraph","Properties":{"id":"20240902102238-l0czeya","updated":"20240902102240"},"Children":[{"Type":"NodeText","Data":"相关配伍："}]},{"ID":"20240902102243-4bg9klu","Type":"NodeParagraph","Properties":{"id":"20240902102243-4bg9klu","updated":"20240902102245"},"Children":[{"Type":"NodeText","Data":"1、体虚白带：牛大力、杜仲藤各12g，千斤拔、五指毛桃各9g，大血藤15g，水煎服。右将上药炖猪脚，去药渣，吃肉喝汤。(《福建药物志》)\n2、胸膜炎：牛大力藤15g，一见喜3g，水煎服。(《福建药物志》)"}]},{"ID":"20240902102156-o8pnsy5","Type":"NodeThematicBreak","Properties":{"id":"20240902102156-o8pnsy5"}},{"ID":"20240902102157-ucxqag5","Type":"NodeParagraph","Properties":{"id":"20240902102157-ucxqag5"}}]}