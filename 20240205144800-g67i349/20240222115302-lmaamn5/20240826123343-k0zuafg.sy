{"ID":"20240826123343-k0zuafg","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240826123343-k0zuafg","title":"穿破石（构棘、九层皮、黄龙脱壳）","type":"doc","updated":"20240902143913"},"Children":[{"ID":"20240829143155-kdvbmc3","Type":"NodeParagraph","Properties":{"id":"20240829143155-kdvbmc3","updated":"20240829143304"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 444px;","style":"width: 434px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"穿破石 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/穿破石 15-20240829143255-drtctnu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 434px;\" parent-style=\"width: 444px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829140023-pg2ddjh","Type":"NodeParagraph","Properties":{"id":"20240829140023-pg2ddjh","updated":"20240829140504"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 389px;","style":"width: 379px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"穿破石 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/穿破石 6-20240829140023-wgjoepf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 379px;\" parent-style=\"width: 389px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 816px;","style":"width: 806px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"穿破石 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/穿破石 9-20240829140504-er5ky81.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 806px;\" parent-style=\"width: 816px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":