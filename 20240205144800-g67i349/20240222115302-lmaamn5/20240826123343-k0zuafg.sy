e=\"width: 487px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829143711-4zrc6p8","Type":"NodeParagraph","Properties":{"id":"20240829143711-4zrc6p8","updated":"20240829143711"}},{"ID":"20240829141507-kt07yax","Type":"NodeParagraph","Properties":{"id":"20240829141507-kt07yax","updated":"20240829145324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为柘木"}]},{"ID":"20240829143825-z19c8eb","Type":"NodeParagraph","Properties":{"id":"20240829143825-z19c8eb","updated":"20240829145511"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 412px;","style":"width: 402px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柘木"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柘木-20240829143825-sxleykl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 402px;\" parent-style=\"width: 412px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柘木 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柘木 1-20240829145302-bmdt5zj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829145607-xqhevf1","Type":"NodeParagraph","Properties":{"id":"20240829145607-xqhevf1","updated":"20240829145617"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柘木 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柘木 3-20240829145611-6qog08s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 369px;","style":"width: 359px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柘木 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柘木 2-20240829145511-bjacech.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 359px;\" parent-style=\"width: 369px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829140735-ya4592t","Type":"NodeParagraph","Properties":{"id":"20240829140735-ya4592t","updated":"20240829140854"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（柘木的成熟果实是红色的，穿破石的成熟果实是黄色的；柘木的刺是直的，穿破石的刺是倒勾的；柘木的叶子比较大，穿破石叶子较窄小）"}]},{"ID":"20240829145316-727gj47","Type":"NodeParagraph","Properties":{"id":"20240829145316-727gj47","updated":"20240829145316"}},{"ID":"20240829142601-zzffpz0","Type":"NodeParagraph","Properties":{"id":"20240829142601-zzffpz0","updated":"20240829142615"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：穿破石和柘木较为相似，注意甄别；"}]},{"ID":"20240829134001-areg3m3","Type":"NodeParagraph","Properties":{"id":"20240829134001-areg3m3","updated":"20240829142619"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：种类较多，未按品种分类；"}]},{"ID":"20240829141619-ts7ocrp","Type":"NodeParagraph","Properties":{"id":"20240829141619-ts7ocrp","updated":"20240829142621"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：穿破石根部外皮较软，手掰可以造成一大片一大片脱落，这也是其另一个名字‘九层皮’的由来；"}]},{"ID":"20240829133937-q6s68h9","Type":"NodeThematicBreak","Properties":{"id":"20240829133937-q6s68h9"}},{"ID":"20240902143905-98pj55z","Type":"NodeParagraph","Properties":{"id":"20240902143905-98pj55z","updated":"20240902143913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：穿破石"}]},{"ID":"20240902143905-k33kye3","Type":"NodeParagraph","Properties":{"id":"20240902143905-k33kye3","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"穿破石《全国中草药汇编》"}]},{"ID":"20240902143905-luhs7yt","Type":"NodeParagraph","Properties":{"id":"20240902143905-luhs7yt","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChuānPòShí"}]},{"ID":"20240902143905-jza61xt","Type":"NodeParagraph","Properties":{"id":"20240902143905-jza61xt","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【别名】葨芝、金蝉退壳、黄龙退壳、牵牛入石、金腰带、黄蛇根、山荔枝、千重皮"}]},{"ID":"20240902143905-ydb3s5e","Type":"NodeParagraph","Properties":{"id":"20240902143905-ydb3s5e","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902143905-gplml91","Type":"NodeParagraph","Properties":{"id":"20240902143905-gplml91","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"桑科柘属植物构棘Cudraniacochinchinensis（Lour.）KudoetMasam.，以根入药。全年可采，洗净切片晒干。"}]},{"ID":"20240902143905-0y1p10e","Type":"NodeParagraph","Properties":{"id":"20240902143905-0y1p10e","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"同属植物柘树（刺桑）Cudraniatricuspidata（Carr.）Bur.。功效与前种大致相同。"}]},{"ID":"20240902143905-0tkyf4i","Type":"NodeParagraph","Properties":{"id":"20240902143905-0tkyf4i","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【性味】微苦，平。"}]},{"ID":"20240902143905-jph0m36","Type":"NodeParagraph","Properties":{"id":"20240902143905-jph0m36","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【功能主治】止咳化痰，祛风利湿，散瘀止痛。用于肺结核，黄疸型肝炎，肝脾肿大，胃、十二指肠溃疡，风湿性腰腿痛；外用治骨折，跌打损伤。"}]},{"ID":"20240902143905-pbrfavj","Type":"NodeParagraph","Properties":{"id":"20240902143905-pbrfavj","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～1两；外用适量，根皮捣烂敷患处。"}]},{"ID":"20240902143905-4eyo8os","Type":"NodeParagraph","Properties":{"id":"20240902143905-4eyo8os","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【注意】孕妇忌服。"}]},{"ID":"20240902143905-ng2x58r","Type":"NodeParagraph","Properties":{"id":"20240902143905-ng2x58r","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902143905-7qko8vv","Type":"NodeParagraph","Properties":{"id":"20240902143905-7qko8vv","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"穿破石《*辞典》"}]},{"ID":"20240902143905-ca9pl9j","Type":"NodeParagraph","Properties":{"id":"20240902143905-ca9pl9j","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【出处】《岭南采药录》"}]},{"ID":"20240902143905-gu3ov44","Type":"NodeParagraph","Properties":{"id":"20240902143905-gu3ov44","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChuānPòShí"}]},{"ID":"20240902143905-sem8coa","Type":"NodeParagraph","Properties":{"id":"20240902143905-sem8coa","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【别名】柘根（《千金方》），川破石（《生草药性备要》），地棉根、拉牛入石（《岭南采药录》），黄蛇（《广东中药》）。"}]},{"ID":"20240902143905-po52l5h","Type":"NodeParagraph","Properties":{"id":"20240902143905-po52l5h","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【来源】为桑科植物小柘树或柘树的根。全年可采。挖出根后，削去支根，洗净，截段晒干，或开片晒干。"}]},{"ID":"20240902143905-0b69io3","Type":"NodeParagraph","Properties":{"id":"20240902143905-0b69io3","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902143905-pzz1peo","Type":"NodeParagraph","Properties":{"id":"20240902143905-pzz1peo","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"①小柘树，又名：奴柘（《本草拾遗》），隈枝（《益部方物略记》），隈支（《纲目》），葨芝（《云谷杂记》），构棘、九层皮、假荔枝、猴欢喜、山荔枝，黄金刺、鸟不踏、老鼠刺、饭团竻、野梅子。"}]},{"ID":"20240902143905-go423g5","Type":"NodeParagraph","Properties":{"id":"20240902143905-go423g5","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"常绿直立或攀援状灌木，高2～4米。根皮柔软，黄色。枝灰褐色，光滑，皮孔散生，具粗壮、直立或微弯的棘刺，长5～10毫米。单叶互生，革质，倒卵状披针形、椭圆形或长椭圆形，长4～9厘米，宽1.5～2.8厘米，先端钝或渐尖，基部楔形，全缘，两面无毛；叶柄长5～10毫米，花单性，雌雄异株；头状花序单生或成对，具短柄，被柔毛：雄花序径6毫米，花被片3～5，楔形，不相等，被毛；雌花序球状，结果时增大，径约1.8厘米，花被片4，顶端厚，被茸毛。聚花果球形，肉质，直径达5厘米，被毛，瘦果包裹在肉质的花被和苞片中。花期4～5月。果期9～10月。"}]},{"ID":"20240902143905-7wrivtw","Type":"NodeParagraph","Properties":{"id":"20240902143905-7wrivtw","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"②柘树，详\"柘木\"条。"}]},{"ID":"20240902143905-ewspg3i","Type":"NodeParagraph","Properties":{"id":"20240902143905-ewspg3i","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于山坡、溪边、灌丛中。分布湖南、安徽、浙江、福建、广东、广西等地。产广东、广西、福建等地。"}]},{"ID":"20240902143905-xczza2q","Type":"NodeParagraph","Properties":{"id":"20240902143905-xczza2q","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【性状】干燥根呈圆柱形，极少分枝，粗细不一，粗者可达5～6厘米。外表栓皮橙黄色或橙红色，有细密横皱纹，菲薄如纸，极易脱落；栓皮脱落后，表面现灰黄色，并有棕黄色或橙黄色斑块。质坚硬。横切面皮部薄，纤维性，木部发达，黄色，满布细小密集的针孔状导管，中心或有小的髓部。以皮色黄、根条匀、无须根者为佳。"}]},{"ID":"20240902143905-awaixnv","Type":"NodeParagraph","Properties":{"id":"20240902143905-awaixnv","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【化学成份】小柘树根含黄酮甙、酚类、氨基酸、有机酸、糖类。"}]},{"ID":"20240902143905-v2a0pnb","Type":"NodeParagraph","Properties":{"id":"20240902143905-v2a0pnb","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【炮制】洗净，润透，斜切薄片，晒干。"}]},{"ID":"20240902143905-av1j9z8","Type":"NodeParagraph","Properties":{"id":"20240902143905-av1j9z8","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902143905-8m4ykjt","Type":"NodeParagraph","Properties":{"id":"20240902143905-8m4ykjt","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"淡微苦，凉。"}]},{"ID":"20240902143905-o2rk1ko","Type":"NodeParagraph","Properties":{"id":"20240902143905-o2rk1ko","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"①《生草药性备要》：\"味甜，性平。\""}]},{"ID":"20240902143905-496eee1","Type":"NodeParagraph","Properties":{"id":"20240902143905-496eee1","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"②《闽东本草》：\"味甘，性温。\""}]},{"ID":"20240902143905-r519vt8","Type":"NodeParagraph","Properties":{"id":"20240902143905-r519vt8","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"③广州部队《常用中草药手册》：\"淡微苦，微凉。\""}]},{"ID":"20240902143905-0emwq7r","Type":"NodeParagraph","Properties":{"id":"20240902143905-0emwq7r","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"④《广西实用中草药新选》：\"微苦微甘，性平，无毒。\""}]},{"ID":"20240902143905-ezl0y34","Type":"NodeParagraph","Properties":{"id":"20240902143905-ezl0y34","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑤《云南中草药选》：\"淡微甘，凉。\""}]},{"ID":"20240902143905-yephb4c","Type":"NodeParagraph","Properties":{"id":"20240902143905-yephb4c","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902143905-lc1yeyc","Type":"NodeParagraph","Properties":{"id":"20240902143905-lc1yeyc","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"祛风利湿，活血通经。治风湿关节疼痛，黄疸，淋浊，蛊胀，闭经，劳伤咳血，跌打损伤，疔疮痈肿。"}]},{"ID":"20240902143905-jgvu6ho","Type":"NodeParagraph","Properties":{"id":"20240902143905-jgvu6ho","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"①姚可成《食物本草》：\"治疮疡疥癣。\""}]},{"ID":"20240902143905-o5glexi","Type":"NodeParagraph","Properties":{"id":"20240902143905-o5glexi","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"②《生草药性备要》：\"治酒顶，消蛊胀；浸酒祛风。\""}]},{"ID":"20240902143905-g35x1ir","Type":"NodeParagraph","Properties":{"id":"20240902143905-g35x1ir","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"③《本草求原》：\"壮筋骨，活血，理跌打。\""}]},{"ID":"20240902143905-shktell","Type":"NodeParagraph","Properties":{"id":"20240902143905-shktell","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"④《岭南采药录》：\"祛风湿，十蒸九晒；治跌打，酒煎服；肩疮和蜜捣敷。\""}]},{"ID":"20240902143905-y1oih0y","Type":"NodeParagraph","Properties":{"id":"20240902143905-y1oih0y","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑤《南宁市药物志》：\"血通经，治淋浊，去远年瘀积、结石。\""}]},{"ID":"20240902143905-eebj5vo","Type":"NodeParagraph","Properties":{"id":"20240902143905-eebj5vo","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑥《闽东本草》：\"健脾益胃，舒筋活络，祛风湿，去瘀血。治腰痛、关节痛，虚劳黄肿，脾虚泄泻。\""}]},{"ID":"20240902143905-ctmsgqw","Type":"NodeParagraph","Properties":{"id":"20240902143905-ctmsgqw","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑦广州部队《常用中草药手册》：\"凉血散瘀。治经闭。\""}]},{"ID":"20240902143905-6b3a2kv","Type":"NodeParagraph","Properties":{"id":"20240902143905-6b3a2kv","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑧《广西实用中草药新选》：\"清热活血，止咳祛痰，治劳伤咳血。\""}]},{"ID":"20240902143905-kklpkcy","Type":"NodeParagraph","Properties":{"id":"20240902143905-kklpkcy","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑨《云南中草药选》：\"消炎止痛，治流行性腮腺炎，疖肿。\""}]},{"ID":"20240902143905-7w9410q","Type":"NodeParagraph","Properties":{"id":"20240902143905-7w9410q","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑩《福建中草药》：\"清热利湿。治湿热黄疸，湿热痹，疔疮痈肿。\""}]},{"ID":"20240902143905-laxuevy","Type":"NodeParagraph","Properties":{"id":"20240902143905-laxuevy","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，2～4钱（鲜者1～2两）；或浸酒。外用：捣敷。"}]},{"ID":"20240902143905-twq18xn","Type":"NodeParagraph","Properties":{"id":"20240902143905-twq18xn","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【注意】《南宁市药物志》：\"孕妇忌用。\""}]},{"ID":"20240902143905-6wxaek3","Type":"NodeParagraph","Properties":{"id":"20240902143905-6wxaek3","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902143905-38pv5rs","Type":"NodeParagraph","Properties":{"id":"20240902143905-38pv5rs","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"①治肺痨，风湿：穿破石、铁包金、甘草。同煎服。（《广东中药》）"}]},{"ID":"20240902143905-pxmfprm","Type":"NodeParagraph","Properties":{"id":"20240902143905-pxmfprm","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"②治体虚白带：柘树根一两。水煎服。（《浙江民间常用草药》）"}]},{"ID":"20240902143905-rhi4bxb","Type":"NodeParagraph","Properties":{"id":"20240902143905-rhi4bxb","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"③治挫伤：葨芝根和糯米捣敷。（《浙江中药资源名录》）"}]},{"ID":"20240902143905-n7mdl4m","Type":"NodeParagraph","Properties":{"id":"20240902143905-n7mdl4m","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"④治耳久聋鸣，或有汁出，皆由肾虚。致多年不瘥：故铁三十斤（烧令赤，以水五斗，渍铁三宿，澄清），菖蒲七斤（切，以水一石，煮取五斗，去滓，澄清），柘根三十斤（以水一石，煮取五斗，去滓，澄清）。上药，合成一石五斗，用米二石，并曲三斗，酿如常法，候酒熟即开，用磁石三斤，捣罗为末，纳酒中，渍三宿。日夜恒饮之，取醉为度，候听闻人语乃止。（《圣惠方》铁浆酒）"}]},{"ID":"20240902143905-9b4osrd","Type":"NodeParagraph","Properties":{"id":"20240902143905-9b4osrd","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"⑤治小儿心热，重舌，鹅口：柘根（锉）五升。以水五升，煮取二升，去滓更煎，取五合。细细敷之，数数为之。（《千金方》）"}]},{"ID":"20240902143905-hyr5c2b","Type":"NodeParagraph","Properties":{"id":"20240902143905-hyr5c2b","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗急、慢性肝炎:取穿破石2斤，五指毛桃半斤，葫芦茶3两，加水浸过药面煮2次，药液合并浓缩至1500毫升，加白糖300克及防腐剂，静置过滤。每次45毫升，对急性黄疸型肝炎及较重的慢性肝炎日服二次，轻症慢性肝炎日服一次，均以30天为一疗程。经治72例，临床治愈35例（急性黄疸型17例，慢性肝炎18例）；好转25例（急性黄疸型6例，慢性肝炎19例）；无效12例（慢性肝炎）。"}]},{"ID":"20240902143905-pgc4emz","Type":"NodeParagraph","Properties":{"id":"20240902143905-pgc4emz","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902143905-i0x6fw5","Type":"NodeParagraph","Properties":{"id":"20240902143905-i0x6fw5","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"穿破石《中华本草》"}]},{"ID":"20240902143905-k0h17vt","Type":"NodeParagraph","Properties":{"id":"20240902143905-k0h17vt","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【出处】出自《岭南采药录》"}]},{"ID":"20240902143905-jek03w3","Type":"NodeParagraph","Properties":{"id":"20240902143905-jek03w3","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【拼音名】ChuānPòShí"}]},{"ID":"20240902143905-hiys4uz","Type":"NodeParagraph","Properties":{"id":"20240902143905-hiys4uz","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【别名】柘根、川破石、地棉根、拉牛入石、柘藤根、黄蛇、山黄箕、铁篱根、黄龙脱皮、刺楮、山黄芪、野黄芪、九层皮、千层皮"}]},{"ID":"20240902143905-26c9dhg","Type":"NodeParagraph","Properties":{"id":"20240902143905-26c9dhg","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902143905-726qaga","Type":"NodeParagraph","Properties":{"id":"20240902143905-726qaga","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"药材基源：为桑科植物构棘或柘树的根。"}]},{"ID":"20240902143905-uktcf7p","Type":"NodeParagraph","Properties":{"id":"20240902143905-uktcf7p","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：l．构棘Macluracochinchinensis(Lour)Corner[VanieriacochinchinensisLour.;Cudraniacochinchinensis(Lour.)KudoetMasam.]u·）KudoetMasam．」。"}]},{"ID":"20240902143905-gf116zd","Type":"NodeParagraph","Properties":{"id":"20240902143905-gf116zd","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"2．柘树MacluratricuspidataCarr．[Cudraniatricuspidata（Carr．）Bur．］"}]},{"ID":"20240902143905-p2yq9qt","Type":"NodeParagraph","Properties":{"id":"20240902143905-p2yq9qt","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，挖出根部，除去泥土、须根，晒干；或洗净，趁鲜切片，晒干。亦可鲜用。"}]},{"ID":"20240902143905-pxnuldu","Type":"NodeParagraph","Properties":{"id":"20240902143905-pxnuldu","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902143905-xze5uhk","Type":"NodeParagraph","Properties":{"id":"20240902143905-xze5uhk","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"1.直立或攀援状；根皮橙黄色；枝灰褐色，光滑，皮孔散生，具直立或略弯的棘刺，粗壮，长5-10（-20）mm。单叶互生；叶柄长5-10mm；叶片革质，倒卵状椭圆形、椭圆形或长椭圆形，长3-9cm，宽1-2.8cm，先端钝或渐尖，或有微凹缺，基部楔形，全缘，两面无毛；基出脉3条，侧脉6-9对。花单性，雌雄异株；球状花序单个或成对腋生，具短柄，被柔毛；雄花序直径约6mm，雄花具花被片3-5，楔形，不相等，被毛；雌花序直径约1.8cm，雌花具花被片4，先端厚有绒毛。聚花果球形，肉质，熟时橙红色，直径3-5cm，被毛；瘦果包裹在肉质的花被和苞片中。花期4-5月，果期9-10月。"}]},{"ID":"20240902143905-37n399v","Type":"NodeParagraph","Properties":{"id":"20240902143905-37n399v","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"2.落叶灌木或小乔木，高达8m。小枝暗绿褐色，具坚硬棘刺，刺长5-35mm。单叶互生；叶柄长0.5-2cm；托叶侧生，分离；叶片近革质，卵圆形或倒卵形，长5-13cm，先端钝或渐尖，基部楔形或圆形，全缘或3裂，上面暗绿色，下面淡绿色，幼时两面均有毛，成长后下面主脉略有毛，余均光滑无毛；基出脉3条，侧脉4-5对。花单性，雌雄异株；均为球形头状花序，具短梗，单个或成对着生于叶腋；雄花花被片4，长圆形，基部有苞片2或4，雄蕊4，花丝直立；雌花被片4，花柱1，线状。聚花果球形，肉质，直径约2.5cm，橘红色或橙黄色，表面呈微皱缩，瘦果包裹在肉质的花被里。花期5-6月，果期9-10月。"}]},{"ID":"20240902143905-1nh941u","Type":"NodeParagraph","Properties":{"id":"20240902143905-1nh941u","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902143905-mexxkrk","Type":"NodeParagraph","Properties":{"id":"20240902143905-mexxkrk","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于山坡。溪边灌丛中或山谷、林缘等处。"}]},{"ID":"20240902143905-ruco3tp","Type":"NodeParagraph","Properties":{"id":"20240902143905-ruco3tp","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"2.生于海拔200-1500m的阳光充足的荒坡、山地、林绿和溪旁。"}]},{"ID":"20240902143905-k9ubs9v","Type":"NodeParagraph","Properties":{"id":"20240902143905-k9ubs9v","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于安徽、浙江、江西、福建、湖北、湖南、广东、海南、广西、四川、贵州、云南等地.2.分布于华东、中南、西南及河北、陕西、甘肃等地。"}]},{"ID":"20240902143905-x598ofx","Type":"NodeParagraph","Properties":{"id":"20240902143905-x598ofx","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【性状】性状鉴别很圆柱形，长短不一，直径且1.5-2.5cm；或已切成圆形厚片。外皮黄色或橙红色，具显着的纵皱纹及少数须根痕。栓皮薄而易脱落。质地坚硬，不易折断，断面皮部薄，灰黄色，具韧性纤维，木部占绝大部分。黄色，柴性，导管孔明显，有的中央部位有小髓。气微，味淡。"}]},{"ID":"20240902143905-q4c25et","Type":"NodeParagraph","Properties":{"id":"20240902143905-q4c25et","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【化学成份】根含柘树异黄酮（cudraisoflavone）A,3′－O-甲基香豌豆甙元（3’－O-methylorobol），去氢木香内酯（dehydrocostuslactone），亚油酸甲酯（methyllinoleate），β-谷甾醇（β－sitoste-rol）［l］。"}]},{"ID":"20240902143905-v2dsjkz","Type":"NodeParagraph","Properties":{"id":"20240902143905-v2dsjkz","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【药理作用】柘木根乙醇提取物有较好的抗结核菌作用。试管中，采用改良苏通半流体琼脂培养基，接种强毒人型结核菌（H37RV），其最低抑菌浓度为6.3-12.5μg／ml。体内抗菌试验表明，给感染结核菌小鼠第2日开始给予柘木注射液1.5g／只，每日1次，至对照组半数动物死亡时停药，可显着延长感染小鼠的半数存活时间［1，2」."}]},{"ID":"20240902143905-c6xlcxs","Type":"NodeParagraph","Properties":{"id":"20240902143905-c6xlcxs","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【炮制】洗净，润透，斜切薄片，晒干。"}]},{"ID":"20240902143905-5iv7jj5","Type":"NodeParagraph","Properties":{"id":"20240902143905-5iv7jj5","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【性味】味淡；微苦；性凉"}]},{"ID":"20240902143905-ncj0g5m","Type":"NodeParagraph","Properties":{"id":"20240902143905-ncj0g5m","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【功能主治】祛风通络；清热除湿；解毒消肿。主风湿痹痛；跌打损伤；黄疽；腮腺炎；肺结核；胃和十二指肠溃疡；淋浊；蛊胀；闭经；劳伤咳血；疗疮痈肿"}]},{"ID":"20240902143905-ob6jgpw","Type":"NodeParagraph","Properties":{"id":"20240902143905-ob6jgpw","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，9～30g,鲜者可用至1209；或浸酒。外用：适量，捣敷。"}]},{"ID":"20240902143905-lsleja2","Type":"NodeParagraph","Properties":{"id":"20240902143905-lsleja2","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【注意】《南宁市药物志》：孕妇忌用。"}]},{"ID":"20240902143905-71rgctn","Type":"NodeParagraph","Properties":{"id":"20240902143905-71rgctn","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【附方】①治肺痨，风湿：穿破石、铁包金、甘草。同煎服。(《广东中药》)②治体虚白带：柘树根一两。水煎服。(《浙江民间常用草药》)③治挫伤：葨芝根和糯米捣敷。(《浙江中药资源名录》)④治耳久聋鸣，或有汁出，皆由肾虚，致多年不瘥：故铁三十斤(烧令赤，以水五斗，渍铁三宿，澄清)，菖蒲七斤(切，以水一石，煮取五斗，去滓，澄清)，柘根三十斤(以水一石，煮取五斗，去滓，澄清)。上药，合成一石五斗，用米二石，并曲三斗，酿如常法，侯酒熟即开，用磁石三斤，捣罗为末，纳酒中，渍三宿。日夜恒饮之，取醉为度，候听闻人语乃止。(《圣惠方》铁浆酒)⑤治小儿心热，重舌，鹅口：柘根(锉)五升。以水五升，煮取二升，去滓更煎，取五合。细细敷之，数数为之。(《千金方》)"}]},{"ID":"20240902143905-4kp7l14","Type":"NodeParagraph","Properties":{"id":"20240902143905-4kp7l14","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902143905-7hhnrgo","Type":"NodeParagraph","Properties":{"id":"20240902143905-7hhnrgo","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"1.姚可成《食物本草》：治疮疡疥癣。"}]},{"ID":"20240902143905-3uns38h","Type":"NodeParagraph","Properties":{"id":"20240902143905-3uns38h","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"2.《生草药性备要》：治酒顶，消蛊胀；浸酒祛风。"}]},{"ID":"20240902143905-8aubx72","Type":"NodeParagraph","Properties":{"id":"20240902143905-8aubx72","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"3.《本草求原》：壮筋骨，活血，理跌打。"}]},{"ID":"20240902143905-o5gee4z","Type":"NodeParagraph","Properties":{"id":"20240902143905-o5gee4z","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"4.《岭南采药录》：祛风湿，十蒸九晒；治跌打，酒煎服；肩疮和蜜捣敷。"}]},{"ID":"20240902143905-ycy8i3x","Type":"NodeParagraph","Properties":{"id":"20240902143905-ycy8i3x","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"5.《南宁市药物志》：破血通经，治淋浊，去远年瘀积、结石。"}]},{"ID":"20240902143905-2ekqhpo","Type":"NodeParagraph","Properties":{"id":"20240902143905-2ekqhpo","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"6.《闽东本草》：健脾益胃，舒筋活络，祛风湿，去瘀血。治腰痛、关节痛，虚劳黄肿，脾虚泄泻。"}]},{"ID":"20240902143905-bzsjc66","Type":"NodeParagraph","Properties":{"id":"20240902143905-bzsjc66","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"7.广州部队《常用中草药手册》：凉血散瘀。治经闭。"}]},{"ID":"20240902143905-lnybfhg","Type":"NodeParagraph","Properties":{"id":"20240902143905-lnybfhg","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"8.《广西实用中草药新选》：清热活血，止咳祛痰。治劳伤咳血。"}]},{"ID":"20240902143905-1sn9l9c","Type":"NodeParagraph","Properties":{"id":"20240902143905-1sn9l9c","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"9.《云南中草药选》：消炎止痛。治流行性腮腺炎，疖肿。"}]},{"ID":"20240902143905-a6ki5ur","Type":"NodeParagraph","Properties":{"id":"20240902143905-a6ki5ur","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"10.《福建中草药》：清热利湿。治湿热黄疸，湿热痹，疔疮痈肿。"}]},{"ID":"20240902143905-9nbrrvw","Type":"NodeParagraph","Properties":{"id":"20240902143905-9nbrrvw","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗急、慢性肝炎。取穿破石2斤，五指毛挑(Ficussimplicissima)半斤，葫芦茶3两，加水浸过药面煮2次，药液合并浓缩至1500ml，加白糖300g及防腐剂，静置过滤。每次45ml，对急性黄疸型肝炎及较重的慢性肝炎日服二次，轻症慢性肝炎日服一次，均以30天为一疗程。经治72例，临床治愈35例(急性黄疸型17例，慢性肝炎18例)；好转25例(急性黄疸型6例、慢性肝炎19例)；无效12例(慢性肝炎)。"}]},{"ID":"20240902143905-yra0wpq","Type":"NodeParagraph","Properties":{"id":"20240902143905-yra0wpq","updated":"20240902143926"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902143906-zo0ovrm","Type":"NodeThematicBreak","Properties":{"id":"20240902143906-zo0ovrm","updated":"20240902143926"}},{"ID":"20240902143908-lw0qtbx","Type":"NodeParagraph","Properties":{"id":"20240902143908-lw0qtbx","updated":"20240902143926"}}]}