{"ID":"20240826123458-vbar24j","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240826123458-vbar24j","title":"玉米须","type":"doc","updated":"20240902103325"},"Children":[{"ID":"20240829131650-uiw46oa","Type":"NodeParagraph","Properties":{"id":"20240829131650-uiw46oa","updated":"20240829131650"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 446px;","style":"width: 436px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米须 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米须 1-20240829131650-1xooaqu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 436px;\" parent-style=\"width: 446px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829131638-avzta0p","Type":"NodeParagraph","Properties":{"id":"20240829131638-avzta0p","updated":"20240829131638"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 447px;","style":"width: 437px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米须"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米须-20240829131638-266b890.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 437px;\" parent-style=\"width: 447px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829131733-pbxlgj1","Type":"NodeParagraph","Properties":{"id":"20240829131733-pbxlgj1","updated":"20240829132023"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米-20240829131733-t2fz7br.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 1-20240829131759-b2eesh7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 6-20240829132023-3qwnjt8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829132400-e9oee77","Type":"NodeParagraph","Properties":{"id":"20240829132400-e9oee77","updated":"20240829132509"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 430px;","style":"width: 420px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 12-20240829132509-w08jmpf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 420px;\" parent-style=\"width: 430px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 850px;","style":"width: 840px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 10-20240829132400-h49ttcy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 840px;\" parent-style=\"width: 850px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829131819-u9m1l51","Type":"NodeParagraph","Properties":{"id":"20240829131819-u9m1l51","updated":"20240829132428"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 444px;","style":"width: 434px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 4-20240829131911-8s42pwd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 434px;\" parent-style=\"width: 444px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 788px;","style":"width: 778px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 11-20240829132428-cttek80.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 778px;\" parent-style=\"width: 788px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829131933-cwp9pis","Type":"NodeParagraph","Properties":{"id":"20240829131933-cwp9pis","updated":"20240829131935"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 616px;","style":"width: 606px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 5-20240829131933-ec5ziif.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 617px;","style":"width: 607px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 2-20240829131819-s5zhz31.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 607px;\" parent-style=\"width: 617px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829132239-6dqet0y","Type":"NodeParagraph","Properties":{"id":"20240829132239-6dqet0y","updated":"20240829133057"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 9-20240829132239-c0sqj26.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 462px;","style":"width: 452px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 15-20240829133000-dp94hcw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 452px;\" parent-style=\"width: 462px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 462px;","style":"width: 452px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 16-20240829133057-piimn1i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 452px;\" parent-style=\"width: 462px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829133504-wuelfr5","Type":"NodeParagraph","Properties":{"id":"20240829133504-wuelfr5","updated":"20240829133504"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 395px;","style":"width: 385px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 18-20240829133504-kpld18t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 385px;\" parent-style=\"width: 395px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 825px;","style":"width: 815px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玉米 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玉米 19-20240829133655-ok8z9zb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 815px;\" parent-style=\"width: 825px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829132634-j0i1m0m","Type":"NodeThematicBreak","Properties":{"id":"20240829132634-j0i1m0m"}},{"ID":"20240902103319-jpo3q9e","Type":"NodeParagraph","Properties":{"id":"20240902103319-jpo3q9e","updated":"20240902103325"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：玉米须"}]},{"ID":"20240902103319-u8poy6f","Type":"NodeParagraph","Properties":{"id":"20240902103319-u8poy6f","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须《全国中草药汇编》"}]},{"ID":"20240902103319-fqczg8l","Type":"NodeParagraph","Properties":{"id":"20240902103319-fqczg8l","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【拼音名】YùMǐXū"}]},{"ID":"20240902103319-ikfp28q","Type":"NodeParagraph","Properties":{"id":"20240902103319-ikfp28q","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【别名】玉蜀黍须、蜀黍须、包谷须"}]},{"ID":"20240902103319-rq5r3ns","Type":"NodeParagraph","Properties":{"id":"20240902103319-rq5r3ns","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【来源】禾本科玉蜀黍属植物玉米ZeamaysL.的花柱和花头。秋季收获玉米时采收，晒干或烘干。"}]},{"ID":"20240902103319-n55196h","Type":"NodeParagraph","Properties":{"id":"20240902103319-n55196h","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【炮制】晒干用。"}]},{"ID":"20240902103319-awf0lob","Type":"NodeParagraph","Properties":{"id":"20240902103319-awf0lob","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【性味】甘、淡，平。"}]},{"ID":"20240902103319-otnpi6v","Type":"NodeParagraph","Properties":{"id":"20240902103319-otnpi6v","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【归经】归膀胱、肝、胆经。"}]},{"ID":"20240902103319-xw65z0x","Type":"NodeParagraph","Properties":{"id":"20240902103319-xw65z0x","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【功能主治】利尿消肿，平肝利胆。用于急、慢性肾炎，水肿，急、慢性肝炎，高血压，糖尿病，慢性鼻窦炎，尿路结石，胆道结石，小便不利、湿热黄胆等症。并可预防习惯性流产。"}]},{"ID":"20240902103319-fz9ec4l","Type":"NodeParagraph","Properties":{"id":"20240902103319-fz9ec4l","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～2两，煎服。"}]},{"ID":"20240902103319-saw5wts","Type":"NodeParagraph","Properties":{"id":"20240902103319-saw5wts","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【备注】（1）用于水肿、小便不利，可配合冬瓜皮、赤小豆等同用；用治湿热黄胆疸，可配茵陈、平地木等同用。此外，本品近年来在临床应用上有所发展，常用于糖尿病、高血压、肝炎、胆道结石、鼻炎及哮喘等病症。"}]},{"ID":"20240902103319-tp2xrra","Type":"NodeParagraph","Properties":{"id":"20240902103319-tp2xrra","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902103319-pkg1l4q","Type":"NodeParagraph","Properties":{"id":"20240902103319-pkg1l4q","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须《*辞典》"}]},{"ID":"20240902103319-ugwlzhn","Type":"NodeParagraph","Properties":{"id":"20240902103319-ugwlzhn","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【出处】《四川中药志》"}]},{"ID":"20240902103319-wzfe36b","Type":"NodeParagraph","Properties":{"id":"20240902103319-wzfe36b","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【拼音名】YùMǐXū"}]},{"ID":"20240902103319-vhgrlqf","Type":"NodeParagraph","Properties":{"id":"20240902103319-vhgrlqf","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【别名】玉麦须（《滇南本草》），玉蜀黍蕊（《现代实用中药》），棒子毛（《河北药材》）。"}]},{"ID":"20240902103319-cfmv8cd","Type":"NodeParagraph","Properties":{"id":"20240902103319-cfmv8cd","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【来源】为禾本科植物玉蜀黍的花柱。"}]},{"ID":"20240902103319-5w475ul","Type":"NodeParagraph","Properties":{"id":"20240902103319-5w475ul","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【原形态】植物形态详\"玉蜀黍\"条。"}]},{"ID":"20240902103319-kqr6x50","Type":"NodeParagraph","Properties":{"id":"20240902103319-kqr6x50","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【化学成份】含脂肪油2.5％、挥发油0.12％、树胶样物质3.8％、树脂2.7％、苦味糖甙1.15％、皂甙3.18％、生物碱O.05％。还含隐黄素、抗坏血酸、泛酸、肌醇、维生素K、谷甾醇、豆甾醇、苹果酸、柠檬酸、酒石酸、草酸等。"}]},{"ID":"20240902103319-x5e3tdy","Type":"NodeParagraph","Properties":{"id":"20240902103319-x5e3tdy","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902103319-d6kl0dn","Type":"NodeParagraph","Properties":{"id":"20240902103319-d6kl0dn","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"①利尿作用"}]},{"ID":"20240902103319-4j30t6e","Type":"NodeParagraph","Properties":{"id":"20240902103319-4j30t6e","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须对人或家兔均有利尿作用，可增加氯化物排出量，但作用较弱。其水浸膏甲醇不溶部分经过透析者（甲）利尿作用最强，无论口服、皮下或静脉注射均有显着效果。利尿作用主要是肾外性的，对肾脏的作用很弱。"}]},{"ID":"20240902103319-qyxh7j8","Type":"NodeParagraph","Properties":{"id":"20240902103319-qyxh7j8","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"②对循环系统的作用"}]},{"ID":"20240902103319-wxsau3b","Type":"NodeParagraph","Properties":{"id":"20240902103319-wxsau3b","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"麻醉犬静脉注射煎剂有显着降压作用，但对慢性颈动脉皮桥狗，每日服药，连续3周，并无降压作用。甲在低浓度时对末梢血管有扩张作用。"}]},{"ID":"20240902103319-x62wxjf","Type":"NodeParagraph","Properties":{"id":"20240902103319-x62wxjf","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"③降低血糖作用"}]},{"ID":"20240902103319-g2r34dv","Type":"NodeParagraph","Properties":{"id":"20240902103319-g2r34dv","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须的发酵制剂对家兔有非常显着的降低血糖作用。"}]},{"ID":"20240902103319-v6a0hg0","Type":"NodeParagraph","Properties":{"id":"20240902103319-v6a0hg0","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"④利胆、止血作用"}]},{"ID":"20240902103319-iufs7s0","Type":"NodeParagraph","Properties":{"id":"20240902103319-iufs7s0","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须制剂能促进胆汁排泄，降低其粘度，减少其胆色素含量，因而可作为利胆药用于无并发症的慢性胆囊炎、胆汁排出障碍的胆管炎患者。它还能加速血液凝固过程，增加血中凝血酶元含量，提高血小板数，故可作为止血药兼利尿药应用于膀胱及尿路结石。"}]},{"ID":"20240902103319-oxr9slr","Type":"NodeParagraph","Properties":{"id":"20240902103319-oxr9slr","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902103319-vz5y0ak","Type":"NodeParagraph","Properties":{"id":"20240902103319-vz5y0ak","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"甘，平。"}]},{"ID":"20240902103319-ywzluke","Type":"NodeParagraph","Properties":{"id":"20240902103319-ywzluke","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性微温，味甘。\""}]},{"ID":"20240902103319-9y6l2xu","Type":"NodeParagraph","Properties":{"id":"20240902103319-9y6l2xu","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"②《现代实用中药》：\"甘，平。\""}]},{"ID":"20240902103319-u7s4ucf","Type":"NodeParagraph","Properties":{"id":"20240902103319-u7s4ucf","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"性平，味甘淡，无毒。\""}]},{"ID":"20240902103319-vzaekja","Type":"NodeParagraph","Properties":{"id":"20240902103319-vzaekja","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902103319-iwgpryv","Type":"NodeParagraph","Properties":{"id":"20240902103319-iwgpryv","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"利尿，泄热，平肝，利胆。治肾炎水肿，脚气，黄疸肝炎，高血压，胆囊炎，胆结石，糖尿病，吐血衄血，鼻渊，乳痈。"}]},{"ID":"20240902103319-dcyt55v","Type":"NodeParagraph","Properties":{"id":"20240902103319-dcyt55v","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"宽肠下气。治妇人乳结，乳汁不通，红肿疼痛，怕冷发热，头痛体困。\""}]},{"ID":"20240902103319-k1khopo","Type":"NodeParagraph","Properties":{"id":"20240902103319-k1khopo","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"②《岭南采药录》：\"和猪肉煎汤治糖尿病。又治小便淋沥砂石，苦痛不可忍，煎汤频服。\""}]},{"ID":"20240902103319-lie5tlq","Type":"NodeParagraph","Properties":{"id":"20240902103319-lie5tlq","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"③《现代实用中药》：\"为利尿药，对肾脏病、浮肿性疾患、糖尿病等有效。又为胆囊炎、胆石、肝炎性黄疸等的有效药。\""}]},{"ID":"20240902103319-xvj9pcf","Type":"NodeParagraph","Properties":{"id":"20240902103319-xvj9pcf","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"④《民间常用草药汇编》：\"能降低血压，利尿消肿。治鼻血、红崩。\""}]},{"ID":"20240902103319-j3pr26u","Type":"NodeParagraph","Properties":{"id":"20240902103319-j3pr26u","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑤《河北药材》：\"治水肿性脚气。\""}]},{"ID":"20240902103319-qa7sh8o","Type":"NodeParagraph","Properties":{"id":"20240902103319-qa7sh8o","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑥《浙江民间草药》：\"开胃，平肝，祛风。\""}]},{"ID":"20240902103319-snpm06e","Type":"NodeParagraph","Properties":{"id":"20240902103319-snpm06e","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑦《四川中药志》：\"清血热，利小便。治黄疸，风热，出疹，吐血及红崩。\""}]},{"ID":"20240902103319-ci73x9s","Type":"NodeParagraph","Properties":{"id":"20240902103319-ci73x9s","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2两；或烧存性研末。外用：烧烟吸入。"}]},{"ID":"20240902103319-mecy75o","Type":"NodeParagraph","Properties":{"id":"20240902103319-mecy75o","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902103319-8b1x07b","Type":"NodeParagraph","Properties":{"id":"20240902103319-8b1x07b","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"①治水肿：玉蜀黍须二两。煎水服，忌食盐。（《贵阳市秘方验方》）"}]},{"ID":"20240902103319-47c4907","Type":"NodeParagraph","Properties":{"id":"20240902103319-47c4907","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"②治肾脏炎，初期肾结石：玉蜀黍须，分量不拘，煎浓汤，频服。（《贵阳市秘方验方》）"}]},{"ID":"20240902103319-kn2ssjl","Type":"NodeParagraph","Properties":{"id":"20240902103319-kn2ssjl","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"③治肝炎黄疸：玉米须、金钱草、满天星、郁金、茵陈，煎服。"}]},{"ID":"20240902103319-kn86s21","Type":"NodeParagraph","Properties":{"id":"20240902103319-kn86s21","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"④治劳伤吐血：玉米须。小蓟，炖五花肉服。"}]},{"ID":"20240902103319-16nm2w2","Type":"NodeParagraph","Properties":{"id":"20240902103319-16nm2w2","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑤治吐血及红崩：玉米须，熬水炖肉服。"}]},{"ID":"20240902103319-e4jspef","Type":"NodeParagraph","Properties":{"id":"20240902103319-e4jspef","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑥治风疹块（俗称风丹）和热毒：玉米须烧灰，兑醪糟服。（③方以下出《四川中药志》）"}]},{"ID":"20240902103319-lte2uhu","Type":"NodeParagraph","Properties":{"id":"20240902103319-lte2uhu","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑦治糖尿病：玉蜀黍须一两。煎服。（《浙江民间草药》）"}]},{"ID":"20240902103319-731ajyg","Type":"NodeParagraph","Properties":{"id":"20240902103319-731ajyg","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑧治原发性高血压病：玉米须、西瓜皮、香蕉。煎服。（《四川中药志》）"}]},{"ID":"20240902103319-mr3352x","Type":"NodeParagraph","Properties":{"id":"20240902103319-mr3352x","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"⑨治脑漏：玉蜀黍须晒干，装旱烟筒上吸之。（《浙江民间草药》）"}]},{"ID":"20240902103319-bfndd03","Type":"NodeParagraph","Properties":{"id":"20240902103319-bfndd03","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【临床应用】"}]},{"ID":"20240902103319-1q8fg9r","Type":"NodeParagraph","Properties":{"id":"20240902103319-1q8fg9r","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"①治疗慢性肾炎"}]},{"ID":"20240902103319-zoh5qeg","Type":"NodeParagraph","Properties":{"id":"20240902103319-zoh5qeg","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"取干燥玉米须50克，加温水600毫升，用文火煎煮20～30分钟，约得300～400毫升药液，过滤后内服，每日1次或分次服完。治疗慢性血管球性肾炎9例，经10个多月观察，其中3例获得痊愈，2例进步，其余4例疗效不明显。玉米须的作用主要表现在利尿，肾功能改善，浮肿消退或减轻，尿蛋白消失或减低等方面。部分病例连续服用6个月未见毒性副作用。"}]},{"ID":"20240902103319-wvcp57g","Type":"NodeParagraph","Properties":{"id":"20240902103319-wvcp57g","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"②治疗肾病综合征"}]},{"ID":"20240902103319-yngomcg","Type":"NodeParagraph","Properties":{"id":"20240902103319-yngomcg","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"每次用干玉米须60克，洗净煎服。每日早晚两次。同时服氯化钾1克，每日3次。临床治疗12例，其中10例伴有严重的周身性水肿，或有胸水及腹水，2例水肿较轻；治疗3个月后，9例水肿完全消退，2例大部消退。最快1例于服药后15天水肿全消。一般于服药3天即开始有利尿现象，同时尿蛋白、非蛋白氮，均有不同程度的下降，少数病例血浆蛋白有所升高，部分病例的酚红试验及血压转为正常。"}]},{"ID":"20240902103319-6kjhpi9","Type":"NodeParagraph","Properties":{"id":"20240902103319-6kjhpi9","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"③治疗急性溶血性贫血并发血红蛋白尿"}]},{"ID":"20240902103319-w0bvnsj","Type":"NodeParagraph","Properties":{"id":"20240902103319-w0bvnsj","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"曾治疗2例食用野生植物\"招鸟棒\"中毒引起的本病，即以玉米须1～2两煎剂内服，2例分别于服用4小时及6小时后，尿量增加，肉眼已看不到酱油样的血尿；以后黄疸减退或消失。治疗过程中均曾同时静脉滴注5％葡萄糖盐水、维生素丙及输血。据观察，玉米须不但能利尿，可能具有抗溶血、抗过敏及解毒等作用。"}]},{"ID":"20240902103319-gmdbu74","Type":"NodeParagraph","Properties":{"id":"20240902103319-gmdbu74","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902103319-l9hu4cu","Type":"NodeParagraph","Properties":{"id":"20240902103319-l9hu4cu","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"玉米须《中华本草》"}]},{"ID":"20240902103319-67gc9es","Type":"NodeParagraph","Properties":{"id":"20240902103319-67gc9es","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【出处】出自《四川中药志》。"}]},{"ID":"20240902103319-7bzq2y2","Type":"NodeParagraph","Properties":{"id":"20240902103319-7bzq2y2","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【拼音名】YùMǐXū"}]},{"ID":"20240902103319-bec5iod","Type":"NodeParagraph","Properties":{"id":"20240902103319-bec5iod","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【英文名】CornStigma"}]},{"ID":"20240902103319-tg9qrev","Type":"NodeParagraph","Properties":{"id":"20240902103319-tg9qrev","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【别名】玉麦须、玉蜀黍蕊、棒子毛"}]},{"ID":"20240902103319-cslcgs6","Type":"NodeParagraph","Properties":{"id":"20240902103319-cslcgs6","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902103319-qy0in2t","Type":"NodeParagraph","Properties":{"id":"20240902103319-qy0in2t","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"药材基源：为禾本科植物玉蜀黍的花柱和柱头。"}]},{"ID":"20240902103319-9rp4d2x","Type":"NodeParagraph","Properties":{"id":"20240902103319-9rp4d2x","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：ZeamaysL."}]},{"ID":"20240902103319-djaygof","Type":"NodeParagraph","Properties":{"id":"20240902103319-djaygof","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"采收和储藏：于玉米成熟时采收，摘取花柱，晒干。"}]},{"ID":"20240902103319-u4twtrt","Type":"NodeParagraph","Properties":{"id":"20240902103319-u4twtrt","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【原形态】玉蜀黍，高大的一年生栽培植物。秆粗壮，直立，高1-4m，通常不分枝，基部节处常有气生根。叶片宽大，线状披针形，边缘呈波状皱折，具强壮之中脉。在秆顶着生雄性开展的圆锥花序；雄花序的分枝三棱状，每节有2雄小穗，1无柄，1有短柄；每1雄小穗含2小花，颖片膜质，先端尖；外稃及内稃均透明膜质；在叶腋内抽出圆柱状的雌花序，雌花序外包有多数鞘状苞片，雌小穗密集成纵行排列于粗壮的穗轴上，颖片宽阔，先端圆形或微凹，外稃膜质透明。花、果期7-9月。"}]},{"ID":"20240902103319-rqphq5j","Type":"NodeParagraph","Properties":{"id":"20240902103319-rqphq5j","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902103319-g4djqni","Type":"NodeParagraph","Properties":{"id":"20240902103319-g4djqni","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"生态环境：喜高温。"}]},{"ID":"20240902103319-kulnctl","Type":"NodeParagraph","Properties":{"id":"20240902103319-kulnctl","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地广泛栽培。"}]},{"ID":"20240902103319-2wohj66","Type":"NodeParagraph","Properties":{"id":"20240902103319-2wohj66","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【栽培】性喜高温，需水较多，适宜疏松肥沃的土壤，以农作物在全国各地有栽培。"}]},{"ID":"20240902103319-9it3tik","Type":"NodeParagraph","Properties":{"id":"20240902103319-9it3tik","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902103319-ticg488","Type":"NodeParagraph","Properties":{"id":"20240902103319-ticg488","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"性状鉴别，本品常集结成疏松团簇，花柱线状或须状，完整者长至30mm，直径约0.5mm，淡绿色、黄绿色至棕红色，有光泽，略透明，柱头2裂，叉开，长至3mm，质柔软。以柔软、有光泽者为佳。"}]},{"ID":"20240902103319-r3xgnqm","Type":"NodeParagraph","Properties":{"id":"20240902103319-r3xgnqm","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"显微鉴别，粉末特征：乳白色，气微味淡。①薄壁细胞长方形，长34-41μm，宽约14μm，壁略厚。②导管主为螺纹和环纹导管，直径为7-10μm，导管常伴有微黄色的薄壁纤维，直径7-10μm。"}]},{"ID":"20240902103319-wngtgkj","Type":"NodeParagraph","Properties":{"id":"20240902103319-wngtgkj","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【化学成份】本品含脂肪油2.5%、挥发油0.12%，树胶样物质3.8%、树脂2.7%、苦味糖甙1.15%、皂甙3.18%、生物碱0.05%。还含隐黄素(cryptoxanthin)、维生素C、泛酸(pantothenicacid)，肌醇(inositol)，维生素K、谷甾醇(sitosterol)、豆甾醇(stigmasterol)、苹果酸(malicacid))枸椽酸(citricacid)，酒石酸(tartaricacid)，草酸(oxalicacid)等。此外，还含大量硝酸钾(KNO3)，a-生育醌(a-tocopherylquinone)。"}]},{"ID":"20240902103319-zz7nqbf","Type":"NodeParagraph","Properties":{"id":"20240902103319-zz7nqbf","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902103319-gn9m2kl","Type":"NodeParagraph","Properties":{"id":"20240902103319-gn9m2kl","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"1.利尿作用：玉米须对人或家兔均有利尿作用，可增加氯化物排出量，但作用较弱。其水浸膏甲醇不溶部分经过透析者（甲）利尿作用最强，无论口服、皮下或静脉注射均有显着效果。利尿作用主要是肾外性的，对肾脏的作用很弱。"}]},{"ID":"20240902103319-pubroi2","Type":"NodeParagraph","Properties":{"id":"20240902103319-pubroi2","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"2.对循环系统的作用：麻醉犬静脉注射煎剂有显着降压作用，但对慢性颈动脉皮桥狗，每日服药，连续3周，并无降压作用。甲在低浓度时对末梢血管有扩张作用。"}]},{"ID":"20240902103319-s1qc0wt","Type":"NodeParagraph","Properties":{"id":"20240902103319-s1qc0wt","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"3.降低血糖作用：玉米须的发酵制剂对家兔有非常显着的降低血糖作用。"}]},{"ID":"20240902103319-6mi5xbk","Type":"NodeParagraph","Properties":{"id":"20240902103319-6mi5xbk","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"4.利胆、止血作用：玉米须制剂能促进胆汁排泄，降低其粘度，减少其胆色素含量，因而可作为利胆药用于无并发症的慢性胆囊炎、胆汁排出障碍的胆管炎患者。它还能加速血液凝固过程，增加血中凝血酶元含量，提高血小板数，故可作为止血药兼利尿药应用于膀胱及尿路结石。"}]},{"ID":"20240902103319-q6cwbf0","Type":"NodeParagraph","Properties":{"id":"20240902103319-q6cwbf0","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【毒性】毒性甲的毒性很小，对兔的致死量约为250mg／kg（静脉注射），利尿有效剂量约为1.5mg/kg，故安全范围较大，在此剂量时对心脏、血压、呼吸、末梢血管、肠肌等几无作用。"}]},{"ID":"20240902103319-60astya","Type":"NodeParagraph","Properties":{"id":"20240902103319-60astya","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902103319-iqoyzbw","Type":"NodeParagraph","Properties":{"id":"20240902103319-iqoyzbw","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"理化鉴别，取本品2g，加乙醇50ml，水浴上加热提min，滤过，滤液供如下试验：（1）取滤液1ml，蒸干，残渣ml醋酐中加入硫酸1滴，醋酐层呈绿色。(检查皂甙、甾体或三萜)（2）将试液滴于硅胶G-CMC薄层板上，滴加4%磷钼酸乙醇液，加热至110℃，显蓝色。"}]},{"ID":"20240902103319-gzj1mw1","Type":"NodeParagraph","Properties":{"id":"20240902103319-gzj1mw1","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"（3）将试液滴于硅胶G-CMC薄层板上，滴加1%香草醛硫酸液，显红色。（检查挥发油、甾体）"}]},{"ID":"20240902103319-9j8pbjb","Type":"NodeParagraph","Properties":{"id":"20240902103319-9j8pbjb","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【炮制】将原药除去杂质、衣壳（总苞片）及灰屑，晒干或烘干即得。"}]},{"ID":"20240902103319-4jkh6p5","Type":"NodeParagraph","Properties":{"id":"20240902103319-4jkh6p5","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【性味】味甘；淡；性平"}]},{"ID":"20240902103319-cj98zfc","Type":"NodeParagraph","Properties":{"id":"20240902103319-cj98zfc","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【归经】肾；胃；肝；胆经"}]},{"ID":"20240902103319-hpcw4f9","Type":"NodeParagraph","Properties":{"id":"20240902103319-hpcw4f9","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【功能主治】利尿消肿；清肝利胆。主水肿；小便淋沥；黄疸；胆囊炎；胆结石；高血压；糖尿病；乳汁不通"}]},{"ID":"20240902103319-6nnalg6","Type":"NodeParagraph","Properties":{"id":"20240902103319-6nnalg6","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-30g；大剂量60-90g；或烧存性研末。外用：适量，烧烟吸入。"}]},{"ID":"20240902103319-ngk9y3r","Type":"NodeParagraph","Properties":{"id":"20240902103319-ngk9y3r","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【注意】煮食去苞须；不作药用时勿服。"}]},{"ID":"20240902103319-c4qhr2j","Type":"NodeParagraph","Properties":{"id":"20240902103319-c4qhr2j","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【附方】治黄疸方《四川省药志》：治湿热黄疸；治劳伤吐血方《四川中药志》：虚劳吐血。"}]},{"ID":"20240902103319-trhftd6","Type":"NodeParagraph","Properties":{"id":"20240902103319-trhftd6","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【各家论述】"}]},{"ID":"20240902103319-dryidah","Type":"NodeParagraph","Properties":{"id":"20240902103319-dryidah","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"1.《滇南本草》：宽肠下气。治妇人乳结，乳汁不通，红肿疼痛，怕冷发热，头痛体困。"}]},{"ID":"20240902103319-tw60o1o","Type":"NodeParagraph","Properties":{"id":"20240902103319-tw60o1o","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"2.《岭南采药录》：和猪肉煎汤治糖尿病。又治小便淋沥砂石，苦痛不可忍，煎汤频服。"}]},{"ID":"20240902103319-5n8co8u","Type":"NodeParagraph","Properties":{"id":"20240902103319-5n8co8u","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"3.《现代实用中药》：为利尿药，对肾脏病、浮肿性疾患、糖尿病等有效。又为胆囊炎、胆石、肝炎性黄疸等的有效药。"}]},{"ID":"20240902103319-2eplbrr","Type":"NodeParagraph","Properties":{"id":"20240902103319-2eplbrr","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"4.《民间常用草药汇编》：能降低血压，利尿消肿。治鼻血、红崩。"}]},{"ID":"20240902103319-o172hez","Type":"NodeParagraph","Properties":{"id":"20240902103319-o172hez","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"5.《河北药材》：治水肿性脚气。"}]},{"ID":"20240902103319-ccq9bg0","Type":"NodeParagraph","Properties":{"id":"20240902103319-ccq9bg0","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"6.《浙江民间草药》：开胃，平肝，祛风。"}]},{"ID":"20240902103319-t9qnng8","Type":"NodeParagraph","Properties":{"id":"20240902103319-t9qnng8","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"7.《四川中药志》：清血热，利小便。治黄疸，风热，出疹，吐血及红崩。"}]},{"ID":"20240902103319-30q8l00","Type":"NodeParagraph","Properties":{"id":"20240902103319-30q8l00","updated":"20240902103345"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902103320-tr2lw16","Type":"NodeThematicBreak","Properties":{"id":"20240902103320-tr2lw16","updated":"20240902103345"}},{"ID":"20240902103321-apu8yyx","Type":"NodeParagraph","Properties":{"id":"20240902103321-apu8yyx","updated":"20240902103345"}}]}