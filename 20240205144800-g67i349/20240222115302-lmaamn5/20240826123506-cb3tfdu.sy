ype":"NodeLinkDest","Data":"assets/葫芦茶 6-20240829154839-p4lj2hp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829154946-s3b2g1j","Type":"NodeParagraph","Properties":{"id":"20240829154946-s3b2g1j","updated":"20240829155023"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 9-20240829154946-ax5yscm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 649px;","style":"width: 639px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 10-20240829155023-d2yiow8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 639px;\" parent-style=\"width: 649px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829155129-cmp1y7s","Type":"NodeParagraph","Properties":{"id":"20240829155129-cmp1y7s","updated":"20240829155132"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 601px;","style":"width: 591px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 1-20240829154242-cl6tg6u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 591px;\" parent-style=\"width: 601px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 11-20240829155129-hqytieo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829155234-f2lvcp6","Type":"NodeParagraph","Properties":{"id":"20240829155234-f2lvcp6","updated":"20240829155315"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 578px;","style":"width: 568px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 13-20240829155315-q6qagvu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 568px;\" parent-style=\"width: 578px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 643px;","style":"width: 633px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 12-20240829155234-6iyu09n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829154303-9baiopu","Type":"NodeParagraph","Properties":{"id":"20240829154303-9baiopu","updated":"20240829155434"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 642px;","style":"width: 632px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 3-20240829154340-jz8fmj8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 632px;\" parent-style=\"width: 642px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 14-20240829155434-7d692lm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829155555-vvv6hm6","Type":"NodeParagraph","Properties":{"id":"20240829155555-vvv6hm6","updated":"20240829155555"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葫芦茶 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葫芦茶 15-20240829155555-x9lw5un.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240829154121-aavc2gv","Type":"NodeThematicBreak","Properties":{"id":"20240829154121-aavc2gv"}},{"ID":"20240902172746-6zvdj87","Type":"NodeParagraph","Properties":{"id":"20240902172746-6zvdj87","updated":"20240902172753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：葫芦茶"}]},{"ID":"20240902172746-serwzp4","Type":"NodeParagraph","Properties":{"id":"20240902172746-serwzp4","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"葫芦茶《全国中草药汇编》"}]},{"ID":"20240902172746-efe745i","Type":"NodeParagraph","Properties":{"id":"20240902172746-efe745i","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【拼音名】HúLuChá"}]},{"ID":"20240902172746-ga5fwyh","Type":"NodeParagraph","Properties":{"id":"20240902172746-ga5fwyh","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【别名】剃刀柄、虫草、金剑草、咸鱼草、百劳舌、鲮鲤舌"}]},{"ID":"20240902172746-9a0rtj8","Type":"NodeParagraph","Properties":{"id":"20240902172746-9a0rtj8","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【来源】豆科山蚂蝗属植物葫芦茶Desmodiumtriquetrum（L.）DC.，以全株入药。夏秋采收，洗净切细，晒干。鲜用随时可采。"}]},{"ID":"20240902172746-xlhovay","Type":"NodeParagraph","Properties":{"id":"20240902172746-xlhovay","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【性味】微苦、涩，凉。"}]},{"ID":"20240902172746-m0yf5gd","Type":"NodeParagraph","Properties":{"id":"20240902172746-m0yf5gd","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒，消积利湿，杀虫防腐。用于预防中暑，感冒发热，咽喉肿痛，肾炎，黄疸型肝炎，肠炎，细菌性痢疾，小儿疳积，妊娠呕吐，菠萝中毒，小儿硬皮病。"}]},{"ID":"20240902172746-ikimmwe","Type":"NodeParagraph","Properties":{"id":"20240902172746-ikimmwe","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【用法用量】0.5～2两；外用适量。"}]},{"ID":"20240902172746-zwt48zu","Type":"NodeParagraph","Properties":{"id":"20240902172746-zwt48zu","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【备注】（1）民间腌制咸鱼、肉类，放入本品，可防蝇蛆。"}]},{"ID":"20240902172746-uww457i","Type":"NodeParagraph","Properties":{"id":"20240902172746-uww457i","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902172746-tgs4j0h","Type":"NodeParagraph","Properties":{"id":"20240902172746-tgs4j0h","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"葫芦茶《*辞典》"}]},{"ID":"20240902172746-aem7aor","Type":"NodeParagraph","Properties":{"id":"20240902172746-aem7aor","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【出处】《生草药性备要》"}]},{"ID":"20240902172746-km88ffx","Type":"NodeParagraph","Properties":{"id":"20240902172746-km88ffx","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【拼音名】HúLuChá"}]},{"ID":"20240902172746-ri4nwcb","Type":"NodeParagraph","Properties":{"id":"20240902172746-ri4nwcb","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【别名】牛虫草、迫颈草、百劳舌（《广西中兽医药植》），金剑草、螳螂草（《泉州本草》），田刀柄、钊板茶、咸鱼草（《岭南草药志》），麻草、鲮鲤舌（《闽东本草》），土豆、地马庄（《贵州草药》），龙舌癀（《福建中草药》）。"}]},{"ID":"20240902172746-1mhkitd","Type":"NodeParagraph","Properties":{"id":"20240902172746-1mhkitd","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【来源】为豆科植物葫芦茶的全草。夏、秋季割取地上部分，除去粗枝，晒干。"}]},{"ID":"20240902172746-1b7xmd5","Type":"NodeParagraph","Properties":{"id":"20240902172746-1b7xmd5","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【原形态】半灌木，高1米左右，直立、分枝。枝四棱，棱上被粗毛，后变秃净。单叶，互生，卵状矩圆形、矩圆形至披针形，长6～12厘米，先端短尖，基部浑圆，上面秃净，下面主脉上被毛；叶柄长1～3厘米，有阔翅，翅宽4～8毫米，与叶同质；有小托叶2枚，披针形，长可达15毫米，有线条，脱落。总状花序顶生或腋生，长15～30厘米；苞片小，锥尖状；花多数，淡紫色，长约5毫米；萼阔钟形，长约3毫米，下面裂齿线形；花冠蝶形，旗瓣圆形，先端微凹，翼瓣贴生于龙骨瓣；雄蕊10，2体；雌蕊1，花柱内弯。荚果长约2～5厘米，有荚节5～8个，秃净或被毛，荚节近四方形。花期7月。果期8～10月。"}]},{"ID":"20240902172746-3r1956a","Type":"NodeParagraph","Properties":{"id":"20240902172746-3r1956a","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于荒坡、低丘陵地草丛中。分布广东、广西、福建、云南、贵州等地。产于广东、广西等地。"}]},{"ID":"20240902172746-j6pzquz","Type":"NodeParagraph","Properties":{"id":"20240902172746-j6pzquz","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【性状】干燥全草，茎多已折断，长约30厘米，粗约0.5厘米。老茎红褐色，细茎红棕色，三角状，棱上被粗毛。叶片红棕色，革质，叶柄具翅，与叶片相连。气香，味微甘。以叶多、干燥、色青带红、无粗梗者为佳。"}]},{"ID":"20240902172746-c639e50","Type":"NodeParagraph","Properties":{"id":"20240902172746-c639e50","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【化学成份】叶中含鞣质7.1～8.6％，二氧化硅0.5～2.32％，氧化钾1.3～3.0％。"}]},{"ID":"20240902172746-vr84abt","Type":"NodeParagraph","Properties":{"id":"20240902172746-vr84abt","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902172746-ohdmw0e","Type":"NodeParagraph","Properties":{"id":"20240902172746-ohdmw0e","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"苦涩，凉。"}]},{"ID":"20240902172746-wzsbjjk","Type":"NodeParagraph","Properties":{"id":"20240902172746-wzsbjjk","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"①《生草药性备要》：\"味涩，性平。\""}]},{"ID":"20240902172746-609pbpa","Type":"NodeParagraph","Properties":{"id":"20240902172746-609pbpa","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"②《南宁市药物志》：\"涩微甘。\""}]},{"ID":"20240902172746-aov5suc","Type":"NodeParagraph","Properties":{"id":"20240902172746-aov5suc","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"③广州部队《常用中草药手册》：\"甘苦，微凉。\""}]},{"ID":"20240902172746-z1ne3cp","Type":"NodeParagraph","Properties":{"id":"20240902172746-z1ne3cp","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902172746-e35b1f7","Type":"NodeParagraph","Properties":{"id":"20240902172746-e35b1f7","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"清热，利湿，消滞，杀虫。治感冒，咽痛，肺病咳血，肠炎，痢疾，黄疸，风湿关节痛，钩虫病，妊娠呕吐，小儿疳积，疮疥。"}]},{"ID":"20240902172746-49pkuyp","Type":"NodeParagraph","Properties":{"id":"20240902172746-49pkuyp","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"①《生草药性备要》：\"消食杀虫，治小儿五疳，作茶饮。\""}]},{"ID":"20240902172746-r98bfhe","Type":"NodeParagraph","Properties":{"id":"20240902172746-r98bfhe","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"②《本草求原》：\"退黄疸。\""}]},{"ID":"20240902172746-srqr49j","Type":"NodeParagraph","Properties":{"id":"20240902172746-srqr49j","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"③《岭南采药录》：\"疮久有虫，敷之。解热毒，去疳积。\"\"治劳伤吐血。\""}]},{"ID":"20240902172746-7rchv0x","Type":"NodeParagraph","Properties":{"id":"20240902172746-7rchv0x","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"④《南宁市药物志》：\"杀虫，清热，止渴。治疝气，疳积。煎水洗疮疥，止痕痒。\""}]},{"ID":"20240902172746-qbdb594","Type":"NodeParagraph","Properties":{"id":"20240902172746-qbdb594","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑤《岭南草药志》：\"消暑，清热，利尿。\""}]},{"ID":"20240902172746-kz240lh","Type":"NodeParagraph","Properties":{"id":"20240902172746-kz240lh","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑥《闽东本草》：\"解肌达表，健脾开胃，润肺生津，强筋骨，除风湿。\""}]},{"ID":"20240902172746-r567pg0","Type":"NodeParagraph","Properties":{"id":"20240902172746-r567pg0","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑦广州部队《常用中草药手册》：\"清热解暑，利水消滞，杀虫防腐。制茶用于感冒发烧、咽喉肿痛，预防中暑；煎水治肾炎水肿，黄疸型肝炎，肠炎腹泻。\""}]},{"ID":"20240902172746-be3rfse","Type":"NodeParagraph","Properties":{"id":"20240902172746-be3rfse","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，0.5～1.5两。外用：捣汁涂或煎水洗。"}]},{"ID":"20240902172746-8jv9c5u","Type":"NodeParagraph","Properties":{"id":"20240902172746-8jv9c5u","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902172746-lig71dr","Type":"NodeParagraph","Properties":{"id":"20240902172746-lig71dr","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"①治咽喉肿痛：葫芦茶二两。煎水含咽。（《岭南草药志》）"}]},{"ID":"20240902172746-gti3513","Type":"NodeParagraph","Properties":{"id":"20240902172746-gti3513","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"②治肺病咳嗽出血：葫芦茶干全草二两半。清水煎服。（《泉州本草》）"}]},{"ID":"20240902172746-r4hbnlr","Type":"NodeParagraph","Properties":{"id":"20240902172746-r4hbnlr","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"③治痢疾：葫芦茶全草、细叶扯头孟根各二至三两。加鸡蛋一个同煎，煎至鸡蛋熟时，将蛋壳除去再煎，加生盐调味，汤蛋同服。（《岭南草药志》）"}]},{"ID":"20240902172746-qcyghkb","Type":"NodeParagraph","Properties":{"id":"20240902172746-qcyghkb","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"④治风湿性关节酸痛：葫芦茶茎，每次二两，合猪脚节炖服。（《泉州本草》）"}]},{"ID":"20240902172746-frt8ae0","Type":"NodeParagraph","Properties":{"id":"20240902172746-frt8ae0","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑤治硬皮症：葫芦茶、拔脓膏（荨麻科糯米藤）各等分，和食盐捣烂敷患处。（《广东省医药卫生科技资料选编》）"}]},{"ID":"20240902172746-zo6a3cc","Type":"NodeParagraph","Properties":{"id":"20240902172746-zo6a3cc","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑥治妊娠呕吐：葫芦茶一两（干品）。水煎，分三次服。（《全展选编·妇产科》）"}]},{"ID":"20240902172746-tdrgs4r","Type":"NodeParagraph","Properties":{"id":"20240902172746-tdrgs4r","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑦治产后瘀血痛：鲜葫芦茶全草五钱至一两。杵烂，酌加米酒炖服。如用清水煎服，可治月经病。（《闽东本草》）"}]},{"ID":"20240902172746-gfqrn45","Type":"NodeParagraph","Properties":{"id":"20240902172746-gfqrn45","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑧治暑季烦渴：葫芦茶，煎成日常饮料，以代茶叶。能解暑清热止渴。（《岭南草药志》）"}]},{"ID":"20240902172746-pm3h7km","Type":"NodeParagraph","Properties":{"id":"20240902172746-pm3h7km","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑨治痈毒：葫芦茶叶捣绒，取汁滴于伤口，每日二至三次，每次适量。（《贵州草药》）"}]},{"ID":"20240902172746-gse7fmr","Type":"NodeParagraph","Properties":{"id":"20240902172746-gse7fmr","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"⑩治荨麻疹：葫芦茶鲜茎、叶一两。水煎服；或用鲜全草适量，水煎熏洗。（《福建中草药》）"}]},{"ID":"20240902172746-q5vxusg","Type":"NodeParagraph","Properties":{"id":"20240902172746-q5vxusg","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【临床应用】治疗钩虫病:取葫芦茶全草半斤（干品），加水800毫升，文火煎至250毫升。分两次于早晚空腹时服。治疗276例，治愈（服药1剂，10天后大便镜检虫卵阴转）183例，无效93例。副作用少，仅个别病例有恶心、呕吐现象。"}]},{"ID":"20240902172746-hzn3ct6","Type":"NodeParagraph","Properties":{"id":"20240902172746-hzn3ct6","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902172746-541deh9","Type":"NodeParagraph","Properties":{"id":"20240902172746-541deh9","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"葫芦茶《中华本草》"}]},{"ID":"20240902172746-nnupxt7","Type":"NodeParagraph","Properties":{"id":"20240902172746-nnupxt7","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【出处】出自《生草药性备要》"}]},{"ID":"20240902172746-7gqd1i9","Type":"NodeParagraph","Properties":{"id":"20240902172746-7gqd1i9","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【拼音名】HúLuChá"}]},{"ID":"20240902172746-3ytug5g","Type":"NodeParagraph","Properties":{"id":"20240902172746-3ytug5g","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【英文名】HerbofTriquetrousTadehagi,TriqretrousTadehagiHerb"}]},{"ID":"20240902172746-44yj3tj","Type":"NodeParagraph","Properties":{"id":"20240902172746-44yj3tj","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【别名】牛虫草、迫颈草、百劳舌、金剑草、螳螂草、田刀柄、钊板茶、咸鱼草、麻草、鲮鲤舌、土豆、地马庄、龙舌癀、鳖颈草、金腰带、三脚虎、龙舌广、葫芦叶。"}]},{"ID":"20240902172746-8lchnsj","Type":"NodeParagraph","Properties":{"id":"20240902172746-8lchnsj","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902172746-2cl3svv","Type":"NodeParagraph","Properties":{"id":"20240902172746-2cl3svv","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"药材基源：为豆科植物葫芦茶、蔓茎葫芦茶的枝叶。"}]},{"ID":"20240902172746-fa5i2id","Type":"NodeParagraph","Properties":{"id":"20240902172746-fa5i2id","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Tadehagitriquetum（L.）Ohashi[Desmodiumtriquetrum（L.）DC.；Pterolomatriquetrum（L.）Benth.]2.Tadehagitriquetrum（L.）Ohashisubsp.pseudotriquetrum（DC.）Ohashi[DesmodiumpseudotriquetrumDC.]"}]},{"ID":"20240902172746-lb6dv38","Type":"NodeParagraph","Properties":{"id":"20240902172746-lb6dv38","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季割取地上部分，除去粗枝，切段晒干。"}]},{"ID":"20240902172746-qgsgmpf","Type":"NodeParagraph","Properties":{"id":"20240902172746-qgsgmpf","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240902172746-6bq4ubm","Type":"NodeParagraph","Properties":{"id":"20240902172746-6bq4ubm","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"1.葫芦茶落叶小灌木，高1-2m。直立，分枝。枝三棱形，棱上被粗毛，后变秃净。单叶互生，叶片卵状披针形至狭披针形，长6-15cm，宽1-4cm，先端急尖，基部浅心形或圆形，上面无毛，背面中脉和侧脉被长毛；叶柄具宽翅，形似葫芦；托叶2枚，披针形，有纵脉。总状花序腋生或顶生，长15-30cm；苞片小，锥尖状；花萼钟状，长约3mm，下面裂齿线状，有疏长毛；花冠紫红色，蝶形，旗瓣圆形，先端微凹，翼瓣倒卵形，基部有耳，龙骨瓣镰刀壮弯曲，爪与瓣片近等长；雄蕊10（9＋l），二体，下部合生；子房密生短柔毛，花柱内弯。荚果条状长圆形，长2-5cm，有荚节5-8，秃净或被毛，背缝线直，腹缝线呈波状。花期7-9月，果期8-10月。"}]},{"ID":"20240902172746-hte00x9","Type":"NodeParagraph","Properties":{"id":"20240902172746-hte00x9","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"2．蔓茎葫芦茶半灌木。全株伏地，多分枝。茎长达1m，三棱形，棱上疏被短硬毛。单叶互生，叶片卵状披针形至卵形，长3-10cm，宽l-5cm，先端急尖，基部心形；叶柄长0.7-3.2cm，具翅；托叶披针形，有纵脉。总状花序顶生或腋生；萼筒短，5齿，稍长于萼筒，上面2齿合生，下面3齿呈披针形；花冠蝶形，紫色，长约7mm；雄蕊10，二体，下部合生。荚果条状长圆形，长20-28mm，宽约5mm，8-9节，无毛，具明显网状脉，腹背缝被缘毛。花、果期8月。"}]},{"ID":"20240902172746-bo7xp8c","Type":"NodeParagraph","Properties":{"id":"20240902172746-bo7xp8c","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902172746-1ct0hou","Type":"NodeParagraph","Properties":{"id":"20240902172746-1ct0hou","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"生态环境：1.生于海拔500-700m的荒地、低丘陵地草丛中。"}]},{"ID":"20240902172746-uk7uul9","Type":"NodeParagraph","Properties":{"id":"20240902172746-uk7uul9","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"2.生于向阳山坡疏林下、路边及丘陵地带。"}]},{"ID":"20240902172746-9iluo5r","Type":"NodeParagraph","Properties":{"id":"20240902172746-9iluo5r","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于福建、台湾、广东、海南、广西、贵州、云南。"}]},{"ID":"20240902172746-2jnbak3","Type":"NodeParagraph","Properties":{"id":"20240902172746-2jnbak3","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"2.分布于浙江、台湾、广西、四川、云南。"}]},{"ID":"20240902172746-i6jhphv","Type":"NodeParagraph","Properties":{"id":"20240902172746-i6jhphv","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902172746-42174dd","Type":"NodeParagraph","Properties":{"id":"20240902172746-42174dd","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"性状鉴别（l）葫芦茶茎枝多折断，基部木质，圆柱形，直径约5mm，表面红棕色至红褐色；上部草质，具三楼，棱上疏被租毛。叶多皱缩卷曲，展平后呈卵状矩圆形至披针形，长6-15cm，宽1-3.5cm；表面红棕色，下面主脉上有毛，革质；叶柄长0.8-3.5cm，具阔翅；托叶有时可见，披针形，淡棕色。有时可见总状花序或扁平荚果，长2-5cm，有4-8个近方形荚节，被毛。气香，味微甘。"}]},{"ID":"20240902172746-ln8ob6l","Type":"NodeParagraph","Properties":{"id":"20240902172746-ln8ob6l","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"（2）蔓茎葫芦茶叶卵状披针形或椭圆状披针形；荚果仅背、腹缝密生缘毛。均以叶多、干燥、色青带红、无粗梗者为佳。"}]},{"ID":"20240902172746-rqycm17","Type":"NodeParagraph","Properties":{"id":"20240902172746-rqycm17","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"显微鉴别葫芦茶茎横切面：呈三角形。表皮细胞1列。皮层为4-5列类图形薄壁细胞，棱角处有3-4列厚角细胞。中柱鞘纤维断续成环。韧皮部狭窄，韧皮纤维单个散在或成束。形成层成环。木质部占较大部位；木射线宽1-3列细胞；导管单个散在或数个径向排列。髓部三角形。本品薄壁细胞中含草酸钙方晶。"}]},{"ID":"20240902172746-ikvqlrq","Type":"NodeParagraph","Properties":{"id":"20240902172746-ikvqlrq","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"叶横切面：上表面中央有尖突的棱脊，叶背中脉向外凸起。中脉维管束5个，下方3个较大，排成弯月形或连成槽状，韧皮部在木质部下方，上方2个较小，韧皮部位于本质部之上。中柱鞘纤维成环。薄壁细胞含草酸钙方晶。"}]},{"ID":"20240902172746-uf0mpto","Type":"NodeParagraph","Properties":{"id":"20240902172746-uf0mpto","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"叶表面观：上表皮细胞垂周壁平直或波状弯曲，气孔及毛茸均较少。下表皮细胞垂周轴式。腺毛易见，腺头3细胞，直径15-20μm，腺柄2细胞。非腺毛百2种，一种为单细胞，长达14μm，基部直径30-50μm，壁厚，表面有疣状突起；加一种2-3细胞，长60-85μm，直径为8μm，壁薄，顶端常弯曲呈钩状。"}]},{"ID":"20240902172746-mfziwud","Type":"NodeParagraph","Properties":{"id":"20240902172746-mfziwud","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【化学成份】叶含鞣质（tannin），二氧化硅、氧化钾。"}]},{"ID":"20240902172746-fwqnp7j","Type":"NodeParagraph","Properties":{"id":"20240902172746-fwqnp7j","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【药理作用】煎剂用平板纸片法，对金黄色葡萄球菌有抑制作用。"}]},{"ID":"20240902172746-00isp43","Type":"NodeParagraph","Properties":{"id":"20240902172746-00isp43","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【鉴别】理化鉴别取本品碎叶10g，用70%乙醇回流提取2次，滤过。滤液加盐酸3滴和锌粉少许，溶液呈粉红色。（检查黄酮类）"}]},{"ID":"20240902172746-xarqlg5","Type":"NodeParagraph","Properties":{"id":"20240902172746-xarqlg5","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【性味】味苦；涩；性凉"}]},{"ID":"20240902172746-j99zlj5","Type":"NodeParagraph","Properties":{"id":"20240902172746-j99zlj5","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【归经】肺；肝；膀胱经"}]},{"ID":"20240902172746-qad8r7p","Type":"NodeParagraph","Properties":{"id":"20240902172746-qad8r7p","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【功能主治】清热解毒；利湿退黄；消积杀虫。主中暑烦渴；感冒发热；咽喉肿痛；肺痛咳血；肾炎；黄疸；泄泻；痢疾；风湿关节痛；小儿疳积；钩虫病；疥疮"}]},{"ID":"20240902172746-k6qy3p6","Type":"NodeParagraph","Properties":{"id":"20240902172746-k6qy3p6","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，15-60g。外用：适量，捣汁涂；或煎水洗。"}]},{"ID":"20240902172746-anv4wes","Type":"NodeParagraph","Properties":{"id":"20240902172746-anv4wes","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.治咽喉肿痛：葫芦茶二两。煎水含咽。(《岭南草药志》)2.治肺病咳嗽出血：葫芦茶干全草二两半。清水煎服。(《泉州本草》)3.治痢疾：葫芦茶全草、细叶扯头孟根各二至三两。加鸡蛋一个同煎，煎至鸡蛋熟时，将蛋壳除去再煎，加生盐调味，汤蛋同服。(《岭南草药志》)4.治风湿性关节酸痛：葫芦茶茎，每次二两，合猪脚节炖服。(《泉州本草》)5.治硬皮症：葫芦茶、拔脓膏(荨麻科糯米藤)各等分，和食盐捣烂敷患处。(《广东省医药卫生科技资料选编》)6.治妊娠呕吐：葫芦茶一两(干品)。水煎，分三次服。(《全展选编·妇产科》)7.治产后瘀血痛：鲜葫芦茶全草五钱至一两。杵烂，酌加米酒炖服。如用清水煎服，可治月经病。(《闽东本草》)8.治暑季烦渴：葫芦茶，煎成日常饮料，以代茶叶。能解暑清热止渴。(《岭南草药志》)9.治痈毒：葫芦茶叶捣绒，取汁滴于伤口，每日二至三次，每次适量。(《贵州草药》)10.治荨麻疹：葫芦茶鲜茎、叶一两。水煎服；或用鲜全草适量，水煎熏洗。(《福建中草药》)治疗钩虫病。取葫芦茶全草半斤(干品)，加水800ml，文火煎至25ml。分两次于早晚空腹时服。治疗276例，治愈(服药1剂，10天后大便镜检虫卵阴转)183例，无效93例。副作用少，仅个别病有恶心、呕吐现象。"}]},{"ID":"20240902172746-tx3f4dv","Type":"NodeParagraph","Properties":{"id":"20240902172746-tx3f4dv","updated":"20240902172756"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902172747-1jt3com","Type":"NodeThematicBreak","Properties":{"id":"20240902172747-1jt3com","updated":"20240902172756"}},{"ID":"20240902172748-mdgbnhw","Type":"NodeParagraph","Properties":{"id":"20240902172748-mdgbnhw","updated":"20240902172756"}}]}