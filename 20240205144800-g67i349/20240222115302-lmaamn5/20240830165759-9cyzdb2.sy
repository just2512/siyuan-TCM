hildren":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 395px;","style":"width: 385px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山楂 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山楂 1-20240712145834-nfd4zug.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 385px;\" parent-style=\"width: 395px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 788px;","style":"width: 778px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山楂 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山楂 6-20240712150102-th44o65.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 778px;\" parent-style=\"width: 788px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830165828-yq8iwcb","Type":"NodeParagraph","Properties":{"id":"20240830165828-yq8iwcb","updated":"20240830165828"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 401px;","style":"width: 391px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山楂 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山楂 15-20240712150942-5ibsckm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 391px;\" parent-style=\"width: 401px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 792px;","style":"width: 782px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山楂 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山楂 5-20240712150007-mc9t66a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 782px;\" parent-style=\"width: 792px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830165832-6j3hdn2","Type":"NodeThematicBreak","Properties":{"id":"20240830165832-6j3hdn2"}},{"ID":"20240830165931-g9lhheq","Type":"NodeParagraph","Properties":{"id":"20240830165931-g9lhheq","updated":"20240830165948"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：山楂叶"}]},{"ID":"20240830165931-xsvwf0w","Type":"NodeParagraph","Properties":{"id":"20240830165931-xsvwf0w","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"山楂叶《*辞典》"}]},{"ID":"20240830165931-052nv46","Type":"NodeParagraph","Properties":{"id":"20240830165931-052nv46","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【出处】《纲目》"}]},{"ID":"20240830165931-fb0khab","Type":"NodeParagraph","Properties":{"id":"20240830165931-fb0khab","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānZhāYè"}]},{"ID":"20240830165931-rkckvth","Type":"NodeParagraph","Properties":{"id":"20240830165931-rkckvth","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【来源】为蔷薇科植物山楂或野山楂等的叶。"}]},{"ID":"20240830165931-ssd54r9","Type":"NodeParagraph","Properties":{"id":"20240830165931-ssd54r9","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240830165931-ld23j6l","Type":"NodeParagraph","Properties":{"id":"20240830165931-ld23j6l","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"叶和花泡茶服可治高血压。"}]},{"ID":"20240830165931-0ms3ejr","Type":"NodeParagraph","Properties":{"id":"20240830165931-0ms3ejr","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"《肘后方》：\"茎叶煮汁，洗漆疮。\""}]},{"ID":"20240830165931-onpjg35","Type":"NodeParagraph","Properties":{"id":"20240830165931-onpjg35","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240830165931-8oqz6wd","Type":"NodeParagraph","Properties":{"id":"20240830165931-8oqz6wd","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"山楂叶《中华本草》"}]},{"ID":"20240830165931-su9u0ru","Type":"NodeParagraph","Properties":{"id":"20240830165931-su9u0ru","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【出处】出自《本草纲目》"}]},{"ID":"20240830165931-8m94veh","Type":"NodeParagraph","Properties":{"id":"20240830165931-8m94veh","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【拼音名】ShānZhāYè"}]},{"ID":"20240830165931-rqngx77","Type":"NodeParagraph","Properties":{"id":"20240830165931-rqngx77","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【英文名】HowthornLeaf"}]},{"ID":"20240830165931-54v7m8a","Type":"NodeParagraph","Properties":{"id":"20240830165931-54v7m8a","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240830165931-ctjm3tm","Type":"NodeParagraph","Properties":{"id":"20240830165931-ctjm3tm","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"药材基源：为蔷薇科植物山里红或野山楂等的叶。"}]},{"ID":"20240830165931-yl7928s","Type":"NodeParagraph","Properties":{"id":"20240830165931-yl7928s","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.CrataeguspinnatifidaBungevar.majorN.E.Br.2.CrataeguspinnatifidaBunge"}]},{"ID":"20240830165931-prnax89","Type":"NodeParagraph","Properties":{"id":"20240830165931-prnax89","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏秋季采收。"}]},{"ID":"20240830165931-u24oe93","Type":"NodeParagraph","Properties":{"id":"20240830165931-u24oe93","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【原形态】"}]},{"ID":"20240830165931-en733w5","Type":"NodeParagraph","Properties":{"id":"20240830165931-en733w5","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"1.山里红落叶乔木，高达6m。枝刺长1-2cm，或无刺。单叶互生；叶柄长2-6cm；叶片阔卵形或三角卵形稀菱状卵形，长6-12cm，宽5-8cm，有2-4对羽状裂片，先端渐尖，基部宽楔形，上面有光泽，下面沿叶脉被短柔毛，边缘有不规则重锯齿。伞房花序，直径约4-6cm；萼筒钟状，5齿裂；花冠白色，直径约1.5cm，花瓣5，倒卵形或近圆形；雄蕊约20，花药粉红色；雌蕊1，子房下位，5室，花柱5。梨果近球形，直径可达2.5cm，深红色，有黄白色小斑点，萼片脱落很迟，先端留下一圆形深洼；小核3-5，向外的一面稍具棱，向内面侧面平滑。花期5-6月。果期8-10月。"}]},{"ID":"20240830165931-1r80e5e","Type":"NodeParagraph","Properties":{"id":"20240830165931-1r80e5e","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"2.山楂本种与山里红极为相似，仅果形较小，直径1.5cm；叶片亦较小，且分裂较深。"}]},{"ID":"20240830165931-xi9trvj","Type":"NodeParagraph","Properties":{"id":"20240830165931-xi9trvj","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240830165931-083sbsm","Type":"NodeParagraph","Properties":{"id":"20240830165931-083sbsm","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"生态环境：山楂生于海拔100-1500m的溪边、山谷、林缘或灌木丛中。"}]},{"ID":"20240830165931-nhcx0ci","Type":"NodeParagraph","Properties":{"id":"20240830165931-nhcx0ci","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"资源分布：1.山里红分布于华北及山东、江苏、安徽、河南等地。"}]},{"ID":"20240830165931-kut4uvf","Type":"NodeParagraph","Properties":{"id":"20240830165931-kut4uvf","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"2.分布于东北及内蒙古、河北、山西、陕西、山东、江苏、浙江、江南等地。"}]},{"ID":"20240830165931-4mt7ab6","Type":"NodeParagraph","Properties":{"id":"20240830165931-4mt7ab6","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【化学成份】山里红叶含槲皮素(quercetin)，金丝桃甙(hyperoside)，牡荆素(vitexin)牡荆素鼠李糖甙(rhamnosylvitexin)，2-对羟苯甲基苹果酸[2-(4-hydroxybenzyl)malicacid]，盐酸二乙胺(diethylaminehydrochloride)，山梨醇(sorbitol)。"}]},{"ID":"20240830165931-hy8ocir","Type":"NodeParagraph","Properties":{"id":"20240830165931-hy8ocir","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240830165931-yeeji1y","Type":"NodeParagraph","Properties":{"id":"20240830165931-yeeji1y","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"1．对心、脑血管系统的作用山楂叶聚合黄酮一次给药或多次给药，均能对抗垂体后叶素诱发的家兔急性心肌缺血，缩小其心肌梗死范围。山楂叶提取物（0．1g/ml）0．4-8ml/kg静脉注入，能显着地降低或恢复垂体后叶素引起的豚鼠心电图S.T段上移和T波增高，加快后叶素引起的心率减慢。牡荆素鼠李糖贰20ml/kg能明显降低犬在位心脏的心肌耗氧量，与金丝桃甙等有协同作用。山楂叶水提取物给大鼠灌胃能显着降低结扎冠脉大鼠的血清磷酸肌酸激酶（CPK）水平和心肌梗死面积。20%山楂提取物颈静脉注入5-7min，脑血管阻力下降1.064-10．91kp/a(8-82mmHg）。"}]},{"ID":"20240830165931-bykl3f6","Type":"NodeParagraph","Properties":{"id":"20240830165931-bykl3f6","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"2．对凝血系统的影响山楂叶在体内、外均能非常显着地抑制胶原或ADP诱导的兔血小板聚集。此外，静脉注射山楂叶制剂30min后，全血比粘度显着下降。"}]},{"ID":"20240830165931-i5nzqpp","Type":"NodeParagraph","Properties":{"id":"20240830165931-i5nzqpp","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"3．降血脂作用山楂叶对蛋黄乳剂快速形成的小鼠胆固醇血症，有非常显着的降低作用。"}]},{"ID":"20240830165931-irdcs7z","Type":"NodeParagraph","Properties":{"id":"20240830165931-irdcs7z","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"4.耐缺氧作用山楂叶与普萘洛尔一样，可显着延长低压缺氧或常压缺氧实验小鼠的存活时间，与显着减低小鼠整体耗氧量的作用一致。"}]},{"ID":"20240830165931-ip79s0u","Type":"NodeParagraph","Properties":{"id":"20240830165931-ip79s0u","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"5.利尿作用山楂叶浸膏具有明显的利尿作用，家兔给药60min后尿量较给药前增加44.2%，90min增加53.9%，120min增加63.7%，说明其利尿作用温和、缓慢而持久，而且山楂叶利尿时对电解质影响较小。"}]},{"ID":"20240830165931-s7zs188","Type":"NodeParagraph","Properties":{"id":"20240830165931-s7zs188","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"6．毒性①急性毒性试：按7.7mg/kg，3．8mg/kg，1．9mg/kg给小鼠灌喂山楂叶总黄酮，血清丙氨酸转氨酶（ALT）与对照组无明显差异，心、肝、脾、肺、肾、脑、肠未见中毒性病理改变。②三致实验：山楂叶总黄酮50mg/kg，200mg/kg，2000mg/kg每日给妊娠大白鼠灌胃1次，每20d检查，未见其对受精母鼠及其受孕率、活胎率有不良影响。750mg/kg，1500mg/kg,3000mg/kg灌喂小鼠，每日l次，连续5d,沙门菌/哺乳动物做核实验均在正常范围内，并且畸变细胞率（骨髓细胞染色体畸变）与阴性对照组之间无明显差异。"}]},{"ID":"20240830165931-819lsxu","Type":"NodeParagraph","Properties":{"id":"20240830165931-819lsxu","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【性味】酸；平"}]},{"ID":"20240830165931-gdguyk6","Type":"NodeParagraph","Properties":{"id":"20240830165931-gdguyk6","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【归经】肺经"}]},{"ID":"20240830165931-ufwiosr","Type":"NodeParagraph","Properties":{"id":"20240830165931-ufwiosr","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【功能主治】止痒，敛疮，降血压。主漆疮，溃疡不敛，高血压病"}]},{"ID":"20240830165931-s5f8xsy","Type":"NodeParagraph","Properties":{"id":"20240830165931-s5f8xsy","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-10g；或泡茶饮。外用：适量，煎汤洗。"}]},{"ID":"20240830165931-8abwi5a","Type":"NodeParagraph","Properties":{"id":"20240830165931-8abwi5a","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【各家论述】《肘后方》：茎叶煮汁，洗漆疮。"}]},{"ID":"20240830165931-4wgdm5d","Type":"NodeParagraph","Properties":{"id":"20240830165931-4wgdm5d","updated":"20240830165947"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240830165932-1xdv75c","Type":"NodeThematicBreak","Properties":{"id":"20240830165932-1xdv75c","updated":"20240830165947"}},{"ID":"20240830165933-ubgztqb","Type":"NodeParagraph","Properties":{"id":"20240830165933-ubgztqb","updated":"20240830165947"}}]}