;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 4-20240724110405-canv0nw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 308px;\" parent-style=\"width: 318px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 318px;","style":"width: 308px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 6-20240724110602-qzxi7t8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 308px;\" parent-style=\"width: 318px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161732-5j1qoxl","Type":"NodeParagraph","Properties":{"id":"20240902161732-5j1qoxl","updated":"20240902161732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 407px;","style":"width: 397px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 7-20240724110725-c7gasno.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 397px;\" parent-style=\"width: 407px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 716px;","style":"width: 706px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 17-20240724112129-scw0tbc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 706px;\" parent-style=\"width: 716px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161732-c5tajqy","Type":"NodeParagraph","Properties":{"id":"20240902161732-c5tajqy","updated":"20240902161732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 769px;","style":"width: 759px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 15-20240724111646-l73val4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 759px;\" parent-style=\"width: 769px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 437px;","style":"width: 427px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角茴香 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角茴香 16-20240724111750-gqojaht.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 427px;\" parent-style=\"width: 437px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161753-idquzb2","Type":"NodeParagraph","Properties":{"id":"20240902161753-idquzb2","updated":"20240902161753"}},{"ID":"20240902161753-bd1qgr1","Type":"NodeParagraph","Properties":{"id":"20240902161753-bd1qgr1","updated":"20240902161753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莽草、八角对比"}]},{"ID":"20240902161753-98myry6","Type":"NodeParagraph","Properties":{"id":"20240902161753-98myry6","updated":"20240902161753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角 莽草 对比图"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角 莽草 对比图-20240702125324-autb3y1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 477px;","style":"width: 467px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角 莽草 对比图2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角 莽草 对比图2-20240702125358-7l4y0vv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 467px;\" parent-style=\"width: 477px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161753-unouibj","Type":"NodeParagraph","Properties":{"id":"20240902161753-unouibj","updated":"20240902162053"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：莽草跟八角茴香相似，注意甄别。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240506105055-dlsmi2x","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"319莽草"}]},{"ID":"20240902161753-8q86pcz","Type":"NodeParagraph","Properties":{"id":"20240902161753-8q86pcz","updated":"20240902161753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：八角茴香不一定是八个角，只是最常见的是八个角；"}]},{"ID":"20240902161736-eeds50y","Type":"NodeThematicBreak","Properties":{"id":"20240902161736-eeds50y"}},{"ID":"20240902161935-28aiica","Type":"NodeParagraph","Properties":{"id":"20240902161935-28aiica","updated":"20240902161942"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中草药：八角茴香"}]},{"ID":"20240902161935-nsamn4d","Type":"NodeParagraph","Properties":{"id":"20240902161935-nsamn4d","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"八角茴香《中国药典》"}]},{"ID":"20240902161935-o3n0v94","Type":"NodeParagraph","Properties":{"id":"20240902161935-o3n0v94","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【拼音名】BāJiǎoHuíXiānɡ"}]},{"ID":"20240902161935-vs28ydh","Type":"NodeParagraph","Properties":{"id":"20240902161935-vs28ydh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【英文名】FRUCTUSANISISTELLATI"}]},{"ID":"20240902161935-ztj54e6","Type":"NodeParagraph","Properties":{"id":"20240902161935-ztj54e6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【来源】本品为木兰科植物八角茴香IlliciumverumHook.f.的干燥成熟果实。秋、冬二季果实由绿变黄时采摘，置沸水中略烫后干燥或直接干燥。"}]},{"ID":"20240902161935-zujmu9p","Type":"NodeParagraph","Properties":{"id":"20240902161935-zujmu9p","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性状】本品为聚合果，多由8蓇葖果组成，放射状排列于中轴上。蓇葖果长1～2cm，宽0.3～0.5cm，高0.6～1cm；外表面红棕色，有不规则皱纹，顶端呈鸟喙状，上侧多开裂；内表面淡棕色，平滑，有光泽；质硬而脆。果梗长3～4cm，连于果实基部中央，弯曲，常脱落。每个蓇葖果含种子1粒，扁卵圆形，长约6mm，红棕色或黄棕色，光亮，尖端有种脐；胚乳白色，富油性。气芳香，味辛、甜。"}]},{"ID":"20240902161935-3fs4z6d","Type":"NodeParagraph","Properties":{"id":"20240902161935-3fs4z6d","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【鉴别】"}]},{"ID":"20240902161935-jq9xw8n","Type":"NodeParagraph","Properties":{"id":"20240902161935-jq9xw8n","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"（1）本品粉末红棕色。内果皮栅状细胞长柱形，长200～546μm，壁稍厚，纹孔口十字状或人字状。种皮石细胞黄色，表面观类多角形，壁极厚，波状弯曲，胞腔分枝状，内含棕黑色物；断面观长方形，壁不均匀增厚。果皮石细胞类长方形、长圆形或分枝状，壁厚。纤维长，单个散在或成束，直径29～60μm，壁木化，有纹孔。中果皮细胞红棕色，散有油细胞。内胚乳细胞多角形，含脂肪油滴和糊粉粒。"}]},{"ID":"20240902161935-90ki93e","Type":"NodeParagraph","Properties":{"id":"20240902161935-90ki93e","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"（2）取本品粗粉1g，加石油醚（60～90℃）-乙醚（1:1）混合液15ml，密塞，振摇15分钟，滤过，滤液于热水浴上挥干，残渣加无水乙醇2ml使溶解，作为供试品溶液。吸取供试品溶液2μl，点于以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，挥干，再点加间苯三酚盐酸试液约2μl，即显粉红色至紫红色的圆环。"}]},{"ID":"20240902161935-typmw93","Type":"NodeParagraph","Properties":{"id":"20240902161935-typmw93","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"（3）精密吸取[鉴别]（2）项下的供试品溶液10μl,置10ml量瓶中，加无水乙醇至刻度，摇匀，照分光光度法（附录ⅤA）测定，在259nm波长处有最大吸收。"}]},{"ID":"20240902161935-n9m7p35","Type":"NodeParagraph","Properties":{"id":"20240902161935-n9m7p35","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"（4）取八角茴香对照药材1g，照[鉴别]（2）项下的供试品溶液制备方法，制成对照药材溶液。另取茴香醛对照品20μl,加无水乙醇2ml使溶解，作为对照品溶液。照薄层色谱法（附录ⅥB）试验，吸取[鉴别]（2）项下的供试品溶液及上述两种溶液各5～10μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以石油醚（30～60℃）-丙酮-醋酸乙酯（19:1:1）为展开剂，展开，取出，晾干，喷以间苯三酚盐酸试液。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点；在与对照品色谱相应的位置上，显相同的橙色至橙红色斑点。"}]},{"ID":"20240902161935-iln2vuc","Type":"NodeParagraph","Properties":{"id":"20240902161935-iln2vuc","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902161935-0dcpg1z","Type":"NodeParagraph","Properties":{"id":"20240902161935-0dcpg1z","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【归经】归肝、肾、脾、胃经。"}]},{"ID":"20240902161935-min1jji","Type":"NodeParagraph","Properties":{"id":"20240902161935-min1jji","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【功能主治】温阳散寒，理气止痛。用于寒疝腹痛，肾虚腰痛，胃寒呕吐，脘腹冷痛。"}]},{"ID":"20240902161935-jblxkhn","Type":"NodeParagraph","Properties":{"id":"20240902161935-jblxkhn","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【用法用量】3～6g。"}]},{"ID":"20240902161935-yxd3qf7","Type":"NodeParagraph","Properties":{"id":"20240902161935-yxd3qf7","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【贮藏】置阴凉干燥处。"}]},{"ID":"20240902161935-5lynzug","Type":"NodeParagraph","Properties":{"id":"20240902161935-5lynzug","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【摘录】《中国药典》"}]},{"ID":"20240902161935-35imirw","Type":"NodeParagraph","Properties":{"id":"20240902161935-35imirw","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"八角茴香《全国中草药汇编》"}]},{"ID":"20240902161935-88mmkzb","Type":"NodeParagraph","Properties":{"id":"20240902161935-88mmkzb","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【拼音名】BāJiǎoHuíXiānɡ"}]},{"ID":"20240902161935-xtjljnt","Type":"NodeParagraph","Properties":{"id":"20240902161935-xtjljnt","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【别名】大茴香、大料、五香八角"}]},{"ID":"20240902161935-7mts738","Type":"NodeParagraph","Properties":{"id":"20240902161935-7mts738","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【来源】木兰科八角属植物八角IlliciumverumHook.F.，以果实入药。秋季采收，晒干备用。"}]},{"ID":"20240902161935-jghum3o","Type":"NodeParagraph","Properties":{"id":"20240902161935-jghum3o","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高达20米；树皮灰色至红褐色，有不规则裂纹；枝密集，呈水平伸展。单叶互生；叶柄粗壮，长约1厘米；叶片革质，椭圆状倒卵形至椭圆状倒披针形，长5～11厘米，宽1.5～4厘米，先端急尖或短渐尖，基部窄楔形，全缘，上面有光泽和透明的油点，下面生疏柔毛。春季花单生于叶腋；花被片7～12，数轮，覆瓦状排列，内轮粉红色至深红色；雄蕊11～20个，排成1～2轮；心皮8～9个，离生，轮状排列。果梗粗壮，长3～4厘米，钩形弯曲。聚合果放射星芒状，直径约3.5厘米，红褐色，蓇葖顶端钝呈鸟嘴状。每一蓇葖含种子1粒，种子呈扁卵形，红棕色或灰棕色，有光泽。气佳适，味香甜。"}]},{"ID":"20240902161935-8jdzbew","Type":"NodeParagraph","Properties":{"id":"20240902161935-8jdzbew","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【生境分布】生于温暖湿润的山谷中。分布于福建、广西、广东、贵州、云南等省区。多为人工栽培。"}]},{"ID":"20240902161935-slxbkbt","Type":"NodeParagraph","Properties":{"id":"20240902161935-slxbkbt","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【栽培】喜温暖湿润环境，幼枝喜阴，成株喜阳。适宜我国中部和南部酸性土壤栽培。用种子繁殖。春播1～2月，秋播11～12月。采种后，将种子与4、5倍黄泥加水搅拌，使每粒种子裹上一层黄泥，放阴凉处保湿至播时取出，以5寸行距在高畦条播，种间距1寸左右，覆土1～1.5寸。出苗后，立即搭3尺高、透光度30～40％的棚遮阴。第二年按12×12尺株行距定株。"}]},{"ID":"20240902161935-5r5xm2q","Type":"NodeParagraph","Properties":{"id":"20240902161935-5r5xm2q","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实含挥发油4～9％，一般约为5％（果皮中较多）、脂肪油约22％（主存于种子中）及蛋白质、树胶、树脂等。挥发油中主要成份为茴香醚（anethole）约80～90％，冷时常自油中析出，其余为d－蒎烯、l－水芹烯、α－萜品醇及少量黄樟醚、甲基胡椒酚（methylchavicol）。叶含挥发油，油中含茴香醚、茴香醛等。"}]},{"ID":"20240902161935-7713oxw","Type":"NodeParagraph","Properties":{"id":"20240902161935-7713oxw","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【药理作用】抑菌试验：八角茴香的乙醇提取物对金黄色葡萄球菌、肺炎球菌、白喉杆菌、枯草杆菌、霍乱弧菌、伤寒杆菌、副伤寒杆菌、痢疾杆菌、大肠杆菌及常见致病性皮肤真菌均有较强的抑制作用。"}]},{"ID":"20240902161935-p107nxh","Type":"NodeParagraph","Properties":{"id":"20240902161935-p107nxh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性味】辛，温。"}]},{"ID":"20240902161935-dzkye9o","Type":"NodeParagraph","Properties":{"id":"20240902161935-dzkye9o","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【功能主治】温中理气，健胃止呕。用于呕吐，腹胀，腹痛，疝气痛。"}]},{"ID":"20240902161935-qzf4bs7","Type":"NodeParagraph","Properties":{"id":"20240902161935-qzf4bs7","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【用法用量】1～2钱。"}]},{"ID":"20240902161935-hz869f8","Type":"NodeParagraph","Properties":{"id":"20240902161935-hz869f8","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【备注】同属植物中有些品种的果实，具有毒性，误食可引起中毒，甚至死亡，应加注意。有毒的果实，外形虽与八角茴香相似，但也有区别点，主要为：蓇葖果发育不规则，形体较小，果皮外表颇缩皱，每一蓇葖的顶端较尖锐，成向上弯曲鸟嘴状，果梗平直。臭如树胶状，味不佳而苦。有毒物质为莽草毒素（shikimitoxin）、莽草晶毒素（shikimin）等。"}]},{"ID":"20240902161935-03m1wm1","Type":"NodeParagraph","Properties":{"id":"20240902161935-03m1wm1","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【摘录】《全国中草药汇编》"}]},{"ID":"20240902161935-xgxcyvo","Type":"NodeParagraph","Properties":{"id":"20240902161935-xgxcyvo","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"八角茴香《*辞典》"}]},{"ID":"20240902161935-9dfld68","Type":"NodeParagraph","Properties":{"id":"20240902161935-9dfld68","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【出处】《品汇精要》"}]},{"ID":"20240902161935-83406zl","Type":"NodeParagraph","Properties":{"id":"20240902161935-83406zl","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【拼音名】BāJiǎoHuíXiānɡ"}]},{"ID":"20240902161935-g8oge39","Type":"NodeParagraph","Properties":{"id":"20240902161935-g8oge39","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【别名】舶上茴香（《脚气治法总要》），大茴香（《卫生杂兴》），舶茴香、茴香八角珠（《纲目》），八角香、八角大茴（《本草求真》），八角（《本草求原》），原油茴（《药材资料汇编》），大八角（《药材学》）。"}]},{"ID":"20240902161935-fu0prd2","Type":"NodeParagraph","Properties":{"id":"20240902161935-fu0prd2","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【来源】为木兰科植物八角茴香的果实。每年采收2次，第1次为主采期，在8～9月间，第2次在翌年2～3月间。采摘后，微火烘干，或用开水浸泡片刻，待果实转红后晒干。"}]},{"ID":"20240902161935-43esfvp","Type":"NodeParagraph","Properties":{"id":"20240902161935-43esfvp","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高10～14米，树皮灰色至红褐色。单叶互生，革质，披针形至长椭圆形，长6～12厘米，宽2～5厘米，先端急尖或渐尖，基部楔形，全缘，下面疏被柔毛，叶脉羽状，中脉下陷，侧脉稍凸起；叶柄粗壮。花单生于叶腋，花梗长1.5～3厘米；花圆球形，花被肉质；萼片3，黄绿色；花瓣6～9，排成2～3轮，淡粉红色或深红色，广卵圆形或长圆形；雄蕊15～19，成2～3轮，心皮8～9，分离，花柱短，基部肥厚，柱头细小。蓇葖果成星芒状排列，幼时绿色，成熟时红棕色，星状体径约2.5～3厘米，开裂。种子扁卵形，棕色有光泽。第1次花期2～3月，果期8～9月。第2次花期在第1次果期之后，第2次果期为翌年2～3月。"}]},{"ID":"20240902161935-22842gq","Type":"NodeParagraph","Properties":{"id":"20240902161935-22842gq","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【生境分布】生长于土壤疏松的阴湿山地。野生或栽培。分布福建、广东、广西、云南、贵州、台湾等地。"}]},{"ID":"20240902161935-hxs6d6u","Type":"NodeParagraph","Properties":{"id":"20240902161935-hxs6d6u","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902161935-aw4rbk6","Type":"NodeParagraph","Properties":{"id":"20240902161935-aw4rbk6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"干燥果实，常由8个（少数有6～13个）蓇葖集成聚合果，放射状排列，中轴下有一钩状弯曲的果柄。菁荚果小艇形，长5～20毫米，高5～10毫米，宽约5毫米，顶端钝尖而平直，上缘开裂。果皮外表面红棕色，多数有皱纹，内表面淡棕色，有光泽，内含种子1粒。种子扁卵形，长7毫米，宽4毫米，厚2毫米；种皮棕色或灰棕色，光亮，一端有小种脐，旁有明显珠孔，另一端有合点，种脐与合点之间有淡色的狭细种脊。种皮质脆，内含白色种仁，富油质。味微甜，有特殊香气。以个大、色红、油多、香浓者为佳。"}]},{"ID":"20240902161935-50pjs28","Type":"NodeParagraph","Properties":{"id":"20240902161935-50pjs28","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"主产广西、广东、云南等地。"}]},{"ID":"20240902161935-mcgha03","Type":"NodeParagraph","Properties":{"id":"20240902161935-mcgha03","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"同属植物莽草的果实，形状与八角茴香非常相似，极易混淆。莽草果实有毒，不可误用。其主要区别点为：莽草果实较小，蓇葖一般长约7～10毫米；其尖端呈向上弯曲之鸟喙状。果柄多垂直，常脱落。带树胶样气味，味苦。"}]},{"ID":"20240902161935-l5315k8","Type":"NodeParagraph","Properties":{"id":"20240902161935-l5315k8","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【炮制】"}]},{"ID":"20240902161935-gsxmg8g","Type":"NodeParagraph","Properties":{"id":"20240902161935-gsxmg8g","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"筛去泥屑种子，拣去果柄杂质。"}]},{"ID":"20240902161935-czz9aal","Type":"NodeParagraph","Properties":{"id":"20240902161935-czz9aal","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"《本草蒙筌》：\"盐酒炒用。\""}]},{"ID":"20240902161935-66ijumk","Type":"NodeParagraph","Properties":{"id":"20240902161935-66ijumk","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性味】"}]},{"ID":"20240902161935-wr9jykx","Type":"NodeParagraph","Properties":{"id":"20240902161935-wr9jykx","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"辛甘，温。"}]},{"ID":"20240902161935-lb4d8xd","Type":"NodeParagraph","Properties":{"id":"20240902161935-lb4d8xd","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"味辛甘，性温。\""}]},{"ID":"20240902161935-w5wvo4y","Type":"NodeParagraph","Properties":{"id":"20240902161935-w5wvo4y","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"味辛，气平，无毒。\""}]},{"ID":"20240902161935-mlq553o","Type":"NodeParagraph","Properties":{"id":"20240902161935-mlq553o","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"性热。\""}]},{"ID":"20240902161935-3fqa3lv","Type":"NodeParagraph","Properties":{"id":"20240902161935-3fqa3lv","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【归经】"}]},{"ID":"20240902161935-pc7rvuw","Type":"NodeParagraph","Properties":{"id":"20240902161935-pc7rvuw","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"入脾、肾经。"}]},{"ID":"20240902161935-wzhqz5v","Type":"NodeParagraph","Properties":{"id":"20240902161935-wzhqz5v","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"①《本草蒙筌》：\"入心、肾、小肠、膀胱。\""}]},{"ID":"20240902161935-cu308rg","Type":"NodeParagraph","Properties":{"id":"20240902161935-cu308rg","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入肝、膀胱、小肠。\""}]},{"ID":"20240902161935-sxq13fq","Type":"NodeParagraph","Properties":{"id":"20240902161935-sxq13fq","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肾二经。\""}]},{"ID":"20240902161935-2ruf15c","Type":"NodeParagraph","Properties":{"id":"20240902161935-2ruf15c","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【功能主治】"}]},{"ID":"20240902161935-7lxsn35","Type":"NodeParagraph","Properties":{"id":"20240902161935-7lxsn35","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"温阳，散寒，理气。治中寒呕逆，寒疝腹痛，肾虚腰痛，干、湿脚气。"}]},{"ID":"20240902161935-soam1e5","Type":"NodeParagraph","Properties":{"id":"20240902161935-soam1e5","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"主一切冷气及诸疝疗痛。\""}]},{"ID":"20240902161935-u1axryy","Type":"NodeParagraph","Properties":{"id":"20240902161935-u1axryy","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"主肾劳疝气，小肠吊气挛疼，干、湿脚气，膀胱冷气肿痛。开胃止呕，下食，补命门不足。（治）诸瘘，霍乱。\""}]},{"ID":"20240902161935-cejo8eq","Type":"NodeParagraph","Properties":{"id":"20240902161935-cejo8eq","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"③《医学入门》：\"专主腰痛。\""}]},{"ID":"20240902161935-6rztph6","Type":"NodeParagraph","Properties":{"id":"20240902161935-6rztph6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"④《本草正》：\"除齿牙口疾，下气，解毒。\""}]},{"ID":"20240902161935-47byil2","Type":"NodeParagraph","Properties":{"id":"20240902161935-47byil2","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"润肾补肾，舒肝木，达阴郁，舒筋，下除脚气。\""}]},{"ID":"20240902161935-37oqzqh","Type":"NodeParagraph","Properties":{"id":"20240902161935-37oqzqh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，1～2钱；或入丸、散。"}]},{"ID":"20240902161935-s92gyev","Type":"NodeParagraph","Properties":{"id":"20240902161935-s92gyev","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【注意】"}]},{"ID":"20240902161935-1za57mh","Type":"NodeParagraph","Properties":{"id":"20240902161935-1za57mh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"阴虚火旺者慎服。"}]},{"ID":"20240902161935-v58l84d","Type":"NodeParagraph","Properties":{"id":"20240902161935-v58l84d","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"多食损目发疮。\""}]},{"ID":"20240902161935-4hmy84d","Type":"NodeParagraph","Properties":{"id":"20240902161935-4hmy84d","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"②《会约医镜》：\"阳旺及得热则呕者均戒。\""}]},{"ID":"20240902161935-t4xv7je","Type":"NodeParagraph","Properties":{"id":"20240902161935-t4xv7je","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【附方】"}]},{"ID":"20240902161935-1hjg057","Type":"NodeParagraph","Properties":{"id":"20240902161935-1hjg057","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"①治小肠气坠：八角茴香，小茴香各三钱，乳香少许。水（煎）服取汗。（《仁斋直指方》）"}]},{"ID":"20240902161935-59tjs43","Type":"NodeParagraph","Properties":{"id":"20240902161935-59tjs43","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"②治疝气偏坠：大茴香末一两，小茴香末一两。用猪尿胞一个，连尿入二末于内，系定罐内，以酒煮烂，连胞捣丸如梧子大。每服五十丸，白汤下。（《卫生杂兴》）"}]},{"ID":"20240902161935-g6mznb4","Type":"NodeParagraph","Properties":{"id":"20240902161935-g6mznb4","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"③治腰重刺胀：八角茴香，炒，为末，食前酒服二钱。（《仁斋直指方》）"}]},{"ID":"20240902161935-ywehoeh","Type":"NodeParagraph","Properties":{"id":"20240902161935-ywehoeh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"④治腰痛如刺：八角茴香（炒研）每服二钱，食前盐汤下。外以糯米一、二升，炒热，袋盛，拴于痛处。（《简便单方》）"}]},{"ID":"20240902161935-lhr7x6e","Type":"NodeParagraph","Properties":{"id":"20240902161935-lhr7x6e","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"⑤治大小便皆秘，腹胀如鼓，气促：大麻子（炒，去壳）半两，八角茴香七个。上作末，生葱白三七个，同研煎汤，调五苓散服。（《永类钤方》）"}]},{"ID":"20240902161935-khhlk2f","Type":"NodeParagraph","Properties":{"id":"20240902161935-khhlk2f","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"⑥治风毒湿气，攻疰成疮，皮肉紫破脓坏，行步无力，皮肉焮热：舶上茴香（炒）、地龙（去土，炒）、川乌头（炮，去皮尖）、乌药（锉）、牵牛（炒）各一两。研杵匀细，酒煮糊为丸，如梧桐子大。每服空心盐汤下十五丸，日二。（《脚气治法总要》茴香丸）"}]},{"ID":"20240902161935-jr45bn5","Type":"NodeParagraph","Properties":{"id":"20240902161935-jr45bn5","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【摘录】《*辞典》"}]},{"ID":"20240902161935-5hf94z5","Type":"NodeParagraph","Properties":{"id":"20240902161935-5hf94z5","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"八角茴香《中华本草》"}]},{"ID":"20240902161935-rsh6vje","Type":"NodeParagraph","Properties":{"id":"20240902161935-rsh6vje","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【出处】出自《品汇精要》"}]},{"ID":"20240902161935-v4i5eej","Type":"NodeParagraph","Properties":{"id":"20240902161935-v4i5eej","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【拼音名】BāJiǎoHuíXiānɡ"}]},{"ID":"20240902161935-6hk2q3l","Type":"NodeParagraph","Properties":{"id":"20240902161935-6hk2q3l","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【别名】舶上茴香、大茴香、舶茴香、八角珠、八角香、八角大茴、八角、原油茴、八月珠、大料、五香八角"}]},{"ID":"20240902161935-86e7bod","Type":"NodeParagraph","Properties":{"id":"20240902161935-86e7bod","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【来源】"}]},{"ID":"20240902161935-jup44ur","Type":"NodeParagraph","Properties":{"id":"20240902161935-jup44ur","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"药材基源：为八角科植物八角茴香的果实。"}]},{"ID":"20240902161935-42igf78","Type":"NodeParagraph","Properties":{"id":"20240902161935-42igf78","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：IlliciumverumHook.f."}]},{"ID":"20240902161935-d1zj31h","Type":"NodeParagraph","Properties":{"id":"20240902161935-d1zj31h","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培8年有少量结果，10年进入盛果期，可连续采收50～70年。春果在4月间果实老熟落地时拾取，晒干。秋果在10-11月采收，采后置沸水锅中煮沸，搅拌约5～10min后，捞出，晒干或烘干。"}]},{"ID":"20240902161935-xpr92ec","Type":"NodeParagraph","Properties":{"id":"20240902161935-xpr92ec","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【原形态】常绿乔木，高10-20m。树皮灰色至红褐色，有不规则裂纹。枝密集，呈水手伸展。单叶互生或3-6簇生于枝顶；叶柄粗壮，长约1cm；叶片革质，长椭圆形或椭圆状披针形，长6-12cm，宽2-4cm，先端渐尖或急尖，基部楔形，全缘，上面深绿色，有光泽和油点，下面浅绿色，疏生柔毛。花两性，单生于叶腋，花被片7-12，数轮，覆瓦状排列，内轮粉红色；雄蕊11-19，排成1-2轮；心皮8-9，离生。聚合果，多由8个（艹骨）（艹突）果放射状排列成八角形，直径3.5-4cm，红褐色，木质；（艹骨）（艹突）果先端钝尖或钝，成熟时沿腹缝线开裂。种子1，扁卵形，亮棕色。花期春、秋两季.早期秋季至翌年春季。"}]},{"ID":"20240902161935-7m6cb32","Type":"NodeParagraph","Properties":{"id":"20240902161935-7m6cb32","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【生境分布】"}]},{"ID":"20240902161935-zxy8d2c","Type":"NodeParagraph","Properties":{"id":"20240902161935-zxy8d2c","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"生态环境：生于气候温暖、潮湿、土壤疏松的山地，野生或栽培，栽培品种甚多。"}]},{"ID":"20240902161935-wc5e4pb","Type":"NodeParagraph","Properties":{"id":"20240902161935-wc5e4pb","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于福建、台湾、广西、广东、贵州、云南等地。"}]},{"ID":"20240902161935-wu5xpyg","Type":"NodeParagraph","Properties":{"id":"20240902161935-wu5xpyg","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【栽培】"}]},{"ID":"20240902161935-2x3gohx","Type":"NodeParagraph","Properties":{"id":"20240902161935-2x3gohx","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"生物学特性喜温暖、潮湿气候，产区多在北纬25°以南，年降水量需1000mm以上，相对湿度80％以上。"}]},{"ID":"20240902161935-g5raxnu","Type":"NodeParagraph","Properties":{"id":"20240902161935-g5raxnu","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"冬、春旱季有露、雾，年平均气温19～23℃，最冷月平均气温10℃以上。幼树喜荫，成年树喜光。忌强光和干旱，怕强风。以土层深厚、疏松、腐殖质含量丰富、排水良好的偏酸性的壤土或砂质壤土栽培为宜。"}]},{"ID":"20240902161935-yawv2jg","Type":"NodeParagraph","Properties":{"id":"20240902161935-yawv2jg","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子繁殖。选二十年生以上植株、结实多，含油量高无病虫害的作留种树。9～10月采收果皮由绿色变黄褐色的成熟果实，随采随播，或用湿沙层积贮藏至第2年1～2月播种。条播，按行距15～20cm开条沟，沟深4cm，按株距3～4cm播种子1粒，用草灰拌细上覆盖，厚度约3cm，再用稻草或茅草覆盖。在幼苗出土前，要经常淋水，促进发芽。出苗后撤去覆盖物，立即插树枝或搭棚遮荫，至11月再拆去。苗床要经常松土除草，结合施肥，早期以氮肥为主，后期以磷、钾肥为主。移苗造林季节在2月新芽未萌动前进行。实用林用2年生苗，一般行珠距各为5m左右，每1hm2390株；叶用林用3年生苗，行株距各为1．33m左右，每1hm25625株。"}]},{"ID":"20240902161935-lvcbcbf","Type":"NodeParagraph","Properties":{"id":"20240902161935-lvcbcbf","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"田间管理定植后3年内宜有天然荫蔽树遮荫，可与农作物间作，3年后要求全光照。每年中耕除草2次，均在收果前，第1次在1～2月，第2次在7～8月。追肥2次，在采果后可施绿肥、厩肥及过磷酸钙等肥料。每隔3～5年垦复施肥1次，要及时截干打顶、整形。"}]},{"ID":"20240902161935-1m3go1m","Type":"NodeParagraph","Properties":{"id":"20240902161935-1m3go1m","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有炭疽病，可喷1：1：120波尔多液防治。虫害有八角尺蠖，在幼龄期喷马拉松1000倍液防治。另外还有金花虫为害。"}]},{"ID":"20240902161935-q7wxmo7","Type":"NodeParagraph","Properties":{"id":"20240902161935-q7wxmo7","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性状】"}]},{"ID":"20240902161935-1vwduli","Type":"NodeParagraph","Properties":{"id":"20240902161935-1vwduli","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"性状鉴别聚合果约由8个（稀5-13个）（艹骨）英果聚成，各分果近等大，放射状排列于中轴上，（艹骨）（艹突）果长1-2cm，高0.5-1cm，外表面棕褐色或红褐色，有不规则皱纹，顶端钝或钝尖，果皮较厚，上侧多开裂成小艇形；内表面淡棕色，有光泽。每个（艹骨）（艹突）果含种子1粒，扁卵圆形，红棕色或灰棕色，有光泽。果梗长3-4cm，弯曲，常脱落。气芳香，味辛、甜。"}]},{"ID":"20240902161935-x9dlsnu","Type":"NodeParagraph","Properties":{"id":"20240902161935-x9dlsnu","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"以个大、色红、油性大、香气浓者为佳。"}]},{"ID":"20240902161935-71xmur5","Type":"NodeParagraph","Properties":{"id":"20240902161935-71xmur5","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"显微鉴别果实横切面：①外果皮为1列表皮细胞，外被不规则小突起的角质层。②中果皮为多层厚用细胞，其内为薄壁细胞，有散在的油细胞、维管束；在腹缝线处有数列厚壁细胞。③内果皮为1列排列整齐的柱状细胞，在腹缝线部分为石细胞；石细胞层从腹缝线向内逐渐加长，与柱状细胞层衔接。④种皮表皮细胞为1列排列紧密的长方形石细胞，其外壁与侧壁呈U形增厚；其内为数层营养层薄壁细胞；胚乳细胞含脂肪油及糊粉粒。"}]},{"ID":"20240902161935-6yp62mp","Type":"NodeParagraph","Properties":{"id":"20240902161935-6yp62mp","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"粉末特征：红褐色。①果皮表皮细胞类多角形，壁厚，角质纹理致密。气孔不定式，长圆形或圆形，直径40-45μm，副卫细胞4-8个。②腹缝线石细胞类长方形或多角形，长至260μm，有孔沟及纹孔。③油细胞多已破碎，完整者类圆形，直径150-180μm。④内果皮柱状细胞直径50-80μm，长达500μm，壁较薄，木化，多具单斜纹孔或十字纹孔对。⑤种皮表皮石细胞淡黄色，矩形，宽50-80μm，长达180μm。⑤纤维较粗长，宽40-90μm，长达1000μm，纹孔明显，木化。"}]},{"ID":"20240902161935-pn59q49","Type":"NodeParagraph","Properties":{"id":"20240902161935-pn59q49","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取果皮粗粉0．5g,加乙醇5ml，温浸2min，放冷，滤过。滤液加蒸馏水25ml，即产生显着浑浊；移至分液漏斗中，加石油醚10ml，充分振摇，静置，分取石油醚液，蒸干，残渣加醋酸溶解，加三氯化铁试液2滴，振摇，沿管壁缓缓加硫酸，两液层交界处显持久的棕绿色环。（检查茴香醚）（2）薄层色谱取本品粗粉10g，常法提取挥发油，将油溶于1ml氯仿中，供点样用。另取茴香醚氯仿溶液为对照液。分别点于同一硅胶G薄层板上，以石油醚-乙酸乙酯（99：1）展开，用5％香荚兰醛硫酸试剂显色，供试品色谱中与茴香醚色谱相应位置上显一樱红色斑点。"}]},{"ID":"20240902161935-9nl1fuf","Type":"NodeParagraph","Properties":{"id":"20240902161935-9nl1fuf","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"品质标志《中华人民共和国药典》1995年版规定：本品含挥发油不得少于4．0％（ml／g）。"}]},{"ID":"20240902161935-ie1o7vk","Type":"NodeParagraph","Properties":{"id":"20240902161935-ie1o7vk","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【化学成份】果实主含黄酮类化合物，内有：槲皮素-3－O-鼠李糖甙（quercetin-3－O-rhamnoside），槲皮素-3－O-葡萄糖甙（quercetin-3－O-β-glucoside），槲皮素-3－O-半乳糖甙（quercetin-3－O-galactoside），槲皮素-3－O-木糖甙（quercetin-3－O-xyloside），槲皮素（quercetin），山奈酚（kaempferol），山奈酚-3－O-葡萄糖甙（kaempferol-3-O-glucoside），山奈酚-3－O-半乳糖甙（Kaempferol-3－O－balactoside），山奈酚-3-芸香糖甙（kaempferol-3-rutinoside）[1]，还含有机酸类化合物，内有3－，或4-，或5-咖啡酰奎宁酸（caf－feoylquinicacid），3－，或4－，或5-阿魏酰奎宁酸（feruloylauinicacid），4-（β-D-吡喃葡萄糖氧基）-苯甲酸[4-（β-D-glucopyra-nosyloxy）benzoicacid］[2]，羟基桂皮酸（hydroxycinnamicacid），羟基苯甲酸（hydroxybenzoicacid）[3]等。又含挥发油，其中主成分是反式茴香脑（anethole），还有对丙烯基苯基异戊烯醚（foeni－culin），α-及β-蒎烯（pinene），樟烯（camphene），月桂烯（myrcene），α-水芹烯（a－phellandrene），α-柠檬烯（α－limonene），3-蒈烯（3－carene），枝叶素（cineole），4（10）-侧柏烯［4（10）－thujene],α-松油烯（α-terpinene），芳樟醇（linalool），α-松油醇（α-terpineol），4-松油醇（4－terPineol），爱草脑（estragole），顺式茴香脑，茴香醛（anisaldehyde），α-香柑油烯（α－bergamotene），顺式-β-金合欢烯（Z-β-farnesene），仅式丁香烯（caryophyllene），对苯二醛（tereph-thaldehyde），β-甜没药烯（β－bisabolene），α-薄草烯（α-humulene），3-甲氧基苯甲酸甲酯（methyl3－methoxyenzoate）,β-芹子烯（β-se-linene）,α-（王古）（王巴）烯（α-copaene）,对甲氧基苯-2-丙酮（p-methoxyphenylpropan-2－one），δ-及γ-荜澄茄烯（cadinene）,β-愈创木烯（β-guaiene），橙花叔醇（nerolidol），榄香醇（elemol），甲基异丁香油酚（methylisoeugenol），β-橄榄烯（β-maaliene），胡萝卜次醇（carotol），柏木醇（cedrol）[4]，对甲氧基桂皮醛（p－methoxycinna-maldehyde）[5]。"}]},{"ID":"20240902161935-fafdsvk","Type":"NodeParagraph","Properties":{"id":"20240902161935-fafdsvk","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【药理作用】"}]},{"ID":"20240902161935-v3ilwq6","Type":"NodeParagraph","Properties":{"id":"20240902161935-v3ilwq6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"1.抑菌作用本品水煎剂对人型结核杆菌及枯草杆菌有抑菌作用。乙醇提取物对金黄色葡萄球菌、肺炎球菌、白喉杆菌、枯草杆菌、霍乱弧菌、伤寒杆菌、副伤寒杆菌、痢疾杆菌、大肠杆菌及常见致病菌均有较强的抑制作用。"}]},{"ID":"20240902161935-6dfqugc","Type":"NodeParagraph","Properties":{"id":"20240902161935-6dfqugc","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"醇提取物在体外对革兰氏阳性细菌(金黄色葡萄球菌。肺炎球菌、白喉杆菌等)之抑茵作用与青霉素钾盐20单位/ml相似；对革兰氏阴性细菌(枯草杆菌、大肠杆菌、霍乱弧茵及伤寒、副伤寒、痢疾杆菌等)之抑菌作用与硫酸链霉素50单位/ml相似；对真菌之抑菌作用大于1%的苯甲酸及水杨酸。"}]},{"ID":"20240902161935-3iw3vic","Type":"NodeParagraph","Properties":{"id":"20240902161935-3iw3vic","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"2.刺激作用挥发油中的茴香醚具有刺激作用，能促进肠胃蠕动，可缓解腹部疼痛；对呼吸道分泌细胞有刺激作用而促进分泌。可用于祛痰。"}]},{"ID":"20240902161935-huw3psx","Type":"NodeParagraph","Properties":{"id":"20240902161935-huw3psx","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"3.升白细胞作用本品提取物甲基胡椒酚，给正常家兔和猴iml00mg/只，给药后24小时白细胞为给药前150%(P＜0.05＝，正常犬im300mg/只，给药后24小时出现升白现象，连续用药白细胞连续增加，停药后2小时白细胞仍为用药前的157%，骨髓细胞数为用药前188%，骨髓有核细胞呈活跃状态。正常犬1次po肠丸200mg/只，24小时白细胞升高，48小时为用药前的161%P＜0.05。手术直接灌入肠道，6-24小时出现明显白细胞升高现象，为用药前的166-181%(P＜0.01)。犬用环磷酰胺所致的白细胞减少症，若同时服用甲基胡椒酚则可使犬全部存活，白细胞下降慢，恢复快。对化疗和放疗病人的白细胞减少症有较好疗效。"}]},{"ID":"20240902161935-jg7o6w6","Type":"NodeParagraph","Properties":{"id":"20240902161935-jg7o6w6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"4.具雌激素活性本品所含茴香脑具有雌激素活性，其活性为50小鼠M.U./ml或100大鼠单位(R.U./ml)。"}]},{"ID":"20240902161935-l0xafft","Type":"NodeParagraph","Properties":{"id":"20240902161935-l0xafft","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【毒性】"}]},{"ID":"20240902161935-damc6id","Type":"NodeParagraph","Properties":{"id":"20240902161935-damc6id","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"1.广西田东县产(统货)和广西南宁市商品(食用二级)八角茴香提取的挥发油，以每1kg259剂量ig健康小鼠，观察7d，未见死亡。"}]},{"ID":"20240902161935-zbo3qtg","Type":"NodeParagraph","Properties":{"id":"20240902161935-zbo3qtg","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"2.小鼠po4g/kg，ip1.5g/kg。茴香脑的顺式异构体ip大鼠0.07g/kg。小鼠0.095g/kg。反式异物体ip，大鼠2.67g/kg，小鼠1.41g/kg。反式异构体，大鼠ip为900mg/kg，顺式异构体，大鼠ip为93mg/kg。八角茴香成分安粒素(茴香脑anethole)灌胃，对小鼠的LD50为4.0g/kg，腹腔注射为1.5g/kg，其顺式异构体腹腔注射对大鼠的LD50为0.07mg/kg，对小鼠为0.095mg/kg，反式异构体腹腔注射对大鼠的LD50为2.67mg/kg，对小鼠的LD50为1.41mg/kg。"}]},{"ID":"20240902161935-lx4z79f","Type":"NodeParagraph","Properties":{"id":"20240902161935-lx4z79f","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"3.甲基胡椒酚的LD50，小鼠po4000mg/kg。"}]},{"ID":"20240902161935-g44fujc","Type":"NodeParagraph","Properties":{"id":"20240902161935-g44fujc","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"4.致突变试验：将广西桂林植物研究所植物园(栽培)提供的干果，用水蒸汽蒸馏得挥发油，采用TA98移码突变型菌株及TA100碱基置换型菌株，按规定方法鉴定其遗传特性、自发回变数以及阳性对照化合物的敏感性。菌株采用(1985)鼠伤寒沙门氏菌诱变性试验方法进行纸片点试和渗入法检测受试物。测试物剂量每皿在0.2、2、20、500等剂量范围(ug/皿)，而每一剂量均做2次，每次2-3个平行皿。在加与不加S9的条件下分别进行测试。结果八角茴香油未检测到诱变性，S9阳性诊断物2-乙酰氨基芴(2一AAF)出现Rt/Rc≥2，表明有诱变性。取食管癌高发区涉县花椒和市售八角(未定学名)、桂皮等，各称取0.5g，分别加二甲亚砜1ml，浸泡24h后灭菌，用沾有浸液的颗粒直接做点试法致突变试验，操作方法和结果判断均按全国Ames试验标准化方法进行，加与不加S一9掺入法试验结果八角茴香和花椒对TA98菌呈阳性反应，对TA100作用较弱(±)，桂皮均为阳性。该实验结果，提示这3种天然调味品的安全性值得进一步研究。"}]},{"ID":"20240902161935-cbb8ni6","Type":"NodeParagraph","Properties":{"id":"20240902161935-cbb8ni6","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【鉴别】1.取果皮粗粉0.5g，加乙醇5ml，温浸2min，放冷、过滤。滤液中加蒸馏水25ml，发生淡黄色混浊，移至分液漏斗中，加石油醚10ml，充分振摇，静置，分取石油醚，蒸干。残渣加醋酸2ml，使溶解，加三氯化铁试液2滴，摇匀。将此醋酸溶液沿管壁缓缓加信盛有硫酸(约1-2ml)的试管中，两液界面显出一明显、持久的棕绿色环。(检查茴香醚)2.薄层层析：取本品粗粉10g，常法提取挥发油，将油溶于1ml氯仿中，供点样用；另用茴香醚和茴香醛氯仿液为对照。分别点样于两块硅胶G薄层板上，一块以石油醚-乙酸乙酯(99：1)展开16cm，5%香荚兰醛浓硫酸试剂显色，有一樱红色斑点与茴香醚相对应。另一块以石油醚-乙酸乙酯(85：5)展开16cm，2，4-二硝基苯肼试剂显色，有一橙红色斑点与茴香醛相对应。"}]},{"ID":"20240902161935-a4isy7u","Type":"NodeParagraph","Properties":{"id":"20240902161935-a4isy7u","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【炮制】筛去泥屑种子，拣去果柄杂质。《本草蒙筌》：盐酒炒用。"}]},{"ID":"20240902161935-w5jojgu","Type":"NodeParagraph","Properties":{"id":"20240902161935-w5jojgu","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【性味】辛；甘；性温"}]},{"ID":"20240902161935-xmiptq4","Type":"NodeParagraph","Properties":{"id":"20240902161935-xmiptq4","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【归经】肝；肾；脾；胃经"}]},{"ID":"20240902161935-9hhbtks","Type":"NodeParagraph","Properties":{"id":"20240902161935-9hhbtks","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【功能主治】散寒；理气；止痛。主寒疝腹痛；腰膝冷痛；胃寒呕吐；脘腹疼痛；寒湿脚气"}]},{"ID":"20240902161935-yomui7r","Type":"NodeParagraph","Properties":{"id":"20240902161935-yomui7r","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【用法用量】内服：煎汤，3-6g；或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240902161935-c92spoh","Type":"NodeParagraph","Properties":{"id":"20240902161935-c92spoh","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【注意】阴虚火旺者慎服。1.《得配本草》：多食损目发疮。2.《会约医镜》：阳旺及得热则呕者均戒。"}]},{"ID":"20240902161935-p5sg290","Type":"NodeParagraph","Properties":{"id":"20240902161935-p5sg290","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【附方】1.治小肠气坠：八角茴香、小茴香各三钱，乳香少许。水(煎)服取汗。(《仁斋直指方》)2.治疝气偏坠：大茴香末一两，小茴香末一两。用猪尿胞一个，连尿入二末于内，系定罐内，以酒煮烂，连胞捣丸如梧子大。每服五十丸，白汤下。(《卫生杂兴》)3.治腰重刺胀：八角茴香，炒，为末，食前酒服二钱。(《仁斋直指方》)4.治腰病如刺：八角茴香(炒研)每服二钱，食前盐汤下。外以糯米一、二升，炒热，袋盛，拴于痛处。(《简便单方》)5.治大小便皆秘，腹胀如鼓，气促：大麻子(炒，去壳)半两，八角茴香七个。上作末，生葱白三七个，同研煎汤，调五苓散服。(《永类钤方》)6.治风毒湿气，攻疰成疮，皮肉紫破脓坏，行步无力，皮肉?热：舶上茴香(炒)、地龙(去土，炒)、川乌头(炮，去皮尖)、乌药(锉)、牵牛(炒)各一两。研杵匀细，酒煮糊为丸，如梧桐子大。每服空心盐汤下十五丸，日二。(《脚气治法总要》茴香丸)"}]},{"ID":"20240902161935-fsum6u7","Type":"NodeParagraph","Properties":{"id":"20240902161935-fsum6u7","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【各家论述】1.《本草求真》：大茴香，据书所载，功专入肝燥肾，凡一切沉寒痼冷而见霍乱。寒疝、阴肿、腰痛，及干、湿脚气，并肝经虚火，从左上冲头面者用之，服皆有效。盖茴香与肉桂、吴茱萸，皆属厥阴燥药，但萸则走肠胃，桂则能入肝肾，此则体轻能入经络也。必得盐引入肾，发出阴邪，故能治疝有效。余细嚼审八角茴味，其香虽有，其味甚甘，其性温而不烈，较之吴茱萸、艾叶等味，更属不同，若似八角大茴甘多之味，而谓能除沉寒痼冷，似于理属有碍。盐水炒用，得酒良。2.《品汇精要》：主一切冷气及诸疝痛。3.《本草蒙筌》：主肾劳疝气，小肠吊气挛疼，干、湿脚气，膀胱冷气肿痛。开胃止呕，下食，补命门不足。(治)诸瘘，霍乱。4.《医学入门》：专主腰痛。5.《本草正》：除齿牙口疾，下气，解毒。6.《医林纂要》：润肾补肾，舒肝木，达阴郁，舒筋，下除脚气。"}]},{"ID":"20240902161935-87jdi61","Type":"NodeParagraph","Properties":{"id":"20240902161935-87jdi61","updated":"20240902161947"},"Children":[{"Type":"NodeText","Data":"【摘录】《中华本草》"}]},{"ID":"20240902161936-nfeqdu6","Type":"NodeThematicBreak","Properties":{"id":"20240902161936-nfeqdu6","updated":"20240902161947"}},{"ID":"20240902162033-nam7t5m","Type":"NodeParagraph","Properties":{"id":"20240902162033-nam7t5m"}}]}